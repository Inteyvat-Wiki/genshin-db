						733220912
					]
				}
			]
		},
		{
			"id": 7332210,
			"completionStepIds": [
				7332210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332210",
							"2"
						],
						"stepId": 7332210,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑟法娜",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733221001,
					"content": "雖說黯色的力量還在肆虐…但所有花池都受到了淨化，恢復了生機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221002
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221002,
					"content": "怎麼回事呢？有誰在幫我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221003
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221003,
					"content": "如果真是這樣，或許我和花池們也獲得了萬種母樹的庇佑…真是太幸運了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221004
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221004,
					"content": "瑟法娜，好久不見啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221005
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221005,
					"content": "等等，我沒看錯吧…是斯露莎姐姐？妳居然回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221006
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221006,
					"content": "妳不會再突然離開吧？不會一去就是好久好久吧？不會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221007
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221007,
					"content": "#冷靜，吾的去留不是重點！這次，吾與「謁頌主」{NICKNAME}來通知妳，吾等彌補了汝的過失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221008
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221008,
					"content": "吾正遂行熄滅「焚真之天象」的偉業，順勢祓除了黯色的侵蝕，解救了所有花池。但汝務必牢記，這是汝的失職！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221009
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221009,
					"content": "原、原來是斯露莎姐姐的功勞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221010
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221010,
					"content": "我…我明白自己的過錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221011
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221011,
					"content": "#實在感謝{F#妳}{M#你}們…我可以鬆口氣了…一直以來的不安全都消散了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221012
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221012,
					"content": "瑟法娜居然叫斯露莎「姐姐」呢，這個姐姐未免也太嚴厲了，根本讓人喜歡不起來嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221013,
					"content": "何等幼稚！前輩對於後輩，當然要多加提點，怎麼能看著她們犯錯，還輕聲細語！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221014
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221014,
					"content": "沒…沒錯！以前斯露莎姐姐是很照顧我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221015
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221015,
					"content": "斯露莎姐姐在「淨覺花」前，發出「目標是比肩西摩格」的宣言時…比什麼心得都能鼓舞我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221016
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221016,
					"content": "從那時起，我就覺得，斯露莎姐姐的意志真可敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221017
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221017,
					"content": "所以我才學著人類對同輩長者的稱謂，如此稱呼她，這代表著我的敬意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221018
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221018,
					"content": "真是個性格和善的花靈啊…完全想像不出斯露莎被其他花靈嚴厲管教後，還親切地叫對方「姐姐」的場景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221019,
					"content": "多…多嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221020,
						733221021
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221020,
					"content": "先聊聊正題吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221022
					]
				},
				{
					"id": 733221022,
					"content": "對喔，斯露莎姐姐的「謁頌主」或許不怎麼瞭解「淨覺花」？那我就借用前輩們的話介紹一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221023
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221023,
					"content": "曾有一位花靈如此誦唱——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221024
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221024,
					"content": "「這凝明的色彩，是生命之泉流轉的靈跡」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221025
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221025,
					"content": "「伴我長存，與我妙舞清歌，編織悠久的歡欣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221026
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221026,
					"content": "…後面忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221027
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221027,
					"content": "這段時間一直在抵抗汙穢的侵襲，太累了，意識有點模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221028
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221028,
					"content": "不用勉強自己喔，典故什麼的記不起來也沒關係，就用輕鬆一點的說法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221029
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221029,
					"content": "那我想想…「淨覺花」雖不是「甘露花海」中最為珍貴之物，但確實是我們花靈極為重視的「伴侶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221030
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221030,
					"content": "許多花靈在完成了每天應盡的職責後，就會與「淨覺花」為伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221031
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221031,
					"content": "在人類眼中就像…從小就一直陪著他們成長的…歌聲是「喵喵」和「汪汪」的生靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221032
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221032,
					"content": "貓貓和狗狗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221033
					]
				},
				{
					"id": 733221033,
					"content": "原來是這樣，如果陪著我長大的貓貓或狗狗生病了，我也會很難過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221034
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221034,
					"content": "更別說，生活中只有貓貓跟狗狗當朋友了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221035
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221035,
					"content": "瑟法娜這麼一描述，我就能理解了，「淨覺花」的健康確實超級重要！我們之前的辛苦都沒有白費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221036,
					"content": "真是粗淺的比喻，其實「淨覺花」的重要性遠在這之上，瑟法娜還是需要修習言辭這門課啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221037
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221037,
					"content": "#話說回來，這次不僅勞煩了斯露莎姐姐，還有第一次見面的「謁頌主」大人，我得好好準備給{F#妳}{M#你}們的謝禮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221038
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221038,
					"content": "我在照顧「淨覺花」的路上，撿到了亮晶晶金閃閃的東西，聽說每個人類和他們的喵喵汪汪都喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221039
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221039,
					"content": "難道是…摩拉？那我的確不討厭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221040
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221040,
					"content": "斯露莎姐姐想要什麼謝禮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221041
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221041,
					"content": "膚淺，瑟法娜！完成偉業才是吾心繫之事。無需費心感謝吾，悉心照料汝的軀體與「淨覺花」便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221042
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221042,
					"content": "意思是，瑟法娜不用跟斯露莎客氣，照顧好自己就可以了？這句話就還滿像個姐姐的耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221043,
						733221044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221043,
					"content": "斯露莎似乎不擅長表達關懷呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221045
					]
				},
				{
					"id": 733221045,
					"content": "胡亂猜測！吾只是在述說瑟法娜的職責，給她警示罷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221046
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221046,
					"content": "以爾等人類能理解的概念而言，「淨覺花」與吾輩花靈皆誕生於萬種母樹的甘露，是同源的「家人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221047
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221047,
					"content": "守候「淨覺花」的花靈終日面對汙穢之物的侵襲，當然要隨時注意軀殼的勞損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221048
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221048,
					"content": "瑟法娜雖有失職之處，但守候「淨覺花」的時日不短，倒也不可否認她的苦勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221049,
						733221050
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221049,
					"content": "「家人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221051
					]
				},
				{
					"id": 733221051,
					"content": "不管怎麼樣，斯露莎還是在照顧後輩吧？也許斯露莎心裡也藏著溫柔的一面呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221052
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221052,
					"content": "溫柔？我覺得這個說法很貼切！雖然斯露莎姐姐總是說著很可怕的話，但她經常幫我解決困擾，是最關心我的好前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221053
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221053,
					"content": "大不敬…不許再用這種離奇的措辭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221054
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221054,
					"content": "多費口舌也沒有意義了…吾等還要熄滅「焚真之天象」，沒空再閒聊了，就與瑟法娜別過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221055
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221055,
					"content": "待吾鑄定偉業，徹底驅除黯色的力量，必將使「甘露花海」的色彩重歸純淨無暇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221056
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221056,
					"content": "啊，斯露莎姐姐要走了嗎？那…祝妳一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221057
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221057,
					"content": "#我會一直等著{F#妳}{M#你}們的，斯露莎姐姐，還有「謁頌主」大人和白色的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221058
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221058,
					"content": "#下次再見的時候，還請「謁頌主」大人和白色的夥伴傾聽斯露莎姐姐的故事。我還有好多好多話想和{F#妳}{M#你}們說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221059
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221059,
					"content": "#哼…之後未必會再見了。不過，盡管與吾之「謁頌主」細說吧，好讓{M#他}{F#她}更為詳實地記述吾之功業！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221050,
					"content": "這樣說來，的確很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221051
					]
				},
				{
					"id": 733221044,
					"content": "說不定以前真的對瑟法娜很好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221045
					]
				},
				{
					"id": 733221021,
					"content": "關於「淨覺花」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221022
					]
				}
			]
		},
		{
			"id": 7332211,
			"completionStepIds": [
				7332210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332210",
							"2"
						],
						"stepId": 7332210,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑟法娜",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733221101,
					"content": "黯色的力量不知不覺就消失了…所有花池都恢復了生機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221102
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221102,
					"content": "怎麼回事呢？難道是那場雨的功效嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221103
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221103,
					"content": "如果真是這樣，表示我和花池們也獲得了萬種母樹的恩惠，真是太幸運了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221104
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221104,
					"content": "瑟法娜，好久不見啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221105,
					"content": "等等…我沒看錯吧，是斯露莎姐姐？妳居然回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221106
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221106,
					"content": "妳不會再突然離開吧？不會一去就是好久好久吧？不會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221107
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221107,
					"content": "別激動啊，瑟法娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221108
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221108,
					"content": "#這位是我的「謁頌主」{NICKNAME}，和{M#他}{F#她}的夥伴派蒙，這次我們專程來探望妳，還帶來了一個好消息給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221109,
					"content": "我們已經熄滅了「焚真之天象」，從黯色的侵蝕中解救了所有的「淨覺花」，讓它們重新煥發了生機，妳就放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221110
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221110,
					"content": "原、原來是斯露莎姐姐的功勞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221111
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221111,
					"content": "#實在太感謝{F#妳}{M#你}們了…我好感動…一直以來的不安全都消散了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221112
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221112,
					"content": "好乾脆的對話！瑟法娜還叫斯露莎「姐姐」，看來妳們以前的關係還滿親密的嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221113,
					"content": "親密？那還不至於…只不過相處過一段時間，交流過不少心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221114,
					"content": "雖然不知道為什麼，斯露莎姐姐說話的方式有點不一樣了，但以前她可是很照顧我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221115
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221115,
					"content": "她在「淨覺花」前，發出「目標是比肩西摩格」的宣言時…比什麼心得都能鼓舞我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221116
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221116,
					"content": "從那時起，我就覺得，斯露莎姐姐的意志真可敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221117
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221117,
					"content": "所以我才學著人類對同輩長者的稱謂，如此稱呼她，這代表著我的敬意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221118
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221118,
					"content": "瑟法娜這麼一說，我的腦海裡不知道為什麼就浮現出畫面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221119,
					"content": "別、別突然提起那麼久遠的事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221120,
						733221121
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221120,
					"content": "那就回到之前的話題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221122
					]
				},
				{
					"id": 733221122,
					"content": "對喔，斯露莎姐姐的「謁頌主」大人或許不怎麼瞭解「淨覺花」？那我就借用前輩們的話介紹一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221123
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221123,
					"content": "曾有一位花靈如此誦唱——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221124
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221124,
					"content": "「這凝明的色彩，是生命之泉流轉的靈跡」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221125
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221125,
					"content": "「伴我長存，與我妙舞清歌，編織悠久的歡欣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221126
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221126,
					"content": "…後面忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221127
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221127,
					"content": "這段時間一直在清除殘餘的黯色力量，太累了，意識有點模糊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221128
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221128,
					"content": "不用勉強自己，典故什麼的記不起來也沒關係，就用輕鬆一點的說法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221129,
					"content": "那我想想…「淨覺花」雖不是「甘露花海」中最為珍貴之物，但確實是我們花靈極為重視的「伴侶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221130
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221130,
					"content": "許多花靈在完成了每天應盡的職責後，就會與「淨覺花」為伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221131
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221131,
					"content": "在人類眼中就像…從小就一直陪著他們成長的…歌聲是「喵喵」和「汪汪」的生靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221132
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221132,
					"content": "貓貓和狗狗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221133
					]
				},
				{
					"id": 733221133,
					"content": "原來是這樣，如果陪著我長大的貓貓或狗狗生病了，我也會很難過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221134,
					"content": "更別說，生活中只有貓貓跟狗狗當朋友了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221135,
					"content": "瑟法娜這麼一描述，我就能理解了，「淨覺花」的健康確實超級重要！我們之前的辛苦都沒有白費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221136,
					"content": "唔，其實遠在這之上，瑟法娜還是不太擅長打比方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221137
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221137,
					"content": "#話說回來，這次不僅勞煩了斯露莎姐姐，還有第一次見面的「謁頌主」大人，我得好好準備給{F#妳}{M#你}們的謝禮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221138
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221138,
					"content": "我在照顧「淨覺花」的路上，撿到了亮晶晶金閃閃的東西，聽說每個人類和他們的喵喵汪汪都喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221139
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221139,
					"content": "難道是…摩拉？那我的確不討厭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221140,
					"content": "斯露莎姐姐想要什麼謝禮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221141
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221141,
					"content": "我就不用了，瑟法娜，照顧好妳自己和「淨覺花」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221142
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221142,
					"content": "斯露莎居然會有這麼客氣的時候，真的像個姐姐耶…妳們兩個的關係果然很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221143,
						733221144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221143,
					"content": "是不是怕瑟法娜提起往事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221145
					]
				},
				{
					"id": 733221145,
					"content": "沒有那種事啦！我真心想讓瑟法娜對自己再好一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221146
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221146,
					"content": "畢竟，用人類的話來說，「淨覺花」與花靈都誕生於萬種母樹的甘露，是同源的「家人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221147
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221147,
					"content": "照顧它們的花靈每天都要抵抗汙穢之物的侵襲，承擔著巨大的壓力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221148
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221148,
					"content": "瑟法娜很堅強，獨自面對了這一切。一直以來，她對我的敬意，也值得回以關切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221149,
						733221150
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221149,
					"content": "「家人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221151
					]
				},
				{
					"id": 733221151,
					"content": "斯露莎也會照顧後輩啦，意外看到了斯露莎溫柔的一面呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221152,
					"content": "溫柔？我覺得這個說法很貼切！斯露莎姐姐經常幫我解決困擾，是最關心我的好前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221153
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221153,
					"content": "這種奇怪的形容詞也不准亂用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221154
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221154,
					"content": "咳咳！反正，「淨覺花」的危機已經結束了！瑟法娜，以後我還會來探望妳和「淨覺花」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221155
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221155,
					"content": "終有一天，黯色的餘燼將絲縷無存，「甘露花海」的色彩也會重歸純淨無暇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221156
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221156,
					"content": "啊，斯露莎姐姐要去處理其他事務了嗎？那…祝妳一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221157
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221157,
					"content": "#我會一直等著{F#妳}{M#你}們的，斯露莎姐姐，還有「謁頌主」大人和白色的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221158
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221158,
					"content": "#下次再見的時候，還請「謁頌主」大人和白色的夥伴傾聽我和斯露莎姐姐的經歷，我還有好多好多趣事要告訴{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221159
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221159,
					"content": "這個部份就不必了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221150,
					"content": "這樣說來，的確很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221151
					]
				},
				{
					"id": 733221144,
					"content": "嗚嗚，想聽斯露莎的黑歷史…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221145
					]
				},
				{
					"id": 733221121,
					"content": "關於「淨覺花」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221122
					]
				}
			]
		},
