			"trigger": {
				"objectNames": [
					"瑟法娜",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733220801,
					"content": "我們回來啦，瑟法娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220802,
					"content": "「淨覺花」已悉數擺脫汙穢的侵蝕，汝也不必惶恐了，瑟法娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220803
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220803,
					"content": "好厲害，不愧是斯露莎姐姐！這麼多年來一直無比可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220804
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220804,
					"content": "#「謁頌主」{NICKNAME}大人，也有勞{F#妳}{M#你}了！我為{F#妳}{M#你}準備了謝禮——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220805
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220805,
					"content": "我在照顧「淨覺花」的路上，撿到了亮晶晶金閃閃的東西，聽說每個人類和他們的喵喵汪汪都喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220806
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220806,
					"content": "難道是…摩拉？那我的確不討厭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220807,
					"content": "斯露莎姐姐想要什麼謝禮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220808
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220808,
					"content": "膚淺，瑟法娜！完成偉業才是吾心繫之事。無需費心感謝吾，悉心照料汝的軀體與「淨覺花」便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220809
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220809,
					"content": "意思是，瑟法娜不用跟斯露莎客氣，照顧好自己就可以了？這句話就還滿像個姐姐的耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220810,
						733220811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220810,
					"content": "斯露莎似乎不擅長表達關懷呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				},
				{
					"id": 733220812,
					"content": "胡亂猜測！吾只是在述說瑟法娜的職責，給她警示罷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220813
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220813,
					"content": "以爾等人類能理解的概念而言，「淨覺花」與吾輩花靈皆誕生於萬種母樹的甘露，是同源的「家人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220814
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220814,
					"content": "守候「淨覺花」的花靈終日面對汙穢之物的侵襲，當然要隨時注意軀殼的勞損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220815
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220815,
					"content": "瑟法娜雖有失職之處，但守候「淨覺花」的時日不短，倒也不可否認她的苦勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220816,
						733220817
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220816,
					"content": "「家人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220818,
					"content": "不管怎麼樣，斯露莎還是在照顧後輩吧？也許斯露莎心裡也藏著溫柔的一面呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220819,
					"content": "溫柔？我覺得這個說法很貼切！雖然斯露莎姐姐總是說著很可怕的話，但她經常幫我解決困擾，是最關心我的好前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220820
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220820,
					"content": "大不敬…不許再用這種離奇的措辭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220821
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220821,
					"content": "多費口舌也沒有意義了…吾等還要熄滅「焚真之天象」，沒空再閒聊了，就與瑟法娜別過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220822
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220822,
					"content": "待吾鑄定偉業，徹底驅除黯色的力量，必將使「甘露花海」的色彩重歸純淨無暇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220823
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220823,
					"content": "啊，斯露莎姐姐要走了嗎？那…祝妳一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220824
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220824,
					"content": "#我會一直等著{F#妳}{M#你}們的，斯露莎姐姐，還有「謁頌主」大人和白色的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220825
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220825,
					"content": "#下次再見的時候，還請「謁頌主」大人和白色的夥伴傾聽斯露莎姐姐的故事。我還有好多好多話想和{F#妳}{M#你}們說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220826
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220826,
					"content": "#哼…之後未必會再見了。不過，盡管與吾之「謁頌主」細說吧，好讓{M#他}{F#她}更為詳實地記述吾之功業！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220817,
					"content": "這樣說來，的確很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220811,
					"content": "說不定以前真的對瑟法娜很好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				}
			]
		},
