			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "#…是嗎？那就好說了，{F#妳}{M#你}叫什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411002,
					"content": "卡特皮拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}，沒想到會在這裡遇到{F#妳}{M#你}。派蒙沒在{F#妳}{M#你}身邊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411004,
					"content": "#等等，{F#妳}{M#你}該不會也是什麼怪物，變成我認識的人的樣子來戲弄我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411005,
					"content": "我們不久前才見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "#…是這樣嗎？自從和{F#妳}{M#你}告別之後，感覺已經過了很久。算了，可能是年紀大了吧？我記得的事情越來越少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411007,
					"content": "#…{F#妳}{M#你}真的不是什麼怪物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411008,
					"content": "你還記得嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "關於巨人的花園的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "#我記得，我記得！{F#妳}{M#你}真的是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411012,
					"content": "抱歉，我在這裡遇到太多不可思議的事情，也經歷許多無法獲勝的戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411013,
					"content": "但這裡終於發生了變化——金色的光芒已經升起，向日葵已經開放。也許就算是古人臆想的宇宙也會發生變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411014,
					"content": "也許一切都會變好，也許我也能夠理解，然後放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411015,
					"content": "卡特皮拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "跟我一起走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "#哈哈哈，看來真的是{F#妳}{M#你}。我想起來了，我曾經認識的{F#妳}{M#你}，就算到現在也沒有變。{F#妳}{M#你}總是多管閒事，這是因為{F#妳}{M#你}正直而善良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411018,
					"content": "#但{F#妳}{M#你}不用擔心我，我不需要幫助，{F#妳}{M#你}也見識過我的身手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411019,
					"content": "#況且對於這裡的事情，或許我比{F#妳}{M#你}懂的還多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411020,
					"content": "#丘丘人，幫我告訴那位{M#少年}{F#少女}，請{M#他}{F#她}趕快離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "你有話對我說嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "#…{F#妳}{M#你}聽得懂我說的話？嗯，那我問{F#妳}{M#你}，在{F#妳}{M#你}眼裡我是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "這樣啊…那還來得及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#這也是為了{F#妳}{M#你}好，離開這裡吧，{M#少年}{F#少女}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#我同意。{NICKNAME}，{F#妳}{M#你}屬於更光明的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411027,
					"content": "我還有問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "#{F#妳}{M#你}不應該要有。再見，不要再回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "關於學徒與小魚的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
