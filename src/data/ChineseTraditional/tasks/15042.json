			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"恰斯卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "#喲，眼力不錯，我站在這麼高的地方居然都被{F#妳}{M#你}發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421302,
					"content": "#看樣子，{F#妳}{M#你}也對這裡的設施感興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421303,
					"content": "它好玩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "#我覺得滿不錯。但好玩與否是個主觀的判斷，我說了也不算，要{F#妳}{M#你}親自上手試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421307,
					"content": "看到那條軌道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421308,
					"content": "用顏料子彈給軌道上的球體染色吧。只要塗上相同的顏色，那些球就會被「消除」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421309,
					"content": "至於是如何「消除」的…呵呵，也許另一個人也端著槍，等著把那些球打飛呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421310,
					"content": "好厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "#那{F#妳}{M#你}就來一局試試？用那個就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421313,
					"content": "#這輪我看{F#妳}{M#你}玩，加油。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421311,
					"content": "說得我快信了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "它複雜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "放輕鬆，這裡可是悠悠度假村，是與「複雜」、「困難」這些詞彙距離最遠的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "恰斯卡"
				}
			]
		},
		{
