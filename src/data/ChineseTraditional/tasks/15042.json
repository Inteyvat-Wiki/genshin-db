			"dialogs": [
				{
					"id": 150421501,
					"content": "很好，清點人數…一二三四…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421502,
					"content": "還多了一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421503,
					"content": "各位是想要參與浪浪灣的主要挑戰設施嗎？但我們這邊出了些狀況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421504,
					"content": "如果需要完成紀念冊任務，在景點拍攝合照的話，我現在可以直接幫大家拍攝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421505,
					"content": "不…這不對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421506,
					"content": "畫片不過是留念的手段，以後翻看時還能回想起溫暖的片段…但我們在意的還是整個遊玩的體驗啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421507,
					"content": "妳忘說畫片可以兌獎的事了…好吧，但我也贊同，拍一張就走太敷衍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421508,
					"content": "我明白了，真是抱歉…那可能需要大家保持耐心等待了，我們會盡快解決的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421509,
					"content": "要等多久呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421510,
					"content": "這個不太好說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421511,
					"content": "欸？不太好說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421512,
					"content": "有我們來幫忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421513,
					"content": "這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421514,
					"content": "我看浪浪灣其他設施工作人員很少，龍員工的狀態明顯有些疲憊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421515,
					"content": "恐怕就是因為「主要挑戰設施」遇到了難關，所有人手都被臨時調度過來，共同參與起了修復工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421516,
					"content": "別緊張，我理解有不便透露的內部情況，並不是要為難妳的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421517,
					"content": "相反，我的同伴個個身手不凡，而且助人為樂，就在不久前完成了「暝導遊船」和「阿夏快跑」兩場測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421518,
					"content": "要是妳願意把難題和我們分享，事態就很有可能得到更快解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421519,
					"content": "哇，她說話有進有退的，這就是平日裡深藏不露的「調停人」實力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421520,
					"content": "恰斯卡，提醒我一下，妳是怎麼觀察的？妳不會暗中坐在樹梢上偷看我們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421521,
					"content": "這是重點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421522,
					"content": "噢，重點是…我們真的很擅長支援和協助！有問題當然要大家一起出力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421523,
					"content": "沒想到這位客人連龍的狀態都能說得那麼準確…不好意思，是我不該隱瞞各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421524,
					"content": "情況是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421525,
					"content": "測試發現，「閃閃大滑行」仍有許多地方缺少正確塗色。由於需要在遊隙靈道上噴繪，施工難度很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421526,
					"content": "為了不影響度假村的正式開業時間，我們只能臨時關停挑戰設施，爭分奪秒搶修…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421527,
					"content": "哈哈…那好說啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421528,
					"content": "告訴我顏料放在哪裡？我來跑一次，一口氣全都塗完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421529,
					"content": "啊？…她在說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421530,
					"content": "我猜妳可能沒和她見過面，這位是「沃摩{RUBY#[S]團結}延」的瑪拉妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421531,
					"content": "瑪拉妮…等等，瑪拉妮…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421532,
					"content": "妳是說…六英傑之一的那位瑪拉妮？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "圖西娜"
				}
			]
		},
