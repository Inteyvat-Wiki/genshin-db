			},
			"dialogs": [
				{
					"id": 150421401,
					"content": "現在感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421402,
					"content": "有點輕鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#口氣還滿大，不過我看{F#妳}{M#你}的確表現得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421408,
					"content": "說不定我也可以跟工作人員提提建議，讓他們日後做點改進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421409,
					"content": "再怎麼說…至少也該讓兩位選手一決高下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421404,
					"content": "眼睛看花了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "哈哈，保持專注的確是一件需要耗費體力的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421406,
					"content": "滿好玩的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "是嗎？看來我們做出了相同的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				}
			]
