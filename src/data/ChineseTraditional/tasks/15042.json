			"dialogs": [
				{
					"id": 150420101,
					"content": "嗚呼——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420102,
					"content": "陽光！海浪！鰭游龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420103,
					"content": "她激動得好像忘了自己的古名是「沃摩{RUBY#[S]團結}延」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420104,
					"content": "快來呀，這邊這邊！哎呀，快一點嘛，用跑的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420105,
					"content": "我們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420106,
					"content": "看！這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420107,
					"content": "木板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420108,
					"content": "看字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420109,
					"content": "噢噢噢是遊覽地圖啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420110,
					"content": "遊覽地圖！其價值不亞於鎖著巨大寶庫的鑰匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420111,
					"content": "我明白，都象徵著冒險的開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420112,
					"content": "或者也能比喻成熊熊燃燒的燃素種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420113,
					"content": "燃素？呃…好像是一種能量對吧？你是想說…只要看一眼就會有…源源不斷的動力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420114,
					"content": "沒錯！而且它也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420115,
					"content": "擁有地圖，需要時隨時查看，每個人都能走出屬於自己的自由冒險之路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420116,
					"content": "哇噢，自由！冒險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150420118,
					"content": "等等…別急著附和。我怎麼聽著瑪拉妮話裡有話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420119,
					"content": "現在，解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420120,
					"content": "哪有妳這種一到景點就原地解散的嚮導啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420121,
					"content": "瑪拉妮是不是自己想玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#不愧是我的好夥伴，我會把{F#妳}{M#你}幫我說話這件事記在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420124,
					"content": "大家仔細看，這兩個大型遊樂設施旁都寫著「待測試」的字樣，大概是遇到了什麼麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420125,
					"content": "我們不如分頭去找自己感興趣的設施，一邊體驗，一邊幫忙測試，說不定還能讓浪浪灣盡早投入營運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420126,
					"content": "我還以為一接觸到妳心愛的水上設施，就不管我們了，原來妳還是滿熱心的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420127,
					"content": "嘿嘿，最後大家就在那個巨大的鰭游龍建築附近集合吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420128,
					"content": "憑我多年嚮導經驗，區域主要挑戰的入口，肯定在那附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420129,
					"content": "行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150420130,
					"content": "那就解散啦，記得多看地圖哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150420122,
					"content": "懂了，今天「嚮導」也在度假…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
