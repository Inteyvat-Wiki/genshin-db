			"dialogs": [
				{
					"id": 150421701,
					"content": "辛苦啦，瑪拉妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421702,
					"content": "呼，這下總算玩爽啦…怎麼樣？各位，我做得很棒吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421703,
					"content": "太漂亮了，不愧是納塔的六英傑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421704,
					"content": "在衝浪板滑出去之後，派蒙和我說起了妳的事蹟，聽得我嘆為觀止！全身都像燃燒起來一樣激動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421705,
					"content": "哈哈，謝謝，聽你誇得我都想原地加開一場溫泉派對了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421706,
					"content": "哇！你們看，浪浪灣工作人員都來了！努力了那麼久，大家肯定都在等著音樂、派對和犒勞呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421707,
					"content": "我覺得妳理解錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421708,
					"content": "哪裡錯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150421709,
					"content": "英雄瑪拉妮小姐，能不能請您為我簽個名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "圖西娜"
				},
				{
					"id": 150421710,
					"content": "我也想要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150421711,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150421712,
					"content": "明星已經藏不住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
