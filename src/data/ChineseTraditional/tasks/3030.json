			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏達",
					"古田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30301001,
					"content": "到啦，這裡是社奉行府，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301002,
					"content": "#{NICKNAME}，好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301003
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301003,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301004
					]
				},
				{
					"id": 30301004,
					"content": "如果閣下是來找奉行大人和大小姐，實在不巧，他們都不在府中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301005
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301005,
					"content": "是有公務嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301006,
					"content": "奉行大人公務在身，大小姐則是替奉行大人出席一些會議，如有急事，可以到府內稍事休息，等候他們歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301007
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301007,
					"content": "怎麼樣？要進去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301008,
					"content": "那就打擾一下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301009
					]
				},
				{
					"id": 30301009,
					"content": "可以在院子裡隨便走走嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301010
					]
				},
				{
					"id": 30301010,
					"content": "換作別人，當然是不可以的了。但您與奉行大人和大小姐關係甚佳，我想，應該沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301011
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301011,
					"content": "謝謝啦，那我們就進去了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301012,
					"content": "嗯？您這樣看著我，是有什麼話要問我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301013
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301013,
					"content": "老婆婆，可以請教一些事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301014
					]
				},
				{
					"id": 30301014,
					"content": "#呵呵，可以啊。我知道您是{NICKNAME}，大小姐跟我說起過您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301015
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301015,
					"content": "您有什麼想知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301016
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301016,
					"content": "奉行大人和大小姐最近好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301017
					]
				},
				{
					"id": 30301017,
					"content": "托您的福，他們兩位一切都好。大小姐近日忙於出席各色會議，時而幫奉行大人走訪一下民間組織…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301018
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301018,
					"content": "而奉行大人，您知道的，他總是忙得很，沒什麼變化。但要說的話，最近心情應是不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301019
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301019,
					"content": "聽起來一切如常，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301020,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301021
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301021,
					"content": "（神里綾人依然擔任社奉行，而神里綾華依然是奉行府的大小姐…與原先並無不同。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301022
					]
				},
				{
					"id": 30301022,
					"content": "（社奉行眼下的情況，似乎也沒有什麼變化…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301023
					]
				},
				{
					"id": 30301023,
					"content": "（雖然是意料中的結果，但聽到他們兄妹一切都好的消息，還是覺得放心不少。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301024
					]
				},
				{
					"id": 30301024,
					"content": "怎麼樣，還有其他要問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301025,
					"content": "暫時沒有了，謝謝您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301026
					]
				},
				{
					"id": 30301026,
					"content": "您實在是太客氣啦，要不是聽說您也非常繁忙，我都想請您常來奉行府做客了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301027
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301027,
					"content": "大小姐她啊，經常提起您。她似乎很高興能有您這樣的朋友，還說您各方面都很厲害，令人欽佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301028
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301028,
					"content": "總覺得，自從您來到稻妻之後，許多事都朝著好的方向轉變了。我想，您也許就是俗語說的貴人與有緣人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301029
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301029,
					"content": "您過獎了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 303012,
			"completionStepIds": [
				303010
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
