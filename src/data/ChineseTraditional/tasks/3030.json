			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天目十五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300201,
					"content": "到天目鍛冶屋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300202,
					"content": "噢，許久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300203
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300203,
					"content": "您好，我想打聽一些消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300204
					]
				},
				{
					"id": 30300204,
					"content": "當然可以啦，請說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300205,
						30300206
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300205,
					"content": "關於「雷電五傳」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				},
				{
					"id": 30300207,
					"content": "#噢，沒想到{F#妳}{M#你}會問起這些…也好，想知道的話，我就再說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300208
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300208,
					"content": "曾享譽稻妻的「雷電五傳」，乃是這五支：天目、經津、一心、百目、千手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300209
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300209,
					"content": "五方所用的鍛造技藝，最初是由將軍大人親自傳下，經諸多天賦異稟的工匠改進後變得越發優異。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300210
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300210,
					"content": "後來，這些鍛刀世家漸漸都沒落了。流傳至今的，原本只有我們「天目」一脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300211
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300211,
					"content": "但好在近期楓原萬葉回到稻妻，繼承了「一心傳」的技藝。如此一來，五傳算是還剩兩家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300212
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300212,
					"content": "#要是我沒記錯，他鍛刀那次，{F#妳}{M#你}也在場呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300213
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300213,
					"content": "這麼一說我也想起來了，是有這回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300214,
					"content": "當時就聽說了雷電五傳沒落的事，聽得我好唏噓呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300215,
					"content": "那沒落的原因是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300216
					]
				},
				{
					"id": 30300216,
					"content": "…唉。如此說起來，又是一段傷心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300217
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300217,
					"content": "本來，那都不是我能知道的東西，但我多年來只聽說各家衰落，至今不清楚緣由…在意之下，就請教了楓原萬葉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300218
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300218,
					"content": "他告訴我，同為雷電五傳後人，他認為我應該知道這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300219
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300219,
					"content": "#…告訴{F#妳}{M#你}也無妨。只不過，這個故事並不讓人高興就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300220
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300220,
					"content": "——雷電五傳，是被一個殺紅了眼的刀匠後人給報復了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300221
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300221,
					"content": "報復？為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300222,
					"content": "傳說四百餘年前踏鞴砂的爐心發生事故。某位刀匠當時在場，為救眾人，不顧自己安危衝入爐中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300223
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300223,
					"content": "踏鞴砂的鍛造冶煉技術十分了不起，而當年負責管理踏鞴砂的造兵司正姓丹羽，丹羽與楓原有姻親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300224
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300224,
					"content": "造兵司正丹羽大人與那名刀匠一同躍入爐中，這之後，爐心似乎安穩下來，但他們兩人也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300225
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300225,
					"content": "刀匠家一落千丈，他的兒子因而成了無人照看的孤兒，每一天都活在憎恨之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300226
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300226,
					"content": "他將此事歸咎於整個稻妻，憎恨將軍大人對父親的死不聞不問、憎恨一切未能挽救他父親的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300227
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300227,
					"content": "他很無力，只能將落魄之恨傳給子孫。這戶人家便世世代代背負著恨意，過著苦悶的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300228
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300228,
					"content": "原本，故事到這裡就可以結束了。但百年前那代家主對現狀極為不滿，又無力翻身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300229
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300229,
					"content": "最終…他做出一個極為偏激的決定——向雷電五傳復仇，洩憤之餘還能動搖稻妻的鍛造業根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300230
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300230,
					"content": "那人來自百目家族，卻連自家的其他匠人都殺。近百年前，就是他主導了一切攻擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300231
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300231,
					"content": "然而，對付楓原家與神里家的後人與刀匠時，因有旁人在場，他遭到猛烈反擊，當場死去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300232
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300232,
					"content": "也是因為這樣，楓原所代表的「一心流」才未遭到滅絕，姑且能說是不幸中的萬幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300233
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300233,
					"content": "（有關雷電五傳的傳說變得不一樣了，當時加害諸位刀匠的竟然另有其人？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300234
					]
				},
				{
					"id": 30300234,
					"content": "（看來，散兵確實對世界樹做了什麼。但…丹羽似乎還是死去了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300235
					]
				},
				{
					"id": 30300235,
					"content": "#{NICKNAME}，{F#妳}{M#你}還有其他要問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300236,
					"content": "您這幾天見過萬葉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300237
					]
				},
				{
					"id": 30300237,
					"content": "楓原萬葉啊，昨天還來我這坐了坐，聊了天，喝了杯茶。看他的樣子，精神還不錯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300238
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300238,
					"content": "（太好了，人還存在…而且沒有什麼異樣，怎麼說都比昨晚想的極端情況好得多。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300239
					]
				},
				{
					"id": 30300239,
					"content": "我沒有其他問題了，謝謝您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300240
					]
				},
				{
					"id": 30300240,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300241
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300241,
					"content": "#看{F#妳}{M#你}的表情，是不是還要去其他地方呀？哼哼，我可是很會察言觀色的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300242,
					"content": "#那麼出發吧，前往下一站！{F#妳}{M#你}走前面，我跟著就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300206,
					"content": "能再對我說一遍嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				}
			]
		},
		{
			"id": 303006,
			"completionStepIds": [
				303006,
				303009
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300602,
					"content": "當然啦，我研究過這一帶的爐心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300603
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300603,
					"content": "有什麼要問的，儘管問吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300604
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300604,
					"content": "瞭解這裡的歷史嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300605
					]
				},
				{
					"id": 30300605,
					"content": "瞭若指掌！要知道，我可是在附近來回走動過許多次的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300606
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300606,
					"content": "而且，我還在其他地方遇到過以前在踏鞴砂居住過的人的後代呢。親屬所說，均是真實歷史啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300607
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300607,
					"content": "還請介紹一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300608
					]
				},
				{
					"id": 30300608,
					"content": "唔？突然這麼說，三言兩語可說不完啊，您應該知道吧？踏鞴砂這地方有很多年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300609
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300609,
					"content": "據我所知，踏鞴砂作為鍛造冶煉業的核心地區之一，已經有上千年歷史，只不過爐心似乎出過兩次問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300610
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300610,
					"content": "兩次？哪兩次呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300611,
					"content": "最近這些年一次，幾百年前還有一次。說到這個，我聽稻妻人提過，踏鞴砂以前也有楓丹工匠來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300612
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300612,
					"content": "看起來，兩個國家交流技術由來已久了，那個楓丹工匠據說還是踏鞴砂的重要客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300613
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300613,
					"content": "（是「博士」。看來「博士」故意毀壞爐心引發動亂的歷史似乎也沒有受到影響…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300614
					]
				},
				{
					"id": 30300614,
					"content": "#喂，{F#妳}{M#你}到踏鞴砂來是要打聽什麼，要不要直接問澤維爾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300615,
					"content": "已經在問了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300616
					]
				},
				{
					"id": 30300616,
					"content": "哦，原來兩位是來研究歷史的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300617
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300617,
					"content": "對，這傢伙今天不知道怎麼了，一直在打聽各種歷史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300618,
					"content": "嗯？該不會是突然有了對歷史的興趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300619
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300619,
					"content": "是啊。所以，想再問一個問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300620
					]
				},
				{
					"id": 30300620,
					"content": "好啊，請說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300621
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300621,
					"content": "你聽說過踏鞴砂有一個「傾奇者」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300622
					]
				},
				{
					"id": 30300622,
					"content": "傾奇者？唔…好像沒聽過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300623
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300623,
					"content": "我知道這個詞在稻妻通常指那些特立獨行、衣飾特殊的人，倒是一直想見見配得上這個說辭的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300624
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300624,
					"content": "但很可惜，既沒見過這類人，也沒在與踏鞴砂有關的說法裡聽過相關事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300625
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300625,
					"content": "（沒有傾奇者…難道說散兵在世界樹裡做了什麼，成功抹去了有關自己的紀錄？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300626
					]
				},
				{
					"id": 30300626,
					"content": "（如果是那樣，他應該是想改變世界，讓一切回到原點吧。但是，目前看來所有影響只跟他自己有關？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300627
					]
				},
				{
					"id": 30300627,
					"content": "謝謝你，澤維爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300628
					]
				},
				{
					"id": 30300628,
					"content": "沒什麼，不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300629
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300629,
					"content": "要走了嗎？那再見啦澤維爾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300630,
					"content": "噢！不必客氣，我能幫上忙就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300631
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300631,
					"content": "那就再會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300632
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 30300632,
					"content": "#看來，{F#妳}{M#你}想問的事都打聽到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300633,
					"content": "回去見小吉祥草王吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300634
					]
				},
				{
					"id": 30300634,
					"content": "#好啊，不過，不知道{F#妳}{M#你}今天到底怎麼了…看起來心事重重的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300635,
					"content": "#打起精神來呀！無論發生什麼我都會陪著{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300636,
						30300638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300636,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300637
					]
				},
				{
					"id": 30300637,
					"content": "要振作哦，不行的話就吃點東西！空腹的人無法戰勝生活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300640,
					"content": "那麼，出發去見納西妲吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30300638,
					"content": "謝謝妳，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300639
					]
				},
				{
					"id": 30300639,
					"content": "我們之間客氣什麼嘛，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "派蒙"
				}
			]
		},
