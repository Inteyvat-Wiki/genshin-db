			},
			"dialogs": [
				{
					"id": 30301201,
					"content": "都是實話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301202
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301202,
					"content": "平日奉行大人用膳，托馬大人總會陪伴左右。在旁服侍順道聽聽他們閒聊，是我最放鬆的時刻之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301203
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301203,
					"content": "公務不由人，奉行大人有時不得不在外用餐，可是若能回來，他還是比較喜歡在府內用膳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301204
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301204,
					"content": "據說是因為托馬大人的料理能力比普通的廚師更出眾，呵呵，奉行大人心中總是有「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301205
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301205,
					"content": "您或許還不知道，他們也會聊到您。那種口氣，像是說一個認識滿久，能談得來的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301206
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301206,
					"content": "大小姐偶爾也會陪著一起，而最近幾次家族團聚的時刻，免不了說到有趣的人事與見聞。這其中，總是有您一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301207
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301207,
					"content": "…前代奉行大人與夫人過世至今，神里家也走過了許多個年頭啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301208
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301208,
					"content": "老婆子我看著奉行大人與大小姐長大，像他們這般身分能結交到有趣又可靠的朋友，真是太好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301209
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301209,
					"content": "所以，您若有時間，歡迎常來奉行府走走。就當是老婆子我冒昧的請求了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301210,
						30301211
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301210,
					"content": "非常感謝，我會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				},
				{
					"id": 30301212,
					"content": "那真是太好了，呵呵，謝謝您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301213
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301213,
					"content": "嘿嘿，我也很喜歡來這裡哦，而且聽婆婆剛才說的，社奉行府的飯菜是不是很棒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301214,
					"content": "說得我都心癢了，下次我們來蹭…啊不是不是，來拜訪吧！最好挑個用餐的時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30301215,
					"content": "當然好，歡迎呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301401
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301401,
					"content": "那我們就先不打擾啦，不過…呃，我們接下來要去哪裡呀？",
