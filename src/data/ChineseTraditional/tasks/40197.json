			"dialogs": [
				{
					"id": 401970101,
					"content": "我認為，當事情發展到如此地步，我們應當加入——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970102,
					"content": "鹽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970103,
					"content": "不。胡椒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970104,
					"content": "哦！精妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970105,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970106,
					"content": "兩位這是在研究什麼？新的甜品菜單嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970107,
					"content": "甜品裡不該有胡椒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "不是甜品喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970109,
					"content": "是劇本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970110,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "我親愛的夥伴、攝影師、新人導演！在映影愛好者們滿溢的愛中，創作永遠不會停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970112,
					"content": "我的舞臺上，平淡的劇本禁止登場。轉折應如漫天落下的胡椒粉，讓觀眾們連連打上噴嚏才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970113,
					"content": "不只是映影，餐盤亦是舞臺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970114,
					"content": "之前聽艾梅莉埃小姐說過，胡椒是可以應用在調香技藝中的…那麼或許甜品也可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970115,
					"content": "喔！胡椒的刺激，也許更能襯托鮮奶油的甜美呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970116,
					"content": "嗚哇，總覺得她們兩個在創作上很合得來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970117,
					"content": "雖然我是想像不出胡椒蛋糕會是什麼味道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970118,
					"content": "什麼什麼？愛可菲要做新蛋糕了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970119,
					"content": "胡椒蛋糕，糊糊焦焦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "這麼刺激！等做出來了，請務必給我嚐嚐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970121,
					"content": "是我的錯覺嗎？總覺得工作完成之後，大家的熱情反而更加高漲了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970122,
					"content": "為什麼不呢？努力有了成果，才正是最應該開心的時刻呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970123,
					"content": "就像新鮮出爐的馬卡龍，不要因為畏懼甜度而不捨得加料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970124,
					"content": "馬卡龍，就是要狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970125,
					"content": "狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970126,
					"content": "狠狠放糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 401970127,
					"content": "…呃，是要放什麼糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 401970128,
					"content": "樂平波琳，妳來啦！東西完成了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970129,
					"content": "當然當然，一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 401970130,
					"content": "欸？樂平波琳是去做什麼重要任務了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970131,
					"content": "#對的對的，這個給{F#妳}{M#你}，請務必收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 401970132,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "哇，好厲害！是展會的全景圖，上面還有大家的圖案呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970134,
					"content": "嘿嘿，鑑於映影歡樂城大獲成功，我們一起商量著，想要製作一份獨特的紀念品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970135,
					"content": "這座歡樂城是由大家一磚一瓦搭建成功的，就像大家一筆一劃畫出的這份地圖一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970136,
					"content": "雖然主要都是由擅長繪圖的樂平波琳小姐完成的啦，但我們每個人也都盡力在上面加了自己的筆墨喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 401970137,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970138,
					"content": "#而且不僅如此，{NICKNAME}，我要給{F#妳}{M#你}一份特權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970139,
					"content": "#——{F#妳}{M#你}將擁有在我的頭像上添加鬍子的權利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙寧娜"
				}
			]
		},
		{
