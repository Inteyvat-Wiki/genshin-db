			"dialogs": [
				{
					"id": 401970201,
					"content": "真棒，我要畫<color=#C4D6EAFF>白色的</color>。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "鮮奶油味鬍子嗎…非常傳統，但非常好吃。嗯，我准許了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401970401,
					"content": "#好啦，既然這份紀念地圖已經是{NICKNAME}的所有物，那{F#妳}{M#你}想畫多少不同口味的鬍子都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970402,
					"content": "嘿嘿，聽起來是很好吃的地圖，我們會好好收藏的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401970403,
					"content": "#{F#妳}{M#你}們喜歡就再好不過啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401970404,
					"content": "樂園各方面的情況都已經很完善了，接下來就請忘記工作的疲憊，盡情遊玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				}
			]
		},
