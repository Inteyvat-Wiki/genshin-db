			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}大人、派蒙，{F#妳}{M#你}們回來了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 745310102,
					"content": "這次拍了不少畫片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "#太好了！這次真的非常感謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 745310105,
					"content": "#在{F#妳}{M#你}們幫忙留影的時候，我就在想我不能什麼都不做，要不然就會一直原地踏步了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 745310106,
					"content": "所以，我鼓起勇氣去拜託了一些路人，然後我也努力拍了很多畫片哦！測試資料應該這樣就足夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 745310107,
					"content": "#哼哼，不愧是我的徒弟！也多虧{NICKNAME}願意出手相助啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310108,
					"content": "樂平波琳！妳什麼時候回來的？妮內特說妳最近在忙別的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745310109,
					"content": "那當然是可以讓我賺到口袋滿滿的大——生——意——了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310110,
					"content": "#前陣子實在是抽不開身，妮內特多虧有{F#妳}{M#你}們關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310111,
					"content": "#這孩子，技術和審美都沒話說，就是膽子小了點。有{F#妳}{M#你}們幫忙，她也算是踏出重要的一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310112,
					"content": "所以妳到底在忙什麼大生意啦？神神秘秘的，不會又聽說了什麼奇怪的新聞，要把全部身家砸進去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745310113,
					"content": "怎麼可能！我樂平波琳也是會吸取教訓的好嗎？這次可是千真萬確、穩賺不賠的超級大生意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310114,
					"content": "（總覺得有點不放心…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "#哼哼，現在說出來就不好玩了。等成品出來，我會第一時間邀請{F#妳}{M#你}們來體驗的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745310103,
					"content": "「瞬影」鏡頭的效果很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
}