					}
				]
			},
			"dialogs": [
				{
					"id": 740670401,
					"content": "#又見面了。我之前和自己打賭，賭來的會不會是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670402,
						740670404
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670402,
					"content": "那這樣是贏了還是輸了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670403
					]
				},
				{
					"id": 740670403,
					"content": "哈哈，贏的也是我，輸的也是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670406,
					"content": "你為什麼要用擴音機做這種事呀？被嘉維婭抓到的話，不是很麻煩嗎？你很怕她，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670407,
					"content": "怕她？怎麼會！只是被她抓到的確很麻煩，但她大部分時間都在管理區，生產區的麻煩如果沒有特別的原因，她是不想插手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670408
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670408,
					"content": "至於為什麼要用擴音機做這種事，那當然是因為這裡的生活太無聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670409
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670409,
					"content": "我現在能理解蒂亞爾的想法了，他一定也是覺得生活太無聊了，所以才總是在找樂子。這樣說來，我只是有樣學樣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670410
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670410,
					"content": "#{F#妳}{M#你}們應該也有這樣的朋友吧？腦子裡裝滿了奇思妙想，偶爾也會惹出些一讓人啼笑皆非的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670411,
						740670412
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670411,
					"content": "有啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670413,
					"content": "我真搞不懂你，既然你覺得這裡的生活無聊，又有這樣的朋友，為什麼不盡快離開梅洛彼得堡呢？難不成你其實是重刑犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670414,
					"content": "想離開的話我隨時都能離開，我是自願留在這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670415
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670415,
					"content": "這裡的生活比外面好多了，風雨無憂、生活規律，也不需要思考複雜的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670416
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670416,
					"content": "那個叫莉諾爾的小女孩，我真是羨慕她，如果能和她交換，我一定是選擇不要離開這裡。我寧願不知道外面的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670417,
						740670419
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670417,
					"content": "那是因為你已經見過外面的世界。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670418
					]
				},
				{
					"id": 740670418,
					"content": "#要做判斷也需要材料，{F#妳}{M#你}說得對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670421,
					"content": "可是留在這裡的話，不就見不到朋友了嗎？除非你的朋友們也下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740670422,
					"content": "好消息，這對我來說不是問題。壞消息，不是問題的原因是，朋友已經不在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670423
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670423,
					"content": "唉，我真不擅長這方面的話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670424
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670424,
					"content": "他們還在的時候，雖然我們的研究方向不熱門，申請經費也很困難，但日子也不算是難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670425
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670425,
					"content": "但是後來意外和事故接踵而至、布托爾先生因病去世、中央實驗室爆炸，而蒂亞爾也因為這場事故喪生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670426
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670426,
					"content": "還有被開除的…算了，就不提他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670427
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670427,
					"content": "總之盡是一些我無能為力的事，但是在梅洛彼得堡，生活很簡單，也沒有什麼我應付不來的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670428
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670428,
					"content": "就算有，那也輪不到我擔心，哈哈！所以，我對現在的生活沒有什麼不滿，只是偶爾想找人敘敘舊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670429,
						740670430
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670429,
					"content": "可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670431,
					"content": "#不過今天能和{F#妳}{M#你}們聊天也滿不錯的，謝謝{F#妳}{M#你}們。這些特許券就送給{F#妳}{M#你}們了，就當作是我請{F#妳}{M#你}們在破爛骨頭商店喝一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670432
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670432,
					"content": "#乾杯，{M#先生}{F#小姐}，還有小小的女士，笑一個吧！願{F#妳}{M#你}們度過美好的一天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670430,
					"content": "尊重你的選擇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670419,
					"content": "不應該以輕率的態度評價他人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670420
					]
				},
				{
					"id": 740670420,
					"content": "是啊，說起來，我和她也並沒有多熟絡，誰知道她自己是怎麼想的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740670412,
					"content": "並沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670404,
					"content": "為什麼和自己打賭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670405
					]
				},
				{
					"id": 740670405,
					"content": "好問題。不過很容易回答，因為這裡沒人願意和我打這種無聊的賭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "克蘭茨"
				}
			]
		}
	]
}