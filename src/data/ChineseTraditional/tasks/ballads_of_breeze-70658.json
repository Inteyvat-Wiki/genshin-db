			"dialogs": [
				{
					"id": 706580101,
					"content": "#{F#妳}{M#你}好，有盡情享受風花節嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580102,
					"content": "多謝妳的推薦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "嘿嘿，那我這裡還有一項很輕鬆的活動，它的名字叫「風物之歌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580105,
					"content": "#想必{F#妳}{M#你}在蒙德城見過了吟遊詩人吧，參加這次的活動，{F#妳}{M#你}就能像他們一樣演奏出好聽的曲子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580106,
					"content": "#高山上，湖水邊，感受著風的氣息，全神貫注地演奏一曲，一定能讓{F#妳}{M#你}把煩心事都忘光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580107,
					"content": "沒有這方面的經驗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "不用擔心，這個活動就是為了讓沒有演奏經驗的人也能享受到音樂的樂趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580110,
					"content": "只要跟上提示，跟上節拍，接下來的都不是問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580111,
					"content": "那我放心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "#嗯嗯，祝{F#妳}{M#你}能度過一個快快樂樂的風花節！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706580112,
					"content": "我這就去試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "真的會好聽嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
					"content": "還沒有時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				}
			]
		}
	]
