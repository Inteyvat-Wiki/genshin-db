			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬塔伽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "#很好，非常好！{F#妳}{M#你}超過我了，可喜可賀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290202,
					"content": "我在這裡獨自特訓，也是希望有一天能超過這個由我自己創造的成績，可惜直到今天我也沒有做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290203,
					"content": "#但{F#妳}{M#你}做到了，這證明是時候出去看看了，外面還有很多遠比我優秀的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290204,
					"content": "和他們切磋、交流的話，我的能力也會提升。有一天，我絕對可以得到父親和姐姐的認可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290205,
					"content": "阿科米蒂就算了，那傢伙一點志氣都沒有，居然跟我是親兄弟，真是恥辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290206,
					"content": "阿科米蒂…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "不，沒什麼，閒話到此為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290208,
					"content": "勇士，以後也要堅持磨礪自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290209,
					"content": "#既然想要成為傳奇，就要奮力向前衝！衝！衝！這就是我留給{F#妳}{M#你}的臨別贈言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塔伽"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
