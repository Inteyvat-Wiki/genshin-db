				"objectNames": [
					"馬塔伽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "勇士！用這條賽道練習得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290502,
					"content": "有進步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "懦弱！沒有進步就等於退步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290506,
					"content": "該怎麼說呢？馬塔伽的字典裡好像除了「向前」、「拼命」之類的詞，沒有其他的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290507,
					"content": "不錯，我的字典比別人的薄！因為除了奮鬥和努力，其他的東西我統統不承認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290508,
					"content": "#{F#妳}{M#你}們需要練習，我也需要，僅僅練習與龍合作的話我還不算全能的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290509,
					"content": "我必須前往更大的舞臺磨礪自己！也就是說，我會離開這裡一陣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290510,
					"content": "#{F#妳}{M#你}們放心！這裡的賽道我會保留，但是這座飛屋我會拆下來帶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290511,
					"content": "打算去哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "唔…去看看我爸，還有姐姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290515,
					"content": "嗯？馬塔伽的語氣怎麼變弱了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290516,
					"content": "有什麼不對！愛護、尊重家人也是勇士理應具備的美德！狹隘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290517,
					"content": "我爸爸是花羽會最專業的訓練大師，我姐姐是最厲害的馭龍師！我為他們驕傲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290518,
					"content": "好啦，我沒有拿他們開玩笑的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290519,
					"content": "知道了，祝你順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "#{F#妳}{M#你}也順利！勇士！這次的臨別贈言是：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290521,
					"content": "我想想…永不放棄，不計血淚，成為英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290513,
					"content": "打算怎麼鍛煉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "唔…可能會先問問爸爸還有姐姐的意見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290504,
					"content": "最近沒空練習。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "懶惰！在無意義的閒逛中浪費人生去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "馬塔伽"
				}
			]
		},
