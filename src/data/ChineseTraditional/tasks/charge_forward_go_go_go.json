			"dialogs": [
				{
					"id": 750290101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "哈哈哈哈哈哈！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290105,
					"content": "嗚哇，嚇人一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290106,
					"content": "#會來到這裡，{F#妳}{M#你}們也是想要參與特訓吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290107,
					"content": "果然，人也好龍也好，擁有上進心的勇士會互相吸引！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290108,
					"content": "不要浪費時間了，我們現在就來特訓吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290109,
					"content": "果然這裡也有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "我們還什麼都沒說耶，怎麼突然就變成來參與特訓的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290112,
					"content": "不過這個口氣，難道你是訓練大師之類的人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290113,
					"content": "訓練大師也不是誰都可以做，我倒不是那麼厲害的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290114,
					"content": "#但{F#妳}{M#你}們從下面一口氣飛到這裡，原來不是為了參加我馬塔伽的勇士特訓嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "馬塔伽",
					"speakerSubtitle": "花羽會勇士預備役"
				},
				{
					"id": 750290115,
					"content": "只是路過看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "明明有馭龍飛行的基本能力，卻沒有進取心，浪費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290118,
					"content": "本來以為是志同道合的勇士…可惜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290119,
					"content": "我竟然看走眼了…可恥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290120,
					"content": "該說納塔不愧是英雄的國度，還是說納塔人平均的熱血含量超標呢？連小朋友都這麼積極。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290121,
					"content": "小朋友，不至於不至於。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "大錯特錯，決定了要成為勇士不能放任自己懶散！沒氣魄、沒膽量、沒志向的人絕對不可能成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290124,
					"content": "#而且我已經十二歲了，從年齡突破一位數的那天起我就告別了「小朋友」這個稱呼，不過我原諒{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290125,
					"content": "怎麼喝牛奶也不鬆動的不過是我的身高，不會折斷不會彎曲、能斬斷一切阻礙的是我的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290126,
					"content": "#況且，我的個子還會再長，{F#妳}{M#你}們的個子也不算高啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290127,
					"content": "好、好熱血的發言，但為什麼突然講到我們身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290128,
					"content": "哼，雖然不得不承認肉體力量受體型影響，但勇士怎麼會受區區肉體限制！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290129,
					"content": "精神的高大遠遠勝過肉體的高大，所以要有足夠的信念，必須相信懷抱著遠大夢想的自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290130,
					"content": "這種淺顯的道理，就算是冒險家也可以理解吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290131,
					"content": "說的是沒錯，但我總覺得他剛才…是不是在罵我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290132,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "#我在向懶散的{F#妳}{M#你}們解釋志氣的必要性，悠閒又怠惰，怎麼可能成為英雄？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290135,
					"content": "作為勇士，不…作為一個人類，沒有光榮的志向、沒有在訓練場上揮灑過汗水，就是失敗！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290136,
					"content": "不能以英勇的姿態翱翔於天空，不能被訓練大師們認可，就是失敗！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290137,
					"content": "#所以必須努力訓練！{F#妳}{M#你}們明白了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290138,
					"content": "明、明白了！怎麼辦？他嗓門好大，聽起來好有道理，我竟然無法反駁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290139,
					"content": "很好，準備好磨礪的話就來找我特訓！目標是：盡全力沿固定賽道馭龍飛行，獲得高分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290140,
					"content": "我會觀察訓練者在每個賽道的表現然後打分數，最終成績按照分數高低分四級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290141,
					"content": "用力飛！就算達不到最高級的評價，至少也要達到第二好的評級！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290142,
					"content": "#燃燒{F#妳}{M#你}的意志，追上我的影子，向前衝！衝！衝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290143,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290144,
					"content": "#勇士，我在等{F#妳}{M#你}的回答！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290145,
					"content": "明、明白了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "再大聲點！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290147,
					"content": "明白了！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "這裡是有抱負的未來勇士們用來自我磨煉的地方，拿出魄力來，不斷挑戰這個世界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290149,
					"content": "準備好了就來找我訓練！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290150,
					"content": "知道了！但是我不想訓練！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "什麼？都說到這種程度了還是沒辦法拋棄自己的惰性嗎？！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290152,
					"content": "#這很糟糕——但是沒關係，總有一天{F#妳}{M#你}們會無法忍受自己的失敗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290153,
					"content": "永遠逃避、永遠退縮就什麼都不會擁有！只有奮力前進才能站著大笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290154,
					"content": "哼，記住我的話，等到那個時候再來這裡磨礪自己也不算晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290133,
					"content": "怎麼可以罵人呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "你有點極端了，小朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "別小看冒險家的好奇心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "什麼特訓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
