					"nextDialogs": [
						750290604
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750290604,
					"content": "#只要{F#妳}{M#你}還有勇氣，就再來！練到超過我為止！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
