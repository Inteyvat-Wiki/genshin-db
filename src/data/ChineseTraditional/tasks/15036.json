			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "呼…跑到這裡，應該安全了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360502,
					"content": "察覺不到他的氣息，看來他仍停留在深淵秘境中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360503,
					"content": "我的力量不是弱者輕易能夠掌控的。在他消化完之前，應該都不會從那裡離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360504,
					"content": "「吞星之鯨」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "#{F#妳}{M#你}看起來很驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360507,
					"content": "也對…你並未真正見過那頭鯨魚張開血盆大口，彷彿要將星球吞入腹中的場景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360508,
					"content": "吞星之鯨有著「吞噬」的權能。無論是活人還是死物，只要能破開防禦，直接接觸到對方的本體，就能從中抽取力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360509,
					"content": "我們和牠交手的時候，那維萊特好像也說過，「吞噬」是牠的本能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360510,
					"content": "#古龍的孑遺看出了牠力量的本質，一直在用「水」的權能保護{F#妳}{M#你}們。那時候吞星之鯨也還處於飽腹的狀態，沒有徹底躁怒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360511,
					"content": "在力量完全耗盡後，牠才會逐漸展露出真正的本性，將星球上的一切化作儲糧。所以我將牠收存在特殊的虛無空間裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360512,
					"content": "只是沒想到，在這顆星球上，仍有人可以使用牠的權能。這表示他在很久以前就看過吞星之鯨，應該是師父認識的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360513,
					"content": "他的確對「極惡騎」這個詞有反應。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "所以我說，此行的目的已經完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360515,
					"content": "#這之後就是我的私事。如今的{F#妳}{M#你}已經重歸完整，可以繼續自己的旅程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360516,
					"content": "這怎麼行！為了幫我們的忙，妳的力量才被奪走了，我們怎麼能放著妳不管呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360517,
					"content": "承受失敗、失去力量，我已經不是第一次經歷這種事情了。若是墜入低谷，就重新向上攀爬，直至變得更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360518,
					"content": "就算這樣…萬一那個怪物在妳恢復好之前就找到妳怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360519,
					"content": "而且妳失去了力量，應該也不能像以前那樣「咻」地一下打開去深淵的門了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360520,
					"content": "至少這段時間，跟我們一起行動也不是什麼壞事，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360521,
					"content": "這並非出於「同情」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360524,
					"content": "#我明白{F#妳}{M#你}們的想法了。這個給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360525,
					"content": "這個是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360526,
					"content": "裝摩拉的袋子。在這個世界生活需要花錢，這點常識我還是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360527,
					"content": "#這段時間就隨{F#妳}{M#你}們安排。決定好去哪，就盡快出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360522,
					"content": "現在還算不上「兩不相欠」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "居然連妳的力量都能奪走…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
