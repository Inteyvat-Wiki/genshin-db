					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "前面好像沒有路了！這裡就是那個壞蛋藏身的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360202,
					"content": "好濃的霧，什麼也看不見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360203,
					"content": "#之前，{F#妳}{M#你}就是在這裡被襲擊，失去了一部分靈魂碎片吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360204,
					"content": "#{F#妳}{M#你}能感應到那部分靈魂碎片在哪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360205,
					"content": "（閉上眼睛，努力想像當時從身體中逸散的光點…它似乎就在附近，但並不清楚它的具體方位。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "不行…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "看來對方也做好了準備，提前遮蔽了它的氣息，否則靈魂之間應該有更強烈的共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360209,
					"content": "等一下，快看！那些尖刺又出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360210,
					"content": "「投鼠忌器」說的就是這種情況。反擊的時候收著點力，先觀察對方的動作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360211,
					"content": "#對方既然奪走了{F#妳}{M#你}的靈魂碎片，就一定會用它做些什麼。或許就藏在某個攻擊招式裡，想辦法找出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360207,
					"content": "只能感覺到它在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
