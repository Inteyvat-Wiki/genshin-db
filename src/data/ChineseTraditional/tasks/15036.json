			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#{NICKNAME}、絲柯克！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360302,
					"content": "剛剛發生什麼了？我看見絲柯克的肩膀好像被——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360304,
					"content": "#在歸離原，{F#妳}{M#你}問我為什麼那傢伙盯上{F#妳}{M#你}，將{F#妳}{M#你}視為重要的獵物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360305,
					"content": "#現在答案已經很明顯了。除了{F#妳}{M#你}本身就具備著不俗的實力之外，也是因為{F#妳}{M#你}有著所謂「淨化深淵」的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360306,
					"content": "「淨化」的本質暫且不論，藉由這股力量，他就能做到許多原本做不到的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360307,
					"content": "就比如洞穿我的防禦，吞噬我的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360308,
					"content": "他的目標其實是妳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "#不，最初他應該並不清楚我會來。拿走{F#妳}{M#你}的靈魂碎片，只是認為{F#妳}{M#你}的力量很珍貴，沒想到碰巧能在這時候派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360311,
					"content": "如果這世界上真有所謂的命運，指的應該就是這種無聊的巧合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360312,
					"content": "#不過，對我們來說也是好事。想明白它會將{F#妳}{M#你}的力量用在哪，就能反過來將{F#妳}{M#你}失去的東西拿回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360313,
					"content": "可是妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "我心裡有數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360315,
					"content": "吃飽了嗎？回答我的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360316,
					"content": "為什麼…你會有「吞星之鯨」的權能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360317,
					"content": "吞星之鯨？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360318,
					"content": "啊…對哦！怪不得我看那個尖刺有點眼熟，那東西…長得很像吞星之鯨頭上的角！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360319,
					"content": "這份權能不是你靠自己的力量得來的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360320,
					"content": "如果你真有戰勝吞星之鯨的實力，就無需四處收集魔神殘渣這種不完整的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360321,
					"content": "我只能想到一種可能性——你認識我的師父，「極惡騎」蘇爾特洛奇是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360322,
					"content": "「極惡騎」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360323,
					"content": "何人稱其為「惡」？蘇爾特洛奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360324,
					"content": "蘇爾…特洛奇…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360325,
					"content": "被力量沖昏了頭腦，已經失去了基本的溝通能力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360326,
					"content": "再等等，我還沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150360327,
					"content": "快看！那東西又來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360328,
					"content": "痴迷力量的人，在被反噬前都不會回頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360329,
					"content": "現在該怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "#冷靜。用{F#妳}{M#你}的「理性」思考，做{F#妳}{M#你}認為最恰當的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360331,
					"content": "（為了拿回我的靈魂碎片，絲柯克被那傢伙的尖刺刺傷，力量也被奪走了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "（元凶就在迷霧之後。在剛剛的交手中，我已經逐漸摸清楚對方的攻擊方式了。繼續動手，勝算很高。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "（但是絲柯克的氣息比平常弱了許多。貿然進攻的話，必然無法保證她和派蒙的安全。雖然很不情願…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "先離開這裡吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "#勝負不在一時，{F#妳}{M#你}做了正確的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360336,
					"content": "#既然拿回了{F#妳}{M#你}的靈魂碎片，此行的目的也就達成了。至於他的命，再多寄存一段時間也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360337,
					"content": "#走吧。這次，靠{F#妳}{M#你}帶我們出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360309,
					"content": "他一開始就在打妳的主意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
