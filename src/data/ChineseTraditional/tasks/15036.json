			"dialogs": [
				{
					"id": 150360601,
					"content": "仔細一看，絲柯克的包包裡居然裝了這麼多摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360602,
					"content": "#難道說她也有在工作？不對不對，{F#妳}{M#你}還記得萬民堂那時候發生的事嗎？如果她去打工的話，絕對會變成這樣子——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360603,
					"content": "「老闆，結一下這個月的工錢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360604,
					"content": "「好的。等一下…妳是誰？我們認識嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360605,
					"content": "嘿嘿，畢竟見過她的人一眨眼就把她忘了嘛。這些摩拉是從哪來的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360606,
					"content": "地下的無主寶藏，以及順手解決一些尋釁的魔物。來路正當，放心用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360607,
					"content": "嗚哇！妳能聽到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360608,
					"content": "這麼響的說話聲，站在門外的山頂上都能聽到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360609,
					"content": "啊？等一下，該不會我之前在背後說的那些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360610,
					"content": "妳指什麼？雪山凍堇瓜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360611,
					"content": "果然被聽到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "那個…其實那句話不是我說的啦！是有一個長得和我很像的人，總喜歡背後冒充我，幫別人取奇怪的綽號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360614,
					"content": "#…好吧，我錯了。那時候我不太喜歡妳，但現在我覺得妳人還不錯，畢竟幫了{NICKNAME}這麼大忙。我們可以當朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360615,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360616,
					"content": "#我剛剛看過，這裡只有一張床，{F#妳}{M#你}們去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360617,
					"content": "欸？那妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360618,
					"content": "我不會感到疲憊，也不需要休息。我去外面揮劍，這樣力量能快一點恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360619,
					"content": "但是妳的身體——欸！等一下，就這樣走了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360620,
					"content": "氣死我了。哼！不管她，等她累了自然就回來休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360621,
					"content": "我們睡覺！睡軟軟的床！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360622,
					"content": "（絲柯克很有主見，現在勸她躺下休息，她應該也不會答應。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "（派蒙說的也有道理，如果絲柯克感到疲憊，她應該就會停止訓練了。今晚先睡吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360625,
					"content": "（絲柯克…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "（不愧是她，這麼快就恢復了一些力量。不過她看起來有點奇怪…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360628,
					"content": "…安靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360629,
					"content": "（安靜？周圍明明沒有人說話。難道說…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "想想我們吧，多少人葬身在那場大火當中，只有妳一個人活了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "倉皇的路人"
				},
				{
					"id": 150360631,
					"content": "不要將目光從劍上移開，妳還沒有資格休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "倉皇的路人"
				},
				{
					"id": 150360632,
					"content": "跑起來，絲柯克。在死亡到來前，妳都要不停地跑下去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "爽朗的男聲"
				},
				{
					"id": 150360633,
					"content": "（對了。那次在夢裡，絲柯克也是在經歷了一場失敗後孤獨地練劍，身後有數不清的雜聲。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "（大火…到底發生過什麼事呢？要是她願意跟我們說就好了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "早睡早起身體好！這床真舒服呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360636,
					"content": "絲柯克，妳在這坐了一個晚上嗎？要不要休息一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360637,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360638,
					"content": "力量恢復了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "恢復了六七成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360640,
					"content": "這麼快！我還以為至少要幾天呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360641,
					"content": "不…比我預想中要慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360642,
					"content": "如果是以前，力量還要多恢復兩成。同樣的方法、同樣的感受，效果卻變差了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360643,
					"content": "難道是受那個尖刺的影響？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "應該是我自己出了問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360645,
					"content": "接下來的兩天，我需要在這裡冥想，讓意識完全沉入內心，看看到底發生了什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360646,
					"content": "冥想！聽起來好厲害，那我們就在旁邊護法好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360647,
					"content": "有勞。兩天後見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360612,
					"content": "派蒙的悄悄話能力有待加強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
		{
			"id": 1503650,
