			"dialogs": [
				{
					"id": 150365101,
					"content": "#{F#妳}{M#你}看起來比之前健康許多。煩擾消失了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365102,
					"content": "嗯，真不簡單。不過現在放鬆還太早了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365103,
					"content": "沒錯。疾病初癒，還是再觀察一段時間為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "白朮"
				},
