			"dialogs": [
				{
					"id": 150365001,
					"content": "他的身上一定有關於師父的線索。下次見面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150365002,
					"content": "傷口還痛嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "外傷而已，不必在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150365004,
					"content": "雖然恢復力量需要時間，但這種程度的困境我已經「適應」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150365005,
					"content": "妳的衣服…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "妳說這個？提瓦特的深淵能量非常稀薄，為了更加自由地使用力量，我製作了一種「星晶旅裝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150365007,
					"content": "裡面蘊藏著高規格的深淵能量，可以為我的行動提供便利。能量散盡的時候，就會變回它最初的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150365008,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "找好休息的地方了嗎？那就盡快離開這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				}
			]
		},
		{
			"id": 1503651,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
