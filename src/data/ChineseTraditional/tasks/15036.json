			"dialogs": [
				{
					"id": 150360101,
					"content": "這裡…我記得是層岩巨淵附近？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360102,
					"content": "#從這裡進去，就能抵達{F#妳}{M#你}夢裡的那個空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360103,
					"content": "雖然同是深淵秘境，但那邊是別人的地盤，還是要謹慎行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360104,
					"content": "#放心吧，我會躲到{NICKNAME}身後的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360105,
					"content": "#嘿嘿，{NICKNAME}，{F#妳}{M#你}也不要勉強哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150360106,
					"content": "放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "走吧。多想一想特訓的內容，或許能用得上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150360107,
					"content": "好好教訓一下那個「強盜」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
