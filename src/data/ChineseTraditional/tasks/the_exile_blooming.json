			"dialogs": [
				{
					"id": 732030401,
					"content": "#{F#妳}{M#你}不像是擁有神之眼的人，卻能駕馭草元素的力量，不是一般的冒險家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030402,
					"content": "#據說的確有一些人不借助神之眼就能驅動元素力，不過相關的傳聞都很糟糕，{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030403,
					"content": "#總之我相信{F#妳}{M#你}是個熱心的好人，不要走上歪路啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		}
	]
