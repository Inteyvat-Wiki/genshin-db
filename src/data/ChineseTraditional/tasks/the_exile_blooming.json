			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "#如果不是遇到{F#妳}{M#你}們，恐怕我很難看到那些薔薇發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930502,
					"content": "早知道會這樣，比起種子，當初我更應該帶些書來這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930503,
					"content": "妳不是本地人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "很意外嗎？這算是代表我適應得很好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930505,
					"content": "當初剛來這裡的時候，從衣食到起居習慣，每一樣我都沒辦法適應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930506,
					"content": "但過了這麼久，慢慢也就接受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930507,
					"content": "只不過表面適應，並不代表內心就接受了自己的處境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930508,
					"content": "能在須彌城裡盛放的薔薇，在這裡始終還是難以開花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930509,
					"content": "妳是學者嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "我…曾經被稱為學者，但現在不是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930511,
					"content": "我說了以我的身分不該說的話，瞭解了以我的身分不該瞭解的知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930512,
					"content": "這是有違教令院禁忌的，所以我就不再是學者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930513,
					"content": "妳說了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "好奇心是我們尋求智慧的原動力，但也是招致罪罰的源頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930515,
					"content": "這是我被驅逐到這裡來之後才明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930516,
					"content": "#安全起見，我認為最好不要詳細跟{F#妳}{M#你}解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930517,
					"content": "那好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "咳咳，不過…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930535,
					"content": "#我以為冒險家都是來去匆匆的人，幫過一次忙，{F#妳}{M#你}大概就不會回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930536,
					"content": "#沒想到，又跟{F#妳}{M#你}說了這麼多話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930537,
					"content": "嗯…在這裡，我能敞開聊天的朋友不是很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930538,
					"content": "#{F#妳}{M#你}認為…之後…{F#妳}{M#你}有空來幫忙給它們施肥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930539,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "#那…好，我會等{F#妳}{M#你}來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930519,
					"content": "為什麼要種須彌薔薇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "#{F#妳}{M#你}可能不太瞭解須彌薔薇，這種植物的用途非常廣泛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930521,
					"content": "它可以食用、可以藥用，作為禮品，也有很高的經濟價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930522,
					"content": "這還僅僅是它在我們日常生活中的常見用途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930523,
					"content": "須彌薔薇的花、葉、莖並不總是我們今天見到的這樣，它曾經也有過不同的形態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930524,
					"content": "我認為地理條件的改變，促使須彌薔薇的形態特徵也發生過改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930525,
					"content": "從它的形態演化過程，我們能得到很多歷史地理方面的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930526,
					"content": "這不是一兩句話說得清的事，向一位路過的冒險家解釋恐怕也不符合規定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930527,
					"content": "#如果{F#妳}{M#你}對植物演化感興趣，就去教令院吧，那裡的植物學教育更加完備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930528,
					"content": "所以是為了研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "我已經不是學者了，沒有做研究的條件和資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930530,
					"content": "#非要說為什麼的話…唉，{F#妳}{M#你}的好奇心真的很重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930531,
					"content": "我以前的居所裡種了很多須彌薔薇，它們開花的時候很漂亮，我每天都看得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930532,
					"content": "如果可以的話，我還想像以前一樣，每天都有它們陪伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930533,
					"content": "…只是這樣而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930534,
					"content": "我能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "#{F#妳}{M#你}們來了啊，很守約呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030102,
					"content": "#我做了一些奶油雞，如果{F#妳}{M#你}們肚子餓的話，可以一起坐下來吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030103,
					"content": "奶油雞！好耶，我要吃一大盤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030104,
					"content": "派蒙，這樣不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "唔…對不起嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030107,
					"content": "沒關係的，請不用跟我客氣，喜愛食物也是人之常情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030108,
					"content": "#待會我就去把菜拿出來熱一熱，再裝好給{F#妳}{M#你}們，也算是答謝{F#妳}{M#你}們之前幫我的忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030109,
					"content": "#嗚哇，賽芭小姐，{F#妳}{M#你}真好！{F#妳}{M#你}種的薔薇花一定會順著{F#妳}{M#你}的心意，好好生長的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030110,
					"content": "哈哈，這段時間，我一直在盡量保持土壤濕潤，植株幼苗狀態還算良好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030111,
					"content": "只是它們的生長速度有點慢，讓人擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030112,
					"content": "一般來說，如果胚芽狀態良好，很快就應該萌發了，但這幾朵到現在也沒有動靜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030113,
					"content": "不知道是不是土壤肥力不夠，它們還是這個狀態的話，我最好繼續從外部施肥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030114,
					"content": "再施一次肥吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "#那就又要麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030117,
					"content": "小事一樁，包在我們身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030115,
					"content": "用草元素的力量試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "抱歉，派蒙是這樣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "#這次也謝謝{F#妳}{M#你}們了，能在這裡看到須彌薔薇生長，我真的很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030302,
					"content": "#在賽芭和{F#妳}{M#你}們說話的同時，一簇簇新葉從舊葉中伸出…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "新葉逐漸舒展，結出了飽滿的花苞…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "花苞緩緩綻放，賽芭種下的須彌薔薇終於吐蕊。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "#她折下一枝須彌薔薇，交給了{F#妳}{M#你}和派蒙。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "這樣不好吧，本來賽芭小姐種的薔薇就不多，現在還折了一枝給我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030307,
					"content": "#沒關係啦，如果不是{F#妳}{M#你}們幫忙，須彌薔薇是沒辦法在這裡開出花來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030308,
					"content": "一點小忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "一座薔薇園當然很壯觀，不過單枝薔薇也有自己的美。以前我還是學者的時候，就對薔薇感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030311,
					"content": "欸，原來賽芭小姐是位學者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030312,
					"content": "對了，我還沒有告訴過派蒙呢。我並不是一直居住在阿如村的居民，我是從教令院裡…「搬」過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030313,
					"content": "我就說嘛，賽芭小姐說話的方式好文雅，真的很像學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030314,
					"content": "我知道啦，賽芭小姐是想繼續研究薔薇，所以才會種植它們的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732030315,
					"content": "倒不能這麼說，學者們對研究對象的興趣不該是為了做研究才刻意培養出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030316,
					"content": "是因為喜愛這個世界，所以才想瞭解它，想理解草木的生命軌跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030317,
					"content": "拿我舉例的話，以前我有個課題——須彌地理環境演化對薔薇物種形態的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030318,
					"content": "#{F#妳}{M#你}想，如果須彌的地理環境演化方向和今天完全不同，為了適應自然條件，薔薇會演化成什麼形態呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030319,
					"content": "會不會演化成爬藤植物？那樣的話，今天的教令院牆壁上說不定就會爬滿薔薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030320,
					"content": "會不會演化出簇生花？一開一大捧，很有氣派吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030321,
					"content": "說不定還會有各式各樣的顏色，白的、紅的、金的…那會是一個全新的品種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030322,
					"content": "當然囉，現在很少有人能發現新物種了，像過去某些頂尖學者那樣培育新物種，就更不用說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030323,
					"content": "我想表達的是：每一枝薔薇身上都蘊含著大量的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030324,
					"content": "探索這些可能性是一件很開心的事，那時候我每天都懷著興趣開開心心地收集著標本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030325,
					"content": "回想起來，真是一段純粹又愉快的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030326,
					"content": "#總而言之，{F#妳}{M#你}們拿著就好了，對我來說，這可不是損失，而是快樂的分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030327,
					"content": "如果實在覺得心裡彆扭，以後就多帶些須彌薔薇來看我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030328,
					"content": "#和{F#妳}{M#你}們說話的時候，感覺很放鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030329,
					"content": "#不管我說些什麼，{F#妳}{M#你}們都不會覺得我是在說「閒話」，打斷我說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030330,
					"content": "#我也會送{F#妳}{M#你}們一些小禮物的，雖然對現在的我基本沒用處，但{F#妳}{M#你}們說不定會喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030331,
					"content": "會常來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "一定要常來看我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030309,
					"content": "別放心上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
