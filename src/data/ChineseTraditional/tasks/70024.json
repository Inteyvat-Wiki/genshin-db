			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "旅行者，請您過來這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240102,
					"content": "抱歉佔用您一些時間，請問您有興趣接受一份新委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240103,
					"content": "請講無妨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "是這樣的。根據最近協會收到的報告，野外的丘丘人們又聚集了起來，侵擾商道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240106,
					"content": "為此我們也派出了不少冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240107,
					"content": "但根據那些冒險家的說法，在集結起來的丘丘人裡，他們總能發現一個奇怪的丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240108,
					"content": "我們猜測，那個奇怪的丘丘人，或許會和這次丘丘人騷亂有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240114,
					"content": "所以，我們需要有人去捕捉，或者至少驅趕那個奇怪的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240109,
					"content": "旅行者，您有興趣接受這份委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240110,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "謝謝您。我已經在您的地圖上標註了幾個地點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240113,
					"content": "這些地方都有丘丘人出沒，請您先從這些地方開始調查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240115,
					"content": "如果遇見了那個奇怪的丘丘人…請您務必小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700240111,
					"content": "我會留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "請問是什麼委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾拉·馬斯克",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "幸好我們來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "妳還好嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "#呼…好險，幸好{F#妳}{M#你}們來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240204,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240205,
					"content": "明明剛剛進展還很順利的…究竟是哪句話說錯了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240206,
					"content": "#不管怎樣…感謝{F#妳}{M#你}們及時搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240207,
					"content": "她看上去很消沉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240208,
					"content": "#畢竟剛剛發生的事{F#妳}{M#你}們也看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240223,
					"content": "自己跑出來和丘丘人溝通，果然還是風險太大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240210,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "有什麼能幫上忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "可是…與丘丘人正常交流的機會，就這樣浪費的話還是很不甘心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240212,
					"content": "這樣的話，詞典的編纂工作又要繼續拖延了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240213,
					"content": "我可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "如果有人能替我驗證書中內容的準確性就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240214,
					"content": "#真、真的嗎！太好了！那麼請{F#妳}{M#你}們務必帶上這本書！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240215,
					"content": "哇啊…瞬間變成了使喚人的口氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240217,
					"content": "理論…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "如果在溝通中遇到什麼困難，只需查閱詞條就可以解決…至少理論上是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240218,
					"content": "所以馬斯克小姐自己也不知道自己寫的是什麼嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240219,
					"content": "外行才會提這樣的問題！科學研究不導入現實中驗證，怎麼知道是否符合邏輯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240225,
					"content": "#哼…算了，反正再說下去妳也未必聽得懂。不管怎樣，這次真的很感謝{F#妳}{M#你}們能來相救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700240221,
					"content": "歡迎加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "既然來都來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "#接下來{F#妳}{M#你}們不介意的話，就讓我和{F#妳}{M#你}們一同去與丘丘人交涉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "艾拉·馬斯克"
				}
			]
		}
	]
}