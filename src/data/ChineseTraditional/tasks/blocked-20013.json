			"dialogs": [
				{
					"id": 200130201,
					"content": "原來是旅行者，實在是太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130202,
					"content": "#{F#妳}{M#你}能再幫我一個小忙嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130203,
					"content": "這個路障豎在這裡，把我的冒險之路給截斷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130204,
					"content": "#{F#妳}{M#你}能幫我把這個路障清理掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130205,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "#唉，要是能像{F#妳}{M#你}一樣，我早就成為個偉大的冒險家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130206,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "#別啊，我偉大的冒險之旅可不能終結在此，拜託{F#妳}{M#你}幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		},
		{
			"id": 2001303,
			"completionStepIds": [
				2001304
