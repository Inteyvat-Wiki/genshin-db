				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#太感謝{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130302,
					"content": "我本來是想去史丹利先生冒險過的地方看看，但是沒想到半路上遇見了這群傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130303,
					"content": "我的實力還是太弱了，假如是史丹利先生，肯定能把這群傢夥全部消滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130304,
					"content": "#要是{F#妳}{M#你}願意和我一起去冒險…還是算了，不能事事都依靠別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130305,
					"content": "#我要接著往前走了，這個給{F#妳}{M#你}，我在路上摘了好多做乾糧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200130306,
					"content": "不過，這也不能叫「乾糧」，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		}
