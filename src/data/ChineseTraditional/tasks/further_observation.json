			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30011001,
					"content": "好耶！是什麼好吃的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011002,
					"content": "派蒙，矜持一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011003
					]
				},
				{
					"id": 30011003,
					"content": "有什麼關係嘛，柯萊又不是外人。再說了，食客的熱情可是對廚師最好的讚美呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011004,
					"content": "#今天我帶來的是一種巡林員常吃的便攜食物，叫做「口袋餅」，不知道合不合{F#妳}{M#你}們的胃口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011005,
					"content": "哇啊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011006,
					"content": "糟了，掉在地上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011007,
					"content": "沒事沒事，我在食物外面包了好幾層油紙，應該沒有弄髒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011008,
					"content": "呼…剛才真是嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011009,
					"content": "和柯萊一起分享了食物…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "真是太好吃啦！柯萊，妳的廚藝真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011011,
					"content": "幸好妳之前把每塊餅都仔細包了起來，要不然我肯定會心疼得晚上連覺都睡不著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011012,
					"content": "哈哈，這也太誇張了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011013,
					"content": "#不過既然{F#妳}{M#你}們喜歡，下次我幫{F#妳}{M#你}們抄一份食譜吧。放心，我會把烹飪要點寫上，{F#妳}{M#你}們很快就能學會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011014,
					"content": "謝謝妳柯萊！嘻嘻，真難想像像妳這麼認真的人，竟然也會有笨手笨腳的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011015,
					"content": "哈哈，可能是有那麼一點吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011016,
					"content": "不過提納里對妳是不是管得太嚴了一點？東西都不讓妳碰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011017,
					"content": "#我偶爾也會在飛的時候碰倒桌上的東西，但{NICKNAME}從來不會怪我，畢竟誰都會有不小心的時候嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011018,
					"content": "#不，不是這樣的！如果{F#妳}{M#你}們和師父相處的時間更長一點，就會發現他其實是個很好的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011019,
					"content": "我聽前輩們說，師父來自一個很古老神秘的種族。他們一族都很聰明，大多有些孤僻，但師父卻是個很熱心腸的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011020,
					"content": "#對了，{F#妳}{M#你}們知道教令院嗎，好像是叫做生…生什麼派來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011021,
					"content": "總之，因為師父對植物很有研究，那個學院的賢者還好幾次寫信來，讓他到教令院去任職。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011022,
					"content": "不過，卻被師父以「須彌城太嘈雜對耳朵不好」為由拒絕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011023,
					"content": "還真像提納里會說的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "哈哈，是啊。不過賢者大人看到信，大概會生氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011025,
					"content": "明明可以去教令院，師父卻選擇了做巡林官，每天都在為雨林的居民們提供幫助，也會教給下屬們各種知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011029,
					"content": "就連口袋餅的做法，也是師父教給我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011030,
					"content": "真的嗎？這我倒是完全沒想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011031,
					"content": "#唔…不過這麼說來，昨天提納里發現{F#妳}{M#你}暈倒後，倒是二話不說就對{F#妳}{M#你}實施救治，也是他把{F#妳}{M#你}背回化城郭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011032,
					"content": "不過我還是覺得有點不爽，因為他整整一路上都在拼命數落我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011033,
					"content": "妳做了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "啊，真不好意思，這件事可能是師父不太對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011035,
					"content": "#因為派蒙當時不停在喊「怎麼辦，{M#他}{F#她}是不是要死了？」，怎麼勸都沒用，把師父給惹毛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011036,
					"content": "#喂，可惡，{F#妳}{M#你}不要笑啊！我還不都是因為關心{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011037,
					"content": "噗…呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011038,
					"content": "怎麼回事，為什麼連柯萊也——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011039,
					"content": "#啊啊啊，氣死我啦！我要報復{F#妳}{M#你}們！看我把{F#妳}{M#你}們的腦袋都揉成鳥窩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011040,
					"content": "別碰我！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011041,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "柯萊，對不起，那個，我不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011044,
					"content": "啊，我…剛才…不、不是這樣的，不是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011045,
					"content": "柯萊，妳還好嗎？妳沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011046,
					"content": "#啊…嗯，我沒事，我沒事了…不好意思，剛才嚇了{F#妳}{M#你}們一跳吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011047,
					"content": "對了，時間已經不早了，我們趕快回化城郭去吧，師父他們也該回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011048,
					"content": "剛才到底怎麼了，柯萊她不要緊吧？她走得可真快，現在都已經看不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011042,
					"content": "柯萊，妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "耳朵…耳朵好像很好摸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "對吧！我也是這麼覺得…嗯，咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30011028,
					"content": "總、總而言之，師父明明可以去教令院，卻還是做了巡林官，每天都在為雨林的居民們提供幫助，也會教給下屬們各種知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "柯萊"
				}
			]
		},
