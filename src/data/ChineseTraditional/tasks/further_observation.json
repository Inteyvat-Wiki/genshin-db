					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010601,
					"content": "仔細看的話，這座神像雕刻出的神明，身材很小巧的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010602,
					"content": "#唔，{F#妳}{M#你}說她究竟是「大慈樹王」，還是「小吉祥草王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010603,
						30010605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010603,
					"content": "「大慈樹王」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010604
					]
				},
				{
					"id": 30010604,
					"content": "嗯，很有可能，畢竟這座神像看起來很古老了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010607,
					"content": "算啦，關於她們的事情，我們以後總會打聽到的。好，接下來我們就來擦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010608,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010609
					],
					"speakerTitle": "蘭那羅A"
				},
				{
					"id": 30010609,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "等一下，剛剛那是什麼？是我的錯覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010611,
					"content": "妳果然也看見了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "對呀！就是那種小小的、圓圓的、看起來還有點像蔬菜的小東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010615,
					"content": "剛才真是嚇了我一大跳，我覺得我們有必要打聽一下這種東西是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010616,
					"content": "#不過現在，我們先開始工作吧。我飛到上面去，{F#妳}{M#你}就負責擦下面好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010617,
					"content": "和派蒙一起仔細擦拭了神像…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "是高麗菜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "對對！小小的、圓圓的，的確有點像高麗菜。不過明顯是活的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010605,
					"content": "「小吉祥草王」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "看這座神像的模樣，倒是和這個名字挺相稱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "派蒙"
				}
			]
		},
