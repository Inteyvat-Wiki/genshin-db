				"objectNames": [
					"娜絲琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30011101,
					"content": "#哦，旅行者，{F#妳}{M#你}們回來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "娜絲琳"
				},
				{
					"id": 30011102,
					"content": "妳好，請問妳看到柯萊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30011103,
					"content": "柯萊啊，剛才看見她回房間去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "娜絲琳"
				},
				{
					"id": 30011104,
					"content": "這樣啊…看來我們只能明天再去找她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
