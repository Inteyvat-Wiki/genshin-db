			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "好，接下來是右手…情況似乎還可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010102,
					"content": "不過還是小心行事，明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010103,
					"content": "嗯，我知道了。對了師父，我還沒拿到今天的巡林路線圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010104,
					"content": "今天的路程很遠，妳就不要跟我一起去了，而且還可能會有那些東西出現在這條路線上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010105,
					"content": "我明明也有神之眼，卻沒辦法幫上什麼忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010106,
					"content": "別說這種話，這不是妳現在應該考慮的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010107,
					"content": "#{F#妳}{M#你}們來了，身體感覺還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010108,
					"content": "有什麼需要幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "對，既然留在這裡，我們也想稍微找點事情做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010110,
					"content": "#{F#妳}{M#你}們是這種閒不下來的類型嗎？好吧，既然這樣，今天就讓柯萊帶{F#妳}{M#你}們去化城郭南邊巡視吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010111,
					"content": "#如果{F#妳}{M#你}們對體力有信心，七天神像的清潔也交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010112,
					"content": "提納里先生，我們已經準備完畢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30010113,
					"content": "#馬上就來——我們先出發去林子裡了，剩下的事就讓柯萊跟{F#妳}{M#你}們說明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30010114,
					"content": "是，交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010115,
					"content": "柯萊，我們今天要做些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010116,
					"content": "剛才提納里說要清潔七天神像，但我沒想到，這也算巡林員的工作啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010117,
					"content": "嗯，其實巡林員的工作內容很廣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010118,
					"content": "檢查道路狀況、維護林間設施、排除火災隱患、為旅客居民提供幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010119,
					"content": "如果是師父的話，還經常要去處理雨林中危險的區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010120,
					"content": "在我們到達七天神像前，先檢查一下沿途的路燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯萊"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "#七天神像就在那塊巨大的岩石上面，{F#妳}{M#你}們之前從這條路過來的時候，應該已經看到它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010502,
					"content": "#位置是不是有點高？如果{F#妳}{M#你}覺得爬上去比較勉強，不打掃也沒關係，師父不會介意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010503,
					"content": "不要緊，我很擅長攀爬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "#是嗎，那就交給{F#妳}{M#你}了。神像附近的空間很小，{F#妳}{M#你}在上面要小心一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}，我也和{F#妳}{M#你}一起上去吧，我可以幫{F#妳}{M#你}打掃比較高的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010507,
					"content": "對了柯萊，妳知道草神是位什麼樣的神嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010508,
					"content": "#{F#妳}{M#你}是問「大慈樹王」還是「小吉祥草王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010509,
					"content": "咦，「大慈樹王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010510,
					"content": "啊，難道說這是前代草神的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010511,
					"content": "對。「大慈樹王」是須彌的初代草神大人。她創造了雨林，在沙漠邊緣建起防沙壁，大家這才獲得了安寧的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010512,
					"content": "在須彌人眼裡，她是智慧、仁慈與無所不能的象徵，但她卻在幾百年前的災難中消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010513,
					"content": "（就像雷電真那樣嗎…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "我聽師父說，後來賢者們找到了新生的草神大人，將她接回了須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010516,
					"content": "為了慶祝神明的失而復得，賢者們就以「小吉祥草王」稱呼她，並讓她居住在淨善宮裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010517,
					"content": "嗯嗯，那然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010518,
					"content": "然後，呃…我也不太清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010519,
					"content": "咦，妳也不清楚嗎？難道說柯萊妳並不是須彌人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010520,
					"content": "不，我是須彌人沒錯，不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010521,
					"content": "是因為我們是陌生人，有些事情不方便說嗎？如果真是這樣也沒關係，妳不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010522,
					"content": "#不不，{F#妳}{M#你}們誤會了，我不是在隱瞞什麼。況且{F#妳}{M#你}們對我來說，也不算是陌生人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010523,
					"content": "#那個…{F#妳}{M#你}、{F#妳}{M#你}們也認識安柏對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010524,
					"content": "等等，妳說的難道是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010525,
					"content": "西風騎士團的偵察騎士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "對，就是她！我之前在蒙德待過一段時間，當時得到了安柏很多幫助，說是她改變了我也不為過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010528,
					"content": "安柏她真的很厲害！熱愛生活，有正義感，不僅充滿行動力，也非常善解人意，總是能像一團火一樣照亮別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010529,
					"content": "在我看來，她是最適合做偵察騎士的人。因為幾乎每個踏入蒙德的人，都會先遇到她，然後被她的熱情感染，愛上那片土地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010530,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010531,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "唔，雖然總覺得偵察騎士的工作目的並不是這樣，不過我已經十分深刻地感覺到了，柯萊妳真的很喜歡安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010534,
					"content": "咳…不、不好意思，剛才我好像說了一些奇怪的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010535,
					"content": "嘻嘻，沒關係啦，知道妳是安柏的朋友後，感覺一下子和妳親近了不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010536,
					"content": "不過妳是怎麼知道我們也認識安柏的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010537,
					"content": "啊，是這樣的，我回到須彌之後，也一直和安柏保持著書信聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010538,
					"content": "她在信裡講過蒙德城遭到飛龍襲擊的事，說有一個金髮的旅行者和飄浮的夥伴幫忙化解了危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010539,
					"content": "#所以昨天一見到{F#妳}{M#你}們，我就認出{F#妳}{M#你}們了。不過當時因為旅行者剛從昏迷中醒來，我就不好意思提起這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010540,
					"content": "原來是這樣呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010541,
					"content": "#嗯！所以請{F#妳}{M#你}們放心，我絕對是信任{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010542,
					"content": "#我也想多告訴{F#妳}{M#你}們一些草神大人的事，但我很長時間都不在須彌生活，而且也沒讀過什麼書…不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010543,
					"content": "沒關係啦，妳剛才告訴我們的情報也很有價值。畢竟我們之前，連「大慈樹王」、「淨善宮」什麼的都沒聽說過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010544,
					"content": "#能幫上一點忙就好。不過{F#妳}{M#你}們為什麼要打聽草神的消息呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010545,
					"content": "向柯萊簡單講述了旅行的目的…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "#原來如此。謝謝{F#妳}{M#你}們願意告訴我這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010547,
					"content": "不用客氣，畢竟我們是朋友呀，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010548,
					"content": "派蒙說得沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "好，那我們現在就去上面清潔神像吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30010550,
					"content": "#嗯，辛苦{F#妳}{M#你}們了。我去前面檢查一下遮雨棚的情況，等一下我們就在這附近會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30010532,
					"content": "原來妳是這樣的柯萊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "蒙德城的狂熱飛行愛好者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "（也是在坎瑞亞那時嗎…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "這種程度小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
