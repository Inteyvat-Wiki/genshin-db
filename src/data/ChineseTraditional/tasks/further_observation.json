			},
			"dialogs": [
				{
					"id": 30015101,
					"content": "#我不太擅長攀爬，神像的清潔就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30015102
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30015102,
					"content": "我去檢查一下前面的設施。完工之後，如果可以的話…能和我再多聊聊嗎？",
