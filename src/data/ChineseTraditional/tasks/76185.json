			"dialogs": [
				{
					"id": 761850101,
					"content": "嗯，美味的茶水點心。多謝桑多涅小姐的招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850102,
					"content": "沒什麼，妳中意就好。我還帶了一些阿舍魯喜歡的零食，對不對？阿舍魯？過來，乖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850103,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 761850104,
					"content": "希望妳同挪德卡萊，以及同「秘聞館」的這份情誼，能夠對未來我們之間的合作有所益處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850105,
					"content": "嗯，我也希望如此。來，阿舍魯，嚐嚐這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850106,
					"content": "另外，關於之前向桑多涅小姐打聽的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850107,
					"content": "哈哈，你這小肉球真軟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850109,
					"content": "桑多涅小姐…妳該不會是藉茶會的名義來我這裡揉貓的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850110,
					"content": "欸…？有、有嗎？沒有的事！和「秘聞館」的往來我也放在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850111,
					"content": "過來，阿舍魯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850112,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 761850113,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850114,
					"content": "那我們具體聊聊「往來」相關的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850115,
					"content": "嘖…有…就算有一點點是想揉貓又怎樣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850116,
					"content": "平時很多小動物都不喜歡機械，好不容易前段時間在這裡研究「數秘陣列」和阿舍魯混熟了，揉一下又怎樣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850117,
					"content": "哈…好吧好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850118,
					"content": "去吧，阿舍魯。反正我也管不了你喜歡蹭誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850119,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 761850120,
					"content": "揉個痛快之後別忘了聊正事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761850121,
					"content": "說了我有放在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
