				},
				{
					"id": 761850202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850204,
					"content": "哦，慢走。有空常來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
