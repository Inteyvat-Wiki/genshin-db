			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "這個遺蹟裡的氣氛，總感覺讓人不是很舒服，不過，這應該就是這個遺蹟的盡頭了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710050202,
					"content": "這一趟也算是有所收穫啦，嘿嘿，還拿到了那枚戒指。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710050203,
					"content": "我們快出去，找一些<color=#00E1FFFF>懂古玩的人</color>來看看，這個寶物到底能賣多少錢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
