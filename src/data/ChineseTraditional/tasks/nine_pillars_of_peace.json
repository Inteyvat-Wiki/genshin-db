					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "我再想想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "您…也行吧，您再想想，要論價錢，我說不定不是開價最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050503,
					"content": "但要是論生意，您把戒指賣我，我絕不會虧您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050504,
					"content": "您想，這寶貝戒指哪能是一錘子買賣，您把戒指賣我，要是以後有什麼後續買賣，我還不得先來告訴您？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050505,
					"content": "再說了，我不還會搭您點東西嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050506,
					"content": "您好好想，好好想啊，要是願意把戒指賣給我，您儘管來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
