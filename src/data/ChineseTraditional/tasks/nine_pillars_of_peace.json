			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "想請妳看樣古玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "古玩？嗯，你算是找對人了，這璃月港裡，我對古玩的估價最公道了，拿出來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050903,
					"content": "嗯，玉石和戒身都是不錯的材質。年代似乎也很久遠了…唔，戒指保存得也很完好，真是難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050904,
					"content": "不過，「世間紛難，眾生皆苦」這句銘文我倒是沒聽過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050905,
					"content": "#算了，{F#妳}{M#你}是從哪裡拿到這枚戒指的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050906,
					"content": "翠玦坡旁的遺蹟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "#翠玦坡旁的遺蹟…居然敢去那裡尋寶，那{F#妳}{M#你}的身手還挺不錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050908,
					"content": "那片遺蹟，周圍是不是有九根柱子，中間還有一塊石碑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050909,
					"content": "別這麼驚訝，我經常聽來我這裡做生意的人提起那片遺蹟，說是那麼大的陣仗，裡面一定埋著好寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050910,
					"content": "有些人還說，這些柱子和裡面的那個遺蹟，都是璃月先民們為了鎮壓戰亂而建造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050911,
					"content": "不過，這大概也就是傳說罷了，九根石頭柱子就能鎮壓戰亂的話，那這個世界早就太平了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050912,
					"content": "但無論這些傳說到底是真是假，這枚戒指既然是那片遺蹟裡的，自然也和這些傳說有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050913,
					"content": "既能套上名頭，又有來歷可說，本身品質也不錯，自然也能賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050914,
					"content": "#…放心，我不會追問{F#妳}{M#你}是怎麼打開那片遺蹟的。我只是做生意而已，其餘的事，和我沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050915,
					"content": "總之，這枚戒指，我出<color=#00E1FFFF>200000摩拉</color>，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
