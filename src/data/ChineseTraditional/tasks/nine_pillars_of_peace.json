			"dialogs": [
				{
					"id": 710050401,
					"content": "我賣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "好！爽快，這是錢，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050403,
					"content": "哎喲，這戒指可是個寶貝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050404,
					"content": "那片遺蹟裡面，肯定還有其他寶貝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
		{
			"id": 7100505,
			"completionStepIds": [
				7100535
			],
