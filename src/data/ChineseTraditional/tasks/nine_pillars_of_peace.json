			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "想請妳看樣古玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "古玩啊，我可不太瞭解…不過，還是先拿出來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050303,
					"content": "這枚戒指…我看看，粗琢的玉石，喲呵，這玉石的料子還不錯，光是這顆玉石就能值點錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050304,
					"content": "這戒托…裡頭還刻著字，「世間紛難，眾生皆苦」…這戒指，您是從哪拿出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050305,
					"content": "翠玦坡旁的遺蹟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "翠玦坡，翠玦坡…嘖嘖，可惜了，旁邊就是絕雲間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050307,
					"content": "要是這戒指是從絕雲間裡的哪個遺蹟中帶出來的，那一定能賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050308,
					"content": "可惜了，沒點來頭，這價錢得低不少。不過這戒指的品相不錯，單賣出去也肯定有人要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "博來"
				},
				{
					"id": 710050309,
					"content": "這樣，我出<color=#00E1FFFF>180000摩拉</color>，再搭您點東西，您看，願意把這戒指出給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
