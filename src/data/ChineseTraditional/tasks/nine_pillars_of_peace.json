			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "「貪心、眷戀、凝視、妒忌、嗔怒、惡欲、自矜、競奪、動亂…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051202,
					"content": "「此凡心九種，既可助世，又可亂世，不褪不滅，綿延不絕…故立九柱以靖世，鎮世間紛戰於此。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051203,
					"content": "「若有後世者破靖世九柱入內，世間必刀兵又起。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051204,
					"content": "「正讀此碑者，可自取室內寶器，鎮守璃月八方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銘文"
				}
			]
		},
