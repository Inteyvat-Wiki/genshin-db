			"trigger": {
				"objectNames": [
					"蒂蕾娜",
					"昂吉安妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745170101,
					"content": "#果然，這邊剛剛擺開兵棋，準備好想定的戰術，準領隊{NICKNAME}就出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170102
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170102,
					"content": "不是吧，還真應了那句傳聞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170103,
					"content": "「感知到戰術對抗的火熱溫度後，準領隊必將如槍彈般趕來，給出最準狠的指揮…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170104,
						745170105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170104,
					"content": "看來我來得正是時候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				},
				{
					"id": 745170106,
					"content": "懂了，您覺得目前的銃槍的彈頭初速還能再提高，我也有這種感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170107
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170107,
					"content": "#哎，蒂蕾娜，妳先收斂一點！好不容易把{NICKNAME}吸引過來，正事優先！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170108,
					"content": "我懂我懂，關於銃槍的發展方向，可以稍後再閒聊。現在，準領隊應該狀態絕佳，隨時可以大展身手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170109,
						745170111
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170109,
					"content": "是新的桌上推演嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170110
					]
				},
				{
					"id": 745170110,
					"content": "沒錯！根據特巡隊面臨的作戰環境，更新了推演各類設計和規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170113,
					"content": "總之，現在的推演變得更有挑戰性了，還準備了不少特別的想定，包括特巡隊精銳留下的難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170114,
					"content": "有的想定，我應付起來都觸角發麻。就讓我見識一下吧，準領隊帶兵打仗的能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170115,
					"content": "辛苦費好談喔，肯定能讓您玩個痛快又大賺一筆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170116,
						745170117
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170116,
					"content": "那我就好好展現準領隊的能力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170118,
					"content": "#妳就看著吧，蒂蕾娜，就算{NICKNAME}認認真真，也會被第三個進攻想定卡住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170119
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170119,
					"content": "#那關也不可能難住{M#他}{F#她}！只是教官現在閒了太久，變弱了而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170120
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170120,
					"content": "妳這傢伙！我…妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170121
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170121,
					"content": "我和妳打賭喔，教官！就賭…夏沃蕾隊長同款的那種限量競賽彈藥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170117,
					"content": "拿錢玩推演，這事我在行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170111,
					"content": "其實還沒太看懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170112
					]
				},
				{
					"id": 745170112,
					"content": "簡單說來，之前我們在璃月舉行了一場聯合推演。回來後，我們又按照特巡隊面臨的作戰環境，更新了多種設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170105,
					"content": "槍彈的比喻不如閃電…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				}
			]
		}
	]
}