			"dialogs": [
				{
					"id": 750530301,
					"content": "已經沒有獎賞，自然沒有，「目隨羽視」挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530302,
					"content": "難道有，其他的，問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530303,
					"content": "關於「目隨羽視」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "那是，很久以前，部族，流傳下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530305,
					"content": "因為「花羽會」，銳利的眼睛，很是重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530306,
					"content": "這一代，就由，我來主持，負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530307,
					"content": "為什麼說話很慢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "以前，受過傷，從很高的地方…摔下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530309,
					"content": "喉嚨，和胸口，讓我不能…如以往一樣，說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530310,
					"content": "但我，不覺得…現在…很糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530311,
					"content": "不，沒什麼問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "#祝福{F#妳}{M#你}…再見。",
