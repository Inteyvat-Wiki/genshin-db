			"dialogs": [
				{
					"id": 750530101,
					"content": "哦，異邦人，眼神不錯…怎麼樣，來試試看「目隨羽視」的挑戰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530102,
					"content": "鍛煉視力…也可以得到嘉獎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530103,
					"content": "哦哦，真是簡潔的說明…也像是什麼都沒說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530104,
					"content": "#詳細的規則還在後頭，如果{F#妳}{M#你}們…想要試試看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530105,
					"content": "那就聽聽看吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "三隻絨翼龍，會往外飛，盯住中間那隻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530107,
					"content": "等牠們都飛回來，<color=#00E1FFFF>認出…原本在中間的那隻</color>，就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530108,
					"content": "唔…也就是說，這三隻會在空中變換位置，我們要找到原本在中間的那隻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530109,
					"content": "很對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530110,
					"content": "怪不得說這個挑戰有辦法鍛煉視力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530111,
					"content": "先來點，簡單的，試試水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530112,
					"content": "如果沒問題，我們再，正式玩一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530113,
					"content": "#挑戰成功，獎勵歸{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530114,
					"content": "還有別的事，之後再來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "好，反正，我一直在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530116,
					"content": "那就試試看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "準備好，就擊打，靶子，開始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				}
			]
