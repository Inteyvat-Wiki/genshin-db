					"「八寶」",
					"「昆布丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "汝等找到牠們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100402,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "汝等，為什麼總是不聽奴家的話呢？為什麼不能像「阿飯」那樣聽話呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100404,
					"content": "「阿飯」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "確實是用好東西當名字呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100406,
					"content": "喵，喵喵喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "「八寶」"
				},
				{
					"id": 722100407,
					"content": "喵！喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100408,
					"content": "不許和奴家頂嘴！不然以後奴家可不去找汝等了，就給奴家從…從太陽還在天上，餓到月亮到天上，再餓到太陽跑到天上，然後再自己想辦法回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100409,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100410,
					"content": "呵呵，這才是好孩子，好了，回來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100411,
					"content": "多虧汝等了，要是沒有汝等幫忙，這小傢伙們又要在野外挨餓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100412,
					"content": "牠們應該能自己回來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
