						722100202
					],
					"speakerTitle": "「八寶」"
				},
				{
					"id": 722100202,
					"content": "啊，牠應該就是是寢子說的「八寶」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100203,
						722100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100203,
					"content": "聽話，過來吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100204
					]
				},
				{
					"id": 722100204,
					"content": "喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "「八寶」"
				},
				{
					"id": 722100207,
					"content": "嗚哇，好聽話的小貓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100205,
					"content": "喵，喵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100206
					]
				},
				{
					"id": 722100206,
