			"dialogs": [
				{
					"id": 722100301,
					"content": "喵！喵喵，喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100302,
					"content": "嗚啊！好、好兇的小貓，小心點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100303,
					"content": "喵，喵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "喵喵？喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100307,
					"content": "#嘿嘿，雖然很兇，但還是乖乖讓{F#妳}{M#你}抱著了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100305,
					"content": "我是來帶你回家的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "喵！喵…喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "「昆布丸」"
				}
			]
		},
		{
