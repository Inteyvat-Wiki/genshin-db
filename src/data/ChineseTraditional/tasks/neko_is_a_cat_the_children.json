			"trigger": {
				"objectNames": [
					"「寢子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "哎呀…喵喵，跑到哪裡去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "是汝等啊。有些小傢伙不知道跑到哪裡玩了，真是令人擔心哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100104,
					"content": "外面可是很危險的。雖然奴家教過牠們很多次了。外面又有拿棒子的毛茸茸人，又有…圓形的水和火的東西，可是相當危險哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100105,
					"content": "如果跑到酥酥麻麻裡面去，還會弄得全身的毛都豎起來。這種滋味，奴家可不希望小傢伙們也體會到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100106,
					"content": "但總有幾個不聽話的小傢伙到處亂跑，奴家每次都要費很大勁把牠們找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100107,
					"content": "今天又有幾個不知道跑到哪去了。好擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100108,
					"content": "汝也幫奴家。找到「昆布丸」和「八寶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100109,
					"content": "「昆布丸」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "是個好孩子。這一代昆布丸很聰明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100111,
					"content": "「這一代」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "阿響有時候會說到的東西。奴家也不知道是什麼，但看她說的時候的表情，那應該是好東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100113,
					"content": "奴家會用好東西給小傢伙取名字。等小傢伙長大了、走了以後，奴家就會用這些名字，給更小更小的小傢伙取名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100114,
					"content": "「昆布丸」喜歡在高的地方睡覺。去好高好高的地方找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100115,
					"content": "那，「八寶」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "非常機靈的小傢伙。很喜歡吃魚。所以，有時候會在海邊找被沖到岸上的魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100117,
					"content": "但是，很危險。水可是可怕的東西。好久好久以前，有個叫「吾輩」的小傢伙就掉到水裡去，差點就回不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100118,
					"content": "「八寶」應該在海邊看，有沒有小魚和螃蟹。去有鹹水的地方找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100119,
					"content": "太寬泛了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "總之，就是，好高好高，還有鹹水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100121,
					"content": "總、總之，把地圖拿出來讓寢子看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100122,
					"content": "#汝啊，悟性不行哪。{F#妳}{M#你}看，這裡就是好高好高。這裡就是鹹水。牠們一定在這兩個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100123,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "那就拜託汝等了，喵喵，這些孩子可真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100125,
					"content": "我不擅長抓貓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "喵喵，沒關係，那些孩子都不怕人的…不如說，正是因為沒人陪牠們玩，牠們才會到處亂跑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722100127,
					"content": "那就拜託汝等了，喵喵，這些孩子可真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
