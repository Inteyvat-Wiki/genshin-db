			"dialogs": [
				{
					"id": 716540201,
					"content": "哇…這壺裡的空間，好像比萍姥姥那盞更大呢，中間還有一棟好大的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540202,
					"content": "不過，周圍卻沒什麼東西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540203,
					"content": "派蒙去開鑿石頭，再造一間屋子吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "#鑿不動！{F#妳}{M#你}自己不是拿著劍嗎？{F#妳}{M#你}自己去鑿啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540207,
					"content": "哎，不過除了那間房子之外，這周圍怎麼空蕩蕩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540208,
					"content": "欸？等等，那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540205,
					"content": "派蒙去挖個地洞，暫時住進去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "明明有房子，為什麼還要我去挖地洞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "派蒙"
				}
			]
		}
