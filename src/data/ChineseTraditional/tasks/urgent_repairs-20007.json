				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#謝、謝謝{F#妳}{M#你}，{NICKNAME}，太好了，我還以為這次完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070102,
					"content": "這車上都是獵手們辛苦狩獵的成果，杜拉夫先生要我送去蒙德城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070103,
					"content": "雖然我不…太擅長狩獵，但是押送這麼簡單的活，應該還是能做的，我一開始是這麼想的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070104,
					"content": "#但還是差點搞砸了。突然被這麼襲擊，肯定是因為這些獵物太好了，那群傢伙也想要，還好{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070105,
					"content": "呃，雖然很不好意思，但是…剛才被襲擊的時候，貨車也被弄壞了，想要離開這，我必須把車修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070106,
					"content": "周圍的樹林裡應該有能用的材料。但是獵物還在車裡，走開的話我實在很擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 200070107,
					"content": "#如果可以的話，{F#妳}{M#你}能幫我從周圍找一塊<color=#00E1FFFF>結實的木板</color>來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾倫"
				}
			]
		},
		{
			"id": 2000702,
