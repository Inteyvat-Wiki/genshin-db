			},
			"dialogs": [
				{
					"id": 730090301,
					"content": "（拉娜依舊沉睡著。蘭拉娜並不在周圍。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730090302,
					"content": "（從包裹拉娜的「氣泡」當中隱約有什麼景象浮現出來…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730090303,
					"content": "（沉浸到景象中去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "#{F#妳}{M#你}身處叢林當中，一切都是無比巨大，又無比幽深。但{F#妳}{M#你}在其中十分自在。\\n偶然透過樹葉灑落的陽光如同金箔一般閃閃發亮，與{F#妳}{M#你}一般高的野草低聲地嬉笑著，在{F#妳}{M#你}走過時輕輕觸碰{F#妳}{M#你}的手。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "#聆聽風中樹木的哼唱與流水的奏樂時，{F#妳}{M#你}注意到了不安的哭聲。循著聲音，{F#妳}{M#你}找到了一個小小的人。\\n似乎是因為哭得累了，她趴在草甸中睡著了。{F#妳}{M#你}走到她的身邊，輕輕唱起了能令生靈平靜的歌…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "（…拉娜的狀況似乎沒有惡化。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730090307,
					"content": "（靜靜離開吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7300904,
