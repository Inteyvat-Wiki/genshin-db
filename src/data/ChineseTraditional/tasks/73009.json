					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730090202,
					"content": "（要早點讓拉娜恢復…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "（悄悄離開吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
