			},
			"dialogs": [
				{
					"id": 730090801,
					"content": "要準備無憂節，還有什麼要做的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090802
					]
				},
				{
					"id": 730090802,
					"content": "說到這個，蘭加惟應該在桓那蘭那的中心。既然要辦無憂節，他應該也有需要幫忙的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
