			"dialogs": [
				{
					"id": 730091001,
					"content": "關於「恆素果」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "那是充滿了力量的果實。它汲取大地中的記憶與夢生長，再經蘭那羅與那菈的努力才能結出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730091003,
					"content": "以恆素果的力量供養「覺王之樹」，就能結出惟耶之實。那是樹王親自種下的偉大之樹，也是蘭那羅一族的原點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
			"id": 7300911,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
