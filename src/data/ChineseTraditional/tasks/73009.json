					"蘭拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091101,
					"content": "關於「森林書」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#那是那菈法留納留下的東西。{M#她}{F#他}是一個金燦燦的那菈，與{F#妳}{M#你}一樣善良、勇敢、正直。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730091103,
					"content": "#還記得那個時期的蘭那羅，都十分想念{M#她}{F#他}，也熱愛{M#她}{F#他}的故事。但老身相信，既然如今有了那菈{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
			"id": 7300912,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300902",
							"2"
						],
						"stepId": 7300902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091201,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091202
					]
				},
				{
					"id": 730091202,
					"content": "#嗯。老夫很期待和{F#妳}{M#你}們一起度過無憂節哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
			"id": 7300913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300906",
							"2"
						],
						"stepId": 7300906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#老身能過上無憂節，都是託了那菈{NICKNAME}和派蒙的福。謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730091302,
					"content": "#老身很遺憾，無法像蘭羅摩他們那樣，和{F#妳}{M#你}一起在外冒險，也不能幫助{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730091303,
					"content": "#但是，這個夢永遠歡迎{F#妳}{M#你}們。如果對外面的世界感覺累了，就到桓那蘭那來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
