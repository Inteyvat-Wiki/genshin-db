			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090901,
					"content": "關於「無留陀」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090902
					]
				},
				{
					"id": 730090902,
					"content": "那是很久以前的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090903
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090903,
					"content": "在過去，蘭那羅行走在大地上，和那菈及萬物為友，而林中也沒有無留陀。直到在很多很多個月亮以前的一次災難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090904
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090904,
					"content": "樹王歸還了沙恆，無留陀開始在地上肆虐。而叢林終於恢復生機後，蘭那羅為了保護自己，將真正的桓那蘭那藏在了夢中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090905
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090905,
					"content": "森林本不知死為何物。直到有一天，樹想起大地中充滿了凋敗的花、死去的獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090906
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090906,
					"content": "正如在同一天，大地想起也許自己曾經將要吞食漆黑的毒血。河流想到太陽降下，蒸發了所有水的紅色的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090907
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090907,
					"content": "他們明白了，萬物都將無可避免地死去。這時，「無留陀」就誕生了。此乃「死」之名，知曉它存在的，終究會死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090908
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090908,
					"content": "無留陀的力量就是令一切走向死。而高大、陰暗、扭曲的東西就是無留陀選中的化身，帶來死的使徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090909
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090909,
					"content": "當然了，在老身的故事中，無留陀的化身形態是不固定的。也許是走獸，也許是飛鳥，也許是那菈，也許是疫病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090910
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730090910,
					"content": "但故事究竟是故事，那已經不是老身的記憶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				}
			]
		},
		{
			"id": 7300910,
