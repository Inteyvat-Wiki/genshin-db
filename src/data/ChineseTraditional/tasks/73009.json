				"objectNames": [
					"蘭拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "蘭拉娜會照顧她。因為她是最重要的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730090102,
					"content": "#那菈{NICKNAME}，請{F#妳}{M#你}去「桓那蘭那」唱「大夢的曲調」。然後請他們幫忙準備「惟耶之實」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730090103,
					"content": "聽不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "就像雲朵會明白要降下雨滴，雨水會明白要落入土地。種子會明白要茁壯成長，變成大樹，結出飽滿的果實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730090104,
					"content": "我、我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#那菈{NICKNAME}，看起來沒有明白，但是沒有關係。在正確的時候，那菈{NICKNAME}會明白應該做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "蘭拉娜"
				}
			]
		},
		{
			"id": 7300902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
