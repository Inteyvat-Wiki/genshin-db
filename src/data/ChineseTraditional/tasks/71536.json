			"dialogs": [
				{
					"id": 715360301,
					"content": "#原來是這樣…這份「祝柬」真好看，謝謝{F#妳}{M#你}，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 715360302,
					"content": "#我等會照著{F#妳}{M#你}教我的做法再做幾份，隨著禮物一起送給村裡人，他們一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "坎蒂絲"
				},
				{
