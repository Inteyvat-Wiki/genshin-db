			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "#旅行者，{F#妳}{M#你}…{F#妳}{M#你}還真的調了杯咖啡給我嗎？這真是不好意思，太麻煩{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130402,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "…這咖啡！比複律庭裡供應的那些咖啡好喝多了！不…不如說根本就是不同等級的咖啡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130405,
					"content": "要是能天天喝到這種咖啡，我也不會每天下午都昏昏欲睡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130406,
					"content": "#謝謝{F#妳}{M#你}的咖啡，喝完這杯之後，我又得去工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130407,
					"content": "要加油。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "那當然了。我必須得快點成長，早日成為洛耶茨先生那樣能獨當一面的人才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130410,
					"content": "唉，但在那之前，我還得做多少惡夢呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130408,
					"content": "打起精神來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "快喝吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
			"id": 2401331,
