			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "唉，我真是想不通，為什麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130102,
					"content": "艾尤恩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "#旅行者，真高興見到{F#妳}{M#你}。{F#妳}{M#你}是來喝咖啡的嗎？讓我來請{F#妳}{M#你}一杯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130105,
					"content": "你怎麼啦？看起來臉色好難看，是又被誰逼著熬夜了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130106,
					"content": "謝謝關心，這次是我自己的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130107,
					"content": "我最近正在思考…我工作的意義到底是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130108,
					"content": "我一直認為複律庭是一個公正、高效率，人人都願意互相幫助的強力機構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130109,
					"content": "在複律庭的管理下，整個楓丹廷都會朝著更好的方向發展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130110,
					"content": "但現在看來，它就像是一個破破爛爛的機關屋子。齒輪、槓桿、旋臂亂七八糟地鬆弛著…只有外殼一直保持光鮮亮麗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130111,
					"content": "它之所以能運轉起來，只是因為一系列的巧合與教訓，而不是精密地思考和設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130112,
					"content": "我…我想做點什麼，但根本無從下手。我怕只要做錯了一件事，就會讓這間機關屋子整個崩塌掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130113,
					"content": "雖然洛耶茨先生時常和我說，要我放寬心，就算我再怎麼犯錯，狀況也不可能比現在更糟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130114,
					"content": "這、這算是安慰嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130115,
					"content": "#唉，抱歉，我不該和{F#妳}{M#你}抱怨這些。我今天之所以出來散心，主要原因也是想暫時逃避這些事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130116,
					"content": "我調一杯咖啡給你吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "#真的？{F#妳}{M#你}會調咖啡嗎？真是太厲害了，我之前也想學，但總是沒時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130118,
					"content": "#那就拜託{F#妳}{M#你}了，我會在這裡等著的…希望工作別在咖啡廳裡追上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130103,
					"content": "今天你休息嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401302",
							"2"
