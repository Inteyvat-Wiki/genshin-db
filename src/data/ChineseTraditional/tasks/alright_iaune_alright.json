			"dialogs": [
				{
					"id": 240130301,
					"content": "唔…這次要用什麼材料來調製咖啡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
