			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿魯埃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "旅行者，您是來店裡幫忙的嗎？非常歡迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130202,
					"content": "不是啦，我們只是想調一杯咖啡給一個朋友，他現在好像…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130203,
					"content": "他現在有點難過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "#{F#妳}{M#你}們說的那個朋友。是坐在那邊的艾尤恩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130206,
					"content": "你認識他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "我和洛耶茨是老朋友了。他和我提起過，說他們辦公室裡來了一位聰明又勤懇的小夥子，就是艾尤恩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130208,
					"content": "不用擔心他。剛剛去複律庭裡工作的年輕人，總是會沮喪一段時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130209,
					"content": "等他們找到一個只屬於自己的位置後，心情就會放鬆下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130210,
					"content": "老闆，你怎麼這麼有經驗呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130211,
					"content": "因為我也曾經是複律庭裡一顆小小的螺絲釘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130212,
					"content": "但我不滿意自己只做個螺絲釘，就離開了我的職位，然後…來開了這家咖啡廳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130213,
					"content": "聽起來發生了很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "哈哈哈，也許吧。但現在我只不過是個咖啡廳的老闆罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130216,
					"content": "#好了，{F#妳}{M#你}們不是還要做一杯咖啡給艾尤恩嗎？我去調整一下儀器，{F#妳}{M#你}們準備好了就來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 240130214,
					"content": "總覺得這之中有很多故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "他現在壓力很大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
