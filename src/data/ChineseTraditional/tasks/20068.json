				"objectNames": [
					"葛瑞絲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "這些就足夠了，謝謝您，請您稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680402,
					"content": "這樣就可以了，請您把這份「蒙德薯餅」送給提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680403,
					"content": "請您以後別做這種…不好的事了，實在是得不償失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680404,
					"content": "希望您能記住我的告誡，別讓我和提米太失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680405,
					"content": "不過…唉，要是人人都能記住告誡，那維多利亞修女就不會那麼忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006803",
							"2"
						],
						"stepId": 2006803,
						"stateName": "QUEST_STATE_UNFINISHED"
