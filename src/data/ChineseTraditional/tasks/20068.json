					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "…吃吧，吃吧，吃好了就快點走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680302,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "#怎麼又是{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680308,
					"content": "#{F#妳}{M#你}到底想做什麼啊，難道還想對鴨子和鴿子下手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680309,
					"content": "這份薯餅是給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "薯餅？咦，你怎麼知道這個薯餅的做法的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680312,
					"content": "我知道了，你絕對是去找葛瑞絲媽媽了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680313,
					"content": "#哼，用這個就想收買我，{F#妳}{M#你}也想得太美了，{F#妳}{M#你}對鴿子和鴨子做的事，我比誰都清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680314,
					"content": "#…不過，葛瑞絲媽媽都讓{F#妳}{M#你}送這個薯餅來，肯定是不想我接著鬧下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680315,
					"content": "她還要照顧諾拉和葛蘿麗，我再給她添麻煩，就太不懂事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680316,
					"content": "#不過先說好，我可沒有原諒{F#妳}{M#你}！只是不想再給媽媽添麻煩了，知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680317,
					"content": "#哼，不過…反正我只是個小孩子，這種口頭的約定，{F#妳}{M#你}肯定說忘就忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680318,
					"content": "#等我爸爸回來了，我要再和他好好說說{F#妳}{M#你}的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 200680310,
					"content": "請收下這份薯餅吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "提米，那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "#怎麼又是{F#妳}{M#你}？你到底有完沒完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680304,
					"content": "發，發生什麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "#{F#妳}{M#你}還好意思問我！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				}
			]
		},
		{
			"id": 2006804,
			"completionStepIds": [
				2006804
			],
