			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞絲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680501,
					"content": "請您快把薯餅送去給提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680502,
					"content": "提米說的媽媽…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "是我。我一直在照顧著一些需要照顧的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680504,
					"content": "提米是我照顧時間最長的，逐漸就叫我「葛瑞絲媽媽」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680505,
					"content": "但是，我終歸不是他真正的家人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680506,
					"content": "提米為什麼會這麼生氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "您…您怎麼會問出這種問題來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680508,
