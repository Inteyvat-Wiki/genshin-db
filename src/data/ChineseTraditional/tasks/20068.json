			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞絲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "唉，這可怎麼辦才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680102,
					"content": "呃，發生什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "是您啊，您來得正好。提米已經把您對鴨子做的事告訴我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680104,
					"content": "您…您…唉，我該怎麼說您好呢，您的事蹟我也不是沒聽說過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680105,
					"content": "您的那些勇氣和力量…怎麼能用在這種地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680106,
					"content": "實在是太餓了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "您…如果真的肚子餓的話，可以去正經工作賺錢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680110,
					"content": "以您的實力，在冒險家協會絕對能占得一席之地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680113,
					"content": "唉，事情已經發生了，多說無益，提米因為這件事已經悶悶不樂很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680114,
					"content": "我曾經從提米的…父親那裡，學過一道菜譜。加入了「慕風蘑菇」的「蒙德薯餅」，是提米最喜歡吃的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680115,
					"content": "您幫我找三個「慕風蘑菇」來吧，提米能吃到這個，心情應該會好些…您也能向他道歉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "那就請您快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680120,
					"content": "慕風蘑菇的話…我記得在城裡南邊房子的房檐下應該就能找到一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680121,
					"content": "請您快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680117,
					"content": "無論多少蘑菇都可以！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "只用三個就夠了。您拿那麼多，難道是準備以後每次惹提米生氣，就拿出來用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680107,
					"content": "只是失手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "失手打到鴿子和鴨子？那麼您遇見的那些強敵，一定也是您「失手」擊敗的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200680108,
					"content": "力量就是來自於這種平時的累積。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "您…您，我…算了，看來您的實力，確實是很全面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞絲"
				}
			]
		},
