				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇蕾娜妲",
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2515.692,
							415.747,
							4528.094
						],
						"pointId": 4515
					},
					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "這裡，這裡就是實驗工棚啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390802,
					"content": "嗯，那麼接下來要試驗的是「真視藥劑」，準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390803,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "唔…一定要小心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390805,
					"content": "#{F#妳}{M#你}從薇蕾娜妲手中接過藥劑，聞起來就像陽光下腐爛許久的已死海草，令人不禁喉頭作嘔…\\n{F#妳}{M#你}猶豫了半刻，將之一飲而盡。藥液卻並不難喝，準確來說，缺少任何可以分辨的口味…\\n除此之外，{F#妳}{M#你}的身體再無其他反應。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "#然後，在薇蕾娜妲指示下，{F#妳}{M#你}休息了一段時間，並沒有發生什麼變化。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "但是，不久後…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "看樣子還是沒什麼變化…呼，幸好不用操心啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390809,
					"content": "#嗯，不過…{NICKNAME}剛剛愣了一下？怎麼了？看到什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390810,
					"content": "我看到了…半截半透明的船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "嗯？有趣！但是…唔…還有更詳細的描述嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390812,
					"content": "它的距離很遠，我沒看清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#很有趣，嗯！…但不能作為藥效的具體證明…因為{NICKNAME}無法證明是不是把遠處的礁石或者船骸看成了「幽靈船」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390814,
					"content": "所以…唉，這次試驗還是沒有成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390818,
					"content": "#謝謝{F#妳}{M#你}們，這次收集到了不得了的筆記！一定可以用在下一次配藥中的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390819,
					"content": "唔嗯…「雖然聽到了很熟悉的說法…」嗯，「但仍舊需要多加考察，調查是否有其他人目睹該種跡象」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390820,
					"content": "欸…也就是說，妳還要找別人試藥呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390821,
					"content": "嗯，沒錯。因為…唔…只有找到兩個以上可靠的目擊者，我們才能確認藥劑真的能讓人看到「真實的東西」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390822,
					"content": "因為「真實」的東西不會受到目光與思緒的束縛，不會因一個人的心而扭曲變形…而是一直一直存在在那裡，就那樣存在著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390823,
					"content": "嗯…就像…能活好幾千歲的神那樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390824,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390825,
					"content": "不，就像白色的細砂、海星的屍骸、搖呀搖的波浪那樣…這些才是「真實」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390826,
					"content": "但藥劑師大人也說過…經由夢和回憶，也能創造出新的「真實」。這個自相矛盾的說法，薇蕾娜妲不懂…但正在努力弄懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390827,
					"content": "嗚哇…話題突然變得好深奧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390828,
					"content": "#哈哈，那就不聊深奧的話題好了！總之，薇蕾娜妲謝謝{F#妳}{M#你}們幫忙！請收下這些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390829,
					"content": "#嗯…還有，下次調配出新藥劑時，也請{F#妳}{M#你}們一定要來呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390815,
					"content": "看起來像是被某種巨大的東西切斷的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390817,
					"content": "#啊，對不起！剛剛…有點分心了。但…但薇蕾娜妲把剛剛的資訊記下來了，謝謝{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "薇蕾娜妲"
				}
			]
		},
