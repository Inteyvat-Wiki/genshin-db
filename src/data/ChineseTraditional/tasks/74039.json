						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "#所、所以，剛剛{NICKNAME}咻咻地就打敗了怪物，是因為「超厲害藥水」的效力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390602,
					"content": "沒錯，「超厲害藥水」讓我超厲害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "這是什麼好爛的廣告詞啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390604,
					"content": "#哇！謝謝！謝謝{F#妳}{M#你}們！果然是藥效的原因，真不愧是藥劑師大人的配方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390609,
					"content": "嗯，好，「超厲害藥水」的試驗告一段落！接下來，我們開始試驗…這個！「暖洋洋藥水」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390610,
					"content": "欸，這些名字都是妳自己取的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390611,
					"content": "不是啦，薇蕾娜妲不會取名字，所以只能讓別人幫忙取笨笨的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390612,
					"content": "也不要這麼說啦…對於藥水來說，一看就知道作用的名字才是好名字呢。妳看，是這個邏輯沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390613,
					"content": "第一次聽到的說法呢…不過沒錯，藥劑師大人就是這樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390614,
					"content": "#咳咳，不說其他的了！{NICKNAME}，{F#妳}{M#你}準備好試這瓶藥了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390615,
					"content": "嗯，我們開始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "嗚哇，這瓶聞起來也好不妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390617,
					"content": "#這瓶「暖洋洋藥水」，理論上可以讓{F#妳}{M#你}不怕寒冷，變得暖洋洋的！唔…理論上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390618,
					"content": "#{F#妳}{M#你}從薇蕾娜妲手中接過藥劑，聞起來像是積滿了灰塵的發霉老皮革…\\n{F#妳}{M#你}猶豫了半刻，一飲而盡，藥液卻並不難喝。帶著肉桂的香味與些許薑汁的辛辣…令{F#妳}{M#你}回想起雨天書房裡劈啪作響的壁爐。\\n除此之外，{F#妳}{M#你}的身體再無其他反應。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "#然後，在薇蕾娜妲指示下，{F#妳}{M#你}休息了一段時間。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "沒什麼感覺耶…滿甜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "欸？！可是…明明聞起來那麼刺鼻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390607,
					"content": "唔…這樣嗎？是哪裡搞錯了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390608,
					"content": "#{F#妳}{M#你}也不用太沮喪啦…反正、反正不難喝也沒有毒，就已經是好事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "派蒙"
				}
			]
		},
