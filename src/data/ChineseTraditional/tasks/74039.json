					}
				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "#薇蕾娜妲感謝{F#妳}{M#你}們能來幫忙！現在我們試試第一種藥吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}，不要喝太多呀！感覺不對就趕快吐出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390503,
					"content": "好啦，不用太擔心我，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "哼…我就是放不下心嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390505,
					"content": "我準備好了，把藥劑給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "#這瓶叫做「超厲害藥水」，理論上能讓{F#妳}{M#你}變得超厲害！嗯…理論上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390507,
					"content": "#{F#妳}{M#你}從薇蕾娜妲手中接過藥劑，一飲而盡。\\n儘管氣味刺鼻難忍，但令人意外的是，藥液口感清甜黏滯，並不難喝。\\n除此之外，{F#妳}{M#你}的身體再無其他反應。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "#然後，在薇蕾娜妲指示下，{F#妳}{M#你}們等到隙境原體活躍的時刻。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
