			"dialogs": [
				{
					"id": 750230701,
					"content": "呀！呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "好啦好啦，不要這麼急嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230703,
					"content": "說實話剛才我也替小傢伙捏了一把冷汗，為了追求真實感，炸藥的量也準備得相當充分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230704,
					"content": "區區爆炸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "唔呀呀呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "總之，有了這次的經驗，之後就知道如何改善了。謝謝幾位的協助，我們這就來看看成片的效果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230709,
					"content": "出乎意料的是，畫面中既沒有尾巴繫著紅絲巾的救星，也沒有發出滋滋聲的邪惡敵人，更沒有驚心動魄的爆炸場景，有的只是阿卡坦加不斷變換的表情…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "我變成主角了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230711,
					"content": "恭喜啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "這不對吧！難道是留影機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230714,
					"content": "這樣一說，這還真的是我第一次正式使用留影機…難不成是弄反了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230715,
					"content": "你說得倒是輕鬆，那我們剛才的辛苦不是都白費了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230716,
					"content": "嗚…嗚嗚…呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#明明{REALNAME[ID(2)|SHOWHOST(true)]}也很期待的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230718,
					"content": "抱歉抱歉，全都是我的錯！這樣好了，剛才就當是彩排，這次才是正式的，我一定拿出十二萬分的幹勁拍出最精彩的映影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230719,
					"content": "嗚…呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "興致很高的樣子呦，那就當你是願意的好了。但願這次別再出什麼差錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230721,
					"content": "於是又按照之前的流程走了一遍，總算是得到想要的結果…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "了不起！完美！只能說是超出預期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230723,
					"content": "這點小事輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "除了原本約定的報酬，這張畫片送給你們留作紀念吧。這怎麼說也算得上是我的得意之作，當然，也多虧了幾位的協助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230726,
					"content": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}威風凜凜的樣子，真的很不錯哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230727,
					"content": "呀！呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也很滿意，那就結果好一切都好囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230724,
					"content": "導演，我們的獎金呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "留影機的操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "就算是我也覺得太危險了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "對啊！萬一傷到誰或引發火災之類的就不好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "派蒙"
				}
			]
		},
