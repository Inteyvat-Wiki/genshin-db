			"dialogs": [
				{
					"id": 750230301,
					"content": "怎麼了，需要我重複一遍步驟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230302,
					"content": "再講一遍讓我聽聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "先是放置演出道具，木桶放在<color=#00E1FFFF>畫面中心但不會擋到主角和布景的位置</color>，元素誘餌放在<color=#00E1FFFF>敵方角色入場的方向</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230304,
					"content": "之後等需要的時候，再去<color=#00E1FFFF>引導敵方角色到木桶附近</color>，然後退到安全位置<color=#00E1FFFF>擊碎木桶</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230305,
					"content": "不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "那就萬事拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿卡坦加"
				}
			]
