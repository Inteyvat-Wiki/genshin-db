			"dialogs": [
				{
					"id": 760850101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760850102,
					"content": "#哎呀，她明明蒙著眼睛，我卻能感覺出她在盯著{F#妳}{M#你}呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760850103,
					"content": "唔…想嚐嚐酒館裡其他口味的飲品了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
