			"dialogs": [
				{
					"id": 760520401,
					"content": "我聞過這個氣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520402,
					"content": "噢？在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520403,
					"content": "桑多涅的房間。她看我好像對散發這種香味的飲品很感興趣，故意拿在手上大半天都沒喝完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520404,
					"content": "就像…在等我提問一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520405,
					"content": "那妳問了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520407,
					"content": "問了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520408,
					"content": "「妳不應該喝機油嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520409,
					"content": "她…怎麼說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520411,
					"content": "很難聽的話。不要學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520413,
					"content": "才喝一口就不感興趣了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520414,
					"content": "對不起，有點苦，不好喝。難怪桑多涅臉色那麼難看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520415,
					"content": "我覺得那個是因為別的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
