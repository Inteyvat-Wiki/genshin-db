			"dialogs": [
				{
					"id": 790580101,
					"content": "此處為短劇《絕境高飛》片場的棄用場景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580102,
					"content": "原本構想的故事是受困於神秘洞窟的水形幻靈，只能憑藉藏匿在書中的挖掘道具逃出生天的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580103,
					"content": "但是遭到了伊迪婭小姐的否定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580104,
					"content": "水形幻靈不依靠道具就能從洞窟裡鑽出來，非得把挖掘用具藏在書本的設計的確有點莫名奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580105,
					"content": "但、但這個絕對是個能夠受歡迎的好點子。如果能將想法展示給伊迪婭小姐看就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580106,
					"content": "不過，嗚，好像得先把<color=#00E1FFFF>被附近的丘丘人偷走的道具書</color>拿回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790580107,
					"content": "——「導演」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "片場備註"
				}
			]
		},
