			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇",
					"小雀兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "這是採給妳治嗓子的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "#朋友！{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010703,
					"content": "…我哪裡有這麼嬌弱，吹點風就嗓子啞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010704,
					"content": "不過，這些清心倒是正好來止止我師兄的頭痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010705,
					"content": "師妹，妳聽我說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010706,
					"content": "師兄，你先去避風的地方歇歇吧，我待會煮了糖水給你喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "小雀兒"
