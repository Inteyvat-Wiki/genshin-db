					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "這裡就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010402,
					"content": "到底是什麼事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "唉，還是我師妹小雀兒的事。我與她平日習武練功形影不離，她的功夫也不在我之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010404,
					"content": "但這次進絕雲間尋訪仙跡本就路途艱辛，她又愛說話，前幾天著了涼，嗓子也啞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010405,
					"content": "#我看朋友功夫也是不凡的，能不能請{F#妳}{M#你}幫我去旁邊的山崖頂上摘三朵清心回來，我給小雀兒泡水喝養養嗓子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010406,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "那就拜託朋友了，小雀兒太活潑了，我可不敢獨自去採藥，放她一個人在這。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010408,
					"content": "為什麼要避著她？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "讓朋友看笑話了，我師妹她從小就性子好強，萬事都不肯落了旁人半點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010410,
					"content": "要是當著她面說給她找藥養嗓子，她一定會和我賭氣不肯喝藥，所以只能避著她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010411,
					"content": "#我又不敢獨自去採藥，把她留在原地，所以只能拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
