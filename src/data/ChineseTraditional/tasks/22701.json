			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇",
					"小雀兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "是給妳師兄治頭痛的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "師兄，你若要去採藥，我幫你去採就是，何必拜託這外人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010603,
					"content": "再說了，這人不知來歷，說不定有什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010604,
					"content": "…好了，師妹，這位朋友是幫了我們的，不要這麼說人家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010605,
					"content": "#謝謝{F#妳}{M#你}，這些謝禮請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010606,
					"content": "收下了就快點走吧，我師兄頭痛吹不得風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010607,
					"content": "師兄，我們快點去那邊避避風，我煮點熱糖水給你喝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小雀兒"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
