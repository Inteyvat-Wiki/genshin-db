			"dialogs": [
				{
					"id": 227010101,
					"content": "這位朋友請留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010102,
					"content": "#看{F#妳}{M#你}步伐輕健，自有一番架勢，想必同我二人一樣，是習武之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "有話直說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "#我師兄同{F#妳}{M#你}搭話，{F#妳}{M#你}給我客氣點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010203,
					"content": "師妹，是我主動叫住這位朋友的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010204,
					"content": "只怕這人又是個想來絕雲間碰仙緣的投機賊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010205,
					"content": "#師妹，好了，好了，{F#妳}{M#你}先在這裡歇歇吧，我和這位朋友說幾句話就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010206,
					"content": "師兄，有什麼事不能當著我說的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010207,
					"content": "只是一些雜事，師妹妳肯定是不願意聽的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010208,
					"content": "哼，肯定又是要說古華派的事了…好啦，師兄你不願意我聽，我不聽就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 227010209,
					"content": "#這位朋友，請隨我去那邊，我再和{F#妳}{M#你}細細說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
