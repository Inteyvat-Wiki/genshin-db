			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "#{F#妳}{M#你}回來了，我所託之事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010502,
					"content": "已經採到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "#這些就可以了，謝謝朋友，容我找些謝禮給{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010504,
					"content": "#咦？{F#妳}{M#你}怎麼採了這麼多清心回來，師兄，你是不是又頭痛了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小雀兒"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
