				7110101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110101",
							"2"
						],
						"stepId": 7110101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"鍾離",
					"田鐵嘴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711010101,
					"content": "#{F#妳}{M#你}看，真的在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010102,
					"content": "喂——！鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010103,
					"content": "哦？二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010104,
					"content": "我們有話要問你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010105,
					"content": "可否稍待片刻？我正忙著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010106
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010106,
					"content": "你在幹嘛呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010107,
					"content": "話說回來，你居然這麼快就回到城裡了，可怕的速度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010108,
					"content": "鍾離兄，這兩位是你朋友？好像常來我這裡找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010109
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010109,
					"content": "都是相熟的朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010110,
					"content": "甚好甚好，既然二位有空，也一起幫我看看，怎麼才能說服鍾離兄把他那塊老石拿出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010111
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010111,
					"content": "老石？你要那個做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010112,
					"content": "二位有所不知，老石現在是炙手可熱的珍稀礦石，有市無價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010113
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010113,
					"content": "今天我照常在此說書，鍾離兄也照常溜達過來，坐下聽書。聊著聊著，便聊到了我的拿手好戲「創龍點睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010114,
						711010115
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010114,
					"content": "原來是那個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				},
				{
					"id": 711010116,
					"content": "不錯的說書吧？呵呵，鍾離兄也說，我說書有一手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010117
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010117,
					"content": "我只知道鍾離兄見多識廣，深諳民俗，卻沒想到，他對歷史、神話也頗有研究。這不，有問題總是問他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010118
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010118,
					"content": "能幫上小忙便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010119
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010119,
					"content": "哪裡哪裡，可幫了我不少！不過啊，聊天本就要跟有趣的人聊。比如鍾離兄，想法奇巧，牛自然也沒少吹，啊哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010120
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010120,
					"content": "好比有一回我同他說：你瞧我這故事裡，岩王帝君以靈石為本，雕刻出若陀龍王，日後又接那金戈鐵馬的橋段，過癮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010121
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010121,
					"content": "他卻說，故事萬般皆好，就是有些細節不對，例如有人考據過，岩王帝君或許手藝不佳，雕不出這麼精美的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010122
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010122,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010123
					]
				},
				{
					"id": 711010123,
					"content": "煞風景，是吧？上回我給他講輕策莊的螭化身為山水，鑄就一方美景。他也不認同，覺得天下哪有這種好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010124
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010124,
					"content": "唉你們說，人是不是見識多了就會缺乏詩意？瞧鍾離兄，儀表堂堂，骨子裡竟如此沒有情調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010125
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010125,
					"content": "田兄批評得句句在理，我定當牢記於心，好好反思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010126,
					"content": "不過田兄編故事向來天馬行空，我只是提出一些常人容易想到的意見，方便田兄參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010127
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010127,
					"content": "說書的都是聰明人，以田兄眼力，不可能看不出我這般衷心的聽眾是為何而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010128
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010128,
					"content": "當然當然！鍾離兄一番好意，我都明白。鍾離兄一定是希望我成為璃月港最好的說書先生，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010129,
						711010130
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010129,
					"content": "（我倒覺得你不是很明白…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010131,
					"content": "你說了這麼多，老石呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010132,
					"content": "#哎呀，言歸正傳言歸正傳。{F#妳}{M#你}們是不曉得，前幾天我又給人說了一出《創龍點睛》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010133
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010133,
					"content": "你這是炒冷飯，翻來覆去地炒呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010134,
					"content": "經典永流傳，懂嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010135
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010135,
					"content": "田兄的戲，總是要炒一遍冷飯的。說書是創作，編也要時間啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010136
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010136,
					"content": "還是鍾離兄明白。正巧那天有個外出打工的礦工頭子，路過我這兒，聽見這段說書，就跟我說啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010137
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010137,
					"content": "層岩巨淵你們知道嗎？那邊有種石頭，模樣漂亮，色澤幽雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010138
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010138,
					"content": "而這種石頭，就長在層岩巨淵裡一條長長的過道上…欸，他是這麼說的嗎？過道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010139
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010139,
					"content": "應該是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010140
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010140,
					"content": "嗨，層岩巨淵那般神秘，縱然是鍾離兄這麼有見識的人都沒機會去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010141
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010141,
					"content": "也就是最近那邊礦業恢復了些，才陸陸續續有人員流動。我們都是聽人說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010142
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010142,
					"content": "對，對。確有此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010143
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010143,
					"content": "人說，石頭長在過道上，過道又是怎麼來的呢？沒人清楚。只能看見那過道蜿蜒曲折，如同巨物拖行所留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010144
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010144,
					"content": "陣仗驚人，見者無不為之震撼！有人說，那裡恐怕是什麼上古戰場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010145
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010145,
					"content": "可究竟是誰和誰打出來的，我們無從考證。我便想著，說不定，岩王帝君和若陀龍王也在那裡打過架？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010146
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010146,
					"content": "不瞞各位說，我正在琢磨一段新說書，要是能把這個編進去，豈不是厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010147
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010147,
					"content": "所以啊，就叫來鍾離兄，請他賜教。沒想到，他手頭剛巧有一塊老石，是從集市的商人那兒淘來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010148
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010148,
					"content": "眼光好，自然會挑。我想著，這老石真能說是我故事的象徵了，鍾離兄要是願意，我也想將這石頭買來，做個紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010149
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010149,
					"content": "鍾離，你、你要把石頭給他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010150,
					"content": "嗯…田兄本就是說書人裡的佼佼者，我又是他的忠實聽眾。若能為田兄的創作盡一份綿力，我自當支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010151
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010151,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010152,
					"content": "可若我將石頭讓出去，倒顯得田兄的故事有紕漏。幾位還請想想，岩王帝君不是將那若陀龍王封入地下了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010153
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010153,
					"content": "據專家稱，層岩巨淵地下滿是洞穴與礦道，若陀龍王封在那處，定會三天兩頭遭人打擾。如此場面，莫非，也是岩王帝君的考量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010154
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010154,
					"content": "好有道理啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010155,
					"content": "倒也是…岩王帝君可不會做這般不周全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010156
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010156,
					"content": "嗯嗯對對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010157
					]
				},
				{
					"id": 711010157,
					"content": "唉，其實啊，我本想拿我最喜歡的這把扇子與鍾離兄交換…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010158
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010158,
					"content": "嗯？上面畫的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010159,
					"content": "正是本人說《創龍點睛》時最愛拿的扇子。游龍入雲，縱橫天下，志遠心高，浩瀚無垠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010160
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010160,
					"content": "哇…很少看到這樣的扇子呢，說得我都想要了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010161,
					"content": "對了，老石我們也有哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010162,
					"content": "什麼？！那、那二位是否願意將老石讓給我？我願以此扇交換！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010163
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010163,
					"content": "哎，田兄此言差矣。老石珍貴，你的扇子也絕非俗物。如此交換，倒是折了雙方仙氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010164
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010164,
					"content": "這…這也行嗎？我這扇子，倒是不止一把…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010165
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010165,
					"content": "田兄親手繪製，原是妙物。任何一個愛聽你說書的人，都會為收到如此厚禮而歡喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010166
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010166,
					"content": "當真？…也是，高山流水遇知音，比起其他，我更想讓人認可我說的故事。畫這些扇子，也是盼著有朝一日能送給有緣人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010167
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010167,
					"content": "既然如此，幾位也與我有緣，這扇子理應送給你們！稍等片刻，我這就去取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010168
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010168,
					"content": "田鐵嘴來去如風，飛快地取來兩把扇子贈予聽眾…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711010169
					]
				},
				{
					"id": 711010169,
					"content": "真的可以給我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010170
					]
				},
				{
					"id": 711010170,
					"content": "當然，您聽過我說書，自是緣分。再說我也畫了不止一把扇子，不給你們，還能給誰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010171
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010171,
					"content": "鍾離兄也不要客氣！自家製品，還請你別嫌棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010172
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010172,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010173
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010173,
					"content": "田兄一番心意，我就不客氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010174
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010174,
					"content": "…當真好扇，值得珍藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010175
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010175,
					"content": "啊對！我們是來找鍾離的，還想跟他聊些別的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010176,
					"content": "那我豈不是耽擱你們了？哎呀，快請快請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010177
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 711010177,
					"content": "何來耽擱一說。田兄，多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010178
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010178,
					"content": "鍾離，你是不是去過層岩巨淵了？還救了我們大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010179,
					"content": "謝謝你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010180
					]
				},
				{
					"id": 711010180,
					"content": "魈也說，要不是你特意出手相助，他恐怕無法逃生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010181,
					"content": "他竟這麼說？有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010182
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010182,
					"content": "時光荏苒，他也變得直白些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010183
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010183,
					"content": "所以，你又為什麼會去層岩巨淵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010184
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010184,
					"content": "唔？竟有此事？我也是第一次聽說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010185
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010185,
					"content": "欸？！你、你不要裝傻啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010186
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010186,
					"content": "哈哈，裝傻又是什麼說法。嗯，剛才那扇子，屬實不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010187
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010187,
					"content": "鍾離！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010188
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010188,
					"content": "…我是個閒人，四處逛逛本是應當。途中遇見什麼，那也是緣分所致，何須言謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010189
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010189,
					"content": "倒不如說，天下如此之大，到處逛逛，多走多看，才能常感懷念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010190
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010190,
					"content": "你很想念過去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010191
					]
				},
				{
					"id": 711010191,
					"content": "怎麼會。我現在是人，人總是活在當下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010192
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010192,
					"content": "游龍入雲，縱橫天下，志遠心高，浩瀚無垠。…不無道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010193
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010193,
					"content": "東西南北，何方不得意。天地山海，盡是玲瓏處。以後有時間，還得多出去走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010130,
					"content": "（他只是想說細節不對…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010115,
					"content": "我也有事沒事常回味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				}
			]
		}
	]
}