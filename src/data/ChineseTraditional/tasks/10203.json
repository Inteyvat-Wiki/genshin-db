			"dialogs": [
				{
					"id": 102030201,
					"content": "嗚…下次我會更小心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102030202,
					"content": "下一次，我會安全地完成一場偉大的冒險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102030203,
					"content": "我聽說「冒險家協會」也有一套冒險的守則，是不是應該去拜託他們呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030204
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102030204,
					"content": "唉，要是這段話被賽琉斯會長聽見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030205,
					"content": "他一定會去拜託琴團長，繼續加長可莉的禁閉時間吧…",
