				"points": []
			},
			"dialogs": [
				{
					"id": 102030101,
					"content": "呼…可莉這孩子，其實是我們西風騎士團的「火花騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030102,
					"content": "什麼？竟然連可莉都是騎士嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030103,
					"content": "那麼，可不可以給派蒙也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "沒錯，派蒙不甘心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030106,
					"content": "話說回來，稱號是「火花騎士」，也難怪可莉的寶物會是那種東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030107,
					"content": "嗯，雖然平時沒有少給騎士團添麻煩，但騎士們還是很關心她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030108,
					"content": "說起她的來歷，其實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030109,
					"content": "#總之，以後{F#妳}{M#你}會對她有更多瞭解的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030110,
					"content": "#到時也請{F#妳}{M#你}對她多關照些了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 102030104,
					"content": "而且聽起來比「榮譽騎士」還強？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
