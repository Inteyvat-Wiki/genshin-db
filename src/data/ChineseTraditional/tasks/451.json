			"dialogs": [
				{
					"id": 4510501,
					"content": "#啊，{F#妳}{M#你}們真的要幫忙嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510502,
					"content": "狼群有自己的方法，更有效。不過陷阱，很新鮮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510503,
					"content": "放置好以後，把野豬趕過去，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510504,
					"content": "不會爆炸吧…",
