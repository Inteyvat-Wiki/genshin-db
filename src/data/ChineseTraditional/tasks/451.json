			"dialogs": [
				{
					"id": 4510601,
					"content": "你看，我們弄到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510602,
					"content": "#謝謝{F#妳}{M#你}們。不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510603,
					"content": "不過要是我們自己來，能抓五六頭。有狼今晚要空肚子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510604,
					"content": "嗚啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510605,
					"content": "#不要在意，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510606,
					"content": "#{F#妳}{M#你}們比起騎士團那個紅色，看起來很燙的女孩子——朋友，要厲害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510607,
					"content": "她出手的話，大概山會燒起來。豬，一頭也抓不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510608,
					"content": "我該走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510609,
					"content": "#最近這裡不安全。{F#妳}{M#你}們小心，保護好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510610,
					"content": "真是奇特的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510611,
					"content": "他提到的騎士團那個朋友。紅色，很燙的女孩子——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}，{F#妳}{M#你}想到了誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
