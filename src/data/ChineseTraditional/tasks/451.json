			"dialogs": [
				{
					"id": 4510101,
					"content": "這裡叫做「奔狼領」，據說蒙德的人很少涉足這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510102,
					"content": "雖然就在蒙德城附近，但這裡生態原始，是一個自然法則至上的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510103,
					"content": "正所謂弱肉強食，連史萊姆都能長得很巨大哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510104,
					"content": "看，就是這——麼巨大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510105,
					"content": "…牠們進攻過來了！做好準備！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "謝…謝謝你——奔狼領的狼群來了！快逃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510303,
					"content": "#不用擔心。狼是朋友。可，{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510304,
					"content": "我們只是普通的旅行者……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510305,
					"content": "#不普通，{F#妳}{M#你}們。不過，有熟悉的氣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510306,
					"content": "熟悉的氣味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510307,
					"content": "騎士團，對吧？騎士團裡有朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510308,
					"content": "你叫什麼名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "我是雷澤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510311,
					"content": "你也是西風騎士團的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510312,
					"content": "和騎士團沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510314,
					"content": "嗚啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510315,
					"content": "狼群…是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "啊……狼群，是家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510317,
					"content": "家人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510318,
					"content": "家人。將我養大，和我一起生活的家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510319,
					"content": "好像這中間有很複雜的故事……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510320,
					"content": "#他們在責怪我。為了幫助{F#妳}{M#你}們，埋伏暴露了。沒有抓到野豬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510321,
					"content": "#這樣嗎…那就讓{NICKNAME}來幫忙抓野豬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME}也是很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510323,
					"content": "我，我覺得不必了。騎士團的朋友每次動手，狼群都要餓肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4510324,
					"content": "不用和我們客氣啦。你們就等著我們的好消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510309,
					"content": "你也是騎士團的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "我是雷澤。 和騎士團沒有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "雷澤"
				}
			]
		},
