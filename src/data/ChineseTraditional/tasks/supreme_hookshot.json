			"trigger": {
				"objectNames": [
					"凱萬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#喲，看{F#妳}{M#你}的樣子…是旅行者吧？居然會來這種地方閒逛，很有閒情雅致啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310102,
					"content": "#還是說，{F#妳}{M#你}也是釣魚客，相中了這片水域？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310103,
					"content": "眼光不錯！這裡是附近最好的釣魚點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310104,
					"content": "可這附近好像沒有其他人在釣魚啊？你怎麼這麼肯定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310105,
					"content": "那當然是因為我眼光獨到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310106,
					"content": "身為這一帶最厲害的漁師，選擇釣魚點的方法當然也有講究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310107,
					"content": "真…真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "你好像沒什麼收穫欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310109,
					"content": "#話都說到這份上了，就讓{F#妳}{M#你}們見識一下「魚鉤上的絕景」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310110,
					"content": "魚鉤上的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "#{F#妳}{M#你}給我特別的素材，我手製魚餌，釣出{F#妳}{M#你}從沒見過的「魚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310113,
					"content": "怎麼感覺有點可疑？手製魚餌真的有用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310114,
					"content": "試一試也無所謂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "爽快，我就喜歡和這樣的人打交道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310116,
					"content": "我的手製魚餌除了作為基底的日落果和小麥以外，還有一種賦予其靈性的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310111,
					"content": "絕景？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
