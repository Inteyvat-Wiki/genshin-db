			"dialogs": [
				{
					"id": 230310601,
					"content": "好極了，素材齊全了，看我製作獨一無二的魚餌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310602,
					"content": "凱萬熟練地製作了魚餌",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "好，開始釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310604,
					"content": "魚鉤入水深度合格…水流速度適中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310605,
					"content": "#{F#妳}{M#你}們要保持安靜，水裡的魚可是很敏感的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310606,
					"content": "岸邊的腳步聲也有可能驚動到牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310607,
					"content": "我站著不動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "#那{F#妳}{M#你}們就沉住氣，安心等待吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310610,
					"content": "凱萬釣到了一袋濕漉漉的東西",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "這是什麼嘛，根本不是魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310612,
					"content": "確實沒見過這種「魚」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "果然還是這樣啊，完全不意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310614,
					"content": "咳咳，異鄉人，心態放寬點，別太計較細節問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310615,
					"content": "魚鉤帶出水面的東西，都可以被看成是釣上來的「魚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310616,
					"content": "#不瞞{F#妳}{M#你}說，我這最厲害的漁師可不是自封的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310617,
					"content": "畢竟每次都釣上這種不會咬鉤的、不算活物的東西，也算是一種本事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310618,
					"content": "其他漁師也都讚嘆過我，說我有著獨一無二的才能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310619,
					"content": "他們可能是在安慰你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "簡單來說，就是除了魚之外什麼都釣的上來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230310622,
					"content": "咳！不管他們怎麼想都沒關係！至，至少我釣魚永不走空車！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310623,
					"content": "今天不行就明天再來，總有一天，我肯定能釣上來魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310624,
					"content": "#謝謝{F#妳}{M#你}們幫我去找素材，這些報酬給{F#妳}{M#你}，我要換個地方繼續釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310625,
					"content": "下次…下次我一定能釣到一條大魚！一定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310620,
					"content": "他們可能是在揶揄你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "派蒙腳不著地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
