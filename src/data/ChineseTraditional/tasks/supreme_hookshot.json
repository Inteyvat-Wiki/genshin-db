					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "根據今天的直覺…就用墩墩桃好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310203,
					"content": "雖然平常很常見，但很少有人把它當成魚餌的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230310204,
					"content": "#麻煩{F#妳}{M#你}們幫我找找這種素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱萬"
				}
			]
