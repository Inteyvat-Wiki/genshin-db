			},
			"dialogs": [
				{
					"id": 710540501,
					"content": "先清剿<color=#00E1FFFF>兵器營地</color>會更方便。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540502
					]
				},
				{
					"id": 710540502,
					"content": "好的，他們很快就會發現自己沒有武器可用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彥博"
