				"objectNames": [
					"彥博"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540301,
					"content": "我建議先處理<color=#00E1FFFF>炊事營地</color>。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "明白，我們會緊急把他們的伙食都運走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彥博"
				}
			]
		},
		{
			"id": 7105404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
