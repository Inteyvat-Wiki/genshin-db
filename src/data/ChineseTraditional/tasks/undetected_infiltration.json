			]
		},
		{
			"id": 7105407,
			"completionStepIds": [
				7105413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彥博",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "#真是精彩！感謝{F#妳}{M#你}的幫助，對了，這裡是說好的獎勵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540702,
					"content": "好耶！好多摩拉！欸…你什麼時候把衣服也換了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540723,
					"content": "#{F#妳}{M#你}們打架的時候呀…咳咳，呃，我是說，那不重要…為了防止{F#妳}{M#你}們打得興起，又把我們誤傷一遍，把制服換回來還是有必要的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540703,
					"content": "#千岩軍永遠感謝{F#妳}{M#你}們的幫助。啊，遵照我們的約定，請四處看看有沒有{F#妳}{M#你}需要的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540704,
					"content": "呃…我是說，除了那些我們正在查封的贓物以外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540705,
					"content": "恭喜你啦，任務圓滿完成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "#哈哈，當然，幸好有{F#妳}{M#你}們幫忙，我們才能這麼順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540709,
					"content": "#嗯，我的意思是…只要別像這些小賊一樣，凡事妄圖走捷徑，我們就不會找{F#妳}{M#你}的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540710,
					"content": "哼，我們才不是那樣的傢伙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540711,
					"content": "哈哈，說得也是呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540712,
					"content": "#唉，話說回來，像{F#妳}{M#你}這樣會使用元素力的人，不論行善或是作惡，都是不容小覷的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540713,
					"content": "我們需要幾個星期或者幾個月才能完成的任務，對你們來說可能是輕而易舉的事…而如果把元素力用來作惡的話，也會以很小的代價，造成恐怖的破壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540714,
					"content": "所以呀，我也並不覺得沒有「神之眼」是一件壞事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540715,
					"content": "#我曾見過有些人，為強求非人的力量而不惜付出自身生命的代價，最終卻只是做了別人的工具、傀儡，{F#妳}{M#你}說說，這值得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "這世上還是沒有神之眼的無力之人佔了多數，而真正能夠理解他們、保護他們的也多是同樣的普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540718,
					"content": "身為這樣的普通人，能夠為保護大多數人而履行職責，不得不說是我的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540719,
					"content": "如果哪天，不再有人獲得神之眼，甚至守護璃月港的仙人也逝去了…我想我也不會放棄這份職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540720,
					"content": "#啊，抱歉…自言自語扯了很多沒用的話，留{F#妳}{M#你}太久了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540721,
					"content": "好了，我們還需要查驗和登記贓物，就不多閒聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540722,
					"content": "#我代表同僚再次感謝{F#妳}{M#你}的幫助，願{F#妳}{M#你}今後的旅途一路順利。千岩牢固，重嶂不移。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540707,
					"content": "這下我們不用受牢獄之災了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
