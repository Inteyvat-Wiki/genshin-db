	"talks": [
		{
			"id": 7105401,
			"completionStepIds": [
				7105402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105402",
							"2"
						],
						"stepId": 7105402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彥博",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "停手，停手！請聽我們解釋！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540102,
					"content": "你們不是盜寶團嗎？乖乖去自首就好啦，有什麼好解釋的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540103,
					"content": "#千岩軍，層岩巨淵轄區，中隊長彥博。很高興見到{F#妳}{M#你}們，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540104,
					"content": "呃…和…很有名的小飛俠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540105,
					"content": "喂，怎麼到我這裡就忘了名字啦！我是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540106,
					"content": "哈哈…失禮、失禮。實在不好意思…但我們大概產生了一點小誤會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540107,
					"content": "等等…你們不是盜寶團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "當然不是，恰恰相反。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540112,
					"content": "咳咳，這麼說吧。這處作坊以前確實是盜寶團佔據的據點沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540113,
					"content": "工人撤走以後，那些見縫就鑽的傢伙就進來了…一開始還只是盜採礦石和琉璃晶砂搞走私，和我們的巡邏隊玩捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540114,
					"content": "後來他們賊膽愈來愈大，居然敢佔據礦工留下的舊倉庫，自己打造廉價的破爛首飾拿出去賣了！唉，真是…讓人看了心疼呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540115,
					"content": "讓人看了心疼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "這麼粗糙的首飾只能騙騙第一次來璃月的遊客，或者沒見識的讀書人吧…要想以低價打入璃月的市場？哼，恐怕是要砸牌子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540117,
					"content": "他們本來也沒有牌子呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540118,
					"content": "哈哈，妳說的沒錯。拿這些東西牟利發財，也太沒品味了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540119,
					"content": "所以我們來了，收拾了原來佔據這裡的盜寶團，裝扮成他們的樣子潛伏在了這裡…嗯，已經是前段時間的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540120,
					"content": "現在我們又摸清他們的頭目們與「愚人眾」的一支部隊有聯絡，疑似在交易什麼危險物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540121,
					"content": "關於愚人眾與盜寶團的聯絡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "儘管之前我們挫敗了愚人眾的圖謀，但他們在璃月的野外仍存在一些殘黨活動…這些傢伙的專業性和戰鬥力都不容小覷，對我們來說極其危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540123,
					"content": "假如盜寶團和他們沆瀣一氣，勾結起來對抗我們的話…會是一個很讓人頭疼的安全問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540126,
					"content": "總之，我們萬事俱備，只欠總攻。只需要把他們一鍋端，就能搞清楚他們在搗什麼鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540127,
					"content": "結果沒想到我們來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540128,
					"content": "#唉…我們知道{F#妳}{M#你}們很厲害，但沒想到這麼能打…現在可好，{F#妳}{M#你}們把我的隊伍打趴下了一大半…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540129,
					"content": "當然啦，我們駐紮在這裡另有一個原因是…此處恰好坐落了一座「七星陣法」的「磐鍵」。我們可不能讓它落在盜寶團這群心術不正的傢伙手裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540130,
					"content": "唔…抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "#哈哈哈，沒關係！我們沒看出是{F#妳}{M#你}們，是我們的過錯…此前就有命令下來要我為{F#妳}{M#你}們讓路，結果誰能想到{F#妳}{M#你}們這麼快就來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540134,
					"content": "哇…千岩軍的大哥原來這麼好說話的！那我們可以走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540135,
					"content": "#我不怪{F#妳}{M#你}們，不代表璃月的律法會放過{F#妳}{M#你}們。嘿嘿，實在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540136,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540137,
					"content": "下次請把話說完！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "嗯…讓我看看：尋釁滋事；干擾千岩軍公務；蓄意破壞「七星陣法」；再加上一個…破壞既有現場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540140,
					"content": "再減去千岩軍當事人的諒解…如果一切順利的話呢，恭喜二位客人，可以在璃月港多住五到十年了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540141,
					"content": "欸？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540142,
					"content": "我可以請律師嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "唔…請給我們律師名單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540146,
					"content": "咳咳…但是…！請聽我把話說完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540147,
					"content": "但是，合法市民或國外旅客可以運用任何合法手段協助千岩軍辦案，並且獲得應得的獎勵或補償…這也是璃月律法的規定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540148,
					"content": "所以兩位英雄，剛才那一架可不是白打的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540149,
					"content": "幫助你們的話，我們會獲得什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "#查封的贓物是不能隨便動的，但如果兩位願意幫忙的話，抓捕過程中偶遇的財物…唔，比如「盜寶團的秘密寶藏！」之類的，由{F#妳}{M#你}們處理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540151,
					"content": "另外呢，我和同僚們也湊了些摩拉，希望兩位不會嫌棄…唉，畢竟這種意外而來的「幫助」，事先並沒有算進預算裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540152,
					"content": "唔…也就是說，我們不用坐大牢，還有寶貝拿！對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540153,
					"content": "是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540154,
					"content": "好！那我們就勉為其難地答應啦！請你帶路吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540155,
					"content": "等等…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "#好了，就請兩位英雄不必客氣啦…我先去集結點待命了，還望{F#妳}{M#你}們一定跟上來，不然我們可要提前行動囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540158,
					"content": "對呀，我們快跟上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540159,
					"content": "喂…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "快點啦，我們這是在協助千岩軍辦案呢！而且不是也有好多摩拉拿嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540156,
					"content": "我還沒…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "早知道不如下手更重一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "哼，我們只不過打了看起來很討厭的人而已啦！誰叫你們都穿著盜寶團的衣服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540138,
					"content": "分明是故意的吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "這麼說，我們真的打錯人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "#嗯，不過我不怪{F#妳}{M#你}們的。我們有錯在先啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540124,
					"content": "關於危險物資…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "我的線人說那些愚人眾在用大批摩拉和軍用物資，向盜寶團購買什麼東西…但他只發現了食物和生活物品，或許是障眼法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540109,
					"content": "你們是…千岩軍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "#哈哈，抱歉事先沒來得及解釋…我們還以為{F#妳}{M#你}是來搞破壞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540111,
					"content": "唔…某種意義上也沒錯吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
