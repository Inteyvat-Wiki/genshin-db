				"points": []
			},
			"dialogs": [
				{
					"id": 710540401,
					"content": "先清剿<color=#00E1FFFF>煉金營地</color>能夠削弱他們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540402
					]
				},
				{
					"id": 710540402,
					"content": "很好，我們這就去查封他們的煉金設備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彥博"
				}
			]
		},
		{
			"id": 7105405,
			"completionStepIds": [],
