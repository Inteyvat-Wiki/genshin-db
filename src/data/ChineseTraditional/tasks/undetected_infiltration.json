			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彥博"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "#{F#妳}{M#你}來了，我就知道{F#妳}{M#你}會幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540202,
					"content": "盜寶團的走私犯們應該會在東邊的大營地裡和愚人眾進行交易，而在通往大營的道路上，他們還設立了三個小營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540203,
					"content": "根據線人的情報，它們分別是東南邊的<color=#00E1FFFF>炊事營地</color>、更東邊的<color=#00E1FFFF>兵器營地</color>，與東北邊的<color=#00E1FFFF>煉金營地</color>。如果我們事先突襲這三個營地，大概能夠截斷他們的物資供應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540204,
					"content": "恰好因為前陣子群玉閣的事情，在這裡巡邏的千岩軍人力不足，讓這幫傢伙猖狂了一段時間，他們現在戒備鬆懈了不少，正適合我們突襲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "彥博"
				},
				{
					"id": 710540205,
					"content": "#只不過…因為之前的誤會，我現在能支援的人手應該只夠鞏固一個分支營地，但如果{F#妳}{M#你}有需要的話，我們一定會加以支援的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彥博"
				}
			]
		},
		{
			"id": 7105403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
