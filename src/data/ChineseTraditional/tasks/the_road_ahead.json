				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "曼科，我們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "嗯，這還真是一陣苦等啊…等待的時間越久，實不相瞞，我的心情就越焦慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080104,
					"content": "#雖然…提出建議的人是我，但若是{F#妳}{M#你}們進入遺蹟而無法歸來，我也實在是良心難安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080105,
					"content": "#不過恕我直言，{F#妳}{M#你}們應該找到「盜火賢者」留在遺蹟裡的信物了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080106,
					"content": "費了番工夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "#我就相信{F#妳}{M#你}們一定可以成功的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "你看，就是這個像圓盤一樣的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080111,
					"content": "啊…「通牒金盤」，傳說中的「通牒金盤」居然是真的…太好了，我一定要記錄在我的研究成果裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080112,
					"content": "原來這個東西叫做「通牒金盤」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080113,
					"content": "是、是的。唉…恕我冒昧，我真是太激動了，據說這可是那位「盜火賢者」親自經手的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080114,
					"content": "剛才有一瞬間我想要把這個佔為己有，作為傳家之寶之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080115,
					"content": "#那可不行，我們是要用來救{REALNAME[ID(2)|SHOWHOST(true)]}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080116,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "我知道…不過，信物的線索我也只知道這枚，另外一枚究竟在何處，我就實在不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080118,
					"content": "奧奇卡納塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#咦？恕我直言，{NICKNAME}，{F#妳}{M#你}是說奧奇卡納塔嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080120,
					"content": "（述說觸摸石碑時看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "唔…居然在奧奇卡納塔…那是花羽會北邊，隔海相望的一座古城遺址…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080122,
					"content": "如果是奧奇卡納塔，恕我抱歉，我愛莫能助。那裡不僅僅是部族人的禁地，更是龍遺物研究協會的禁地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080123,
					"content": "據說許多年前，曾經有龍遺物研究協會的組織成員受人委託前去調查，結果就像石頭沉入水中那樣，再無半點消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080124,
					"content": "自那以後，我們協會就不再插手任何和奧奇卡納塔相關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080125,
					"content": "沒關係，知道這些已經很足夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080126,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "#嗯，我要再度感謝{F#妳}{M#你}們，能夠看到「通牒金盤」對我來說真的十分重要。不行，我必須快點回去把這些記錄下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080128,
					"content": "#再度感謝{F#妳}{M#你}們，{NICKNAME}、派蒙，祝{F#妳}{M#你}們的旅途順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080129,
					"content": "#然後，也祝願{REALNAME[ID(2)|SHOWHOST(true)]}，祝願你能去除「焰主之祝」的印記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080130,
					"content": "再見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "嗯…在旅途的終點，在所有靈魂的歸處，我們一定能夠再見的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080107,
					"content": "輕輕鬆鬆啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
