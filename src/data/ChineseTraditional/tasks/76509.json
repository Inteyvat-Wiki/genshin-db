					}
				]
			},
			"dialogs": [
				{
					"id": 765090101,
					"content": "好妳個「熱心商人」…怎麼，買賣做到這樣的地方來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090102
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090102,
					"content": "唉，妳不懂，像我們這樣口袋空空的平民，看到哪裡有商機，就像野狗嗅到了煮得香噴噴的骨頭一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090103
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090103,
					"content": "哼，只剩一張嘴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090104
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090104,
					"content": "還是多看看妳眼前的局勢吧，我看妳也是馬上要「兵敗如山倒」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090105
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090105,
					"content": "#我看未必…正好，{NICKNAME}您也來了啊，快來幫我看看，怎麼在這位的手下「逆轉頹勢」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090106
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090106,
					"content": "哼哼，那妳們就問對人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090107,
					"content": "和我之前玩的有點不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090108
					]
				},
				{
					"id": 765090108,
					"content": "#啊，沒錯，來一個新地方「做生意」，總是要做出一些特別的改變的。{F#妳}{M#你}面前的是我改良過，最新版的兵棋推演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090109
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090109,
					"content": "總之，就是玩法更豐富的推演——現在，有「戰線領隊」、有不同作用的旗幟…玩起來就會更像是在指揮一支真正的軍隊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090110
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090110,
					"content": "只不過和客人推銷到半路時，被這位打擾買賣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090111
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090111,
					"content": "為了證明我賣的是合法商品，不被這位報警抓起來，我只好和她來一盤，以證明我賣的東西不是什麼危險的「軍事武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090112
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090112,
					"content": "妳又自顧自說了半天啊…啊，您一定是大名鼎鼎的旅行者吧。還有這位，最好的嚮導派蒙，久仰久仰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090113
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090113,
					"content": "沒想到我們這位熱心的楓丹商人人脈竟如此驚人…兩位聲名遠播，今天我終於有幸一窺真容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090114
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090114,
					"content": "我叫維斯菈娃，是一個…「熱心保鏢」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090115
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090115,
					"content": "#只可惜這盤推演還沒結束，不然我一定現在就好好招待{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090116,
						765090117
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090116,
					"content": "（真招待還是真「招待」。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				},
				{
					"id": 765090118,
					"content": "嘿嘿，不用這麼客氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090119,
					"content": "妳人還算滿不錯的嘛！以前碰到像妳這樣打扮的，呃…通常二話不說就是要先打一架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090120,
					"content": "啊哈，現在是休假期，通常情況下，能動手的時候也盡量不動手，更何況…總之，現在我怎樣都不會對您動手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090121
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090121,
					"content": "但妳們看起來要動手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090122
					]
				},
				{
					"id": 765090122,
					"content": "對啊！剛剛過來的時候，雖然妳們只是在玩兵棋推演，但感覺氣氛很緊張，看來是誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090123,
					"content": "想切磋切磋？不錯的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090124
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090124,
					"content": "也不是不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090125
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090125,
					"content": "喂喂喂！只是打個比方啦，妳們怎麼一副當真的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090126,
					"content": "哈哈，別擔心，我們也只是開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090127
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090127,
					"content": "不過看來我這個新商品還有調解衝突的作用——在緊要關頭，兩位正欲對戰的人掏出了這款新版兵棋推演…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090128
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090128,
					"content": "#哎呀，廢話太多了，不如{F#妳}{M#你}直接親身試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090129
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090129,
					"content": "好主意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090130
					]
				},
				{
					"id": 765090130,
					"content": "#或者，{F#妳}{M#你}先來幫我打敗她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090131
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090131,
					"content": "不許請外援！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765090117,
					"content": "（這個人看起來很危險。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				}
			]
		}
	]
}