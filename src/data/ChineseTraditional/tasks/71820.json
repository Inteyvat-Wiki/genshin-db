			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "果然每年過節的時候都格外忙啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200202,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "還是客棧裡的事，很多人都回去過海燈節了，客棧裡的人手實在不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200204,
					"content": "又要招呼客人，又要打理客棧，還得準備點東西過節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200205,
					"content": "還有平常的一些事也不能擱置了…言笑都要忙不過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200206,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能去幫他一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200207,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "#那就拜託{F#妳}{M#你}了，言笑就在廚房裡，{F#妳}{M#你}直接去找他就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718200209,
					"content": "我還得在這處理一點事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "#誰啊！不要隨便…哦，是{F#妳}{M#你}啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200302,
					"content": "有什麼事嗎？要點菜的話可能要等等了，我正在忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200303,
					"content": "我是來幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "#{F#妳}{M#你}是來幫忙的？哦…那太好了，我正好有一堆事要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200306,
					"content": "#{F#妳}{M#你}先去客棧下面，幫我把剛送過來的那些烹飪用材料拿上來，我急著要用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200307,
					"content": "然後，再順便把這些霄燈掛到客棧門口的那兩棵樹上去…掌櫃唸這事好久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200304,
					"content": "有什麼需要我幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "怎麼樣，事情都弄好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718201502,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "謝謝了，真是幫大忙了，我得趕緊把這幾道菜給弄完，免得客人們等急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "#{F#妳}{M#你}回來了，言笑那邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718201602,
					"content": "現在應該輕鬆一些了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "#那就好，那就好，謝謝{F#妳}{M#你}幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718201604,
					"content": "這裡也沒有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201605,
					"content": "咦，望雅小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "#旅行者？真是巧了，沒想到能在這裡遇見{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201608,
					"content": "#送霄燈…算是吧，{F#妳}{M#你}知道輕策莊嗎？那裡離城裡很遠，裡面住的居民也大多是老人和小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201609,
					"content": "所以每年海燈節的時候，總務司也會特別派人過去，給他們帶一些節日用品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201610,
					"content": "第一批物資已經送過去了，但我還想再做點什麼，讓輕策莊裡更有節日的氛圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201611,
					"content": "所以，我去請了那位詩人清晝，他答應我會準備一些燈謎去輕策莊裡陪孩子們玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201612,
					"content": "清晝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "那位大詩人應該沒問題。然後我又想去找伯桓子，他的字寫得很不錯，要是能幫輕策莊裡的老人們寫寫霄燈就最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201615,
					"content": "但是，我卻怎麼樣都找不到伯桓子，有人說他來荻花洲取材，我就來這裡想找找他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201616,
					"content": "說不定老闆知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "伯桓子？我想想…他最近確實來過客棧一趟，說是要去附近考察什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718201619,
					"content": "不過那一帶有很多魔物，我也不確定他是不是還在那裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718201620,
					"content": "這樣嗎…可我和清晝約好了，等會要在望舒客棧這裡見面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201621,
					"content": "#旅行者，能請{F#妳}{M#你}再幫我去找一下伯桓子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201622,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "#那就拜託{F#妳}{M#你}了，我在這裡等清晝過來，還有一些事情要和他交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201624,
					"content": "嗚…事情完全排不過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201617,
					"content": "老闆，關於伯桓子的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "（咦，他不是和梵米爾約好…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "妳是來這裡「送霄燈」的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
