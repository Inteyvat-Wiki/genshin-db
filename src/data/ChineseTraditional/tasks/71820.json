			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯桓子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "#謝謝，謝謝{F#妳}{M#你}，唉…都怪我太不小心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201902,
					"content": "你在這做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "我來這裡取材啊，現在不是海燈節了嗎？我就想寫幾幅好字，送給周圍的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201904,
					"content": "我本來就是想到這裡來逛一逛找點材料，然後做幾份特別的墨水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201905,
					"content": "沒想到卻撞上了一堆魔物，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201906,
					"content": "關於望雅的請求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "去輕策莊幫人寫字…好，沒問題，這件事就包在我身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201908,
					"content": "輕策莊…我記得那裡的老人很多對吧，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201909,
					"content": "#這樣，{F#妳}{M#你}先幫我去搜集一塊石珀，一朵清心過來吧，我先拿回去做點墨水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201910,
					"content": "這些東西…能做墨水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "#哈哈哈，{F#妳}{M#你}這就有所不知了吧。石珀粉摻進墨水裡，寫出來的墨字裡帶著隱隱的金色，很吉祥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201912,
					"content": "清心的汁水摻進墨水裡，墨水會帶著一股清香，只要墨好，這兩種味道就會相得益彰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201913,
					"content": "這、這也太講究了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "呵，這算什麼，要是真讓講究的人來備墨，那才是真的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201916,
					"content": "#我們這次就盡量從簡吧，{F#妳}{M#你}搜集好了之後就拿來給我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201917,
					"content": "哎喲…我得休息休息，剛才真是太累了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201914,
					"content": "這麼麻煩嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
