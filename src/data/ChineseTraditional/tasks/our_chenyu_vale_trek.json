			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#我親愛的朋友，{F#妳}{M#你}也是來參加留影風光賽的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "馬里"
				},
				{
					"id": 711100202,
					"content": "#作為一名從留影機發源地來的楓丹攝影師，讓我給{F#妳}{M#你}們一個忠告：所謂留影，精髓中的精髓其實就在於留影機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "馬里"
				},
				{
					"id": 711100203,
					"content": "#所以，我要介紹一個人給{F#妳}{M#你}們。在我的家鄉，他製作的留影機沒有人不喜歡，價格也實惠，我手上就有購買管道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "馬里"
				},
				{
					"id": 711100204,
					"content": "#欸欸…不要露出那種不感興趣的表情啊…我再多幫{F#妳}{M#你}們申請一點折扣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "馬里"
				},
				{
					"id": 711100205,
					"content": "欸欸…不要走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬里"
				}
			]
		},
