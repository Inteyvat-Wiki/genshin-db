			"dialogs": [
				{
					"id": 711100801,
					"content": "唔…這些畫片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100802,
					"content": "怎麼了？我們的畫片不夠好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100803,
					"content": "恰恰相反…雖說這幾天我已經看過很多佳作了，但兩位的作品依然讓我耳目一新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100805,
					"content": "比如這張翹英莊的畫片，鵜鶘的加入為寧靜的村莊增加了一絲活潑，一靜一動的對比…真是別出心裁的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100806,
					"content": "如果按照我的眼光，兩位一定能夠成功入選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100807,
					"content": "哇！居然是這麼好的評價，說得我都有點不好意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100808,
					"content": "又不是妳拍的，妳不好意思什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "#我是替{F#妳}{M#你}不好意思一下嘛…我知道{F#妳}{M#你}在謙虛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100811,
					"content": "言歸正傳，我們的評選工作會在明早前完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100812,
					"content": "明早八點至下午六點，我們會將入選作品公開展出，地點就在合轍驛外的大街。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100813,
					"content": "感謝兩位對本次「沉玉之旅」風光留影賽的支持。請不要忘記，明天要再來一趟哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100814,
					"content": "嗯！我們不會錯過最後的驚喜的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100810,
					"content": "說得我也有點不好意思了。",
					"roleType": "TALK_ROLE_PLAYER",
