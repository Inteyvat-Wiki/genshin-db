			"dialogs": [
				{
					"id": 711101001,
					"content": "#兩位，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101002,
					"content": "#看見這些展出的畫片了嗎？這次的「沉玉之旅」一共有八幅入選作品，{F#妳}{M#你}們包攬了其中一半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101003,
					"content": "#恭喜{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101004,
					"content": "哇！這也太棒了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}，我就說吧！最後的結果是四分之四呢！我的算數真是越來越厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101006,
					"content": "明明是八分之四吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "#呵呵，就和我昨天的看法類似，評委們對{F#妳}{M#你}們另外兩幅作品也讚賞有加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101009,
					"content": "#所以，請收好這份限量版「沉玉之旅」留影紀念冊，裡面收錄了這次所有入選的作品。這是{F#妳}{M#你}們應得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101010,
					"content": "這就是驚喜嗎？看起來很漂亮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101011,
					"content": "#如果不嫌棄的話，我這裡還有一些摩拉，請收下吧。我要再次感謝{F#妳}{M#你}們的支持，這次是以個人的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101012,
					"content": "#因為這裡是我的家鄉，{F#妳}{M#你}們把她美麗動人的地方記錄了下來，永遠留存了下來，這些畫片一定會讓更多人喜歡上這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101013,
					"content": "#謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101007,
					"content": "哇！派蒙真是太會算數了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
