					}
				]
			},
			"dialogs": [
				{
					"id": 120440301,
					"content": "那裡怎麼有個姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440302,
					"content": "她好像很難受…我們快過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440801,
					"content": "剛剛是怎麼了？明明只是和那個姐姐對視了一眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440802,
					"content": "等一下，這裡什麼時候來了這麼多人？這些人到這裡來幹嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440803,
					"content": "這些人好像在排隊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "是哦…那個姐姐還在那裡！嗯…我覺得她可能知道發生了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440805,
					"content": "現在出發的話，我剩下的時間還足夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "手島"
				},
				{
					"id": 120440806,
					"content": "怎麼就講不通呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 120440807,
					"content": "檢舉了肯定混不下去，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "真田"
				},
				{
					"id": 120440808,
					"content": "唔…因為缺乏靈感而產生的焦慮…靈感往往不會光顧過於焦慮的大腦，希望這次治療能讓妳更放鬆一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440809,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 120440810,
					"content": "對於過往惡行的悔恨…還有對於困頓現狀的哀愁…我可以讓你更開朗地面對這一切，但還請你也努力一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440811,
					"content": "多謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "西口"
				},
				{
					"id": 120440812,
					"content": "下一位…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440813,
					"content": "這是怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440814,
					"content": "妳沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "我還行，下一位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440816,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440817,
					"content": "…哦！真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440818,
					"content": "哇，好突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440819,
					"content": "欸？這是…嗝！真的很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440820,
					"content": "抱歉？說實話，我們兩個都不清楚剛剛到底發生了什麼事，能麻煩說明一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440821,
					"content": "兩位應該是誤入了我的夢境，容我先讓兩位醒來再進行說明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440822,
					"content": "夢境？什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440901,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440902,
					"content": "#嗨，是不是有種「如夢方醒」的感覺？真沒想到那位{NICKNAME}會出現在我的夢裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440903,
					"content": "妳認識我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "#有人經常向我提起{F#妳}{M#你}，嗯…我根據傳聞做的人物側寫還算準確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440905,
					"content": "那妳是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440906,
					"content": "#說起來這是我和{NICKNAME}的第一次見面呢。那麼正式自我介紹一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440907,
					"content": "我是夢見月瑞希，叫我瑞希就好。我來自食夢貘一族，也是稻妻的妖怪之一哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440908,
					"content": "食夢貘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440909,
					"content": "啾啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "小食夢貘"
				},
				{
					"id": 120440910,
					"content": "是之前的那個小傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440911,
					"content": "這就是我們一族原本的樣子，兩位剛剛應該就是被牠吸引才誤入了我的夢境吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440912,
					"content": "#食夢貘擁有吞食人類噩夢的能力，而噩夢需要我們在自己的夢境裡進行消化。{F#妳}{M#你}們剛剛看到的就是我消化噩夢的場景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440913,
					"content": "#我一口氣吃了太多噩夢，它們堵在一起，讓我有些消化不良…幸好牠帶{F#妳}{M#你}們闖了進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440914,
					"content": "也算是歪打正著，幫了我一個大忙，現在我可以好好消化這些噩夢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440915,
					"content": "我們就是發現妳有點難受才湊過去的，雖然不知道具體發生了什麼，但能幫到妳就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440916,
					"content": "我最討厭噩夢了，能吞食噩夢的妖怪，的確要好好幫助一下呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440917,
					"content": "不過，非常抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440918,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "#{F#妳}{M#你}在夢境裡湊過來的時候，我從{F#妳}{M#你}身上分離出來的不是噩夢，而是美夢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440920,
					"content": "之前吃了那麼多噩夢，我的動作都變得機械了，沒留意就一口咬了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440921,
					"content": "原來食夢貘也可以吃美夢啊…話說回來，這是很過分的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440922,
					"content": "當然了，美夢對於人類來說十分珍貴，怎麼能像噩夢那樣隨意吞食呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440923,
					"content": "我們食夢貘一族有個不成文的規定，未經允許絕對不能吞食他人的美夢，我真是太不小心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440924,
					"content": "不必這麼自責。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "#難道{F#妳}{M#你}沒有覺得十分低落，又或者忽然想起很多傷心往事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440927,
					"content": "沒有啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "自己的美夢被吞食一部分後還能維持如此穩定的心理狀態，真是難得一見的案例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440929,
					"content": "#嗯…一定是{NICKNAME}的美夢太多了，被吃掉一點也沒關係嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440930,
					"content": "#但我還是應該向{F#妳}{M#你}提供補償…這樣吧，請收下這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440931,
					"content": "秋沙錢湯貴賓邀請函…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440932,
					"content": "本店有多位心理診療師坐鎮，並附帶溫泉和美食服務。帶著煩惱前來，帶著快樂離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440933,
					"content": "邀請函上標註了地址，我就在那裡工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440934,
					"content": "#使用這張邀請函，{F#妳}{M#你}們可以在那裡免費享受最高等級的服務…啊，說起來我也得趕快回去，店裡的事務不能擱置太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440935,
					"content": "#那麼，期待{F#妳}{M#你}們的正式光臨哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440936,
					"content": "這麼說，那位食夢貘姐姐還是一位心理診療師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440937,
					"content": "不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "心理診療服務…除了思考下一頓該吃什麼，很少有能讓我發愁的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440940,
					"content": "對了，那個什麼湯好像也提供美食服務，有這張卡的話就可以去那裡免費吃大餐吧？我們可不能浪費這次機會哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440938,
					"content": "很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "我覺得還好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
