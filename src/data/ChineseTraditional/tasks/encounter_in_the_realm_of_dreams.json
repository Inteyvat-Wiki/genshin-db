			"dialogs": [
				{
					"id": 120440201,
					"content": "嗯…我又想起了之前在這邊追狸貓的日子，有些懷念呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440202,
					"content": "欸？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440203,
					"content": "狸貓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "怎麼看都不像吧？難道稻妻又有新的妖怪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440206,
					"content": "嗯…難道牠想要我們跟過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440204,
					"content": "小豬仔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
