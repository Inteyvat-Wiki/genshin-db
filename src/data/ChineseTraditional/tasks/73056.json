					"content": "說來話長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "我們是朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560709
