				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560501,
					"content": "看呀，看呀…這裡的植物長勢真好！被「無留陀」蹂躪過的土壤，還是能生出有精神的植物來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560502,
					"content": "哈哈，「無郁夷摩」呀「無郁夷摩」，你這個臭老頭！還是滿有活力的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560503,
					"content": "哇，海亞姆先生好像突然變年輕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560504,
					"content": "派蒙也突然變得會說話了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "#{F#妳}{M#你}是什麼意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560508,
					"content": "#嗯…{F#妳}{M#你}採摘的這些應該夠了，辛苦{F#妳}{M#你}們陪我來跑一趟了。既然沒有其他事情，我們離開這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560509,
					"content": "哈哈，真好呀…有了這些樣本，或許對「死域」秘密和弱點的研究，會有更多進展吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560510,
					"content": "#辛苦兩位了，我們順原路回去吧…我還有東西交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560511,
					"content": "好耶，是謝禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560512,
					"content": "呵呵，算是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560506,
					"content": "好耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "雖然不是很清楚，但是好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "派蒙"
				}
			]
		},
