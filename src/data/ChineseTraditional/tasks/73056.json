	"talks": [
		{
			"id": 7305601,
			"completionStepIds": [
				7305601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305601",
							"2"
						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亞姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "哈哈，真是有趣…真是有意思。好起來了，這片森林…好起來了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560102,
					"content": "你好！老爺爺，你是迷路了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560103,
					"content": "#嗯…嗯？麋鹿…？啊，{F#妳}{M#你}們是在叫我嗎？哈哈，迷路，是吧？沒有的事，沒有的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560104,
					"content": "你們好呀，孩子們。我是生論派的陀裟多，吉亞斯·海亞姆，哈哈…叫我海亞姆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560105,
					"content": "唔…你好呀，海亞姆先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560106,
					"content": "不…像這樣，壓下舌尖，拱起舌中…海——然後雙唇呈圓形…亞——最後，自然而然地抿起嘴唇…姆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560107,
					"content": "呃…海——亞——姆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560108,
					"content": "#對啦！真不錯！好，金髮的孩子，{F#妳}{M#你}再來一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560109,
					"content": "海——亞——姆——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "#哈哈，不錯！比白色的小東西強多了！{F#妳}{M#你}看，我早說過我也能去教語音學的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560113,
					"content": "所以，海亞姆先生…既然你沒有迷路，那來這種地方做什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560114,
					"content": "為什麼？呵呵…我是森林學者呀。對我們森林學者來說，森林就像家一樣。我怎麼會在久違的家裡迷路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560115,
					"content": "喔……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560116,
					"content": "這片森林深受「死域」的困擾。過去三十年裡植物無論種類還是數量都在迅速減少，而有害的蕈類卻愈來愈多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560117,
					"content": "但最近這段時間裡，「死域」卻消失了。很多曾經消失的植物如今重新生長了出來，蕈類的繁殖也有所收斂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560118,
					"content": "這種情況，我只在六十年前見到過一次…所以為了驗證我的一點不成熟的想法，我就來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560119,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560120,
					"content": "關於驗證想法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "哈哈，六十年前的事情了…可不要期待我這老傢伙記得多清楚。但我相信，「死域」的清除，和那件事情有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560122,
					"content": "所以，接下來，我要進入這個洞穴裡面採集一些樣本，驗證我的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560126,
					"content": "這樣呀…洞裡的「無留陀」雖然沒有了，可還是很危險呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560127,
					"content": "哈哈，對我來說沒什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560128,
					"content": "#唔，等等…{F#妳}{M#你}剛剛說什麼？洞裡的…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560129,
					"content": "「無留陀」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "#嗯…再想想，我可能確實需要{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560132,
					"content": "哼哼，你看我怎麼說的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560133,
					"content": "嘿嘿，請恕我冒昧…但還沒有問過兩位朋友的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560134,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "而我是派蒙！派——蒙——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560136,
					"content": "派蒙？派蒙…哈哈，很有趣的名字…我還是頭一次聽說有人…或者小精靈，叫這個名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560137,
					"content": "啊，抱歉，抱歉。沒有冒犯的意思…我是說這個小東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560138,
					"content": "什麼小東西！已經很冒犯了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560139,
					"content": "好了，閒話不多說，請兩位「傑萬」隨我一同來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560140,
					"content": "「傑萬」…？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560141,
					"content": "是我們家鄉古老的語言，意思是「勇敢的年輕人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560142,
					"content": "準確來說，是…「面對龐大的邪惡而不熟視無睹，直面無垠的不公而不退避求和的年輕人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560143,
					"content": "哼哼，那不就是我們嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560144,
					"content": "喔？這麼有自覺嗎？哈哈，那就跟我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560145,
					"content": "欸？海亞姆老爺爺，你的腿的狀況真的能跟上我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560146,
					"content": "#哈哈…我可有二三十年的森林考察經驗，不要小瞧老年人的體能呀！{F#妳}{M#你}們儘管走便是，我很快就能跟上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560130,
					"content": "「死域」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "需要我們幫助嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "#哈哈…謝謝{F#妳}{M#你}們，熱情的孩子。我這把老骨頭雖然不靈活了，但腦子還好使，可不要小看我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560125,
					"content": "畢竟，我知道怎樣讓森林高興，森林就不會讓我受傷害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560111,
					"content": "海亞姆先生，你在這裡做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "#嗯…{F#妳}{M#你}發音太快了，太急促了。不過沒關係…慢下來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "海亞姆"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亞姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "我要調查的，主要是三個地點。哈哈，三十年前來到這裡的記憶應該還沒有消退乾淨…我還能給你們指出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560202,
					"content": "#總之，辛苦{F#妳}{M#你}們相陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560203,
					"content": "不要客氣啦，海亞姆先生！這都是我們「傑萬」應該做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7305603,
			"completionStepIds": [
				7305609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305609",
							"2"
						],
						"stepId": 7305609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亞姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "有趣…這裡的植物看起來…重新煥發生機了啊。「無郁夷摩」重新發揮作用了…真是神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560302,
					"content": "欸…海亞姆先生也知道「無郁夷摩」嗎？我還以為只有蘭那羅知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560303,
					"content": "派蒙，噓！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "#「蘭那羅」，是嗎？{F#妳}{M#你}們也看到過他們啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560306,
					"content": "欸…？嗯…是、是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560307,
					"content": "怎麼了，海亞姆先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "「伊蘭杳隨薔薇沒，夷王神杯何所終…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560310,
					"content": "我們繼續吧，去下一個地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560308,
					"content": "你也見過蘭那羅嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "派蒙…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305610",
							"2"
						],
						"stepId": 7305610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亞姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "#哈！{F#妳}{M#你}瞧！看看這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560402,
					"content": "欸？是新植物嗎？怎麼突然這麼興奮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560403,
					"content": "不是，不是新植物，但更讓人開心！…瞧瞧呀，我們的「秘密城堡」！哈！破敗成什麼樣子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560404,
					"content": "欸…？「秘密城堡」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560405,
					"content": "哈哈！學士奧馬爾回來了！他帶著群星的秘密回來了！伊爾凡，熙蔓，你們在哪裡！還不出來歡迎我嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560407,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "呃…咳咳，抱歉，孩子們。我…我有點太興奮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560409,
					"content": "歲數大了總是這樣，愈是現在的事，就越糊塗；愈是小時候的事，就愈懷念，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560410,
					"content": "伊爾凡，熙蔓，他們是我的朋友，我們一起搭建了這座「城堡」，我們三個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560411,
					"content": "那時候，伊爾凡是大樂師，熙蔓是元帥，我是占星學士。我們偶爾也會輪換，小孩子嘛…玩膩了就會換著來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560412,
					"content": "伊爾凡彈得一手好琴；熙蔓她個子高、手臂壯，沒人打得過；而我呢？哈哈，讀書多一點，家裡多點摩拉而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560413,
					"content": "這裡是你兒時玩耍的地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "不，這裡是我們的秘密國度，我很嚴肅的。我們和他們約好了切莫相忘，長大後舉「復國軍」回來光復城堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560418,
					"content": "呵呵，二十年過去，他們或許都已經忘記了…這裡就被我當做了研究森林的小小據點，一直運作到三十年前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560419,
					"content": "再後來，「無留陀」來了，「復國軍」卻還是沒蹤影。呵呵，也對…小孩子的約定，怎麼能抵擋死亡的到來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560420,
					"content": "可是…既然你還記得他們，他們一定也還記得你的吧！請不要灰心呀，海亞姆先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560421,
					"content": "灰心？不會的。兒時的記憶，共同的「幻想朋友」，不屬於大人的世界。可能會有點遺憾，但…時光不復回呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560422,
					"content": "「幻想朋友」…你是說蘭那羅嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560423,
					"content": "派蒙…！噓！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560426,
					"content": "#哈哈…我差點忘記了，我是請{F#妳}{M#你}們來幫我為新生植物採樣的，不是來閒聊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560427,
					"content": "請原諒我這糟老頭子話太多，我們繼續吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560424,
					"content": "就妳話多，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "這些都是你和玩伴留下來的嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "不，不全是。最初我們還約定了，等長大以後，舉「復國軍」回來光復這裡…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730560417,
					"content": "我後來在教令院做植物學研究，正巧回來把這裡改造了一番，一波一波搬來又搬走了不少垃圾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "海亞姆"
				}
			]
		},
