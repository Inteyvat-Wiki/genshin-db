					"id": 730560714,
					"content": "東西，給我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560715,
					"content": "給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560716,
					"content": "就是這個。",
