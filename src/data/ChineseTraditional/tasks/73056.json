			"dialogs": [
				{
					"id": 730560701,
					"content": "#為什麼來這裡，{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560702,
					"content": "哇啊！嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560703,
					"content": "#知道我的名字，{F#妳}{M#你}們。但沒有在這裡見過{F#妳}{M#你}們，蘭納迦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560704,
					"content": "#所以…為什麼來這裡，{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560705,
					"content": "這個問題不太好解釋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "雖然很多事情你都記不起來了，但是我們沒有惡意的！我們一直都站在你們這邊！一直都會幫助「無郁夷摩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560707,
					"content": "#「無郁夷摩」…{F#妳}{M#你}們知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560710,
					"content": "#哼…看起來不像是壞蛋，{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560711,
					"content": "#但請不要逗留，在這裡。盡快離開吧，{F#妳}{M#你}們。還在恢復，森林…所以，還不應該逗留，新的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560712,
					"content": "欸…等等呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560713,
					"content": "我們有東西要交給你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
