					"id": 730560723,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560724
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560724,
					"content": "怎麼樣，記起來了嗎！",
