					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730560718,
					"content": "你看，記起來了嗎？你也給過我們一樣的花呢！",
