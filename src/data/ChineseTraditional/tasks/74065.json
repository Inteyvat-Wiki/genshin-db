				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#哎喲，讓我看看，這不是{NICKNAME}和派蒙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650102,
					"content": "我們很熟嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "不要這麼冷淡嘛！上次那件事，我還牢牢地記在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650105,
					"content": "上次那件事…啊！我們還有好多想問的都沒問清楚呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650106,
					"content": "是、是這樣嗎？妳看我這個記性，上次是什麼事？我完全忘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650107,
					"content": "聰明人都說，與其回顧過去，不如放眼未來——不如我們聊聊今後的合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650108,
					"content": "現在我手頭上有些報酬不錯的工作，只是煩惱沒有人幫忙。兩位如果有空的話，要不要來試試看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650109,
					"content": "哼，別以為我們還會輕易上當…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650110,
					"content": "報酬不錯是多不錯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650112,
					"content": "#這就是為什麼我喜歡和{NICKNAME}{M#先生}{F#小姐}這樣的人物談買賣，不是有句話嗎？上道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650113,
					"content": "#這樣好了，我說個數字，保證{F#妳}{M#你}們滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650114,
					"content": "一百特許券，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650115,
					"content": "一百？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650116,
					"content": "嗯，看妳的樣子，是被我的慷慨給打動了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650117,
					"content": "買楓達的瓶蓋都不夠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "就是說啊！簡直不敢相信你居然說得出口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650121,
					"content": "#我這樣還不夠慷慨？{F#妳}{M#你}們這些年輕人還真是…不要不知好歹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650122,
					"content": "要知道，這些做起來輕鬆又有賺頭的工作，那些窮鬼可是全部都搶著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650123,
					"content": "德瑟布爾，你這狡猾的傢伙，總算讓我逮到你了！上次在收發室附近抓到你把自己應該完成的委託低價外包給新來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME}和派蒙？{F#妳}{M#你}們不會信了這傢伙說的鬼話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650125,
					"content": "嗚嗚，已經被騙過一次了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "唉，還是晚了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650130,
					"content": "總之他的話一個字都不要信。他專挑剛來梅洛彼得堡，或者來了一段時間但是不懂規矩的人行騙，已經有不少人受害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650131,
					"content": "什麼行騙…說得這麼難聽，我們之間有什麼差別嗎？你們看守不是也會用特許券叫人做一些雜事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650132,
					"content": "我們可是不會留一部分放進自己口袋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650133,
					"content": "你在暗示什麼？沒有證據就不要血口噴人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740650134,
					"content": "唉，想看證據是吧？我們走，禁閉室又安靜又寬敞，最適合看證據了。真是的，明明晶簇礦坑道那邊還有麻煩事等著我去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650135,
					"content": "#對了，{NICKNAME}和派蒙，如果{F#妳}{M#你}們方便的話，可以幫我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650136,
					"content": "我們也不是總是很閒的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650137,
					"content": "報酬一定很優厚吧！這忙我幫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650139,
					"content": "#哈哈，那當然是依規定發放。{F#妳}{M#你}們應該知道標準的，我也不會騙{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650140,
					"content": "事情是這樣，晶簇礦坑道那邊有些原海異種…放任不管的話可能會造成危害，必須盡早處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650141,
					"content": "#我先把這傢伙送去禁閉室，和同事交接大概會耽擱一下…手續辦完之後我會盡快和{F#妳}{M#你}們會合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650142,
					"content": "好吧，那你不要耽誤太久哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650143,
					"content": "#我會盡快的，不過手續嘛…快不快得了也不是我說了算。那邊就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650127,
					"content": "這次還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "這次？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650129,
					"content": "呃…之前發生過一些事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650119,
					"content": "給你一百，你幫我工作，我還有賺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "哇，你該不會就是這樣打算的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650103,
					"content": "我有不好的預感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406503",
							"2"
						],
						"stepId": 7406503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫普瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "你怎麼現在才來呀！那些原海異種都被我們趕走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650302,
					"content": "這麼說來，終於讓我趕上一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650303,
					"content": "趕上一次？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740650304,
					"content": "那當然是等我到現場的時候，發現工作已經全部都由別人完成了。而我呢？我什麼都不用做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740650305,
					"content": "#這是給{F#妳}{M#你}們的，真是多謝{F#妳}{M#你}們了，今晚我可以睡個好覺了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫普瓦"
				}
			]
		}
	]
}