			"dialogs": [
				{
					"id": 761970120,
					"content": "(test)臺詞文字",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "當年在海上漂泊時，我曾聽到不知從何處傳來的召喚，其他人無動於衷，但我卻很快被迷住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970102,
					"content": "一定是來自異界的聲音吧？我也聽過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970103,
					"content": "後來我才意識到，那召喚中包含了一切未能抵達彼岸的夢想，可以說是怨念的集合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970104,
					"content": "你應該帶著寒湧石，從中間的孔就可以看到是誰在召喚你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970105,
					"content": "但當時我還是個年輕氣盛的毛頭小子，哪怕看到危險也只會覺得是機遇，於是就這樣一頭撞了進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970106,
					"content": "聽說寒湧石中間的孔就是通向異界的門扉…不過，該怎麼穿過去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970107,
					"content": "而在那之後…大海的風浪啊，帶走了我的財富、榮譽還有家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970108,
					"content": "在野心和欲望驅使下的冒險，從來不會有好的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970109,
					"content": "啊，卡住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970110,
					"content": "我來幫妳拿下來吧。下次不要再這樣做了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970111,
					"content": "莉奈婭姐姐，妳怎麼有空回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970112,
					"content": "我來附近收集寒湧石，看到你們在聊天，就來打個招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970113,
					"content": "對哦，如果是莉奈婭姐姐，說不定真的可以用寒湧石打開通往異界的門扉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970114,
					"content": "就算是我也不行。之前不是和妳說過嗎？那只是穿鑿附會的民間傳說而已，沒什麼可靠的依據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970115,
					"content": "原來行不通啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970116,
					"content": "原來你在聽啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970117,
					"content": "咳…不，我已經不再是過去的我了。現在的我知足常樂，別無所求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "維賈米"
				},
				{
					"id": 761970118,
					"content": "這樣啊，真可惜。那我也來幫莉奈婭姐姐收集寒湧石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 761970119,
					"content": "好啊，那就麻煩妳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970124,
					"content": "在奧妮的幫助下，很快收集完畢…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "謝謝妳，不過我已經收集好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761970123,
					"content": "好吧，那我就去莫雷谷找莫雷爺爺他們了。再見啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧妮"
				}
			]
		},
