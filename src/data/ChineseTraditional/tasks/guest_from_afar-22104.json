			},
			"dialogs": [
				{
					"id": 221040101,
					"content": "真是煩人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "咦，抱歉，您是什麼時候來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040104,
					"content": "是這樣，周圍的怪物越來越多了，雖然我丈夫老是說，他們不敢進客棧來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040105,
					"content": "但是只有他一個人的拳腳…我還是有點擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040106,
					"content": "您如果有空的話，能幫我去客棧周圍看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "#謝謝{F#妳}{M#你}願意幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040113,
					"content": "總之，就拜託您了，報酬我也不會少您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040108,
					"content": "這家客棧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "唔…只是一家很普通的客棧啦，只不過開的地方偏了點，收的客人多了點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040111,
					"content": "不過流落野外的人，有個地方能吃飯睡覺總是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221040112,
					"content": "我和我丈夫是這麼想的，也就是這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
