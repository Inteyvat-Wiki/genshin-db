					"梢"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "這位客人，今日光臨「木漏茶室」有何貴幹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010202,
					"content": "關於拉姆齊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "那位商人啊…他確實在茶室裡，不過，最近他似乎看起來有點緊張，不知道遇見了什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010204,
					"content": "#{F#妳}{M#你}要是想找他的話，往裡面走一走就能看見他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梢"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉姆齊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "#{F#妳}{M#你}是…旅行者？找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010302,
					"content": "關於「遊記」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "#噢，{F#妳}{M#你}是說我寫給小綠那孩子的「遊記」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010304,
					"content": "這真是…我最近實在沒空寫了，我想那孩子一定是等急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010305,
					"content": "那些「遊記」是真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "#哈哈哈，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010307,
					"content": "不太像真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "哈哈哈，不愧是四處旅行過的人，一看就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010311,
					"content": "沒錯，嚴肅地來說，這些「遊記」都不是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010312,
					"content": "雖然有些地點和人物確實是取材於現實…但大部分的內容，都是出自於我個人的想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010313,
					"content": "當然啦，有些內容也不完全是想像。比如我正在寫的一篇「遊記」裡，一個人製作了一個超級氣球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010314,
					"content": "然後他召集了幾位同伴，想要用這個氣球在八十天內環遊提瓦特大陸一圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010315,
					"content": "而且，操作這個氣球完全不需要「神之眼」，只需要有技術常識就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010316,
					"content": "這群人搭著氣球環遊著世界，一路上遇見了無數奇怪的事物和現象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010317,
					"content": "這篇本來就是我準備寫給小綠的，但因為…某些原因，我到現在連一小段都沒機會寫完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010318,
					"content": "什麼原因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "#{F#妳}{M#你}看見走廊上那個傢伙了嗎？他叫平八，不知道從什麼時候起，那傢伙就一直盯著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010320,
					"content": "我本來想出去採風，為那篇「遊記」取取材，但那傢伙每次都跟著我，不知道想做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010321,
					"content": "因為擔心這傢伙對我圖謀不軌，我也就不敢出去採風了，這篇「遊記」也就擱置了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010322,
					"content": "#但還好現在{F#妳}{M#你}來了，旅行者，{F#妳}{M#你}能陪我出去採採風嗎？有{F#妳}{M#你}陪著，諒那傢伙也不敢對我做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010323,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010327,
					"content": "而且俗話講「防人之心不可無」，有這麼一位在後面盯著我，無論他打著什麼主意，我多少也得防著點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010328,
					"content": "所以，在我採風的時候，護衛我的事就拜託你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010329,
					"content": "我之前其實已經定好了幾處採風的地點，我們直接過去就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010330,
					"content": "第一個地點是附近的海灘，我們現在就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010325,
					"content": "他為什麼要這麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "我不知道。但是…對某個人產生惡意，可不需要什麼太充分的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010309,
					"content": "我希望是真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "哈哈哈，我也希望我寫的這些東西能夠成真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "拉姆齊"
				}
			]
		},
