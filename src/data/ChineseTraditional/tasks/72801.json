					"拉姆齊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "這片海灘的水質格外清澈，細砂的顏色也很白淨，與狂躁的外海截然不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010502,
					"content": "從這裡出海…起飛的話，應該還滿有氣氛的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010503,
					"content": "咳，這裡的景致很不錯，我得記錄一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "拉姆齊"
				},
				{
					"id": 728010504,
