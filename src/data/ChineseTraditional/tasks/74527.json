					"愛可菲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#是{F#妳}{M#你}啊，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270402,
					"content": "愛可菲，好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "今天的我不負責烹飪，只是單純在試吃而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270405,
					"content": "莎凡娜想推出一道新菜品，拜託我來幫她把把關，但這道菜…已經是第五次重做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270406,
					"content": "不是火候差了幾秒，影響了食材的口感，就是調味的比例偏高，讓香料的味道喧賓奪主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270407,
					"content": "愛可菲還是那麼嚴格啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "那是當然！烹飪可是一門科學，不會因為她是我朋友就變了味。不如說就是因為要對她和顧客負責，我才更應該嚴格吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270409,
					"content": "其實，我有一個小小的請求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "…在這種時候嗎？如果是要用於公開展示的畫片，我建議另找時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270412,
					"content": "我們需要好好挑選布景、仔細調整光線和角度，才能達到最佳的呈現效果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270413,
					"content": "只是想為朋友留影紀念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "好吧…反正要等她重做第六次，現在還有點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270416,
					"content": "#那就讓我看看{F#妳}{M#你}的新鏡頭和那道新菜品，哪邊可以發揮得更好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛可菲"
				},
				{
					"id": 745270414,
					"content": "也可以測試新鏡頭效能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "可以讓我為妳拍一張畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "在研發新的食譜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
}