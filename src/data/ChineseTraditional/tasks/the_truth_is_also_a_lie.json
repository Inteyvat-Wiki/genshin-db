				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"新之丞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340401,
					"content": "謝謝你們，謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340402
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340402,
					"content": "嚇死我了，他們說要把我連人帶籠子扔到海裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340403
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340403,
					"content": "啊不對，小姐結婚…聽我說，有人想利用小姐結婚的機會做壞事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340404
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340404,
					"content": "冷靜點，新之丞，這個我們已經知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340405,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340406
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340406,
					"content": "關於這件事，我們有所察覺。迄今為止的發展，也與我想的相差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340407
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340407,
					"content": "想出這個計畫的人不願就此放棄，他們馬上就會展開進一步行動，我們也要找到對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340408
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340408,
					"content": "社奉行大人，要親自參與進來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340409
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340409,
					"content": "這件事影響到三大奉行，事關整個稻妻的穩定，我的中立態度到此為止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340410
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340410,
					"content": "將軍大人向來厭惡無聊的權謀遊戲。我作為將軍麾下的奉行，有義務為她解決瑣事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340411
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340411,
					"content": "也、也有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340412
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340412,
					"content": "新之丞，你暫時不要回去，找個地方躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340413
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340413,
					"content": "旅行者，派蒙，我們也離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340414
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340414,
					"content": "剛走了不久…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340415
					]
				},
				{
					"id": 120340415,
					"content": "喔，這不是社奉行大人嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340416
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340416,
					"content": "聽說您無緣無故來到這個地方，還打傷了我的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340417
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340417,
					"content": "該不會，您正在秘密地進行什麼行動吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340418
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340418,
					"content": "恰好聽說有人濫用私刑，我身為富有責任心的稻妻官員，不願坐視不理罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340419
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340419,
					"content": "就算新之丞是您的家臣，律法也沒有賦予您隨意處置他的權力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340420
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340420,
					"content": "私刑？這怎麼能算私刑，這只是管教而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340421
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340421,
					"content": "一個小卒，莫名其妙衝到小姐面前，張嘴就是一大堆自以為是又失禮的話，成何體統？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340422
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340422,
					"content": "小姐她啊，可是被嚇得不輕呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340423
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340423,
					"content": "按您的意思，是全然不知道背後的緣由了？否則，又怎麼會說這件事「莫名其妙」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340424
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340424,
					"content": "兩家聯姻原是喜事，偏偏被自作聰明的小卒想得那麼複雜。這般無中生有，不是莫名其妙，又是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340425
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340425,
					"content": "柊小姐嫁去了九條家，也依然是柊家的大小姐，是勘定奉行最為尊貴的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340426
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340426,
					"content": "我們當然會忠心耿耿地侍奉她左右，為她掃清後顧之憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340427
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340427,
					"content": "盡忠職守，本就是我們的原則。那小卒非但沒有這般覺悟，反而挑撥小姐，是何用心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340428
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340428,
					"content": "暫且算他是一腔熱血好了，可高貴如您，不該有跟那小卒一樣的想法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340429
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340429,
					"content": "可惡，說起話來一套一套的…好叫人生氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340430,
						120340431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340430,
					"content": "（陰陽怪氣。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				},
				{
					"id": 120340432,
					"content": "您這麼一說，我倒是想起些事。自我出任社奉行以來，每天都能遇到不少有趣的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340433
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340433,
					"content": "外國的商販告訴我，有一種鳥，舌頭特別的長，能扯到嘴巴外面打上兩個結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340434
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340434,
					"content": "您也是有見識的人，要不要猜猜，這麼珍奇的鳥類一般會拿來做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340435
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340435,
					"content": "這…這…當成觀賞用的寵物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340436
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340436,
					"content": "呵呵，說來有趣，這種鳥啊，既不能當成寵物，也沒有任何用處，哪怕抓到了，也只能剪掉牠的舌頭扔出窗外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340437
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340437,
					"content": "因為大家都說：「舌頭這麼長，又愛強詞奪理，叫得喳喳響，實際上嘛…卻只是虛張聲勢而已。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340438
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340438,
					"content": "您…！社奉行大人，您來這裡，就是為了對我們勘定奉行冷嘲熱諷嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340439
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340439,
					"content": "怎麼會呢。在我心中，勘定奉行的各位向來是剛正不阿，恪盡職守的良善之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340440
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340440,
					"content": "這樣的人，本不該像您這樣，故弄玄虛，避重就輕，只為找一個理由把柊小姐拉下勘定奉行之位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340441
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340441,
					"content": "社奉行大人，說話要講證據啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340442
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340442,
					"content": "證據不就在您和我的眼前嗎？比如那位有力的人證，您見他說到了重點，可是急著要消滅他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340443
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340443,
					"content": "哎呀呀，堂堂松浦家，也算名門大戶了，沒想到論起忠心，竟連一位普通役人都比不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340444
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340444,
					"content": "讀了書，做了官，到頭來也只是耍些不上檯面的小把戲。該說您是聰明，還是愚昧呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340445
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340445,
					"content": "您為將軍辦事，非但沒能學到周圍人一星半點的優秀，反倒被幾分利益蒙蔽了雙眼，自毀前程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340468
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340468,
					"content": "我並不生氣，松浦大人，我是在替您難過啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340446
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340446,
					"content": "…哈哈哈！是嗎？那聰明的您，又能把我怎麼樣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340447
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340447,
					"content": "這充其量是勘定奉行的家事，我們內部自有處理的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340448
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340448,
					"content": "您的手伸得這麼長，連別人的家事也要管，那我是不是也可以擅自揣度一番大人您的用心呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340449
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340449,
					"content": "您只是不希望勘定奉行與天領奉行站到一起，三方關係失去平衡以至於威脅了社奉行的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340469
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340469,
					"content": "——才找了個光鮮的理由，來拆散我們兩家聯姻吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340450
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340450,
					"content": "嗯？原來在您看來是這樣的啊。不得不說，您對三方利益的關注，實在是強過我太多太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340451
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340451,
					"content": "實話告訴您吧，這個婚，現在是結也得結，不結也得結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340452
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340452,
					"content": "現在公告已經貼出去了，消息飛滿了整座稻妻城！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340453
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340453,
					"content": "市民本不知道九條鐮治和柊千里的戀情，現在肯定到處都在討論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340454
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340454,
					"content": "自從消息公佈的那一刻起，就算這件事還沒成真，它也必須成真！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340455
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340455,
					"content": "嗯。原來是這樣，看來我還是錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340456
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340456,
					"content": "哈！您也知道啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340457
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340457,
					"content": "我原本覺得您再怎麼說也比普通人聰明些，現在看來，卻是大錯特錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340458
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340458,
					"content": "神里綾人，你…！你居然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340459
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340459,
					"content": "您這步棋已經下完，應該輪到我了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340460
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340460,
					"content": "…什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340461
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340461,
					"content": "難道您真心認為，結婚這件事是讓勘定奉行和天領奉行站在一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340462
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340462,
					"content": "有沒有可能，被孤立的反而是勘定奉行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340463
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340463,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340464
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340464,
					"content": "嗯，和您聊天很長見識，我的話也說完了，就先告辭啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340465
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340465,
					"content": "喂，喂，我完全沒搞懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340466
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340466,
					"content": "他們有他們的算計，幸好我事先也有所準備。如我所言，他們果然走到了臺前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340467
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340467,
					"content": "#先回稻妻城看看現狀，然後我把計畫詳細地告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340431,
					"content": "（但確實難以找出破綻…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				}
			]
		},
