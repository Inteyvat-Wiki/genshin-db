			"dialogs": [
				{
					"id": 120340701,
					"content": "九條家和柊家居然要辦婚禮，這可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340702
					],
					"speakerTitle": "小百合"
				},
				{
					"id": 120340702,
					"content": "我有個親戚在勘定奉行內部工作，我等會找她打聽一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340703
					],
					"speakerTitle": "真理"
				},
				{
					"id": 120340703,
					"content": "她都從來沒和我講過這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真理"
				}
			]
