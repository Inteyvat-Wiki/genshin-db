			},
			"dialogs": [
				{
					"id": 120340101,
					"content": "你們在幹什麼，放了新之丞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340102,
					"content": "馬上停止你們的暴行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340103
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340103,
					"content": "居然是社奉行大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340104
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340104,
					"content": "哼，我們只聽命於老爺，也只為老爺負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340105
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340105,
					"content": "是嗎…那就恕我失禮了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 1203402,
			"completionStepIds": [
				1203406
			],
