			},
			"dialogs": [
				{
					"id": 120340801,
					"content": "幾位，歡迎。實際上，我剛剛聽說…我和千里的婚事被公佈出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340802
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340802,
					"content": "怎麼會這麼突然？我還沒做好準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340803
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340803,
					"content": "關於這個，背後比較複雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340804,
					"content": "向九條鐮治簡單說明了事件背後的複雜情況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340805
					]
				},
				{
					"id": 120340805,
					"content": "這樣啊…原來有人想利用我們的婚姻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340806
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340806,
					"content": "順勢結婚，對您的影響或許不大，但我們必須考慮柊小姐的處境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340807
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340807,
					"content": "我不是沒有考慮過現在這種可能性，但我們結婚是真心的，我也已經跟她說好，會竭盡全力保護她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340808
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340808,
					"content": "您的心意我能理解，但恕我直言，她本可以不藉助您的保護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340809
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340809,
					"content": "換句話說，假如連您也潛意識認為，柊小姐必須受您保護才能渡過困境，那是否意味著她已經失去了某些東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340810
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340810,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340811
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340811,
					"content": "我並非苛責您，想保護重要的人是人之常情。我也知道您如此聰慧溫柔，若不是關心則亂，一定能想得再周全一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340812
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340812,
					"content": "您喜歡的柊小姐，是獨立自主，溫柔堅強，充滿決心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340813
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340813,
					"content": "然而就是這樣的她，從今往後，為了與您的婚姻…即將變得只能依託您而活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340814
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340814,
					"content": "即使如此也沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340815
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340815,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340816
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340816,
					"content": "我用心愛著她，願意盡我所能給她幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340817
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340817,
					"content": "正因如此，我不願意見她痛苦，更不願意看她被人利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340818
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340818,
					"content": "社奉行大人，您說得對，我之前的想法…太過簡單自私。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340819
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340819,
					"content": "但，現在一切都晚了吧，公告都已經貼得到處都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340820
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340820,
					"content": "我有一計，不過…這個計畫需要「壞人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340821
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340821,
					"content": "九條大人，如果實行這個計畫，那麼您和我都需要扮演壞人，承擔一定風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340822
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340822,
					"content": "您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340823
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340823,
					"content": "請講講您的計畫吧，只要還有辦法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340824
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340824,
					"content": "我已經告訴勘定奉行的人，結婚一事並不能讓勘定奉行和天領奉行站在一起。相反，它是個令勘定奉行遭到孤立的決策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340825
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340825,
					"content": "這種說辭指向的隱情在於，他們想要利用結婚一事架空柊家，而此事成功的關鍵是天領奉行對這場婚事沒有任何想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340826
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340826,
					"content": "但如果我們假設，「眼狩令」一事後，天領奉行早就想對勢力薄弱的勘定奉行下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340827
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340827,
					"content": "您接任天領奉行之後遲遲沒有動作，不過是顧慮柊小姐的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340843
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340843,
					"content": "對您來說，最好的辦法就是在社奉行的支持下盡快辦妥婚事，迎娶柊小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340828
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340828,
					"content": "——那樣一來，身為天領奉行掌權者的您就再也沒有後顧之憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340829
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340829,
					"content": "原來如此！的確合乎形勢，也很巧妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340830
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340830,
					"content": "這會讓柊千里顯得不可或缺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340831
					]
				},
				{
					"id": 120340831,
					"content": "沒錯，我們的目的是改變柊小姐的立場。讓她從「盡快送走的累贅」，變成「不可或缺的保護傘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340832
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340832,
					"content": "如此舉措，還能穩固柊小姐在勘定奉行府中的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340833
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340833,
					"content": "一旦那些人意識到整件事背後的關係網，就會全力阻止這場婚姻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340834
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340834,
					"content": "至於那些他們親手製造的麻煩，就請他們自己去擺平吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340835
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340835,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340836
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120340836,
					"content": "#呃…關係網…好繞啊，聽不懂！你還是直接點明我和{M#他}{F#她}需要做什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340837,
					"content": "我們需要保證，「背後的故事」能順利地傳入勘定奉行那幫人耳中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340838
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340838,
					"content": "跟我聊過天的那位松浦大人，等他緩過神來，應該已經開始胡思亂想，提防各種危機了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340839
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340839,
					"content": "那麼他一定會在稻妻城內佈設許多眼線，我們要做的，就是讓這些眼線成為假情報潛滋暗長的溫床。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340840
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340840,
					"content": "九條大人，有些具體的工作需要您去完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340841
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340841,
					"content": "神里綾人為九條鐮治說明了具體安排，之後又過了一段時間…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340842
					]
				},
				{
					"id": 120340842,
					"content": "時候差不多了。我的忍者已經定位到其中一名眼線，各位，一起去看看他會不會中計吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 1203409,
			"completionStepIds": [
				1203414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203414",
							"2"
						],
						"stepId": 1203414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀夫",
					"岡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340901,
					"content": "哇，怎麼有這麼多天領奉行的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340902,
					"content": "請問各位，這條路上是發生什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340903
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340903,
					"content": "我是做生意的商人，這條路被重兵把守，我有點怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340904
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340904,
					"content": "啊，不用擔心，相信你也聽說了，九條鐮治大人和柊千里小姐將於近日成婚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340905
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340905,
					"content": "九條大人的想法是，將柊小姐提前接到稻妻城來住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340906
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340906,
					"content": "這、這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340907
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340907,
					"content": "我們這裡的人，都會為柊小姐開路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340908
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340908,
					"content": "不只是我們，你往前走會遇到更多天領奉行眾，我們的職責都相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340909
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340909,
					"content": "…這會不會太隆重了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340910
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340910,
					"content": "這樣才顯得九條大人很重視柊小姐，他希望從始至終都維持最高的規格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340911
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340911,
					"content": "我、我知道了…不好意思，打擾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340912
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340912,
					"content": "糟了，糟了，和老爺的猜想完全一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340913
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340913,
					"content": "這些人說是在路上護衛，要是老爺不打算讓柊小姐離開，這些人遲早會衝進離島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340914
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340914,
					"content": "不對，柊小姐離開，這幫人更有理由衝進來了…跟天領奉行作對，現在老爺怎麼有勝算啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340915
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340915,
					"content": "馬上回去，得馬上告訴老爺才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340916
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340916,
					"content": "他跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340917,
						120340918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340917,
					"content": "嚇得臉色蒼白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340919
					]
				},
				{
					"id": 120340919,
					"content": "這樣就差不多了，種子已經種下。如今的氛圍，此起彼伏的猜忌，都會成為滋養恐懼的養分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340920
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340920,
					"content": "之後，就靜待它的成長與發酵吧。最令人不安的，永遠都是暴風雨前的寧靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340921
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340921,
					"content": "他們真的會乖乖知錯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340922,
					"content": "#好奇的話，兩天之後，{F#妳}{M#你}們去離島看看柊家的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340923
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340923,
					"content": "我還有許多事務要處理，就先不為這件事費神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340924
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340924,
					"content": "——何況，該佈的棋子已經落下，他們遲早會繳械投降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340925
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340925,
					"content": "你這麼有自信嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340926
					]
				},
				{
					"id": 120340926,
					"content": "也不是第一次處理這樣的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340927
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340927,
					"content": "那麼，各位再會吧。我由衷希望柊千里能因此受益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340928
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340928,
					"content": "他就這麼走了…事情真的就會像他預料的那樣發展嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340929,
						120340930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340929,
					"content": "還是關注到最後吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340931
					]
				},
				{
					"id": 120340931,
					"content": "嗯，我也有同感。那兩天之後我們去離島看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340930,
					"content": "我還是擔心柊千里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340931
					]
				},
				{
					"id": 120340918,
					"content": "他意識到事件的嚴重性了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340919
					]
				}
