			"dialogs": [
				{
					"id": 120340501,
					"content": "你看，勘定奉行柊家的大小姐，還有天領奉行九條家的二少爺，這兩個人要結婚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340502
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340502,
					"content": "咳咳…沒有比這更門當戶對的情況了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340503
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120340503,
					"content": "我也覺得，只是這消息來得有點突然，之前一直沒聽說呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340504
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340504,
					"content": "祝福他們吧，能邁出這一步，我想也很不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷升"
				}
			]
		},
