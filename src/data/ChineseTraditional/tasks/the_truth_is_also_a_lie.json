				"points": []
			},
			"dialogs": [
				{
					"id": 120340201,
					"content": "可惡，我們走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340202
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340202,
					"content": "得馬上告訴老爺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340203
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340203,
					"content": "喂，不准跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340204,
					"content": "不用追。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340205
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340205,
					"content": "有餌才有魚，隨他們去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340206
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340206,
					"content": "剛才戰鬥中他們似乎把鑰匙掉在了地上，我們先把新之丞救出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340207
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340207,
					"content": "不過，戰鬥中一片混亂，是被踢到哪裡去了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340208
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340208,
					"content": "欸？是狸貓，不會被狸貓拿走了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120340209,
					"content": "追上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
