			"dialogs": [
				{
					"id": 220410301,
					"content": "怎麼樣，汝等找到昆布丸了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410302,
					"content": "已經找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "欸！牠又跑不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220410304,
					"content": "我這就接著抓牠回來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "汝等，不用去找牠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410307,
					"content": "這孩子果然還在和奴家賭氣…等會奴家自己再去教訓一下那孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410308,
					"content": "明明都快成為一隻大貓了，怎麼還是這麼任性，到時候要是驚到了來神社的人類可怎麼辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410309,
					"content": "喔，這些東西給汝等，謝謝汝等幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410310,
					"content": "唉，為什麼這孩子不能和「阿飯」一樣聽話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410305,
					"content": "我今天還不信了…",
