			"dialogs": [
				{
					"id": 220410101,
					"content": "汝等來了啊，來得正好，奴家正在煩惱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "汝等還記得「昆布丸」這個孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410104,
					"content": "這孩子去附近玩了之後，到現在也沒有回來，奴家很擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410105,
					"content": "拜託汝等，去附近找找「昆布丸」，再把牠帶回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410106,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "那就拜託汝了，快點找到「昆布丸」，把牠帶回神社來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410108,
					"content": "只有牠跑出去了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "只有這孩子…也許是上次奴家訓斥了牠，讓牠不高興了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410110,
					"content": "這孩子，為什麼總是這麼不聽話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220410111,
					"content": "拜託汝了，快點找到「昆布丸」，把牠帶回神社來吧。",
