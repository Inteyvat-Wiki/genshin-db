			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們好。吃了嗎？今天有什麼特別的預定安排嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040702,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "瞭解了。四處走走，用鏡頭記錄見聞，是不錯的放鬆方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040705,
					"content": "#不過，我沒有在{F#妳}{M#你}身上偵測到留影機呢。是不是出門的時候太匆忙，把它忘在什麼地方了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040703,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
