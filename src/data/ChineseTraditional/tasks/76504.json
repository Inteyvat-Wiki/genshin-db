			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊涅芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們好。吃了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040102,
					"content": "伊涅芙？妳怎麼也跑到屋頂上來啦。難道是…在觀察雲的形狀，計算下雨的機率？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040103,
					"content": "我正在執行一項…意外偏離預定軌道的任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040104,
					"content": "原定計畫是為愛諾採購她清單上指定的「高精度齒輪」和「特製六角螺絲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040105,
					"content": "但在返回工坊的途中，遭遇了一次…不可預見的物資攔截事件。一隻鷹隼以極快的速度從我的手中叼走了那枚特製螺絲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040106,
					"content": "所以妳就跑到屋頂上來找鷹隼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "是的。根據該生物的習性，屋頂是其可能的臨時停落點。我正在進行全方位的視覺掃描與聲音探測，試圖定位目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040108,
					"content": "不過，截至目前，並未捕捉到有效蹤跡。初步推測，目標已逃離我的追蹤範圍，或已將「獵物」轉移至更隱密的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040109,
					"content": "備用計畫已啟動：重新前往指定供應商處，採購一枚同型號螺絲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040110,
					"content": "#話說回來。{F#妳}{M#你}們出現在高處，難道也在…追蹤某種小動物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040111,
					"content": "沒有沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "對呀對呀，我們本來是想找個視野開闊的地方，拍一拍那夏鎮的全景照片，記錄下這裡繁忙又有活力的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040114,
					"content": "想不到竟然會在這裡遇上正在「追捕小偷」的伊涅芙！這也是一種超低機率的「偏離軌道的驚喜事件」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040115,
					"content": "機會難得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "可以。請指示我需要配合的站立位置、身體朝向以及推薦的面部表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040118,
					"content": "#我想，我會登上屋頂，然後在這裡遇到{F#妳}{M#你}們，還能讓{NICKNAME}為我拍攝畫片，這一系列事件的發生機率，恐怕比那隻鷹隼歸還螺絲還要低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040119,
					"content": "請務必將這難得的「驚喜」時刻，精確地記錄下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040116,
					"content": "可以為妳拍攝畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "我只是在尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
