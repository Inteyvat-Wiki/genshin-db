			},
			"dialogs": [
				{
					"id": 750150401,
					"content": "#鏘鏘！真不愧是{NICKNAME}，把這條囂張的魚抓到囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150402,
					"content": "對了，如果一次把餌全部灑進去，讓魚吃到翻肚皮自己漂上來，是不是也算一種「釣魚」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150403,
					"content": "啊…啊嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也覺得這樣可以嗎？看你的眼神很期待呢！嘿嘿，下次我們一起試試看呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150405,
					"content": "啊嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#哇！還沒有烤呢，要等{NICKNAME}做好才能吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150407,
					"content": "做完了烤魚，大家一起飽餐一頓。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "總覺得這頓烤魚格外地香，不愧是我釣起來的魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150410,
					"content": "不愧是派蒙，以後都交給妳了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150412,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#不要想著不勞而獲，如果想要吃魚，那{REALNAME[ID(2)|SHOWHOST(true)]}你下次也要幫忙才可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750150414,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "這種時候就開始裝傻了，你這傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
