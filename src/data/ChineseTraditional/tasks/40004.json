				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "英雄大人，神仙哥哥！手下留情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "貝兒"
				},
				{
					"id": 400040802,
					"content": "那匿名信一紙胡言亂語，不必這般兵戎相向的！拿去便是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "伶俐鬼"
				},
				{
					"id": 400040803,
					"content": "真巧，我早就這麼覺得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME}，來看看匿名信的內容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040805,
					"content": "原來如此，那麼就讓這兩位前去赴會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040806,
					"content": "寄信之人可能對海燈節圖謀不軌，似乎準備縱火焚城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040807,
					"content": "如此甚好。你們也好，我們也好。只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "貝兒"
				},
				{
					"id": 400040808,
					"content": "只是，他們兩人和我們兩人，未免體形相差太大了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "伶俐鬼"
				},
				{
					"id": 400040809,
					"content": "不用擔心，喬裝打扮之後就認不出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040810,
					"content": "雖然我覺得哪裡不對，但是既然有仙人撐腰，應該不要緊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "貝兒"
				},
				{
					"id": 400040811,
					"content": "那…那璃月安危就託付兩位了，我們盜寶團也不希望全城盡毀啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "伶俐鬼"
				},
				{
					"id": 400040812,
					"content": "既然如此，我們就這樣講定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040813,
					"content": "請等等…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040815,
					"content": "我們下一次見面的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040817,
					"content": "希望是能看到明霄燈的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "…我不喜歡人來人往之處，尤其是每年的這幾天裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040819,
					"content": "非要在那裡不可嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040820,
					"content": "是的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "…我明白了。我會在那裡等你的消息的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
