					"nextDialogs": [
						400040909
					],
					"speakerTitle": "貝兒"
				},
				{
					"id": 400040909,
					"content": "不錯。是我委託他們來調查的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400040910,
					"content": "現在，還有什麼問題嗎？",
