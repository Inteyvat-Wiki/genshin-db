						400040902
					],
					"speakerTitle": "貝兒"
				},
				{
					"id": 400040902,
					"content": "那邊不是璃月港嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040903,
					"content": "當然是去璃月港了，因為這裡什麼都沒有啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "貝兒"
				},
				{
