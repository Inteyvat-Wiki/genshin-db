			"dialogs": [
				{
					"id": 400040201,
					"content": "#{NICKNAME}，哦，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040202,
					"content": "凱亞，我們去璃月海燈節了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040203,
					"content": "怎麼樣，海燈節有趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040204,
					"content": "好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040205,
					"content": "那妳好好期待蒙德的羽球節吧。應該也不會讓妳失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040206,
					"content": "說正事吧，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "啊，對了。凱亞，事情是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040208,
					"content": "嗯…建燈用的木、紙、油這些材料…無論怎麼想，都很容易滑向危險的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040209,
					"content": "哼哼，很有意思，你們為什麼覺得我會認識這個符號呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040210,
					"content": "因為凱亞神通廣大，值得信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040212,
					"content": "呵呵呵，不敢當，我哪有那種本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040213,
					"content": "出現了！騎士「謙虛」的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040214,
					"content": "哼哼，在璃月待了一陣子，變得牙尖嘴利了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040220,
					"content": "回到正題吧。這是跨國犯罪組織「盜寶團」的符號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040221,
					"content": "#{F#妳}{M#你}如果有興趣的話，我可以安排{F#妳}{M#你}和線人見一面哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040222,
					"content": "西風騎士團不是不和敵人做交易嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040223,
					"content": "——那是我凱亞的線人，不是西風騎士團的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040224,
					"content": "晚些時候，去風起地吧。我會安排線人去赴會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040225,
					"content": "謝謝你，凱亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040226,
					"content": "記住了，「酒中出真知」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040227,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040215,
					"content": "因為凱亞黑白通吃，可以依賴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040217,
					"content": "嘖嘖。作為榮譽騎士，要慎言啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040218,
					"content": "什麼叫黑白通吃？我們西風騎士團是不和敵人做交易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400040219,
					"content": "這就是騎士「誠實」的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "凱亞"
				}
			]
		},
