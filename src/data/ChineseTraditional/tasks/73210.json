				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "嗯…不知道這裡會有什麼寶藏呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100502,
					"content": "#櫃子中放滿了簿冊，{F#妳}{M#你}們翻了翻，似乎是病歷卡和帳務紀錄之類的醫院文件。\\n失望地關上了櫃子。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "哼，我還以為裡頭有什麼特別的寶藏呢…還不如我們平時冒險的時候見到的木桶木箱呢！裡面起碼還有高麗菜和禽肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100504,
					"content": "欸，這是什麼？好像從裡頭掉出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100505,
					"content": "我看看…說不定有寶藏的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100507,
					"content": "嗚哇，「魔鱗病」看起來好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100508,
					"content": "另一份文件上寫了什麼呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100510,
					"content": "嗯…完全看不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100511,
					"content": "我也看不懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100512,
					"content": "我只看懂了什麼「神的聲音引導」…難道這裡真的會出現奇特的聲音，引導人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100515,
					"content": "可能是「地下水脈或生物活動」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "嗯！確實，說不定地下有什麼遺蹟呢！如果注意到什麼聲音，我們就去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100513,
					"content": "看不懂可能比較好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "#咦？{F#妳}{M#你}看懂了嗎？我只看懂了什麼「神的聲音引導」…難道這裡真的會出現奇特的聲音，引導人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
