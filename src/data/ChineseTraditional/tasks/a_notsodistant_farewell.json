	"talks": [
		{
			"id": 7451001,
			"completionStepIds": [
				7451001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451001",
							"2"
						],
						"stepId": 7451001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"左右加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745100101,
					"content": "是我們贏啦！蕈獸夥伴們大獲全勝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100102,
					"content": "#真是華麗的戰鬥策略，不愧是{F#妳}{M#你}們，「黃金流星」和「白銀伴星」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100103
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100103,
					"content": "#{F#妳}{M#你}們的馴獸才能完全超出了常理，即便在面對常理以外的對手，蕈獸夥伴們也能在{F#妳}{M#你}們的指揮下立於不敗之地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100104,
						745100105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100104,
					"content": "嘿嘿！被海妮耶誇獎了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				},
				{
					"id": 745100106,
					"content": "不過，前幾次有大雪豬王和魔偶劍鬼登場，這次居然連刀子狗都找來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100107,
					"content": "左右加，妳設定對手的陣容，還真是隨心所欲啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100108,
					"content": "這些強敵都是各地冒險家故事中傳說般的存在哦！名氣多多少少漂洋過海，可以引起各地玩家的共鳴嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100109
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100109,
					"content": "作為一個小說作者，我也很喜歡…各種本來無關的角色比拼一番實力的場景，想想都興奮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100110
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100110,
					"content": "#那麼「智巧勇武雙連星」，{F#妳}{M#你}們已經體驗了本次「小小靈蕈大幻戲」的所有關卡，感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100111,
						745100113,
						745100115
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100111,
					"content": "關卡有點少，不夠玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100112
					]
				},
				{
					"id": 745100112,
					"content": "嗯…這符合我們的第二種預期。那下一次暖場活動，還是按照最高規格，製作更多關卡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100117,
					"content": "總之，左右加之後還會查閱更多資料，設計更多強大有趣的對手，讓楓丹人們逐漸喜歡上這個遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100118
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100118,
					"content": "如此一來，我們的贊助商楓達就會持續為我們提供大筆資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100119
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100119,
					"content": "等到籌集了足夠的經費，就能再次舉辦「月蓮盃」那種規模…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100120
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100120,
					"content": "不！是比「月蓮盃」更大的盛會！大賽的賽制也會做出大幅改進，要做到激動人心，又生動有趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100121
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100121,
					"content": "欸嘿嘿！想想就興奮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100122,
						745100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100122,
					"content": "有需要就找我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100124,
					"content": "這是一個長期的計畫，不必計較短時間的進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100125,
					"content": "#經過左右加和貝爾福先生的指導，我也算是個基本合格的商業人士了，當然不能勞煩{F#妳}{M#你}們親自處理細節問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100126
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100126,
					"content": "就算暖場活動和商業洽談結束了，我和左右加也會在楓丹停留很久，帶著蕈獸夥伴們好好旅遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100127
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100127,
					"content": "#我們想定期寄信給{F#妳}{M#你}們，附上蕈獸夥伴的近況和計畫進展的報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100128
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100128,
					"content": "#當然，這需要{F#妳}{M#你}們確認一個固定的收信地點，不然就容易出現以前那樣的情況，聯絡不到{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100129
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100129,
					"content": "固定的收信地點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100130,
						745100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100130,
					"content": "每隔幾天就去的地方嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100132,
					"content": "#完美！那就由我寫信給「智巧勇武雙連星」，代表海妮耶和蕈獸夥伴，向{F#妳}{M#你}們定期匯報情況！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100133
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100133,
					"content": "那就這麼說定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100134,
					"content": "現在「小小靈蕈大幻戲」的人氣還沒降下來，我們還打算再辦一段時間活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100135,
					"content": "#如果{F#妳}{M#你}們不忙的話，還可以再來玩玩這個遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100136,
						745100137
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100136,
					"content": "沒問題哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100138,
					"content": "嘿嘿！感覺這次，海妮耶、左右加和蕈獸夥伴們不會再離開我們很遠，也不會分別許久，安心了很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100139,
					"content": "我越來越期待了，下次馴獸師大賽，到底能辦成什麼樣子呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100137,
					"content": "時間還很多！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100131,
					"content": "好像只有冒險家協會了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100123,
					"content": "我們也懂經營！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100113,
					"content": "關卡剛剛好，很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100114
					]
				},
				{
					"id": 745100114,
					"content": "#多謝肯定…不過，也有可能是{F#妳}{M#你}比較忙，沒有太多時間。我們還是再準備一些備用關卡為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100115,
					"content": "有蕈獸夥伴，我都行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100116
					]
				},
				{
					"id": 745100116,
					"content": "#唉呀！{F#妳}{M#你}還是這樣率性。按照左右加的話，現在{F#妳}{M#你}是我們的老闆，有什麼要求，直接跟我們說就可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100105,
					"content": "哈哈！海妮耶也很強！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				}
			]
		}
	]
}