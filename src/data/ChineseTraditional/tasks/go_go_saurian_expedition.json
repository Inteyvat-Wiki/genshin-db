				"points": []
			},
			"dialogs": [
				{
					"id": 756650101,
					"content": "#{F#妳}{M#你}們好，歡迎來到「龍龍遠征隊補給站」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650102
					],
					"speakerTitle": "薇內什"
				},
				{
					"id": 756650102,
					"content": "哇，好多小龍圍在這裡。大家都是準備去找海風草的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756650103,
					"content": "時間不等人，尋找海風草的小隊已經出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650104
					],
					"speakerTitle": "薇內什"
				},
				{
					"id": 756650104,
					"content": "這些「小朋友們」雖然也想幫忙，但不管伊法前輩和咔庫庫前輩怎麼教導，牠們都不太理解什麼是海風草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650105
					],
					"speakerTitle": "薇內什"
				},
				{
					"id": 756650105,
					"content": "為了不辜負牠們的熱情，伊法前輩還是決定讓牠們加入遠征，不過遠征的內容隨牠們喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650106
					],
					"speakerTitle": "薇內什"
				},
				{
					"id": 756650106,
					"content": "不管是牠們愛吃的顆粒果，還是牠們感興趣的寶貝，想找什麼都沒關係。只要注意安全，平安歸來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650107
					],
					"speakerTitle": "薇內什"
				},
				{
					"id": 756650107,
					"content": "原來是這樣，牠們看上去很高興呢。一定要注意安全呀，外面可是有很多壞魔物哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756650108,
					"content": "嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650109
					],
					"speakerTitle": "活潑的小嵴鋒龍"
				},
				{
					"id": 756650109,
					"content": "我們這裡會為參加遠征的小龍提供指導，兩位如果感興趣的話，也可以來看看呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇內什"
				}
			]
		}
	]
