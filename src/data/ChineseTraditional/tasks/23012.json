			"trigger": {
				"objectNames": [
					"莎莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "#{F#妳}{M#你}們已經把小貓帶回來了啊，真是辛苦{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120302,
					"content": "#看樣子，{F#妳}{M#你}們的「貓語」學得也不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120303,
					"content": "#這些報酬給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120304,
					"content": "#能這麼快學會「貓語」的人可真難得，說不定我下次還要麻煩{F#妳}{M#你}幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120305,
					"content": "喵！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "可以說人話啦！莎莉小姐又不是貓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120307,
					"content": "#我可以從{F#妳}{M#你}的表情裡看出來，{F#妳}{M#你}想說的話是「沒問題」，不過…這次{F#妳}{M#你}的發音可不對喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120308,
					"content": "#不過沒關係，我以後會繼續教{F#妳}{M#你}「貓語」的，就讓我們一起來學習吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎莉"
				}
			]
		},
