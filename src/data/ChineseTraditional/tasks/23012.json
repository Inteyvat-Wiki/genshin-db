			"dialogs": [
				{
					"id": 230121101,
					"content": "我之前和貓也正經交流過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "#{F#妳}{M#你}是說「寢子」嗎？不過寢子可是能說人話的貓啊，應該也不算「貓語」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230121103,
					"content": "#沒錯，但作為交換，{F#妳}{M#你}得去幫我把一隻小貓帶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121104,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "#那麼，{F#妳}{M#你}們是答應我了？那就太感謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121109,
					"content": "#咳，咳咳…那就請{F#妳}{M#你}們聽好了，這是我總結了很長時間才總結出的「貓的定型語」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230121105,
					"content": "每個城市的找貓方式都不一樣啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "哈哈，哈…沒錯呢，這麼一想，我們在好多城市裡都幫人找過貓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230121107,
					"content": "是該說每個人都喜歡小貓呢，還是該說…每個養貓的人都會遇見一樣的煩惱呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
