					"莎莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "喵——咳咳，咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120102,
					"content": "妳在做什麼呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "我正在找我家的小貓呢。平常我這麼叫一下，牠們就會回應我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120104,
					"content": "難道是我今天的發音不對嗎？叫了好久都沒回應，真奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120105,
					"content": "不能直接叫牠們的名字嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "對啊，通常來說找小貓的話，都應該直接叫牠們的名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120107,
					"content": "可是，用我們人的語言來呼喚牠們的名字，小貓們肯定也聽不懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120108,
					"content": "咦？這，這麼說倒是有些道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120113,
					"content": "不過，再這麼喊下去也不是個辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120114,
					"content": "#旅行者，我想問{F#妳}{M#你}一個嚴肅的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120115,
					"content": "就交給…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "#…{F#妳}{M#你}想學「貓語」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120118,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120120,
					"content": "妳是說，要教我們學貓說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230120116,
					"content": "報酬不能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "什麼叫做「今天的發音」不對？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "因為我現在發出的這些喵喵聲，其實就是那些小貓們的名字喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120111,
					"content": "畢竟，如果直接用人的語言來呼喚小貓們的名字，牠們肯定也聽不懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "莎莉"
				},
				{
					"id": 230120112,
					"content": "咦？這，這麼說倒是有些道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
