			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30261705,
					"content": "嗯。有什麼想知道的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261706,
						30261717,
						30261729,
						30261735,
						30261743
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261706,
					"content": "關於「虛空」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261707
					]
				},
				{
					"id": 30261717,
					"content": "關於那天我入睡後發生的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261718
					]
				},
				{
					"id": 30261729,
					"content": "關於「散兵」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261730
					]
				},
				{
					"id": 30261735,
					"content": "關於旅途的下一站，楓丹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261736
					]
				},
				{
					"id": 30261790,
					"content": "#關於我的{M#妹妹}{F#哥哥}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261762
					]
				},
				{
					"id": 30261743,
					"content": "沒什麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261744
					]
				},
				{
					"id": 30261707,
					"content": "那件事之後，虛空不再能像原來那樣運作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261708
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261708,
					"content": "綜合考慮之後，我選擇關閉虛空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261709
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261709,
					"content": "不過，這絕對不是什麼壞事。我原本也計劃停止虛空的運作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261710
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261710,
					"content": "由虛空統一管理知識，本來就會限制人們的好奇心並抹殺他們的可能性。我想這並不利於須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261711
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261711,
					"content": "現在人們還會為失去虛空感到不適應，但不用多久，大家就會明白，這樣的生活才更好、更適合他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261712
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261712,
					"content": "而關於須彌的未來…我正準備重新掌控教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261713
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261713,
					"content": "原本的賢者已經接受了屬於他們的懲戒，新的賢者還沒選出。這件事，我也會親自監督。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261714
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261714,
					"content": "我期望中的新一代六賢者會更偏學術，現在，須彌需要這樣的領導者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261715
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261715,
					"content": "另外，赤王子民乃至整個沙漠區域的居民，他們在過去很長的時間裡遭到了不公待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261716
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261716,
					"content": "我已經做出一些相應處理了，重建任何事物都需要時間，但不論是文化、友誼、信任…我們都會重新得到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261718,
					"content": "#{F#妳}{M#你}是說「博士」令{F#妳}{M#你}昏睡之後，究竟發生了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261719
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261719,
					"content": "他奪走了神之心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261720
					]
				},
				{
					"id": 30261720,
					"content": "#{F#妳}{M#你}猜得沒錯…第三席以上的愚人眾執行官都有著堪比神明的實力，那種情況下我並不是他的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261721
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261721,
					"content": "不過，儘管形勢惡劣，我也做到了跟「博士」對等交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261722
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261722,
					"content": "#{F#妳}{M#你}一定記得吧，那個改變了{F#妳}{M#你}命運的——「天理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261723
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261723,
					"content": "事實上，「天理」自從五百年前坎瑞亞災變以後就沉寂至今了。而我利用這一點，威脅了博士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261724
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261724,
					"content": "我告訴他，如果我毀滅這顆神之心，就有可能將「天理」喚醒，雖然只是猜測，也成功反制住了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261725
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261725,
					"content": "事關「法則」，這種等級的毀損，「天理」應該不會坐視不理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261726
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261726,
					"content": "至於我用神之心交換了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261727
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261727,
					"content": "我換到了對「博士」的懲罰，和我身為智慧之神難以拒絕的「知識」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261728
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261730,
					"content": "他一直昏迷不醒，我像藏起一片羽毛那樣，把他藏起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261731
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261731,
					"content": "#我知道{F#妳}{M#你}對他充滿顧慮，可是「曾經成神」的他，身上留有了一些很有用的特質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261732
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261732,
					"content": "不過別擔心，我會看住他，不允許他作惡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261733
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261733,
					"content": "另外，他身上還存在著一些謎團。有些事從我的視角看得很清楚，他自己卻完全沒弄明白呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261734
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261734,
					"content": "未來的事，還得看他造化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261736,
					"content": "#{F#妳}{M#你}們要去那裡了啊，「正義」的國度，楓丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261737
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261737,
					"content": "據我瞭解，那個國家的運轉是建立在一套關於正義的審判體系之上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261738
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261738,
					"content": "是由他們的神明來審判民眾嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261739,
					"content": "並不是，楓丹有一位最高審判官在，通常來說，神明「芙卡洛斯」並不會親自參與審判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261740
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261740,
					"content": "但…幾乎每一場審判，芙卡洛斯都不會缺席，她似乎只是沉醉於那種氛圍而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261741
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261741,
					"content": "身為神明的她，也依舊保留著影響最終判決的權力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261742
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261742,
					"content": "總而言之，是一位…嗯…非常有個性的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261705
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261784,
					"content": "#嗯。再過一段時間，{F#妳}{M#你}們也會啟程，然後離開須彌了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261785
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261785,
					"content": "#我對{F#妳}{M#你}未來的命運很感興趣。那將是無法被觀測，也不會被這個世界所記錄的旅程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261786
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261786,
					"content": "#我曾說命運是終極的知識，而{F#妳}{M#你}的未來則是「終極的命運」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261787
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261787,
					"content": "能認識妳真好，納西妲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261788
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261788,
					"content": "#我才應該好好感謝{F#妳}{M#你}們的到來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261789
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261789,
					"content": "#好啦，就先聊到這裡吧。以後如果{F#妳}{M#你}們想我的話，說不定我會在{F#妳}{M#你}們的夢裡出現喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261762,
					"content": "#從我可以接觸到的紀錄中，{F#妳}{M#你}的血親是忽然出現在坎瑞亞的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261763
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261763,
					"content": "#在坎瑞亞災變以後，{M#她}{F#他}踏上了走遍提瓦特各國的旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261764
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261764,
					"content": "#可是在{M#她}{F#他}的旅程即將結束的時候，世界樹中有關{M#她}{F#他}的紀錄又忽然間模糊掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261765
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261765,
					"content": "#模糊掉了？{M#她}{F#他}遇上了什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261766
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261766,
					"content": "#我能確定的是，似乎有人在為了某種理由而刻意掩蓋{M#她}{F#他}的「命運」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261767
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261767,
					"content": "既然能做到這一點…那個傢伙必然有著非凡的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261768
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261768,
					"content": "難道和「深淵」有關…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261769
					]
				},
				{
					"id": 30261769,
					"content": "#但是，這些資訊好像也沒辦法解釋為什麼{NICKNAME}的血親會是這個世界的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261770
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261770,
					"content": "#有一個值得注意的點，據我所知…在愚人眾的情報體系中，他們也並未將{F#妳}{M#你}的血親列入「降臨者」的範疇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261771
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261771,
					"content": "「降臨者」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30261772
					]
				},
				{
					"id": 30261772,
					"content": "…降臨者是什麼？好像頭一次聽說這個概念…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261773
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30261773,
					"content": "#{F#妳}{M#你}應該也會好奇我究竟用神之心與愚人眾交換了什麼情報吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261774
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261774,
					"content": "其中非常重要的一部分，便是關於這個世界的「降臨者」…不屬於這個世界的外來存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30261775
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30261775,
