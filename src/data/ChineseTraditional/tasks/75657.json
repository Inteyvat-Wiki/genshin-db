					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570231,
					"content": "放鬆的姿勢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570232,
					"content": "好啊，這樣可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570233,
						756570235,
						756570237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570233,
					"content": "很棒！我們開始留影吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570234
					]
				},
				{
