			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}，這裡這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570202,
					"content": "記得嗎？這是我們旅程的起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570203,
					"content": "不知不覺中居然已經走過了那麼多地方，派蒙我心生感慨，想要賦詩一首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570204,
					"content": "請，派大詩人——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "噗嗤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "#{F#妳}{M#你}不要打岔啦，讓我醞釀一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570207,
					"content": "啊！好大一個提瓦特！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570208,
					"content": "啊！走了那麼遠還是沒有把你走遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570209,
					"content": "（保持沉默）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "根本沒有押韻啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "啊！啊…啊不出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570212,
					"content": "哈哈哈哈哈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "派蒙在感嘆這一路的艱難？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "#哼，{F#妳}{M#你}就笑吧，跟{F#妳}{M#你}旅行了這麼久，我已經習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570215,
					"content": "#沒錯，這就是我想表達的重點，唉呀還是{F#妳}{M#你}懂我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570216,
					"content": "說正經的，旅行太久很容易忘記最開始的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570217,
					"content": "比方說現在我就有點記不起來甜甜花釀雞的味道了，明明以前那麼喜歡吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570218,
					"content": "所以我才會想到要買這份留影冊，一起拍下走過的路和遇到的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570219,
					"content": "輕小說和映影裡不是經常有這種橋段嗎？一旦回到最初的起點，就離大結局不遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570220,
					"content": "之所以選這裡留影，不是為了感傷，而是希望我們都能記得來時的路，旅途走得更從容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570221,
					"content": "#{F#妳}{M#你}偷聽我和萬葉說話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "派蒙進化了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "#唔…我承認{F#妳}{M#你}和萬葉說話的時候我在旁邊偷聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570224,
					"content": "真是的，我好不容易創造出的氣氛，這下都沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570225,
					"content": "我明白派蒙的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "我們還要一起走下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "#嘿嘿，{F#妳}{M#你}明白我的意思就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570228,
					"content": "#好了，這張畫片就由提瓦特最好的嚮導來當{F#妳}{M#你}的模特兒，{F#妳}{M#你}覺得什麼樣的姿勢比較好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570101,
					"content": "#欸，等一下，我借給{F#妳}{M#你}的留影機呢？不會丟了吧？快找找有沒有帶在身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
