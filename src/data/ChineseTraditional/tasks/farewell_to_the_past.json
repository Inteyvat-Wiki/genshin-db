			"dialogs": [
				{
					"id": 120410601,
					"content": "終於打敗她了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410602,
					"content": "看來妳的武藝並沒有退步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410603
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410603,
					"content": "但妳的意志又能堅持到什麼時候呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410604
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410604,
					"content": "怎、怎麼會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410605,
					"content": "人偶將軍不會是無敵的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410606
					]
				},
				{
					"id": 120410606,
					"content": "這裡是意識空間，她的存在確實很難撼動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410607
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410607,
					"content": "#她是為了對抗磨損而生的產物。論意志，她能凌駕於一切生靈之上，包括{F#妳}{M#你}我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410608
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410608,
					"content": "那、那這場戰鬥不就是沒有盡頭的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410609,
					"content": "或許吧。但我必須向她證明，此刻我的意志絕非磨損的產物。我將鑄就的未來，會是經得起磨損的偉業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410610
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410610,
					"content": "不這樣做，將軍的法則就無從改變，稻妻亦無「前進」可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410611
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410611,
					"content": "這是我的責任。無論這場戰鬥要持續多久，數月、數年、十幾上百年…無論多少次，我都會擊敗她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410612
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410612,
					"content": "那這段時間稻妻怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410613
					]
				},
				{
					"id": 120410613,
					"content": "五百年前，人類憑藉奮戰證明了自身的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410614
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410614,
					"content": "現在，他們又靠著「願望」革除舊弊，就像古老的櫻樹也會長出新枝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410615
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410615,
					"content": "——我該學會信任他們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410616,
						120410617
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410616,
					"content": "但妳忍心讓人類獨自前行嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				},
				{
					"id": 120410618,
					"content": "我明白。但假如真所說的「夢想」才是真正的永恆，那麼將軍所不存在的「須臾」，也不足為懼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410619
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410619,
					"content": "若是為了稻妻無窮的未來，我的戰鬥無論多漫長，在「永恆」中也只如一瞬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410620
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410620,
					"content": "#我向稻妻的臣民們許諾，定會歸來。這份諾言，由{F#妳}{M#你}見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410621
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410621,
					"content": "我不在的這段時間，一切就交給神子她們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410622
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410622,
					"content": "可是、可是這樣一來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410623,
					"content": "轉告我的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410624
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410624,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410625
					]
				},
				{
					"id": 120410625,
					"content": "嗚哇——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410617,
					"content": "大家都認為將軍大人是希望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				}
			]
		},
