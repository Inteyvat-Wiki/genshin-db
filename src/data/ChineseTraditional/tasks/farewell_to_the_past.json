			"dialogs": [
				{
					"id": 120410301,
					"content": "牠們的進攻，好像終於停止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410302
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410302,
					"content": "我還是第一次打這麼激烈的仗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410303
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410303,
					"content": "謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410304
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410304,
					"content": "欸？妳沒事了嗎？要不要再休息一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410305,
					"content": "沒關係，已經好些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410306
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410306,
					"content": "#{F#妳}{M#你}們身手了得，實在令人刮目相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410307
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410307,
					"content": "那些魔物一定還會回來。到時候，恐怕就不只是獸境獵犬這麼簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410308
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410308,
					"content": "#{F#妳}{M#你}們盡快護送將軍大人返回稻妻城，與大將率領的軍隊會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410309
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410309,
					"content": "見到將軍大人順利歸來，所有人一定會士氣大振。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410310
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410310,
					"content": "那你們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410311,
					"content": "我們留在這裡阻擋怪物，不能讓它們再前進了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410312
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410312,
					"content": "只要兄弟們齊心協力，無論有多少魔物都不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410313
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410314,
						120410315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410314,
					"content": "（不必打擾他們心中的「現實」。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				},
				{
					"id": 120410316,
					"content": "交給我們吧！戰鬥本就是我們最熟悉的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410317
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410317,
					"content": "但將軍大人是特別的，只有將軍大人才能逆轉這絕望的現狀，帶我們走向未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410318
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410318,
					"content": "無論稻妻面對什麼樣的威脅，我們都有理由永遠相信將軍大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410319
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410320
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410320,
					"content": "非常感謝你們，我向你們保證，我會給稻妻一個光明的未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410321
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410321,
					"content": "這份承諾來得有些遲了，但至少，是從此刻開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410322
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410322,
					"content": "將軍大人請放心，有您這句話，我們決不言敗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410323
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410323,
					"content": "我們一定能與您一起，把稻妻失去的東西全都奪回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410324
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410324,
					"content": "常道恢弘，鳴神永恆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410325
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410325,
					"content": "常道恢弘，鳴神永恆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410326
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410326,
					"content": "他們…消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410327,
						120410328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410327,
					"content": "剛剛的承諾，妳是對他們說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410329,
					"content": "兩者皆有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410330
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410330,
					"content": "人們的犧牲曾令我無比痛苦，可我忽視了他們燃盡一切，閃出強光的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410331
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410331,
					"content": "——結果便是在這幾百年裡，我辜負了他們的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410332
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410332,
					"content": "「無論對他們說什麼都沒有意義，他們不過是地脈中一段游離的記憶。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410333
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410333,
					"content": "就算如此，我也要給他們…和直到現在仍深信我的人民一個交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410334
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410334,
					"content": "我覺得，這樣的心意，在幾百年之後能夠被回應，也算收穫回報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410335,
					"content": "謝謝妳的安慰。但這本就是身為稻妻之神應盡的事，我已經做得太遲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410336
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410336,
					"content": "就像那位武士說的，我曾以為，我只需承擔一名戰士所應承受的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410337
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410337,
					"content": "可稻妻更需要的，是像真那樣的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410338
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410338,
					"content": "哪怕我與真完全不同，也永遠無法成為她——我需要做的事也應該和她相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410339
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410339,
					"content": "人類值得妳的信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410340
					]
				},
				{
					"id": 120410340,
					"content": "是啊，多麼強大，堅韌，值得為之驕傲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410341
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410341,
					"content": "被人們崇敬的雷電將軍，萬不可拖了他們的後腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410342
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410342,
					"content": "哦？這樣看來，妳已經想通了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410343,
					"content": "稻妻會有新的變化與可能，但還需要時間。「過去」留給我們的傷痕，會被「未來」的時間撫平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410344
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410344,
					"content": "無論花費多少時間，我都會堅持下去。這就是我許下的承諾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410345
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410345,
					"content": "消滅了獸境獵犬，這件事算初步解決了。現下看來，牠們並不會構成更大的威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410346
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410346,
					"content": "後續事務，比如調查事件原因，養護根系等，就交給天領奉行或社奉行的人去處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410347
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410347,
					"content": "嗯，那我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410348,
					"content": "影雖然看起來還算冷靜，心裡應該很亂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410349,
					"content": "我總覺得，這段時間她變了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410350,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410351,
					"content": "怎麼了，影？快跟上來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410352,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410353
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410353,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410354
					]
				},
				{
					"id": 120410354,
					"content": "妳怎麼了，是不是又難受起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410355,
					"content": "身體…動不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410356
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410356,
					"content": "看來情況比我想的更嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410357,
						120410358
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410357,
					"content": "要不要休息一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410359,
					"content": "不用，是「她」在呼喚我。現在就是最好的時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410360
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410360,
					"content": "#{NICKNAME}，可以扶我一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410361
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410361,
					"content": "我要去鳴神大社下方的洞窟裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410362
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410362,
					"content": "洞窟？裡面有什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410363,
					"content": "那裡…是可以斬斷過去，走向未來的戰場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410358,
					"content": "總之先回稻妻城吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410328,
					"content": "還是對妳自己說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410315,
					"content": "#那就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				}
			]
		},
