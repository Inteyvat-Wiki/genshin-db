				},
				{
					"id": 120410505,
					"content": "有另一個影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410506,
					"content": "又見面了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410507
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410507,
					"content": "此身為內在的協助者，亦是法則的守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410508
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410508,
					"content": "如果內在想要背離法則，那此身…便化作修羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410509
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410509,
					"content": "這種感覺…難道是人偶將軍？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410510,
					"content": "妳以我的身軀遊歷世間，看似掌握了永恆的真諦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410511
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410511,
					"content": "妳認為如今的自己比過去更堅定，所以現在這個妳才是正確的。是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410512
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410512,
					"content": "如今的妳究竟是有了新的想法，還是受到了無可抵禦的「磨損」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410513
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410513,
					"content": "我正是為回答妳而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410514
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410514,
					"content": "我們同為武人，此時此刻的對話方式，只有「戰鬥」這一種吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410515
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410515,
					"content": "嗚哇，等等，氣氛一下就變了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410516,
					"content": "妳妳妳…妳已經沒事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410517,
					"content": "先前種種不適，是將軍在抗拒我繼續使用她的身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410518
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410518,
					"content": "如她所說，一旦我有了「改變」的念頭，她就會視我為敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410519
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410519,
					"content": "只要進入意識空間，我便可獨立於她存在，不再受到干擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410520
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410520,
					"content": "將軍雖是人偶，也有其自我意識。必要時，她會出現在這裡與我對質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410521,
						120410522
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410521,
					"content": "這就是妳曾對我說的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				},
				{
					"id": 120410523,
					"content": "呃…雖然影說過再困難也會去做之類的話，但誰想得到是這種自己打自己的情況啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410524,
					"content": "影和將軍竟然要戰鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410525,
					"content": "我為將軍定下的法則…不，將軍便是過去的我的理想，是「永恆」的基石，難以撼動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410526
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410526,
					"content": "若非必要，我不會嘗試改變她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410527
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410527,
					"content": "就沒有其他辦法了嗎？不動手也能把話說開…之類的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410528,
					"content": "影不是給自己留退路的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410529
					]
				},
				{
					"id": 120410529,
					"content": "可是，她們明明都是為了稻妻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410530,
					"content": "此身，象徵無上威嚴，被授予統領一國之權，凝聚了「雷電將軍」的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410531
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410531,
					"content": "自然也繼承了影前行時不斷失去的痛苦，以及，想要抵達永恆的決心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410532
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410532,
					"content": "一切都是為了對抗「磨損」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410533
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410533,
					"content": "決心、勇氣、愛慕、仇恨…都會在時間長河中變質扭曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410534
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410534,
					"content": "唯有「法則」永恆不變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410535
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410535,
					"content": "這的確是我製造妳之時的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410536
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410536,
					"content": "也變成了我不得不跨越的高牆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410537
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410537,
					"content": "妳，要與我為敵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410538
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410538,
					"content": "我是妳的過去，我是萬世不變的法則，我是「永恆」的守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410539
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410539,
					"content": "而我是，許以臣民一夢的——「雷電影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410522,
					"content": "永恆的防禦機制？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				}
			]
		},
