					"content": "終於到了，入口就在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410402
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410402,
					"content": "居然出現了一個鳥居？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410403,
					"content": "妳還好吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410404
					]
				},
				{
					"id": 120410404,
					"content": "感覺又惡化了…但沒關係，我會盡快結束一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410405
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410405,
					"content": "這裡是曾被我親手封存起來的…雷電真的意識空間入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410406
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410406,
					"content": "看來，「她」已經不允許我胡亂使用這個身體了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410407
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410407,
					"content": "嗯？什麼意思，她到底是誰啊？是在說真嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410408,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410409
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410409,
					"content": "跟到哪裡去…唔，唔哇啊啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
