					"content": "很像「一心淨土」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410504
					]
				},
				{
					"id": 120410504,
					"content": "#{F#妳}{M#你}看，{F#妳}{M#你}看，那邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410505
