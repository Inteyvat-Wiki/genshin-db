					"nextDialogs": [
						120410502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410502,
					"content": "嗚哇！這個地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410503
					],
					"speakerTitle": "派蒙"
				},
				{
