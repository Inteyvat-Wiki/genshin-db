			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410201,
					"content": "影，要不然還是交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410202,
						120410203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410202,
					"content": "妳的狀態確實不對勁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				},
				{
					"id": 120410204,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410205
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410205,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410206
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410206,
					"content": "沒關係，妳先在後面休息，恢復一下體力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410207,
					"content": "我們來對付魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410208,
					"content": "欸…又是那樣的光？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410209,
						120410210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410209,
					"content": "馬上又要來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410211,
					"content": "這、這裡是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410212
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410212,
					"content": "#{F#妳}{M#你}們是…啊，將軍大人也在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410213
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410213,
					"content": "將軍大人您受傷了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410214
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410214,
					"content": "唔…沒事，只是身體有點僵硬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410215
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410215,
					"content": "我等幕府武士，定會護將軍大人周全直至最後一刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410216
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410216,
					"content": "兄弟們，上，魔物又衝過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410217
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410217,
					"content": "不行，太危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410218
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410218,
					"content": "我們的職責正在於此！如果害怕危險，從一開始就不會拿起武器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410219
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410219,
					"content": "不用擔心，將軍大人，正是在這種困境中，神明賜予我們的力量才更有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410220
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410220,
					"content": "那個是，神之眼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410221,
					"content": "沒錯。我知道神明無所不能，願意將力量賜給人類，說明神對我們有深厚的期望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410222
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410222,
					"content": "如今將軍大人遭遇困境，更是我們兌現諾言的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410223
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410223,
					"content": "那時的武人，是這麼看待神之眼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410224,
						120410225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410224,
					"content": "充滿了希望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410226,
					"content": "大家都不知道將軍大人去了哪裡，都很絕望。但我們現在找到了您，您就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410227
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410227,
					"content": "只要您能重新出現在大家面前，我們心中就會重燃希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410228
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410228,
					"content": "這份希望，會成為指引我們穿越黑暗的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410229
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410229,
					"content": "大家，跟我一起戰鬥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410230
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410230,
					"content": "我們也可以戰鬥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410231,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410232
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410232,
					"content": "我知道了，請一定保護好自己的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410225,
					"content": "抗爭之心從未動搖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410210,
					"content": "這次是什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410203,
					"content": "別再硬撐了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				}
			]
		},
