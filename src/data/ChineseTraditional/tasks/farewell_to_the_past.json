			"dialogs": [
				{
					"id": 120410101,
					"content": "還是像剛剛一樣，交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410102
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120410102,
					"content": "喂喂，妳、妳確定自己沒問題嗎？別嚇唬我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410103,
					"content": "沒關係，戰鬥本就是我最熟悉的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
