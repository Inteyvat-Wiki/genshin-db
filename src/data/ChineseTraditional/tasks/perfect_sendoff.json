					"nextDialogs": [
						111130804
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130804,
					"content": "其實確實有個好消息，木木他馬上就要當爸爸了，最近總是在說這件事，好像既開心又緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130805,
					"content": "哈哈哈，他這麼木訥的人，能當好爸爸嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "狼哥"
