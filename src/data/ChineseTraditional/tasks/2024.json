	"talks": [
		{
			"id": 202401,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202401",
							"2"
						],
						"stepId": 202401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20240101,
					"content": "#剛才的話題是不是有些太過嚴肅了，{F#妳}{M#你}還是更喜歡被我捉弄嗎？呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "關於「人偶」將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人偶」將軍的技術源自于某些現今已然失落的知識，或許只有身為神明的她才能知會其中源頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "#不過…倒是有件事{F#妳}{M#你}們應該會感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "在影開始對自己的神明之軀進行自我改造之前，還憑空創造過一個「原型人偶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "那、那難道有三個雷電將軍！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210306,
					"content": "不，那個原型只是為了驗證可行性，外貌和智能都沒有依託影的自身去設計，可以說算是試做品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "按照最初設想，影應當將他直接廢棄，但也許影認為這樣做過於殘酷，便選擇只將他體內的力量封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "後來，他便像個普通人一樣，憑藉自我意識流浪在稻妻的土地上，直到…愚人眾看中了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210310,
					"content": "而那個原型人偶經過愚人眾裡某些奇人異士的調整，解除了力量的封印，甚至比封印之前更強大也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "莫非…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "嗯，神之造物親手奪去了神之心…那個原型人偶便是如今的「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "居、居然還有這樣的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210314,
					"content": "是啊，究竟是機緣巧合，還是天命註定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "關於前任雷電將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "#{F#妳}{M#你}這個異鄉人居然知道雷神曾經更易過的事…這在稻妻的國民之中也是鮮有人知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "是摩拉克斯曾經提及過，雷神巴爾也已經逝去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210404,
					"content": "嗯，事實是這樣的，「巴爾」與「巴爾澤布」其實是一對雙生魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "雙生…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210406,
					"content": "她們共同贏下魔神戰爭，而後來巴爾建立幕府後，巴爾澤布則以御側「影武者」的身分，成為巴爾的替身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "#巴爾澤布便是{F#妳}{M#你}我熟悉的「影」，而巴爾，其名則為「真」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "在世人眼中，她們二者向來都是統一的存在，她們兩人也一直相互補足，共同治理稻妻，因而民眾也沒有知曉真相的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "不論是「巴爾」這個魔神名諱，還是雷電將軍這個稱謂，其實一直都可以看做是同時指稱她們兩人的，直到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "直到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210411,
					"content": "直到真死於數百年前的一場我未能親身經歷的戰爭，自那以後影才來到了幕前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "一定對影的打擊很大吧，是姐妹的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210413,
					"content": "數百年前的…戰爭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "所以影的轉變也是從那時開始的，對她來說這是最大的「失去」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "原來還有這樣的往事，好像更加理解影一些了…那麼「真」是一個什麼樣的神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210417,
					"content": "我與她相處的時間並不算長，印象裡…是個溫柔的神吧，總是珍惜著眼前的一切美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210501,
					"content": "#關於我的{F#哥哥}{M#妹妹}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "#抱歉，這個我沒什麼頭緒，我對{F#妳}{M#你}們所說的那位神明也並不瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "#但如果{F#妳}{M#你}們還在懷疑影的話，我覺得就有些多慮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "#影不僅不符合{F#妳}{M#你}們之前的描述，而且很久以前便主動放棄神之心，斷絕了與天空島的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "見過以後，感覺確實不是她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "那就好，不然的話，作為雷神眷屬，好像我們的關係就會一下子微妙起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "放心吧，我們不會想和妳打架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210508,
					"content": "#呵呵呵…祝{F#妳}{M#你}們早日達成目的，知曉一切真相吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#至於{F#妳}{M#你}{F#哥哥}{M#妹妹}的蹤跡，我會盡我所能利用一切資源去調查的，包括從綾人那裡借用一些終末番的手下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "#有消息我會通知{F#妳}{M#你}，就算是酬謝的一部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "關於旅途的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "離開稻妻以後的話，我想…去往須彌應該會比較方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "須彌呀，我們一路上見過很多來自須彌的學者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210604,
					"content": "嗯，須彌是智慧之神的國度，他們對智慧與知識的探求是永無止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "但這份執著往往也會衍生出一些令人費解的事，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…在須彌，知識是作為一種「資源」而被統一管理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知識…也是資源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210608,
					"content": "嗯，只是不知道做出這種決定的究竟是那些「賢者」，還是「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「小吉祥草王」？有些可愛的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210610,
					"content": "#欸，原來{F#妳}{M#你}們還不清楚嗎，「小吉祥草王」便是須彌所信仰的神明，是須彌人對她的暱稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "#想必{F#妳}{M#你}們也有些事情想要找她確認吧？祝{F#妳}{M#你}們順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "沒什麼想問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "#這樣啊，那好吧。喔對了旅行者，我送給{F#妳}{M#你}的御守，{F#妳}{M#你}還留著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "當然，我會好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "好好保管，僅此而已嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "#我還以為{F#妳}{M#你}會將它掛在胸前最顯眼的位置，以後逢人便說，這可是兼具智慧與美貌的八重神子大人贈予我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "誰會那樣做呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210707,
					"content": "#呵呵…好了好了。說起來，旅行者，{F#妳}{M#你}的願望又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
