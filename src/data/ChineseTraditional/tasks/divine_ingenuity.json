			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "#旅行者，{F#妳}{M#你}來得正好，這裡有一份委託，我覺得必須要請{F#妳}{M#你}來接下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620102,
					"content": "是什麼危險的委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "這份委託涉及到一座未知的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620105,
					"content": "雖然協會對那座秘境展開了長時間的調查，但一直沒收集到什麼有價值的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620106,
					"content": "負責這次調查行動的宏朗先生說，他需要找一位善於隨機應變的冒險家來協助調查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620107,
					"content": "#我第一時間就想到了{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620108,
					"content": "到底是什麼秘境…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "#宏朗先生就在那座秘境的入口旁邊，如果{F#妳}{M#你}願意幫忙的話，可以去問問他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620110,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716620103,
					"content": "是什麼很難的委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "這秘境到底是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620202,
					"content": "關於委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "#咦？{F#妳}{M#你}…等一下，{F#妳}{M#你}難道就是凱瑟琳小姐說的那位冒險家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620204,
					"content": "#我聽說，{F#妳}{M#你}善於隨機應變，精通各種冒險知識，身手也數一數二…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620205,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "#太好了，有{F#妳}{M#你}過來幫忙的話，我心裡總算有點底了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620208,
					"content": "但是，這秘境到底是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "#我差點忘了…還得向{F#妳}{M#你}介紹一下情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620210,
					"content": "事情是這樣的。在一段時間之前，協會裡的一支冒險家小隊在野外發現了一扇奇怪的大門…就是我身邊這扇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620211,
					"content": "通過大門之後，這支小隊來到了一座未知的秘境中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620212,
					"content": "據第一批進入秘境的冒險家說，當他們進入秘境時，這個秘境就像是一座「空蕩蕩的屋子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620213,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "這只是個比喻，準確來說「長大約五十二步，寬大約五十二步，高未知」的一個區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620216,
					"content": "在這個區域的五十二步之內，都是鋪著石磚的平常區域，但五十二步之外的區域，全都瀰漫著某種深灰色的濃霧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620217,
					"content": "而且，當有人想要跨越邊界，到五十二步之外的區域中時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620218,
					"content": "這個人要嘛會莫名其妙地轉向，向著相反的方向前進…要嘛就是突然消失，然後再出現在所有人的身後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620219,
					"content": "總之，無論用任何方法，都沒人能跨越到五十二步之外的區域中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620220,
					"content": "試過用其他工具探索嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "他們當然試過，但丟出去的東西會回到原地，連火把的光芒都無法探入五十二步之外的區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620222,
					"content": "所以，你是想要讓我們來幫你探索這座秘境嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620223,
					"content": "#是的，不過…{F#妳}{M#你}們要做的，也許不僅僅是「探索」這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620224,
					"content": "在這裡也說不清楚，我們先去秘境裡看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620214,
					"content": "空蕩蕩的…屋子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "算、算是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620302,
					"content": "就是你說的那座和「空蕩蕩的屋子」一樣的秘境？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620303,
					"content": "這就是一般的秘境吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "對啊！這不就是我們經常去探索的那種遺蹟嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620306,
					"content": "這裡確實就是我們正在探索的那座秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620307,
					"content": "這座秘境之所以是現在這個樣子，是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620308,
					"content": "在不久前，它變成了這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620309,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620310,
					"content": "「變」成了這樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "沒錯。這座秘境…會隨著人的心意而變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620312,
					"content": "據當時領導冒險的冒險隊隊長說，他們在那個灰濛濛的環境裡折騰了很久，大家都開始有些失去耐心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620313,
					"content": "這個時候，其中一位成員開始小聲抱怨了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620314,
					"content": "「如果這裡是一座普通的遺蹟，那我們早就探索完了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620315,
					"content": "冒險隊的人又餓又睏，紛紛對他的看法表示同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620316,
					"content": "隨著愈來愈多的人同意這個看法，不知道在哪個刹那，冒險隊突然發現自己已經處在一個「普通的遺蹟」裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620317,
					"content": "這座「普通的遺蹟」裡有機關，有道路，有寶藏…甚至火把都還在燃燒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620318,
					"content": "冒險隊判斷自己無法處理這種情況，就馬上回到了協會報告了這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620319,
					"content": "我們迅速加派人手，對這處秘境展開了更深入的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620320,
					"content": "但到了現在，我們也只知道，這座秘境會隨人的心意而變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620321,
					"content": "如果有多人同時進入秘境，那這個秘境則會根據心願最強烈的人的想法而變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620322,
					"content": "哇！那這裡不是可以再變出一個璃月港來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716620323,
					"content": "這個我們試過了，可是一直沒成功…我想，也許是我們想要再變出個璃月港的心願不夠強烈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620324,
					"content": "總之，我們現在正在招募冒險家進入秘境，拜託他們依照自己的心願，讓這座秘境不斷地變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620325,
					"content": "在這樣的過程中，我們也許能找出這個秘境變化的某些規律，進而找到我們想要的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620326,
					"content": "那我要怎麼操作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "#{F#妳}{M#你}看到那邊的機關了嗎？那就是我們設定的「觸發器」，是一個冒險家想出來的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620329,
					"content": "簡單來說，他的心願是「只有觸摸這個機關才能讓秘境開始變化」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620330,
					"content": "然後，這座秘境也回應了他的心願，但為了保證這個機關一直存在，我們隔段時間就要讓他重新回來一趟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620331,
					"content": "居然有這種方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "這也是一種應急方案啦，不然，這座秘境說不定就要變化個不停了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620333,
					"content": "不過從另外一個角度來說，這座秘境還挺適合鍛煉冒險家的，畢竟只要一動念頭，各種機關和地形都能變出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620334,
					"content": "#光是說{F#妳}{M#你}一定也不明白，乾脆{F#妳}{M#你}親手來試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620335,
					"content": "#{F#妳}{M#你}看見那邊的金色「冒險幣」了嗎？那也是我們用心願變出來的小玩意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620336,
					"content": "#旅行者，{F#妳}{M#你}先來試試拿到那枚「冒險幣」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 716620327,
					"content": "要用什麼特殊方式嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "看起來還挺熟悉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
