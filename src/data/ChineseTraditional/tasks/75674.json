			},
			"dialogs": [
				{
					"id": 756740101,
					"content": "如此如此…這般這般…小賊們肯定會跪地哭號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740102,
					"content": "這種時候「失誤放跑」一個小賊，他鐵定會驚恐地回去通風報信，妳再悄悄尾隨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740103,
					"content": "就能在小賊們商量對策的時候，踹開他們老巢的大門，給他們恐怖映影般的驚嚇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740104
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740104,
					"content": "您說得很有道理，昂吉安妮小姐。對付軟硬不吃的惡人，的確要用超出常理的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740105
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740105,
					"content": "納塔不像楓丹，有那麼繁瑣…咳，「嚴格的執法程序」！我會好好利用這個優勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740106
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740106,
					"content": "之前我抓到了幾個漏網的龍販子，就用您說的辦法，再把北邊的走私犯也一窩端掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740107
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740107,
					"content": "到時候記得給我捷報哦，我超期待的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740108,
					"content": "唉呀…現在我不再是執律庭的成員了，按照保密條例，蒂蕾娜也不能向我匯報她的工作情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740109
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740109,
					"content": "總覺得，自己還有一些本領沒和有需要的人分享……要不要，乾脆寫一本回憶錄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740110,
					"content": "嗯，只對各國執法人員發售的回憶錄！我這150年的工作經驗應該能幫上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740111
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740111,
					"content": "我支持！等妳好好享受這次派對，玩得身心舒暢，創作起來絕對也順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740112,
					"content": "到時候請幫我留一本簽名版的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740113
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740113,
					"content": "第一個送妳！這次跳舞跳個盡興，我回去就租一臺打字機，立刻開寫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740114,
					"content": "美露莘和…努斯妲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740115,
					"content": "又一對沒想過的組合，在聊什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740116,
						756740117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740116,
					"content": "聽起來是很有趣的內容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				},
				{
					"id": 756740118,
					"content": "好啊，我們的「杜麥尼」登場了！領舞者就位，派對進入正題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740119
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740119,
					"content": "#當務之急是告訴{F#妳}{M#你}們特大好消息——我們第二次「舞力聚會」已經開始了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740120
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740120,
					"content": "還有全新的參與者：來自楓丹旅遊團的昂吉安妮小姐，和她的三位夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740121
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740121,
					"content": "另外，多虧「烏沙博蒂」卡齊娜和蒙德的偶像小姐，楓丹客人和這邊的阿夏都學會了全新的舞步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740122,
					"content": "等等等等，一下子接收到太多資訊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740123,
					"content": "意思是，除了之前跳舞的大家和小龍，還有美露莘和…阿夏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740124,
					"content": "對哦！所以我們能在更新、更歡快的音樂裡，跳出更盡興的舞蹈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740125
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740125,
					"content": "作為領舞的「杜麥尼」也能展現自己對所有節拍的適應力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740126,
						756740127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740126,
					"content": "熱鬧一點的確更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740128,
					"content": "#等等，努斯妲叫{F#妳}{M#你}「杜麥尼」…{NICKNAME}就是「杜麥尼」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740129
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740129,
					"content": "教我跳舞的那位「回聲之子」小勇士說，她的師父是納塔最最厲害的「杜麥尼」，也很會跳舞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740130,
					"content": "#繞了半天，原來就是{F#妳}{M#你}啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740131,
						756740135
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740131,
					"content": "那現在我是妳的師祖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740132
					]
				},
				{
					"id": 756740132,
					"content": "噗…那我也是昂吉安妮師祖那一輩的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740133,
					"content": "不行不行，怎麼感覺地位降了兩段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740134
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740134,
					"content": "各論各的，各論各的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740139,
					"content": "話說回來，跳舞這種事情很看天分的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740140
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740140,
					"content": "#說不定我就是小說主角級的天才，練了兩天就跳得和{F#妳}{M#你}差不多呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740141
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740141,
					"content": "當然，也沒必要比個高下，我的意思是…最好搖的節奏、最時髦的舞步，我都跟得上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740142
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740142,
					"content": "沒錯沒錯，跳舞這種事，開心就好！就算只能卡準節奏搖擺搖擺，也是好好參與！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740143,
					"content": "看來，一切都準備就緒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740144
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740144,
					"content": "#如果「杜麥尼」想先和朋友們聊聊天，她們都在那邊等著{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740145
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740145,
					"content": "這邊也隨時可以讓大家聚集起來，奏響音樂，開始派對的正題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756740135,
					"content": "特巡隊警官的情報不夠廣啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740136
					]
				},
				{
					"id": 756740136,
					"content": "就是嘛就是嘛，看來妳這個教官也有大意的時候嘛，怎麼能不收集鄰國的重要資訊呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756740137,
					"content": "話不能這麼說，我又沒有在境外行動的需求。和我無關的事情，幹嘛要去管？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740138
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740138,
					"content": "知道的事情越多，有時候越容易心亂，明白嗎？這個叫做情報集中度的管理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756740127,
					"content": "人多的派對更歡樂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740117,
					"content": "聽起來是很危險的內容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				}
			]
		}
	]
}