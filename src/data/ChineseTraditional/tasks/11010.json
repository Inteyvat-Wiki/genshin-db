	"talks": [
		{
			"id": 1101001,
			"completionStepIds": [
				1101001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
