				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "這樣不合適吧，執行官大人，您怎麼能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "葉卡捷琳娜"
				},
				{
					"id": 110100302,
					"content": "偶爾一次嘛，沒關係沒關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100303,
					"content": "哦？這個人怎麼也在這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100304,
					"content": "哥哥！哥哥、哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100305,
					"content": "啊這聲音是…托克！天啊，是托克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100306,
					"content": "哈哈哈…這是你給我準備的驚喜嗎，托克？我還以為要等我回了至冬才能見到你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100307,
					"content": "你的冬妮婭姐姐，還有安東哥哥…他們怎麼樣？過得好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100308,
					"content": "他們都可想你了，冬妮婭姐姐每天晚飯前都在禱告，祈求哥哥的平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100309,
					"content": "…等等，不對，托克！你是怎麼來璃月的，我怎麼沒接到任何消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100310,
					"content": "唔，這個…我見到一艘像是賣玩具的船，還以為哥哥在上面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100311,
					"content": "下了船以後我走啊走，然後就見到了「獨眼小寶」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100312,
					"content": "#「獨眼小寶」趕走了一個壞蛋，再然後，我就跟著好人{F#姐姐}{M#哥哥}過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100313,
					"content": "居然是偷渡嗎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "而且…托克居然是「公子」的弟弟嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100316,
					"content": "那看來托克的錢，我們收得心安理得呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100317,
					"content": "這太危險了托克，見到你我的確很開心，但是答應哥哥，以後不許做這樣冒險的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100318,
					"content": "唔…托克知道了，哥哥，請你不要生我的氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100319,
					"content": "哥哥沒有生氣，我只是在擔心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100320,
					"content": "如果不是遇上了這兩位，托克的處境可能就危險了。有好好道謝過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100321,
					"content": "嗯！托克可懂禮貌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100322,
					"content": "終於注意到我們了嗎，「公子」哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100323,
					"content": "#哈哈哈哈，真是不好意思，與家人的交流無論何時都是該放在第一位的，還請{F#妳}{M#你}們諒解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100324,
					"content": "還有，雖然之前我們有過一些對立的經歷，不過拋開那些立場上的問題…我們不是相處得挺愉快的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100325,
					"content": "這只是場面話吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "呵呵，關於「那件事」，我們都不過是棋子而已。至於棋局的勝負和收拾棋盤的工作…就交給那些對弈的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100328,
					"content": "而我真正在乎的，只有我們之間，那一戰的勝負而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100329,
					"content": "怎麼，你還想再輸一次嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100330,
					"content": "哈，我可是每一秒都在變強的達達利亞，下次請做好苦戰的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100331,
					"content": "我也已經不是那時的我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "喂喂，你們現在就要打嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100334,
					"content": "哈哈哈…這次就算了，打架會教壞小孩子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100335,
					"content": "#打架？哥哥和好人{F#姐姐}{M#哥哥}關係不好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100336,
					"content": "#沒有沒有，怎麼會呢？{NICKNAME}，容我正式感謝{F#妳}{M#你}護送我的弟弟，他的安危對我來說真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100337,
					"content": "我還是會提防你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "話說…我忽然想起一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100340,
					"content": "托克說，哥哥是「玩具銷售員」是怎麼回事？你不是愚人眾的執行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100341,
					"content": "咳咳…嗯…啊~！妳說那個呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100342,
					"content": "噓…因為小孩子眼裡，賣玩具是最讓人羡慕的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100343,
					"content": "而且，我不想讓家人接觸到愚人眾的…或者說至冬國的…陰暗面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100344,
					"content": "雖說年長一些的弟弟妹妹們都已經知道我在為女皇陛下效力了，但在最小的弟弟眼裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100345,
					"content": "咳咳，我依舊是至冬最出色的外派玩具銷售員，暫時隸屬於璃月分部的「玩具研究所」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100346,
					"content": "就是就是，我哥哥超厲害的！是「獨眼小寶」的好夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100347,
					"content": "這件事請一定在托克面前配合我，拜託拜託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100348,
					"content": "哦對了，葉卡捷琳娜小姐，收錢的事，我現在就準備動身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100349,
					"content": "這是見勢不妙要開溜了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100350,
					"content": "可是，我們剛才就在說，麻煩「公子」大人處理債務…？這實在有些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "葉卡捷琳娜"
				},
				{
					"id": 110100351,
					"content": "願賭服輸嘛。既然打賭輸給那位「債務處理人」，就順便活動一下筋骨好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100352,
					"content": "哥哥要去賣玩具了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100353,
					"content": "#沒錯。雖然哥哥也很想陪托克，可是畢竟工作在身，不如還是讓帶你來的{F#姐姐}{M#哥哥}陪你吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100354,
					"content": "還要我們做保姆嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100355,
					"content": "#嗯！托克喜歡和好人{F#姐姐}{M#哥哥}一起，而且我們打過勾勾了，約好要照顧托克的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100356,
					"content": "#嗯，托克喜歡和{F#妳}{M#你}一起，而且你們打過勾勾了，約好要照顧托克的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100357,
					"content": "這就是所謂的兄弟齊心嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "#有勞了，這些錢交給{F#妳}{M#你}們，就當是活動資金，請帶托克在璃月隨便轉轉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100360,
					"content": "如果遇上什麼萬不得已的情況，就來<color=#00E1FFFF>青墟浦附近的河邊</color>找我，回頭見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100358,
					"content": "看在托克的份上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "擔憂家人的心情，我能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "隨時奉陪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "你還好意思說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "托克居然是「公子」的弟弟嗎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
