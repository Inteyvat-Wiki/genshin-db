			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴派"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "當心，旅人。最近可不是觀光的好時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100102,
					"content": "咦，最近出什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100103,
					"content": "嗯。總部接到多起目擊報告，有一些本不該出現的遺蹟守衛，晃蕩在本不該出現的地區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100104,
					"content": "教頭派人追查這些古代機器的來源，發現似乎是從一處遺蹟裡突然冒出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100105,
					"content": "是誰把它們吵醒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100106,
					"content": "不清楚，我們獲知的情報太少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100107,
					"content": "況且那遺蹟陰森森的，裡面不時還會傳出「咔啦咔啦」的響聲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100108,
					"content": "在總部的批准下達之前，我們是不被允許進入探索的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100109,
					"content": "確實是謹慎為妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "總之目前最好的策略，就只有加強巡邏，避免一般民眾受到波及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100114,
					"content": "唔，普通人撞上遺蹟守衛的話，可就危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100115,
					"content": "我能幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "#呃，{F#妳}{M#你}的心意我十分感謝，可是…萬一讓{F#妳}{M#你}因此陷入危險，那可就得不償失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME}{F#她}{M#他}可是很能打的，你放心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100118,
					"content": "沒關係的，我會一點防身術。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100122,
					"content": "既然如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100123,
					"content": "我之前在<color=#00E1FFFF>山坡上</color>見到了一些遺蹟守衛的腳印，但後來光顧著警告附近的路人，還沒來得及開展調查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100124,
					"content": "嗯，要從這條線索開始調查嗎？交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100125,
					"content": "#「千岩牢固，重嶂不移」，向{F#妳}{M#你}致敬，旅行者。等我這一遍巡邏完，會再來與{F#妳}{M#你}們會合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100120,
					"content": "這麼講很不禮貌，但我能打十個你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "哈哈，年輕人很自信嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100110,
					"content": "辦事效率好低。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "#嗯？{F#妳}{M#你}剛才說了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100112,
					"content": "#喂，{F#妳}{M#你}的口吻怎麼像迪盧克老爺評判騎士團一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "#{F#姐姐}{M#哥哥}快看！好大，好威風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100202,
					"content": "咦，是個裝扮奇怪的小朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100203,
					"content": "#我還是第一次這麼近距離看呢，{F#妳}{M#你}們認識它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100204,
					"content": "是失去動力的「遺蹟守衛」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "錯啦錯啦，什麼「遺蹟守衛」，它的名字是「獨眼小寶」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100208,
					"content": "「獨眼小寶」？…原來還有這麼可愛的叫法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100209,
					"content": "嗯！是我哥哥告訴我的，我哥哥是最厲害的玩具銷售員，專門賣這種玩具的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100210,
					"content": "他現在在璃月的「玩具研究所」工作，「獨眼小寶」就是在那裡出生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100211,
					"content": "#{F#姐姐}{M#哥哥}{F#妳}{M#你}應該也很喜歡玩具吧，{F#妳}{M#你}身邊飄著的這隻是最新款嗎？居然還會說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100212,
					"content": "派蒙和遺蹟守衛都不是玩具…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "是的！沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100216,
					"content": "辛苦你們了，有什麼頭緒嗎…嗯？這個外國的小朋友是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100217,
					"content": "是剛剛我們偶然遇到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100218,
					"content": "這可不行，小朋友。這一帶有殺人機器在遊蕩著，很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100219,
					"content": "「殺人機器」？叔叔是說，像這個樣子的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100220,
					"content": "是的沒錯，包括這隻也是一樣，萬一忽然動起來可就糟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100221,
					"content": "才不是什麼殺人機器！「獨眼小寶」是正義的夥伴，不許你這麼說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100222,
					"content": "獨…獨眼什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100223,
					"content": "#{F#姐姐}{M#哥哥}，這個叔叔在說「獨眼小寶」的壞話，所以他肯定是壞人，我們千萬不要理他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100224,
					"content": "小朋友，我只是出於好心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100225,
					"content": "他已經不會聽你的話了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "真沒辦法，我一向不擅長應付小孩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100228,
					"content": "你快繼續忙你的事情吧，我們會保證他的安全的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100229,
					"content": "好吧，也只能這樣了…那我繼續在附近巡邏，請你們把小朋友帶到安全的地方去吧，這裡還是太危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "戴派"
				},
				{
					"id": 110100230,
					"content": "哼~哼~「獨眼小寶」又嚇跑了壞蛋~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100231,
					"content": "你叫什麼名字，小朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "啊，我是托克！托克是從遙遠的至冬國來璃月找哥哥的，可是托克一個人，不知道哥哥在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100234,
					"content": "居然是至冬國來的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100235,
					"content": "對了，這種時候的話…這個，給！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100236,
					"content": "嗯？什麼東西…沉甸甸的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100237,
					"content": "這是…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100238,
					"content": "好多摩拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "這些是我哥哥讓我帶在身上的，我哥哥說了，把這些交給好人，好人就會對托克好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100241,
					"content": "好、好像很有道理…能從至冬來璃月難道就是靠這個嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100242,
					"content": "看來托克是個大戶人家的孩子啊，原來賣玩具是這麼賺錢的生意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100243,
					"content": "我收下了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#嗚啊，真的嗎！謝謝好人{F#姐姐}{M#哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100246,
					"content": "那麼，和托克打勾勾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100247,
					"content": "「打勾打勾不許變，變了丟他去冰川。冰川冷，雪原寒，撒謊的舌頭全凍爛！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110100248,
					"content": "真是殘酷得很有至冬國特色的童謠呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100249,
					"content": "既然如此，只好當一段時間保姆了呀…可是，要到哪裡去找他的哥哥呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100250,
					"content": "和至冬國關係密切的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "和至冬國關係密切…對了，那就去<color=#00E1FFFF>北國銀行</color>問問看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100254,
					"content": "要出發了嗎？托克終於又要見到哥哥啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托克"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>北國銀行</color>？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "嗯，好主意！到那邊去問問看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100244,
					"content": "我收下了…（見到他哥哥就還回去吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "好多好多摩拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "你的家人在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "還是交給我吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "嗯，羡慕吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "喂！我怎麼又成了新的奇怪東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110100206,
					"content": "小心，它很難對付。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "沒錯！「獨眼小寶」超~~~厲害的，沒有壞蛋能逃過它的手掌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "托克"
				}
			]
		},
		{
			"id": 1101003,
