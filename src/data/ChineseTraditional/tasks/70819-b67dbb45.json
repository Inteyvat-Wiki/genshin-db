			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"漢娜洛蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "#謝謝{F#妳}{M#你}的慷慨。只不過，我是西風教會的修女，不能收下來自他人的財物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "漢娜洛蕾"
				},
				{
					"id": 708190202,
					"content": "對我而言，能藉著海風嗅到這般美妙的芬芳，便已經足夠了。將美好的事物留給風，而非獨自占有，才是虔信者應行之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "漢娜洛蕾"
				},
				{
					"id": 708190203,
					"content": "#不過，{F#妳}{M#你}這份如南風般和煦的善意，我確切地收到了。作為回禮，請{F#妳}{M#你}收下這本書吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "漢娜洛蕾"
				},
				{
					"id": 708190204,
					"content": "#願風神護佑{F#妳}{M#你}。願{F#妳}{M#你}未來的道路，也能如這香氛一般，盈滿美德、自由與仁愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漢娜洛蕾"
				}
			]
		},
