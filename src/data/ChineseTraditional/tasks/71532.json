						"position": [
							2454.721,
							343.059,
							2402.242
						],
						"pointId": 7560
					}
				]
			},
			"dialogs": [
				{
					"id": 715320101,
					"content": "#兩位，說書人學徒卷舒懇請{F#妳}{M#你}們留步——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320102
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320102,
					"content": "#{F#妳}{M#你}們可曾聽說過這樣一則傳聞？「海燈節的良宵之時，曾有蹈躍的焰光在夜空中揮筆作畫，描繪盛美的圖卷…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320103
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320103,
					"content": "沒、沒有聽懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320104,
					"content": "焰光？在天空中作畫？普通人根本做不到這種事吧…就算坐著那什麼飛艇，也沒有可以浮在天上的神奇顏料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320105,
					"content": "聽起來像是很誇張的比方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320106,
						715320107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320106,
					"content": "感覺不是普通的畫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				},
				{
					"id": 715320108,
					"content": "#總之！這則傳聞的主角就是{F#妳}{M#你}們兩位，聞名遐邇的旅行者{NICKNAME}和{M#他}{F#她}的夥伴派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320109
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320109,
					"content": "咦？怎麼話題突然轉向了我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320110,
					"content": "#也許{F#妳}{M#你}們已經忘記了，去年{F#妳}{M#你}們接受了冒險家甜甜的委託，參與了一場特別的競速挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320111
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320111,
					"content": "那場競速挑戰被漂亮的煙花點綴，蔚為壯觀，成了難得一見的美景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320112
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320112,
					"content": "這麼說來，我隱約記得，當時我們只是舉手之勞，幫了幫那位冒險家協會的宣傳員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320113,
					"content": "她說要藉助那場活動來吸引新的成員，也不知道她後來有沒有成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320114,
						715320115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320114,
					"content": "好像有這件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320116,
					"content": "#當時我在望舒客棧附近喝悶酒，仰望到了{F#妳}{M#你}們被煙花點亮的身影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320117
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320117,
					"content": "#一瞬間，考試落榜的哀愁，對前路的迷茫，都被{F#妳}{M#你}們那充滿朝氣、光芒萬丈的身姿給驅散了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320118
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320118,
					"content": "#所以我才打起精神，繼續我的民俗研究，來到這沉玉谷，深入探索我熱愛的課題…感謝{F#妳}{M#你}們的鼓勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320119
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320119,
					"content": "#除了我以外，還有不少被{F#妳}{M#你}們的身影吸引，加入冒險家協會的人，他們也找到了人生的新方向！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320120
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320120,
					"content": "完、完全沒想到！我們當時都沒注意到遠處有人在看，也沒想過，我們只是參與了競速挑戰，就能給別人加油打氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320121,
					"content": "妳說得這麼誇張，我們都有點不好意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320122,
						715320123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320122,
					"content": "打起精神就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320124,
					"content": "今天偶遇兩位，實屬三生有幸。我想麻煩兩位一件事，並對兩位表示真摯的感謝——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320125
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320125,
					"content": "#請兩位將{F#妳}{M#你}們的光輝傳遞下去，繼續鼓舞更多人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320126
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320126,
					"content": "雖然我們好像沒有妳說的那麼偉大啦，但妳的想法很好很好，能讓更多人心情變好的話，我們當然超級樂意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320127,
					"content": "話說回來，我們要怎麼做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320128,
					"content": "#遵循慣例，我參考了甜甜規劃的競速挑戰，聯合被{F#妳}{M#你}們鼓舞的冒險家們，共同規劃了一種全新的活動「熠光雲行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320129
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320129,
					"content": "在這沉玉谷之中，也有著諸多奇妙之物，其中就有一種奇妙的鯉魚，能讓人藉助牠的力量快速穿行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320130
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320130,
					"content": "#兩位只需要像往常那樣，盡情在山間與空中穿梭，將{F#妳}{M#你}們的俐落身姿和朝氣展示給更多人就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320131,
						715320132
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320131,
					"content": "舉手之勞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320133,
					"content": "當然，除了我這份摩拉的謝禮，我們還替兩位準備了各種酬勞，聊表我們的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320134
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320134,
					"content": "對於兩位傳遞希望，令人振奮的事蹟而言，這些謝禮或許並不豐厚，但並不是全部。我們以後還會找機會報答兩位的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320135
					],
					"speakerTitle": "卷舒"
				},
				{
					"id": 715320135,
					"content": "#嘿嘿，妳也太客氣啦！就算拿不到多少好處，我和{NICKNAME}也會一直旅行下去，盡量幫助每個迷茫的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320136,
					"content": "聽卷舒小姐這麼一說，總覺得冒險都更有幹勁了！我們就試試看她說的「熠光雲行」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715320132,
					"content": "非常樂意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320123,
					"content": "恭喜妳振作起來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320115,
					"content": "那這樣重點是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320107,
					"content": "難不成是在說煙花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				}
			]
		}
	]
}