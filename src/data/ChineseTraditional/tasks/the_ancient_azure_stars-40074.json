				"points": []
			},
			"dialogs": [
				{
					"id": 400740301,
					"content": "好宏偉的建築…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400740302,
					"content": "哇…我從來沒見過這樣的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740303,
					"content": "喂莫娜，妳的幻境太厲害了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740304,
					"content": "雖然比起幽夜淨土還是寒磣了一些，但也不錯哦，梅姬斯圖斯卿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400740305,
					"content": "（太好了，幸好不是什麼被老太婆訓話的課堂…面子算是保住了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740306,
					"content": "天才占星術士的幻境，當然得氣派啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740307,
					"content": "接下來，開始搜索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4007409,
			"completionStepIds": [
				4007409
