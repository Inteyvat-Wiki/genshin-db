			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"奧茲",
					"菲謝爾",
					"莫娜",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "周圍變了。這裡不是我們出發前的海灘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400740902,
					"content": "看起來，應該是蒙德的山地。難道說，我們被送到蒙德了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400740903,
					"content": "但周圍還是無垠之海呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400740904,
					"content": "周圍應該有剛才那樣可供進入的水池。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740905,
					"content": "在這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740906,
					"content": "…嗯？不能直接進入？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740907,
					"content": "水面上好像浮現出什麼東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740908,
					"content": "這是畫嗎？還是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740909,
					"content": "似乎在提示某個地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400740910,
					"content": "是希望本皇女帶領大家前往那裡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400740911,
					"content": "怎麼又是妳帶隊了…算了，誰帶都行，總之先把這個地方找出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
