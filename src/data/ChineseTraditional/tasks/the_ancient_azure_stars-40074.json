				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "各位，這邊集合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741102,
					"content": "大家都睡醒了吧？莫娜剛才說，有重要的事要宣佈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400741103,
					"content": "君臨幽夜淨土後晨曦初綻之時，確實令本皇女心曠神怡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400741104,
					"content": "小姐的意思是，她已經準備好面對接下來的挑戰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400741105,
					"content": "我們也睡飽吃飽了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400741106,
					"content": "嗯。那我就直說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741107,
					"content": "剛才我用水占盤看過，有一處新的幻境，已經在那邊的島嶼上彙聚成型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741108,
					"content": "而且…如果直覺沒錯的話，應該與我有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741109,
					"content": "這次是莫娜啊。之前幾個幻境，莫娜都陪著我們去了。這回輪到我們去妳那裡看看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741110,
					"content": "呃…沒什麼好看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741111,
					"content": "梅姬斯圖斯卿，您是在不好意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400741112,
					"content": "不不，怎麼會呢，啊哈哈，我才不擔心大家看見過於寒磣的幻境從而對我這個人產生偏見呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741113,
					"content": "都說出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400741114,
					"content": "其實…大家一般都會覺得占星術士很超凡脫俗，對吧？我擔心，萬一我的幻境不是那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741115,
					"content": "本皇女可沒有在期待那種愚昧無比的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400741116,
					"content": "我也沒有。倒不是不對妳抱有期待啦，但我認為，莫娜妳本來就是個親切善良的人，不需要偽裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400741117,
					"content": "懷抱平常心的人，其幻境也會呈現出相應的親切。這不是好事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400741118,
					"content": "對呀，再說，我們去莫娜的幻境也不只是觀光旅遊，還有別的目的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400741119,
					"content": "嗯。說不定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "…這樣啊，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741122,
					"content": "只要你們別太期待，我就不緊張了。好，那出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400741120,
					"content": "那裡有解決幻象的線索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
