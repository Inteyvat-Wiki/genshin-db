				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "水占盤上顯示，我們已經到幻境了。唔，先找入口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740202,
					"content": "會不會是那邊那個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740203,
					"content": "這看起來…好像是個水池。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400740204,
					"content": "不會是要游泳進去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400740205,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740206,
					"content": "難道，我們之中有旱鴨子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740207,
					"content": "我倒覺得問題可能不在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400740208,
					"content": "啊哈，有人害怕了是嗎？那好吧，就由我來打頭陣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740209,
					"content": "開始了！她對游泳很自信，所以開始炫耀了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400740210,
					"content": "咳！小姐，注意措辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400740211,
					"content": "啊、噢噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400740212,
					"content": "先走一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400740213,
					"content": "啊，莫娜跳進池子裡消失了？！我們也快跟上去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
