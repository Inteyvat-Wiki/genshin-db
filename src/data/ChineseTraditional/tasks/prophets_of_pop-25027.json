			"dialogs": [
				{
					"id": 250270401,
					"content": "看看前面那群鳥，太棒了！牠的叫聲…說不定可以拿來當作素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270402,
					"content": "但是只有幾隻的話…牠們的叫聲還是太過單薄。如果之後可以找到一整個族群，把牠們全部的叫聲都錄下來就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270403,
					"content": "等等，前面是鰭游龍群，聽到牠用爪子抓石頭的聲音了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270404,
					"content": "牠很敏感，我們不能靠近。之後我會請部族裡的專業人士來幫我取材，他們絕對可以搞定這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270405,
					"content": "那是…正在比試的部族戰士啊。不錯，不錯，這種真實的打鬥聽起來非常好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270406,
					"content": "喂！旁邊的是誰，要幹什麼！討打是嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "暴躁的部族戰士"
				},
				{
					"id": 250270407,
					"content": "我們正在取…材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270408,
					"content": "取材？那我就讓你取個痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "暴躁的部族戰士"
				},
				{
					"id": 250270409,
					"content": "#救、救命啊！{NICKNAME}，快攔住他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
		},
