				"objectNames": [
					"馬西娜·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "米盧先生又出新唱片了，到底要不要買呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "馬西娜·努伊"
				},
				{
					"id": 250270202,
					"content": "關於米盧·努伊的唱片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "欸？他的唱片很好啊。夏蘿和龍寶寶都很喜歡聽哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "馬西娜·努伊"
				},
				{
					"id": 250270204,
					"content": "每當她們淘氣不願意睡覺的時候，我都會放米盧先生的那首《頌春日》給她們聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "馬西娜·努伊"
				},
				{
					"id": 250270205,
					"content": "她們聽著聽著就會乖乖睡著，而且睡得很好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "馬西娜·努伊"
				},
				{
					"id": 250270206,
					"content": "唉呀…但夏蘿一直說自己喜歡更激烈一點的曲子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "馬西娜·努伊"
				},
				{
					"id": 250270207,
					"content": "要是米盧先生能創作出幾首更熱鬧的歌就好了，那樣她絕對會玩得更開心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬西娜·努伊"
				}
			]
		},
		{
			"id": 2502703,
