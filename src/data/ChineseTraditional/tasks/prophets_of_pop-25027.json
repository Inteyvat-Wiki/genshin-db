					"nextDialogs": [
						250271403
					]
				},
				{
					"id": 250271403,
					"content": "咦？我很喜歡米盧的歌曲風格，每天工作結束後我都會聽他的歌放鬆身心。",
					"roleType": "TALK_ROLE_NPC",
