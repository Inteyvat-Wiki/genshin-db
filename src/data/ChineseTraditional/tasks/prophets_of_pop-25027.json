			"trigger": {
				"objectNames": [
					"米盧·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "帕卡這小子…真是無法交流！他就是不理解我的音樂理想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#哦，看起來{F#妳}{M#你}是一位…旅行者？向您問好，我是米盧·努伊，一名音樂家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270105,
					"content": "#如果{F#妳}{M#你}有去過「花歌唱片行」的話，一定有在流行區看過我創作的唱片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270106,
					"content": "那份唱片裡包含著我對於「流行」的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270107,
					"content": "只有帕卡那小子不能理解我，非要說我的音樂比起「流行樂」更像是「兒歌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270108,
					"content": "無論我怎麼堅持，他都要把我的唱片放進兒歌區！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270109,
					"content": "雖然…孩子們是很喜歡啦，也有一些父母買回去給他們當禮物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270110,
					"content": "但、但是孩子們是最敏銳的聽眾！整個部族裡也有不少孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270111,
					"content": "我的唱片在那麼多孩子之中流行，我認為！完全可以放進流行區！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270112,
					"content": "你說的…有點道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "對吧？哼，我就知道是帕卡不識貨。等我創作好這首新歌，他一定會被我折服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270115,
					"content": "我是不相信他對音樂的品味…這位旅行者，請問您對音樂的瞭解如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270116,
					"content": "呃…音樂的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "您會操作樂器嗎？會唱歌也可以，會哼幾下也算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270118,
					"content": "我都很擅長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "那太好了！您一定可以理解我的音樂理念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270122,
					"content": "我正需要一個像您這樣的人來幫助我製作全新的歌曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270123,
					"content": "放心，我會為您準備充分的報酬，絕對不會讓您做白工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270124,
					"content": "來吧，用您的直覺告訴我，您認為首先我應該怎麼做，才能製作出一首優秀的音樂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270120,
					"content": "根本不會啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "沒關係！像您這樣的人才能真正用心享受音樂，您評判音樂的時候，一定能夠更加客觀公正。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270113,
					"content": "的確可以算是「兒童流行樂」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "你的音樂理想是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
