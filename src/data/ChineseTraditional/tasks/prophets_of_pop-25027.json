			"dialogs": [
				{
					"id": 250270901,
					"content": "也許應該採集聲音的素材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "聲音的素材？嗯…您的意思是…將大自然的聲音直接用在歌曲裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270903,
					"content": "喔…這倒是一個好主意。很好！我就知道您聰明敏銳，我們這就出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270904,
					"content": "等等，你要空手去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "當然，難道我要搬著一臺留音機去野外取材嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270906,
					"content": "放心吧，這次我們的目的只是確定哪些聲音素材可用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270907,
					"content": "例如鴨子振翅拍打的聲音、鰭游龍鑽進水裡的波浪聲、嵴鋒龍走過時的隆隆腳步聲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270908,
					"content": "在確定目標之後，我會做好一切準備再正式採集聲音素材…這就是之後的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250270909,
					"content": "至於現在，我們直接出發吧，事不宜遲啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
