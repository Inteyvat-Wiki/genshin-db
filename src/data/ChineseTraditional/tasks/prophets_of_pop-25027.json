				"objectNames": [
					"夏蘿·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "哇！又有新唱片了，龍寶寶們一定會很開心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "夏蘿·努伊"
				},
				{
					"id": 250270302,
					"content": "關於米盧·努伊的唱片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "我滿喜歡米盧叔叔作的曲子，而且我家的龍寶寶比我更喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "夏蘿·努伊"
				},
				{
					"id": 250270304,
					"content": "每次牠開始鬧的時候，媽媽就會放米盧叔叔的歌，牠一聽到曲子就馬上安靜下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "夏蘿·努伊"
				},
				{
					"id": 250270305,
					"content": "唔…可是那些歌都好長好長，我都記不住歌詞，沒辦法唱給我家的龍寶寶聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "夏蘿·努伊"
				},
				{
					"id": 250270306,
					"content": "嘿嘿，要是米盧叔叔可以把歌詞寫短一點就好了，這樣我天天都可以唱歌給他聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏蘿·努伊"
				}
			]
		},
