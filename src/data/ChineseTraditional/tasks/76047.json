				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "喲，這不是老主顧嗎，今天也來買投資券嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470202,
					"content": "聽說你這裡的投資券是騙人的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "說這什麼話，該不會是因為這陣子都在虧損，所以才胡思亂想的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470204,
					"content": "這世上哪能有穩賺不賠的生意呢，有人輸就有人贏，想當初我在須彌城…咳，不過是最近運氣不好，運氣這種事本來就不準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470205,
					"content": "「希望」啊就是得堅持下去才能抓到的。只要繼續投資，肯定有獲得回報的那一天的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470206,
					"content": "好吧，我還會再來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "#喂！{F#妳}{M#你}怎麼這麼輕易就被打發了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470209,
					"content": "#騙我們是不會有好下場的！我們…對了，我們可是大名鼎鼎的{NICKNAME}和派蒙！在那夏鎮也有不少朋友的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470210,
					"content": "「朋友」？什麼朋友…難、難道是那種「朋友」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470211,
					"content": "…嗯？呃，對！就是那種「朋友」，不只有，而且還很多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470212,
					"content": "#哎呀！{F#妳}{M#你}們怎麼不早說，惹不起，真的惹不起。這些全都給{F#妳}{M#你}們，我不會再賣投資券給{F#妳}{M#你}們了，{F#妳}{M#你}們快點走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩維特"
				},
				{
					"id": 760470208,
					"content": "別想再唬我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
