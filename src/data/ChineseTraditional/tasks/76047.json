			"dialogs": [
				{
					"id": 760470101,
					"content": "呃…兩位，我已經在這裡觀察兩位很久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "佩徹娜"
				},
				{
					"id": 760470102,
					"content": "妳在監視我們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "不，我只是經常來找書，偶然間發現兩位對參與投資很上心，這不是好事，兩位還是放棄吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "佩徹娜"
				},
				{
					"id": 760470104,
					"content": "我們的確還沒拿到過什麼豐厚回報…不過為什麼說不是好事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760470105,
					"content": "因為我猜根本沒有豐厚回報。老闆還有不少負債沒有償清，應該不會再做賠本買賣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "佩徹娜"
				},
				{
					"id": 760470106,
					"content": "我的朋友曾經也中過這樣的騙局，所以兩位還是不要再繼續比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "佩徹娜"
				},
				{
					"id": 760470107,
					"content": "#難道真的是騙人的…{NICKNAME}，我們必須去找他問清楚才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
