			"dialogs": [
				{
					"id": 401190601,
					"content": "哇，伊迪婭姐姐又變回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190602
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190602,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190603
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190603,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190604
					]
				},
				{
					"id": 401190604,
					"content": "在別人的誇獎和詢問裡得意忘形，一口氣說了好多不堪回首的話…我…失去了活著的勇氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190605
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190605,
					"content": "請不要這麼說，明明都是很了不起的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190606
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190606,
					"content": "對，伊迪婭小姐並不是在為自己許願，而是在為別人許願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190607
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190607,
					"content": "我有些朋友也是這樣！會為別人的願望而行動，為了讓他人露出笑容不懈努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190608
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190608,
					"content": "我想…這樣的人才最高尚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190609
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190609,
					"content": "別再誇我了，我…我真的好不習慣…好羞恥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190610
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190610,
					"content": "我這種人也能被這麼多人表揚…好像做夢一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190611
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190611,
					"content": "不過，這下蜃境總算恢復了，也算把那傢伙欠的東西還清了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190612
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190612,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190613
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190613,
					"content": "怎麼了？可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190614
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190614,
					"content": "可莉突然有好多好多願望！想坐「呼呼飛車」，還想到大大的轉輪上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190615
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190615,
					"content": "伊迪婭姐姐，有沒有上去的辦法啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190616
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190616,
					"content": "有是有啦，不過上面只能站幾個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190617
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190617,
					"content": "#可莉一個人上去也不好玩…嗚，榮譽騎士{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190618
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190618,
					"content": "伴您左右，「魔女」小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190619
					]
				},
				{
					"id": 401190619,
					"content": "真的嗎，那個看起來好高啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190620,
					"content": "要是一不小心掉下來怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190621,
					"content": "…妳不是飛著的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190622
					]
				},
				{
					"id": 401190622,
					"content": "#我，我是替{F#妳}{M#你}感到擔心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190623,
					"content": "#沒關係，我和{F#妳}{M#你}們一起去，我也好久沒上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				}
			]
		},
		{
			"id": 4011908,
			"completionStepIds": [
				4011908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011908",
							"2"
						],
						"stepId": 4011908,
						"stateName": "QUEST_STATE_UNFINISHED"
