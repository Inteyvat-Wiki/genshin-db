			"dialogs": [
				{
					"id": 401190201,
					"content": "啊，優菈和柯萊，妳們已經回來了!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190202,
					"content": "嗯，演出快結束的時候，我們接到了伊迪婭小姐拜託「小水珠」送來的消息，就先一步到這裡等各位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190203
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190203,
					"content": "那萊斯格先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190204
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190204,
					"content": "他攬下了所有粗工，賣力過頭了，現在在房間裡睡得正香呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190205
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190205,
					"content": "唔，有點過意不去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190206
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190206,
					"content": "就當他做的一切都是贖罪吧。做完這些才能睡個安穩覺，本該如此。不用管他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190207
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190207,
					"content": "這樣嗎…好，那我們就把握時間，修復「琉形蜃境」的核心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190208
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190208,
					"content": "這不就是我們一開始遇到「小水珠」的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190209,
					"content": "沒錯，「琉形蜃境」的核心就是最大的「聚流映燈」，而整個蜃境就是一張最為龐大的「先成圖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190210
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190210,
					"content": "我們看到的一切，都是由它產生出來的嗎？太不可思議了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190211
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190211,
					"content": "現在就該像之前一樣，利用核心的「先成圖」來修復它了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190212,
					"content": "沒錯，就是這樣。妳理解得真快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190213
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190213,
					"content": "嘿嘿，修了這麼多次，再怎麼也都記住啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190214,
					"content": "那開始吧，這就是最後一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190215
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190215,
					"content": "哦！突然充滿了幹勁呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
