			"dialogs": [
				{
					"id": 401190401,
					"content": "成功啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190402,
					"content": "可是輪縠並沒有轉動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190403
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190403,
					"content": "零件回到了蜃境核心，輪縠的形狀也透過它們補全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190404
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190404,
					"content": "哈哈，這樣就沒問題了，好比傷口會慢慢癒合，說不定在某個夜深人靜的時候，「核心輪縠」就會悄悄轉動呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190405
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190405,
					"content": "哦？我還以為，靠伊迪婭小姐的本事，現在就能讓它運轉起來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190406
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190406,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190407
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190407,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190408,
					"content": "不管是蜃境原本的樣子，還是伊迪婭小姐深藏不露的美麗姿態，都很令人期待呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190409,
					"content": "可莉也想看伊迪婭姐姐用魔法的樣子！一定很——厲害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190410
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190410,
					"content": "你…你們都在說什麼呀？為什麼連小可莉都知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190411,
					"content": "派蒙果然沒有發現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190412
					]
				},
				{
					"id": 401190412,
					"content": "就是在說…「吉祥物小姐的真身」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190413
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190413,
					"content": "之前就說過，伊迪婭小姐絕不是自己以為的那樣。她有她獨特的力量，我們之中也有人隱約感覺到了這一點哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190414,
					"content": "「軍師」小姐從一開始就發現了嗎？我是後來和優菈聊天的時候才意識到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190415
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190415,
					"content": "看上去悠閒無比的「軍師」小姐成了第一個察覺真相的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190416
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190416,
					"content": "我看你也知道得滿清楚的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190417
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190417,
					"content": "你們…全都知道了嗎…我保證，不是有意瞞著你們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190418
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190418,
					"content": "只是…對誤入蜃境的旅人來說，比起真身，我現在的樣子要更容易親近吧。我…我不想被人投以害怕的眼神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190419,
						401190420
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190419,
					"content": "居然一直沒細想！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				},
				{
					"id": 401190421,
					"content": "啊？究竟是什麼呀？大家是怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190422,
					"content": "嗯…怎麼說呢，蜃境裡的居民沒有神之眼，我卻能從他們身上感受到水元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190423,
					"content": "看小說的時候恍神了一下，忽然想到一種可能性。水形幻靈能夠變為各種樣子，同樣也能幻化成常人的模樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190424
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190424,
					"content": "還真是敏銳啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190425
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190425,
					"content": "那麼，就允許我重新做個自我介紹吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190426
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190426,
					"content": "我是舊水神崩歿時流亡至此的純水精靈，我的名字叫伊迪婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190427
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190427,
					"content": "居然是純水精靈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190428
					]
				},
				{
					"id": 401190428,
					"content": "伊迪婭姐姐好漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190429
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190429,
					"content": "唔…突然用自己的真身說話還有點不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190430
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190430,
					"content": "如此優美的身姿，就該大大方方展示出來才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190431
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401190431,
					"content": "我沒有那麼勇敢啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190432
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190432,
					"content": "咦？那難道說我們之前遇到的那些人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190433,
					"content": "我猜，這些「水形居民」的「原型」，都已經不在此處了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190434
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190434,
					"content": "沒錯，當他們想要離開的時候，我就會把他們送到沙漠的邊緣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190435
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190435,
					"content": "之前的這些「零件」，其實都是他們留下的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190436
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190436,
					"content": "但我總會很好奇他們進來的原因…就使用「聚流映燈」，塑造出了他們的願景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190437
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190437,
					"content": "「能實現願望，但即使能實現，也只限於瓶子裡。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190438
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190438,
					"content": "就是這麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190439
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190439,
					"content": "真是一抹耀眼的光芒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190440
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190440,
					"content": "這麼說來，從蜃境核心裡掉出來的「零件」，並不是回到了他們的主人那裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190441
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190441,
					"content": "而是先有「零件」掉到了相應位置，與他們息息相關的「主人」與「區域」才被幻化出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190442
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190442,
					"content": "但現在「零件」都被收回來了，難道他們也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190443
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190443,
					"content": "放心吧，他們不會消失的…只要我不忘記他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190444
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190444,
					"content": "互相批評也好，一起打鬧也罷…在這片幻境裡，他們永遠是我的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190445
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190445,
					"content": "「呼呼飛車」和「導演」先生都很有趣！可莉不會忘記的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190446
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190446,
					"content": "我也是。不會忘記這一場奇幻冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190447
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190447,
					"content": "哈哈，好了，那我也差不多該讓輪縠恢復運轉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190448
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190448,
					"content": "看妳的了，像流水一樣溫柔的「吉祥物」小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190449
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401190449,
					"content": "好…好緊張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190450,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190451
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190451,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190452
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190452,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190453
					]
				},
				{
					"id": 401190453,
					"content": "咦…不會吧，居然沒有反應…難道因為之前蜃境的故障導致力量不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190454
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190454,
					"content": "完了完了…剛才大家還把我捧上了天…我也大言不慚地誇下海口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190455
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190455,
					"content": "嗚嗚…給個瓶子讓我躲進去吧！躲一百年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190456
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190456,
					"content": "呃…妳現在就是在瓶子裡啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190457
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190457,
					"content": "怎麼辦…這下真的沒辦法讓大家看到「蜃境」原本的樣子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190458
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190458,
					"content": "其實，我有一計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190459
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190459,
					"content": "「軍師」小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190460
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190460,
					"content": "伊迪婭小姐，如果可以的話，能將蜃境核心中的「蜃樓玉匣」借我一用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190461
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190461,
					"content": "好像確實聽過這個名字，請稍等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190462
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190462,
					"content": "喏，是它吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190463
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190463,
					"content": "哇！好大的貝殼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190464
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190464,
					"content": "心海之前提到的古物，原來藏在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190465
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190465,
					"content": "嗯，它是從前供奉在曚雲神社中的禮器，用名為「蜃氣樓」的妖怪遺蛻製作而成，能聽取往來祈禱者的願望，蓄積蜃氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190466
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190466,
					"content": "數百年前，此物隨最後一代八醞守征戰未歸遺失在外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190467
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190467,
					"content": "與之相配的寶珠本應能感應到「玉匣」所在，誰料「玉匣」被藏進了「蜃境核心」中，寶珠也就此褪去了光芒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190468
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190468,
					"content": "欸？這是為什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190469
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190469,
					"content": "假如把聲音關進很深、很深的房間裡面，外面也會聽不見對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190470
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401190470,
					"content": "啊！明白了，貝殼太貪玩了，所以在禁閉室裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190471
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190471,
					"content": "那我也明白了！蜃境的核心近來老化了…所以「軍師」小姐才會捧著寶珠一路走進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190472
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190472,
					"content": "（聽起來很像我會用的尋寶羅盤…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190473
					]
				},
				{
					"id": 401190473,
					"content": "…言歸正傳。本來，離開了神社的供奉，這件禮器會迅速失去靈氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190474
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190474,
					"content": "但在這片蜃境之內，無數人留下了自己的願望和禮物，成為了它的「供物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190475
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190475,
					"content": "這…原來這是這麼厲害的東西嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190476
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190476,
					"content": "沒錯，它能夠幫助伊迪婭小姐修復「蜃境」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190477
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190477,
					"content": "可…我要怎麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190478
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190478,
					"content": "很簡單，用願望喚醒它就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190479
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190479,
					"content": "比如…我的名字是珊瑚宮心海，是海祇島的「現人神巫女」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190480
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190480,
					"content": "我的願望是透過自己的思考和決策，讓海祇島的大家和我珍視的人…能夠稍稍過得幸福，再幸福一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190481
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190481,
					"content": "伊迪婭小姐，妳的願望是什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190482
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401190482,
					"content": "我的願望？我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190483
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190483,
					"content": "我的願望是，那些曾經來到「琉形蜃境」中的旅人，不僅僅是在蜃境裡，也能夠在蜃境外實現他們真正想達成的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190484
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190484,
					"content": "即使我知道…在蜃境外鋪就飛車的軌道無異於癡人說夢，我知道邁蒙還是會回去當她的學者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190485
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190485,
					"content": "我知道佐西摩斯寫故事的水準還有待提高，回到楓丹還會在這方面吃很多苦頭，逐夢可沒那麼簡單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190486
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190486,
					"content": "但是我還是好希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190487
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190487,
					"content": "好希望他們能達成自己的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190420,
					"content": "是有所察覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				}
			]
		},
