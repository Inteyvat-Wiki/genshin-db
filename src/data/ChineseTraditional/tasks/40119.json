			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401190801,
					"content": "每次送大家離開蜃境之後，我都會一個人到這裡待一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190802
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190802,
					"content": "他們呀，一開始在蜃境裡做出各種東西的時候可開心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190803
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190803,
					"content": "可是一知道這些東西沒辦法帶出去，就會變得有點苦惱，要嘛不捨，要嘛一臉遺憾地離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190804
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190804,
					"content": "伊迪婭姐姐會難過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190805
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190805,
					"content": "…雖然偶爾會感到寂寞，但我不難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190806
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190806,
					"content": "#有些人會在離開蜃境時毀掉自己創造的一切，而有些則不會，比如{F#妳}{M#你}們看到的那些居民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190807
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190807,
					"content": "在離開蜃境時，他們託我用水形幻靈模擬「自己」，替他們維護蜃境中的造物，就像是看管他們的夢一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190808
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190808,
					"content": "聽起來好浪漫呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190809,
					"content": "嗯，雖然不知道他們在外面過得如何，但光是想到他們有可能實現夢想，成為這個蜃境中的樣子，就覺得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190810
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190810,
					"content": "彷彿我是在夢想的終點等著他們一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190811
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190811,
					"content": "伊迪婭人真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190812
					]
				},
				{
					"id": 401190812,
					"content": "呃…有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190813
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190813,
					"content": "我只是覺得，每個夢想和願望就像一束瓶中之光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190814
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190814,
					"content": "#不管{F#妳}{M#你}是在追尋夢想的途中，還是已經達成了夢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190815
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190815,
					"content": "只要回想起這束屬於自己的光芒時能夠會心一笑，就已經足夠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190816
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190816,
					"content": "可莉現在就覺得很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190817
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190817,
					"content": "哈哈，那我也算報答了當年艾莉絲女士的恩情。沙漠這地方，怎麼看都是汙泥湯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190818
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190818,
					"content": "那幫妳取個外號吧，就叫「泥水精靈」！哇，伊迪婭是泥水精靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401190819,
					"content": "還敢笑我？啊呣一口把妳吃掉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190820
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190820,
					"content": "#…雖然讓{F#妳}{M#你}們見到了難堪的一面，但恢復運轉的蜃境會變得越來越熱鬧，大家就再好好放鬆一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190821
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401190821,
					"content": "為了大家的夢想！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190822
					]
				},
				{
					"id": 401190822,
					"content": "嗯，可莉想要叫所有人都來——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190823
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401190823,
					"content": "大家一起坐「呼呼飛車」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		},
