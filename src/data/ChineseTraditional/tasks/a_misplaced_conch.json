					"nextDialogs": [
						790242229
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790242229,
					"content": "不，這就有點噁心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
