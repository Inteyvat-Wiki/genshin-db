						790242235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790242234,
					"content": "內部文件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790242236
					]
				},
				{
					"id": 790242236,
					"content": "哎呀，沒什麼，上面都沒什麼重要的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242237
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790242237,
					"content": "#對了雅科夫，如果沒有{F#她}{M#他}們幫忙，你說不定就沒法恢復理智了！",
					"roleType": "TALK_ROLE_NPC",
