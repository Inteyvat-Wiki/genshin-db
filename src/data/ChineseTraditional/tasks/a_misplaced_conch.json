			"trigger": {
				"objectNames": [
					"阿加菲婭",
					"扎哈爾",
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240101,
					"content": "雅科夫、雅科夫，剛才的就是你平時最喜歡聽的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240102
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240102,
					"content": "怎麼樣，雅科夫醒過來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240103
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240103,
					"content": "不行，阿加霞，還是什麼反應都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240104
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240104,
					"content": "每次我唱這首歌的時候，尤其是唱到「仲夏已逝，萬花凋謝。你必將遠行，而我卻習慣等待。」這句的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240105
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240105,
					"content": "每次我唱到這裡，他總是會眼睛變得濕潤地看著我呀…怎麼會一點反應都沒有呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240106
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240106,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240107
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240107,
					"content": "我幫他做了他最喜歡喝的湯，味道香得我自己口水都要流出來了，可是他還是沒醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240108
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240108,
					"content": "阿加霞，我明白了！其實雅科夫最想要的就是他父親能夠回來，要不我就假扮成他的父親…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240109
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790240109,
					"content": "閉嘴，我現在不想跟你說話！我當時就不該讓雅科夫和你一隊的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240110
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240110,
					"content": "阿加霞，這不是因為我，妳知道的，都是因為那個實驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240111
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790240111,
					"content": "雅科夫，可憐的雅科夫啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240112
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240112,
					"content": "怎麼了，雅科夫還是什麼反應都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240113,
					"content": "#是{F#妳}{M#你}們啊…唉，正如你們所見，雅科夫還是一點反應都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240114
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240114,
					"content": "這該如何是好啊，如果他這樣渾渾噩噩的，就算回到了至冬，恐怕也會被愚人眾除名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240115,
						790240116
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240115,
					"content": "被愚人眾除名不好嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				},
				{
					"id": 790240117,
					"content": "可是，可是雅科夫現在孤身一人…我們都時常外出執行任務，沒人能夠照顧他…如果被愚人眾除名，他這樣還怎麼活下去呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240118
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240118,
					"content": "#對了，{NICKNAME}，{F#妳}{M#你}…{F#妳}{M#你}肯定解決過很多這樣的事了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240119
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240119,
					"content": "拜託了，拜託了，找到讓雅科夫恢復的辦法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240120
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240120,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240121,
					"content": "#{F#妳}{M#你}們不是想要情報嗎，我們會拿機密的情報跟{F#妳}{M#你}們交換的，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240122
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240122,
					"content": "對，比如「愚人眾其實在金蘋果群島偷偷捕獵神秘花鱂」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240123
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240123,
					"content": "扎哈爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240124
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240124,
					"content": "對不起…我只記得這個了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240125
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240125,
					"content": "我們只是些負責跑腿的，哪有什麼機密情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240126
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790240126,
					"content": "葉夫卡，你不說話沒人把你當啞巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240127
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240127,
					"content": "#唉…{NICKNAME}，{F#妳}{M#你}怎麼看呢，「愚人眾其實在金蘋果群島偷偷捕獵神秘花鱂」這則情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240128,
						790240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240128,
					"content": "多少也是情報…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240130,
					"content": "好吧，就看在這條情報的價值上，就幫你們這個忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240131,
					"content": "那真是感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240132
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240132,
					"content": "不過說是這麼說…到底怎麼樣才能喚醒雅科夫呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240133,
					"content": "#他們之前好像一直在這個營地裡…{NICKNAME}，不如我們先一起去營地裡找找線索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240129,
					"content": "勉勉強強吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240116,
					"content": "聽起來倒是件好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				}
			]
		},
		{
			"id": 7902402,
			"completionStepIds": [
				7902403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902403",
							"2"
						],
						"stepId": 7902403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲婭",
					"葉夫卡",
					"扎哈爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240201,
					"content": "怎麼樣，有什麼發現了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240202
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240202,
					"content": "雖然也說不上是有線索，不過也是一種可能呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240203,
					"content": "向三位愚人眾小隊成員說明了海螺的作用…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790240204
					]
				},
				{
					"id": 790240204,
					"content": "啊，沒想到被那個奇怪裝置影響到的海螺還會有這樣的效果啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240205
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240205,
					"content": "你說的那個畫面，應該是我帶著害怕被訓斥的雅科夫，找葉夫卡的畫面吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240206
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240206,
					"content": "對，妳這麼一說，我也有點印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240207
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790240207,
					"content": "不過，那也是很長一段時間之前，更何況，受到了那台巨大裝置的影響，嗚…在營地裡時的記憶也變得很模糊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240208
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240208,
					"content": "但是，這裡的海螺本來應該有四個，應該<color=#00E1FFFF>還有其他三個</color>的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240209
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240209,
					"content": "其他的記憶很模糊，但是海螺有四個卻記得很清楚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240210,
					"content": "在營地休整的時候，我們發現忘記帶盛湯的容器了，所以就臨時用了那個海螺裝做好的湯。所以，那個海螺是我們一人一個的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240211
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240211,
					"content": "嗯，不過出發之前，雅科夫就把湯喝完，留在箱子上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240212
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240212,
					"content": "其他的我們一人一個，全都帶走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240213,
						790240214
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240213,
					"content": "那，海螺呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				},
				{
					"id": 790240215,
					"content": "唔…當時只覺得是一些普通的海螺，所以喝完湯之後就扔掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240216
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240216,
					"content": "我想想，那個時候才剛上<color=#00E1FFFF>西北方向的大島</color>，就把湯喝完，海螺……海螺被我順手丟在島上一個全是水的山洞裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240217
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790240217,
					"content": "我，我好像扔在<color=#00E1FFFF>南方的大島</color>遺蹟邊的山上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240218
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790240218,
					"content": "嘿嘿，我的扔進了<color=#00E1FFFF>東北方向大島</color>的井裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240219
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790240219,
					"content": "哇，根本就丟得到處都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240220,
					"content": "西北方向的島，應該是辛焱的幻境所在的島，也就是破破島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240221,
					"content": "南方向的大島，就應該是危危島…東北方向的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240222,
					"content": "就是雙雙島吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240223
					]
				},
				{
					"id": 790240223,
					"content": "丟在了這三個島上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240224,
					"content": "看來得找到這三個海螺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240225
					]
				},
				{
					"id": 790240225,
					"content": "嗯，如果找到了這三個海螺，說不定就能找到能讓雅科夫醒過來的線索了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240214,
					"content": "海螺現在在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				}
			]
		},
