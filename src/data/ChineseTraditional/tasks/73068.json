					"蘭伽盧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680201,
					"content": "#那菈{NICKNAME}和派蒙？蘭那庫拉跟著蘭般度去了善見地還沒回來，不如趁現在去吃點蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭伽盧"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭那庫拉",
					"蘭伽盧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "是蘭那庫拉！順利回到桓那蘭那了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680302,
					"content": "#那菈{NICKNAME}，還有派蒙！法留納神機治好了，蘭那庫拉可以專心照看苗圃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680303,
					"content": "這裡就是蘭那庫拉總是提起的苗圃啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680304,
					"content": "是的，是蘭那庫拉和蘭伽盧一起照料的苗圃。這裡的土，原本適合生長，可以種出高興的毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680305,
					"content": "還有不高興的毗波耶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680306,
					"content": "也不是不高興，只是沒那麼高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680307,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680308,
					"content": "就像，有適合生長的土壤，也不缺雨水和陽光，成長的過程中也沒有遇到什麼阻礙…好像沒什麼不高興的，但是也沒那麼高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680309,
					"content": "喔…感覺就普普通通的。欸？那這裡和其他地方不一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680310,
					"content": "桓那蘭那的土，都很好，但是這裡特別好。而且還有更重要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680311,
					"content": "蘭伽盧和蘭那庫拉，會照看它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680312,
					"content": "照看…具體是指哪方面呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680313,
					"content": "會演奏音樂給它們聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680314,
					"content": "還會誇它們長得漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680315,
					"content": "這就是野生和家養的區別嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "好像也不是不能理解…如果每天都有悅耳的音樂可以聽，還會被誇漂亮，確實很難不高興呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680317,
					"content": "#對了，就像我，在被{NICKNAME}釣起來之前，沒有不高興，可也沒那麼高興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680318,
					"content": "#和{NICKNAME}一起旅行之後，雖然有時會遇到困難，但是高興的時候也會加倍高興呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680319,
					"content": "派蒙很對，蘭伽盧要用高興的毗波耶，造漂亮的燈，為了無憂節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680320,
					"content": "嘿嘿，既然蘭那庫拉也回來了，我們就趕緊開始吧！毗波耶的種子…毗波耶也有種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680321,
					"content": "毗波耶，是大地的夢囈，是大地在夢中想起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680322,
					"content": "那種子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680323,
					"content": "毗波耶沒有種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680324,
					"content": "欸？可是沒有種子要怎麼在苗圃種植…啊！難道是蘭那庫拉有什麼可以憑空種出毗波耶的蘭迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680325,
					"content": "不對，派蒙不對…要讓苗圃長出毗波耶，需要桓斯彌利底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680326,
					"content": "桓…桓什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680327,
					"content": "「桓斯彌利底」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "桓那會記得一切，所以，有桓斯彌利底的話，大地會在夢中重新記起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680329,
					"content": "苗圃也會生出高興的毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680330,
					"content": "#唔…那、那這個「桓斯彌利底」，只有蘭那羅才能獲得嗎？我和{NICKNAME}是不是沒機會在苗圃培育毗波耶了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680331,
					"content": "#金色的那菈幫助過蘭那庫拉，還有其他蘭那羅，是蘭那羅的朋友，所以蘭那庫拉和那菈{NICKNAME}一起培育毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680332,
					"content": "#讓桓斯彌利底沉入泥土裡，就能生出毗波耶，那菈{NICKNAME}，試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680333,
					"content": "按蘭那庫拉所說，讓「桓斯彌利底」沉入泥土。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "這樣就好了嗎？好像和種植其他的植物也沒什麼區別嘛！把種子埋進土裡，然後等種子發芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680335,
					"content": "桓斯彌利底不是種子。就像派蒙不是會飛的貓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680336,
					"content": "唔…好、好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680337,
					"content": "話說回來，苗圃還有好些空地呢，一、二、三…居然還有十二塊看起來可以培育毗波耶的地。蘭那庫拉還有更多桓斯彌利底嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680338,
					"content": "以前有，但是現在沒有更多的了，需要重新收集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680339,
					"content": "在夢境之外，有十二座苗圃，會凝結出桓斯彌利底。有了它們，桓那蘭那的苗圃就能生滿毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680340,
					"content": "#無憂節需要很多毗波耶，桓那蘭那有很多，但如果有更多高興的毗波耶，蘭那羅會高興，那菈{NICKNAME}和派蒙也會高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680341,
					"content": "既然是這樣的話，我們也來幫忙收集桓斯彌利底吧！不過，這東西該怎麼收集呀？蘭伽盧剛才說是在夢境之外的苗圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680342,
					"content": "金色的那菈，需要遍歷苗圃的土地，但是只需要一次，太多，不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680343,
					"content": "只需要一次遍歷…苗圃的土地就會凝結出桓斯彌利底，就像前一夜的漣漣雨絲，在天濛濛亮以後，凝聚成葉片上的露珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730680344,
					"content": "…唔…根本聽不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680345,
					"content": "不過根據之前和蘭那羅打交道的經驗…等我們找到了夢境之外的苗圃，應該自然而然就知道蘭那庫拉在說什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680346,
					"content": "之後如果找到苗圃的話就去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
