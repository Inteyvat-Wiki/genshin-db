			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭伽盧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "你好！這邊的土地看起來和其他地方不太一樣呢，是有什麼特別的用途嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680103,
					"content": "欸？他怎麼沒反應？是沒聽到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680104,
					"content": "你——好——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "…咕？那、那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680108,
					"content": "怎、怎麼會？桓那蘭那怎麼會有那菈？是來抓我去烤的嗎？蘭伽盧可沒有蘑菇好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680109,
					"content": "那麼可怕的事情我們怎麼可能會做嘛，我們可是大家公認的「蘭那羅的愉快的好夥伴」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680110,
					"content": "根本沒人這麼說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "哎呀，大家雖然嘴上沒說，心裡一定是這麼想的，不用問我也知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680114,
					"content": "#總之，我是派蒙，這邊的金色的傢伙是{NICKNAME}，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是個好那菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680115,
					"content": "你是蘭伽盧對吧？你獨自一個蘭那羅在這裡幹什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680116,
					"content": "派蒙問這個做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680117,
					"content": "呃…我就是好奇嘛！就像看到蝴蝶就要撲，看到蜥蜴就要抓，已經跟本能一樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680118,
					"content": "派蒙是會飛的貓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680119,
					"content": "不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680120,
					"content": "唔…如果是什麼不方便說的蘭那羅的秘密之類的就算啦，我們也不是那麼不識趣的傢伙，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680121,
					"content": "雖然還是挺好奇的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "話是這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680123,
					"content": "「秘密」？蘭伽盧沒有「秘密」。蘭伽盧沒有在做什麼，蘭伽盧在等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680124,
					"content": "在等？是指其他的蘭那羅嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680125,
					"content": "蘭那庫拉，跟蘭般度一起去了善見地，不知道什麼時候才能回來。法留納神機不好，不是照料苗圃的時候，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680126,
					"content": "#那菈{NICKNAME}喜歡種地嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680127,
					"content": "種地好麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "在巴螺迦種地才麻煩，桓那種地不麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680131,
					"content": "為什麼不問問我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680132,
					"content": "派蒙不是撲蝴蝶，就是抓蜥蜴，看起來不像喜歡種地的樣子，問了白問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680133,
					"content": "雖然很想反駁…反正我就是比起過程，更在意結果啦！所以，這裡的苗圃是種什麼的呀？是好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680134,
					"content": "好吃，但是也有別的用處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680135,
					"content": "不過現在，派蒙要是餓了，不要來苗圃吃，去吃蘑菇。桓那的蘑菇太多了，要吃掉一些才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680136,
					"content": "總之，蘭那庫拉還沒回來，什麼都沒辦法開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680137,
					"content": "#好吧，看來只能等蘭那庫拉回來了…我們先走吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680129,
					"content": "最喜歡種地了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "太好了，蘭伽盧也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730680112,
					"content": "派蒙說得對！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680106,
					"content": "開飯啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "蘑菇好吃！…那菈？好吃？不對，那菈不能吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "蘭伽盧"
				}
			]
		},
		{
			"id": 7306802,
