				"objectNames": [
					"禁閉室"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020401,
					"content": "猜猜我是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020402,
					"content": "啊，是小派蒙的聲音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102020403,
					"content": "要不要我們放妳出去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "好呀那就——不，不對，可莉是真心在反省的，不要誘惑我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102020406,
					"content": "禁閉期間，我會留在這裡，做羽球節特製版的「寶物」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102020407,
					"content": "「寶物」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020408,
					"content": "嘿嘿…我專門做成了羽球的形狀呢！很可愛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102020409,
					"content": "羽球形狀的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "等到了羽球節的時候，嗯！大家一定會喜歡的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "禁閉室"
				},
				{
					"id": 102020412,
					"content": "唉，要是這段話被琴團長聽見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020413,
					"content": "她的禁閉時間，大概又要加長了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020410,
					"content": "其實還是炸彈吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "要給妳帶點吃的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}