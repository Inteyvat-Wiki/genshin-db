			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "啊，可莉也在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020102,
					"content": "我…嗚嗚嗚，我自首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020103,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020104,
					"content": "我…我的炸彈…炸彈炸傷了人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020105,
					"content": "嗚嗚…違反了生存守則，我肯定看不到明天的太陽了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020107,
					"content": "等等，這裡有誤會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "可莉，妳先回答我。傷患呢，傷患人在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020109,
					"content": "可莉炸飛的，是深淵法師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020110,
					"content": "但…但是毛茸茸只是偷了東西而已，我的炸彈卻把他給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020111,
					"content": "啊…我之前說深淵法師是「壞人」，只是一種比喻啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020112,
					"content": "深淵法師不是人類。它們是…唔，與人類為敵的壞傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020113,
					"content": "毛茸茸…與人類為敵？是壞傢伙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020114,
					"content": "欸，欸？！腦…腦袋跟不上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020115,
					"content": "嗯，這是我的疏忽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020116,
					"content": "因為妳還太小，我之前從沒有把這些告訴過妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020118,
					"content": "難道是因為「最強的寶物」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "實際上，深淵教團的怪物們，是侵擾著蒙德的威脅，最近格外活躍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020119,
					"content": "對哦，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020120,
					"content": "它們就是聽到了寶物的流言，才盯上可莉的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020121,
					"content": "就像，就像我最初也會想得到…啊不，想知道這寶貝一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020122,
					"content": "所以…所以說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020123,
					"content": "看在妳這次的功勞上，下次的羽球節，就允許妳一起參加吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020125,
					"content": "真是歪打正著。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "真為妳高興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "羽球節！！哇！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020127,
					"content": "#{F#姐姐}{M#哥哥}到時候也一定要來哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020128,
					"content": "欸嘿，圓滿的結局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020129,
					"content": "不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020130,
					"content": "不過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020131,
					"content": "可莉，妳原先的「寶物」，藏在了哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020132,
					"content": "唔唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020133,
					"content": "是不是又想去炸星落湖的魚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020134,
					"content": "我，我不是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020136,
					"content": "（可是琴團長也看得見啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "（她在拼命給我們使眼色呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102020137,
					"content": "可——莉——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102020138,
					"content": "呀！可莉這就去<color=#00E1FFFF>禁閉室</color>報到…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102020139,
					"content": "不知道可莉一個人關禁閉，會不會無聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
