			"dialogs": [
				{
					"id": 80190501,
					"content": "就是這裡嗎？這棵樹下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190502,
					"content": "嗯，看似平平無奇，但對我來說又充滿回憶的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190503,
					"content": "我們曾經會坐在這棵樹下聊天，看著天空中的雲朵，感受風的方向，一坐就是很久很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190504
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190504,
					"content": "我是在森林裡被巡林員發現，後來被維摩莊收養的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190505,
					"content": "儘管大家對我很好，每天也過得很熱鬧，但曾經的我還是會感覺到孤獨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190506,
					"content": "孤獨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190507,
					"content": "唔…怎麼說呢，有些心事不管是開心也好、傷心也罷，總是不知道該向誰傾訴，或者說不知道該不該傾訴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190508,
					"content": "大家都有自己的生活，有些時候敞開心扉或許只會給別人帶來麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190509,
					"content": "我大概可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "#欸，{F#妳}{M#你}也是這樣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190512,
					"content": "我曾經有一位親人願意聽我傾訴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190515,
					"content": "#是嗎，那可太好了，真是羨慕{F#妳}{M#你}…而對我來說，「他」應該又像是親人，又像一位能理解我的朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190516,
					"content": "不管我遇到了什麼，都可以毫無顧忌地對他說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190517,
					"content": "他的心思單純又細膩，臉上的表情也總是充滿了耐心與興趣，就好像在聽他自己的事情一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190518,
					"content": "自從他消失以後，我真的有好多事情想要和他講…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190519,
					"content": "不不，那些事情也都沒那麼重要了，只要能再見到他就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190520,
					"content": "你們兩個，關係真的很好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190521,
					"content": "那在妳的印象裡，他有說過什麼關於自己的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190522,
					"content": "唔…他講的大概都是維摩莊裡他見到的趣事，還有自己的很多天馬行空的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190523,
					"content": "哦對了，我有一次問過他，他的父母在哪裡…但他只是回答說——「他們不在這裡了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190524,
					"content": "我也不敢追問，那究竟只是離開了，還是不在人世了的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190525,
					"content": "還是沒什麼線索嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190526,
					"content": "聊了這麼多，還是沒能幫上忙，實在是抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190527,
					"content": "別這麼說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "上次一口氣說這麼多話，還是和他一起的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190530,
					"content": "這麼說來，好像每次和他聊天，也都是在這樣的黃昏時分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190531,
					"content": "在記憶裡，時間會變得很慢很慢，有時候感覺明明聊了很久很久，可是天卻還沒有暗下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190532,
					"content": "#好像放鬆下來以後，時間就是會變慢呢…欸，{F#妳}{M#你}怎麼了，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190533,
						80190534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190533,
					"content": "每次都是同一時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190535,
					"content": "（情報收集到這裡，感覺已經完全不能作為普通的尋人委託來處理了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "（反倒是剛剛阿托莎所說的，關於時間的問題，或許才是解開謎團的契機…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "#…喂，{NICKNAME}，那邊的幾個丘丘人，是不是樣子有些古怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190538,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "欸，深淵教團？難道是他們搞的鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190540,
					"content": "#發現我們了，{NICKNAME}，快迎戰吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190534,
					"content": "時間似乎不會流逝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190528,
					"content": "至少我們更加瞭解他了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190513,
					"content": "不過我現在擁有更多理解我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190510,
					"content": "這就是「親人」存在的意義吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				}
			]
		},
