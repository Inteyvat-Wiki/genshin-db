							2651.488
						],
						"pointId": 330400533
					}
				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "喲，你好，是想買點什麼東西嗎，我在這一帶做生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190302,
					"content": "不是不是，我們是專程過來的冒險家，剛剛在凱瑟琳那裡接到了維摩莊的委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190303,
					"content": "那件事啊，唉…也算是勞煩你們這些冒險家一趟一趟往這裡跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190304,
					"content": "老實說，我們大家都不怎麼抱希望了，每次都是有人信誓旦旦來幫忙找人，結果很快就鎩羽而歸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190305,
					"content": "各種線索我們都被問煩了，維摩莊周邊也快被掘地三尺了，就是沒有任何新的進展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190306,
					"content": "那他到底叫什麼？原本住在哪裡？他的親人們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190307,
					"content": "不知道、不知道、不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190308,
					"content": "呃…就這麼不耐煩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190309,
					"content": "啊…不好意思，我那不是不耐煩，而是依次回答了妳的三個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190310,
					"content": "三問三不知嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "話雖這麼說，但其實我們都對他印象很深的，都是在維摩莊過日子的人嘛，記憶裡也一起做過很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190313,
					"content": "只是並不瞭解他的這些具體情況罷了，也可能以前知道，但現在沒人記得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190314,
					"content": "反正村裡大家交換過情報，結論就是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190315,
					"content": "好吧，就當是這樣吧…那麼他是一個怎樣的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190316,
					"content": "他呀，印象裡是個二十歲出頭的小夥子，非常熱心、人又和善…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190317,
					"content": "我這邊沒什麼客人的時候，偶爾就和他聊聊天。有時候又看見他冒冒失失地幫人家忙，哈哈…滿有趣的小夥子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190318,
					"content": "看起來你對他的評價還不錯嘛，一聊起他，表情都不像之前那麼愁眉苦臉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190319,
					"content": "可不是嘛，大家應該都滿喜歡他的，不然也不會一起到冒險家協會發布委託找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190320,
					"content": "像他這樣單純的年輕人不多見了，怎麼就忽然消失了呢，但願不是出了什麼不好的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190321,
					"content": "或許…只是偷偷搬走了之類的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190322,
					"content": "不會的，以他的性格不可能會不辭而別。就算如此，他搬家的事也不可能躲過我們維摩莊所有人的視線…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "巴蘭"
				},
				{
					"id": 80190323,
					"content": "唔…好吧，謝謝你的情報，我們再到別處問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190311,
					"content": "那你們究竟知道些什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
