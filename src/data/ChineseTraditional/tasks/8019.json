			"dialogs": [
				{
					"id": 80190401,
					"content": "是客人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190402,
					"content": "你好，阿瑪茲亞爺爺，我們是接到維摩莊的委託才過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190403,
					"content": "#哦，那可真是辛苦{F#妳}{M#你}們了，這麼大老遠過來，那孩子的事就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190404,
					"content": "能多跟我們講一些失蹤者的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190405,
					"content": "#當然可以，只要能對{F#妳}{M#你}們有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190406,
					"content": "我雖然眼睛不太好，但過去總是能聽到他的聲音，現在聽不到了就覺得心裡空落落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190407,
					"content": "他的父母好像都不在維摩莊，但那孩子看起來一點也不孤單，還總是願意做那個陪伴他人的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190408,
					"content": "他經常去孤寡老人家裡做客，也喜歡帶著村裡的孤兒一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190409,
					"content": "不管誰遇到了傷心的事，他都樂意聽人家傾訴，又總是很會安慰人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190410,
					"content": "身為村長，我真的要好好感謝他。從精神上幫助那些身處困難的人，本應是我職責的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190411,
					"content": "難怪他失蹤了以後，你們那麼著急，原來是這樣一個溫柔的好人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190412,
					"content": "可是…關於他的名字、住所、家庭情況之類的，村長你也完全沒有線索是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190413,
					"content": "唉…這也是讓我十分慚愧的事，無論如何我都應該記得的，或許是我真的年紀大了…這些我怎麼也想不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 80190414,
					"content": "啊…沒關係的，不用強求，我們會想想辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190415,
					"content": "#{NICKNAME}，{F#妳}{M#你}現在怎麼看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190416,
					"content": "感覺…並不是一個簡單的失蹤案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "是呀，我也這麼覺得…再怎麼說，他的名字都沒人記得了也太奇怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190419,
					"content": "住所和家人也都沒有相關線索，這個人簡直就像從現實裡被抹去了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190420,
					"content": "不，我倒覺得更像是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "#唔…{F#妳}{M#你}的意思是說，從現實的角度來看，不是「被抹去」，而是從來都「不存在」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190423,
					"content": "等等，這對我來說有點難理解…只存在於記憶裡的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190424,
					"content": "（會不會和大慈樹王那時候一樣，出現了群體性的記憶變動…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "#{F#妳}{M#你}們是…剛到維摩莊的冒險家？是接到委託才來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190426,
					"content": "啊，沒錯沒錯，我們正在調查失蹤者的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190427,
					"content": "#太好了，謝謝{F#妳}{M#你}們還沒有放棄，我一直都擔心冒險家協會要把我們的委託撤掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190428,
					"content": "#我叫阿托莎，也住在維摩莊。請{F#妳}{M#你}們一定要再努力試試看，拜託了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190429,
					"content": "一定會找到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "這位小姐妳不要著急，妳和失蹤者很熟嗎？有沒有可以提供給我們的線索呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190432,
					"content": "#線索…我也不知道能不能算是線索，{F#妳}{M#你}們跟我來，我帶{F#妳}{M#你}們去一個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190430,
					"content": "只能說盡力而為。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "…只存在於記憶裡的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "不協調的地方很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
