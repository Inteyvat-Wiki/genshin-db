				{
					"id": 205160201,
					"content": "原來從這裡可以看到整個蒙德城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205160202,
					"content": "別著涼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "#哇！嚇我一跳，{F#妳}{M#你}是從哪冒出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205160204,
					"content": "一定是哥哥又在找我了吧，哼哼，這地方他果然找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205160205,
					"content": "好啦，好啦，我知道了，等會我就會回去啦。不會讓哥哥擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
