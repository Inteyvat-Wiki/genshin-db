			"dialogs": [
				{
					"id": 205160401,
					"content": "這孩子，不是一直在生病嗎？怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160402,
					"content": "請問您看見過一個女孩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "呼…您是在找安娜吧，您往上看，她就在風神像的手上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160404,
					"content": "她跑過來的時候，我還在奇怪，這孩子不還是在生病嗎？怎麼突然這麼有活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160405,
					"content": "我就是一個恍神，這孩子就爬到風神像手上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160406,
					"content": "您…為什麼不生氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "生氣？啊…當然是有一些的，不過，那孩子之前一直被病痛折磨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160408,
					"content": "現在看見她這麼健康的樣子，怎麼說呢，我反而生氣不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 205160409,
					"content": "不過，上面風很大，這孩子別著涼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				}
			]
