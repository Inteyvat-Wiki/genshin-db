			},
			"dialogs": [
				{
					"id": 205160101,
					"content": "這丫頭，又跑到哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160102,
					"content": "安娜又出去玩了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "#我說啊，{F#妳}{M#你}怎麼一副習以為常的表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160104,
					"content": "安娜是越來越不聽話了，我一個不留神，她又溜出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160105,
					"content": "#她的病還沒有好全呢，{F#妳}{M#你}快點幫我找找安娜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160106,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160115,
					"content": "對了，之前安娜一直和我說，想要去看看風神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160116,
					"content": "我記得，葛瑞絲修女經常待在那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160117,
					"content": "#{F#妳}{M#你}我可以先去問問她，說不定她會注意到什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160108,
					"content": "你找過了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "我當然找過了，連城外都去過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160110,
					"content": "#就是找不到，才只能拜託{F#妳}{M#你}啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160111,
					"content": "安娜喜歡吃什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "哦，她喜歡吃…喂！都說了不要把我妹妹當成貓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160113,
					"content": "再說了，她喜歡吃的東西多了去了，我數得過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160114,
					"content": "#好了，拜託{F#妳}{M#你}快去找找吧，我就在這等{F#妳}{M#你}。找了一圈，我都快累死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安東尼"
				}
			]
		},
