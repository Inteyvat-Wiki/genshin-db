					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205160304,
					"content": "我馬上去那邊，把她給叫下來好好教訓一下。",
					"roleType": "TALK_ROLE_NPC",
