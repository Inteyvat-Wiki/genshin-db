			"dialogs": [
				{
					"id": 730600401,
					"content": "夢景林莽…安靜的曲子，水的聲音，鳥撲棱翅膀的聲音，踩在枝椏上的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730600402,
					"content": "和那菈還有派蒙說話…派蒙好玩。但是可惜，派蒙不想變成種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730600403,
					"content": "因為派蒙不是蘭那羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730600404,
					"content": "夢景林莽已經沒問題了，蘭百梨迦在荼訶之座，但是不擔心，謁頌幽境的「蕈獸」很多，蘭那庫拉，擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				}
