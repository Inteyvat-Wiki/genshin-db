			"dialogs": [
				{
					"id": 730600301,
					"content": "蘭百梨迦果然順利，但是擔心在謁頌幽境的蘭那庫拉和在夢景林莽的蘭貢迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730600302,
					"content": "蘭那庫拉…壞蘑菇太多，萬一蘭那庫拉又被壞蘑菇抓到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730600303,
					"content": "太多擔心，沒用。金色的那菈很強，打倒大大鐵塊，就像大風刮倒朽木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730600304,
					"content": "只要治好法留納神機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				}
