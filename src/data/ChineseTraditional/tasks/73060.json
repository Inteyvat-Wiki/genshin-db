			"dialogs": [
				{
					"id": 730600201,
					"content": "金色的那菈，好像什麼也不怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730600202,
					"content": "金色的那菈是勇敢的那菈，就像那菈法留納一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730600203,
					"content": "雖然擔心在荼訶之座的蘭百梨迦和在夢景林莽的蘭貢迪，但是有金色的那菈幫助，一定不會有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730600204,
					"content": "#治好了法留納神機，就不會有壞傢伙到苗圃搗亂了，苗圃的花，想要送給{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭那庫拉"
				}
			]
