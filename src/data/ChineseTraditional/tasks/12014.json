			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "我打算再待一會，我心中的煙花會還沒有結束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140102,
					"content": "啊，不過如果想聊天的話，也沒問題喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140103,
					"content": "接下來打算做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "松坂他們還在等我和他們一起去找「大貉妖」呢，宵宮姐姐可不能言而無信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140105,
					"content": "還有各家各戶放完煙花之後的感想，我也要去瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140106,
					"content": "接下來的日子，還要承蒙大家關照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140107,
					"content": "#{F#妳}{M#你}和派蒙的關照當然也少不了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140108,
					"content": "訂做煙花很貴嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "#{F#妳}{M#你}們的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140110,
					"content": "免費吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140111,
					"content": "#畢竟是我硬要送給{F#妳}{M#你}們的，一路上還給{F#妳}{M#你}們添了很多麻煩，嘿嘿，再收費我會不好意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140112,
					"content": "那有點過意不去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#別在意，不用這麼客氣。那這樣吧，作為交換，等{F#妳}{M#你}找到了親人，{F#妳}{M#你}要把「長野原煙花店」介紹給{F#他}{M#她}，這樣我又能多一個客人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140114,
					"content": "#我也想見{F#他}{M#她}一面啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140115,
					"content": "天領奉行如果來找妳的麻煩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "那就再打一頓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140117,
					"content": "——哈哈哈，開玩笑，開玩笑啦。我不是說了，我家經常會和奉行眾打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140118,
					"content": "無非是認錯、賠笑臉、繳些罰款罷了，很容易矇混過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140119,
					"content": "#倒是{F#妳}{M#你}們要更小心一點，遇到事情，可不要像我一樣魯莽，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		}
	]
}