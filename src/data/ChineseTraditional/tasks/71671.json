			},
			"dialogs": [
				{
					"id": 716710101,
					"content": "呃啊，不愧是夜蘭都評價棘手的秘境，真的不普通呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710102,
					"content": "也不知道這個地脈紊亂點記錄的都是什麼戰局…普通士兵真的能應付過來嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710103,
						716710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710103,
					"content": "魔神戰爭的區域性交戰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				},
				{
					"id": 716710105,
					"content": "唔…我猜，大概也沒到…那麼嚇人的程度吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710106,
					"content": "#{F#妳}{M#你}們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710107
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710107,
					"content": "嗯，神色從容，應該取得了不錯的戰果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710108,
					"content": "也的確遇見了非常驚險的情況！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710109,
					"content": "向刻晴和夜蘭描述了其中的戰況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716710110
					]
				},
				{
					"id": 716710110,
					"content": "#原來如此…實在有勞{F#妳}{M#你}們了，幹得漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710111
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710111,
					"content": "#{F#妳}{M#你}們通過紊亂點造訪秘境後，外溢的魔物顯著減少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710112,
					"content": "雖然沒能直接清除紊亂點，但的確有效削弱了它的活性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710113,
					"content": "得益於此，魔物們的棘手程度大大降低，普通的千岩軍戰士也能將它們擊退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710115,
						716710116
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710115,
					"content": "進去一次，就明白了凶險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710117,
					"content": "#怎麼感覺，{NICKNAME}的鬥志燃燒起來了…{F#妳}{M#你}還摩拳擦掌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710118,
					"content": "#剛才，送往玉京臺的加急信件得到了回覆，天權星和開陽星一致同意，與{NICKNAME}達成長期合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710119
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710119,
					"content": "#得益於{NICKNAME}的努力，這個地脈紊亂點甚至可被我們妥善利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710120
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710120,
					"content": "#此後，{NICKNAME}將獲得駐軍的全力支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710121
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710121,
					"content": "#紊亂點活躍期間，若是{NICKNAME}有意願，便可攻入秘境。少量外溢的魔物則由千岩軍處理，給戰士們輪番練手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710122
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710122,
					"content": "算是轉危為安，轉禍為福了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710123,
						716710124
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710123,
					"content": "那從今以後，我定然全力以赴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710125,
					"content": "哎呀呀，可算鬆了口氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710126,
					"content": "話又說回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710127,
					"content": "地脈真是個奇妙的東西，總有一天，我們得想個辦法，查出它更多的秘密才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710128,
					"content": "不知道能不能遇見什麼聰明人，給我們翻出一本…《地脈百科全書》來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710124,
					"content": "既然危險解除，我就酌情出勤！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710116,
					"content": "難對付的傢伙，要慢慢搞定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710104,
					"content": "災變之時的極端戰況？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				}
			]
		}
	]
}