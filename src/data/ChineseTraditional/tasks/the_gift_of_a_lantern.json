			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "#{F#妳}{M#你}好啊，旅行者。上次真是太謝謝{F#妳}{M#你}了，輕策莊好久沒有這麼熱鬧過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180102,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "往年只有我和阿芷在，最多給孩子們做點霄燈，陪老人話家常，再稍微做一些好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180104,
					"content": "#這次多虧了{F#妳}{M#你}，才能過上一個熱熱鬧鬧的海燈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180105,
					"content": "不過熱鬧歸熱鬧…我還是想去探望一下莊裡的老人。今天我準備去看看江城爺爺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180106,
					"content": "#如果{F#妳}{M#你}願意的話，就一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180107,
					"content": "那我們一起吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "嗯，好的，那我們先去江城爺爺那裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
