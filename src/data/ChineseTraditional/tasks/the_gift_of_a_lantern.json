			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "霄燈掛好了？好看，真好看，來年一定又是個好年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180402,
					"content": "一定會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "那江城爺爺，我們還有點事，就先走了，之後再來看您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180405,
					"content": "行、行，年輕人，總有自己要忙的事…忙不完的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180406,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "欸，老婆子…別忘了看看我們家的地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				},
				{
					"id": 718180403,
					"content": "肯定會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
