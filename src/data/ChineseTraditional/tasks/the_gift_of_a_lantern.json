				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "老婆子，妳回來啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180202,
					"content": "抱歉，你認錯人了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "嗨，我可還沒老糊塗呢…怎麼會認不出妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180204,
					"content": "#我剛剛還想著{F#妳}{M#你}呢，{F#妳}{M#你}看這大過年的，是不是該給咱女兒買件新衣服了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180205,
					"content": "喲…這回妳還多帶了個人回來…啊，是妳找來的裁縫嗎？我們又想到一樣的事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180206,
					"content": "江城爺爺，是我，小白啊。前兩天我還來送過豆腐，這麼快就不記得我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180207,
					"content": "啊…小白…是小白啊！記得記得！就前一陣子，你爸爸還在跟我誇獎你呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180208,
					"content": "欸…那是什麼時候的事來著…老婆子，妳還記得嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180209,
					"content": "…還記得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "呵！我就說，我的記性怎麼可能差了…還有，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180212,
					"content": "江城爺爺，您歇一會，別太累了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180213,
					"content": "#旅行者，要不{F#妳}{M#你}先去幫江城爺爺打掃一下屋子吧，我來陪他聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180214,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				},
				{
					"id": 718180210,
					"content": "當然記得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
		{
