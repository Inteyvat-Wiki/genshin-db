					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "唉…老婆子，你也來說小白兩句…她爸爸的手藝這麼好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180302,
					"content": "這豆腐啊，就算拿去璃月港賣，也是頂級的好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180303,
					"content": "唔，小白啊，妳是來做什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180304,
					"content": "是來送霄燈的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "霄燈…啊…是霄燈…哎呀，年年都麻煩妳啦，小白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180306,
					"content": "老婆子，妳還記得吧，之前我編霄燈的手藝可好啦，附近的人都找我編。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180307,
					"content": "每年過海燈節的時候，那些霄燈啊，可真好看…妳等著，我這就去為妳掛霄燈去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180308,
					"content": "我來掛霄燈吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "嗯，也好，那妳可小心點啊，可別撞到了摔倒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				}
			]
		},
		{
			"id": 7181804,
