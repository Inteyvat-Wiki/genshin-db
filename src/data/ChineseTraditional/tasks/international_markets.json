					{
						"sceneId": 3,
						"position": [
							2506.894,
							205.371,
							-1146.261
						],
						"pointId": 300300750
					}
				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "#{F#妳}{M#你}們好呀，我是來自須彌的旅行商人阿泰菲，很高興認識{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460102,
					"content": "哇，居然從這麼遠的地方過來嗎，不知不覺，我們的店鋪名氣已經這麼大了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460103,
					"content": "多虧了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "#哼哼，現在在{F#妳}{M#你}面前的，正是冉冉升起的銷售之星，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460106,
					"content": "#啊哈哈，最近的確有不少消息靈通的商人聽說了{F#妳}{M#你}們在售賣的煉金藥劑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460107,
					"content": "這種不太常見的商品，大部分人還是不太敢冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460108,
					"content": "但在我看來，要想賺大錢，就得搶佔商機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460109,
					"content": "雖然現在普通人對煉金藥劑的瞭解程度還不是很高，但只要配合銷售手段，一旦打開了市場，那可就是賺不完的摩拉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460110,
					"content": "如果能打響名號，說不定售價能翻十倍…嘿嘿，幹完這一票，就能休息到年底了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460111,
					"content": "十倍！妳是認真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460112,
					"content": "哼哼，只要有人願意買，不管價格賣多高都是合理的。所謂你情我願嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460113,
					"content": "這個說辭，讓我想起了某個滿腦子都是摩拉的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460114,
					"content": "我說，既然妳來自須彌，該不會湊巧認識多莉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460115,
					"content": "#多莉？難道妳說的是多莉·桑歌馬哈巴依老爺？{F#妳}{M#你}們居然認識這位大人物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460116,
					"content": "她是我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "好厲害！桑歌馬哈巴依老爺是我的偶像，她的商業嗅覺和對摩拉的執著一直激勵著我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460119,
					"content": "我曾經有幸拜訪過卡薩扎萊宮，真是氣派又美麗的宅邸啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460120,
					"content": "總有一天，我也想像她一樣，擁有數都數不完的摩拉，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460121,
					"content": "呃…她已經徹底沉浸在夢裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460122,
					"content": "祝妳成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "#謝謝{F#妳}{M#你}的祝福！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460126,
					"content": "那麼，我們來聊聊一起賺大錢的方法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460127,
					"content": "#其實很簡單，我定期來向{F#妳}{M#你}進貨，{F#妳}{M#你}生產出需要的藥劑，然後我就能幫{F#妳}{M#你}賣到其他地方啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460128,
					"content": "如果決定合作的話，就來具體談談這批要出售的藥劑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460129,
					"content": "查看藥劑需求。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "根據我敏銳的市場嗅覺，這次需要的藥劑是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460131,
					"content": "以後再說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "賺錢的機會可是稍縱即逝的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460124,
					"content": "還是聊正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "咳咳，一下子扯遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460117,
					"content": "以前打過交道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "這段時間的努力有成果了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
