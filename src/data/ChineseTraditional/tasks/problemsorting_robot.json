					"nextDialogs": [
						766520518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766520518,
					"content": "是女孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520519
					],
					"speakerTitle": "奇怪的淘金小弟"
				},
				{
					"id": 766520519,
					"content": "這太不對勁了，雖然不知道發生了什麼事…但它絕對不是原本的「淘金小弟」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520520
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520520,
					"content": "決定了，就把你拆開來看看是怎麼回事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520521
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520521,
					"content": "不要對我動手動腳啊！救命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520522
					],
					"speakerTitle": "奇怪的淘金小弟"
				},
				{
					"id": 766520522,
					"content": "我也是女孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520523
					],
					"speakerTitle": "愛諾"
				},
