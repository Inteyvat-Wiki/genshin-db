				},
				{
					"id": 766520502,
					"content": "哼，真沒見識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520503
					],
					"speakerTitle": "奇怪的淘金小弟"
				},
				{
					"id": 766520503,
					"content": "欸？！你…你會說話？！愛諾，這樣正常嗎？",
