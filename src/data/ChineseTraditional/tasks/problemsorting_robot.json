			"dialogs": [
				{
					"id": 766520801,
					"content": "#做得很漂亮嘛！{NICKNAME}也很有當機械師的天賦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520802
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520802,
					"content": "#謝謝{F#妳}{M#你}們，這下我有了一個更厲害的「淘金小弟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520803
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520803,
					"content": "阿莎莎，妳以後要認真工作噢，我會發薪水給妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520804
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520804,
					"content": "誰稀罕啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520805
					],
					"speakerTitle": "奇怪的淘金小弟"
				},
				{
					"id": 766520805,
					"content": "妳的脾氣真的不太好，給妳戴一朵花花。希望妳能溫柔一點，喏~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520807
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520807,
					"content": "嗯，這下子看起來可愛多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520808
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520808,
					"content": "#對了，{NICKNAME}、派蒙，要是以後{F#妳}{M#你}們也撿到了沒用的材料，比如螺絲螺母什麼的，可以送來我這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520809
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520809,
					"content": "#我能把它們都變成花花，或者用來升級我的控制臺，嘿嘿。當然不會讓{F#妳}{M#你}們做白工，報酬一定會讓{F#妳}{M#你}們願意天天來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520810
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520810,
					"content": "成交嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520811
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520811,
					"content": "當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520812
					]
				},
				{
					"id": 766520812,
					"content": "#太好囉！果然還是伊涅芙說得對呀。「不順利」中也藏著「順利」。等{F#妳}{M#你}度過了「不」，之後就是「順利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520813
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 766520813,
					"content": "#{F#妳}{M#你}們的旅途一定也會是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				}
			]
