			"dialogs": [
				{
					"id": 732941201,
					"content": "我們回來啦…哦！果然是于連的動物同伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732941202,
					"content": "（發出威脅的聲音。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941203,
					"content": "…好哇，「胡椒」你這傢伙…還吼我，你也不想想是誰在養這個家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732941204,
					"content": "（原來牠也有名字啊！不過這個人沒事吧？怎麼在跟狗吵架…）",
