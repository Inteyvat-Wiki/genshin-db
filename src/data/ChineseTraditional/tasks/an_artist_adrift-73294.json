						732941004
					]
				},
				{
					"id": 732941004,
					"content": "（短吠了一聲。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732941007,
					"content": "對了，之前不是在于連的營地看到過碗盆嗎？該不會是牠的吧！奇怪，為什麼于連說自己沒有動物同伴呢…",
					"roleType": "TALK_ROLE_NPC",
