			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940102,
					"content": "#他看起來不太好的樣子…一定是餓壞了！{NICKNAME}，要不要分一些食物給他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940103,
					"content": "希望美食能給他力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#我不是因為偏心才這麼說，{NICKNAME}做的料理是真的很美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940107,
					"content": "讓倒地者吃下了提瓦特煎蛋。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "重、重獲新生啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940109,
					"content": "哇…看起來他是真的餓到不行了，只是一個煎蛋而已嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940110,
					"content": "真是讓人復活的美味呀…唉，早知道煎蛋這麼美味，就該從那個傢伙手裡買下那份神奇鳥蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940111,
					"content": "什麼神奇鳥蛋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940112,
					"content": "據說只要吃下它就能抵消掉一天的厄運，要是當時就買下那份神奇鳥蛋…不，要是能買十二份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940113,
					"content": "唔…聽起來好可疑，像是什麼騙人的買賣。不過，你怎麼一個人到這種地方來呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940114,
					"content": "#我是…呃…我是來須彌考察的楓丹知名畫家。{F#妳}{M#你}們可以叫我于連。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940115,
					"content": "到這種地方考察？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "應該有其他更適合考察的地方吧？比如說，風景更好，也更安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940119,
					"content": "而且，如果真的是從楓丹來的畫家，那怎麼兩手空空？啊…該不會你其實是愚人眾的臥底吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940120,
					"content": "太偏頗的推論了吧！很難想像是什樣的經歷讓妳做出這麼偏頗的推論。但是，我的確是畫家，只是個畫家，其他的什麼也不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940121,
					"content": "我只是，呃，其實我已經在這裡得到了夠多的靈感，準備結束考察返回楓丹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940122,
					"content": "沒想到須彌的氣候這麼乾燥，來時經過的沉玉谷還比較濕潤，進入須彌地界之後風沙就多了起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940123,
					"content": "說來慚愧，我還是比較習慣濕潤氣候，所以本來想回程走水路體驗一下不同的風景，結果木筏被沖散了，再加上我又不會游泳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940124,
					"content": "那你在楓丹生活應該很不容易吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "的確是這樣，不光是會不會游泳的問題，唉，算了。我在水邊找了個能休息的地方，應該還有一些沒被泡爛的茶葉，為了表示感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940126,
					"content": "你要請我們喝茶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940127,
					"content": "呃，當然…當然！為了報答煎蛋的恩情，請兩位…不知兩位該怎麼稱呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940128,
					"content": "對哦，差點忘了自我介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "#嗯，響亮的名字。總之，請{F#妳}{M#你}們喝茶。營地就在附近，很快就到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
				},
				{
					"id": 732940130,
					"content": "#正義的使者和{M#他的}{F#她的}扈從。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#是{NICKNAME}和最好的夥伴——派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940132,
					"content": "金燦燦和銀閃閃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#是金燦燦的{NICKNAME}和銀閃閃的派蒙哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940117,
					"content": "怎麼會有人自稱「知名」啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "就是說呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940105,
					"content": "哈哈，他又不是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "什麼嘛！不管是誰，總會有那麼一兩次因為餓昏而眼前一片黑，倒在地上的經歷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
