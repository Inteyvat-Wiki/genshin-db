		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "好簡陋的營地！這還能算是營地嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940502,
					"content": "可是這裡風景還不錯，走到沙灘邊會感覺很開闊，比在楓丹的時候舒暢很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940503,
					"content": "你在楓丹究竟過著怎樣的生活啊…和想像中的知名畫家會過的生活很不一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940504,
					"content": "其實我在楓丹的住處很小，呃，因為我不是個貪圖虛名的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940505,
					"content": "野外的冒險家營地都比這裡豪華多了呢。欸？這是…你的動物同伴呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940506,
					"content": "呃…我可沒有什麼動物同伴，這大概是之前來這裡的冒險家之類的留下的吧。話說回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940507,
					"content": "我是很想拿出點好東西招待和報答兩位的，但是不巧大部分行李都在木筏被沖散的時候掉進水裡了，我又不會游泳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940508,
					"content": "如果兩位能幫我把遺失在水上的行李找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940509,
					"content": "這行李都泡水了，還要嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "我目前都仔細打包好了，但是裡面有些東西…唉，沒了就沒了吧，沒關係，我還能再畫…還能…再畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732940511,
					"content": "#唔…感覺有點可憐…{NICKNAME}，我們就幫幫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732940512,
					"content": "#在這種地方實在無人可以依靠了…只能拜託兩位，我在這裡泡好茶等{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
				}
			]
		},
