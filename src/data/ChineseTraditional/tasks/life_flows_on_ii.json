					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "我已經和洛蒂婭說明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220102,
					"content": "她是我們純水精靈密探中最為有名，也是最為強大的一位。不過她卻懷揣著對上一任水之神的思念，叛逃了楓丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220103,
					"content": "#我也已經回不去楓丹了，所以我就全部告訴{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220104,
					"content": "我們純水精靈曾經分佈在全大陸的山川河流、小池溪水之中，絕大部分都是楓丹的間諜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220105,
					"content": "嗚啊！水之神究竟在計劃著什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220106,
					"content": "以前那位沒有什麼計畫，只是想要像是水系一樣，貫通大陸，把大家聯繫在一起。可是隨著她消逝，許多精靈切斷了和楓丹的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220107,
					"content": "像是最強大的洛蒂婭，她並不認可新的水之神，只想懷抱著曾經的夢活下去而已。洛蒂婭她，只想要一方靜水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220108,
					"content": "但是她察覺到了我，誤以為我是楓丹的刺客。所以她散出惡意，使河水變苦，想要消滅我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220109,
					"content": "可是妳當初明明這麼弱小，她有需要這麼大費周章嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220110,
					"content": "純水精靈的主導意識，很容易因為融合了一個有惡念的小意識就崩潰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220111,
					"content": "我很嚮往洛蒂婭，所以靠著寄宿水史萊姆，在水系間跳躍，遠離楓丹來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220112,
					"content": "除了背負任務的刺客，應該沒有別的純水精靈能有我這樣的執著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220113,
					"content": "某種程度上，是聽起來挺厲害的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220114,
					"content": "#不過我也一樣，是被{NICKNAME}載著遲早要橫跨七國的人哦。和我的豐功偉業相比，妳還差了點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220115,
					"content": "喂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "我已經和她解釋清楚了，水的苦味應該不久就會消失。最後她還詢問我，是否還想要融入輕策之水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220117,
					"content": "所以妳是來告別的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220118,
					"content": "#我還有一則訊息要傳達呢。請{F#妳}{M#你}們陪我再去一次清泉鎮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嫣朵拉"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老芬奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "芬奇，芬奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220202,
					"content": "哎喲，嚇我一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220203,
					"content": "嫣朵拉她學習東西進步神速。難免會被嚇到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220204,
					"content": "只是覺得，會叫我芬奇，真像是她啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220205,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220206,
					"content": "「每天都有一個孩子蹣跚向前，世間一切由他自己去發現。他的所見變成了他的一部分——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220207,
					"content": "「這個孩子蹣跚向前，如此一生的時間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220208,
					"content": "我知道這首詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220209,
					"content": "我們的生命和你們的生命有很大不同。所以可能我們在活著的時候，無法互相理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220210,
					"content": "但是我們的生命，也都是一樣的。一直都在迎接新事物和新轉機的過程裡，奔流到海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220211,
					"content": "所以她說：「在夜空裡所有星星熄滅的時候，所有溪流、所有的夢想，都能匯入同一片大海之中。那時我們終會再見的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220212,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220213,
					"content": "生命之流還在前行，請你也邁開腳步，不要駐足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220214,
					"content": "哈哈哈，果然是她。還是一副把我當小孩子的語氣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220215,
					"content": "好了，請讓我一個人靜靜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220216,
					"content": "#那{NICKNAME}，我們也應該找康納回覆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"康納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "哦哦，你們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414220302,
					"content": "我猜想如果是你們出馬的話，事情應該完美解決了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414220303,
					"content": "那是當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "大概過幾天水的苦味就會消散了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220306,
					"content": "哦，我明白我明白。就算消除了源頭，還得給水一點時間讓它自我清潔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414220307,
					"content": "那我就聯繫冒險家協會結案了。實在是太感謝兩位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "康納"
				},
				{
					"id": 414220304,
					"content": "雖然過程有點複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "我們族群表達喜愛的方式，是把雙方的水體融匯在一起。這樣多個意識就可以無隔閡的相處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220402,
					"content": "但理解世界上其他生命卻沒有這麼簡單。因此我們觀察、研究、模仿，幻化出動物的樣子。也可以說，它們的模樣變成了我們的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220403,
					"content": "望著流逝的河水，嫣朵拉開始思考高深話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220404,
					"content": "我以前從來沒有思考過以後的生命如何度過。我以前一直覺得和洛蒂婭融為一體就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220405,
					"content": "但是洛蒂婭看起來並不開心。她自己也明白，她只是在等待著淨水腐敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220406,
					"content": "所以妳的選擇是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "不論是洛蒂婭還是清泉鎮的她，似乎都不想讓我走上她們的路。但是她們肯定更加討厭楓丹的生活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220409,
					"content": "妳們這種生命真的很奇妙，所以我也沒辦法提出什麼有用的建議。不過我覺得，生命還是過得開心一點比較好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220410,
					"content": "#所以，我決定選一條從沒有前人選過的路。因為和{F#妳}{M#你}們相處的旅行很開心，我想要以後每天都這麼開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220411,
					"content": "#我想要和{F#妳}{M#你}們一起旅行。去看看生命的小溪到海之前，會經歷的夾岸繁花與天際雲霞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220412,
					"content": "當然歡迎妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "#不過這樣的話，被{NICKNAME}帶著走遍七國的殊榮我就不能獨佔了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220413,
					"content": "要不然就換掉派蒙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220407,
					"content": "所以妳拒絕了她嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				}
			]
