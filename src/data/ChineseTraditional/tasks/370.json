			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "咦？那不是琴團長嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700202,
					"content": "她好像在和什麼人說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700203,
					"content": "等她們說完，過去打個招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700204,
					"content": "…所以，我們的態度就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700205,
					"content": "若無法立刻剿滅作亂的魔龍，不如將蒙德的城防移交給「愚人眾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700206,
					"content": "蒙德的龍災是可以處理的，只要讓我們把那頭野獸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700207,
					"content": "「野獸」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700208,
					"content": "嗯？代理團長大人的意思是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700209,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700210,
					"content": "希望貴國的外交官能拿出更專業的態度來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700211,
					"content": "你們想「處理」蒙德的四風守護之一？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700212,
					"content": "我不希望有人在西風騎士面前說這種瘋話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700213,
					"content": "呵…呵呵呵…也沒妳說得那麼瘋吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700214,
					"content": "很好，今天的磋商到此為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700215,
					"content": "這次的成果就是「雙方坦誠地交換了建設性的意見」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700216,
					"content": "我會…如實記錄的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "安娜斯塔西婭"
				},
				{
					"id": 3700217,
					"content": "#啊，{NICKNAME}，{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700218,
					"content": "#十分感謝{F#妳}{M#你}的協助，城市周圍的元素循環終於安定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700219,
					"content": "風魔龍上次襲擊的餘波，算是暫時告一段落了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700220,
					"content": "不過，使團那邊施加的壓力，也已經大到了很難無視的地步……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700221,
					"content": "使團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700222,
					"content": "是外交使團嗎…來自璃月港嗎？還是稻妻城？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700223,
					"content": "是至冬國，在七神中信奉冰神的國家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700224,
					"content": "他們的使者有個特殊的名字：愚人眾——聽說過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700225,
					"content": "啊，原來是「愚人眾」。確實有聽過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700226,
					"content": "不過，是那種不太好的名聲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700227,
					"content": "我不認為直接殺死風魔龍是正確的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700228,
					"content": "而且，冰之神統率的「愚人眾」，覬覦著風神眷屬的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700229,
					"content": "這件事本身就已經非常可疑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700230,
					"content": "說到「力量」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#怎麼了，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700232,
					"content": "有件東西想讓騎士團看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "嗯？好，那我們就回騎士團總部吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700234,
					"content": "不要在…這種地方，談論重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "是蘊含著某種力量的結晶…但，麗莎，妳能分析它的構成嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700402,
					"content": "嗯，我來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700403,
					"content": "可以發現結晶內部有些汙穢雜質，不過更進一步的研究就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700404,
					"content": "很抱歉，現在還得不出有用的結論。給我一點時間，我去禁書區找些資料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700405,
					"content": "那麼麗莎，之後的研究調查就交給妳了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700406,
					"content": "嗯，如果有什麼進展，我會通知大家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700407,
					"content": "不過嘛，不要太期待上古的文獻能有什麼幫助。而且——咿啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700408,
					"content": "嗚…好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700409,
					"content": "結晶裡的那種汙穢雜質，稍稍靠近，就會讓我感到刺痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700410,
					"content": "是了，原來是這樣啊…是與「神之眼」的互斥呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700411,
					"content": "那種汙穢的力量，會和我們體內的元素之力相互排斥，糾纏相殺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#不過，真是奇怪。{NICKNAME}明明也能使用元素之力，卻不受影響呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700415,
					"content": "小可愛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "好，就這樣辦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "總之，這枚結晶還是讓小可愛保管吧。放在我們手裡也只是徒增疼痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3700417,
					"content": "…真是不可思議的現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700418,
					"content": "#{F#妳}{M#你}對這一切——對自己身上這些特殊的地方，有什麼頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700420,
					"content": "我想也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700421,
					"content": "#那麼，{NICKNAME}。這是騎士團第二次的不情之請：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700422,
					"content": "請接受西風騎士團榮譽騎士的爵位…與代理團長的謝意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700424,
					"content": "西風的…榮譽騎士？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700426,
					"content": "#也請{F#妳}{M#你}再次幫助我們，尋找這些謎團的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700427,
					"content": "魔龍的狂亂，與怪異的結晶…我想，這背後的答案一定關係著蒙德的和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700428,
					"content": "#願風擦拭{F#妳}{M#你}的雙眼，讓{F#妳}{M#你}看清真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700429,
					"content": "如果有什麼最新發現，我們就在這裡再會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
