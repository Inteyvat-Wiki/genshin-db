					}
				]
			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "卡西奧多大人，卡西奧多大人…是您嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741860303,
					"content": "沒錯了，果然是您，您終於回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860304,
					"content": "我奉命把守這座要塞，但是那些殘虐的龍蜥與蠻族的攻勢實在太猛烈，我才只能一退再退來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860305,
					"content": "從那以後似乎過去了很多很多年…外面的情況怎麼樣了，我們勝利了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741860307,
					"content": "…是嗎？那麼是我們輸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860308,
					"content": "我很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741860309,
					"content": "您別這樣說，尊貴的大人。在我加入至尊的軍團之時，便曾想過會有這樣一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860310,
					"content": "至尊曾說要帶領我們砸碎「法圖納」的鐐銬，但事情又怎會這樣容易呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860311,
					"content": "畢竟我們對抗的可是命運，而命運是連偉大的神明都無法違抗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860312,
					"content": "最後，一切的努力都是徒勞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741860313,
					"content": "不，大人。我們曾向天命舉起刀劍，我們創造的事業挑戰了高天的律法。面對那個預言，我們奮起反抗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860314,
					"content": "雖然我們還是失敗了…一定是有人背叛了我們，才使我們走上了歧途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860315,
					"content": "但結果已經不重要了，無論如何，我們都會銘刻在世界的「歷史」之上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "無名的魔像"
				},
				{
					"id": 741860316,
					"content": "喂，他怎麼倒下了，石頭人也會像這樣突然失去意識嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741860317,
					"content": "我還不知道他的名字…看起來，他的「歷史」已經終結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741860318,
					"content": "也太可憐了，他就這樣在這裡戰鬥了數千年嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741860319,
					"content": "但現在，他終於能享有安寧了，我們繼續前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小嗚斯"
				}
			]
		}
	]
}