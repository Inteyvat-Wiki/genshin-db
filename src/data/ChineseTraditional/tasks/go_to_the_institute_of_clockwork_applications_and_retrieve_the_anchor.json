			"dialogs": [
				{
					"id": 740880601,
					"content": "呼…我還是沒辦法忘記舒瓦瑟爾那副搪塞人的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740880602,
					"content": "還有那個雷蒙多…那傢伙趾高氣昂、目中無人，您注意到他看我的眼神了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740880603,
					"content": "我覺得您比他們兩個人都好太多了，如果您在那個位置上，絕對不會變成那副模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛妮艾"
				}
			]
		}
