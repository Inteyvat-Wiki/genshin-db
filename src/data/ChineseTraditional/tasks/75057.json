			"dialogs": [
				{
					"id": 750013201,
					"content": "居然真的成功了…這之前只是出現在「故事」中的場景，真是了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013202,
					"content": "原本聒噪不休的聲音也安靜了下去…「小縫影針」又回歸了原本的樣貌，那麼大的東西「轟隆」一下砸了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013203,
					"content": "#呼…真的有人可以做到…這不會是一場夢吧？{F#妳}{M#你}們都真實存在？不會是我的臆想吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013204,
					"content": "夢醒了…該你自己解決啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "不要說這麼殘忍的話啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750013206,
					"content": "#怎麼樣？我就說{NICKNAME}是很強的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750013207,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也覺得很了不起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}，了不起的異邦勇士啊，{F#妳}{M#你}沒有被深淵影響到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013210,
					"content": "沒有，區區深淵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#就連部族裡最強的勇士面對深淵都得打起十二分精神，{NICKNAME}果然不是普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013213,
					"content": "唉呀，說不定以這個題材寫出的故事，能夠比桑哈傑記錄的故事更加精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013214,
					"content": "啊嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "雖然不知道桑哈傑是誰，但是聽起來很了不起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750013216,
					"content": "哈哈，對於所有「講故事的部族人」來說，煙謎主的桑哈傑都是值得崇敬的人物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013217,
					"content": "#不過現在情況緊急，等有空的時候再和{F#妳}{M#你}們說桑哈傑的故事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013218,
					"content": "好了，我們到下一根浮起的「小縫影針」那邊去吧，快點解決問題，我今晚就可以開始動筆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750013219,
					"content": "出發出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750013220,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "目前還滿健康的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "哇，剛才聽到了什麼可怕的動靜，所以想過來看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010802,
					"content": "過來的時候還安慰自己：「不要亂想了，蒂圖，還會有什麼事呢？」結果根本就發生了了不起的大事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010803,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "這裡居然還有一隻小嵴鋒龍…是你把這兩位異邦人引到這裡來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010805,
					"content": "#還有這個「縫影針」…是{F#妳}{M#你}們鑽下去的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010806,
					"content": "難道…不應該鑽下去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#啊？那…{NICKNAME}，我們豈不是做了很糟糕的事…不如趁目擊者只有一位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010808,
					"content": "#哈哈，不要說那麼恐怖的話啦，情況沒那麼嚴重，應該說{F#妳}{M#你}們做了好事？這位{M#兄弟}{F#小姐}是{NICKNAME}，妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010813,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#這是{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "嗯，而我的名字是蒂圖，我是部族裡負責講故{RUBY#[D]敘事人}事的人。同時，也負責「照看」山谷裡的這幾根石柱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010816,
					"content": "#當然了，{F#妳}{M#你}們鑽下去的這塊石柱，是三根「小縫影針」其中之一，也在我的看管範圍之內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010817,
					"content": "看、看管…果然，我們把那個什麼石柱弄掉了，納塔這裡的人就會以此來向我們索要賠償。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010818,
					"content": "嗚，早知道剛才就不應該報真名的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010819,
					"content": "賠償…「蒂圖靈光一閃，說不定能夠以這樣的方式要挾眼前的人，達成自己的目的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010820,
					"content": "感覺如果是這樣的情節的話，就該插入這樣的敘事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010821,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "啊，抱歉，光顧著想故事的事情。我是部族裡負責講故{RUBY#[D]敘事人}事的人，講了許多年的故事後，最近到了需要自己想故事的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010823,
					"content": "這幾天一直在為此煩心，結果「縫影針」也出了問題…老話說得好啊，人倒楣的時候龍也跟著一起倒楣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010824,
					"content": "#咳咳，我是不會要挾{F#妳}{M#你}們的啦，畢竟如果我真的想要那樣做，就、就不會把腦海裡的句子說出口了不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010825,
					"content": "#唉呀，{F#妳}{M#你}看，我們互相報上了名字，卻又沒有大打出手，這就證明我們已經是朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010826,
					"content": "#不知道{F#妳}{M#你}們可不可以聽聽朋友我這邊的請求？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010827,
					"content": "只要…不是索要賠償的話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "#當然不是啦，該怎麼說好呢…對了，{F#妳}{M#你}們在山谷裡漫步的時候，有沒有看到一塊超級大，還刻有金色花紋的固態燃素塊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010829,
					"content": "就在這片區域的中心，應該很顯眼哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010830,
					"content": "好像有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "我要說的其實就和那個大石柱有關…那個大石柱被部族的人們稱為「縫影針」，只不過最近出了一些問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010834,
					"content": "#在看到{F#妳}{M#你}們之前我都想放棄了，甚至都對自己說：「寫一個『縫影針』問題解決不了，災難毀滅了部族的故事也可以啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010835,
					"content": "等等，只是一個石柱，和毀滅部族有什麼關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010836,
					"content": "而且你剛才一直在說的「縫影針」，和更之前說的我們鑽下去的什麼「小縫影針」，明明都是大石柱子，為什麼叫這個啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010837,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#哦，{NICKNAME}和派蒙都是異邦人，的確應該解釋得更詳細一點，這其實和部族裡的一個傳說故事有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010839,
					"content": "故事裡說大靈將「縫影針」懸掛於此，是為了縫住火山大王的影子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010840,
					"content": "不過在真實的歷史中，那根柱子之下其實是被封印在此的深淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010841,
					"content": "在納塔，故事大多都是為了警告，都是被敘事裝點過的話語，所有的修辭都是一種譬喻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010842,
					"content": "等等，所以下面其實是被封印起來的深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010843,
					"content": "對啊，最近三根小的「縫影針」中浮起了兩根，說不定等第三根浮起來的時候，底下的壞東西就會跟潮水一樣湧出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010844,
					"content": "#所以看到{F#妳}{M#你}們鑽下去一根，實在是有點喜出望外，也就當然不可能向{F#妳}{M#你}們要賠償了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010845,
					"content": "#而且，我想向{F#妳}{M#你}們請求，可不可以把另外一根「小縫影針」也壓下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010846,
					"content": "#唔…怎麼辦好呢，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010847,
					"content": "…事涉深淵，很難袖手旁觀了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#好吧，既然連{REALNAME[ID(2)|SHOWHOST(true)]}都答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010851,
					"content": "唉呀…就像黑暗矇昧之時總有火光出現，呵呵…危難之際也總能傲立起了不得的豪傑，人類的可能性總在這時候變得相當耀眼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010852,
					"content": "#說不定這也會是個了不起的好故事，{NICKNAME}，{F#妳}{M#你}擁有一些故事裡的英雄也不具備的氣質呢，真讓人期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010853,
					"content": "走吧，英雄們，我們這就出發，去看看剩下那根浮起來的「縫影針」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010848,
					"content": "或許我們可以幫上一點忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "沒有什麼印象了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "是嗎？那個大傢伙明明滿顯眼的，不過沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010809,
					"content": "是派蒙幹的，我只是共犯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "#哇，這種時候{F#妳}{M#你}每次都這樣，我也是會生氣的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750010811,
					"content": "#哈哈，不用那麼緊張，應該說真是讓人鬆了口氣。這位小小的女士叫派蒙，那這位{M#兄弟}{F#小姐}的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "蒂圖"
				},
				{
					"id": 750010812,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}