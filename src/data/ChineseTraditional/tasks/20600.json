			"dialogs": [
				{
					"id": 206000501,
					"content": "別忘了啊，是「丘丘人暴徒」身上的戰利品，拿到了就趕緊回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
