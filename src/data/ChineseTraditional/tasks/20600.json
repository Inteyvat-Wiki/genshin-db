			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "關於「邪眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "#嘿…我說，{F#妳}{M#你}是真不會說話，還是假裝糊塗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000303,
					"content": "#{F#妳}{M#你}又不是「愚人眾」的正式成員，這麼直挺挺一句「『邪眼』是什麼？」戳過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000304,
					"content": "#{F#妳}{M#你}覺得我會直接一五一十地全部告訴{F#妳}{M#你}嗎？我又不是那兩個看門的西風騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000305,
					"content": "#不過…「邪眼」可是咱「愚人眾」的寶物，讓{F#妳}{M#你}瞭解一下，也不是不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000306,
					"content": "#這樣吧，{F#妳}{M#你}再去跑一趟。你見過蒙德城周圍的那些「盜寶團」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000307,
					"content": "雖然是一群偷偷摸摸的小毛賊，但偶爾還真能讓他們撞到寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000308,
					"content": "#{F#妳}{M#你}去幫我跑一趟，從「盜寶團」的手上拿點東西回來，作為交換，我就給{F#妳}{M#你}講講「邪眼」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000309,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "#我就喜歡爽快的人，那{F#妳}{M#你}就快點去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000311,
					"content": "你缺錢了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "#缺錢？哈哈哈，{F#妳}{M#你}以為我們是西風騎士團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000313,
					"content": "我只是想看看，盜寶團能在蒙德挖出什麼東西來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000314,
					"content": "不過…嘿嘿，想來他們也挖不出來什麼值得一提的寶貝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
