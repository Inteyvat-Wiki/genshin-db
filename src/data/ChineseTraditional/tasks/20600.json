			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "#這裡，旅行者，我注意{F#妳}{M#你}很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000102,
					"content": "找我有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "#怎麼這麼一副提防的語氣，我可是有件好事告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000104,
					"content": "#怎麼樣，{F#妳}{M#你}有沒有興趣加入「愚人眾」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000105,
					"content": "哼，我們才沒興趣呢！對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 206000106,
					"content": "我考慮考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "#喂！怎麼這種事情{F#妳}{M#你}也要考慮呀，直接拒絕才對吧！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 206000108,
					"content": "眼光不錯啊，想要成就一番事業，加入咱們「愚人眾」當然是不二之選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000111,
					"content": "#咦，看{F#妳}{M#你}的表情，是有問題想問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000109,
					"content": "這裡可是蒙德城。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "蒙德城怎麼了？咱們「愚人眾」可是全大陸公開徵募，絕對公平公正，西風騎士也管不著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "維克多"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060002",
							"2"
						],
						"stepId": 2060002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "關於「愚人眾」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "哦唷，單刀直入啊，哼哼，那講起來可就長囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000203,
					"content": "#不過，{F#妳}{M#你}還不是「愚人眾」的正式成員，我也不能白白告訴{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000204,
					"content": "我聽說，這蒙德城周圍有很多丘丘人，有的還群聚起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000205,
					"content": "#{F#妳}{M#你}幫我去跑一趟，從領頭的「丘丘人暴徒」那拿點戰利品回來，然後，我就跟{F#妳}{M#你}講點新鮮故事，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000206,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "喲，還滿爽快的，難得在蒙德城裡能遇見這種人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000208,
					"content": "#那{F#妳}{M#你}快點去吧，我就在這等{F#妳}{M#你}，記得快去快回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000209,
					"content": "就只要這個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "#幹嘛，{F#妳}{M#你}還嫌這個沒挑戰性？好了啦，再厲害點的怪物{F#妳}{M#你}搞得定嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000211,
					"content": "#快去快回吧，我就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000212,
					"content": "哈…要是再拖下去，我就要被這風給吹睡著了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
			"id": 2060003,
			"completionStepIds": [
				2060003
			],
