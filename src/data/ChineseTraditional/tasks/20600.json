					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000401,
					"content": "關於「女皇陛下」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "#怎麼，{F#妳}{M#你}想找我打聽女皇陛下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000403,
					"content": "#{F#妳}{M#你}不會是因為女皇陛下，才考慮加入愚人眾的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000404,
					"content": "#哼，不是我說{F#妳}{M#你}，{F#妳}{M#你}自己掂掂{F#妳}{M#你}這個念頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000405,
					"content": "#不過，關於女皇陛下的消息，我更不能白白告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000406,
					"content": "#{F#妳}{M#你}去跑一趟，從遺蹟守衛身上找點寶貝回來吧，我突然想收藏來玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "#哦，那{F#妳}{M#你}快去吧，我就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000409,
					"content": "你要這個做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "啊？做個收藏不行嗎？怎麼，蒙德人連個遺蹟守衛都不敢試試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000411,
					"content": "哼，對「愚人眾」來說，也就是一抬手的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000412,
					"content": "#不過，哈…這股風吹得我只想睡覺，實在提不起勁，所以這件小事就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
