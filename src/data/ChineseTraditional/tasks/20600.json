			"dialogs": [
				{
					"id": 206000601,
					"content": "東西拿到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000602,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "我看看，嗯…勉強還行，湊合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000604,
					"content": "那我就和你們講講「愚人眾」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000605,
					"content": "我們「愚人眾」來自「至冬宮」，聽從女皇陛下的命令，秉承著女皇陛下的意志，在世界各地活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000606,
					"content": "在其中有十一位最強的人，被女皇陛下賜予了「執行官」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000607,
					"content": "比起我們這些無名小卒，那十一位「執行官」才是有著赫赫威名的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000608,
					"content": "#如果{F#妳}{M#你}加入了「愚人眾」，實力也夠強，說不定還會被那位大人挑中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000609,
					"content": "#那樣的話，{F#妳}{M#你}就飛黃騰達囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000610,
					"content": "我？被挑中倒是談不上，我就是在這為「女士」大人辦點小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 206000611,
					"content": "呃…如果非要選的話，我其實更想跟著「隊長」大人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
