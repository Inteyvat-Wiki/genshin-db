			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "我有寶物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "欸？其實小店已經有了固定的進貨管道，平時也沒有收購散貨的業務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720104,
					"content": "#不過看{F#妳}{M#你}的樣子…似乎是個了不起的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720105,
					"content": "既然如此…不如先給我看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720106,
					"content": "將龍骨花凝珠的故事告訴了御輿源一郎。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720108,
					"content": "坦白說…雖然這個故事很神奇…但是好像也稍微神奇過頭了些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720109,
					"content": "這種東西，已經有些超出我的理解能力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720110,
					"content": "請別見笑，畢竟我也只是會做些手工藝品的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720120,
					"content": "這樣吧，80000摩拉，最多再加5份刺身拼盤，這種料理可不便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720111,
					"content": "#這個價格{F#妳}{M#你}接受的話，我就買下這件寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720112,
					"content": "你會拿它做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "我還說不清楚，得再仔細琢磨一下這個東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720114,
					"content": "如果情況好的話，說不定可以加工成一種特別的根付，這樣應該能多賣點價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720115,
					"content": "公道的價格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "那麼這些摩拉請收好。我得去好好研究研究這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720117,
					"content": "我再考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "嗯…剛好我也可以再想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720119,
					"content": "#如果{F#妳}{M#你}考慮好了，可以再來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御輿源一郎"
				}
			]
