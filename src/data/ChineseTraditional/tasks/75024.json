			"dialogs": [
				{
					"id": 750240601,
					"content": "嘎嗚——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "「金盞花」"
				},
				{
					"id": 750240602,
					"content": "你不要激動，我們只是擔心那個人有沒有受傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240603,
					"content": "看來只能決鬥了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "不要這麼快就放棄嘛！小金盞花，我們沒有惡意，我們也知道，呃…好勇鬥狠絕對不是你的本意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240606,
					"content": "嘎！嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "「金盞花」"
				},
				{
					"id": 750240607,
					"content": "哇…牠怎麼更生氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240605,
					"content": "「我心愛的金盞花」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
