							-2032.529,
							73.586,
							8456.144
						],
						"pointId": 9450
					}
				]
			},
			"dialogs": [
				{
					"id": 750240101,
					"content": "親愛的，你們的熱情…真叫我招架不住，呼——先吃點冰，冷靜一下頭腦之後我們再慢慢聊，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "伊卡尤"
				},
				{
					"id": 750240102,
					"content": "嘎嗚——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "「金盞花」"
				},
				{
					"id": 750240103,
					"content": "起初聽到「唉喲」一聲慘叫，接著就是重物摔到地上的悶響，再之後就只剩龍的嗚嗚聲…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "欸？！那人沒事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240105,
					"content": "唔…牠們圍得死死的，不知道裡面的人到底怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240106,
					"content": "派蒙從上面看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}好像在說讓牠試試看，那就交給牠吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240109,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "呃…看起來情況不太妙的樣子？那人該不會死…呸呸呸，說不定只是昏過去了。但不管怎麼說，我們總不能見死不救啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240111,
					"content": "唔…麻煩三位借過一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240112,
					"content": "嘎！嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "「金盞花」"
				},
				{
					"id": 750240113,
					"content": "嗚…嗚嗚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "「小波」"
				},
				{
					"id": 750240114,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "「翡翠」"
				},
				{
					"id": 750240115,
					"content": "嗚哇，牠們完全不肯讓開…到底怎麼回事啊？聽那個人之前的話，應該也不是完全不認識的龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240116,
					"content": "要是有更多線索就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240117,
					"content": "…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#欸？{REALNAME[ID(2)|SHOWHOST(true)]}！是發現什麼了嗎？我們快跟上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
							"2"
						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "「…今天是雨天。為小波準備了牠最愛的<color=#00E1FFFF>酸汁醃魚</color>，看到牠心滿意足的樣子，一切也都值得了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240202,
					"content": "「…哪怕牠原本在縱情暢游，但只要端出<color=#00E1FFFF>酸汁醃魚</color>，牠就會從水中躍出，那弧線堪稱完美！…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240203,
					"content": "「我是不會懷疑牠對我的愛的，只是擔心…會不會其實牠愛<color=#00E1FFFF>酸汁醃魚</color>更甚於我…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240204,
					"content": "小波…指的應該是鰭游龍吧？營地的鍋子裡煮著的也是酸汁醃魚，一定是為牠準備的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240205,
					"content": "「…圓滾滾的眼睛、捲捲的尾巴、神氣快活的叫聲…翡翠啊翡翠，這世上還會有比你更可愛的小龍嗎？…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240206,
					"content": "「…從沒被欺騙過，也不懂得懷疑，好像和這世上所有的生靈都能夠成為朋友，分享玩耍的樂趣…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240207,
					"content": "「…要不是太忙，我真想整日整夜陪你玩耍，看你在陽光斑駁的林間穿梭，好像風的孩子，無憂無慮的精靈！…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240208,
					"content": "#唔…看來那隻小匿葉龍叫做翡翠，還是隻貪玩的小龍。說不定{REALNAME[ID(2)|SHOWHOST(true)]}也可以跟牠變成朋友呦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240209,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "「…我遍踏丘陵與山谷，只為了尋得你的蹤跡。如果你真的不待見我，大可以一走了之…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240211,
					"content": "「…但你卻照顧我的腳程，走走停停，甚至為我收集許多顆粒果，還有那些亮晶晶的石塊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240212,
					"content": "「…我心愛的金盞花，只有我知道，硬殼包裹著的是柔軟體貼的心，好勇鬥狠絕非你的本意…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "某人的日誌"
				},
				{
					"id": 750240213,
					"content": "呃…金盞花該不會是說那隻脾氣暴躁的嵴鋒龍吧？那副氣勢洶洶把人擊倒的樣子，哪有一絲溫柔體貼的影子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240214,
					"content": "不過話說回來，原來這三隻龍都是他的…朋友？到底為什麼會把他撞昏還團團圍住呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240215,
					"content": "先把人救出來再問吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "說的也是，要是有辦法讓龍讓開就好了…對了，日誌裡不是說小波喜歡吃酸汁醃魚嗎？正好營地裡也有，說不定可以把牠引開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240217,
					"content": "#讓{REALNAME[ID(2)|SHOWHOST(true)]}和翡翠交朋友呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#嗯！翡翠很貪玩，{REALNAME[ID(2)|SHOWHOST(true)]}只要帶牠去旁邊玩就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240221,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也很有幹勁呦！不過我們還是先試試看最簡單的方法吧，酸汁醃魚不吃不就浪費了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240219,
					"content": "和金盞花決鬥吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#還是先試試看和平的手段吧！譬如叫{REALNAME[ID(2)|SHOWHOST(true)]}把貪玩的翡翠引開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
