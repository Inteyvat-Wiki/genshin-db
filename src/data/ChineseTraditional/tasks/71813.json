			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "「璃月之永固，人世之綢繆，願據此大計，徐徐而行…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130502,
					"content": "#{F#妳}{M#你}回來了啊，稍等，還有最後幾句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130503,
					"content": "嗯…行了，寫完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130504,
					"content": "這是「扣三絲」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "#不急不急，{F#妳}{M#你}先看看這本書怎麼樣，我自認書法尚可，寫的字應該是能夠入眼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130506,
					"content": "這就是詩人的實力嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "#哈哈哈，謬贊，謬贊了。這本書給{F#妳}{M#你}，可別弄丟了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "#嗯？{F#妳}{M#你}有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 718130602,
					"content": "我們想要訂製一些竹製的小擺設…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "#竹製的小擺設？我倒是也能做，但{F#妳}{M#你}這個訂單是從哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 718130604,
					"content": "是百聞給的清單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "哦…月海亭那邊來的訂單啊，行，我盡量加緊做就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 718130606,
					"content": "不過，我經常去取材料的竹林那邊，最近不知道為什麼，突然多了很多林豬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 718130607,
					"content": "雖然也沒什麼大影響，但我總得繞著它們去取竹子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 718130608,
					"content": "#要是{F#妳}{M#你}們能把那些林豬趕跑的話，我現在就能去取點竹子回來開工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
