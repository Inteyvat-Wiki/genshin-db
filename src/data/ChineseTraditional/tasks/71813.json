					"nextDialogs": [
						718130810
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130810,
					"content": "#好了，不說這些了，再次感謝{F#妳}{M#你}們幫助籌備物資，這些報酬請{F#妳}{M#你}們收下，我要接著去工作了。",
