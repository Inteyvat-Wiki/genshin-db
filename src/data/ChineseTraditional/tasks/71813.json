			"dialogs": [
				{
					"id": 718130401,
					"content": "《珠璣寶礦》…唔，「凡工商萬業，如泉如流，起於山岩，終於汪洋…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
