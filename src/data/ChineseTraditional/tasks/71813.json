			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紀芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "#{F#妳}{M#你}好，想要買什麼書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130202,
					"content": "我們想要《珠璣寶礦》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "#《珠璣寶礦》？這本書我這裡可沒有…怎麼，{F#妳}{M#你}要得很急嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130204,
					"content": "關於重建群玉閣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "咦？群玉閣要重建了嗎？那確實得好好籌備，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130206,
					"content": "#不然，{F#妳}{M#你}去找清晝問問吧，他讀過很多書，說不定他知道在哪能找到這本《珠璣寶礦》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130207,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "清晝我記得經常在望舒客棧待著，你可以去那邊找找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "難寫，真是難寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130302,
					"content": "關於《珠璣寶礦》…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "《珠璣寶礦》？哦，我記得那本書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130304,
					"content": "我之前為了寫一首和商賈之事有關的詩而四處取材，在一個地方偶然讀過這本書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130305,
					"content": "那本書裡說的東西雖然我有些看不懂，但有些事例對我作詩倒也有所啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130306,
					"content": "#我想想那首詩是什麼啊，{F#妳}{M#你}稍等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130307,
					"content": "你還記得那本書在哪裡能找到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "#{F#妳}{M#你}們要找那本書？那我可不記得在哪能找這本書了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130309,
					"content": "#不過，如果{F#妳}{M#你}們急著要，我倒是可以直接手寫一份給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130310,
					"content": "手寫一份？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "欸，那本書的內容倒也不長，記下來也不難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130313,
					"content": "而且我那時候讀那本《珠璣寶礦》的時候，藏書的人壓根也不讓我借閱出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130314,
					"content": "但作詩哪是一朝一夕的事…我就把那本書給抄了一份走，因為內容也不太多，我也就差不多背下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130315,
					"content": "這就是詩人的實力嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "#不值一提，不值一提。不過…我寫一份這本書給{F#妳}{M#你}，{F#妳}{M#你}也幫我個小忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130317,
					"content": "說來有些不好意思，我一直在這取材，卻忘了吃飯，現在有些餓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130318,
					"content": "#請{F#妳}{M#你}幫我拿一份「扣三絲」過來吧，我也會在這幫你寫那本《珠璣寶礦》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130319,
					"content": "#等{F#妳}{M#你}回來了，我差不多也就寫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				},
				{
					"id": 718130311,
					"content": "你全記下來了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
			"completionStepIds": [],
