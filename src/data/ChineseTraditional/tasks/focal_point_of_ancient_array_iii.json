			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "…比約恩怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001602,
					"content": "…傷得很重。攻擊來得太突然了，他為了保護我們…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "伊捷莉"
				},
				{
					"id": 761001603,
					"content": "…戰場環境太危險，他也承受不了轉移的顛簸了，我們只能就地緊急處理，但以我們現有的能力實在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "伊捷莉"
				},
				{
					"id": 761001604,
					"content": "隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001605,
					"content": "比約恩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001606,
					"content": "…對不起…我沒能完成任務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001607,
					"content": "你完成得很好！陣地守住了，大家也都平安無事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001608,
					"content": "是嗎…原來我做到了…太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001609,
					"content": "別說話了，先專心養傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001610,
					"content": "現在不說…以後就沒機會了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001611,
					"content": "…這是隊長命令！我不准你再說這種話！你會沒事的…一定會沒事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001612,
					"content": "呵…好…遵命…我不會再說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001613,
					"content": "不過…等我見到維德…也算能夠交代了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001614,
					"content": "他以前常說…我們執燈人就像冬凌草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001615,
					"content": "面對狂獵…我們每個人都很脆弱…就像冬凌草的花一樣…會輕易凋落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001616,
					"content": "但是…只要葉片還在…只要根還牢牢扎在泥土裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001617,
					"content": "到了下一季…再下一季…總會有新的花朵綻放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001618,
					"content": "我們是不會失敗的…對吧…隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001619,
					"content": "…嗯！我們絕不會失敗！我一定會親手、徹底將那魔物葬送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001620,
					"content": "…你是我們之中最強的…我相信你…隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001621,
					"content": "…放心吧，比約恩，我一定遵守約定。你該休息了…等你傷養好了，一切都會好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001622,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "比約恩"
				},
				{
					"id": 761001623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001624,
					"content": "#…{NICKNAME}、派蒙，我們該走了。任務還沒結束，我們不能在這裡耽擱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761001625,
					"content": "葉洛亞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761001626,
					"content": "就算為了比約恩，我們也得向前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "我們一定能打敗敵人，取得勝利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "…嗯，繼續前進吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		}
	]
