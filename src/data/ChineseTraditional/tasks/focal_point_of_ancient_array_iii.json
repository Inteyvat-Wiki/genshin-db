			"dialogs": [
				{
					"id": 761000701,
					"content": "別擋路，滾開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761000702,
					"content": "嘻嘻…你急什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000703,
					"content": "反正你們…遲早都得死…不過是…有人要提早上路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000704,
					"content": "他不是抱怨…三年前自己沒死成嗎…現在…我就成全他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000705,
					"content": "…比約恩？你對他做了什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761000706,
					"content": "是他太弱了…弱者…廢物…蟲豸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000707,
					"content": "…會死難道不是理所應當嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000708,
					"content": "不准你侮辱他！他一點也不弱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761000709,
					"content": "哦…在你看來…他是強者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000710,
					"content": "可是…可是強者就不會死嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000711,
					"content": "我還以為…你心裡非常清楚啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000712,
					"content": "那些比你強的人…不是都死掉了嗎…不管是三年前…還是十年前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000713,
					"content": "…閉上你的狗嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 761000714,
					"content": "是啊…原來弱小的…就只有你而已啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000715,
					"content": "要不然為什麼…每次…每次活下來的都只有你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000716,
					"content": "…是你從戰場逃跑了吧？苟且偷生的膽小鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "來自魔物的聲音"
				},
				{
					"id": 761000717,
					"content": "葉洛亞！別聽它胡說八道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761000718,
					"content": "少廢話，納命來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#…{NICKNAME}！我們速戰速決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		},
