			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"阿漢格爾",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "這一根軸承的尺寸太大了，沒辦法和其他軸承相容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230150102,
					"content": "上一根太小，這一根太大，我的鐵塊都要被你用光了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150103,
					"content": "事實上，我們的錢也快不夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150104,
					"content": "你們在吵什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "這個人，要我給他打造很多鐵管和齒輪，而且每個鐵管和齒輪還有不同的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150106,
					"content": "為了幫他打造這些東西，我已經要把鐵塊都用完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150107,
					"content": "但他還說不夠用，還要更多的齒輪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150108,
					"content": "請您再聽我解釋一下我的工作，您聽完之後，肯定能理解我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230150109,
					"content": "這是在折騰什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "就讓加爾恰先生給阿漢格爾先生講解去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150111,
					"content": "旅行者，我…呃，加爾恰先生想請您幫忙去搜集一些鐵塊，請問您願意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150112,
					"content": "我是有空，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "在製造機器這件事上…我們遇見了一些早已預料到的阻礙，加爾恰先生目前正在思索如何突破這個阻礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150115,
					"content": "如果以後您有興趣，就請自己去問問加爾恰先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150116,
					"content": "我想…除了他自己，誰也無法解釋清楚那臺機器的原理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150117,
					"content": "但在那之前，請您先拿些鐵塊回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 230150113,
					"content": "他的機器改造得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
