			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通",
					"阿漢格爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "好了！好了！不要再說了，我要接著給你做齒輪去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150302,
					"content": "但我還沒有完全講清楚我的機器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230150303,
					"content": "#鐵塊已經有了吧，那我馬上就開工了，{F#妳}{M#你}離遠點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230150304,
					"content": "阿漢格爾猛烈揮舞著鐵錘，加爾恰不得不躲到了一邊…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "就讓阿漢格爾先生繼續工作吧，這是您的報酬，請您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150306,
					"content": "希望你們能成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "我對您的祝福表示感謝，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150308,
					"content": "我對這件事…則謹慎地抱著悲觀態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150309,
					"content": "加爾恰先生是一個機械方面的天才，這一點不容置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150310,
					"content": "但我認為，對於加爾恰先生所想完成的那臺機器而言…他僅僅是一個「天才」，也許還遠遠不夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301502",
							"2"
						],
						"stepId": 2301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿漢格爾",
					"加爾恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "你要那麼多齒輪和管子做什麼？是想要搭個鐵皮屋嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230155002,
					"content": "沒錯，先生！我就是要搭一間屋子，一間塞滿了齒輪的屋子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230155003,
					"content": "我把容納一部分齒輪的地方稱為「容室」，而軸承和另外一部分齒輪，則會組成「算庫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230155004,
					"content": "「容室」裡的齒輪用來儲存和記錄數字，而「算庫」裡的齒輪則用來計算它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230155005,
					"content": "我畫張圖您就能理解了。有紙嗎？沒有？沒關係，我在衣服上畫，這樣比較容易看清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230155006,
					"content": "能把那塊炭給我嗎？非常感謝，您瞧這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		}
	]
}