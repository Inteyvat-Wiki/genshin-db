			"dialogs": [
				{
					"id": 160110201,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110202,
					"content": "…劍還完好無損？但感知不到上面的狼靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110203,
					"content": "（…看來這裡已經不是「現實」了，而是「北風」混雜「羅蘭」的意識，構築出的空間吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110204,
					"content": "後面沒有退路，前面又是「狼口」…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110205,
					"content": "——哈，就往裡頭走一遭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
		},
