					"nextDialogs": [
						160111202,
						160111215,
						160111219,
						160111231
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111202,
					"content": "關於你的計畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111203
					]
				},
				{
					"id": 160111203,
					"content": "以劍刃作為佯攻，以心臟承載靈魂…是我當初認為最可行的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111204
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111204,
					"content": "不過計畫的後半部分…靠思念的牽引殺出地脈…我倒也的確沒幾成把握，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111205,
					"content": "#說真的，要是那時候{NICKNAME}分離羅蘭雜質的實驗沒成功，你打算怎麼辦啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160111206,
					"content": "嗯…這一步最初是準備交給巴巴托斯執行的，但他聽完之後，馬上向我舉薦了更適合的人選…「捕風的異鄉人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111207,
					"content": "#事實證明，我們的信任沒有錯。多謝{F#妳}{M#你}了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111208,
					"content": "那萬一我也沒成功呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "那可能就得辛苦巴巴托斯把我從狼的那一頭，吹回人的這一頭了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111210,
					"content": "…但無論如何，代價都不會小，成功的機率也未必會高…而我更不希望他去耗用這種力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111211,
					"content": "動用神明的力量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "嗯，問得好——一杯上好的蒲公英酒，就拿我藏在辦公桌抽屜裡的私房錢付帳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111214,
					"content": "哪有這麼便宜的事啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160111212,
					"content": "…要支付什麼代價？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "關於遠征軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "嗯，這次擊敗羅蘭倒影之後，狂獵在短時間內應該無力再組織反撲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111217,
					"content": "除了一部分留在挪德卡萊的據點裡輪值的人，剩下的都會分批次陸續返回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111218,
					"content": "#阿貝多跟杜林也會跟第一波遠征軍一起回來，{F#妳}{M#你}們應該過不久就能再見到他們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111219,
					"content": "關於你的未來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "#我的未來嗎…說不定{F#妳}{M#你}也已經從巴巴托斯或者魔女會之類的地方瞭解過了，我曾在水占盤裡窺見一些未來的倒影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111221,
					"content": "「來自北方的深淵災厄」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "#對，如今看來…這個未來，大概算是已經改變了吧——託{F#妳}{M#你}的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111223,
					"content": "但等我辦完騎士團裡的瑣事，還是得回北邊一趟…挪德卡萊的新據點裡還有很多工作要處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111224,
					"content": "第一批自願留守的騎士們都還沒換班回來，我又怎麼能放下他們不管呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111225,
					"content": "說得這麼好聽，該不會就是為了把蒙德的工作繼續丟給琴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160111226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111227,
					"content": "…不會吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160111228,
					"content": "不要在這種時候沉默啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "#哈哈——開玩笑的，以後{F#妳}{M#你}們在蒙德也能經常見到我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160111229,
					"content": "不要在這種時候微笑啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "沒問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "嗯，那我就自己再吹一會吧——最醉人的酒，還是老家的風啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
		}
	]
}