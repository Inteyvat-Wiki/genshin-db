			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "這裡…就是狼的「心」中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110702,
					"content": "……！「羅蘭」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅蘭"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "…如你所願，「北風騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110902,
					"content": "哈，跟我想像的不太一樣，你看起來好像沒有「碎片」裡記憶得那麼瘋狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110903,
					"content": "我從未偏離過正確的道路。而你，現在的你不像是能屠龍的英雄，倒像個落魄騎士…流浪了太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110904,
					"content": "彼此彼此。看來我們都不在自己最強的時刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110905,
					"content": "「獵月人」的軍勢已經被擊敗，由深淵擬造出的「我」，自然也只是不完整的倒影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110906,
					"content": "力量已臻「羅蘭」的極致，心境卻依然停滯於染血的時刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110907,
					"content": "因此，「我」也同樣不正確…而騎士不能容忍自身止步不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110908,
					"content": "將你從不公中救贖、引領你投效深淵後，我便會將自身匡正，繼續踐行騎士之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110909,
					"content": "哈，外頭可是經不起你繼續折騰了…你的這份偏執倒是跟我想像的一樣，看來我是沒機會說服你了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110910,
					"content": "騎士信奉的美德不會為言語玷染，無論那言語多麼高貴。你我都無法說服彼此，你也早已知曉這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110911,
					"content": "否則，你們又何必將一切希望，都繫在玻瑞亞斯的「一念」之間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110912,
					"content": "但如今你用以承載狼靈的劍刃早已崩毀，手中所執的不過是徒具其形的幻影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110913,
					"content": "你已沒有手段改變一切，也再無援軍可以期待…此地即是你的「末路」，孤獨的遠征者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110914,
					"content": "呵，手段姑且不論，援軍的話…這裡不是還有一位嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110915,
					"content": "…什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110916,
					"content": "我要說服的對象，從始至終就只有那一位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110917,
					"content": "這裡是北風之魔神——安德留斯的「心」中，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110918,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110919,
					"content": "喂——！聽見了嗎？！安德留斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110920,
					"content": "快醒醒吧！堂堂北風之魔神，還要被深淵控制多久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110922,
					"content": "如果這就是你最後的掙扎，那我很失望，「北風騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110923,
					"content": "氣勢和願望喚不來奇蹟，這世界從不會那樣仁慈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110924,
					"content": "…歸去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110925,
					"content": "…歸於…地脈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110926,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110927,
					"content": "…這就是「我」的選擇…「我」的記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110928,
					"content": "…是「我」在旅途終點…找到的答案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110929,
					"content": "「安德{RUBY#[D]玻瑞亞斯}留斯」…你的信，我可是好好送回到「你」心裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110930,
					"content": "呵…「北風騎士」嗎？看著吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110931,
					"content": "…這就是「狼{RUBY#[S]我}」…唯一能為「人{RUBY#[S]你們}」做的事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "安德留斯"
				},
				{
					"id": 160110932,
					"content": "…代表地上的人類，向您致謝，群狼的領主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110933,
					"content": "玻瑞亞斯…正在回歸地脈。為什麼？你的劍已經破碎，你明明已經沒有任何承載靈魂的手段了。不，莫非…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110934,
					"content": "氣勢和願望喚不來奇蹟…這種事情我當然知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110935,
					"content": "…但從一開始，寄託靈魂的手段——就不只有「劍」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110936,
					"content": "…奔狼的領主，曾將靈魂的力量賦予麾下的群狼，強壯牠們的心臟、鋒利牠們的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160110937,
					"content": "…即便「我」無意於此，凡人的「心」，也將會被王狼的靈魂撕咬、吞噬、同化…一如強行混合的人群與狼群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 160110938,
					"content": "…以凡人的心臟，承載魔神的靈魂…這將會是一條無法回還的道路，但我不會勸阻一名騎士，踏上自己的征途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 160110939,
					"content": "你的心臟、你的靈魂…也在一同崩解？…原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110940,
					"content": "「羔羊怎麼將鈴鐺繫到狼的心口」…你曾經這麼問過對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110941,
					"content": "這就是我的答案——讓狼自行吞下這顆「心臟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110942,
					"content": "託付於劍上那部分狼靈不過是佯攻，真正的念想與記憶，是由你的心臟承載…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110943,
					"content": "為了不被我察覺，故意讓王狼的靈魂與你同化，再被我吞噬…迄今為止，你都是承受著這樣的重荷在戰鬥的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110944,
					"content": "比起王狼的決意…這點付出算不了什麼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110945,
					"content": "頑強的意志、優秀的策略…但這不是騎士應有的戰鬥方式。正因如此，你的選擇是錯誤的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110946,
					"content": "你的靈魂已同安德留斯融為一體。待牠徹底將自身匯入地脈，你也會與牠一同墜入其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110947,
					"content": "屆時，無論是巴巴托斯，還是你身邊那位旅人，都已無法從地脈中錨定你的靈魂，更遑論將你救出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110948,
					"content": "你輸了，我也是。很遺憾，現在我已經無法拯救你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110949,
					"content": "…願你的靈魂隨北風安息，孤獨的遠征者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 160110950,
					"content": "哈哈…孤獨嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110951,
					"content": "抱歉啊——雖然我也曾經想過和你同歸於地脈的結局，是不是已經滿圓滿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110952,
					"content": "但可惜啊，跟當年的羅蘭不一樣，外面還有美酒跟朋友在盼著我凱旋呢，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110953,
					"content": "——我還沒打算認命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 160110954,
					"content": "叮鈴——有你的來信~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
