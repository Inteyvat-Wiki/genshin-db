				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "來試試「機關棋譚」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560102,
					"content": "這是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "喔…喔！歡迎光臨~！這是我剛從璃月那邊代理到的新遊戲，叫做「機關棋譚」哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560104,
					"content": "簡單來說，就是一種能在桌子上玩的「遊戲」啦。最開始是由璃月的瑞錦小姐發明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560105,
					"content": "我…怎麼說呢，按照瑞錦小姐的說法，我是「海外代理」之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560111,
					"content": "在獲得…呃…「代理權」之後，瑞錦小姐就把整套的「機關棋譚」，還有相關的營業建議寄了過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560112,
					"content": "雖然寄過來的時候被遠國監司扣住了…我奔波了好久才把這套「機關棋譚」帶回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560113,
					"content": "遠國監司扣這個做什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "只要是國外來的東西，他們什麼都扣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560115,
					"content": "算了，不說這個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560116,
					"content": "#{F#妳}{M#你}看到桌上這些擺件了嗎？這些都是「機關棋譚」裡要用到的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560117,
					"content": "是不是很有璃月的感覺？哈哈哈，這可都是我按照瑞錦小姐信裡的描述請人專門做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560118,
					"content": "連桌子都專門拜託人做了一張差不多的…花了一大筆錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560119,
					"content": "而且在這副「機關棋譚」裡，我還按照瑞錦小姐的建議，加入了一個全新的玩法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560120,
					"content": "#唔…用講的{F#妳}{M#你}應該也聽不懂，{F#妳}{M#你}就直接先試玩一局吧。親自玩過之後，應該就都能弄懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560121,
					"content": "試玩「機關棋譚」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "#沒問題，好好玩吧，這可是全新的「機關棋譚」，絕不會讓{F#妳}{M#你}失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560123,
					"content": "還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "#嗯，等{F#妳}{M#你}有空了再來試玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560106,
					"content": "怎麼這裡也有「機關棋譚」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "#歡迎…咦？{F#妳}{M#你}知道「機關棋譚」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560108,
					"content": "#啊…我知道了，{F#妳}{M#你}應該是在璃月那邊玩過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560109,
					"content": "瑞錦小姐和我說過她在海燈節的時候做的推廣工作…看來確實還挺有效的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560110,
					"content": "我…怎麼說呢，按照瑞錦小姐的說法，我是這套「機關棋譚」在稻妻區域的「海外代理」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "駒形"
				}
			]
		}
	]
}