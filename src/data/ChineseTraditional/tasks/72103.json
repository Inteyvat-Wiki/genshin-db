				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721033701,
					"content": "「朧夜正中」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033702
					]
				},
				{
					"id": 721033702,
					"content": "啊…不好意思，目前暫時沒有「這種東西」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033703
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033703,
					"content": "您真是相當可靠呢。如果愚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033704
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033704,
					"content": "愚人眾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033705
					]
				},
				{
					"id": 721033705,
					"content": "愚…我、我是說，「愚拙如我玄冬林檎，也有幸能親眼目睹您戰鬥的英姿，那就再好不過了」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033706
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033706,
					"content": "…會有機會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7210338,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210315",
							"3"
						],
						"stepId": 7210315,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「玄冬林檎」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721033801,
					"content": "關於這種紙片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033802
					]
				},
				{
					"id": 721033802,
					"content": "啊，您是說「御神籤」吧？求籤的流程是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033803
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033803,
					"content": "首先需要由您用力搖晃「御神籤箱」，取出一根竹籤。然後，需要麻煩您將竹籤交給我，我會將其換成對應的「御神籤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033804
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033804,
					"content": "如果是「凶籤」的話，可以將其結在「御籤掛」上逢凶化吉喔。大致就是這樣一回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033805
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033805,
					"content": "玄冬小姐懂得真多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033806
					]
				},
				{
					"id": 721033806,
					"content": "哪、哪有，這畢竟是…是巫女的基本素養嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				}
			]
		},
		{
			"id": 7210339,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
