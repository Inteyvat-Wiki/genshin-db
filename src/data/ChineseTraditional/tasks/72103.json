					"nextDialogs": [
						721034005
					]
				},
				{
					"id": 721034005,
					"content": "很遺憾，我回到這裡的時候，百代小姐已經走了，我至今沒能當面向她道謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721034006
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
