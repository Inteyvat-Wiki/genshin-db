			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「玄冬林檎」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721033901,
					"content": "交出「特製的竹籤」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033902
					]
				},
				{
					"id": 721033902,
					"content": "好的，請將竹籤交給我吧。奇怪，總覺得剛才好像沒有看到您搖晃籤筒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033903
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033903,
					"content": "是妳的錯覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033904
					]
				},
				{
					"id": 721033904,
					"content": "對呀，因為玄冬小姐一副心不在焉的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721033905,
					"content": "心、心不在焉？！啊…沒有的事，大概只是因為昨天沒有睡好的關係，讓您擔心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033906
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033906,
					"content": "這是您的御神籤，請您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033907
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033907,
					"content": "（怎麼樣怎麼樣？剛才粉末應該已經黏在她身上了吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721033908,
					"content": "（嗯，沒問題。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033909
					]
				},
				{
					"id": 721033909,
					"content": "咦，你們兩位為什麼一臉凝重地站在這裡？難道是抽到凶簽了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721033910
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721033910,
					"content": "不，是「末吉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721033911
					]
				},
				{
					"id": 721033911,
					"content": "請不要灰心，「末吉」其實也是不錯的運勢哦。也許會經歷一些坎坷，但最終一定會迎來美滿的結局。",
					"roleType": "TALK_ROLE_NPC",
