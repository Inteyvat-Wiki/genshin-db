				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721031901,
					"content": "#（喂，{NICKNAME}！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721031902,
					"content": "（這個玄冬小姐，按照那個玄冬小姐說的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721031903,
					"content": "（嗯，愚人眾的冒牌貨。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721031904
					]
				},
				{
					"id": 721031904,
					"content": "啊呀，又見面了。今天也要來看看運勢嗎？還是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031905
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031905,
					"content": "如果有什麼想傾訴、想找人商量的事，我也能聽您講喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031906,
						721031907
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031906,
					"content": "只是路過而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721031908
					]
				},
				{
					"id": 721031908,
					"content": "玄冬小姐好親切喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721031909,
					"content": "是這樣嗎？呵呵，最近經常有人這麼誇我呢。感覺好開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031910
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031910,
					"content": "在這樣漂亮的神社工作，一直是我的夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031911
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031911,
					"content": "（她就是愚人眾派來的冒牌貨。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721031912
					]
				},
				{
					"id": 721031912,
					"content": "（唔…不過這個玄冬小姐，好像真的很喜歡這裡的工作。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031913,
						721031914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721031913,
					"content": "（不能掉以輕心。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721031915
					]
				},
				{
					"id": 721031915,
					"content": "#那麼，{NICKNAME}，今天找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031916,
						721031919
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031916,
					"content": "我只是來看妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721031917
					]
				},
				{
					"id": 721031917,
					"content": "我…欸？啊，欸？不、不好意思，我不太明白您、您您的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721031918
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 721031918,
					"content": "請、請讓我冷靜一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
