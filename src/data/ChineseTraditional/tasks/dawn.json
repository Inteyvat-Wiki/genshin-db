					"id": 30130201,
					"content": "#怎麼啦，怎麼啦，{F#妳}{M#你}們見到我這麼激動，呵呵，我們不是才一晚上沒見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130202
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30130202,
					"content": "其實已經不止一晚上了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130203,
					"content": "啊…好奇怪，原來我睡了那麼久嗎？難怪頭這麼痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪娜澤黛"
				}
			]
