				"points": []
			},
			"dialogs": [
				{
					"id": 30130401,
					"content": "妳其實是納西妲吧！我就說當時在花神誕祭會場見到過的凱瑟琳小姐有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130402,
					"content": "還有迪娜澤黛的事…是妳救了她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130403,
					"content": "這個可就說來話長了，還是不要在這裡打擾病人休息得好，她的精神還非常虛弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130404
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130404,
					"content": "我們換個地方聊吧，就到旅行者「情有獨鍾」的那個長椅附近聊聊如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		}
