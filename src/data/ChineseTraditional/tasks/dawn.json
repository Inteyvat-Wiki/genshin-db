	"talks": [
		{
			"id": 301301,
			"completionStepIds": [
				301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301301",
							"2"
						],
						"stepId": 301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30130101,
					"content": "先說說迪娜澤黛的事吧，她沒事可真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130102,
					"content": "嗯，在「最後一天的花神誕祭」上我們分別之後，我到了城外去，見到了旅行者所描述的光景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130103,
					"content": "在無數的夢境中，我找到了一個逐漸變得稀薄的夢…這正好驗證了我的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130104,
					"content": "當迪娜澤黛徹底無法承受虛空對夢境的收割之後，意識便會逸散，反而脫離了虛空的掌控。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130105,
					"content": "不過殘留的那一點意識也無力支撐很久了，它會回到本該屬於自己的夢境裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130106,
					"content": "與夢境一起逐漸變得稀薄，直至消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130107,
					"content": "#我竭盡了全部的努力維持住了那個迪娜澤黛的夢境，但也不會很長久，好在{F#妳}{M#你}們及時打破了「輪迴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130108,
					"content": "這麼說來，算是我們一起拯救了迪娜澤黛呀，最後還是趕上了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130109,
						30130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130109,
					"content": "令人欣慰的結果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				},
				{
					"id": 30130111,
					"content": "#嗯？{F#妳}{M#你}們怎麼都在欣慰地笑呢？我以為此刻{F#妳}{M#你}們應該感動得痛哭流涕才對…嗯…還需要繼續多多觀察才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130112,
					"content": "兩者其實都可以啦！這要分人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130113,
					"content": "#好了，除此之外，{F#妳}{M#你}們還有很多問題想問我吧？{F#妳}{M#你}們拯救了我虔誠的信徒，我會將所有答案作為回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130114,
					"content": "關於我在道成林昏迷時所看到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130115
					]
				},
				{
					"id": 30130115,
					"content": "#旅行者在道成林的時候被薰香影響而昏迷了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}說昏迷時看到了一棵巨大的樹，紅色的天空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130116,
					"content": "還聽到了一個人的聲音，對嗎？關鍵字是「世界」和「遺忘」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130117,
					"content": "對的！妳果然知道，我們一直想問妳那是什麼，紅色的天空和坎瑞亞有沒有關聯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130118,
					"content": "旅行者看來連接上了世界樹啊，那是世界樹中，大慈樹王殘餘的意識所留下的一段訊息，也或許是她臨死前最後的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130119,
					"content": "#{F#妳}{M#你}們應該也知道，大慈樹王是在坎瑞亞災變後失蹤的，所以時間點的確對得上，{F#妳}{M#你}們的懷疑不無道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130120
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130120,
					"content": "是大慈樹王殘留的訊息？我們之前還以為會是那個赤王呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130121,
					"content": "#赤王…那位更早便逝去的魔神？至今還有一些仍在信仰那位赤王的沙漠子民，{F#妳}{M#你}們可能聽到了些謠傳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130122
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130122,
					"content": "這樣嗎，那麼…那條訊息的內容到底是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130123,
					"content": "…我還無法解讀它，哪怕以虛空目前的能力也做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130124
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130124,
					"content": "大慈樹王在世界樹中殘留的意識，像是被「汙染」了一樣，隱含了非常危險的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130125
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130125,
					"content": "甚至許多修行的學者一旦意識與之連通，便會徹底陷入瘋狂…儘管我多次對教令院進行過警示，卻依舊一直有受害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130126
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130126,
					"content": "不過我相信，拯救世界樹的關鍵就在其中，所以我一直沒有放棄對它的解讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130127
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130127,
					"content": "幻覺裡的那棵樹就是世界樹嗎…提納里也說過，世界樹「生病」了，難道就是因為有被「汙染」的意識在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130128,
					"content": "可是連妳也不知道那個幻覺的含義，我們豈不是白來找妳了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130129,
					"content": "#旅行者接觸了那個「意識」卻絲毫不受影響，我第一次見到這樣的人。或許有{F#妳}{M#你}在的話，我們會有機會解讀它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130130
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130130,
					"content": "不，我們是必須要解讀出其中的秘密。我已經排除了所有可能影響世界樹的因素，只剩下這一種了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130131
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130131,
					"content": "這是一個以世界樹…以提瓦特的存亡為賭注來挑戰的「謎題」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130132,
					"content": "妳為何是凱瑟琳的模樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130133
					]
				},
				{
					"id": 30130133,
					"content": "應該說，我正在以虛空為媒介，「侵佔」著凱瑟琳的意識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130134
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130134,
					"content": "那、那是怎麼做到的！凱瑟琳小姐好可憐，妳也能侵佔別人的意識嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130135,
					"content": "如果是佩戴著虛空終端的人的話，理論上我都是可以「進入」他們的腦子裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130136
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130136,
					"content": "虛空是大慈樹王的遺產，而我既是小吉祥草王，又是「最初的虛空終端」，我的意識一直連接在虛空當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130137
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130137,
					"content": "不過我一向尊重須彌子民的自我意志，從未真的去侵佔他們的意識，只會在必要時借用一下這個至冬的仿生人偶而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130138
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130138,
					"content": "啊…唔，等等，好像冷不防知道了什麼不得了的事，原來凱瑟琳是…難怪有那麼多奇怪的地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130139,
					"content": "可是妳自己的身體呢？為什麼一直用這種方式，我記得妳是住在「淨善宮」來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130140,
					"content": "…這要從很久以前說起。大慈樹王消失後，賢者們找到了剛剛誕生的我，並接回須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130141
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130141,
					"content": "當時的我的確幼小無力，賢者們便以「保護」的名義，將我關在淨善宮中，幾乎不再過問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130142
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130142,
					"content": "可我很清楚，賢者多麼希望他們找到的是大慈樹王，而非是幾乎象徵著大慈樹王已逝去這一事實的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130143
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130143,
					"content": "所以…賢者們其實是在「軟禁」自己新的神明嗎？他們怎麼敢…為什麼不給他們一點教訓呀，納西妲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130144,
					"content": "從某個角度上講，他們也沒有錯。大慈樹王是全知全能的，哪怕逝去後，虛空依舊在賦予這個國家力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130145
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130145,
					"content": "而我…還遠遠擔不起「智慧之神」的名號，對國家的治理也是教令院更加駕輕就熟，我的存在並沒有那麼大的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130146
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130146,
					"content": "在我眼裡，妳已經是位優秀的神明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130147
					]
				},
				{
					"id": 30130147,
					"content": "是呀是呀，納西妲也已經有很多信徒了，看看花神誕祭那天，來參加的大家都是真心喜歡妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130148,
					"content": "#呵呵，謝謝{F#妳}{M#你}們能這麼說。不過其實，能夠將意識連接虛空的我，也並不需要身體上的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130149
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130149,
					"content": "對我來說，設法拯救世界樹才是使命與最優先事項。我會一邊繼續尋找方法，一邊努力成長為更合格的神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130150
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130150,
					"content": "…偶爾，負起「智慧之神」的責任，開導一下迷途中的子民，這些…也就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130151,
					"content": "關於教令院賢者們的計畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130152
					]
				},
				{
					"id": 30130152,
					"content": "教令院對須彌的治理一直沒出過什麼大問題，這是我見到他們第一次脫離正軌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130153
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130153,
					"content": "究竟發生了什麼事，有什麼目的值得他們這麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130154
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130154,
					"content": "儘管現在城裡的人們幾乎沒有察覺異樣，但若非旅行者破壞了「花神誕祭的輪迴」，或許事態真的會很嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130155
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130155,
					"content": "我試圖在虛空中調查過，可虛空中沒有任何可疑資料，關鍵人員也似乎刻意沒有佩戴虛空終端…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130156
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130156,
					"content": "我想他們應該故意在掩蓋些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130157
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130157,
					"content": "這讓我想起，在化城郭的時候，有位賢者來邀請提納里參加某項「工程」…難道說就是那個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130158,
					"content": "總之，必須優先查明賢者們的意圖，進行糾正與懲罰…但也當心不要打草驚蛇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130159,
						30130169
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130159,
					"content": "人們沒有發現虛空的問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130160
					]
				},
				{
					"id": 30130160,
					"content": "妳是說使用虛空導致不再做夢的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130161
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130161,
					"content": "對呀，這麼長時間以來，沒有人覺得不對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130162,
					"content": "不是察覺不到，而是沒有人在意。其實根源還是在於賢者們的「誤導」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130163
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130163,
					"content": "「誤導」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130164,
					"content": "賢者讓人們以為不會做夢是理性與智慧的體現，須彌人不會做夢是須彌人的榮耀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130165
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130165,
					"content": "…但實際上，夢境只是被虛空「收割」走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130166
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130166,
					"content": "賢者們也因此可以最大化地利用虛空，使過往的那些研究能夠更加順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130175
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130175,
					"content": "況且大慈樹王當年創造虛空，也一定希望它可以物盡其用吧，所以我並未對這件事有很大意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130167
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130167,
					"content": "如此一來，賢者們宣揚的主流觀點便淹沒了質疑的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130168
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130168,
					"content": "甚至那些從來不用虛空終端，並且會做夢的須彌人，也只會認為這是一種不好意思說出口的恥辱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130169
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130169,
					"content": "沒什麼問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130170
					]
				},
				{
					"id": 30130170,
					"content": "#這樣嗎？但願我的回答，可以讓作為「求知者」的{F#妳}{M#你}們滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130171
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130171,
					"content": "其實之前維持迪娜澤黛即將消失的夢境的時候，對我精神力的耗損非常大…我恐怕需要小憩一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130172
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130172,
					"content": "這段時間裡倒不怎麼需要擔心賢者們的行動，像「花神誕祭的輪迴」這種大工程，短時間內虛空不可能進行兩次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130173
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130173,
					"content": "嗯，妳去睡覺吧，有我們看著呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130174,
					"content": "呵呵，真令人安心。哈——…這可真是我出生以來最累人的一次生日了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130301
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130301,
					"content": "#唔…旅行者？派蒙？我為什麼會在這裡，{F#妳}{M#你}們有什麼頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130302
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130302,
					"content": "呃…可能是夢遊？妳知道，不能叫醒夢遊的人的，所以我們只是…只是路過在這裡等妳醒來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130303,
					"content": "#是這樣啊，嗯…有空該找找維護人員了。啊，我沒事，等等我就回去了，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 30130110,
					"content": "可真是奇蹟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				}
			]
		},
