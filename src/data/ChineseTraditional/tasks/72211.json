			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "是汝啊，來得正好。正好奴家有事情要人幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110802,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "多虧了汝，現在神社也比以前好了。很快很快就會有很多很多人來神社了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110804,
					"content": "奴家叮囑小傢伙們，到時候可不能像現在這樣，一定要在人類面前保持風度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110805,
					"content": "但牠們已經瘋習慣了，不愛聽奴家的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110806,
					"content": "不過奴家想到了一個辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110807,
					"content": "辦法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "奴家還很小很小的時候，也喜歡到處玩。那時候，阿響為了讓奴家和別的貓乖乖聽話，會做很好吃的飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110809,
					"content": "好、好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110810,
					"content": "那時候呀，只要那鍋飯一端出來，貓們馬上就會從樹上、屋頂上下來。就算飯好燙好燙、舌頭好熱好熱，也忍不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110811,
					"content": "阿響每次都會做好大一鍋，分給貓和人類一起吃，來神社的人也有份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110812,
					"content": "不過，百目鬼的食量可大了，每次吃好多好多。不像奴家這樣有風度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110813,
					"content": "所以說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "不錯，很有悟性嘛。奴家要請汝等做飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110816,
					"content": "我不是懷疑寢子的智慧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "不過寢子真的知道飯要怎麼做嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110818,
					"content": "喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110819,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "這、這種東西，就交給汝等想辦法了！難道什麼都要奴家自己做嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110821,
					"content": "哎呀，不過那個飯，真是太好吃了哪。那個味道，就算走了好遠好遠、過了好久好久，都可以聞到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110822,
					"content": "#{NICKNAME}，我覺得我們還是應該努力一下！畢竟，為了神社嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110823,
					"content": "飯裡有什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "奴家當然記得。有魚的肉、動物的肉、水裡長的草，還有白米。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110827,
					"content": "唔，就是魚肉、獸肉、海草和稻米對吧…怎麼做的還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110828,
					"content": "不記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110829,
					"content": "看來得找個廚師問問。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "但是，哪個廚師會做貓飯呢…不如我們去問問大祐和悅子吧，他們說不定知道要怎麼辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110831,
					"content": "去找那兩個冒險家問問看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "對喔，大祐和悅子是冒險家，說不定他們會知道些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110824,
					"content": "派蒙真好懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "什麼嘛，我可是熱心助貓！寢子，飯裡有什麼材料，還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110814,
					"content": "我們幫妳做飯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
