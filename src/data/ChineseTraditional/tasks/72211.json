			"trigger": {
				"objectNames": [
					"大祐",
					"悅子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "悅子小姐，我們接著去哪裡探索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110102,
					"content": "呼…先歇一歇吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110103,
					"content": "#嗯？是{F#妳}{M#你}們啊，{F#妳}{M#你}們找我們有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110104,
					"content": "關於可靠的廚師…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "在清籟島的地方找廚師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110106,
					"content": "事情是這樣的。寢子她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110107,
					"content": "#{F#妳}{M#你}說…寢子大人拜託{F#妳}{M#你}們幫忙準備食物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110108,
					"content": "啊…可惡！要是我有烹飪的才能就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110109,
					"content": "#這麼說，{F#妳}{M#你}們是想要找一個能幫{F#妳}{M#你}們搞明白…「怎麼用這些食材，做出貓會喜歡的飯」的廚師，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110110,
					"content": "我想想…廚師…廚師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110111,
					"content": "喔，你們不如去稻妻城，去找「木南料亭」的木南杏奈小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110112,
					"content": "#木南小姐人很好，廚藝也很不錯，應該能幫{F#妳}{M#你}們這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110113,
					"content": "謝謝，我們這就去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "不用謝，快點去吧，我和大祐還要繼續制訂探索計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110115,
					"content": "呵呵，希望這個神社真的可以熱鬧起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722110116,
					"content": "#這樣，也不枉{F#妳}{M#你}和那位寢子忙前忙後這麼長時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悅子"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
