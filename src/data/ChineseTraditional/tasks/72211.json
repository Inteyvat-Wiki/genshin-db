			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "#{F#妳}{M#你}好，歡迎光臨「木南料亭」，請問{F#妳}{M#你}們有什麼需要的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110203,
					"content": "關於寢子的飯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "「寢子」？這個名字，難不成是貓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110205,
					"content": "妳認識寢子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110206,
					"content": "哎呀，不是。我只是覺得，這個名字很適合貓呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110207,
					"content": "真是強大的直覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "先不說這些，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110209,
					"content": "#清籟島上…有一座淺瀨神社，神社裡有一隻會說話的貓？！那隻貓還拜託{F#妳}{M#你}們做一道菜給牠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110210,
					"content": "欸？欸！真的嗎？我從來都沒聽說過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110211,
					"content": "是、是真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "在清籟島上對吧？等有機會，我一定要自己去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110214,
					"content": "那個…寢子的飯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "啊…對哦，差點忘了正事…我想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110216,
					"content": "唔…貓也會喜歡的飯嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110217,
					"content": "很難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110219,
					"content": "很、很難嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "這是對「木南」家名的挑戰！我一定要克服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110221,
					"content": "用魚肉、獸肉、海草、稻米做出能讓貓趨之若鶩的美食，就交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110222,
					"content": "我、我也想吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110223,
					"content": "我也想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110226,
					"content": "#我先構思一下食譜，{F#妳}{M#你}們先幫我準備三份海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110227,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "#那就拜託{F#妳}{M#你}們了，只要三份海草就好，找到之後就拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110229,
					"content": "妳已經知道怎麼做了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "有了一點想法，但還沒有完全想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110231,
					"content": "#{F#妳}{M#你}先去幫我找三份海草過來吧，拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110224,
					"content": "那就交給妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "妳可以自己過去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
