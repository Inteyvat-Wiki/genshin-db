			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "#{F#妳}{M#你}好，歡迎光臨「木南料亭」，請問{F#妳}{M#你}們有什麼需要的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111102,
					"content": "#{F#妳}{M#你}好…哎呀，是神里小姐的朋友！快請進，有什麼我可以幫{F#妳}{M#你}們的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111103,
					"content": "關於寢子的飯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "「寢子」？這個名字，難不成是貓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111105,
					"content": "妳認識寢子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111106,
					"content": "哎呀，不是。我只是覺得，這個名字很適合貓呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111107,
					"content": "真是強大的直覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "先不說這些，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111109,
					"content": "#清籟島上…有一座淺瀨神社，神社裡有一隻會說話的貓？！那隻貓還拜託{F#妳}{M#你}們做一道菜給牠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111110,
					"content": "欸？欸！真的嗎？我從來都沒聽說過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111111,
					"content": "是、是真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "在清籟島上對吧？等有機會，我一定要自己去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111114,
					"content": "那個…寢子的飯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "啊…對哦，差點忘了正事…我想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111116,
					"content": "唔…貓也會喜歡的飯嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111117,
					"content": "很難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111118,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111119,
					"content": "很、很難嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "這是對「木南」家名的挑戰！我一定要克服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111121,
					"content": "用魚肉、獸肉、海草、稻米做出能讓貓趨之若鶩的美食，就交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111122,
					"content": "我、我也想吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722111123,
					"content": "我也想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111126,
					"content": "#我先構思一下食譜，{F#妳}{M#你}們先幫我準備三份海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111127,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "#那就拜託{F#妳}{M#你}們了，只要三份海草就好，找到之後就拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111129,
					"content": "妳已經知道怎麼做了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "有了一點想法，但還沒有完全想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111131,
					"content": "#{F#妳}{M#你}先去幫我找三份海草過來吧，拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111124,
					"content": "那就交給妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "妳可以自己過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "木南杏奈"
				}
			]
		}
