			},
			"dialogs": [
				{
					"id": 722110401,
					"content": "好香…汝等，做好飯了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110402,
					"content": "做好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "喵喵！真厲害，快給奴家嚐嚐看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110405,
					"content": "看起來，和阿響做的飯有些不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110406,
					"content": "應、應該很好吃的，我們先一起嚐嚐看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110407,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110408,
					"content": "……喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110409,
					"content": "（寢子是因為飯和「阿響」做得不一樣，不開心嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110410,
					"content": "很好吃，汝等，很可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110411,
					"content": "那就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "雖然，汝等做的飯，和阿響做的飯味道不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110413,
					"content": "但是，和汝等一起吃飯時的感覺，和之前奴家和阿響一起吃飯時的感覺，一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110414,
					"content": "人類啊，這是為什麼呢？汝等人類，難道會什麼妖法不成？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110415,
					"content": "很久沒人做飯給妳了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "…無論如何，謝謝汝等。好久沒吃過這樣好吃的飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110418,
					"content": "小傢伙們肯定會喜歡的。汝再跑一趟，把這飯帶給牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110419,
					"content": "既然奴家喜歡，那牠們肯定會喜歡。然後，吃了這麼好吃的飯，一定也會願意聽奴家的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110416,
					"content": "因為做的人很熱心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
