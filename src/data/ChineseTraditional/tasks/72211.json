			"dialogs": [
				{
					"id": 722110501,
					"content": "汝等已經把飯帶給那些小傢伙了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110502,
					"content": "都吃得很開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "是嗎？那樣就好了，喵喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110504,
					"content": "奴家已經很久沒有吃過這樣好吃的飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110505,
					"content": "喵喵喵…雖然奴家現在也不需要吃飯、不需要喝水了，但飯的滋味，真是讓奴家欲罷不能呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110506,
					"content": "有個小傢伙叫「阿飯」，就是因為奴家想要用世界上最好的東西給她起名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110507,
					"content": "阿響做的飯叫什麼名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "名字？飯還能有名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110509,
					"content": "這個飯叫「活力喵飯」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "名字好複雜。不過奴家不討厭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110511,
					"content": "…汝說得也對。畢竟，飯是好東西。好東西都應該有名字才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110512,
					"content": "喵喵，等阿響回來了，奴家再問她吧。然後，汝也可以做汝的飯給她吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110513,
					"content": "然後，她再做她的飯給汝吃。然後，奴家可以吃兩種不同的，又都很好吃的飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110514,
					"content": "所以說，奴家得把神社打理得更好。等她回來了，就一起吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722110515,
					"content": "謝謝。很好吃。喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
