			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "#太好了，{F#妳}{M#你}們稍等一下，我對於怎麼做這道菜…已經有思路了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110703,
					"content": "完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110704,
					"content": "聞著好香啊！唔唔，好想嚐嚐看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110705,
					"content": "名字就叫做…嗯…既然這道飯是給一隻會說話的貓做的，那這道飯就叫做「活力喵飯」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110706,
					"content": "#總之，這份飯{F#妳}{M#你}們拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110707,
					"content": "#對了，食譜我也抄一份給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110708,
					"content": "#太好了，那{NICKNAME}也能隨時給我做…做「喵飯」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110709,
					"content": "妳是貓嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "真沒禮貌！美食是全世界共通的，是我和寢子的共同語言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110711,
					"content": "對了！要感謝木南小姐才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722110713,
					"content": "不用謝啦，這道飯和食譜，就當做給那位寢子的禮物啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110714,
					"content": "等我有空了，一定會去那座「淺瀨神社」拜訪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110715,
					"content": "#好了，{F#妳}{M#你}們快回去吧，別讓寢子等急啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110712,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
