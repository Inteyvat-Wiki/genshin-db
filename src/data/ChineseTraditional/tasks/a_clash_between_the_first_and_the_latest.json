				]
			},
			"dialogs": [
				{
					"id": 745090101,
					"content": "#一段時間後，{F#妳}{M#你}與派蒙來到了「小小靈蕈大幻戲」的攤位前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745090102
					]
				},
				{
					"id": 745090102,
					"content": "#哦吼！「智巧勇武雙連星」，{F#妳}{M#你}們又來玩「小小靈蕈大幻戲」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090103
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090103,
					"content": "#昂吉安妮小姐接到了任務，先回執律庭去了，之後就由我來陪{F#妳}{M#你}們玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090104
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090104,
					"content": "左右加，妳回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090105,
					"content": "雖然之前見到海妮耶的時候，已經大大吃驚過一次了，但妳更誇張，我都覺得妳這套衣服都有點太有精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090106,
					"content": "有精神是好事，我的工作還有很多，幹勁不能早早用完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090107
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090107,
					"content": "要像揮舞斧子一樣，把難題一個一個都劈開，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090108,
						745090109
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090108,
					"content": "報社那邊的事忙得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				},
				{
					"id": 745090110,
					"content": "計畫正在穩步推進，這種新奇的活動能吸引不少目光，報社也不會放過大肆宣傳的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090111
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090111,
					"content": "雖然我們沒有拿到最重要的版面，但顯而易見，最近活動受歡迎的程度一直在上漲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090112
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090112,
					"content": "的確，這段時間來攤位試玩「小小靈蕈大幻戲」的普通市民在不斷增加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090113
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745090113,
					"content": "不少人開始討論，如何搭配「小小靈蕈」的隊伍，才能最快獲勝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090114
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745090114,
					"content": "#我也有聽說，大家都想找到「黃金流星」和「白銀伴星」，和{F#妳}{M#你}們好好較量一番，見識一下高手的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090115,
						745090116
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745090115,
					"content": "哈哈！大師不會隨便出手！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090117,
					"content": "#除非海妮耶和左右加親自出手，{F#妳}{M#你}們兩位老朋友已經非常瞭解我們的策略了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090118,
					"content": "我們之間的對局，才算是…技術含量最高的對局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090119,
					"content": "話都說到這份上了，我們是否也該友情切磋一下了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090120
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090120,
					"content": "#仔細一想，上次我們直接較量，還是在第一次「月蓮盃馴獸師大賽」的時候，我兩三下就被{F#妳}{M#你}們打垮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090121
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090121,
					"content": "#有點懷念呀…從那以後，我和海妮耶經歷了很多事，有了很多變化，{F#妳}{M#你}們一定也一樣吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090122
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090122,
					"content": "#但{F#妳}{M#你}們身上那股…清澈幹練的勇氣、無所畏懼的豪氣，還是像水晶一樣堅定、牢固！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090123,
					"content": "#單憑這一點來看，我們在籌備「靈蕈棋陣」後就決定跟著{F#妳}{M#你}混，真是選對老大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090124
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090124,
					"content": "左右加怎麼突然開始感慨了？這難道是…作家特有的狀態嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090125,
						745090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090125,
					"content": "我也很懷念開心的往事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090127,
					"content": "好！真是漂亮的臺詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090128
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090128,
					"content": "那就看好啦，作為遊戲的設計者之一，我可是準備了很強力的底牌的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090129
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090129,
					"content": "要用那個嗎，左右加？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090130
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745090130,
					"content": "#沒錯，我來暖暖場，就由海妮耶指揮強勁的對手，來和{F#妳}{M#你}們再次打出一場精彩的對決吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090131
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090131,
					"content": "那就請多關照了，「黃金流星」和「白銀伴星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090132,
						745090133
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745090132,
					"content": "好哦好哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090134,
					"content": "#時隔這麼久，{NICKNAME}又要和海妮耶較量一番…我也激動起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090135,
					"content": "不過這次是友好純粹的對局，要玩得開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745090133,
					"content": "開打開打！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090126,
					"content": "我們還能創造新的回憶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090116,
					"content": "哎呀！為什麼要急著挨打呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090109,
					"content": "活動的廣告投放還算順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				}
			]
		}
	]
}