					}
				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "妳好，崔斯梅姬斯圖斯女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950102,
					"content": "哦？能正確說出這個名字，看來我們有共同的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950103,
					"content": "有位哥倫比婭小姐向我推薦了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950104,
					"content": "那可是位難以預測的小姐呢，你們的相遇一定充滿驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950105,
					"content": "所言極是，我非常認同「難以預測」這個評價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950106,
					"content": "初次見面，我是萊歐斯利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950107,
					"content": "是了，駐守水下的公爵，很高興認識你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950108,
					"content": "沒想到偉大的魔女之一竟然聽說過我，真是榮幸之至。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950109,
					"content": "還是說，作為占星術士的崔斯梅姬斯圖斯女士已經預見了我的到來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950110,
					"content": "呵呵…既然我們都知曉彼此的身分，那就省去這些繁文縟節吧，稱呼我為芭比洛斯即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950111,
					"content": "那也請直接叫我萊歐斯利吧。現在並非公務時間，我也只是一個閒散的楓丹市民罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950112,
					"content": "剛剛路上正好碰到新鮮出爐的晶螺糕，聽說魔女們都喜歡圍著茶桌閒聊，如不嫌棄的話，請收下一份吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950113,
					"content": "哎呀，這的確是茶會上非常受歡迎的甜點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950114,
					"content": "在這裡停留許久，我為不少人送出了屬於他們的預言，倒是第一次先收到了禮物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950115,
					"content": "謝謝你，萊歐斯利先生，我會和艾莉絲她們分享的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950116,
					"content": "…我聽到了哦，芭比，必須給我留！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950117,
					"content": "不能像之前那樣因為我來晚了就讓尼可一聲不吭地把所有——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950118,
					"content": "咳咳！知道了知道了，這次一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950119,
					"content": "真是的，妳怎麼來得這麼巧，我還想在新朋友面前維持住魔女會的體面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950120,
					"content": "沒關係，有什麼不好，沒有規定說能力強大的人不能擁有活潑的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950121,
					"content": "正是如此！樂觀開朗可是我們魔女會的入會門檻之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950122,
					"content": "第一次聽說有這種門檻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950123,
					"content": "我剛剛想的！魔女會可是為世界帶來快樂的組織，我們自己當然要先樂觀開朗起來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950124,
					"content": "僅代表個人，我支持諸位隨心所欲地享受生活——當然，要在不違法亂紀的前提下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950125,
					"content": "你這個前提在艾莉絲面前不堪一擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950126,
					"content": "哎呀，那可真是令人擔憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950127,
					"content": "嘿，我還在這呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950128,
					"content": "放心放心，我還不至於非要在梅洛彼得堡的管理人面前胡鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950129,
					"content": "而且…就算退一步講，你那裡應該比西風騎士團的禁閉室要更寬敞一些吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950130,
					"content": "哈哈，難道一間禁閉室就能關住傳說中的魔女嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950131,
					"content": "艾莉絲女士甘願受罰，肯定是因為她為人謙和且守信啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950132,
					"content": "這話說得——真是太對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950133,
					"content": "停、停，萊歐斯利先生，請不要再助長她的氣焰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950134,
					"content": "一個心情愉悅的艾莉絲，可不一定會做出什麼事來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950135,
					"content": "深有體會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#對哦，說起來{NICKNAME}可是騎士團的榮譽騎士，那麼肯定是要維護禁閉室的尊嚴才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950138,
					"content": "由榮譽騎士來阻攔逃跑的魔女嗎？聽起來像是很不錯的話劇，請務必叫我圍觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950139,
					"content": "你也真是看熱鬧不嫌事大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950140,
					"content": "不過沒想到公爵已經提前過來了，省去了我們往水下跑一趟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950141,
					"content": "這就是占卜的力量吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "啊，說到這個，也該做些正事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950143,
					"content": "萊歐斯利先生，無論是看在哥倫比婭小姐的面上，還是作為茶會糕點的回禮，都請你抽取一張「月諭聖牌」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950144,
					"content": "或許命運的饋贈就暗藏其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950145,
					"content": "這算是一種預言嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950146,
					"content": "可以這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950147,
					"content": "那沒有楓丹人會不認真對待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950148,
					"content": "說是要「認真對待」，萊歐斯利直接拿起了最上面的一張牌…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "我對這種牌不甚瞭解，這似乎是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950150,
					"content": "是正位的「皇帝」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950151,
					"content": "您這樣欲言又止，難道是壞消息？請不必介意，直言相告就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950152,
					"content": "不，恰恰相反，這張牌意味著永恆的統轄與難以撼動的權威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950153,
					"content": "如果這代表未來的路，那其實你早已抵達了目的地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950154,
					"content": "不過…呵呵呵，你的「命運」顯然還會滾滾向前，變化不止，那麼就意味著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950155,
					"content": "或許變化的不是人，而是環境？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950156,
					"content": "嗯…就目前而言，是有這種傾向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950157,
					"content": "那看來我可以對自己的直覺更加自信一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950158,
					"content": "之前我曾因公務拜訪挪德卡萊，長了不少見識，此後也不免注意了一些當地的新聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950159,
					"content": "而有那麼一個晚上，我看著格外明亮的月亮，不由得想，這個世界正在產生變化，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950160,
					"content": "正確的回答是：世間萬物每時每刻都在變化，而在巨大變量的介入後，我們都要做好迎接未知的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950161,
					"content": "不過從這張牌的結果來看，你似乎不用太過擔心。無論環境如何改變，你都將擁有適應它或與之對抗的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950162,
					"content": "那可真是皆大歡喜。看來那一拳沒有白挨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950163,
					"content": "是帶著美好祝願的一拳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "不過出於好奇，我有個相當冒昧的問題想要請教，不知能否直說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950166,
					"content": "真是狡猾，萊歐斯利先生這樣說就是在故意引起我們的好奇心嘛！這下就算你不說，我也偏要問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950167,
					"content": "那就恕我直言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950168,
					"content": "我一直很想知道，一個真正的預言究竟要如何保證它的實現？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950169,
					"content": "就以我為例，當下的占卜稱我會長期處於一個穩定的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950170,
					"content": "但如果我在得知了這個預言後叛逆心肆起，立即去做一些出格的事情，結果又會如何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950171,
					"content": "就比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950172,
					"content": "比如把梅洛彼得堡炸上天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "行，就這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950174,
					"content": "還惦記著這回事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950175,
					"content": "欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950176,
					"content": "不，你等會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950177,
					"content": "哈哈！真是巧了！我這邊正好有一位實力強勁的爆破專家可以介紹給你——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950178,
					"content": "而榮譽騎士會作為那位爆破專家的隨行監護人，在關鍵時刻阻攔一切壞事的發生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950179,
					"content": "…你看，預言就是這樣達成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950180,
					"content": "看來是位破壞力很強的專家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950181,
					"content": "而且非常可愛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "啊，是小可莉吧！公爵可能不知道，可莉是艾莉絲的女兒哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950183,
					"content": "不，正確地說，應當是「諸世界的大冒險家」、「很壞很壞的大魔王」、「舊蒙德的守護者」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950184,
					"content": "太長了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950185,
					"content": "…總之就是大魔王艾莉絲最可愛的孩子，名副其實的「火花騎士」——可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950186,
					"content": "唉，就應該按照原定的計畫，大家一起好好辦一場聚會，還能介紹你們認識呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950187,
					"content": "那樣等可莉去楓丹玩的時候，還能有新朋友一起開茶會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950188,
					"content": "聽起來是個不錯的計畫，我已經開始期待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950189,
					"content": "畢竟我是不會對一壺好茶說不的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 746950164,
					"content": "大難不死，必有後福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "還請對禁閉室保持敬畏之心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
