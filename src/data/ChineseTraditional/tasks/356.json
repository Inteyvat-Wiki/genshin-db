			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "容我正式介紹，風與蒲公英的牧歌之城，自由之都——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560102,
					"content": "受西風騎士團庇護的旅人們，歡迎來到蒙德城！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560103,
					"content": "終於不用在荒野露宿啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560104,
					"content": "不過城裡的大家…精神都不太好的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560105,
					"content": "因為最近全城都在煩惱風魔龍的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560106,
					"content": "但有琴在的話，一切都不會有問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560107,
					"content": "琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560108,
					"content": "西風騎士團代理團長——琴。蒙德的守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560109,
					"content": "與琴同在的我們，即使是風魔龍這種級別的災害，也一定能夠戰勝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560110,
					"content": "（看來是一位大人物…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#對了，在一起去騎士團總部之前，我有禮物要送給{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560113,
					"content": "是剛才幫我清理丘丘人營地的酬謝喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560114,
					"content": "見，見者有份！為什麼我沒有禮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560115,
					"content": "嗯…因為那是小派蒙沒辦法用的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560116,
					"content": "#但我今晚會請{F#妳}{M#你}吃蒙德特色的蜜醬胡蘿蔔煎肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560117,
					"content": "蜜醬胡蘿蔔煎肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560118,
					"content": "現在就先跟我來吧，我們要去城區的…<color=#00E1FFFF>高處</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560111,
					"content": "（希望她能知道關於風神的事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
			"completionStepIds": [
				35604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35604",
							"2"
						],
						"stepId": 35604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "那麼，說好的禮物就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560402,
					"content": "<color=#00E1FFFF>風之翼</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560403,
					"content": "偵察騎士靠它在天空中行動，蒙德的市民們也很喜歡用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560404,
					"content": "#我特地把{F#妳}{M#你}叫來這裡，就是為了讓{F#妳}{M#你}第一時間感受到它的好處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560405,
					"content": "是正在熱心推薦的語氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3560406,
					"content": "因為「風」是蒙德的靈魂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560407,
					"content": "好了，趕快來試試風之翼的性能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3560408,
					"content": "#雖然操作起來很簡單，但{F#妳}{M#你}一定要聽我指示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		}
	]
}