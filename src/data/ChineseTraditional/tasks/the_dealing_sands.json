			"dialogs": [
				{
					"id": 711160601,
					"content": "兩位豪俠！多謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160602,
					"content": "不用謝不用謝！不管在哪裡交易，都要遵守契約才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160603,
					"content": "呵呵，這位小豪俠說的是。不過這樣看，兩位似乎對我們的交易很清楚嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160604,
					"content": "#是鐵豆兒告訴我們的啦，她說{F#妳}{M#你}們在這裡走砂什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160605,
					"content": "不過走砂是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160606,
					"content": "好像不是什麼正規的交易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "既然這樣，那我必須得要好好感謝兩位豪俠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160608,
					"content": "#來人！把{F#她}{M#他}們綁好了，丟去海裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160609,
					"content": "#記得多綁幾塊石頭，這兩位對我們鐵鹽幫有恩，別叫{F#她}{M#他}們多遭了罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160610,
					"content": "什麼？！你…你要對我們做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160611,
					"content": "這位小豪俠，妳剛才不是還很明白嗎？璃月是講究契約的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160612,
					"content": "撞破了非法團夥的交易，自然就會被滅口，這不是人盡皆知的契約嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160613,
					"content": "哪有這種契約啊！你這種恩將仇報才是不講契約！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160614,
					"content": "#不要白白浪費我的好意，等我親自動手，{F#妳}{M#你}們就有苦頭吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160615,
					"content": "你知道我是誰嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "少廢話！鐵豆兒！鐵船兒！還不動手？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160618,
					"content": "鐵明老大，你果然還是這麼不仁不義啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "鐵船兒"
				},
				{
					"id": 711160619,
					"content": "也不枉我們費一番功夫，絕對不能再放你這樣的人在璃月為非作歹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160626,
					"content": "收網！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160620,
					"content": "什…什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160621,
					"content": "賊人鐵明！睜大你的眼睛再好好看看！我們是誰？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160622,
					"content": "千…千岩軍？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160623,
					"content": "喂喂！怎麼回事？！怎麼突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160624,
					"content": "我只當你們幾個是新上了跳板，沒想到是該死的鷹爪孫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160625,
					"content": "別以為我會束手就擒！我跟你們拼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160616,
					"content": "喔唷！我好怕怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
