			"dialogs": [
				{
					"id": 711160401,
					"content": "尊尼老大，你我朋友一場，我呢，也明白你們近來有難處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160402,
					"content": "有什麼問題當面和我商量就好，搞成這樣…未免有點傷感情了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160403,
					"content": "嘿，朋友…你知道，我們這邊的生意不同往常了。「刺玫會」近來得了勢，我們的兄弟頗有些成了乾貨，落了水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160404,
					"content": "小鳥兒們都還嗷嗷待哺呢。再這樣下去，我們恐怕連鳥嘴都沾不濕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160405,
					"content": "我們的生意很好，很合理，如果多給我們一點…將來感謝的機會，我想朋友們會更能體會到我的誠意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160406,
					"content": "不然…哈哈，大海這樣廣闊，鐵明先生，你們也不是不好找到新朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160407,
					"content": "這樣說，尊尼老大，這個報價，就是你的意思了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160408,
					"content": "這樣的價格有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160409,
					"content": "楓丹佬！招子放亮點！這點錢打發誰呢？！放那麼多的屁幹什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "鐵船兒"
				},
				{
					"id": 711160410,
					"content": "多嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160411,
					"content": "尊尼老大，我的貨賣給唐佩西家族，一箱五萬八。賣給德尼祿家族，一箱七萬。他們都是柔燈港地下響噹噹的幫會，這不必我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160412,
					"content": "我的貨賣給你，三箱只要十萬，專人接，專人送…為什麼？為的是珍惜你這個朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160413,
					"content": "大道理我就不多說了…我相信尊尼老大還是欠考慮了！我們找個地方喝一杯，再聊聊怎麼樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160414,
					"content": "呵呵，沒那個必要。我知道璃月人最講究契約，契約最在乎公平。可沒聽說過情理能大於公平的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160415,
					"content": "呵呵，尊尼老大！如此注重契約精神，我的小弟們也該多多向你學習，哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160416,
					"content": "只不過，在這件事上，我要首先看到你們對契約的尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160417,
					"content": "當然，當然！您的話再有道理不過了，璃月的古老契約真是令人崇敬，看來我必須要展示一下我的敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160418,
					"content": "沃克，你覺得給每件貨的報價再提高…一摩拉，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160419,
					"content": "十分恰當，尊尼先生。這些璃月人如此辛勞，理應再獲得每件貨一摩拉的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160420,
					"content": "楓丹佬！你們到底什麼意思？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "鐵船兒"
				},
				{
					"id": 711160421,
					"content": "朋友，你們還感受不到這份遠道而來的誠意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160422,
					"content": "尊尼老大，你們這是執意要違背約定了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160423,
					"content": "哦？是嗎？沃克，你覺得是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160424,
					"content": "尊尼先生，若您問我的意思…大海如此廣闊，是蝦米就該有點自知之明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160425,
					"content": "沃克，我為你羞愧，你怎能如此侮辱我們的璃月朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160426,
					"content": "畢竟稍後就要收下他們的地盤，我們不該心懷感恩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160427,
					"content": "對不起，尊尼先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160428,
					"content": "你們！混帳東西！你們居然打著這個主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "鐵船兒"
				},
				{
					"id": 711160429,
					"content": "怎麼還開始罵人了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "哦？這兩位小朋友是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160431,
					"content": "呵呵，可真是有趣啊，璃月的小朋友都這麼有膽色嗎？沃克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160432,
					"content": "#喂！哪來的小鬼，賞{F#妳}{M#你}們點摩拉，趕緊滾去買奶喝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160433,
					"content": "你！你們這些人也太沒禮貌了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160434,
					"content": "#{F#妳}{M#你}們兩位是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160435,
					"content": "我們是來吃香喝辣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "#哈哈哈哈！這樣說來…{F#妳}{M#你}們是鐵明先生請來的幫手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160438,
					"content": "原來鐵明先生也早就對我們有想法了啊？哼，我們也不是毫無準備。沃克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160439,
					"content": "出來吧！兄弟們！到時候了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160440,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "鐵船兒"
				},
				{
					"id": 711160441,
					"content": "哎呀，哎呀，怎麼回事？好像還是我們的人比較多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160442,
					"content": "鐵明先生，真遺憾，我事先給手下安排了一些活，現在您留在營地的人，應該已經被清理乾淨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160443,
					"content": "請安心地去吧，您的生意我們會好好打理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160444,
					"content": "尊尼老大…想淌我們鐵鹽幫的線，沒那麼簡單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "鐵明"
				},
				{
					"id": 711160445,
					"content": "希望您的命和嘴一樣硬，動手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160436,
					"content": "我們是來送某些人回家喝奶的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
