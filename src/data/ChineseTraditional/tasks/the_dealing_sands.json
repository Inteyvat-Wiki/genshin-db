				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "合字上的朋友，大恩不講謝，有什麼需要的，招呼一聲就成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160203,
					"content": "喔！妳這個人還怪客氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160204,
					"content": "那我就直說了，最近手頭有點緊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "需要摩拉？哈哈，這倒是好說。就是辦起來還有點小小地麻煩——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160206,
					"content": "俺們的摩拉，全被瓢把子帶走了。現在這土窩已經成黃草窯子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160210,
					"content": "瓢把子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "就是俺們鐵鹽幫的老大，他在那邊的山崖底下，跟一夥楓丹佬走砂，留下俺們守著窩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160212,
					"content": "但是剛剛朋友也瞧見了吧？那些楓丹皮娃子，居然趁著瓢把子在談事，偷偷摸了來，捅屁股！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160213,
					"content": "嗚哇…捅屁股…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160214,
					"content": "嗚哇…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "好崽子，這是把俺們當羊牯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160216,
					"content": "現在這邊水漫了，瓢把子指不定也要吃暗青子。好朋友，話說幫人幫到底，還請再幫俺們一把？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160217,
					"content": "#若瓢把子沒事，保準有{F#妳}{M#你}們吃香喝辣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160218,
					"content": "在哪裡？我先去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "#就在那邊山崖底下的海灘，{F#妳}{M#你}們過去指定能瞧見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160220,
					"content": "#兩位朋友，託{F#妳}{M#你}們先走一步，俺收拾收拾就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160207,
					"content": "路見不平，拔刀相助而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "義薄雲天！義薄雲天啊！既然這樣，兩位朋友，俺正好有個事想說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "鐵豆兒"
				},
				{
					"id": 711160209,
					"content": "俺覺得瓢把子那邊，搞不好也得遭事，得去幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "鐵豆兒"
				}
			]
		},
