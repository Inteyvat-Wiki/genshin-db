			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法拉比",
					"埃德蒙德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736790101,
					"content": "#旅行者，{F#妳}{M#你}們來了。呼…這下總算可以放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790102
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790102,
					"content": "哇，埃德蒙德先生，法拉比，你們怎麼突然跑到雪山裡來了呀。收到你們的消息說在這裡集合時，我真是嚇了一大跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790103,
					"content": "哈哈，這件事確實有點突然，不過既然出現了「意想不到的研究目標」，怎麼說也不能放棄這個機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790104
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790104,
					"content": "「意想不到的研究目標」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790105,
					"content": "對。埃德蒙德先生說，他曾經在雪山腳下看到過巨大的動物蹄印。經過這兩天的搜尋，我們終於在這附近發現了同樣的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790106
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790106,
					"content": "旅行者，我能確定，這裡絕對生活著一頭巨大的雪豬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790107
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790107,
					"content": "如果能夠得到牠的毛髮和血液樣本，對於弄清雪豬種群的生存情況、雪豬出現在山下的原因，一定會有很大幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790108
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790108,
					"content": "所以說，我們今天的目標，是狩獵那頭巨大的雪豬嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790109,
					"content": "不，並不是狩獵。其實在我們獵人的傳說裡，巨大的雪豬是真正的龍脊雪山之主，是不能隨便狩獵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790110
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790110,
					"content": "不過如果只是出於研究目的，稍微困住牠一下下，應該沒關係吧？法拉比老弟，你可要好好做啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790111
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790111,
					"content": "嗯，你們放心吧。其實，最近我瞭解到蒙德一到豐收季總會遭到野林豬侵擾的情況之後，也想了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790112
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790112,
					"content": "我覺得，說不定自己能在野林豬這個研究方向繼續鑽研下去，幫大家找到解決之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790113
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790113,
					"content": "畢竟我們研究生物的一個重要目的，就是為了跟牠們和諧共處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790114
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790114,
					"content": "嘻嘻，感覺你的這趟佳釀節之旅，收穫了不少東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736790115,
					"content": "是啊，不僅嚐到了美酒，還得到了熱心的朋友和奮鬥的目標。不過感慨的話，還是等到我們下山之後再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790116
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790116,
					"content": "#旅行者，看那頭雪豬的足跡大小，我恐怕也不是牠的對手，等一下這裡，就只能交給{F#妳}{M#你}這樣的專業人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790117
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790117,
					"content": "#不過{F#妳}{M#你}放心吧，我已經把吸引牠的誘餌和捕獵裝置都佈置好了，應該能幫上一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790118
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736790118,
					"content": "嗯，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790119
					]
				},
				{
					"id": 736790119,
					"content": "#旅行者，如果{F#妳}{M#你}準備好了的話，我就要點燃誘餌，吸引大雪豬過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736790120,
						736790121
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736790120,
					"content": "我準備好了，大雪豬！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736790121,
					"content": "等一下，我還需要做點準備。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736790122
					]
				},
				{
					"id": 736790122,
					"content": "#沒關係，{F#妳}{M#你}可以慢慢來，畢竟我們要對付的是那個大傢伙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法拉比"
				}
			]
		}
	]
}