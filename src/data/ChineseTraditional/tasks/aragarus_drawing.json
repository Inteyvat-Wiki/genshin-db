			},
			"dialogs": [
				{
					"id": 730580401,
					"content": "去看看壞蛋那菈的營地吧！一定能知道他們是來做什麼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580402,
					"content": "你是怎麼分辨壞蛋的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#唔…不知道，說不清楚！但是我知道，那菈{NICKNAME}和白飛飛一定不是壞人！蘭迦魯相信！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				}
			]
