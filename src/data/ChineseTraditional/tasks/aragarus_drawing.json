			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭迦魯",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#金色的那菈，白色的飛飛！又見到{F#妳}{M#你}們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580102,
					"content": "嗚哇，下次突然出現請打聲招呼啦！又嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580103,
					"content": "我們不是壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#哼…{F#妳}{M#你}們說的有道理啦…所以，看起來不像壞蛋的金色那菈和白飛飛，可以再幫我一個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580106,
					"content": "#樂意效勞，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "我是派蒙，這次可別忘啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580108,
					"content": "這次…？呃…咳咳，我是蘭迦魯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580109,
					"content": "#我們和你一起來過這裡喔，但是你忘記啦…唔，好難解釋！{NICKNAME}，我們一起講給他聽吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580110,
					"content": "你們具言了與蘭迦魯冒險的所見所聞。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "#這樣嗎…雖然我不記得了，但不知為什麼，我願意相信{F#妳}{M#你}們…而且{F#妳}{M#你}們有我送的花，我能感知到她在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580112,
					"content": "啊，對了！壞蛋那菈留下了營地，我們去找找看他們留下了什麼東西，說不定能知道他們在盤算什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580104,
					"content": "我們幫你打跑了壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
