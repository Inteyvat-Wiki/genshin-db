			"trigger": {
				"objectNames": [
					"蘭迦魯",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "怎麼樣，有發現什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580202,
					"content": "唔…只發現了語焉不詳的命令，還有這個！一朵風乾的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580203,
					"content": "欸…！這個，可以給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580204,
					"content": "這個是壞人留下的，你就不怕有毒…什麼的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580205,
					"content": "#不需要擔心，我見過這朵花…那個人，我應該見過…請{F#妳}{M#你}交給我，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580206,
					"content": "請你拿去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#謝謝{F#妳}{M#你}！那菈{NICKNAME}和白飛飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730580208,
					"content": "蘭迦魯將風乾的小花帶去了無郁稠林…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
