			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120401,
					"content": "#{NICKNAME}！{F#妳}{M#你}好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120402,
					"content": "#很感謝{F#妳}{M#你}能陪我一起去冒險，關於我父母的事…謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120403,
					"content": "請不用這麼客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "#嘿嘿，如果不是芭別爾主母還委託了其他任務，我就也陪{F#妳}{M#你}一起去沙漠裡探險啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120405,
					"content": "#我還知道好多好玩的地方，等我有時間就帶{F#妳}{M#你}們一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732120406,
					"content": "不過現在怕是不方便了，那些勾結北方人的叛徒一直在覬覦著我們的領地，我還要偵察他們的動向才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
