			},
			"dialogs": [
				{
					"id": 732121701,
					"content": "#{F#妳}{M#你}好，尊貴的鎮靈主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121702
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121702,
					"content": "#關於{F#妳}{M#你}們上次遇襲的事情，我還正在追查，請{F#妳}{M#你}們一定放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121703
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121703,
					"content": "#我保證{F#妳}{M#你}們在塔尼特部族內的安全，但如果進入沙漠…還請萬分小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121704,
						732121711,
						732121714,
						732121721
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121704,
					"content": "關於「永恆綠洲」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121705
					]
				},
				{
					"id": 732121705,
					"content": "#請容我代表塔尼特部族再次感謝{F#妳}{M#你}們和婕德的付出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121706
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121706,
					"content": "「永恆綠洲」不僅對那孩子有重要的意義，對於塔尼特部族，它也是信仰的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121707
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121707,
					"content": "擁有它，就是擁有了「綠洲女王」娜布·瑪莉卡塔的王座…對於曾屬於她的子民之後代來說，意義重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121708
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121708,
					"content": "我不太明白…它究竟有什麼價值？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121709
					]
				},
				{
					"id": 732121709,
					"content": "哈哈，毫無價值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121710
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121710,
					"content": "…價值非凡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121711,
					"content": "婕德最近很忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121712
					]
				},
				{
					"id": 732121712,
					"content": "是啊，既然我們已經控制了「永恆綠洲」，就要阻止其他懷有非分之想的傢伙靠近。塔尼特如今是「永恆綠洲」的衛士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121713
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121713,
					"content": "而最適合完成這等任務的，我想是婕德無疑了。她也是在守護自己的父母，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121714,
					"content": "關於叛徒們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121715
					]
				},
				{
					"id": 732121715,
					"content": "我猜是因為我們打開了通往「永恆綠洲」的道路，那些叛徒們才又開始蠢蠢欲動起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121716
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121716,
					"content": "我們的女神，對於他們來說是至高權力的標誌，也能給他們帶來無數財源…我無法容忍這種褻瀆，不論她是睡著，還是醒著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121717,
						732121719
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121717,
					"content": "妳還相信她會醒來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121718
					]
				},
				{
					"id": 732121718,
					"content": "我當然相信…或早或晚，她會重聚神形，她會引導我們進入花的國度。但在那之前，我…塔尼特會代她的意志行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121719,
					"content": "我們去過了，她不在那裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121720
					]
				},
				{
					"id": 732121720,
					"content": "#她「在」那裡，{F#妳}{M#你}們只是沒「看到」。但她「在」，她永遠都「在」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121721,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121722
					]
				},
				{
					"id": 732121722,
					"content": "保重，尊貴的「鎮靈主人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				}
			]
		}
	]
}