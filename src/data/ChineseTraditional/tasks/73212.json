			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"尤夫騰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120101,
					"content": "啊，「鎮靈主人」，您、您、您來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120102
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120102,
					"content": "我正好有一件事要拜託您，一件、一件…急事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120103,
						732120105
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120103,
					"content": "請別著急，我在聽著。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120104
					]
				},
				{
					"id": 732120104,
					"content": "嗯嗯，你慢慢說，我們會幫忙的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120107,
					"content": "是我的一批、一批、一批貨物…丟失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120108
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120108,
					"content": "居然丟了三批貨物呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120109,
					"content": "不，是一、一、一批…貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120110
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120110,
					"content": "外人運進來的「豐沃之惠」，已經很、很久了，但沒、沒有到貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120111
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120111,
					"content": "可能是那些北、北方人搞的鬼…因為芭別爾主母一直在針對他們，搜、搜捕叛徒什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120112
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120112,
					"content": "自從、自從阿德菲和阿薩里格不在了以後…他們的活動也多起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120113
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120113,
					"content": "好、好了，不多說別、別的閒話。運送「豐沃之惠」的商隊最後是在、在這片區域被哨兵發現的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120114
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120114,
					"content": "希望您能幫助我找、找、找到貨物，或者至少、至少、至少…將商隊留下的線索告知我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120115
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120115,
					"content": "好的，我會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120116
					]
				},
				{
					"id": 732120116,
					"content": "商隊自己就不見了？聽起來是被壞傢伙搶劫了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120117,
					"content": "十分、十分、十分感謝，這些肉請您收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120118
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120118,
					"content": "你太客氣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120105,
					"content": "有什麼事情需要我幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120106
					]
				},
				{
					"id": 732120106,
					"content": "慢慢說啦，不要著急！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
