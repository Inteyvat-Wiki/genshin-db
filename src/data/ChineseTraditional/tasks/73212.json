			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尤夫騰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121001,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}、{F#妳}{M#你}們回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121002
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121002,
					"content": "怎麼啦，我們能回來很奇怪嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121003,
					"content": "#不、不、沒有，很高興{F#妳}{M#你}們能回來，尊、尊貴的「鎮靈主人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121004
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121004,
					"content": "#對、對了，關、關、關、關於商隊的事情…{F#妳}{M#你}們調查得如何了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121005
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121005,
					"content": "商隊遭到了伏擊，貨物被洗劫了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121006
					]
				},
				{
					"id": 732121006,
					"content": "可惡！可惡！又是那群叛徒搞的鬼！一、一定、一定是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121007
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121007,
					"content": "叛徒…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121008,
					"content": "叛、叛、叛徒，和北方人勾結的狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121009
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121009,
					"content": "#除了、除了這個，{F#妳}{M#你}、{F#妳}{M#你}、{F#妳}{M#你}們還發現了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121010
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121010,
					"content": "我們遭到了鍍金旅團的襲擊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121011
					]
				},
				{
					"id": 732121011,
					"content": "嗯，我們剛調查完商隊，就被突然出現的鍍金旅團壞傢伙襲擊了！他們還說是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121012,
					"content": "他們還說他們認識我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121013
					]
				},
				{
					"id": 732121013,
					"content": "呃…對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121014,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121015
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121015,
					"content": "果、果、果然如此…他們也盯上了您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121016
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121016,
					"content": "這裡是您的報、報、報酬。請、請快點去和芭別爾主母說說這件事吧，事、事、事不宜遲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121017
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732121017,
					"content": "好、好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121018
					]
				},
				{
					"id": 732121018,
					"content": "再、再見。尊貴的「鎮靈主人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尤夫騰"
				}
			]
		},
		{
			"id": 7321211,
			"completionStepIds": [
				7321211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321211",
							"2"
						],
						"stepId": 7321211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭別爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121101,
					"content": "#{F#妳}{M#你}來了，尊貴的「鎮靈主人」，請問有什麼急事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121102
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121102,
					"content": "尤夫騰的商隊被「叛徒」洗劫了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121103
					]
				},
				{
					"id": 732121103,
					"content": "這樣嗎…這並不奇怪，因為從雪國而來的北方人一直在滲透我們的領地，許多叛徒聽信了他們的誘惑，轉而與我們為敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121104
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121104,
					"content": "這些人一直在作亂，零星的劫掠事件時有發生，從幾個月前就是如此了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121105
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121105,
					"content": "#呃…抱歉，我沒想故意打斷{F#妳}{M#你}，請{F#妳}{M#你}繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121106
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121106,
					"content": "那些「叛徒」也盯上了我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121107
					]
				},
				{
					"id": 732121107,
					"content": "嗯，我們剛調查完商隊，鍍金旅團壞傢伙就突然出現，襲擊了我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121108,
					"content": "這樣嗎…可惡啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121109
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121109,
					"content": "看起來…即使失去了阿德菲和阿薩里格，這群野狗依然敢對我們吐露獠牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121110
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121110,
					"content": "#這樣吧，請{F#妳}{M#你}們先留在這裡休息壓驚，{F#妳}{M#你}們的安全保護工作我會親自負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121111
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121111,
					"content": "#婕德還在外面執行部族的任務，待她回來，我會委託她同{F#妳}{M#你}一起調查此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121112
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121112,
					"content": "#而在這之前，我會負責全力追查襲擊{F#妳}{M#你}們的凶手…請{F#妳}{M#你}們寬心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121113
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121113,
					"content": "唔…還有還有！攔截我們的那群壞東西似乎認識我們！他們可能是部族裡的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121114,
					"content": "#不是沒有可能…但沒關係，{F#妳}{M#你}們受賓客權利保護…只要還在這裡，就沒有人會傷害{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121115
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121115,
					"content": "#如果有人試圖在塔尼特部族內為難{F#妳}{M#你}們，無論那人是誰，我都會以主母的身分追究到底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121116
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121116,
					"content": "#請{F#妳}{M#你}休息一下吧，關於叛徒的事件，我會全力追查的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121117
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121117,
					"content": "#另外，我也會替{F#妳}{M#你}留意婕德的，等她回來就第一時間通知{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121118
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732121118,
					"content": "嗯嗯，那就謝謝妳啦，芭別爾主母！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732121119,
					"content": "請不必客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				}
			]
		},
