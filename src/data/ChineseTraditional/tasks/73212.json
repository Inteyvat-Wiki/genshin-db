			"dialogs": [
				{
					"id": 732120301,
					"content": "怎麼，有、有、有何進展？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120302
					],
					"speakerTitle": "尤夫騰"
				},
				{
					"id": 732120302,
					"content": "我們還在調查失蹤的商隊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120303
					]
				},
				{
					"id": 732120303,
					"content": "請、請、請盡快調查吧，我請求您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尤夫騰"
				}
			]
		},
		{
