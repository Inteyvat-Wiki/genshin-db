			"dialogs": [
				{
					"id": 732120501,
					"content": "（一個破損的空罐，尚未完全被沙子掩埋。看起來它是在不久前被人丟棄的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "調查"
				},
				{
					"id": 732120502,
					"content": "#{F#妳}{M#你}看！這個罐子還沒有被沙子掩埋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120503,
					"content": "物資散落在商道上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "看起來很不妙呢…說不定他們順路還遺落了其他東西，我們再往前找找看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120505,
					"content": "我們再順路尋找一番吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "嗯…他們應該還沿途丟棄了其他東西，我們繼續往前走走看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
