			"dialogs": [
				{
					"id": 732120901,
					"content": "嗚…好險！還好我們超能打，三下五除二就…就把他們全解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120902,
					"content": "謝謝「招待」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120903
					]
				},
				{
					"id": 732120903,
					"content": "為什麼每個壞蛋都喜歡招惹我們！是因為我們看起來很好欺負嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120904,
					"content": "他們自稱是婕德指使的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120905
					]
				},
				{
					"id": 732120905,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120906,
					"content": "#{F#妳}{M#你}相信他們說的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120907,
					"content": "我不相信婕德有理由做這樣的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120908
					]
				},
				{
					"id": 732120908,
					"content": "但肯定她被捲入了某個更大的陰謀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120909
					]
				},
				{
					"id": 732120909,
					"content": "唔…我也相信婕德是不會做這種事的…不過，現在我們怎麼辦呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120910,
					"content": "襲擊我們的人認識婕德，也就是說在塔尼特部族裡一定也有他們的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120911,
					"content": "這樣的話，我們回到部族就很有可能會被他們盯上，他們一定是不會善罷甘休的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120912,
					"content": "而且婕德…我也不願意懷疑她啦，但…既然想要謀害我們的人就在塔尼特部族裡，我們不如先走為上策吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120913,
					"content": "我們離開的話，婕德可能會有危險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120914
					]
				},
				{
					"id": 732120914,
					"content": "唔，也對呢…我們不能拋下她不管呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120915,
					"content": "我們先回去，但不要提及婕德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120916
					]
				},
				{
					"id": 732120916,
					"content": "欸…？可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120917,
					"content": "#哼…我才沒有害怕呢！既然{F#妳}{M#你}這樣決定了，那就這樣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
