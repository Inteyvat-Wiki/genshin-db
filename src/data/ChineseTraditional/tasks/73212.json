			"dialogs": [
				{
					"id": 732120801,
					"content": "（一卷完好的毛毯，其上縫製著塔尼特部族的標誌，沾染著點點不祥的汙跡…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120802
					],
					"speakerTitle": "調查"
				},
				{
					"id": 732120802,
					"content": "這卷毛毯…真奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "唔…昂貴的毛毯，為什麼會被丟在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120804,
					"content": "或許是因為發生了搶奪和打鬥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120805
					]
				},
				{
					"id": 732120805,
					"content": "嗯…有道理哦…這樣的話，就能說明白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120806,
					"content": "商隊和劫匪在這裡發生了打鬥，一些物資在打鬥過程中被破壞掉了，還有一些完好的物資沒有顧得上整理就被丟棄掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120807,
					"content": "派蒙的推理很可靠呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120808
					]
				},
				{
					"id": 732120808,
					"content": "哼哼！畢竟是我派蒙嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120809,
					"content": "於是，商隊和劫匪一路打、一路跑！一路打、一路跑！一路打、一路跑…所以路上會散落著破碎的箱子和罐子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120810,
					"content": "嗯，這樣就能說得通啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120811,
					"content": "完全說不通吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120812
					]
				},
				{
					"id": 732120812,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120813,
						732120814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120813,
					"content": "那些垃圾應該是劫匪得手後丟棄的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				},
				{
					"id": 732120815,
					"content": "這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120816,
					"content": "因為沿途沒有發現爭鬥痕跡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120817
					]
				},
				{
					"id": 732120817,
					"content": "這樣呀…哼哼，那我的推理也差的不遠啦…八九不離十嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120818,
					"content": "唔…但我總覺得哪裡不太對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120819,
						732120820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120819,
					"content": "是哪裡呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "#那個…{F#妳}{M#你}不覺得這些線索太刻意了嗎？就像為專門引導我們而排列的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120822,
					"content": "唔…是妳太多疑了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "#欸！{F#妳}{M#你}看，馬車不就在那邊嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120825,
					"content": "幾乎認不出原狀了呢…不過上面還有塔尼特部族的標誌…模模糊糊的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120826,
					"content": "好啦，我們可以結案了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120827,
					"content": "#{F#妳}{M#你}看，很顯然是馬隊被人伏擊，物資也都被搶走了。我們可以回去向尤夫騰回報情況啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120828,
					"content": "嗯，我們回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120829
					]
				},
				{
					"id": 732120829,
					"content": "不好意思，兩位客人請留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120830
					],
					"speakerTitle": "鍍金旅團刺客"
				},
				{
					"id": 732120830,
					"content": "欸…你們是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120831
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120831,
					"content": "#我們是婕德的朋友，辛苦{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120832
					],
					"speakerTitle": "鍍金旅團刺客"
				},
				{
					"id": 732120832,
					"content": "這樣呀，婕德的朋友就是我們的朋友！正好我們這邊也忙完啦，我們一起回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120833,
					"content": "哈哈，不著急，客人不用著急回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120834
					],
					"speakerTitle": "鍍金旅團刺客"
				},
				{
					"id": 732120834,
					"content": "等等，派蒙…他們有些不對勁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120835
					]
				},
				{
					"id": 732120835,
					"content": "#婕德說，希望{F#妳}{M#你}們在沙漠裡多留一段時間…她委託我們在這裡「招待」一下{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120836
					],
					"speakerTitle": "鍍金旅團刺客"
				},
				{
					"id": 732120836,
					"content": "#希望{F#妳}{M#你}不要辜負她的好意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120837
					],
					"speakerTitle": "鍍金旅團刺客"
				},
				{
					"id": 732120837,
					"content": "#欸…？{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120838,
					"content": "躲起來，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120839
					]
				},
				{
					"id": 732120839,
					"content": "好、好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732120823,
					"content": "有道理，但我們還沒有足夠證據。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120820,
					"content": "是派蒙的直覺時間！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120814,
					"content": "丟棄那些，是出於輕裝趕路的需要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				}
			]
		},
