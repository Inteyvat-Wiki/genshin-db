			"dialogs": [
				{
					"id": 120030601,
					"content": "別太得意忘形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030602
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120030602,
					"content": "哇，有個看起來很厲害的人走出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200308,
			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "有兩下子，不是泛泛之輩…這樣打下去，損失就難以接受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120030802,
					"content": "他們快堅持不住了，繼續上啊！把石珀都搶過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030803,
					"content": "愚人眾和你本來就只有生意上的合作關係，我可沒有讓你帶著我的人去尋釁滋事，惹下這種麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120030804,
					"content": "說…說什麼呢？大人，我、我這也不是為了完成訂單嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030805,
					"content": "訂單的事，自己想辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120030806,
					"content": "別、別走啊！喂！喂！大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030807,
					"content": "少爺？！你怎麼在這裡？沒有受傷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030808,
					"content": "#有這位{F#女俠}{M#少俠}相助，所幸無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030809,
					"content": "少爺？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030810,
					"content": "少爺？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "你、你就是「飛雲商會」的少爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030813,
					"content": "在下行不更名坐不改姓，古華派弟子，暨「飛雲商會」掌櫃次子，行秋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030814,
					"content": "該死，居然被你算計了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030815,
					"content": "茂才公，強搶這種事對生意人來說太不體面了吧，不如還是用生意的辦法解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030816,
					"content": "沒有這石珀，「愚人眾」會把你怎麼樣，需要我幫你想像一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030817,
					"content": "可惡…說吧，你要怎麼樣才肯賣給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030818,
					"content": "既然你和常九爺開的是三折，那一報還一報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030819,
					"content": "市場價的三倍，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030820,
					"content": "你趁火打劫！欺人太甚！你…你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030821,
					"content": "叫喚得這麼厲害，買還是不買啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030822,
					"content": "我…唉，好好好，我答應你，我去籌錢，行了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030823,
					"content": "感謝貴客惠顧「飛雲商會」，今後的生意也望多多關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030824,
					"content": "你你你你你你居然是「飛雲商會」的少爺？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030825,
					"content": "我們用的那嘩啦啦點都點不清楚的摩拉，都是從你的金庫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030826,
					"content": "小事一樁。這是一筆穩賺不賠的生意，還能順便教訓茂才公，一舉兩得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030827,
					"content": "真是人不可貌相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "過獎過獎，你的俠義之心也令人欽佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030831,
					"content": "啊——！之前我一直叫他書呆子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030832,
					"content": "我在武俠小說裡看過，有錢的少爺如果生氣了的話，會花錢買人手腳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030833,
					"content": "怎麼辦？怎麼辦？對不起！對不起！真的很對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030834,
					"content": "既然妳能飛，腳也不是那麼必要的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030835,
					"content": "#嗚哇！{NICKNAME}，幫幫我啊！他的眼神是認真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030836,
					"content": "明顯是在捉弄妳啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "玩笑到此為止，這次的事情真是謝謝二位了，幫了很大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030839,
					"content": "#這本《神霄折戟錄》也讓我非常盡興，麻煩{F#妳}{M#你}們幫我還給常九爺吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030840,
					"content": "又讓我們跑腿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "因為其實我並沒有做什麼，不應該去接受謝意。倒是兩位本與此事毫無瓜葛，卻幫到了最後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030842,
					"content": "能結識如此有俠義心腸的友人，在下已經心滿意足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030843,
					"content": "少爺，抱歉打斷您，但老爺那邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030844,
					"content": "關於這個，請幫我給父親帶句話，我這次平息了事態，還賺了大錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030845,
					"content": "不知可否將功補過，再換幾日自由？《神霄折戟錄》提到了一處秘境，我想去尋訪一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030846,
					"content": "說得那麼好聽，其實還是你自己不想去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030847,
					"content": "哈哈哈，若是我說，常九爺那裡不光有謝意，還會有謝禮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030848,
					"content": "謝禮！那…那還說得過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030849,
					"content": "唉，看來不管我說什麼，只怕也留不住少爺您吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030850,
					"content": "應該早說行秋是你家少爺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "#我、我也沒想到{F#妳}{M#你}們會不知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 120030852,
					"content": "那麼還書一事就拜託二位。行秋告辭，有緣我們江湖再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030837,
					"content": "妳看的真的是武俠小說嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "富家少爺現在都不練字嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "哈哈哈，別挖苦我了。看到我的字家裡人就能認出我，這也算一種特徵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030811,
					"content": "…果然是這麼一回事啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
							"2"
						],
						"stepId": 1200309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "#{F#妳}{M#你}們終於來了！今天早上當鋪的人主動把我的藏書都還回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030902,
					"content": "#這所有的事一定都是{F#妳}{M#你}們幫的忙吧，太謝謝了，真的太謝謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030903,
					"content": "不用客氣，幫上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "哎呀，千萬別這麼說，這件事對我來說真的關係重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030906,
					"content": "常家原本也算璃月的大家族，可惜我做少當家時，生意上多次受挫，敗了家裡的財產…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030907,
					"content": "我累積了多年財力，想要重振家族榮光…這批石珀的生意，就是我壓上全部身家的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030908,
					"content": "#要不是{F#妳}{M#你}們，我大概得葬在這荒山野嶺裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030909,
					"content": "沒想到你也是個「少爺」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030910,
					"content": "嗯？什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030911,
					"content": "啊沒什麼沒什麼！對了，我們是來還書的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030912,
					"content": "哦哦，《神霄折戟錄》！我就說那古華派的小子怎麼突然沒影了，還以為他是個小毛賊呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030913,
					"content": "古華派…有這麼不被人待見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030914,
					"content": "這個門派倒是有幾百年的歷史，也曾經輝煌過，但現在已經衰落到不成樣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030915,
					"content": "振興山門要靠新鮮血液，但若是一直衰落下去，就永遠吸引不來人才，這是個惡性循環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030916,
					"content": "#現在古華派的年輕人啊…就比如那小子吧，說要報恩，結果遠不如{F#妳}{M#你}們有擔當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030917,
					"content": "也不見得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "#唉，無所謂啦。對了對了，{F#妳}{M#你}們是來找《提瓦特遊覽指南》的璃月篇的吧！我已經幫{F#妳}{M#你}們備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030920,
					"content": "#送給{F#妳}{M#你}們，不用還了。另外，大恩難以為報，還有一份微薄的謝禮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030921,
					"content": "謝謝，總算不是白跑一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "礦賣出去了，寶貝書也回來了，這真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030924,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030925,
					"content": "怎麼了？我看好像有什麼東西掉出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030926,
					"content": "沒什麼，沒什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030927,
					"content": "（莫非…那個小毛賊…是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120030922,
					"content": "我差點都忘了這回事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "說不定古華派的轉機就要來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "其實我們也沒做什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
}