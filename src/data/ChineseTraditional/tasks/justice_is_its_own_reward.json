					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120004501,
					"content": "#真是太感謝{F#妳}{M#你}們了，這下子我的礦石生意還有希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120004502,
					"content": "#之前對{F#妳}{M#你}們說話有點不客氣，太抱歉了，還望多多擔待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "#最後一齣好戲，可不能缺了{F#妳}{M#你}們兩位重要的看客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030402,
					"content": "說得輕鬆，我們在跑這跑那的時候，你又幹了什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030403,
					"content": "這個嘛…當然是好好讀完了《神霄折戟錄》，度過了一段美妙的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030404,
					"content": "神戟與邪劍，彌耳與未央…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030405,
					"content": "前五卷故事的展開，還可以說它「奇」，或是「妙」，但這第六卷，已經找不到合適的形容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030426,
					"content": "這世上，也就那位奇人，能寫出這樣的奇作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030427,
					"content": "但這和茂才公的事，有什麼關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030406,
					"content": "我只是感嘆一下。畢竟，「出乎意料」是特別少見的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030407,
					"content": "事情都被你算到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "#也多虧{F#妳}{M#你}的幫助，我的預想才會實現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030411,
					"content": "什、什麼？這…這種「只有我不明白」的氣氛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030412,
					"content": "那…那為什麼你說要在倉庫這裡看好戲呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120030413,
					"content": "試想一下，茂才公跑遍整個璃月港，也買不到半個石珀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030414,
					"content": "他擔驚受怕，沒有材料就完成不了契約，完成不了契約，就會得罪「愚人眾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030415,
					"content": "惶恐之中他聽到了「飛雲商會」的名字，一下子變得氣急敗壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030416,
					"content": "茂才公有權有勢，什麼時候被這樣針對過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030417,
					"content": "不管是想出氣，還是要解決問題，他都要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030418,
					"content": "原來是你們，就是你們在幫常九爺出頭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030419,
					"content": "#{F#妳}{M#你}們看，說來就來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030420,
					"content": "我跑了一大圈，到哪裡都買不到石珀，這才知道是「飛雲商會」在大肆收購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030421,
					"content": "這明明不是什麼稀有礦物，卻一下子斷了貨，你們這是存心針對我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030422,
					"content": "並非針對，只是報恩而已。路見不平拔刀相助，再正常不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030423,
					"content": "我記得是你們的人說的吧，這件事不會就這麼完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120030424,
					"content": "哼，真不知好歹，那我也不廢話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030425,
					"content": "大人，靠你了，把這裡的石珀全部搶走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120030409,
					"content": "書的結局好看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "挺不錯的…希望這邊的結局也能合乎我的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "行秋"
				}
			]
		},
		{
			"id": 1200306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
