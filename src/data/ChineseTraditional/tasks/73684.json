			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫克爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736840101,
					"content": "欸——各位冒險家們，有興趣的請過來看看，協會正在舉辦新活動——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840102
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840102,
					"content": "只要參與這個活動，不僅能拿到協會發放的獎勵，還會有額外的禮品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840103,
						736840104
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840103,
					"content": "冒險家協會有活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				},
				{
					"id": 736840105,
					"content": "#{F#妳}{M#你}是…旅行者！幸會幸會，哎呀，沒想到能遇見前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840106
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840106,
					"content": "如您所見，我正在為協會裡的一項活動招募參與人員呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840107
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840107,
					"content": "這是我在協會裡的第一項正式工作，我得打起十二分的精神完成才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840108
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840108,
					"content": "關於這次活動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840109
					]
				},
				{
					"id": 736840109,
					"content": "喔…喔！抱歉，前輩一定還不知道這次活動的情況吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840110
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840110,
					"content": "這次的活動被傑克前輩命名為「跨野尋蹤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840111
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840111,
					"content": "用傑克前輩的話來說，是一場「既簡單又有趣，同時還能檢驗冒險家自身實力」的活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840112
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840112,
					"content": "大致來說，我們會在各地放置一些「野蹤氣球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840113
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840113,
					"content": "參與的冒險家們需要做的，就是根據提示找到「野蹤氣球」，並且沿著這些氣球的分佈軌跡前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840114
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840114,
					"content": "在限定時間內收集到越多「野蹤氣球」，就能獲得越高的評價，獎勵也會更加豐厚喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840115,
						736840119
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840115,
					"content": "要是我把這些氣球擊破了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840116
					]
				},
				{
					"id": 736840116,
					"content": "那些氣球都是特製的，能抵禦住普通弓箭的射擊，只能從近處擊破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840117
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840117,
					"content": "畢竟之前舉辦這類活動的時候，冒險家們看見氣球的第一反應就是舉弓就射，說了很多次他們也不記得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840118
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840118,
					"content": "所以，這次協會使用了這種特製氣球，希望會有用啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840124,
					"content": "啊！我不能和您閒聊了，我還要接著去招募人員呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840125
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840125,
					"content": "如果您有興趣的話，也請來參與一下吧！如果您願意加入這次活動，傑克前輩和賽琉斯會長一定也會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840119,
					"content": "感覺就是一場長跑啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840120
					]
				},
				{
					"id": 736840120,
					"content": "唔…傑克前輩說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840121
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840121,
					"content": "「尋找氣球是檢驗冒險家們的『洞察力』，在各種環境中前進是檢驗冒險家們的『基本功』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840122
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840122,
					"content": "「而『按照提示行動』則是檢驗冒險家們的『紀律』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840123
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840123,
					"content": "我剛進協會，對這方面的事不太懂啦…但傑克前輩既然這麼說了，一定有他的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "溫克爾"
				},
				{
					"id": 736840104,
					"content": "冒險家協會又在幹什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				}
			]
		}
	]
}