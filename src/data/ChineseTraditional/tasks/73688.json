				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "閣下武藝精湛，這場較量在下輸得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "曉月左衛門十藏"
				},
				{
					"id": 736880102,
					"content": "承讓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#各位觀眾，經過剛才令人熱血沸騰的一戰，本屆「演武傳心劍道大賽」的冠軍已經產生，那就是——{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880104,
					"content": "#明天，我們將進入最後的表演賽階段：由{NICKNAME}與神里小姐一起，迎戰將軍大人的特使——人形機關劍士「魔偶劍豪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880105,
					"content": "各位，我們屆時不見不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880106,
					"content": "旅行者，真是一場精彩的比賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880107,
					"content": "#恭喜{F#妳}{M#你}，旅行者。這個冠軍頒給{F#妳}{M#你}，的確是實至名歸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880108,
					"content": "只是沒想到明天的對手竟然是「魔偶劍豪」。這個名字聽起來和我們在八醞島野外遇到的那個傢伙很像，總感覺不太好對付呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880109,
					"content": "派蒙不用擔心，雖然特使的實力強勁，但明天的比賽並不限制使用神之眼，我們還是拿回了一些主動權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880110,
					"content": "而且，只要我們見招拆招，總能找到還擊的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880111,
					"content": "綾華這麼說我就放心多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880112,
					"content": "最終能不能取勝，我其實也並無把握。但只有盡全力戰鬥，才能為觀眾們呈現出最精彩的表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880113,
					"content": "我們一定能獲勝的，綾華。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "#{F#妳}{M#你}們兩個真是有幹勁呢，那今天晚上可要好好休息，養精蓄銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880116,
					"content": "嗯，明天一覺醒來就能看到綾華的新衣服了。穿著楓丹服飾的綾華…哎呀，好期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880117,
					"content": "唔，這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880118,
					"content": "我也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#怎麼旅行者{F#妳}{M#你}也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880121,
					"content": "#好啦綾華小姐，妳就滿足{M#他們}{F#她們}的期待吧，如果不是因為明天我有事在身，我都想一起來看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880122,
					"content": "#嗯，那就這樣說好了。明天早上，我在神里屋敷等{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880120,
					"content": "需要我來接妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "我們一定能呈獻一場精彩的比賽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏達",
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "#兩位，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880202,
					"content": "呃啊，竟然是宏達！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880203,
					"content": "#前幾天的比賽{NICKNAME}已經贏了你，而且還拿了冠軍，你現在還有什麼話說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880204,
					"content": "#請放心，我並非是來挑剔兩位的，而是來道歉的。旅行者，幾天前與{F#妳}{M#你}的一戰，我輸得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880205,
					"content": "#閣下劍術精湛，出招犀利卻不咄咄逼人，足見品性。之前我錯判了閣下的為人，言行對{F#妳}{M#你}多有冒犯，還請{F#妳}{M#你}見諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880206,
					"content": "沒關係，我並不在意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "兩位今天是來接神里小姐的吧？小姐現在正在室內整理著裝，應該很快就會出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880209,
					"content": "旅行者，趁小姐來之前，我有個不情之請，希望您能答應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880210,
					"content": "好的，請講。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "小姐她雖然從沒有對我們這些家臣提過今天的表演賽，但最近小姐每天無論多忙，晚上一定會抽出幾個時辰練習劍術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880212,
					"content": "小姐向來勤勉認真，雖說今天是表演賽，不取勝也無妨，但按照小姐的心性，一定會全力以赴，忘我奮戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880213,
					"content": "#身為家臣，我當然相信小姐的實力，只不過…還是希望{F#妳}{M#你}能在賽場上支援小姐，保護小姐的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880214,
					"content": "請放心吧，我一定會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "#旅行者，那小姐就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880217,
					"content": "喔，應該是綾華出來了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880218,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880219,
					"content": "#咦，怎麼了？{F#妳}{M#你}們兩個都這樣一言不發…是這身裝扮有哪裡不妥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880220,
					"content": "不是的！綾華，妳這樣真好看…有種眼前一亮的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880221,
					"content": "這個造型很適合妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "對呀對呀，看起來就像是楓丹的大小姐，氣質也活潑了不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880223,
					"content": "真的嗎？我還擔心會不會有點過於俏皮…我不一定能駕馭住這種風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880224,
					"content": "#不過既然{F#妳}{M#你}們都覺得還不錯，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880229,
					"content": "嘻嘻，等等大家看到綾華的時候，一定也會覺得很驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880230,
					"content": "謝謝妳的誇獎，派蒙。旅行者，既然已經準備妥當，我們就出發去賽場吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880231,
					"content": "#小姐、旅行者，請慢走。祝{F#妳}{M#你}們表演賽一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏達"
				},
				{
					"id": 736880225,
					"content": "很漂亮的服裝，非常合身。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "對呀對呀，仔細看的話，在裙擺上還繡上了你們神里家的椿紋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880227,
					"content": "嗯，這是小野寺先生他們在這幾天裡找人趕製出來的，聽說是根據觀眾們寫在投票上的建議加上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880228,
					"content": "這套衣服裁剪得非常合身，活動起來也比想像中更自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736880207,
					"content": "和你那場戰鬥我也很盡興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
