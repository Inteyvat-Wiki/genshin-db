			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "啊旅行者，可真是巧啊，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040102,
					"content": "凱瑟琳小姐，今天有什麼委託嗎？還有…妳今天見到我們怎麼好像格外開心的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040103,
					"content": "因為今天早些時候我去神社求籤，巫女告訴我說，最近適合「意料之外的再會」喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040104,
					"content": "凱瑟琳小姐會去神社求籤？怎麼感覺是非常非常稀奇的景象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040105,
					"content": "不對，重點是妳一天之內去稻妻跑了個來回嗎？這裡可是璃月欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040106,
					"content": "呵呵，哪怕是我，也偶爾會有些私生活的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040107,
					"content": "所以妳說「意料之外的再會」，指的是和我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040108,
					"content": "誰知道呢，至少有了這份期待，就感覺見到誰都會很開心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040109,
					"content": "好吧…明明我們幾乎每天都要見面的，凱瑟琳小姐開心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040110,
					"content": "意料之外的再會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#{F#妳}{M#你}是說…嗯，我理解的心情，{NICKNAME}，如果巫女所說的真能靈驗就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040113,
					"content": "#{F#妳}{M#你}的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040114,
					"content": "#我是不是…說了什麼不該說的話呢？看到{F#妳}{M#你}們好像有些沮喪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040115,
					"content": "沒事沒事，凱瑟琳小姐，我們還是回到委託的話題吧，有沒有什麼適合我們的委託呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040116,
					"content": "嗯，正巧有一位礦工大哥的委託，似乎是關於層岩巨淵的調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040117,
					"content": "欸，那邊難道已經解除封鎖了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040118,
					"content": "#那麼具體情況就讓委託人再詳細與{F#妳}{M#你}們溝通吧，他叫玥輝，現在應該就在層岩巨淵的附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040119,
					"content": "好的，凱瑟琳小姐，那我們就動身啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040120,
					"content": "嗯，向著星辰與深淵…唔，這次好像真的是向著「深淵」呢，祝兩位好運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 80040111,
					"content": "或許…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玥輝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "你好！是那個…那個玥輝嗎？我們是冒險家協會派來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040202,
					"content": "喔，幸會幸會，確實是我發佈的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040203,
					"content": "嗯？這位看起來好像有點眼熟…是很有名的冒險家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040204,
					"content": "我的來歷比較複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "這樣啊，好吧。先自我介紹一下，我是前不久才拿到層岩巨淵開採許可的礦工，手下有一些跟著我的兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040207,
					"content": "居然可以拿到層岩巨淵的開採許可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040208,
					"content": "嗯，玉京臺那邊終於也開竅了，在千岩軍的保護下，開始准許一些僅限於淺表範圍的礦物開採，我們還是第一批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040209,
					"content": "可是最近發生了一些事情，礦工兄弟們都有些人心惶惶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040210,
					"content": "發生了什麼事？我們好像沒聽說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040211,
					"content": "嗯…這件事說大不大，說小不小，只是有些詭異…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040212,
					"content": "有個兄弟在休息的時候，忽然注意到幾個丘丘人神情恍惚地路過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040213,
					"content": "而且這些丘丘人看都沒看他一眼，只是徑直朝著層岩巨淵深處去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040214,
					"content": "於是那個兄弟刻意留心觀察了一段時日，發現時不時便會有類似的情況發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040215,
					"content": "丘丘人難道也有好奇心嗎？會不會只是來這邊轉轉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040216,
					"content": "不，詭異的地方在於，他發現來到層岩巨淵的丘丘人們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040217,
					"content": "…從來都是「只進不出」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040218,
					"content": "那些丘丘人的行跡永遠都是單向的，進去之後就再也沒有出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040219,
					"content": "這段時間，類似的情況愈發頻繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040220,
					"content": "「那些丘丘人的目標究竟是什麼」，「它們後來怎麼樣了」，「會不會是在醞釀什麼災厄」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040221,
					"content": "這些念頭在礦工兄弟們的腦海中不斷出現，很多人都要把自己嚇得發瘋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040222,
					"content": "唔呃，我好像能理解…光是聽上去就覺得有些頭皮發麻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040223,
					"content": "不敢想像層岩巨淵內部的畫面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "是啊，可能源於未知的恐懼才是最深的恐懼吧。只有查明了真相，兄弟們才能安心幹活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040226,
					"content": "我們…我們真的要接這個委託嗎？那個，礦工大哥，讓我們再考慮一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040227,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "#喂！{F#妳}{M#你}也照顧一下我的意見呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040229,
					"content": "類似這樣的詭異情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "#原來{F#妳}{M#你}是這樣考慮的，唔…那、那好吧，或許真的藏著什麼關於血親的線索呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040232,
					"content": "#不去的話，{F#妳}{M#你}會一直很在意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040233,
					"content": "二位決定要接下這個委託了嗎？我可不想我的開採許可證就這麼白費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040234,
					"content": "嗯，就當是我們也想滿足一下好奇心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80040235,
					"content": "#那可真是幫了大忙了，我這就告訴{F#妳}{M#你}們那些丘丘人去往的大致位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80040230,
					"content": "我懷疑和「深淵教團」有所關聯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "確實是非常詭異的事件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "還是直接說正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
			"id": 800403,
			"completionStepIds": [
				800403,
				800404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
