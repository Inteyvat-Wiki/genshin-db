				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "唉呀，您也是來這裡留影的吧？之前就有外國的旅客過來想要在這裡留影，畢竟海面上的浮島是很好的景色啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270102,
					"content": "可惜之前沒有留影機，我還特地拜託認識的外國商人弄了一臺來勒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270103,
					"content": "怎麼樣，客人，要不要試試看拍張畫片？不過必須要您自己動手，我拍照的技術可不怎麼樣喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270104,
					"content": "奇怪，海面上的霧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "#海面上的霧？客人{F#妳}{M#你}在說什麼啊？這裡海風這麼大，哪會有霧啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270106,
					"content": "我出生到現在都還沒看過海上有霧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270107,
					"content": "客人不會是把這裡和鏡璧山下那些全是霧的地方搞混了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270108,
					"content": "大概吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "#嘿嘿，在我看來，客人{F#妳}{M#你}就是太緊張了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 751270110,
					"content": "來納塔旅遊，還是要放鬆一點才好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩卡烏"
				}
			]
		}
	]
}