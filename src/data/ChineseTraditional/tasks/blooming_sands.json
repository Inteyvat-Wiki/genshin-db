				"points": []
			},
			"dialogs": [
				{
					"id": 732330301,
					"content": "#旅行者！{F#妳}{M#你}把東西拿回來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "#就是這些，太謝謝{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330402,
					"content": "你是要開花店嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "哎呀，畢竟…一次性多買一點，免得總是出去嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330405,
					"content": "#{F#妳}{M#你}先在旁邊休息一下吧！我得先把種子種下去，再施點肥料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330406,
					"content": "里夫開始處理花盆…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "好了！這樣就可以了，內爾敏這盆花只需要再澆澆水就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330408,
					"content": "#旅行者，能不能…再請{F#妳}{M#你}幫我把這盆花送去給內爾敏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330409,
					"content": "你怎麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "我要盯著這個路口啊，要是有糧食或者物資運過來，我還得去叫村裡的人過來接收物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330411,
					"content": "#周圍這溫度…{F#妳}{M#你}應該已經感覺到了。要是接收速度太慢，物資說不定都會被曬壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330412,
					"content": "#拜託{F#妳}{M#你}啦旅行者，內爾敏住得離這裡不遠，{F#妳}{M#你}就把這一盆花送去給她就好，剩下的東西我會想辦法運回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330403,
					"content": "你買這麼多東西做什麼！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323305",
							"2"
