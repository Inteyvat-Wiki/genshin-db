					"阿扎萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "唉，還有一批貨物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330202,
					"content": "關於里夫的貨物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "#{F#妳}{M#你}是說里夫找我訂的貨物嗎？我剛接了一批貨，裡面剛好有他要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330204,
					"content": "#不過，他買的東西真不少啊…{F#妳}{M#你}是幫他來拿貨的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330205,
					"content": "很、很重嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "除了那個花盆之外，還有各類種子，肥料和園藝用品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330208,
					"content": "#這些東西加起來很重喔，{F#妳}{M#你}…{F#妳}{M#你}一個人搬得過去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330209,
					"content": "我自有辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "#這樣啊…那好吧，我幫{F#妳}{M#你}把東西都包好。真是辛苦{F#妳}{M#你}跑這一趟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 732330210,
					"content": "我都答應人家了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "有、有多少…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
			"completionStepIds": [],
