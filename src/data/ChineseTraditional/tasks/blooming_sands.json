			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "#旅行者，{F#妳}{M#你}回來了，真是辛苦{F#妳}{M#你}了…內爾敏怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330602,
					"content": "她擔心自己不會種花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "這個…我會陪著她研究這件事的啦，實在不行就去找人問問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330604,
					"content": "要是有問題，我…我就…我就去找點容易種，又容易活下來的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330608,
					"content": "#咳，總之…謝謝{F#妳}{M#你}幫我的忙，旅行者，這些報酬請{F#妳}{M#你}收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330609,
					"content": "等等我就把其他的東西拿過去給內爾敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330610,
					"content": "等等，這些園藝工具沒附使用說明書嗎？我完全不知道怎麼用它們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330605,
					"content": "你之前沒送過她花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "也不能說沒送過吧…只不過前幾次我託人買的都是已經長成的花。等送到村裡來的時候，那些花已經快被曬乾了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330607,
					"content": "所以這次，我決定直接送內爾敏一盆剛種下的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "里夫"
				}
			]
		},
