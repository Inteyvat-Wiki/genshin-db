			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "屋內的某人似乎聽到了動靜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "#{F#妳}{M#你}好，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330503,
					"content": "關於這盆花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "這是…里夫送給我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330505,
					"content": "#這盆裡種著花嗎？真的？謝謝{F#妳}{M#你}幫他送來，我很喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330506,
					"content": "不過…我真的能養好它嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330507,
					"content": "妳之前沒養過花嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "我…我不擅長照顧植物，之前好多盆栽都被我養得枯萎了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330509,
					"content": "這盆花一定更嬌弱，要是我又把它養枯的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330510,
					"content": "唉，不行，既然花已經到我手上了，我就要好好照顧它才可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 732330511,
					"content": "庫爾蘇姆奶奶一定知道怎麼解決這個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
