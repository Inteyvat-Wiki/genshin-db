						],
						"pointId": 5742
					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "嘿嘿！嘟嘟可戰勝了一大群壞壞的角角魚士兵！角角魚的大王也不是對手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360102,
					"content": "嘟嘟可、蹦蹦炸彈和轟轟火花的組合，是最厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360103,
					"content": "是無敵的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "玩這個遊戲的時候，我經常想到果酒湖的那件事呢…難道麗莎直接把那件事改編成了遊戲的主題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360106,
					"content": "不過話說回來，如果真的找不到那些外來的魚…讓小可莉去把可疑的礁石統統炸一遍，不就萬事大吉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360107,
					"content": "實在不行，給我們幾個炸彈，我們也能把這件事包辦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360108,
					"content": "派蒙，妳和可莉更契合了啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "#嗯，看{F#妳}{M#你}們的表情，似乎還滿享受這個遊戲的嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360111,
					"content": "麗莎姐姐，妳來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360112,
					"content": "麗莎，妳終於露面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360113,
					"content": "妳設計的「嘟嘟可轟轟奇遇記」很有趣，我們和小可莉都玩得很盡興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360114,
					"content": "#謝謝{F#妳}{M#你}們的喜歡。難道說，我還要設計這部作品的續作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360115,
					"content": "好耶！我還想看…嘟嘟可去其他地方冒險的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360116,
					"content": "不、不對，我記得，麗莎姐姐做這個遊戲花了好多時間，一定很累，不能總是讓麗莎姐姐這麼累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360117,
					"content": "啊呀，小可莉這麼關心姐姐，姐姐很高興哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360118,
					"content": "如果妳喜歡這樣的遊戲，願意安安心心待在城裡玩，我花再多時間都值得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360119,
					"content": "當然，我明白，自由自在地到處冒險，才是妳的最愛，這個遊戲只是一種新奇的消遣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360120,
					"content": "#所以，我為{F#妳}{M#你}們帶來了一則好消息，還有給小可愛們的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360121,
					"content": "禮物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360122,
					"content": "#我、我也有禮物要給榮譽騎士{M#哥哥}{F#姐姐}和小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360123,
					"content": "禮物放在最後，先說好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360124,
					"content": "我猜，果酒湖的問題解決了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "沒錯，調查小隊的兩位騎士找到了外來魚類的老巢，將它輕鬆搗毀啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360127,
					"content": "至於外來魚類突然出現的原因，騎士團也查清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360128,
					"content": "這次的事故起源於一位商人的無心之舉。念在她沒有惡意，騎士團只讓她繳納了相應的罰金，好好教育了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360129,
					"content": "呼…還好還好，沒有造成很大的影響。不過，那個商人未免也太不小心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360130,
					"content": "果酒湖的水質安全了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "那，接下來就是——公布禮物的時間了！可莉可以先說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360133,
					"content": "當然沒問題啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360134,
					"content": "我也有點好奇呢，小可莉最近每天很早就回家了，完全都不用別人提醒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360135,
					"content": "哼哼~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360136,
					"content": "晚上在家的時候，我一邊看著阿貝多哥哥的手工畫冊，一邊學，一邊做出來了這個——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360137,
					"content": "鏘鏘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360138,
					"content": "這是…準備擲出蹦蹦炸彈的嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360139,
					"content": "嗯！可莉照著「嘟嘟可轟轟奇遇記」的棋子，做了這個嘟嘟可的玩偶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360140,
					"content": "雖然這個嘟嘟可不能真的丟出蹦蹦炸彈，但我覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360141,
					"content": "#只要看到這個玩偶，榮譽騎士{M#哥哥}{F#姐姐}和小派蒙就能想起這幾天的開心時光，煩惱和無聊丟光光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360142,
					"content": "嘟嘟可的大玩偶！確實是個大驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360143,
					"content": "這樣一來，感覺隨時都能見到小可莉和嘟嘟可了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360144,
					"content": "謝謝妳！細心手巧又體貼的可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "#嘿嘿！榮譽騎士{M#哥哥}{F#姐姐}和小派蒙喜歡我的禮物，可莉的努力大獲成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360147,
					"content": "麗莎姐姐的禮物呢？可莉也想知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360148,
					"content": "啊呀，比起小可莉的心意，我的這件禮物就要保守得多了呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360149,
					"content": "來看看「嘟嘟可轟轟奇遇記」的冒險故事書吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360150,
					"content": "冒險故事書！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360151,
					"content": "一整本故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360152,
					"content": "小可愛們回到了蒙德，與小可莉一起加入了嘟嘟可的冒險旅程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360153,
					"content": "#{M#他們}{F#她們}一起打敗了壞壞的角角魚士兵，開開心心地喝起了下午茶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360154,
					"content": "這個故事才是「嘟嘟可轟轟奇遇記」最最完美的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360155,
					"content": "難道說，麗莎在設計這些遊戲關卡的時候，就想好了整個故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360156,
					"content": "#不是的。派蒙，這個故事是小可愛、妳和小可莉合力完成的哦，{F#妳}{M#你}們才是決定一切的主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360157,
					"content": "我之前特別為這本書預留出了一張插圖的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360158,
					"content": "現在我有個提議——大家難得在這麼悠閒的時候相聚，不如，小可愛們一起合個影，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705360159,
					"content": "好呀，見到了好朋友，還一起玩到了開心的遊戲，這一刻的確值得紀念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360160,
					"content": "開開心心合個影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#那就來吧，榮譽騎士{M#哥哥}{F#姐姐}和小派蒙，這邊這邊！麗莎姐姐，拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360163,
					"content": "今天也是開心的一天！三、二、一——嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360161,
					"content": "平平淡淡也珍貴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
