			"completionStepIds": [
				7166901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166901",
							"2"
						],
						"stepId": 7166901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}，聽工作人員們說所有安裝了發信裝置的小動物都被{F#妳}{M#你}找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690102,
					"content": "有點意外啊。有些動物天性敏感，在陌生生物靠近時會立刻逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690103,
					"content": "#但牠們並不排斥{F#妳}{M#你}靠近，真是奇事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690104,
					"content": "因為我是動物之友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "#哈哈，{F#妳}{M#你}這能力很讓人嫉妒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690107,
					"content": "之前有好幾次工作人員陪我一起去餵動物的時候，我不是被吼就是被咬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690112,
					"content": "手臂上還留了好幾道疤，很痛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690113,
					"content": "不過呢，雖然牠們一點都不親我，但能夠看到這些可愛的生靈好好地活著，我就覺得很滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690114,
					"content": "對所有認養人來說也是這樣，大家都希望在不驚擾到動物們的前提下，保護好牠們的生存環境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690115,
					"content": "我知道對許多冒險家來說野生動物是重要的食物來源，我們也不會要求「伴爪同行」的成員完全不殺生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690116,
					"content": "我們提倡的原則是不濫殺、濫捕，如果每個人都能做到這一點，我們身邊的環境一定會變得更豐富、更美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690117,
					"content": "#作為我們的成員，如果{NICKNAME}{F#妳}{M#你}也能夠認同接受這個原則就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690118,
					"content": "我認同。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "#我就知道，像{F#妳}{M#你}這樣通情達理的人一定會認同我們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690122,
					"content": "能引發他人思考，就已經是成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690123,
					"content": "#有機會的話，希望能在下一次「伴爪同行」的活動裡見到{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690124,
					"content": "希望到那個時候，我手臂上不會有新的傷疤，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690120,
					"content": "我持保留態度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "沒關係，我們並不強求所有人都接受，但我個人希望所有人在殺生前想一想這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690105,
					"content": "這是冒險家的天賦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
