				]
			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "哥倫比婭小姐、桑多涅小姐！感謝妳們抽空來參加我們的桌上劇團！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480102,
					"content": "沒什麼，我們之前沒怎麼玩過，倒是要麻煩兩位多多關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480103,
					"content": "不必有壓力，大家享受故事的樂趣就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480104,
					"content": "嗯。我很期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480105,
					"content": "那麼，就由我來簡單說明一下此次故事的背景——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480106,
					"content": "「這是一個吸血鬼與人類共生的時代，故事就發生在兩個種族共同生活的城市中…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 742480107,
					"content": "「人類與吸血鬼的關係說不上敵對，但也不能稱之為和諧。而一起夜晚的凶案，徹底打破了這個微妙的平衡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 742480108,
					"content": "吸血鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480109,
					"content": "就是靠吸食人類血液才能活下去的種族啦，算是小說中的常見設定。哥倫比婭小姐看過類似的故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480110,
					"content": "唔，好像聽說過。那我們需要在故事中做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480111,
					"content": "各位先決定自己想要在這個世界中扮演的角色吧，貼合背景設定就行，身分和職業不做限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480112,
					"content": "想要扮演的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480113,
					"content": "如果自己不好決定的話，也可以和他人交換，讓對方來決定妳在這個世界的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480114,
					"content": "欸？意思是…讓別人來寫你的背景設定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480115,
					"content": "哦！聽起來很有趣呢！不如就這麼辦吧！我的角色卡就交給克洛琳德妳來寫吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480116,
					"content": "那我的角色，就交給桑多涅來決定吧。我也會為桑多涅設計一個符合妳的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480117,
					"content": "哈…行吧。我剛好也對自己故事中的職業沒有太多頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480118,
					"content": "各位都寫好了嗎？嘿嘿，那我先看看自己的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480119,
					"content": "「我是一位商人，平時奔走於吸血鬼與人類所居住的城市…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "娜維婭",
					"speakerSubtitle": "行商"
				},
				{
					"id": 742480120,
					"content": "…等等，主持人，這不是和我以前的角色卡差不多嗎？！連數值都一樣！你這是偷懶了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480121,
					"content": "反正妳到最後都會用奇奇怪怪的方式給我出難題，而且我覺得這種精明胡鬧的角色很適合妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480122,
					"content": "…喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 742480123,
					"content": "哈哈。那我來看看我的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480124,
					"content": "「我是一位很壞很壞的吸血鬼。白天喜歡躺在家裡睡覺，只在夜晚月亮出來的時候才會到花園中散步。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很壞很壞的吸血鬼"
				},
				{
					"id": 742480125,
					"content": "「我喜歡唱歌，會用歌聲誘惑自己的獵物。而見過我睜眼的人，更是沒有一位能看到第二天的太陽。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很壞很壞的吸血鬼"
				},
				{
					"id": 742480126,
					"content": "唔…在桑多涅看來，我是這麼一個形象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480127,
					"content": "哼哼，這不是滿適合妳的嗎？而且很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480128,
					"content": "好吧，但我還是想盡量做一個好的吸血鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480129,
					"content": "隨妳便，讓我看看妳寫的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480130,
					"content": "「我是一位優雅的貴族大小姐。平時喜歡在房間裡搞一些發明創造，睡覺睡得很晚，作息很不規律…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼獵人"
				},
				{
					"id": 742480131,
					"content": "喂！誰的自我介紹會寫這種東西啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480132,
					"content": "嘖…「但我同時也是一位吸血鬼獵人，只要城市裡有人陷入了危險，我就會帶著自己的發明挺身而出，拯救大家…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼獵人"
				},
				{
					"id": 742480133,
					"content": "…哈？這和我根本一點也不像吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480134,
					"content": "是嗎？我明明覺得很像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480135,
					"content": "但這麼看來，哥倫比婭小姐的角色和桑多涅小姐就是對立關係了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "娜維婭",
					"speakerSubtitle": "行商"
				},
				{
					"id": 742480136,
					"content": "嗯，看起來這故事會有很多奇妙的發展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 742480137,
					"content": "哦！我已經等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "娜維婭",
					"speakerSubtitle": "行商"
				},
				{
					"id": 742480138,
					"content": "哈…總感覺會有很多麻煩的發展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼獵人"
				},
				{
					"id": 742480139,
					"content": "妳怕了嗎，桑多涅？因為我是很壞很壞的吸血鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很壞很壞的吸血鬼"
				},
				{
					"id": 742480140,
					"content": "哦哦？應該說我反倒等不及要把妳揍一頓了才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼獵人"
				}
			]
		},
