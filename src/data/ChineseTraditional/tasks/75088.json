			"dialogs": [
				{
					"id": 750880101,
					"content": "#怎麼樣，{F#妳}{M#你}們找到「鐫光銘印」的碎片了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋紐奧"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秋紐奧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "哈哈，了不起，這下我一定能夠破譯「鐫光銘印」上的這些金紋…懸賞，懸賞一定是我的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880202,
					"content": "應該說如果這次也失敗，那就徹底沒有經費了，生死成敗在此一舉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880203,
					"content": "#啊，對了，這是給{F#妳}{M#你}們的酬勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋紐奧"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秋紐奧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "嗯，如果樣本夠多的話，說不定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880302,
					"content": "哦，這裡有個奇怪的傢伙在嘀嘀咕咕的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880303,
					"content": "#像我這樣的人在納塔到處都是，奇怪的反而是{F#妳}{M#你}們哦…如果沒什麼事就不要打擾我做研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880304,
					"content": "我這個月的支出超出了預計額度，只能靠解決協會裡懸賞的研究問題來補貼一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880305,
					"content": "原來做研究還有錢拿啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880306,
					"content": "對啊，「龍遺物研究協會」就是這樣的組織，有獎賞才能促進大家研究各種課題嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880307,
					"content": "這次我就要挑戰破譯「鐫光銘印」…據說這是沒有人完成的偉業，可以拿到的摩拉也有很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880308,
					"content": "不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880309,
					"content": "不過什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880310,
					"content": "如果要破譯「鐫光銘印」，就要先拿到夠多的「鐫光銘印」碎片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880311,
					"content": "#嗯…那這樣好了，如果{F#妳}{M#你}們有辦法找來「鐫光銘印」的碎片的話，我就給{F#妳}{M#你}們報酬，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880312,
					"content": "#看起來{F#妳}{M#你}們是經驗豐富的冒險家嘛，應該常常接到這樣的委託吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880313,
					"content": "也不是不行啦，不過你這個月的支出不是已經超額了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880314,
					"content": "既然都已經超額了，多超少超根本不是問題…只要拿到「鐫光銘印」的碎片然後破譯裡面的內容，多少摩拉都可以有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880315,
					"content": "我們只負責找碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "#{F#妳}{M#你}們只要保證能夠拿到「真貨」就好，講到這個就氣，這個月有販子賣給我的秘源遺蹟物品根本就是偽造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880318,
					"content": "坑了我好大一筆摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880319,
					"content": "哦，原來是因為這樣才超支的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750880320,
					"content": "所以就要用「鐫光銘印」的碎片打個翻身仗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880321,
					"content": "#拜託了，尋找碎片就拜託{F#妳}{M#你}們了！如果找到了請一定要帶到我這裡來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880322,
					"content": "呃…也不用太多，就…三，不，四個吧！多的我就實在付不起酬勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880316,
					"content": "不保證碎片一定有用哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
