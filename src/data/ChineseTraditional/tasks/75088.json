			"dialogs": [
				{
					"id": 750880601,
					"content": "#唉呀，是{F#妳}{M#你}啊，謝謝{F#妳}{M#你}帶來的「鐫光銘印」碎片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880602,
					"content": "不過破譯的進度有點堪憂，看起來跟燃素刻錄差不多，但是果然比想像中複雜太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "秋紐奧"
				},
				{
					"id": 750880603,
					"content": "已經沒有退路了，我一定要破譯成功才可以啊，哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋紐奧"
				}
			]
		}
