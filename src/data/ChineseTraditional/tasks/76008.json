							10581.7
						],
						"pointId": 11129
					},
					{
						"sceneId": 3,
						"position": [
							1951.384,
							241.685,
							10578.37
						],
						"pointId": 13263
					},
					{
						"sceneId": 3,
						"position": [
							1950.003,
							241.463,
							10577.32
						],
