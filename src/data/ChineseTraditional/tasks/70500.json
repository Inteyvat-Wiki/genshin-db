				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "冰天雪地，玉樹瓊枝…寂寞又冷冽之地啊。本仙這第三道菜，倒是應景得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000102,
					"content": "這次又要做什麼菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "#唔…本仙問{F#妳}{M#你}，{F#妳}{M#你}有沒有聽說過一種名為「燴」的烹飪手法？這種手法也是本仙翻閱食譜時偶然發現的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000104,
					"content": "本仙深感有趣，特意以這種烹飪手法為核心，寫出了一份名為「紅燴獸肉」的新食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000105,
					"content": "雖然對本仙的「機關烹飪神機」來說，這道菜並不麻煩，但「紅燴獸肉」這道菜重點在肉，所用的獸肉必須是優品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000106,
					"content": "因此，本仙開啟機關，一路追尋著食材的氣息來到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000107,
					"content": "此處風雪彌漫，實難辦事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000108,
					"content": "#旅行者，本仙知道{F#妳}{M#你}見識廣闊又精於冒險，區區雪山，對{F#妳}{M#你}而言，肯定不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000109,
					"content": "#就請{F#妳}{M#你}再為本仙跑一趟，尋些食材回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000110,
					"content": "第三份食譜我也要哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "#自然忘不了{F#妳}{M#你}的。那這件事就交給{F#妳}{M#你}了，本仙就在這裡等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000112,
					"content": "呃，機關怎麼突然停了，難不成是周遭太冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000113,
					"content": "待本仙重啟一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000114,
					"content": "機關烹飪神機…啟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000115,
					"content": "#這下應該好了…旅行者，{F#妳}{M#你}快循著氣息的蹤跡，去把本仙要的食材拿回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000116,
					"content": "您冷得飛不動了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "#笑話！本仙威能，豈容{F#妳}{M#你}小覷！本仙只是、只是…需要在此修繕機關罷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000118,
					"content": "#{F#妳}{M#你}且快去快回吧，莫要讓本仙等待太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
