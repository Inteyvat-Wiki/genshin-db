			"dialogs": [
				{
					"id": 705000501,
					"content": "這是…什麼肉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000502,
					"content": "冷鮮肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "冷鮮肉…名字倒是貼切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000504,
					"content": "唔…品質不錯。但看肉的狀態，還需要稍加小火，化凍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000505,
					"content": "幸好，本仙設計的「機關烹飪神機」兼有解凍之能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000506,
					"content": "這機關好像什麼功能都不缺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "怎麼會呢？要說功能缺失，自然也有。例如，自動取回食材啊，自動控制火候…之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000508,
					"content": "這機關，還是需要多多改進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000509,
					"content": "好了，閒話不多說。既然食材備齊，本仙馬上就去開啟機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000510,
					"content": "#照看火候的事，依然交給{F#妳}{M#你}負責，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000511,
					"content": "#{F#妳}{M#你}準備好之後，速來知會本仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000512,
					"content": "仙人，果然很強大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "#與其讚賞仙力，本仙更希望{F#妳}{M#你}讚賞「機關烹飪神機」的巧能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
