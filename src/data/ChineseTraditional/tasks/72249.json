			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490302,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490303,
					"content": "嗯，赫利俄斯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490304,
					"content": "赫利俄斯是什麼很了不起的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490305,
					"content": "當然！吾當時主持建造赫利俄斯，舉全國之力，以此抵禦深海龍嗣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490306,
					"content": "是整個白夜國，除吾之外，再無第二人能完成的偉業！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490307,
					"content": "啊，聽上去真是了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490308,
					"content": "可是這麼了不起的大人物，為什麼會被封在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490309,
					"content": "吾…吾是被人背叛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490310,
					"content": "當初天國塌落於無底深淵之下，諸民受龍嗣所害，是吾，吾掌持建造赫利俄斯，以此救眾生於倒懸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490311,
					"content": "可是那群貪鄙小人！一旦性命無虞，就行欺上瞞下之事…最後竟還，推舉稚童作國首。可笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490312,
					"content": "就連吾也被他們陷害，身死囹圄之中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490313,
					"content": "可惡！可惡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490314,
					"content": "對了，汝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490315,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "#是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490320,
					"content": "就是汝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490321,
					"content": "原本吾之聖服被放置於此，只可惜年月之久，僅餘殘絲敗縷，已難以作為憑依。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490322,
					"content": "只要汝能通過考驗，吾就將寄託意念的供奉之物託付於汝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490323,
					"content": "希望汝能…成功通過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490324,
					"content": "此事兇險，旅者啊，若汝準備好了，再與吾說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490317,
					"content": "派蒙，在叫妳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "#欸，他明明就在看著{F#妳}{M#你}嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490319,
					"content": "（而且眼神還相當熱切的樣子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
