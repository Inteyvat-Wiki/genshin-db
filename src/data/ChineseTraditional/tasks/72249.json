			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "好、好啊！如果是汝一定能做到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490202,
					"content": "吾委命於汝，將、將這些供奉之物…這些供奉之物…一定要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490203,
					"content": "一定要將之取走，拿到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490204,
					"content": "拿到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490205,
					"content": "怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490206,
					"content": "殘魂先生的聲音怎麼愈來愈模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490207,
					"content": "拿到…供奉之處…眾魂歸一，如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490208,
					"content": "殘魂先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490209,
					"content": "如此才能…如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490210,
					"content": "如此才能什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490211,
					"content": "如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490212,
					"content": "唔，不清不楚的，不過剛才聽殘魂先生的意思，好像是要把這些供奉品拿到什麼地方去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490213,
					"content": "這供奉品放在這裡這麼久，不知道裡面有沒有吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490214,
					"content": "妳別偷吃哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "我、我也不是什麼東西都吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490216,
					"content": "#好了，{NICKNAME}，收下供奉之物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224903,
