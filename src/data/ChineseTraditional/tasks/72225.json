			},
			"dialogs": [
				{
					"id": 722250101,
					"content": "好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}{F#姐姐}{M#哥哥}、派蒙！{F#妳}{M#你}們來得正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250103,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "腳扭到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250105,
					"content": "#阿久哥又受傷了，能請{F#妳}{M#你}們供奉棲木嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250106,
					"content": "這樣的發展也不是沒猜到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "沒問題，那就交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250109,
					"content": "太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250110,
					"content": "對了，阿瑠你不是也對「元素」很敏感嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250111,
					"content": "為什麼你不自己去供奉棲木呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250112,
					"content": "唔…以前我也在祭典裡做過各種各樣的事情，但最後的結果好像不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250113,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "我也不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250117,
					"content": "真沒辦法，那棲木就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250115,
					"content": "那就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "受傷的人就交給你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
