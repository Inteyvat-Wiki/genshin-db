				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "棲木煥發生機了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250302,
					"content": "供奉棲木，總算是完成了呢。真不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250303,
					"content": "哼哼，我們可是處理這種問題的專家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250304,
					"content": "和「導光儀式」差不多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "為了處理一件事，需要解決分散在三個地點的三個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250306,
					"content": "#總感覺，和{F#妳}{M#你}一起，總會遇到這種事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250307,
					"content": "雖然別的事情我不是很明白，但大人中有這樣的說法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250308,
					"content": "就是「萬事皆三」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250309,
					"content": "萬事皆三…是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250310,
					"content": "嗯…大概就是，任何事情都要經歷三次以後，才能迎來結果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250311,
					"content": "比如說，吉兆要發生三次，好運才會真正降臨。然後，如果凶兆發生了三次，那一定會發生壞事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250312,
					"content": "做事情的時候，也會遇到三次困難，第四次才會成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250313,
					"content": "但是，那樣的話，不應該是「萬事皆四」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250314,
					"content": "也是呢！派蒙的數學真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250315,
					"content": "哼哼，那當然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250316,
					"content": "重點是數學？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "話說回來，阿久的傷沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722250319,
					"content": "不用擔心哦。阿久哥總是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250320,
					"content": "真是難堪…希望不會影響祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250321,
					"content": "不然的話，就太對不起阿瑠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250322,
					"content": "怎麼會呢。阿久哥一直都對我很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "阿久"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}{F#姐姐}{M#哥哥}、派蒙，{F#妳}{M#你}們先走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250325,
					"content": "我陪阿久哥多坐一下。然後，再為供奉收尾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722250318,
					"content": "阿久受的傷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
