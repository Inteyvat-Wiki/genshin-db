			"dialogs": [
				{
					"id": 140160401,
					"content": "老實交代，你們是什麼人，為什麼要跟蹤我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160402
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160402,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160403
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160403,
					"content": "不要以為不說話就可以蒙混過關！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160404,
						140160405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160404,
					"content": "現狀如此，就不要心懷僥幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				},
				{
					"id": 140160406,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160407
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160407,
					"content": "#老闆，怎麼樣？{F#妳}{M#你}們沒受傷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160408
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160408,
					"content": "這種程度的敵人，怎麼能奈何得了我們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160409
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160409,
					"content": "好了，不要拖拖拉拉的，趕快交代。要是執律庭介入，這件事可就沒有商量的餘地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160410
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160410,
					"content": "我們…是來找刺玫會尋仇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160411
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160411,
					"content": "#被發現了，又打不過{F#妳}{M#你}們，我們自認倒楣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160412
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160412,
					"content": "尋仇？難道…你們是那個什麼，羅默夫的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160413
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160413,
					"content": "妳居然知道這個名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160414
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160414,
					"content": "那妳就應該知道我們的恨來自何處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160415
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160415,
					"content": "勸你冷靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160416
					]
				},
				{
					"id": 140160416,
					"content": "是的，你們現在毫無勝算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160417
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160417,
					"content": "呿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160418
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160418,
					"content": "#我們喝了點酒，在街上看到娜維婭，覺得很生氣，就想找機會找{F#妳}{M#你}們的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160419
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160419,
					"content": "#結果，反倒是被{F#妳}{M#你}們先抓到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160420
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160420,
					"content": "你在說謊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160421
					]
				},
				{
					"id": 140160421,
					"content": "啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160422,
						140160423
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160422,
					"content": "你們一路跟蹤到城裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160424,
					"content": "#很敏銳嘛，但那又怎麼樣？我們什麼都沒做，也沒有對{F#妳}{M#你}們做什麼的本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160425
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160425,
					"content": "#我們只是火氣上來，看{F#妳}{M#你}們很不爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160426
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160426,
					"content": "聽著，卡雷斯已經死了，無論刺玫會曾經做過什麼，我都希望能有一個新的開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160427
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160427,
					"content": "我是刺玫會的現任會長，如果你們的老大有什麼意見，我願意和他直接對話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160428
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160428,
					"content": "我不會追究你們的責任，這也是我態度的表示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160429
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160429,
					"content": "…嗯，謝謝妳。妳的想法，我會傳達給老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160430
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160430,
					"content": "但如果你們再敢做類似的事，哪怕是再有類似的想法，我絕不輕饒，知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160431
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160431,
					"content": "知道了知道了，喂，我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160432
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160432,
					"content": "放走他們真的沒問題嗎，娜維婭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160433,
					"content": "我不想繼承我老爹留下的矛盾，而且巡軌船的事，我也不認為他的做法就完全正確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160434
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160434,
					"content": "如果對方願意談，我也是願意配合的，很多事情都應該進入新的篇章了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160435
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160435,
					"content": "我也支持老闆的做法，以暴制暴是很原始的做法，在刺玫會的哲學中也毫無美感可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160436
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160436,
					"content": "嗯，而且科爾特也說過最近他們內部情況不好，掀不起什麼風浪，或許也會是他們最願意坐下來談的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160437
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160437,
					"content": "不過我認為還是要提防羅默夫的行動，如果他對我們這邊的警告視而不見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160438
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160438,
					"content": "恐怕到最後還是會演變成一場戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160439
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160439,
					"content": "至少他那邊的人看起來滿討厭刺玫會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160440,
					"content": "不要發展到那一步最好，畢竟…就算恩斷義絕，兩邊也曾是一家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160441
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160441,
					"content": "嗯，的確如此。好了，總之算是解決了吧？不用在乎這些討厭鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160442
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160442,
					"content": "今天有點晚了，我們去「灰河」休息一晚，明天再回白淞鎮好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160443
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160443,
					"content": "我會託人向弗洛朗寫封信，告訴他今天的遭遇，請他注意白淞鎮周邊的安全，提防可疑人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160444
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160444,
					"content": "又要住在「灰河」嗎？那裡的枕頭都有一股水草的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160445,
					"content": "沒辦法，很靠近水邊又沒什麼陽光，不過白淞鎮也差不多，我早就習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160446
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160446,
					"content": "晚上我們還可以去店裡吃烤魚、喝飲料、聽人唱船歌，不是也不錯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160447
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160447,
					"content": "有道理，妳說服我了！我們走吧，我也要唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160423,
					"content": "一定有所預謀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160405,
					"content": "我們上面和下面都有人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				}
			]
		},
