						"pointId": 340100402
					},
					{
						"sceneId": 3,
						"position": [
							3818.551,
							440.109,
							4335.818
						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "用自動魚竿釣魚，還算釣魚嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160702,
					"content": "嗯，怎麼了？這種魚竿在白淞鎮很常見啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160703,
					"content": "釣魚不是應該是…呃…非常投入地看著浮標，等魚上鉤，體會魚出水那一瞬間的驚喜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160704,
					"content": "#那也是一種方式啦。{NICKNAME}，{F#妳}{M#你}怎麼看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160705,
					"content": "手動比較好玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "自動比較輕鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "那下次我們就用普通的魚竿釣魚好了，比一比誰釣得比較多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160708,
					"content": "#哈哈，{F#妳}{M#你}也這麼覺得吧，不管怎麼樣，能釣到魚就開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160709,
					"content": "比起這個，我更想問為什麼娜維婭妳這麼有精神，這種時候我都…哈啊…想睡覺了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160710,
					"content": "天生的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160711,
					"content": "就這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160712,
					"content": "講得更詳細的話妳會更想睡覺的。我想，應該是多虧了刺玫會，還有我的母親吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160713,
					"content": "母親？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "我老爹從小就對我有很多不切實際的期待，他越是想要我和他一樣，我就越不想聽他的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160715,
					"content": "我母親就不一樣了，我聽說她對我只有一個期望——就是能開開心心地長大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160716,
					"content": "刺玫會的成員都很尊重她的想法，無論我去哪裡胡鬧，他們都願意慣著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160717,
					"content": "#{F#妳}{M#你}們可以想像嗎？我因為闖禍挨罵的時候，所有人站成兩排，邁勒斯和西爾弗也在，只有我老爹一個人大發雷霆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160718,
					"content": "大家都默不作聲，漸漸地就顯得為了小事而對我發脾氣的老爹很小氣，他也就只好閉嘴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160719,
					"content": "還有這種事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160720,
					"content": "是啊，現在想想，他們真的都是一群很溫柔的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160721,
					"content": "小時候的我一直認為我可以想做什麼就做什麼，因為總會有人幫我善後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160722,
					"content": "但是有一次邁勒斯受傷了，他不願意告訴我原因——但是我能夠感覺到是因為我的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160723,
					"content": "總會有人要為錯誤承擔責任，越是珍視周圍的人，就越不可以做錯事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160724,
					"content": "因為當錯誤的懲罰降臨時，那些人真的會不顧一切地為你挺身而出、為你付出代價…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160725,
					"content": "娜維婭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "妳果然還是很難過吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "對不起、對不起，不該提這個，今晚不想聊難過的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160728,
					"content": "總之就是，刺玫會有今天這樣的氛圍，一定不是因為我老爹，而是我的母親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160729,
					"content": "這或許是我感受母愛的唯一方式，我也想要把她的溫柔傳遞下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160730,
					"content": "所以妳才會放走今天的那些人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160731,
					"content": "嗯，或許也是過往的教訓吧…至少我不希望太過武斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160732,
					"content": "#欸，{F#妳}{M#你}看，{NICKNAME}，{F#妳}{M#你}那邊有水花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160733,
					"content": "但是為什麼魚竿不收線啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160734,
					"content": "應該是發條裝置沒裝好，我也是第一次組裝這種魚竿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160735,
					"content": "別讓牠跑了，我們抓住牠！快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160736,
					"content": "我、我也要來嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160737,
					"content": "#{F#妳}{M#你}們同心協力，總算把這條大魚釣了上來。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "妳這個沒有裝魚鉤啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
