			"dialogs": [
				{
					"id": 140160801,
					"content": "別再浪費時間了，老大耐心有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160802,
					"content": "明天就行動，你自求多福吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "馬蒂納"
				},
				{
					"id": 140160803,
					"content": "發條裝置不會動也是因為少裝了一個零件，這樣想的話，好像我們也算公平？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160804,
					"content": "只討論數量倒是沒錯啦…哈啊…不行了，我實在是撐不住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160805,
					"content": "哈哈哈，快去休息吧！今天我玩得很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160806,
					"content": "明天見，娜維婭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "嗯，明天見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160808,
					"content": "怎麼樣，昨天睡了個好覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160809,
					"content": "我夢見在和海星跳舞…應該算「還行」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160810,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160811,
					"content": "…妳從哪裡學來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "哈哈，沒想到妳還滿幽默的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160813,
					"content": "#{F#妳}{M#你}看，還是有人懂得欣賞嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160814,
