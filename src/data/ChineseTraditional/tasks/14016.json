			"dialogs": [
				{
					"id": 140160101,
					"content": "路德溫，我來了。這兩天生意怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160102,
					"content": "等不到刺玫會大小姐的光顧，我這小店馬上就要關門倒閉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "路德溫"
				},
				{
					"id": 140160103,
					"content": "呵呵，都知妳門路廣、方法多，妳開這種玩笑沒有人會信的。不過現在她已經是老闆了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160104,
					"content": "失敬失敬，哎呀，順口了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "路德溫"
				},
				{
					"id": 140160105,
					"content": "你們是來拿衣服的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "路德溫"
				},
				{
					"id": 140160106,
					"content": "對，之前在楓丹廷辦事的時候忘記了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160107,
					"content": "這點小事，請手下來辦也沒問題，大小姐竟然親自跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "路德溫"
				},
				{
					"id": 140160108,
					"content": "小題大做一直是娜維婭的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160109,
					"content": "並非小題大做，散心也是行程中很重要的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160110,
					"content": "沒有什麼比踏上一段新的旅程更能治癒身心的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160111,
					"content": "呵呵，老闆說的是，至少比一個人悶著還要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160112,
					"content": "那你們稍等，我這就去拿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "路德溫"
				},
				{
					"id": 140160113,
					"content": "對了，為什麼阿黛爾想要加入刺玫會呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160114,
					"content": "嘿嘿，她還說不清楚具體的理由，只是說因為很喜歡我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160115,
					"content": "在那件事之後她變得開朗了不少，大概是因為她終於知道，她的父親並不是個讓她失望的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160116,
					"content": "她說她很害怕我的老爹，所以覺得刺玫會裡都是可怕的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160117,
					"content": "但現在刺玫會的氛圍不一樣了，她有勇氣和我說話，也覺得我能夠理解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160118,
					"content": "妳們有類似的遭遇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "嗯，或許是吧。我在尋找真相的同時也幫助了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160120,
					"content": "她說也想要像我一樣去幫助別人，而不是繼續在原地等，期待別人朝她伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160121,
					"content": "聽起來，她會成為一個優秀的刺玫會成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160122,
					"content": "我也這麼認為，但首先還是要創造一個能讓她健康成長的環境吧，等她長大再把選擇權交給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160123,
					"content": "（果然不是錯覺…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "#嗯？{F#妳}{M#你}怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160125,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "欸？跟、跟蹤？！我來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160128,
					"content": "我也去看看！科爾特，衣服你幫我拿一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160129,
					"content": "哦…好、好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160126,
					"content": "有人跟蹤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
