				]
			},
			"dialogs": [
				{
					"id": 140160601,
					"content": "享用晚餐、觀看表演，熱鬧的夜晚漸漸過去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "#一切轉為安寧，{F#妳}{M#你}和派蒙回到房中，卻聽見敲門聲…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "睡了嗎？還沒有吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160604,
					"content": "娜維婭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "沒什麼，只是覺得難得有這樣的夜晚，不應該就這麼結束，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160607,
					"content": "想去釣魚嗎？我已經準備好裝備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160608,
					"content": "這就是妳晚餐之前說的「準備」吧！那我們馬上來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160609,
					"content": "#嘿嘿！沒打擾到{F#妳}{M#你}們休息吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160610,
					"content": "還好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "#放心，我考慮到{F#妳}{M#你}可能會沒精神，已經做好準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160612,
					"content": "就當陪我聊聊天，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160615,
					"content": "走吧走吧，釣魚去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160613,
					"content": "既然是妳的邀請…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "嘿嘿，不愧是我的好搭檔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160605,
					"content": "怎麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
			"id": 1401607,
			"completionStepIds": [
				1401607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
