			},
			"dialogs": [
				{
					"id": 140160501,
					"content": "再次來到這個地方，總覺得有點親切感了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160502,
					"content": "如果刺玫會在楓丹廷的據點是像沫芒宮那樣富麗堂皇的地方，反而會覺得很奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160503,
					"content": "哈哈哈，的確如此，我也這麼覺得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160504
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160504,
					"content": "只不過在我老爹的想像中，等刺玫會越來越好，白淞鎮也會成為不輸給楓丹廷的大城市。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160505
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160505,
					"content": "他是個野心很旺盛的人，很少考慮到現實情況，所以他才會有很多異於常人的特質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160506
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160506,
					"content": "也就是這一點，讓人們對卡雷斯先生總是又愛又恨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160507
					],
					"speakerTitle": "科爾特"
				},
				{
					"id": 140160507,
					"content": "#好了，{F#妳}{M#你}們去店裡等我，我去裡面做些準備，順便也叫人把{F#妳}{M#你}們的住處整理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160508
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160508,
					"content": "房間還是和上次一樣，沒有忘記是哪一間吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160509
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160509,
					"content": "嗯，反正又沒有幾間房間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160510,
					"content": "妳這傢伙，想說這地方寒酸對吧！我現在就去把妳的枕頭塞滿水草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160511
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140160511,
					"content": "對不起、對不起，那就真的要睡不著了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160512,
					"content": "#哈哈哈！開玩笑的，{F#妳}{M#你}們先過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				}
			]
		},
