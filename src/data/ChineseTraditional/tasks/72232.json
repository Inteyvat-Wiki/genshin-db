						722320305
					],
					"speakerTitle": "工整的字條"
				},
				{
					"id": 722320305,
					"content": "（在紙條的一側還有一些細小文字：）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320306
					],
					"speakerTitle": "工整的字條"
				},
				{
					"id": 722320306,
					"content": "「…前來尋回此報告的愚人眾新募人員，須盡快前往島嶼西側港口，與接洽情報官會合。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320307
					],
					"speakerTitle": "工整的字條"
				},
				{
					"id": 722320307,
					"content": "「口令為：『笑死我了』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "工整的字條"
				}
			]
