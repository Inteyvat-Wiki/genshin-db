			"trigger": {
				"objectNames": [
					"？？？",
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320401,
					"content": "止步！平民，為了自身安全，請離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320402,
					"content": "不好意思，我們不是平民。而且我們來這裡是有原因的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320403
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320403,
					"content": "我們是來接洽愚人眾情報官的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320404
					]
				},
				{
					"id": 722320404,
					"content": "#我不知道{F#妳}{M#你}們在說什麼…這裡是私人領地，請不要和我們搭話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320405,
					"content": "穿著這樣過分浮誇的衣服，手裡拿的武器既不像幕府軍的裝備、也不像珊瑚宮軍的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320406
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320406,
					"content": "看起來隨時要跑路，一副不懷好意的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320407
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320407,
					"content": "你們還是多在意一下偽裝比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320408
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320408,
					"content": "我看起來像是會開玩笑的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320409,
					"content": "#好了，不說笑了。我們是從蛇骨礦洞那邊來的。{NICKNAME}，請證明給他看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320410
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320410,
					"content": "笑死我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320411
					]
				},
				{
					"id": 722320411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320413
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320413,
					"content": "#歡迎加入愚人眾，我是{F#妳}{M#你}們的接應人，海務準尉鮑連卡。今後{F#妳}{M#你}們要叫我「長官」，聽懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320414,
					"content": "#他們和我說，勘定奉行那些丟了官職、沒了俸祿的前部屬很快就會取到我們想要的東西…沒想到只有{F#妳}{M#你}們兩個。我還以為會有很多人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320415,
					"content": "一個是說話很不客氣的巫女，還有一個是…外國人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320416
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320416,
					"content": "#{F#妳}{M#你}們都不是武士嗎？哼，柊慎介那傢伙的用人眼光還真是有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320417,
						722320418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320417,
					"content": "確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320419
					]
				},
				{
					"id": 722320419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320420
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320420,
					"content": "…長官。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320421
					]
				},
				{
					"id": 722320421,
					"content": "我們之前進行了一些…管理層變動。所以你也明白，從結果上來說，有的人可以贏得新工作，有的人就只能落進海裡，什麼也留不下囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320422
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320422,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320423
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320423,
					"content": "…長官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320424
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320424,
					"content": "#嗯，{F#妳}{M#你}說得對。我不關心{F#妳}{M#你}們之前發生了什麼，我想要的只有結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320425
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320425,
					"content": "#把「內森」留下的報告交給我，然後上船。這是一個簡單的命令，希望{F#妳}{M#你}們能夠好好執行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320426
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320426,
					"content": "就在這裡了…長官。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320427
					]
				},
				{
					"id": 722320427,
					"content": "#很好。{F#妳}{M#你}們在這裡的工作結束了，還有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320428
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320428,
					"content": "我們之後還有什麼任務嗎，長官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320429
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320429,
					"content": "#與我何干？我只負責把{F#妳}{M#你}們運回至冬國，之後的行動就要聽從上面的意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320430
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320430,
					"content": "上面沒有透露任何消息嗎，長官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320431
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320431,
					"content": "#與{F#妳}{M#你}何干？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320432
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320432,
					"content": "你說得對，長官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320433,
						722320434
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320433,
					"content": "（可以動手了嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320435
					]
				},
				{
					"id": 722320435,
					"content": "（請您再等一下，我想試試看套些情報。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320436
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320436,
					"content": "#我還在這裡呢，{F#妳}{M#你}們兩個在鬼鬼祟祟說什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320437
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320437,
					"content": "抱歉，關於將來需要我們執行的任務，許多細節我們還不清楚，請問長官可不可以為我們講解？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320438
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320438,
					"content": "#我沒有義務跟{F#妳}{M#你}們講解命令，留給{F#妳}{M#你}們的選擇只有執行，或者被我教訓一頓，然後執行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320439
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320439,
					"content": "抱歉，或許你沒有聽明白。我的意思是…咳咳，請問你可不可以把你所知道的，全都毫無保留地告訴我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320440
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320440,
					"content": "妳是不是忘了什麼，新兵…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320441
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320441,
					"content": "我什麼也沒有忘記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320442
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320442,
					"content": "相反，我什麼都記得清清楚楚。我相信我身邊的這位珊瑚宮將領也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320443
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320443,
					"content": "#{F#妳}{M#你}…珊瑚宮？！我就知道…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320444
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722320444,
					"content": "是啊，你可真了不起…不過我已經聽煩你的話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320445
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320445,
					"content": "你們在八醞島的秘密行動、你們煽動海祇島激進派破壞鎮物的罪證，你們勾結失主武士的證據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320446
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320446,
					"content": "以及剛剛對一位珊瑚宮巫女的羞辱，我都記錄在案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320447
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320447,
					"content": "前面幾個問題或許會作為外交事件進入珊瑚宮的備忘錄。而最後的那個問題，我希望你能夠親自負責，「長官」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320448
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320448,
					"content": "對了，我一開始就忠告過了，你們還是多在意一下偽裝比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320449
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320449,
					"content": "#請您動手吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320434,
					"content": "（我們還要繼續和他扮家家酒嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320435
					]
				},
				{
					"id": 722320418,
					"content": "很難和你解釋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320419
					]
				}
			]
		},
