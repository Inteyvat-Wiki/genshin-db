	"talks": [
		{
			"id": 7223201,
			"completionStepIds": [
				7223201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223201",
							"2"
						],
						"stepId": 7223201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320101,
					"content": "#您好，{NICKNAME}。請問方便談一些事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320102
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320102,
					"content": "實在抱歉打擾您，但事關重大…現人神巫女大人吩咐我一定要找到您才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320103,
						722320105
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320103,
					"content": "畢竟我是「劍魚」二番隊隊長嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320104
					]
				},
				{
					"id": 722320104,
					"content": "是這樣沒錯，所以這件事情，相信您一定也能夠漂亮完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320106
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320106,
					"content": "多虧了您的傾力幫助，我們在與幕府的戰爭中逆轉了劣勢…按照當前的局面，長期停戰應該是大勢所趨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320107
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320107,
					"content": "我們贏回了和平，掃除了「眼狩令」，而一直盤剝我們的惡奉行終於倒台…大御神的遺骨也獲得了寧靜，這些都多虧了您的努力。請容我再次感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320108
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320108,
					"content": "但殘餘的愚人眾勢力仍然沒有放棄在八醞島四處探查。儘管他們在戰爭中失去了一個「執行官」，另一個「執行官」也不知所蹤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320109
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320109,
					"content": "關於「愚人眾」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320110
					]
				},
				{
					"id": 722320110,
					"content": "海祇島資訊長期不流通，這場戰爭可以說製造了我們與這些傢伙接觸的緣由。以這樣的方式相識，還真是糟糕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320111
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320111,
					"content": "他們似乎是想要將這場戰爭拖成持久戰，並且意圖煽動起雙方民眾的仇恨，以此提升戰爭烈度…相比起幕府軍，他們是更加危險的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320112
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320112,
					"content": "假如戰爭遷延日久，它所造成的嚴重經濟匱乏與社會緊張，就會極大地方便「愚人眾」在兩方的夾縫中擴張自己的影響力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320113
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320113,
					"content": "幸好現人神巫女大人及時發覺了他們的陰謀，以及您和許許多多將士們的奮戰…我們才得以及時制止愚人眾的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320114
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320114,
					"content": "我需要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320115
					]
				},
				{
					"id": 722320115,
					"content": "根據我們的情報，仍有一些被愚人眾滲透的幕府軍軍士潛伏在八醞島，正蒐集資訊、密謀著什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320116
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320116,
					"content": "向您提出這樣的請求實在是迫不得已，但現人神巫女大人認為您是處理此事最為保險的人選…所以還得勞煩您隨我一同前往大御神殉身之處找那些傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320117
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320117,
					"content": "首先由我以言語溝通勸阻。如果他們仍執意挑起紛爭、不願悔改，那便煩請您使用武力說服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320118
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320118,
					"content": "就這麼簡單？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320119
					]
				},
				{
					"id": 722320119,
					"content": "簡單嗎？啊…不愧是您，對您而言，這或許就是舉手之勞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320120
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320120,
					"content": "但唯一的難點是…您太出名了，對方可能一眼就能認出來。事出突然，我們也沒時間易容了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320121
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320121,
					"content": "我有這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320122
					]
				},
				{
					"id": 722320122,
					"content": "好直接的偽裝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320123
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320123,
					"content": "#唔…不過不知為什麼，我也險些沒認出來您呢。和作為「劍魚」二番隊隊長的{NICKNAME}相比，確實在氣質上有明顯的不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320124
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320124,
					"content": "那就這樣吧，準備好了就請隨我出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320105,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320106
					]
				}
			]
		},
		{
			"id": 7223202,
			"completionStepIds": [
				7223202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223202",
							"2"
						],
						"stepId": 7223202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蠻橫的武士",
					"思鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320201,
					"content": "留步，庶民！幕府轄地，無關人士速速離去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320202
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320202,
					"content": "庶民？…我是珊瑚宮特使思鶴，來此巡查大御神殉身之所的現狀。你的上司沒有通知你嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320203
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320203,
					"content": "#珊瑚宮的人…？沒有，我從來沒有接到過通知。請{F#妳}{M#你}們立刻離開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320204
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320204,
					"content": "這與我們雙方先前的停戰協定不符，武士先生。請你報上名來，我會讓你的上司知道你的無理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320205
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320205,
					"content": "抱歉，我不覺得有那個必要，珊瑚宮的小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320206
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320206,
					"content": "倒是妳，最好不要再靠近礦洞了，如若繼續挑釁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320207
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320207,
					"content": "那麼，破壞停戰的罪名不是一般人能承受的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320208
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320208,
					"content": "沒錯，破壞停戰的罪名不是一般人能承受得了的…正因如此，我才希望你們能停止褻瀆神體，體面且安全地離開大御神殉身之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320209
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320209,
					"content": "哈！「神體」！「殉身之地」！呸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320210
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320210,
					"content": "沒錯。我們已經給了你們足夠的時間，可以有條有序地逐步撤離這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320211
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320211,
					"content": "呵，你們海祇島的人，說話太好笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320212
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320212,
					"content": "這就是你們打仗的目的嗎？為了死去的神？但是你們的大蛇早就成了礦洞裡那些亮晶晶的石頭，成了我們的劍了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320213
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320213,
					"content": "曾經你們俯首大蛇，後來你們俯首在它的遺骨熔煉打造成的劍下，兩種命運不都是差不多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320214
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320214,
					"content": "請注意你的言辭，武士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320215
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320215,
					"content": "既然不樂意追隨將軍殿下，我們也給了你們選擇，對吧？作為聽話的庶民活下去不好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320216
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320216,
					"content": "當年是將軍殿下一時憐憫才留你們存活的，如此大恩不謝，如今居然還要對抗幕府…你們真的以為一時反逆能給你們帶來什麼好下場？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320217
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320218
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320218,
					"content": "哼，瞧瞧你們幹的好事吧…藉著推翻「眼狩令」，你們奪去了多少人的生路？奪去了多少稅源！沒有了稅源，你們又讓我們吃什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320219
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320219,
					"content": "如果不是柊大人因為你們而被廢黜，我們這些體面武士怎會淪落至此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320220
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320220,
					"content": "我和妳說這麼多幹什麼…你們這些小島上的窮酸鄉巴佬，什麼也不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320221
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320221,
					"content": "總之，我見到你們就煩，趕快滾吧…除非妳存心惹事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320222
					],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320222,
					"content": "「柊大人」，是嗎…呵呵，我是不會破壞停戰協議的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320223
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320223,
					"content": "相反，現人神巫女大人交給我的任務，是清理掉企圖破壞和平的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320224
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320224,
					"content": "#{NICKNAME}，您可以動手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320225,
						722320227
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320225,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320226
					]
				},
				{
					"id": 722320226,
					"content": "什麼…妳怎麼…敵襲！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蠻橫的武士"
				},
				{
					"id": 722320227,
					"content": "可是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320228
					]
				},
				{
					"id": 722320228,
					"content": "就是他了，總之請先將他制服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320229
					],
					"speakerTitle": "思鶴"
				},
				{
					"id": 722320229,
					"content": "果然，妳…敵襲、敵襲！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蠻橫的武士"
				}
			]
		},
