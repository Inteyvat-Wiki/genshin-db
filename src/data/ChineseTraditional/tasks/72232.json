			},
			"dialogs": [
				{
					"id": 722320601,
					"content": "「…請務必盡快撤離，將尋回『內森』秘密報告的稻妻新兵交予首席執行官大人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320602
					],
					"speakerTitle": "鮑連卡的「指令」"
				},
				{
					"id": 722320602,
					"content": "「以此斷絕後患，不可將八醞島事件之內幕向任何方面透露。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320603
					],
					"speakerTitle": "鮑連卡的「指令」"
				},
				{
					"id": 722320603,
					"content": "「新兵本身於『愚人眾』之共同目標或無價值，亦無甚培養必要。但作為活體樣本，於科學研究甚為方便。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鮑連卡的「指令」"
				}
			]
		}
	]
}