			"dialogs": [
				{
					"id": 210230201,
					"content": "樓梯還是得趕緊修了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230202,
					"content": "你是掌櫃的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "我是，您有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230204,
					"content": "有一份給你的包裹，是樓下的一個人要我們送給你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210230205,
					"content": "哦…這應該是客商給我的包裹…甄強怎麼自己不來送？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230206,
					"content": "他還有貨要接？唉，他準是嫌上上下下麻煩，懶得上來又下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230207,
					"content": "您是客人吧，實在對不住，這樓梯壞得太不是時候了，我正尋思著怎麼修呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230208,
					"content": "真是麻煩了，還讓您來送這個包裹給我，這樣，這份報酬給您，您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230209,
					"content": "這本來是給甄強準備的，但既然他讓您來送了這個包裹，那這份報酬當然該您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210230210,
					"content": "好了，我接著去籌備修樓梯的事了，您隨意在客棧裡逛逛，有什麼事您隨時找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
	]
