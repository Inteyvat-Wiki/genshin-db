					{
						"sceneId": 3,
						"position": [
							4410.831,
							150.124,
							4633.232
						],
						"pointId": 6132
					}
				]
			},
			"dialogs": [
				{
					"id": 140040801,
					"content": "出來吧，我們把帽子帶回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040802,
					"content": "#真的嗎？太謝謝{F#妳}{M#你}們了！我這就出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040803
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040803,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040804
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040804,
					"content": "什麼嘛，你不是有頭髮嗎？還這麼濃密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040805,
					"content": "#唉，我就說{F#妳}{M#你}們誤會了，不是那麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040806
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040806,
					"content": "等一下，這個不是我丟掉的那頂帽子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040807
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040807,
					"content": "因為你說的那頂帽子實在是找不到了，所以我們去買了新的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040808,
					"content": "準確的說是別人送的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040809
					]
				},
				{
					"id": 140040809,
					"content": "#哦，原來是這樣，謝謝{F#妳}{M#你}們。但很不好意思，對我來說，不是原來的那頂帽子就不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040810
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040810,
					"content": "因為有什麼紀念意義嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040811,
					"content": "這個，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040812
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040812,
					"content": "抱歉，我也解釋不清楚。時間很緊迫，我再去周圍找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040813
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040813,
					"content": "帽子的話，我剛剛在下面撿到一頂，這是你的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040814
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040814,
					"content": "公爵大人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040815
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040815,
					"content": "哦，是萊歐斯利，有一陣子不見了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040816,
					"content": "今天沒什麼事，就到處巡視一下。我辦公的地方雖然寬敞，但待久了也難免覺得悶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040817
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040817,
					"content": "#{F#妳}{M#你}們還是老樣子，只要有人需要幫忙，無論事情大小，都不會拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040818
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040818,
					"content": "這就是冒險家的精神嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040819,
					"content": "呵，都想讓他們到梅洛彼得堡開個分部了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040820
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040820,
					"content": "對你們「簷帽會」來說，帽子是非常重要的東西吧，這可不能隨便亂丟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040821
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040821,
					"content": "不然下次大概就沒有這樣的好運氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040822
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040822,
					"content": "明白了，非、非常感謝，公爵大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040823
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040823,
					"content": "那…那我先走了，呃，我…我先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040824
					],
					"speakerTitle": "費索勒"
				},
				{
					"id": 140040824,
					"content": "好怪的人，完全搞不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040825,
					"content": "他是做了什麼虧心事嗎？怎麼看到你就像丟了魂一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040826,
					"content": "怎麼會，恰恰相反，「簷帽會」的人從不惹事生非，工作態度積極向上，很讓我放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040827
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040827,
					"content": "他的話，我想只是比較內向吧，突然看到我大概有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040828
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040828,
					"content": "啊？內向…還有內向的罪人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040829,
					"content": "地面之上有千百罪名，犯罪者亦有千百動機，「罪人」只不過是一個歸類標籤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040830
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040830,
					"content": "無論是「邪惡」，還是「暴戾」，還是「自私」，都不足以描述複雜的人性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040831
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040831,
					"content": "他是什麼樣的人，又為什麼會定罪，不去了解他的故事就無從得知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040832
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040832,
					"content": "有道理，反正只要你不在乎就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040833,
						140040834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040833,
					"content": "「簷帽會」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				},
				{
					"id": 140040835,
					"content": "雖然絕大多數的幫會只是讓罪人間的鬥毆變成群毆而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040836
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040836,
					"content": "但「簷帽會」的確是在嘗試一些比較新鮮有趣的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040837
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040837,
					"content": "#{F#妳}{M#你}們現在有時間嗎？不妨隨我去特許餐廳坐一坐，正好我也想和{F#妳}{M#你}們聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040838
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040838,
					"content": "#在那之後如果感興趣的話，我還可以帶{F#妳}{M#你}們去「簷帽會」的休息處看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040839
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040839,
					"content": "我對那個餐廳沒什麼好印象，不過反正也沒事情做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040840,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040841
					]
				},
				{
					"id": 140040841,
					"content": "那麼請隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040834,
					"content": "還有人會認真工作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				}
			]
		},
		{
			"id": 1400409,
			"completionStepIds": [
				1400409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
