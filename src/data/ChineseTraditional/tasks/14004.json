					},
					{
						"sceneId": 3,
						"position": [
							4485.177,
							121.596,
							4596.509
						],
						"pointId": 6133
					},
					{
						"sceneId": 3,
						"position": [
							4483.128,
							121.648,
							4596.076
						],
						"pointId": 6135
					}
				]
			},
			"dialogs": [
				{
					"id": 140040901,
					"content": "這不是公爵大人還有旅行者嘛，歡迎來到特許餐廳，需要今天的福利餐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040902
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040902,
					"content": "不過公爵大人應該提前打個招呼，超豪華福利餐今天可是一份也沒有做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040903
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040903,
					"content": "#那我就不用了。{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040904,
						140040905
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040904,
					"content": "我不餓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				},
				{
					"id": 140040906,
					"content": "我…我也不要，我寧願把肚子留給更好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040907,
					"content": "真可惜，看來我們都欣賞不了韋爾賽你的手藝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040908
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040908,
					"content": "哈哈，那只能請公爵大人想想辦法，多幫我安排點食材種類，這樣我才能開發出更多套餐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040909
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040909,
					"content": "#不需要食物的話，我幫{F#妳}{M#你}們上幾瓶飲料吧，都是剛到貨的好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040910
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040910,
					"content": "這個還不錯，原來你這裡不只有福利餐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040911,
					"content": "#一般人可享受不到，這是公爵大人和{F#妳}{M#你}們的獨家待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040912
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040912,
					"content": "嘿嘿，我就喜歡獨家待遇，那給我兩瓶，我很能喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040913,
					"content": "好嘞，稍等哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040914
					],
					"speakerTitle": "韋爾賽"
				},
				{
					"id": 140040914,
					"content": "過了一會，韋爾賽把飲料送了上來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140040915
					]
				},
				{
					"id": 140040915,
					"content": "#之前的見面略顯倉促，後來又發生了這樣那樣的事，一直沒有機會和{F#妳}{M#你}們聊些私人話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040916
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040916,
					"content": "#我是個很喜歡聽故事的人，之前聽說了{F#妳}{M#你}們在楓丹的種種事蹟，很想聽聽真實情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040917
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040917,
					"content": "要聊這個可就有的說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040918,
						140040921,
						140040924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040918,
					"content": "戰天鬥地，行俠仗義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040919
					]
				},
				{
					"id": 140040919,
					"content": "不錯不錯。既有勇氣投身危險的事件，又有能力全身而退，這可不是隨便什麼人都能做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040920
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040920,
					"content": "#要不是{F#妳}{M#你}們有這樣可貴的特質，我可能根本沒有機會與{F#妳}{M#你}們兩位結識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040927,
					"content": "感覺你一直在挑好聽的話說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040928,
					"content": "之前那個賣帽子的人明說想要巴結我們，但你是這裡的「公爵」，沒有理由這麼做吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040929,
					"content": "#畢竟{F#妳}{M#你}們也幫助了梅洛彼得堡，讓我能繼續在這地方自娛自樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040930
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040930,
					"content": "只是出於單純的敬佩，表達適度的讚揚，難道很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040931,
						140040932
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040931,
					"content": "說實話，有點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040933,
					"content": "原來如此，是信任感的原因啊。沒辦法，誰叫我的故事不值一提呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040934
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040934,
					"content": "我很早就成為罪人被扔到了這裡，摸爬滾打很長時間之後，才當上了這裡的老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040935
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040935,
					"content": "手段也是多種多樣、有黑有白，只不過在這個地方，沒有罪加一等，只有勝者為王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040936
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040936,
					"content": "怎麼樣，就算知道了這些，也不能提升信任感吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040937
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040937,
					"content": "也是啊，你和我們一路上遇到的人都不太一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040938,
					"content": "#呵呵，在這點上我也有自知之明。不過這也不影響我對{F#妳}{M#你}們另眼相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040939
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040939,
					"content": "——我很願意把我們的友善關係保持下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040940,
						140040941
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040940,
					"content": "我也是這樣的態度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040942,
					"content": "公爵大人，按照你的指示，我們果然在貨物堆裡找到了一箱未經報備的違禁品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040943
					],
					"speakerTitle": "格萊"
				},
				{
					"id": 140040943,
					"content": "東西隱藏得很好，對方已經不是第一次做這樣的事了，貨物的源頭我們正在追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040944
					],
					"speakerTitle": "格萊"
				},
				{
					"id": 140040944,
					"content": "好的，有進展及時通知我，東西留下，先回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040945
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040945,
					"content": "是的，公爵大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040946
					],
					"speakerTitle": "格萊"
				},
				{
					"id": 140040946,
					"content": "抱歉，我都差點把這件事忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040947
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040947,
					"content": "違禁品是什麼？該不會是很危險的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040948
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040948,
					"content": "應該不是，通常提到違禁，往往是想要偷偷運進來的貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040949
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040949,
					"content": "罪人們很多都身懷絕技，就算很普通的東西也能玩出花來，所以在物品管理上需要格外注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040950
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040950,
					"content": "讓我看看…嗯，和預想中差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040951
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040951,
					"content": "哇，有摩拉、小零食、毛線團、繩子、機器零件，還有寶石！收獲好豐富啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040952
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040952,
					"content": "等等，既然被你收繳了，也就是說…這些東西現在都歸你所有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040953
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040953,
					"content": "嗯，不然也沒別的處理方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040954
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040954,
					"content": "#那不是賺瘋了嗎？！{NICKNAME}，{F#妳}{M#你}要不要也搞個「公爵」來當當！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040955,
						140040957
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040955,
					"content": "那派蒙妳呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040956
					]
				},
				{
					"id": 140040956,
					"content": "我當倉庫管理員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040959,
					"content": "沒想到妳會這麼喜歡，那這樣吧，這裡妳隨便挑一個東西，算我送妳的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040960
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040960,
					"content": "真的嗎？隨便一個都行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040961
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040961,
					"content": "你可不要反悔哦，我下手超狠的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040962
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040962,
					"content": "我怎麼會用這種事開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040963
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040963,
					"content": "那…我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040964
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040964,
					"content": "就它了，這個黑黑的寶石，一看就是高級貨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040965
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040965,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040966
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040966,
					"content": "我不要了。我不喜歡這個，換一個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040967,
						140040968
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040967,
					"content": "怎麼了，派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040969,
					"content": "這個石頭很奇怪，拿起來之後我就想起來很多不開心的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040970
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040970,
					"content": "控制都控制不住，什麼討厭的想法都冒了出來…我覺得這個東西很不對勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040971
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040971,
					"content": "是這樣嗎？我來試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040972
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040972,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040973
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040973,
					"content": "派蒙說的沒錯，我也看到了一些不是很愉快的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040974
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040974,
					"content": "也讓我試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040975
					]
				},
				{
					"id": 140040975,
					"content": "沒關係嗎？這種體驗真的不算好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040976,
						140040977
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040976,
					"content": "我想和你們資訊一致。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040978,
					"content": "#原來如此，那{F#妳}{M#你}來試試吧，我想它對身體應該沒有壞處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040979
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040979,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040980
					]
				},
				{
					"id": 140040980,
					"content": "#怎麼樣，{NICKNAME}，{F#妳}{M#你}也看到了什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040981,
						140040982
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040981,
					"content": "嗯，確實如你們所說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040983,
					"content": "這個寶石就由我來保管，之後我會好好調查一番，派蒙選個其他的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040984
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040984,
					"content": "那…唉，算了，我不要了。本來想選小零食的，現在都有點不敢吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040985,
						140040986
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040985,
					"content": "同意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040987,
					"content": "有道理，保險起見，還是把整箱東西全部銷毀吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040988
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040988,
					"content": "#正好飲料喝得差不多了，接下來我帶{F#妳}{M#你}們去「簷帽會」看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040989
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040989,
					"content": "#我來為{F#妳}{M#你}們介紹，順便我們還能繼續聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040990
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040990,
					"content": "你該不會平時每天都這麼閒吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040991
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040991,
					"content": "妳才發現？我們第一天見面時不也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040986,
					"content": "謹慎是正確的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040982,
					"content": "至少都是…印象深刻的記憶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040977,
					"content": "我的體質比較特殊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040968,
					"content": "不舒服嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040957,
					"content": "「公爵」的稱號歸我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040958
					]
				},
				{
					"id": 140040958,
					"content": "哦？我們剛剛才達成了和平意向，現在就要搶我位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040941,
					"content": "感謝你的招待，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040932,
					"content": "因為你幾乎不提你自己的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040921,
					"content": "一點點暸解了這個國度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040922
					]
				},
				{
					"id": 140040922,
					"content": "原來如此，確實很有旅行者的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040923
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040923,
					"content": "#沿途記錄所見所聞、廣交朋友，{F#妳}{M#你}的視野和機遇將超過所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040924,
					"content": "其實都和我關係不大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040925
					]
				},
				{
					"id": 140040925,
					"content": "呵呵，這種回答未免太謙虛了一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040926
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040926,
					"content": "#或許只是{F#妳}{M#你}一個不經意的舉動，就催生出了新的變化，扭轉了既定的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140040905,
					"content": "沒有豪華版就算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				}
			]
		},
