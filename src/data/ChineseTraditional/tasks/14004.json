			"dialogs": [
				{
					"id": 140040501,
					"content": "水裡也沒有，還以為會被吹進去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040502,
					"content": "不知道掉到什麼地方去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040503,
						140040504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040503,
					"content": "放棄吧，這裡太大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				},
				{
					"id": 140040505,
					"content": "也對啊，不想被人看到禿頭的話，只要有帽子遮住就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040506,
					"content": "我們可以去「破爛骨頭商店」看看，我印象中那邊雜七雜八的什麼都有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040507,
						140040509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040507,
					"content": "怎麼說到商店就興奮起來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040508
					]
				},
				{
					"id": 140040508,
					"content": "嘿嘿，因為順手還能買點其他東西啊，去都去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040512,
					"content": "走吧，先過去看看再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040509,
					"content": "…先說好，只買帽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040510
					]
				},
				{
					"id": 140040510,
					"content": "#欸？{F#妳}{M#你}怎麼知道我在盤算什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040511,
					"content": "#唉，{NICKNAME}{F#妳}{M#你}越來越不好對付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040504,
					"content": "不如直接去買一個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				}
			]
		},
