					}
				]
			},
			"dialogs": [
				{
					"id": 751340201,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "呃啊，外面都被深淵侵蝕了，感覺隨時會掉下來的樣子，綠寶指給我們的難道就是這個東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340203,
					"content": "也不知道那裡面是什麼東西，反正我覺得一定不會是什麼祭壇啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340204,
					"content": "「只是一板一眼地依靠邏輯的話…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "啊啊，我知道啦。而且就是因為這些深淵，綠寶才會不願意進來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340206,
					"content": "不能放著深淵不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "沒錯，綠寶就是因為這些深淵才會不願意進來的吧，不能放著不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340208,
					"content": "#出發了，{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "喂，你們兩個怎麼把我排除了啦，好過分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340211,
					"content": "總之我們就先把這些髒東西清理掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
