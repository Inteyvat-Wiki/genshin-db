				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喀什米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "「二十年前的事」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "…看來我實在不該到處說。上次喝多了酒嘮叨了幾句，結果最近一直有人來問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200205,
					"content": "#既然{F#妳}{M#你}們好奇，我就再講講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200206,
					"content": "二十年前，我只是個六歲的毛頭小子。當時發生的事，我已經完全記不清了。前段時間看了小時候寫的日記，才朦朧地回憶起當時的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200207,
					"content": "那年也辦了學院爭霸賽，比賽共三輪，最後一輪是在城外。我就央求老媽帶我出城去看，她不答應，我就偷偷跑了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200208,
					"content": "然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200209,
					"content": "然後我就在城外迷路了。荒郊野嶺，一個人都沒有。我越來越怕，忍不住哭了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200210,
					"content": "就在這時，我看到一些奇特的生物…我已經記不起它們的長相了，只記得當時還是孩子的我看到它們，很快就不哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200211,
					"content": "奇特的生物，難道說是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200212,
					"content": "（是蘭那羅吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "它們帶我去了比賽現場。可惜到那裡的時候已經太晚，比賽早就結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200214,
					"content": "就在我心灰意冷的時候，我忽然看到一個奇特的生物拖著一頂王冠慢慢地走著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200215,
					"content": "那王冠很漂亮，在月光下閃閃發亮，我忍不住跟了上去。我看到那個小傢伙將王冠藏進了一個樹洞裡，然後就消失不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200216,
					"content": "我很想去摸一摸那頂王冠。但就在這個時候，遠處傳來了老媽的呼聲。原來她發現我走丟了，就請左鄰右舍一起來找我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200217,
					"content": "我最後也沒有摸到那頂冠冕，直到後來我長大了，在學院爭霸賽現場見到「才識之冠」，才恍然發覺似乎是同一個東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200218,
					"content": "好吧…你還記得那個王冠最後被放在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200219,
					"content": "好像是在道成林，不過我後來去找過幾次，都沒有發現任何線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200220,
					"content": "就算我說了也沒人相信。唉，連我自己也記不清楚了，可能是我小時候做的一個夢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "喀什米"
				},
				{
					"id": 735200221,
					"content": "#嗯…{NICKNAME}，我們要不要去找找看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
