			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "這裡好像有個樹洞，不過裡面是空的，什麼都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200302,
					"content": "嗯？等等，這裡面好像有張字條！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200303,
					"content": "「好那菈教蘭迦葉波識字，蘭迦葉波要保護好那菈…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735200304,
					"content": "這是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7352022,
