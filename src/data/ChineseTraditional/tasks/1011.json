						10110712
					]
				}
			]
		},
		{
			"id": 10110721,
			"completionStepIds": [
				101111
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101111",
							"2"
						],
						"stepId": 101111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110721,
					"content": "我要「二號夜泊石」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110722
					]
				}
			]
		},
		{
			"id": 10110731,
			"completionStepIds": [
				101107
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101107",
							"2"
						],
						"stepId": 101107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110731,
					"content": "我要「三號夜泊石」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110732
					]
				},
				{
					"id": 10110732,
					"content": "沒錯！我也記得是這塊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110733,
					"content": "沒問題，既然看中了，老爺們就拿去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110771
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110771,
					"content": "嗯。「三號夜泊石」這個種類的，來一箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110772
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110772,
					"content": "好嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110734
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110734,
					"content": "話說…別怪我多嘴，純粹是好奇，各位老爺要這麼多極品「夜泊石」，是有何貴幹啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110735
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110735,
					"content": "嗯…說也無妨。是製作「送仙典儀」的器具所用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110736,
					"content": "「送仙」…？！呃，最近我也聽過不少小道消息，可是一直沒敢太多過問。那，那就是，岩王爺他，確實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110737
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110737,
					"content": "…唉，難以置信。雖然如今「解翠行」有些沒落，但祖祖輩輩一直多虧岩王爺護佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110738
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110738,
					"content": "據說兩百年前岩王爺微服下城南，迷路時品嚐民間小吃，就是用「解翠行」的玉勺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110739
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110739,
					"content": "俱往矣…俱往矣…唉，既然是跟岩王爺道別所用，那這箱「夜泊石」就只收半價吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110740
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110740,
					"content": "啊，這真的可以嗎…明明老闆之前還是一毛不拔的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110741,
					"content": "沒有岩王爺的保佑，就沒有這「貿易之都」如今的模樣。作為一個生意人，怎麼能去賺這種錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110742
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110742,
					"content": "嗚…老闆，你的心意一定會傳達給岩王爺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110743,
					"content": "在「璃月七星」與各位腳踏實地的商人共同努力之下，想必璃月也會一如既往地繁榮下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110744
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110744,
					"content": "所以，打起精神來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110745
					]
				},
				{
					"id": 10110745,
					"content": "好…好，謝謝幾位老爺了。嗯，我這是怎麼了，哭哭啼啼的，財運都要溜走了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110746
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110746,
					"content": "既然挑選完畢，我們就帶著「夜泊石」去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110747
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110747,
					"content": "喂！等等，雖說是半價，但也不代表可以不付錢呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110748,
					"content": "哦，不好意思，我又把付錢的事給忘了。讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110749
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110749,
					"content": "…嗯…果然沒帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110750
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110750,
					"content": "沒帶什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110751,
					"content": "沒帶摩拉。真是慚愧，又疏漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110752,
						10110753
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110752,
					"content": "奇怪的金錢觀念…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110754
					]
				},
				{
					"id": 10110754,
					"content": "那可怎麼辦，這不是一筆小數目…啊，對了，「公子」似乎給過我們一筆墊付資金來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110755
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110755,
					"content": "在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110756
					]
				},
				{
					"id": 10110756,
					"content": "好在有這些錢，老闆看看，夠不夠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110757,
					"content": "【表現備註：主角遞給老闆錢】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110758,
					"content": "夠了夠了，半價的話，差不多正好…其實就算不夠也沒關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110759
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110759,
