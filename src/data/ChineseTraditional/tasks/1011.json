	"talks": [
		{
			"id": 101101,
			"completionStepIds": [
				101101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101101",
							"2"
						],
						"stepId": 101101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"石頭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110101,
					"content": "喲，客官，歡迎光臨「解翠行」。今天要不要來開兩塊「璞石」試試手氣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110102
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110102,
					"content": "便宜又好玩，也許一不留神就發家致富了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110103
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110103,
					"content": "「璞石」？不要不要，我們是來挑…什麼石頭來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110104,
					"content": "夜泊石，品相至少要「燭照」級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110105,
					"content": "「燭照」級的夜泊石…？嗯，原來不是遊客。失禮了，我這就拿貨，請看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110106
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110106,
					"content": "（黑屏，拿來了貨）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110107
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110107,
					"content": "您看這怎麼樣？我們「解翠行」可是玉石老字號。瞧瞧這品相！絕對上佳，簡直是岩王爺也難得降下的恩賜。您就放心隨便選吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110108
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110108,
					"content": "這三塊「夜泊石」看上去確實都很漂亮，不像是平時挖出來的那種…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110109,
					"content": "但，到底該怎麼選啊，要不我們就隨便選一種回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110110,
						10110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110110,
					"content": "做賭石生意的老闆，不能輕信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110111
					]
				},
				{
					"id": 10110111,
					"content": "#很好。貿易之都的生存法則，看來{F#妳}{M#你}已經悟到了幾分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110112,
					"content": "那鍾離先生的意見呢？這些「夜泊石」該怎麼選？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110114,
					"content": "哦？想要我來決定嗎。也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110115
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110115,
					"content": "要我說的話，答案其實很簡單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110116
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110116,
					"content": "嗯？答案是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110117,
					"content": "老闆，我全要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110118
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110118,
					"content": "好！這位老爺，我早看出您氣宇不凡，出手果真闊氣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110119
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110119,
					"content": "等等！等一下，老闆，剛才他說的不算，我們再商量一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110120,
					"content": "（黑畫面，和石頭稍微拉開距離，變成鍾離主角派蒙三人對話）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110121,
					"content": "喂！如果儀式只需要一種的話，全買下來不就白白浪費三倍的摩拉了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110122,
						10110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110122,
					"content": "對，派蒙說得沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110124,
					"content": "摩拉…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110125
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110125,
					"content": "確實如此。剛才沒想到這方面的問題，是我考慮不周了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110126,
					"content": "啊？買東西怎麼能不考慮摩拉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110127,
					"content": "若凡事都要先考慮摩拉，也就等同於凡事都被摩拉束縛了手腳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110128
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110128,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110129,
					"content": "摩拉天然是貨幣，但貨幣天然不是摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110130
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110130,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110131,
						10110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110131,
					"content": "他說的是經濟學。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110132
					]
				},
				{
					"id": 10110132,
					"content": "這就是有錢人的世界嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110133,
					"content": "雖然很懂宏觀經濟，但不懂得省一些「小錢」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110136,
					"content": "不必動搖。即使摩拉束縛了手腳，我也有在束手束腳的情況下，依然能解決問題的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110137
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110137,
					"content": "「夜泊石」品相的鑑別，確實令人棘手。一塊原礦不論好壞，它的質地、色澤，以及內部的岩紋，都不會有太大差別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110138
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110138,
					"content": "只有當夜泊石製造的器物成型以後，才會發現其中一些成品根本上不了檯面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110139
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110139,
					"content": "這時再去找那些奸商理論的話，他們又會以「你的合成台不好」、「火候不對」之類理由來搪塞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110140
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110140,
					"content": "好險好險！原來這東西是這麼容易上當受騙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110141,
					"content": "不過，真正的鑑別方式還是存在的——真正的內行人，還是能鑑別的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110142
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110142,
					"content": "「如愚見指月，觀指不觀月。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110143
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110143,
					"content": "那是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110144,
					"content": "#{F#妳}{M#你}用手指指向月亮，聰明人能明白{F#妳}{M#你}在指月，但不聰明的人只能看到眼前的手指，看不到月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110145
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110145,
					"content": "紋路、外殼…這些都是手指。夜泊石是夜間照明用的奇石，「亮度」的重要性，才等同於天上之月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110146
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110146,
					"content": "優質的「夜泊石」會有更佳的火元素親和力。也就是說，在高溫之下，光澤越亮越藍的礦石，品相就越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110147,
						10110148
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110147,
					"content": "原來鍾離先生這麼內行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110149,
					"content": "#我已將玉石界價值千金的秘密告訴了{F#妳}{M#你}們，剩下就是實踐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110150
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110150,
					"content": "價值千金…唔，可惜派蒙覺得，以後應該再也用不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110151,
					"content": "（黑屏遮蓋，回到石頭攤前對話）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110152,
					"content": "老闆，我們回來選石頭了，麻煩把石頭都借給我們燒一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110153,
					"content": "燒、燒一下？！燒不得啊幾位老爺，你們燒完我還賣什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110154,
						10110156
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110154,
					"content": "那我們只要一點點樣品可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110155
					]
				},
				{
					"id": 10110155,
					"content": "這…唉，罷了，還是聽老爺們的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110158,
					"content": "這樣，我從三塊石頭上都取些樣品來，我老石虧一點就虧一點，就當交朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110159
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110159,
					"content": "放心，商界的規矩我明白。只要證明是好礦，自然不會讓閣下吃虧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110160
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110160,
					"content": "（黑屏取樣品）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110161
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110161,
					"content": "好了，就拿這些做樣品吧，我用刻刀切下來的，還標上了記號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110162,
						10110163
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110162,
					"content": "這些樣品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110164,
					"content": "…也太薄了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110165,
					"content": "比紙還要薄…不對，比蟲子的翅膀還要薄，薄得都快透明了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110166,
						10110168
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110166,
					"content": "老闆真小氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110167
					]
				},
				{
					"id": 10110167,
					"content": "小氣？已經很大方了，再多取一點都是要我的命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110171,
					"content": "可是，薄成這樣的話，一遇到火，就會馬上灰飛煙滅了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110172,
					"content": "想讓生意人讓出利潤，就如同要餓狼吐出剛下肚的肉一樣，這也是沒有辦法的事。但其實在特殊條件下，這些薄片也夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110173
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110173,
					"content": "什麼樣的特殊條件？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110174,
					"content": "在施加「火」之高溫的同時，用「水」的元素力從中保護，就可以讓樣品不至於瞬間燒毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110175
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110175,
					"content": "哦？這位老爺居然如此有見識。感謝體諒，感謝體諒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110176
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110176,
					"content": "平心而論，我們沒有給出一定會買的承諾，便這樣索要樣品…本身就是有失公平的。璃月的「契約」之道，還需處處基於公平才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110177
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110177,
					"content": "那麼，剩下的就是要找一個可以實驗的地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110178,
						10110179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110178,
					"content": "我記得達達烏帕谷裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110182
					]
				},
				{
					"id": 10110182,
					"content": "哦！我想起來了，在蒙德的時候見過…<color=#00E1FFFF>達達烏帕谷裡</color>，「好肉族」的丘丘人有一口<color=#00E1FFFF>超大的鍋</color>！很結實，應該能頂住元素反應！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110183,
					"content": "#{NICKNAME}，我們帶好樣品，然後出發吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110179,
					"content": "香菱家的廚房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110180
					]
				},
				{
					"id": 10110180,
					"content": "#{F#妳}{M#你}是說「萬民堂」嗎？也好，趁香菱不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110181,
					"content": "不妥，那裡人來人往，萬一元素反應失控，波及民眾…我們不能冒這樣的風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110182
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110168,
					"content": "老闆的手藝令人佩服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110169
					]
				},
				{
					"id": 10110169,
					"content": "哈哈哈…過獎過獎，這些石頭都是我的心肝寶貝，不這樣溫柔可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110170
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110170,
					"content": "萬一不小心割了太多，可就真要了我的命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110163,
					"content": "好薄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110156,
					"content": "不然我們就不買了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110157
					]
				},
				{
					"id": 10110157,
					"content": "不買了…？欸，別，別這樣，老爺…還可以商量，買賣就是商量的藝術，您說是不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 10110148,
					"content": "這就是高雅人士的品味生活嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110134,
					"content": "感覺他很有錢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110135
					]
				},
				{
					"id": 10110135,
					"content": "是有錢到了從來不用省一些「小錢」的地步嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110123,
					"content": "不，其實是浪費兩倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110113,
					"content": "我想問問鍾離先生的意見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110114
					]
				}
			]
		},
		{
			"id": 101104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101104",
							"2"
						],
						"stepId": 101104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110401,
					"content": "哇…裡面還有湯呢，丘丘人的胃口可真大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110402,
						10110403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110402,
					"content": "現在是我們的實驗台了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				},
				{
					"id": 10110404,
					"content": "這鍋湯剛好可以作為「水」元素力的保護，那就開始點火，進行試驗吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110405,
					"content": "【表現備註，伸手放置的動作or投石的視覺表現】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110406,
					"content": "這樣應該就可以了吧？派蒙也會幫忙記住三塊樣品的編號和位置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110407,
					"content": "那麼現在開始！用<color=#00E1FFFF>「火」的元素力</color>不斷加熱大鍋，直到結果出現為止——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110408,
					"content": "鍾離先生說，<color=#00E1FFFF>光澤越亮越藍</color>的礦石品質越好，要注意觀察哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110403,
					"content": "可惜了這鍋湯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				}
			]
		},
		{
			"id": 101109,
			"completionStepIds": [
				101109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101109",
							"2"
						],
						"stepId": 101109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110901,
					"content": "「夜泊石」放在這裡就行了。我已經派人去喊珠寶匠了，之後就會把它們打造成儀式所需的器物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110902
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110902,
					"content": "對了，這麼短的時間裡，我還沒來得及去見「公子」，珠寶匠的報酬，也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110903,
						10110904
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110903,
					"content": "如果他回來的話我就先墊付吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				},
				{
					"id": 10110905,
					"content": "那也只能這樣了。話說回來，這裡就是…「送仙典儀」的會場？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110906,
					"content": "嗯，這片場地我已經租借下來，開始進行儀式的籌備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110907,
						10110909
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110907,
					"content": "與「請仙典儀」同一個地點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110908
					]
				},
				{
					"id": 10110908,
					"content": "是的，用了相同的場地。這也是「璃月七星」默許的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110911,
					"content": "可這裡剛發生過那麼大的案件…啊，這麼說來，我們作為嫌犯回到現場，要小心別被千岩軍抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110940,
					"content": "不過總覺得，從絕雲間回來以後，就再沒遇到過找麻煩的千岩軍了，這是怎麼回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110912,
					"content": "還有，之前留在這裡的，岩王帝君的…呃，仙體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110913,
					"content": "以傳統而言，可稱之為「仙祖法蛻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110914,
					"content": "啊對，是這個名字，鍾離怎麼什麼都知道。所以「仙祖法蛻」是被七星藏起來了嗎？可是兇手不是還沒有調查清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110915,
					"content": "只能說明七星已經心裡有數…或者已經確定，現場的線索都找齊了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110916,
						10110917
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110916,
					"content": "還是覺得很奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110918,
					"content": "那些事，自會有玉京臺的大人物考慮。想替他們分憂，也只是徒增煩惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110919
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110919,
					"content": "在儀式舉辦前，「仙祖法蛻」會被暫時安放在「黃金屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110920
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110920,
					"content": "「黃金屋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110921,
					"content": "璃月唯一的鑄幣廠…也是全提瓦特唯一的鑄幣廠。人類七國所流通的摩拉，全都是在那裡鑄造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110922,
					"content": "嗚哇——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110923,
					"content": "不，我沒在想不好的事。我是說，很符合「摩拉克斯」的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110924,
					"content": "但是，鍾離為什麼知道這件事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110925,
					"content": "因為「送仙典儀」得到了七星的默許，也算是半官方活動了，所以我能得到一些內部消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110926,
						10110927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110926,
					"content": "七星提供場地、公子提供資金…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110928,
					"content": "或許他們各有目的吧…不過，在這商業之都，偶爾被人利用，也不是什麼不可接受的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110929
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110929,
					"content": "在「契約」之神治下的璃月，唯有契約不可違背。至於契約之外的小動作，我倒是無所謂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110930
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110930,
					"content": "好了，我們該去準備儀式所用的<color=#00E1FFFF>香膏</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110931,
					"content": "香膏？要去哪裡弄呢？直接去買嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110932,
					"content": "不，這種敬神的香膏，若要熬製，所需的<color=#00E1FFFF>「霓裳花」</color>品質，同樣也是很特殊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110933,
					"content": "名為「霓裳」的花，其花瓣是上好的纖維材料，多用於製作錦緞。但它的芳香又十分清雅，尤其適合供奉仙神的嚴肅場合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110934
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110934,
					"content": "又到了鍾離普及上流社會知識的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110935,
					"content": "更具體的細節，目前也不需要多言了。還是先隨我一道去商人那裡，收購材料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110927,
					"content": "他們究竟想利用這場儀式做什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110917,
					"content": "會不會太輕率了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110909,
					"content": "就這麼把「現場」給…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110910
					]
				},
				{
					"id": 10110910,
					"content": "這也是「璃月七星」默許的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110904,
					"content": "之後去找公子報帳吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				}
			]
		},
