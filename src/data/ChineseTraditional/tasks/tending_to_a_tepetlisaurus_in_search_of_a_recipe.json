						250220305
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220305,
					"content": "（霍萊小心翼翼地咬了咬，仔細品嚐著花瓣的味道。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220306,
					"content": "嗚，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220307,
					"content": "喔！看霍萊的樣子，牠還滿喜歡吃這個的，不過吃花吃不飽啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220308,
					"content": "而且這種花看起來就不太便宜啊…總之我先記下來好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220309,
					"content": "花要怎麼做成食物呢？唔…要不然把花包在餅裡…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
