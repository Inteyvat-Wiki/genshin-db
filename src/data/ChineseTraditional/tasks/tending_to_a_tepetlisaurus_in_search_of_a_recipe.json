			"dialogs": [
				{
					"id": 250220101,
					"content": "嗯…看來是要換一個食譜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220102,
					"content": "嗚嗚，嗚嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220103,
					"content": "你又有什麼主意了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220107,
					"content": "平常霍萊他都可以吃完一整盆果子，吃完之後可以瘋玩一整天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220108,
					"content": "現在牠一盆水果只能吃一半多一點，而且吃完之後就坐在旁邊一動也不動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220109,
					"content": "我還以為牠生病了，嚇得連夜去找醫生幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220110,
					"content": "我們兩個折騰了一整夜，終於確定霍萊什麼病也沒有，牠就只是…挑食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220111,
					"content": "醫生說最好的解決方法就是幫霍萊換個新食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220112,
					"content": "他還說我也可以試著在霍萊吃飯的時候放點音樂，也許這樣可以促進牠的食慾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220113,
					"content": "聽起來還不錯啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "哈哈哈…對啊，我那時的確找了一張唱片，裡面的音樂霍萊也很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220116,
					"content": "不過當霍萊跳起來一口咬掉一半的唱片之後…我就被迫放棄了這個計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220117,
					"content": "畢竟對於嵴鋒龍霍萊來說，用黑曜石和燃素做的唱片本身就夠好吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220118,
					"content": "我現在也只能去「懸木人」那邊找人幫忙，看能不能拿到一些新奇的食材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220119,
					"content": "我去幫你找一些食材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "#{F#妳}{M#你}願意幫忙？那就再好不過了！「懸木人」的老兄也只能在納塔找食材，{F#妳}{M#你}一定可以去納塔外面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220124,
					"content": "等等喔，我看看醫生列給我的食材建議表，這位醫生真是見多識廣，對納塔外的事都有瞭解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220125,
					"content": "唔…上面寫說可以試試看<color=#00E1FFFF>「虹彩薔薇」、「堇瓜」</color>和<color=#00E1FFFF>「清心」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220122,
					"content": "#那就拜託{F#妳}{M#你}了，找到新奇的食材之後就直接拿過來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220123,
					"content": "嗚嗚，嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220120,
					"content": "我很擅長找食材的喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "還有這種唱片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "（摸摸霍萊。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "霍萊"
				}
			]
