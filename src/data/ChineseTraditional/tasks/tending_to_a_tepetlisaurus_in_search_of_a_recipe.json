						250220405
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220405,
					"content": "（霍萊大口咀嚼堇瓜，一下子就全吃光了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220406,
					"content": "嗚嗚，嗚嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220407,
					"content": "哈哈哈，一下子就吃光了，你很喜歡這個嗎？霍萊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250220408,
					"content": "嗚嗚，嗚！嗚嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250220409,
					"content": "好！那我等等就去找人問一下哪裡有稻妻來的商人，要多買點堇瓜才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡茲加"
				}
			]
		},
