			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂",
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "你好，請問是來抓藥的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280202,
					"content": "咦？這不是小蒙嗎？你怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280203,
					"content": "噢…我知道了，你是來問那些藥物的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280204,
					"content": "放心吧，那些藥物我基本上都準備好了，會分批送去給你爸爸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280205,
					"content": "不過你爸爸要的藥物量太大，店裡囤的一些藥材都快用完了，可能有一些藥會做得慢一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280206,
					"content": "我看看啊，嗯…主要是薄荷沒剩下多少，所以治療中暑的藥也沒法做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280207,
					"content": "畢竟，除了製作你爸爸的藥物訂單之外，我們也要給其他人看病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280208,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280209,
					"content": "輪到我出場了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#嘿嘿，謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280213,
					"content": "#那藥材的事就拜託{F#妳}{M#你}啦，我要留在這裡仔細核查一下藥物。這是爸爸特意叮囑我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280214,
					"content": "這孩子還挺認真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280215,
					"content": "那你和我進來吧，我把這一批的藥物清單給你看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280216,
					"content": "嗚啊…怎麼這麼多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280217,
					"content": "你先看這些，我把另外一批拿過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280218,
					"content": "欸？還有嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280211,
					"content": "我可要收取報酬喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#嘿嘿，沒問題！謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "小蒙"
				}
			]
		},
