			"dialogs": [
				{
					"id": 210280401,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280402,
					"content": "嗯，這些應該夠我做一些藥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280403,
					"content": "那些治療中暑的藥物，我會放在下批藥物裡一起送過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280404,
					"content": "那就辛苦你啦，阿桂哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280405,
					"content": "#這些東西給{F#妳}{M#你}，謝謝{F#妳}{M#你}幫忙，{F#大姐姐}{M#大哥哥}，我們回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280406,
					"content": "嘿嘿，爸爸聽到這個消息肯定會高興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280407,
					"content": "小蒙，你等一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280408,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280409,
					"content": "你不是要核查藥物嗎？後面的清單你還沒看完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280410,
					"content": "欸…欸？我剛才不是核查了那麼久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280411,
					"content": "那才核查了多少，來吧小蒙，我們繼續核查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 210280412,
					"content": "嗚…好…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				}
			]
		},
