			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{F#大姐姐}{M#大哥哥}！{F#妳}{M#你}來得正好，我有事情想問{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280102,
					"content": "有什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "爸爸說，去須彌的路程很遠，需要準備一些藥物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280106,
					"content": "治療頭痛的、防止腹瀉的，防止中暑的…還有解酒的，消食的…好多好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280107,
					"content": "為什麼還要準備解酒的藥啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210280108,
					"content": "談生意的時候要用吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "欸？談生意和解酒藥有什麼關係，難道喝酒喝得多，生意就會做得好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210280110,
					"content": "總之，爸爸要我去「不卜廬」問問，那些藥物準備得怎麼樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280111,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}能陪我去嗎？有些事，我想要請{F#妳}{M#你}幫幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280112,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#我們走吧，{F#大姐姐}{M#大哥哥}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280113,
					"content": "你…有什麼事要我幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "到那邊再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210280103,
					"content": "旅行準備得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "大部分都是我爸爸和那群叔叔在準備啦…但是爸爸也交給我了一些任務！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "小蒙"
				}
			]
		},
		{
			"id": 2102802,
			"completionStepIds": [
				2102803
			],
