					"素海卜"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2712.056,
							67.739,
							4387.715
						],
						"pointId": 331000111
					}
				]
			},
			"dialogs": [
				{
					"id": 735210501,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210502
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210502,
					"content": "嗚哇…這個人看起來好凶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210503,
					"content": "#有事就說，沒事就走。我沒空伺候{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210504
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210504,
					"content": "其實，我們聽說你手裡有薩齊因寫的文章，所以想來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210505,
					"content": "…你們不會是在拿我尋開心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210506
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210506,
					"content": "沒有呀！為什麼這麼問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210507,
					"content": "#看來{F#妳}{M#你}們確實不知道。我前段時間找人鑑定了，這篇文章只是抒情性質的遊記，沒什麼價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210508
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210508,
					"content": "當初他曾僱我老爹保護他的安全，那個叫薩齊因的人經常邊走、邊問、邊寫，神經兮兮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210509
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210509,
					"content": "有一次他的稿紙被風吹跑了。他說不要了，我爹卻覺得文化人寫的東西絕對值錢，於是在夜裡打著火把四處尋找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210510
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210510,
					"content": "我們一家都不識字。我爹把他寫的東西當寶貝，還傳給了我。沒想到根本不值錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210511
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210511,
					"content": "聽起來有點倒楣…那篇文章還在你這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210512,
					"content": "#在。{F#妳}{M#你}們想看？那就讓{F#妳}{M#你}們看看好了，既然不值錢，我也沒必要當寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210513
					],
					"speakerTitle": "素海卜"
				},
				{
					"id": 735210513,
					"content": "這就是薩齊因寫的文章？呃…說實話，看不太懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210514,
					"content": "不過…看著這些模糊的筆跡，不知道為什麼，好像感覺他有點難過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210515,
					"content": "總之，我們看完啦，多謝你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210516,
					"content": "不客氣。雖然不值錢，但我還是會繼續留著它，畢竟是我爹留給我的。想看的話就再來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "素海卜"
				}
			]
		},
