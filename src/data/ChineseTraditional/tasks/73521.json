					{
						"sceneId": 3,
						"position": [
							-405.308,
							281.227,
							2791.237
						],
						"pointId": 330201343
					}
				]
			},
			"dialogs": [
				{
					"id": 735210401,
					"content": "…二十年前的事？為什麼突然想問這個，你們聽到了什麼消息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210402
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210402,
					"content": "我們打聽到二十年前冠冕好像弄丟過，而且好像還有參賽者性格發生了變化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210403,
					"content": "#{F#妳}{M#你}們知道的還真不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210404
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210404,
					"content": "維卡斯，你是不是有什麼事瞞著我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210405,
					"content": "也算不上隱瞞，二十年前我才五歲，我能知道什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210406
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210406,
					"content": "但有些事我也確實沒和別人說過。其實我加入學院慶典策劃委員會，是受一位前輩的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210407
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210407,
					"content": "前輩和我是在旅遊中認識的。他…膽子有點小，遇到什麼突發情況總是第一時間躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210408
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210408,
					"content": "四年前的一天我跟他說，我想回教令院一趟，學院慶典要開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210409
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210409,
					"content": "然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210410,
					"content": "聽到學院慶典，他像是嚇了一跳，說什麼「不關他的事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210411
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210411,
					"content": "當晚我找他告別的時候，他非要拉著我喝酒。喝多了，就開始說些亂七八糟的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210412
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210412,
					"content": "我當時也喝了不少，意識模糊，聽得不太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210413
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210413,
					"content": "只記得他說才識之冠曾經丟過一陣子。當時他主要負責才識之冠的發放與回收，差點沒嚇死，好在最後從樹洞裡找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210414
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210414,
					"content": "和我們之前看到的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210415,
					"content": "他說才識之冠是非常貴重的寶物，許多典籍都有記載。傳說它是由古代赫赫有名的工匠打造，有著不為人知的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210416
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210416,
					"content": "薩齊因畢竟只是委託教令院保管，如果冠冕在那位前輩手上丟了，他傾家蕩產也賠不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210417
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210417,
					"content": "哪怕只是暫時丟了，也不能讓別人知道，不然教令院會判處他嚴重失職。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210418
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210418,
					"content": "所以他隱瞞了這件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210419,
					"content": "是啊。當時他好像還說有不少人來問，其中甚至還有小孩子，但他一律聲稱冠冕從未丟過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210420
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210420,
					"content": "但他還是太害怕了，於是等風頭過去後，乾脆辭掉了工作，從教令院離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210421
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210421,
					"content": "當天晚上我也喝多了，第二天起來他已經不見了。後來我越想越覺得不是滋味，學院慶典交給這種人來搞，早晚會出大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210422
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210422,
					"content": "當時我也沒有工作，乾脆加入了學院慶典策劃委員會。我也從內部查過當年的事情，不過沒什麼收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210423
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210423,
					"content": "冠冕失而復得，傳聞性格變化的人也已經去世，查無可查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210424
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210424,
					"content": "二十年還是太久了，久到當初的事情已經無人記得、也無人在意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210425
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210425,
					"content": "#我只知道這麼多了。如果{F#妳}{M#你}們好奇的話，可以繼續調查下去，也許有一天能推測出真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210426
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210426,
					"content": "說得輕鬆，我們也沒有更多線索啦。你就沒有更多的線索了嗎？比如那個前輩平時在哪活動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210427,
					"content": "那個前輩的消息我確實沒有了。後來我也去沙漠找過他，但茫茫沙海，想偶遇幾乎是不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210428
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210428,
					"content": "#作為補償，我這裡倒是有個關於薩齊因的消息，{F#妳}{M#你}們要不要聽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210429
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210429,
					"content": "嗯…也可以，說來聽聽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210430,
					"content": "我在外面旅遊的時候，曾經與一位傭兵團長同行。聊天的時候，他說自己手上有一位教令院學者寫的文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210431
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210431,
					"content": "他似乎覺得這是什麼寶貝，不肯輕易示人，在我的懇請下才讓我看了一眼。我沒看清內容，但看到署名是薩齊因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210432
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210432,
					"content": "當時我不知道薩齊因是誰，也不怎麼關心。加入學院慶典策劃委員會後，才知道他就是贊助學院慶典的因論派名宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210433
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210433,
					"content": "#{F#妳}{M#你}們要是感興趣，可以去沙漠找他，他平時在荼訶落谷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210434
					],
					"speakerTitle": "維卡斯"
				},
				{
					"id": 735210434,
					"content": "跟薩齊因有關的消息？好吧，我們去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
