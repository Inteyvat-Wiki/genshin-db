			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡維斯卡"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2009.721,
							274.996,
							4224.615
						],
						"pointId": 330800394
					}
				]
			},
			"dialogs": [
				{
					"id": 735210301,
					"content": "今年學院爭霸賽，我最看好的就是賽諾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210302
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210302,
					"content": "拋開他大風紀官的身手不談，回顧歷屆爭霸賽，素論派奪冠比例是最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210303
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210303,
					"content": "很多人說素論派盛產天才，居勒什、魯奇卡、麗莎、賽諾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210304
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210304,
					"content": "天才越是耀眼，比賽也會越早失去懸念。要說打得最激烈的，還是二十年前那一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210305
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210305,
					"content": "當時我的朋友也參加了比賽，我專門去現場為他加油助威。最後一輪是在道成林打的，打到最後沒人敢靠近，誰也不知道林子深處發生了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210306
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210306,
					"content": "後來聽說教令院叫停了那場比賽。再之後，學院爭霸賽就移除了許多生死相爭的項目，不鼓勵大家在比賽中「死鬥」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210307
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210307,
					"content": "你的朋友是一個什麼樣的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210308
					]
				},
				{
					"id": 735210308,
					"content": "讓我想想。他…正直善良，但也脆弱敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210309
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210309,
					"content": "最重要的是，他很在乎我們這些朋友。我們一起喝酒，酒中滿是歡聲笑語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210310
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210310,
					"content": "只可惜往事一去不返了。當初一起喝酒的朋友們，有人過世、有人失蹤、有人隱居…都說命運無常，真是所言非虛啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210311
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210311,
					"content": "看來二十年前確實發生了一些事…對了，維卡斯不是跟我們說，有什麼問題可以去找他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210312,
					"content": "既然現在有時間，我們去找他問問怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7352104,
