				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦瑟迪瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735210201,
					"content": "唉，看到這些年輕的孩子們，忍不住就會回憶起往事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210202
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210202,
					"content": "學院爭霸賽向來是年輕天才們的舞臺。只可惜，不是每個天才最終都能成才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210203
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210203,
					"content": "為什麼這麼說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210204
					]
				},
				{
					"id": 735210204,
					"content": "天才大多固執冷漠，很難理解他人的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210205
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210205,
					"content": "而有同理心的人，又往往會陷入自我懷疑與消沉當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210206
					],
					"speakerTitle": "瓦瑟迪瓦"
				},
				{
					"id": 735210206,
					"content": "意志不堅定的人只能原地踏步，意志堅定卻走錯了路的人不肯回頭。這裡面的考驗多著呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦瑟迪瓦"
				}
			]
		},
		{
			"id": 7352103,
			"completionStepIds": [
				7352103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
