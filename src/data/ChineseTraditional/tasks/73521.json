			"dialogs": [
				{
					"id": 735210801,
					"content": "時間會抹掉一個人存在過的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210802
					],
					"speakerTitle": "胡維斯卡"
				},
				{
					"id": 735210802,
					"content": "學生時代的那些歡聲笑語，有很多我都已經忘記了。也不知道此刻在懷念什麼，或許只是不願承認自己正在慢慢老去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
