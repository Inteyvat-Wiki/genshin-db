			},
			"dialogs": [
				{
					"id": 735210101,
					"content": "#哎呀哎呀，又看到{NICKNAME}和小派蒙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210102
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210102,
					"content": "我這裡有一份最新的學院慶典情報哦，要不要瞭解一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210103
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210103,
					"content": "要錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210104,
					"content": "免費贈送！桑歌瑪哈巴依老爺真的是太慷慨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210105
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210105,
					"content": "#{F#妳}{M#你}們還記得薩齊因嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210106
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210106,
					"content": "是贊助學院慶典的那個人吧！聽說獎金和才識之冠都來源於他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210107,
					"content": "答對了！其實前不久，我在沙漠經商的時候，遇到了一位老商人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210108
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210108,
					"content": "#{F#妳}{M#你}猜我從他們手上買到了什麼？一份行商紀錄！有了它，我就能避開沙漠中的危險區域，去更多地方了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210109
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210109,
					"content": "當然，最最重要的是，紀錄中竟然提到了薩齊因！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210110
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210110,
					"content": "原來薩齊因曾經到沙漠考察風土人情，還和沙漠中的旅行商人親切交流過呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210111
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210111,
					"content": "雖然很多文字已經看不清了，但這可是關於學院慶典背後大贊助商的第一手資料！要看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210112
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210112,
					"content": "好吧，那我們就看看好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210113,
					"content": "嗯…看不懂！多莉，妳知道是什麼意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210114,
					"content": "是什麼意思呢？很遺憾，如果需要分析的話，需要額外支付一百萬摩拉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210115
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210115,
					"content": "那還是算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735210116,
					"content": "#既然{F#妳}{M#你}們不肯付錢，那多莉的特別消息就到此為止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210117
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735210117,
					"content": "#不過我還可以給{F#妳}{M#你}們一點提示！比賽現場應該有人參加過許多屆學院慶典，找他們聊聊或許會有新的收穫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
		{
			"id": 7352102,
			"completionStepIds": [
				7352102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
