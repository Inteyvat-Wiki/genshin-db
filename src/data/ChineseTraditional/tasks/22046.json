			"dialogs": [
				{
					"id": 220460101,
					"content": "神社又有些亂了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "唔喵，是汝等啊，來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460104,
					"content": "一段時間沒打掃，神社的屋子周圍，又有了好多汙漬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460105,
					"content": "這樣子可不能接待來神社的人類啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460106,
					"content": "汝等，能和上次一樣，幫奴家打掃一下神社嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460107,
					"content": "不是有大祐和悅子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "奴家可不會去主動找那兩個綠綠的人類說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460109,
					"content": "那個高高的人類，看奴家的眼神總是很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460110,
					"content": "另外一個綠綠的人類，又總是那副提不起勁的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460111,
					"content": "喵喵，無論怎麼想，都是兩個靠不住的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460115,
					"content": "總之，就拜託汝等了。就和上次一樣，用長棍子和水「打掃」，汝等明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460116,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "總之，這件事就拜託汝等了，奴家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460119,
					"content": "奴家在這裡等著汝等，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460117,
					"content": "差不多明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "可以拜託大島先生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "那個石頭人類一直在忙個不停，不知道在咚咚咚地敲什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220460114,
					"content": "明明石頭已經敲好了，為什麼還在咚咚咚呢，真煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寢子」"
				}
			]
		},
