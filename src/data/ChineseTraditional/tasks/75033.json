			},
			"dialogs": [
				{
					"id": 750330401,
					"content": "飛得不錯，年輕人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330402,
					"content": "#恩人，剛才{F#妳}{M#你}覺得我飛得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330403,
					"content": "很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "#謝謝{F#妳}{M#你}願意給我這些肯定，我看得出來和{F#妳}{M#你}相比，我飛得並不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330406,
					"content": "阿科米蒂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750330407,
					"content": "#不是{F#妳}{M#你}們想的那樣，我不是因為比不過別人又沮喪了。我是可以飛的，我自己知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330408,
					"content": "只是長期處在糟糕的狀態裡，我破壞了對自己的信任，就算飛得好也沒辦法從容面對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME}不會這樣，{M#他}{F#她}的飛姿就自在得多，大家都看得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330410,
					"content": "爸爸，我知道你和姐姐希望我自己做決定，不要逃避。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330411,
					"content": "如果我現在告訴你們不管是我的身體、大腦還是心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330412,
					"content": "都不願意在不適合自己的道路上繼續走下去，你們還會支持我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330413,
					"content": "沒關係，只要是你自己做出的決定，只要你願意承擔後果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330414,
					"content": "馬塔伽，你會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330415,
					"content": "停！不要以為我會在這時候跳出來指責你，我哥哥的個性我一直知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750330416,
					"content": "受不了就果斷放棄，只要坦蕩就算是勇士，誰也沒資格批評你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "馬塔伽"
				},
				{
					"id": 750330417,
					"content": "有的時候訓練大師的工作也還滿輕鬆的，我為勇士們制定訓練計畫，自己卻不用上場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330418,
					"content": "不過你們的父親我曾經也過著成天和龍一起飛來飛去的日子，知道這種生活的真正滋味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330419,
					"content": "批評別人很容易，放手去做永遠比簡單動動嘴皮子難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330420,
					"content": "作為一個訓練師，我建議你申請休假調整身心狀態，哪怕這會引起隊裡的不滿，你也該這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330421,
					"content": "作為一個父親，知道你不願意再繼續，我尊重你的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330422,
					"content": "就算不在飛行隊待著了也沒什麼大不了，花羽會的勇士也不是只有通過飛行才能證明自己的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330423,
					"content": "謝謝你們…我還擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750330424,
					"content": "不用想太多，我們是你的家人，有什麼事我們都會幫你一起想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750330425,
					"content": "做勇士也不容易啊…沒想到進入花羽會的飛行隊這麼辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330426,
					"content": "我們有我們的辛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "也是哦，想想我們這一路上遇到的各種事情都挺過來了，我還覺得滿驕傲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330430,
					"content": "成為勇士本來就不簡單，要從勇士成長為英雄更難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330431,
					"content": "見的勇士多了，什麼樣的人擁有成為英雄的氣度，我還是看得出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330432,
					"content": "#年輕人，{F#妳}{M#你}已經經歷很多磨煉了吧？{F#妳}{M#你}的眼睛是這樣告訴我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330433,
					"content": "你難以想像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "#看來我沒有看走眼。{F#妳}{M#你}的路和我們不同，或許{F#妳}{M#你}還要走很遠，而我很樂意為未來的英雄提供幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330436,
					"content": "#更何況{F#妳}{M#你}和我們一家相識一場。那這樣好了，我也沒有什麼其他可以做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330437,
					"content": "#如果{F#妳}{M#你}想要使用這裡的訓練賽道，只要和我說一聲，隨時都可以從這裡起飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330438,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "#不用客氣，我很期待看到{F#妳}{M#你}成為英雄，在天空閃耀的那一刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫約尼"
				},
				{
					"id": 750330434,
					"content": "（保持沉默）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "勇士不是誰都可以當的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "好嚴格哦…但想想也是，算了，反正我才不想為了成為勇士每天都訓練得那麼辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750330404,
					"content": "還可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				}
			]
