			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派翠克",
					"阿納托爾"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-211.69,
							323.075,
							1775.736
						],
						"pointId": 310600186
					},
					{
						"sceneId": 3,
						"position": [
							-210.303,
							323.046,
							1774.581
						],
						"pointId": 310600187
					}
				]
			},
			"dialogs": [
				{
					"id": 711250101,
					"content": "派翠克，收手吧！我們現在做實驗的方向已經完全違背科學院裡的指示了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250102
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250102,
					"content": "科學院的指示——你是說審批資料上那個「專案需要更具經濟效益前景的技術應用」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250103
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250103,
					"content": "他們不就是想知道有沒有辦法賣錢？別管那個，我們需要的就是繼續實驗並且收集資料，阿納托爾，再給我一點經費買振晶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250104
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250104,
					"content": "沒那麼多經費了，用完這筆經費你要從哪裡弄來摩拉請人下場做實驗？你自己下場？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250105
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250105,
					"content": "還記得嗎，阿納托爾？「出外實驗的研究監督員，在必要時刻也需要協助研究者進行研究…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250106
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250106,
					"content": "下場實驗的事就交給你了，而且我記得你有一筆滿可觀的差旅費吧？不如少吃幾頓飯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250107
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250107,
					"content": "哇，你省經費的算盤都打到同僚身上了，派翠克，你好狠的心啊！這筆錢是我要用來去吃醃篤鮮的，絕對不能交給你這個惡毒的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250108
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250108,
					"content": "是啊！事可以少做，飯怎麼可以少吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250109,
					"content": "說得對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250110
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250110,
					"content": "哦，我就說嘛，可以說出如此深刻的真知灼見，原來是大名鼎鼎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250111
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250111,
					"content": "對，我就是大名鼎鼎的派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250112,
					"content": "#那這位就是大名鼎鼎的{NICKNAME}了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250113,
						711250114
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250113,
					"content": "對，我就是大名鼎鼎的我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250116
					]
				},
				{
					"id": 711250116,
					"content": "總之，正如派蒙所說，怎麼可以省吃飯的錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250117
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250117,
					"content": "那怎麼辦？如果沒錢做實驗，被應用的就不是所謂「更具經濟效益的研究前景」，而是我「悲慘的人生前景」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250118
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250118,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250119
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250119,
					"content": "啊，我剛才還在想你們這兩個楓丹人在這邊做什麼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250120,
					"content": "原來你們是在這裡做什麼「錢井」的研究。難、難道是不停從地上冒出摩拉的井？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250121,
					"content": "哇，請幫我也打一口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250122
					]
				},
				{
					"id": 711250122,
					"content": "哪有這樣的井啊！不過我相信我研究的專案「前景」，最終一定會變成這樣的「錢井」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250123
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250123,
					"content": "但是首先得解決經費的問題。還有，就是要設計出能夠大賣的發明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250124
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250124,
					"content": "咳咳，偉大的發明通常只是偉大研究的副產物…奇妙發明的想法在做研究的時候，就會像鰩魚一樣自己從腦迴溜出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250125
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250125,
					"content": "最好是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250126
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250126,
					"content": "等等，聽你們說得我都有點好奇了，到底是什麼研究呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250127,
					"content": "是關於名為「振晶」的特殊礦石的研究，「振晶」是從前在測試不同礦石性質時發現的璃月礦石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250128
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250128,
					"content": "「振晶」分為兩類：一類名為「響振晶」，一類名為「應振晶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250129
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250129,
					"content": "「響振晶」受到特定的刺激後，可以放出能量激發「應振晶」的共鳴，進而產生一些特殊效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250130
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250130,
					"content": "這種現象雖然是很有趣啦，不過楓科院對於礦石研究因為…因為一些特殊原因已經不像之前一樣熱衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250131
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250131,
					"content": "而雷蒙多先生覺得這個研究專案沒什麼「經濟效益」，說白了——並不能賣錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250132
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250132,
					"content": "膚淺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250133
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250133,
					"content": "唉，總之派翠克在申請經費的時候理所當然地遭受了搪塞，經費沒要到，只要到一個榮譽頭銜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250134
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250134,
					"content": "我本來以為至少可以用這個榮譽頭銜作為信用證明，去北國銀行臨時借點摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250135
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250135,
					"content": "結果北國銀行的櫃員一聽我是楓丹科學院的工程師，嘴角的笑容就像春日的雪一般消融了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250136
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250136,
					"content": "這招院裡的人已經用爛了，你借得到才奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250137
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250137,
					"content": "所以正如兩位所見，經費也見底了，實驗也請不到冒險家來做…設計發明的方向也一點都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250138
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250138,
					"content": "不過也沒錯，一邊準備程序繁瑣的實驗和實驗場地，還要一邊設計發明——還在沒有經費的異鄉，實在是有點困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250139
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250139,
					"content": "#這樣啊，{NICKNAME}，不如我們來幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250140,
					"content": "哦，派蒙要成為大發明家了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250141
					]
				},
				{
					"id": 711250141,
					"content": "發明的事情我是不懂啦，但是說不定我們可以承擔做實驗的部分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711250142,
					"content": "真、真的可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250114,
					"content": "那我要比大名鼎鼎再有名一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250115
					]
				},
				{
					"id": 711250115,
					"content": "#{F#妳}{M#你}在這裡攀比什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250116
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
