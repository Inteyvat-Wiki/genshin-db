				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250301,
					"content": "畢竟我是榮譽高級研究員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250302
					]
				},
				{
					"id": 711250302,
					"content": "這、這還真是令人驚訝，沒想到我們科學院發榮譽頭銜都已經發到這裡來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250303
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250303,
					"content": "就憑這位想要幫助做實驗的熱心腸，就值得十個八個榮譽頭銜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派翠克"
				}
			]
		},
		{
			"id": 7112504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
