				7112501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112501",
							"2"
						],
						"stepId": 7112501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派翠克",
					"阿納托爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250501,
					"content": "快，阿納托爾，快把你的差旅費拿出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250502
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 711250502,
					"content": "#好吧，不過我願意支出的是{NICKNAME}和派蒙幫助實驗的部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250503
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 711250503,
					"content": "其他的我就要看派翠克你的產品設計案再做決定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250504
					],
					"speakerTitle": "阿納托爾"
				},
				{
