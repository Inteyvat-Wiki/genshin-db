			},
			"dialogs": [
				{
					"id": 711250401,
					"content": "畢竟我是經驗豐富的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250402
					]
				},
				{
					"id": 711250402,
					"content": "#那實驗就拜託兩位了，{NICKNAME}和派蒙！研究專案的存亡，在此一舉。",
					"roleType": "TALK_ROLE_NPC",
