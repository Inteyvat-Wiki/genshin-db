			"dialogs": [
				{
					"id": 700650101,
					"content": "真是好話難勸想死的鬼啊。都說了現在不能上山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650102,
					"content": "欸欸，曼恩大爺，你別這麼激動。好好說話，好好說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650103,
					"content": "之前我和這位大爺在暗夜之釀聊得還好好的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650104,
					"content": "他一聽說我要去風息山就開始抓著我了，一路拉扯都走到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650105,
					"content": "咦，是霍夫曼啊。這裡發生什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700650106,
					"content": "如妳所見，曼恩大爺正在力勸人們遠離風息山呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650107,
					"content": "介紹一下，這位是冒險家莉普哈特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 700650108,
					"content": "#我的親身經歷可是很嚇人的！{F#妳}{M#你}們真的要聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650109,
					"content": "好嘛，我感覺今天是走不了了。那聽一聽吧，就當是剛才喝酒吹牛的延續了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650110,
					"content": "我來看看究竟是怎麼個危險法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "莉普哈特"
				},
				{
					"id": 700650111,
					"content": "療養院裡真的有鬼！我親眼看見的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "曼恩"
				},
				{
					"id": 700650112,
					"content": "哇，鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700650113,
					"content": "昨天晚上的事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼恩"
				}
			]
		}
	]
