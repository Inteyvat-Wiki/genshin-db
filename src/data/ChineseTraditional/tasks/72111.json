			"dialogs": [
				{
					"id": 721110301,
					"content": "#這個是…咳，{F#妳}{M#你}又是從哪裡撿到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110302,
					"content": "溝渠的下游。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110306,
					"content": "#總之，{F#妳}{M#你}也沒有證據證明 ，這兩件東西之間有什麼關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110307,
					"content": "關聯是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110308,
					"content": "莫名其妙，這能有什麼關聯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110309,
					"content": "摩拉上，難不成還能有什麼暗號？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110310,
					"content": "摩拉上確實沒有，但別的地方有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110311,
					"content": "那就是我們在貨車殘骸附近找到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "在村口的樹梢上撿到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "#這怎麼可能…{F#妳}{M#你}這樣試探我是沒用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "紺田傳助"
				}
			]
		},
