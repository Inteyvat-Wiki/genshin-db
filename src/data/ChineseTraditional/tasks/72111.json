			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紺田傳助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "裝摩拉的袋子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110202,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110203,
					"content": "…這就是我們家的東西。沒有什麼可疑的。沒錯，很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110204,
					"content": "好可疑！絕對有問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110205,
					"content": "請你畫出上面的標記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110211,
					"content": "好吧。這的確不是我的錢袋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110212,
					"content": "我家後院人來人往的，有誰落下了什麼東西也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110213,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110214,
					"content": "這是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "#唉！還是{F#妳}{M#你}們機靈，本來我鬼迷心竅，想私吞{F#妳}{M#你}們手裡的錢袋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110216,
					"content": "一把年紀了，傳助啊傳助，怎麼能動這種歪腦筋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110217,
					"content": "不對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "我、我都承認自己想私吞這筆錢了，還能有什麼問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110220,
					"content": "我這就把錢袋交給官府。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110221,
					"content": "感覺不太對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110222,
					"content": "錢袋是被人刻意遺棄的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}這樣說，有什麼證據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110228,
					"content": "錢袋只是其中的一部分。我們還找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110229,
					"content": "#…找到了什麼？唔嗯，交給{F#妳}{M#你}了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110230,
					"content": "#（{NICKNAME}，我們之前在水渠裡發現了什麼來著…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110231,
					"content": "這就是想趁著雨夜丟掉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "沒什麼，是派蒙想多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#（不對吧！{NICKNAME}，傳助爺爺真的只是想要這筆摩拉嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110225,
					"content": "（他是在隱瞞什麼別的事情吧？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110226,
					"content": "錢袋是被人刻意遺棄的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "你在隱瞞別的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "請你說出裡面的摩拉數量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "#哈哈哈，{F#妳}{M#你}這叫什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110208,
					"content": "#不打開行囊確認，{F#妳}{M#你}也不知道現在自己的包裡有多少摩拉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110209,
					"content": "請你畫出上面的標記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
