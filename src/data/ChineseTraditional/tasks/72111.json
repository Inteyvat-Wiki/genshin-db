				"points": []
			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "有什麼事嗎？這位年輕人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110102,
					"content": "我們找到證據了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "「證據」？什麼證據，屬實不知所謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110104,
					"content": "關於村裡的怪事，爺爺不要狡辯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110105,
					"content": "笑話，我們村哪能有什麼怪事。好啊，有什麼證據就拿出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110106,
					"content": "#（喂，{NICKNAME}，就從井邊找到的東西開始吧。交給{F#妳}{M#你}啦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110107,
					"content": "這是從後院枯井撿到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
