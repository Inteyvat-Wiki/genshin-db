				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紺田傳助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "這是…這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110702,
					"content": "居然疏忽了，破壞貨車的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110703,
					"content": "哇，承認了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110704,
					"content": "#沒辦法了，{F#妳}{M#你}都調查到這個地步了，我再瞞也瞞不下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110705,
					"content": "#事情{F#妳}{M#你}差不多也清楚了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110706,
					"content": "非常清楚了！傳助爺爺，你竟然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110707,
					"content": "搶劫了官府的鏢車。在爭搶中，你一拳把貨車打碎，結果貨物袋飛走了，掉進水渠裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110708,
					"content": "幕府的人為了保住性命，把錢袋往水井裡丟，吸引你的注意力！為了防止錢被人撿走，你把井口鎖起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110709,
					"content": "是這樣對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110710,
					"content": "嗄？不對，不是這樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110711,
					"content": "居然不是嗎！我還想跟你拿來鑰匙，去把井底的摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110712,
					"content": "…交還給幕府的大人們！沒錯！當然是還給官府！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110713,
					"content": "唉，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110714,
					"content": "村裡本來有一群年輕人，酒後膽子大，竟然劫了幕府的運車。這貨物和袋子，都是幕府的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110715,
					"content": "我想著村醜不可外揚，才出力幫他們隱瞞下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110716,
					"content": "那承認自己私吞錢袋的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110717,
					"content": "是為了隱瞞事情的真相吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "#沒錯。本來我以為，只要我這麼做，{F#妳}{M#你}們就會不追究下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110719,
					"content": "如果只有我一個人的話…只要不波及別人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110720,
					"content": "#拜託了，請{F#妳}{M#你}不要向幕府告發。這不是我面子的問題。我是怕我們整個村子，都會因此受到牽連。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110721,
					"content": "我沒有告發的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "是呀，我們不是為了這件事來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110723,
					"content": "那就好，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110727,
					"content": "因為做這樣的事情，讓我良心實在不安，所以我把事情記下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110728,
					"content": "#筆記我扔到房頂上了。如果{F#妳}{M#你}真的想讀，就自己去找吧，年輕人。不過，可別把我最近才新修的房頂踩壞囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110729,
					"content": "關於井口的鎖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "是的，是我把井口鎖上了。藏鑰匙的地方，我也記在筆記裡了，自己去看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110731,
					"content": "關於紺田村的「結界」，傳助爺爺知道什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110732,
					"content": "「結界」？哎呀，這麼久遠的傳說，現在還有人知道嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110733,
					"content": "據說在古時，我們腳下的地底有雷櫻的根，是守護鳴神島平安的五段樹根之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110734,
					"content": "而守護它與它的結界，就是「狐齋宮大人」交給我們紺田一族的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110735,
					"content": "但這事已經太久遠了，詳情我已經不清楚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 721110724,
					"content": "我只是想調查真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "是呀，我們不是為了這件事來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110726,
					"content": "調查真相？呵呵…現在的年輕人，倒也挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "紺田傳助"
				}
			]
		},
