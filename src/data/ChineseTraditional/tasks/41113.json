						411131303
					],
					"speakerTitle": "阿陽"
				},
				{
					"id": 411131303,
					"content": "那他說夢話了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131304,
					"content": "這麼一說…昨天他似乎喊了一句「好高啊」，也不知道是什麼意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "阿陽"
				},
				{
					"id": 411131305,
					"content": "好高？是說雪山的高度很高嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131306,
					"content": "高聳的冷冽魔山，帶來奔流的黑暗之力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
