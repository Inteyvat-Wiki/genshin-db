			"dialogs": [
				{
					"id": 411131201,
					"content": "凡民！你也沉淪在苦難的境界之中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411131202,
					"content": "和其他兩地的患者症狀一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131203,
					"content": "你好，請問他有醒來過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131204,
					"content": "沒有，只是偶爾說些夢話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "華清"
				},
				{
					"id": 411131205,
					"content": "什麼樣的夢話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131206,
					"content": "好冷…走不動了…之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "華清"
				},
				{
					"id": 411131207,
					"content": "冷？之前也有人提過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "寒冷的地帶，山脈…會是哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧茲"
