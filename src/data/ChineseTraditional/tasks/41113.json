			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大黃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "你好，請問這裡有醒來的病人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131402,
					"content": "巧了，<color=#00E1FFFF>高老六</color>剛剛醒來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "大黃"
				},
				{
					"id": 411131403,
					"content": "我們就找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131404,
					"content": "不過他昏睡至今，身體十分虛弱。你們若要問話，還請溫柔一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "大黃"
				},
				{
					"id": 411131405,
					"content": "不幸的人，你將獲得皇女的問候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411131406,
					"content": "哎…好餓啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131407,
					"content": "你沒事吧？是不是肚子餓得厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131408,
					"content": "哎…哎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131409,
					"content": "想吃什麼？報個菜名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "想吃…家…家鄉…菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131412,
					"content": "輕策莊的家鄉菜，一定就是<color=#00E1FFFF>輕策農家菜</color>啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131410,
					"content": "我可以為你做一頓飯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
