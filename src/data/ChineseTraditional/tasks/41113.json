		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "莫娜，我們問到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130702,
					"content": "高聳入雲的雪山，想必那就是黑暗滋生的蘖芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411130703,
					"content": "雪山？就這一條嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130704,
					"content": "所有人都夢見同一座雪山。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "高聳入雲、見所未見的雪山，溫度極低，而且，夢中所有人不受控制地想要登上山頂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130706,
					"content": "登上山頂…登上山頂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130707,
					"content": "什麼人會想登上山頂？而且如此渴望，甚至能影響到他人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130708,
					"content": "雪山上埋著被迫害致死的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411130709,
					"content": "或者是…對雪山充滿渴望的挑戰者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130710,
					"content": "我再算一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130711,
					"content": "有了！隱約能看到一點新線索，他的名字是…<color=#00E1FFFF>萊納德</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130712,
					"content": "哎？！這麼快？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130713,
					"content": "早就告訴過妳了，我是天才呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130714,
					"content": "萊納德…沒聽過的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111308",
							"2"
						],
						"stepId": 4111308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "即使用最簡易的占卜，也能察知那個人…是「愚人眾執行官」！太危險了，你們怎麼會和他有來往？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130716,
					"content": "什麼，那位少年是愚人眾執行官？何等邪惡的人物…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130717,
					"content": "居然是執行官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "#他接近{F#妳}{M#你}一定是有所圖謀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130719,
					"content": "而且他非常強！看上一眼就能感覺到，他的實力超乎想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130720,
					"content": "雖然不想承認，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130721,
					"content": "難道他比身為罕見占星天才的莫娜女士更強大？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130722,
					"content": "誰、誰說的！他不過是實力險勝一籌而已，單論占星術可比我差遠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130723,
					"content": "對了對了，我們在望舒客棧附近也遇到過愚人眾的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130724,
					"content": "愚人眾為什麼對隕石如此關心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130725,
					"content": "果然是有什麼陰謀吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130726,
					"content": "唔，難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130727,
					"content": "啊！該不會，這批隕石就是愚人眾搞出來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130728,
					"content": "派蒙！妳竟敢搶我臺詞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130729,
					"content": "哎嘿嘿…不好意思，還是我的嘴比較快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130730,
					"content": "可是，世上有召喚隕石的法術嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "從天上拉下一顆星星，太誇張了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130732,
					"content": "奧茲華爾多·赫芙那梵茵斯，你怎麼看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411130733,
					"content": "小姐，我認為一切均有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130734,
					"content": "只要投以同等的代價，不祥之種就會在任何地方紮根…愚人眾，本皇女記住你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411130735,
					"content": "哈，奇蹟也是可能發生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130736,
					"content": "群星的使者，不愧是我優秀的扈從！我會指派部下保護妳，使妳免遭黑暗的侵襲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411130737,
					"content": "比方說，我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130738,
					"content": "不不不，我們的戰鬥力安排很合理，保持現在這樣就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130739,
					"content": "菲謝爾，妳在小看我嗎？我可是很強的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130740,
					"content": "沒有比妳更值得信賴的人了，女士。只不過，皇女也會擔心妳的安危。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130741,
					"content": "沒那個必要。再說，你們所處的環境比我更危險，可能的話，我還想保護你們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130742,
					"content": "莫娜，妳人真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "幹、幹嘛突然說這種話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130746,
					"content": "先解決新的麻煩吧，星盤顯示，有一顆<color=#00E1FFFF>巨大的隕石</color>落地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130744,
					"content": "菲謝爾，妳人真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "那、那是當然的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "菲謝爾"
				}
			]
