			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "莫娜！託妳的福，我們清了好些隕石呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130102,
					"content": "啊，正好！有件事需要你們去辦一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130103,
					"content": "記得嗎？我說過這片隕石是某個人的命之座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130104,
					"content": "距離遙遠的星星突然墜落在地，按理說這不可能。但事實就是如此矛盾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130105,
					"content": "想破解謎題，最好的辦法就是查清命之座的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130106,
					"content": "#{F#妳}{M#你}說過被隕石影響的人會陷入夢境，而且似乎都夢見了一座雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130107,
					"content": "未知的高山、覆雪之地…卻又不是龍脊雪山，否則一定會有人認出山勢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130108,
					"content": "是不是所有人都有著共通的夢境？夢中他們身處什麼地方？這些都很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130109,
					"content": "#我需要{F#妳}{M#你}搜集更多關於夢境的訊息。線索越多，越容易查到真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130110,
					"content": "看來，得找個人多的地方調查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130111,
					"content": "再去找些患者問問話吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130112,
					"content": "我必須留在不受干擾的環境裡，調查就拜託你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411130113,
					"content": "還有我們沒去過的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130114,
					"content": "在璃月，有一座<color=#00E1FFFF>輕策莊</color>…雖然那裡並不是什麼「人多的地方」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411130115,
					"content": "但我想，那裡也許會像望舒客棧一樣被千岩軍臨時徵用，成為救治患者的場所吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧茲"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111302",
							"2"
						],
						"stepId": 4111302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"經綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "你好，我們來自冒險家協會。請問輕策莊一帶受隕石影響大嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411130202,
					"content": "是冒險家啊！太好了，正愁沒人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411130203,
					"content": "這幾天，隕石動不動就從天上掉下來，別提有多麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411130204,
					"content": "落在<color=#00E1FFFF>田裡</color>，誰都不敢去收糧食，落在<color=#00E1FFFF>大門口</color>，進出又成了問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411130205,
					"content": "你們有辦法清理這些隕石嗎？實在是太礙事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411130206,
					"content": "看來輕策莊也遇到了麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "沒辦法，該我們出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111303,
			"completionStepIds": [],
