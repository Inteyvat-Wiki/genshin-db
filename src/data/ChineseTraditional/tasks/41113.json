			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高老六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "嗚啊…活過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131102,
					"content": "請問，你昏睡期間做夢了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131103,
					"content": "做了做了！可把我累得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131104,
					"content": "什麼夢能把人累成這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131105,
					"content": "你夢見自己在山上嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "你怎麼知道？那是座很高、很冷的雪山…我從沒見過那麼高的山峰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131109,
					"content": "你去雪山幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131110,
					"content": "我也不清楚，就跟中邪一樣，夢裡只想著要爬山，要到最高峰去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131111,
					"content": "山峰上有什麼好東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131112,
					"content": "誰知道呢？我一睡著就跟變了個人一樣，妳問原因，我也說不上來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131113,
					"content": "不是你自己想爬嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "怎麼說呢…像是有人控制了我，讓我產生這種爬山的念頭，別提有多奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "高老六"
				},
				{
					"id": 411131115,
					"content": "難道說，是黑暗心流？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411131116,
					"content": "不是自發，而是下意識產生這種願望。的確很像精神控制呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411131117,
					"content": "雖然已經習慣了但還是想說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "這麼說，之前那些一直說冷的、爬不動了的…也都在雪山上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131120,
					"content": "所有人都做同一個夢嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "太不可思議了…得快點告訴<color=#00E1FFFF>莫娜</color>才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411131118,
					"content": "你們倆說的根本不是同一個詞……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "你夢見自己在雪原上嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "不是雪原，是雪山。非常高，而且很冷…我一睡著，就夢見自己站在山腳下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高老六"
				}
			]
		},
