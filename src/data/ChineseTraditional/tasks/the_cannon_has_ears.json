						],
						"pointId": 340300480
					}
				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "好呀，頂班的來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870302,
					"content": "#咦？怎麼是{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870303,
					"content": "我…我們怎麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "感覺妳好像認識我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870305,
					"content": "#沒有任何問題，很好很好，{F#妳}{M#你}們出了名的強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870306,
					"content": "#在單位裡的時候，回村裡以後，大家都在說，什麼事都能放心交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870311,
					"content": "相比之下，那邊的兩位同事，雖然也都很可靠，但總感覺有點，說不上來的彆扭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870312,
					"content": "人類的情感真複雜啊…要不要推他們一把呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870313,
					"content": "彆扭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "算了，正事要緊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870315,
					"content": "#總之加油吧，那部重炮的操縱並不難，期待{F#妳}{M#你}們輕輕鬆鬆地把所有目標都轟得一個不留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870307,
					"content": "我們之前好像見過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "#居然還記得我？之前「海薇瑪映影歡樂城」招募員工的時候，我還投過履歷給{F#妳}{M#你}們喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746870309,
					"content": "好像，的確有這麼一回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870310,
					"content": "#我知道{F#妳}{M#你}們很強，什麼事都能放心交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "瑪因"
				}
			]
		}
	]
}