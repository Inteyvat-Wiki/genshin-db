				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "前輩，事態已經持續半天了，魔物還是沒有減少的跡象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870102,
					"content": "要不然，我還是去呼叫增援吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870103,
					"content": "不用慌張，相信我的重炮和那位便衣同事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870104,
					"content": "此外，對危機有著敏銳嗅覺的冒險家，甚至是某位長官…應該也會在第一時間趕來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870105,
					"content": "又有什麼危機？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "出現了…準領隊居然真的帶著小助手來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870108,
					"content": "兩位好，請讓我簡單說明事態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870109,
					"content": "嘿嘿，前輩先休息一下吧，說明工作交給我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870110,
					"content": "咳！想操縱重炮狂轟一番嗎？海軍艦隊全滅後，這種機會可不多了，說是夢回幾百年前也不為過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870111,
					"content": "用特製的彈頭成片成片擊倒魔物，怎麼想都很解壓吧，還能拿到警備隊的獎金呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870112,
					"content": "用大炮轟魔物…這個我們的確在行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870113,
					"content": "聽起來的確不複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "前輩，我理解你的喜悅之情。但現在應該緊張一點，還是讓我來為準領隊解釋吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870116,
					"content": "最近，工人們無意間在附近的地下挖出了一座遺蹟，驚動了裡邊沉睡的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870117,
					"content": "為了不讓魔物外逃，警備隊建立了防禦陣地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870118,
					"content": "不過，說是陣地，目前只有我們兩人和一位度假中的美露莘探員，還有我們改進過的一種炮臺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870119,
					"content": "噫！感覺有點危險！那位美露莘探員沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870120,
					"content": "放心，透過遠距離操縱遺蹟出口的重炮，那位美露莘探員不必親自上陣，也能將大部分魔物攔住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870121,
					"content": "她的確非常可靠，但長期高強度執勤，肯定也會累的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870122,
					"content": "#準領隊，{F#妳}{M#你}願意幫幫我們嗎？要是情況一直不妙，我會找來更多增援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870123,
					"content": "#不不，謝妮，妳也知道準領隊的手腕，應該做最好的打算——{M#他}{F#她}用我的炮臺直接消滅所有魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870124,
					"content": "你別說，我還真有興趣試試重炮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "放著眼前的事態不管，也不是我們的作風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870127,
					"content": "#太好了，多謝{F#妳}{M#你}們願意出手相幫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870128,
					"content": "#上次實驗之後，我又重新調整了自己的發明，希望{F#妳}{M#你}們用得順手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870129,
					"content": "哎，要是重炮能自己瞄準、自己發射就好了，前輩覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870130,
					"content": "對啊！下次我可以試著替重炮加上警衛機關的辨識模組，讓它們自行值班！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870131,
					"content": "不愧是前輩，真聰明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746870125,
					"content": "無論事態好壞，我都想來幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "但為什麼突然轟魔物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "我們來得正好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
