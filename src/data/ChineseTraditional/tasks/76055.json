			"dialogs": [
				{
					"id": 760550101,
					"content": "（<color=#FFCC33FF>菈烏瑪</color>似乎聽到了什麼…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "…奇怪。剛才聽見了什麼動靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550103,
					"content": "又有客人！轉動轉盤，停下轉盤，就有好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550104,
					"content": "（咦？客人怎麼不轉啊，快點快點，想吃好吃的！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550105,
					"content": "聽起來，像是一隻小狗…？轉動轉盤，有好吃的…這又是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550106,
					"content": "（客人！能和我說話，客人，快點轉動轉盤吧，不然我就吃不到好吃的啦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550107,
					"content": "你餓了嗎？來，我身上帶著一些餅乾，先吃一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550108,
					"content": "（嗚？客人不轉轉盤，客人要給我吃的…嗯，先吃，先吃。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550109,
					"content": "（謝謝客人，我是巴甫洛夫，謝謝客人的餅乾，好吃好吃。但妳沒有轉動輪盤呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550110,
					"content": "不客氣，但…你剛才說的轉盤，是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550111,
					"content": "（轉盤動了，讓它停下，好吃的會掉下來，每次都是這樣。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550112,
					"content": "（客人，妳真的不轉轉盤嗎？每個人轉完之後，都很高興。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550113,
					"content": "我就不用了，看起來…你在這裡過得還不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550114,
					"content": "（好啊，好啊，有人陪著我玩，轉盤陪著我玩，還有好吃的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550115,
					"content": "這樣就好。那麼，替我向你的主人問好，我先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760550116,
					"content": "（嗚…客人再見，客人下次再見。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴甫洛夫"
				}
			]
		},
