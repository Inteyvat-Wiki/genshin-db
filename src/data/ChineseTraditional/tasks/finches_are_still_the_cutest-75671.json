			"dialogs": [
				{
					"id": 756710101,
					"content": "啾啾，咕咕，啾啾啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710102,
					"content": "這是在…幹什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710103,
					"content": "密、密文？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "是哦！是和可愛團雀溝通的技巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710106,
					"content": "#哦，我好像忘了和{F#妳}{M#你}們打招呼了，還有那句必不可少的開場白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710107,
					"content": "#兩位路過的好心人，生論派的學者、新星商人和可愛動物專家拜希麥五世向{F#妳}{M#你}們問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710108,
					"content": "請放鬆身體、放空思緒，聽我說一件重要的事————",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710109,
					"content": "團雀最可愛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710110,
					"content": "完全正確！恭喜妳被團雀的可愛感染，開始了搶答！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710111,
					"content": "奇怪，不知道為什麼，好像看見桌上的遊戲，腦袋裡就冒出了這句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710112,
					"content": "#{F#妳}{M#你}有印象嗎，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710113,
					"content": "我們和這位女士以前見過吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "#沒錯！還不只一面之緣哦。看見{F#妳}{M#你}們還是如此活力滿滿，我感覺心裡很溫暖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710117,
					"content": "總之，要不要來試試看我身邊這個遊戲？第十七版，也就是第三世代的「哐哐噹噹雀雀球」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710118,
					"content": "在輕鬆休閒的遊玩之間，還可以瞭解大大的朱羽古團雀戰勝賊鷗的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710119,
					"content": "好哦好哦，輕鬆休閒的遊戲，我們一直都很喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710120,
					"content": "現在就玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "#嗯！希望{F#妳}{M#你}們能找到最適合自己的玩法，發現獨一無二的樂趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710121,
					"content": "開局開局！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "現在開始「團雀最可愛」也可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "對的！就算暫時想不起以前的事也沒關係，重要的是享受現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 756710104,
					"content": "暗、暗號？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}