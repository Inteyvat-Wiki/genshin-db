				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "#接下來就是解封之刻了，請{F#妳}{M#你}拿好之前的「月浴淵之鑰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330302,
					"content": "妳再說一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330303,
					"content": "「月浴淵之鑰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330304,
					"content": "妳再說三遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330305,
					"content": "「月浴淵之鑰」、「月浴淵之鑰」、「噦浴醃之浴」…切，咬舌頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330306,
					"content": "所以你們這個命名肯定有問題啊。改個名字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330307,
					"content": "就算要改也是幾百年後的人受益啦。這次妳就忍一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330308,
					"content": "咳咳，總、總之，我就要施行儀式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330309,
					"content": "十分可惜，我們並沒有淵下宮試煉的具體細節，接下來您只能依賴自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330310,
					"content": "這種保持神秘感的傳統真是壞東西。所以我也只能祝您好運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330311,
					"content": "另外，請您千萬不要逞強。您的安全是最重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
