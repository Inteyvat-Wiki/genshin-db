			"dialogs": [
				{
					"id": 722330401,
					"content": "#{NICKNAME}，還有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330402,
					"content": "關於鍵紋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "鍵紋被我們放在了「海神之鰭」與「海神之心」處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330404,
					"content": "其實我們也就是就近移開了一點。畢竟兩處海神之傷也還算是比較隱秘的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330405,
					"content": "盡力了，真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330406,
					"content": "關於祭壇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "祭壇在北方和正東邊。就在下面月浴淵的第二重山之垣上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330408,
					"content": "#如果{F#妳}{M#你}從珊瑚宮到「海神之鰭」與「海神之心」連兩條線…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330409,
					"content": "再和二重垣的弧線取兩個交點。就是這兩處啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
