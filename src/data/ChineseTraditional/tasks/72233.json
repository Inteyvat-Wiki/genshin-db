					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330502,
					"content": "關於白夜國…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "淵下宮曾經的名字就叫做白夜國。因為地下之國並無日月，只有白夜和常夜兩種天象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330504,
					"content": "我的家系之中曾有一位名叫烏帽子的巫女，在白夜國歷史裡也算個人物，所以才讓我負責「海祇御靈祭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		}
	]
