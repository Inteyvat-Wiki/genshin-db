			"trigger": {
				"objectNames": [
					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}，{F#妳}{M#你}們好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330102,
					"content": "露子小姐，取珊瑚的事情準備的怎麼樣了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330103,
					"content": "哎呀，這不是又遇到了難處嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330104,
					"content": "雖然露子小姐妳看起來悲傷地低下了頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330105,
					"content": "但這樣不停地給我們使眼色，未免也太露骨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330106,
					"content": "#嗚，果然{F#妳}{M#你}們也發現了情況危急。那我也不隱瞞了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330107,
					"content": "妳根本就沒想隱瞞吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330108,
					"content": "之前雖然初步取得了「月浴淵之鑰」，淵下宮正在緩慢甦醒。但是因為人手不足的原因，調查推進還是很慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330109,
					"content": "畢竟最近還是特殊時期嘛，和鳴神島的關係不知能不能緩和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330110,
					"content": "那，多我一個也不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "那可不一樣哦。要知道根據傳統，取珊瑚最需要的人，就是「勇者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330112,
					"content": "先建立根據地，然後協助「勇者」沿著先人足跡探索，最後迎來試煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330113,
					"content": "所謂穩紮穩打的策略就是這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330114,
					"content": "但是因為最近人手不足，所以沒辦法探索囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330115,
					"content": "正是如此，最關鍵的「勇者」現在連根頭髮絲都看不到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330116,
					"content": "現在好像看到了。似乎是一縷…一縷金髮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330117,
					"content": "嗚啊，聽起來好麻煩的樣子。根本不想蹚這蹚水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330118,
					"content": "不過探索通常都會發現一些奇珍異寶。按照慣例，拿到了都是要上繳珊瑚宮家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330119,
					"content": "#如果這次{F#妳}{M#你}下去找到點什麼的話，咱們睜一隻眼閉一隻眼也不是不可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330120,
					"content": "要不兩隻眼一起閉上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "英雄，大俠，好漢，救世主！這麼說您是同意囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330123,
					"content": "我們怎麼能對珊瑚宮的危險視而不見呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330124,
					"content": "您這麼說是最好不過了。看來按照心海大人教的話術，確實能哄到人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330125,
					"content": "#珊瑚宮大人甚至連{F#妳}{M#你}們會回來找我也預料到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330126,
					"content": "妳說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330127,
					"content": "沒什麼沒什麼。那麼請隨我來，我來向您展示一個東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330128,
					"content": "#我們就在前方下面的祭台那裡見面吧。如果{F#妳}{M#你}看不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330129,
					"content": "如果看不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330130,
					"content": "就在東南方向，眯起眼睛看就看到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330121,
					"content": "我和心海大人關係很好的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "這個叫做「鍵紋」，是曾經淵下宮的通行紋章。只有當通路打開之時，它才會在地上浮現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330202,
					"content": "據說是淵下宮甦醒之時，為海祇島之民遞送的另一組鑰匙。而這種鍵紋在珊瑚宮的記載裡，一共有五種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330203,
					"content": "目前我們在海祇島找到了其中的三種。如此操作之後就可以將其歸位，解開封禁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330204,
					"content": "我們之前特地將這三個從鍵紋孔上拔了下來，並且放置到了海祇島的其他地方。這樣可以讓屏障重新生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330205,
					"content": "就是為了防止不懂事的熊孩子幫、愚人眾間諜、鳴神島居民和外鄉人之類的傢伙，偷偷潛下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330206,
					"content": "哦，外鄉人當然不包括您啦。哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330207,
					"content": "現階段沒有辦法和冒險家協會取得聯繫，所以冒險家都不給放下去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330208,
					"content": "你們還會放冒險家下去的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330209,
					"content": "歷史上有這樣的紀錄啦，合作共贏嘛。畢竟探索是他們和您的強項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330210,
					"content": "哦豁，也就是說這次沒有別人偷跑的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330211,
					"content": "注意點吃相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "這怎麼說呢…這種臨時保護屏障挺不可靠的。因為從調查鍵紋位置到取出鍵紋的時間用得太久了，期間可能溜下去過幾個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330213,
					"content": "畢竟人手不夠嘛…所以您在下面如果遇到愚人眾、盜寶團、海亂鬼之類的，請毫不猶豫地把他們教訓一頓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330214,
					"content": "如果他們這麼容易就下去了，那之前我們拿到的月什麼鑰是為了什麼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722330215,
					"content": "只有取走「月浴淵之鑰」，淵下宮才會轉醒。同時只有用「月浴淵之鑰」開門，試煉系統才會運作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330216,
					"content": "如果不是為了海祇御靈祭前往淵下宮，或許確實可以靠著外道邪法溜進去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330217,
					"content": "#所以就希望{F#妳}{M#你}們能盡快動身，請去將海祇島其他「鍵紋」取回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330218,
					"content": "鍵紋被我們放在了「海神之鰭」與「海神之心」處。而兩座祭壇則在它們與珊瑚宮的連線裡，坐落於月浴淵的第二重山垣上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330219,
					"content": "那麼我就回到老地方靜候您的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
