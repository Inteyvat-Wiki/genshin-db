						210039903
					]
				},
				{
					"id": 210039903,
					"content": "#辛苦{F#妳}{M#你}了，真是不好意思，這本來是我的工作，還讓{F#妳}{M#你}跑了一趟…",
					"roleType": "TALK_ROLE_NPC",
