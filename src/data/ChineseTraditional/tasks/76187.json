			"dialogs": [
				{
					"id": 761870401,
					"content": "點心，真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "瑪梅赫"
				},
				{
					"id": 761870402,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761870404,
					"content": "欸？！這麼快嗎？好吧，謝謝桑多涅小姐！我們下次見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪梅赫"
				},
				{
					"id": 761870403,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
