	"talks": [
		{
			"id": 7365201,
			"completionStepIds": [
				7365201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365201",
							"2"
						],
						"stepId": 7365201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈賈娜德",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736520101,
					"content": "#終於回來了？我等{F#妳}{M#你}們好久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520102
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520102,
					"content": "來，向我詳細描述「重熔片劑」的效果吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520103
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520103,
					"content": "哈賈娜德真興奮啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520104
					]
				},
				{
					"id": 736520104,
					"content": "那我們要先說缺點哦，不怕打擊妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520105,
					"content": "向哈賈娜德詳細說明了「重熔片劑」的缺點與優點。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520106
					]
				},
				{
					"id": 736520106,
					"content": "原來如此…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520107
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520107,
					"content": "現在的爆炸無法精確控制混合的藥量，所以效果不太穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520108
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520108,
					"content": "還需要給小型炸藥裝上藥罩、收束爆轟波，並且改善預置片劑的排列…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520109
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520109,
					"content": "嗯，完成改進需要的時間不長，問題在於資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520110
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520110,
					"content": "好在之前還留下了救急預算。接下來每天只吃一頓飯，再賣掉老舊的器材，應該是夠用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520111
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520111,
					"content": "每天只吃一頓飯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520112,
					"content": "不行不行，這種事怎麼想都不能忍吧！妳的資金明明不太夠用，為什麼不早說啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520113,
					"content": "#哦，{F#妳}{M#你}們放心，給{F#妳}{M#你}們的報酬當然是不會少的，這筆預算最早就規劃好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520114
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520114,
					"content": "我以前也經常只吃一頓飯，有的時候每個星期只吃三頓，早就習慣了，沒問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520115
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520115,
					"content": "不用這麼拼吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520116
					]
				},
				{
					"id": 736520116,
					"content": "我還是很在意，一定要問清楚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520117,
					"content": "哈賈娜德小姐，妳這麼想當知名的學者，是為了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520118,
					"content": "是真的很喜歡學術研究嗎？是想證明自己的才能？還是用煉金術賺很多很多摩拉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520119,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520120
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520120,
					"content": "突然這麼問我，我也說不清…可能只是因為以前受過欺負，不甘心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520121
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520121,
					"content": "如果我能證明自己的能力，就可以生活得更有餘裕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520122
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520122,
					"content": "為了這種理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520123,
					"content": "妳就開始學術研究了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520124
					]
				},
				{
					"id": 736520124,
					"content": "對啊，在這個知識就是一切的國家，當然要靠學術能力來往上爬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520125
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520125,
					"content": "我沒什麼天賦，智商很平庸，只能選擇很少有人研究的冷門學科，來全力做出點成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520126
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520126,
					"content": "一個人埋頭搞研究太長時間，也不知道該怎麼和別人相處了，染上了怪脾氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520127,
						736520128
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520127,
					"content": "世界上還是好人居多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				},
				{
					"id": 736520129,
					"content": "對哦，現在的妳也有更厲害的目標了，可以生活得更大氣一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520130,
					"content": "如果妳抱著平常心，好好和別人說話，肯定還有很多人願意幫妳，和妳一起研究的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520131,
					"content": "謝謝啦，這些道理我還是明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520132
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520132,
					"content": "我已經發現了，研究煉金術挺有趣的，比考慮柴米油鹽和人情世故要輕鬆多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520133
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520133,
					"content": "#遇見{F#妳}{M#你}們以後，我也反省過自己，我確實應該好好收斂一下情緒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520134
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520134,
					"content": "#總之，多謝{F#妳}{M#你}們幫我試驗「重熔片劑」，我該回城裡去寫論文了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520135
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520135,
					"content": "#除了說好的報酬，這個也送給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520136
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520136,
					"content": "這個是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520137
					]
				},
				{
					"id": 736520137,
					"content": "我最好的煉金釜，以前花了不少積蓄買下來，結果一直沒捨得用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520138
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520138,
					"content": "#喂！{F#妳}{M#你}怎麼突然連自己最寶貴的工具都不要了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520139,
					"content": "「重熔片劑」和傳統藥劑不一樣，需要用我全新設計的器材來製作，所以我也用不到這個煉金釜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520140
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520140,
					"content": "#畢竟，給{F#妳}{M#你}們的報酬裡，還有一個承諾呢，就把這個煉金釜當成見證物好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520141
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520141,
					"content": "#{F#妳}{M#你}們也可以試試用它…煮茶或者煮湯？它有促進萃取的功能，煮出來的湯汁應該挺好喝的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520142
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520142,
					"content": "既然妳都這麼說了…我們也不好拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520143,
					"content": "加油啊，哈賈娜德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520144
					]
				},
				{
					"id": 736520144,
					"content": "當然！等著我的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520145
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736520145,
					"content": "哈賈娜德離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520146
					]
				},
				{
					"id": 736520146,
					"content": "#{NICKNAME}，{F#妳}{M#你}說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520147,
					"content": "這次我們算是做了一件好事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520148,
						736520149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520148,
					"content": "只是冒險的日常罷了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520150,
					"content": "說得也是呢，現在還不急著下定論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520151,
					"content": "說不定等到我們都忘了這件事的那天，突然聽到消息，哈賈娜德當上了學者，邀請我們去看望她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520152,
					"content": "不亂想了，走吧走吧。我要試試用這個煉金釜煮茶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736520149,
					"content": "我們也要抱著平常心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520128,
					"content": "不必拘泥於過去的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				}
			]
		}
	]
}