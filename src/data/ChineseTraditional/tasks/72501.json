			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝霧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "森子小姐怎麼總是分給我這種奇怪的稿件啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010202,
					"content": "妳還在畫插畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "妳又沒靈感了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "#呀！旅行者，{F#妳}{M#你}怎麼來了？好久沒看到{F#妳}{M#你}，我還以為{F#妳}{M#你}已經去別的地方旅行了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010205,
					"content": "#唉…要是我身體能好點，我也想和{F#妳}{M#你}一樣出去旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010206,
					"content": "這樣的話，就不用每天都被森子小姐當面催稿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010207,
					"content": "上次我畫的那些稿件似乎很受好評，好多老師都專門要我為他們畫插畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010230,
					"content": "雖然森子小姐已經幫我推掉了很多約稿，但留下來的那一部分也還是太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010208,
					"content": "而且，「八重堂」裡的老師們所寫小說的題材越來越…越來越誇張了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010209,
					"content": "我最開始以為他們除了稻妻之外，最多就寫一寫蒙德啦、璃月啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010210,
					"content": "但老師們筆下小說的題材…已經立足須彌，放眼楓丹啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010216,
					"content": "#嗯…說回正事，旅行者啊，{F#妳}{M#你}手上的那台「留影機」還好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010217,
					"content": "我覺得它應該還滿好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "妳又要我幫妳拍畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "#{F#妳}{M#你}看，上次我開給{F#妳}{M#你}的報酬還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010220,
					"content": "#旅行者，就請{F#妳}{M#你}再幫我去世界各地拍一拍畫片吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010221,
					"content": "唉，交給我吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "妳去冒險家協會掛個委託吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "#那就拜託{F#妳}{M#你}了！嘿嘿，我早就把筆記本準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010223,
					"content": "#要是{F#妳}{M#你}不來找我呀，我都要拜託森子小姐去找{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010225,
					"content": "#嗚哇！別呀！拜託{F#妳}{M#你}了、拜託{F#妳}{M#你}了嘛！我去冒險家協會掛過委託，但就是找不到會熟練使用留影機的冒險家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010226,
					"content": "#{F#妳}{M#你}就幫幫我吧旅行者，我要是交不出稿，森子小姐又要跑來和我一起住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010227,
					"content": "#我可受不了她做的那種緋櫻泡飯啊，旅行者！{F#妳}{M#你}就幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 725010228,
					"content": "我知道了，我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "呼…那就好，稍等一下啊，我找一下筆記本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				}
			]
		}
	]
}