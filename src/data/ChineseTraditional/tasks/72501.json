			"completionStepIds": [
				7250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7250102",
							"2"
						],
						"stepId": 7250102,
						"stateName": "QUEST_STATE_UNFINISHED"
