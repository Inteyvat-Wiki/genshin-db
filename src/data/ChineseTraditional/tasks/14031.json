			},
			"dialogs": [
				{
					"id": 140310101,
					"content": "…還是不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310102
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310102,
					"content": "不行，我整個楓丹廷都跑過一遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310103
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310103,
					"content": "琳妮特聽到要連續幾天在外面跑，耳朵都垂下來了。菲米尼好像覺得生人太多，直接把頭縮進了頭盔裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310104
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310104,
					"content": "千織和夏洛蒂呢？感覺她們能夠勝任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310105
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310105,
					"content": "我問過了，但她們最近都很忙，沒有空閒。另外我剛給刺玫會成員放了幾天假，不想因為這事打擾大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310106
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310106,
					"content": "…難辦了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310107,
					"content": "娜維婭！克洛琳德！妳們好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310108,
					"content": "#天哪！是我的好搭檔和派蒙！{F#妳}{M#你}們好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310109
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310109,
					"content": "…娜維婭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310110
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310110,
					"content": "…哦！妳的意思是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310111
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310111,
					"content": "嗯，機會來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310112,
						140310113
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310112,
					"content": "…妳、妳們要幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				},
				{
					"id": 140310114,
					"content": "妳們這是遇到什麼難事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310115,
					"content": "#沒錯！我的好搭檔，有個天大的難事，眼下只有{F#妳}{M#你}們能幫我們解決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310116
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310116,
					"content": "這麼誇張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310117,
					"content": "毫不誇張。已經走投無路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310118,
						140310119
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310118,
					"content": "到底是多大的難事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310120,
					"content": "#{NICKNAME}，派蒙…{F#妳}{M#你}們願意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310121
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310121,
					"content": "——來玩《逐影獵人：審判之時》嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310122
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310122,
					"content": "什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310123,
					"content": "一個由楓丹「桌上劇團」俱樂部推出的遊戲劇本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310124
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310124,
					"content": "#{F#妳}{M#你}們聽過「桌上劇團」吧？就是和好朋友圍在桌前，扮演劇中角色，參與劇本故事的遊戲。我小時候就愛玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310125
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310125,
					"content": "好像滿有趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310126,
					"content": "我和克洛琳德都是俱樂部裡的老會員了。最近，有人找到我，說他們出了一個新劇本，想請人免費試玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310127
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310127,
					"content": "這可是一個全新的劇本欸！我們是第一批體驗者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310128
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310128,
					"content": "試玩階段的劇本一般來說會有很多瑕疵，但這次的我覺得不錯，完成度比較高，作者的分析也很到位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310129
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310129,
					"content": "欸停停停！劇本我一個字沒看就直接拿給妳了，千萬別在這裡劇透！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310130
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310130,
					"content": "…總之，這個劇本要求四位扮演者，現在三缺一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310131
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310131,
					"content": "…那還真是天大的麻煩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310132
					]
				},
				{
					"id": 140310132,
					"content": "#{F#妳}{M#你}果然也這麼覺得吧？我的好搭檔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310133
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310133,
					"content": "#但我和{NICKNAME}是兩個人欸，這沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310134,
					"content": "#沒問題，我會根據實際參與人數把控節奏的，保證{F#妳}{M#你}們的遊玩體驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310135
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310135,
					"content": "#嘿嘿，{F#妳}{M#你}怎麼看？想玩嗎？我聽{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310136,
						140310137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310136,
					"content": "朋友有難怎能不幫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310138,
					"content": "好。那現在問題就解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310139
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310139,
					"content": "太棒了！我這就去俱樂部叫劇本管理人過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310140
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310140,
					"content": "劇本管理人？劇本不就在克洛琳德手裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310141,
					"content": "配合這個劇本，俱樂部推出了全新的遊玩方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310142
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310142,
					"content": "一開始主持人手中的劇本並不完整，需要跑完目前階段的劇情，才能從劇本管理人那邊接到下一階段的劇本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310143
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310143,
					"content": "而且，俱樂部還會在現實中搭建劇中場景，讓參與者身臨其境，實景參與。第一天的遊玩地點，得等劇本管理人告訴我們才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310144
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310144,
					"content": "哇，聽起來寫這個劇本的人真的很用心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310145,
					"content": "嘿嘿，而且還很有懸念對吧？就連主持人都不知道故事的結局呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310146
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310146,
					"content": "#我很期待和{F#妳}{M#你}們共同見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310147
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310147,
					"content": "#{F#妳}{M#你}們先去和其他人會合吧，他們還在千織屋等著呢，我待會就和劇本管理人一起過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310148
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310148,
					"content": "好，不要著急，小心看路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310149
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310149,
					"content": "妳怎麼把我說得像個小孩子一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310150
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310150,
					"content": "唔…讓我想想，這次該扮演一個什麼樣的角色呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310151
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140310151,
					"content": "…希望這次妳能學一些正常的技能。另外，別再試圖對每一隻見到的動物都使用「說服」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310137,
					"content": "好的劇本怎麼可以不玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310119,
					"content": "先聽聽看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310113,
					"content": "…我，我只是路過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				}
			]
		},
