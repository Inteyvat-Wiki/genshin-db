				]
			},
			"dialogs": [
				{
					"id": 765110101,
					"content": "按照奈芙爾女士的預測，比賽進行到現在，那位高手差不多要到場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110102,
					"content": "#的確，澤西切先生，晚風已經捎來了{M#他}{F#她}的氣息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110103,
					"content": "#久違了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110104,
					"content": "#看見{F#妳}{M#你}們容光煥發的狀態，我由衷欣喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110105,
					"content": "居然是萬葉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "沒想到，萬葉也會來挪德卡萊，還和這位執燈人先生聊上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110108,
					"content": "不對，周圍的情況…氣氛怎麼有點緊張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110109,
					"content": "緊張是理所當然的，畢竟賽事已經到達了白熱化的階段，各地的「武學高人」都在等待最終結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110110,
					"content": "比拼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "沒錯，歡迎來到「挪德卡萊有限制冷靜格鬥賽」的決賽現場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110113,
					"content": "相比肆意出招，天馬行空的比武，這次格鬥賽更聚焦於淳樸的武器技藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110114,
					"content": "因此，我們組委會才委託冒險家協會，邀請到了這位「南十字船隊」的頂尖劍客，擔任我們的顧問！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110115,
					"content": "我明白了，這次萬葉成了武鬥會的評審！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110116,
					"content": "是的，我之前也略感意外，沒想到那場比武的消息居然傳到了挪德卡萊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110117,
					"content": "大姐頭她們前不久才在那夏鎮參了展，處理完了這裡的所有事務，短時間內不會再來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110118,
					"content": "而我相對空閒，又有著「南十字武鬥會」的一些經驗，所以就答應了澤西切先生的邀請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110119,
					"content": "多虧萬葉先生那敏銳的觀察力，還有近乎絕對客觀的評價，一些混亂的賽況才能被準確判明結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110120,
					"content": "不過現在又難辦了，三位冠軍候選者各有優勢，互相破不了對方的招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110121,
					"content": "這樣打下去，再來幾天幾夜都沒個結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110122,
					"content": "嗚啊，比賽打不出結果？還真是從沒聽過的情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110123,
					"content": "依我看，還是實行那個方案好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110124,
					"content": "沒錯，還是要麻煩這位專家中的專家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110125,
					"content": "#咦，焦點怎麼轉移到了{NICKNAME}身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110126,
					"content": "#如果{F#妳}{M#你}能稍微露兩手，僵局就會被打破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110127,
					"content": "我來打表演賽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "#不，是由{F#妳}{M#你}這位「南十字武鬥會」的冠軍，武學界的絕對泰斗，來扮演決定冠軍的最終試煉人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110130,
					"content": "#{F#妳}{M#你}分別對戰三位冠軍候選人，以他們對{F#妳}{M#你}造成的威脅來評分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110131,
					"content": "最終，分數最高的一位便將獲得冠軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110132,
					"content": "#而為了答謝{F#妳}{M#你}為比賽做出的貢獻，原定冠軍一半的獎金，將作為酬勞支付給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110133,
					"content": "還有這種解決方式嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110134,
					"content": "既能搞定比賽僵住的麻煩，又給足了我們面子和好處…不愧是萬葉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765110135,
					"content": "這種事，我還真沒體驗過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "真爽快，那就這麼說定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "澤西切"
				},
				{
					"id": 765110138,
					"content": "#有勞{F#妳}{M#你}了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110139,
					"content": "#三位對手各有看家本領，相信{F#妳}{M#你}會享受這次的切磋，並展現出往屆冠軍的英姿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 765110136,
					"content": "的確是非常新奇的做法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "我給大家助興？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "武學？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "好久不見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}