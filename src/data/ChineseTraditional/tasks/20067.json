					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "旅行者…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670104,
					"content": "#自從上次{F#妳}{M#你}幫我輔導之後，我又很認真地學習了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670105,
					"content": "然後，我就請傑克來幫我做了一次模擬考試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670106,
					"content": "結果…結果考下來，我不及格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670107,
					"content": "#真不知道是哪裡出了問題…旅行者，{F#妳}{M#你}能再輔導我一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670108,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670111,
					"content": "唔…第一個問題是，在飛行時，最多可以同時幾人共用一架風之翼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670109,
					"content": "（難道上次有答案錯了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
