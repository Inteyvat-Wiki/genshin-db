					"蘭利遮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "這下事情總算是告一段落了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270402,
					"content": "說起來，還真是一段漫長的冒險呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270403,
					"content": "說給加扎里先生聽的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "對喔，他要是知道了爐心的事情，還可以幫我們申請經費什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270405,
					"content": "#不過，我可不想進入什麼教令院。{NICKNAME}，{F#妳}{M#你}也不想的，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270409,
					"content": "總之，雖然不知道「無留陀的化身」到底和這些深淵教團有什麼關係，不過治好了森林的「病」，也是件好事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270410,
					"content": "#嗚嗚嗚，蘭利遮謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270411,
					"content": "不用謝，蘭利遮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "不過接下來，蘭利遮打算怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270413,
					"content": "蘭利遮要去參加無憂節，不過蘭利遮很擔心森林的「病」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270414,
					"content": "可能還會有希望森林生病的壞東西回來，蘭利遮要保護森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270415,
					"content": "所以無憂節之後，蘭利遮還要回來這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270416,
					"content": "蘭那羅也很辛苦啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "如果蘭利遮需要什麼幫助的話，一定要過來找我們喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270418,
					"content": "嗯嗯，蘭利遮知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270419,
					"content": "嘿嘿，要照顧好自己，我們一定還會再見面的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270406,
					"content": "說給羅因賈爺爺的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "對喔，羅因賈爺爺一定會說「真是有趣的故事啊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270408,
					"content": "誰知道我們真的拯救了森林呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}