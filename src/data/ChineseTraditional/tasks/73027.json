						"rawParams": [
							"7302705",
							"2"
						],
						"stepId": 7302705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "那裡面那個發光的東西，應該就是加扎里先生說的，上面那個大傢伙的混沌爐心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270302,
					"content": "雖然看起來是被樹枝和藤蔓封印住了，但好像有什麼東西一直從裡面流出來的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270303,
					"content": "嗚嗚，是髒東西，蘭利遮能感覺到，就是這個讓森林生病的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270304,
					"content": "唔，有好多深淵法師在那幾根大樹枝旁邊不知道在做些什麼，總感覺沒有什麼好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270305,
					"content": "我記得加扎里先生說過，爐心的封印受到了破壞，該不會就是這些深淵法師搞的鬼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270306,
					"content": "總之蘭利遮先去外面找地方躲起來吧，我們去阻止他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
