			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭利遮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "咦，蘭利遮，你怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270202,
					"content": "#蘭利遮種完花花之後就一直待在這邊等{F#妳}{M#你}們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270203,
					"content": "結果不知道為什麼剛才大鐵山突然有東西掉下來，差點砸到蘭利遮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270204,
					"content": "嗚啊，蘭利遮對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270205,
					"content": "派蒙為什麼要道歉，蘭利遮沒關係的，蘭利遮跑得快，所以不會被砸到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730270206,
					"content": "總之你沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "看來大機器人斷掉的手臂真的把通往地下遺蹟的入口砸開了。總算還是發揮了一點作用嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270208,
					"content": "既然這樣我們就下去看看吧，不知道會有什麼壞東西在等著我們呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270209,
					"content": "#蘭利遮和{F#妳}{M#你}們一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭利遮"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
