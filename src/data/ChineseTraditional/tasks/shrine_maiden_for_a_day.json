			"dialogs": [
				{
					"id": 191451601,
					"content": "希望雷神大人保祐這位婆婆和她的孫女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 191451602,
					"content": "關於婆婆的眼睛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "#{F#妳}{M#你}們也注意到了嗎？是啊，婆婆看東西不太清楚，每次上山來我們都有些擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 191451604,
					"content": "不過她總是不願意多麻煩我們，說自己走了這麼多年，一個人也能上下山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 191451605,
					"content": "還好山道上也有神社的巫女，多少也能照看著些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 191451606,
					"content": "雷神保祐，祝婆婆和她的孫女都能一路平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城螢美"
				}
			]
