			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"多莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#哎呀，這不是{NICKNAME}和派蒙嗎！想不到在這裡也能和兩位相遇，這一定是能帶來好運的奇妙緣分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060102,
					"content": "多莉！妳怎麼一個人在這裡呀？難道是擺攤賣東西嗎？欸，不過我怎麼沒看到妳的商品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060103,
					"content": "真是不好意思，今天大名鼎鼎的旅行商人多莉暫時店休哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060104,
					"content": "我現在啊，正學著那些挪德卡萊的當地人，在這座「樂園」裡度過普普通通又自由自在的一天呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060105,
					"content": "哇，真的假的？沒在忙著做買賣、賺摩拉的多莉，真的是比沙漠裡下雨還要少見啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060106,
					"content": "哼哼，就算我本人在享受難得的假期，我那些店鋪和勤勞能幹的員工們，也依然在不停地為我賺取源源不絕的摩拉呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060107,
					"content": "只要我帳戶裡的數字還在不斷上升，那就沒什麼好擔心的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060108,
					"content": "這麼說來，兩位難道是遇到了什麼難題嗎？雖然我還在休假，但是對於送上門來的生意，我可是從來都不會拒絕的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060109,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "#哦哦，原來是想記錄下挪德卡萊的獨特風光啊！那{F#妳}{M#你}們算是問對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060112,
					"content": "#我對這裡的熟悉程度，雖然可能還比不上那些土生土長的地頭蛇，但是說到風景獨特的拍攝點，我還是能為{F#妳}{M#你}們推薦不少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060113,
					"content": "#看在我們這麼熟的份上，我親自給{F#妳}{M#你}們當導遊，費用就給{F#妳}{M#你}們打個骨折友情價，一天只收你們區區五十萬摩拉！怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060114,
					"content": "嗚哇…不愧是多莉，還是三句話離不開從我們的口袋裡掏摩拉的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060115,
					"content": "哎呀呀，我這可都是為了讓我最重要的客戶，能在挪德卡萊留下一段最開心、最難忘的美好回憶嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060116,
					"content": "既然妳如此盛情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "欸？為我拍照？這個提議聽起來倒滿有趣的。不過嘛，這些畫片可不能用於商業宣傳哦，我的肖像權可是價值連城的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060119,
					"content": "放心好了，我們只是單純想給熟人拍個照，留作紀念而已啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765060120,
					"content": "#好好好，既然是{NICKNAME}親自開口，我就破例為你們當一次模特兒。請務必把我拍得雍容華貴、氣質非凡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060121,
					"content": "我想想啊…畫片的題目嘛，就叫「多莉·桑歌瑪哈巴依老爺的樂園假日」。是不是很棒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 765060117,
					"content": "能否為妳拍攝畫片呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
