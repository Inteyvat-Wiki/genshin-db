			"dialogs": [
				{
					"id": 790501501,
					"content": "嘿嘿，大功告成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501502,
					"content": "「小水珠」們都很開心的樣子，我的心裡也暖暖的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501503,
					"content": "我們守護了友情的結晶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "嗯，這樣一來，那位畫家在「琉形蜃境」的朋友和作品，全都保持著最完美的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501506,
					"content": "希望將來的某天，他還能回來和朋友們相聚，看看自己留下的傑作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501507,
					"content": "說起來，這幅畫的風格還滿特別的…看起來不算特別華麗，但也非常美觀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501508,
					"content": "重要的是，我也能看懂，說不定，模仿一下這幅壁畫的風格，我也能畫出很漂亮，很好懂的畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501509,
					"content": "高水準的畫作不一定複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "#嗯！如果{F#妳}{M#你}覺得沒問題，可以為這幅壁畫留影哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501512,
					"content": "這樣一來，我就能隨時學習那個畫家的技巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790501514,
					"content": "說不定，等我畫出了漂亮的畫，也會有「小水珠」被吸引過來，成為我們的好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
