			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "完了，這下全都完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "嗚…小安說，我可能不太適合這份工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140104,
					"content": "這不就是要辭退我了嗎？該怎麼辦啊，嗚…我明明每天都在認真工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140105,
					"content": "咦？為什麼突然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "#那個…我之前不是拜託過{F#妳}{M#你}…幫我去數船嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140107,
					"content": "#因為我相信{F#妳}{M#你}的能力嘛，就沒有多複核，直接把數據報上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140108,
					"content": "結果，好多數據都錯了…小安發了很大的火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140109,
					"content": "#{F#妳}{M#你}能幫我去和小安說說嗎？我，我之後一定認真工作！也盡量不拜託{F#妳}{M#你}幫忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140110,
					"content": "但我自己是不敢去問他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140111,
					"content": "是之前統計船隻出錯了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "#對啊，之前我不是拜託{F#妳}{M#你}統計過船隻數嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140113,
					"content": "#因為我相信{F#妳}{M#你}的能力…就沒複核數據，直接報上去了，好多數據都錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140114,
					"content": "#但是我也只是偶爾拜託{F#妳}{M#你}，我自己也統計了很多資數據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140115,
					"content": "兩邊混在一起，我連哪裡錯了都不知道，小安發了很大的火…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140116,
					"content": "#拜託{F#妳}{M#你}去和小安說說吧！我，我之後一定認真工作！也盡量不拜託{F#妳}{M#你}幫忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140117,
					"content": "但我自己是不敢去問他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				}
			]
		},
		{
