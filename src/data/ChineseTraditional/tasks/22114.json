			"trigger": {
				"objectNames": [
					"小安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "唉，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140202,
					"content": "關於霖鈴的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "#嗯？{F#妳}{M#你}問霖鈴的事啊，哦，她…怎麼說呢，不太適合這份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140204,
					"content": "具體地說，就是…她上報的數據錯誤得太過分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140205,
					"content": "這週內的資料，只有一到兩天是正確的，就算是純目測都比她算得準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140206,
					"content": "這樣子的工作態度，我怎麼能把工作放心交給她呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140207,
					"content": "只是數船的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "在工作的時候，任何事前面都不能加上「只是」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140209,
					"content": "只要木桶裡的某一塊木板略短，那麼整個木桶的品質都會下降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140210,
					"content": "工作也一樣，對任何一件事掉以輕心，都只會讓整項工作全部落入泥潭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140211,
					"content": "就拿統計船隻數目作比方。假如統計的船隻數量不準確，那麼針對碼頭的各項舉措一定也不準確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140212,
					"content": "不準確的舉措，絕對會帶來糟糕的後果。就算是有人來補救，但白白消耗的時間也已經回不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140213,
					"content": "#這麼說，{F#妳}{M#你}們明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140214,
					"content": "我，我明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "…不過，現在碼頭上實在是太缺人了，辭退…應該不會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140216,
					"content": "怎麼說呢…「一塊木板略短」總比「一塊木板暫缺」好，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140217,
					"content": "#負責複核貨物的人臨時有事來不了，{F#妳}{M#你}們回去告訴霖鈴，讓她去這裡臨時幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140218,
					"content": "如果這項工作她沒出什麼大問題的話，等負責那塊的人回來了，她可以繼續回去統計船隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140224,
					"content": "嗯…這算是一個「測試」吧，也算是給她一個機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140225,
					"content": "把這份貨物單給霖鈴，讓她按著這個來檢查吧，檢查一項之後，就在後面標記好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140226,
					"content": "#還有，{F#妳}{M#你}們告訴霖鈴，讓她打起精神來，如果這份工作再出錯的話，就沒有第二次機會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小安"
				},
				{
					"id": 221140219,
					"content": "我，我會和霖鈴說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "#{F#妳}{M#你}們回去說什麼？辭退？不，辭退暫時不會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140221,
					"content": "碼頭上實在是太缺人了，怎麼說呢…「一塊木板略短」總比「一塊木板暫缺」好，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140222,
					"content": "#負責複核貨物的人臨時有事來不了，{F#妳}{M#你}們回去告訴霖鈴，讓她去這裡臨時幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "小安"
				},
				{
					"id": 221140223,
					"content": "如果這項工作她沒出什麼大問題的話，等負責那塊的人回來了，她可以繼續回去統計船隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "小安"
				}
			]
		},
		{
