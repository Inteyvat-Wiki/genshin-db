						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "#{F#妳}{M#你}們確認好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140502,
					"content": "確認好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "太好了，我也準備差不多了，等會我就去把那些貨物全部複核一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140506,
					"content": "#對了！這個給{F#妳}{M#你}，就當做是答謝了，請收下吧。等一下我就去複核貨物，這次絕對不能再出問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140504,
					"content": "妳沒有寫詩吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "當然沒有！我也是分得清輕重緩急的人，現在可不是寫詩的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "霖鈴"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "嗚…以後不能寫詩了，要更認真工作才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140602,
					"content": "還是工作比較重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "我知道啦，但是，一天到晚都做一件事，年復一年的…總會無聊嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140604,
					"content": "而且，還是這種邊邊角角的小工作，沒什麼價值，也沒人會在意，不由自主就開始摸魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140605,
					"content": "唉，雖然小安總是說「每項工作都有重要的價值」，「每項工作都是決定性的」之類的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140606,
					"content": "但是，如果真是這樣，那為什麼工作的時候，大家還是挑挑揀揀的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140607,
					"content": "工作要負責。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "#我也只是偶爾拜託{F#妳}{M#你}幫忙啦，大部分時候還是我自己來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140609,
					"content": "#工作負責…我當然也知道。但越是工作忙的時候，卻越是想要再偷偷懶，所以才會找{F#妳}{M#你}來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140610,
					"content": "如果真閒下來了，反而想要四處找點事情做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140611,
					"content": "#哎呀，{F#妳}{M#你}還沒工作過吧，說了{F#妳}{M#你}應該也不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140612,
					"content": "為什麼這麼想寫詩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "#怎麼突然問這個？我想想…{F#妳}{M#你}覺得，一個人工作是為了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140614,
					"content": "在我看來，如果是「為了繼續工作而工作」的話，未免有些太無聊了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140615,
					"content": "怎麼說呢，人總是要有點夢想的，對吧？和日常的冗雜工作完全不同的「夢想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140616,
					"content": "這樣的話，在很累很疲憊，快要堅持不下去的時候，至少可以在「夢想」裡放鬆一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140617,
					"content": "不過，這也只是我的想法，那些冒險家是怎麼想這個問題的，我是不知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140618,
					"content": "畢竟他們那副純為夢想而生的樣子，我覺得反而需要一點日常工作來約束一下自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140619,
					"content": "#不過，哈哈哈…{F#妳}{M#你}可要以我為鑑吶，「夢想」就只是「夢想」而已，工作的時候還是要腳踏實地呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				}
			]
		},
