			"dialogs": [
				{
					"id": 221140301,
					"content": "嗚…工作可怎麼辦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140302,
					"content": "小安說給妳個機會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "真的嗎？！太好了，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140304,
					"content": "咦？複核貨物？糟了，我，我從來沒做過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140305,
					"content": "要是這次工作再出錯，我肯定徹底完了，不行，我要準備準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140306,
					"content": "我要去找找之前的貨物複核標準…還有之前寫過的標準格式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140307,
					"content": "#能請{F#妳}{M#你}們幫我先去確認一下貨物的數量嗎？先對著單據，看看貨物的數量是不是正確的就好，我之後會再去做更詳細的核查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140308,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "#那就拜託{F#妳}{M#你}們了！我在這裡接著做複核的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140310,
					"content": "這次不能再出錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140311,
					"content": "都交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "不，這次不行。複核貨物比統計船隻複雜多了，必須要我自己來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140313,
					"content": "#所以，請{F#妳}{M#你}們先去確定一下貨物的數量吧，我會再去做具體複核。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
