					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "是誰？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540102,
					"content": "別緊張，雷澤，是我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540103,
					"content": "妳是…妳也是騎士團的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540104,
					"content": "什麼，原來你們不認識嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540105,
					"content": "「紅色，很燙的女孩子」——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "不認識。雖然也是紅色，但是沒有那個人那麼燙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540108,
					"content": "#啊，我明白了。{F#妳}{M#你}們之前說的狼少年就是他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540109,
					"content": "正是。他叫做雷澤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540110,
					"content": "幫我一個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540111,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540112,
					"content": "來不及解釋了。我讓盧皮卡散開了。因為那群人來了。他們沒有善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540113,
					"content": "就是剛才那些傢伙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540114,
					"content": "明白了。不過在那之前，我有些事情想要問你——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540115,
					"content": "有血的氣味。我們要快點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540116,
					"content": "難道說是那群傻子被狼襲擊了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540106,
					"content": "真的不是安柏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
		{
