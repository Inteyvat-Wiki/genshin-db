			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "是牠。被那群人抓住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541302,
					"content": "真是過分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541303,
					"content": "雖然我也覺得很淒慘，但是我的立場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541304,
					"content": "襲擊村子的不是我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541305,
					"content": "是流浪而來的黑狼，還有牠的狼群。牠們想要領地。牠們破壞了牠定下的規矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>牠？</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541307,
					"content": "這片土地的領主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541308,
					"content": "這句話剛才聽過了。你還是解釋一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541309,
					"content": "我要把盧皮卡抱到深處去。和我一起來吧。或許牠會現身回答妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷澤"
				}
			]
		},
