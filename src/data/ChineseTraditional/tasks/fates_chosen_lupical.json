			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "是血跡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541102,
					"content": "不是人，是狼的。是盧皮卡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541103,
					"content": "所以盧皮卡究竟是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541104,
					"content": "盧皮卡——是命運的家族。如果狼接納了人，或者人接納了狼。他們就是盧皮卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541105,
					"content": "聽起來不像是人的語言啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541106,
					"content": "這話就很奇怪了。難道狼的交流還會用語言的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541107,
					"content": "是牠定下的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541108,
					"content": "…牠，說的是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541109,
					"content": "這片土地的領主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541110,
					"content": "蒙德的主人，不應該就是巴巴托斯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541111,
					"content": "之後再說，我好像又找到線索了。跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541112,
					"content": "欸，你等等！我可是在給你機會解釋自己的清白喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541113,
					"content": "啊，雷澤已經走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
