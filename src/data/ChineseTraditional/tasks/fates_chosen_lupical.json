					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "我們回來啦！你看看這些夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540302,
					"content": "足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540303,
					"content": "剛才和他談了一下。狼群世界的規則，很不可思議啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540304,
					"content": "#謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540305,
					"content": "繞了一圈都沒有找到其他狼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540307,
					"content": "狼平常是這樣的。剛才抓到那條明顯是智力有點問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "約頓"
				},
				{
					"id": 4540308,
					"content": "幹、幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540309,
					"content": "找你算帳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4540310,
					"content": "就是他，傳聞裡被狼養大的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "約頓"
				},
				{
					"id": 4540311,
					"content": "嚯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540312,
					"content": "原來就是你。我還在想狼怎麼這麼聰明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540313,
					"content": "是你在幫著畜生算計人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540314,
					"content": "誰給吃誰就是父母嗎，你忘了自己是個什麼東西了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540315,
					"content": "夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540316,
					"content": "你們這是欺負雷澤不擅長說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540317,
					"content": "嗯？！騎士團要袒護這個人嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "約頓"
				},
				{
					"id": 4540318,
					"content": "不是我們，襲擊村子的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷澤"
				}
			]
		},
