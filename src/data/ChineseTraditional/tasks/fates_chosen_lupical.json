			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "這裡是……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}，請{F#妳}{M#你}幫我一個忙。幫我收集這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541503,
					"content": "這個不是鉤鉤果的種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541504,
					"content": "它碾碎了包紮，可以止血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541505,
					"content": "的確。鉤鉤果的種子上面有層汁液，不僅能輕微麻醉痛覺，還能止血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541506,
					"content": "書上這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541507,
					"content": "為什麼會這樣啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541508,
					"content": "這我就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541509,
					"content": "鉤子讓種子散佈。麻醉與止血，為了不痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541510,
					"content": "我們會更難察覺它，把它帶得更遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541511,
					"content": "…紫色的老師，是這麼和我說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541512,
					"content": "我要留在這裡照看牠。還有，回答另一個紅色女孩子的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 4541513,
					"content": "嗯，如果人群回來了，騎士團的面子應該有點作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541514,
					"content": "#你的狼朋友們並沒有洗脫嫌疑呢。不過，{NICKNAME}，草藥還是麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		}
	]
