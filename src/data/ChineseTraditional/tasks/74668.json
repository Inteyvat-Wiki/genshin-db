			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "咦，剛才七天神像是不是突然很誇張地亮了一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680102,
					"content": "好奇怪，以前發生過這樣的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680103,
					"content": "七天神像發光很正常吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}，沒有覺得不舒服吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680108,
					"content": "嗯，水…水在對我說話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "最好是能說啦！還有心情開玩笑，看來沒什麼問題嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680112,
					"content": "不過，在那陣光亮起來之後，周圍的空氣的確變得稍微潮濕了一點，說不定也是剛才冒出的水元素力的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680113,
					"content": "哼哼，聽說在楓丹，如果能好好運用元素力，就能夠在水下暢游，說不定還能撿到掉在水裡的寶藏喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680114,
					"content": "#打撈寶藏的工作，就交給{F#妳}{M#你}了，我…我就負責在岸上為{F#妳}{M#你}把風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680115,
					"content": "一個人下水，好寂寞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "嗚，但是、但是水裡很可怕嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680118,
					"content": "說不定一個不小心，就會被捲入水流裡，暈頭轉向，怎麼都飛不起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680119,
					"content": "#就像在蒙德遇到{F#妳}{M#你}之前那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680120,
					"content": "那我再把妳釣上來就好啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "#…真的嗎，那、那也不是不可以和{F#妳}{M#你}一起去水裡。哼，{F#妳}{M#你}一定要說話算話喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680116,
					"content": "可以出點力了派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "哇！感覺可以用鰓呼吸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "#好啊，{F#妳}{M#你}先長個鰓出來看看吧。哼，看起來精神不錯嘛，害我白擔心了一下子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680105,
					"content": "好像冒出了水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "真不愧是水神的國度，連七天神像都會冒出水來…才怪啦，剛才那個光亮怎麼想都不是正常的反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}