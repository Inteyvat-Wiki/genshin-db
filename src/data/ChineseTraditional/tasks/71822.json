				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220201,
					"content": "鹿角…天衡山…唔，如果是真的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "#{F#妳}{M#你}把樣本帶回來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220302,
					"content": "已經帶回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "#辛苦{F#妳}{M#你}了，請給我看一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220304,
					"content": "…唔，這份土壤好像也沒什麼特別的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220305,
					"content": "妳想發現什麼嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "根據傳說，「移霄導天真君」是為了保護璃月港，用自己強壯的頭角支起了即將傾頹的天衡山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220307,
					"content": "我還以為，會至少發現一些「角」的碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220308,
					"content": "果然傳說也只是傳說而已嗎…或者說，那場大戰距離現在的時間太遠，痕跡也基本上消失了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220309,
					"content": "但能夠蒐集到天衡山的土質樣本倒也不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220310,
					"content": "#旅行者，{F#妳}{M#你}能再陪我一段路程嗎？我想要再往上走走，倒也不會太遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220311,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "這次…我想要去高處俯視一下天衡山，觀察一下這裡的地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220314,
					"content": "在傳說中，「岩王帝君」和許多仙人們都參與了那次大戰，還險些導致天衡山倒塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220315,
					"content": "如果戰況激烈到那種程度…那我也許能從地形裡觀察出一些東西來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220312,
					"content": "妳又想去找什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "總算到這裡了…這路可真難走，還有這麼多魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220602,
					"content": "這周圍的地形…好像也沒什麼特別的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220603,
					"content": "咦？這棵樹上是什麼，一盞霄燈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220604,
					"content": "這裡怎麼會有霄燈？難道有人來這裡拜祭那位仙人了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220605,
					"content": "我看看這盞霄燈裡寫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220606,
					"content": "「萬世安泰，天下太平。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220607,
					"content": "是個很宏偉的願望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "確實。但這個願望…怎麼說呢，有點太過宏偉了？不像是祭拜，也不像是「願望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220610,
					"content": "反而像是那種…在璃月傳說裡的仙人們才會許的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220611,
					"content": "到底是誰會在霄燈上許這種願望呢？真奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220612,
					"content": "唔，不管怎麼說，至少有人還記得來這裡放霄燈，那位仙人應該也會很高興吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220613,
					"content": "#謝謝{F#妳}{M#你}陪我走了這麼遠的路，我還想在這裡再研究一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220614,
					"content": "#對了，這些東西請{F#妳}{M#你}收下，就當做是報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220615,
					"content": "唉，璃月有這麼多傳說，但我的研究怎麼就一點進展都沒有呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220608,
					"content": "看起來不像是來祭拜的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}