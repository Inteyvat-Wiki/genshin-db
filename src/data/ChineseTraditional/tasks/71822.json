			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "天衡山…移霄導天真君…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220102,
					"content": "妳在想什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "啊，我正在研究璃月海燈節的歷史和傳說呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220104,
					"content": "我聽說這次的「明霄燈」的造型，會是一位名叫「移霄導天真君」的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220105,
					"content": "根據我蒐集到的傳說，那位仙人似乎也在某段時間裡跟隨「岩王帝君」征戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220106,
					"content": "雖然具體時間和面對的敵人在各種文獻中有各種不同的說法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220107,
					"content": "但在各類記載和在坊間流傳的說法中，都一致指出這位仙人已經犧牲了。而且這位仙人還以自己的角支撐起了天衡山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220108,
					"content": "所以，我來天衡山，想要實地考察一下，想說如果運氣夠好，說不定能夠找到些什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220109,
					"content": "但天衡山裡的魔物眾多，我確定了考察地點之後，卻發現通往那裡的路上都是魔物，根本過不去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220110,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能不能請{F#妳}{M#你}幫我去那邊搜索一下，幫我帶些「土質樣本」回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220111,
					"content": "土質…樣本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "嗯…這是教令院裡的說法，其實就是那片區域裡的土壤啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220113,
					"content": "既然在璃月的傳說中，那位「移霄導天真君」用自己的角支撐起了天衡山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220114,
					"content": "那麼從學術角度來說，我認為地質成分中也許會存在一些不同尋常的成分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220115,
					"content": "#所以，請{F#妳}{M#你}幫我去那裡，取一份土壤回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 7182202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182202",
							"2"
						],
						"stepId": 7182202,
						"stateName": "QUEST_STATE_UNFINISHED"
