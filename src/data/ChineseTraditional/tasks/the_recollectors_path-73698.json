				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980101,
					"content": "看來前一項訓練進行得很順利嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980102,
						736980104
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736980102,
					"content": "還算順利吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980103
					]
				},
				{
					"id": 736980103,
					"content": "嗯，對於斯露莎來說或許有點太簡單了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980106,
					"content": "呵呵，那就讓我期待一下她這次的表現吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980107
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736980107,
					"content": "對了，關於聽斯露莎講故事的部分，原來之前斯露莎是因為叛逆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980108,
					"content": "這個就不必說了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980109,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980110,
					"content": "咳，總之，現在我已經脫、脫離了那個階段了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980111,
					"content": "重要的是，在同「謁頌主」及白飄飄回溯花靈誕生的歷史之後，談到了深林中草木的眷屬和他們獨有的節日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980112
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980112,
					"content": "花靈沒有自己的節日這件事讓我耿耿於懷，前輩難道不這樣覺得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980113,
					"content": "要我說，應該讓人類來參與花靈的節日，由他們來唱誦稱讚花靈的詩篇，然後由我選出最優秀的那一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980114,
					"content": "據我所知，無憂節可不是這樣胡鬧的節日哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980115
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736980115,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980116
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980116,
					"content": "總覺得斯露莎這種找人類來記錄功業的想法就和其他的花靈很不一樣…這應該也是矯論團的影響吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980117,
					"content": "正因為如此，回顧和反思過去才是有意義的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980118
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736980118,
					"content": "呵呵，不管怎麼說，就讓我期待一下她這次的表現吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736980104,
					"content": "倒也沒那麼順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980105
					]
				},
				{
					"id": 736980105,
					"content": "斯露莎並不像自己說的那麼厲害嘛，接下來得多努力才行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7369806,
			"completionStepIds": [
				7369806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369806",
							"2"
						],
						"stepId": 7369806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980601,
					"content": "哦！我記得這裡，我們之前來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980602,
						736980604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980602,
					"content": "的確是令人印象深刻的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980603
					]
				},
				{
					"id": 736980603,
					"content": "剛看到的時候嚇了一跳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980606,
					"content": "記得斯露莎說過這傢伙是因為運氣不好才被封印在這裡。不過，它跟斯露莎的訓練有什麼關係呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980607,
					"content": "啊，難道說，祖爾宛的意思是：「呵呵，斯露莎，看看吧，這就是運氣不好的傢伙的下場」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980608,
					"content": "噗…前輩才不是會做這種無聊的事的花靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980609,
					"content": "#…言歸正傳，雖然之前從這裡經過時沒有細說，但是導致它被封印的那場災難，{F#妳}{M#你}們應該也很熟悉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980610,
					"content": "五百年前的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980611,
					"content": "#沒錯。那應該是一瞬間的事吧，{F#妳}{M#你}們看，即便已經變成結晶的現在，它依然保持著當時的動態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980612,
					"content": "就好像一旦封印解除，它馬上又會轟隆隆地在洞穴中穿行一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980613,
					"content": "這剎那，將是妳的永恆…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980614
					]
				},
				{
					"id": 736980614,
					"content": "嗚啊，我可不要變成這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980615,
					"content": "雖說可能是一瞬間發生的事，唔…不行不行，光是想想就覺得害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980616,
					"content": "不會讓派蒙遇到這種事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980617
					]
				},
				{
					"id": 736980617,
					"content": "#那當然啦！我也絕不會讓{NICKNAME}遇到這樣的危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980618,
					"content": "#唉，那{F#妳}{M#你}們應該感謝吾輩花靈才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980619
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980619,
					"content": "當時為了平息災禍，包括花靈在內的許多族類與存在都獻出了生命…有時甚至是比生命更珍貴的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980620,
					"content": "現在的我們能夠免於它所遭遇的無可轉圜的滅頂之災，正是因為當年的那些犧牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980621,
					"content": "也正是因為我沒能親歷那場大災厄，當這片土地再次遭遇危機之時，我才更應該有所作為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980622,
					"content": "這麼說來，它的年紀比斯露莎還要大，也算是斯露莎的前輩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980623,
					"content": "不過它可不會活過來了。畢竟已經結晶化幾百年了，等待它的或許只剩下銷蝕的命運吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980624,
					"content": "因為那場災厄而殞命的生靈數不勝數，它們中的許多就像這個倒楣的傢伙一樣，被封進了災禍發生的剎那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980625,
					"content": "但這許多的生靈卻比我們眼前的倒楣傢伙更加不幸，因為它們早已在百年來歲時的流逝中將形體消磨殆盡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980626,
					"content": "而今什麼也沒有剩下，沒有人記得它們，更無處憑弔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980627
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980627,
					"content": "我們眼前的倒楣傢伙嘛，只是因為原本就格外巨大，又生在免於酷曬與烈風的地下洞穴，這才保留得較為完好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980628,
					"content": "不過大陸上還沒有什麼生靈能敵得過時間，哪怕是生靈的遺骸也不行。總有一天，它也會消失得無影無蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980629,
					"content": "總覺得有點可惜呢…到頭來，就連生存過的痕跡也不能留下的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980630,
					"content": "唔，人類留下的文獻裡應該能找到有關它的紀錄吧，這樣的東西對人類來說還是很稀罕的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980631
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980631,
					"content": "以前聽前輩說起過，除了矯論團的人類，也有從森林來的學者四處調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980632,
					"content": "不過聽說有些人類堅信風蝕沙蟲是流沙鰻鰻的完整形態…有這樣的學識和聯想，真憂心這些人類記錄下來的內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980633
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980633,
					"content": "這不是根本靠不住嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980634,
					"content": "仔細想想，明明人類的紀錄這樣不可靠，斯露莎卻還熱心地尋找人類來當「謁頌主」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980635,
					"content": "說不定在這塊結晶銷蝕殆盡之前，為斯露莎所寫的頌詩都會被傳得面目全非了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980636,
					"content": "到時候人們聽到的頌詩裡說的花靈勇者可能就是既不粉也不可愛，外形硬朗可靠、待人溫和有禮、行事理智不衝動…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980637,
					"content": "聽起來很像理想中的勇者形象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980638
					]
				},
				{
					"id": 736980638,
					"content": "雖然和斯露莎好像一點關係也沒有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980639,
					"content": "那可不行！等等，我好像知道前輩的用意了，一定是為了提醒我應該找找更可靠的記錄功業的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980640
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980640,
					"content": "呼，還是前輩高瞻遠矚，之後得好好感謝才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980641
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980641,
					"content": "我覺得應該不是這樣的…",
