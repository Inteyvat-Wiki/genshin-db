			"trigger": {
				"objectNames": [
					"「少女」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "什…什麼？怎麼可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800602,
					"content": "是妳輸了呢，桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800603,
					"content": "我…我這是讓妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800604,
					"content": "真的嗎？妳明明很不甘心的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800605,
					"content": "可惡…再來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800606,
					"content": "哼，輕輕鬆鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800607,
					"content": "是我輸了。妳果然很厲害呢，桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800608,
					"content": "下次帶妳玩一些更有難度的吧。我知道很多好玩的數理遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800609,
					"content": "好啊。哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800610,
					"content": "妳笑什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800611,
					"content": "以前很少看到桑多涅這麼開心的樣子，妳也不怎麼邀請我玩遊戲，還會把我趕走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800612,
					"content": "喂…別把我說得像是經常欺負妳一樣好不好！我以後多找妳開幾次茶會總行了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800613,
					"content": "嗯，好啊。我很喜歡這種和桑多涅妳一起度過的茶會時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
