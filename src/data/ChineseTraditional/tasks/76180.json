			"dialogs": [
				{
					"id": 761800801,
					"content": "和桑多涅玩遊戲真開心。下次也一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800802,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761800804,
					"content": "要走了嗎？好吧，那我們下次見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761800803,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
