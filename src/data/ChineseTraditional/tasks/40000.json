			"trigger": {
				"objectNames": [
					"瑞錦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "#{F#妳}{M#你}好！{F#妳}{M#你}也想試玩一下「機關棋譚」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000202,
					"content": "什麼…「機關棋譚」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "#唔，看來{F#妳}{M#你}不太瞭解呢…「機關棋譚」是我發明的一種能在桌子上玩的「遊戲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000204,
					"content": "#{F#妳}{M#你}看到桌子上的這些擺設了嗎？這些都是「機關棋譚」裡要用到的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000205,
					"content": "看起來好複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "只是看起來複雜啦，其實很容易上手的，只要玩幾局就熟悉規則了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000207,
					"content": "#怎麼樣，{F#妳}{M#你}想試試看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000208,
					"content": "這個…玩一局要多少錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "沒有沒有，這不是海燈節嘛，剛好我也想要看看大家對於這個「機關棋譚」的態度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000211,
					"content": "所以，現在只需要一盞「霄燈」就能玩一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000212,
					"content": "#如果{F#妳}{M#你}想玩的話，拿著「霄燈」來找我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000213,
					"content": "#怎麼樣，來試試吧，第一局我就不收{F#妳}{M#你}霄燈啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000209,
					"content": "這玩一局不便宜吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
