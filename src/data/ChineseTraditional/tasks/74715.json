			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲米尼"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3509.359,
							452.648,
							4162.708
						],
						"pointId": 17298
					}
				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "菲米尼，你怎麼看起來那麼疲憊？是這陣子打撈得太累了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150102,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150103,
					"content": "也不要躲進潛水頭盔裡啦！我們都是好朋友，比起憋進心裡，說出來會更好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150104,
					"content": "…嗯，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150105,
					"content": "剛才下水打撈的時候，我見到了一個有些討厭的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150106,
					"content": "討厭的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150107,
					"content": "呃…要從哪裡講起呢…按照楓丹法規，對於沉入水下的貨物，如果原主獲得了保險賠款，它們就會變成自由財產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150108,
					"content": "基於這種規則，有些人將潛水視為發財的手段。透過打撈別人遺失的東西，在上岸後賣出摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150109,
					"content": "這麼做並沒有太高門檻，導致潛水員中混入了不少…一心只想獲得財富的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150110,
					"content": "有時候，他們會粗暴地趕走魚群和膨膨獸，只因牠們礙了自己的生意…我不接某些委託，也與這樣的人有一點關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150111,
					"content": "原來是這樣…可以理解菲米尼的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150112,
					"content": "剛才在水下，我又遇到了這樣的情況。我鼓起勇氣，制止了對方的行為。儘管最後還是…被罵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150113,
					"content": "怎麼這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150114,
					"content": "你做得沒錯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "#謝謝{NICKNAME}和派蒙的好意，不過…雖然對我來說很難也很累，但我還是想靠自己的努力，去改變些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150117,
					"content": "我喜歡在水下遨遊的感覺，觀察蒼晶螺的紋路、感受海露花的呼吸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150118,
					"content": "當水下的世界認可你時，它會給你善意的回應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150119,
					"content": "我認為這才是我們應該選擇的，與世界相處的方式，而不是一味自私地奪取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150120,
					"content": "我覺得菲米尼說的這些也很好哦！你看，當你真的有什麼想做的、想說的時候，表達出來其實更暢快吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150121,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150122,
					"content": "菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150123,
					"content": "抱歉…我有點害羞。總之…我、我會繼續努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150124,
					"content": "#差點忘了…這些是最新的水底勘測情報，請收下，它們應該能為{F#妳}{M#你}們派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150115,
					"content": "下次我們也可以替你出面！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}