			"dialogs": [
				{
					"id": 761140301,
					"content": "（咦？這是…看起來像是沒燒完的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140302,
					"content": "（以前就聽說德文特先生會收留受傷的冒險家之類的…這好像是最近發生的事。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140303,
					"content": "（為什麼要把這些燒掉呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
