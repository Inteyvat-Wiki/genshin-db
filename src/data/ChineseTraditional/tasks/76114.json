			"dialogs": [
				{
					"id": 761140201,
					"content": "您好——有人在嗎——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140202,
					"content": "德文特先生——您在家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140203,
					"content": "…是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140204,
					"content": "是「秘聞館」的雅珂達，有些事想要問問您，所以特意來拜訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140205,
					"content": "…妳就直接問吧。我病了，起不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140206,
					"content": "（奇怪，之前聽海螺幫的孩子們說，德文特先生教他們認字，說話溫聲細語…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140207,
					"content": "（現在聽起來聲音沙啞，不過不像是病了，而像是原本就是這副嗓音…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140208,
					"content": "您沒事吧？如果病得厲害，我可以去請醫生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140209,
					"content": "…不用。過陣子就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140210,
					"content": "好吧，那等您恢復了再去那夏鎮吧。您的朋友也很牽掛您呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140212,
					"content": "（…他怎麼不說話了？聽得到屋裡有人走動的聲音，不過腳步很沉重…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140213,
					"content": "您最近好像都沒怎麼出門吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140214,
					"content": "…是為了專心修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140215,
					"content": "聽說您近來的裝扮也和過去不太一樣，有人說完全沒想到原來您那麼健碩，之前穿隱者長袍的時候都沒看出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140216,
					"content": "呃，還有隔絕月矩力的面罩…是新的流行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140217,
					"content": "…是為了隔絕外界的雜音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140218,
					"content": "也是為了修行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140220,
					"content": "那前陣子拜訪過您的行商，您知道他在那之後去哪了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140221,
					"content": "…不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140222,
					"content": "好、好吧…那我就先不打擾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140223,
					"content": "（不知道為什麼，有種繼續問下去會很危險的感覺…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140224,
					"content": "（唔，他們說的沒錯，簡直就像是換了個人…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761140225,
					"content": "（收穫太少了，也不能就這樣回去面對奈姐啊…在附近再小心地調查一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
