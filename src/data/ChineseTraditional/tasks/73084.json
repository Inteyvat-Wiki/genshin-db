			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿弗拉圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840101,
					"content": "#{F#妳}{M#你}們是受本人阿弗拉圖委託而來的鍍金旅團嗎？如果不是的話，還是請在此留步吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840102
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840102,
					"content": "前面的區域很危險，我已經委託了聚砂廳讓鍍金旅團來處理了，普通人還是小心為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840103
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840103,
					"content": "#作為教令官，{F#妳}{M#你}們要是出了什麼意外的話，那就是我的失職了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840104,
						730840106
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840104,
					"content": "我們不是普通人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840105
					]
				},
				{
					"id": 730840105,
					"content": "唔…那些初來乍到的冒險家們都這麼說，在沙漠過於自信可是很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840108,
					"content": "注意到那邊的巨大機械了嗎？那是傳說中荼訶人的遺物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840109
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840109,
					"content": "荼訶人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840110
					]
				},
				{
					"id": 730840110,
					"content": "嗯，常見的說法應該是坎瑞亞吧？荼訶是我們因論派喜歡用的古稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840111
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840111,
					"content": "傳說五百年前，荼訶{RUBY#[D]坎瑞亞}古國的「白鵠騎士」曾駕駛著這些巨大的機械對抗黑淵湧出的魔群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840112
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840112,
					"content": "在殘酷的戰爭後，最終殘留下來的三臺遺蹟巨像被賢者們所封印，這臺遺蹟巨像就是其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840113
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840113,
					"content": "按理來說這臺機械已經在此靜默了數百年了，但是不知道怎麼了，最近突然活躍了起來，甚至還開始攻擊附近的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840114
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840114,
					"content": "無差別地用鐳射炮攻擊附近的活物，這樣危險的機能在這些被封印的遺蹟巨像身上還是第一次見。沒辦法放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840115
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840115,
					"content": "明明為這些機械提供能源的混沌爐心早就進行過無害化處理了，沒想到過了幾百年竟然還能運行，真是奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840116
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840116,
					"content": "混沌爐心？聽上去和遺蹟守衛一樣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840117,
					"content": "#哦哦，{F#妳}{M#你}們知道遺蹟守衛嗎？那解釋起來就輕鬆多了。簡單來說遺蹟巨像就像是超級巨大版的遺蹟守衛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840118
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840118,
					"content": "不過和遺蹟守衛不同，遺蹟巨像雖然也裝載了自律系統，但主要還是由人類操縱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840119
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840119,
					"content": "這也是最奇怪的地方，進入遺蹟巨像的通道都被賢者利用「須陀流心」的力量封印起來了，應該沒有人能夠進去啟動它才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840120
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840120,
					"content": "是有人透過其他的方法進去了嗎？還是說觸發了什麼我們還不知道的自啟動機制呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840121
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840121,
					"content": "要進去看看才知道吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840122
					]
				},
				{
					"id": 730840122,
					"content": "話是這麼說，不過不知道是不是聚砂廳的業務太忙了，這麼久也沒有鍍金旅團的人過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840123
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840123,
					"content": "教令院的封印還好說，問題是進入遺蹟巨像的通路入口是被巨石堵住的，靠我自己可沒辦法挪開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840124
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840124,
					"content": "哦哦，這個的話我們倒是可以幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840125,
					"content": "#如果能把給鍍金旅團的報酬給我們的話。對吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840126,
					"content": "#{F#妳}{M#你}們是冒險家嗎？如果是一般民眾的話，我可不能讓{F#妳}{M#你}們冒這樣的風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840127
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840127,
					"content": "#畢竟這傢伙的鐳射炮可不是鬧著玩的，要是讓{F#妳}{M#你}們白白送命的話，我可沒辦法向教令院交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840128,
						730840130
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840128,
					"content": "我們是註冊在籍的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840129
					]
				},
				{
					"id": 730840129,
					"content": "如果是這樣的話，流程上倒是沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840132,
					"content": "#畢竟我也還有重要的研究工作，一直耽誤在這裡也不是辦法。為了盡快解決就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840133
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840133,
					"content": "那麼委託就是進入遺蹟巨像裡面關閉它的自律系統，如果能弄清楚遺蹟巨像發生異變的原因就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840134
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840134,
					"content": "自律系統的開關應該是在駕駛艙裡，成功關閉之後會進入手動模式。不過駕駛艙也被封印了，只有將封印解除才能進到裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840135
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840135,
					"content": "嗯…根據記載，維持封印力量的是散佈在巨像內的三組「須陀流心」，只要把它們都打破就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840136
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840136,
					"content": "不過要注意小心一點不要破壞機關內部的結構啊，畢竟這可是教令院登記在冊的重要文物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840137
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840137,
					"content": "嘿嘿，放心放心，就交給我們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840130,
					"content": "我們是聞名諸國的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840131
					]
				},
				{
					"id": 730840131,
					"content": "#是嗎？我之後會向冒險家協會查證的，現在就先暫時相信{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840132
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840106,
					"content": "前面發生了什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840107
					]
				},
				{
					"id": 730840107,
					"content": "發生了一些異變啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840108
					],
					"speakerTitle": "阿弗拉圖"
				}
			]
		},
		{
			"id": 7308402,
			"completionStepIds": [
				7308402,
				7308418
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"73026",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308402",
							"2"
						],
						"stepId": 7308402,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308418",
							"2"
						],
						"stepId": 7308418,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿弗拉圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840201,
					"content": "#{F#妳}{M#你}們是受本人阿弗拉圖委託而來的鍍金旅團嗎？如果不是的話，還是請在此留步吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840202
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840202,
					"content": "前面的區域很危險，我已經委託了聚砂廳讓鍍金旅團來處理了，普通人還是小心為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840203
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840203,
					"content": "#作為教令官，{F#妳}{M#你}們要是出了什麼意外的話，那就是我的失職了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840204,
						730840206
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840204,
					"content": "我們不是普通人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840205
					]
				},
				{
					"id": 730840205,
					"content": "唔…那些初來乍到的冒險家們都這麼說，在沙漠過於自信可是很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840208,
					"content": "注意到那邊的巨大機械了嗎？那是傳說中荼訶人的遺物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840209
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840209,
					"content": "荼訶人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840210
					]
				},
				{
					"id": 730840210,
					"content": "嗯，常見的說法應該是坎瑞亞吧？荼訶是我們因論派喜歡用的古稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840211
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840211,
					"content": "傳說五百年前，荼訶{RUBY#[D]坎瑞亞}古國的「白鵠騎士」曾駕駛著這些巨大的機械對抗黑淵湧出的魔群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840212
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840212,
					"content": "在殘酷的戰爭後，最終殘留下來的三臺遺蹟巨像被賢者們所封印，這臺遺蹟巨像就是其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840213
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840213,
					"content": "按理來說這臺機械已經在此靜默了數百年了，但是不知道怎麼了，最近突然活躍了起來，甚至還開始攻擊附近的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840214
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840214,
					"content": "無差別地用鐳射炮攻擊附近的活物，這樣危險的機能在這些被封印的遺蹟巨像身上還是第一次見。沒辦法放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840215
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840215,
					"content": "明明為這些機械提供能源的混沌爐心早就進行過無害化處理了，沒想到過了幾百年竟然還能運行，真是奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840216
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840216,
					"content": "雖然一句話也沒聽懂，但是這個遺蹟巨像，應該和我們之前在降諸魔山見過的一樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840217,
					"content": "不過之前的那個大傢伙可不會亂攻擊人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840218,
					"content": "#哦哦，{F#妳}{M#你}們知道遺蹟巨像嗎？那就不用我再解釋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840219
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840219,
					"content": "#那麼{F#妳}{M#你}們應該也知道，遺蹟巨像雖然也裝載了自律系統，但主要還是由人類操縱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840220
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840220,
					"content": "這也是最奇怪的地方，進入遺蹟巨像的通道都被賢者利用「須陀流心」的力量封印起來了，應該沒有人能夠進去啟動它才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840221
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840221,
					"content": "是有人透過其他的方法進去了嗎？還是說觸發了什麼我們還不知道的自啟動機制呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840222,
						730840227
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840222,
					"content": "要是加扎里在的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840223
					]
				},
				{
					"id": 730840223,
					"content": "對哦，加扎里先生不是專門研究這個遺蹟巨像的嗎？要是他在的話，肯定迫不及待的要進去看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840224,
					"content": "#嗯？{F#妳}{M#你}們認識加扎里嗎？如果是他的話的確會對這些東西有點研究。雖然我也有找他協助調查，不過他好像正忙著閉關寫什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840225
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840225,
					"content": "該說是妙論派的傢伙特有的天真嗎？要是他能對教令院的事務多用點心，就不會到現在還止步在陀裟多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840226
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840226,
					"content": "不如讓我們來協助調查吧，之前加扎里先生的調查，也是我們協助的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840231,
					"content": "#如果能把給鍍金旅團的報酬給我們的話。對吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840232,
					"content": "#真的嗎？{F#妳}{M#你}們有這樣的經驗的話，那真的是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840233
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840233,
					"content": "#不過{F#妳}{M#你}們是冒險家嗎？如果是一般民眾的話，我可不能讓{F#妳}{M#你}們冒這樣的風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840234
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840234,
					"content": "#就算{F#妳}{M#你}們說之前也協助調查過類似的機械，但是和這個不同，這傢伙的鐳射炮可不是鬧著玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840235
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840235,
					"content": "#要是讓{F#妳}{M#你}們白白送命的話，我可沒辦法向教令院交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840236,
						730840238
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840236,
					"content": "我們是註冊在籍的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840237
					]
				},
				{
					"id": 730840237,
					"content": "如果是這樣的話，流程上倒是沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840240,
					"content": "#畢竟我也還有重要的研究工作，一直耽誤在這裡也不是辦法。為了盡快解決就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840241
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840241,
					"content": "那麼委託就是進入遺蹟巨像裡面關閉它的自律系統，如果能弄清楚遺蹟巨像發生異變的原因就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840242
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840242,
					"content": "自律系統的開關應該是在駕駛艙裡，成功關閉之後會進入手動模式。不過駕駛艙也被封印了，只有將封印解除才能進到裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840243
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840243,
					"content": "嗯…根據記載，維持封印力量的是散佈在巨像內的三組「須陀流心」，只要把它們都打破就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840244
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840244,
					"content": "不過要注意小心一點不要破壞機關內部的結構啊，畢竟這可是教令院登記在冊的重要文物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840245
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840245,
					"content": "嘿嘿，放心放心，就交給我們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840238,
					"content": "我們是聞名諸國的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840239
					]
				},
				{
					"id": 730840239,
					"content": "#是嗎？我之後會向冒險家協會查證的，現在就先暫時相信{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840227,
					"content": "要進去看看才知道吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840228
					]
				},
				{
					"id": 730840228,
					"content": "話是這麼說，不過不知道是不是聚砂廳的業務太忙了，這麼久也沒有鍍金旅團的人過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840229
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840229,
					"content": "教令院的封印還好說，問題是進入遺蹟巨像的通路入口是被巨石堵住的，靠我自己可沒辦法挪開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840230
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840230,
					"content": "哦哦，聽上去我們倒是可以幫忙，畢竟之前也進去過一次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840206,
					"content": "前面發生了什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840207
					]
				},
				{
					"id": 730840207,
					"content": "發生了一些異變啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "阿弗拉圖"
				}
			]
		},
		{
			"id": 7308403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿弗拉圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840301,
					"content": "雖然作為教令官負責這裡，但我其實是因為要去考察，結果正好在附近而被臨時委派到這裡來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840302
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840302,
					"content": "況且我來自伐護{RUBY#[D]因論派}末那學院，對遺蹟巨像的瞭解也僅限於歷史書上的隻言片語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840303
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730840303,
					"content": "不過如果藉此能對荼訶{RUBY#[D]坎瑞亞}古國的歷史有更多瞭解的話，對我接下來的研究應該也會很有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿弗拉圖"
				}
			]
		},
		{
			"id": 7308417,
			"completionStepIds": [
				7308417
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308417",
							"2"
						],
						"stepId": 7308417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿弗拉圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730841701,
					"content": "#情況如何？我注意到遺蹟巨像發生了一些異動，是{F#妳}{M#你}們進去把它的自律系統關閉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841702,
						730841704
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841702,
					"content": "已經輕鬆解決了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841703
					]
				},
				{
					"id": 730841703,
					"content": "那真是太好了，這樣委託也算是完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841706,
					"content": "#不過關於它到底為什麼會突然啟動，{F#妳}{M#你}們在遺蹟巨像裡面有發現什麼線索嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841707
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841707,
					"content": "向阿弗拉圖回報了在遺蹟巨像內部的發現。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730841708
					]
				},
				{
					"id": 730841708,
					"content": "嗯…過度生長的藤蔓…不像是沙漠中會出現的生態啊。雖然我也不是很清楚，不過聽上去像是和地脈之類的有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841709
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841709,
					"content": "之前也有接到過類似的，爐心被破壞的遺蹟機關因為地脈的原因還能不斷「復活」的報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841710
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841710,
					"content": "荼訶人製造的機關和地脈能源之間，應該還有很多我們還不清楚的關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841711
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841711,
					"content": "而且古代賢者們使用的封印原本就是利用了地脈的力量構築的，要是地脈發生了什麼異變的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841712
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841712,
					"content": "如果我的推論沒錯，可能各地被封印的遺蹟巨像都會開始出現問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841713
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841713,
					"content": "聽上去有點麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841714
					]
				},
				{
					"id": 730841714,
					"content": "只能先向教令院報告看看了，這種事情我也沒辦法處理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841715
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841715,
					"content": "本來我此行是為了前往荼訶人的遺蹟考察，好不容易才從教令院申請到了許可，還聯絡到了當地的教團來接我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841716
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841716,
					"content": "結果剛一出城就碰到這種麻煩的事情，但是教令院派下來的任務也沒辦法拒絕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841717
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841717,
					"content": "現在事情總算解決了，我也能繼續我的遊學之旅了，剩下的工作就等教令院派其他人來處理好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841718
					],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841718,
					"content": "那麼請收下報酬。如果有緣的話，或許我們還會在沙漠的某處再見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿弗拉圖"
				},
				{
					"id": 730841704,
					"content": "已經關閉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841705
					]
				},
				{
					"id": 730841705,
					"content": "嗯，這樣它應該就不會亂攻擊附近的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "阿弗拉圖"
				}
			]
		}
	]
}