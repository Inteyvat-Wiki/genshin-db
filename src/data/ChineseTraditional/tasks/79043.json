			"dialogs": [
				{
					"id": 790430101,
					"content": "這邊的地上有一些日記？怎麼回事…其他人也到過這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430102
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790430102,
					"content": "唔，這位畫家的心態好像發生了一點變化呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430103,
						790430104
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790430103,
					"content": "見識到了真正的大師…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790430105
					]
				},
				{
					"id": 790430105,
					"content": "我聽說…真正碰見嚴重挫折的時候，越是有自信的人，心裡就會越難受？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430106
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790430106,
					"content": "有點擔心他的精神狀況，不過，這都是已經發生過很久的事了吧，我們也幫不到他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430107
					],
					"speakerTitle": "閱讀"
				},
				{
