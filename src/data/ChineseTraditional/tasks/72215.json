			},
			"dialogs": [
				{
					"id": 722150201,
					"content": "有了這些鐵球，一定會有很多人來的。阿響一定會高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
		{
			"id": 7221503,
			"completionStepIds": [
				7221503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
