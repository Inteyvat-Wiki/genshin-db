			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "唔喵，這塊石頭，什麼時候能變得和奴家一樣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150102,
					"content": "雕像怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "那個石頭人類說，再過段時間，石頭就可以完全敲好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150104,
					"content": "等阿響回來的時候，她一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150105,
					"content": "對了，可不能只是把那塊石頭敲好，還得再把神社周圍打扮打扮才行呐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150106,
					"content": "#請{F#妳}{M#你}們幫奴家去把這些圓圓的，會響的鐵球掛在神社周圍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150107,
					"content": "這些東西是阿響之前準備的，記得是說百目鬼看她喜歡奴家和別的孩子們，特地送給她的。奴家好不容易才找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150108,
					"content": "這是…鈴鐺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "「鈴鐺」？奴家不清楚…但阿響之前，經常和奴家一起玩這種鐵球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150110,
					"content": "阿響把鐵球放在地上，然後打到遠處。鐵球動的時候，會叮叮噹噹地響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150111,
					"content": "不知道這些鐵球有什麼力量，奴家和別的貓一聽到，就忍不住想要過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150112,
					"content": "所以，奴家想明白了。現在來神社的人這麼少，一定是因為沒有鐵球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150113,
					"content": "所以奴家要汝幫忙，把這些鐵球掛在高處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150114,
					"content": "這樣的話，人類聽到鐵球的聲音，就會來神社，也不會走錯路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150115,
					"content": "那就會給「塞錢箱」塞很多錢，神社會變得很熱鬧。阿響回來就會很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150116,
					"content": "所以，去幫奴家把這些鐵球掛在神社周圍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150117,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "#那就拜託{F#妳}{M#你}了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
		{
			"id": 7221502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
