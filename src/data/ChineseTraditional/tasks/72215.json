			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "都掛上去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150302,
					"content": "都掛好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "喵喵，太好了，這樣子神社就會熱鬧一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150305,
					"content": "咦？怎麼還沒有好多好多人類來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150306,
					"content": "應該不會這麼快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "哎，人類好難懂啊。當然，汝不一樣，汝很有悟性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150309,
					"content": "雖然暫時還沒人…但有了鐵球的叮噹聲，至少那些小傢伙就不會迷路了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150310,
					"content": "那個石頭人類說，石頭奴家很快就能好，一定要來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150311,
					"content": "啊，對了。還有件怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150312,
					"content": "奴家去問了那兩個綠綠的人類，阿響和百目鬼的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150313,
					"content": "但那兩個綠綠的人類，都說不認識阿響，也不記得和阿響有關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150314,
					"content": "但高高的綠綠的人類說，他讀到過「赤穗百目鬼」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150315,
					"content": "不過他說什麼…「賊」、什麼「討伐」來著…意思好像說，百目鬼是個壞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150316,
					"content": "肯定是弄錯了。阿響和他經常在一起玩。所以，百目鬼也是很好的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150317,
					"content": "一定是那個人類悟性不行。歸根到底，還是汝比較可靠哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150318,
					"content": "阿響…到底什麼時候才會回來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722150307,
					"content": "應該沒有這麼簡單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}