			"dialogs": [
				{
					"id": 761160101,
					"content": "這不是我們和博比克的生死之交嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160102,
					"content": "關於你們兩個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "我們會留在這裡一段時間，畢竟把德茲斯拉沃的實驗室大門破壞了。我們必須守在附近，避免再被那些壞蛋們乘虛而入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160104,
					"content": "#等我們修好門，或是小德回家了，大概就會跟{F#妳}{M#你}們一樣，帶著博比克一起出門旅行吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160105,
					"content": "關於德茲斯拉沃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "#完全不知道他會在哪…要是{F#妳}{M#你}們在旅行的時候遇到他的話，請代我們向他問好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160107,
					"content": "真想和他一起再到「旗艦」喝個整整一晚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160108,
					"content": "關於博比克…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "#{F#妳}{M#你}想博比克了啊？只要{F#妳}{M#你}有空，隨時可以來找它玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮茲卡"
				},
				{
					"id": 761160110,
					"content": "再見了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "嗯嗯，一定會再見的，畢竟我們是生死之交嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安妮茲卡"
				}
