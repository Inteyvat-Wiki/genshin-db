							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘿莎莉亞",
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040202,
					"content": "怎麼了，不合蘿莎莉亞的口味嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040203,
					"content": "我可以重做一杯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "#不，不是針對{F#妳}{M#你}。我只是很少喝茶，這種味道會讓我想起一些事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040205,
					"content": "跟教會有關的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040206,
					"content": "嗯。有一次教會辦活動，我沒去，沒想到芭芭拉給我留了一份茶和點心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040207,
					"content": "點心放得太久口感很差，她偷偷收走了。但那杯茶，差不多就是這個味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040208,
					"content": "蘿莎莉亞現在的神態，可真是少見呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040209,
					"content": "看來蒙德要多一個紅茶愛好者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040210,
					"content": "那還是酒好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040211,
					"content": "凱亞呢，對飲品滿意嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "#如果我挑幾個瑕疵出來，{F#妳}{M#你}是不是會幫我重做一杯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040213,
					"content": "#哈哈哈，開玩笑的，我怎麼會做這種招{F#妳}{M#你}討厭的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040214,
					"content": "唉，凱亞的思維總是這麼跳躍！真虧蘿莎莉亞能跟他一起喝酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040215,
					"content": "是嗎？我根本不關心他的思維。喝酒，就只聊酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040216,
					"content": "#何況，{F#妳}{M#你}也好，這裡的老闆也好…凱亞只會試探自己感興趣的人或事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040217,
					"content": "喂！咱們好歹也是酒友吧，妳怎麼出賣我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040218,
					"content": "這就算出賣了？根本無所謂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040219,
					"content": "平時生活中「正經人」可太多了。還是酒館裡人人鬆散的氣氛更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040220,
					"content": "哦？到批評正經人的時段了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040221,
					"content": "說起這個，我認識的某個人，應該能排進「蒙德正經人榜」前三吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040222,
					"content": "要說程度…哦，應該這麼形容。他已經正經到被當面這樣評價表情也完全不會變化的地步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040223,
					"content": "居然還有這種排名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040224,
					"content": "當然啦。我想想…還有連續喝酒天數排行、最長工作時間排行、廚房殺手排行、禁忌知識量排行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040225,
					"content": "蒙德人也太閒了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040226,
					"content": "不用上班的人，有那麼多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040227,
					"content": "不…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "#嗚，就沒有什麼能讓我和{M#他}{F#她}一起上榜的排行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040230,
					"content": "有啊，比如「最佳酒保」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040231,
					"content": "真，真的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040232,
					"content": "#太好了，{NICKNAME}，我們也在這裡一起留下我們的名字了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040233,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040234,
					"content": "哼，這種氛圍倒是不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040235,
					"content": "#可不是嘛，光看著{M#他}{F#她}們就覺得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040236,
					"content": "極富感染力的氛圍，嗯，會成為酒館一大賣點的呢。看來「最佳酒保」稱號給對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040237,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040238,
					"content": "沒什麼，這次多謝兩位款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040239,
					"content": "嗯，我差不多也該回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040240,
					"content": "另外，紅茶味道很好，之後我會試著自己泡泡看…如果早上起得來的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040241,
					"content": "那就再見囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040242,
					"content": "下次見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "我大概知道都在指誰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}