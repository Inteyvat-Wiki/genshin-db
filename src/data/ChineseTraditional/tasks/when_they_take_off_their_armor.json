			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞",
					"蘿莎莉亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "#喲，今天的酒保居然是{F#妳}{M#你}，真是罕見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040102,
					"content": "那我就要一杯午後之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040103,
					"content": "一開口就為難別人，真有你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040104,
					"content": "#哎呀，只是想看{M#他}{F#她}如何應對嘛。倒是沒想到蘿莎莉亞小姐今天也來喝酒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040105,
					"content": "酒館裡刁鑽的客人那麼多，旅行者不早點累積起經驗可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040106,
					"content": "凱亞還是那麼油嘴滑舌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040107,
					"content": "#冤枉啊，我是一片好意！{F#妳}{M#你}不是應該感謝我嗎？比如說，給我來一杯簡簡單單的月夜暗巷什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040108,
					"content": "啊對，要大杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 705040109,
					"content": "給我隨便來一杯。有茶香的飲品都行，量不用太大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705040110,
					"content": "明白了，請稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "慢慢來。等待美味出品的時間，也是很令人興奮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
