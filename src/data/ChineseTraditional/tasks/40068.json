			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"莫娜",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "看起來是正常的島嶼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680302,
					"content": "…風裡似乎有灼燒的氣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680303,
					"content": "呃…我的水占盤變明亮一點了，可還是看不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680304,
					"content": "喂！看我發現了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680305,
					"content": "這東西…該說它是一面鼓，還是一株植物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680306,
					"content": "是植物構成的樂器？那看來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680307,
					"content": "辛焱，這裡該不會是跟妳有關的島嶼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680308,
					"content": "唔，難道這是給我準備的樂器？那我先敲一敲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680309,
					"content": "稍等一下。昨天我碰了盆景中的假山，我們就被轉移到某個特殊的空間內，辛焱，妳要不要先做個準備？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680310,
					"content": "你說得對，但我不擔心這個。我對音樂，可是隨時都有所準備的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
