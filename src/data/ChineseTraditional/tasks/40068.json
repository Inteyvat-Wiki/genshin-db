				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "哇！好大一朵花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680902,
					"content": "這裡好熱…跟那朵花有關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680903,
					"content": "沒想到，這裡會有客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680904,
					"content": "咿啊啊啊啊它會說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680905,
					"content": "昨天松鼠也說話了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "我知道啦！但、但就是不一樣嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680908,
					"content": "您好，我們觸摸了外面海灘上那些長得像鼓一樣的植物，就被送到這一帶來。請問您是這裡的主人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680909,
					"content": "這裡是音樂的殿堂，我不過是區區守門者。朋友們，你們也是來追求極致音樂的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680910,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680911,
					"content": "那麼，妳對音樂的寄託是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680912,
					"content": "為反抗高歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680913,
					"content": "妳很懂嘛！太好了，能遇到知己，我可真有福氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680914,
					"content": "跟奇怪的花都這麼投緣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680915,
					"content": "好相處的人，走到哪裡都有很多朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680916,
					"content": "你們能走到這裡，一定是想進入更深層的殿堂。不過很抱歉，進入殿堂需要我的歌喉，而我現在嗓子有點啞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680917,
					"content": "妳不要緊吧？要不要，呃，喝點驅寒的藥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680918,
					"content": "不，我只是太久沒喝「寒山甘泉」了。只要喝到那個，我就能重振歌喉，為你們打開道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680919,
					"content": "「寒山甘泉」？是泉水的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680920,
					"content": "對。只要喝下那種水，疲憊的大人、睏倦的小鳥、無知的孩童…所有人都能唱出最優美的歌聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680922,
					"content": "好，我幫妳找。妳把泉水的所在地告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680923,
					"content": "謝謝妳！清澈的水令植物生長，它們變得茁壯，克服困難攀上高山…泉水，就在那些被植被庇護的山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680924,
					"content": "原來是上山啊！我還以為隨便打點海水就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680925,
					"content": "山泉跟海水完全是兩種東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680926,
					"content": "只不過，想要看到那樣的山泉，或許得靠我的力量。這位朋友，把手給我，這樣妳就能看到我所看見的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400680927,
					"content": "握了我的手，就是結交我這個朋友了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680906,
					"content": "昨天船也說話了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
