				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "咳咳，吃了一嘴灰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680402,
					"content": "沒事吧派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680403,
					"content": "果然，換地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680404,
					"content": "這裡怎麼有種荒涼的感覺…辛焱，這是跟妳有關的幻境沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680405,
					"content": "我猜沒錯，但…奇怪，怎麼會這麼荒涼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680406,
					"content": "你們看，那個地方好亮，像在邀請我們過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680407,
					"content": "嗯，過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680408,
					"content": "欸不對不對！這麼明顯，肯定是陷阱吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680409,
					"content": "說是這麼說，我們也沒有其他路可走啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680410,
					"content": "確實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "如果這的確是辛焱的幻境，應該不會有陷阱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680412,
					"content": "這話我愛聽！一下就肯定了我的人品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680413,
					"content": "有道理欸，那我們過去看看吧，不過要小心一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
