			"dialogs": [
				{
					"id": 400680501,
					"content": "門鎖住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680502,
					"content": "莫娜，變成水鑽進去！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "#說什麼胡話啊{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680506,
					"content": "#辛焱，{F#妳}{M#你}幹嘛把門鎖起來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680507,
					"content": "啊哈哈，就算妳問我，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680508,
					"content": "唔，不過我是個會把鑰匙放在家門口花盆底下的人，所以…附近應該有鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680509,
					"content": "噢！這附近有花盆嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680510,
					"content": "沒有花盆，但有…那個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "不無可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680504,
					"content": "萬葉用力跳起來，就能解決了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "…還是再想想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "楓原萬葉"
				}
			]
