			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "起床啦——！太陽曬到屁股上啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680202,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "派蒙，我是仰面朝上睡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "好吧，那太陽曬到肚子上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}，昨晚睡得好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680206,
					"content": "馬馬虎虎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "#大家好像都跟{F#妳}{M#你}差不多。今天我起得最早，四處逛了逛，摘了水果給大家當早餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680209,
					"content": "#為了等{F#妳}{M#你}起床，我可是一直忍著沒先吃哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680210,
					"content": "在大家的陪伴下享用了水果早餐，期間，眾人閒聊起來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "咦？菲謝爾一早就跑了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680212,
					"content": "嗯，她似乎不太願意跟我們一起行動，說是另有冒險家的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680213,
					"content": "太假了吧！明明說是來光復幽夜淨土的，怎麼又給冒險家協會打工去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680214,
					"content": "好了…派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "瞧她的樣子，應該是有心事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680216,
					"content": "我們按原計畫派出莫娜關懷她，沒想到，她居然說莫娜不懂冒險家的工作，不能跟去冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680217,
					"content": "菲謝爾為了獨處，連幽夜淨土這個藉口都不用了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680218,
					"content": "可見她遇到了不小的難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680219,
					"content": "唉，我身為朋友，很想幫幫她。不過有一句話她說對了，今天我們會去其他島嶼探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680220,
					"content": "欸？是這樣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "大家全票通過的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680222,
					"content": "我都沒參加，怎麼能算全票！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "#這個啊，剛才派蒙替{F#妳}{M#你}投了。她說，{F#妳}{M#你}和她是一夥的，{F#妳}{M#你}在哪兒她就在哪兒，反過來也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680224,
					"content": "#嘿嘿，{F#妳}{M#你}可是冒險家，肯定會去的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680225,
					"content": "（派蒙這傢伙，好吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "菲謝爾建議我們一起行動，她自己還有其他想調查的事，讓我們不用擔心，她忙完就來跟我們會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680227,
					"content": "別看她平時那樣，怎麼說都是個經驗豐富的冒險家，我想，我們應該相信她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680228,
					"content": "跟菲謝爾認識不久，我的意見只是冒昧猜測而已。不過我認為…她的矛盾在於自身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680229,
					"content": "好像還挺準的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680230,
					"content": "與他人的矛盾，不是解決就是放棄，唯獨跟自己，永遠不能輕易放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680231,
					"content": "…我也有過那樣的時期，很理解她。雖不知道她在苦惱什麼，但現在她需要獨處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400680232,
					"content": "我也同意，就是可惜了今天的冒險之旅…大家一起才有意思啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680233,
					"content": "辛焱太有進取精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680234,
					"content": "#啊對了，還沒告訴你們呢。今天早上，北邊那座島嶼出現了幻象，等{NICKNAME}吃完早餐，我們就去調查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680207,
					"content": "不錯哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
			"completionStepIds": [
				4006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
