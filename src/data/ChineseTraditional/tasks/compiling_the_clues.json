			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530902,
					"content": "分析給我聽聽吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "嗯，首先根據卡塔揚提供的資訊，基本上可以推斷出仙靈的真實身分是梨多梵諦學院的學生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530904,
					"content": "畢竟所有外來者的可能性都已經排除，也沒辦法繞過管理員拿走那兩本書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530905,
					"content": "接下來，排除匪夷所思的超能力本身不提，所有目擊地點皆為我們學院官方推薦的星相觀測地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530906,
					"content": "換句話說…它可能只是在做研究，而且研究內容與我很相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530907,
					"content": "我向它提出的問題並不簡單，但它可以在一天時間內給我答覆，表示它掌握了相似的背景知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530908,
					"content": "那麼，只需要根據這個推測，去下一個星相觀測地等待它就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530909,
					"content": "想法很清楚嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "過、過獎啦…其實還有些別的理由，是一直以來的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530912,
					"content": "不過這不重要，我們先去吧，就算有了線索，能不能有結論還很難說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530913,
					"content": "#至於為什麼我會這樣想…如果它真的沒有來的話，我再跟{F#妳}{M#你}說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 191530910,
					"content": "有這樣的推理能力，完成論文絕對沒有問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}