			"dialogs": [
				{
					"id": 790221801,
					"content": "啊，扎哈爾，扎哈爾你一定要平安無事啊…怎麼了，還沒打開荊棘封住的洞口嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221802,
						790221804,
						790221807,
						790221809
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221802,
					"content": "你們到底是來做什麼的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221803
					]
				},
				{
					"id": 790221803,
					"content": "只是一些跑腿的工作罷了，言盡於此，再問的話我也不會多說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221804,
					"content": "扎哈爾是誰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221805
					]
				},
				{
					"id": 790221805,
					"content": "扎哈爾是我的隊友，他身體有點不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221806
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221806,
					"content": "真不知道他有沒有出什麼事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221807,
					"content": "關於懷錶裡的合照…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221808
					]
				},
				{
					"id": 790221808,
					"content": "#不行，那個跟愚人眾沒什麼關係，也沒有什麼好告訴{F#妳}{M#你}的。{F#妳}{M#你}幫我找回了懷錶我很感激，可是也不能說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221809,
					"content": "再見…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
