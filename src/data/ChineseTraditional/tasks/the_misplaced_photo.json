			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿加菲婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220101,
					"content": "這裡怎麼有愚人眾，這名藏鏡仕女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220102,
					"content": "他們留在這裡，不會又在搞什麼陰謀詭計吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220103,
					"content": "…要趕快回去…要趕快回去，他還在…可是，哥哥們不見了，哥哥們的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220104
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220104,
					"content": "喂，妳是誰，在這裡有什麼企圖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220105,
					"content": "哥哥們的照片…丟了照片，就回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220106
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220106,
					"content": "愚人眾的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220107,
					"content": "不能，把他丟下…不能讓他一個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220108,
						790220109
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220108,
					"content": "狀態不太對呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				},
				{
					"id": 790220110,
					"content": "嗯…不過真有點在意為什麼會有一個藏鏡仕女在這呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220111,
					"content": "#{NICKNAME}，不如我們想辦法讓她清醒過來，然後好好問問這些散落在外的愚人眾在做什麼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220112,
					"content": "確實不能放著不管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220113
					]
				},
				{
					"id": 790220113,
					"content": "嗯，雖然只是一個不太正常的愚人眾…但是放任不管的話總覺得不是什麼好事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220114,
					"content": "不過，她到底為什麼會變成現在這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220115,
					"content": "因為那個裝置吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220116
					]
				},
				{
					"id": 790220116,
					"content": "啊，是哦，那個裝置影響了島上所有的人…不過那個裝置明明已經關閉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220117,
					"content": "哥哥們和我的合照…要是那個找不回來了，我就沒法回去，可是…可是他還在那裡，獨自等著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220118
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220118,
					"content": "#我明白了…{NICKNAME}，我們把她心心念念的什麼合照找來吧，說不定就能讓她清醒過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220109,
					"content": "沒辦法溝通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220110
					]
				}
			]
		},
		{
			"id": 7902206,
			"completionStepIds": [
				7902206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
