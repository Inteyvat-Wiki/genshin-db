				"points": []
			},
			"dialogs": [
				{
					"id": 790222301,
					"content": "扎哈爾，扎哈爾…你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222302
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222302,
					"content": "阿加霞，怎麼了，出什麼事了…我只是在這裡睡了一覺，不過身體已經舒服很多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222303
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222303,
					"content": "唉…你沒事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222304
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222304,
					"content": "嘿嘿，對了，阿加霞，妳之前給我的果子，妳給了我四個，我可一個都沒吃呢，就等妳回來一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222305
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222305,
					"content": "真是的，本來就是幫你摘的蘋果…要是等太久餓了，就先吃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222306
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222306,
					"content": "可是妳獨自去做任務，更辛苦…雖然很餓，但是扎哈爾忍住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222307
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222307,
					"content": "哦？獨自去執行任務呀，是執行了什麼任務呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222308,
					"content": "啊，不就是因為雅科夫差點弄壞了設備，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222309
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222309,
					"content": "扎哈爾！你怎麼什麼話都敢向外人說啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222310
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222310,
					"content": "#啊！{F#妳}{M#你}們，這不是內部文件上的，{NICKNAME}和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222311
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222311,
					"content": "「小飛人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222312
					]
				},
				{
					"id": 790222312,
					"content": "對，是「小飛人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222313
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222313,
					"content": "我已經說膩了，我的名字是「派蒙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222314,
					"content": "#嘿嘿，我腦袋不太靈光，我的名字是扎哈爾…不對，{F#妳}{M#你}們和我們愚人眾不是…不是敵人嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222315
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222315,
					"content": "阿加菲婭，是妳把敵人帶到這裡來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222316
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222316,
					"content": "對，這兩位就是把你從荊棘裡救出來的好心…救出來的好敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222317
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222317,
					"content": "#對哦，妳走了以後不久，這裡突然長出了巨大的荊棘，把山洞封起來了…是{F#妳}{M#你}們把那個巨大荊棘消滅掉的嗎，了不起啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222318
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222318,
					"content": "正是如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222319,
					"content": "可是我們不是敵人嘛，為什麼要做幫助敵人的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222320
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222320,
					"content": "真是個讓人有點答不上來的好問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222321,
					"content": "當然是因為她答應了，如果我們把你救出來，她就告訴我們，你們幾個到底在這個島上幹什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222322,
					"content": "阿加霞，妳居然出賣愚人眾的情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222323
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222323,
					"content": "沒關係的，扎哈爾，到時候我們隨便說些什麼「愚人眾在這片海域捕獵神秘花鱂」之類的話糊弄過去就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222324
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222324,
					"content": "哇，居然光明正大地說要糊弄我們，真是被小看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222325,
					"content": "好了，荊棘也打開了，扎哈爾也救出來了，該說出你們要做什麼事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222326,
					"content": "不能說呀，阿加菲婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222327
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222327,
					"content": "唉，都到了這個時候了…不過說實話。其實我們也不太清楚，只是過來做測試的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222328,
						790222329
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222328,
					"content": "測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				},
				{
					"id": 790222330,
					"content": "大概是什麼訊號測試吧…具體的內容我也不清楚，不過如果是小隊裡的另一組人，應該知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222331
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222331,
					"content": "他們確實說了一大堆，不過你們這邊只有這些嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222332,
					"content": "#我知道的也不多嘛…對了，情報也說了，{F#妳}{M#你}們可以放我們走了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222333
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222333,
					"content": "雖然好像沒有答應過會放你們走，不過看起來也沒什麼危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222334,
					"content": "那就算我們大發慈悲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222335
					]
				},
				{
					"id": 790222335,
					"content": "欸呀，那還真是感謝了。唉，也不知道另一組去其他兩個島的傢伙們怎麼樣了，我們當時約好，做完任務就回海域中間的營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222336
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222336,
					"content": "啊，妳說的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790222337,
					"content": "是之前碰到的其他愚人眾呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222338
					]
				},
				{
					"id": 790222338,
					"content": "#原來{F#妳}{M#你}已經遇到過了嗎？不行，扎哈爾，我們得盡快返回營地，到之前說好的會合地點才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790222329,
					"content": "什麼測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				}
			]
		},
