			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220601,
					"content": "扎哈爾！扎哈爾！你能聽見嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220602
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220602,
					"content": "這裡怎麼會變成這樣…我們來的時候這裡明明就是個山洞，這荊棘是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220603
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220603,
					"content": "啊，這就是因為受到你們那個什麼幻境實驗的影響導致的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220604,
					"content": "這個島上有很多類似的荊棘呢，不過只要用一定的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220605,
					"content": "#是放火嗎？{F#妳}{M#你}們不會是想放火燒掉荊棘吧，不行，裡面還有人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220606
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220606,
					"content": "#雖說早就聽聞{NICKNAME}和派蒙非常危險，有的時候只是走在執行公務的路上也會被突然襲擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220607
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220607,
					"content": "但是居然想放火慢慢燒一個大活人，天啊，就連最殘忍的債務處理人都做不到這種程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220608
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220608,
					"content": "當然不是啦…而且這種荊棘用火燒也沒用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220609,
					"content": "我們有將荊棘打開，但不會傷到裡面的人的辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220610,
					"content": "#真的嗎，我才不信{F#妳}{M#你}們有這麼神通廣大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220611
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220611,
					"content": "#什麼，{NICKNAME}，這就把荊棘打開給她看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220612,
						790220613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220612,
					"content": "上當受騙了哦，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				},
				{
					"id": 790220614,
					"content": "咦…好呀，妳故意挑撥我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220615,
					"content": "居然被識破了，真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220616
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220616,
					"content": "哼，真是奸詐狡猾的愚人眾，我們差點就中了妳的詭計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220617,
					"content": "中計的只有妳啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220618
					]
				},
				{
					"id": 790220618,
					"content": "嗚…總之，總之我們可以救出裡面的人，但是相對的，妳也得說出一些情報來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220619,
					"content": "這就是用別人的珍貴之物作為威脅，讓別人說出情報的方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220620,
					"content": "哇，真是好沒有人情味的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220621
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220621,
					"content": "好沒有人情味的做法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220622
					]
				},
				{
					"id": 790220622,
					"content": "#她說也就算了，為什麼{F#妳}{M#你}也說我呀，{F#妳}{M#你}到底是哪一邊的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220623,
					"content": "…情報嗎，阿加菲婭，我的名字是阿加菲婭，現在能給的情報只有這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220624
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220624,
					"content": "只有一個名字嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220625,
					"content": "我要是說出什麼重要情報，你們就拉下臉來說什麼「是嘛，你已經沒用了…」之類的臺詞，然後把我解決掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220626
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220626,
					"content": "愚人眾的教官說每年都會發生很多類似的事，所以一定不能外洩重要的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220627
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220627,
					"content": "我們才不會幹這樣的事呢！還有你們愚人眾的教官真的很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220628,
					"content": "#奇怪嗎…我倒覺得還挺正常的。總之，我現在就一個人在這裡，無論如何{F#妳}{M#你}們都能很輕鬆解決我不是嗎？我又逃不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220629
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220629,
					"content": "#嗯…總覺得有點不甘心，唉，沒辦法，{NICKNAME}，那我們就先打開封住洞口的荊棘吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220613,
					"content": "別這麼簡單就被挑撥啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220614
					]
				}
			]
		},
		{
			"id": 7902207,
			"completionStepIds": [
				7902201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7902303",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902201",
							"2"
						],
						"stepId": 7902201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿加菲婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220701,
					"content": "#{NICKNAME}，這個藏鏡仕女給人感覺好奇怪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220702,
					"content": "…要趕快回去…要趕快回去，他還在…可是，哥哥們不見了，哥哥們的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220703
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220703,
					"content": "喂，愚人眾的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220704,
					"content": "哥哥們的照片…丟了照片，就回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220705
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220705,
					"content": "愚人眾的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220706,
					"content": "不能，把他丟下…不能讓他一個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220707,
						790220708
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220707,
					"content": "狀態不太對呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				},
				{
					"id": 790220709,
					"content": "總覺得看到過類似的場景啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220710,
					"content": "之前的愚人眾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220711
					]
				},
				{
					"id": 790220711,
					"content": "是哦，之前碰到葉夫卡的時候，他也一直念著「徽記、徽記…」什麼的，把徽記給他就清醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220712,
					"content": "愚人眾在這裡做實驗，結果連自己的人都被影響了，這就叫「惡有惡報」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220713,
					"content": "派蒙說的對！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220714
					]
				},
				{
					"id": 790220714,
					"content": "這麼說來，這個藏鏡仕女是不是就是葉夫卡說的，他們小隊的成員啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220715,
					"content": "那我們是不是也要找到什麼讓她清醒過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220716,
					"content": "哥哥們和我的合照…要是那個找不回來了，我就沒法回去，可是…可是他還在那裡，獨自等著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220717
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220717,
					"content": "#我明白了…{NICKNAME}，看來得把她心心念念的那個合照給她，她才會醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220708,
					"content": "沒辦法溝通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				}
			]
		},
		{
			"id": 7902208,
			"completionStepIds": [
				7902208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902208",
							"2"
						],
						"stepId": 7902208,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7902303",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲婭",
					"扎哈爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220801,
					"content": "扎哈爾，扎哈爾…你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220802
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220802,
					"content": "阿加霞，怎麼了，出什麼事了…我只是在這裡睡了一覺，不過身體已經舒服很多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220803
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220803,
					"content": "唉…你沒事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220804
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220804,
					"content": "嘿嘿，對了，阿加霞，妳之前給我的果子，妳給了我四個，我可一個都沒吃呢，就等妳回來一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220805
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220805,
					"content": "真是的，本來就是幫你摘的蘋果…要是等太久餓了，就先吃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220806
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220806,
					"content": "可是妳獨自去做任務，更辛苦…雖然很餓，但是扎哈爾忍住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220807
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220807,
					"content": "哦？獨自去執行任務呀，是執行了什麼任務呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220808,
					"content": "啊，不就是因為雅科夫差點弄壞了設備，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220809
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220809,
					"content": "扎哈爾！你怎麼什麼話都敢向外人說啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220810
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220810,
					"content": "#啊！{F#妳}{M#你}們，這不是內部文件上的，{NICKNAME}和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220811
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220811,
					"content": "「小飛人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220812
					]
				},
				{
					"id": 790220812,
					"content": "對，是「小飛人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220813
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220813,
					"content": "我已經說膩了，我的名字是「派蒙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220814,
					"content": "#嘿嘿，我腦袋不太靈光，我的名字是扎哈爾…不對，{F#妳}{M#你}們和我們愚人眾不是…不是敵人嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220815
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220815,
					"content": "阿加菲婭，是妳把敵人帶到這裡來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220816
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220816,
					"content": "對，這兩位就是把你從荊棘裡救出來的好心…救出來的好敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220817
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220817,
					"content": "#對哦，妳走了以後不久，這裡突然長出了巨大的荊棘，把山洞封起來了…是{F#妳}{M#你}們把那個巨大荊棘消滅掉的嗎，了不起啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220818
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220818,
					"content": "正是如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220819,
					"content": "可是我們不是敵人嘛，為什麼要做幫助敵人的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220820
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220820,
					"content": "真是個讓人有點答不上來的好問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220821,
					"content": "當然是因為她答應了，如果我們把你救出來，她就告訴我們，你們幾個到底在幹什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220822,
					"content": "阿加菲婭，你居然出賣愚人眾的情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220823
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220823,
					"content": "沒關係的，扎哈爾，到時候我們隨便說些什麼「愚人眾在這片海域捕獵神秘花鱂」之類的話糊弄過去就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220824
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220824,
					"content": "哇，居然光明正大地說要糊弄我們，真是被小看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220825,
					"content": "好了，荊棘也打開了，扎哈爾也救出來了，該說出你們要做什麼事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220826,
					"content": "不能說呀，阿加菲婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220827
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790220827,
					"content": "唉，都到了這個時候了…不過說實話。其實我們也不太清楚，只是過來做測試的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220828,
						790220829
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220828,
					"content": "測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				},
				{
					"id": 790220830,
					"content": "大概是什麼訊號測試吧…具體的內容我也不清楚，不過如果是小隊裡的另一組人，應該知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220831
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220831,
					"content": "只有這些嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220832,
					"content": "#我知道的也不多嘛…對了，情報也說了，{F#妳}{M#你}們可以放我們走了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220833
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220833,
					"content": "雖然好像沒有答應過會放你們走，不過看起來也沒什麼危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220834,
					"content": "那就算我們大發慈悲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220835
					]
				},
				{
					"id": 790220835,
					"content": "欸呀，那還真是感謝了。唉，也不知道<color=#00E1FFFF>另一組的傢伙們</color>怎麼樣了，我們當時約好，說做完任務就回海域中間的營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220836
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220836,
					"content": "另一組人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220837,
					"content": "對，也是兩個人，說是要朝著<color=#00E1FFFF>南方的兩個島</color>的方向去了…啊，這可是額外的情報，不是無意中被套話了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220838
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220838,
					"content": "南方的大島上…那就是危危島吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220839
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790220839,
					"content": "好了好了，不能再說了，我們得快點回海域中央島嶼上的營地才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790220829,
					"content": "什麼測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220830
					]
				}
			]
		},
