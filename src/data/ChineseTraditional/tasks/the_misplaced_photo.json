			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790221201,
					"content": "這…啊，這個是我的，這裡面是哥哥們和我的合照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221202
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221202,
					"content": "能夠重新找回來真是太好了，之前到底是丟在哪了呢…唔，不對，頭好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221203
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221203,
					"content": "我們是在丘丘人營地的旁邊找到的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221204,
					"content": "真是，真是十分感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221205
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221205,
					"content": "#啊！是內部文件上看到過的…金髮的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}和小飛人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221206
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221206,
					"content": "是「派蒙」啦…唉，我乾脆改名叫「小飛人」算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221207,
					"content": "#{F#妳}{M#你}們對我做了什麼，記憶…記憶有一段空白，{F#妳}{M#你}們不會對我做了什麼奇怪的實驗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221208
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221208,
					"content": "就算我們立場不同…這樣的行為也是不能被接受的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221209
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221209,
					"content": "做奇怪實驗的是你們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221210,
					"content": "居然對把合照還給妳的好心人說這種話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221211,
					"content": "…原來是這樣，可是，既然我清醒了過來就說明，佩爾西科夫研究員的實驗失敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221212
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221212,
					"content": "#看到{F#妳}{M#你}們也大概猜到失敗的原因…欸呀，從立場上我們暫時仍是敵對的，{F#妳}{M#你}們還把合照給我，{F#妳}{M#你}們對敵人也太好心了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221213
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221213,
					"content": "正確的做法應該是把別人的珍貴之物，比如對我來說，就是剛才懷錶裡的合照…應該把合照拿在手裡，然後威脅我說出情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221214
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221214,
					"content": "居然反過來被教訓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221215,
						790221217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221215,
					"content": "好沒有人情味的做法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221216
					]
				},
				{
					"id": 790221216,
					"content": "…確實，是很沒有人情味的做法，但是我們進入愚人眾之後就是這樣被教導的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221219,
					"content": "對了，你們在這裡到底在搞什麼破壞，快說出來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790221220,
					"content": "我…我們，我們一起到了這島上…對了，扎哈爾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221221
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221221,
					"content": "他還一個人在那裡，得快點回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221222
					],
					"speakerTitle": "阿加菲婭"
				},
				{
					"id": 790221222,
					"content": "似乎想起了什麼，剛清醒的愚人眾轉身就離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 790221217,
					"content": "下次試試看吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790221218
					]
				},
				{
					"id": 790221218,
					"content": "不要學這種事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221219
					],
					"speakerTitle": "派蒙"
				}
			]
		},
