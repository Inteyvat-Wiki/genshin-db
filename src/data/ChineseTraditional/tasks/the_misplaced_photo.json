			"dialogs": [
				{
					"id": 790222501,
					"content": "#{F#妳}{M#你}和我們是敵人，不應該跟敵人作太多的交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222502
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222502,
					"content": "如果跟敵人說太多話，關係也會變得親密，心也會變的柔軟，這樣在戰鬥的時候就會陷入劣勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222503
					],
					"speakerTitle": "扎哈爾"
				},
				{
					"id": 790222503,
					"content": "教官是這樣告訴我們的。",
					"roleType": "TALK_ROLE_NPC",
