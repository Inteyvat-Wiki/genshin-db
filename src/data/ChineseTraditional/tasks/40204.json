			"completionStepIds": [
				4020401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4020401",
							"2"
						],
						"stepId": 4020401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法德瓦",
					"阿塔希耶",
					"達爾維什"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "阿塔希耶，我忍你很久了…你提供的這些東西，根本就沒有能夠用得上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040102,
					"content": "你看看你寫的報告上都是什麼東西…「可能」、「大概」、「差不多」，你就這樣讓我做數學模型？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040103,
					"content": "這個、這個，成立課題的時間有限，更何況我是妙論派的，誰知道對生物產生的影響應該怎麼測量…比如、比如蕈獸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040104,
					"content": "總、總不能我把手伸到蕈獸嘴巴前面讓它們咬一口，然後記錄下來說「咬合力真的很驚人」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040105,
					"content": "達爾維什，你才是那個生論派的，你來評評理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040106,
					"content": "哈哈，如果要讓我來評理，那我必須說，阿塔希耶你的基礎課程學得不太行，畢竟大家都知道大部分的蕈獸都沒有嘴巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040107,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040108,
					"content": "不過，法德瓦，我們這次也不需要這麼嚴謹的數學模型，我們這次的課題也不是針對院裡的那些老學究做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040109,
					"content": "我們要做的是提供給孩子的課題…嗯，得有趣才行啊，或許適當的想像也是必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040110,
					"content": "唔…唔，既然前輩你這麼說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040111,
					"content": "喂，法德瓦，妳對待達爾維什的態度是不是和對我的態度差太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040112,
					"content": "好了好了，我這邊的東西都負責的差不多了，阿塔希耶的結論我也過一遍好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040113,
					"content": "而且，資料也可以在測試以後調整，這就是測試的意義嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040114,
					"content": "啊，不愧是達爾維什前輩…條理清晰，比某個人好太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040115,
					"content": "是是，我就不問妳嘴裡的「某個人」是誰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040116,
					"content": "好啦好啦，快去做最後的準備吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040117,
					"content": "好、好的！前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040118,
					"content": "我也去看看畫上的漆彩乾了沒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040119,
					"content": "不過說到測試…測試的人員啊，那邊的那兩位，有沒有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040120,
					"content": "剛才站在那邊看了半天了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040121,
					"content": "咦，我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040122,
					"content": "對對，參與測試，還有大量新鮮水果吃喔，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040123,
					"content": "是新水果品種的測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "不是，嗯…讓我想想應該從什麼地方說起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040130,
					"content": "不如這樣，我不如先問兩位一個問題吧…嗯，比如…「會滑鏟的伸縮火蕈獸和長鬢虎打架誰厲害」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040131,
					"content": "會滑鏟的伸縮火蕈獸吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "是嘛，我倒是覺得長鬢虎看上去比較能打呢…長鬢虎的爪子迅速敏捷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040133,
					"content": "唔，怎麼會有這麼奇怪的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040140,
					"content": "嗯…還有喔，比如「浮游風蕈獸和風史萊姆誰更強？」、「鍍金旅團和納塔的龍武士誰比較厲害？那海亂鬼呢？」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040141,
					"content": "都是我們在向孩子們講學的時候，他們問出口的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040142,
					"content": "小小年紀就關心這些比來比去的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040143,
					"content": "哈哈，不過孩子們的好奇心就是講學教育的起點，他們「想要知道」…所以我們才做了這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040144,
					"content": "模仿嚴肅「推演」所做的「夥伴冒險大戰記」！讓孩子們模擬養成他們的冒險隊伍，然後和敵人對戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040145,
					"content": "阿塔希耶正好在做飲食和生活環境對於魔物的影響的課題，而法德瓦則幫忙建立「模擬養成」的模型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040146,
					"content": "模擬養成？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "嗯，畢竟不能真的讓孩子去和蕈獸、鍍金旅團接觸嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040148,
					"content": "怎麼樣，有空的話就來看看吧，嘿嘿，參與測試的話，也能算作參與課題，這樣不斷累積，也能有了不起的學歷呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040149,
					"content": "#哦哦，聽上去好棒哦…{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040150,
					"content": "好哦，派蒙累積學歷當賢者！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "哼，可別小看我，我可是很了不起的，以後會更了不起。嗯！我們待會就來看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040152,
					"content": "#那就歡迎{F#妳}{M#你}們來測試，{NICKNAME}，當然了，哈哈，還有了不起的未來賢者派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040153,
					"content": "#嗯，{F#妳}{M#你}們想要試試的話就跟我說吧，我也要先跟{F#妳}{M#你}們講解一下「模擬養成」的規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040134,
					"content": "當然是長鬢虎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040135
					]
				},
				{
					"id": 402040135,
					"content": "哦哦！我也覺得長鬢虎比較厲害呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040136,
					"content": "唔，怎麼會有這麼奇怪的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040137,
					"content": "會滑鏟的長鬢虎最厲害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040138
					]
				},
				{
					"id": 402040138,
					"content": "到底什麼是會滑鏟的長鬢虎啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040139,
					"content": "唔，是誰問的這麼奇怪的問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040125,
					"content": "抱歉，只對吵架感興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040126
					]
				},
				{
					"id": 402040126,
					"content": "別這麼說嘛，聽上去好像是什麼路過的怪人一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040127,
					"content": "不如我們先聽聽他想做的測試是什麼樣再決定嘛。我對新鮮水果…我對他們的研究課題有點好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040128,
					"content": "哎呀，這位白色的小小女士有這樣的好奇心，旅途中的運氣肯定不會太差的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040129
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040129,
					"content": "那就讓我為兩位解釋一下這個課題…應該從什麼地方說起呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "達爾維什"
				}
			]
		},
		{
			"id": 4020402,
