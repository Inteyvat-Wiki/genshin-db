			"dialogs": [
				{
					"id": 402040201,
					"content": "哦，怎麼樣，要學習一下「夥伴冒險大戰記」的規則嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040202
					],
					"speakerTitle": "達爾維什"
				},
				{
					"id": 402040202,
					"content": "嗯，現在開始吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040203
					]
				},
				{
					"id": 402040203,
					"content": "好，那麼…就讓我打開一下教學的地圖和棋盤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達爾維什"
				}
			]
		}
