				]
			},
			"dialogs": [
				{
					"id": 761430101,
					"content": "旅程的終點到了，她就是開啟望月者計畫的鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430102
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430102,
					"content": "她是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430103
					]
				},
				{
					"id": 761430103,
					"content": "是望月者計畫的最後繼承者，留在這裡的印跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430104
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430104,
					"content": "她會解釋一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430105
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430105,
					"content": "嘿！你好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430106
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430106,
					"content": "妳好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430107
					]
				},
				{
					"id": 761430107,
					"content": "我是寧希姬婭，你也可以叫我寧寧，是我的小名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430108
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430108,
					"content": "你叫什麼名字？伊比尼伯龍？烏吉恩？瑪歌？還是盧沙里姆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430109
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430109,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430110
					]
				},
				{
					"id": 761430110,
					"content": "嘿嘿，不用回答我，因為很遺憾，我已經不在了，這只是一段留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430111
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430111,
					"content": "但反過來想，其實一點也不遺憾，因為你來到了這裡——這代表計畫成功了，你繼承了我們的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430112
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430112,
					"content": "你一定還有很多疑惑，比如——我到底是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430113
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430113,
					"content": "讓我告訴你，你是由月球意志創生的新生命，你是望月者計畫的重要一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430114
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430114,
					"content": "「那這個計畫究竟是什麼呢？」你肯定又在這麼想…別著急，聽我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430115
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430115,
					"content": "首先，請感謝三月女神，她們容許了我們的僭越，借用了月球本源的創生之力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430116
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430116,
					"content": "其次，感謝我的老師盧沙里姆。他繼承了所有人的研究成果，還成功蒐集了大家的古月力資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430117
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430117,
					"content": "這樣一來，我才能把資訊匯聚於這片月心之海，當本源的創生之力被激發時，「砰」地一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430118
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430118,
					"content": "一隻可愛的黑色月靈——也就是你，誕生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430119
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430119,
					"content": "你可能會繼承資訊海洋中某位前輩的名字，也可能不會，但大概能想起你有一個使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430120
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430120,
					"content": "原來這就是黑蛋的誕生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430121
					]
				},
				{
					"id": 761430121,
					"content": "接下來，還要感謝瑪歌前輩，她揭開了那位星空訪客的本質——一種資訊生命，她的研究是你誕生的基石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430122
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430122,
					"content": "還有烏吉恩前輩，他付出生命，傳遞了那位訪客所代表的文明最後向星空傳遞的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430123
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430123,
					"content": "然後，是最初的望月者——伊比尼伯龍。他帶著我們登上月亮，睜大了我們的眼睛，永不疲倦地望向璀璨星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430124
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430124,
					"content": "最後，繼承者，還要感謝你，因為你即將獻出自己，去望月者高塔啟動計畫的最後一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430125
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430125,
					"content": "你的使命，就是繼續向宇宙發送我們曾經接收到的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430126
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430126,
					"content": "「一束光很微弱，很容易被黑暗吞沒，但只要在它消失前有另一束光亮起…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430127
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430127,
					"content": "「那麼總有一天，總有一束光，會成為刺破夜幕的曙光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430128
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430128,
					"content": "說到這裡，你應該理解了吧？剛好，我的時間差不多也要到了…但沒關係，我馬上就來加入大家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430129
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430129,
					"content": "這樣一想，搞不好，你繼承的可能會是我的名字呢，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430130
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430130,
					"content": "該說再見了，去完成你的使命吧。最後…向你和所有的望月{RUBY#[S]星空}者致意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430131
					],
					"speakerTitle": "寧希姬婭的印跡"
				},
				{
					"id": 761430131,
					"content": "#就是這樣，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430132
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430132,
					"content": "所有探尋過星空的學者，他們的資訊都被融入了這片海洋，藉著月球的意志，在未來的某天以黑蛋的模樣再次誕生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430133
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430133,
					"content": "它們會本能地互相吞噬來獲得更多資訊，直到腦海中的使命變清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430134
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430134,
					"content": "然後再走一遍我們所走過的路，來到這裡，得知一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430135
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430135,
					"content": "它們會用自己當作鑰匙，打開伊比尼伯龍之眼的望月者模組。向宇宙重新發送訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430136
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430136,
					"content": "最後回歸生命的循環…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430137
					]
				},
				{
					"id": 761430137,
					"content": "嗯，這個循環可能已經不只發生過一次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430138
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430138,
					"content": "但是，向未知的星空發出聲音，未必是一件安全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430139
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430139,
					"content": "龍族的學者一定也意識到了這點，所以開始研究月幕工程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430140
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430140,
					"content": "而在寧寧的年代，世界因為兩位至高者的爭鬥，已是將要毀滅的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430141
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430141,
					"content": "可是現在，提瓦特已經恢復了平靜——至少現在如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430142
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430142,
					"content": "（如果這次發出的訊號，最後卻讓星空中的黑暗注意到這裡…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430143
					]
				},
				{
					"id": 761430143,
					"content": "我會依照承諾，把鑰匙和資訊交給寧寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430144
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430144,
					"content": "#但{F#妳}{M#你}覺得我們應該阻止寧寧完成她的使命，還是支持她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430145
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430145,
					"content": "我需要一點時間考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430146
					]
				},
				{
					"id": 761430146,
					"content": "嗯，我理解。那我們就返回那座最初的望月者高塔吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430147
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430147,
					"content": "派蒙和寧寧呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430148
					]
				},
				{
					"id": 761430148,
					"content": "放心，瑪歌會接上她們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430149
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430149,
					"content": "去那裡還有不短的路程，我們可以多考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430150
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430150,
					"content": "走吧。該離開這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥倫比婭"
				}
			]
		},
