					"content": "這裡是盧沙里姆最後的研究場所，而上一個是月幕實驗室，也就是現在的月海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430305
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430305,
					"content": "是…月海的古月之源？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761430306
					]
				},
				{
					"id": 761430306,
					"content": "就是這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430307
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430307,
					"content": "嗯？是識別到了入侵者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761430308
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761430308,
					"content": "不過它們攔不住我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥倫比婭"
				}
