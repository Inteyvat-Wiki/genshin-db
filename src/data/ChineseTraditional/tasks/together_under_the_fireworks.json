			"trigger": {
				"objectNames": [
					"松坂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130101,
					"content": "宵宮姐姐好！對付「大貉妖」的武器，宵宮姐姐做好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120130102,
					"content": "那個我已經拜託給龍之介伯伯了，待會你們就去找他拿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130103
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130103,
					"content": "欸？難道姐姐不陪我們玩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130104
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130104,
					"content": "對不起，姐姐還有些重要的事，會稍微晚一點回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130105,
					"content": "下次給你們帶糖果吧！就是你們喜歡的，很甜很甜的那種糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130106,
					"content": "好！又有糖吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130107,
					"content": "對了，我有個事想打聽，你們剛剛看到了一群看起來很兇的叔叔經過這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130108
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130108,
					"content": "有的有的，他們好像在抓什麼人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130109
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130109,
					"content": "他們是不是也在抓妖怪啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130110
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130110,
					"content": "沒事，你們不用擔心，是叔叔他們誤會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130111
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130111,
					"content": "你們聽話，留在城裡，等煙花會開始了就和大家一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130112,
					"content": "嗯，會好好聽話的！宵宮姐姐說什麼我們就做什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "松坂"
				}
			]
		},
