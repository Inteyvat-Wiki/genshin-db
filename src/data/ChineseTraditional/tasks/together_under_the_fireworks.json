			"dialogs": [
				{
					"id": 120130201,
					"content": "前方正在執行公務，禁止通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130202
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130202,
					"content": "朔次郎和佳祐就在裡面對吧？我們有事情要找他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130203
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130203,
					"content": "聽不懂人話嗎？就說了禁止通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130204
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130204,
					"content": "真礙事，那就別怪我們不客氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
