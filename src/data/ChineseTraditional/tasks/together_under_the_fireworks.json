			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷佳祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130501,
					"content": "哈啊…哈啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130502
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130502,
					"content": "你的劍技一直沒長進啊，朔次郎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130503
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130503,
					"content": "你明知道和我決鬥，是不可能有勝算的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130504
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130504,
					"content": "我沒想到，最後竟是落到你的手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130505
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130505,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130506
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130506,
					"content": "我認了，這就是命運吧，我已經沒什麼想說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130507
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130507,
					"content": "但至少你回來了。這表示你最終還是認同了我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130508
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130508,
					"content": "隨你怎麼說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130509
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130509,
					"content": "跟我回天領奉行，聽候發落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130510
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130510,
					"content": "這艘船的製造者，也逃不過懲處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130511
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130511,
					"content": "等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130512
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130512,
					"content": "為什麼就這麼決定了！你們沒有更多的話要說嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130513
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130513,
					"content": "我知道妳，是長野原家造煙花的那個姑娘…早就知道妳愛管閒事，但這件事和妳無關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130514
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130514,
					"content": "沒事的，宵宮，過去的事已經沒有什麼好說的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130515
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130515,
					"content": "那你辛辛苦苦，不惜偷渡也要回到稻妻是為了什麼？！猶豫那麼久又是為了什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130516
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130516,
					"content": "不就是想要現在這樣，可以好好說話的機會嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130517
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130517,
					"content": "我沒有話要和他說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130518
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130518,
					"content": "他是犯人，我是天領奉行的執法者，本來就沒有交談的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130519
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130519,
					"content": "只是念在舊日的友誼，我給了他與我決鬥的機會，但他的劍技還是像以前一樣不爭氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130520
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130520,
					"content": "為什麼要說這種話？別再騙人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130521
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130521,
					"content": "你把你的手下都留在那邊封路，這裡一個跟隨的人都沒有，不就是覺得，可能還有對話的機會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130522
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130522,
					"content": "明明兩個人都是一副有話要說的樣子，為什麼就是什麼都不願意說啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130523
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130524
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130524,
					"content": "自作多情。妳又懂什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130525
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130525,
					"content": "行了，宵宮，我覺得只是我一廂情願而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130526
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130526,
					"content": "不行！明明什麼都沒做，當然不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130527
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130527,
					"content": "既然這樣，佳祐，你習慣用決鬥解決問題，那就跟我決鬥吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130528
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130528,
					"content": "只要我贏了你，你就要說出你的真心話，不要再隱藏自己的真意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130529
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130529,
					"content": "朔次郎，你也是！我贏了的話，你就把你回來的原因告訴他，無論結果如何，都一定要說出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130530
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130530,
					"content": "不說的話，可能就再也沒有機會了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130531
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130531,
					"content": "那，如果妳輸了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130532
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130532,
					"content": "我輸了，那我就承認我是朔次郎的共犯，任憑天領奉行發落！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130533
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130533,
					"content": "宵宮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130534
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130534,
					"content": "我接受。一決勝負吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷佳祐"
				}
			]
		},
		{
			"id": 1201307,
			"completionStepIds": [
				1201307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201307",
							"2"
						],
						"stepId": 1201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷佳祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130701,
					"content": "#頭兒，{F#她}{M#他}們真的很強，我們還要找更多的兄弟來支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130702
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130702,
					"content": "退下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130703
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130703,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130704
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130704,
					"content": "不是叫你們不要闖進來嗎！都給我退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130705
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130705,
					"content": "是、是…對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130706
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130706,
					"content": "我覺得，妳這個姑娘，跟當年的朔次郎一樣固執。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130707
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130707,
					"content": "妳為什麼覺得，我們之間一定有話要說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130708
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130708,
					"content": "因為，朔次郎回來，雖然沒有對我講你的故事，但他找我做了煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130709
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130709,
					"content": "從你的爸爸媽媽那裡，我聽到了你和朔次郎過去的故事，那時候我就知道，這煙花對你們有特殊的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130710
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130710,
					"content": "——那就絕對不是無話可說，絕對不是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130711
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130711,
					"content": "不是為了感受寂寞，才放煙花的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130712
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130712,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130713
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130713,
					"content": "其實，我是因為迷茫才回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130714
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130714,
					"content": "並不是我改變了以前的想法，而是我覺得我的做法只是在逃避現實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130715
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130715,
					"content": "我見識到了蒙德的自由、璃月的契約、須彌的智慧、楓丹的正義…對我而言都有很深的感觸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130716
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130716,
					"content": "我慶幸我離開了稻妻，但在我慶幸之時，偶然聽說稻妻實施了鎖國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130717
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130717,
					"content": "我是逃離者，我因我的逃跑而驕傲，但實際上，我真正應該做的，是把這些外面的東西帶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130718
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130718,
					"content": "你還是天真地想要改變這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130719
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130719,
					"content": "不，不再是那麼恢弘的想法了。我只是覺得逃走是不對的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130720
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130720,
					"content": "明明你都沒有逃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130721
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130721,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130722
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130722,
					"content": "我過得並不好，也不知道你過得怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130723
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130723,
					"content": "但就像聽到了命運的召喚，我想回來看看的心情，已經無法遏止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130724
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130724,
					"content": "…有誰過得好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130725
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130725,
					"content": "我非常崇拜雷電將軍，將她的一切想法都奉為教條去執行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130726
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130726,
					"content": "但我現在的工作，就是在懲罰鎖國的違逆者，收繳神之眼。我從沒想過成為天領奉行眾要做這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130727
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130727,
					"content": "我做的，真的就是正確的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130728
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130728,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130729
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130730
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130730,
					"content": "船留給你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130731
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130731,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130732
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130732,
					"content": "我沒辦法讓你留在稻妻，但我也不想把你抓回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130733
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130733,
					"content": "但這樣你不是沒辦法和上面交代？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130734
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130734,
					"content": "不用管我，我自有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130735
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130735,
					"content": "我聽說現在外面的人想回稻妻，需要辦理的手續很複雜，但總歸還是有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130736
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130736,
					"content": "我會幫你一把的，在那之前，你在外面等著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130737
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130737,
					"content": "…別死在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130738
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130738,
					"content": "放心吧，佳祐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130739
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130739,
					"content": "我還想和你一起看煙花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130740
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130740,
					"content": "嗯，下次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130741
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130741,
					"content": "這下子會被降職吧，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130742
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130742,
					"content": "也老大不小的了，我怎麼會做出這麼幼稚的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130743
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130743,
					"content": "那艘船…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130744
					]
				},
				{
					"id": 120130744,
					"content": "就是朔次郎想用來逃跑的那一艘，之前我叫義高他們運到了這裡，用的是「暫放違禁品」的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130745
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130745,
					"content": "把朔次郎追到這裡來，也是我早就計劃好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130746
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130746,
					"content": "就像宵宮所說，雖然當時我沒下定決心，但我的行為，已經暴露了我的願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130747
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130747,
					"content": "但我覺得你做得很正確。而且你看，只要把這些話都說出來，心中的芥蒂是能化解的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130748
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130748,
					"content": "嗯，我現在也明白了，謝謝妳。沒想到妳這麼敏銳，能看穿我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130749
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130749,
					"content": "嘿嘿，因為我和你爸媽很熟啊，他們都是非常好的人，那你一定也是好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130750
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130750,
					"content": "早聽說長野原家後繼有人，雖然有點魯莽和吵鬧，但…名不虛傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130751
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130751,
					"content": "對了，那時候的煙花，「長野原煙花店」是可以重現的吧，能為我做一個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130752
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130752,
					"content": "不行喔，沒有那張紙條我是做不出來的，而紙條已經被朔次郎帶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130753
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130753,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130754
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130754,
					"content": "那就算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130755
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130755,
					"content": "嘿嘿，別這麼沮喪，我之前說了嘛，朔次郎回來就找我做了煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130756
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130756,
					"content": "雖然不能幫你做，但是現在朔次郎已經沒辦法放煙花了，為了不浪費，就破例讓你代替他放吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130757
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130757,
					"content": "…非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130758
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130758,
					"content": "嗯，可不要錯過煙花會開始的時間了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130759
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130759,
					"content": "這件事上，宵宮表現得很強硬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130760,
					"content": "因為我喜歡說話嘛！我相信，語言擁有強大的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130761
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130761,
					"content": "不願意溝通的話，問題就會永遠留在那裡。人們就看著，看著…直到眼睜睜地錯過所有解決它的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130762
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130762,
					"content": "雖然朔次郎和佳祐已經沒辦法回到從前了，但至少…我覺得不應在心中留下懊悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130763
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130763,
					"content": "#好了，跟我走吧，我帶{F#妳}{M#你}去個最適合看煙花會的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130764
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130764,
					"content": "#老爹會代替我，把答應送給{F#妳}{M#你}們的那個煙花，升上天空的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201308,
			"completionStepIds": [
				1201309
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201309",
							"2"
						],
						"stepId": 1201309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130801,
					"content": "啊，滿足滿足，這次的煙花會也好看得要哭出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130802
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130802,
					"content": "應該沒有真的哭出來吧？我感覺眼眶濕濕的就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130803,
						120130804
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130803,
					"content": "我也覺得非常漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				},
				{
					"id": 120130805,
					"content": "#對了，{F#妳}{M#你}看到第一枚升空的，那顆金色的大煙花了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130806
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130806,
					"content": "#那就是我拜託老爹為{F#妳}{M#你}們做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130807
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130807,
					"content": "喔喔，感覺很有氣勢，印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130808,
					"content": "#哈哈，那就對了，我希望{F#妳}{M#你}們看到那枚煙花後的感覺，就是印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130809
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130809,
					"content": "無論走了多遠、遇到了什麼，覺得動搖了、或者累了，至少還能想起今天的煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130810
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130810,
					"content": "#我相信在時間的沉澱之後，這枚煙花在{F#妳}{M#你}們心裡，會變得愈來愈漂亮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130811
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130811,
					"content": "#對了，這樣的話{F#妳}{M#你}們就是我的客人了。來，紙條也收好，想再看到這枚金色大煙花，就儘管來找我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130812,
						120130813
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130812,
					"content": "謝謝妳的煙花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130814,
					"content": "不過，在看煙花的時候，宵宮妳好像變了一個人，什麼也不說，也好像什麼都聽不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130815,
					"content": "那個嘛，其實我有聽到。只是看煙花的時候，我從來不說話，這是我的習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130816
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130816,
					"content": "自己做出來的東西，安靜地目送它升空，是一件有儀式感而又神聖的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130817
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130817,
					"content": "妳剛剛問我，對我來說煙花是什麼，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130818
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130818,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130819,
					"content": "對準備船的耕一來說，他和三姐好像是要紀念友誼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130820,
					"content": "對佳祐的爸爸媽媽來說，他們紀念的是婚姻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130821,
					"content": "而佳祐和朔次郎，他們要紀念的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130822,
					"content": "是不曾改變的信念吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130823
					]
				},
				{
					"id": 120130823,
					"content": "對對對，信念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130824,
					"content": "對我來說呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130825
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130825,
					"content": "嘿嘿，老實說，我從來沒想過，我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130826
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130826,
					"content": "欸？我還以為能聽到很震撼的答案呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120130827,
					"content": "因為其實沒什麼人會問我這個，我也不覺得這是件很了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130828
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130828,
					"content": "我只是碰巧生在長野原家，碰巧在老爹的教導下學了這門手藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130829
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130829,
					"content": "碰巧認識了很多人，聽說了很多事，知道他們都把心中珍視之物寄託在煙花裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130830
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130830,
					"content": "煙花一瞬間就消失了，那是和將軍想要的永恆距離最遠的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130831
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130831,
					"content": "但大家的寄託可不會消失，那才是煙花存在的理由。如果沒有人想看煙花，那就沒有煙花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130832
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130832,
					"content": "這也是一種永恆吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130833
					]
				},
				{
					"id": 120130833,
					"content": "但也要這麼想，正是因為有這麼多的人把思念寄託在煙花裡，長野原才必須存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130834
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130834,
					"content": "不然，不是辜負了他們的心意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130835
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130835,
					"content": "#{F#妳}{M#你}知道嗎，{NICKNAME}，雖然我不怎麼會去考慮複雜的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130836
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130836,
					"content": "但能生在長野原家，能做好多好多好多漂亮的煙花，我是非常自豪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130813,
					"content": "謝謝妳的祝福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130804,
					"content": "長野原果然名不虛傳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				}
			]
		},
