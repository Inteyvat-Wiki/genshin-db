					"義高"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130301,
					"content": "妳們竟敢妨礙公務，好大的膽子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130302
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130302,
					"content": "這種行為，天領奉行定會嚴懲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130303
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130303,
					"content": "#就算{F#妳}{M#你}們逃到天涯海角，也休想逃脫制裁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130304
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130304,
					"content": "說得這麼嚇人，跑得比誰都快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130305
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130305,
					"content": "沒時間耽誤在他們的身上了，我們繼續往裡面走吧，應該就在裡面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201305,
			"completionStepIds": [
