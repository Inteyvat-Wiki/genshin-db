			},
			"dialogs": [
				{
					"id": 120120901,
					"content": "#對不起啊，沒能幫上{F#妳}{M#你}們的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120902,
					"content": "不過，那個孩子，總要學會面對他的心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120903,
					"content": "這是作父母的沒辦法教他的東西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷香里"
				}
			]
		},
