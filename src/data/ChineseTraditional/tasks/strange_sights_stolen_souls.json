			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "上一回說到啊，岩王帝君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 111200302,
					"content": "找到你啦，鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200303,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200304,
					"content": "#{F#妳}{M#你}們興致不錯，也來這裡聽人說書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200305,
					"content": "不不，我們是來找你的，你現在有空嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200306,
					"content": "時間倒是有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200307,
					"content": "我們接到一份委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "這份工作需要了解地質與礦石的人喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200310,
					"content": "地質與礦石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200311,
					"content": "放眼整片大陸，難道會有比你更懂這些的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200312,
					"content": "那個委託人自稱找到了全天下最懂石頭的行家。我想向他證明，你才是提瓦特大陸上最了解這些的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200313,
					"content": "這無緣無故的攀比之心，是從何而來啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200314,
					"content": "不是攀比啦，是老戴沒眼光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200315,
					"content": "我就是…想讓他見識見識嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200316,
					"content": "#哈哈，既然如此，我便隨{F#妳}{M#你}們走一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200317,
					"content": "真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200318,
					"content": "話說在前頭，我雖有些見識，倒也未必是天下最精於此道的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200319,
					"content": "#學海無涯，長些見識總是好事。一來，我在{F#妳}{M#你}們也可以放心，二來，若真有專家，也好讓我切磋學習一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200320,
					"content": "唔…我覺得鍾離可以不用這麼謙虛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200321,
					"content": "既然鍾離答應了，那我們走吧，回去找老戴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200308,
					"content": "有一件特別的工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "老戴，我們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200402,
					"content": "#噢！這位就是{F#妳}{M#你}們的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200403,
					"content": "正是！我認為，這位先生才是天下最懂礦石與地質的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200404,
					"content": "過獎。略有心得罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200405,
					"content": "唉，妳要這麼說，我找的那位也絕對不輸他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200406,
					"content": "#我說不清，待會等他來了，{F#妳}{M#你}們自己感受吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200407,
					"content": "呃…是這嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200408,
					"content": "哎呀來得正好！給各位介紹一下，這是我找的幫手，昆鈞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200409,
					"content": "小昆啊，這兩位都是我找的冒險家，呃，至於這位先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200410,
					"content": "嗯…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200412,
					"content": "他叫鍾離，是往生堂的客卿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "往生堂客卿鍾離先生…我也有所耳聞，聽說你學富五車，才高八斗。沒想到，今天能見到本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200414,
					"content": "嗯？有些眼熟…唔，難道是在往生堂見過嗎？但我也沒去過往生堂啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200415,
					"content": "老戴，你不試試嗎？看他們誰才是真正的行家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200416,
					"content": "原來要當場比試啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "啊？這…我、我也不知從何比起啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200418,
					"content": "那你們自己想辦法比試一下，要是鍾離贏了，就請他幫忙，要是鍾離…不對，他怎麼會輸呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200419,
					"content": "比試？好啊好啊，我願意奉陪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200420,
					"content": "這位先生很有興致嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200421,
					"content": "啊哈哈，我看你的臉就覺得你肯定是行家。不過跟我比起來孰高孰低，還不好說呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200422,
					"content": "這個人口氣好大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200423,
					"content": "實話實說而已，哈哈哈…再說，我也只會這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200424,
					"content": "昆兄可是鑑定師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200425,
					"content": "不，其實…其實我也忘了我來璃月港幹嘛…有天站在路邊，突然被老戴叫住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200426,
					"content": "老戴見我拿著石頭，問了我幾句，跟著便激動萬分地約我來此地碰面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200427,
					"content": "啊？這也能忘記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200428,
					"content": "我來璃月港路上，遇見這人站在路邊把玩石頭，嘴裡還念念有詞，好像對那些石頭熟得不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200429,
					"content": "出於好奇我就問了幾句，誰知，他比我這個礦工頭子還懂！反正他也無所事事，不如來幫我的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200430,
					"content": "這傢伙，記性不好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200431,
					"content": "也不能說是記性不好…不過，只是石頭的話，我一定能幫上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200432,
					"content": "鍾離先生，你覺得這塊石頭如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200433,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200434,
					"content": "這塊石頭表殼光滑，表面的裂痕是由火山噴發所致。如果我沒猜錯，這是出自別國的石胚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200435,
					"content": "哦、哦！眼光真不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200436,
					"content": "這不是普通的石胚。殼薄，線黑…我猜，其中包著上好的水晶礦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200437,
					"content": "一點也沒錯，這塊石頭出自火山周圍，我一邊閒逛，一邊在市集買了這個。賣家當它是邊角料，卻不知其中奧妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200438,
					"content": "水晶礦不是哪裡都有嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "光是成色純淨質地高級，還不足以稱為珍寶。更高一等的罕見水晶，有些包著水膽，有些則藏著金沙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200441,
					"content": "這層石殼下藏著的水晶，在其形成瞬間包裹住了一團水。水藏於底，猶如山中滿月，映天而動，可說是相當稀有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200442,
					"content": "這麼詳細，簡直像是親眼看到的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200443,
					"content": "不會是糊弄我們的吧？畢竟，你這塊石頭還沒開呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200444,
					"content": "不，他說的都是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200445,
					"content": "水晶大多誕生於高溫環境，高溫與流水無法並存，水膽水晶因而珍貴。這塊晶體內藏著的卻是高山湖泊水，更為罕見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200446,
					"content": "連鍾離都這麼說…那應該是真的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200447,
					"content": "鍾離先生這種眼力，我還是第一次見！石殼下的模樣，你是怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200448,
					"content": "見得多了，自然有心得。小小賣弄，還請昆兄不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111200449,
					"content": "不不，怎麼會呢！我覺得我倆很是投緣，我是真心想要結交你這個朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200450,
					"content": "老戴，帶上鍾離先生一起吧！信我準沒錯，他絕對是個眼力過人的行家。這樣的人，你一輩子也遇不到幾個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111200451,
					"content": "也好，多一個人，多一份力量。各位，請跟我到層岩巨淵礦區走走，這次走丟的兄弟，還要靠你們找回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200439,
					"content": "為什麼這塊就是上好的呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
			"completionStepIds": [],
