			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "喂——你是老戴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200202,
					"content": "噢，找我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200203,
					"content": "#嗯？等等，{F#妳}{M#你}們就是協會派來的冒險家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200204,
					"content": "哇，看得出來嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200205,
					"content": "#看{F#妳}{M#你}們這副打扮和神情，應該是老手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200206,
					"content": "沒錯沒錯，你眼光真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200207,
					"content": "哈哈哈，幹咱們這行，少不了鑑定的活兒。看石頭也是看，看人也是看。一般人什麼底細，老戴我一眼就瞧出來囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200208,
					"content": "二位稍等，我找的幫手還在路上，一會就到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200209,
					"content": "等一下等一下，你不是已經找了我們嗎？不會還有其他人要來瓜分工錢吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200210,
					"content": "唉！實不相瞞，這次的事有些棘手。光是冒險家恐怕不夠，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200211,
					"content": "果然還有其他人，哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200212,
					"content": "大叔，你是不是小看我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200213,
					"content": "派蒙，別這麼說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "#{F#妳}{M#你}們有所不知，這次的事發生在礦區，而且有些離奇。礦區向來多事故，以防萬一，我才找了專業的高手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200216,
					"content": "冒險家的主業總不會是礦石鑑定、地質分析之類的吧？身邊帶個行家，凡事也好照應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200217,
					"content": "再說，我找的這位可是頂尖高手，無論什麼石頭，他只要看上一眼，就能說個八九不離十！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200218,
					"content": "要我說啊，世上最懂石頭的人，就得是他！遇見這等行家，還不趕緊請來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200219,
					"content": "不對不對，世上最懂石頭的人怎麼會被你找到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200220,
					"content": "怎麼不會啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200221,
					"content": "當然不會了，因為世上最懂石頭的人，是我們的朋友才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200222,
					"content": "該不會是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "（剛好，我也有些事想問他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "哼哼，天外有天，人外有人！你在這裡等著，我們馬上就帶他過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200214,
					"content": "派蒙，開始爭強好勝了呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
