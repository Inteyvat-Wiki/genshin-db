					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "凱瑟琳，我們來啦，有新委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200102,
					"content": "#是的，有份新工作，我認為{F#妳}{M#你}們可以勝任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 111200103,
					"content": "老戴是璃月港輝山廳的工頭之一，他希望冒險家協會能派幾個人手給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 111200104,
					"content": "具體是要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200105,
					"content": "聽說是要找幾個工人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 111200106,
					"content": "找人？太好了，是我們擅長的工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200107,
					"content": "是啊，旅行者的能力毋庸置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 111200108,
					"content": "#具體委託內容可以見面詳談。如果{F#妳}{M#你}們願意接下這份工作，就到碼頭附近找老戴聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
