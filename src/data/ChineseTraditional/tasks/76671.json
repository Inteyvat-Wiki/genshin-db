							9919.57
						],
						"pointId": 361100020
					},
					{
						"sceneId": 3,
						"position": [
							6050.061,
							231.727,
							9915.102
						],
						"pointId": 361100043
					},
					{
						"sceneId": 3,
						"position": [
							6051.46,
							231.727,
							9914.742
						],
						"pointId": 361100044
					}
				]
			},
			"dialogs": [
				{
					"id": 766710201,
					"content": "之前看到就很好奇了，為什麼執燈人的營地裡會有這種像是餐車一樣的小車呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710202,
					"content": "雖然要是能在上面做飯的話看起來是很方便啦，但感覺應該不會有這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710203,
						766710205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710203,
					"content": "或許可以做更複雜的料理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710204
					]
				},
				{
					"id": 766710204,
					"content": "那我可要嚐嚐啦…不對吧，我不是在說這種不簡單啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710207,
					"content": "它們嘛，正式一點的稱呼應該叫作「月廂車」，是我們執燈人用至冬的機關車改造而成的運輸工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710208
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710208,
					"content": "#{F#妳}{M#你}們可以把它們當作可移動的燈塔，同樣也是依靠月矩力的燃料驅動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710209
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710209,
					"content": "雖然移動的速度不是很快，但相比起在運輸物資上消耗寶貴的人力，有了它們的幫助也算替我們省了不少事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710210
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710210,
					"content": "至於派蒙說的料理嘛，之前我倒是沒有考慮過，但如果在裡面裝上烤麵包機的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710211,
						766710212
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710211,
					"content": "派蒙的話不用那麼當真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710213,
					"content": "不不，能及時填飽肚子對於執勤的執燈士來說也是很重要的，派蒙的話倒是提醒我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710214
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710214,
					"content": "如果我們能配置一輛專門的餐車的話，大家就不用再為了吃口熱飯而在野外壘石做灶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710215
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710215,
					"content": "對吧對吧！然後大家還可以用它來做各式各樣好吃的東西，一起在這裡開篝火晚會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710216,
					"content": "唔，不過營地裡的大家看起來都很忙的樣子，應該也沒有這種心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710217,
					"content": "其實我也希望有一天能夠放下心來，和大家坐在一起吃吃喝喝，想想就會覺得很幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710218
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710218,
					"content": "不過眼下還不是放鬆的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710219
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710219,
					"content": "果然是這樣啊…是因為狂獵的原因嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710220,
					"content": "#嗯，{F#妳}{M#你}們也看到了，最近狂獵的活動越來越頻繁，因此我們不得不加強戒備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710221
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710221,
					"content": "為此需要對據點進行整備，定時派出執燈士調查巡邏，保證來往的道路暢通無阻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710222
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710222,
					"content": "唔，光是聽你說，我就已經開始累了…執燈人的工作還真是辛苦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710223,
					"content": "這只是一些基礎的工作罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710224
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710224,
					"content": "像是更危險的——比如對付那些不知道會在何時何地出現的狂獵——這樣的職責都是老爺子，還有菲林斯、奧拉維他們在承擔著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710225
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710225,
					"content": "我想也不能事事都讓老爺子操心，就把這些最基礎的工作接過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710226
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710226,
					"content": "其實相比起籌備物資，眼下最棘手的還是人力的問題，實在是巧婦難為無米之炊啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710227
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710227,
					"content": "因為執燈人曾經的據點大多年久失修，沒辦法作為長久的棲身之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710228
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710228,
					"content": "現在大家只能不停地在野外的營地與總部之間疲於奔命，久而久之能作為戰力的人就更少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710229
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710229,
					"content": "有什麼解決的辦法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710230
					]
				},
				{
					"id": 766710230,
					"content": "想要解決的話，就必須把這裡改建成永久性據點。而作為執燈人的營壘，最重要的就是要有一座燈塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710231
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710231,
					"content": "意思就是說，你們要在這裡建一座燈塔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710232,
					"content": "沒錯，只有建起了燈塔，才能在狂獵襲擊時有所憑依。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710233
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710233,
					"content": "#不過說起來容易，實際上嘛…{F#妳}{M#你}們剛才也看到了，目前的進展並不是很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710234
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710234,
					"content": "對哦，我都快忘了我們是要來幫忙的了。所以到底是遇到什麼問題了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710235,
					"content": "是這樣的，為了建造營壘需要大量的燃料和物資，它們都是用月廂車從皮拉米達城源源不斷地運輸過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710236,
						766710237
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710236,
					"content": "就地取材不行嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710238,
					"content": "要是那麼簡單的話就好了。我們需要的不是普通的燃料，而是用月矩力精煉而成的特殊油料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710239
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710239,
					"content": "雖然附近植物裡的月矩力是很豐富，採集過來也不是不能勉強撐一會…但要用它們來供應燈塔的話，就完全是杯水車薪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710240
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710240,
					"content": "原本昨晚運送燃料與物資的運輸車就該到了，但直到現在都沒看到影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710241
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710241,
					"content": "負責運輸的瓦蒂什做事一向嚴謹，我想他應該不會大意到連時間都搞錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710242
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710242,
					"content": "因此我才擔心會不會是路上遇到了什麼麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710243,
						766710244
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710243,
					"content": "停停停，你別總往壞處想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710245,
					"content": "對啊，就算是被騙到鑽進了酒桶出不來，又或者是被人埋進土裡只剩下個腦袋，最後也總有辦法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710246,
					"content": "反正也不會比這些還糟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710247,
					"content": "#噗嗤，這些該不會都是{F#妳}{M#你}們在冒險途中遇到過的情況吧？看來我還是低估{F#妳}{M#你}們的實力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710248,
						766710249
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710248,
					"content": "其實還有更誇張的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710250,
					"content": "總之，我們先在附近找找看吧，說不定他只是迷路了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710251,
					"content": "#沒錯，{F#妳}{M#你}們說得對。事不宜遲，那就拜託{F#妳}{M#你}們和我一起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710252
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710252,
					"content": "嗯嗯，那是當然，我們現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710249,
					"content": "梅洛彼得堡也不是沒待過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710244,
					"content": "別急，這種事情我碰得多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710237,
					"content": "我看旁邊木材就滿多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710212,
					"content": "餐車的事情是開玩笑的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710205,
					"content": "或許可以變形成戰鬥機器人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710206
					]
				},
				{
					"id": 766710206,
					"content": "真的假的？難道說是那種，如果你說不喜歡它做的菜，它就會拿勺子攻擊你的料理機器人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "派蒙"
				}
			]
		},
