						],
						"pointId": 361100048
					}
				]
			},
			"dialogs": [
				{
					"id": 766710601,
					"content": "隊、隊長！太好了，終於有人來了——救命啊，隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710602
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710602,
					"content": "瓦蒂什，你怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710603
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710603,
					"content": "這就說來話長了…這些曼陀草製造的壁障從裡面根本解除不了，我已經快被困在裡面一天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710604
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710604,
					"content": "等一下，那就奇怪了。照理來說這裡不在皮拉米達城過來的大道上，也算不上是什麼捷徑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710605
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710605,
					"content": "至於這些曼陀草，它們通常不會主動攻擊路人，除非是有人入侵了它們的領地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710606
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710606,
					"content": "所以，你到底是怎麼被它們困在這裡的？要是不能給我一個合理的解釋，我就只能讓你在裡面多待一會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710607
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710607,
					"content": "哇，很少看到葉洛亞生氣的樣子，我都有點害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710608,
						766710609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710608,
					"content": "畢竟是隊長，需要有威嚴的一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				},
				{
					"id": 766710610,
					"content": "是哦，果然還是當冒險家比較輕鬆…幸好我們只是外部的隊員，不然也要被葉洛亞管教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710611,
					"content": "呃啊…好吧，事情的經過是這樣的…昨天夜裡，我在前往營地的路上被一大群曼陀草擋住了去路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710612
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710612,
					"content": "隊長你也知道我平常喜歡研究一些昆蟲啊、植物啊什麼的，這麼多曼陀草聚在一起，是很少見的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710613
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710613,
					"content": "我想著不能錯過研究的機會，就跟著它們一路來到了這裡，結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710614
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710614,
					"content": "非常抱歉！我會承擔起責任的，接下來一個星期的值夜就由我…不，一個月，這一個月的值夜就由我承擔了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710615,
						766710617
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710615,
					"content": "還是先救人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710616
					]
				},
				{
					"id": 766710616,
					"content": "#{F#妳}{M#你}說得對，違反紀律的事情就等回去再說，我們先想辦法把人弄出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710621,
					"content": "#{NICKNAME}，又得麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710622
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710622,
					"content": "嗚嗚，謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710617,
					"content": "反正物資已經拿到了，不如…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710618
					]
				},
				{
					"id": 766710618,
					"content": "欸，什麼意思？該不會是要丟下我不管吧？不要啊，求求你們了，我已經知道錯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710619
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710619,
					"content": "看他這麼可憐，我們還是先把他救出來吧。反正等回了營地，他也會接受應得的懲罰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710620,
					"content": "派蒙說得對，違反紀律的事情就等回去再說，我們先想辦法把人弄出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766710609,
					"content": "執燈人也有自己的紀律。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				}
			]
		},
