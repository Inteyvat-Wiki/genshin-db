					"nextDialogs": [
						20171007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20171007,
					"content": "哈哈哈，沒關係的，只是煙花啦，煙花而已。不會有什麼問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 20171008,
					"content": "那我們就去試試好了…謝謝妳啦，宵宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
