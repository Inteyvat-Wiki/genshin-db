				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托馬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}，{F#妳}{M#你}們怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170404,
					"content": "見到反抗軍了嗎？現在戰場情況如何？我能從這出去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170405,
					"content": "大概還不行…我們來的時候還看到附近有人在巡邏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170406,
					"content": "#看來還沒結束啊…這麼說來，{F#妳}{M#你}們出現在這裡，應該是有事要找我們商量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170407,
					"content": "我去找人叫小姐過來，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170408,
					"content": "將現狀告訴了綾華與托馬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170409,
					"content": "#原來如此，{F#妳}{M#你}們也經歷了許多事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170410,
					"content": "情況我已經瞭解了，總之是要找到天領奉行叛變的證據，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170411,
					"content": "這麼說來，確實有一點讓我很在意。幕府軍與反抗軍交戰已久，但將軍卻從未過問此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170412,
					"content": "我曾以為將軍對此事並不在意，但現在來看，或許是天領奉行給將軍的<color=#00E1FFFF>「上奏公文」</color>，從一開始就有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170413,
					"content": "綾華的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170414,
					"content": "天領奉行執掌國內軍事事務，如果他們有隱瞞不報的念頭，我們也無從得知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170415,
					"content": "其結果，是將軍錯估眼狩令的危害，繼續一意孤行。如果能拿到天領奉行的上奏公文，一看便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170416,
					"content": "可是我記得，有權力碰觸上奏公文的，只有九條孝行一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170417,
					"content": "而且那裡有重兵把守，就算有早柚幫忙，想悄悄拿走公文也是一件難事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170418,
					"content": "如果有什麼東西，能夠暫時引開那些守衛就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170419,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170420,
					"content": "要說吸引注意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "宵宮的煙花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170423,
					"content": "果然是托馬會提出來的建議呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170424,
					"content": "倒也不無道理。天領奉行旁邊就是千手百眼神像，如果能在神像周圍點燃煙花，天領奉行不會不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170425,
					"content": "到時早柚就可以順利潛入天領奉行，拿到公文和其他證據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170426,
					"content": "好！我感覺我離自由的日子愈來愈近了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170427,
					"content": "呼…像這樣坐在一起聊天，總感覺已經是好久之前的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170428,
					"content": "好像也沒有很久…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "#對我來說已經很久了，我每天都在這裡盼著{F#妳}{M#你}們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170430,
					"content": "以前這裡確實是我最喜歡的秘密場所，但這次進來之後，我已經不知道多久沒有邁出茶室一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170431,
					"content": "可惡，好想去泡溫泉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170432,
					"content": "托馬，好可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170433,
					"content": "我們還是先解決眼下的問題吧。廢除眼狩令之後，托馬就自由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170434,
					"content": "雖然是再度重逢，但沒有多少敘舊的時間呢。等一切結束，我們再好好慶祝一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170435,
					"content": "到時候我們再一起玩火鍋遊戲好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170436,
					"content": "你還惦記著那個啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170437,
					"content": "#天領奉行附近的守衛很多，{F#妳}{M#你}們靠近的時候務必小心。之後我們再在這裡碰面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170438,
					"content": "#那{NICKNAME}，我們就先去<color=#00E1FFFF>花見坂</color>找<color=#00E1FFFF>宵宮</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170421,
					"content": "好像之前也遇到過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
