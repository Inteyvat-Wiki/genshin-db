			"dialogs": [
				{
					"id": 20170701,
					"content": "嗯…和我想的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170702,
					"content": "好多好多人…被盯上的話…會被發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170703,
					"content": "必須將他們引開，才能順利潛入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170704,
					"content": "只能相信宵宮了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "等我拿到公文，我們再在<color=#00E1FFFF>木漏茶室</color>會合，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170706,
					"content": "還有，如果我被抓了的話…請來救我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170707,
					"content": "真的沒問題嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170708,
					"content": "總、總之我們還是先去<color=#00E1FFFF>千手百眼神像</color>那邊吧！要小心不要被巡邏的人發現喔！",
					"roleType": "TALK_ROLE_NPC",
