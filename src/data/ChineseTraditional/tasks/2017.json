			"trigger": {
				"objectNames": [
					"早柚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "狸、狸貓玩偶變成人類了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170202,
					"content": "這是什麼，我還是第一次見到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170203,
					"content": "不是狸貓…是貉…呼嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170204,
					"content": "好睏…睡不飽的話…會長不高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170205,
					"content": "難道說這位就是八重小姐所說的「專業人士」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170206,
					"content": "看起來完全不像呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170207,
					"content": "呵呵…這位可是「終末番」的成員，是貨真價實的「忍者」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170208,
					"content": "忍者！那剛剛的，難道就是傳說中的替身術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170209,
					"content": "不過，「終末番」又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170210,
					"content": "終末番隸屬於社奉行，是神里綾人的秘密部隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170211,
					"content": "目前神里綾人和社奉行持中立態度，我也無法調動終末番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170212,
					"content": "不過，抓一個常年偷懶的終末番成員過來幫忙，還是可以做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170213,
					"content": "咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170214,
					"content": "#就是這樣，就拜託{F#妳}{M#你}們進城，去尋找天領奉行叛變的證據了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170215,
					"content": "畢竟在那樣的場合，我不適合露面嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170216,
					"content": "就算妳這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170217,
					"content": "感覺沒什麼頭緒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "#欸？我還以為{F#妳}{M#你}已經想到了呢。好吧，那我就再給{F#妳}{M#你}一點點提示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170220,
					"content": "對外人來說，想要摸清楚天領奉行的底細確實很難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170221,
					"content": "但三奉行共同輔佐將軍，關係來往密切，想必其他奉行更容易察覺其中的蹊蹺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170222,
					"content": "社奉行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "#呵呵…看來{F#妳}{M#你}已經想到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170224,
					"content": "#幕府軍對{F#妳}{M#你}的搜捕，應該還沒有結束。不過有這位終末番的忍者相助，相信{F#妳}{M#你}可以順利與朋友再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170225,
					"content": "別忘了在約定的時間之前，把證據帶回來喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170218,
					"content": "證據到底是什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
