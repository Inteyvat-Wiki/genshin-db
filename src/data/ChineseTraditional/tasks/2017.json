			"dialogs": [
				{
					"id": 20170901,
					"content": "#怎麼樣{NICKNAME}，計畫還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170902,
					"content": "我也不知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "辛苦了，接下來就等早柚的消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170905,
					"content": "一段時間後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170906,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170907,
					"content": "雖然運動有助於長高，但好像有些運動過頭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170908,
					"content": "暈暈的…大家…都在旋轉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170909,
					"content": "不行，睡覺前，好像還有重要的事情…對了，我拿到了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170910,
					"content": "我也不知道你們說的「公文」到底長什麼樣子，就把所有可疑的東西都偷回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170911,
					"content": "給你們…我要去睡覺了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170912,
					"content": "小姐，這些是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170913,
					"content": "這一卷密封的，應該是天領奉行要呈給將軍的「上奏公文」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170914,
					"content": "除此之外，這是…他們與愚人眾來往的信件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170915,
					"content": "看來那位八重宮司的判斷是正確的。如今稻妻的紛爭，確實是他們推波助瀾的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}，這些當證據應該足夠了。接下來還請{F#妳}{M#你}將它們帶給<color=#00E1FFFF>八重宮司</color>，相信她會有接下來的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170917,
					"content": "我也會召集人手，爭取挖出更多潛伏在稻妻的愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170918,
					"content": "不過，還是要小心將軍大人，一想到她之前出刀的樣子，我就渾身雞皮疙瘩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20170919,
					"content": "也只能相信八重宮司了。她與將軍關係密切，或許會有辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170920,
					"content": "我記得，快到與八重神子約定的日期了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170921,
					"content": "我們還是快點收拾一下，準備趕往<color=#00E1FFFF>鳴神大社</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170903,
					"content": "點燃煙花就跑了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
