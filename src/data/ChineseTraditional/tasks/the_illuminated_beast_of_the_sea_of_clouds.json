						110300403
					]
				},
				{
					"id": 110300403,
					"content": "#沒錯，雖然沒有仙人的血脈，但{F#妳}{M#你}好像具備了許多仙人的資質呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300406
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300406,
					"content": "做完修行以後，甘雨還有什麼打算呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300407
					],
					"speakerTitle": "派蒙"
				},
				{
