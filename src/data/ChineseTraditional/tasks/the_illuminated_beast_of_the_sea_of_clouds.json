			"dialogs": [
				{
					"id": 110300601,
					"content": "您佈置的修煉我已經完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300602
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300602,
					"content": "無需向我報告，妳所想要的他人評價，無益於修煉本身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300603,
					"content": "修煉的結果，僅僅留給自身審視，會更容易使妳精進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300604
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300604,
					"content": "嗯…我記住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300605
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300605,
					"content": "魈總是有一套自己的見解呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300606,
						110300607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300606,
					"content": "要是委婉點就更好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300608
					]
				},
				{
					"id": 110300608,
					"content": "明日我會繼續提高修煉的難度，妳要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300609
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300610
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300610,
					"content": "要什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300611,
					"content": "呼…從那邊過來了，那個難對付的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300612
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300612,
					"content": "就先交給妳應付了，甘雨，這…嗯，這也是修行的一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300613,
					"content": "難對付的傢伙？居然能在這裡碰到讓魈皺眉頭的傢伙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300614,
					"content": "天…天呐！帝君在天之靈保佑，我終於訪到仙人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300615
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300615,
					"content": "敢問各位都是這山上的仙人嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300616
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300616,
					"content": "太好了，小民辛程，求各位仙人保佑戀愛、保佑財運、保佑仕途…拜託拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300617
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300617,
					"content": "原來是訪仙者呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300618,
						110300619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300618,
					"content": "好功利…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300621
					]
				},
				{
					"id": 110300621,
					"content": "我…應該也算仙人吧，也可以說是還在修行中的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300622
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300622,
					"content": "太好了！果真沒白來，雖然聽起來好像是個半吊子，嗯…也無所謂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300623
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300623,
					"content": "那您能保佑我什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300624
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300624,
					"content": "…哇，這人講話真是過分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300625,
					"content": "這位…訪仙人，我覺得您不該這般妄圖走捷徑，仙人也不是都要無償幫助每個訪仙者的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300626
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300626,
					"content": "無償？您這意思是，仙人保佑還要收費的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300627
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300627,
					"content": "啊，我不是這個意思，我只是想說凡事還是應當靠努力工作和認真生活來爭取…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300628,
					"content": "平白無故得到一切的話，對其他普通人是不公平的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300629
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300629,
					"content": "好了好了，這段話我來之前，也聽我爹爹嘮叨過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300630
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300630,
					"content": "因為您父親應該體會過，普通人辛勞卻幸福的一生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300631,
					"content": "像您這樣的年紀，還是應該把注意力集中在工作和家庭上，不要寄希望於虛無縹緲的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300632,
					"content": "您真的是仙人嗎…為什麼想法和說話方式都這麼像我們城裡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300633
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300633,
					"content": "該不會是那種冒充仙人傳道，其實是想騙錢的騙術吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300634,
						110300635
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300634,
					"content": "居然還懷疑起人家了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300638
					]
				},
				{
					"id": 110300638,
					"content": "唉，算了，不管仙人是真是假，看起來都沒什麼用了。下山吧下山吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300639
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300639,
					"content": "哼，你這種傢伙還是趕緊走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300640,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300641,
					"content": "甘雨小姐，不要因為這種無理的傢伙影響了心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300642,
					"content": "我…我不是因為他的態度，而是…他有些話說得確實有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300643,
					"content": "我以為回到絕雲間努力修行，就能找回仙人的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300644,
					"content": "可被他質疑了以後，我果然還是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300645,
						110300646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300645,
					"content": "那就回到璃月港吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
					"id": 110300647,
					"content": "可是…璃月港已經不歡迎我了，作為仙人，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300648,
						110300649
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300648,
					"content": "都說了是誤會！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300650,
					"content": "是呀！就相信旅行者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300651,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300652
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300652,
					"content": "那好吧，我再回璃月港繞繞。雖然這件事我還是堅持我原有的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300653
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300653,
					"content": "如果證明我的判斷沒錯，我便一定會再次回到絕雲間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300654,
					"content": "可算踏出一步了…那我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300649,
					"content": "相信作為人類的我一次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300646,
					"content": "還是人類的一面更適合妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
