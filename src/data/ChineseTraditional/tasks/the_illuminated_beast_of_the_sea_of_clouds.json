	"talks": [
		{
			"id": 1103001,
			"completionStepIds": [
				1103001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
