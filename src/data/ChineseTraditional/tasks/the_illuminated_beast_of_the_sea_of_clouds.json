			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百曉",
					"百識",
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300101,
					"content": "這工作量也實在太驚人了，我們明明有三個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300102
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300102,
					"content": "她一直都是怎麼過來的…「七星」的秘書果然不是一般人，這種挫敗感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300103
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300103,
					"content": "#欸，{F#妳}{M#你}們是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300104
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300104,
					"content": "#{F#妳}{M#你}們不是凝光的三個跟班嗎！怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300105,
					"content": "咳…是凝光小姐的私人秘書，不是跟班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300106
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300106,
					"content": "#請問{F#妳}{M#你}有見過甘雨小姐嗎？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300107
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300107,
					"content": "自從她前往絕雲間之後，已經有很多天沒回來了。她是輔助「璃月七星」這個整體的秘書，我們正在替她打理工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300108,
						110300109
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300108,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				},
				{
					"id": 110300110,
					"content": "唔，之前眾仙來璃月問罪，雖說事情已經談和，但「七星」還是希望能展現對仙人們敬重的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300111
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300111,
					"content": "於是派甘雨小姐作為使者，帶信函前往絕雲間，將最近璃月風波的處理情況交給仙人過目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300112
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300112,
					"content": "可是…理論上甘雨小姐應該已經回來繼續投入工作了，卻一直沒見她的蹤影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300113
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300113,
					"content": "這樣啊…可能甘雨小姐只是順路旅遊去了？工作久了也要放鬆一下心情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300114,
					"content": "這個恐怕不會的…自從我們認識甘雨小姐以來，說她是全璃月最勤奮的人也不為過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300115
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300115,
					"content": "就算是每年固定時間的休假，甘雨小姐也會以「還有很多事情要忙」為由，繼續留守月海亭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300116
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300116,
					"content": "這樣的她會藉出差的機會去偷懶…實在有些難以想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300117
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300117,
					"content": "原來是這樣呀…可是，她也有一半是仙人，應該不至於出什麼意外吧？妳們又為什麼一副特別著急的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300118,
					"content": "這個嘛…當然是因為，她那「不可理喻」的工作量了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300119
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300119,
					"content": "唉…原先得知要為甘雨小姐代班，而且是三個人一起，以為不過是換換工作環境罷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300120
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300120,
					"content": "嗯，可想不到，原來甘雨小姐一個人的日常工作，就遠遠超過我們三人可以處理的範疇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300121,
						110300122
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300121,
					"content": "仙人的血脈果然與常人不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300125
					]
				},
				{
					"id": 110300125,
					"content": "說到這，聽說旅行者您也可以自由出入絕雲間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300126
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300126,
					"content": "當然，我們去過很多次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300127,
					"content": "果然，太好了…請問您能不能代我們去絕雲間找找甘雨小姐呢？在我們倒在工作崗位上之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300128,
						110300129
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300128,
					"content": "好像確實只有我才行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300130,
					"content": "呼…得救了。還記得甘雨小姐說過準備先去留雲借風真君那裡，不妨您先去那邊找找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300131
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110300131,
					"content": "時間也差不多了，再不回去繼續工作的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300132
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300132,
					"content": "不，又或者，是不是應該先去跟凝光大人再提一提加班補貼的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百識"
				},
				{
					"id": 110300129,
					"content": "人命關天，好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300122,
					"content": "還是妳們再多加一點班？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300123
					]
				},
				{
					"id": 110300123,
					"content": "我們已經不知道連續工作多長時間了…像現在這樣出來小憩一下，都很有罪惡感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300124
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300124,
					"content": "那還真是，不得了，很緊急的情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300109,
					"content": "她為什麼會去絕雲間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				}
			]
		},
		{
			"id": 1103002,
			"completionStepIds": [
				1103003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103003",
							"2"
						],
						"stepId": 1103003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300201,
					"content": "甘雨小姐！妳原來在這！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300202,
					"content": "二位…真沒料到會在這裡相見。請問有公事還是私事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300203
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300203,
					"content": "啊…不對，如今我已脫離塵世，如果是商港事務的話，還請到月海亭去諮詢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300204,
						110300205
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300204,
					"content": "脫離塵世？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300206
					]
				},
				{
					"id": 110300206,
					"content": "欸，甘雨小姐難道不做「七星」的秘書了嗎？他們都還在等妳回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300207,
					"content": "#要我回去…原來這就是{F#妳}{M#你}們的來意嗎？不好意思，要讓兩位無功而返了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300208,
					"content": "怎麼會…莫非是發生什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300209,
					"content": "雲捲雲舒，潮起潮落，不過是歷史的選擇罷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300210
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300210,
					"content": "自上次仙眾將璃月港的「監督」之權交還給百姓之後，我便已經知道，離開璃月只是時間問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300211,
					"content": "擁有仙人血脈的我，在璃月港其實並沒有容身之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300212,
					"content": "此行送達信函之後，我曾回到璃月港，發現我的工作已被百聞、百曉、百識接替…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300213,
					"content": "想必這次送信的工作，也只是將我支開的藉口吧？既然「七星」給了我體面退場的機會，我也自然應該識趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300214,
						110300215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300214,
					"content": "我覺得…誤會大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300216
					]
				},
				{
					"id": 110300216,
					"content": "二位的好意，甘雨心領，不過無需再講這些安慰我的話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300217,
					"content": "能回到這千年未歸的絕雲間，看看山間的浮雲，我現在心境很平和，如此便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300218,
					"content": "唔，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300219,
					"content": "是誰在擾這山間清靜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300220
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300220,
					"content": "留雲借風真君？真不好意思，我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300221,
					"content": "#呵呵，玩笑話罷了，{F#妳}{M#你}們踏入此地之時我便早已覺察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300222
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300222,
					"content": "哇，不愧是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300223,
					"content": "#如何，{F#妳}{M#你}們是專程來找甘雨敘舊的吧？看{F#妳}{M#你}們相談甚歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300224,
						110300225
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300224,
					"content": "敘舊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300226
					]
				},
				{
					"id": 110300226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300227
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300227,
					"content": "啊…那看來有些話不投機嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300228
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300228,
					"content": "沒關係，找話題可是我擅長的事，畢竟千年來很多時候要自己和自己聊天，打發時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300229
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300229,
					"content": "#哦對了，既然是甘雨的朋友，那我跟{F#妳}{M#你}們講講甘雨這孩子小時候的故事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300230
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300230,
					"content": "喂，留雲真君！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300231
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300231,
					"content": "哈哈哈…這有什麼，妳小時候那麼可愛，妳的朋友們也肯定很想知道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300232,
						110300233
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300232,
					"content": "確實…有點興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300234
					]
				},
				{
					"id": 110300234,
					"content": "想聽想聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300235,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300236
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300236,
					"content": "呵呵…甘雨這孩子啊，從小最喜歡的事兒就是被摸摸頭上的角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300237
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300237,
					"content": "當時我照看她的時候，總是要我摸著角才能入睡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300238
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300238,
					"content": "唔哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300239,
					"content": "…甘雨那時候還胖胖的，胖到什麼程度呢？隨我上山的時候，只要稍一失足，就會咕嚕咕嚕滾到山腳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300240
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300240,
					"content": "噗…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300241,
					"content": "…有一天，甘雨撞上一個訪仙的人，那是她第一次見到活生生的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300242
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300242,
					"content": "想不到居然把她嚇得躲在石縫裡兩天兩夜，我找到她的時候，她一邊哭一邊和我說有怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300243
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300243,
					"content": "哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300244,
					"content": "留…雲…真…君！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300245
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300245,
					"content": "…呼，算了，差不多到了「修行」的時間了，我先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300246,
						110300247
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300246,
					"content": "甘雨好像有點生氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300248
					]
				},
				{
					"id": 110300248,
					"content": "#唔，我只是想緩解一下{F#妳}{M#你}們之前的尷尬而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300249
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300249,
					"content": "你成功地讓尷尬的程度翻了好幾倍呢，真是厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300250,
					"content": "是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300251
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300251,
					"content": "#說回甘雨的事，其實我很欣慰{F#妳}{M#你}們能來找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300252
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300252,
					"content": "我始終覺得，她這樣留在絕雲間，其實對她來說恐怕不是一件好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300253
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300253,
					"content": "#就讓我稍微跟{F#妳}{M#你}們講講，有關她的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300254
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300254,
					"content": "…我偶然聽到的甘雨心聲，就是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300255
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300255,
					"content": "#內心的困境如果只靠她自己一人，是很難走得出的。所以，希望{F#妳}{M#你}們可以暫時陪陪她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300256
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300256,
					"content": "唔，真君說得對，讓甘雨繼續這樣消沉下去的話，也不是辦法。而且，被璃月拋棄本來也是她的誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300257,
					"content": "話說，剛才甘雨說的「去修行」是指什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300258,
					"content": "她回絕雲間以後，一直想要找回身為仙人的感覺，所以提出要我幫她安排仙人的修行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300259
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300259,
					"content": "現在她應該在奧藏山南邊，準備修行的內容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300260
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300260,
					"content": "原來如此，那我們過去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300247,
					"content": "您講話好像有點不看氣氛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300248
					]
				},
				{
					"id": 110300233,
					"content": "很不錯的話題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300234
					]
				},
				{
					"id": 110300225,
					"content": "相談甚歡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300226
					]
				},
				{
					"id": 110300215,
					"content": "沒有人打算排擠妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300216
					]
				},
				{
					"id": 110300205,
					"content": "感覺氣場和以前不一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300206
					]
				}
			]
