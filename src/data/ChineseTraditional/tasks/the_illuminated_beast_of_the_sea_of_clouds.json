			"dialogs": [
				{
					"id": 110300501,
					"content": "遲了四分之一個時辰…妳還是甩不開那些人類的陋習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300502,
					"content": "不好意思，剛才在留雲真君那邊，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300503
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300503,
					"content": "不必向我解釋什麼，也無需相互諒解，我只是受託幫助妳修行而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300504
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300504,
					"content": "當老師的魈…也太嚴格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300505,
					"content": "妳既非仙人，亦非人類，以此身分漫步塵世邊緣，難免產生許多困惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300506
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300506,
					"content": "所以，比起向我解釋，還是先直面妳自己的內心比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300507,
					"content": "我…沒有遮掩什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300508,
						110300509
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300508,
					"content": "其實魈…好像很理解甘雨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300510
					]
				},
				{
					"id": 110300510,
					"content": "軀殼與神魂是統一的，神魂如果遇上困境，從軀殼尋求突破也是一種選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300511,
					"content": "我給妳安排的修行，會試著探索妳軀殼的潛能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300512,
					"content": "嗯，我做好準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300509,
					"content": "其實魈…可能是個好老師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300510
					]
				}
			]
		},
