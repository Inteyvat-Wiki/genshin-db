			"dialogs": [
				{
					"id": 100090601,
					"content": "材料也全都準備好了，煉製用的煉金釜就在那邊…隨時可以開始，嗯…不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090602,
					"content": "還有什麼困難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100090603,
					"content": "#不不，只是…為了能夠精確記錄，所以能讓我觀看{F#妳}{M#你}們煉製的過程嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 100090604,
					"content": "其實有很多人做實驗的時候不喜歡被看著…我就…",
