			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"冒失的帕拉德",
					"喬爾",
					"喬瑟夫",
					"賽琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "咦？這個人是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030102,
					"content": "難道是喬爾的父親？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "#喔！{F#妳}{M#你}來了啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030105,
					"content": "我介紹一下，這位就是喬爾的父親，喬瑟夫先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030106,
					"content": "爸爸！這位就是我和你說的旅行者，之前幫過我好多好多忙，這次還陪我一起堆雪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708030107,
					"content": "#喬爾都和我說了，哎呀，真是太感謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030108,
					"content": "團圓就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "是啊，這真是天大的好事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030111,
					"content": "帕拉德，這次你算是立了一個大功，幹得不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708030112,
					"content": "又？帕拉德又做什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030113,
					"content": "你們還記得，我之前說在雪山裡看見了一個人影吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030114,
					"content": "那天你們陪我進了雪山，又幫我打倒了那些魔物之後，我又開始在周圍搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030115,
					"content": "在搜索的時候，我一個不小心從山上滾了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030116,
					"content": "滾、滾了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030117,
					"content": "還好下面的雪層很厚，我沒有受傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030118,
					"content": "正當我準備找回去的路時，突然聽見旁邊有響動，一個人突然鑽了出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030119,
					"content": "我當時沒有意識到他就是我要找的人，還以為是和我一樣進山搜救的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030120,
					"content": "但聊了幾句才發現，好多事情他都記不得了，連自己的名字都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030121,
					"content": "當時我來不及多想，雪山上太冷了，我趕緊催他跟我一起翻山回營地，有什麼事等回來再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030122,
					"content": "回到營地，我們見到了喬爾，喬爾一見到他就愣住了，跟著大叫起來：「爸爸！」他就是在這個時候突然回憶起一些事情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030123,
					"content": "爸爸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708030124,
					"content": "喬爾，爸爸在，爸爸在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030125,
					"content": "喬瑟夫先生，真的想不起其他事情了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030126,
					"content": "《野豬公主》、還有雪山上你餵過的狐狸們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030127,
					"content": "很抱歉，我沒有印象了。或許是因為腦袋受了外傷？我也不清楚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030128,
					"content": "當我醒來的時候，身上全是血。就連行李也丟了，沒有能夠證明身分的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030129,
					"content": "我只能爬進一個山洞，安頓下來慢慢養傷，在腿腳復原點之後，靠打獵的本能才活了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030130,
					"content": "爸爸…我真的好擔心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708030131,
					"content": "沒事沒事，喬爾不哭，爸爸這次哪裡也不去了，就陪在你身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030132,
					"content": "喬瑟夫先生，那你接下來準備怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030133,
					"content": "我…現在只想再和我的家人們多待一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 708030134,
					"content": "能回來就好。這件事也算是有了個完美的結局了，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708030135,
					"content": "不過，帕拉德，在搜索的過程中居然會失足滾下山去，你的冒險能力還需要再加強啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708030136,
					"content": "回去協會，我得好好再幫你補課了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708030137,
					"content": "欸？賽、賽琉斯會長…我不是都立功了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030138,
					"content": "走了！回協會去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708030139,
					"content": "會長！你就饒了我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030109,
					"content": "沒事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "大號的喬爾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}