			},
			"dialogs": [
				{
					"id": 402050401,
					"content": "最後一架，一定就在上面了！啊，往那邊逃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050402,
					"content": "看我的！不准跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050403
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050403,
					"content": "愛諾，危險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050404,
					"content": "可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050405
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050405,
					"content": "愛諾——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050406,
					"content": "#唔…{NICKNAME}？對了，那架偵察單元…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050407
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050407,
					"content": "妳沒事才最重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050408
					]
				},
				{
					"id": 402050408,
					"content": "呼…真是太危險了，妳這樣也很亂來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050409,
					"content": "#沒事就好…身手不錯嘛，{NICKNAME}，我還以為必須要我出手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050410
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050410,
					"content": "（幸虧沒出事，不然的話，我真的想不到該怎麼跟伊涅芙交代啊…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050411
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050411,
					"content": "根本不是沒事！鐺鐺七分甜還是被搶走了…我是叮鈴哐啷蛋捲工坊的老大，我不能在這時候哭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050412
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050412,
					"content": "請容我代替族人向妳致歉，如果沒有他們的阻攔，或許妳的夥伴就不會被劫走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050413
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050413,
					"content": "詠月使大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050414
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050414,
					"content": "如果她真的將那種機械造物視為牟利的手段，大可以重新製作，又何必展示這種足以讓你們羞愧的勇氣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050415
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050415,
					"content": "即便是滿月的光華，也無法在她的心緒上映出瑕疵，而你們那顆苛求的心，卻已經要沒入月華所無法觸及的陰影之中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050416
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050416,
					"content": "…請也接受我的道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050417
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050417,
					"content": "誤會解開了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050418,
					"content": "所以，請不要悲傷。「心緒無瑕之人，總能得到月光的指引。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050419
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050419,
					"content": "妳一定能找回同伴，有需要的話，我也願意安排族人向妳提供幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050420
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050420,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050421
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050421,
					"content": "但是話說回來，接下來該去哪裡找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050422,
					"content": "結論很明顯，動手的是那個非法黑市的商人，恐怕對方早就料到愛諾和霜月之子之間會發生衝突，就鑽了這個空子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050423
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050423,
					"content": "更確切一點來說，最初把鐺鐺七分甜偷走的人可能也是他安排的，所以他早就知道鐺鐺七分甜在這裡，能提前布局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050424
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050424,
					"content": "目前來看，嫌疑最大的絕對是那個阿斯科，不過，好像也不能完全排除其他商人的嫌疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050425
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050425,
					"content": "的確如此…看來雅珂達一定知道去哪裡查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050426,
					"content": "（又要我來？剛剛說過了，那裡的商人都有嫌疑，黑市一散，誰知道都能跑到什麼地方去？唉…剛剛不該賣弄的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050427
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050427,
					"content": "雅珂達一定也見不得愛諾這麼傷心，接下來也要仰仗妳了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050428,
					"content": "雅珂達，仰仗妳了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050429
					]
				},
				{
					"id": 402050429,
					"content": "（…這讓我怎麼拒絕啊？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050430
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050430,
					"content": "好吧，至少…至少先給我兩天時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050431
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050431,
					"content": "再等兩天，看來也是沒辦法的事呢。愛諾，現在有這麼多人幫忙，不用擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050432,
					"content": "我知道的…謝謝大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				}
			]
		},
