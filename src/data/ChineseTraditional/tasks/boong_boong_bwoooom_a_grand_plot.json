			"dialogs": [
				{
					"id": 402050101,
					"content": "妳好啊，菈烏瑪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050102,
					"content": "#{NICKNAME}和派蒙？願月光聯繫著{F#妳}{M#你}我，不論日夜。嗯…心中煩擾，不妨直言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050103
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050103,
					"content": "妳又看出來啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050104,
					"content": "沐浴著月光的愁容正如滿月的暗斑，於陰晴之間流露心緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050105
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050105,
					"content": "讓她先別說話，果然鬧脾氣了…詠月使大人，請先聽我講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050106
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050106,
					"content": "#雅珂達仔細講述了{F#妳}{M#你}們來這裡的原因，她的措辭很小心。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050107
					]
				},
				{
					"id": 402050107,
					"content": "…偷盜？此舉卑劣，當為霜月之子所不齒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050108,
					"content": "目前都還只是猜測…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050109
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050109,
					"content": "請稍等片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050110
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050110,
					"content": "前幾日，的確有一些族人帶回了某種機械造物，請隨我前去與他們當面對質，個中是非，自可辨明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				}
			]
		},
