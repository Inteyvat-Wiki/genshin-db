			"dialogs": [
				{
					"id": 402050201,
					"content": "請…請冷靜點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050202
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050202,
					"content": "愛諾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050203,
						402050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050203,
					"content": "不能再胡鬧了，愛諾！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050204
					]
				},
				{
					"id": 402050204,
					"content": "可是，他們說要銷毀鐺鐺七分甜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050205
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050205,
					"content": "我們當然不會讓這件事發生，但胡來是解決不了問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050209,
					"content": "不好了，一大批飛行機械偷襲了我們儲存物資的地方，那臺機械造物被搶走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050210
					],
					"speakerTitle": "赫莉米"
				},
				{
					"id": 402050210,
					"content": "這個時候？難道是看準了我們和這個女孩起衝突的時機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050211
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050211,
					"content": "哇，好多偵察單元！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050212,
					"content": "一定是那些黑市商人安排的，我們果然還被盯著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050213
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050213,
					"content": "#{NICKNAME}，我可以直接在這裡搭建一段臨時的月靈旅路，麻煩{F#妳}{M#你}請月靈來幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050214
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050214,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050215
					]
				},
				{
					"id": 402050215,
					"content": "對啊，把它們打下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050206,
					"content": "我不會讓愛諾的夥伴出事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050207
					]
				},
				{
					"id": 402050207,
					"content": "嗯，還請相信我們，先冷靜一下，這樣胡來是絕對不行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050208,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "愛諾"
				}
			]
		},
