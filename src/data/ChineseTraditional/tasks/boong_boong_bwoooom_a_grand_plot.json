				]
			},
			"dialogs": [
				{
					"id": 402050701,
					"content": "願月光聯繫著妳我，詠月使大人，請問您找我們有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050702
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050702,
					"content": "#菈烏瑪轉述了{F#妳}{M#你}們來到這裡的原因。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050703
					]
				},
				{
					"id": 402050703,
					"content": "偷盜？我們怎麼會做這種事？這是憑空汙衊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050704
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050704,
					"content": "我們的確帶回了一種危險的機械造物，但它並非是我們偷來的，而是從一夥匪徒手裡搶到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050705
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050705,
					"content": "若有誤會，那就向客人們澄清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050706
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050706,
					"content": "我記得那是幾天前，在附近的野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050707
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050707,
					"content": "嗯？那些人在幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050708
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050708,
					"content": "還沒好嗎？我們得在被那幫原住民發現之前完成測試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050709
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050709,
					"content": "就不能去其他地方嗎？這件工作幹得提心吊膽的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050710
					],
					"speakerTitle": "冒失的盜寶團成員"
				},
				{
					"id": 402050710,
					"content": "蠢貨，沒聽雇主說嗎？這玩意對月矩力有特殊的需求，要不然也不用跑到這個地方來。閉上嘴，把握時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050711
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050711,
					"content": "別喊，讓我想想，應該是這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050712
					],
					"speakerTitle": "冒失的盜寶團成員"
				},
				{
					"id": 402050712,
					"content": "什麼！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050713
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050713,
					"content": "你幹了什麼？這動靜不被人注意到才怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050714
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050714,
					"content": "這…至少我們驗證了這玩意的威力，不是嗎？一定可以回去交差了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050715
					],
					"speakerTitle": "冒失的盜寶團成員"
				},
				{
					"id": 402050715,
					"content": "唉，算是吧，那就收拾東西趕快撤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050716
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050716,
					"content": "站住！放下你們持有的危險物品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050717
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050717,
					"content": "這麼快？這玩意還能再啟動一次嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050718
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050718,
					"content": "剛剛的操作我也記不得了…這我可搬不動啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050719
					],
					"speakerTitle": "冒失的盜寶團成員"
				},
				{
					"id": 402050719,
					"content": "唉…快跑吧，最重要的是我們不能被當場逮到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050720
					],
					"speakerTitle": "急躁的盜寶團成員"
				},
				{
					"id": 402050720,
					"content": "就是這樣，我們沒能抓到人，但是我們截獲了他們手中的那種機械造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050721
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050721,
					"content": "愛諾，我再確認一下，妳不會又造出了什麼危險的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050722
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050722,
					"content": "或許這是另一個誤會？阿索看到的那種機械造物不一定就是鐺鐺七分甜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050723,
					"content": "嗯…那種機械造物上面有沒有這個標誌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050724
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050724,
					"content": "嗯，有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050725
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050725,
					"content": "這是我為夥伴特別設計的標誌，每次加標誌的時候都會特殊處理一下，就算拆卸改裝也絕對抹不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050726
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050726,
					"content": "所以，那的確是鐺鐺七分甜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050727
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050727,
					"content": "既然誤會已經澄清，就物歸原主吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050728
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 402050728,
					"content": "恕我直言，詠月使大人，我認為不能如此草率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050729
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050729,
					"content": "那種機械造物和那夏鎮的大炮在原理上十分相似，但我們不能對它們一視同仁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050730
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050730,
					"content": "那夏鎮的大炮利用月矩力一次次地擊退了「狂獵」，守護了這片土地，我一直將其視為一種月神賜予的庇佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050731
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050731,
					"content": "然而那種機械造物…它更像是一種商品，很容易就會被惡徒掌控，用於滿足他們的私慾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050732
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050732,
					"content": "據我所知，這位工坊的主人經常與挪德卡萊的各大勢力進行交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050733
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050733,
					"content": "我懷疑她製作這種機械造物正是為了向他人出售，一旦讓它流入黑市，繼而被濫用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050734
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050734,
					"content": "鐺鐺七分甜是我的夥伴，它不是用來買賣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050735
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050735,
					"content": "…這只是妳的一面之詞，我們可不能冒險。一旦讓心懷不軌的人拿到這種造物，聖潔的月光必將遭到褻瀆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050736
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050736,
					"content": "（我就說過，事情會變得很難辦，這次趟進渾水了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050737
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050737,
					"content": "在我看來，最好的處理方法還是銷毀這種危險的造物，並防止類似的造物再次出現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050738
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050738,
					"content": "你說什麼？你們想銷毀鐺鐺七分甜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050739
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050739,
					"content": "還請理解我們的苦衷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050740
					],
					"speakerTitle": "阿索"
				},
				{
					"id": 402050740,
					"content": "你們都是壞蛋！給我讓開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				}
			]
		},
