			"dialogs": [
				{
					"id": 402050301,
					"content": "妳好啊，雅珂達。哇，那裡果然來了好多人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050302,
					"content": "可不要小看了我的情報網。這樣吧，我們先查一查這裡的交易紀錄，那個小偷有可能在這裡脫手他偷到的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050303
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050303,
					"content": "喂！是哪個壞蛋偷走了我的機器人夥伴？站出來，好好交代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050304
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050304,
					"content": "（不是這樣查的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050305
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050306
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050306,
					"content": "這位莫非就是那個工坊的主人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050307
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050307,
					"content": "來得正好，更方便談生意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050308
					],
					"speakerTitle": "急切的商人"
				},
				{
					"id": 402050308,
					"content": "你們…你們誰是那個小偷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050309
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050309,
					"content": "什麼小偷？這裡只有生意人。我想訂製一種機械，價錢都好說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050310
					],
					"speakerTitle": "好奇的商人"
				},
				{
					"id": 402050310,
					"content": "那個機器人女僕是妳造出來的吧？這種技術賣不賣？我也想擁有一個機器人女僕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050311
					],
					"speakerTitle": "急切的商人"
				},
				{
					"id": 402050311,
					"content": "你們…都閃開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050312
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050312,
					"content": "咳咳！連最基本的規矩都不懂，怪不得淪落到在這種非法黑市裡做生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050313
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050313,
					"content": "就算工坊的主人願意和你們做交易，也得透過這裡的櫃檯來談，明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050314
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050314,
					"content": "愛諾這傢伙的機械造物放眼整個挪德卡萊都是搶手貨，也不能怪這幫商人如此熱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050315
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050315,
					"content": "無論是伊涅芙還是鐺鐺七分甜，都不是用來買賣的，這裡的大人都讓我很討厭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050316
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050316,
					"content": "#不過，{NICKNAME}說得對，這裡的大人就算做賊也不會心虛，我的方法行不通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050317
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402050317,
					"content": "妳真的想用那種方法把小偷揪出來啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402050318,
					"content": "沒見過世面吧？這裡的商人眼裡只有錢，而道德在他們眼裡不值錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050319
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402050319,
					"content": "線索還是得從櫃檯那邊找，跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
