			"dialogs": [
				{
					"id": 221070901,
					"content": "怎麼樣，你們找到什麼徵兆了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210710",
							"2"
						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "我看見屋上有鳥成雙對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "嗯…嗯！好，這個好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071003,
					"content": "兩隻相愛的鴿子遠離族群，眼中只有彼此，只願和對方比翼天涯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071004,
					"content": "這個徵兆是在暗示…我一定會遇見那位只認定我一人的愛人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071005,
					"content": "然後與她克服艱難險阻，脫離紛擾的人群，一起比翼天涯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071006,
					"content": "咳！那個，辛苦你們了…我得找個時間，再去問問綺命姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
