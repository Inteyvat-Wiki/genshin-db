			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "關於落葉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "嗯…這個和愛情，應該沒什麼關係吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221071203,
					"content": "落葉？當然有關係了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071204,
					"content": "這些落葉，雖然看似凋零無用，但是只要有一點契機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071205,
					"content": "有一點星火，它們就會熱烈燃燒，有一縷微風，它們就會翩然而起。",
