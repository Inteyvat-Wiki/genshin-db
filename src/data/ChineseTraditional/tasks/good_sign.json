			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "我看見有店主今天生意興隆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "嗯，生意興隆，財源廣進？這個不錯，這個不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071103,
					"content": "只要耐心守候，用心經營，必然會有所收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071104,
					"content": "這個徵兆一定是在告訴我，無論是人生還是愛情，都是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071105,
					"content": "咳！咳咳…那個，太感謝你們了，我得好好想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071106,
					"content": "綺命姐！總有一天我會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
		{
