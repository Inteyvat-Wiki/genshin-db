			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "「愛情這種東西，遠在天邊，近在眼前。不需強求，總有一天會自己送到你眼前…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070102,
					"content": "你在說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "當然是在說我的愛情運勢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070104,
					"content": "這句話，可是綺命姐為我指點的愛情運勢，遠在天邊，近在眼前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070105,
					"content": "她一定是在暗示我什麼，但是到底在暗示什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070106,
					"content": "我聽說書的人說，當人的「運勢」到來時，身邊的各種事物都會顯出徵兆來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070107,
					"content": "我覺得我的「愛情運」已經到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070108,
					"content": "#{F#妳}{M#你}能幫我去周圍看看，有什麼特別的「徵兆」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "#那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				},
				{
					"id": 221070110,
					"content": "你為什麼不自己去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "所謂「當局者迷，旁觀者清」，要是我自己去看的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070113,
					"content": "無論看見什麼，我都會覺得是在暗示我的「愛情運」到來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070114,
					"content": "#所以，一切都拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
