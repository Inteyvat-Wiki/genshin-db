					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "#什麼意思？{F#妳}{M#你}把那條魚給帶來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071809,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}不會是直接下去，把它給抓上來了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071810,
					"content": "這種超越物種的友誼！不是應該去用心保護嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071811,
					"content": "#而且好不容易找到這麼好的徵兆，{F#妳}{M#你}，{F#妳}{M#你}究竟做了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071812,
					"content": "#算了，麻煩{F#妳}{M#你}讓我一個人待一會，我想靜一靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
