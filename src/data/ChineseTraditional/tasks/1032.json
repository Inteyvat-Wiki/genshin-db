				{
					"id": 10293201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293202
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293202,
					"content": "妳還好嗎？突然變得那麼沉默，真不像妳平時的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10293203,
					"content": "噓，晚點說話，我在整理到目前為止的所有線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293204,
					"content": "突破口說不定就藏在某個被我忽略了的細節裡，必須全部盤點一遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293205,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10293206,
					"content": "啊，放心，妳說的那些事情我是不會記錄在紙上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293207,
					"content": "不。我是說，要分析的話，也算我一個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
