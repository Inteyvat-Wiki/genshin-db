			"dialogs": [
				{
					"id": 740870201,
					"content": "研究員平常就在這種地方休息嗎？這合乎人道嗎？楓丹科學院有考慮過優先修繕此處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870202
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870202,
					"content": "…這裡應該有一枚「勘測樁錨」。正如克洛妮艾小姐暗示的，此處亟待修繕，儲能裝置的數量十分有限——或者說短缺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870203
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870203,
					"content": "#在我為克洛妮艾小姐解惑的期間，回收「勘測樁錨」的工作就拜託{NICKNAME}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納克"
				}
			]
		},
		{
			"id": 7408703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7408702",
							"3"
						],
						"stepId": 7408702,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納克",
					"克洛妮艾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "「宿舍」相對其他區域，可以說是沒有被爆炸影響太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870302,
					"content": "宿舍？但這裡連一張床都沒有，研究員要怎麼休息？他們總不可能坐在椅子上睡覺吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870303,
					"content": "克洛妮艾小姐，妳所理解的「休息」和研究員們所需的「休息」不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870304,
					"content": "當一個楓丹科學院的研究員說自己需要休息時，他實際上只是想讓自己的頭腦稍微停下來一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870305,
					"content": "然後，他一般就會來到這裡彈彈琴、看看閒書，有必要的話再喝兩杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870306,
					"content": "呃…但在我看來，直接睡一覺不是更能讓頭腦得到休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870307,
					"content": "這話說得沒錯。但…對於我們研究員來說，睡覺首先太過浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870308,
					"content": "睡覺也算是浪費時間嗎？這是必要的休息呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870309,
					"content": "睡覺會完全打斷我們的研究思緒，這對研究工作來說實在太不可接受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870310,
					"content": "（繼續聽下去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "你是認真的嗎？不睡覺的話，被打斷的就是生命了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870313,
					"content": "那可不會，之前院裡有著優秀的醫療保障，要保證研究員的健康不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870314,
					"content": "這也不是不睡覺的理由吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870315,
					"content": "而且…那些研究員來這裡不就是暫時讓頭腦休息嗎？研究思緒本來就是中斷著的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870316,
					"content": "那可不會，說是讓頭腦暫時停下來，但實際上他們還是本能地在思考著學術問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870317,
					"content": "就像是在一片廣闊的大海上，雖然表面上波濤暫歇，但實際上在深處依然有暗流湧動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870318,
					"content": "有時候，這種暗流所蘊含的力量，會比表面上的波濤更巨大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870319,
					"content": "我理解了，您的意思就是，如果楓丹科學院的研究員正在研究，那他們就只能一直研究，不得休息，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870320,
					"content": "這個說法不客觀，如果真的需要睡覺的話，他們大可以回去自己家裡睡覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "納克"
				},
				{
					"id": 740870321,
					"content": "那就是楓丹科學院的研究員如果處於楓丹科學院內，就只能一直研究，不得休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740870322,
					"content": "您的修辭學能力真是讓我讚嘆不已，克洛妮艾小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納克"
				},
				{
					"id": 740870311,
					"content": "（還是不要聽了吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}