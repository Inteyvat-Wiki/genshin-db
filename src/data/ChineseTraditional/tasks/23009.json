			"dialogs": [
				{
					"id": 230090201,
					"content": "還得再去買些材料回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090202,
					"content": "你的「凝成泥土」怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "非常好！不如說，這種泥土的應用範圍簡直超乎我的想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090204,
					"content": "它可以用來做瓶瓶罐罐，也能修補房屋的漏洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090205,
					"content": "只要調整一下各種泥土的混合比例，直接用來搭建房屋也沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090206,
					"content": "不過…因為大家都來找我訂購這種泥土，我的材料又不夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090207,
					"content": "#而且最關鍵的史萊姆凝液也用光了。旅行者，能請{F#妳}{M#你}再去幫我拿三份史萊姆凝液回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090208,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#拜託{F#妳}{M#你}了，旅行者，請{F#妳}{M#你}幫我拿三份史萊姆凝液回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090209,
					"content": "其他材料呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "其他的材料我都已經從各種管道訂購，或者託人去找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090211,
					"content": "但史萊姆凝液消耗得實在太快，出乎我的預料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "阿金"
				}
			]
		},
