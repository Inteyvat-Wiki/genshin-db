			},
			"dialogs": [
				{
					"id": 230091101,
					"content": "#旅行者！{F#妳}{M#你}來得正好，我正在發愁沒有人幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091102,
					"content": "你的研究有進展了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "呃…也談不上「進展」，只不過是有一位顧客給我提出了意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091104,
					"content": "他說自己經常養花，最煩惱的事就是尋找合適的花土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091114,
					"content": "既要有透氣性，營養又要好；不能太吸水，也不能太容易排水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091105,
					"content": "他看到了我的「凝成泥土」有這麼多改進方案，就想要拜託我設計出一種專門養花用的「凝成花土」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091106,
					"content": "我覺得這是一個很有趣的方向，所以我正在尋找別的材料，來改進我的「凝成泥土」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091107,
					"content": "#這一次，我想要拜託{F#妳}{M#你}幫我去挖一些肥沃的泥土回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091108,
					"content": "#我把那種泥土的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091109,
					"content": "怎麼這麼遠啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "這地方是我找人打聽來的，雖然有點遠，但據說那邊的泥土非常肥沃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091112,
					"content": "不過…呃…那邊好像也有很多魔物，我自己可不敢去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091113,
					"content": "#所以，我只能拜託{F#妳}{M#你}了！旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091110,
					"content": "這地方你是怎麼找到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
