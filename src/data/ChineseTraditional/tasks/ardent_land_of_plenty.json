					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "我們終於到了，這裡就是「沃陸之邦」的部族營地，也就是我的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180814,
					"content": "哇啊，好壯觀，那個牛頭形狀的高臺真氣派，我很喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180802,
					"content": "嘿嘿，那個叫「逐響擂臺」，是我們舉辦各種比賽的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180803,
					"content": "謝謝妳帶我們來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "不客氣不客氣，小事一樁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180815,
					"content": "#我很想帶{F#妳}{M#你}們在這裡好好轉一圈，但是我要先回家一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180816,
					"content": "想起什麼重要的事了嗎？剛剛丘丘人出現的時候，就感覺妳好像很著急…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180817,
					"content": "希望沒耽誤妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "沒耽誤沒耽誤，時間上正正好好！不過這件事的確滿重要，訓練後最重要的事就是——吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180805,
					"content": "餓了肚子，就會有氣無力、頭暈目眩、精神渙散、胡思亂想，可謂是壞處多多，一定要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180806,
					"content": "#實在抱歉，我必須首先、立刻、馬上吃飯！{F#妳}{M#你}們也快去吃飯吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180807,
					"content": "之後我們「逐響擂臺」再見，我先走一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180808,
					"content": "瓦雷莎走掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180809,
					"content": "怎麼說呢，真是個神奇的人，有時候軟綿綿的，有時候又橫衝直撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180810,
					"content": "這叫「青春」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "「這叫『青春』」…幹嘛突然說只有老頭子才會說的話啊，我們還年輕呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180812,
					"content": "既然她回家去了，我們就先自己逛逛吧，等會再去「逐響擂臺」等她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180813,
					"content": "那麼高的地方，視野一定超級好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
