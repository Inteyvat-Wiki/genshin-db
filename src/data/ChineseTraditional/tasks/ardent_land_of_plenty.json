				"points": []
			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "原來妳就是瓦雷莎，我們聽過這個名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180202,
					"content": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我們是最好的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180203,
					"content": "#好的，派蒙和{NICKNAME}，真是不錯的名字，我記住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180204,
					"content": "那我們這就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
