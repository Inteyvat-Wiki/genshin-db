			"dialogs": [
				{
					"id": 150180101,
					"content": "這個立在路邊的木板是做什麼用的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180107,
					"content": "哦，這是我們部族的健身器材，我也經常用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180108,
					"content": "健身器材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180109,
					"content": "嗯，我想想…比起解釋還是直接示範一下比較快。瓦雷莎，要上了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180103,
					"content": "平穩落地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180104,
					"content": "嗚哇啊啊，就這樣跳過去了，妳好厲害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180105,
					"content": "沒什麼、沒什麼，只要多加練習，很多人都可以做得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180110,
					"content": "哦！妳甚至都不需要訓練，直接飛過來就好，這不是比我厲害多了嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180112,
					"content": "這不一樣啦…嗯，但妳說的有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
