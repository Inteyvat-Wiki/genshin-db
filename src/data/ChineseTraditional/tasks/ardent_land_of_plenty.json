			"dialogs": [
				{
					"id": 150180301,
					"content": "妳好，請問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180303,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180304,
					"content": "#{F#妳}{M#你}們是不是迷路了？需要我幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180305,
					"content": "沒有沒有，我們只是正巧路過這裡，想去「沃陸之邦」看看…請問是往這個方向去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180306,
					"content": "#沒錯，那裡是我的家，如果需要的話，現在我就能帶{F#妳}{M#你}們過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180307,
					"content": "#太好了，{NICKNAME}，又遇到當地的嚮導了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180308,
					"content": "妳想偷懶的語氣太明顯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "#嚮導啊…我應該沒問題吧，嘿嘿，那我現在就是{F#妳}{M#你}們的嚮導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180310,
					"content": "#這一路上有很多特別的風景，我可以幫{F#妳}{M#你}們介紹，幾乎每個剛來我們這裡的人，都會發出「哇噢——」的讚嘆呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180311,
					"content": "謝謝妳的好意，不過等等…妳接受得這麼快，我反而有點愧疚…呃，沒關係嗎？會不會耽誤妳本來要做的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180312,
					"content": "沒關係沒關係，我本來是到這邊訓練的，正好打算收拾東西回家，我們也算順路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180313,
					"content": "#而且我來當嚮導的話，{F#妳}{M#你}們會瞭解更多這裡的風土人情、獲得很多新知識，就會很開心對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180314,
					"content": "#{F#妳}{M#你}們開心的話，我就開心。阿卡特叔叔說，這叫「待客之道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180315,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180316,
					"content": "感覺是個單純又熱情的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180317,
					"content": "運氣滿好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "是吧，我也這樣覺得，我喜歡她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180319,
					"content": "怎麼啦，如果準備好了的話，我們就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180320,
					"content": "對了，還沒有問妳叫什麼名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180321,
					"content": "#對哦，我叫瓦雷莎，很高興認識{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
