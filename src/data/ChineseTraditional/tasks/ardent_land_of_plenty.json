			"dialogs": [
				{
					"id": 150180501,
					"content": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我們是最好的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
