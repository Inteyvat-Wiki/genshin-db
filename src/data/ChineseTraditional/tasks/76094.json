			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "#太好了，我就知道{F#妳}{M#你}果然會有辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940202,
					"content": "雖說獺懶羊無法在沒有月矩力的環境下生存，不過至少在挪德卡萊的這段時間裡也能給那位先生一點慰藉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940203,
					"content": "那麼我就先行告退了，這是一點小小的感謝，不成敬意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦加勞"
				}
			]
		},
