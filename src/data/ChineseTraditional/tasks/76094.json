			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦加勞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "到底要怎麼把那傢伙弄出來呢，真是傷腦筋啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940102,
					"content": "有什麼能幫上忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#嗯？哦哦，是熱心的冒險家啊，遇上{F#妳}{M#你}真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940104,
					"content": "事情是這樣的，穿過這裡的岩洞，原本有一條通往北方的道路，不過前陣子因為月矩力的異變而發生了坍塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940105,
					"content": "雖然所幸沒造成什麼人員傷亡，但有位異國的行商說他的「夥伴」被困在了裡面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940106,
					"content": "#那是一隻他在附近結識的獺懶羊。{F#妳}{M#你}要是在這裡待得夠久就會知道，獺懶羊跟著{F#妳}{M#你}大概只是為了把攜帶的種子播撒到遠方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940107,
					"content": "但怎麼跟那位先生解釋，他都不聽，一定要我們想辦法把牠救出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940108,
					"content": "要想重新連接通往洞穴深處的道路，只能利用這些璇瓏花。可惜我既不會霜月之子的魔法，也沒有強力的月矩力機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940109,
					"content": "#不過幸好遇上了{F#妳}{M#你}，如果是冒險家的話，應該能有辦法把裡面的獺懶羊帶出來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "瓦加勞"
				},
				{
					"id": 760940110,
					"content": "#我會替那位先生感謝{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦加勞"
				}
			]
		},
