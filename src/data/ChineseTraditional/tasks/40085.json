				"objectNames": [
					"埃爾欣根",
					"八重神子",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851601,
					"content": "#諸位觀眾與選手，經歷多場激烈角逐後，「月蓮盃」的決賽總算要開幕了。馴獸師海妮耶將與旅行者{NICKNAME}一較高下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851602
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400851602,
					"content": "他們之中的勝者若是能通過最終考驗，就能獲得我的全部財產，接過繼續舉辦這場大賽的責任，向全提瓦特繼續傳播和平之道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851603
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400851603,
					"content": "今天考特里亞沒在場…是個好機會！決賽和最終考驗之後，我們先去提醒埃爾欣根，然後再找考特里亞當面對質吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851604,
					"content": "神子、萊依拉，妳們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851605,
					"content": "向神子和萊依拉講述了和海妮耶的溝通過程，以及接下來的計畫。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400851606
					]
				},
				{
					"id": 400851606,
					"content": "#不出所料，急躁的學術狂人終究在兩位主角的面前露出了馬腳…{F#妳}{M#你}們的推測或許接近真相了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851607,
					"content": "暫時不向教令院上報的決定也相當謹慎，說不定考特里亞…或是什麼其他人還留了一手呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851608
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851608,
					"content": "現在的情況也容不得我們放鬆警惕吧，畢竟要和那個最強的海妮耶對戰了，也不知道埃爾欣根的「最終考驗」到底是什麼情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851609,
					"content": "但我們還不知道怎麼說服海妮耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851610,
					"content": "答案已經很明顯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851611,
					"content": "#帶上我們的蕈獸，乾淨俐落地打敗海妮耶，讓她放棄軟硬不吃的態度，老老實實聽{F#妳}{M#你}們說明真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851612,
					"content": "#我相信{F#妳}{M#你}們，呼…{F#妳}{M#你}們一定可以讓海妮耶看見自己的盲點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851613
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400851613,
					"content": "感謝妳們的支持！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851614
					]
				},
				{
					"id": 400851614,
					"content": "好呀！「咚咚小圓帽」、「轉轉悠悠獸」和「百雷遮羅」，三個最熟悉的夥伴要並肩戰鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851615,
					"content": "現在我們集結了大家的力量，絕對不會輸的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
