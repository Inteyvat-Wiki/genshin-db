			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾欣根",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851001,
					"content": "居然敗給了一群蕈獸…實在太荒唐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851002
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400851002,
					"content": "想逃去哪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851003
					]
				},
				{
					"id": 400851003,
					"content": "神子，妳怎麼不攔住他啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851004,
					"content": "#嗯？作為遊客，我似乎沒有在須彌境內逮捕誰的權力。{F#妳}{M#你}們不也一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851005
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851005,
					"content": "#不過，{F#妳}{M#你}們放心好了，他逃不掉的。回到賽場後，{F#妳}{M#你}們就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851006
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851006,
					"content": "來不及多想了，我們趕快追過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008512,
			"completionStepIds": [
				4008512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008512",
							"2"
						],
						"stepId": 4008512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西達",
					"埃爾欣根",
					"八重神子",
					"萊依拉",
					"海妮耶",
					"風速棗椰",
					"左右加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851201,
					"content": "你們是…「三十人團」的傭兵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851202,
					"content": "你們總算出手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851203
					]
				},
				{
					"id": 400851203,
					"content": "受大風紀官賽諾所託，我們前來逮捕重犯埃爾欣根，和學術罪犯考特里亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851204
					],
					"speakerTitle": "西達"
				},
				{
					"id": 400851204,
					"content": "大風紀官盯上考特里亞很久了，只是他最近事務繁忙，暫時無法抽身應對這些宵小。多虧幾位提供的證據，我們才能順利收網。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851205
					],
					"speakerTitle": "西達"
				},
				{
					"id": 400851205,
					"content": "這裡是大風紀官特地寫給兩位的信件，請過目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851206
					],
					"speakerTitle": "西達"
				},
				{
					"id": 400851206,
					"content": "原來賽諾一直在關注這場比賽，我們調查的時候，他也在暗中收集線索，剛好為我們準備了一份保險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851207,
						400851208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851207,
					"content": "及時的配合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851209
					]
				},
				{
					"id": 400851209,
					"content": "#那麼，我就將疑犯們帶走了。有{F#妳}{M#你}們在這裡，賽場秩序也無需我們操心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851210
					],
					"speakerTitle": "西達"
				},
				{
					"id": 400851210,
					"content": "別急著慶祝，這件事還沒結束…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851211
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400851211,
					"content": "#我還會來找{F#妳}{M#你}們的，為了多托雷大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851212
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400851212,
					"content": "還嘴硬什麼！好好在監獄裡懺悔吧，愚人眾的大騙子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851213,
					"content": "不過，賽諾的信裡還提到了證據。這麼說來，十六強賽以後，原來神子是去報案了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851214,
					"content": "幹嘛這樣看著我？我也很苦惱嘛，明明是出來度假的，卻總被各種各樣的人找上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851215,
					"content": "#我只不過是帶著編輯們在須彌城裡逛了幾圈，和偶然遇見的大風紀官閒聊幾句罷了，一切的關鍵還是{F#妳}{M#你}們收集的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851216,
					"content": "噫…總覺得妳越是輕描淡寫，背後的過程就越複雜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851217,
					"content": "話說回來，主辦方和贊助商都被逮捕了，蕈獸們和這場比賽又該怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851218
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400851218,
					"content": "規則就是規則，小傢伙們奪得了冠軍，也通過了最終考驗，等於取代了埃爾欣根和考特里亞的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851219,
					"content": "#從今以後，大賽的一切都由小傢伙們說了算喔。相信經歷了這麼多以後，{F#她}{M#他}們一定能作出最合理的決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851220,
						400851221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851220,
					"content": "首先要向海妮耶公開真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851222
					]
				},
				{
					"id": 400851222,
					"content": "#{F#妳}{M#你}們提到的真相，狐狸小姐已經告訴過我了。當年襲擊我祖輩的蕈獸，正處於失控後的暴走狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851223
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851223,
					"content": "我對蕈獸的印象建立在誤解之上，最初就太過極端…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851224
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851224,
					"content": "欸？我們還沒開口呢！神子妳怎麼搶先一步啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851225,
					"content": "#哎呀，{F#妳}{M#你}們不應該感謝我嗎？要讓消沉的海妮耶振作起來，跟著我們去聲援{F#妳}{M#你}，總得給她一點動力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851226,
					"content": "#不勞{F#妳}{M#你}們多說了…之前的我，的確在向自己重複一些固執的觀念，欺騙自己，直到完全麻木…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851227,
					"content": "可是剛才，我見識到了真相。即便沒有「意智寶珠」，「火一」也還願意聽我的話。它一直相信著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851228,
					"content": "#願賭服輸，我接受{F#妳}{M#你}們的指正和懲罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851229
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851229,
					"content": "懲罰這樣的詞也太誇張了啦，畢竟妳除了說過一些嚇人的話，還有對「火一」太嚴格，又沒做錯什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851230,
					"content": "剛好說到這裡，我覺得我想好該怎麼辦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851231,
					"content": "我也有個好點子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851232
					]
				},
				{
					"id": 400851232,
					"content": "和大家一起商量了最終的決定，確定了措辭。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400851233
					]
				},
				{
					"id": 400851233,
					"content": "好了！我完全明白了！現在我們就去向大家公佈這個結果吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851234,
						400851235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851234,
					"content": "冠軍演講就交給派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851236
					]
				},
				{
					"id": 400851236,
					"content": "呃咳咳，我還是第一次站在這種舞臺上向這麼多人講話呢，有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851237,
					"content": "#這次我和{NICKNAME}有幸拿到了冠軍，還揭發了一場陰謀，我們非常開心！辦好這場大賽的責任，也落到了我們的肩上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851238,
					"content": "就算主辦方和贊助商被抓走了，給各位選手的獎勵還是會照常發放的，請大家放一萬個心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851239,
					"content": "好！等的就是這句話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851240
					],
					"speakerTitle": "風速棗椰"
				},
				{
					"id": 400851240,
					"content": "英明的決定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851241
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 400851241,
					"content": "不過，現在的「意智寶珠」有個缺點，它會影響周圍的環境，對人們帶來健康問題，所以蕈獸夥伴還不能長期待在大家身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851242,
					"content": "為了大家的健康著想，我們希望，各位選手和蕈獸夥伴相處一段時間後，可以將它們交給最可靠的馴獸師海妮耶來照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851243,
					"content": "但大家不會和夥伴們分開很久的！在海妮耶照顧蕈獸期間，我們會向教令院提出改進「意智寶珠」的請求，盡快解決這個問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851244,
					"content": "而且，這次的比賽很有趣，只舉辦一次就太可惜了嘛，大家也沒有盡興吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851245,
					"content": "等到技術的問題被解決了，我們就能和蕈獸夥伴們團聚了！到時候再來較量一番吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851246,
					"content": "這就是對我的懲罰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851247
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851247,
					"content": "說是給亞軍的獎勵，或許更合適喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851248
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400851248,
					"content": "放鬆一點，海妮耶小姐。其實與蘑菇夥伴相處是很開心的事。沒錯吧，「轉轉悠悠獸」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851249
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400851249,
					"content": "我還有點捨不得呢，以後「轉轉悠悠獸」就要交給妳來照顧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851250
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400851250,
					"content": "#{NICKNAME}和派蒙…還有萊依拉和狐狸小姐，{F#妳}{M#你}們真是奇妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851251
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851251,
					"content": "海妮耶，我們都在所有人面前宣佈這個決定了，妳可要打起精神來啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851252,
					"content": "#不必多說，我明白{F#妳}{M#你}們的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851253
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851253,
					"content": "#作為一名馴獸師，我接受{F#妳}{M#你}們的安排。我會盡到自己的責任，好好照顧這些蕈獸，照顧大家珍貴的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851254
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851254,
					"content": "嘿嘿，早點露出這種表情就好了嘛！這才是我們希望交朋友的，超級厲害的海妮耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851255,
					"content": "大家就先和自己的夥伴盡情玩耍一段時間吧，之後我們再來奧摩斯港碰面，就這麼說定啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851235,
					"content": "妳來出這個大風頭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851236
					]
				},
				{
					"id": 400851221,
					"content": "首先要改變海妮耶的態度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851222
					]
				},
				{
					"id": 400851208,
					"content": "之後交給你們了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851209
					]
				}
			]
		},
