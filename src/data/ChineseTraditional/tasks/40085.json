			},
			"dialogs": [
				{
					"id": 400851501,
					"content": "#終於等到這一天了，{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851502
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851502,
					"content": "#我早就告誡過{F#妳}{M#你}們，不要對蕈獸抱有多餘的情感，要將它們當成棋子指揮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851503
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851503,
					"content": "#現在看來，{F#妳}{M#你}們並沒有改觀。所以，這場比賽會毫無懸念地結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851504,
						400851505
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851504,
					"content": "要改觀的是妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				},
				{
					"id": 400851506,
					"content": "說得對！我們和「咚咚小圓帽」，還有其他夥伴的默契絕對不會輸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400851507,
					"content": "#唉…就讓{F#妳}{M#你}們見識一下好了，{F#妳}{M#你}們那軟弱的打法和真正的馴獸師之間的差距…「火一」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400851505,
					"content": "我們會用實力說服妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				}
			]
		},
		{
			"id": 4008516,
