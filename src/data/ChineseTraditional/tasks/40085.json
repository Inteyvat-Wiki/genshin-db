	"talks": [
		{
			"id": 4008504,
			"completionStepIds": [
				4008504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008504",
							"2"
						],
						"stepId": 4008504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850401,
					"content": "為什麼會這樣…「火一」？為什麼不盡全力戰鬥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850402,
						400850403
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850402,
					"content": "下命令的是妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				},
				{
					"id": 400850404,
					"content": "不要責怪「火一」，也不要勉強自己嘛，海妮耶。準決賽的時候，妳明明因為「火一」受傷而猶豫過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850405,
					"content": "除了我們和神子，妳大概沒有碰到能和妳較量的對手吧？也沒有讓「火一」和其他夥伴陷入過苦戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850406,
					"content": "真正看到「火一」和其他同伴受傷的時候，妳還是不忍心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850407,
					"content": "#勉強自己？事到如今，{F#妳}{M#你}們還覺得我會因為蕈獸受傷而動情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850408,
						400850409
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850408,
					"content": "並非我們的揣測。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850410,
					"content": "海妮耶…妳聽著可怕的故事長大，對蕈獸有了不好的看法，我們完全能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850411,
					"content": "可是，只憑一個模糊的印象，就把眼前的夥伴也當成凶惡的敵人…時間一長，還是騙不過妳自己的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850412,
					"content": "我們經常討伐凶惡的蕈獸，以前我們也把蕈獸當成純粹的魔物。就連我們參賽的目的，都是防止這些蕈獸惹出麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850413,
					"content": "但遇見了「咚咚小圓帽」後，我們發現，只要不斷努力，以真情實意對待溫和的蕈獸，它們也會作出回應，和我們友善地交流！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850414,
					"content": "至少這些溫和的蕈獸是妳的夥伴，而不是棋子或敵人！我們希望妳信任「火一」，信任妳的其他蕈獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850415,
						400850416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850415,
					"content": "然後放棄激進的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850417,
					"content": "夠了，比賽還沒結束呢！現在就擺出一副獲勝者的姿態，想要對我說教嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850416,
					"content": "理智地對待蕈獸這個物種。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850409,
					"content": "而是妳不想承認。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850403,
					"content": "妳已經心軟了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				}
			]
		},
		{
			"id": 4008505,
			"completionStepIds": [
				4008505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008505",
							"2"
						],
						"stepId": 4008505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"埃爾欣根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850501,
					"content": "失敗了…我還沒辦法走出最重要的一步，居然就失敗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850502
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850502,
					"content": "#結果{F#妳}{M#你}們兩個，還是成了最大的變數…但只憑那種幼稚的想法，為什麼能贏過我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850503,
						400850504
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850503,
					"content": "我們會向妳展示原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				},
				{
					"id": 400850505,
					"content": "海妮耶，按照約定，我們贏了妳之後，妳會好好聽我們講清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850506,
					"content": "道理之後再說，先讓「火一」跟著我們去接受最終考驗，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850507,
					"content": "#「火一」？{F#妳}{M#你}們要帶上它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850508
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850508,
					"content": "嗯！「咚咚小圓帽」、「轉轉悠悠獸」、「百雷遮羅」和妳的「火一」，我們要用大家的蕈獸一起通過最終考驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850509,
						400850510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850509,
					"content": "然後取得大賽的最高許可權。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850511,
					"content": "那天拿到了妳的記事簿，和妳談話後，我們確定了很多事——關於蕈獸的安全性，妳的看法也有可取之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850512,
					"content": "「意智寶珠」可能影響人的健康。大賽不該被過度宣傳，蕈獸和人們也不能親密無隙地生活在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850513,
					"content": "但是，不斷改進「意智寶珠」，用它們和蕈獸好好溝通，找出善良的蕈獸，慢慢瞭解這個群體，應該是可行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850514,
					"content": "#…那就依{F#妳}{M#你}們好了。反正我輸了，敗者沒有固執和嘴硬的資本…「火一」大概也更喜歡…一個總是為它著想的主人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850515
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850515,
					"content": "海妮耶，振作一點，不要輕視自己在夥伴心中的地位啊…等到我們贏得了最終考驗，還有更重要的事要和妳說呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850516,
						400850517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850516,
					"content": "有關妳的祖輩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850518,
					"content": "對喔！妳要是知道了當時發生了什麼，一定會改變想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850519,
					"content": "精彩，精妙絕倫的一場對決！觀點的交鋒也令人感慨萬千！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850520
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850520,
					"content": "埃爾欣根？你怎麼進到賽場來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850521,
					"content": "當然是為了親自見證決賽中雙方的角逐，和冠軍在最終考驗裡的英姿了！對於大賽而言，這可是歷史性的時刻，我怎麼能缺席！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850522
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850522,
					"content": "#來吧，旅行者和派蒙，向我證明{F#妳}{M#你}們的意志。{F#妳}{M#你}們一定能成為昇華這場大賽的關鍵人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850517,
					"content": "那次襲擊的真相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850518
					]
				},
				{
					"id": 400850510,
					"content": "妥當地安排這些蕈獸夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850511
					]
				},
				{
					"id": 400850504,
					"content": "妳一定能理解的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850505
					]
				}
			]
		},
		{
			"id": 4008508,
			"completionStepIds": [
				4008508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008508",
							"2"
						],
						"stepId": 4008508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾欣根",
					"埃爾欣根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850801,
					"content": "怎麼回事…怎麼到處都是愚人眾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850802,
					"content": "埃爾欣根！賽場被壞人入侵了！你快逃，我們來對付他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850803,
					"content": "等等，說起來，出口在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850804,
						400850805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850804,
					"content": "不是賽場被壞人入侵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				},
				{
					"id": 400850806,
					"content": "#不愧是旅行者，看得很通透。對於這種絕境，{F#妳}{M#你}也準備了應對方案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850807
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850807,
					"content": "我不明白…現在不是在最終考驗嗎？幕後黑手不應該是考特里亞嗎！他想利用這場比賽取得成就，所以騙你為他出錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850808,
					"content": "只差一點就說到真相了。考特里亞的動機確實如此，他發掘的失落技術，有著絕佳的潛力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850809
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850809,
					"content": "#所以我才買下了他，舉辦了這場比賽，擴大這項技術的影響力。當然，我沒想到，{F#妳}{M#你}這樣的高價值目標居然會主動咬鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850810,
						400850811
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850810,
					"content": "你也主動暴露了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850812,
					"content": "也就是說…你沒有被考特里亞欺騙，而是在利用考特里亞？ 你原本就是個愚人眾的壞傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850813,
					"content": "氣死我了！虧我們還想著警告你別被騙！「咚咚小圓帽」，揍他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850814,
					"content": "氣勢不錯，可惜太自信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850815
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850815,
					"content": "「轉轉悠悠獸」？「百雷遮羅」…還有「火一」？你們都怎麼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850816,
					"content": "考特里亞在「意智寶珠」中加入了漏洞指令，一旦我啟動這條指令，所有被寶珠控制的蕈獸都會聽令於我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850817
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850817,
					"content": "漏洞指令？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850818
					]
				},
				{
					"id": 400850818,
					"content": "難不成…你大張旗鼓地舉辦比賽，是想鼓勵人們去捕捉更多蕈獸，然後接管它們，用它們來做壞事嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850819,
					"content": "一點即通，很不錯。等到比賽多次舉辦後，民間就會保有一支龐大的蕈獸部隊，能在須彌製造混亂，為我創造機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850820
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850820,
					"content": "#等到我取得其他同事難以企及的成就，我所敬愛的主人——因為{F#妳}{M#你}們而離開的「多托雷」大人——也會重新意識到，我還有著價值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850821,
						400850822
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850821,
					"content": "多托雷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850823,
					"content": "不過現在看來，我還能做得更出色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850824
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850824,
					"content": "#只要除掉{F#妳}{M#你}們，我就能為長官們和眾多同事一雪前恥，取得組織裡數一數二的成就，「多托雷」大人會給予我最高的重視…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850825
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850825,
					"content": "#我會將{F#妳}{M#你}們的死宣傳成一場意外——{F#妳}{M#你}們太過相信蕈獸，試圖突破極限，結果引發賽場崩毀，不幸遇難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850826
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850826,
					"content": "#封鎖這個秘境後，誰都查不出{F#妳}{M#你}們的下落。我會讓考特里亞接下全部責任和罪名，給教令院一個交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850827
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850827,
					"content": "#隨後，我會以緬懷{F#妳}{M#你}們的名義，投入更多資金，加大宣傳比賽的力度，縮短賽事的週期…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850828
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850828,
					"content": "你怎麼睜著眼亂編謊話？還要出賣同夥？未免也太陰險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850829,
					"content": "可惡啊…光是聽著你胡說，我就好難受！絕不能讓你得逞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850830,
					"content": "#不過，我們該怎麼辦？現在{F#妳}{M#你}沒有武器，其他蕈獸夥伴又不聽我們的話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850831,
						400850832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850831,
					"content": "先保護好自己！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850833,
					"content": "#不必急著出手。蕈獸對蕈獸、戰士對戰士。等到旅行者的夥伴被擊潰，信念徹底崩塌後，你們再去給{M#他}{F#她}一個痛快的死法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850834
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850834,
					"content": "之前我們的手段不算光彩，至少在送旅行者上路這件事上，我們需要保留尊重和儀式感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850832,
					"content": "我相信「咚咚小圓帽」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850833
					]
				},
				{
					"id": 400850822,
					"content": "你是博士的舊部…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850823
					]
				},
				{
					"id": 400850811,
					"content": "到了牢里再自白吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850812
					]
				},
				{
					"id": 400850805,
					"content": "而是埃爾欣根的安排。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850806
					]
				}
			]
		},
		{
			"id": 4008509,
			"completionStepIds": [
				4008509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008509",
							"2"
						],
						"stepId": 4008509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾欣根",
					"八重神子",
					"海妮耶",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850901,
					"content": "「咚咚小圓帽」！你不要緊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850902,
					"content": "以一敵三太勉強了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850903
					]
				},
				{
					"id": 400850903,
					"content": "不對勁，明明對那隻浮游水蕈獸發動了三次漏洞指令，為什麼它還在聽從旅行者的指揮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850904
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850904,
					"content": "考特里亞的設備失靈了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850905
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850905,
					"content": "啊呀，看來你還沒有意識到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850906
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850906,
					"content": "「意智寶珠」所用的技術確實可以讓蕈獸聽令於馴獸師，可是不過是壓制本能，增強蕈獸作為「生物」與馴獸師的溝通效果罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850907
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850907,
					"content": "這四隻蕈獸對馴獸師的認可，他們之間的情感和默契，已經凌駕於「意智寶珠」的影響之上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850908
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850908,
					"content": "八重神子…妳能破除封鎖秘境的術法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850909
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850909,
					"content": "只憑那些拙劣的模仿品，就想把我攔在外面？我似乎被小看了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850910
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850910,
					"content": "還有東拼西湊出來的「漏洞指令」，你們還真以為自己完全沒露出過破綻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850911
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850911,
					"content": "真麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850912
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400850912,
					"content": "神子、萊依拉！海妮耶也來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850913,
					"content": "埃爾欣根…原來你才是主謀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850914
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850914,
					"content": "相比蕈獸的威脅，你的野心更不可饒恕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850915
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850915,
					"content": "八重小姐…我們趕快去幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850916
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400850916,
					"content": "別心急嘛，小萊依拉。這種時候就要好好看著喔，夥伴之間的默契，絕不會被世俗的陰謀和技術破壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850917
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850917,
					"content": "「百雷遮羅」，你的任務還沒完成，怎麼能屈服呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850918
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850918,
					"content": "咦？快看，「百雷遮羅」好像恢復神智了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850919,
					"content": "莫非，八重小姐所說的時機已經來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850920
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400850920,
					"content": "「轉轉悠悠獸」，我相信你！打敗那個騙子吧…呃咳咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850921
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400850921,
					"content": "漏洞指令對蕈獸夥伴們的影響…正在消退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850922,
					"content": "還在猶豫嗎，海妮耶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850923
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850923,
					"content": "妳害怕看到…妳一直想要當成「棋子」的蕈獸，始終堅信著妳，讓妳不得不正視自己逃避的情感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850924
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850924,
					"content": "但妳的蕈獸似乎等不及了。脫離了「意智寶珠」的控制後，它也在等待妳的命令呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850925
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400850925,
					"content": "「火一」…你真的在等我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850926
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850926,
					"content": "對不起，我一直對你這麼苛刻，你還相信著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850927
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850927,
					"content": "去做你該做的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850928
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400850928,
					"content": "雖然不知道是什麼原理，但蕈獸們全都清醒過來了！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850929,
					"content": "埃爾欣根！你這個卑鄙的傢伙，準備好迎接我們的怒火了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400850930,
					"content": "有序迎戰，不要慌。對方只是蕈獸罷了，優勢依然在我們這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾欣根"
				}
			]
		},
		{
			"id": 4008510,
			"completionStepIds": [
				4008510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008510",
							"2"
