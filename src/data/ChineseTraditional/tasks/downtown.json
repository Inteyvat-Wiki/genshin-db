	"talks": [
		{
			"id": 101301,
			"completionStepIds": [
				101301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101301",
							"2"
						],
						"stepId": 101301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿山婆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10130101,
					"content": "客人，來啦？之前預訂的七隻風箏都已經紮好了，是現在要取嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130102
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130102,
					"content": "是的，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130103,
					"content": "這年頭，願意買這樣式風箏的客人，還真少見。要說早年間，倒是有些三教九流的朋友會用上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130104
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130104,
					"content": "嗯，這位鍾離先生是「往生堂」的客卿，所以他對三教九流的遊戲規則也都能理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130105,
					"content": "不過，這次旅途裡跟鍾離閒聊的東西，還遠遠不止這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130106,
						10130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130106,
					"content": "他也懂衣冠日用、珠玉瓷器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130108
					]
				},
				{
					"id": 10130108,
					"content": "唔…他好像也能接上璃月人最愛的金融和政治話題，但卻更喜歡說那些比較「無用」的知識呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130109,
					"content": "#哈哈…因為我更願意把這些趣事分享給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130110,
					"content": "哎呀，孩子的玩具就是很有趣的東西嘛。不過…雖然我也挺喜歡看孩子笑，但畢竟，還有點別的念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130111
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130111,
					"content": "精巧的玩意，總能討孩子喜歡。但這份「精巧」也是千多年的積澱，背後都是有「意義」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130112
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130112,
					"content": "我在璃月做了四十年風箏，對祖上傳下的式樣一清二楚。這位客人訂的七隻風箏，意義可不一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130113
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130113,
					"content": "沒錯。這是「送仙典儀」用的飾物，七隻風箏…象徵七神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130114
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130114,
					"content": "呵呵呵…敬獻風神的紋樣，我特意把顏色「自由」地塗出了界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130115
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130115,
					"content": "至於敬獻岩神的，就要好好按照「契約」來畫囉。這種花紋是很古的，在「黃金屋」裡也找得到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130116
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130116,
					"content": "啊，「黃金屋」，這個名字我最近聽過——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130117,
						10130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130117,
					"content": "噓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130119
					]
				},
				{
					"id": 10130119,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130120,
					"content": "這隻風箏的雷紋…嗯，旋迴感把握得很好，正如雷神想要的「永恆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130121,
					"content": "敬獻「智慧」的草葉紋路、銀木年輪…巧妙地融合在風箏的骨架裡，令人讚嘆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130122
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130122,
					"content": "水面般平衡的「正義」、如火熾烈的「戰爭」，還有冰神曾經的…嗯，細節做得都很到位啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130123
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130123,
					"content": "哈哈哈，偶爾能聽懂行的客人多誇幾句，也是賞心樂事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130124
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 10130124,
					"content": "那麼阿山婆，我就先把這些預訂的貨取走了。餘款的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130125,
						10130126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130125,
					"content": "完了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130127
					]
				},
				{
					"id": 10130127,
					"content": "餘款的話…我來付吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130128
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130128,
					"content": "呀，是「公子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130129,
						10130131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130129,
					"content": "你們約好在這裡見面嗎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130130
					]
				},
				{
					"id": 10130130,
					"content": "哈哈，只是路過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130133
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130133,
					"content": "鍾離先生還是老樣子。付帳…或者喊人付帳的時候，從來不看價格，也不看荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130134
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130134,
					"content": "不過話說回來，他其實既懂金錢的價值，也很明白人間疾苦。但他似乎不能理解「窮」也是一種可能出現在自己身上的境況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130135
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130135,
					"content": "或者換句話說，只是根本不能想像一個沒有錢的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130136
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130136,
					"content": "真是絕了，這種人怎麼還沒餓死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10130137,
					"content": "…「公子」先生還是這麼愛開玩笑。好了，買風箏一切順利，進行下一項準備之前，就不必休息了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130138
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130138,
					"content": "「送仙典儀」需要物資，也需要人。在碼頭附近，我們可以雇到一些不錯的幫工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130139
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10130139,
					"content": "#{NICKNAME}，把這個錢袋拿去——我不說{F#妳}{M#你}也明白的吧？討價還價的事，{F#妳}{M#你}自己來，可千萬別讓鍾離插手喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130140
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10130140,
					"content": "嗯…來晚一步，似乎錯過了什麼有趣的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130141
					],
					"speakerTitle": "「公子」"
				},
				{
