				"objectNames": [
					"「愚人眾」守衛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201010301,
					"content": "#哇啊…不要吃我！——呃，{F#妳}{M#你}們…是人類？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010302
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010302,
					"content": "一整層的防禦…都被突破了…我還以為是「深淵教團」的怪物攻來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010303,
						201010305
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010303,
					"content": "我們是來取天空之琴的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010304
					]
				},
				{
					"id": 201010304,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}們怎麼知道「天空之琴」在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010309,
					"content": "#存放聖物的地方是上鎖的，{F#妳}{M#你}們要找鑰匙的話…往前走吧，不要找我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010310
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010310,
					"content": "#鑰匙不知道是在哪位先遣隊員手裡…但總之{F#妳}{M#你}可以去房間裡找他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010311
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010311,
					"content": "是個被嚇破膽了的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 201010312,
					"content": "#哼…{F#妳}{M#你}，{F#妳}{M#你}們好自為之吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010313
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010313,
					"content": "我們「愚人眾」在蒙德…可是有「執行官」坐鎮的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010314
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010314,
					"content": "#「女士」大人會找到{F#妳}{M#你}們，把{F#妳}{M#你}們吊起來折磨——到那時可不要連累我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010305,
					"content": "我們是來取你性命的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010306
					]
				},
				{
					"id": 201010306,
					"content": "咿——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010307
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010307,
					"content": "不要這樣…！我有珍貴的情報要坦白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010308
					],
					"speakerTitle": "「愚人眾」守衛"
				},
				{
					"id": 201010308,
					"content": "其實我們把蒙德的至寶，「天空之琴」，藏在這座遺蹟深處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「愚人眾」守衛"
				}
			]
		},
