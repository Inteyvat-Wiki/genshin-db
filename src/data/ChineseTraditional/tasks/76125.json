			"dialogs": [
				{
					"id": 761250201,
					"content": "（哥倫比婭，果然不在這裡…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "難道哥倫比婭真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250203,
					"content": "（她踏入了「月之門」，沒人知道門內有什麼，但那是個將極為強大的獵月人都徹底撕碎了的地方…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "（如果我當時…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "哥倫比婭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250207,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250208,
					"content": "是你們啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250209,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250210,
					"content": "你們…也在等哥倫比婭回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761250212,
					"content": "就連你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761250214,
					"content": "嗚…不要那麼難過嘛，打起精神來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250215,
					"content": "大家一起難過的話，不就像是…不就像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250216,
					"content": "我才不要這麼想呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250217,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "（…我不能沉溺在自責之中。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "（哥倫比婭不是為了看到這樣的局面才做出犧牲，更何況…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "我…還沒有放棄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "哥倫比婭，她的每一位朋友，都不會就此放棄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "再給我們一點時間。我沒辦法向各位許諾什麼，但我一定會盡力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250224,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761250225,
					"content": "它們…這是在…鼓勵我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250226,
					"content": "嗯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250228,
					"content": "想要陪你們做點什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250230,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761250231,
					"content": "這隻月靈…似乎是喜歡彈琴的那隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250232,
					"content": "這隻月靈…有點心神不寧的樣子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250233,
					"content": "#要不然{F#妳}{M#你}彈點什麼吧？聽到熟悉的旋律，說不定就可以稍稍安下心來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250234,
					"content": "熟悉的旋律…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "演奏哥倫比婭常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "…它們睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250237,
					"content": "看起來小傢伙們很久都沒有好好休息過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250238,
					"content": "我們悄悄離開這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250239,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250240,
					"content": "桑多涅！妳怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250241,
					"content": "隨便出門散散心不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250242,
					"content": "她沒有回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250244,
					"content": "奇蹟怎麼可能沒有代價呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250245,
					"content": "妳要往哪個方向走？我是說…好不容易遇見了，要不要再一起走一段？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250246,
					"content": "算了吧，今天心情不好，說出來的話不會好聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250247,
					"content": "而且我看，這裡最不需要的就是安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
