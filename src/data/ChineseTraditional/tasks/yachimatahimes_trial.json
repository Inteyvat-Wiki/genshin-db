			"dialogs": [
				{
					"id": 722690301,
					"content": "#俐落地完成了試煉。我，末代地走官·江木，於此認可{F#妳}{M#你}的勇武。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690302
					],
					"speakerTitle": "江木"
				},
				{
					"id": 722690302,
					"content": "#{F#妳}{M#你}的明察，可稱得上「微察冬鰻」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690303
					],
					"speakerTitle": "江木"
				},
				{
					"id": 722690303,
					"content": "這又是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722690304,
					"content": "繁殖時節的小陸鰻鰻魚苗真的非常非常小哦。要集中注意力瞇起眼睛才能看到。",
					"roleType": "TALK_ROLE_NPC",
