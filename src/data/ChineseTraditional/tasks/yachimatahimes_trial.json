				"points": []
			},
			"dialogs": [
				{
					"id": 722690101,
					"content": "#我乃末代地走官·江木。珊瑚宮之勇者，我認可{F#妳}{M#你}挑戰的榮譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "江木"
				},
				{
					"id": 722690102,
					"content": "#我將主持「明察」之試煉。請{F#妳}{M#你}動身去解開所有的謎題，讓「高門之火」歸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "江木"
				},
				{
					"id": 722690103,
					"content": "戰場瞬息萬變。唯有耳觀八方、眼觀六路才能把握情況，把握一切變數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "江木"
				}
			]
		},
