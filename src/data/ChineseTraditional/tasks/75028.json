			"dialogs": [
				{
					"id": 750280101,
					"content": "嘖，這下遇到個不好惹的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "老鼠"
				},
				{
					"id": 750280102,
					"content": "唉喲，今天這是什麼日子？我又招誰惹誰了，給我一頓好打…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "夜貓子"
				},
				{
					"id": 750280103,
					"content": "#{M#大兄弟}{F#好姐姐}，您可要指點我一下，讓我知道知道我這又是做了什麼枉費您的心意，今後才好不要再犯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "夜貓子"
				},
				{
					"id": 750280104,
					"content": "喂！你小子，對這凶神惡煞的魔頭低聲下氣的，有沒有點出息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "老鼠"
				},
				{
					"id": 750280105,
					"content": "出息？出息可以當飯吃？我總算是看清了，跟你混無非就是做些雞鳴狗盜的生意，賣龍又有什麼了不起的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "夜貓子"
				},
				{
					"id": 750280106,
					"content": "#橫豎都要被更強的煞星打劫，那我為什麼不跟這邊的{M#大兄弟}{F#好姐姐}混？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "夜貓子"
				},
				{
					"id": 750280107,
					"content": "#{M#大兄弟}{F#好姐姐}，不是我自誇，但我絕對比{F#妳}{M#你}帶的這兩個拖油瓶伶俐多了，有什麼事您招呼我，包准給您安排得服服貼貼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "夜貓子"
				},
				{
					"id": 750280108,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "我正好缺個小弟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "#{F#妳}{M#你}不會真的想帶著他吧？不行不行！我不同意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750280112,
					"content": "#而且你們根本就是壞蛋吧！我們可是正派人士，才不會跟龍販子為伍，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750280113,
					"content": "不會有比我更正派的人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#咳，總之你們也不要打龍的歪主意了，不然我們…{NICKNAME}一定你們知道厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750280118,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "兩個龍販子悻悻地離開了…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "不知道那隻絨翼龍狀況怎麼樣了，去看看牠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750280114,
					"content": "也不一定，有通融的餘地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#{F#妳}{M#你}這樣說會帶壞{REALNAME[ID(2)|SHOWHOST(true)]}的啦！小傢伙，放心好了，我們不會跟龍販子一夥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750280116,
					"content": "唔…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "謝謝你的好意，不過不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
