			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050101,
					"content": "這邊有一些丘丘人生活的痕跡，會是委託裡涉及到的那些丘丘人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050102,
					"content": "#委託？說起來，{F#妳}{M#你}們還沒告訴我…為何{F#妳}{M#你}們會出現在這裡，一般的旅行者可沒理由涉足層岩巨淵之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050103
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050103,
					"content": "我們是接到冒險家協會的委託，來調查層岩巨淵內丘丘人反常聚集的事件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050104,
					"content": "一路下來，終於在這裡發現了線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050105,
					"content": "#{F#妳}{M#你}們想要答案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050106
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050106,
					"content": "欸？戴因知道些什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050107,
					"content": "碰巧知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050108,
						80050109
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050108,
					"content": "我怎麼沒發現？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				},
				{
					"id": 80050110,
					"content": "#{F#妳}{M#你}們無法察覺異樣也情有可原。此地的怪異，其實在於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050111,
					"content": "…這裡的環境正在削弱「詛咒」的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050112
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050112,
					"content": "詛咒！我記得之前說過，戴因作為坎瑞亞的國民，身中不死詛咒什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050113,
					"content": "幾百年來，詛咒帶來的苦痛依舊每天都在糾纏我。而來到此地，身體卻感覺得到了片刻的喘息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050114
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050114,
					"content": "此時此刻，我的身體也正在向我表達著強烈的意願，那就是——「留下來」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050115
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050115,
					"content": "削弱詛咒…這裡為什麼會有這樣神奇的效果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050116,
					"content": "這也是我想要查明的，不過據我所知，深淵教團還尚未擁有實現類似效果的技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050117,
						80050118
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050117,
					"content": "也就是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050119,
					"content": "#嗯，{F#妳}{M#你}知道為何丘丘人都戴著面具嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050120,
						80050121
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050120,
					"content": "我有所瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050122,
					"content": "因為它們都在迴避著自己如今的面貌，害怕著水中的倒影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050123
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050123,
					"content": "畢竟那和它們記憶中的自己相比，太過醜陋，也太過絕望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050124
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050124,
					"content": "果然丘丘人也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050125
					]
				},
				{
					"id": 80050125,
					"content": "不死詛咒其實…也並非真正永久的「不死」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050126
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050126,
					"content": "難道還有逆轉的機會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050127,
					"content": "不。而是在「磨損」的作用下，靈魂與肉體依舊會被消磨殆盡，哪怕不是以「死亡」這一形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050128
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050128,
					"content": "當那些丘丘人意識到自我的終結將至，似乎會本能地找尋一個安靜又黑暗的角落，與幾百年來的苦痛道別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050129
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050129,
					"content": "而能夠削弱詛咒效果的此地，對它們來說一定是最好的靈柩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050130
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050130,
					"content": "居然…會是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050131,
					"content": "閒聊到此為止，警戒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050132
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050132,
					"content": "怎麼、怎麼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050133,
					"content": "敵襲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050121,
					"content": "我不太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050118,
					"content": "來到此處的丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050109,
					"content": "和那座倒著的城市有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				}
			]
		},
		{
			"id": 800503,
			"completionStepIds": [
				800503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800503",
							"2"
						],
						"stepId": 800503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050301,
					"content": "剛才那些是…為什麼忽然襲擊我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050302,
					"content": "「黑蛇騎士」，曾隸屬於坎瑞亞宮廷衛隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050303
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050303,
					"content": "等等！宮廷衛隊…他們曾經是你的下屬嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050304,
					"content": "曾經是。可是如今他們身上那強烈的詛咒氣息，還有捨棄了所有榮耀的戰鬥方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050305
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050305,
					"content": "…已經是深淵的爪牙了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050306,
					"content": "…先前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050307,
					"content": "啊，戴因…",
