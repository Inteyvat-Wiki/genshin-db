						726910203
					]
				},
				{
					"id": 726910203,
					"content": "拜託了，要<color=#00E1FFFF>四張</color>稻妻區域特產的畫片就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊內"
				}
			]
		},
