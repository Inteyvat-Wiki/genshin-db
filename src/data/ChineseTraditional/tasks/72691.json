					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "讓我看看…果然都是我之前從沒見過的物產！噢，這張拍得真不錯！這張似乎也很值得一寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910304,
					"content": "#朋友，多虧了{F#妳}{M#你}們拍攝的畫片，我一下子就有了靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910305,
					"content": "#根據{F#妳}{M#你}們提供的畫片，我試著寫了幾種不同的詩句，要使用哪一句，還真是讓人為難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910306,
					"content": "#我有些好奇{F#妳}{M#你}的意見，如果是{F#妳}{M#你}會用哪句呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊內"
				}
			]
		},
