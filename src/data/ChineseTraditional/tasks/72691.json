			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#小哥}{F#姑娘}，我看{F#妳}{M#你}在這會場上徘徊了很久，應該也是懂得欣賞文藝的風雅之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910102,
					"content": "#現在有件風雅之事想請{F#妳}{M#你}幫忙，不知道{F#妳}{M#你}意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910103,
					"content": "請講。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "我和這位蒙德來的吟遊詩人，萊內先生，一見如故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910105,
					"content": "大伴先生說的很對，雖然我和他認識才幾天，但他的學識涵養讓我非常欽佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910106,
					"content": "呵呵，萊內先生客氣了。總之，我們二人決定以詩會友，趁著這段時間一起創作一些作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910107,
					"content": "既然風塵僕僕來到了稻妻，那麼萊內先生也很想在作品中加入一些有稻妻特色的內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910108,
					"content": "對，只可惜這次來稻妻的行程太緊，沒有時間到處遊覽採風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910109,
					"content": "所以，我能做些什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "朋友，我正在寫一首主題是「鄉愁」的詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910111,
					"content": "遊子看到異鄉的風景，往往不自覺地回憶起故鄉，所以我想在詩裡加入一些異鄉獨有的意象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910112,
					"content": "#不知道{F#妳}{M#你}能否用留影機拍攝一些畫片，幫助我尋找創作靈感呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910113,
					"content": "稻妻應該有許多獨特的風物吧？比方說，一提到蒙德，大家就會想起「蒲公英」和「風車菊」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910114,
					"content": "喔喔，我明白啦，既然這樣，去拍攝一些稻妻區域特產的畫片就可以了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726910115,
					"content": "#嗯，那就拜託{F#妳}{M#你}們了！我把目前這首創作到一半的詩，也抄一份留給{F#妳}{M#你}們做參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910116,
					"content": "至於拍攝數量，我想有<color=#00E1FFFF>四張</color>內容不同的畫片就差不多了，我也會為你們提供相應的旅費報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726910117,
					"content": "#{NICKNAME}，既然萊內先生的要求已經都清楚了，那我們就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
