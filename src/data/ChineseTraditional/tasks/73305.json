					"content": "沒什麼…是演習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733051204,
					"content": "哦哦，沒什麼啦，是「演習」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "派蒙"
				},
				{
