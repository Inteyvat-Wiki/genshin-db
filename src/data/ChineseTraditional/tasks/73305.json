			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050402,
					"content": "#唔…利露帕爾，{F#妳}{M#你}還好嗎？怎麼突然沒反應啦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050403,
					"content": "噓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "#等等，{F#妳}{M#你}看…她在發光呢。跟平常不太一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050406,
					"content": "#鎮靈的魔瓶微微閃光，似乎與「棋子」的振動同調。\\n{F#妳}{M#你}聽到時間在流逝，就像監牢中的水滴聲…似乎長達一生，又或短則一瞬。\\n而利露帕爾沒有說話。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "#然後，迷霧中{F#妳}{M#你}看到了那座巨城，龐大、臃腫而冷漠。\\n大地張開裂口，吞沒了居爾城的一切…\\n而它的城門就在那裡，鑲嵌在山壁之上，它如此醜陋，彷彿集聚了古老世界的一切汙穢，卻免於為眾目所觀…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "它在那裡，居爾城。我記起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050409,
					"content": "我的頭好痛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "#嗚哇，{F#妳}{M#你}們怎麼回事啦…下次再這樣提前通知我呀！不要總是嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050411,
					"content": "對不起啦，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "哼，反正我是生氣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050415,
					"content": "#噗…小孩子一樣呢，好啦，不要擔心了。我會把{M#他}{F#她}還給妳的，小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050416,
					"content": "#到時候，{M#他}{F#她}還要賠償你好多好吃的呢…嗯，還有「牟拉」，你們的錢幣，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050417,
					"content": "是「摩拉」…我為什麼要糾正妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "這還差不多嘛…我記下來囉！好吃的，還有摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050420,
					"content": "好了，兒童時間結束，我們前往居爾城吧，我的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050421,
					"content": "我們為什麼要去那裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "為什麼？我不知道…或許理由根本不重要，但我需要去那裡。所以，我的大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050423,
					"content": "如果非要一個理由，那麼就是我希望您見證我的過去，見證我的教訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050428,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050429,
					"content": "雖然沒頭沒尾的…我也沒聽太懂就是啦，但妳這話說得好像要告別一樣，是發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050430,
					"content": "#哈哈，沒什麼…只是，有些東西，我想要讓{F#妳}{M#你}們見識一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050431,
					"content": "什麼嘛，一把年紀了說話還吞吞吐吐的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050432,
					"content": "總之，請您跟著我前來吧，我為您指引居爾城的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050424,
					"content": "居爾城…那裡有什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "什麼都沒有，什麼也沒有留下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050426,
					"content": "殘留在那裡的，只有鬼魂的回憶、無法復原的碎夢和復仇甜美的餘味…我會這樣說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050427,
					"content": "雖然這個請求有點過分…但我希望您見證我的過去，見證我的教訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050418,
					"content": "不要擅自替我下決定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "我沒事，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "#哼，每次{F#妳}{M#你}都這麼說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050404,
					"content": "利露帕爾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330506",
							"2"
						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "嗚哇！剛剛我們還在「棋子」旁邊，「唰——」的一下就到這裡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050602,
					"content": "這是怎麼回事呀，好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050603,
					"content": "呵呵，還想再來一遍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050604,
					"content": "再來一遍，再來一遍！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "#收斂點啦！{F#妳}{M#你}是小孩子嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050608,
					"content": "很正常，座標偏轉了。可能是因為老化的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050609,
					"content": "欸…這不是我們最初來過的那座峽谷嗎？妳帶我們來這裡做什麼呀？這裡有什麼值得一看的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050610,
					"content": "問題太多了，小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050611,
					"content": "奇怪…應該就在這裡的…啊，在這！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050606,
					"content": "還是不了，我有點暈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "唔…這麼說來，我也有點暈暈的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "#隨著閃光的碎片匯入利露帕爾的魔瓶，{F#妳}{M#你}感到自身的力量也被抽離了少許…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "「希魯伊，正是胡拉姆丁。」\\n頭戴黃銅面具者如是說。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "「你名下的人必不留後；我必從你神的廟中除滅諸多偶像；我必因你卑鄙，使你歸於墳墓。」\\n頭戴黃銅面具者如是說。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "#從鎮靈恍惚的目光中，{F#妳}{M#你}望見了居爾城被黑暗吞沒時的景象…\\n居爾城自古如蓄水大池，如今住民卻如洪流般四散奔逃。\\n毫無智性的鎮靈從冷酷的機械、兵士們的武器之中噴湧…朱紅的酒，石榴的汁液隨之而至，爆散而出…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "石榴翻滾開裂，又被踐踏成泥、混作一團…飽滿或萎縮、富貴或卑賤…猩紅的果實紛紛呼號著胡拉姆丁的到來——生命的歡樂，復仇的歡欣。\\n汁液的滋味甜美醇厚如醴，泉湧滿城，化作紅色的汪洋大海…\\n大海先淹沒奴隸，然後主子才漂浮在黑夜的汪洋中哀嚎。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "#最後，{F#妳}{M#你}望見黃銅面具的王。他遁入陰影，遁入希琳的懷抱…\\n她的容顏蒼老模糊，生命與理智的痕跡如夜風中的塵埃般消逝了。\\n還有那化為黑色魔獸的基斯拉王…他們皆是{F#妳}{M#你}的血脈，但{F#妳}{M#你}卻為此欣喜不已——{F#妳}{M#你}為報應而狂喜。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "居爾城啊，你的創傷無法救治，你的羞恥為眾目所觀…\\n聽見這消息的人必鼓掌歡呼——\\n因為誰沒受過你無休止的暴虐呢？",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "「居爾城啊，你的創傷無法救治，你的羞恥為眾目所觀…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050909,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "奧爾瑪茲曾是利露帕爾的愛人，他因鎮靈的愛而從牧羊人成為人中之王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050912,
					"content": "我曾以為他會是超越凡人的伴侶，我愚蠢地愛上他的雙眼…但為王的虛榮與自私終究攫住了他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050913,
					"content": "他與朝生暮死的凡人諸王沒有任何區別…只知徜徉在征服與迫害的迷夢之中，以流沙為基搭建宮闕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050914,
					"content": "於是，妳謀害了他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "我說過，我懲罰了他。由父及子，直至三代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050916,
					"content": "基斯拉·帕維茲拉萬、希琳，皆是我的血脈…我用血的陰謀、蜜的極刑，與狂暴的野心，懲罰了他們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050917,
					"content": "不僅如此…唉，不僅如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050918,
					"content": "關於「懲罰」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "虛榮的帕維茲拉萬，我的愛子…他想要無窮的權力，我便給了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050921,
					"content": "我為他設計了用鎮靈殘魄驅使的機械，在深黑的夢中啟發他建立起流水般吞吐人工造物的龐大機械…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050922,
					"content": "它們帶來了無窮的財富，卻也奪走了勞役者的生命力，剝奪了農人的財產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050923,
					"content": "王公與富商們紛紛含淚激賞——這是凡人的凱旋，這是奴役的結束。但我明知，只有我明曉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050924,
					"content": "奴隸的取締，正是無窮殘虐奴役的開始——奴隸主被解脫了撫養奴隸的義務，而奴隸被剝奪了免於飢餒的小小恩惠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050925,
					"content": "我…我已經開始聽不懂了…妳這是在說什麼呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050926,
					"content": "貧苦伴生仇恨，仇恨催化野心…富裕蔓生貪婪，貪婪亦燃發野心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050927,
					"content": "野心令他逼迫王后希琳——亦是他的親生姐姐產出無智性的畸形鎮靈…而她的痛苦取悅了我，也給我力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050928,
					"content": "…令我得以將他們的骨肉撫養長大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050929,
					"content": "妳是說希魯伊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "希魯伊，就是「黃銅面具」胡拉姆丁。賤民與奴隸視他為女主人的使者，視他如苦難中降臨的拯救者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050931,
					"content": "於是，他引導他們擁抱正義…擁抱滅亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050935,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050936,
					"content": "嗯？原來妳還在這呢，小傢伙…怎麼不說話了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050937,
					"content": "嗯…只是，我完全沒聽懂…而且，聽起來好可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050938,
					"content": "沒什麼，沒什麼…我剛剛所說的都是我的過去，與我的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050939,
					"content": "哦…我…我不知道該說什麼啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050940,
					"content": "多謝您的陪伴，我才能再度回到女主人的花園…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050941,
					"content": "欸…為什麼突然說這個呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050942,
					"content": "居爾城，是我的命運之地。我要返回這座城中，還有使命在等著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050943,
					"content": "唔…因為妳以前做了很多錯事，所以妳要回去彌補…是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050944,
					"content": "錯事…？噗…我沒什麼做錯的事。但我的孩子們還在那裡，她和希魯伊…一定很寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050945,
					"content": "妳的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "漆黑的力量愈發強大了…能直面它的，只有母親的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050947,
					"content": "我曾以為我能利用漆黑的深淵，對我所憎恨的施以懲罰…但我業已遭受了報應…進入居爾城，直面它的報復，也將是我的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050948,
					"content": "我的大人…很抱歉，沒能多陪在您的身邊一會，沒能多熟悉您片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050949,
					"content": "但我明白，命運一定會驅使我們再次相見。您擁有不受腐化的品質，我相信…我的選擇會是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050950,
					"content": "妳的選擇…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "常理來說，並非主人選擇鎮靈，而是鎮靈選擇主人。即使離去，我想我們的聯繫也不會這樣簡單地結束…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050953,
					"content": "所以…請接受我的最後一件禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050954,
					"content": "請您將我捧在耳邊…再一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050955,
					"content": "#{F#妳}{M#你}將魔瓶輕輕捧在耳邊…\\n伴隨著一陣輕笑，{F#妳}{M#你}聽到有人用無比柔和雅致的語言在{F#妳}{M#你}的耳旁柔聲低語…\\n她所傾訴的東西就像泉流一樣難測，但{F#妳}{M#你}一字不落地聽懂了。\\n最後，話語消散，僅在{F#妳}{M#你}的耳廓留下一絲清冷的餘韻…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "#透過她的指點，{F#妳}{M#你}熟識了古代的韻文…\\n但她卻不再言語。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "#欸…{F#妳}{M#你}看，瓶子裡的光變暗了…利露帕爾，妳還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050958,
					"content": "利露帕爾…利露帕爾…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050959,
					"content": "（瓶子的光芒漸暗，又逐漸恢復了閃爍。但她已經不再言語。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050960,
					"content": "她離開了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "這樣嗎…結果，真的是告別呀…我們以後還會再見到她嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050963,
					"content": "唔…我們…也回去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733050961,
					"content": "居爾城…在等待著她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "妳要離開了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "「黃銅面具」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "啊…胡拉姆丁，就是戴黃銅面具的希魯伊王。「女主人的使者」、「窮困者與奴隸的拯救者」，哈哈，高明的騙子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050934,
					"content": "終究，他引導那些追隨他的人歸於漆黑的滅亡…連同這整座居爾城，被大地吞入漆黑的裂口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733050919,
					"content": "關於居爾城的結局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "所以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
