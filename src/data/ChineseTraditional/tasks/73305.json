	"talks": [
		{
			"id": 7330504,
			"completionStepIds": [
				7330504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
