			"dialogs": [
				{
					"id": 733052201,
					"content": "請將我與那座「棋子」相連吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733052202,
					"content": "相…相連…？那是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733052203,
					"content": "從它的表面找到突出物，然後插入我瓶子的插槽裡，就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733052204,
					"content": "欸…還有那種東西嗎？妳的瓶子看起來明明挺光滑的…也沒有能插的地方呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733052205,
					"content": "妳看不到而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733052206,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733052207,
					"content": "因為是我剛剛亂編的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733052208,
					"content": "哦…喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733052209,
					"content": "噗…好了，不開玩笑了。我的大人，您只需要帶著我，接觸那座「棋子」即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
				}
