				{
					"id": 733051201,
					"content": "…小心，在地下深處，有奇特的震動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 733051202,
					"content": "#欸？{F#妳}{M#你}有感覺到什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
