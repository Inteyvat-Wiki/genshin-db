					"content": "等等——什麼「演習」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733051206,
					"content": "噓…他們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
