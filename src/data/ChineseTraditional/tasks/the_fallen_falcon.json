			"dialogs": [
				{
					"id": 732820201,
					"content": "#北方的遺蹟，{F#妳}{M#你}們最初遇見的地方附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820202
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820202,
					"content": "這是她的選擇…希望您能夠加以尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塞拉"
