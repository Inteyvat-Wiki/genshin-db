		},
		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "#{F#妳}{M#你}果然會來，我很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820402,
					"content": "#我聽說{F#妳}{M#你}在找我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "我一直覺得這個時刻的沙漠，很好看。我很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820405,
					"content": "但是可惜…一直沒有機會和朋友一起，在這裡，就這樣看太陽慢慢落下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820406,
					"content": "是啊，整個沙漠都被染成紅色了…很漂亮，好安靜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820407,
					"content": "不過，塔德菈，妳特地叫我們來就是為了這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820409,
					"content": "#對於塔尼特，{F#妳}{M#你}是客人，對「獵鷹」來說，也是潛在的「獵物」…但我希望，活下來的是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820410,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "所以，對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820403,
					"content": "最近過得如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328206",
							"2"
						],
						"stepId": 7328206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "可惡…馬塞拉那傢伙不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820602,
					"content": "他留下了這張字條…哼，老狐狸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732820603,
					"content": "若您看到這張字條，那麼我已經深入峽谷之中的避難所了。\\n若您的首級還在兩肩中間，請不要為塔德菈的選擇悲傷。\\n\\n這場狩獵並非結束，而是風暴的開始。\\n塔尼特長老，獵人馬塞拉，特為您發出警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "調查"
				},
				{
					"id": 732820604,
					"content": "他說的這些…看不明白是什麼意思呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820605,
					"content": "看來出於某種壓力，這傢伙離開了部族…並且留下了警告給您。哼，塔尼特…暗潮洶湧呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
