			"trigger": {
				"objectNames": [
					"馬塞拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "啊，您來了！請您留步，這恐怕是我最後一次拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820102,
					"content": "請說吧，有什麼需要幫忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "是塔德菈，她想要找您談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820106,
					"content": "欸…什麼事呀，這麼正式的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820107,
					"content": "#北方的遺蹟，{F#妳}{M#你}們最初遇見的地方附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820108,
					"content": "你說什麼…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "#北方的遺蹟，{F#妳}{M#你}們最初遇見的地方附近…別忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820110,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "嗯，請您好好待她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732820104,
					"content": "我還有別的事情要忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "請您務必聽我說…塔德菈想要找您談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "馬塞拉"
				}
			]
		},
		{
			"id": 7328202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
