				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "（她局促地別開目光。然後緊張地低下了頭。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822802,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "抱歉，狩獵已經結束了。我是父親的「獵鷹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822804,
					"content": "不過…我很好，請您不要擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822808,
					"content": "這麼極端嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "極端…？我不知道，我從懂事起就是這樣活著的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822814,
					"content": "#啊…不過…{F#妳}{M#你}和派蒙的故事，{F#妳}{M#你}們的旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822815,
					"content": "#有機會的話，我想多聽{F#妳}{M#你}講講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822816,
					"content": "好呀，我們有好多好多故事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732822817,
					"content": "嗯，我會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822820,
					"content": "#咳咳，沒什麼，我只是很高興…謝謝{F#妳}{M#你}…呃，您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822818,
					"content": "妳想聽的話，我隨時可以跟妳說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "妳沒想過為自己而活嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822812,
					"content": "…不，沒有。沒想過，沒期待過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822813,
					"content": "沙漠很冷酷，沒有閒暇考慮自己。沒有我，還有很多人能活，但沒有部族…我沒辦法一個人活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822805,
					"content": "關於妳和馬塞拉的關係…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "我說過，他是我的父親，我是他的「獵鷹」。我跟隨他的指令，為他而獵，為他而死…因為他代表了塔尼特的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822807,
					"content": "假如我什麼時候無法貫徹父親的指令了，那麼作為「獵鷹」的生命就這樣結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "塔德菈"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
