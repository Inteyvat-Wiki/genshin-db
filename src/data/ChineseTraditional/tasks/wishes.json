	"talks": [
		{
			"id": 202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210201,
					"content": "這不是凱旋的旅行者嗎，到神社可是來還願的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210202,
					"content": "不是妳叫我們來的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210203,
					"content": "#哈哈…開個玩笑，我正在等{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210204,
					"content": "神子的心情好像很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210205,
					"content": "是啊，難得和多年未見的老友敘敘舊，怎麼說都是件值得開心的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210206,
					"content": "#話說…我後來才聽說，{F#妳}{M#你}居然和愚人眾的執行官來了場御前決鬥，這膽識實在值得讚許。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210207,
						20210208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210207,
					"content": "只是突發奇想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				},
				{
					"id": 20210209,
					"content": "#能正面挫敗那個「女士」，{F#妳}{M#你}的實力也已經超過我的預測了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210210,
					"content": "但總之，能贏就好，可喜可賀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210211,
					"content": "終於讓愚人眾的計畫好好受挫了一次，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210212,
					"content": "至少這次，沒讓他們成功帶走「神之心」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210213,
					"content": "#等等，{F#妳}{M#你}們提到了「神之心」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210214,
					"content": "是那個像棋子一樣的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210215,
					"content": "對呀對呀，神子也見過嗎？歸七神所有，與天空島相連的「神之心」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210216,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210217,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210218,
					"content": "那個東西，被我交出去了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210219,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210220
					]
				},
				{
					"id": 20210220,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210221,
					"content": "#不然的話…{F#妳}{M#你}以為我用什麼從「散兵」的手裡換回了{F#妳}{M#你}的命呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210222,
						20210223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210222,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210224,
					"content": "「散兵」如今可是愚人眾執行官的第六席，論實力，還在「女士」之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210225,
					"content": "我可不是那種動不動就拼上自己性命的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210226,
					"content": "我竟然，一時間不知道該說什麼好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210227,
					"content": "可是，「神之心」為何會在妳手裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210228
					]
				},
				{
					"id": 20210228,
					"content": "影自從創造了人偶的形體以後，「神之心」便無處安放了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210229,
					"content": "作為曾經與影關係最密切的朋友…影將「神之心」交到我手上，並保管在鳴神大社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210230
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210230,
					"content": "她本身就已經不再需要「神之心」的力量，據她說，她也已經與天空島斷絕了聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210231,
					"content": "既然如此，「神之心」便是無用又只會招致紛爭之物罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210232
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210232,
					"content": "所以，用它換回「計畫」的核心人物，不是一件非常划算的買賣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210233,
					"content": "而且從結果來看，我確實賺到了啊，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210234,
					"content": "這麼說，也是…在我心裡，旅行者好像也是比一顆神之心要值錢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210235,
						20210236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210235,
					"content": "難怪後來沒再見到「散兵」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210237,
					"content": "唉，算了算了，事已至此應該也追不回來了吧，過去的就先讓它過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210238,
					"content": "所以，神子還沒說，這次叫我們過來究竟是要做什麼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210239,
					"content": "#呵呵，是要答謝{F#妳}{M#你}們喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210240
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210240,
					"content": "真的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210241,
					"content": "#既然{F#妳}{M#你}們一直在全提瓦特旅行，如今稻妻之旅也該告一段落了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210242,
					"content": "作為酬謝，不論是今後的路還是過往的疑惑，就由我來為兩位一併解答吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210243
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210243,
					"content": "有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "關於「人偶」將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人偶」將軍的技術源自于某些現今已然失落的知識，或許只有身為神明的她才能知會其中源頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "#不過…倒是有件事{F#妳}{M#你}們應該會感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "在影開始對自己的神明之軀進行自我改造之前，還憑空創造過一個「原型人偶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "那、那難道有三個雷電將軍！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210306,
					"content": "不，那個原型只是為了驗證可行性，外貌和智能都沒有依託影的自身去設計，可以說算是試做品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "按照最初設想，影應當將他直接廢棄，但也許影認為這樣做過於殘酷，便選擇只將他體內的力量封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "後來，他便像個普通人一樣，憑藉自我意識流浪在稻妻的土地上，直到…愚人眾看中了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210310,
					"content": "而那個原型人偶經過愚人眾裡某些奇人異士的調整，解除了力量的封印，甚至比封印之前更強大也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "莫非…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "嗯，神之造物親手奪去了神之心…那個原型人偶便是如今的「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "居、居然還有這樣的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210314,
					"content": "是啊，究竟是機緣巧合，還是天命註定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "關於前任雷電將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "#{F#妳}{M#你}這個異鄉人居然知道雷神曾經更易過的事…這在稻妻的國民之中也是鮮有人知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "是摩拉克斯曾經提及過，雷神巴爾也已經逝去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210404,
					"content": "嗯，事實是這樣的，「巴爾」與「巴爾澤布」其實是一對雙生魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "雙生…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210406,
					"content": "她們共同贏下魔神戰爭，而後來巴爾建立幕府後，巴爾澤布則以御側「影武者」的身分，成為巴爾的替身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "#巴爾澤布便是{F#妳}{M#你}我熟悉的「影」，而巴爾，其名則為「真」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "在世人眼中，她們二者向來都是統一的存在，她們兩人也一直相互補足，共同治理稻妻，因而民眾也沒有知曉真相的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "不論是「巴爾」這個魔神名諱，還是雷電將軍這個稱謂，其實一直都可以看做是同時指稱她們兩人的，直到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "直到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210411,
					"content": "直到真死於數百年前的一場我未能親身經歷的戰爭，自那以後影才來到了幕前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "一定對影的打擊很大吧，是姐妹的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210413,
					"content": "數百年前的…戰爭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "所以影的轉變也是從那時開始的，對她來說這是最大的「失去」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "原來還有這樣的往事，好像更加理解影一些了…那麼「真」是一個什麼樣的神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210417,
					"content": "我與她相處的時間並不算長，印象裡…是個溫柔的神吧，總是珍惜著眼前的一切美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210501,
					"content": "#關於我的{F#哥哥}{M#妹妹}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "#抱歉，這個我沒什麼頭緒，我對{F#妳}{M#你}們所說的那位神明也並不瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "#但如果{F#妳}{M#你}們還在懷疑影的話，我覺得就有些多慮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "#影不僅不符合{F#妳}{M#你}們之前的描述，而且很久以前便主動放棄神之心，斷絕了與天空島的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "見過以後，感覺確實不是她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "那就好，不然的話，作為雷神眷屬，好像我們的關係就會一下子微妙起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "放心吧，我們不會想和妳打架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210508,
					"content": "#呵呵呵…祝{F#妳}{M#你}們早日達成目的，知曉一切真相吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#至於{F#妳}{M#你}{F#哥哥}{M#妹妹}的蹤跡，我會盡我所能利用一切資源去調查的，包括從綾人那裡借用一些終末番的手下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "#有消息我會通知{F#妳}{M#你}，就算是酬謝的一部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "關於旅途的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "離開稻妻以後的話，我想…去往須彌應該會比較方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "須彌呀，我們一路上見過很多來自須彌的學者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210604,
					"content": "嗯，須彌是智慧之神的國度，他們對智慧與知識的探求是永無止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "但這份執著往往也會衍生出一些令人費解的事，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…在須彌，知識是作為一種「資源」而被統一管理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知識…也是資源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210608,
					"content": "嗯，只是不知道做出這種決定的究竟是那些「賢者」，還是「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「小吉祥草王」？有些可愛的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210610,
					"content": "#欸，原來{F#妳}{M#你}們還不清楚嗎，「小吉祥草王」便是須彌所信仰的神明，是須彌人對她的暱稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "#想必{F#妳}{M#你}們也有些事情想要找她確認吧？祝{F#妳}{M#你}們順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "沒什麼想問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "#這樣啊，那好吧。喔對了旅行者，我送給{F#妳}{M#你}的御守，{F#妳}{M#你}還留著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "當然，我會好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "好好保管，僅此而已嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "#我還以為{F#妳}{M#你}會將它掛在胸前最顯眼的位置，以後逢人便說，這可是兼具智慧與美貌的八重神子大人贈予我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "誰會那樣做呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210707,
					"content": "#呵呵…好了好了。說起來，旅行者，{F#妳}{M#你}的願望又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
					"content": "#嗯…與{F#哥哥}{M#妹妹}再次團聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "#這樣嗎…但我覺得，那或許只是{F#妳}{M#你}目前的一個小小目標而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210710,
					"content": "#對{F#妳}{M#你}來說，「願望」應當是可以跨越塵世和星海，與命運一同閃耀之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210711,
					"content": "#{F#妳}{M#你}沒有神之眼，或許是因為那個願望尚未誕生…也說不定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210712,
					"content": "#就在{F#妳}{M#你}接下來的旅途中，去見證那一刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210414,
					"content": "難道說…是坎瑞亞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210236,
					"content": "原來我這麼值錢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210223,
					"content": "原來那個時候就已經…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210208,
					"content": "當時有點衝動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				}
			]
		},
		{
			"id": 202103,
			"completionStepIds": [
				202102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210243,
					"content": "有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "關於「人偶」將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人偶」將軍的技術源自于某些現今已然失落的知識，或許只有身為神明的她才能知會其中源頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "#不過…倒是有件事{F#妳}{M#你}們應該會感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "在影開始對自己的神明之軀進行自我改造之前，還憑空創造過一個「原型人偶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "那、那難道有三個雷電將軍！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210306,
					"content": "不，那個原型只是為了驗證可行性，外貌和智能都沒有依託影的自身去設計，可以說算是試做品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "按照最初設想，影應當將他直接廢棄，但也許影認為這樣做過於殘酷，便選擇只將他體內的力量封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "後來，他便像個普通人一樣，憑藉自我意識流浪在稻妻的土地上，直到…愚人眾看中了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210310,
					"content": "而那個原型人偶經過愚人眾裡某些奇人異士的調整，解除了力量的封印，甚至比封印之前更強大也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "莫非…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "嗯，神之造物親手奪去了神之心…那個原型人偶便是如今的「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "居、居然還有這樣的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210314,
					"content": "是啊，究竟是機緣巧合，還是天命註定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "關於前任雷電將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "#{F#妳}{M#你}這個異鄉人居然知道雷神曾經更易過的事…這在稻妻的國民之中也是鮮有人知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "是摩拉克斯曾經提及過，雷神巴爾也已經逝去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210404,
					"content": "嗯，事實是這樣的，「巴爾」與「巴爾澤布」其實是一對雙生魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "雙生…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210406,
					"content": "她們共同贏下魔神戰爭，而後來巴爾建立幕府後，巴爾澤布則以御側「影武者」的身分，成為巴爾的替身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "#巴爾澤布便是{F#妳}{M#你}我熟悉的「影」，而巴爾，其名則為「真」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "在世人眼中，她們二者向來都是統一的存在，她們兩人也一直相互補足，共同治理稻妻，因而民眾也沒有知曉真相的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "不論是「巴爾」這個魔神名諱，還是雷電將軍這個稱謂，其實一直都可以看做是同時指稱她們兩人的，直到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "直到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210411,
					"content": "直到真死於數百年前的一場我未能親身經歷的戰爭，自那以後影才來到了幕前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "一定對影的打擊很大吧，是姐妹的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210413,
					"content": "數百年前的…戰爭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "所以影的轉變也是從那時開始的，對她來說這是最大的「失去」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "原來還有這樣的往事，好像更加理解影一些了…那麼「真」是一個什麼樣的神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210417,
					"content": "我與她相處的時間並不算長，印象裡…是個溫柔的神吧，總是珍惜著眼前的一切美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210501,
					"content": "#關於我的{F#哥哥}{M#妹妹}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "#抱歉，這個我沒什麼頭緒，我對{F#妳}{M#你}們所說的那位神明也並不瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "#但如果{F#妳}{M#你}們還在懷疑影的話，我覺得就有些多慮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "#影不僅不符合{F#妳}{M#你}們之前的描述，而且很久以前便主動放棄神之心，斷絕了與天空島的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "見過以後，感覺確實不是她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "那就好，不然的話，作為雷神眷屬，好像我們的關係就會一下子微妙起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "放心吧，我們不會想和妳打架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210508,
					"content": "#呵呵呵…祝{F#妳}{M#你}們早日達成目的，知曉一切真相吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#至於{F#妳}{M#你}{F#哥哥}{M#妹妹}的蹤跡，我會盡我所能利用一切資源去調查的，包括從綾人那裡借用一些終末番的手下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "#有消息我會通知{F#妳}{M#你}，就算是酬謝的一部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "關於旅途的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "離開稻妻以後的話，我想…去往須彌應該會比較方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "須彌呀，我們一路上見過很多來自須彌的學者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210604,
					"content": "嗯，須彌是智慧之神的國度，他們對智慧與知識的探求是永無止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "但這份執著往往也會衍生出一些令人費解的事，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…在須彌，知識是作為一種「資源」而被統一管理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知識…也是資源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210608,
					"content": "嗯，只是不知道做出這種決定的究竟是那些「賢者」，還是「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「小吉祥草王」？有些可愛的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210610,
					"content": "#欸，原來{F#妳}{M#你}們還不清楚嗎，「小吉祥草王」便是須彌所信仰的神明，是須彌人對她的暱稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "#想必{F#妳}{M#你}們也有些事情想要找她確認吧？祝{F#妳}{M#你}們順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "沒什麼想問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "#這樣啊，那好吧。喔對了旅行者，我送給{F#妳}{M#你}的御守，{F#妳}{M#你}還留著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "當然，我會好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "好好保管，僅此而已嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "#我還以為{F#妳}{M#你}會將它掛在胸前最顯眼的位置，以後逢人便說，這可是兼具智慧與美貌的八重神子大人贈予我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "誰會那樣做呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210707,
					"content": "#呵呵…好了好了。說起來，旅行者，{F#妳}{M#你}的願望又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
					"content": "#嗯…與{F#哥哥}{M#妹妹}再次團聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "#這樣嗎…但我覺得，那或許只是{F#妳}{M#你}目前的一個小小目標而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210710,
					"content": "#對{F#妳}{M#你}來說，「願望」應當是可以跨越塵世和星海，與命運一同閃耀之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210711,
					"content": "#{F#妳}{M#你}沒有神之眼，或許是因為那個願望尚未誕生…也說不定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210712,
					"content": "#就在{F#妳}{M#你}接下來的旅途中，去見證那一刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210414,
					"content": "難道說…是坎瑞亞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				}
			]
		}
	]
}