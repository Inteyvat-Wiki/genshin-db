			"dialogs": [
				{
					"id": 740510301,
					"content": "太好了，映影機完好無損，裡面的映影也沒有被破壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510328,
					"content": "謝天謝地，我還以為又要從頭開拍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510302,
					"content": "你們為什麼在這裡拍映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "看起來你們也不是楓丹人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "這事情就說來話長了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510304,
					"content": "長話短說吧。我們三個人來自於璃月的「翹英莊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510305,
					"content": "莊裡的人大部分都是做茶葉生意的，但我們…對茶葉生意沒什麼興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510306,
					"content": "所以就轉了行，去幫莊裡的茶葉商拍宣傳用的紀錄映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510307,
					"content": "其實是做茶葉生意的人太多，我們原本的生意比不過他們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 740510308,
					"content": "店裡的好手也一個接一個地跑去別家做事，再做茶葉生意，我們就沒飯吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510309,
					"content": "你們兩個…就不能說點好聽的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510310,
					"content": "給莊裡的茶葉拍宣傳映影這件事，賺得也不少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510311,
					"content": "可是，最近莊裡也有其他人開始拍宣傳映影了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 740510312,
					"content": "有的映影裡還有人唱戲呢，派頭可大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510313,
					"content": "所以我們才來楓丹，尋求映影專家的建議啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510314,
					"content": "所以，你們是來楓丹學拍攝映影的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "沒錯。我們找到了一個名叫熱塞爾的「映影專家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510316,
					"content": "他很擅長在映影中用光影來…那什麼來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510317,
					"content": "「敘事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 740510318,
					"content": "對！用光影來「敘事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510319,
					"content": "有了熱塞爾先生的指導，我們一定能拍出整個翹英莊裡最好的映影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510320,
					"content": "老闆，你上個月才說要拍出整個璃月裡最好的映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510321,
					"content": "做生意就是要合理地調整自己對未來的預期…你懂什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510322,
					"content": "總之，感謝您的幫忙，旅行者，這些錢請您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510323,
					"content": "興曄、弈豐，趕緊把東西架起來！今天必須把樣片拍完，拿過去給熱塞爾先生看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510324,
					"content": "注意打光！鏡頭要…這樣對著光源，打出一個…有高級感的光線！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510325,
					"content": "你們都看過那本書了吧，光影要有質感，質感你們明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 740510326,
					"content": "老闆，雖然熱塞爾先生的那本書我們的確都看過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510327,
					"content": "但就憑這個鏡頭，就算我們再折騰，拍出來的光線質感也高級不到哪去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弈豐"
				}
			]
		},
