			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克洛琳德"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "說到逐影獵人，那處洞窟裡的「寶藏」要怎麼處理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340302,
					"content": "復歸原樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340303,
					"content": "真的嗎？不讓現在的人們來看看，記住他們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340304,
					"content": "不了。這是他們的選擇，這就是逐影獵人的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340305,
					"content": "就算是我，也只希望以決鬥代理人的身分繼續工作。我從不希望人們記住我「逐影獵人」的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340306,
					"content": "這和「魔術師」的道路還真不一樣。不過，我欣賞克洛琳德小姐的決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340307,
					"content": "咦？我突然想到，既然不是演出特效的話，那最後戰鬥時，我們的武器為什麼會發光呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340308,
					"content": "因為以前的逐影獵人，會在自己的武器中附上剋制魔物的術法。感應到魔物時，它們就會發出光芒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340309,
					"content": "哦！怪不得最後能封住那傢伙的行動呢。我還以為召喚真的奏效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140340310,
					"content": "可能多少也奏效了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340311,
					"content": "哦？這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340312,
					"content": "這個被封印的「噬魂獸」，我猜和那幾位逐影獵人來自同一個時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340313,
					"content": "你們所念出的名字，都是斬殺了它無數同類、最為英勇的獵人的名字。聽到這些名字後，它明顯畏縮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340314,
					"content": "原來名字還有這樣的作用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340316,
					"content": "…娜維婭，剛才在「召喚」的時候，妳說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340317,
					"content": "啊？呃…啊啊啊！那、那些都是真話，啊不，是戲中的真話啦！妳聽聽就好，別再讓我重複了，怪不好意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140340318,
					"content": "謝謝妳那麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340319,
					"content": "哎呀好啦，我們誰跟誰嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140340320,
					"content": "呃…不、不聊這個了！我走在前面，你們也要跟上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140340321,
					"content": "啊…她溜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140340322,
					"content": "那我也就此告辭吧，今天收獲了十分精彩的故事，可以回去和大家分享一整晚呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340323,
					"content": "後會有期。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "嗯，改日再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140340325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}…若是{M#你}{F#妳}的名字不被人記住，{M#你}{F#妳}的旅途不被人歌頌，那麼{M#你}{F#妳}覺得這趟旅途的意義何在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340327,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "就算不被記住，和同伴們共度的時光或許就是意義。和同伴們共同創造的未來，也是意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "…不錯的回答。我記下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340330,
					"content": "那妳又是怎麼看待的呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "我嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340332,
					"content": "「對於這個問題，那位逐影獵人沒再說什麼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340333,
					"content": "「就由這無聲的夜色，來替她回答吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				}
			]
		}
	]
