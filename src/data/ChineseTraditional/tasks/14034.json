			"dialogs": [
				{
					"id": 140340101,
					"content": "終於，你們來到了那個教{RUBY#[D]地下室}堂附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 140340102,
					"content": "周圍散發著不祥的氣息，你們已感覺到敵人幾乎近在咫尺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 140340103,
					"content": "（奇怪…還真有一股不舒服的感覺…這怎麼做到的？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140340104,
					"content": "接下來…就是決戰的時刻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德飾"
				},
				{
					"id": 140340105,
					"content": "我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "林尼",
					"speakerSubtitle": "逐影獵人"
				},
				{
					"id": 140340106,
					"content": "弗洛萊恩，等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340107,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340108,
					"content": "你在外面等我們，別進去。你曾經被噬魂獸侵蝕過一次，它很容易就能再次進入你的意識，奪走你身體的控制權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340109,
					"content": "而且還是離它本體這麼近的位置，被侵蝕之後的身體變成什麼樣都有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340110,
					"content": "正因如此，我才要去…我會走在最前面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340111,
					"content": "…！你是想要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340112,
					"content": "沒錯，我要引誘它進入我的身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340113,
					"content": "這太危險了。最壞情況下，我可能不得不殺死你。你明白這嚴重性嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340114,
					"content": "我明白，但這樣一來，你們的目標就更明確了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340115,
					"content": "它不會輕易從方便控制的身體中溜走，你也無需考慮同伴被附身的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340117,
					"content": "克洛琳德小姐，和我不同，妳是位強大而正直的逐影獵人。這是我犯下的錯，也理應由我自己來承擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340118,
					"content": "不如說…我非這樣做不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340119,
					"content": "妳就當是我以自己的名譽，而向妳發起的決鬥吧。請一定不要手軟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340120,
					"content": "…好，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340121,
					"content": "弗洛萊恩，我以決鬥代理人的名義，接受你的「決鬥申請」，並向你致以敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140340122,
					"content": "…謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "弗洛萊恩"
				},
				{
					"id": 140340123,
					"content": "走吧，該去做正事了。讓那魔物再次顫抖於獵人的劍刃之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				}
			]
		},
