				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "這…這是…我的「作案手法」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "內田幸太郎"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}！他居然直接就承認了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090403,
					"content": "啊！請別誤會，這是我打算寫進下一部小說裡的詭計，是我之前喝酒的時候想出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "內田幸太郎"
				},
				{
					"id": 708090404,
					"content": "沒想到酒一醒這頁紙就消失了…我差點以為自己是在做夢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "內田幸太郎"
				},
				{
					"id": 708090405,
					"content": "#總之，多謝{F#妳}{M#你}幫忙找回來。這下我的小說應該就能順產了，到時候我先送{F#妳}{M#你}一本！附簽名的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內田幸太郎"
				}
			]
		},
