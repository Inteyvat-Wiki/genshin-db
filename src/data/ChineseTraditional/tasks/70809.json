			"dialogs": [
				{
					"id": 708090501,
					"content": "哦？滿有趣的，讓我看看…嗯，創意可以給六分，可行性大概就四分吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090502,
					"content": "這…這是「犯罪計畫書」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090503,
					"content": "哈哈，其實我從駐地跑來這裡，就是聽說了有人在這裡盤算一些稀奇古怪的「犯罪計畫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090504,
					"content": "…不過看過這頁筆記之後，我大概知道那些流言是怎麼起來的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090505,
					"content": "這份「犯罪計畫書」就交給騎士團來處理吧。之後要是有空就來我的駐地逛逛，搞不好會有好戲哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				}
			]
		}
