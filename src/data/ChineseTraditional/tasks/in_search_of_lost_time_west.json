			"dialogs": [
				{
					"id": 740120501,
					"content": "嗚哇！好嚴格！我可絕對不想在這傢伙手下工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120502,
					"content": "還說什麼「集體榮譽感」…連飯都不給人吃，還有什麼榮譽感嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120503,
					"content": "他說的也不是沒有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "真是莫名其妙的規定啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "唔，紀律的確很重要啦…不過也沒必要做到這種地步吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120506,
					"content": "就是啊！越是不知道實務操作的傢伙，就越喜歡搞這種奇怪的紀律和規定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120507,
					"content": "咦？仔細想想的話，要是我們也敲鍋的話，說不定就能把那個叫舒米洛夫的小隊長給引下來了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120508,
					"content": "#這樣一來，我們說不定就能上去了…{NICKNAME}，我們快去試試看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
