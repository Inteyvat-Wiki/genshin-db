			"dialogs": [
				{
					"id": 206010701,
					"content": "#{F#妳}{M#你}回來了，傑克也回來了，但是一瘸一拐的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010702,
					"content": "到底發生什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010703,
					"content": "傑克因為冒進受傷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "果然和我想的一樣，唉…平時我和他說的話，他都沒怎麼記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010705,
					"content": "雖然我也理解他想要證明自己的心思，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010706,
					"content": "算了，這件事我已經瞭解了，傑克那邊我會去和他談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010707,
					"content": "#這是給{F#妳}{M#你}的，算是{F#妳}{M#你}冒險的獎勵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
