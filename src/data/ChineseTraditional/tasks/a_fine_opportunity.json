			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "嘶，痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010502,
					"content": "#謝謝{F#妳}{M#你}，我還以為自己回不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010503,
					"content": "你怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "哈，一點小傷…呃！一點…小傷，我沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010505,
					"content": "我是因為發現一群丘丘人正在向前面的營地裡集結，覺得它們想要做什麼，才跟了上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010506,
					"content": "…但我跟蹤調查的時候靠得太近，不小心就被它們發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010507,
					"content": "不說這個了，不用擔心我，請快點去把前面的丘丘人都清理掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010508,
					"content": "它們的數量越來越多，絕不能讓它們的陰謀得逞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010509,
					"content": "至於我…我會照顧好我自己的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
