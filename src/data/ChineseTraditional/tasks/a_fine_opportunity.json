						206010803,
						206010807
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010803,
					"content": "傑克戰鬥時很英勇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010804
					]
				},
				{
					"id": 206010804,
					"content": "#{F#妳}{M#你}和他並肩作戰了嗎？原來他是這麼受傷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010805
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010805,
					"content": "唉，英勇是好事…但我寧願他更加穩重一些，畢竟，活下來的冒險家才是冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010806,
					"content": "#旅行者，{F#妳}{M#你}和傑克的勇氣都值得嘉獎，這些東西{F#妳}{M#你}拿著，算是{F#妳}{M#你}冒險的獎勵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206010807,
