			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "#{F#妳}{M#你}已經清理掉那個營地了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010602,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "#{F#妳}{M#你}的實力可真強啊，要是我能像{F#妳}{M#你}一樣優秀就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010604,
					"content": "我也想留下斬殺惡龍、拯救世界的傳說，但到頭來連丘丘人都沒法勝過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010605,
					"content": "#呃，那個…雖然很不好意思，但是我有件事拜託{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010606,
					"content": "其實我這次之所以會去千風神殿調查，是因為我馬上就要「冒險等階評定」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010607,
					"content": "我想著如果能在這個時候展現出實力的話，等階評定一定會順利不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010608,
					"content": "但是沒想到，實力沒展現出來，反而差點把自己給賠進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010609,
					"content": "#能，能拜託{F#妳}{M#你}，別把我的慘樣告訴賽琉斯先生嗎？要是真的影響到「冒險等階評定」，那我就真的慘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010610,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "#太謝謝{F#妳}{M#你}了！我以後一定不會再這麼魯莽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010612,
					"content": "這樣不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "我知道這樣不好，賽琉斯先生也說「冒險家應該直面自己」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 206010614,
					"content": "但是…唉，算了，希望賽琉斯先生不會太生我的氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		},
		{
