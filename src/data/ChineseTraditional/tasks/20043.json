			"dialogs": [
				{
					"id": 200430401,
					"content": "#{F#妳}{M#你}找到<color=#00E1FFFF>日落果</color>了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430402,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "#拜託{F#妳}{M#你}了，城外應該有很多<color=#00E1FFFF>日落果</color>，我要看著攤子，請快去快回啊！",
