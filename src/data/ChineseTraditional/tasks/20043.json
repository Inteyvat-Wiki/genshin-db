			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "腰怎麼這麼痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430102,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "我正準備去工作，但是突然腰很痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430104,
					"content": "我已經和昆恩約好去他的水果攤幫忙，現在只能休息一下再去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430105,
					"content": "唉，但是光待在這裡也只是耽誤事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430106,
					"content": "#{F#妳}{M#你}能幫我去問問昆恩，他需要我做什麼工作嗎？我也好做些準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "#那就拜託{F#妳}{M#你}了，我只要休息一會就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430109,
					"content": "看起來也不遠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "喂，這麼點小事，幫個忙也沒關係吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
