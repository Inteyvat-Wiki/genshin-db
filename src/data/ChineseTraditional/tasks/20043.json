			"dialogs": [
				{
					"id": 200430301,
					"content": "怎麼還沒送來，糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430302,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "啊…攤子裡的日落果賣光了，我剛去訂了幾批日落果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430304,
					"content": "但是到現在也沒送來…好多客人都在等著買呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430305,
					"content": "光是優律小姐就來了三趟了，她就只要<color=#00E1FFFF>三顆日落果</color>，我可不想失去這個老顧客啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430306,
					"content": "我還要看攤子…要是誰能幫我去城外找點日落果回來就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430307,
					"content": "很急的話，我能幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "#{F#妳}{M#你}願意幫忙嗎？那太好了，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430309,
					"content": "蜜雪兒小姐馬上就來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "等一下！蜜雪兒小姐那個樣子，怎麼出去摘果子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430311,
					"content": "我們來幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
