			"dialogs": [
				{
					"id": 200430601,
					"content": "你們問昆恩先生了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430602,
					"content": "昆恩先生請妳回去休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "昆恩先生的店裡今天沒有什麼工作喔，請回去好好休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430604,
					"content": "是嗎，呼…看來要去找別的事做了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430605,
					"content": "咦，咦？！妳不去休息嗎？好不容易不用工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430606,
					"content": "你們感受一下四周，巴巴托斯大人的風還在勤勞地工作著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430607,
					"content": "我們這些被他庇佑著的人，也沒有偷懶的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "蜜雪兒"
				},
				{
					"id": 200430608,
					"content": "#不過，{F#妳}{M#你}是去做什麼事了，怎麼出了這麼多汗？",
