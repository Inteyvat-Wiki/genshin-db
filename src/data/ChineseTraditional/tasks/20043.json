			"dialogs": [
				{
					"id": 200430501,
					"content": "#{F#妳}{M#你}找到日落果了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430502,
					"content": "已經找好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "謝謝，這些應該就夠優律小姐買了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430504,
					"content": "唉，但是很多客人們還是走掉了，一個人果然還是忙不過來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430505,
					"content": "哦對了，謝謝你們幫忙，要給你們謝禮才行，稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430506,
					"content": "謝禮就不用了，我們有事情拜託你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430507,
					"content": "關於蜜雪兒小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "蜜雪兒小姐…你們遇見她了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430509,
					"content": "希望我交給她一點輕鬆的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430510,
					"content": "可是我一開始就只準備讓她幫忙看店啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430511,
					"content": "是，是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430512,
					"content": "不過現在客人們都走了，看來是不用人看店了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430513,
					"content": "麻煩你們告訴蜜雪兒小姐，讓她回去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430514,
					"content": "我等會準備去看看那批貨到底怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				}
			]
		},
