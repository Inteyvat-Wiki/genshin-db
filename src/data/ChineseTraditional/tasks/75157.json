			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"科奴拉芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751570101,
					"content": "嗚嗚…沒想到居然被關在這個籠子裡，「煙謎主」部族成員的尊嚴真是蕩然無存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570102
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570102,
					"content": "唉…唉…真是讓部族蒙羞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570103
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570103,
					"content": "是妳？這次又是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570104
					]
				},
				{
					"id": 751570104,
					"content": "唉呀，恩人…這次又見到您了，嗚…這次真是讓您看到我的醜態了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570105
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570105,
					"content": "唉呀恩人啊，上次我不是說過我的名字叫科奴拉芙，是「煙謎主」的實習祭司…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570106
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570106,
					"content": "現在正在祭司的修行途中，嗯…部族的長輩告訴我，我的先祖桑哈傑常常跟其他部族的人賭鬥，還把他們騙得團團轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570107
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570107,
					"content": "所以長輩們對我說：「去跟人賭鬥，然後獲得勝利吧！這樣做為煙謎主的人才能稱得上是合格啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570108
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570108,
					"content": "於是我路過這裡的時候看到比賽，我、我也下注了，什麼衛冕冠軍嵴鋒龍，什麼十年來最強新秀絨翼龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570109
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570109,
					"content": "最強的當然是我們「煙謎主」的暝視龍啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570110
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570110,
					"content": "結果輸得肝腦塗地…唔，不是，是輸得一敗塗地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570111
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570111,
					"content": "不僅因為賭暝視龍贏欠了錢，人還被關在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570112
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570112,
					"content": "「嘿，暝視龍要是拿得到冠軍，我們還妳十倍的錢，不然妳就在這個籠子裡待著吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570113
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570113,
					"content": "唉呀，這下怎麼辦啊！如果這時候有一隻暝視龍把那兩隻龍都揍一頓就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570114
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570114,
					"content": "這樣我就能從籠子裡出來，還可以拿到十倍的摩拉…啊，最主要是不能讓兩個部族的人，輕視偉大的煙謎主的偉大暝視龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570115
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570115,
					"content": "嗚…求求了，恩人，如果您能夠找到這樣一隻暝視龍的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570116
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570116,
					"content": "唉…我真的是在亂講話，恩人又不是煙謎主的人，到底是要去哪裡找這樣的暝視龍啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570117
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 751570117,
					"content": "我會盡力找找看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570118
					]
				},
				{
					"id": 751570118,
					"content": "真、真的嗎？恩人啊，那我就在這個籠子裡等、等您的好消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				}
			]
		},
