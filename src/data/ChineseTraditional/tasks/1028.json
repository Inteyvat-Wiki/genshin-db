						10280805
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280805,
					"content": "哈？發生了那麼大的事情，妳就叫我在這烤堇瓜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
