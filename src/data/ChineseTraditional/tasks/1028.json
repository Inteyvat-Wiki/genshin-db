			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "嗯？不對，怎麼搞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280402,
					"content": "我們…我們怎麼回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280403,
					"content": "這裡是我們走過的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280404,
					"content": "對，是起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280405,
					"content": "可我們沒走錯啊，剛才一路走的都是通往出口的路，沒有往回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280406,
					"content": "我也記得是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280407,
					"content": "#旅行者，{F#妳}{M#你}也確定沒錯對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280408,
					"content": "嗯，我覺得沒有走錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280410,
					"content": "在稻妻有種說法，商人晚上走夜路中了狸妖的奸計，整晚都在同一個地方繞個不停，直到天亮還走不出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280411,
					"content": "不就是鬼打牆嘛，我也知道哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280412,
					"content": "原來大家都知道，那就好辦了，我現在認為，我們就是遇到了這種怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280413,
					"content": "不過沒關係，我有個幫手能驅邪，遇到這種情況，就該叫他出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280414,
					"content": "一斗這個鬼，身邊竟然有驅邪的夥伴…他心可真大啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280415,
					"content": "遲鈍是老大過得好的資本嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280416,
					"content": "來吧，阿丑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280417,
					"content": "哞——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280418,
					"content": "這就是咱們荒瀧派編外成員，阿丑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280419,
					"content": "哞哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280420,
					"content": "#哦，阿丑在向大家問好呢。{F#妳}{M#你}們叫他阿丑也行，丑哥也行。阿丑可擅長找路了，一會就讓他帶我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280421,
					"content": "原來還有編外成員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280422,
					"content": "我覺得不像靠譜的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280423,
					"content": "誰知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280424,
					"content": "阿丑，去！給兄弟們找條明路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280425,
					"content": "哞——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280426,
					"content": "阿丑開始在四周尋找是否有隱藏的出口…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "哞…哞哞…哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280428,
					"content": "嗯？噢噢…啊？！不會吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280429,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280430,
					"content": "阿丑說，他沿路找遍了，根本沒有出口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280431,
					"content": "可我們既然能進來，沒理由出不去啊。不行…我去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280432,
					"content": "你們注意到了嗎？起初我們以為自己是從上空掉下來的，那時頭上還有高不見頂的出口…現在出口也消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280433,
					"content": "怎麼會這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280434,
					"content": "看來，地下這些建築不是我們想的那麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280435,
					"content": "…我四處檢查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280436,
					"content": "這裡四處都是岩壁，會不會…會不會是我們記錯了，其實我們根本不是從這裡掉下來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280437,
					"content": "喂，妳是在害怕嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280438,
					"content": "我、我可沒有那麼膽小！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280439,
					"content": "哞——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280440,
					"content": "阿丑也覺得妳害怕了。沒關係，害怕就說出來，我們保護妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280441,
					"content": "派蒙，有我在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#愣著也不是辦法，再找找路吧。阿忍，妳陪著恩人，我帶{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280443,
					"content": "好，大家都要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280444,
					"content": "恩人什麼的，言重了，叫煙緋就行。一斗先生不愧是幫派老大，很有領導力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280445,
					"content": "哪裡哪裡，妳叫我一斗就行。既然說好都是同伴，就該彼此照顧。派蒙，怕的話本大爺可以捂住妳的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280446,
					"content": "眾人兵分幾路，檢查了四周的環境，但並無收穫…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280448,
					"content": "真的沒有出口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280449,
					"content": "哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280450,
					"content": "我覺得，這地方有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280451,
					"content": "老大，你們那裡怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280452,
					"content": "沒有收穫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "而且就在剛才，我餘光好像瞥到幾個人影…別是真鬧鬼了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280454,
					"content": "雖然現在氣氛很不對勁，但我還是要說，一斗，你自己不就是鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280455,
					"content": "不是啦！我是說那種，那種忽閃忽閃，一會有一會沒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280456,
					"content": "嗯？一斗，其實…你怕鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280457,
					"content": "啊呀。被人家看出來了呢，老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280458,
					"content": "我、我哪有！妳們不許亂說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280459,
					"content": "嘻嘻，看你這樣我忽然不怕了…喂放牛的，要是害怕的話，我可以捂著你的眼睛哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280460,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280461,
					"content": "看來，我得找點別的事做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280462,
					"content": "（嗯？阿忍走到一旁，似乎找了幾塊石頭，又從口袋拿出樹枝和堇瓜…嗯嗯？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "放點鹽…胡椒也來一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280464,
					"content": "請問妳是在烤堇瓜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "#對。烤堇瓜很好吃，一會{F#妳}{M#你}也嚐嚐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280466,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "#唔…有甜鹹兩種，{F#妳}{M#你}喜歡哪種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280468,
					"content": "都可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "嗯，那就都試試好了。越是現在這種場合，越要穩定精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280470,
					"content": "#如果我沒猜錯的話，這裡可能藏著不方便讓我和老大知道的秘密。不過別擔心，我會注意不讓老大打擾{F#妳}{M#你}們討論機密的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280471,
					"content": "哇，居然在烤東西吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280472,
					"content": "煙緋小姐要來一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280473,
					"content": "#我不餓，{F#妳}{M#你}們先吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280474,
					"content": "說起來，跟阿忍也是好久沒見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280475,
					"content": "是啊。上回見面還是我在璃月唸書的時候了，妳來替我的老師代了一節課。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280476,
					"content": "代課…啊，想起來了，是有一年的冬天對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280477,
					"content": "對，大家都說妳講課很有趣。這麼說來…應該叫妳一聲師姐才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280478,
					"content": "嗯嗯，這個叫法真不錯，我喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280479,
					"content": "沒想到會跟師妹一起遇到這種意外，也算是緣分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280480,
					"content": "煙緋還會講課，真厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "而且風格詼諧幽默，寓教於樂，很受學生歡迎哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280482,
					"content": "哈哈哈，師妹真是過獎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280483,
					"content": "幾位，都在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280484,
					"content": "夜蘭，我們分頭找過了，這附近沒有出口。妳呢？有什麼收穫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280485,
					"content": "沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280486,
					"content": "而且…雖然我不想這麼說，但還是做好心理準備吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280487,
					"content": "如果一直找不到路，我們也許會在地下待一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280488,
					"content": "…我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280489,
					"content": "…明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280490,
					"content": "但世上不應存在只能進不能出的地下空間，這不合理…我會繼續想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280491,
					"content": "各位假如找到疑似出口的地方，也千萬記得在保證安全的前提下進行探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280492,
					"content": "（說起來，魈也在這裡。還記得他提過，如果遇到棘手的情況，可以呼喚他的名字。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "（…嗯，或許是個辦法。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "#喂喂，看{F#妳}{M#你}神情嚴肅，是要做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280495,
					"content": "妳記不記得，魈也在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "#魈…對哦！{F#妳}{M#你}是不是想叫他來幫忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280497,
					"content": "我認為可以一試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "好，試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280499,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "魈，能聽見嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280502,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "魈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "沒有回應…我還以為魈無論在哪都會趕過來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280505,
					"content": "難道說，就連魈都感覺不到我們的氣息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280506,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "（如果真是如此，將意味著什麼？我們身處的這片地下…究竟是怎麼回事？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
