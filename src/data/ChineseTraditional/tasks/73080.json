			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"艾方索"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "（一起揪出維摩莊的「壞人」吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "你好，艾方索！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800103,
					"content": "#是{F#妳}{M#你}們啊。{NICKNAME}，有什麼事嗎？如果是找拉娜的話，她已經走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800104,
					"content": "想和你討論一下——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "潛伏在維摩莊的「壞人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#畢竟，{NICKNAME}答應了拉娜，會處理壞人，她才安心去旅行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800107,
					"content": "…這樣啊。我明白了，雖然我沒什麼頭緒，但想問什麼，就儘管問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800108,
					"content": "首先，一起整理一下情況吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "那麼…維摩莊裡，第一個走失的孩子是誰來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800110,
					"content": "素達蓓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "嗯，我想起來了，應該是素達蓓！她聽人說森林裡有藥草，對阿瑪茲亞爺爺的眼睛好，就偷偷跑到森林裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800120,
					"content": "確實是這樣。當時，我們都很擔心，所以組織了搜救隊進入森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800121,
					"content": "啊，想起來了！拉娜說過，搜救隊是你組織的！而且，還帶著咖哩去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800122,
					"content": "藥草的事情，是誰跟素達蓓說的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "…是我。素達蓓是好孩子，很關心阿瑪茲亞爺爺的事情。有一次，和她聊天的時候，我記得提過這件事情。但是我也說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800124,
					"content": "嗯，我知道！素達蓓說過，你要她別隨便到森林裡去。只能說，素達蓓真的很關心阿瑪茲亞爺爺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800125,
					"content": "…還有什麼要問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800126,
					"content": "唔…接下來，第二個走失的是誰來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800127,
					"content": "卡烏斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "卡烏斯…他說要去森林裡找「朋友」商量妹妹失蹤的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800136,
					"content": "對，跟卡烏斯講故事的時候，他好像也說過！艾方索，你知道卡烏斯的朋友是誰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800138,
					"content": "#我怎麼會知道。在森林裡，我沒找到卡烏斯和卡烏斯的朋友。如{F#妳}{M#你}們所知，他也和素達蓓一樣，突然回來了，什麼都不記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800139,
					"content": "還有什麼問題嗎？之後，就沒有孩子失蹤了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800140,
					"content": "派蒙，妳來說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "欸？好的…咳咳，應該這麼說，接下來要走丟的，本來是優丹。但我們和拉娜碰巧遇到他，所以把他救回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800142,
					"content": "事情是怎麼發生的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "嗯…我記得，按照他的說法是…他聽艾方索說，森林的洞窟裡有很大的蘑菇，就想要採給拉娜吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800144,
					"content": "結果，路上有愚人眾的壞蛋跟蹤他，他很害怕，就一直逃跑，結果被困在了死域裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800145,
					"content": "啊？他竟然到死域裡去了…這種事情，他都沒跟我說過！真是太危險了，怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800146,
					"content": "#不對…既然他誤入死域，又是怎麼平安回來的？即使{NICKNAME}沒有神之眼也能驅使元素的力量，也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800147,
					"content": "（嗯…蘭拉娜的事情，能跟艾方索說嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800148,
					"content": "（沒關係。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "…艾方索，雖然你可能很難相信，不過森林裡有一種叫「蘭那羅」的精靈。優丹他們和蘭那羅是朋友，所以蘭那羅幫助了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800151,
					"content": "蘭那羅啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800152,
					"content": "不過，愚人眾真的好可惡，居然連小孩子都不放過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800154,
					"content": "唔…這樣梳理下來，也不知道潛伏在維摩莊的壞人是誰呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800155,
					"content": "派蒙，那邊好像有人在監視我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "欸？在哪？該不會就是我們要找的壞人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800157,
					"content": "妳幫忙看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "我自己去…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800159,
					"content": "如果發現什麼，就大喊。我馬上來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#哼，好吧。總是什麼事都交給{NICKNAME}也不是辦法，這次我也要幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800162,
					"content": "派蒙很有幹勁地離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "何必多此一舉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800164,
					"content": "她不知道的話，會開心一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "我們換個地方說話吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800165,
					"content": "有的事情，沒必要讓她知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "妳又能飛，身材又小，適合偵察。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "（應該讓他知道。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "素達蓓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "不對不對，我們不是剛剛才聊完素達蓓的事情嗎？我記得，是她的哥哥…是叫卡烏斯對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800130,
					"content": "優丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "不對吧？優丹走失的時候，是我們一起救了他…我記得，第二個應該是素達蓓的哥哥，卡烏斯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800132,
					"content": "暢暢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "等等，暢暢不是在璃月嗎…？這和暢暢有什麼關係啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800134,
					"content": "#{F#妳}{M#你}沒問題吧，{NICKNAME}？我記得，第二個應該是素達蓓的哥哥，應該是叫卡烏斯，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800111,
					"content": "卡烏斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "是素達蓓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800113,
					"content": "優丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "不對吧！優丹是最後一個走失的才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800115,
					"content": "是素達蓓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800116,
					"content": "提米。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "提米？不對，這和提米沒有關係吧！他不是在蒙德嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730800118,
					"content": "提米是誰呀…第一個走失的，是素達蓓才對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "艾方索"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾方索"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "#{F#妳}{M#你}是從什麼時候開始懷疑我的？是因為素達蓓和優丹提到我的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800202,
					"content": "你知道我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "拉娜沒有對你介紹過我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "#或許存在著這樣的可能性：我的耳朵很好，拉娜向阿瑪茲亞爺爺介紹{F#妳}{M#你}的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800205,
					"content": "她沒有對阿瑪茲亞爺爺介紹過名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "#…我大意了。但是，在整個提瓦特，資訊流通率高的組織除了愚人眾，還有冒險家協會。為什麼{F#妳}{M#你}不認為我是個冒險家呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800207,
					"content": "你似乎對我的情況也很瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "知道我沒有神之眼也能驅使元素。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "#{F#妳}{M#你}在各地冒險的事蹟很有名。不一定非得是愚人眾，才知道吧…歸根到底，{F#妳}{M#你}還是沒有實際的證據，證明我是愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800212,
					"content": "沒錯。但這不重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "#{F#妳}{M#你}說得對。只有律法重視「證據」。而機敏的獵犬，明白只要追蹤可疑的氣味，就能找到獵物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800214,
					"content": "#當然，聰明的獵犬，會避開自己不該聞的氣味，以免在蹤跡的末尾遇見惡龍。但是，從{F#妳}{M#你}的事蹟來看，{F#妳}{M#你}不是明哲保身的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800215,
					"content": "你特地警告過拉娜，請她不要巡林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "是希望她不要阻撓愚人眾的行動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "…這是一方面。但更重要的是，我不希望她因此受傷。別的愚人眾和我不同，對她、對維摩莊沒有感情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800218,
					"content": "「艾方索」，你究竟是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "我的血親為我起的名字，已經失落在冰雪之中。「壁爐之家」賦予我的名字是特洛芬·雪奈茨維奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800220,
					"content": "壁爐之家的雪奈茨維奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "#…看{F#妳}{M#你}的反應，似乎有些眉目。{F#妳}{M#你}應該遇到過我的「兄弟姐妹」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800222,
					"content": "#啊，不要告訴我遇見了誰，也不要告訴我他們的情況。既然他們對{F#妳}{M#你}暴露了身分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800223,
					"content": "如果如今情況安好，那他們想必已經背叛了陛下。如果已經殞命…我不想聽到這樣的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800224,
					"content": "壁爐之家是「僕人」大人設立的福利院。生活在壁爐之家的孩子，是沒有血親的。但是，我們有更加寶貴的「兄弟姐妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800225,
					"content": "歲數到了後，有天賦的孩子就會被訓練成特務，然後潛伏在各個地方，等待命令。不幸的是，我被認為是「有天賦的孩子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800226,
					"content": "你的命令是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "捕獲「蘭那羅」。這是「博士」大人的命令，為了研究蘭那羅與夢境、死域的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800228,
					"content": "將「夢」與「死域」兵器化，似乎是他的研究課題之一。當然了，我和你所擊敗的愚人眾同士，則是他的「研究資源」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800229,
					"content": "我們是見不到蘭那羅的。但卡烏斯、素達蓓、優丹他們…他們有與蘭那羅成為朋友的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800230,
					"content": "你讓愚人眾拐走孩子，引出蘭那羅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "沒錯。蘭那羅確實出現了。但蘭那羅的力量果真神奇，竟然能從看守嚴密的營地裡，在不驚動任何人的情況下，將他們救走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800232,
					"content": "「博士」大人真是，看上了不得了的東西呢。哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800233,
					"content": "#我也有問題想要問{F#妳}{M#你}，{NICKNAME}。為什麼蘭那羅要將卡烏斯和素達蓓被拐走又被救走的記憶消除？是害怕暴露自己嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800234,
					"content": "蘭拉娜不希望孩子們記住這些事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "不希望他們長大後成為施暴的一方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "這樣啊…那個蘭那羅，原來是叫「蘭拉娜」嗎？和拉娜的名字很像，是個好名字。有機會的話，請幫我傳達一句「謝謝」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800237,
					"content": "為什麼要道謝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "維摩莊就像真正的家一樣。拉娜和優丹，在我看來，就像我本應擁有的親人…卡烏斯和素達蓓，也是我寶貴的弟弟妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800239,
					"content": "我希望他們能健康長大，變成正直而善良的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800240,
					"content": "所以，雖然在我的「工作」上，給我增添了許多困擾，但我很感謝蘭拉娜所作的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800241,
					"content": "#…啊，我終於明白了。就像{F#妳}{M#你}支開派蒙一樣，孩子們不應該知道這些陰暗齷齪的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800242,
					"content": "「少年人，你在孩童時應當快樂，使你的心歡暢，行你所願行的，見你所樂見的。然而也應當記住黑暗的時日…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800243,
					"content": "…這是壁爐之家的教導。因為大人一定會面對黑暗，所以在幼年時就應當有所準備。這樣，才能保護好自己與珍惜的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800244,
					"content": "#或許{F#妳}{M#你}們的做法也有其道理。假如我沒有在壁爐之家長大，成為駐維摩莊的特務…假如我出生在維摩莊，那就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800245,
					"content": "說這些沒有任何意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "我明白，我只是感到遺憾。我希望我一直都是「艾方索」，而不是「特洛芬·雪奈茨維奇」。我希望我能成為優丹真正的哥哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800247,
					"content": "我想當一個好人，但我是屬於組織的人。我想成為拉娜的家人、孩子們的家人，但我已經有一個無法背叛的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800248,
					"content": "#有許多同伴，有足以匹敵執行官大人的實力，又不屬於任何一城一國，連身為騎士也只是自由的榮譽騎士的{F#妳}{M#你}，是不能理解吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800249,
					"content": "我理解你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "但你所作的，不會被原諒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "#那麼，該說的都說完了。{F#妳}{M#你}要怎麼處置我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800254,
					"content": "別再靠近維摩莊，別再讓我見到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "#…這樣嗎？我明白了，我不會再出現在{F#妳}{M#你}面前。我也不會回到愚人眾的勢力內，因為我的任務失敗了，會讓「兄弟姐妹」蒙羞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800256,
					"content": "優丹會一直等著「艾方索哥哥」回來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800257,
					"content": "你走吧。派蒙該來找我們了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "再見。不，永別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800259,
					"content": "（戰鬥）我改變主意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#適合惡徒的結局，我已經看到了…但我不會坐以待斃的。就算{F#妳}{M#你}是{NICKNAME}，就算我沒有任何勝算，我也會放手一戰。因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800261,
					"content": "我是善中之惡、藥中之毒、羔羊中的狼、金杯中的水銀…我名為雪奈茨維奇。來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800262,
					"content": "（戰鬥）我與蘭拉娜有一個約定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "一定要懲罰惡徒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#適合惡徒的結局，我已經看到了…但我不會坐以待斃的。就算{F#妳}{M#你}是{NICKNAME}，就算我沒有任何勝算，我也會放手一戰。因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800265,
					"content": "我是善中之惡、藥中之毒、羔羊中的狼、金杯中的水銀…我名為雪奈茨維奇。來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730800251,
					"content": "我並不理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800252
					]
				},
				{
					"id": 730800252,
					"content": "我也不會試圖理解你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800210,
					"content": "你似乎對愚人眾的情況很瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800211
					]
				},
				{
					"id": 730800211,
					"content": "#愚人眾作惡多端，整個大陸的人多少都有所耳聞吧…歸根到底，{F#妳}{M#你}還是沒有實際的證據，證明我是愚人眾。",
					"roleType": "TALK_ROLE_NPC",
