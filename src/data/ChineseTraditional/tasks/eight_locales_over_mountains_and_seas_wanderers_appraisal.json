			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "終於上來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780502,
					"content": "這裡的視線，比下面好多了。你看，那邊就是我們來的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780503,
					"content": "派蒙很喜歡高的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780504,
					"content": "在高的地方視野很好，滑翔也方便。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "風風龍睡在這個塔裡面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780508,
					"content": "嗯，在裡面睡了好久好久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780509,
					"content": "#雖然{NICKNAME}和「風魔龍」戰鬥，但是牠不是壞龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780510,
					"content": "只是遇到了難過的事情，受了傷害，又被壞人騙了，所以以為，風神朋友不要牠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780511,
					"content": "呶…後來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780512,
					"content": "#後來呀…{NICKNAME}，{F#妳}{M#你}還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780513,
					"content": "我們在戰鬥中，淨化了「毒血」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "但是，戰鬥的平台也坍塌了。本來，我們，還有風神都要掉到好深好深、好黑好黑的地方去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780515,
					"content": "#呶！好可怕…那麼，派蒙和{NICKNAME}怎麼辦？飛出來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780516,
					"content": "特瓦林救了我們。載著我們飛走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "特…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780518,
					"content": "就是「風魔龍」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780520,
					"content": "#「風魔龍」是有自己的名字的喔，就像吉法師、派蒙和{NICKNAME}一樣。牠叫特瓦林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780521,
					"content": "開始，特瓦林受了傷害、又被壞人騙了，非常非常生氣，還到蒙德城去大鬧了一場。大家都覺得它是壞龍，所以叫它「風魔龍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780522,
					"content": "後來，我們打倒了壞人，又和風神一起淨化了汙染牠的毒血，牠才知道，風神其實沒有拋棄牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780523,
					"content": "喔！特…風風龍就變好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780524,
					"content": "沒錯！所以說呀…派蒙今天帶吉法師到這裡來修行，就是想告訴吉法師特瓦林的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780525,
					"content": "吉法師長大以後，也會遇到誤解、遇到傷害、遇到難過的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780526,
					"content": "但是，也一定不能變成壞人。因為，「風向是會轉變的」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780527,
					"content": "總有一天，會吹向更光明的方向。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780529,
					"content": "對吉法師來說，會不會太難懂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "好像懂了，但又不太懂呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780531,
					"content": "#不過，吉法師知道是很重要的事情。派蒙和{NICKNAME}說的事情，不會忘記的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780532,
					"content": "嗯！那就沒辜負我花了好長好長時間想的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780533,
					"content": "不過，吉法師也不要太貪玩、太調皮，被人封印起來喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780534,
					"content": "吉法師這次的修行也告一段落了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "嗚呶呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780537,
					"content": "別這麼難過嘛！要笑著回去，這樣五百藏才會高興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780538,
					"content": "#好啦，派蒙和{NICKNAME}也要完成好嚮導最後的職責啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780539,
					"content": "那就是，把吉法師送回五百藏身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780540,
					"content": "我們走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780541,
					"content": "我們走吧，吉法師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "五百藏的委託也算是完成了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "風魔龍救了我們。載著我們飛走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "「笨蛋和煙…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "喂！才不是這麼回事啦。在高的地方，視野很好，而且空氣也比較清新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
