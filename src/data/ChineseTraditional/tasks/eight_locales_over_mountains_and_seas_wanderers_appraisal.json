			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "嗚呶呶…風好大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780402,
					"content": "這裡的風牆，是過不去的喔！要繞路走才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780403,
					"content": "吉法師，跟著我們慢慢從旁邊繞上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
