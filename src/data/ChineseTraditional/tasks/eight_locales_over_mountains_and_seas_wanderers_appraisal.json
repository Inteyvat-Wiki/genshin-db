			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "好大的城市，但是…感覺，好荒涼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780102,
					"content": "#以前，我和{NICKNAME}、還有很多同伴一起，曾經在這裡和「風魔龍」戰鬥呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780103,
					"content": "是那種，身體大大，翅膀飛飛、牙齒尖尖，很可怕的龍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780104,
					"content": "其實沒有那麼可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "吉法師還記得，之前我們在蒙德城看到的風神像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780107,
					"content": "風神像…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780108,
					"content": "就是那個，好高好高的石頭像啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780109,
					"content": "呶！記得。風神的手好大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780110,
					"content": "「風魔龍」是風神的好朋友呢！以前，風神也是從這個「城市」來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780111,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780112,
					"content": "但是，如果風風龍很大，那要怎麼進來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780113,
					"content": "以前好像也有誰問過一樣的問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "啊，這個派蒙知道！因為牠不用像我們這樣，從那邊走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780116,
					"content": "吉法師想到了。風風龍會飛，所以不用走進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780117,
					"content": "可、可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780118,
					"content": "呶？派蒙，好像有點不開心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780119,
					"content": "嗯…這些之後再說，先在這裡拍照紀念吧！吉法師，不要亂動喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780120,
					"content": "吉法師站好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780114,
					"content": "是「風魔龍」啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "其實也很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
