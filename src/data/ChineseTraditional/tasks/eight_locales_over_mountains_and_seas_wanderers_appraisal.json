			"dialogs": [
				{
					"id": 726780301,
					"content": "呶…很好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780302,
					"content": "吉法師，你怎麼啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780303,
					"content": "這個城市很荒涼，感覺有點難過，不知道為什麼。奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780304,
					"content": "我也覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "接下來，我們就向「城市」的中心前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726780305,
					"content": "吉法師真奇怪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
