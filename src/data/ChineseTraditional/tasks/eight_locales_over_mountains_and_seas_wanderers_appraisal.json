			},
			"dialogs": []
		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "五百藏，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790102,
					"content": "喔，回來啦！吉法師，修行的成果如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790103,
					"content": "咔嚓咔嚓，砰砰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790104,
					"content": "呶哈哈哈，真不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790105,
					"content": "嗚哇，又聽不懂吉法師說的話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790106,
					"content": "我們還拍了好多好多照片。五百藏，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790107,
					"content": "將這段時間一同旅行時，為吉法師拍的照片，一張張交給了五百藏。\\n連同旅行中遇到的事情，也說給了五百藏聽。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "…就這樣，我們完成了五百藏「帶吉法師去八個地方修行」的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790109,
					"content": "#嗯！不愧是吾輩看上的人，真不錯。假如{F#妳}{M#你}們這些小輩是狸子，那想必也能成為名震天下的大妖狸。可能加起來有吾輩一半強吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790110,
					"content": "（聽起來也沒有很強嘛…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790111,
					"content": "不過，既然任務完成了，我們也該走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790112,
					"content": "嗚呶呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790113,
					"content": "好啦好啦，別這樣。派蒙再教吉法師一件事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790114,
					"content": "和朋友告別的時候，要笑著告別！這樣的話，下次再見的時候，會更加開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790115,
					"content": "…唔？好的，沒問題。交給吾輩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790116,
					"content": "吉法師說，「知道了。白毛。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790117,
					"content": "欸？難道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790118,
					"content": "吉法師又不能說話了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "過了這麼久時間，妖狸飯的效果也該消退了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790121,
					"content": "#哼，吾輩要是沒被封印在石頭裡的話，想要讓{F#妳}{M#你}們一直都能聽懂妖狸說的話，也是易如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790122,
					"content": "…嗯？好，吾輩幫你傳達一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790123,
					"content": "「吉法師要努力修行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790124,
					"content": "「變成像五百藏那樣的大妖狸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790125,
					"content": "…呶？你這傢伙，口氣不小。呶哈哈哈，有吾輩當年的氣魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790126,
					"content": "「那樣，白毛、黃毛不用吃妖狸的飯，也可以聽懂吉法師說話。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790127,
					"content": "…嗯！我會等著，下次和吉法師一起修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726790128,
					"content": "吉法師要加油。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "不要被人封印了喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "呶？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790131,
					"content": "呶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790132,
					"content": "#算了，看{F#妳}{M#你}們這些人類帶吉法師修行的份上，吾輩就不計較了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790133,
					"content": "對了。之前有個叫歌麿的傢伙，在鎮守之森裡畫被封印的狸子，還留下了一些畫稿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790134,
					"content": "#就給{F#妳}{M#你}們吧。如果想念我們妖狸一族的俊朗模樣，就看看這些畫像吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790135,
					"content": "#唉，如果{F#妳}{M#你}們是妖狸就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790136,
					"content": "…那我們早該變成石頭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "哼，也對。沒什麼事就快走吧，吾輩，還要教吉法師法術呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726790119,
					"content": "我們又聽不懂吉法師說的話了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}