			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱萬",
					"荷貝特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "你就通融一下嘛，我是真心來求你辦事的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040102,
					"content": "沒什麼好說的，我不能讓步，請回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040103,
					"content": "哇啊，這兩人怎麼吵起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731040104,
					"content": "喲，異鄉人，能幫我說服這位小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040105,
					"content": "今天她突然找過來，一直纏著我，說是想讓我幫忙釣一批古董。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040106,
					"content": "嚇跑了我的魚不說，還想佔用我接下來的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040107,
					"content": "我說啊小姐，妳這麼心急，難道是想藉這批古董發財？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040108,
					"content": "不是的，凱萬先生，我是教令院合作方的雇員荷貝特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040109,
					"content": "那些古董都是教令院搜集來用做研究的，我負責管理它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040110,
					"content": "但就在昨天，運輸文物的小船出了點意外，有幾件文物掉進了河裡，被水流沖到了下游來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040111,
					"content": "那妳去找專業的捕撈隊啊！妳找我一個釣魚的人幹嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040112,
					"content": "找捕撈隊就太慢了，我之前聽人介紹說，「魚鉤上的絕景」凱萬先生幾乎每天都能釣到失物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040113,
					"content": "而且你也經常在這片流域釣魚，所以我想要請你下竿，看看能不能把文物給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040114,
					"content": "完全是病急亂投醫啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "咳咳，荷貝特小姐，我對妳的遭遇表示同情，但我只是一個釣魚的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040118,
					"content": "我下竿只為了釣魚，也只可能釣上來魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040119,
					"content": "明明一條魚都沒釣上來過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731040120,
					"content": "咳！我一直抱著這樣的想法練習釣魚的技巧，從沒想過用這門本領幹別的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040121,
					"content": "所以妳還是去請其他人比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040122,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040123,
					"content": "那不然…這樣好了，我不求你幫我釣到失物，只需要你換個地方釣魚，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040124,
					"content": "你就當…就當是我付錢請你釣魚啦！拜託你了，拜託你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040125,
					"content": "我說你們啊，我可是一個漁夫啊！漁夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040126,
					"content": "換一個地方釣魚也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "拜託拜託，你看，我報酬都準備好了，你就幫幫我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040129,
					"content": "真是受不了你們…行吧，就當是換個心情了。妳要我在哪裡釣魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040130,
					"content": "太謝謝你了，跟我來就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040131,
					"content": "#和之前一樣，旅行者，麻煩{F#妳}{M#你}們幫我找找魚餌的素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040132,
					"content": "我想想…這次的特別素材是薄荷，不過需要從我常去的地方採集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040133,
					"content": "#我幫{F#妳}{M#你}把大概的位置標注在地圖上，那就拜託{F#妳}{M#你}了啊。等{F#妳}{M#你}把東西拿過來，我會給{F#妳}{M#你}詳細算清楚報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040134,
					"content": "我先跟著荷貝特小姐去釣魚點了，待會在那邊碰頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040127,
					"content": "漁夫也會釣到各種東西啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "如果是凱萬下竿的話，確實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "我下竿只是為了釣到大魚好嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "凱萬"
				}
			]
		},
