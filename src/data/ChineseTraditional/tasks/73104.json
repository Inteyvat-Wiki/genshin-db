					"nextDialogs": [
						731040408
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040408,
					"content": "這是…我，我來看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040409,
					"content": "就是這個！這是落水的文物之一！結構完好，也沒有水生生物鑽進去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040410,
					"content": "居然能釣上來文物！您真不愧是「魚鉤上的絕景」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040411,
					"content": "妳這是誇我嗎？我可是一點都高興不起來…",
