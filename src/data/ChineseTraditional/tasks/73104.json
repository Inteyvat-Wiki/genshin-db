							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱萬",
					"荷貝特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "動作挺快的嘛，辛苦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040402,
					"content": "請趕快開始吧，不然那些文物…呃…那些魚都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 731040403,
					"content": "別心急，要感受水流的韻律，下竿時的心態要平和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040404,
					"content": "讓我試試看吧，在這裡能釣上什麼大魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 731040405,
					"content": "凱萬製作了魚餌，開始了垂釣",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "漫長的等待後，凱萬釣到了一個濕漉漉的包裹",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "這是什麼東西…",
