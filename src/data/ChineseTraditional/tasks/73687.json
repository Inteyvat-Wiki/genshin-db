			"dialogs": [
				{
					"id": 736870301,
					"content": "《拜託了我的狐仙宮司》巫女主題得票情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870302
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870302,
					"content": "《奧西茲小姐事件簿》奧西茲小姐主題得票情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870303
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870304
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870304,
					"content": "投票流程公開透明，結果公平公正，特此公告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由宇"
				}
			]
		}
	]
