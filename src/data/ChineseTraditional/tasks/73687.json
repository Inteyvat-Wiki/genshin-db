	"talks": [
		{
			"id": 7368701,
			"completionStepIds": [
				7368701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368701",
							"2"
						],
						"stepId": 7368701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"由宇",
					"鐵也"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870101,
					"content": "已經有不少人圍在公告板前了呢，讓我看看讓我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870102,
					"content": "啊，沒想到票數差了這麼多，我還以為像「演武傳心」這樣有稻妻特色的賽事，一定是政子小姐獲勝呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870103
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870103,
					"content": "意料之中，畢竟《奧西茲小姐事件簿》可是新銳人氣作品。不僅故事有趣，插畫頁裡的楓丹服飾也很有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870104
					],
					"speakerTitle": "鐵也"
				},
				{
					"id": 736870104,
					"content": "而且你不覺得，奧西茲小姐的身分也和神里小姐很相稱嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870105
					],
					"speakerTitle": "鐵也"
				},
				{
					"id": 736870105,
					"content": "嗯…雖說奧西茲小姐爭強好勝，又喜歡惡作劇，和神里小姐一點都不一樣，但能看到穿楓丹服飾的神里小姐倒也是一樁驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870106
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870106,
					"content": "咦，他們到底在說什麼呀，我都有點糊塗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870107,
					"content": "#欸，{F#妳}{M#你}看！公告板上演武傳心服裝投票的幾個選項，《拜託了我的狐仙宮司》、《奧西茲小姐事件簿》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870108,
					"content": "等一下等一下，之前我們聽說的投票，不是選擇稻妻的四季風物嗎？什麼時候變成了輕小說主角的服裝了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870109,
						736870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870109,
					"content": "難道最後修改了方案？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				},
				{
					"id": 736870111,
					"content": "我覺得有必要去問問這件事。走，我們趕快到社奉行去找綾華吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870110,
					"content": "難道投票出了什麼差錯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				}
			]
		},
		{
			"id": 7368702,
			"completionStepIds": [
				7368702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368702",
							"2"
						],
						"stepId": 7368702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"水田",
					"小野寺",
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870201,
					"content": "真是萬分抱歉，是我把兩個裝著選票的箱子弄混了！等到小野寺先生出差回來發現這件事，就已經是公佈結果之後了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870202
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736870202,
					"content": "唉，之前為了防止洩密，刻意沒有在選票上標記投票的標題，沒想到最後竟然會弄巧成拙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870203
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870203,
					"content": "啊，不會吧…演武傳心的服裝投票，原來真的是出了差錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870204,
					"content": "#旅行者、派蒙，看來{F#妳}{M#你}們也得知投票結果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870205,
					"content": "是啊，不只是我們知道了，我們過來的一路上，感覺大家都在討論這件事呢。這可怎麼辦啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870206,
					"content": "神里小姐，造成這樣嚴重的事故是我們的責任，我現在就去重新舉辦投票，一定會把這件事說明清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870207
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870207,
					"content": "不，小野寺先生，請先等一下，事情或許還有其他解決方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870208
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870208,
					"content": "選票弄錯的事，目前只有我們這些籌備賽事的工作人員知道，普通民眾並沒有察覺到選票有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870209
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870209,
					"content": "而且，當大家得知表演賽上會出現流行作品中的服飾，卻並沒有什麼不滿和怨言。相反地，大家似乎都認為這是意外驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870210
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870210,
					"content": "既然我們的目的之一，是讓更多人對這場比賽產生興趣，那麼這個差錯造成的後果，不應該稱作「事故」才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870211
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870211,
					"content": "綾華，妳的意思難道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870212,
					"content": "嗯，我覺得不如將錯就錯。最後的表演賽上，我穿著現在投票結果選中的服飾上場即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870213
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870213,
					"content": "可是這…也太為難神里小姐了，畢竟小說人物的衣服，並不像演武華服那樣是為了戰鬥而設計的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870214
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870214,
					"content": "沒關係，小說裡那件楓丹風格的裙裝，造型並不算繁冗，對我來說應該不會有太大影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870215
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870215,
					"content": "即使和平日的裝束不同，我也會努力適應它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870216
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870216,
					"content": "哇，綾華說是說得很平靜，但好有魄力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870217,
					"content": "好，我明白了…既然這樣，那就按照神里小姐的辦法來做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870218
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870218,
					"content": "我們為讀者見面會準備的服裝，這兩天會根據神里小姐的身材裁剪調整，保證在表演賽上達到最佳效果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870219
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870219,
					"content": "嗯，那就辛苦你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870220
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870220,
					"content": "綾華，穿著小說角色的服裝參加表演賽，真的沒關係嗎？妳沒有在我們面前勉強自己吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870221,
					"content": "放心吧。我此刻很輕鬆，還有些欣喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870222
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870222,
					"content": "之前，一想到要身著華服登上表演賽的舞臺，我就難免擔心，自己在場上的舉止是否足夠得體美觀，配得上觀眾們的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870223
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870223,
					"content": "不過，如果穿著小說角色的衣服，應該就不用考慮這麼多了。因為書中那位偵探小姐，可是出了名地我行我素，又酷愛惡作劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870224
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870224,
					"content": "這樣一來，觀看表演賽的大家，應該也能夠從傳統形式中品味出新的樂趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870225
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870225,
					"content": "（原來綾華是這樣想的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870226
					]
				},
				{
					"id": 736870226,
					"content": "不，還不只是這樣。不如說在我內心深處，也一直期待著有朝一日，能打扮成與平常不同的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870227
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870227,
					"content": "#旅行者，我還記得剛認識{F#妳}{M#你}不久的時候，曾聽{F#妳}{M#你}說過，璃月、蒙德…各個國家的服飾都各有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870228
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870228,
					"content": "那時候的我，完全無法想像未來某天，自己也能切身體會這些異國風情。不過現在，所有曾經不可能的願望，都不再遙遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870229,
					"content": "而且，母親生前也一直很嚮往其他國家的服飾。這一次，我又幫助母親完成了一個心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870230
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870230,
					"content": "這樣想的話，這件特別的衣服，的確可以被稱為驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870231,
					"content": "嘻嘻，這麼看來，雖然弄錯了投票，但結果卻是一件好事呢。好，既然這件事已經圓滿解決了，那我們就準備去賽場吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870232,
					"content": "嗯，我相信旅行者的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870233
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736870233,
					"content": "#等我和小野寺先生確認了服裝尺寸後，也會前往賽場觀看{F#妳}{M#你}們的對決的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
