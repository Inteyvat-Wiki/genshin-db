			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"狗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "欸？這不是「胡椒」嘛！牠好像看守著什麼呢…等等，這情景有點熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950602,
					"content": "#（似乎認出了{F#妳}{M#你}們，搖起了尾巴。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732950603,
					"content": "唔…難道牠是在看守于連的畫稿嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950604,
					"content": "「胡椒」短吠了兩聲，很快離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "牠又走掉了呢，上次也是這樣…話說回來，丘丘人把畫稿撿回來幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950606,
					"content": "可能也有裝飾的需求吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "唔…真的是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950608,
					"content": "難道真的是當衛生紙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#呃——{NICKNAME}怎麼會有這麼奇怪的想像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "牠果然已經回來了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950802,
					"content": "喂，于連！我們找到畫稿帶回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950803,
					"content": "哦哦！感謝兩位好朋友…為了這種不值錢的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950804,
					"content": "別這麼說，你不是楓丹知名畫家嘛，知名畫家的手稿一定也是很值錢的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950805,
					"content": "呃，是…或許是吧，我其實不太關注這方面，畢竟真正的藝術應該是無價的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950806,
					"content": "不愧是知名畫家，每句話都感覺很有藝術感很有哲理呢！話說回來，我們找到畫稿的時候，「胡椒」也在旁邊守著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950807,
					"content": "和之前一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "嗯！我覺得，牠一定還是很關心你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950809,
					"content": "#{F#妳}{M#你}們是說，不顧我餵養牠這麼久，卻帶我走進歧途，還留我獨自面對丘丘人的傢伙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950810,
					"content": "唔…牠、牠可能也有牠的考量吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950811,
					"content": "對了，于連雖然嘴上這麼說，其實心裡還是很喜歡牠的吧？不然也不會用特別的留影機幫牠拍畫片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950812,
					"content": "畫片？什麼畫片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950813,
					"content": "就是夾在畫稿裡的那一張狗的畫片呀，和牠一模一樣！色彩看起來很獨特呢，應該是用楓丹的什麼特別的留影機拍攝的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950814,
					"content": "啊…那個其實是我畫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950815,
					"content": "欸？知、知名畫家果然很厲害呢！不僅畫得像，配色也…也很藝術！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950817,
					"content": "（難道是我誇得不對嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950818,
					"content": "（別問我，我也不懂。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "#我也不想畫這樣的東西…我只是…我只是想當個一流的畫家，{F#妳}{M#你}們說，這件事真的很困難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950821,
					"content": "唉…對不起，我不該對兩位好朋友說謊。一旦說出第一個謊言，之後就需要更多謊言…我已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950822,
					"content": "其實我只是個半吊子，無法像其他人一樣「正確地」分辨顏色，但是又不想放棄成為畫家的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950823,
					"content": "所以藉助了一個…朋友的力量，得到了畫什麼像什麼的能力，但還是沒辦法辨別色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950824,
					"content": "等等，你說「得到了畫什麼像什麼的能力」…這是不經過訓練就能獲得的能力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950825,
					"content": "是啊，我這個朋友他比較神通廣大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950826,
					"content": "真的嗎？我不信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "應該說，現在的我已經沒辦法畫得不像了，這或許就是能力的代價吧。說起來的確有點離譜，不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950828,
					"content": "#于連當即摹寫了一份冒險家的經驗交給{F#妳}{M#你}。\\n{F#妳}{M#你}將摹寫的副本與原本兩相比較，並未發現任何不同。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "唯一的區別或許是，副本讀完之後有種腦袋空空的奇妙感覺…\\n就像是讀了，但完全沒讀。只有時間白白被浪費，卻沒能獲得任何經驗…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "唔…看起來和原版沒什麼區別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950829,
					"content": "哈哈，那當然，雖然沒當上知名畫家，製作贗品我可是一流的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950830,
					"content": "可是那不是違法的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950831,
					"content": "…是啊，所以我在服過刑之後決定做點正事來維生，這次一定要當一個堂堂正正的畫家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950832,
					"content": "可是這畫什麼像什麼的能力…如果不是卡特皮拉賦予我的，我一定會把它稱作詛咒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950833,
					"content": "現在的我就像是壞掉的留影機，只能產出顏色錯亂的「畫片」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950834,
					"content": "原本以為循著純水精靈的朝聖之路就能找到解藥…讓我也能像常人一樣分辨色彩，讓我變得如白紙一般的孩童充滿創造力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950835,
					"content": "卡特皮拉到底是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "是朋友…可靠的朋友，是他告訴我循著純水精靈的朝聖之路，就能在須彌找到治癒一切傷痛，讓人重獲新生的靈藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950839,
					"content": "…聽起來好可疑的感覺！你這個朋友是什麼樣的朋友呀…你該不會是被騙了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950840,
					"content": "他見多識廣怎麼會騙我。一定是我自己的問題吧，就像之前說的，我的人生就是不斷的失敗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950841,
					"content": "我想靈藥恐怕是被安放在重重保護之下，像我這樣的俗人終究是無法企及的，我已經…認清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950842,
					"content": "其實狗也一定不想陪我來須彌吧，不然也不會一路給我找麻煩，讓我受罪。要是當初讓牠留在楓丹就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950843,
					"content": "唔…我是覺得牠一定還是想和你在一起的，而且牠一定很喜歡你的畫…所以不要這麼快就放棄嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950844,
					"content": "#非常暖心的安慰…但我已經不抱希望了。兩位好朋友，難得{F#妳}{M#你}們幫了我幾次，我卻提供不了什麼像樣的報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950845,
					"content": "等我休息一陣恢復得差不多了就準備返回楓丹了。雖然是很厚臉皮的請求…到時候可以麻煩兩位將我帶到正確的路上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950846,
					"content": "唉…要是能更早放棄…或者沒有死要面子…說不定現在已經走在正確的路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950847,
					"content": "只是帶路的話當然沒問題，既然你已經決定了…那就先好好休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950850,
					"content": "#嗯，謝謝{F#妳}{M#你}們，好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
				},
				{
					"id": 732950837,
					"content": "朝聖之路是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "卡特皮拉告訴我這是純水精靈們歷經的道路，在朝聖之路的盡頭也就是須彌，能找到治癒一切傷痛，讓人重獲新生的靈藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950819,
					"content": "（是超越派蒙理解的藝術呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
		{
