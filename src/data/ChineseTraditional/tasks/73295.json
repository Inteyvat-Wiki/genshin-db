						732950902
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950902,
					"content": "…朝聖之路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950903,
					"content": "啊，沒什麼，呃，只是一種…一種比喻的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
