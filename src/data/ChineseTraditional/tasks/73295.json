			"dialogs": [
				{
					"id": 732951201,
					"content": "啊，兩位好朋友，丟失的畫稿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732951202
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732951202,
					"content": "還沒呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732951203
					]
				},
				{
					"id": 732951203,
					"content": "沒關係，反正…反正不是什麼值錢的東西…",
					"roleType": "TALK_ROLE_NPC",
