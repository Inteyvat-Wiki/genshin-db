				"points": []
			},
			"dialogs": [
				{
					"id": 732950101,
					"content": "要幫牠留點什麼好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950102,
					"content": "#（期待地看著{F#妳}{M#你}們。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "狗"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "你還好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950402,
					"content": "我…我…唉…多謝兩位搭救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950403,
					"content": "昨晚做了個好夢，夢裡卡特皮拉站在朝聖之路的終點向我招手，記得夢裡我想，真怪呀，朝聖之路怎麼會是洞窟接著洞窟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950404,
					"content": "可是卡特皮拉分明就站在長長狹路的盡頭，於是我趕忙朝他的方向跑去，結果我還沒抵達，就被狗叫給吵醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950405,
					"content": "且不論狗叫的部分…我想這一定是好兆頭啊，今天一定能有所收穫，於是帶著寫生的道具出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950406,
					"content": "結果…結果在迷宮裡好像無頭蒼蠅，還被丘丘人給纏上…最後不僅沒逃脫，裝著畫稿的背包也在逃跑時掉落了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950407,
					"content": "今天也是丟三落四的一天呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "這能怪我嗎？這一帶簡直比楓丹的下水道還難繞…對了，我聽說須彌人都是住樹上的，難道這裡真的是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950409,
					"content": "天呀！須彌人到底都排泄了些什麼東西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950410,
					"content": "應該不是你想的那樣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950411,
					"content": "唉…我的人生就是不斷的失敗，一步錯步步錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950412,
					"content": "今天早上為什麼要離開安全的地方呢？雖然說夢見了好兆頭，可是那畢竟只是一個夢，我怎麼就當真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950413,
					"content": "#昨天為什麼不誠實一點告訴{F#妳}{M#你}們我的難處呢？要是早點請{F#妳}{M#你}們帶路，又怎麼會落得今天的下場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950414,
					"content": "當初為什麼要離開楓丹呢？就算不離開楓丹，日子也沒到完全過不下去的地步…反而離開之後一件好事也沒發生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950415,
					"content": "你、你先不要洩氣嘛，適合考察的地方，我們可以帶你去的！不過現在應該先把丟失的東西找回來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950416,
					"content": "唔…雖然不知道能不能全都完整地找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950417,
					"content": "哈哈，可能已經被丘丘人撿走當衛生紙了吧，反正…反正也不是什麼值錢的東西，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950418,
					"content": "誠實一點吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "對啊，就算不是能賣出很多價錢的東西，對于連本人來說也是很珍貴的吧？我們會盡量幫你找找的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950420,
					"content": "…話說回來，「胡椒」呢？牠沒和你在一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950421,
					"content": "哼，沒良心的東西…牠老早就跑掉了，現在應該躲在什麼安全的地方悠閒自得吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732950422,
					"content": "真不敢相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950423,
					"content": "唔…還是你先回營地休息一下，處理一下傷口吧！我們找到丟失的東西之後回營地找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950424,
					"content": "謝謝兩位…好朋友，人生在世就得靠朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329506",
							"2"
						],
						"stepId": 7329506,
						"stateName": "QUEST_STATE_UNFINISHED"
