				},
				{
					"id": 746560101,
					"content": "關於泡泡桔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560102
					]
				},
				{
					"id": 746560102,
					"content": "#那麼年輕的朋友，{F#妳}{M#你}帶了泡泡桔來吧？請分我一點，我們邊吃邊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560103
					],
					"speakerTitle": "伊斯梅諾"
				},
				{
					"id": 746560103,
					"content": "雕塑是無言的詩，不要在餓著肚子的時候欣賞它們。這是一位決鬥者在他人生最後一次決鬥中告訴我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "伊斯梅諾"
				},
				{
					"id": 746560106,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "還沒準備好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "#我按照從別人那裡聽說的，準備了錢來答謝{F#妳}{M#你}的泡泡桔。這樣的話，我好像應該等到{F#妳}{M#你}準備好了再給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯梅諾"
				}
