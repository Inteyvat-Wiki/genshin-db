				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "我親愛的路通，你…確定就是這個地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130102,
					"content": "不會錯的，加爾恰先生，這裡就是史萊姆最常出沒的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130103,
					"content": "我對史萊姆聚集地這一點毫無懷疑，我的問題是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130104,
					"content": "這些史萊姆，是否有點太多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130105,
					"content": "加爾恰先生，這就是我們缺少資金所導致的後果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130106,
					"content": "你是…加爾恰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "旅行者！太巧了，您也來須彌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130109,
					"content": "你在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "哈哈哈，我之所以在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130111,
					"content": "自討苦吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130112,
					"content": "勇敢赴險。謝謝，路通，你能不能稍微…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130113,
					"content": "如您所願，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130114,
					"content": "回到正題，我之所以來這裡，是想要尋找一些「史萊姆凝液」來為我的「推數機」製作潤滑劑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130115,
					"content": "但是，一方面是因為市場上販賣的「史萊姆凝液」普遍放置時間太久，品質不高，另一方面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130116,
					"content": "是因為加爾恰先生購買了太多書籍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130117,
					"content": "…是因為，我們被迫花費了許多…必要性支出！導致資金匱乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130118,
					"content": "所以我們才來這裡，想要直接取得一些新鮮的史萊姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130119,
					"content": "不過如您所見，我親愛的路通身為一個璃月人，既不會武功，也不會做菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130120,
					"content": "所幸我依然有著梳理帳目的天賦…這都得感謝總務司複雜的稅務規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130121,
					"content": "…而我，總不可能拿著我的「推數機」零件去砸人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130122,
					"content": "你需要我的幫助？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "在某種意義上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130124,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130125,
					"content": "路通，我們…呃，我們還有錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130126,
					"content": "在支付了這位旅行者的報酬後，我相信我們總能找到方法活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130127,
					"content": "那就可以！拜託您了，旅行者，請幫我去拿點史萊姆凝液回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130107,
					"content": "你怎麼會在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
