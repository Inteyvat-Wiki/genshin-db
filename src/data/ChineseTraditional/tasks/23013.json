			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "#旅行者，{F#妳}{M#你}拿到史萊姆凝液了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130302,
					"content": "已經拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "太棒了！這些應該就足夠了，我回去就開始做試驗，有了這些潤滑劑，我的「推數機」一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130304,
					"content": "我得去研究一下，路通，剩下的事就拜託你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130305,
					"content": "是的，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130306,
					"content": "這是您的報酬，旅行者，非常感謝您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130307,
					"content": "嗯…以我並不高遠的眼光來看，我們之後也許還會需要您的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130308,
					"content": "請您放心，只要帳目還歸我管理，您就一定能收到合理的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130309,
					"content": "…唉，我之所以會和加爾恰先生一起旅行，就是不願意像我父母一樣，一生都在璃月總務司的某個部門裡梳理帳目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130310,
					"content": "但現在…我除了和加爾恰先生一同進行運算工作外，還要來幫他梳理帳目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130311,
					"content": "也許這就是所謂的「命運使然」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
		{
