			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "路通，我們的資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130202,
					"content": "我們總能找到方法活下去的，加爾恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130203,
					"content": "我們璃月人有句老話叫做「車到山前必有路」，我認為十分適合用於形容我們現在的處境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130204,
					"content": "這句話的意思是，當我們前進的道路被一座大山擋住的時候，總是能找到跨過去的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130205,
					"content": "啊哈，非常巧妙的比喻，那看來我們的處境還不算太糟糕嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230130206,
					"content": "加爾恰先生，那您覺得寫下這句話的人，當時找到跨過山的辦法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130207,
					"content": "呃？噢，見鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
