			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通",
					"加爾恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "加爾恰先生，我再次誠心地建議您。我們可以賣幾部書以籌措資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131102,
					"content": "不！絕不！親愛的路通，你這是讓我去販賣我的靈魂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131103,
					"content": "先生，但問題在於沒人願意為靈魂出價啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131104,
					"content": "你怎麼還在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "旅行者？您怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131107,
					"content": "呃…我上次的試驗失敗了，我稀釋史萊姆凝液的方法有問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131108,
					"content": "做出來的潤滑劑不僅沒有起到潤滑「推數機」軸承的作用，反而讓它們更容易卡死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131109,
					"content": "所以，我需要更多的史萊姆凝液來做試驗。您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131110,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "史萊姆凝液就拜託您了，旅行者，我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 230131111,
					"content": "你們沒賺錢的方法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "不是沒有賺錢的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131113,
					"content": "而是沒有賺錢的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131114,
					"content": "非常感謝你的補充，路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131115,
					"content": "唉，非常慚愧…雖然我說我已經製造出了「推數機」，但它的功能實在太過簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131116,
					"content": "怎麼說呢，就連「運算」這件事也不能完全自行做到，需要我手動做很多輔助工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131117,
					"content": "但是…我一定會完善它！我充分地相信，我的「推數機」將是一個偉大的發明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131118,
					"content": "一個…一個宣告新時代和舊時代交替的發明！然後我一定能找到賺錢的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131119,
					"content": "但，但是在那之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230131105,
					"content": "你還需要史萊姆凝液嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
