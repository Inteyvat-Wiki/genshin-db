			"dialogs": [
				{
					"id": 230135001,
					"content": "先生，看來這裡就是我們要找的地方了，接下來要雇一些人來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230135002,
					"content": "先生？加爾恰先生？您在聽我說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230135003,
					"content": "嗯？喔…當然，我在聽，那我們就回去僱人吧，這花不了多長時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135004,
					"content": "你…還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "旅行者，哈哈哈…沒事，我很好，您為什麼會覺得我不好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135006,
					"content": "現在我正在全身心投入在研究「計數器」這件事上，我已經感覺到了，我離成功只有一步之遙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135007,
					"content": "#如果{F#妳}{M#你}願意的話，能幫我去拿一點史萊姆凝液來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135008,
					"content": "既然您在這裡，我也不用費大勁回城裡僱人了。正好我現在也賺了一點小錢，可以給您多一點報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135009,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "#那就交給{F#妳}{M#你}了，旅行者。我還得再想想怎麼修改機關結構…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230135010,
					"content": "這倒是沒什麼問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
