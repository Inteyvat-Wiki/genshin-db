					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "很好，這些就足夠了。路通，你能先把報酬付給旅行者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
