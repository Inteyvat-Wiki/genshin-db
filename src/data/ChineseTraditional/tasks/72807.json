			},
			"dialogs": [
				{
					"id": 728070201,
					"content": "#唉，真是頭痛…{F#妳}{M#你}好，有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070202,
					"content": "關於鐮治…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "#{F#妳}{M#你}說鐮治少爺？{F#妳}{M#你}找他有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070204,
					"content": "（出示親筆信）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "#{F#妳}{M#你}說這是柊千里小姐的親筆信？這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070206,
					"content": "不過，這封信要真是那位柊千里小姐的親筆信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070207,
					"content": "#這件事{F#妳}{M#你}還是…還是直接去問問鐮治少爺吧，他最近經常在橋那邊散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真田"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280703",
							"2"
						],
						"stepId": 7280703,
						"stateName": "QUEST_STATE_UNFINISHED"
