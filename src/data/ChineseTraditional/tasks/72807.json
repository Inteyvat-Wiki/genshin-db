					"柊千里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070501,
					"content": "#旅行者，{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070502,
					"content": "#{F#妳}{M#你}應該已經把信送給鐮治了吧…拿到「通行憑證」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070503,
					"content": "拿到了，謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "#不用謝我，還是多虧了鐮治願意批下這個憑證給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070506,
					"content": "咦？這是什麼，點心，還有…鐮治的親筆信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070507,
					"content": "#是他託{F#妳}{M#你}帶過來的嗎？這「三彩糰子」…他居然還特意準備了這個給我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070508,
					"content": "#謝謝{F#妳}{M#你}旅行者，這些點心我會好好品味的，這封信…我也會好好看一下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070509,
					"content": "#辛苦{F#妳}{M#你}跑這一趟了，這些東西請收下吧，就當做是報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070510,
					"content": "#以後…說不定我還要請{F#妳}{M#你}幫忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070505,
					"content": "這是鐮治給妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
		{
