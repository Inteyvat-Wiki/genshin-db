			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070401,
					"content": "#{F#妳}{M#你}好，歡迎光臨「木南料亭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070402,
					"content": "關於鐮治訂的點心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "#喔，鐮治少爺訂做的點心我已經準備好了，現在就拿給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070404,
					"content": "但是，不知道鐮治少爺是打算把這些點心送給誰呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070405,
					"content": "只是公家的往來罷了，木南小姐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070406,
					"content": "前段時間，柊慎介大人曾贈予了家父一批好茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070407,
					"content": "家父知道柊慎介大人的愛女柊千里小姐喜愛點心，就叮囑我備些點心寄送回去，也算是回禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070408,
					"content": "我擔心寄送過去耗時太長，路途上又免不了顛簸…所以專門拜託這位旅行者幫我把點心帶過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070409,
					"content": "木南小姐，請把那些點心拿給我看看吧，我先清點一下，免得疏漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070410,
					"content": "喔…好的，這是點心，請您看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070411,
					"content": "確實很齊全，謝謝妳，木南小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070412,
					"content": "#我們去旁邊吧，旅行者，不要擋在店門口了，我還有話要和{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070413,
					"content": "#這就是「通行憑證」了，{F#妳}{M#你}收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070414,
					"content": "#有了這憑證，{F#妳}{M#你}應該就可以自由出入離島了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070415,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "#不用謝，有了這憑證之後，{F#妳}{M#你}幫我送點心的時候也能更順利一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070417,
					"content": "還有…還有這封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070418,
					"content": "這是你的親筆信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "是的，我挑了一封我覺得用詞最…得體的，希望柊小姐讀的時候不會覺得不快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070420,
					"content": "#請{F#妳}{M#你}把這封信連同點心一起送給柊小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070421,
					"content": "又要回去嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "#呵呵，這次{F#妳}{M#你}可是拿著「通行憑證」回去的，出入應該都會十分自由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070423,
					"content": "#那拜託{F#妳}{M#你}了，旅行者，我也該回去處理公務了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070424,
					"content": "唉，什麼時候我才能直接登門拜訪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九條鐮治"
				}
			]
		},
		{
			"id": 7280705,
			"completionStepIds": [
