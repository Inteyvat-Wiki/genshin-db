			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九條鐮治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#{F#妳}{M#你}是…啊，是國外來的旅行者啊，找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070302,
					"content": "關於柊千里的親筆信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "#這封信，是柊小姐拜託{F#妳}{M#你}送來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070304,
					"content": "這字跡，果然是她…真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070305,
					"content": "#謝謝{F#妳}{M#你}專門跑這一趟，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070306,
					"content": "「通行憑證」的事…既然是柊小姐親自委託，我自然會辦周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070307,
					"content": "但是，這份「通行憑證」我還得回去準備一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070308,
					"content": "#這樣吧，{F#妳}{M#你}先去「木南料亭」那邊等我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070309,
					"content": "為什麼要去那裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "#這個…是我想請{F#妳}{M#你}幫我一個小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070311,
					"content": "我其實…前段時間也想著寄些東西給柊小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070312,
					"content": "我本來寫了封信，又找木南小姐訂了些點心，準備一同寄去給柊小姐，權當做是禮物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070313,
					"content": "#但要是父親發現我寄信給柊小姐，說不定會有些不快…我正想著怎麼寄信呢，{F#妳}{M#你}就正好來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070314,
					"content": "只是一份禮物而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "父親他是不太願意我和柊小姐通信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070316,
					"content": "我也明白他的顧慮，我身為九條家的族人，又是天領奉行的執行者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070317,
					"content": "而柊小姐又是勘定奉行柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070318,
					"content": "假如我與她交往過密，難免被有心人抓住話柄，借題發揮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070319,
					"content": "雖然這確實只是一份禮物，但在某些人眼中，卻又不僅僅是一份禮物那麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070326,
					"content": "呵呵，我還是別再說這些瑣事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070327,
					"content": "#旅行者，請{F#妳}{M#你}先去「木南料亭」等我吧，我批好「通行憑證」後，就拿去給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070320,
					"content": "你父親很嚴厲嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "父親他…自然是很嚴厲的。他之所以不太願意我和柊小姐通信，我也能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070322,
					"content": "我身為九條家的族人，又是天領奉行的執行者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070323,
					"content": "而柊小姐又是勘定奉行柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070324,
					"content": "假如我與她交往過密，難免被有心人抓住話柄，借題發揮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 728070325,
					"content": "雖然這確實只是一份禮物，但在某些人眼中，卻又不僅僅是一份禮物那麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九條鐮治"
				}
			]
		},
