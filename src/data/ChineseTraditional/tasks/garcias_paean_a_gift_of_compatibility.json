	"talks": [
		{
			"id": 7380301,
			"completionStepIds": [
				7380301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380301",
							"2"
						],
						"stepId": 7380301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030101,
					"content": "先生，恕我直言。您的這一份「樂譜」，我連哼唱它的方法都想像不出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030102,
					"content": "我真誠地建議，如果您真的想寫出一篇足夠…呃…正常的樂譜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030103,
					"content": "我們可以花一點錢，拜託劇院裡某位演員幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030104,
					"content": "不！不不不，不行，絕對不行，那樣就失去意義了，我再修改一下算式，等一下回去再輸出一份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030105
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030105,
					"content": "而且那麼做的話…一定要花更多的時間，我要再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030106
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030106,
					"content": "你們在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030107
					]
				},
				{
					"id": 738030107,
					"content": "旅行者，您來得正好，我和加爾恰先生正試圖把那台「計數器」訓練成一位作曲家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030108
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030108,
					"content": "這樣說您可能不太明白。簡單來說，加爾恰先生試圖讓「計數器」按照某種算式輸出樂譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030109,
						738030110
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030109,
					"content": "「計數器」真的能做到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				},
				{
					"id": 738030111,
					"content": "「計數器」本質上只是一台算數的機器，當然不可能直接輸出樂譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030112,
					"content": "所以當「計數器」算出結果後，還需要加爾恰先生自己按照另外一種算式，將數字手動轉寫為樂譜上的那些符號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030113,
						738030114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030113,
					"content": "頭，頭開始痛了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030115,
					"content": "沒錯！路通，你概括得非常好，我差不多就是這個意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030116
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030116,
					"content": "#解說就暫時到這裡，旅行者！我需要{F#妳}{M#你}幫我個忙…拜託{F#妳}{M#你}，務必幫我這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030117
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030117,
					"content": "摩拉和其他報酬都好說，我現在急需人手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030118,
						738030119
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030118,
					"content": "你是惹到什麼人了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030120,
					"content": "都不是，比這些問題可嚴重多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030121
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030121,
					"content": "#{F#妳}{M#你}還記得迦雅…呃，迦雅小姐嗎？她今天就要隨劇團離開須彌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030122
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030122,
					"content": "我答應過她，要送她一件臨別禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030123
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030123,
					"content": "而這份純粹由算式推算出來的「算式樂譜」，就是我想要送給迦雅的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030124
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030124,
					"content": "但是…但是這樂譜，連唱都不能唱…根本就無法當成禮物送出去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030125,
						738030126
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030125,
					"content": "不然，換一種禮物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030127,
					"content": "不行，要是禮物太普通了，迦雅小姐說不定就會…抱歉，我心有點亂，我要冷靜一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030128
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030128,
					"content": "總，總之，我需要再改進一下「計數器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030129
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030129,
					"content": "#旅行者，請{F#妳}{M#你}和我一起去找阿漢格爾先生吧，{F#妳}{M#你}一定能幫上我的忙，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030126,
					"content": "不然，去買份禮物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030119,
					"content": "是楓丹那邊有人要抓你回去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030114,
					"content": "我覺得我完全理解了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030110,
					"content": "「計數器」有這麼厲害嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				}
			]
		},
		{
			"id": 7380302,
			"completionStepIds": [
				7380302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380302",
							"2"
						],
						"stepId": 7380302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿漢格爾",
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030201,
					"content": "你之前給我畫的那幾張零件設計圖我看過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030202
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030202,
					"content": "這些零件倒是不難做，不過要達到你想要的細緻程度，還要花點時間來打磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030203
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030203,
					"content": "大概需要多長時間？今天能拿到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030204
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030204,
					"content": "那當然不可能了！你以為鍛造零件是寫字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030205
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030205,
					"content": "如果今天拿不到的話，那我一定來不及改造「計數器」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030206
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030206,
					"content": "唉，你怎麼急成這樣，你的那台機器不是已經做好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030207
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030207,
					"content": "這件事就由我來說明吧。我們遇見了一些…呃…意料之外的麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030208
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030208,
					"content": "路通敘述了事情的經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030209
					]
				},
				{
					"id": 738030209,
					"content": "也就是說，你對這位迦雅小姐一見鍾情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030210
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030210,
					"content": "什麼？！不！我們是合作關係，生意夥伴！天哪！我簡直…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030211
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030211,
					"content": "你對那位迦雅小姐表露過心意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030212
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030212,
					"content": "心意？什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030213
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030213,
					"content": "你就沒對她提起過你對她的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030214
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030214,
					"content": "我證明，加爾恰先生一定是提起過的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030215
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030215,
					"content": "什麼？！你…路通！你是怎麼知道的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030216
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030216,
					"content": "先生，你那次支開我的藉口實在是太簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030217
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030217,
					"content": "而且那天在咖啡館裡，你和迦雅小姐聊了半天，連一句有關「計數器」的話都沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030218,
					"content": "以我對您的瞭解，這不會是一次尋常的聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030219
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030219,
					"content": "謝謝！路通，我懇求你，把你的好記性用在正確的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030220,
						738030221
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030220,
					"content": "迦雅小姐怎麼說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				},
				{
					"id": 738030222,
					"content": "她…她說第二天的咖啡她來請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030223
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030223,
					"content": "啊哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030224
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030224,
					"content": "喔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030225
					]
				},
				{
					"id": 738030225,
					"content": "我們能不能別在這個問題上糾結了，現在的問題是零件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030226
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030226,
					"content": "#咳…既然{F#妳}{M#你}已經付錢了。那我也會盡快幫{F#妳}{M#你}製作這批零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030227
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030227,
					"content": "但是說真的，如果你想送一份能討那位迦雅小姐歡心的禮物，為什麼不直接去問問專業人士呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030228
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030228,
					"content": "比如管劇場的謝赫祖拜爾，他很瞭解那些演出人員們的喜好，說不定會知道送迦雅什麼禮物合適呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030229
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030229,
					"content": "這個主意不錯，加爾恰先生，請您在這裡繼續和阿漢格爾先生討論零件的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030230,
					"content": "而我和這位旅行者，則去劇場那邊問問謝赫祖拜爾先生關於禮物的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030231,
					"content": "就像您常和我說的，無論做什麼事都要有一個備案，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030232
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030232,
					"content": "謝謝你，路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030233
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030233,
					"content": "不客氣，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030234
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030234,
					"content": "那我們就出發吧，旅行者。希望我們能找到…合適的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030221,
					"content": "她的態度是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				}
			]
		},
		{
			"id": 7380303,
			"completionStepIds": [
				7380303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380303",
							"2"
						],
						"stepId": 7380303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"謝赫祖拜爾",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030301,
					"content": "呼…總算可以休息一下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030302
					],
					"speakerTitle": "謝赫祖拜爾"
				},
				{
					"id": 738030302,
					"content": "咦？你們是來找我的？有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030303
					],
					"speakerTitle": "謝赫祖拜爾"
				},
				{
					"id": 738030303,
					"content": "我們想問問迦雅小姐的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030304,
					"content": "路通敘述了想要詢問的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030305
					]
				},
				{
					"id": 738030305,
					"content": "迦雅？噢，我記得，她的舞跳得可好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030306
					],
					"speakerTitle": "謝赫祖拜爾"
				},
				{
					"id": 738030306,
					"content": "她的愛好啊…嗯…非要說的話，她特別喜歡「棗椰蜜糖」這種小點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030307
					],
					"speakerTitle": "謝赫祖拜爾"
				},
				{
					"id": 738030307,
					"content": "迦雅不是要離開須彌了嗎？最近她還一直在託人到處買這種點心呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030308
					],
					"speakerTitle": "謝赫祖拜爾"
				},
				{
					"id": 738030308,
					"content": "「棗椰蜜糖」…對了，前幾天為了驗證「計數器」的性能，我們轉寫過一批食譜，裡面正好就有「棗椰蜜糖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030309,
					"content": "唔，這主意倒是不錯，但即便是轉寫出了食譜算式，還是得要人親手來做啊。我和加爾恰先生對烹飪技術可以說是一竅不通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030310,
					"content": "我見識過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030311
					]
				},
				{
					"id": 738030311,
					"content": "但這也能算是一個備用方案，我們先回去把這個主意告訴加爾恰先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030312
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030312,
					"content": "看您的表情，是還有什麼問題想問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030313,
						738030317
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030313,
					"content": "你們為什麼不跟著迦雅走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030314
					]
				},
				{
					"id": 738030314,
					"content": "這一點我也向加爾恰先生建議過。我甚至和那個劇團的老闆溝通過，那位老闆也很願意讓我們隨團管理帳目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030315
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030315,
					"content": "但是，加爾恰先生還是很堅決地拒絕了我的建議。他說自己的工作還沒有完成，這台「計數器」還有太多要完善的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030316
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030316,
					"content": "呵呵，說實話，這是我第一次嚴肅地質疑加爾恰先生對事物重要程度的判斷力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030322
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030322,
					"content": "不說這些了，我們先把消息帶回去給加爾恰先生吧，希望阿漢格爾先生不會再次被他耗盡耐心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030317,
					"content": "迦雅小姐和你們說過什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030318
					]
				},
				{
					"id": 738030318,
					"content": "那我可不知道。自從前幾天開始，加爾恰先生每次和迦雅小姐約會的時候，我都自己去旁邊喝咖啡，而且盡量保證自己的目光不要往那邊瞄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030319
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030319,
					"content": "其實我一直希望，有一天加爾恰先生會突然坐在我面前，說他要把「計數器」這件事給放一放，先跟著迦雅小姐四處旅行一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030320
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030320,
					"content": "不管他是給我一筆錢，讓我先回璃月，還是要我幫他們倆繼續管帳…我都欣然接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030321
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030321,
					"content": "但加爾恰先生每次都是拍了拍我的肩膀，和我說：「路通，我們得繼續討論一下機關結構了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030322
					],
					"speakerTitle": "路通"
				}
			]
		},
		{
			"id": 7380304,
