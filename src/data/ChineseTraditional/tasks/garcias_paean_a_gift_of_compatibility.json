				"points": []
			},
			"dialogs": [
				{
					"id": 738030601,
					"content": "老兄，你為什麼非要拿你那個怪機器寫什麼樂譜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030602
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030602,
					"content": "你看，須彌城裡既有香料，又有不少首飾店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030603
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030603,
					"content": "如果你覺得這些都不行，我也可以幫你做點小首飾嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030604
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030604,
					"content": "哎呀，這個…我和迦雅是因為那台「計數器」認識的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030605
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030605,
					"content": "我希望也送她一份和這台「計數器」有關的禮物，就是這份「算式樂譜」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030606
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 738030606,
					"content": "嘿…你還真是個怪人，那個迦雅小姐可是專業劇團裡的人，天天都能讀到好樂譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030607
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030607,
					"content": "你那個樂譜，要是被她丟到一邊，或者忘在腦後了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030608
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 738030608,
					"content": "迦雅不會這麼做的，絕對不會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		}
