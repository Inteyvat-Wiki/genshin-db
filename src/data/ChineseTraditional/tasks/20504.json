			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "歡迎光臨，這裡的寶物保證獨一無二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040102,
					"content": "好多都是沒見過的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040103,
					"content": "哈哈，當然了，這些都是冒險家從世界各地找到的稀奇寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040104,
					"content": "怎麼樣，有一眼就看中的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040105,
					"content": "感覺都很奢侈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "#不會不會，忘記跟{F#妳}{M#你}介紹了，我這裡都是以物易物，不收取摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040108,
					"content": "我最近想做一個特殊的工藝品，需要大量的<color=#00E1FFFF>「風之印」</color>來裝飾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040109,
					"content": "#{F#妳}{M#你}們身上有<color=#00E1FFFF>「風之印」</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040110,
					"content": "找到了幾個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "#哈哈，那看起來{F#妳}{M#你}的冒險已經得到風神的認可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040114,
					"content": "#總之，只要{F#妳}{M#你}有<color=#00E1FFFF>「風之印」</color>，就可以和我交換商店裡所有的商品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040115,
					"content": "挑選商品",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "那是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "那是一種印記，風神會將它送給受到認可的冒險者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040106,
					"content": "我根本不敢看價格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
