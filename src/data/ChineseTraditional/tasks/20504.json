			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>「風之印」</color>有可能出現在蒙德的任何地方，如果不夠用的話就去多找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040302,
					"content": "真的只是用來裝飾嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "是啊，怎麼說都是風神的贈禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040304,
					"content": "#哈哈，{F#妳}{M#你}們還挺敏銳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040305,
					"content": "解釋起來挺複雜，用裝飾品的說法大家都容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040306,
					"content": "我會選擇用<color=#00E1FFFF>「風之印」</color>，自然是有非它不可的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040307,
					"content": "做好了記得讓我看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "#哈哈，肯定的，保證讓{F#妳}{M#你}大吃一驚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040312,
					"content": "#歡迎再來哦，希望{F#妳}{M#你}下次能帶來很多很多的<color=#00E1FFFF>「風之印」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040313,
					"content": "找到什麼稀奇寶物的話也記得要帶到我這裡來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 205040309,
					"content": "故弄玄虛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "但我真的有點好奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040311,
					"content": "哈哈，就是要保持未知才會有驚喜啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "瑪喬麗"
				}
			]
		}
	]
}