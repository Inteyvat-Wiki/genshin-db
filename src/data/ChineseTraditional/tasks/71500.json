	"talks": [
		{
			"id": 7150001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150001",
							"2"
						],
						"stepId": 7150001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "唔…如此便好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000102,
					"content": "#旅行者，{F#妳}{M#你}來得正巧，本仙剛把這機關給安置周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000103,
					"content": "這就是…「機關烹飪神機」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "正是。這機關由本仙親自設計安置，妙用無窮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000107,
					"content": "為了製作這烹飪用機關，本仙查閱無數古籍。須知，在「烹飪」這一事中，有幾件最重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000108,
					"content": "其一，尋覓食材。烹飪一事中，食材至關重要。為了搜羅珍奇的食材，無數廚師勞心勞力，四處奔波…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000109,
					"content": "本仙的機關，首先便能解決這一難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000110,
					"content": "只需啟動這機關，它便會自動尋找周邊最適合烹飪的食材，並且沿途標識出該食材的氣息，廚師只需要循路前往即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000111,
					"content": "它不能自己去拿嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "咳，這個嘛…本仙研究時間尚短，暫時無法解決…鍋怎麼在崎嶇山路上自動尋路這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000113,
					"content": "其二，即是烹煮一事。本仙在機關內設置了無數機巧物件，只需投入食材，它便會自動處理妥當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000114,
					"content": "它怎麼知道要怎樣處理食材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "這個嘛…自然是要按照對應的食譜細細設置各項參數，將每種食材所需的處理方法都設置好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000116,
					"content": "#個中奧妙，三言兩語難說清，本仙不作贅述，{F#妳}{M#你}們只要明白這事挺麻煩就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000117,
					"content": "此外，結合本仙心得，烹飪期間最令廚師們煩躁的雜事，乃是「清理鍋灶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000118,
					"content": "否則，大快朵頤之後，還得清理鍋中的殘羹冷炙，實在有些煞風景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000119,
					"content": "這機關賣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "#哈哈哈，只怕{F#妳}{M#你}買不起本仙這玄機妙器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000121,
					"content": "#況且，此機關目前僅能靠本仙的仙力驅動，{F#妳}{M#你}買回去也沒什麼用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000125,
					"content": "好了，閒話就說到這。本仙一邊製作著機關，一邊也研究著食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000126,
					"content": "如今機關製作完畢，本仙同時鑽研出了幾道世間未有之美食，用以測試「機關烹飪神機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000127,
					"content": "#本仙此次請{F#妳}{M#你}來，是想請{F#妳}{M#你}幫本仙幾個小忙，搜羅些食材，按照這些食譜烹出菜餚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000128,
					"content": "第一道菜，本仙特此賜名：「文心豆腐」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000129,
					"content": "做這道菜需將豆腐切成纖絲…正好測試一下這機關的「刀工」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000130,
					"content": "至於食材嗎…要用到豆腐、火腿，竹筍與禽肉，本仙已託甘雨備好了食材，就在這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000131,
					"content": "咦？竹筍哪去了？之前明明擺在這裡，難道是本仙安置機關時太過入神，被什麼東西趁隙偷走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000132,
					"content": "#哼，不過…來吧，剛好讓{F#妳}{M#你}們見識下「機關烹飪神機」搜尋食材的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000133,
					"content": "機關烹飪神機…啟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000134,
					"content": "#旅行者，本仙已啟動機關，{F#妳}{M#你}且循著氣息，去把本仙的竹筍拿回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000122,
					"content": "為什麼做這個機關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "要說目的…自然是為了點撥這世間的機關之道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000124,
					"content": "另一方面，有了這機關，本仙平時做菜也會方便些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000105,
					"content": "這機關有什麼用？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "#哼，{F#妳}{M#你}倒是心急。稍安勿躁，待本仙慢慢為{F#妳}{M#你}道來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
		{
			"id": 7150002,
