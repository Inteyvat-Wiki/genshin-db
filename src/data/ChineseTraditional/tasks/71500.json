			"dialogs": [
				{
					"id": 715000201,
					"content": "#{F#妳}{M#你}們拿到竹筍了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "#其餘的事就交給這機關，但是旅行者，還得請{F#妳}{M#你}幫忙照看一下火候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000304,
					"content": "這機關不能自動控制火候嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "這個嘛…本仙之前也嘗試過將灶火內置，想要以機關控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000306,
					"content": "但「機關烹飪神機」所需的灶火不同尋常…必須得是本仙親自操控仙力化出的火焰才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000307,
					"content": "若是把這種等級的仙火內置，一些細小的機關部件可能會被烤得變形，導致機關失靈。因小失大，實不可取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000308,
					"content": "目前最好的解決方法，還是將仙火置於機關外部。只是如此一來，我需要一個人幫著控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
