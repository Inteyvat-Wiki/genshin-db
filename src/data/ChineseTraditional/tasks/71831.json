			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "這廟看著還算不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310302,
					"content": "確實很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "欸？您來得倒是剛剛好，這廟才修好不久，我剛給工匠們結完錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310304,
					"content": "唉…沒想到居然花了這麼多錢，我辛苦賺的那些錢，已經全部砸裡面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310305,
					"content": "不過無論如何，這廟建好了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310306,
					"content": "您想去廟裡敬敬香嗎？我還專門託人做了一個新香爐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310307,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "這幾炷香您拿著，香爐就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310308,
					"content": "你也敬香了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "那當然。廟剛建好之後，我可是敬了一柱上好的香，剛剛才燒完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "王平安"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
