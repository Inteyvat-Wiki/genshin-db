			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "您敬好香了吧，感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310502,
					"content": "還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "那就好。希望這座廟以後香火會盛一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310504,
					"content": "我會暫時待在這裡一段時間。這裡很清靜，是個進行編寫工作的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310505,
					"content": "我得盡快整理一下我之前蒐集的那些資料，然後繼續編寫那本有關「護法夜叉」的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310506,
					"content": "您以後有空的話，也可以多來這廟裡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310507,
					"content": "想要敬香的話，直接找我拿香就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310508,
					"content": "唉，其實我還想把周圍也再整修一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310509,
					"content": "路得重新鋪一遍，兩邊要加上圍欄，旁邊還要再做個花圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
