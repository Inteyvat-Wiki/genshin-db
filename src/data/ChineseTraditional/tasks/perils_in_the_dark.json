			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "「…安東上士在東南方發現了一口大鐘…岩壁上寫著『它們』的文字…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "愚人眾的日誌本"
				},
				{
					"id": 710430102,
					"content": "「…和大尉之前在西北方的遺蹟裡看到的大鐘相近，或許…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "愚人眾的日誌本"
				},
				{
					"id": 710430103,
					"content": "「…派遣雪奈茨芙娜與法迭卡兩人，分別敲響兩側遺蹟中的大鐘…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "愚人眾的日誌本"
				},
				{
					"id": 710430104,
					"content": "「…可怖的呼嘯聲回蕩在岩壁間，黑霧消散了。難以解釋的奇特現象…似乎在昭告著誰的登場…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "愚人眾的日誌本"
				},
				{
					"id": 710430105,
					"content": "「…十人犧牲，兩支先鋒小隊皆蒙受嚴重損失，大尉下令立即撤離…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "愚人眾的日誌本"
				},
				{
					"id": 710430106,
					"content": "（一張簡易的地圖從日誌本中滑落，地圖上標出了西北方與東南方的兩處大鐘，並畫了兩個醒目的骷髏頭。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人眾的日誌本"
				}
			]
		},
