						741210304
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210304,
					"content": "喂！不要不理我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210305,
					"content": "…妳好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210306,
					"content": "天氣真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210307,
					"content": "關於那邊那個人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "什麼人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210309,
					"content": "我不知道什麼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210310,
					"content": "我們只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210311,
					"content": "在這裡散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210312,
					"content": "沒錯。我們只是在這裡散步。兩個正在散步的普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210313,
					"content": "天氣真好。散步真美妙。您不這麼認為嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210314,
					"content": "散步是完全正常的事情，您一定可以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210315,
					"content": "呃，你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210316,
					"content": "剛剛你們聽到呼救的聲音了嗎？在那邊，有個人埋在土裡，差點被螃蟹吃掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210317,
					"content": "居然會有這種事，發生在我們散步的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210318,
					"content": "發生在這麼好的天氣裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210319,
					"content": "他要是被螃蟹吃掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210320,
					"content": "那就太好笑了。我是說，可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210321,
					"content": "可惜，我們不會讓這種事情發生。我是說，不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210322,
					"content": "如果我們在散步時遇到了，一定會制止。我是說，如果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210323,
					"content": "你們在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210325,
					"content": "都說了，是散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210326,
					"content": "真的什麼都沒注意到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210327,
					"content": "什麼也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210328,
					"content": "沒錯，什麼也沒有。除了，有兩個人正在打擾我們的散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210329,
					"content": "散步是很…個人的事情。我們不喜歡被人打擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210330,
					"content": "推薦您也找個好地方，去散步。露景泉就很適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210331,
					"content": "但這裡是我們散步的地方。我是說，感受大自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210332,
					"content": "所以不希望被人打擾，再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				}
			]
		},
