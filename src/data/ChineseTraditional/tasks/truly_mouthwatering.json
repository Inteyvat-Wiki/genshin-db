						741210602
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210602,
					"content": "哎呀…我什麼都…我這個是最新的美容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210603,
					"content": "嗚哇，你們什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210604,
					"content": "我們在散步，散步…是一種運動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210605,
					"content": "運動會帶來移動，移動將我們帶到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210606,
					"content": "是你們做的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "是的話又…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210608,
					"content": "#亨特，我想起來了。你仔細看看{M#他}{F#她}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210610,
					"content": "是他提到過的那位，千萬不能招惹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210611,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210612,
					"content": "你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210613,
					"content": "沒什麼，我們只是在散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210614,
					"content": "沒錯。我們只是在散步。如果沒什麼別的事，我們就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210615,
					"content": "我們就繼續散步到別的地方去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210616,
					"content": "欸？你們不用對我做什麼可怕的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210617,
					"content": "教訓應該已經夠了，如果你明白我的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210618,
					"content": "什麼教訓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "沒什麼。我是說，烤雞很危險，會引來麻煩的東西。就當作是寶貴的教訓吧，我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210620,
					"content": "但是，烤雞…那可是德波…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 741210621,
					"content": "別管烤雞了！我們該繼續散步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "特納"
				},
				{
					"id": 741210622,
					"content": "「下次再讓桑尼大哥請我們吃烤雞。」\\n特納說著，帶著亨特離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "#謝謝！謝謝{F#妳}{M#你}們，我就知道{F#妳}{M#你}們能夠明白我的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210624,
					"content": "#看來真的和{NICKNAME}說的一樣…我們把恩里挖出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210625,
					"content": "不過，做這個事情需要很多體力，所以烤雞就歸我們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210626,
					"content": "啊啊？可惡…沒辦法，只好答應了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210627,
					"content": "花費了一些時間將恩里從砂土中挖了出來，並將他身上不知為何套著的桶子取了下來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "和派蒙一起開始吃香噴噴的烤雞。\\n恩里看起來很想吃，但他守住了諾言和尊嚴，並沒有開口要。\\n而派蒙看到恩里的樣子，還是主動把烤雞分給他了。\\n外皮烤得香脆無比，散發著油脂香氣。非常美味！",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
