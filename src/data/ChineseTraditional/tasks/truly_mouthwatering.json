				]
			},
			"dialogs": [
				{
					"id": 741210101,
					"content": "#謝謝！謝謝！太感謝了，{F#妳}{M#你}們真是我的大救星。我恩里永遠不會忘記這份恩情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210102,
					"content": "不說這個，我更好奇你是怎麼落到這種處境的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210103,
					"content": "唉，那些螃蟹一定是被烤雞的香味吸引過來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210104,
					"content": "我也是被烤雞的香味吸引過來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210105,
					"content": "螃蟹和妳才不一樣啊！我看牠們，大概在考慮是先吃我還是先吃烤雞，生怕牠們最後還是決定新鮮的更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210106,
					"content": "有道理，還是新鮮的好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "欸，我問的是恩里的事情啦！正常人不會被埋在土裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210108,
					"content": "所以，你需要幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210111,
					"content": "當然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210112,
					"content": "呃…兩位，當然不用！！不用幫忙把我挖出來！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210113,
					"content": "#嗚哇，知道了知道了我們聽得到，不用這麼大聲！那我們走吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210114,
					"content": "#等等，拜託{F#妳}{M#你}們等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210115,
					"content": "嗯？怎麼啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210116,
					"content": "我…呃，咳咳！是這樣的！！兩位請聽好！！這是一種剛發明的美容方法！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210117,
					"content": "都說了不用喊啦！好吵哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210118,
					"content": "兩位千萬不要懷疑！！我是神智健全的人，選擇了這種科學又健康的美容方法！！以自己的力量，將自己埋在了潮濕的砂土中！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210119,
					"content": "請快點離開吧！！不要擋住我的陽光！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210120,
					"content": "呃，那我們走吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210121,
					"content": "#既然{F#妳}{M#你}們好奇！那就沒辦法了！！那就請聽我解釋這種美容方法的妙趣吧！！呃，砂土中的沙蠶等動物能夠清除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210122,
					"content": "#（嗚哇，好吵。{NICKNAME}，這個人到底怎麼回事呀？講話前後不一…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210123,
					"content": "（感覺有些蹊蹺…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "#（是喔？{F#妳}{M#你}有什麼想法嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210125,
					"content": "（先看看周圍情況吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "#欸，{F#妳}{M#你}們要走了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210127,
					"content": "我們先看看周圍的情況，再回來找你喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741210128,
					"content": "#好的！！{F#妳}{M#你}們趕快去吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 741210109,
					"content": "比較好奇你為什麼被埋在土裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "對呀！你需要幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
