						],
						"stepId": 7211508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "您放好信標了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150302,
					"content": "已經放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "多謝您了，就讓它們慢慢地搜集數據吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150304,
					"content": "你為什麼會知道那些地點？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "這個「御影爐心」我也參與了設計，在那幾個點上放置信標，基本上就可以搜集「御影爐心」內大部分區域的數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150306,
					"content": "唉，要是能直接在那幾個點上設置淨化儀器的話，睡一覺這事就基本上結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150307,
					"content": "現在這個情況…要是弗洛瓦先生知道的話，他非瘋了不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150311,
					"content": "好了，謝謝您幫忙，這些東西請先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150312,
					"content": "咳，那個…過段時間，說不定還得麻煩您把那些信標拿回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
