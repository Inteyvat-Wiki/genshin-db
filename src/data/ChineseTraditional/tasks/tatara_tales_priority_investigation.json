	"talks": [
		{
			"id": 7211501,
			"completionStepIds": [
				7211502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211502",
							"2"
						],
						"stepId": 7211502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#{F#小姐}{M#先生}，真是幸會！關於「御影爐心」，我有一個好消息和一個壞消息，您想先聽哪一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150102,
					"content": "好消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "好消息是，爐心的損毀似乎並不嚴重，還在我可以處理的範圍內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150104,
					"content": "但壞消息是，正在裡面折騰的那群愚人眾並不太樂意接受這個好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150105,
					"content": "他們似乎還在不斷尋找染指「祟神」核心的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150111,
					"content": "再讓他們這麼折騰下去，「祟神」的力量遲早會真的失去控制，然後把這座島，還有島上的我們一起炸上天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150112,
					"content": "但如果我們只把注意力放在愚人眾這邊，那護罩中累積的「祟神」，遲早也會抵達臨界點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150113,
					"content": "所以，我們要同時對付兩邊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "嗯…通俗地來說，從學術的觀點，客觀地來講…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150115,
					"content": "現在的情況就是，我們面前擺著愚人眾和「祟神」兩個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150116,
					"content": "但鑑於「御影爐心」裡的現狀，假如我們想要解決其中某一個問題，那在實踐過程中，我們有很高的機率也必須面對另一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150117,
					"content": "所以，我們面對的現實情況就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150118,
					"content": "你是說「沒錯」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "呃，是的，沒錯。我們就是要同時對付兩邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150120,
					"content": "但我們還是一步步來吧，璃月人不是常說「心急吃不了熱豆腐」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150121,
					"content": "你還知道璃月諺語？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "之前我們也去過璃月，這是一點旅途的小紀念品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150123,
					"content": "這樣的紀念品我還有很多，但蒙德的紀念品我已經喝乾淨了…味道非常不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150124,
					"content": "好了，我們還是說正事吧。為了搞定這個「御影爐心」，我有一個小計畫，想要請您幫幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150125,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "啊哈！我就是喜歡您這樣…直爽的性格，太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150131,
					"content": "咳，我們說回正題。這些「偵測信標」請拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150132,
					"content": "我想拜託您，把這些「偵測信標」放在幾個位置上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150133,
					"content": "這些信標能搜集「御影爐心」內「祟神」力量的濃度與分佈數據，只要有這些數據，我就能制訂更詳細的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150134,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "那就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150141,
					"content": "我把那些放置點幫您標記在地圖上，就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150136,
					"content": "這信標到底是什麼原理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "簡單來說…就是一種基於元素力原理，對於各類能量進行量化測算的儀器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150138,
					"content": "「簡單來說」…雖然我想這麼說，但它的運作也沒辦法簡單地講清楚。對了，就從七大元素說起吧！是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150139,
					"content": "不、不用說了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "好吧，如您所願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150127,
					"content": "我能得到什麼好處？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "好處嘛…當然是這座島上那些還沒被發現的寶藏，和「御影爐心」裡的一些「邊角料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150129,
					"content": "您瞧，作為稻妻最大的冶煉設施，「御影爐心」裡肯定還有些…嗯…值得一看的好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150130,
					"content": "當然！作為一個沒有「神之眼」的人，我現在可沒辦法進入「御影爐心」，那裡面的情況，我也無從知曉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150106,
					"content": "壞消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "壞消息是，那群愚人眾還在「御影爐心」內部折騰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150108,
					"content": "他們似乎還在不斷尋找染指「祟神」核心的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150109,
					"content": "雖然好消息是，現在爐心的損毀似乎並不嚴重，還在我可以處理的範圍內…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721150110,
					"content": "但很明顯，愚人眾並不太樂意接受這個好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "澤維爾"
				}
			]
		},
		{
