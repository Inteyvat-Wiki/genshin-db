			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "沒想到我們會被困在這個地方，這下可真是難辦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280602,
					"content": "就算我博學廣聞，那也是在律法領域之內。我可不懂什麼「越獄」的知識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280603,
					"content": "虧我還和老爹定過「要快樂生活」的契約呢…唉，至少我不能消沉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280604,
					"content": "往好處想，能來新地方開開眼界，還能和舊友重逢，都是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280605,
					"content": "嗯嗯…對，好事。嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "煙緋"
				}
			]
		},
