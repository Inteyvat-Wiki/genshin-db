			"dialogs": [
				{
					"id": 10280801,
					"content": "不行，我要再去看一次。拿出我荒瀧天下獨尊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280802,
					"content": "老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280803,
					"content": "噫！幹嘛那麼嚴肅嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280804,
					"content": "烤堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280805,
					"content": "哈？發生了那麼大的事情，妳就叫我在這烤堇瓜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280806,
					"content": "哞！哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280807,
					"content": "聽見沒，阿丑都說妳說得對…等等，阿丑你又是幫哪邊的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280808,
					"content": "哞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280809,
					"content": "後勤是很重要的。保持充沛的體力和穩定的精神狀態，才能應對未知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280810,
					"content": "阿丑也知道這個道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280811,
					"content": "好啊，你們一個兩個的…這就已經吃上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280812,
					"content": "等等，已經熟了？香倒是挺香的…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280813,
					"content": "好吧，那就先墊墊肚子再想辦法。別把堇瓜吃完了，也給我留兩個啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
