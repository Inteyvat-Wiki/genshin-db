			},
			"dialogs": [
				{
					"id": 230110301,
					"content": "真是倒楣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110302,
					"content": "關於維克多的木頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "#{F#妳}{M#你}是說那個愚人眾找我訂的木頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110304,
					"content": "唉，別提了，我就說跟愚人眾做生意不會有好運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110305,
					"content": "那批木頭運到一半就被魔物襲擊了，人是全跑回來了，但車毀了，木頭都丟在了半路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110306,
					"content": "唉，現在這情況，我是不敢過去了，一時之間也找不到人去趕走那些魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110308,
					"content": "我不是愚人眾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "#{F#妳}{M#你}不是愚人眾嗎？那{F#妳}{M#你}怎麼幫他做事？奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110310,
					"content": "無論如何，那輛車我暫時是拉不回來了，我只能等到能雇到人之後再想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110311,
					"content": "#如果{F#妳}{M#你}著急要木頭的話，我把那輛車大概的地方標在地圖上給{F#妳}{M#你}，{F#妳}{M#你}自己過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "哈馬維"
				},
				{
					"id": 230110312,
					"content": "唉，只要和愚人眾扯上果然就遇不上好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈馬維"
				}
			]
		},
