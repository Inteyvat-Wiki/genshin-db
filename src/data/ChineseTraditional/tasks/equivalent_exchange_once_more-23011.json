			"dialogs": [
				{
					"id": 230110601,
					"content": "怎麼樣，我買的木頭已經到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110602,
					"content": "向維克多敘述了事情的過程…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "又是魔物？我怎麼感覺全世界的貨車都很容易被魔物襲擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110604,
					"content": "算了，反正木頭能送回來就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110605,
					"content": "來，這是說好的報酬，好好數一數吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110606,
					"content": "還有…那個，莉莉還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110607,
					"content": "我走的時候也沒和那孩子當面道別，她沒生氣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110608,
					"content": "她很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "#那就行，咳…{F#妳}{M#你}別這麼看著我，我就是關心一下啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110614,
					"content": "不說這些了，再數數報酬吧，旅行者，我可是一分都沒少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110610,
					"content": "你自己回去看看她吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "那弗謝沃洛德先生非得踢我不可，算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110612,
					"content": "我也不太敢直接寄信過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110613,
					"content": "收到一封來自愚人眾的信，聽起來就不像什麼好事，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "維克多"
				}
