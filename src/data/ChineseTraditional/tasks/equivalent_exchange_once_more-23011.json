			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "呃…這裡該怎麼雕來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110102,
					"content": "嗨！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "哎呀，誰啊，別吵我，我正…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110105,
					"content": "#啊？！旅行者？！{F#妳}{M#你}怎麼也來須彌了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110106,
					"content": "#不會是魯道夫那傢伙派{F#妳}{M#你}來揍我的吧，我只是很久之前送了莉莉一點禮物而已啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110107,
					"content": "我只是旅行過來啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "#{F#妳}{M#你}還在旅行中啊，真是夠有精力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110112,
					"content": "#不過，真沒想到能在須彌遇見{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110113,
					"content": "我從蒙德被調走的時候，本來接到的命令是讓我直接回至冬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110114,
					"content": "不過，半路上又來了一道新命令，讓我來須彌城協助弗謝沃洛德先生的工作，還告知我，我已經被調到了「公雞」大人手下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110115,
					"content": "「公雞」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "對…呃，不行，我不能接著往下說了，不然弗謝沃洛德先生又要說我對保密工作不仔細了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110118,
					"content": "唉，這些執行官大人的名字又不是什麼秘密，真不知道他為什麼這麼敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110119,
					"content": "你在須彌做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "哦，我和弗謝沃洛德先生主要負責的是協調後勤補給工作。簡單來說，就是到處去採購啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110121,
					"content": "雖然聽起來也不是很重要，但總比在蒙德教堂裡一直發呆好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110122,
					"content": "嘿嘿，而且做這個，在工作時有很多空閒時間，也沒人一直盯著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110123,
					"content": "我就把我小時候做木雕的手藝撿回來了，反正須彌木頭多，剛好練手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110124,
					"content": "沒想到我雕的那些小玩意，居然還滿受孩子們喜歡的。這幫小毛孩一直吵著要，我就答應他們，幫他們每個人都雕一個玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110125,
					"content": "你是愚人眾吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "是啊，怎麼了？哎呀…誰規定愚人眾就不能送玩具給孩子們了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110127,
					"content": "再說了，我現在就是個管後勤的，那些驚天動地的大事，就留給上面的大人們去處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110130,
					"content": "總之，我現在的情況就是這樣啦，雖然沒能回至冬，但我還滿喜歡須彌的，有吃有玩，環境也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110131,
					"content": "工作完了之後，我就去買點吃的，然後找個陽光好的地方雕我的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110132,
					"content": "#雖然…哈哈，大家看我的表情都有點不信任，就和{F#妳}{M#你}第一次跟我說話的時候一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110133,
					"content": "那也沒辦法，誰讓我是個愚人眾呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110134,
					"content": "我現在也不信任你哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "好吧…總而言之，我對現在的生活還挺滿意的，而且手頭還有了點積蓄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110137,
					"content": "再這麼過幾年，說不定我就在須彌定居得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110138,
					"content": "#咳，不說了不說了。旅行者，既然{F#妳}{M#你}也來須彌了，那如果{F#妳}{M#你}有興趣的話，我們兩個就繼續「等量交換」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110139,
					"content": "#不過，這次我沒故事跟{F#妳}{M#你}說了，只能給{F#妳}{M#你}真金白銀的報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110140,
					"content": "這樣更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "好了，我來說明一下委託內容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110144,
					"content": "我前幾天找哈馬維訂了一批木頭，但是他現在還沒把貨物送來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110145,
					"content": "現在我還在工作時間，也不敢直接去找他，不然弗謝沃洛德先生又要教訓我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110146,
					"content": "#旅行者，{F#妳}{M#你}就幫我去找哈馬維問問，我要的那一批木頭什麼時候到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110147,
					"content": "報酬準備好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "#{F#妳}{M#你}就放心吧，絕對準備好",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110151,
					"content": "#總之，這件事就交給{F#妳}{M#你}了啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110149,
					"content": "你真沒打什麼鬼主意嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "#我之前跟{F#妳}{M#你}做交易的時候哪次打了鬼主意的，{F#妳}{M#你}就放心吧，我才懶得做那種麻煩事呢，舒舒服服地生活不好嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110141,
					"content": "這是「愚人眾」的委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "當然不是，這只是「維克多」的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110135,
					"content": "誰信任你了，別攀關係！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "你該不會是想從孩子們嘴裡套情報吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "#喂！我不會做這種事的，{F#妳}{M#你}對愚人眾到底有什麼可怕的刻板印象啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110116,
					"content": "是另一位執行官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "是啊，和我回蒙德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "#哈。哈。哈。好哦，那{F#妳}{M#你}要不要把我銬著帶走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110111,
					"content": "#好啦，不和{F#妳}{M#你}開玩笑了，我還有正事要辦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 230110103,
					"content": "維、維克多？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
