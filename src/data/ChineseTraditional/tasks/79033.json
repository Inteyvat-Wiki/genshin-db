			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "海螺居然能夠從井中浮起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330202,
					"content": "畢竟是被幻境影響的海螺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#嗯，真是奇妙…啊，影像顯示出來了，{NICKNAME}，{F#妳}{M#你}快看，那裡有個彎腰的…哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}，{F#妳}{M#你}不要動，{F#妳}{M#你}的身後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330206,
					"content": "是、是什麼可怕的東西嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "啊，仔細一看只是海螺產生的影像，突然出現在背後，真是嚇了人一大跳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330209,
					"content": "訊號測試器…兩組…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330210,
					"content": "唉，我還以為他被單獨叫出去是要受什麼嚴重的懲罰，結果只是被指派了比較麻煩的任務，真是鬆了口氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330211,
					"content": "他很害怕被你罵呀，哈哈，看起來就像是害怕被「哥哥」罵的「弟弟」一樣…你說，他是不是，其實怕的是我們對他失望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330212,
					"content": "明明大家只是小隊成員而已…但有的時候，感覺就跟「家人」一樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330213,
					"content": "家人嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330214,
					"content": "嗯…總有種偷聽到了不該偷聽到的話的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330215,
					"content": "影像裡這幾個人好像不是…「那麼壞」的愚人眾嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330207,
					"content": "不許故意嚇人哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "大概殼中有空氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
