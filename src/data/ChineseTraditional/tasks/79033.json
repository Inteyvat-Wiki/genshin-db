							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "哦，看上去像是兩個人躺在地上呢…是在看天上的星星？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330302,
					"content": "總覺得是有點奇怪的影像呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330303,
					"content": "雅科夫，長官對你說了些什麼，你這麼垂頭喪氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330304,
					"content": "因為海浪顛簸，搬運儀器的時候摔了一跤，幸好我手快，儀器沒事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330305,
					"content": "但是長官還是訓話說，要讓我們小隊去各個島上做裝置的信號接收測試，那可是最辛苦的任務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330306,
					"content": "沒關係，不必這麼傷心，我們什麼累活沒做過啊。別傷心啦，先吃點東西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330307,
					"content": "他們指著那麼高的地方，是想要吃什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330308,
					"content": "難道這個海螺…放歪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}