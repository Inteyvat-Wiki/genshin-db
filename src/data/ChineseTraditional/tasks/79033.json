			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "唔，影像居然正好放在舞臺的中間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330102,
					"content": "這兩個人在幹嘛呢…看起來就像是一個人在說什麼，另一個人坐在地上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330103,
					"content": "我知道了，這個一定是在講故事的畫面！他們一定是快要睡覺了，所以影像裡她正在為坐在地上的人講睡前故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330104,
					"content": "愚人眾也要聽睡前故事嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "說不定愚人眾裡也有人有這種需要的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330106,
					"content": "阿加霞，佩爾西科夫大人讓我們去做訊號接收測試，是讓我們四個一起去…葉夫卡要是聽到這件事，又得生氣不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330107,
					"content": "雅科夫，不會的，這是上面大人的命令，葉夫卡肯定也不會責怪你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330108,
					"content": "唉，你要是真這麼害怕，我陪你去跟葉夫卡說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330109,
					"content": "什麼嘛，原來不是在講故事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790330110,
					"content": "不過這段對話沒頭沒尾的，根本什麼都看不出來嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
