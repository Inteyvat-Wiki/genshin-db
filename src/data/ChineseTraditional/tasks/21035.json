			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "唉，師妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350102,
					"content": "咦？孫宇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "#旅行者？真是巧了，居然能在這裡遇見{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350105,
					"content": "我…正在這裡做些鍛煉，準備過段時間就離開璃月，外出遊歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350106,
					"content": "你怎麼突然要離開璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "咳，說來慚愧。之前我雖然一直說著要復興古華派，但平日裡的行動…說是訪仙，其實也就是在絕雲間裡閒逛罷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350109,
					"content": "雖然承蒙師妹不棄，但我內心深知，如此行為，對復興古華派實無意義…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350110,
					"content": "前段時間，當我回城裡採買物資的時候，偶然和一個楓丹來的客商聊了兩句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350111,
					"content": "這位楓丹人和我說：「你不可能在出現問題的地方找到解決問題的方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350112,
					"content": "我想了好久…也許這位楓丹客商，是在建議我去璃月之外的地方遊歷一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350113,
					"content": "出去看看也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "我也是這麼想，但…但師妹她卻不願意離開璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350116,
					"content": "平日裡她耍小脾氣的時候，我知道她是在和我逗樂，哄哄就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350117,
					"content": "但這次她卻像是真生氣了，無論如何都不願聽我說話，還獨自跑回了城裡，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350118,
					"content": "#先不說這些了，這些閒雜事情{F#妳}{M#你}聽了也煩…旅行者，我能拜託{F#妳}{M#你}一件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350119,
					"content": "雖然我會一些防身的武術，但平日裡幾乎沒怎麼真的動過手。以後要外出遊歷，免不了要正經實戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350120,
					"content": "#旅行者，我聽說過許多{F#妳}{M#你}在外冒險的事蹟，{F#妳}{M#你}一定知道不少應對魔物的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350121,
					"content": "#{F#妳}{M#你}能陪我一起去周圍找些魔物練練手，順便再指導指導我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350122,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "我看看…附近就有一處魔物的聚集地，咱們就先去那裡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350123,
					"content": "哼，就怕你看不清我的動作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "這…閣下武藝竟如此高強？哈哈哈，那就只能請閣下把動作稍稍放慢些啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350114,
					"content": "就當做是散心也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "你不是要復興古華派嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
			"completionStepIds": [
				2103503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103503",
							"2"
						],
						"stepId": 2103503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "呼…呼…真是難以對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350202,
					"content": "#抱歉，讓{F#妳}{M#你}見笑了。沒想到正式對敵時，我會這麼緊張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350203,
					"content": "#總之我…我還是需要多多鍛煉。多謝了旅行者，這些報酬給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350204,
					"content": "你真的要離開璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "我還沒有完全想好，我還得再想想，順便…再嘗試說服一下師妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		}
	]
}