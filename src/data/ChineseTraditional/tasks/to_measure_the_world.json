					"法伽尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "嗯嗯…原來是這樣嗎？只要再引入這個變數，就能解釋之前的誤差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250402,
					"content": "不過這麼一來，別的推論會不會也跟著改變呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250403,
					"content": "有進展了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "#啊，不好意思，都忘了{F#妳}{M#你}還在這裡…來，這是說好的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250405,
					"content": "至於進展嘛…雖然解決了一些問題，但又好像出現了不少新問題…大概這就是做研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250406,
					"content": "#在得出最終的結論之前，可能還是得繼續麻煩{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法伽尼"
				}
			]
		},
