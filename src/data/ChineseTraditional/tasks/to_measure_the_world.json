			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法伽尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "嘿——這位朋友，請問能否佔用您一點時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250202,
					"content": "有什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "您有沒有想過這麼一個問題：要是天塌下來該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250209,
					"content": "我覺得你多慮了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "或許是吧，但天空為什麼不會坍塌？大地又為什麼不會陷落？如果不經過準確的測量，這些問題就永遠不會有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250213,
					"content": "其實我已經有了一套完美的模型來解釋這些問題，只是需要更多的觀測數據來支撐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250214,
					"content": "需要我幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "那您是願意幫忙了吧，真是太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250224,
					"content": "其實我已經選定了一個絕佳的觀測地點，只是那附近的魔物有些活躍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250225,
					"content": "拜託您驅離那些魔物，我好安心去做觀測記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250226,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "多謝了，我們這就上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250228,
					"content": "你也要到現場嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "畢竟有些數據還是得親眼去見證，才能發現誤差產生的原因啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250230,
					"content": "埋頭對著紙堆計算，可是會離正解越算越遠的——我們快點上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250215,
					"content": "祝你好運，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "等、等等啊！您再考慮一下吧，只要我的成果能夠發表，那可是開天闢地的大事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250217,
					"content": "到時候，您就是這篇偉大理論的協力者，我可以在文末的致謝列表裡寫上您的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250218,
					"content": "唔…要不然的話，第二作者的位置也不是不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250219,
					"content": "有這麼著急嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "要是再拿不出結果，我的研究經費怕是都要出問題…這可比天什麼時候會塌要命得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250221,
					"content": "「第二作者」就算了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "報酬合理就可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "天應該塌不下來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "我很忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "哦！請別這麼說，有什麼事情能比自己的居所坍圮在即還要嚴重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250205,
					"content": "你家屋子…要塌了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "咳咳，那當然不是。但如果您住在一座屋子裡，卻從沒見過這屋子的全貌，也沒人保證過屋子的結構強度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "法伽尼"
				},
				{
					"id": 230250207,
					"content": "那每天生活在這屋子裡，也是會有不安的吧？那麼住在這個世界裡也是一個道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "法伽尼"
				}
			]
		},
		{
			"id": 2302504,
			"completionStepIds": [
				2302504
			],
