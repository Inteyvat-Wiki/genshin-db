			},
			"dialogs": [
				{
					"id": 413330401,
					"content": "嗯…怎麼感覺…聞起來怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330402
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330402,
					"content": "#這怎麼能端給紫微，{F#妳}{M#你}再幫我換一份好的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵塊兒"
				}
			]
		},
		{
