			]
		},
		{
			"id": 4133306,
			"completionStepIds": [
				4133308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133308",
							"2"
						],
						"stepId": 4133308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鐵塊兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330601,
					"content": "這個看著可真不錯！這可真是萬事俱備…只…只欠去找紫微了！",
					"roleType": "TALK_ROLE_NPC",
