			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鐵塊兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "「九天玄羅仙人漫天飛座」…真美啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330102,
					"content": "你是在看星星嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "是…也不是，這不是海燈節嗎？看點這種文雅的東西，應景嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330104,
					"content": "我還學著寫了點詩咧，聽其他兄弟說，現在的女孩子都喜歡這種調調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330105,
					"content": "嗨，紫微也一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330106,
					"content": "寫詩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "咳咳…我可是從紫微那聽說了不少星座的名字，哎呀…那些名字可好聽了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330109,
					"content": "#{F#妳}{M#你}看，我總得感謝一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330110,
					"content": "我就想，我自己作首詩寫在霄燈上，和紫微一起找個好地方放了…吃著零食唱著歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330111,
					"content": "——這好事不就成了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330112,
					"content": "成了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "咳！我是說…這個節日的氛圍，不就成了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330114,
					"content": "總之，我想找個氣氛好點，路人少一點，景色漂亮點的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330115,
					"content": "我還特地找人問過了，找到了兩個好地方…你看看，就這兩地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330116,
					"content": "我聽其他兄弟說，他們以前都是在這兩個地方放霄燈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330117,
					"content": "不過我還得作詩呢…隨便亂跑連靈感都要跑掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330118,
					"content": "#{F#妳}{M#你}能不能幫我跑一趟考察一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330119,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "#多謝{F#妳}{M#你}願意幫忙，那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330107,
					"content": "紫微？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
