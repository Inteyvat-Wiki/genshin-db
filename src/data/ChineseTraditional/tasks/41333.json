					"鐵塊兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "「鐵塊紫微一相逢」…不行不行，這也太直接了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330202,
					"content": "嗯？你們什麼時候來的，地點都找過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330203,
					"content": "都找過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "這麼快？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330205,
					"content": "嗯…讓我看看…一個重重疊疊別具一格，一個鱗次櫛比錯落有致…真是「橫看成嶺側成峰」…下一句是什麼來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330206,
					"content": "…算了不管了，還是從正面看過去明亮大方比較氣派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330207,
					"content": "#嗯，好！我知道選哪裡了…旅行者，我還想請{F#妳}{M#你}再幫我一個小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330208,
					"content": "#我兄弟說，和人家說話的時候，最好還得備點吃食，{F#妳}{M#你}覺得，我和紫微說話的時候，準備什麼好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330209,
					"content": "烤吃虎魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "烤吃虎魚…哎呀，會不會太油了點，有點不太講究，不然還是杏仁豆腐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330212,
					"content": "對，杏仁豆腐，這個很適合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330213,
					"content": "#旅行者，拜託{F#妳}{M#你}幫我去準備一份杏仁豆腐吧，我同時間想一下這詩該怎麼改…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330214,
					"content": "「撞出火花無數」…這句不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330211,
					"content": "杏仁豆腐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
		{
