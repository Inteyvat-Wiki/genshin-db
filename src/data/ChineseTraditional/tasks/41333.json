				}
			]
		},
		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紫微"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "這個角度…這個星座…好像一條狗啊…取什麼名字好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330702,
					"content": "哦，是鐵塊兒啊？你們找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330703,
					"content": "呃…那個…就是…我在璃月港外面隨便走了走，偶然發現了一個好地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330704,
					"content": "好地方？是觀星的好地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330705,
					"content": "是，是觀星的好地方，也是放霄燈的好地方。我霄燈都準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330706,
					"content": "妳看，我在上面還寫了…寫了一首詩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330707,
					"content": "「鐵鍬隕星一相逢，便撞出火花無數」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330708,
					"content": "嗯…雖然我不知道你要許什麼願，但這詩是很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330709,
					"content": "不過霄燈上的願望可不能提前讓人家看到，不然會不靈驗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330710,
					"content": "然後，你今天來找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330711,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330712,
					"content": "他找了個很合適放霄燈的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "放霄燈？哦…抱歉，其實我正想找個霄燈少點的地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330715,
					"content": "因為霄燈的光照有點影響觀星，我打算再走遠一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330716,
					"content": "謝謝你們的好意，我要再往那邊走一走了，希望你們海燈節玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330717,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330718,
					"content": "走掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "我…我沒事，一定是我寫得太隱晦了，紫微沒有看懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330721,
					"content": "放心，我不會氣餒的，總有一天…她會明白我的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330722,
					"content": "#旅行者，謝謝{F#妳}{M#你}幫我的忙，這些東西請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330723,
					"content": "唉，我至少要把這盞霄燈給放了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330719,
					"content": "不要氣餒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "妳要放霄燈的話，不如和他一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
