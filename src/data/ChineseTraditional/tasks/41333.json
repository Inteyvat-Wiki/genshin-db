			"dialogs": [
				{
					"id": 413330301,
					"content": "嗯？你們什麼時候來的，杏仁豆腐準備得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "鐵塊兒"
				},
				{
					"id": 413330302,
					"content": "準備好了",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "還需要一點時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "哎呀沒事，我也得再想想這詩該怎麼寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵塊兒"
				}
			]
		},
		{
