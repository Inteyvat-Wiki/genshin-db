						20050802
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050802,
					"content": "咱們去的那幾個武士家，除了其中一個特別窮之外，基本上都富得流油，這下可發財了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050803,
					"content": "這點錢算什麼，這只是咱們兄弟發家致富的第一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050804,
					"content": "今天開始，我會帶著你們在盜寶行業闖出一番名堂，讓我們威名遠揚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050805,
					"content": "老大威武！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "阿豪"
				},
				{
					"id": 20050806,
					"content": "…看來他們就是我們要找的盜寶團了，讓我們去教訓他們一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
