				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "怎麼只有你一個人在這裡呀，剛剛纏住你的那兩個人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050402,
					"content": "我對他們說，再不走的話，我就拔刀了。他們就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050403,
					"content": "果然，這比用言語說服他們方便多了。或許，今後我也應該…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050404,
					"content": "#盜寶團的事情查清楚了？我沒有騙{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050405,
					"content": "其實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "大概就是這樣。其實你真的有發「救濟糧」，只不過這些糧食是你自己掏錢買的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050407,
					"content": "怎麼會…以前的我是這樣的人嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050408,
					"content": "#我完全沒有印象了。就算{F#妳}{M#你}告訴我了這些事情，我也想不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050409,
					"content": "以前的我為什麼要做這種事？這不是自討苦吃嗎？真是難以理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050410,
					"content": "不過確實，剛剛握住這把刀，對他們兩個施加威脅的時候，我也感受到了身體在本能地抗拒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050411,
					"content": "這把刀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "這把刀，曾經是我老爹的佩刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050414,
					"content": "我記得小時候有一次，我從老爹那裡偷了這把刀，想要在鄰居家的孩子面前炫耀一番，結果被老爹狠狠地教訓了一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050415,
					"content": "他跟我說…說什麼來著…奇怪，我又記不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050416,
					"content": "「神之眼」被奪走之後，我好像忘記了很多重要的事情。記憶裡盡是大段大段的空白，不管怎麼想都想不起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050417,
					"content": "只記得老爹好像說過，這把刀上，有他一生的信條。而他在離開這個世界之前，親手把刀交到了我的手裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050418,
					"content": "還對我說，拿著這把刀，就應該…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050419,
					"content": "嗯…仔細看看的話，這個刀柄上是不是刻著字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050420,
					"content": "#旅行者，{F#妳}{M#你}能看出來上面刻著什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050421,
					"content": "是「仁義」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "「仁義」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050423,
					"content": "這麼說的話，好像就能解釋得通了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050424,
					"content": "不惜負債累累，也要讓他人獲得幸福，這就是我過去最大的願望吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050425,
					"content": "但「仁義」，有什麼用？我踐行此道，用自己的錢買糧食救濟他們，可結果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050426,
					"content": "天領奉行奪走了我的神之眼，而那些被我救濟的人也不願意理解我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050427,
					"content": "最諷刺的是，我朝他們拔刀的時候，還會感受到心痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050428,
					"content": "我做不了好人，連壞人都當不了！我到底…到底該怎麼辦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050429,
					"content": "又是一個好可憐的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050430,
					"content": "關於他欠錢的事，有空我們和托馬他們說一下吧，社奉行應該會支援他一下的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050431,
					"content": "總不能真的讓他把自己珍視的刀也賣掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050432,
					"content": "失去神之眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "嗯…原來失去願望是這麼可怕的一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050435,
					"content": "#好在{F#妳}{M#你}沒有神之眼，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050436,
					"content": "我們還是去下一個失去神之眼的人那裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050433,
					"content": "好像確實很可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "能讓我們看一下嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
