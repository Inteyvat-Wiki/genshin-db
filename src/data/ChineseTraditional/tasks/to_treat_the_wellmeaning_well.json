						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿賢",
					"忠夫",
					"派蒙",
					"阿豪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "可惡，怎麼會這樣…我的錢，那可是我們辛辛苦苦偷來的啊……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050202,
					"content": "老大，快想想辦法啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050203,
					"content": "#咳咳，這個…我看{F#妳}{M#你}身手不錯，不知道有沒有興趣加入盜寶團，與我們共謀大事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050204,
					"content": "先把黑澤的事情告訴我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "黑澤？哦哦…我想起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050207,
					"content": "#{F#妳}{M#你}們原來是他派來的？晦氣，真是晦氣，早知道就不應該順路去他家的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050208,
					"content": "黑澤的家裡怎麼樣？有很多糧食吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050209,
					"content": "糧食？沒有沒有，而且家裡亂糟糟的，倒是…有個盒子挺別致的，我猜裡面一定有寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050210,
					"content": "本想回去再打開的，就擔心被什麼其他人盯上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050211,
					"content": "#但既然被{F#妳}{M#你}們逮到了，乾脆就拿這盒子來贖我們自己吧，{F#妳}{M#你}們看成不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050212,
					"content": "算你們有誠意，快打開看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050213,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050214,
					"content": "這是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050215,
					"content": "欠、欠條？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "阿豪"
				},
				{
					"id": 20050216,
					"content": "而且好像很多呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050217,
					"content": "好像是寫給雜貨店葵小姐的欠條，哇…欠了好多錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050218,
					"content": "究竟是怎麼回事呢…我們去雜貨店問問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050219,
					"content": "喂，你們走吧！當心下次不要再被我們逮到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050220,
					"content": "好！好！謝謝小老爺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "阿賢"
				},
				{
					"id": 20050221,
					"content": "拿欠條贖了我們的身…是不是算我們賺到了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "阿豪"
				},
				{
					"id": 20050222,
					"content": "快走吧你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "忠夫"
				},
				{
					"id": 20050205,
					"content": "聽說你們洗劫了黑澤的家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "「九十九物」，無所不有。客人想要買點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050302,
					"content": "還是說…想要打聽些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050303,
					"content": "這欠條…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "呵呵，原來是黑澤先生的朋友，客人是來替黑澤先生償還債務的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050305,
					"content": "不不不，我們只是想打聽一下「欠條」的來歷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050306,
					"content": "黑澤為什麼會欠這麼多錢，他在這裡買了什麼貴重的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050307,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050308,
					"content": "黑澤先生會定期在我們這裡購買大量糧食，不過用的是他自己的薪水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050309,
					"content": "但是最近糧價上漲，黑澤先生自己的薪水已經不夠了。他就開始向我們寫欠條，透過賒帳來換取等量的糧食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050310,
					"content": "原來「救濟糧」是這麼來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050311,
					"content": "可是黑澤為什麼一定要買「等量」的糧食呢？糧價上漲的話，少買一些不就可以了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050312,
					"content": "客人不妨想一下。領取「救濟糧」的民眾，在拿到這些糧食之前，一定會反覆思考這些糧食能支撐多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050313,
					"content": "他們精打細算，日夜核對，拿到手的時候卻發現數量比預想中要少…黑澤先生認為，這會讓他們感到很失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050314,
					"content": "為了照顧他們的感受，黑澤先生寧願透過賒帳來換取等量的糧食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050315,
					"content": "這些糧食，實際上是黑澤自己買的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050316,
					"content": "他們沒有感謝黑澤，反而還不停地責怪他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050317,
					"content": "人的態度往往取決於他們的處境，在生存問題面前，大多數人是不會顧慮那麼多的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050318,
					"content": "在我看來，如果黑澤從一開始就公佈「救濟糧」的來源，現在面臨的麻煩應該會少一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050319,
					"content": "當然，也只是少一點而已。他所做的，本來就是吃力不討好的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050320,
					"content": "至於他為什麼要花錢購買糧食救災，又為什麼不願留下姓名供人感激…這些我就不清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050321,
					"content": "#如果{F#妳}{M#你}們好奇的話，直接去問問黑澤先生如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050322,
					"content": "他也不記得了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "哦…說起來，他好像剛剛被收繳了「神之眼」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050324,
					"content": "這就有點麻煩了…如果黑澤先生還不清欠款的話，大概就只能賣掉那把他很珍視的刀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050325,
					"content": "刀？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050326,
					"content": "#黑澤先生沒有跟{F#妳}{M#你}們說嗎？他有一把很寶貝的刀，常年帶在身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050327,
					"content": "我也曾向他詢問過刀的來歷，黑澤先生說是他的父親送的，再高的價格都不賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050328,
					"content": "當時我還感到有些遺憾，畢竟在我看來，世間萬物都有價格，只要能開出相應的價碼，應該什麼都買得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050329,
					"content": "#{F#妳}{M#你}們也可以問問黑澤先生關於刀的事情。說不定{F#妳}{M#你}們要找的答案，就在那把刀上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050330,
					"content": "當然，在那之前，也請客人先結清一下這次的帳單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050331,
					"content": "但我們明明什麼也沒有買呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050332,
					"content": "呵呵，「情報」也是貨物的一種，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050333,
					"content": "不過，關於黑澤先生的情報倒是並不貴，畢竟黑澤先生也沒有特別叮囑我們要保守秘密。讓我想想…兩千摩拉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "葵"
				},
				{
					"id": 20050334,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "至少我們知道了「救濟糧」的來歷，還有黑澤一直帶著的那把刀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050336,
					"content": "再去找黑澤問問吧，看看他能不能想起來什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200504,
