			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"大森",
					"悠也",
					"黑澤京之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "奇怪，據說「天領奉行」直屬於將軍管轄，統管稻妻治安方面的事宜，眼狩令就是他們在執行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050102,
					"content": "可是為什麼他們要對自己的同伴下手呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050103,
					"content": "想不明白…等等，那邊似乎發生了爭吵，我們先過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050104,
					"content": "我說，這個月的救濟糧，你是打算不給了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050105,
					"content": "我們一家人可都等著這些糧食養活呢！今天不給我們一個說法，你就別想走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050106,
					"content": "說了多少遍，我不知道什麼救濟糧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "黑澤京之介"
				},
				{
					"id": 20050107,
					"content": "還在騙人，那可是救命的糧食，不是給你們這些武士中飽私囊用的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050108,
					"content": "武士就能為所欲為了嗎！我要去天領奉行所告發你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050109,
					"content": "「救濟糧」指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "#{F#妳}{M#你}是誰？跟黑澤是一夥的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050111,
					"content": "不不不，我們只是路過的普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050112,
					"content": "聽到你們在爭吵，就想過來看看情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050113,
					"content": "#原來是這樣。正好，{F#妳}{M#你}來幫我們評評理——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050114,
					"content": "這個叫黑澤的武士，是幕府軍的人。幕府軍在這附近派發救濟糧，他就是負責人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050115,
					"content": "以前我們只要找到他就可以領到糧食，但現在他突然不給了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050116,
					"content": "一定是他起了貪念，打算自己吞掉這批糧食！可是沒有這批糧食，我們就要餓肚子了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "大森"
				},
				{
					"id": 20050117,
					"content": "根本就沒人考慮我們的感受…以前還覺得他是個有良心的人，現在看來他和別的武士一樣壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050118,
					"content": "怪不得連「神之眼」都被收回去了，雷電將軍治理國家也不想要這樣的人協助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "悠也"
				},
				{
					"id": 20050119,
					"content": "原來這個人就是綾華說的人呀，可是綾華為什麼要我們幫助這種人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20050120,
					"content": "我們還是問問這位叫黑澤的武士是怎麼想的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
