				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "唔…還得再去佈置一批寶箱才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640102,
					"content": "什麼寶箱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "#欸？！{F#妳}{M#你}是…旅行者嗎？{F#妳}{M#你}也是來參加「逐月節」的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640104,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "#那{F#妳}{M#你}來得剛好。為了慶祝逐月節，我們冒險家協會正在舉辦活動呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640106,
					"content": "#怎麼樣，{F#妳}{M#你}想要瞭解一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640107,
					"content": "具體是什麼活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "逐月節期間，我們冒險家協會在各地佈置了一種叫做「逐月符」的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640111,
					"content": "找到這些逐月符的人，可以將它們帶回協會，兌換各種獎勵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640112,
					"content": "另外，協會還派遣了一批冒險家，在野外佈置了一大批特別寶箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640113,
					"content": "這些特別寶箱裡面，都裝著協會專門準備好的各種寶物哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640114,
					"content": "除了這兩項活動之外，協會還為那些想要挑戰自我的精英冒險家們，設置了一連串的高難度挑戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640115,
					"content": "具體來說…就是一連串的魔物營地啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640116,
					"content": "這和逐月節有關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "#啊…哈哈哈，這個…這…{F#妳}{M#你}別這麼說嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640119,
					"content": "只要討伐了那些魔物，協會也會給予相應報酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640120,
					"content": "這和平時的委託有什麼區別？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "#拜託，拜託{F#妳}{M#你}啦！逐月節期間，大部分冒險家都去過節了，好多委託都沒人接。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640122,
					"content": "#怎麼樣？憑{F#妳}{M#你}的身手，對付那些魔物肯定不在話下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640123,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "#報、報酬方面一定不會讓{F#妳}{M#你}失望的，放心吧旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640126,
					"content": "#逐月節期間，我會一直待在這裡，有什麼問題，{F#妳}{M#你}直接過來問我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640127,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。那個…好好享受逐月節吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640124,
					"content": "準備好報酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "這和逐月節一點關係都沒有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "不會又是各種日常雜務吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "不會啦！這次的活動可都是很有冒險感的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "琳陽"
				}
			]
		}
	]
}