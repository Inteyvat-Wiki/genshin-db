			"dialogs": [
				{
					"id": 737080201,
					"content": "看來留言轉達得很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080202,
					"content": "終於又見面了，「黃金流星」和「白銀伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080203,
					"content": "#{F#妳}{M#你}們容光煥發的模樣，讓我有種時間停滯的美好感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080204,
					"content": "久違了，海妮耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "真的是你們啊，海妮耶和「咚咚小圓帽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080206,
					"content": "難怪看了留言，我就有種奇妙的熟悉感…代表我和「咚咚小圓帽」的默契還在！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737080212,
					"content": "#我設想過許多重逢的情景，例如舉辦豐盛的宴會，或是富有創意的歡迎儀式，給{F#妳}{M#你}們一個巨大的驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080213,
					"content": "#但感覺都有些見外，考慮到{F#妳}{M#你}們一直很忙，說不定佔用太長時間，反而會讓{F#妳}{M#你}們覺得麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080214,
					"content": "而且現在的蕈獸夥伴們也喜歡寧靜的環境，所以，就讓我們以鬆弛自然的方式重逢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080215,
					"content": "沒錯沒錯，海妮耶讀的散文派上用場啦！平靜的心態對生活有益！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080216,
					"content": "還是像這樣，輕輕鬆鬆聊天最開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "歡騰之火"
				},
				{
					"id": 737080218,
					"content": "左右加小姐也在，還有「歡騰之火」和…這位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080219,
					"content": "#是我自己的蕈獸夥伴「信風舞姬」哦。當時在三十二強賽上，被{F#妳}{M#你}們和「咚咚小圓帽」一下就打敗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080220,
					"content": "哎呀，還是妳記得清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080221,
					"content": "熟悉的感覺逐漸回來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "#總之，兩位大老闆，就像{F#妳}{M#你}們看到的這樣，我們再也不用約定什麼下次見面的時間和地點啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080224,
					"content": "海妮耶和我已經買下了這片商區，將這裡改造成常駐的「小小靈蕈樂園」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080225,
					"content": "等等，妳的意思是…現在這裡的設施不是為了新的桌遊租用的，而是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080226,
					"content": "沒錯，以後我們就會一直生活在拜達港，向人們推廣蕈獸的桌遊，以及和動物們交流的理論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080227,
					"content": "#只要{F#妳}{M#你}們有空，隨時可以來這裡找蕈獸夥伴們玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737080229,
					"content": "好耶！蕈獸夥伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "這這這…這是我今天聽過最好的消息之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080232,
					"content": "第一次蕈獸大賽後，我就想了好多好多…和「咚咚小圓帽」一起玩的點子，這下可以慢慢做到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080233,
					"content": "對了，這裡的開銷不低吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "放心啦，摩拉目前不是問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080235,
					"content": "這段時間，除了在貝爾福先生的幫助下經營「靈蕈棋陣」和「小小靈蕈大幻戲」這款桌遊來賺取資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080236,
					"content": "我們還彙整了以往的經驗，將馴獸和蕈獸的許多知識統整成系統性的理論，試著刊印了一些書籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080237,
					"content": "甚至，有些學者也因此給了我資金資助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080238,
					"content": "用我累積的學問為更多人提供方便、換取摩拉，讓蕈獸夥伴們過得更好，一切都進入了正向的循環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080239,
					"content": "有、有點厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080240,
					"content": "感覺海妮耶已經變成了穩重的…「馴獸理論專家」，能把一切問題統統搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080241,
					"content": "多虧左右加引導得好，她讓我按照學生們的方法，挑戰了自己應該學會的技能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080242,
					"content": "喂喂！這種謙虛不要學啊，我才不是什麼超級老師，誇妳就好好接受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080243,
					"content": "講得輕鬆，其實有過困難吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "的確也遇過許多難題，但過去那些不好的事情，就讓它們隨時間走遠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080246,
					"content": "我最大的遺憾是——這一年來，沒怎麼帶蕈獸夥伴們好好在外遊玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080247,
					"content": "從我開始歸納自己的馴獸理論開始，大多數時間我們都在洞窟和樹屋裡，過著晝夜混亂的寫稿生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080248,
					"content": "商務生活太累人，趕稿的日子也真是難熬，我更理解左右加的一些想法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080249,
					"content": "其實也不全是負面評價嘛！寫完稿子的一瞬間，還是非常有滿足感的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080250,
					"content": "嗯，我同意，每次完稿都值得吃一頓放縱餐來慶祝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080251,
					"content": "可是，蕈獸夥伴們也享受不了我們的食物，或許在它們看來，生活變得越來越枯燥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080252,
					"content": "長期如此，夥伴們的精神狀況也會變差，很不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080253,
					"content": "那，既然現在妳們的狀況穩定下來了，也有了固定的住所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080254,
					"content": "其實可以由我們兩個帶著蕈獸夥伴們出去玩玩，玩到盡興就送它們回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080255,
					"content": "這樣，妳們就可以忙手頭的工作，蕈獸夥伴們也能好好玩樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080256,
					"content": "派蒙這個主意好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "我支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080259,
					"content": "談到賞玩的地點，我是純粹的理論派，只能從書上找去處。第一次到楓丹的時候，其實還鬧過迷路的笑話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080260,
					"content": "海妮耶更是個呆瓜，連須彌有哪些好玩的地方都不知道，以前都光顧著工作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080261,
					"content": "上次在楓丹待了那麼久，行程規劃也不到位，最後連想去的甜品店都沒去成，錯過了好奇好久的馬卡龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080262,
					"content": "咳咳…換成「黃金流星」和「白銀伴星」的話，一定可以找到各種好地方讓蕈獸夥伴們大開眼界，暢玩一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080263,
					"content": "那我的確要好好物色地點了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "稍等啊，請帶著這個小留影機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080266,
					"content": "海妮耶取出一臺平平無奇的留影機放在「咚咚小圓帽」頭上，「咚咚小圓帽」居然能夠穩穩頂著留影機，似乎已經習慣托著這種東西飛行了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "雖然外觀很普通，但這是一件特別的紀念品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080268,
					"content": "「咚咚小圓帽」曾在水天叢林南部救下一位迷路商人的孩子，商人送了「咚咚小圓帽」許多謝禮，其中一件就是這臺留影機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080269,
					"content": "「咚咚小圓帽」很喜歡這個留影機拍攝的畫片，這次去玩時，也可以用它來留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080270,
					"content": "我找了器材專家伊蓮小姐來密封留影機的外殼，讓它能在「咚咚小圓帽」喜歡的潮濕環境…甚至是水下工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080271,
					"content": "也就是說，這個留影機也是「咚咚小圓帽」的榮譽象徵之一了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080272,
					"content": "咚咚小圓帽，棒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737080275,
					"content": "#至於留影的問題，放心放心，我和{NICKNAME}也是專家！裝置的外觀不要緊，拍得好就可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}，我們準備準備，然後就出發吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080277,
					"content": "除了行李，還有蕈獸夥伴們特別的食物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080278,
					"content": "沒錯，這一點派蒙也記得很清楚——請攜帶足夠的「妙妙瓊脂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080279,
					"content": "最新改良版的版本有著更美味的口感，還很好保存，無論在多炎熱的環境下都不用擔心變質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080280,
					"content": "小心，不要一次給夥伴們吃太多哦，暴飲暴食是不好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080281,
					"content": "嘿嘿，都記住啦——瓊脂要收進小背包…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080282,
					"content": "就等我們開開心心帶著遊玩的紀念品回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080273,
					"content": "幹得漂亮，小圓帽！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "我會選出好玩又好看的地方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "我也想帶蕈獸夥伴去玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "感覺略過了很多吃苦的部分…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "以後可以常常見面啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "親切的氣氛讓我放鬆下來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "雖然不太記得了，但你們好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "真的是海妮耶和「咚咚小圓帽」！我們好久之前在「月蓮盃馴獸師大賽」認識的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080210,
					"content": "印象中之後我們還在奧摩斯港附近，還有楓丹廷見過面！不知不覺，已經過去這麼久的時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "咚咚小圓帽"
				}
			]
		},
