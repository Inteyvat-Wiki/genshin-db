			"dialogs": [
				{
					"id": 737080301,
					"content": "呼啊…總算到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080302,
					"content": "雖然路途非常遙遠，但我覺得「懸木人」這邊超有特色的彩石頂，對蕈獸夥伴們來說絕對無比新奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080303,
					"content": "我這裡有幾張風景畫，可以讓蕈獸夥伴們對比圖畫和眼前的景象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080304,
					"content": "如果夥伴們仔細觀察，把兩者對起來後，慢慢注意到不起眼的細節，對這裡有興趣…就代表這裡適合我們深度遊玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080305,
					"content": "♪♫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737080306,
					"content": "♫…♩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "歡騰之火"
				},
				{
					"id": 737080307,
					"content": "還有這種辦法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "嘿嘿，我閒下來沒事的時候，也會翻看導覽圖冊，觀察一些遊覽勝地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080310,
					"content": "這可是好嚮導的必修課！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080311,
					"content": "好啦，讓蕈獸夥伴也試試看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080308,
					"content": "派蒙很懂嘛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
