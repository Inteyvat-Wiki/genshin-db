			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#謝謝{F#妳}{M#你}，旅行者，呼…剛才嚇死我了，盜寶團真是越來越猖狂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060302,
					"content": "妳是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "我叫索拉雅，是一名遊學者，正在這裡做研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060304,
					"content": "幾天前，我循著線索找到了一處遺蹟，在裡面找到了一枚記載著魔神戰爭時期歷史的玉盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060305,
					"content": "但是我取出玉盤之後，剛剛走出遺蹟，就被盜寶團襲擊了，我跑了一段，還是被他們追上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060306,
					"content": "#要是沒有你們，我和玉盤可能都會有危險，再次感謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060307,
					"content": "妳也是學者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "…也？還有學者在這裡研究嗎，那這位的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060309,
					"content": "寶兒…等一下，在剛才襲擊我的盜寶團裡，我聽見有人說「怎麼能讓寶兒獨吞寶物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060310,
					"content": "#居然有這麼巧的事情…抱歉，能詳細和我說說{F#妳}{M#你}遇見的那個「寶兒」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060311,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "#…那位「寶兒」給{F#妳}{M#你}指定的地點，恰好都是我選定過的。這樣的「巧合」，實在是太巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060313,
					"content": "如果她真是盜寶團的成員，那麼按照我的推測，也許我早就被盜寶團跟蹤了，他們想跟著我…「撿現成的」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060314,
					"content": "那個「寶兒」想要獨吞財物，於是自己一個人搶先行事，但憑她一個人，實在是搜索不了這麼大的範圍，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060315,
					"content": "#看來…{F#妳}{M#你}也許被利用了呢，旅行者。恐怕這次的位置，也是她早就瞄好的，只不過她的同夥和我，都比{F#妳}{M#你}早來了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060316,
					"content": "不用緊張，這些暫時只是猜測，但是「寶兒」這個名字…聽著就十分可疑，像是個假名，或者代號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060317,
					"content": "#旅行者，{F#妳}{M#你}能幫我敷衍一下她嗎？無論怎樣，也不能把這枚玉盤交給可疑的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060318,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "#謝謝{F#妳}{M#你}，不過{F#妳}{M#你}這麼空手回去，她說不定會起疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060321,
					"content": "#這樣，我這裡有一個不那麼貴重的小玩意，{F#妳}{M#你}帶回去給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060322,
					"content": "雖然只是蠅頭小利，但也足夠拖延一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060325,
					"content": "#好了，{F#妳}{M#你}快點回去吧，雖然{F#妳}{M#你}剛才把她的同夥打跑了，但是她既然一個人單獨行動，那她的同夥肯定也沒法把{F#妳}{M#你}的事馬上告訴她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060326,
					"content": "#對了，如果下次她再支使{F#妳}{M#你}去找什麼，而且{F#妳}{M#你}真有發現的話，可以帶來給我。我平常會待在望舒客棧裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060327,
					"content": "呼，雖然我能做的事也很有限…但是能保護一件文物是一件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060319,
					"content": "空手回去會讓她懷疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "#嗯…有道理，那這樣，我這裡有一個不那麼貴重的小玩意，{F#妳}{M#你}帶回去給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060324,
					"content": "雖然只是蠅頭小利，但也足夠拖延一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "索拉雅"
				}
			]
		},
