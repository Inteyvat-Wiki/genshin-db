			"dialogs": [
				{
					"id": 220060101,
					"content": "到底在哪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060102,
					"content": "妳又丟了什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "這次沒有「丟」，是剛開始找啦！但是——無論如何都找不到啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060104,
					"content": "到底在哪裡，好不容易鎖定了位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060105,
					"content": "#{F#妳}{M#你}也來和我一起找找吧，這種貴重的文物，絕不能流落在外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060106,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "#那{F#妳}{M#你}去那邊，我繼續搜索這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060109,
					"content": "一定要把它找出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060107,
					"content": "這次又是什麼文物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "是一件…一件…呃，年代很久遠！可以追溯到…一千，啊不，魔神戰爭時期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220060111,
					"content": "#總之，是件很貴重的文物，絕不能讓它流落在外！{F#妳}{M#你}也幫我找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				}
			]
		},
