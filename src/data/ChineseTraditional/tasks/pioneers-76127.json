			"dialogs": [
				{
					"id": 761270201,
					"content": "#嗚嗚嗚，{NICKNAME}！我就知道{F#妳}{M#你}一定會沒事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270202,
					"content": "派蒙還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270203
					]
				},
				{
					"id": 761270203,
					"content": "#剛才很不好，我從逃生艙裡出來一看，{F#妳}{M#你}們都不見了，差點嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270204,
					"content": "#不過現在找到了{F#妳}{M#你}，一下就好多了，嘿嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270205,
					"content": "#快讓我看看，{F#妳}{M#你}有沒有哪裡受傷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270206,
					"content": "放心，我也沒事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270207
					]
				},
				{
					"id": 761270207,
					"content": "這樣我就不擔心了，沒想到飛船居然出了問題…不對，其實這種事早就該想到的…",
					"roleType": "TALK_ROLE_NPC",
