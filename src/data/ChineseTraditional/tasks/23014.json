				"points": []
			},
			"dialogs": [
				{
					"id": 230140301,
					"content": "非常感謝您，旅行者，這些徽印就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140302,
					"content": "我得先去把齒輪重製…呃，不對，也許先要研究一下軸承問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140303,
					"content": "這是您的報酬，旅行者，請您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140304,
					"content": "就現在的情況來看，我們大概真的要長期合作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140305,
					"content": "唉，加爾恰先生的帳目，梳理起來可真是難啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
