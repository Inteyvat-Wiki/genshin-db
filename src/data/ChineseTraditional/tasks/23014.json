			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "我們必須得想點辦法賺錢了，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145002,
					"content": "我聽說須彌城裡有一個劇院，裡面不少劇團需要做一些計算工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145003,
					"content": "而且那些劇團演出成員…您懂得，他們賺得很多，卻不知道如何管理自己的帳目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145004,
					"content": "這就是我們的機會，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145005,
					"content": "你在算帳和做生意這兩個方面的天賦真讓人震驚，親愛的路通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145006,
					"content": "再讓我想想，再讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		},
		{
