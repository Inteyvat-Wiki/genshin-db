			"trigger": {
				"objectNames": [
					"路通",
					"加爾恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "先生，這次我真的誠心建議，我們還是選擇想辦法付錢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140102,
					"content": "那群賣貨的簡直是在搶劫！為什麼幾個徽印要賣那麼貴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140103,
					"content": "也許是因為他們發現，您看見那些徽印的時候兩眼都在放光吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140104,
					"content": "你要那些徽印做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "旅行者！您每次都來得這麼及時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140106,
					"content": "上次多虧了您幫忙，我基本上已經製造出一種能用的潤滑劑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140107,
					"content": "但我馬上又遇到了一個問題，在我重製某些零件的時候，我發現…如果用太過堅硬的材料製造它們，反而容易將其它組件碰傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140108,
					"content": "而且，那些太過堅硬的零件只要稍微受到衝擊，就會出現不同程度的壞裂情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140109,
					"content": "所以，我就開始尋找某種既有一定的硬度，又有著一定柔性的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140110,
					"content": "在我不懈的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140111,
					"content": "…和對阿漢格爾先生的持續騷擾後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140112,
					"content": "我覺得盜寶團所攜帶的那種…徽記，也許就用到了某些我所要找的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140113,
					"content": "但是…那些商人簡直和盜寶團一樣在搶劫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140114,
					"content": "又到了我出馬的時候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "我簡直想把您的名字刻在「推數機」的主軸承裡了！太謝謝您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230140115,
					"content": "我去幫你找找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
