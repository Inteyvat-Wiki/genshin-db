				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "唔…路通，你得扶著我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145502,
					"content": "先生，您還是回去再睡一會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145503,
					"content": "旅行者，您來得正好！請過來一下吧，我想請您幫一個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145504,
					"content": "他這是怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "簡單來說…加爾恰先生喝了太多咖啡，睡覺的時間又太少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145506,
					"content": "不過值得慶幸的是，先生至少只是喝咖啡，沒有喝酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145507,
					"content": "路通，呃…我、我們得再找幾枚那種徽印才可以…就是盜寶團帶著那種…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145508,
					"content": "#旅行者！{F#妳}{M#你}怎麼在這裡，抱歉，我剛才沒有注意到{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145509,
					"content": "#{F#妳}{M#你}願意幫我去拿點那種徽印來嗎？只要幾枚就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145510,
					"content": "你就回去休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "沒關係、沒關係，我很好，思維很清晰…就是手有點不聽使喚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145514,
					"content": "總之，就請您拿幾枚徽印來吧，我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145515,
					"content": "拿來之後直接…直接給我就行，我要仔細看看，這次一定要把那根軸承做好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230145512,
					"content": "喝咖啡能喝成這樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "這倒是不能怪罪咖啡，只能怪罪不想睡覺的加爾恰先生自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
