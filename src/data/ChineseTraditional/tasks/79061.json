							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>裡面的世界</color>也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "嗯，這裡畢竟是埃斯諾爾的家，他一定也很喜歡這裡，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610303,
					"content": "這裡有許多熟悉的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "對！我就是會擔心失去這些，總是為這些事煩憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610307,
					"content": "這一切都很好，好得不得了…我不願這些東西改變，也不願自己改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610308,
					"content": "但是…遠遊會讓一切都變得不一樣，對嗎？羅澤爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610309,
					"content": "會的，一定會。我不願騙你，也無意讓你難過，親愛的埃斯諾爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610310,
					"content": "好的…好的。我明白你的心，你一定也明白我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610311,
					"content": "我要好好想想你的邀請，稍後再做決定…至少現在，我們只應該一起平靜地喝點茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610312,
					"content": "好吧…我會陪著你的，埃斯諾爾。離下次起航日還很遠，我可以和你一起慢慢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610304,
					"content": "有很多漂亮的花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "和好吃的蛋糕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "羅澤爾，或許…我可以和你同行，但是…我不知道該如何準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610402,
					"content": "這很簡單。準備好你的果醬、麵包和好奇心，穿上舒適的衣服，帶著一些備用衣物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610403,
					"content": "最後，再做好心理準備——因為你很可能會在半路不得不丟掉那之中的一些東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610404,
					"content": "哦，聽起來真複雜，而且我不想丟掉，那些是我的東西，很寶貴，我愛它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610405,
					"content": "在那些東西離開你之後，你還會遇見新的、寶貴的東西的，親愛的埃斯諾爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610406,
					"content": "相信我，這會是一趟有趣的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅澤爾"
				}
			]
		},
		{
			"id": 7906105,
