			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "抱歉，羅澤爾。我…還是不能和你同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610502,
					"content": "我待在這裡就足夠了。這樣的話，當你遠遊回來時至少會有人迎接你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610503,
					"content": "但是…埃斯諾爾，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610504,
					"content": "我不夠聰明，也不夠勇敢，羅澤爾。但我想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610505,
					"content": "風穿過樹叢，河流經湖泊，周而復始，在最後總是會回到起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610506,
					"content": "或許，在經歷那麼多改變後，最終的願望還是…變回最初的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610508,
					"content": "我會在家裡等你的，好朋友，一如既往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃斯諾爾"
				}
			]
		},
