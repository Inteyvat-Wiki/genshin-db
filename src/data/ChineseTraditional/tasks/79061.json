				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "羅澤爾，無論你說多少遍，我都不會和你去遠遊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610102,
					"content": "我是你的朋友，這永遠不變，我不討厭你，但…但我不喜歡遠遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610103,
					"content": "埃斯諾爾，這一切沒有你想像的那麼可怕，只是一場旅行，僅此而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610104,
					"content": "外面的世界有許多村裡沒有的花、沒見過的人——甚至連雲的形狀都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610105,
					"content": "我不是從外面帶了花種來給你嗎？我保證，你絕對從未見過這種形狀和顏色的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610106,
					"content": "現在還只是種子，我要把它種下去，等開花了才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610107,
					"content": "如果你願意和我去遠遊，那我們也許可以直接找到這種花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610108,
					"content": "羅澤爾…抱歉，我不想遠遊，也不想變得和那些冒險客一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610109,
					"content": "他們總是擔心地毯的價值，不在意漂亮的帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610110,
					"content": "這是遠遊帶給你們的改變，我害怕這種改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610111,
					"content": "這是事實，但你注意到他們手提箱裡的地圖、植物樣本，還有寫得滿滿滿的遊記了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610112,
					"content": "我們就像一陣風穿過不同的樹叢，一條河流經另一片湖泊…結識了新鮮事，但也不再是從前的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610113,
					"content": "這是遠遊帶給我們的改變，我也會害怕…但我同時也很感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610114,
					"content": "就像一片兩面都塗著鮮奶油的麵包，無論你再怎麼小心拿，總會有一面的鮮奶油被弄得一團糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610115,
					"content": "那我就把鮮奶油分開塗，這樣我甚至還可以塗不同口味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610116,
					"content": "這個主意不錯，聽起來一定吃得飽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "是您啊，您總算來了。羅澤爾一直在告訴我外面的世界很美好，邀請我去遠遊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610119,
					"content": "您對外面的世界有瞭解嗎？那邊…真的和羅澤爾說的一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610117,
					"content": "這想法滿好，鮮奶油不會弄到手上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
