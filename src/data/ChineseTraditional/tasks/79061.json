			"dialogs": [
				{
					"id": 790610601,
					"content": "「這封信給我的鄰居、我的朋友——燈塔和小花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "字跡歪歪扭扭的信"
				},
				{
					"id": 790610602,
					"content": "「我即將和羅澤爾外出遠遊，您儘管用我的鞦韆、桌子和凳子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "字跡歪歪扭扭的信"
				},
				{
					"id": 790610603,
					"content": "「祝您愉快。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "字跡歪歪扭扭的信"
				},
				{
					"id": 790610604,
					"content": "「您的鄰居，埃斯諾爾。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "字跡歪歪扭扭的信"
