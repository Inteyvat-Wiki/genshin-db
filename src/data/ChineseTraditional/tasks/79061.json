				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "是的。<color=#FFCC33FF>外面的世界</color>有許多新鮮事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "對啊，外面有好多好吃、好玩的，還會遇見好多有趣的事、認識很多厲害的人，像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610203,
					"content": "有專注在事物美好本質的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "真的？唉呀，我還以為外面世界的只有「價值」，大家都是那種想戴帽子卻又不敢的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610207,
					"content": "這個…呃…那個…就、就像是蛋糕上面撒的巧克力，每一顆都是不同的味道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610208,
					"content": "要是每顆巧克力豆都是同樣的味道，那蛋糕吃起來不就很普通了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610209,
					"content": "派蒙，很會說嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "都聽了這麼久，多少也會一點了嘛，嘿嘿，是不是還滿有道理的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790610212,
					"content": "這樣嗎？我…我還要再想想…也許，小小地去遠遊一下，也不錯…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "埃斯諾爾"
				},
				{
					"id": 790610213,
					"content": "不用著急，埃斯諾爾，離下次起航日還很遠，我可以和你一起慢慢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅澤爾"
				},
				{
					"id": 790610210,
					"content": "派蒙已經完全融入這裡了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "永不褪色的燦爛理想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "和為了夢想努力的人們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
			"completionStepIds": [
				7906101
