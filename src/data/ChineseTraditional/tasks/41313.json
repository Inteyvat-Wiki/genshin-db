					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "還有何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130802,
					"content": "想請你一起去海燈節。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "#…我不喜歡人來人往的地方，{F#妳}{M#你}自己去遊玩就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130804,
					"content": "不用你去璃月港。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "…什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130806,
					"content": "我把海燈節搬過來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "「搬過來」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130808,
					"content": "哎呀，就是在客棧下面擺了好多好吃的，好多霄燈，周圍也沒有多少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130809,
					"content": "還準備了「杏仁豆腐」和「烤吃虎魚」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "我們快點下去吧，不然菜都要涼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
