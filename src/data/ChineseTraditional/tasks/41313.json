			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "#怎麼樣，我們給{F#妳}{M#你}搬過來的海燈節看上去是不是很好吃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130902,
					"content": "這就是你們搬來的海燈節？人類的行為，非要如此怪異嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130903,
					"content": "你們做這些事，意義何在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130904,
					"content": "為了讓你參加一次海燈節。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "…是這樣嗎？人的心思真是難以揣測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130907,
					"content": "你們別光顧著說話了，快點吃東西吧，不然菜都要涼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130908,
					"content": "嘿嘿，我先開始吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130909,
					"content": "好啦，東西也吃好了，應該是去看「明霄燈」的時候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130910,
					"content": "魈也一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "你們去吧，我對那些東西不感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130912,
					"content": "不然，你送送我們也行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "對啊，就算你不想去看「明霄燈」，那…那你送我們過去總可以吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130915,
					"content": "從這裡去璃月港很遠喔，野外也很危險的…對吧，很危險的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130916,
					"content": "不用送我們進城啦，只…需要送到城外就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130917,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130918,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130919,
					"content": "那好，我送你們到<color=#00E1FFFF>城外</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130920,
					"content": "沒問題！我們這就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130913,
					"content": "拜託了，護法夜叉大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "海燈節是所有人的節日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
