			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "如何，事情了結了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130202,
					"content": "已經了結了，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "如此就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130204,
					"content": "真的不去看明霄燈嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "不去。我說過了，不喜歡人來人往之處，尤其是每年的這幾天裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130206,
					"content": "今年的明霄燈是「移霄導天真君」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "對，是一隻看起來很神氣很神氣的鹿哦，我們一起去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130208,
					"content": "「移霄導天真君」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130209,
					"content": "但終究只是座霄燈罷了，人造的死物，無趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130210,
					"content": "你們自己去城裡，看個熱鬧就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "看來，你們又和魈一起辦了件大事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413130302,
					"content": "動靜可不小啊，我們在這裡都聽說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130303,
					"content": "不過，眼看著今年的海燈節又要結束了，他還是沒去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413130304,
					"content": "唉…這麼多年了，我就沒見過那位去過海燈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130305,
					"content": "#要我說，{F#妳}{M#你}就是讓我把海燈節給搬過來，都比請那位去海燈節要容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130306,
					"content": "把海燈節給…搬過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130307,
					"content": "好主意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "對啊！既然魈不去海燈節，那我們就把海燈節搬過來給他好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130309,
					"content": "嗯？這玩笑話…如何當真？要怎麼「搬過來」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130310,
					"content": "在逛海燈節的時候，我們學了怎麼編「霄燈」，還找到了一個賣特色小吃的攤子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130311,
					"content": "很多好吃的，漂亮的霄燈，還有…嗯…過往的英雄，和他以前的好朋友們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130312,
					"content": "這不就是海燈節的全部嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130313,
					"content": "這麼說倒也沒錯，可是要在哪裡佈置才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413130314,
					"content": "要這麼說的話，那我尋思著，地方得寬敞點，還得搭個攤子才行，嗯…<color=#00E1FFFF>客棧底下</color>也許還有點空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130315,
					"content": "我們一起去下面選個地方吧。我大概知道你們想要個什麼樣的攤子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130316,
					"content": "唔…應該有些樣式可以參考，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "這裡還不錯，嗯…也很僻靜，很合適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130702,
					"content": "那就這裡了，我剛才思考了一下，也想好怎麼建你們要的那種攤子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130703,
					"content": "你們稍等啊，我看看，該從哪先開始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130704,
					"content": "完成了，差不多就是這樣，你們看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130705,
					"content": "掌櫃，你這木工…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "哎呀，一點點小手藝，不值一提，很多年前學的，我都忘得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130707,
					"content": "這下子攤子有了，我還順便在上面擺了點「霄燈」，看起來還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130708,
					"content": "編霄燈你也會？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "哎呀，我這個年紀的璃月人，基本上都會編霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130710,
					"content": "對了，大過節的…請客總得吃點好的吧，你們想好請那位吃什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130711,
					"content": "吃…「杏仁豆腐」！我們之前請魈吃過的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413130712,
					"content": "還有「烤吃虎魚」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "「杏仁豆腐」和「烤吃虎魚」是吧…行，沒問題，我這就叫言笑去準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130714,
					"content": "正好客棧裡備著材料，這麼幾道小菜，他應該很快就能做完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130715,
					"content": "那你們先上去請那位下來吧，你們下來的時候，菜應該就已經做好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
