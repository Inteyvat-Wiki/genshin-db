			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "（一塊小石碑，其上刻文如下…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640202,
					"content": "…「層岩巨淵一戰，我四肢皆瘓，只得口述，託人記錄並鐫刻於此。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640203,
					"content": "…「鏖戰之中，雖討得一命，每念及殉難同袍，便夙夜難眠。何況留此殘軀，真恨不能隨諸位同去。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640204,
					"content": "…「自絕無果，帝君得聞，痛加斥詈，如是幡然醒悟。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640205,
					"content": "…「可嘆帝君仁慈，賜還千岩軍兜鍪甲胄，私念無能報效，留之亦為蒙塵，如是放置於此，待有緣人相取。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "石碑"
				},
				{
					"id": 710640206,
					"content": "…「諸位，此生已無機會，便來世再做同袍，屆時再共飲一杯盟誓之酒，共抵璃月之敵寇。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石碑"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿望"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "#沒想到真的讓{F#妳}{M#你}給找到了…這就是「千岩軍的寶藏」嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640302,
					"content": "#雖然不知道裡面有什麼，不過…那份寶藏能夠被{F#妳}{M#你}找到，當年留下那份寶藏的千岩軍恐怕也很欣慰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640303,
					"content": "離那場災厄已經五百年了，一想到五百年前，這裡是水深火熱的戰場，而無數先烈在此犧牲，就讓人不禁疑問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640304,
					"content": "在那個年代，隨岩王爺征戰的無數凡民，他們中的某一位，也會認為自己在參與一項被後人銘記千百年的事業嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640305,
					"content": "他們不會對自己的職責產生片刻的懷疑嗎…？那些沒能獲得「神之眼」的凡人，如何忠誠於一個未曾注視他們的神，至死方休呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640306,
					"content": "因為神從未遠離他們身邊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640309,
					"content": "#嗯，{F#妳}{M#你}說的沒錯。有「神之眼」也好，沒有也好…人總還是要為了無窮可能的未來而努力的。這就是動力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640310,
					"content": "我們也是一樣，不是為了過去的好日子，也不是為了當今的自我實現…而是為了彼此扶持，一同在時代中留下自己的痕跡與聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640311,
					"content": "或許很久以後，層岩巨淵也會成為我們的紀念碑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640314,
					"content": "這滿坑滿谷刀削斧鑿的痕跡，一代代礦工揮灑的汗水…同樣見證著我們選擇的艱辛之路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640312,
					"content": "就像這塊紀念石一樣，將來百年，不，將來千年都會豎立在此，證明將士們的犧牲沒有被記憶辜負。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640313,
					"content": "嘿嘿，雖然我肯定看不到了…但到那時候，希望也會有人來此為我們這些窮礦工酌上苦酒一杯，我也就心滿意足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿望"
				},
				{
					"id": 710640307,
					"content": "他們也是忠於自己的選擇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
