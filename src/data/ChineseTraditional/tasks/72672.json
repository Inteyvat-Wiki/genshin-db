			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "#{F#妳}{M#你}去找過若紫了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720502,
					"content": "關於「四方八方之網」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "「四方八方之網」…這名字倒是不錯，不過那個術式嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720504,
					"content": "那個術式真能拘出人的神形嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "嗯…不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720506,
					"content": "那種陰陽術只有記載，具體的施術方式早就失傳不知道多久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720507,
					"content": "我給若紫的那道術式，只能拘出小動物的神形而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720508,
					"content": "那妳為什麼還告訴若紫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "這個啊。我只是想讓若紫幫我散出一個消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720510,
					"content": "「萬端珊瑚偵探社的社長，正在拜託人以惟神陰陽術為核心，研製一種能讓人說真話的網。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720511,
					"content": "失傳已久的惟神陰陽術，萬端珊瑚偵探社，還有確實能拘出小動物神形的網子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720512,
					"content": "這些要素綜合在一起，足以形成一個聽上去很厲害，感覺上也很真實的「街頭傳說」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720513,
					"content": "雖然這個「街頭傳說」對於常人來說只是一個小故事…但對於那些心裡有鬼的犯人來說，可就不僅僅是故事那麼簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720514,
					"content": "原來是這樣嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "另外一方面的原因是…誰叫若紫一個勁地纏著我，要我給她一個「最厲害的陰陽術式」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720516,
					"content": "我都說了沒有了，但那傢伙根本就聽不進去。我實在沒辦法了，只能用這道陰陽術式來哄走她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720517,
					"content": "如果若紫不告訴別人這件事呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "不會的，那傢伙從來都沒法保守住秘密。我可太瞭解她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720519,
					"content": "#辛苦{F#妳}{M#你}幫我跑這一趟了，這些東西給{F#妳}{M#你}，就當做是報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720520,
					"content": "希望若紫不要再來找我要新的陰陽術式了，我是個偵探，又不是陰陽師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
