				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "若紫這傢伙…真不該讓她知道影郎丸的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "#旅行者，是{F#妳}{M#你}啊。你還記得那張「四方之網」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720104,
					"content": "#在我們解決了上次的事件之後，我把{F#妳}{M#你}的事蹟也講給我那位朋友聽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720105,
					"content": "她叫若紫，是個…嗯…她說自己是個「設計師」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720106,
					"content": "若紫那傢伙聽說了你操作這張網的方式之後，似乎很受啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720107,
					"content": "她一個勁地纏著我，想要讓我幫她去找幾個新術式，方便她繼續改造那張「四方之網」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720108,
					"content": "我實在沒辦法，就去那本古籍裡給她找了一道新術式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720109,
					"content": "#旅行者，如果{F#妳}{M#你}有興趣的話，就去若紫那邊看看吧，也許她現在已經把那張網給改造好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
