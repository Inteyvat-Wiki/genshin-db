				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "怎麼樣，這張網用得還順手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720402,
					"content": "用了一次就壞掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "嗯…這也是沒辦法的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720404,
					"content": "我之前說了，那道術式可以拘出小動物的神形，但如果想要保存神形，或者再次化出小動物的形體，還需要另外的媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720405,
					"content": "我把那道術式融進了「四方八方之網」裡，保存神形和化出形體的媒介，就是這張網本身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720406,
					"content": "好複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "簡單來說，就是一張網只能用一次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720408,
					"content": "這也是我到現在都沒解決的難題，媒介不能復用的話，那成本也太高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720409,
					"content": "我會繼續研究這張網，爭取盡快解決這個問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720410,
					"content": "#如果{F#妳}{M#你}還需要「四方八方之網」的話，就過來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720411,
					"content": "還有，那個…雖然這種網目前只能捕捉一下小動物，但製作起來其實也挺麻煩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720412,
					"content": "#所以嘛…嘿嘿，下次{F#妳}{M#你}想要這種網的話，就要付給我一點「成本費」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720413,
					"content": "#放心！{F#妳}{M#你}是珊瑚的朋友，我不會收{F#妳}{M#你}很多錢的，一定給{F#妳}{M#你}一個公道的價格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				}
			]
		},
