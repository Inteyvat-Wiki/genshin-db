			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "這樣就差不多完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720202,
					"content": "請問妳是若紫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "#我是，{F#妳}{M#你}找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720204,
					"content": "關於「四方之網」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "#欸？我記起來了，{F#妳}{M#你}應該是那位旅行者吧？珊瑚和我提起過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720206,
					"content": "#{F#妳}{M#你}操作「四方之網」的方式可真是巧妙啊，給我很多啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720207,
					"content": "聽說妳正在改造它？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "沒錯。嘿嘿…珊瑚給了我一道全新的陰陽術式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720209,
					"content": "我用那道術式再次改造了一下這張網，現在這張網的名字是「四方八方之網」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720210,
					"content": "據珊瑚說，這道術式可以拘出生物的神形，再以某個物體為媒介，再次化出那個生物的形體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720211,
					"content": "她還說，如果把這道陰陽術式演化到極致，甚至可以拘出人類的神形來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720212,
					"content": "被拘出來的人類神形可以回答問題，而且絕不會說謊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720213,
					"content": "這種術式對於珊瑚這樣的偵探來說，可以算是最強的工具了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720214,
					"content": "我想，她也是因為這個原因，才願意把那道術式給我，讓我來改造這張網的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720215,
					"content": "#啊！{F#妳}{M#你}可別到處說啊！因為{F#妳}{M#你}是珊瑚的朋友，我才會把這些事告訴{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720216,
					"content": "這、這麼強嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "呃…暫時還沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720219,
					"content": "無論我用什麼方式改造，這張網目前都只能拘出小動物的神形，對人類一點用都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720220,
					"content": "#旅行者，{F#妳}{M#你}也來試用一下這張網吧，說不定…{F#妳}{M#你}操作這張網的方式，會再次給我一些啟發呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720221,
					"content": "#喏，這張網給{F#妳}{M#你}，現在這張網的名字是「四方八方之網」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720222,
					"content": "#{F#妳}{M#你}快去用這張網抓些小動物試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720217,
					"content": "已經改造成功了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
