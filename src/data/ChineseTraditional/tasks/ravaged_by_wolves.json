			"trigger": {
				"objectNames": [
					"神奇的霍普金斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "#{F#妳}{M#你}們調查找到什麼結果了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530602,
					"content": "嗚啊，你站起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530603,
					"content": "我緩過來了。甚至可以說，我從地獄裡爬回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530604,
					"content": "所以騎士團調查有結果了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530605,
					"content": "從殘留的毛髮裡能看出來狼群生活在奔狼領。除此以外都不太明朗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530606,
					"content": "#不過請{F#妳}{M#你}們放心，我馬上就去奔狼領把事件調查清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530607,
					"content": "騎士團絕對不會放任這麼危險的事情繼續發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530608,
					"content": "好吧。補救得晚了點，好過完全不作為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530609,
					"content": "哇，這個人好沒禮貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530610,
					"content": "我們現在就要去做該做的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530611,
					"content": "喂，不要做蠢事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530612,
					"content": "笑話，我們和騎士團不一樣。這仇必須算清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530613,
					"content": "我們走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4530614,
					"content": "真是淒慘啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530615,
					"content": "你在說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530616,
					"content": "說他們的未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530617,
					"content": "我同意你的意見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "年輕人容易火氣大。勞煩各位再照顧一下吧，別讓他們做蠢事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 4530619,
					"content": "放心吧，這是我們職責所在——雖然這傢伙真的很讓人不爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530620,
					"content": "請交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4530621,
					"content": "那我們趕快去奔狼領吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
