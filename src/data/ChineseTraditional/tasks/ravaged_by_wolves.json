			"dialogs": [
				{
					"id": 4530701,
					"content": "這個爪印——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530702,
					"content": "透過爪印，可以推斷出來狼的數量和大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530703,
					"content": "數量不止兩條，大小的話，這一匹大概有——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530704,
					"content": "大概有？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "…嗯，呃，大概有兩公尺高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4530706,
					"content": "…派蒙，妳，見過狼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "狼很神秘的，平常哪有機會看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
