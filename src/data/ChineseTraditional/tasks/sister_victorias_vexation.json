			"dialogs": [
				{
					"id": 190010101,
					"content": "芭芭拉小姐…不會出了什麼事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010102,
					"content": "芭芭拉怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "芭芭拉小姐說自己要外出採藥，但是到現在還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010104,
					"content": "難道要向西風騎士團報告嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010105,
					"content": "我去找芭芭拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "#{F#妳}{M#你}？哦…{F#妳}{M#你}這位「榮譽騎士」確實很合適…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010107,
					"content": "這樣的話，倒也免了向騎士團報告後的一堆麻煩事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010108,
					"content": "#那就拜託{F#妳}{M#你}了，芭芭拉小姐在離開之前說，她準備去奔狼領附近採藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190010109,
					"content": "#{F#妳}{M#你}可以去那邊找找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "維多利亞"
				}
			]
		},
