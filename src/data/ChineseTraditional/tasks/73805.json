			"dialogs": [
				{
					"id": 738050101,
					"content": "#旅行者，稍等一下，這裡有一封信給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "瑪亞姆"
				},
				{
					"id": 738050102,
					"content": "給我的信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "#是那個叫「旭東」的璃月人留給{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "瑪亞姆"
				},
				{
					"id": 738050104,
					"content": "他在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "那我可就不知道了。前段時間，他匆匆忙忙地過來，交給我這封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "瑪亞姆"
				},
				{
					"id": 738050107,
					"content": "#說什麼…請務必轉交給{F#妳}{M#你}，還給了我一筆錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "瑪亞姆"
				},
				{
					"id": 738050108,
					"content": "旭東…匆匆忙忙的？有什麼事會讓他這麼著急呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050109,
					"content": "難道…是那個壞蛋又搗亂了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050110,
					"content": "還是先看看信吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "好吧…那我們就先讀讀這封信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738050111,
					"content": "也許他會在信裡說明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "他為什麼要留信給我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				}
			]
		}
