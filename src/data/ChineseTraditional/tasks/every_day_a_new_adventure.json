					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "嘿嘿，那我們就不客氣地收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310302,
					"content": "儘管收下，這是冒險家協會表示感謝的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310303,
					"content": "因為每天協會都會收到很多委託，如果不是各位冒險家鼎力相助，是肯定沒辦法完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310304,
					"content": "#當{F#妳}{M#你}每天完成足夠數量的委託，就可以到我這裡領取一份額外的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310305,
					"content": "「冒險之證」裡會記錄今天已經完成過的數量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310306,
					"content": "一定記得要當天過來領取禮物，因為數量有限，錯過了是沒辦法補發的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310307,
					"content": "明白了，謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "#不用客氣，是應該謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310312,
					"content": "#對了，如果{F#妳}{M#你}幫助{F#妳}{M#你}的冒險夥伴完成委託，同樣會計算在領取禮物的數量之內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310313,
					"content": "#也請多多與{F#妳}{M#你}的夥伴相互合作吧！向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310309,
					"content": "一天只有一份嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "現在的話是這樣的…很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310311,
					"content": "不過也請放心，關於冒險家們的報酬，我們一直都在向總部爭取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
