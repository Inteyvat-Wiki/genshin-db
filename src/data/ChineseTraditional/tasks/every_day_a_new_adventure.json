			"dialogs": [
				{
					"id": 200310201,
					"content": "#完成得很好，{NICKNAME}，作為第一次來說相當出色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310202,
					"content": "#委託人都請我幫忙感謝{F#妳}{M#你}呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310203,
					"content": "那麼現在該我履行之前的約定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
