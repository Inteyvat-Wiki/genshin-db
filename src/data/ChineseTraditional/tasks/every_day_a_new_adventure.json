			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "我們又見面了，冒險家新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310102,
					"content": "怎麼樣，最近的冒險還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310103,
					"content": "很順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "很不錯的氣勢，記得一直保持下去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310107,
					"content": "#看起來{F#妳}{M#你}已經積累了很多的閱歷，是時候介紹給{F#妳}{M#你}冒險家協會的重要工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310108,
					"content": "冒險家協會每天都會收到來自各處的<color=#00E1FFFF>委託</color>，並負責整理發放給各位冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310109,
					"content": "這也是冒險家們最主要的報酬來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310110,
					"content": "都是什麼樣的委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310111,
					"content": "什麼類型都可能有，從幫助居民到清理怪物，有瑣碎的也有很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310112,
					"content": "俗話說百聞不如一見，還是親自上手做一做更容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310113,
					"content": "這裡就是今天的委託內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310114,
					"content": "麻煩完成之後來向我報告一下，我會提供一份豐厚的獎勵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#不愧是{NICKNAME}，很可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310119,
					"content": "#那我就在這裡等{F#妳}{M#你}的好消息，{NICKNAME}，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310117,
					"content": "有多豐厚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "#別那麼心急，保留一下期待吧，不會讓{F#妳}{M#你}失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310105,
					"content": "有點吃力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "#剛開始是會這樣的，在冒險前做好準備會讓{F#妳}{M#你}輕鬆不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
