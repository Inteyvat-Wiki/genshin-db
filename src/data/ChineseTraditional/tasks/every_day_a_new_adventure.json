					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#我聽說了哦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310402,
					"content": "#{F#妳}{M#你}已經完成了冒險家協會承接的<color=#00E1FFFF>委託</color>，委託人都請我向{F#妳}{M#你}道謝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310403,
					"content": "委託？沒什麼印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310404,
					"content": "#就是{F#妳}{M#你}在路上遇到的需要{F#妳}{M#你}幫忙的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310405,
					"content": "他們其實都是在協會發佈了委託的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310408,
					"content": "#總之，還是和{F#妳}{M#你}簡單介紹一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310409,
					"content": "冒險家協會每天都會收到來自各處的委託，並負責整理發放給各位冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310410,
					"content": "這也是冒險家們最主要的報酬來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310411,
					"content": "#說到報酬，就不得不提到協會為{F#妳}{M#你}準備的一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310406,
					"content": "路上正好看到就幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310407,
					"content": "不愧是我們的冒險者新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 2003105,
			"completionStepIds": [
				2003106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003106",
							"2"
						],
						"stepId": 2003106,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_DAILY_TASK_REWARD_CAN_GET",
						"rawParams": [
							"1"
						]
					},
					{
						"type": "QUEST_COND_DAILY_TASK_REWARD_RECEIVED",
						"rawParams": [
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "嘿嘿，那我們就不客氣地收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310502,
					"content": "儘管收下，這是冒險家協會表示感謝的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310503,
					"content": "因為每天協會都會收到很多委託，如果不是各位冒險家鼎力相助，是肯定沒辦法完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310504,
					"content": "#當{F#妳}{M#你}每天完成足夠數量的委託，就可以到我這裡領取一份額外的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310505,
					"content": "「冒險之證」裡會記錄今天已經完成過的數量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310506,
					"content": "一定記得要當天過來領取禮物，因為數量有限，錯過了是沒辦法補發的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310507,
					"content": "明白了，謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "#不用客氣，是應該謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310512,
					"content": "#對了，如果{F#妳}{M#你}幫助{F#妳}{M#你}的冒險夥伴完成委託，同樣會計算在領取禮物的數量之內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310513,
					"content": "#也請多多與{F#妳}{M#你}的夥伴相互合作吧！向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310509,
					"content": "一天只有一份嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "現在的話是這樣的…很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 200310511,
					"content": "不過也請放心，關於冒險家們的報酬，我們一直都在向總部爭取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
