			"trigger": {
				"objectNames": [
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "是的，是的。我知道他們什麼都敢碰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000102,
					"content": "七神、魔神、惡龍…就連帶著這些背景的古物，他們也沒有不敢下手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000103,
					"content": "但這一次，是誰給他們的膽子，去動深淵教團的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000104,
					"content": "#啊，旅行者，是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000105,
					"content": "咦？甘雨怎麼在嵐姐這裡？是要發佈什麼委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000106,
					"content": "#{F#妳}{M#你}好，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000107,
					"content": "我們剛才在聊盜寶團的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000108,
					"content": "嗯，我們剛才談到，即使是什麼都敢碰的盜寶團，原本也都知道，最好別去接觸「深淵」——因為那實在太邪門了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000109,
					"content": "但我最近從總務司接到情報，蒙德和璃月一帶的盜寶團南北兩大巨頭，正準備聯合起來做一件大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000110,
					"content": "盜寶團…南北兩大巨頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000111,
					"content": "嗯，江湖人稱「南長姊」，「北怪鳥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000112,
					"content": "啊，「怪鳥」！我有印象，他在蒙德和安柏交過手…但「南長姊」是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000113,
					"content": "長姊的意思，是最大的姐姐嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "沒錯，璃月一帶的盜寶團首領，據我所知，那夥人都稱她為「大姐頭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000117,
					"content": "也有人說她的手藝得到過盜寶之神的恩賜，所以是「神之長姊」…但這大概只是以訛傳訛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000118,
					"content": "總而言之，盜寶團發現一座無人發掘過的遺蹟，這座遺蹟暗中被深淵教團嚴密守護著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000119,
					"content": "雖然這是非常危險的徵兆，但以盜寶團的思維，只會覺得有寶物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000120,
					"content": "他們制定了計劃，派一批炮灰引開深淵教團的兵力，然後只靠一位最精英的專家深入遺蹟，取寶逃離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000121,
					"content": "為此，據說「大姐頭」和「怪鳥」從楓丹請來了一位「大盜寶家」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000122,
					"content": "「大盜寶家」？是個聽起來很有氣勢的稱號呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000123,
					"content": "是的，那是一位非常傳奇的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000124,
					"content": "所謂「大盜寶家」，在盜寶團的地位，等同於我們冒險家心目中的「大冒險家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000125,
					"content": "比如大冒險家艾莉絲小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "#{F#妳}{M#你}們也知道那位《提瓦特遊覽指南》的作者嗎？沒錯，「大盜寶家」的地位和她一樣，就是如此崇高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000129,
					"content": "所以即使是附近一帶的盜寶團南北兩大巨頭，也要千方百計把他請來，拜託他親自坐鎮整個盜寶計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000130,
					"content": "最近璃月遭逢巨變，總務司和千岩軍都過於忙碌，沒空應對這種道聽途說的盜寶團行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000131,
					"content": "但，以我的直覺，與「深淵」相關的事物，都潛藏著未知的威脅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000132,
					"content": "所以，我就想來冒險家協會掛個委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000133,
					"content": "既然我們剛好路過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "嗯，那這個委託我們就接下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000136,
					"content": "啊，非常感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000137,
					"content": "不錯，真是可靠的協會會員。那麼，一路順風，委託的細節就由協會來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000134,
					"content": "我也明白「深淵」的危害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "比如大冒險家史丹利先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "#哦？{F#妳}{M#你}們難道在蒙德見過那位前輩高人嗎？沒錯，「大盜寶家」的地位和他一樣，就是如此崇高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 80000114,
					"content": "是盜寶團口中的「大姐頭」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "#{F#妳}{M#你}知道得不少嘛，看來是和盜寶團打過很多交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
							"2"
						],
						"stepId": 800004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "這…好像是個人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000202,
					"content": "難道是…「大盜寶家」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000203,
					"content": "這個姿勢…他在對什麼東西「祈禱」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000204,
					"content": "？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000205,
					"content": "那…那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000206,
					"content": "是…七天神像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "為，為什麼七天神像…會被這樣倒掛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000209,
					"content": "而且，神像手裡…我記得…本來應該捧著一顆寶珠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000210,
					"content": "現在…神像手裡捧著的…是什麼…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000211,
					"content": "嗚…好壓抑…感覺非常不妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000212,
					"content": "那個「大盜寶家」也是一動不動的樣子，難，難道說，已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000213,
					"content": "喂，你還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80000214,
					"content": "（沒有一絲反應，也聽不到呼吸聲。）",
					"roleType": "TALK_ROLE_NPC",
