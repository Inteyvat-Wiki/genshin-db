			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "唉，看來我還是得自己跑一趟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040102,
					"content": "我這把老骨頭，非得散架不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040103,
					"content": "有什麼急事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "旅行者？唉…也不能算是急事，但我是真的操辦不過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040105,
					"content": "#{F#妳}{M#你}也知道，那群愚人眾把我的飯店給包下來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040106,
					"content": "他們包下了飯店之後，我作為「歌德大飯店」的老闆，自然也得在旁邊照應著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040107,
					"content": "幫著聯繫食材供應商，物件壞了及時叫人去修，還有一些雜七雜八的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040108,
					"content": "最近飯店裡有幾間屋子的桌椅壞了，我得趕緊去連絡人，把合適的木材送去給木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040109,
					"content": "還有城裡幾間屋子的租金沒收…瑪文那小子又成天不見影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040110,
					"content": "唉，也不知道我這把老骨頭能折騰幾年，瑪文到底什麼時候才能懂事點呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040111,
					"content": "我來幫您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}願意幫我嗎？唉，真的太麻煩{F#妳}{M#你}了，瑪文那小子要是有{F#妳}{M#你}一半懂事，我也不會累成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040114,
					"content": "#那就麻煩{F#妳}{M#你}，先幫我去拿一份杉木和一份樺木回來吧，我要趕緊把這些木材交給木匠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040112,
					"content": "你先在這休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
			"completionStepIds": [
				2000403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
