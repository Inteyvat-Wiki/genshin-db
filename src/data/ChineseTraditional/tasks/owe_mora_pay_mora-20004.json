			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "#是{F#妳}{M#你}啊，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040302,
					"content": "#怎麼一副急匆匆的樣子，{F#妳}{M#你}找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040303,
					"content": "莫娜，妳這幾天去哪裡了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200040304,
					"content": "找妳好幾天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "那可真不巧…前幾天《蒸汽鳥報》剛向我約了一份新稿件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040306,
					"content": "主題是「星相的運轉變化和個人命運變遷的關係」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040307,
					"content": "為了寫這篇稿件，我這幾天基本上都在野外觀測星象，很晚才回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040308,
					"content": "為了賺錢，莫娜也真是努力呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200040309,
					"content": "畢竟楓丹廷那邊的星象儀又推出了新版嘛，我都已經付了訂貨押金了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040310,
					"content": "等這篇稿件的稿酬到了，我就能結清尾款，正式拿到那台星象儀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040311,
					"content": "妳還有錢付歌德先生的房租嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "房租？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040313,
					"content": "喔…！我、我應該留了錢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040314,
					"content": "#{F#妳}{M#你}們等一會，我找找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040315,
					"content": "（莫娜開始翻起了自己的錢包…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "這些…加上這些！應該夠付房租了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040317,
					"content": "（莫娜是把身上的錢都掏光了嗎…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "#{F#妳}{M#你}們幫我把這些錢帶給歌德先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
