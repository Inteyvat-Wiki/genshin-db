					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040401,
					"content": "#怎麼樣，{F#妳}{M#你}們找到那位…呃…{F#妳}{M#你}們的那位朋友了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040402,
					"content": "這是租金。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "#好，好，這些錢夠了，謝謝{F#妳}{M#你}們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040404,
					"content": "#不過，{F#妳}{M#你}們的那位朋友究竟是做什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040405,
					"content": "明明看著那麼有本事，卻總是這麼窮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
		{
			"id": 2000405,
			"completionStepIds": [
				2000405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2000405",
							"2"
						],
						"stepId": 2000405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040501,
					"content": "#{F#妳}{M#你}們回來了，租金交給歌德了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040502,
					"content": "已經都交給他了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "那就好。幸好這間屋子的租金也不算太貴…勉強能把錢湊齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 200040504,
					"content": "不過，看來我又得多吃幾天沙拉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 2000406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
