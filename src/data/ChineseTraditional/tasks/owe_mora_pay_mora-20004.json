			},
			"dialogs": [
				{
					"id": 200040601,
					"content": "#{F#妳}{M#你}拿到木材了嗎？只要一份杉木和一份樺木就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
		{
			"id": 2000407,
			"completionStepIds": [
				2000407
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2000407",
							"2"
						],
						"stepId": 2000407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "#謝謝{F#妳}{M#你}，這些木材就夠了，我這就拿去給木匠…對了，還得去收房租才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040702,
					"content": "唉，也不知道那個…阿斯…阿斯…什麼莫娜…這次在不在家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040703,
					"content": "是阿斯托洛吉斯·莫娜·梅姬斯圖斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "對！就是這個名字，哎喲…我是真的記不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200040705,
					"content": "咦？莫娜還沒交房租嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200040706,
					"content": "可不是嘛，其他的租客都把房租交了，就剩她了。",
