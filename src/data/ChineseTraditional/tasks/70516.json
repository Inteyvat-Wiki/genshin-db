			"dialogs": [
				{
					"id": 705161001,
					"content": "琴親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161002
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161002,
					"content": "衷心感謝代理團長的關心。妳說得不錯，我或將不再對那件事耿耿於懷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161003
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161003,
					"content": "懲辦瀆職的伊洛克，其本質是糾正騎士團過去的錯誤。對騎士團本身意義重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161004
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161004,
					"content": "至於我的個人安全，暫時還無需騎士團操心。騎士團應當將人力用在刀刃上，照顧那些需要幫助的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161005
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161005,
					"content": "也祝妳身體健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051611,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
