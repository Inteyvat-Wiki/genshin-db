			},
			"dialogs": [
				{
					"id": 705132201,
					"content": "字跡粗獷的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132202
					]
				},
				{
					"id": 705132202,
					"content": "迪盧克 收：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132203
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132203,
					"content": "最近琴給我寫信了，我非常震驚，如果我沒猜錯，她也給你寫了吧。她的問候代表騎士團全體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132204
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132204,
					"content": "克利普斯老爺是個非常好的人，我個人相當認可他。聽聞他遭遇這種事，我實在痛心，也深表遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132205
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132205,
					"content": "另外，擊退魔龍一事，功勞理應屬於你父親。他付出所有換取的戰果被伊洛克奪走，我無法認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132206
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132206,
					"content": "靠欺騙獲得名望，於情於理我都不允許這種事發生在西風騎士團內部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132207
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132207,
					"content": "我已通知琴，伊洛克需要被從嚴處理。等有結果，騎士團將第一時間通知你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132208
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132208,
					"content": "聽說你最近在外散心，很難聯繫。我不敢指望這封信一定能送到你手上，所以就先寫到這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132209
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132209,
					"content": "如果送到了，那祝你身體健康，旅行途中注意安全。有什麼需要儘管聯繫我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132210
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132210,
					"content": "希望你的鷹足夠爭氣，讓你有機會看到這封信。我親筆所寫，很難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132211
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132211,
					"content": "或許在現在的你看來，以下這句是風涼話，但希望你記得：再大的災難也總會過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132212
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132212,
					"content": "我們在蒙德等你回來。若你願意，隨時可以回騎士團報到。（若你不願意，當我沒說。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051619,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705132301,
					"content": "字跡靈動的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132302
					]
				},
				{
					"id": 705132302,
					"content": "萊艮芬德家的貴公子收：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132303
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132303,
					"content": "冒昧來信，你或許不記得我是誰了，但我們確實見過幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132304
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132304,
					"content": "有時是在廣場附近，有時是在「獵鹿人」坐鄰桌，有時是在你的酒館裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132305
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132305,
					"content": "你總是忙於各種事務，甚至更早的時候，你顯得比後來健談許多，常與你的兄弟朋友們相談甚歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132306
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132306,
					"content": "對那時的你來說，注意不到我也很正常。不過，我可是一直記著你這位小朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132307
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132307,
					"content": "我記得很清楚，有一次可莉跑到你家葡萄園裡抓晶蝶，把整齊的葡萄架弄得一團糟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132308
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132308,
					"content": "你沒有生氣，親自送可莉回來，還給了她幾瓶新榨的葡萄汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132309
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132309,
					"content": "也許你開始有一點印象了，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132310
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132310,
					"content": "最近聽可莉說，「紅頭髮的奇怪大人好久沒出現」，我十分好奇，忍不住打聽了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132311
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132311,
					"content": "對於你父親的遭遇，我深表遺憾。請節哀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132312
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132312,
					"content": "在我聽到的故事裡，人們總說你是完美高傲，銳氣滿滿的名門騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132313
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132313,
					"content": "但我知道你比外表親切。若非如此，你不會那樣對待可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132314
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132314,
					"content": "你幫助了我的小朋友，我也想將你當作我的小朋友來對待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132315
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132315,
					"content": "因此我由衷祝願，你能盡早走出陰霾，不必長久地浸泡在悲傷和懊悔中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132316
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132316,
					"content": "分別最令人痛苦，卻也促使人成長。失去了遮雨屋簷的飛鳥，會比其他同類飛得更高遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132317
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132317,
					"content": "外出走走吧，遊歷是再合適不過的選擇了。對此刻的你而言，唯有感受、觀察和聆聽能治癒你的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132318
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132318,
					"content": "父母總期盼自己能長久地陪伴子女。天空、海洋與群星將會見證這一誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132319
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132319,
					"content": "你父親的一切都在你身上延續。你在世間感受到的，或許也正是你父親曾感受過的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132320
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132320,
					"content": "願你能在前行的風中品味到好的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132321
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132321,
					"content": "振作起來，年輕的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051620,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
