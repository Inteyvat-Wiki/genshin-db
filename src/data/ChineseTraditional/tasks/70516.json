			"dialogs": [
				{
					"id": 705132101,
					"content": "字跡工整的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132102
					]
				},
				{
					"id": 705132102,
					"content": "迪盧克先生親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132103
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132103,
					"content": "很高興能與你一同探討有關地脈的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132104
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132104,
					"content": "如你所知，我的主要研究領域是煉金術，對地脈瞭解不深，只能簡單談談個人理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132105
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132105,
					"content": "據各種已有文獻表明，地脈可以被視為一種訊息載體，其會在特定狀態下開始記錄周邊事象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132106
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132106,
					"content": "所有訊息都將經歷被記錄和被沉澱的過程。經過一定時間後，亦可能被地脈再次釋出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132107
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132107,
					"content": "我大膽猜想，世上應該存在刺激地脈運作的辦法。掌握相關手法，就可能掌控地脈記錄與放出訊息的時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132108
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132108,
					"content": "從符文及其他方面推測，一些特殊的深淵教團成員確實有極小機率能做到這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132109
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132109,
					"content": "假如你認為有必要深究，這些個體也許會成為你的突破口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132110
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132110,
					"content": "幾年前我在我的一篇論文中研判過地脈流動及相關問題。論文副本已隨信附上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132111
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132111,
					"content": "希望它能解答你的疑惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
