					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161301,
					"content": "（這塊磚…似乎有點奇怪？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161302
					]
				},
				{
					"id": 705161302,
					"content": "取下牆磚",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161303
					]
				},
				{
					"id": 705161303,
					"content": "（這是…暗格？裡面有個匣子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161304
					]
				},
				{
					"id": 705161304,
					"content": "打開匣子",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161305
					]
				},
				{
					"id": 705161305,
					"content": "匣中的物品似乎都有些年頭了。其中有張紙片十分顯眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161306
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161306,
					"content": "它被燒掉了一塊，剩餘部分看起來就像是從火堆裡搶救出來的殘渣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161307
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161307,
					"content": "紙上，每兩行內容都完全相同。看筆跡似乎是有個孩子先寫了一遍，某位大人又握著孩子的手再教了一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161308
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161308,
					"content": "所寫內容如下：「…務必記得，獨眼的王者伊爾明失能之後，是不流有王血的亞爾伯里奇一族挺身而出，暫任攝政。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161309
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161309,
					"content": "「雖無法使坎瑞亞起死回生，可我亞爾伯里奇一族的生命應是瞬息輝煌的烈焰，而非黯淡苟活的餘燼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161310
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161310,
					"content": "將紙張翻過來，背面還有別的字，應該是批註之類的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161311
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161311,
					"content": "「趁『父親』不注意從火堆中搶回的唯一紀念。我違背了原則，有關家族的事本不該被記錄下來。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161312
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161312,
					"content": "「於我，這張紙不能成為任何身分證明，無法支撐我去往任何地方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161313
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161313,
					"content": "「如今看來，他的筆跡也如行將燃盡的火焰一般悲戚。生活在蒙德的我，是無法寫出那種筆跡的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161314
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161314,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161315
					]
				},
				{
					"id": 705161315,
					"content": "拿開紙張，底下還有個布袋，裡面是一隻陳舊的眼罩。旁邊附有標籤紙，其上的文字是：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161316
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161316,
					"content": "「沒想到從前假裝獨眼海盜騙人，終有一日自己也傷了一隻眼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161317
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161317,
					"content": "「我從沒有責怪迪盧克的意思。選在義父去世那日吐露實情，發生糾紛也很正常。這都是我自找的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161318
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161318,
					"content": "「他好像當真了。不過我沒有真瞎，騙了他好一陣子…也好，就這樣繼續下去吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161319
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161319,
					"content": "布袋下方擺著兩封信，署名都是「D」。信件被保存得非常好，背面標有時間，應該是收信的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161320
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161320,
					"content": "信上的字跡瀟灑有力又不失華美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161321,
						705161325
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161321,
					"content": "閱讀第一封來信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161322
					]
				},
				{
					"id": 705161322,
					"content": "給K：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161323
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161323,
					"content": "知道了，感謝你的來信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161324
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161324,
					"content": "另外，不建議你在寫給我的信裡提什麼眼睛。別以為我不知道你右眼沒瞎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161330
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161330,
					"content": "在這兩封信的旁邊，還有一個小小的紙包。打開後是幾顆貝殼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161331
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161331,
					"content": "貝殼表面光澤並不明顯，也不知是經過了多久的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161332
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161332,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161333
					]
				},
				{
					"id": 705161333,
					"content": "（還是收好這個匣子，把一切恢復原樣吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705161325,
					"content": "閱讀第二封來信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161326
					]
				},
				{
					"id": 705161326,
					"content": "給K：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161327
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161327,
					"content": "感謝你的來信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161328
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161328,
					"content": "與騎士團合作一事客觀有利，自然也會有弊，就像硬幣的正反面。相信你比我更明白這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161329
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161329,
					"content": "安全問題無需擔憂。自保不難，難的永遠是向外推進目標。還是照顧好你自己吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161330
					],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
