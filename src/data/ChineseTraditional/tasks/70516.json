			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161501,
					"content": "這些信件裡談論的事情好像不止一件，原來以前發生過這麼多複雜的事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705161502,
					"content": "想要搞清楚事情的來龍去脈，的確要仔細推敲細節呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705161503,
					"content": "#{NICKNAME}，{F#妳}{M#你}還要讀哪一封信呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7051616,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
