				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161101,
					"content": "阿貝多親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161102
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161102,
					"content": "感謝你詳盡的說明。我已拜讀你的論文，內容詳實易懂，是不可多得的優秀文獻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161103
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161103,
					"content": "相關資訊我都記錄下來了，但願日後能用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161104
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161104,
					"content": "預防危機是項相當重要的技術。我會繼續留意深淵教團，必要時動用武力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051612,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161201,
					"content": "法爾伽團長親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161202
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161202,
					"content": "我由衷地感謝您能關心並慰問這些事。父親如能知道，一定也會為您的贊許感到光榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161203
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161203,
					"content": "沒有什麼比受到北風騎士的認可更值得他高興了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161204
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161204,
					"content": "我正在旅途中，非常幸運，順利收到了您的來信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161205
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161205,
					"content": "不出意外的話，我應該不會回騎士團。但過去的經歷我不會忘記。騎士團教會我的事，我也謹記在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161206
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161206,
					"content": "祝您身體健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
