			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160101,
					"content": "咦，這裡放著另一組信？好像不久前也被迪盧克讀過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160102,
					"content": "我們要先讀哪些呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160103,
						705160108,
						705160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160103,
					"content": "字跡華麗的信·其一",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160104
					]
				},
				{
					"id": 705160104,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160105
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160105,
					"content": "騎士團內部颳起了一場風暴。法爾伽的心腹預備徹查伊洛克和他的黨羽，他很快就會落馬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160106
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160106,
					"content": "或許你不那麼想看到我的來信，但我的本意是希望這件事能盡快傳到你耳朵裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160107
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160107,
					"content": "不用回信也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160108,
					"content": "字跡華麗的信·其二",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160109
					]
				},
				{
					"id": 705160109,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160110
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160110,
					"content": "聽說你決定出門遠遊，即便是我也感到有些意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160111
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160111,
					"content": "琴想寫信你，我建議她不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160112
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160112,
					"content": "至於法爾伽那邊，應該是還不清楚這件事。否則以他的個性，多半會約你去酒館面談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160113
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160113,
					"content": "你想走就趁最近。知道的人越少，告別儀式就越少。最好選在夜晚出發，以免感傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160114
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160114,
					"content": "一路順風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160115,
					"content": "字跡華麗的信·其三",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160116
					]
				},
				{
					"id": 705160116,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160117
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160117,
					"content": "半條壞消息。伊洛克沒那麼容易被扳倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160118
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160118,
					"content": "大團長下令調查的確給了他很大打擊，但相關勢力仍未被連根拔除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160119
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160119,
					"content": "目前這件事由琴跟進。她應該會盡到職責，伊洛克本來也是她執權路上繞不過的坎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160120
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160120,
					"content": "你只需要靜候佳音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051602",
							"2"
						],
						"stepId": 7051602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160501,
					"content": "這裡有兩篇筆記，我們先讀哪一篇比較好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160502,
						705160509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160502,
					"content": "閱讀第一篇筆記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160503
					]
				},
				{
					"id": 705160503,
					"content": "上次地脈發生異常，主動放出侵略性很強的魔物，已經是好幾年前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160504
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160504,
					"content": "「暗夜英雄」準確控制時間，將所有魔物分批引導到開闊地帶，逐一擊敗…的確是一種策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160505
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160505,
					"content": "事後偽裝成受重傷的模樣，引誘幕後的深淵教團主隊現身，再給對方迎頭痛擊，更是精彩絕倫的反擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160506
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160506,
					"content": "但這中間存在太多不確定因素了。「暗夜英雄」本人也表示不能每次都像這樣冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160507
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160507,
					"content": "查明原理，提早預防這種地脈異常現象，才是最穩妥的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160508
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160508,
					"content": "雖然不太明白，但好像提到了迪盧克以前的戰果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160509,
					"content": "閱讀第二篇筆記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160510
					]
				},
				{
					"id": 705160510,
					"content": "地脈還有很多秘密，我們這些普通人沒必要太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160511
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160511,
					"content": "不過「暗夜英雄」要長期對抗深淵教團，還是深入瞭解一下為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160512
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160512,
					"content": "聽說西風騎士團調查小隊的隊長有著很高的學術造詣。他不像麗莎，和代理團長走得很近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160513
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160513,
					"content": "向他請教一些問題，不太可能被騎士團的人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160514
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160514,
					"content": "應當建議「暗夜英雄」向他諮詢地脈的技術難題，由我來將信件送到他在雪山的營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160515
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160515,
					"content": "咦？這篇筆記好像提到了阿貝多呢。難道迪盧克寄過信給阿貝多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7051607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160701,
					"content": "還有一組信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160702,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得我們要先看哪一封呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160703,
						705160709,
						705160714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160703,
					"content": "字跡華麗的信·其四",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160704
					]
				},
				{
					"id": 705160704,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160705
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160705,
					"content": "近期有批商人回到了蒙德城，說是在外經營不利，退回蒙德發展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160706
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160706,
					"content": "經我觀察，他們的員工常往「天使的饋贈」跑。也正是這批人，多次出沒在野外危險地帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160707
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160707,
					"content": "其中有幾位不夠謹慎，居然把筆記的殘頁落在地上。好心如我，就先替他們送回「天使的饋贈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160708
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160708,
					"content": "會去那裡，應該是你有關。我看他們的筆記都用了暗語，情報販子？還是秘密組織？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160720
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160720,
					"content": "總之，雖然只憑單眼很難看清那些模糊的字，我也還是認真看了。這件事我會幫忙保密的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160709,
					"content": "字跡華麗的信·其五",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160710
					]
				},
				{
					"id": 705160710,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160711
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160711,
					"content": "我可沒有故意瞞著你，不過，倒也沒想到你已經發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160712
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160712,
					"content": "似乎沒人規定過瞎了才能戴眼罩吧。右眼有疤痕，戴個眼罩遮一下不也是天經地義嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160713
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160713,
					"content": "等候已久的好消息來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160721
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160721,
					"content": "在伊洛克離職當天端著酒杯茶杯趕去看熱鬧，目送他收拾東西滾蛋，應該挺有趣的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160722
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160722,
					"content": "你的性格多半不會這麼做。但我喜歡，我可以代勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160714,
					"content": "字跡華麗的信·其六",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160715
					]
				},
				{
					"id": 705160715,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160716
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160716,
					"content": "真不巧！你才回蒙德沒多久，城裡就出現了一個神秘人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160717
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160717,
					"content": "聽說他被稱為「暗夜英雄」。此人曾多次打擊蒙德周邊的盜寶團和魔物，甚至主動進攻深淵教團據點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160718
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160718,
					"content": "目前看來，他的行動對蒙德尚算有利。但騎士團不可能允許獨立的武裝勢力存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160719
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160719,
					"content": "我總覺得你們會很合得來，你快找個機會認識一下這位，最好能再勸勸他。可別被騎士團抓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160801,
					"content": "這裡也有幾封信呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160802,
					"content": "#來，{NICKNAME}，選出{F#妳}{M#你}想讀的信件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160803,
						705160810,
						705160816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160803,
					"content": "字跡華麗的信·其七",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160804
					]
				},
				{
					"id": 705160804,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160805
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160805,
					"content": "例行公務，騎士團需要對相關人士取證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160806
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160806,
					"content": "最近騎士團收到幾例目擊報告，稱「暗夜英雄」曾在晨曦酒莊一帶出沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160807
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160807,
					"content": "大團長指定騎兵小隊執行本次任務。因此，我將在三天後登門拜訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160808
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160808,
					"content": "他似乎覺得，強迫我們面對面交流就能改善我們的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160809
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160809,
					"content": "當然了，我不會多說半個字，只是走個流程。提前三天通你，算是給足了準備時間吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160810,
					"content": "字跡華麗的信·其八",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160811
					]
				},
				{
					"id": 705160811,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160812
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160812,
					"content": "上次深淵教團來襲，「暗夜英雄」的出現的確為騎士團爭取到了一定時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160813
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160813,
					"content": "這也讓琴有了服眾的理由，騎士團不會再重點防備「暗夜英雄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160814
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160814,
					"content": "「暗夜英雄」受到的限制將會減少，但處境未必會變好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160815
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160815,
					"content": "鋒芒太過銳利的事物，勢必容易遭到折損。獨自行動意味著怎樣巨大的風險，你應該很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160823
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160823,
					"content": "我不推薦這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				},
				{
					"id": 705160816,
					"content": "字跡華麗的信·其九",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160817
					]
				},
				{
					"id": 705160817,
					"content": "給D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160818
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160818,
					"content": "聽說晨曦酒莊幸未遭受任何損失。騎士團也只有幾人輕傷，短時間內就能恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160819
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160819,
					"content": "只是，有位商鋪員工失蹤了。失聯地點與深淵教團的行動路線巧妙地重合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160820
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160820,
					"content": "騎士團已經派人前去搜救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160821
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160821,
					"content": "你必須意識到，深淵教團已經變得越來越危險，甚至開始組織多線攻勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160822
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705160822,
					"content": "「暗夜英雄」或許該考慮與騎士團合作，那樣才能萬無一失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051610,
