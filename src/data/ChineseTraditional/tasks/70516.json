			"dialogs": [
				{
					"id": 705132501,
					"content": "方才的來信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132502
					]
				},
				{
					"id": 705132502,
					"content": "誥告「暗夜英雄」，騎士團已在蒙德各地加強警戒，而且沒有明顯的調動，不會引發深淵教團的警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132503
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132503,
					"content": "我正在龍脊雪山一帶偵察，這裡的魔物較為零散，並沒有被深淵教團集結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132504
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132504,
					"content": "蒙德南部也沒有敵人活動的跡象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132505
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132505,
					"content": "如果你確認其他方向也沒有魔物，那就可以確認了，這次的地脈異常與深淵教團無關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		}
	]
}