			"dialogs": [
				{
					"id": 705132401,
					"content": "字跡疏朗的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132402
					]
				},
				{
					"id": 705132402,
					"content": "老爺親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132403
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132403,
					"content": "凱亞少爺請假回晨曦酒莊小住了幾天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132404
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132404,
					"content": "非常難得，他就住在原來那間臥室。閒暇時四處散步，還請愛德琳做了他喜歡吃的菜餚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132405
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132405,
					"content": "那種感覺，讓我像是回到了從前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132406
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132406,
					"content": "不瞞您說，凱亞少爺出現在我們面前說要住幾天時，我深感驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132407
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132407,
					"content": "但我們沒有拒絕。我們覺得，即便您在，也不會明著反對他住下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132408
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132408,
					"content": "晨曦酒莊向來算得上清淨，或許是因為住在此地的人都較為安分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132409
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132409,
					"content": "…房屋，總是跟著人的氛圍走。凱亞少爺難得來一趟，倒是讓這裡熱鬧了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132410
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132410,
					"content": "願您旅行在外也能過得好。酒莊所有人都很想念您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132411
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132411,
					"content": "請務必平安健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
