			},
			"dialogs": [
				{
					"id": 705132001,
					"content": "字跡娟秀的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132002
					]
				},
				{
					"id": 705132002,
					"content": "迪盧克前輩——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132003
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132003,
					"content": "歡迎回到蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132004
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132004,
					"content": "那件事已經過去一段時日了，我們查明是伊洛克從中作梗，他已被嚴厲懲辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132005
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132005,
					"content": "希望聽見這個消息後，你的心境能稍微平復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132006
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132006,
					"content": "此外，我們的人發現，最近深淵教團在奔狼領到石門一帶活動愈發頻繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132007
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132007,
					"content": "還有一名被稱作「暗夜英雄」的神秘人，最近他常在午夜時分出沒，活躍於蒙德城四周。行動目的尚不明朗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132008
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132008,
					"content": "請務必注意安全，發現異常盡早通知騎士團，我們將是你的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132009
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132009,
					"content": "不論是否任職於騎士團，你對騎士團的貢獻仍會被每位信念堅定的騎士銘記在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132010
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705132010,
					"content": "祝你健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051617,
