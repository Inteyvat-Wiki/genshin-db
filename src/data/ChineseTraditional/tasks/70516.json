			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161401,
					"content": "艾莉絲女士親啟：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161402
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161402,
					"content": "必須承認，我在閱讀信件開頭時，沒有想到這封信出自您之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161403
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161403,
					"content": "或許有許多次您就近在我身旁，只是我沒能注意到。我為我的疏忽向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161404
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161404,
					"content": "曾有耳聞，您是非常厲害的魔女，即使沒有我，可莉也一定能安全返回家中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161405
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161405,
					"content": "即便如此，您卻依然為我寄來這封信。對此我唯有感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161406
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161406,
					"content": "如您所說，旅行是眼下最好的選擇。我會依照您所說，去感受世間的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161407
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161407,
					"content": "父親那份意志，將在我的生活中延續下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161408
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161408,
					"content": "我不在的這段時間，也歡迎可莉到晨曦酒莊做客。愛德琳會準備足夠多的點心和葡萄汁，期待小客人光臨。若您不嫌棄，也請一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161409
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705161409,
					"content": "祝您和可莉身體健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
		{
			"id": 7051615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
