			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鐵弘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "#請留步！層岩巨淵禁地，外來旅客請…啊，是{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460202,
					"content": "糟了，快跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460203,
					"content": "派蒙，別鬧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "#哈哈哈哈…抱歉嚇到{F#妳}{M#你}們了。救命恩人我怎麼能不記得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460207,
					"content": "我也是最近才換防過來的…沒想到正巧能在這裡遇到恩人，真是好運氣呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460208,
					"content": "恩人…？我們做過什麼好事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460209,
					"content": "哪裡的話！大家對付海中大魔那時候，我也在群玉閣呀。受了點傷，前陣子才靈活一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460210,
					"content": "#可能{F#妳}{M#你}對我沒什麼印象，不過我可忘不了{F#妳}{M#你}。並肩作戰的兄弟們都見證了{F#妳}{M#你}對璃月的付出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460211,
					"content": "關於層岩巨淵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "前兩年礦洞裡發生了不明原因的事故，被七星下令關停了。礦工也大多安然無恙地疏散了出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460213,
					"content": "只不過呀，可惜了，這麼大的一座礦就這樣停產了。工人們領了補貼就各做各的營生去了…唉，一朝人散了，再重聚就難了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460214,
					"content": "#啊，抱歉扯遠了。我相信{F#妳}{M#你}是有要事才會來這裡，就不先攔著{F#妳}{M#你}了。有什麼事請直接去找沐寧吧，他就在入口處的營地裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460215,
					"content": "呃…不是不信任，只是職責所在。我還是要叮囑一句，可不要在這裡做違法亂紀的事情喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "鐵弘"
				},
				{
					"id": 710460216,
					"content": "放心吧，你還信不過我們嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460204,
					"content": "你認得我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "被認出來了，快跑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}