			"dialogs": [
				{
					"id": 207420101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "啊！蒲公英！全都飛走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420103,
					"content": "#{F#妳}{M#你}做什麼啊！這盆蒲公英好不容易才長好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420104,
					"content": "我在幫它散佈到遠方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "這是在城裡！飛不了多遠就會被牆擋住的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420106,
					"content": "這樣就可以長出更多蒲公英了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "#那{F#妳}{M#你}直接拿著蒲公英籽去城外放飛不就好了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420108,
					"content": "嗚…我的蒲公英，好不容易才種好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420109,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}，需要蒲公英，直接去城外採不就好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420110,
					"content": "#而且…這盆蒲公英的花籽還是{F#妳}{M#你}幫我蒐集的，我照顧了好久才讓它長大…{F#妳}{M#你}就這麼對它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
		{
