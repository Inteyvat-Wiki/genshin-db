						207420503
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207420503,
					"content": "這些都給妳",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "…這些蒲公英籽我就收下了，等會我再去重新種一盆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420505
