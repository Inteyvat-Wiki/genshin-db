				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "#旅行者！啊不對，財富之子，幸運之人！{F#妳}{M#你}來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030202,
					"content": "#上次吃了{F#妳}{M#你}準備的「吞金料理」，我在交易所裡根本是大殺四方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030203,
					"content": "不管買入什麼期貨，今天過來一看，全都是大賺特賺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030204,
					"content": "#走走走，去蘭巴德酒館，隨便點菜，今天我請客，我要好好感謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "#多虧了{F#妳}{M#你}們的幫忙啊，今天想吃什麼隨便點！哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030402,
					"content": "看來你真的賺了很多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030403,
					"content": "放在常人身上還算是很多，不過跟我哈特姆的資產比起來，也就普普通通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030404,
					"content": "#畢竟我也是縱橫交易所幾十年的老專家了，要是{F#妳}{M#你}們對期貨也有興趣，我倒是可以跟{F#妳}{M#你}們分享一點個人的心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030405,
					"content": "#上次說好了的，有額外的好處給{F#妳}{M#你}，{F#妳}{M#你}們可別跟我客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030406,
					"content": "原來好處就是指這個啊，感覺跟沒好處也差不多嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030407,
					"content": "畢竟我們也不做期貨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "#別這樣說，摩拉當然少不了{F#妳}{M#你}們那份，但比起那個，我哈特姆的指點，才是真正有價值的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030409,
					"content": "那我有個問題…真的會有史萊姆期貨嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030410,
					"content": "不、不是想賺錢！就是這麼問一問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030411,
					"content": "只有流通的商品才會成為期貨，也就是說，如果市場上有麵粉那麼多、牛奶那麼多的史萊姆凝液，那才有可能形成史萊姆凝液的期貨交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030412,
					"content": "就和我之前說的一樣。如果史萊姆凝液想要形成期貨交易，那只怕野外的史萊姆都要被抓光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030413,
					"content": "而且，說不定還會出現專門飼養史萊姆，持續生產大批史萊姆凝液的機構或個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030414,
					"content": "到時候，史萊姆凝液的價格說不定也會水漲船高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030415,
					"content": "嗚哇！只不過是買點史萊姆凝液，怎麼這麼複雜呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030416,
					"content": "#我、我還是讓{NICKNAME}直接幫我去打倒史萊姆吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030417,
					"content": "#財運之子，{F#妳}{M#你}呢，{F#妳}{M#你}有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030418,
					"content": "你是怎麼研究出「吞金料理」的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "哈！果然不愧是財運之子啊，一下就問到了致富的關鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030420,
					"content": "不能說是「研究」出的，只能說…這些「吞金料理」是我在長久的期貨交易生涯裡「總結」出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030421,
					"content": "雖然期貨交易市場波詭雲譎…但只要有「吞金料理」在，我一定能狠狠地掌握住投資之船的船舵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030422,
					"content": "果然沒有根據啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "#先不說了，來！吃菜吃菜！多吃一點、多吃一點，以後我還要多多請{F#妳}{M#你}幫忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030425,
					"content": "來！吃吃看這道烤肉卷，這可是須彌的特色菜，不得不品嚐啊，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030426,
					"content": "與哈特姆一起享用了美食…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "這不就是「只求心安」嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "明明是在「蓄財之地」吃下的「吞金料理」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030702,
					"content": "最後居然跌成這樣…不講道理！這個市場還有規律可言嗎，有規則可講嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030703,
					"content": "哈特姆，我們找你半天呢，你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030704,
					"content": "#是{F#妳}{M#你}們啊…我我…沒事，我好著呢…{F#妳}{M#你}們看，我也沒缺條手臂少條腿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030705,
					"content": "不過就是虧走了保證金而已…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030706,
					"content": "抱、抱歉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "#不！這不是{F#妳}{M#你}的問題，不用放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030708,
					"content": "當然，這肯定也不是我的問題，真要怪就怪這個市場太爛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030709,
					"content": "沒有道理！不講規律！說跌就跌，說漲就…它也一直就不漲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030710,
					"content": "真是，哎喲，我真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030711,
					"content": "算了算了，我還就不信了…我卡里米的不凡富翁哈特姆，還征服不了期貨交易！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030712,
					"content": "你不都虧了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "哼，沒關係，我還有充足的後備資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030714,
					"content": "就算手頭分文不剩了，在別處我還有周轉的資金和資產呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030715,
					"content": "等著吧，卡里米交易所，我哈特姆還會回來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		}
	]
}