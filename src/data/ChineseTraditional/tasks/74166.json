			"dialogs": [
				{
					"id": 741660301,
					"content": "怎麼樣，兩位商量好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660302,
					"content": "說好了，一定是免費的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660303,
					"content": "那當然，那當然，絕對是「免費」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660304,
					"content": "來來來，接下來就跟著我一起熟悉梅洛彼得堡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
				}
			]
		},
