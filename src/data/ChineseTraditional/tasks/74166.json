			"dialogs": [
				{
					"id": 741660501,
					"content": "這裡是三枚券劇團的所在地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660502,
					"content": "嗯？這樣就介紹完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660503,
					"content": "#{F#妳}{M#你}們難道沒有聯想到什麼嗎？說到劇團那就是戲劇！說到戲劇那就是浪漫！說到浪漫那就是愛情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660504,
					"content": "有傳聞說，只要每天都來這裡觀看表演，就能找到此生的摯愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660505,
					"content": "還有這種傳聞？那大家不是應該都聚在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660506,
					"content": "#話是這麼說沒錯，但前提要求{F#妳}{M#你}既不能是梅洛彼得堡的犯人，也不能是梅洛彼得堡的看守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660507,
					"content": "那根本就沒有人能遇到摯愛了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660508,
					"content": "或許這就是問題所在了。不管怎樣，我們先向下一個目標邁進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
				}
			]
		},
