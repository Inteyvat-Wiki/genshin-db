					}
				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#那邊的{M#帥哥}{F#美女}，對對，就是{F#妳}{M#你}，就是{F#妳}{M#你}，來來來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660202,
					"content": "嗯？你在叫我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660203,
					"content": "#哦，兩位朋友，我一看就知道{F#妳}{M#你}們是新來的，對梅洛彼得堡還不太熟悉對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660204,
					"content": "#恭喜{F#妳}{M#你}們今天能遇到我，我是梅洛彼得堡裡心地最善良的「住民」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660205,
					"content": "#今天就讓我來帶領{F#妳}{M#你}們熟悉一下梅洛彼得堡吧。當然，這一切都是「免費」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660206,
					"content": "其實我很熟悉這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "欸，別這麼說嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660208,
					"content": "#或許{F#妳}{M#你}覺得{F#妳}{M#你}很熟悉這裡，但是在我的導覽下，我相信{F#妳}{M#你}能發現不一樣的景色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660209,
					"content": "天下竟然有免費的午餐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "當然當然，我說了，我可是梅洛彼得堡裡心地最善良的「住民」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660211,
					"content": "唔，總覺得這個人怪怪的，怎麼一見面就這麼熱情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741660212,
					"content": "#哈哈，我的朋友，不要多想。這樣，要不然{F#妳}{M#你}們先商量一下，我就在這裡等{F#妳}{M#你}們做決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "奇怪的人"
				},
				{
					"id": 741660213,
					"content": "#等{F#妳}{M#你}們商量好了，就來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇怪的人"
				}
			]
		},
