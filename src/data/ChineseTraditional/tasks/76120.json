					}
				]
			},
			"dialogs": [
				{
					"id": 761200101,
					"content": "#…來，給{F#妳}{M#你}，這樣我的部分就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200102,
					"content": "哇！是畫板！這麼看來，難道說…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200103,
					"content": "#嗯，{F#妳}{M#你}們來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200104,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200105,
					"content": "是梅拉大畫家！好久不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200106,
					"content": "來得正好指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "我剛剛帶梅拉去了一趟月球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200108,
					"content": "真羨慕妳說這話的語氣…輕鬆得就像說去隔壁花園逛了一圈一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200109,
					"content": "不過，你們去月球做什麼啊？去考察嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200110,
					"content": "#對了一半，我們還在月球上選好了辦「畫展」的地方，{F#妳}{M#你}們記得的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200111,
					"content": "哦！記得記得，大畫家梅拉的月神主題展！到時候一定要叫我們去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200112,
					"content": "嗯，當然。另外，梅拉這孩子，好像能體察到周圍一些很細微的變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200113,
					"content": "它說我從月球上回來之後，很明顯變了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200114,
					"content": "所以想要我帶它去看看月球上到底有什麼特殊的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200115,
					"content": "哦！不愧是大藝術家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200116,
					"content": "所以特殊的東西是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "我也不知道，我帶梅拉逛了好多地方，它好像都不滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200118,
					"content": "#直到，我帶它去了{F#妳}{M#你}的飛船附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200119,
					"content": "飛船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "不過我帶它走近一些後，卻發現它感興趣的並不是飛船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200122,
					"content": "嗯？那是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200123,
					"content": "~！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200124,
					"content": "嗯？它在繞著哥倫比婭妳飛欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200125,
					"content": "哈哈，在那時它就這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200126,
					"content": "我想，它真正感興趣的，是我看到飛船後的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200127,
					"content": "妳的…樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200128,
					"content": "#嗯，我想起了和{NICKNAME}一起來到這裡時的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200129,
					"content": "#我們坐在船上，望著提瓦特。{M#他}{F#她}找到了過去的真相，而我找到了自己的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200130,
					"content": "僅僅只是回憶起這些，我就有了一種安心——或說，幸福的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200131,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200132,
					"content": "嗯，你說得沒錯，這是我以前基本不曾有過的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200133,
					"content": "#所以，我就把我們的故事，包括和{F#妳}{M#你}上月球後發生的事告訴了梅拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200134,
					"content": "它聽完後看起來很滿意，像是找到了自己想要的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200135,
					"content": "原來是這樣，那現在就是大畫家梅拉動筆的階段了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200136,
					"content": "#{F#妳}{M#你}們當時沒帶我上去，我也很好奇梅拉到底會畫出怎樣的風景呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200137,
					"content": "這次需要什麼來做顏料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "這次的有些特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200139,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200140,
					"content": "梅拉說，它想要只屬於我們自己的顏料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200141,
					"content": "欸？這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200142,
					"content": "大概就是…當妳看到這個東西的時候，就會想起這段旅程，心中浮現起它帶給妳的收穫與歡喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200143,
					"content": "不用擔心，梅拉只是想看看那東西，感受一下而已。不會用這麼珍貴的東西來做顏料的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200144,
					"content": "哥倫比婭給了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "#月球的土壤，還有{F#妳}{M#你}們送給我的祈月之夜賀卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200146,
					"content": "#哦~總之就是能代表這次冒險的東西吧？那就交給{NICKNAME}來選了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200120,
					"content": "那是真的有點特殊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
