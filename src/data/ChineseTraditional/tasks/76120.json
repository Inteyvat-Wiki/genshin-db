			"dialogs": [
				{
					"id": 761200301,
					"content": "嗯，不錯的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200302,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200303,
					"content": "它看起來很滿意呢，已經開始畫起來了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200304,
					"content": "這麼一想，梅拉的這些畫，簡直囊括了哥倫比婭從誕生到現在的故事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200305,
					"content": "故事還不會結束。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "嗯！我也還沒看夠這位大畫家的作品呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200307,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 761200308,
					"content": "#哦！畫好了嗎？{F#妳}{M#你}的速度真是一如既往地快呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200309,
					"content": "我看看…哇！好漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200310,
					"content": "原來在月球上看提瓦特，是這麼美的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200311,
					"content": "哈…我現在能明白，為什麼梅拉會說我變得不同了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200312,
					"content": "嗯？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761200313,
					"content": "看到這幅畫後，我想起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200314,
					"content": "當時的我坐在月球上看著提瓦特，心裡在想——以前的我，一直都在尋找屬於自己的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200315,
					"content": "但現在，我忽然有了兩個「家」，而且它們都如此美麗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200316,
					"content": "那時我明白了——或許「家」是你珍視的東西、珍視的「家人」和朋友們所在的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200317,
					"content": "不錯的感想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "#謝謝{F#妳}{M#你}，這之後，我想經常帶月靈們去月亮上玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200319,
					"content": "#也歡迎{F#妳}{M#你}們，以後一起去我的「另一個家」看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
