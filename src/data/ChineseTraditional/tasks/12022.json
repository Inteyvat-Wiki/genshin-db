			"dialogs": [
				{
					"id": 120220401,
					"content": "心海，妳在找的是這一本嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220402,
					"content": "我也有點記不清了…可以讀兩句讓我聽聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220403,
					"content": "「制由權也，權因事制」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "#嗯嗯，就是這個！拜託{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220406,
					"content": "心海…心海…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220407,
					"content": "#怎麼辦呀，{NICKNAME}，心海她好像睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220408,
					"content": "今天晚上還有慶功晚會呢！而且馬上就要和談了，還有很多事沒有做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220409,
					"content": "讓她休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220411,
					"content": "不過，心海確實很疲憊的樣子。既然還有時間，我們再陪她一起休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220412,
					"content": "祓除災厄…護佑平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220413,
					"content": "戰爭已經結束了喔…一切都在慢慢變好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220414,
					"content": "你們看到了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220415,
					"content": "欸…我睡著了嗎？現在幾點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220416,
					"content": "心海已經睡了很久了喔！馬上就要篝火晚會啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220417,
					"content": "這麼晚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220418,
					"content": "已經好久沒有睡得這麼安穩了。感覺這次至少回復了三點能量值，應該能堅持到和談結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220419,
					"content": "#謝謝{F#妳}{M#你}了，{NICKNAME}。走吧，我們一起去篝火晚會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220420,
					"content": "心海恢復平時的樣子了呢！真的太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220421,
					"content": "叫她起來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "嗯嗯，心海也說了，不能耽誤正事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220423,
					"content": "喂——心海，起床啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220424,
					"content": "唔…我睡著了嗎，現在幾點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220425,
					"content": "準備出發去篝火晚會啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120220426,
					"content": "都這麼晚了嗎？嗚嗚…總覺得能量還沒有回滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220427,
					"content": "等下幫妳買新的兵書。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "真的嗎！我想看《提瓦特戰爭藝術》最新的一期！",
