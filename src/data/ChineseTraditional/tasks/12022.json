					"nextDialogs": [
						120220429
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220429,
					"content": "#八重堂應該上個月就印製出來了，但我一直沒辦法去買…{F#妳}{M#你}可不能反悔喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "珊瑚宮心海"
				},
