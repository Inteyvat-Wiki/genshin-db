			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "#我回來了，{F#妳}{M#你}們看到什麼有意思的東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440142,
					"content": "都看不懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "沒關係，只是一些煉金術的常用物件而已，生活中不太會用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440146,
					"content": "總之，抓緊時間進行下一項研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440101,
					"content": "不同的世界之間，可能存在非常大的差異。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440102,
					"content": "打個比方來說，在提瓦特，擁有神之眼的人就可以使用元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440103,
					"content": "但也可能存在「只有一人可以使用元素力的世界」，又或者「每個人都能使用元素力的世界」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440104,
					"content": "#所以，{NICKNAME}除了元素之外…{F#妳}{M#你}是否還掌握一些，這個世界沒有的特殊力量呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440105,
					"content": "還是只能用之前的辦法，用實驗來測定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440106,
					"content": "又要打史萊姆嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "不不不，這次就不大費周折了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440109,
					"content": "#這邊有根柱子，{F#妳}{M#你}試試看用意志力將它折斷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440110,
					"content": "抱歉，我做不到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "已經認真地嘗試過了嗎？是嗎…唔，沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440112,
					"content": "這才是正常的吧，怎麼覺得你有點失望的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440116,
					"content": "#對了，{F#妳}{M#你}有嘗試過用元素力做菜嗎？不是說烹飪，而是把元素力放進菜裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440117,
					"content": "我很好奇菜會不會因此變得更好吃，或者改變口感，甚至是…增殖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440118,
					"content": "煉金術士的想法真是獨特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "哈哈，好奇心放在平時別人不會注意的地方，更容易發現驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440121,
					"content": "#那麼，拜託{F#妳}{M#你}們去做一道「奶油煎魚」吧，這裡是我剛剛準備的食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440151,
					"content": "還以為你是去準備奇奇怪怪的東西，原來是食譜啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440122,
					"content": "因為平時我也經常吃這個，無論是做實驗還是品嚐，它都是很好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440123,
					"content": "你肯定是餓了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440124,
					"content": "不過如果要做好吃的，我是不會反對的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440125,
					"content": "好好好，知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "嗯嗯，這就是好夥伴的默契！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440128,
					"content": "#那就交給{F#妳}{M#你}們了，我很期待實驗結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440130,
					"content": "如果真的出現我們吃不完的情況，還可以請蒂瑪烏斯一起來分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440131,
					"content": "有我在，不用擔心這種事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440126,
					"content": "不會忘記妳的那一份的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "你不會只是因為餓了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "折斷它吧，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "#無論是{F#妳}{M#你}還是我都做不到啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440115,
					"content": "已經認真地嘗試過了嗎？是嗎…唔，沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440107,
					"content": "又要喝藥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "有點亂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "嗯，同感，我也正想找個時間收拾一下，不過實驗一個接一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "阿貝多"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "#沒想到{F#妳}{M#你}們真的全都找到了，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440321,
					"content": "尋找物品，還有之前來雪山找我的時候，用到的都是「元素視野」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440322,
					"content": "是的，這個應該算是超能力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440323,
					"content": "有點遺憾，雖然「元素視野」比較罕見，但是總歸是提瓦特大陸存在的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440324,
					"content": "只有完全沒有聽說過的異世界超能力，才能為我的研究提供幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440325,
					"content": "也就是說，又白忙一場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440326,
					"content": "不用太沮喪，這也在預料之中，而且能回收失物，這次實驗已經非常有價值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440301,
					"content": "#{F#妳}{M#你}們能夠想到失物都具有元素力這一點，也值得稱讚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440302,
					"content": "#好了，之前都是在研究異世界可能存在的與眾不同之處，但是對於{F#妳}{M#你}人類的身分的研究，現在才要開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440303,
					"content": "做好奉陪到底的準備了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "人類的個體差異，集中體現在智力和身體機能的水準上，我們就從身體機能方面開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440306,
					"content": "#從這裡望出去，{F#妳}{M#你}可以看見砂糖她現在在做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440307,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "#那如果{F#妳}{M#你}平地起跳，跳到那邊的山崖上，能看到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440309,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "#那如果{F#妳}{M#你}一拳打碎面前的山體，能看到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440311,
					"content": "不能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "既然是這樣，可能還要下調一點期待。比起提問，還是做實驗更直觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440314,
					"content": "我知道一個地方非常適合進行體能實驗，跟我過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440312,
					"content": "我覺得這個是超能力測試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "這就叫「上了賊船」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
