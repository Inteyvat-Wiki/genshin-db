				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "唔，是非常普通的好吃料理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440502,
					"content": "#我最期待的增殖現象並沒有出現，看來就算是{F#妳}{M#你}的世界也無法擺脫食物的困擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440503,
					"content": "#不對，可能是這個世界的法則限制了{F#妳}{M#你}的特殊能力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440504,
					"content": "首先是不知道要怎麼樣把元素力，像調味品一樣放進料理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440505,
					"content": "#沒關係，至少沒有浪費可口的食物，{F#妳}{M#你}們也不必感到沮喪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440506,
					"content": "這裡是答應要分享給妳的那一份，慢慢享用吧，帶走也沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440507,
					"content": "謝謝你，居然好好地記得這件事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440508,
					"content": "你對派蒙真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "#因為我能看出她是{F#妳}{M#你}很好的朋友，實驗過程中她一直在提醒{F#妳}{M#你}，也在擔心{F#妳}{M#你}的安危。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440511,
					"content": "雖然這些提醒和擔心有沒有起到作用，是需要另外討論的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440512,
					"content": "喂，不要突然說我壞話啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440513,
					"content": "不過你請我吃了好吃的，我願意原諒你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440514,
					"content": "也不用羡慕我們關係這麼好啦。你不是也有朋友，還有學生嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440515,
					"content": "…嗯，是啊，我也算幸運的吧。不說這些了，我們進行下一項實驗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440516,
					"content": "煉金術用品種類繁雜，如何收納存放是個令人頭痛的問題。前不久因為意外，我的收藏品散落了一地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440517,
					"content": "雖然大部分都找了回來，但有一瓶風晶蝶的元素萃取物，還有一瓶無相之雷的粉末，怎麼都找不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440518,
					"content": "做飯之後，接下來又是找東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440519,
					"content": "沒關係，本來就打算重新製備了，只是如果能找到，就可以省去很多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440520,
					"content": "#假如{F#妳}{M#你}擁有「夜視」，或者「震動感知」之類的超能力，要找到遺失的小東西就是輕而易舉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440521,
					"content": "#東西應該就掉在之前{F#妳}{M#你}們參觀過的地方的某個角落裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110440522,
					"content": "那…就只能試試看了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440523,
					"content": "丟的東西好像都有元素力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "對哦！可以用元素視野！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110440509,
					"content": "很少有人對派蒙這麼好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
