			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布列松"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746690101,
					"content": "布列松，你要相信自己…相信自己，所有的器材都準備好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690102
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690102,
					"content": "只要…呼…只要你下水…下水證明一下這些器材的可靠性，一切就大功告成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690103
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690103,
					"content": "你在做什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690104
					]
				},
				{
					"id": 746690104,
					"content": "哎喲！您是從哪冒出來的，怎麼連一點聲音都沒有？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690105
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690105,
					"content": "我嚇得差點栽進水裡…要是我剛才沒站穩，楓丹留影技術就沒有未來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690106,
						746690107
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690106,
					"content": "抱歉啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				},
				{
					"id": 746690108,
					"content": "不過，你不會游泳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746690109,
					"content": "看起來你也是個楓丹人啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690110
					]
				},
				{
					"id": 746690110,
					"content": "誰…誰說楓丹人一定要會游泳了？也不是每一個璃月人都會做菜、每一個蒙德人都會作詩吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690111
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690111,
					"content": "我不和您說了，好不容易才借來這一套潛水設備，今天我必須去水下留影一趟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690112
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690112,
					"content": "原來是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746690113,
					"content": "這留影機有什麼特別之處？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690114
					]
				},
				{
					"id": 746690114,
					"content": "特別之處？這台留影機是由我布列松·卡蒂親自改造過的，這就是它的「特別之處」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690115
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690115,
					"content": "我的改造方法既嚴謹，又巧妙，採用的材料也都是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690131
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690131,
					"content": "鏡頭更是比其他留影機好上無數倍，在水下留影時，畫片的品質沒有絲毫折損！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690116
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690116,
					"content": "但協會裡的那群傢伙…對我的新技術根本不在意，還說什麼留影主要靠留影者的技術，留影器材不重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690117
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690117,
					"content": "等我拍出幾張漂亮的畫片，一定能讓這群根本不懂留影器材重要性的傢伙閉嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690118
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690118,
					"content": "呼…布列松，你要相信自己…相信自己…水溫很合適，水裡也沒有會吃人的魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690119
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690119,
					"content": "我…我…哎喲！這潛水服真的有用嗎？說不定它會在水底突然爆裂啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690120
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690120,
					"content": "然後我就會被暗流捲到水底，誰也發現不了我，天哪，哎喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690121,
						746690122
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690121,
					"content": "實在不行，我可以幫忙啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690123,
					"content": "#真的嗎？！您願意幫我？好慷慨的{M#先生}{F#女士}，您真是我的大救星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690124,
						746690125
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690124,
					"content": "你還是得付我報酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690126,
					"content": "我當然不可能讓您幫我白跑這一趟，您一定能拿到一大筆報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690127
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690127,
					"content": "對了，我還得把幾處水底的好風景標在您的地圖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690128
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690128,
					"content": "還有一些地上的，呃…應該是在這附近…這是全新的器材，得多找幾個地方測試一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690129
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690129,
					"content": "這樣就可以了，楓丹留影技術的未來，還有我的留影機器材事業，就全部拜託給您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690130
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690130,
					"content": "我就…呃…在岸上等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690125,
					"content": "但報酬要按照協會的規定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690122,
					"content": "不然…我幫你去水下留影吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690107,
					"content": "也沒想到你反應這麼大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				}
			]
		}
	]
}