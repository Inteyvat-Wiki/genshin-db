			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708101501,
					"content": "（拿出「獵鹿人的餐品」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101502
					]
				},
				{
					"id": 708101502,
					"content": "這個是食物吧，還特地曬乾了，確實是容易拿，但是味道好像不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101503
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101503,
					"content": "哈哈哈，不過好歹是蒙德城的特產，這個我就帶回去，送給別人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101504
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101504,
					"content": "#{F#妳}{M#你}辦事還挺不錯的，有什麼想問的，趕緊問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101505
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101505,
					"content": "關於「女士」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101506
					]
				},
				{
					"id": 708101506,
					"content": "#我就知道{F#妳}{M#你}要問這個，不過，這個我真不知道，我自己都還在奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101507
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101507,
					"content": "上頭派我來蒙德城幫「女士」大人辦事，但是到今天「女士」大人都沒讓我幹活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101508
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101508,
					"content": "聽人家說，「女士」大人就來了一趟，然後就離開蒙德城了，據說她心情還不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101509
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101509,
					"content": "唉，也不知道「女士」大人是不是把事情給辦完了，如果事情辦完了，我是不是也可以回去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101510
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708101510,
					"content": "成天在這裡莫名其妙地被修女和西風騎士瞪著，我自己也不自在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
			"id": 7081018,
