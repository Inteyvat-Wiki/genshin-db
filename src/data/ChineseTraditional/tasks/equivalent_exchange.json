			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "#{F#妳}{M#你}還有什麼事情？要問就快點問，別磨磨蹭蹭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100122,
					"content": "你為什麼找我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "#哈，這個問題挺不錯，我為什麼找{F#妳}{M#你}…因為我這個愚人眾，在蒙德城裡就快要人人喊打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100124,
					"content": "之前就是修女看我的眼神怪怪的，現在，西風騎士看我的眼神，就像是想把我當街給逮捕了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100125,
					"content": "#除了能和{F#妳}{M#你}這位旅行者說上點話，我難道還真敢去拜託其他的蒙德人幫忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100126,
					"content": "我就搞不懂了，我到底做了什麼事，這麼惹人厭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100127,
					"content": "還有多少愚人眾在城裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "詳細數量我不知道，不過歌德大飯店裡的那些先生們是已經閉門不出了，也不知道發生了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 708100129,
					"content": "我想，說不定是那些大人物又在做什麼事。不過嘛…哼，這些事和我這個小角色一點關係都沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
			"id": 7081003,
			"completionStepIds": [
				7081002
