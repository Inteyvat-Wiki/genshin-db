			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "關於蒙德城的特產…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "蒙德城的特產？雖然我們的菜品都能說有蒙德特色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100203,
					"content": "但是，我們店裡一般的菜都不能放很久，也不方便長途攜帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100204,
					"content": "雖然我們也可以把一般的菜加工得方便攜帶和儲存…但這樣做的話，口感和味道都會差不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100205,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "好吧，如果您堅持的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100207,
					"content": "不過，店裡的貨放的時間都有些久了，如果您是用來送人的話，最好還是新做一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100208,
					"content": "請問，您的朋友是哪裡人？我來想想送什麼菜比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100209,
					"content": "來自至冬國。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "至冬國？是很遠的地方啊，那可要好好想想用什麼菜最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100213,
					"content": "唔，雖然不知道至冬國人口味如何，但是有一道菜肯定不會錯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100214,
					"content": "請您幫我做一份「滿足沙拉」來吧，然後我來幫您處理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100215,
					"content": "好久沒有做過這種加工了，我得去找找工具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100211,
					"content": "來自愚人眾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "愚，愚人眾？您是說來自至冬國的那些…您的交際可真廣泛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "莎拉"
				}
			]
		},
