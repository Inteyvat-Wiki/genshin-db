					"nextDialogs": [
						708100405
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 708100405,
					"content": "#不過，{F#妳}{M#你}要先回答我一個問題。如果答對了的話，我就送{F#妳}{M#你}一枚書籤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100406
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 708100406,
					"content": "問題很簡單。請問…「蒲公英」是不是花呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
