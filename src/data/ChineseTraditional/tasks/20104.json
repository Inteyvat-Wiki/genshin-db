			"dialogs": [
				{
					"id": 201040301,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}做什麼呀，怎麼把整個草垛都燒掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040302,
					"content": "這回不是被罵就能了事了，一定會被開除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040303,
					"content": "一不小心就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "早知道，我們還不如慢慢地一點點把落葉挑出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040305,
					"content": "完了…這下子全完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040306,
					"content": "那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "#旅行者，請{F#妳}{M#你}快點離開吧，這件事是我們的責任…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040308,
					"content": "我們不該讓不懂得打掃方法的人來幫忙，是我們錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040309,
					"content": "女僕長會怎麼處置我們呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040310,
					"content": "這下子，全都完了…",
