					"nextDialogs": [
						201040203
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040203,
					"content": "已經打掃乾淨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "太厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040205,
					"content": "不愧是旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040206,
					"content": "#這樣就不用被女僕長罵了，謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040207,
					"content": "這些請收下，就算是謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040208,
					"content": "#我們得趕緊打掃別的地方去了…再次謝謝{F#妳}{M#你}幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩可"
				}
			]
