			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040102,
					"content": "又要被女僕長罵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "愛德琳小姐本來是要我們打掃酒莊的周邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040105,
					"content": "其他的地方還好，但是，周圍還有很多堆起來的草垛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040106,
					"content": "這些是康納先生特地堆在這，說是有用處的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040107,
					"content": "雖然因為捆得很牢，暴風的時候這些草堆沒有被吹走，但是，有很多落葉被吹到了草垛裡面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040108,
					"content": "我們費了好大的力氣，也沒有把落葉從草垛裡清理乾淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040109,
					"content": "再這麼耗下去，女僕長非得罵我們不可，這可怎麼辦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040110,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "#咦？可以交給{F#妳}{M#你}嗎！太好了，那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040112,
					"content": "很難清理嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "落葉和草垛都攪一起了，我們只能用手慢慢地分開，實在是太慢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040114,
					"content": "#如果{F#妳}{M#你}有什麼好辦法，就請幫幫我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海莉"
				}
			]
		},
