			"dialogs": [
				{
					"id": 751650301,
					"content": "需要準備一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "沒問題，你準備好的話，隨時可以再來。",
					"roleType": "TALK_ROLE_NPC",
