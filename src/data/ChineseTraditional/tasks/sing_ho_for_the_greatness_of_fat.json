				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊伊馬尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "#{F#妳}{M#你}的成績很不錯嘛，但是呢，說實話…這不是我誇口，我的最佳紀錄的確在{F#妳}{M#你}之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650802,
					"content": "人嘛，總會有這麼一兩項自己做得好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650803,
					"content": "#這下{F#妳}{M#你}相信了吧，我這種體型的戰士未必不敏捷，所以飯一定要好好吃，不要胡亂減肥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊伊馬尼"
				}
			]
		},
		{
			"id": 7516509,
