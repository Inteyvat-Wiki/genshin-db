					"蘇里奎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "#哼哼，{F#妳}{M#你}的成績很不錯，但比起我來，還差那麼一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650702,
					"content": "長期保持微胖體型、但又從來沒有疏於訓練的我，論靈活性和衝擊力，絕對不是那些愚蠢的健身狂能比的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650703,
					"content": "放棄對肌肉的追求，和我一起讚美偉大的脂肪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘇里奎"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
