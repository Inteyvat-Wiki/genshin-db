				]
			},
			"dialogs": [
				{
					"id": 751650901,
					"content": "伊伊馬尼，你好像又胖了，恭喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650902,
					"content": "哈哈，謝謝你，蘇里奎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650903,
					"content": "好消息，我這幾天又勸住了一個想減肥的瘦子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650904,
					"content": "哦，很了不起啊，大好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650905,
					"content": "#欸，是{F#妳}{M#你}，怎麼樣，這幾天有好好吃飯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650906,
					"content": "吃飯很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "很好，就應該多吃飯，吃得胖胖的才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650910,
					"content": "伊伊馬尼，我跟你說，這人的擊罐紀錄很厲害，離我的最好成績就差一點點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650911,
					"content": "#{M#他}{F#她}也在我這裡接受過挑戰，成績也不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650912,
					"content": "#不錯啊，沒想到{F#妳}{M#你}這麼厲害，居然差一點就超過我們兩個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650913,
					"content": "#我覺得{M#他}{F#她}再長胖點，說不定真的能超過我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650914,
					"content": "#嗯，很有可能。雖然從我的角度來看，{F#妳}{M#你}有點太苗條了，還有長胖的空間，不過嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650915,
					"content": "#我認可{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650916,
					"content": "#我也認可{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650917,
					"content": "但我還是建議你每頓飯最好多吃點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650918,
					"content": "不要節食，不要減肥，我們會失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650908,
					"content": "吃得不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "這不好，沒有什麼事情比好好吃飯更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "蘇里奎"
				}
			]
		},
