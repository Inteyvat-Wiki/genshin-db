			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊伊馬尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "#路過的勇士，對，沒錯，就是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650402,
					"content": "唉，太瘦了…你有好好吃飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650406,
					"content": "飯都被嚮導派蒙吃了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "#不論{F#妳}{M#你}有什麼理由或者苦衷，首先，飯必須好好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650408,
					"content": "#既然{F#妳}{M#你}已經進入了特特奧坎，大概已經見過「沃陸之邦」的大力士了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650409,
					"content": "#出於良心，我要給{F#妳}{M#你}一個忠告，絕對不要相信那些一股腦鼓吹肌肉的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650410,
					"content": "神賜予我們的脂肪是寶貴的禮物，為了好看的肌肉，就戒掉所有好吃的東西，拋棄脂肪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650411,
					"content": "#這麼做就是笨到家了，林豬都會同情{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650412,
					"content": "而且要說什麼是好看，吹捧肌肉好像也就是這幾十年的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650413,
					"content": "我爺爺說，他年輕的時候，大家還是比較喜歡微胖的身材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650414,
					"content": "所以，千萬不要聽人蠱惑，走上減肥的錯誤道路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650415,
					"content": "#但如果有一天，{F#妳}{M#你}跟「沃陸之邦」裡我那些親戚們一樣，為了追求力量而選擇了減肥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650416,
					"content": "那我還有一句話：論敏捷，體型微胖的戰士也可以做到像魚一樣靈活，論力量，那些瘦傢伙根本不是我們的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650417,
					"content": "要問證據的話，這片訓練場裡的罐子就是證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650418,
					"content": "以我的體型，要做到<color=#00E1FFFF>疾速通過而不打破罐子</color>輕而易舉，這種程度的敏捷，就算是瘦子也未必做得到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650419,
					"content": "#看{F#妳}{M#你}那要笑又不好意思笑的表情…沒關係沒關係，我就知道{F#妳}{M#你}不相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650420,
					"content": "來試試吧，以你最快的速度通過這片訓練場，但注意<color=#00E1FFFF>不要打破任何罐子</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650421,
					"content": "看看你的成績有多好，是否能超過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊伊馬尼"
				},
				{
					"id": 751650404,
					"content": "哇，是要請我吃飯嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "#倒不是這個意思…要是{F#妳}{M#你}實在是肚子餓的話，我隨身帶的包裡還有點烤肉。不過這個先放到一邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "伊伊馬尼"
				}
			]
		},
