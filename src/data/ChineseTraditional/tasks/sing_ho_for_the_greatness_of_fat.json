			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘇里奎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "路過的勇士，既然會來到特特奧坎，你也是追尋力量的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650202,
					"content": "或許你已經見過「沃陸之邦」的大力士們了，哼，多數都是些滿身肌肉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650203,
					"content": "不過看你身材滿苗條的，應該還沒有變成每天瘋狂舉重臥推的健身狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650204,
					"content": "我跟你說，那些都是騙局，不要上當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650205,
					"content": "你討厭鍛煉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "也不能這麼說，但鼓吹肌肉，認為勇士的力量來自於肌肉，這肯定是胡說八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650208,
					"content": "讓我告訴你，古代英雄們的身上絕對不可能除了骨頭就是肌肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650209,
					"content": "他們的生存環境比今天惡劣得多，在實戰中更追求生存與防禦，一定會儲存適量的脂肪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650210,
					"content": "他們的體型，應該就像我這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650211,
					"content": "我這樣微胖的體型才是過去英雄們的體型，兼具衝擊力與靈活性的體型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650212,
					"content": "但部族的大家都沒有意識到這一點，唉，太愚蠢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650213,
					"content": "#看{F#妳}{M#你}的表情，好像不太相信的樣子…嗯，這樣好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650214,
					"content": "來試試看我準備的擊罐挑戰吧！這片場地原本是我為了鍛煉自己準備的，借你用用也沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650215,
					"content": "你試一試就知道，大體型在實戰中是多麼的有力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘇里奎"
				},
				{
					"id": 751650206,
					"content": "你討厭肌肉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
