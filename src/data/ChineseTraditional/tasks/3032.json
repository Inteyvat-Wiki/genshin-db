			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤田",
					"亞卡巴",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "我想好了！小說的結尾可以放在御輿長正身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320302,
					"content": "意思是，故事裡的其他人都不在了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "亞卡巴"
				},
				{
					"id": 30320303,
					"content": "是啊，聽說御輿長正一直活到壽終正寢呢，很適合當小說結尾的敘事者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320304,
					"content": "「怪異的氛圍散去了，可是未來幾十年裡，這件事仍如陰雲繚繞在御輿長正心頭。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320305,
					"content": "「年邁的他做了一個夢。名為『大踏鞴長正』之寶刀鍛成那夜，眾人歡呼雀躍，作畫、起舞、飲酒。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320306,
					"content": "「…萬般歡喜都熔在了爐火中，化作紅雲，圍抱著御輿長正一生最後所見的那片朝陽。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320307,
					"content": "「此生路遙遠，欲行已忘言。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320308,
					"content": "…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
