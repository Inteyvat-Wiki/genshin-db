				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "呼——！終於到休息時間啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320502,
					"content": "一旦放鬆下來，突然覺得好餓好累哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320503,
					"content": "派蒙好好休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "哇！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320506,
					"content": "…咦？那個瓶子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320507,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "是誰來打掃的時候碰碎了嗎？可是，沒聽說有人來收拾過房間呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320509,
					"content": "（那天晚上在住宿處，派蒙被散兵的事嚇到，一不小心撞到桌子，導致這個瓶子被打碎。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "（可是緊接著散兵就抹去了自己存在過的事，他是改變了世界吧？那這個瓶子…為什麼還是碎的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "#聽起來，{F#妳}{M#你}很迷茫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320512,
					"content": "…是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "#我明白{F#妳}{M#你}的苦惱。任何人知道這些，都會覺得頭暈腦脹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320514,
					"content": "咦？有人在我們耳邊說話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320515,
					"content": "不過很可惜，提瓦特的命運無法輕易撼動。神明尚且有微小的可能，非神之身…就難說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320516,
					"content": "小小的動物撞在樹幹上會令它搖擺，可是歪斜不等於位移，命運也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320517,
					"content": "就像瓶子落到地上，小貓打碎的也好，飛鳥打碎的也好。結果它都碎成這樣了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320518,
					"content": "妳、妳是誰啊！為什麼妳會知道這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320519,
					"content": "#歷史不會輕易被改變，但人們的心會。相信自己的眼睛，{F#妳}{M#你}所見才是真實，未見則為虛幻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "聲音消失了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320522,
					"content": "剛才那個人到底是誰啊！突然冒出來說些讓人害怕的話，什麼意思嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320523,
					"content": "（相信眼睛？她所說的…是要我堅守住自己的記憶嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "倒是那個瓶子，還碎在地上呢。我去找人來收拾一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320525,
					"content": "…總覺得就這麼放著不管，心裡有些怪怪的。那我去去就來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320526,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "（未來，還會有什麼等著我呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "買些好吃的東西獎勵妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
