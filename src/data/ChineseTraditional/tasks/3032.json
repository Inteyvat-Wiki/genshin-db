				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#歡迎回來，{NICKNAME}、派蒙、散兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320102,
					"content": "呼！感覺經歷了很長的旅途…累死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "莫非你是對這個名字感到不滿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320105,
					"content": "沒什麼。只是在想，我也該換個名字了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "你不打算叫「散兵」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "明知「博士」做了那麼多事，我怎麼可能繼續採用跟他有關的稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "我不打算也不可能回到愚人眾那邊。一定有許多人被這次的事影響，未必還能記得第六席是誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "意思是你要脫離組織了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320110,
					"content": "也算是變相逃亡吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "正如妳所說，小吉祥草王。一切看似徒勞，但並非沒有意義，至少能讓不少人忘記我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "可是那也不意味著你身上的往事就此消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320114,
					"content": "這是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "另外，你傾盡全力去追求的事，它最核心的目的…並沒有達成，這一點還請你明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320116,
					"content": "改變世界、改變過去…改變他人命運，並不是那麼容易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320117,
					"content": "你所渴望的答案是極致的毀滅…它本質是虛妄。即便世上再沒有「散兵」，世界也不會遵循你的意志而動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320118,
					"content": "…是啊。哈哈，真可笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "為這樣的結果做到這種地步…不會後悔嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320120,
					"content": "哪怕我一文不值，世上也從來沒有值得後悔的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "小吉祥草王，世界樹裡的訊息，是妳故意留在那裡的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "為了讓你盡可能自然地收獲資訊，我也費了不少心思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320123,
					"content": "為什麼不惜做到這一步？妳也想拉攏我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "必須誠實地說，過去的經歷使你成為了一個對我和須彌有用的個體。拉攏你的確是我計畫的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320125,
					"content": "但在那之前，我想把過去的真相告訴你。如果只是利用，我就與「博士」毫無分別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320126,
					"content": "…妳很聰明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "這大概是我應具有的美德吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320128,
					"content": "對他人有用就是價值。所以即使身為罪人，我也重新擁有了被利用的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "納西妲並不是那麼想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "#噢對，差點忘了…{F#妳}{M#你}們是「正義」的一方，與我不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "不好意思，我看待事物的角度略有不同。但我不會稱這一切為算計，妳的智慧註定了妳會擁有更好的幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "你能這麼想就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}，未來我還會進一步研究並挖掘世界樹裡深藏的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320134,
					"content": "#包括{F#妳}{M#你}血親被記錄在世界樹中的旅程之始。前後究竟還有什麼？我也想知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320135,
					"content": "那就拜託妳為我尋找了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "#為什麼在我跳進世界樹的資訊洪流之後，{F#妳}{M#你}就去了稻妻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "因為我想知道你改變了什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "…所以才打聽到了那些人被改變後的命運嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "#不管怎麼說，{F#妳}{M#你}幫了我的忙，這份恩情我都會盡力償還。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "…我做這些不是想要回報。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "#個體與個體之間只存在「借」和「還」的關係。我們遲早會兩清，{F#妳}{M#你}不需要在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "不是這樣的哦。人與人的關係，絕不是輕易就能撫回原狀的白紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320147,
					"content": "你一定感受過。生命中出現過的人不會像水滴蒸發一樣消失，世上不存在真正的「兩清」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320148,
					"content": "正因為有些事不能挽回也不能改變，人間才會有情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320149,
					"content": "你感受的所有東西都是真實，你欠下的事物也不會被彌補。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320150,
					"content": "背負裂痕生活下去是人的行為。你可以選擇是否成為人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "沒有缺失心臟的人類，不是嗎？再說，我早就不想成為人類了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "沒有心臟的你依然能理解痛苦。你只是封閉了感情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320154,
					"content": "過去不會被撼動，但你可以繼續走。只要未來的線夠長，總有一天「過去」會變成比例尺上很短小的一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320155,
					"content": "聽起來，妳已經想好怎麼安排我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "希望你能配合納西妲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "很多事情混在一起，都說不清楚了，反正最重要的是，你最好跟隨納西妲，否則我們為什麼要做這麼多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320158,
					"content": "#…那就讓我作為黑暗中的助力與{F#妳}{M#你}們同在吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "很高興你能接受我們的提議。為表慶祝，不如幫自己取個新名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320160,
					"content": "快快快，我也要幫你取個難聽的綽號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320161,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "因為…因為我還是不怎麼喜歡你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320163,
					"content": "哼。那以後我們最好不要經常見面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "「名字是人生第一份饋贈」——雖然你沒明說，但我知道你是這麼想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320165,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#這次{NICKNAME}和派蒙幫了你不少忙，假如你無法決定要叫什麼名字，可以問問{F#她們}{M#他們}的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30320167,
					"content": "欸？讓我們來決定嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "#不行，我只會取綽號，不會取正經名字…交給{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320144,
					"content": "請不要說得像是我在勒索你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
