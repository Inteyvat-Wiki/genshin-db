					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071001,
					"content": "#{F#妳}{M#你}是什麼人？怎麼跑到這裡來了？卸貨的人都應該在港口附近才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610711,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "我就是你們的執行官「木偶」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "欸？原、原來我們現在是要用這套說法嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071103,
					"content": "#哼，我欣賞{F#妳}{M#你}的膽識，但這種明目張膽的謊言，也未免太低估我們愚人眾了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "我是「木偶」…特聘的研究員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "特聘研究員？那位大人對機械體和月矩力的研究都已經到了登峰造極的程度，很難想像她還需要外聘研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "科學研究是建立在合作的基礎上的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "也是，我也為那位大人蒐集過不少楓丹科學院的研究報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071303,
					"content": "既然您是這方面的專家，那麼，這臺巡陸艇發生的故障，對您來說解決起來一定十分容易了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "呃…我專注於理論研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "原來是這樣，月矩力的理論研究是最艱深的學問，太了不起了！而維修巡陸艇相對來說更偏應用型，兩者的確不能混淆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071403,
					"content": "不過，「木偶」大人此刻不在這裡，您可以先去找阿扎莉婭長官，或許她會知道接下來的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "那當然，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "在巡陸艇身上叮叮噹噹敲擊了幾下，這下徹底不動了…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "好像…完全壞掉了？現在要怎麼辦啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071504,
					"content": "#哼，從剛才我就覺得{F#妳}{M#你}不對勁。真正的研究員怎麼會誇下這種海口？{F#妳}{M#你}果然是冒牌的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "可以說我就是她的老師也不為過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "喔喔！我曾經為那位大人蒐集過不少楓丹科學院的研究報告，她對莫索博士的研究成果讚不絕口——莫非您就是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071603,
					"content": "咳咳…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "沒、沒錯，原來莫索博士的名號已經傳到這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071605,
					"content": "#哼，據我所知，莫索博士三十年前就逝世了。那就請{F#妳}{M#你}也步上他的後塵吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610717,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
