			},
			"dialogs": [
				{
					"id": 761071701,
					"content": "沒打算照你們愚人眾的規則行事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "既然不肯服從規則，那就給我消失吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
