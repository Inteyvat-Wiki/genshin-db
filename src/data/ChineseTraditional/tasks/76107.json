			"dialogs": [
				{
					"id": 761071901,
					"content": "有事，想找你練練身手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "#練身手？{F#妳}{M#你}不是外聘的研究人員嗎…唔，仔細想想的話，似乎從來沒見過那位大人外聘過什麼人…哼，{F#妳}{M#你}果然是奸細，受死吧！",
