			"dialogs": [
				{
					"id": 760290101,
					"content": "#{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290102,
					"content": "咦？哥倫比婭妳要出門嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290103,
					"content": "嗯，出去修琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290104,
					"content": "…什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290105,
					"content": "有隻月靈的琴壞了，它很珍惜這把琴，我想幫它修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290106,
					"content": "月靈還真是多才多藝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290107,
					"content": "嗯，它經常在這裡彈琴，我偶爾也會和著琴聲唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290108,
					"content": "我之前就這麼覺得了，妳還真寵月靈呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290109,
					"content": "它們一直陪著我，還經常帶好玩的東西回來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290110,
					"content": "（菈烏瑪說過，這是因為月靈想讓月神開心的天性使然吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "不過我問一句，妳打算怎麼修好這把琴呀？妳不是說自己不能被別人看到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290112,
					"content": "唔…以前我會拜託小動物或者月靈，請它們把要修的東西放到工匠家門口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290113,
					"content": "工匠發現後，通常都會順手把東西修好。不過有時也會沒注意到，要等幾天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290114,
					"content": "聽起來有點迂迴呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290115,
					"content": "不如交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290117,
					"content": "放心吧，我們去的話說不定今天就能修好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290118,
					"content": "…好吧。謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290119,
					"content": "別客氣。順帶一提，妳通常放在哪個工匠的家門口呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290120,
					"content": "我不知道她名字。她家門口有隻大大的機械手，住在一棟圓圓的、像海螺一樣的房子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290121,
					"content": "（難道說是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "裡面還經常傳來蛋捲的香味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290123,
					"content": "我好像知道是誰了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
