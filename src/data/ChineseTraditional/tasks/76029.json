					]
				},
				{
					"id": 760290233,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290234,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290236,
					"content": "相似度比對中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290237,
					"content": "在和什麼比對啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290238,
					"content": "與挪德卡萊月神像的人物相似度…百分之九十五…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290239,
					"content": "是…是演員！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#偵測到{NICKNAME}的心率上升…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290243,
					"content": "修好啦！這次應該再也不會壞了，順帶一提剛才的零…伊…伊涅芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290244,
					"content": "剛才的零…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290245,
					"content": "剛才的零件也很管用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290246,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290247,
					"content": "#嗯？{F#妳}{M#你}們身後這位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290248,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290249,
					"content": "是琴的委託人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "（總覺得有點眼熟…我在哪裡見過這位姐姐嗎？不管了，這不重要。派蒙給我的零食應該藏好了吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290252,
					"content": "對…對！這些零件也是她送過來的，說是想感謝愛諾妳幫忙修琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290253,
					"content": "嗯？我看看…哇！都是些古老的稀有零件欸！真的可以收下嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290254,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290255,
					"content": "謝謝妳！以後有什麼要修的東西也可以來找我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290256,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290257,
					"content": "呃…那，那我們差不多回去了。愛諾、伊涅芙，我們改天再找妳們玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290258,
					"content": "（要快點帶「少女」離開，不然伊涅芙要認出來了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290259,
					"content": "好…好呀！那就改天見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290260,
					"content": "（要快點回去收拾一下，不然伊涅芙要發現零食屑了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290261,
					"content": "好，兩位再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290262,
					"content": "…愛諾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290263,
					"content": "怎…怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290264,
					"content": "這些零件需要供起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290265,
					"content": "啊？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290266,
					"content": "它們好像是「月神的贈物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290267,
					"content": "呃，伊涅芙妳在說什麼…我等一下幫妳檢查一下線路吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290250,
					"content": "是怕生的客戶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "有…有誤差！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "誤差範圍較小，推斷結論可靠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290216,
					"content": "那個朋友有點怕生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
