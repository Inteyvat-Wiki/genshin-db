			},
			"dialogs": [
				{
					"id": 760290201,
					"content": "愛諾！妳在家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290202,
					"content": "哇！是派蒙的聲音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290203,
					"content": "#{F#妳}{M#你}們好呀！是帶著零食來探望愛諾的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290204,
					"content": "就知道妳會這麼說，喏，來的路上就為妳準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290205,
					"content": "快給我快給我，等一下伊涅芙就要回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290206,
					"content": "那麼今天要和愛諾一起玩什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290207,
					"content": "嘿嘿…實際上，有件事情想拜託愛諾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290208,
					"content": "嗚哇！拿…拿走拿走！快把那怪東西拿走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290209,
					"content": "怪東西？是說這把琴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290210,
					"content": "說了我討厭用科學和機械原理解釋不通的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290211,
					"content": "那個琴隔三差五就會出現在我家門口，但我每次把它修好後，它又會莫名其妙地不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290212,
					"content": "我…我才不信有這種怪力亂神的東西呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290213,
					"content": "啊…看來這其中有些誤會呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290214,
					"content": "誤會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290215,
					"content": "這是一位朋友的琴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "嗯，她其實沒有惡意啦，每次悄悄拿走，也有些緣由在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290218,
					"content": "#真的嗎？{F#妳}{M#你}們沒在騙我哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290219,
					"content": "#那…那我就信{F#妳}{M#你}們，再修一次…這次就修得徹底一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290220,
					"content": "#{F#妳}{M#你}們在這裡等一下哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760290221,
					"content": "愛諾還是滿可靠的呀，只是被悄悄放東西的行為嚇到，有點可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290222,
					"content": "的確該回報她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290223,
					"content": "嗯嗯…呃啊！妳怎麼突然出現在這裡啦！這次是嚇到我們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290224,
					"content": "#給{F#妳}{M#你}們一些東西就回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290225,
					"content": "嗯？這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290226,
					"content": "是月靈收集的一些「寶物」，它想要謝謝這位工匠，覺得她會喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290227,
					"content": "哦~好多稀奇古怪的零件呢。好吧，我們收到了，待會就轉交給愛諾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290228,
					"content": "妳回去的路上也要小心哦，別被人看見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290229,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "嗯？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
