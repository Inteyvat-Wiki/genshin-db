	"talks": [
		{
			"id": 7370101,
			"completionStepIds": [
				7370101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370101",
							"2"
						],
						"stepId": 7370101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010101,
					"content": "啊呀，斯露莎看起來沒什麼精神的樣子，是訓練遇到什麼困難了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010102
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010102,
					"content": "該說是困難呢，還是困惑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010103,
					"content": "向祖爾宛說明了此前的對話內容…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737010104
					]
				},
				{
					"id": 737010104,
					"content": "原來是這樣，不過，人類記錄下來的東西與實情並不相符倒也不是什麼新鮮事了，畢竟是健忘又偏執的物種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010105
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010105,
					"content": "想來世事大都如此，旁觀者雖能縱覽全域但卻無法體察其中忽微，親歷者雖置身其中但又難免固執己見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010106
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010106,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010107,
					"content": "感覺沒發揮什麼安慰的作用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010108
					]
				},
				{
					"id": 737010108,
					"content": "#原來{F#妳}{M#你}們是希望我來說點暖心的話寬慰斯露莎嗎？別忘了，這可是她的訓練內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010109
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010109,
					"content": "遇到困難時自己想辦法解決困難，這才是訓練的目的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010110
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010110,
					"content": "好像的確是這樣沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010111,
					"content": "如果斯露莎連這點小事也做不好，那只能說她愧對花靈勇者的名號，也擔不起「雙角的花冠」的重量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010112
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010112,
					"content": "到時候，就算是仁慈如我，也只好狠下心來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010113
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010113,
					"content": "會、會沒收花冠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010114,
					"content": "懲罰的內容嘛，就等到真的失敗時再揭曉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010115
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737010115,
					"content": "嗚…斯露莎也不想頭頂一陣寒吧，之後得加倍努力才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7370106,
			"completionStepIds": [
				7370106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370106",
							"2"
						],
						"stepId": 7370106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010601,
					"content": "明明是看慣了的景色，現在卻只覺得心情複雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010602
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010602,
					"content": "呃…往好處想，這表示斯露莎比起從前有成長了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010603,
					"content": "究竟是成長還是退化而不自知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010604
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010604,
					"content": "打起精神來呀斯露莎，這樣垂頭喪氣的樣子，一點都不像妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010605,
					"content": "對了，既然來都來了，不如斯露莎跟我們講講矯論團最初的歷史？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010606,
					"content": "雖然現在是這副模樣…但是建立之初一定還是有可取之處的吧？否則祖爾宛也不會幫助他們，斯露莎也不會被他們所吸引了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010607,
					"content": "#好吧，既然{F#妳}{M#你}們想聽…不過，{F#妳}{M#你}們知道的，我的誕生是在矯論團建立之後，所以在那之前的事我也只是聽說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010608
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010608,
					"content": "據說，在一切發生以前，就有純白的一群，試圖將災難即將發生的消息傳遞出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010609,
					"content": "但只是傳遞消息，並不能阻止災厄降臨。很快，漆黑的浪潮席捲了大地，萬物眾生恐懼不已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010610,
					"content": "就像我們之前見到的風蝕沙蟲的結晶，就連那樣強壯的生靈也在最初的劫禍中罹難了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010611
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010611,
					"content": "相比之下，人類這樣柔弱的生物，就算四處逃竄也不是什麼值得苛責的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010612,
					"content": "但偏偏有些人，卻朝著災厄渦旋的正中而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010613,
					"content": "這些人就是最初的矯論團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010614,
					"content": "嗯。其中為首的正是那伽朱那，他們原本是深林之中的學者，但卻為了平息災厄的餘波而紮根此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010615,
					"content": "對了，還有個金髮的…前輩雖然對他言及不多，但是應該至少是個「有趣」的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010616,
					"content": "#唔…可惜是幾百年前的人物，不然真想讓{NICKNAME}和他見見，當面比一比誰更「有趣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010617,
						737010618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010617,
					"content": "這有什麼好比的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010619
					]
				},
				{
					"id": 737010619,
					"content": "接著，在我誕生之後，災厄的餘波也已經平息得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010620,
					"content": "所以斯露莎已經沒什麼可做的了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010621,
					"content": "唔…也不是完全無事可做，畢竟汙穢沒有完全根除的一天。只是…像神鳥「西摩格」那樣壯烈燦然的犧牲不再是必須的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010622,
					"content": "更何況在我之前，米希爾、拉沙魯這些花靈早就各司其職了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010623,
					"content": "在那伽朱那之後，前輩就漸漸不和矯論團的人類往來了，但是對方顯然還是對我們花靈十分在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010624,
					"content": "這也不奇怪，畢竟對他們來說，吾輩花靈就是頌詩的主角嘛，會有欽慕之情也是理所當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010625,
					"content": "那時我常常聽他們高聲誦讀詩篇，久而久之，神鳥獻身的景象也似乎變得越來越鮮明了。前輩說起這些時卻是輕描淡寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010626,
					"content": "聽起來像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010627,
					"content": "被人類的花言巧語給…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010628
					]
				},
				{
					"id": 737010628,
					"content": "怎麼會？我明明是被神鳥的慈愛與意志所打動才決心效法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010629,
					"content": "跟矯論團的人類交好也只是因為，他們會毫無保留地對我講述過去發生的事…當、當然，適度的讚美也不是完全沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010630
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010630,
					"content": "同樣一個故事，用誇張的講法來講會比較吸引人嘛，我也喜歡聽精彩的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010631,
					"content": "哦！不過初衷是為了記錄真實歷史的話，這樣就有大麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010632,
					"content": "對啊，無論是我還是矯論團的人類，漸漸習慣了言過其實，所以才會變成現在的樣子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010633
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010633,
					"content": "矯論團的文獻典籍裡不再只是簡單的事實紀錄，而是充滿了各種言辭的修飾與主觀的註解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010634
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010634,
					"content": "…而我也不知不覺重視聲名而勝過行動本身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010635
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010635,
					"content": "斯露莎好像想通了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010636,
					"content": "至少比來的時候看起來有精神了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010637
					]
				},
				{
					"id": 737010637,
					"content": "這不是好事嗎，嘿嘿，這下子就算是祖爾宛也不會說出要把花冠沒收這種話了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010638,
