			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"「吉法師」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "拍得真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610202,
					"content": "呶哈哈，吉法師帥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610203,
					"content": "這孩子，一點也不謙虛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610204,
					"content": "對了，派蒙。仙人有什麼法術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610205,
					"content": "仙人的力量很強的！不過要具體舉例的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610206,
					"content": "這周邊的琥珀吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "琥珀，那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610208,
					"content": "嗯！我記得是說，理水疊山真君有能生出琥珀的花，把入侵的壞東西都困在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610209,
					"content": "理理真好厲害。守護璃月，所以把壞東西困住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610210,
					"content": "好久好久以前，有很壞很壞的緒方四鬼，闖到森林裡到處打打。欺負狸子。五百藏變成公家大人的樣子，給他們吃妖狸飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610211,
					"content": "後來，和御伽大王一起，把他們丟到畫紙裡，封印了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610212,
					"content": "還有這樣的故事啊。難怪五百藏看到吉法師相片的時候，嚇得不輕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610213,
					"content": "五百藏不是仙人，不保護璃月。但五百藏保護森林，保護狸子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610214,
					"content": "不同的人，要保護不同的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610216,
					"content": "吉法師長大以後就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "所以，吉法師要努力修行，變成了不起的大妖狸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610218,
					"content": "呶！當然了。名震天下的妖狸吉法師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610219,
					"content": "很好奇五百藏沒被封印的時候的樣子呢！感覺應該很好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610220,
					"content": "啊，突然想起，之前也有盜寶團的人被琥珀定身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610221,
					"content": "我們還被當成了「仙使」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "感覺是好久以前發生的事情了呢…但好像，也沒有過多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610223,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610224,
					"content": "咳咳。我們來到璃月之後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610225,
					"content": "#「是一年一度的請仙典儀耶。哇哈哈，我{NICKNAME}應該可以吃好多好多好吃的。派蒙，我們走！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610226,
					"content": "「還有貢品！我派蒙馬上飛過去！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610228,
					"content": "別亂說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610230,
					"content": "以較為簡單的語言講述了一些在璃月的冒險經歷，\\n一直講到在珉林絕雲地方尋訪眾仙為止。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#…接下來的事情，就是我和{NICKNAME}，一起去之前那個「琉璃亭」吃飯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610232,
					"content": "理理真好厲害，留留真也好厲害！還能做出會動的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610233,
					"content": "留留真…呸，留雲借風真君好像也很喜歡美食呢！當時，做了好多菜才見到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610234,
					"content": "好貪吃哦，像派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610235,
					"content": "這點確實像派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610238,
					"content": "派蒙是仙人？派蒙好厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610239,
					"content": "嗚哇，心情好複雜。雖然被吉法師誇了，但感覺又很不是滋味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610240,
					"content": "不過，派蒙不是仙人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "派蒙"
