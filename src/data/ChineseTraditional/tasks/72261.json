			"dialogs": [
				{
					"id": 722610101,
					"content": "喂——理水疊山真君——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610102,
					"content": "喂——理理真——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610104,
					"content": "傷腦筋，仙人好像不在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610105,
					"content": "對仙人不能無禮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "派蒙，仙人是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610107,
					"content": "嗯…應該說是很特別的人，或者是動物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610108,
					"content": "就像吉法師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610109,
					"content": "不對不對！應該說，有神奇的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610110,
					"content": "也會砰砰？那，吉法師也是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610111,
					"content": "唔…仙人，是更加古老、更有威嚴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610112,
					"content": "知道了，吉法師不是仙人。五百藏是仙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610113,
					"content": "嗚哇，要怎麼解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610114,
					"content": "仙人是守護璃月的古老存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "吉法師知道了。五百藏守護的是鎮守之森，所以不是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610116,
					"content": "雖然道理不是這麼一回事，不過能撇清誤會就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610117,
					"content": "不過難得眼前有仙府，就在這裡給吉法師拍照吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610118,
					"content": "呶！吉法師乖乖站好拍照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610119,
					"content": "吉法師乖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
