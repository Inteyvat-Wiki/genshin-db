						722610412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610412,
					"content": "#嗚呶呶。謝謝{NICKNAME}，謝謝派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610413,
					"content": "還以為，吉法師又被封印了哩，很害怕。但是，能聽見派蒙在叫吉法師，所以又沒那麼害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610414,
					"content": "啊，五百藏說過，有的小狸子也曾經被封印過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610415,
					"content": "琥珀裡好可怕。都是黑色的，什麼都看不見，沒辦法說話，也不能動、不能砰砰。就像變成石頭一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610416,
					"content": "五百藏就算變成石頭，也很厲害，所以可以說話、可以看見。但還是不能動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610417,
					"content": "吉法師想幫助五百藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "嗯。然後，還幫助其他還在石頭裡的妖狸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610419,
					"content": "不過，現在我們在吉法師身邊，我們不會讓你被封印的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610422,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722610423,
					"content": "不過，吉法師要聽話，不要太調皮才行。",
