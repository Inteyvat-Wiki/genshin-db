					{
						"sceneId": 3,
						"position": [
							-1855.365,
							155.684,
							5479.971
						],
						"pointId": 330700024
					},
					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "等一下！等一下！停手！別打了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480202,
					"content": "#呼…呼…就一箱子的書，沒必要下這麼狠的手，{F#妳}{M#你}要的話，全都給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480203,
					"content": "就只有這些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "我對天發誓！我們在這裡就只挖到了這一個箱子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480206,
					"content": "除了書之外，裡面還有一些石頭和裝在瓶子裡的泥巴…石頭裡面嘛，倒是有些好看的寶石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480207,
					"content": "你們把這些寶石拿走了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "喂！把那些寶石全部還回來！那都是珍貴的地質樣本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480209,
					"content": "地質…樣本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480210,
					"content": "還回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "還！還！全都還！快快快，把東西都放進箱子裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480213,
					"content": "東西…東西都放在箱子裡了，兄弟們就先走了…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "達拉"
				},
				{
					"id": 733480214,
					"content": "賽達菲想找的東西應該都在裡面啦，我們把箱子拿回去給他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480215,
					"content": "但他居然一個人進了沙漠，還挖了這麼多地質樣本，記了這麼多筆記，真是一位了不起的學者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480211,
					"content": "我數到三。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "還有其他的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
