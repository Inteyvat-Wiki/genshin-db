			},
			"dialogs": [
				{
					"id": 733480101,
					"content": "但是…如果沒有那些樣本的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480102,
					"content": "關於普爾比魯尼一門…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "是的。我是普爾比魯尼一門現在的「訶般荼」，請問您找我有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480105,
					"content": "是關於學術問題嗎？但看您的裝束，並不像是教令院裡的學者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480106,
					"content": "關於海迪夫的舉薦信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "這是海迪夫…海迪夫學弟的親筆信？稍等，容我看一看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480108,
					"content": "嗯，看來他在層岩巨淵的研究進展得很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480109,
					"content": "…菌類調查…水生環境…古代生物化石…特殊的地質環境…樣本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480110,
					"content": "很好，很好，很好！他的學術嗅覺和考察能力還是如此優秀，果然沒令我失望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480111,
					"content": "哼…雖然不是太願意在外人面前承認，但普爾希娜門人的學術能力，還是值得信任的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480112,
					"content": "而且，海迪夫在信裡也強調了很多次您對他的巨大幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480113,
					"content": "在您的幫助下，他的研究就如同「猛虎插上了翅膀一樣順利」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480114,
					"content": "不用再重複一遍了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "是這樣嗎？咳，是我失態了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480117,
					"content": "等他回到教令院，普爾希娜一門的學術史冊上，一定又將添上光輝的一筆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480118,
					"content": "呃…還有，我們兩個師門之間的千年友誼，也一定會大大增進的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480119,
					"content": "總而言之！我同時代表普爾比魯尼和普爾希娜，再次感謝您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480120,
					"content": "對了，他在信裡還拜託我為您準備一些禮物…這沒有問題，請您稍等一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480121,
					"content": "您不會也給我一封信做報酬吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "那當然不會！您辛苦勞碌，幫助海迪夫四處考察，付您摩拉是再自然不過的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480123,
					"content": "但…請您原諒，我今天出門太過匆忙，沒有帶多少摩拉。如果您願意的話，還請在這裡稍等我一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480124,
					"content": "雖然都是很為各自門派自豪的學者…但他和海迪夫的樣子完全不一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480125,
					"content": "看起來好像…真的沒有多少錢的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480126,
					"content": "怎、怎麼會呢？我們普爾比魯尼一門可是學者世家，絕不可能有財物上的困擾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480127,
					"content": "只不過，我們將大部分的財物都投入了研究之中，在研究之外…就會略顯拮据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480128,
					"content": "但這並不妨礙我們的研究，不如說，正因為我們沒有被物欲遮蔽雙眼，所以才能將智慧的道路看得更加清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480129,
					"content": "我這就回去為您準備報酬。但在這之前，我還有一個不情之請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480130,
					"content": "我看海迪夫在信中寫道，您的身手十分矯健，戰鬥經驗也十分豐富，是一位出類拔萃的，萬中選一的精銳冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480131,
					"content": "如果！如果您願意的話，能幫我一個忙嗎？在不久之前，為了調查一處地區的地質環境，我一個人進入沙漠考察…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480132,
					"content": "因為…我沒多少錢，所以沒有雇傭護衛。我想著，如果快去快回，應該也不會有什麼風險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480133,
					"content": "但我運氣實在不好，考察結束後，在回去的路上被盜寶團襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480134,
					"content": "雖然我安全逃回了城裡，也沒有受傷，但裝著所有地質樣本和筆記的箱子卻弄丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480135,
					"content": "在商人和盜寶團的眼裡，那個箱子也許根本就不值錢…但在我眼裡！這箱子裡的東西價值連城，無可替代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480136,
					"content": "#我一時半刻找不到願意幫忙的冒險家…旅行者，能請{F#妳}{M#你}幫幫我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480137,
					"content": "我會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "太感謝了！沒有您，我都不知道如何是好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480140,
					"content": "我這就把被襲擊的地點標在地圖上，那個箱子一定就在那附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480138,
					"content": "包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "我已經聽他說過了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "請問您是普爾比魯尼的學者嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
		{
			"id": 7334802,
