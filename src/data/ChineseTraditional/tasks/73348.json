						],
						"pointId": 600100254
					}
				]
			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "#欸，{F#妳}{M#你}怎麼回來了，找到普爾比魯尼一門的人了嗎？應該沒費多大力氣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480402,
					"content": "找是找到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "#嗯？{F#妳}{M#你}怎麼一副欲言又止的樣子，{F#妳}{M#你}不會被人給為難了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480405,
					"content": "向海迪夫講述了和賽達菲有關的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "賽達菲學長啊…他可是出了名的死心眼，有時候連老師都對付不來他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480407,
					"content": "而且還拒絕所有資助，堅持自己研究，說要保持自己研究的純潔性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480408,
					"content": "這就是「金錢不能作為智慧的報酬」嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480409,
					"content": "這是他們普爾比魯尼一門學者的研究原則…哈哈，我們普爾希娜一門沒有這麼迂腐就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480410,
					"content": "唔…也不能這麼說，只是我比較有錢而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480411,
					"content": "你是怎麼賺錢的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "#{F#妳}{M#你}怎麼這麼一副懷疑的樣子？我的這些錢也是我辛苦打拼出來的啊，{F#妳}{M#你}知道做期貨交易有多麻煩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480414,
					"content": "期、期貨交易？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "做期貨交易…又要關注貨物交易量，又要關注市場動向，還要權衡投資的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480417,
					"content": "我最開始只是投一點錢玩玩，不想影響我的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480418,
					"content": "但誰知道…唉！誰知道我越賺越多，放在交易所裡的錢也越來越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480419,
					"content": "我的本職是學者啊！我想要做研究，我想要做學術！我想要的是學術成果，不是摩拉成果！我一直這麼告誡自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480420,
					"content": "但只要待在須彌城裡，我就不由自主地走進交易所，一筆又一筆地做期貨交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480421,
					"content": "我帳上的錢是越來越多，但我的學術研究一點進展都沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480422,
					"content": "所以！我才請了這麼多人，一起進入層岩巨淵裡考察。只有待在這個沒有交易所的地方，我才能安心進行學術研究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480423,
					"content": "如果研究不出成果，我…我就不從層岩巨淵裡出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480415,
					"content": "你用期貨交易來賺錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "那你為什麼這麼有錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "發生了一些事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
