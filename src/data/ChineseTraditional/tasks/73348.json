					"賽達菲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "旅行者，您回來了，請問我的箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480302,
					"content": "就在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "太好了！非常感謝您…唉，您拿著舉薦信來來訪，我卻讓您如此辛勞，真是太不好意思了…這些摩拉還請您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480305,
					"content": "你們不是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "咦？您連這句話也知道嗎？我們普爾比魯尼一門裡確實有這種訓誡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480307,
					"content": "但這句話只是用來勸誡我們，在任何時候都不能因為錢財或其他外部原因而動搖研究的原則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480308,
					"content": "畢竟，如果一個研究者將逐利作為自己的首要學術原則，那麼…他就不配做一個研究者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480309,
					"content": "但您為了幫助我辛苦奔波，理應獲得一份數量合理的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480310,
					"content": "再次感謝您的幫助，如果您以後需要我的幫助，請儘管開口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽達菲"
				},
				{
					"id": 733480311,
					"content": "「金錢不能作為智慧的報酬」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "已經拿回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
