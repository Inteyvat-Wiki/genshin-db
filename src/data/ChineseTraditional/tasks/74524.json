			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "哎呀，這不是小傢伙嗎？難道是打聽到了我今天的行程，特意來這裡見我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240402,
					"content": "神子剛去見過將軍嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "呵呵，鼻子還滿靈的。不過是為某位不愛出門的友人帶了些甜點，和時下最熱門的輕小說罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240405,
					"content": "影也開始追了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "她的說法是，想藉此瞭解稻妻民眾近來的娛樂生活和喜好變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240407,
					"content": "剛才她還和我討論了一番呢。一開始，她還只是一本正經地分析故事內容所體現出的讀者偏好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240408,
					"content": "但說著說著…就忽然很在意地問我：「所以，那個角色最後的結局究竟如何？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240409,
					"content": "呵呵，看來就算是影，也難免會被精彩的故事所吸引呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240410,
					"content": "神子剛才的表情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "#哦？所以這才是{F#妳}{M#你}今天真正的來意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240413,
					"content": "我知道了，一定是小傢伙在旅途中時常會思念我，所以想要拍些畫片留作念想，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240414,
					"content": "#那就交給{F#妳}{M#你}了，可要用心挑選角度哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 745240411,
					"content": "非常值得被記錄下來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "我聞到了一股甜味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
