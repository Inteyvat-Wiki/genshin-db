			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "#一段時間後，{F#妳}{M#你}與派蒙來到了「小小靈蕈大幻戲」的攤位前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "哼哼！滑滑彈彈軟軟嫩嫩的蕈獸真是太棒了！我還要繼續玩這個遊戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080103,
					"content": "這位是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "本小姐是昂吉安妮，蒂蕾娜進入特巡隊之前的教官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080105,
					"content": "#我和蒂蕾娜不一樣，不一樣哦！不會因為{F#妳}{M#你}們是「超天頂領隊級戰力」就對{F#妳}{M#你}們畏畏縮縮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080106,
					"content": "這個很囂張的美露莘…居然是蒂蕾娜以前的教官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080107,
					"content": "不用緊張，「黃金流星」和「白銀伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080108,
					"content": "不久前，蒂蕾娜小姐接到了別的任務，回到特巡隊的駐地去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080109,
					"content": "昂吉安妮小姐是蒂蕾娜小姐請來，代替她負責活動場地安全的專業人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080110,
					"content": "她也非常喜歡「小小靈蕈大幻戲」，和我玩得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080111,
					"content": "沒錯，無論是桌上的遊戲，還是現實裡圓圓的蕈獸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080112,
					"content": "滑滑彈彈軟軟嫩嫩，就像汐藻一樣…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080113,
					"content": "妳怎麼流口水了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "才不會吃！抱著蹭一下也沒關係吧！海妮耶都不介意我捏捏「歡騰之火」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080116,
					"content": "#那…那妳也只能捏捏「歡騰之火」！「咚咚小圓帽」只有我和{NICKNAME}才能抱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080117,
					"content": "幹嘛這麼小氣！我全都要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080118,
					"content": "#海妮耶說過，{F#妳}{M#你}們是這個遊戲的專家，那不如就和我比劃比劃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080119,
					"content": "如果我贏了，我也要揉「咚咚小圓帽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080120,
					"content": "可惡，被她看不起了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}，我們上吧，讓她見識一下「小小靈蕈大幻戲」第一代玩家的力量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080122,
					"content": "還有「月蓮盃初代冠軍」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "對對對！我們那麼多威風的外號才不是白白得來的，哪有隨便就被打敗的道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080123,
					"content": "還有「智巧勇武雙連星」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "不准吃蕈獸夥伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}