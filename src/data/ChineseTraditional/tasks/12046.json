			"dialogs": [
				{
					"id": 120460401,
					"content": "神子平時應該在這裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460402,
					"content": "小傢伙們，求籤還是訪友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460403,
					"content": "哇！什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460404,
					"content": "好久不見，宮司大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "#這語氣怎麼有點像我那個老朋友…不要客套了，看{F#妳}{M#你}們的樣子，有急事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460406,
					"content": "想打聽個人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "#我昨天的提示那麼明顯，{F#妳}{M#你}們還沒找到人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460409,
					"content": "妳昨天果然是故意那樣說的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460410,
					"content": "先別管這個。既然來求人幫忙，至少先向我說明一下情況吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460411,
					"content": "好吧，我們昨天去過那個地址，可惜沒有抓住機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460412,
					"content": "現在那個傢伙已經不在那裡露面了，據說是在避世清修，我們根本不知道去哪裡找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460413,
					"content": "唉…明明找到昨天那個地址就已經很不容易了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460414,
					"content": "如果需要的話，我們這邊也有些新的情報。那個「江村一玄齋」可能是瑞希接待過的一名客人，我記得是叫江村中彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460415,
					"content": "啊？那個傢伙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460416,
					"content": "神子知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460417,
					"content": "我讓八重堂舉辦那次讀者來信活動，本來是想找同好聊一些有趣的事情，結果這個傢伙蹦了出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460418,
					"content": "傳播煩惱的傢伙和消除煩惱的大師，也能是同一個人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460419,
					"content": "從我們之前的調查來看，的確有這種可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460420,
					"content": "#好吧，如果{F#妳}{M#你}們想找這個人，可以去這個地址試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460421,
					"content": "這個地址…這真的是住人的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460422,
					"content": "他曾經在八重堂一口氣訂購了幾十本小說，然後留了這個收貨地址，還要求貨到付款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460423,
					"content": "倉庫那邊以為是惡作劇，就拒絕了這筆訂單，結果這件事還被他在那封讀者來信中專門罵了一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460424,
					"content": "現在想想，這種性格的傢伙，還真的就只能住在那種地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460425,
					"content": "沒錯…來找神子果然沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460426,
					"content": "能幫上我那個老朋友就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460427,
					"content": "所以妳還是想幫她的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460428,
					"content": "我看得出來瑞希對秋沙錢湯這份產業的投入很大，現在秋沙錢湯遇到了困難，我作為朋友自然要關心一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460429,
					"content": "看妳昨天的樣子，我還以為妳是去吵架的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460430,
					"content": "#瑞希應該和{F#妳}{M#你}們說過，我和她之間有競爭關係吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460431,
					"content": "從同窗時期開始，她就一直這麼認為。現在我是鳴神大社的宮司，她一定也想透過秋沙錢湯證明自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460432,
					"content": "要是這種生死攸關的經營問題都必須靠我幫忙解決…我總該考慮一下老朋友的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460433,
					"content": "難得見妳這麼體貼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "#就當{F#妳}{M#你}是在誇我吧。我這個老朋友習慣了體貼別人，也總該有人來體貼她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460435,
					"content": "妳不方便的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "#小傢伙，一點就通嘛——{F#妳}{M#你}們來的時候很急，還有時間閒聊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460438,
					"content": "哦哦，我們快通知瑞希吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460436,
					"content": "我來幫她吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "請問那個「江村一玄齋」在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
