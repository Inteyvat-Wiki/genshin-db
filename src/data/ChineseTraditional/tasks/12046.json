			"dialogs": [
				{
					"id": 120460201,
					"content": "瑞希，我們來預約下次的心理診療服務了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460202,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120460203,
					"content": "真難熬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "柴葉紫"
				},
				{
					"id": 120460204,
					"content": "欸？這是怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460205,
					"content": "一覺醒來，就變成了這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 120460206,
					"content": "是很嚴重的消化不良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460207,
					"content": "啊？難道白音和阿紫昨晚吃了很多噩夢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460208,
					"content": "#不會吧？昨天登記的客人除了{NICKNAME}和派蒙，就只剩下兩個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 120460209,
					"content": "那兩個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460210,
					"content": "那兩個人的噩夢有問題，影響食夢貘消化的因素除了噩夢的數量，還有噩夢的強度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460211,
					"content": "這種強度的噩夢，根本不是正常人應該有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460212,
					"content": "嘔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120460213,
					"content": "如果不能幫她們盡快消化噩夢的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460214,
					"content": "接下來需要做什麼？我們可以幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460215,
					"content": "必須先找到那兩名客人，瞭解他們產生噩夢的原因，我才能幫助白音和阿紫消化噩夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們昨天和他們交流過，有把握找到他們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460217,
					"content": "嗯…對了，他們說還要再找「江村一玄齋」接受一次指導，今天可能還會去那個地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120460218,
					"content": "請帶我去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夢見月瑞希"
				}
			]
		},
