			"dialogs": [
				{
					"id": 790640601,
					"content": "發現可疑人士！雖然不知道你們犯了什麼法，但是現在最高戒備，走，和我們去自首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "巨人衛兵"
				},
				{
					"id": 790640602,
					"content": "你們四散逃開，卡佩喊了一句：「各憑本事！」\\n甩開守衛之後，你們在原地重新集合了，好在沒有人被抓…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "再試試看吧。",
