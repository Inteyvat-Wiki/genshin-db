					]
				},
				{
					"id": 80091117,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091118,
						80091119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80091118,
					"content": "我們在星海之間穿行，從未分開…",
