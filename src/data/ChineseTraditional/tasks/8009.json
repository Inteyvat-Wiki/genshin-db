							"800901",
							"2"
						],
						"stepId": 800901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬斯魯爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090101,
					"content": "#哦？{F#妳}{M#你}就是那位正在各個國家旅行的金髮旅者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090102
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090102,
					"content": "怎麼啦？找我們有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090103,
					"content": "#太好了，我正煩惱去哪裡找{F#妳}{M#你}。正巧我手上有封{F#妳}{M#你}的信，是個外國人郵寄的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090104
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090104,
					"content": "那傢伙鑽了我們郵寄系統的漏洞，拿到了「信必送達」的承諾後，填了個極度模糊的地址。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090105
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090105,
					"content": "想寄信給我們還的確滿難的，畢竟我們一直四處晃蕩，除非是我們自己去信箱裡翻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090106,
					"content": "所以那個人填的地址究竟是哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090107,
					"content": "呃…他寫的是「一隻白髮會說話的小精靈旁邊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090108
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090108,
					"content": "什麼！是我嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090109,
					"content": "唉，就是說啊，而且我們如果送不到信的話，按照條例還要賠錢給他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090110
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090110,
					"content": "#真的是被那位先生給算計了，不過好在運氣站在我這邊，能跟{F#妳}{M#你}們這樣偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090111,
						80090112
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090111,
					"content": "那就把信給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				},
				{
					"id": 80090113,
					"content": "好好好，快請拿去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090114
					],
					"speakerTitle": "馬斯魯爾"
				},
				{
					"id": 80090114,
					"content": "讓我也看看，到底是誰的來信呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090115,
					"content": "凱亞！原來是他到須彌來了呀…唔，我就覺得「詭計多端的外國先生」很有可能是他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090116,
						80090117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090116,
					"content": "的確不是很意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090118,
					"content": "從信的內容來看，他也不怎麼指望這封信可以寄到呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090119,
					"content": "哦，倒不如說他的意思是，如果這封信真的寄到了，那就是命運的安排，我們就不好意思不去找他了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090120,
						80090121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090120,
					"content": "信裡信外都是算計…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090122,
					"content": "好吧，見見老朋友總歸是件令人開心的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090123,
					"content": "信裡說的是他每天下午會在迪亞法餐廳，那我們就找個下午的時間過去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090121,
					"content": "也好，本來就想去見見他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090117,
					"content": "應該說不愧是凱亞嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090112,
					"content": "把信給我看看，我很好奇那個人是誰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				}
			]
		},
