			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090301,
					"content": "…老闆，再來一杯我沒喝過的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090302
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090302,
					"content": "呃…先生，我這個店裡的酒，您早就喝遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090303
					],
					"speakerTitle": "艾依曼"
				},
				{
					"id": 80090303,
					"content": "是嗎？好吧好吧，今天就先這樣吧，剛好我等等還有事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090304
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090304,
					"content": "凱亞！你果然在這裡，我還擔心你會不會耍我們呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090305,
					"content": "#喲，派蒙、{NICKNAME}，看來神明還是眷顧我的嘛。我這麼想見{F#妳}{M#你}們，怎麼可能耍{F#妳}{M#你}們呢，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090306,
						80090307
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090306,
					"content": "這句我就當是真的好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090308
					]
				},
				{
					"id": 80090308,
					"content": "話說你不是出差嗎？天天下午泡在酒館裡，不怕回去被琴團長教訓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090309,
					"content": "呵呵呵…我那麼害怕琴團長，怎麼敢做出令她不開心的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090310,
						80090311
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090310,
					"content": "我怎麼沒看出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090312
					]
				},
				{
					"id": 80090312,
					"content": "其實我這趟來須彌，就是來考察須彌酒業的。我泡在迪亞法餐廳，做的可是正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090313
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090313,
					"content": "人們都知道，須彌的香料很有名氣，而在之前的傳聞中，這裡發明了一種加入香辛料的雞尾酒，廣受好評。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090314
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090314,
					"content": "所以騎士團派了我這個對酒品味最好的人來，嚐嚐是否有傳聞中那樣驚豔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090315
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090315,
					"content": "那麼結果如何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090316,
					"content": "結果…我已經在跟奧摩斯港的幾位香料商人談合作的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090317
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090317,
					"content": "唔，聽起來是不錯的商業機會，晨曦酒莊和迪盧克老爺或許也可以藉機大賺一筆了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090318,
					"content": "這個嘛…這筆買賣最終能不能落在晨曦酒莊的頭上，還要看我的心情，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090319
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090319,
					"content": "喂！公報私仇是不允許的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090320,
					"content": "凱亞以前來過須彌嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090321
					]
				},
				{
					"id": 80090321,
					"content": "哦？怎麼突然問這種問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090322
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090322,
					"content": "看你獨自來考察，可能很熟悉這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090323
					]
				},
				{
					"id": 80090323,
					"content": "真是敏銳啊。熟悉…倒還談不上，只是在我很小的時候偷偷來過一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090324
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090325
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090325,
					"content": "嗯？然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090326,
					"content": "#唔…我還有必要講下去嗎？雖說是找{F#妳}{M#你}們來「敘舊」，但這只是我一個人的「舊事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090327,
						80090328
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090327,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090329
					]
				},
				{
					"id": 80090329,
					"content": "#好吧，既然{F#妳}{M#你}們有興趣聽…那時的我年紀還非常小，剛被晨曦酒莊收養不久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090330
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090330,
					"content": "在一次義父的商業洽談中，我偷聽到了他們要派商隊前往須彌的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090331
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090331,
					"content": "#{F#妳}{M#你}知道的，所有人都不可能不對自己血脈中的故鄉感興趣。而我的故鄉…坎瑞亞，據說曾存在於須彌附近的地底深處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090332
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090332,
					"content": "坎瑞亞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090333
					]
				},
				{
					"id": 80090333,
					"content": "於是我偷偷潛伏進貨物裡，隨商隊一起來到了須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090334
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090334,
					"content": "不過很快，我失蹤的消息便從酒莊傳到了我在的商隊，負責人將我搜出來以後，義父親手把我揪了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090335
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090335,
					"content": "真是抱歉，不是什麼驚心動魄的故事，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090336
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090336,
					"content": "說起來…你對坎瑞亞瞭解多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090337
					]
				},
				{
					"id": 80090337,
					"content": "實話實說，瞭解得並不多。就連坎瑞亞離須彌很近這樣的情報，都是年幼的我自己查閱資料獲知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090338
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090338,
					"content": "不過隨著年齡的增長，我的生活也跟坎瑞亞再沒有了交集，漸漸地對坎瑞亞也沒那麼在意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090339
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090339,
					"content": "曾經我總覺得，我或許是從親生父親那裡繼承了某種「責任」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090340
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090340,
					"content": "但後來又想，父親之所以將我放在蒙德這樣自由和平的城邦，可能真的只是希望我好好活下去而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090341
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090341,
					"content": "讓我隔絕於「某些事物」之外，當然，如果能活得快樂就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090342
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090342,
					"content": "#…這些都只是我的想法，總而言之，沒辦法向{F#妳}{M#你}提供什麼有效的情報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090343
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090343,
					"content": "我現在能談得上與坎瑞亞還有關聯的東西，恐怕只有「亞爾伯里奇」這一個姓氏而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090344
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090344,
					"content": "…老闆，一杯「午後之死」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090345
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090345,
					"content": "……？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090346
					]
				},
				{
					"id": 80090346,
					"content": "不知這位先生是否清楚…「亞爾伯里奇」意味著什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090347
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090347,
					"content": "戴因…戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090348,
					"content": "…終於不只是在一旁偷聽，而是願意賞光加入我們了嗎？我似乎在蒙德就見過你，戴因斯雷布…是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090349
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090349,
					"content": "既然你對我有印象，那我們也算舊識了，凱亞·亞爾伯里奇先生…深淵教團創始者的後人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090350
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090350,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090351
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090351,
					"content": "深淵教團…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090352
					]
				},
				{
					"id": 80090352,
					"content": "居然！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090353,
					"content": "你之前應該不清楚這件事吧，凱亞先生？不然也不會這麼坦然地公開提起這個姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090354
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090354,
					"content": "哎呀哎呀，這個姓氏原來這麼「麻煩」，也算驗證了我之前的猜想，這就是父親把我留在蒙德的原因嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090355
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090355,
					"content": "沒想到你這麼容易就接受了，而且沒有絲毫懷疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090356
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090356,
					"content": "可能這個說法剛好解釋了我記憶中的一些疑問吧，而且…我認得出你的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090357
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090357,
					"content": "你是血統最純正的坎瑞亞人，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090358
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090358,
					"content": "聰明的傢伙，恕我直言，我只願你保守本心，別違背了你剛才對旅行者說過的那些話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090359
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090359,
					"content": "凱亞…你應該不會和深淵教團的人有什麼牽連吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090360,
					"content": "喂，我們的話題是不是突然間有些太過嚴肅了，我一個蒙德人可不習慣這種氛圍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090361
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090361,
					"content": "#知道了血脈的來源又怎麼樣？{NICKNAME}，我像是那種會被血脈這種事束縛住的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090362
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090362,
					"content": "放心好了，跟以前一樣，但凡有機會，我都會很樂意教訓那些深淵教團的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090363,
						80090364
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090363,
					"content": "我相信你，凱亞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090365
					]
				},
				{
					"id": 80090365,
					"content": "我看時間也差不多了，我還約了個香料商人談合作的事，你們先聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090366
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090366,
					"content": "這樣呀…那你去忙吧，凱亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090367,
					"content": "嗯，幾位之後見。還有戴因斯雷布先生，下次來酒館我可以請客，不用只是站在一旁聽人聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090368
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 80090368,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090369
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090369,
					"content": "你還是不相信凱亞嗎，戴因…你們兩個同為坎瑞亞人，但反而有些水火不容的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090370,
					"content": "我對他這個人的確還不瞭解，妄下定論也沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090371
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090371,
					"content": "血脈…真的能夠對人毫無影響嗎？我只是對此持懷疑態度而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090372,
						80090373
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090372,
					"content": "話說，亞爾伯里奇創立了深淵教團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090374
					]
				},
				{
					"id": 80090374,
					"content": "#{F#妳}{M#你}的血親被深淵教團稱為{M#公主}{F#王子}，正是因為這是種「繼承」關係吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090375
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090375,
					"content": "唔，不然的話，就應該叫深淵教團的「王」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090376
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090376,
					"content": "你這次來須彌有什麼打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090377
					]
				},
				{
					"id": 80090377,
					"content": "#追查「命運的織機」。{F#妳}{M#你}還記得這個名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090378
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090378,
					"content": "當然，就是在蒙德的時候，我們發現的深淵教團的計畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090379
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090379,
					"content": "有什麼新的線索？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090380
					]
				},
				{
					"id": 80090380,
					"content": "不能說是新線索，只是…我一直無奈於記憶的磨損，而在之前的養傷期間，偶然回想起了些事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090381
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090381,
					"content": "#當初和{F#妳}{M#你}的血親一起旅行的時候，{M#她}{F#他}曾提起過這個詞…「命運的織機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090382,
						80090383
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090382,
					"content": "那麼早？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090384
					]
				},
				{
					"id": 80090384,
					"content": "嗯，記憶對上的時候，我也有些驚訝。印象裡，正是當初我們一起旅行至須彌時候的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090385
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090385,
					"content": "#所以戴因就準備去當年{M#她}{F#他}提起的地方調查了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090386
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090386,
					"content": "沒錯，這個「概念」的出現，總歸應該有某種契機…沒記錯的話，是在須彌道成林的某處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090387
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090387,
					"content": "那我們趕緊過去吧，說不定有埋藏了幾百年的秘密在等著我們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090388
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090388,
					"content": "現在還不是時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090389,
						80090390
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090389,
					"content": "是擔心深淵教團嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090391
					]
				},
				{
					"id": 80090391,
					"content": "不，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090392
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090392,
					"content": "我點的酒還沒上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090393
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80090393,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090394
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80090394,
					"content": "等戴因喝完了酒，一行人準備出發前往道成林…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 80090390,
					"content": "需要等待什麼時機？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090391
					]
				},
				{
					"id": 80090383,
					"content": "幾百年前就存在了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090384
					]
				},
				{
					"id": 80090373,
					"content": "我還以為我的血親是創立者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090374
					]
				},
				{
					"id": 80090364,
					"content": "或許…吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090365
					]
				},
				{
					"id": 80090328,
					"content": "只是隨便聊聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090329
					]
				},
				{
					"id": 80090311,
					"content": "真的有你怕的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090312
					]
				},
				{
					"id": 80090307,
					"content": "我們也很想見你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090308
					]
				}
			]
		},
