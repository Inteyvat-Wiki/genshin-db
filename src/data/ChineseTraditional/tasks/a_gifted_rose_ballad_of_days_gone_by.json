			"dialogs": [
				{
					"id": 732030619,
					"content": "阿如村的生活怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "還算可以。有飯吃，有地方住，基本生活能得到保證就已經很不錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030621,
					"content": "畢竟是被驅逐到這裡來的人，我當然不能奢求藏書和研究器材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030622,
					"content": "而且從以前開始，這個村子就是教令院放逐學者的地方，生存條件和研究條件都無法和須彌城相比，自然也不會有什麼學術氛圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030623,
					"content": "我不是第一個流放者，可能也不會是最後一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030624,
					"content": "來都來了，習慣就好。只能這麼想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "賽芭"
