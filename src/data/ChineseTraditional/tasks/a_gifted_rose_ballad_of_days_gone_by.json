				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "「薔薇啊薔薇，實現我的願望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070502,
					"content": "「花從石頭中綻放，金薔薇對我歌唱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070503,
					"content": "「它唱：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070504,
					"content": "「沒有土地承載我，唯有歌謠承載我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070505,
					"content": "「歌謠戰勝敵視我的命運，戰勝我的結局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070506,
					"content": "「戰勝我戰勝時間，戰勝永不消逝的消逝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070507,
					"content": "這就是沙法卡特叔叔以前教給我們的歌謠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
