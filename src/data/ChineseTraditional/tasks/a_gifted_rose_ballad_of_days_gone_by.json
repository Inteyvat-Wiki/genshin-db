					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060402,
					"content": "關於阿凡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "嗯？什麼樣的問題呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732060404,
					"content": "把阿凡遇到的困難告訴了賽芭。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "#原來如此，所以{F#妳}{M#你}來向我求援了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732060406,
					"content": "#雖然在這種時候{F#妳}{M#你}能想起我，對我來說是很榮幸的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732060407,
					"content": "不過我畢竟不是專攻物種培育的學者，我的經驗也很有限，不能保證一定幫上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732060408,
					"content": "#但我會努力試試的，更何況{F#妳}{M#你}說的那位培育出新品種薔薇的先生也讓人很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732060409,
					"content": "等我有空的時候就會去阿凡老先生的苗圃，之後去那裡找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "沙法卡特叔叔，你最後的一點心願我沒辦法替完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060602,
					"content": "沙法卡特是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "#{F#妳}{M#你}們之前不是還纏著我問鬼老頭的事嗎？其實鬼老頭原來也不叫鬼老頭，畢竟哪有人真名就叫這個的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060604,
					"content": "聽我的長輩說，他原來叫沙法卡特，年輕的時候就從須彌城離開，到了我們村。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060605,
					"content": "他來之後蓋了這間小屋一個人住，後來幾十年裡幾乎都沒離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060606,
					"content": "我是沒見過他年輕時候的樣子，不過據說他那個時候還不怎麼討厭小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060607,
					"content": "他家的屋前屋後又種了很多花和樹，很多孩子都喜歡往他那裡跑，跟他要棗椰吃，聽他說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060608,
					"content": "但我見到他的時候，他已經老了，被人叫作鬼老頭，變得討厭小孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060621,
					"content": "一定還有辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "還能有什麼辦法呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060623,
					"content": "沙法卡特叔叔…也就是鬼老頭，早就安安靜靜地離開了，要不是這樣，我還能去問一問這薔薇有什麼栽種的特殊方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060624,
					"content": "現在我還能去問誰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060625,
					"content": "我認識一位生論派的學者賽芭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "#哦，{F#妳}{M#你}是說那個外來的小姐啊。她能幫上忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060627,
					"content": "再說，她之前路過我這裡，被我說了幾句給罵跑了。她還會願意幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060628,
					"content": "我會試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "#{F#妳}{M#你}是個很好的孩子，如果找不到能幫忙的人也沒關係，有{F#妳}{M#你}這些心意就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060609,
					"content": "為什麼執著於種花呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "我們村裡，時不時就會有些外來的人迫不得己，在這裡定居。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060611,
					"content": "有的人哪怕一直勉強自己，都始終不能習慣這裡的生活，最後孤獨一輩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060612,
					"content": "可能鬼老頭…也就是沙法卡特叔叔，算其中之一吧，長期以來，大家都習慣這種事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060613,
					"content": "但不管多少年，我還是不願意習慣這種事。他實在是太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060614,
					"content": "#他那座小花園{F#妳}{M#你}要是看到也會喜歡的，各種顏色的花，還有高高低低的樹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060615,
					"content": "打理出這麼一座小花園的人就那麼無聲無息的不在了，關於他，大家只記得鬼老頭會抓走調皮的小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060616,
					"content": "我就是不樂意接受這種事，他留下的手記裡寫了他想讓這些薔薇到處長，我就是想實現他的心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060617,
					"content": "反正我這一把年紀，別人怎麼看我都無所謂，能做好這件事我就算沒有白活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060618,
					"content": "屋子我給他收拾好了，他留下來的一大堆小冊子我也分類整理好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060619,
					"content": "#{F#妳}{M#你}感興趣的話，我可以拿一冊出來讓{F#妳}{M#你}看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060620,
					"content": "我就放在<color=#00E1FFFF>屋前</color>吧，讓這手記裡的他也見見太陽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "#{F#妳}{M#你}們來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070102,
					"content": "#這位就是{F#妳}{M#你}們找來幫忙的人吧，我前幾天才剛對她說了難聽的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070103,
					"content": "我真是…唉，老糊塗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070104,
					"content": "我們現在不是在友好地談天嘛，老先生你就別放在心上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070105,
					"content": "種子發芽了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "很遺憾，我和阿凡老先生都看過了，種子依舊沒有發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070107,
					"content": "據我觀察，這些種子的外部出現了礦石化的現象，之所以會如此，有兩種可能原因：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070108,
					"content": "第一，經過長時間的自然風化，它們失去了生物的活性，正在向化石形態轉變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070109,
					"content": "這種情況下，種子當然是無法發芽的。不過，這種假設成立的可能性較小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070110,
					"content": "出現化石化現象所需的時間相當長，這些種子不能滿足這個時間條件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070111,
					"content": "第二，這個品種本身具有岩元素親和力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070112,
					"content": "它們在種子階段富集了足夠的岩元素，在種子外部生成了一層石殼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070113,
					"content": "上述假設成立的話，這就是種子能夠長時間保存的基本原理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070114,
					"content": "我…我不是很明白，賽芭小姐是在說種子都變成了石頭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732070115,
					"content": "石頭啊，果然還是沒希望了，石頭開不出金薔薇啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070116,
					"content": "金薔薇？那個歌謠裡的金薔薇嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070117,
					"content": "#哦，{F#妳}{M#你}們應該都還不知道吧，村子裡流傳的薔薇歌謠，最初就是沙法卡特叔叔編出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070118,
					"content": "他把自己編的歌謠教給了我的上一輩，他們又把它教給自己的孩子們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070119,
					"content": "我這輩就已經有人不知道這事了，等我這一輩人也不在了，就沒人記得他了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070120,
					"content": "「薔薇啊薔薇，實現我的願望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070121,
					"content": "「花從石頭中綻放，金薔薇對我歌唱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070122,
					"content": "對啊…我們可以讓石頭開花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070123,
					"content": "賽芭想到了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "就像歌謠裡暗示的那樣，或許打破了石質外殼，就能讓種子從石頭中發出芽來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070125,
					"content": "一般來說，栽種植物都需要創造一個理想條件喚醒種子，讓它們自己突破種殼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070126,
					"content": "但既然這個薔薇品種的種子外殼過於堅硬，種芽難以自行突破種殼，我們可以試著從外面幫一幫它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070127,
					"content": "阿凡老先生，你看可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070128,
					"content": "這是要用暴力方法弄碎種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070129,
					"content": "當然不能把種子完全打碎，我們得讓一個靈巧的人去做這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}，可以拜託{F#妳}{M#你}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070131,
					"content": "果然是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "過程中一定得小心，先用<color=#00E1FFFF>鈍擊</color>打破種殼，再用<color=#00E1FFFF>草元素</color>的力量「喚醒」種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070132,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡",
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "靜靜等待了片刻之後，幼芽慢慢從土裡冒了出來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "賽芭的方法真的有效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732070302,
					"content": "終於發芽了，終於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070303,
					"content": "看來，那位沙法卡特先生生前許下的心願能夠被實現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070304,
					"content": "阿凡老先生，你之前告訴我，這種薔薇是由他培育出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070305,
					"content": "能培育出新品種，他和我一樣，也是被驅逐到這裡的學者對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070306,
					"content": "…是的。他被流放到了這個村子，在我們身後的屋子裡度過了一生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070307,
					"content": "是這樣啊，的確，既然成為了流放者，最後的結局都會如此吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070308,
					"content": "說起來，培育新品種是只有頂尖學者才辦得到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070309,
					"content": "他這樣的人，就這麼籍籍無名地消失在教令院之外的地方，真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070310,
					"content": "賽芭是想到了自己的將來嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732070311,
					"content": "請振作起來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "是啊，孩子，妳還有很長的路要走，還有很多事可以做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070313,
					"content": "不要被感傷困住，我可不想看到第二個鬼老頭出現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070317,
					"content": "說的也是，我怎麼在這種開心的時候傷感起來了，我們說正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070318,
					"content": "#現在這些金薔薇還只是發了芽，還沒有開花。我想一直見證到金薔薇盛開，{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070319,
					"content": "我也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "那我們多等點時間，讓它們汲取一點養分，過一段時間再一起來見證它們盛開吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732070314,
					"content": "（不知道該如何勸慰賽芭…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "別難過，妳看，到最後他還是留下了金薔薇給我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070316,
					"content": "它們還能證明沙法卡特叔叔來過這個世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "阿凡"
				}
			]
		},
