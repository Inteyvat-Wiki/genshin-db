				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "#多讓人懷念的花，給{F#妳}{M#你}的禮物我也準備好了，{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900202,
					"content": "#都是無法在這裡生長發芽的植物種子，如果{F#妳}{M#你}在別處有宅院的話，就能看它們長大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900203,
					"content": "#{F#妳}{M#你}看我，一下說了好多話，好暢快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900204,
					"content": "#{F#妳}{M#你}來之前，我在這裡沒什麼朋友，其實有些寂寞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900207,
					"content": "整個村子裡，有閒心種花的人很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900208,
					"content": "嗯…這樣說不準確，村子北面，也有位老爺爺開墾出了一片苗圃，拿來種花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900209,
					"content": "我去看望過他，是個有點奇怪的老人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900210,
					"content": "種下的明明是「石頭」，卻非說自己在種花，還把我趕走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900211,
					"content": "一個人生活也有點寂寞吧，我能理解那種心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900212,
					"content": "#{F#妳}{M#你}能幫我的須彌薔薇開花，說不定也能幫幫他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732900213,
					"content": "#如果有機會的話，{F#妳}{M#你}和派蒙也可以去看看他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		}
	]
