					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030602,
					"content": "這是我採到的須彌薔薇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "#多讓人懷念的花，給{F#妳}{M#你}的禮物我也準備好了，{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030604,
					"content": "#都是無法在這裡生長發芽的植物種子，如果{F#妳}{M#你}在別處有宅院的話，就能看它們長大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "來找我聊天了嗎？我可是憋了一肚子的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "妳是哪個學派的學者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "想聊聊我的學派？我能說上三天三夜都停不下來，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030607,
					"content": "我以前屬於生論派，專攻植物演化，算是一門實證研究學科吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030608,
					"content": "#這意味著沒有新素材就很難發現新結論，{F#妳}{M#你}可以簡單理解成：要考察過去的植物，歷史標本是研究基礎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030609,
					"content": "但是便於搜集的標本就那麼多，它們基本上都被搜羅得差不多了，教令院能提供的新標本有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030610,
					"content": "客觀條件就是這樣，但院內還是不斷在要求研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030611,
					"content": "#有人就把以前的研究成果拿出來，改一改湊一湊，也算完成了。{F#妳}{M#你}肯定也覺得這樣很沒意思對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030612,
					"content": "其實我們完全可以嘗試從歷史地理的角度，找一找新素材，這樣一定能有新發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030613,
					"content": "一些不受生論派重視的文學資料也是可以利用的。不過這樣的話，難免要涉及因論派和知論派的領域了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030614,
					"content": "我並不具備那些領域的知識，申請相關「知識」的手續又太麻煩，和相關領域的學者合作更是難上加難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030615,
					"content": "但是我相信，如果我們能做到跨學科合作的話，過去的很多問題就可以得到突破性進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030616,
					"content": "只是可惜這樣的嘗試無法進行下去，因論派和知論派的怪人們討論事情的角度特別…嗯…奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030617,
					"content": "我交給他們的提案裡，所有的措辭都得仔細斟酌，要不然就會出現誤會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030618,
					"content": "被趕出教令院之前，我還在跟一個知論派的傢伙吵架。現在好了，想找他們吵架也難了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030625,
					"content": "#{F#妳}{M#你}看我，一下說了好多話，好暢快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030626,
					"content": "#{F#妳}{M#你}來之前，我在這裡沒什麼朋友，其實有些寂寞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030629,
					"content": "整個村子裡，有閒心種花的人很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030630,
					"content": "嗯…這樣說不準確，村子北面，也有位老爺爺開墾出了一片苗圃，拿來種花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030631,
					"content": "我去看望過他，是個有點奇怪的老人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030632,
					"content": "種下的明明是「石頭」，卻非說自己在種花，還把我趕走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030633,
					"content": "一個人生活也有點寂寞吧，我能理解那種心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030634,
					"content": "#{F#妳}{M#你}能幫我的須彌薔薇開花，說不定也能幫幫他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732030635,
					"content": "#如果有機會的話，{F#妳}{M#你}和派蒙也可以去看看他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		},
