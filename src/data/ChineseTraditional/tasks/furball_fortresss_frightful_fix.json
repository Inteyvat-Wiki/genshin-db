					}
				]
			},
			"dialogs": [
				{
					"id": 705390101,
					"content": "咦，瑪格麗特老闆好像在和那兩個人說什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390102,
					"content": "等等，是蘿莎莉亞？她身邊有個不認識的冒險家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390103,
						705390104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390103,
					"content": "蘿莎莉亞也來和貓貓玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390105
					]
				},
				{
					"id": 705390105,
					"content": "嗯，不用多說了，瓦樂瑞娜。我會按照維多利亞的要求，繼續為妳提供幫助的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390106
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390106,
					"content": "給貓看個病，洗個澡，都是小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390107
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390107,
					"content": "關鍵的問題還沒解決吧，蘿莎莉亞小姐！要是我們兩個和貓貓再不拉近一點距離，讓牠們一直緊張兮兮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390108
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390108,
					"content": "貓貓們肯定會得病的，「貓茸茸城堡」開不了幾天就要垮掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390109
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390109,
					"content": "我勸妳少擔心，少慌張，都沒用的。處不來是客觀事實，我不能給妳變出辦法來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390110
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390110,
					"content": "蘿莎莉亞，還有這位冒險家小姐，妳們好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390111,
					"content": "聽起來，妳們好像在為什麼事情煩惱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390112,
					"content": "#貓貓救星！{F#妳}{M#你}們這麼快就出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390113
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390113,
					"content": "欸…一見面就叫我們救星，好突然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390114,
						705390115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390114,
					"content": "有敬稱，就有對應的責任！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390116
					]
				},
				{
					"id": 705390116,
					"content": "長話短說！我叫瓦樂瑞娜，很喜歡小動物，最近正在全力建立專門的流浪貓收養所「貓茸茸城堡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390117
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390117,
					"content": "我認為，收養無家可歸的小傢伙們，既能將牠們從不幸的命運中拯救出來，又能改善蒙德的生態和市容問題，一舉兩得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390118
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390118,
					"content": "教會的修女們聽說了我的諮詢後，派出了好心的蘿莎莉亞小姐支援我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390119
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390119,
					"content": "不是好心，只是受維多利亞所託。誰讓最近略懂醫術、又有空閒的修女只剩我了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390120
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390120,
					"content": "好幹練的冒險家，思緒清晰，概括能力也很強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390121,
					"content": "那妳們遇到的麻煩是…摩拉不夠嗎？還是缺什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390122,
					"content": "我很有錢！摩拉、場地、相關物資和規章流程的問題，統統都搞定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390123
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390123,
					"content": "現在的主要問題是…噫噫呃呃…貓貓總是打我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390124
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390124,
					"content": "不管我用什麼姿勢接近牠們，牠們都會凶我…拿著好吃的都不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390125
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390125,
					"content": "貓也很怕我，我站在附近，牠們就會逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390126
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390126,
					"content": "呃啊，好像聽說過這樣的傳聞，有些人的體質生來就會讓貓繞著走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390127,
					"content": "不過，收養貓貓的好心人，卻和貓貓不合拍…別說管理收養所了，就算去貓尾酒館，也會手忙腳亂吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390128,
					"content": "所以我們才諮詢了這方面的專家，可是瑪格麗特小姐自己也概括不了訣竅，她店裡的人手又不多，幫不了我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390129
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390129,
					"content": "瑪格麗特小姐說，「遇到這種難題，只要拜託榮譽騎士和白色小幫手，肯定沒錯！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390130
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390130,
					"content": "#結果我們剛剛聊完，{F#妳}{M#你}們就出現了，簡直就像巴巴托斯大人派來的使者，正宗的救星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390131
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390131,
					"content": "先不說巴巴托斯懂不懂照顧貓啦，我們也沒有管理收養所的經驗，結果突然就變成救星了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390132,
						705390133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390132,
					"content": "這個稱號不是來得正好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390134
					]
				},
				{
					"id": 705390134,
					"content": "這倒沒錯！單論和貓貓搞好關係，我倒是很有信心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390135,
					"content": "感覺這個問題並不難辦嘛，只要向瓦樂瑞娜和蘿莎莉亞演示怎麼和貓貓搞好關係，就不用擔心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390136,
					"content": "#我倒是沒什麼所謂，{F#妳}{M#你}們多教教瓦樂瑞娜吧，遇到需要救治小傢伙的情況再叫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390137
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390137,
					"content": "#總之，{F#妳}{M#你}們能讓收養所穩定營運下去，不需要我費什麼力的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390138
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390138,
					"content": "我不介意繼續幹這份清閒的差事，起碼比教會的其他活動省心多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390139
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705390139,
					"content": "欸，原來只是想翹掉教會的班而已嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390140,
					"content": "那就先請兩位這邊走，我們現在就去「貓茸茸城堡」看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705390133,
					"content": "我們本來就想和貓貓玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390134
					]
				},
				{
					"id": 705390115,
					"content": "這種時候，肯定會有委託！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390116
					]
				},
				{
					"id": 705390104,
					"content": "蘿莎莉亞也來酒館打牌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705390105
					]
				}
			]
		},
