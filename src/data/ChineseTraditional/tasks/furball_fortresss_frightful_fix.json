						705390232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390232,
					"content": "耐心地和貓貓相處，不斷加深對貓貓的瞭解，一定能夠和牠們成為好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705390233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705390233,
					"content": "我完全明白了！現在就是「貓茸茸城堡」的試營業階段，我會好好觀察，認真學習！",
					"roleType": "TALK_ROLE_NPC",
