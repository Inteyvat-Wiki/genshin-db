			"dialogs": [
				{
					"id": 111010201,
					"content": "就要這一本嗎，《護法仙眾夜叉錄》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 111010202,
					"content": "嗯，這些給妳，不用找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010203,
					"content": "老闆闊氣，闊氣…謝謝惠顧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 111010204,
					"content": "這不是那位「多星缺辰天君」嗎？怎麼又在這裡碰到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010205,
					"content": "是「掇星攫辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "我好像聽到他剛才買的書叫…《護法仙眾夜叉錄》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010208,
					"content": "記得好像是一本關於仙人的書來著，仙人為什麼會買有關自己的書呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010209,
					"content": "我早就覺得他有些可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "#欸，是這樣嗎？{F#妳}{M#你}覺得哪裡可疑啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010214,
					"content": "仙人要那麼多錢做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "啊…說得也是，一般的仙人好像都是一臉無欲無求的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010220,
					"content": "唔……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010221,
					"content": "看起來有必要確認一下書的內容了，說不定可以抓住什麼把柄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010216,
					"content": "感覺像是江湖騙子的套路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "#{F#妳}{M#你}的意思是…其實他沒有實現願望的能力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010218,
					"content": "他的面具太醜了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "啊！確實很醜！太可疑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010211,
					"content": "是自戀吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "這麼說也有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010213,
					"content": "不過仔細想想，這個仙人總覺得有些不對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010206,
					"content": "這就是「仙緣」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
