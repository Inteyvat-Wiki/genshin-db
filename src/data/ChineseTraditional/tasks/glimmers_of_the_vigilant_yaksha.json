			},
			"dialogs": [
				{
					"id": 111010701,
					"content": "怎麼會的…「百無禁忌籙」怎麼會沒有效果呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010702,
					"content": "這些丘丘人身上的邪氣又變強了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010703,
					"content": "「百無禁忌籙」…好像有點耳熟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010704,
					"content": "可以自由出入「絕雲間」的那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "對了，是那個！仙人的「信物」，上面一定殘留著仙人的力量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010707,
					"content": "怪不得他上次能用這個把怪物嚇跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010708,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}們在念叨什麼呢，這不過是本仙昨晚沒睡好…仙力未能通達六脈而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010709,
					"content": "如果再給我一次機會的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010710,
					"content": "又有「邪惡丘丘人」往那邊去了，那這次可以交給你嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010711,
					"content": "我…本、本仙忽然覺得身體有恙，定是方才仙力耗損太多所致，不然我必斬盡這些妖邪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010712,
					"content": "唉…果然是吹牛大王，沒有錯怪你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010713,
					"content": "旅行者，還是我們追上去看看吧，用「元素視野」可以方便追蹤哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010705,
					"content": "原來他是在用它驅魔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
