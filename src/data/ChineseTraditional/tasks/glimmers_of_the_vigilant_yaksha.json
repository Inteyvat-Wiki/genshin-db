				},
				{
					"id": 111010223,
					"content": "嗯？這種老書什麼時候翻身成了暢銷書了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010224
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 111010224,
					"content": "難得有年輕人喜歡，去書架那邊自己找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
