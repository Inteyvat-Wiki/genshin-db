					"nextDialogs": [
						111010502
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010502,
					"content": "退散——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010503,
					"content": "快，快退散哪？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111010504,
					"content": "Beru nye！Beru nya！Beru nyaaaa！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 111010505,
					"content": "糟了，「天君」好像不管用了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111010506,
					"content": "附近還有普通民眾在，不能放手不管了，我們快去幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
