			"dialogs": [
				{
					"id": 230260401,
					"content": "您仰頭看看，可以看到那棵托舉著教令院的大樹嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260402,
					"content": "我接下來的問題很簡單，但不少人都會忽視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260403,
					"content": "那麼請聽題，這棵托舉著教令院的大樹，它的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260404,
					"content": "大樹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
