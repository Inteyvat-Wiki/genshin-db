			"trigger": {
				"objectNames": [
					"齊里亞布",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "這些問題會不會太難了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260102,
					"content": "欸？旅行者！還請留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260103,
					"content": "你叫我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "正是！哈哈哈，我之所以冒昧地請您留步，是想要請您幫一點小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260105,
					"content": "你丟東西了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "啊？您這是…聽起來怎麼這麼熟練啊？哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260109,
					"content": "都不是，都不是，我既沒有丟東西，也不缺研究的材料，至於取材嘛…我自己都取得夠多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260110,
					"content": "咳咳，實際上，為了幫助一些新生迅速理解流傳在須彌內的各種名詞，我正在編纂一本「問答集」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260111,
					"content": "簡單來說，就是以一問一答的形式，將各種複雜的名詞解釋給人聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260112,
					"content": "這樣學習起來效率又高，學習的過程也不會很乏味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260113,
					"content": "不過，我不太確定這些問題的難易程度…所以想要請您來幫我判斷一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260114,
					"content": "我不太瞭解教令院…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "哈哈哈，沒事，等您回答完我的問題，就能對教令院稍微有些瞭解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260119,
					"content": "不用擔心，這些問題不會太過艱深，只是一些…日常的小問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260120,
					"content": "那我們就開始吧，請聽題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260116,
					"content": "怎麼感覺我做過這種事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "#{F#妳}{M#你}是說蒙德的斯萬先生問{F#妳}{M#你}的那些問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230260118,
					"content": "斯萬先生那個時候可是給過我們參考答案啊。這位學者…看起來就不會提前給我們參考答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230260106,
					"content": "你缺材料了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "你要取材了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
			"id": 2302602,
