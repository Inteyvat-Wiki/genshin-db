			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"齊里亞布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "咳咳…您可能已經知道，教令院中各學派的研究各有所長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260202,
					"content": "那麼請問，教令院中學者數量最多，也就是生論派學者為主的學院，它的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260203,
					"content": "阿彌利多學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "很好，完全正確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260205,
					"content": "阿利彌多學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "唔，跟正確答案背道而馳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260207,
					"content": "阿多彌利學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "哈哈，很遺憾。不是這個答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				}
			]
		},
		{
