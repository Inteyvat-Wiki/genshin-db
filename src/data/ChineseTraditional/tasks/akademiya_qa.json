				"points": []
			},
			"dialogs": [
				{
					"id": 230260301,
					"content": "也許您在旅行的過程中，曾經遇見過不少自稱「帝利耶悉」的「遊學者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260302,
					"content": "實際上，教令院的某個學院中也有著大量的「帝利耶悉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260303,
					"content": "這個學院以元素為其理論核心，研究著各類與元素力密切相關的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260304,
					"content": "我的問題是，這個學院的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260305,
					"content": "悉般多摩學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "沒錯，就是聚集著「素論派」學者的悉般多摩學院，他們將七大元素視為一切物質與生命的本質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260307,
					"content": "室羅婆耽學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "哈哈，答錯了，「室羅婆耽學院」的「知論派」學者們研究著語言、符號以及邏輯學…相信我，真的非常複雜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				},
				{
					"id": 230260309,
					"content": "梨多梵諦學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "唔，很遺憾，您答錯了。「梨多梵諦學院」是「明論派」學者的大本營，他們研究的核心是我們頭頂的星空…呵呵，聽起來是不是很有趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊里亞布"
				}
			]
		},
		{
			"id": 2302604,
			"completionStepIds": [],
