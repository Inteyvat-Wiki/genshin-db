			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#呼，總算結束了。真是搞不懂，怎麼突然就開始戰鬥了，明明影狼丸之前看起來還挺友好的，還好有{NICKNAME}在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340902,
					"content": "#咦，為什麼影狼丸會跟著{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340903,
					"content": "汪嗚汪嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340904,
					"content": "這叫聲好像聽起來有點高興？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "#{F#妳}{M#你}怎麼聽出來的！我還一頭霧水呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340906,
					"content": "#如果我的猜想沒錯的話，影狼丸應該已經成為{NICKNAME}的忍犬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340907,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340908,
					"content": "欸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "關於忍犬的契約方法，我也只是略有耳聞罷了。據說忍者看中忍犬後，需要打敗牠，才能得到忍犬的認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340910,
					"content": "忍者渴望強大的夥伴，忍犬也是一樣的，只有互相認可，才能完成契約。看來確實是這樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340911,
					"content": "#可是{NICKNAME}又不是忍者…而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340912,
					"content": "嗚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340913,
					"content": "派蒙怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}，{F#妳}{M#你}先同意答應我一件事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340915,
					"content": "什麼事情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "#{F#妳}{M#你}先說答應嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340917,
					"content": "好吧，我答應妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "#就算{F#妳}{M#你}現在已經和影狼丸立了契約，{F#妳}{M#你}也不能忘記派蒙是{F#妳}{M#你}最最最好的夥伴喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340919,
					"content": "嗯，派蒙是我最好的夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340921,
					"content": "比起貓和狗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "欸嘿嘿。我們永遠都是最最最好的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340924,
					"content": "咳咳，兩位關係真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340925,
					"content": "不過話又說回來，既然影狼丸實力那麼強，為什麼之前那個人還要留信下來，讓別人照顧牠呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340926,
					"content": "#這個我知道喔！{NICKNAME}，很強對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340927,
					"content": "確實實力超群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340928,
					"content": "#但是如果有一天，萬一有什麼意外，我不得不和{NICKNAME}分開，我也會很擔心的。這和{NICKNAME}強不強，其實沒什麼關係啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340929,
					"content": "#呸呸，我在說什麼不吉利的事情！總之只是打個比方！我和{NICKNAME}是最好的夥伴，我們是不會分開的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340930,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "派蒙的推理很合理。那麼接下來唯一的問題是，為什麼這隻狗狗會偷走村民們的小動物，並守著呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340932,
					"content": "呃…唔…這個機智的派蒙也想不出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340933,
					"content": "#可惜，影狼丸也沒辦法說話，不然讓{NICKNAME}去問問就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340934,
					"content": "我們去找找珊瑚吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "對喔，還有珊瑚！這個時候總該輪到頭腦派出場了，我們去找她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340936,
					"content": "嗯，我先去把藏起來的小動物還回去，我們到時候偵探社會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340922,
					"content": "還是派蒙更可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "珊瑚社長，我們回來了，事情是這樣子的……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341002,
					"content": "原來如此。我大概知道為什麼影狼丸會守著小動物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341003,
					"content": "是想要帶著其他小動物變強吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341004,
					"content": "牠小的時候很弱，然後又變強了，對吧。所以牠就想透過訓練，也帶著別的小動物變強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341005,
					"content": "後來牠看到願意保護弱小的旅行者之後，又認可了旅行者作為主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341006,
					"content": "這也是出於牠對弱小的同情心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341007,
					"content": "不過這只是我透過線索進行的推理罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341008,
					"content": "至於真實情況嘛，應該也八九不離十了。但由於影狼丸不會說話，我們也沒辦法得到一個肯定的回答了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341009,
					"content": "珊瑚說話也很有道理呢！不愧是頭腦派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341010,
					"content": "汪汪汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400341011,
					"content": "嗚哇，你也是在肯定珊瑚說的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341012,
					"content": "#不要以為奉承我，下次{F#妳}{M#你}們有委託的時候我就會打折喔。不過呢，這個案子算是辦結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341013,
					"content": "#感謝{NICKNAME}和派蒙，多虧了{F#妳}{M#你}們才能辦結這個案子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341014,
					"content": "#喔，差點忘了，「四方之網」{F#妳}{M#你}們用著感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341015,
					"content": "滿好用的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "嗯，我記下來了。我會和我的那位朋友說的，謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341018,
					"content": "#不客氣！以後有什麼困難，隨時來找我們喔！{NICKNAME}可厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341019,
					"content": "旅行者確實實力不俗，但是不用和我說這些客套話，畢竟感情是真相的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341016,
					"content": "總擔心它會破掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影狼丸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "呼——終於追上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341102,
					"content": "嗯？牠面前的是…一封信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341103,
					"content": "我們先看看吧，這是目前唯一的線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341104,
					"content": "嗯！讓我看看，裡面寫的是什麼……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341105,
					"content": "「致有緣…」呃，太破了看不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341106,
					"content": "可能是「致有緣之人」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341107,
					"content": "哦哦，然後是…「我們家是專門訓練忍犬的世家，為忍者們帶來了許許多多可靠的夥伴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341108,
					"content": "「……此番徵兵令下來，怕是凶多吉少。我此生沒什麼遺憾，唯一放心不下的只有影狼丸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341109,
					"content": "「小時候，牠太弱了，所以忍者們來進行契約的時候，牠被剩了下來。但是沒關係，身為訓練師，我不會放棄任何一隻狗。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341110,
					"content": "「經過日復一日的努力，影狼丸真的變得越來越厲害了。只可惜，牠完全不想和任何忍者契約。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341111,
					"content": "「雖然戰爭還未開始，但奉行所的催促越來越急，我已無暇顧及其他，現在到了不得不離開的時候了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341112,
					"content": "「只好留下這一封信，若是日後有人能找到這裡，請代替我照顧一下影狼丸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341113,
					"content": "「牠臉上有一道疤痕，是年幼時留下的，氣場也與其他普通狗狗不同，很好辨認。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
