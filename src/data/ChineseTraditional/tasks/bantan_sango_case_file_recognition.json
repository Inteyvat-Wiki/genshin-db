			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "#嗯，{F#妳}{M#你}們果然來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340103,
					"content": "龍二的話，按照目前收集到的線索和我的推理，他已經去八醞島調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340104,
					"content": "#我把方位標記在{F#妳}{M#你}的地圖上，如果{F#妳}{M#你}趕緊動身，應該還可以和他會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340105,
					"content": "怎麼突然這麼急急忙忙的，之前不還在偵探社等我們一起的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340106,
					"content": "#因為已經接近尾聲了。{F#妳}{M#你}們也快點動身，一同見證真相的浮現吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340107,
					"content": "#這麼一說，我也有點迫不及待了。我們快走吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "龍二！我們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340202,
					"content": "#啊，是{F#妳}{M#你}們。珊瑚社長讓我先過來調查，說{F#妳}{M#你}們晚點就會過來。果然如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340203,
					"content": "還多虧了她告訴我們，你在這裡呢！龍二調查得怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340204,
					"content": "咦，這裡怎麼都是些關著小動物的籠子，沒有人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340205,
					"content": "剛剛走開了，是盜寶團。珊瑚社長告訴我，他們打算偷狗來訓練成「尋寶犬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340206,
					"content": "就像盜寶鼬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "沒錯，就像盜寶鼬。只不過鼬因為太過調皮，不服管教，所以失敗了。這次，他們就以更加忠心的「狗」為目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340210,
					"content": "以前處理過不少盜寶團的相關委託。這麼一想，珊瑚社長說得果然沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340211,
					"content": "就像人有腳印，組織也會留下自己獨有的痕跡。整個事件中，雖然有著其他迷失、被困的小動物，但痕跡最終還是指向了盜寶團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340212,
					"content": "參考了一下當時的解決辦法，然後我就調查到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340213,
					"content": "不過居然不派個人留守，比起之前的案件，這次的作案者們也太大意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340214,
					"content": "#嗯，真是一群粗心的壞傢伙！不過嘛，{NICKNAME}，{F#妳}{M#你}打了這麼多天架也累了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340215,
					"content": "所以趁他們不在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "沒錯，就這麼辦吧！嘿嘿，我們好默契哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340216,
					"content": "我們偷偷把牠們給救出來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "就像派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "派蒙"
				}
			]
		},
