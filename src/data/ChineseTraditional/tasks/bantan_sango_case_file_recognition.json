					"nextDialogs": [
						400340602
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340602,
					"content": "汪嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340603,
					"content": "這、這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340604,
					"content": "帽子狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "才不是啦！這算什麼外號啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340609,
					"content": "不管怎麼說，好像沒有攻擊我們的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340610,
					"content": "汪汪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340611,
					"content": "嗚哇，牠跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340612,
					"content": "邊跑邊回頭看我們，或許是讓我們跟上去的意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340613,
					"content": "我們快跟上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "嗯，說不定真相就在前面…或許就如同珊瑚社長預料的那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340606,
					"content": "刀子狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "是帽子狗才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340608,
					"content": "黑影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
