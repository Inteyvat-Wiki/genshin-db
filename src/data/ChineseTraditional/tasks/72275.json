			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏帽子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750401,
					"content": "邊陲三角的試煉之地已經準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750402
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750402,
					"content": "那麼我來傳達剩下三場試煉的線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750403
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750403,
					"content": "#請{F#妳}{M#你}在常夜之中，遠望白夜國的邊疆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750404
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750404,
					"content": "——「於昏冥的常世之夜中，於奔流的冥河之外，於無罪的天光流瀉之處。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750405
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750405,
					"content": "#請{F#妳}{M#你}解開天光流瀉之處的封印，升入天之門扉到達試煉之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750406
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750406,
					"content": "天光流瀉之處？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750408
					]
				},
				{
					"id": 722750408,
					"content": "在夜晚可以看到自穹頂落下的三道光柱，這些光柱指向了天光流瀉之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750410
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750410,
					"content": "你說得有點太模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750411,
					"content": "抱歉，海祇大御神它寫的劇本就是這樣的。語焉不詳的指示也是試煉的老傳統了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750412
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750412,
					"content": "總之試煉之處的地走官們都是怪人。沒有透過傳送門過去的話，他們是不會和氣說話的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750413
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750413,
					"content": "#我唯有在這裡恭候{F#妳}{M#你}踏破所有阻礙，取得所有認可之後歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏帽子"
				}
			]
		}
	]
}