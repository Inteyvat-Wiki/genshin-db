	"talks": [
		{
			"id": 7227501,
			"completionStepIds": [
				7227501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227501",
							"2"
						],
						"stepId": 7227501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"烏帽子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "此身既然已經顯現，那血枝珊瑚應該已入海祇之手。讓人欣慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750102,
					"content": "我名厄伯斯，稻妻式名字是烏帽子。乃是珊瑚宮之輔弼，淵下宮巫女中的一位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750103,
					"content": "您應該就是取得珊瑚枝的勇者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750104,
					"content": "是我沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "實在抱歉，我要講述之事可能過於複雜，不知應該如何說起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750106,
					"content": "妳可以從頭開始說，我們會聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750107,
					"content": "非常感謝。那麼，就請容我為您稍事介紹吧。這要從海祇大御神打通海淵之門說起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750108,
					"content": "淵下宮的深處有一處天然溶洞，便是通往海祇島之路。也是海祇所許諾的地上樂土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750109,
					"content": "我們在大御神的授意下，學習了鳴神文化，並且曾與諸方土地建立了外交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750110,
					"content": "鳴神島還稱讚我們的「海祇美人」呢。因為我們海祇人膚質細嫩，可以令七種難隱的汙痕都不再顯眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750111,
					"content": "這種說法的來由呢，是因為我們和祖先都在淵下宮生活得不到日照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750112,
					"content": "說重點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "啊，抱歉。以前日子與諸國外交，我作為珊瑚宮之輔弼，經常擔任嚮導。一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750115,
					"content": "話說回來吧。我與珊瑚宮大人產生了分歧，在海祇大御神的調停之下，我們有了現在的這個方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750116,
					"content": "因為淵下宮有「罪影」這種現象，「過去」、「歷史」、「真相」這種東西，放著不管也會永世長存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750117,
					"content": "所以我們費心盡力，並不是為了銘記，而是為了「遺忘」。很明顯，珊瑚宮大人就是這麼想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750118,
					"content": "（她說的珊瑚宮，應該是很久以前的珊瑚宮巫女吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722750119,
					"content": "取珊瑚枝的試煉，就是盡可能少地讓後人接觸事件全貌的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750120,
					"content": "而我則支持留下真相。因此海祇大御神許可我在此追加一道試煉，通過的話，就可以知曉秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750121,
					"content": "請您接受這個挑戰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750122,
					"content": "我接受挑戰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "#如此甚好，那麼我來為{F#妳}{M#你}啟動追加的試煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750123,
					"content": "我對秘密很感興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "怎麼又是這話。說重點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏帽子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "#如此您已經獲得了所有地走官的認可。他們代行海祇之意志，因此{F#妳}{M#你}也獲得了知道一切的權力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750202,
					"content": "您是拯救海祇萬民的救主，亦是海祇認可之人。您有權知曉任何您關心的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750203,
					"content": "但是請您遵守規矩，一定不要將這些真相帶離海淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750204,
					"content": "#{F#妳}{M#你}還有什麼想知道的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750205,
					"content": "關於深海龍蜥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "深海龍蜥是原始的元素生物，因為久居深海，所以並沒有被天上降臨的力量降伏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750211,
					"content": "牠們其實非常聰明，而且擅長進化。在和我們戰鬥的歷史裡，甚至進化出了其他元素的品種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750212,
					"content": "如果牠們學會了語言，甚至進化出蜥蜴人這種東西我都不會奇怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750213,
					"content": "「聖土化」的本質，其實就是牠們宜居環境的拓張。也就是三界中的原始元素力量變得強勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750214,
					"content": "我們唯有使用海祇大御神生命力，喚醒它的第二眷屬，將荒蠻的元素力轉化掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750206,
					"content": "關於海祇大御神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "海祇大御神因為它的厄運，落入了「天之秩序」管轄之外的此處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750216,
					"content": "這件事毫無疑問是我等白夜國民的好運。它真的為了我們做了許多事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750217,
					"content": "只不過也因為接觸了我們，觸碰了甚至在它誕生之前的真相。於是它被天京敕令，必須捨身成仁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750218,
					"content": "此番獻頭，必須做到無人懷疑。唯有此法，白夜之民才能被允許活在新的「七之秩序」之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750207,
					"content": "關於日月之前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "白夜國落入海淵之前，確實整個世界都在統一的文化之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750220,
					"content": "後來發生了一場大戰，天也傾覆，地也崩裂。這片土地在那時落下了漆黑的海淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750221,
					"content": "而後，天之秩序似乎並不想讓記得這一切的人殘留在大地之上。我們尋找歸途，卻怎麼也找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750222,
					"content": "直到很久以後，天之禁令的力量逐漸減弱了。海祇大御神掉入了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750208,
					"content": "關於大日御輿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "大日御輿是賢人·阿布拉克設計的建築。它擁有為海淵之下帶來光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750224,
					"content": "除此以外，還集成了很多功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750225,
					"content": "總之很厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750209,
					"content": "沒有其他的事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "#那麼好的。請{F#妳}{M#你}務必記住，淵下宮所遇之事，請當成永遠的秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏帽子"
				}
			]
		},
		{
			"id": 7227503,
			"completionStepIds": [],
