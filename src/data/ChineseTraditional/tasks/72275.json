					"烏帽子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750301,
					"content": "請您向地走官的常世之靈證明自己的勇武吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750302
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750302,
					"content": "#當{F#妳}{M#你}完成了所有挑戰，我才能告訴{F#妳}{M#你}所有的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750303
					],
					"speakerTitle": "烏帽子"
				},
				{
					"id": 722750303,
					"content": "…唉，我像是個知道了點小秘密就忍不住想找人說的小姑娘似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏帽子"
				}
			]
		},
		{
			"id": 7227504,
			"completionStepIds": [
				7227508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
