							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格奧爾格"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "格奧爾格先生，你好啊。我們是沙瓦瑪先生的代理人，想代他訂購50箱「假日果釀」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180202,
					"content": "喔？沙瓦瑪先生嗎？他是我的熟客了，訂貨的數量很少有變化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "格奧爾格"
				},
				{
					"id": 705180203,
					"content": "言歸正傳，今年你們打算出多少價錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格奧爾格"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180302,
					"content": "喔！是芭芭拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180303,
					"content": "妳好呀，芭芭拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "嗯，佳釀節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180306,
					"content": "#佳釀節是蒙德最熱鬧的節日之一，我很開心能在這個時候見到{F#妳}{M#你}們，希望{F#妳}{M#你}們也喜歡佳釀節！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180307,
					"content": "#說起來，剛才我聽格奧爾格先生說，{F#妳}{M#你}們在收集「佳釀晶凍」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180308,
					"content": "#我有點好奇，{F#妳}{M#你}們是在幫騎士團義賣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180309,
					"content": "對啊，我們也是騎士團的一份子嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180310,
					"content": "現在店鋪還沒開張，我們要多跑幾趟，籌集開店資金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180311,
					"content": "雖然還不知道開店後會遇上什麼問題，但我們一定能搞定所有麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180312,
					"content": "#太可靠了！嘿嘿…有{F#妳}{M#你}們幫忙，一定會取得前所未有的成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180313,
					"content": "借妳吉言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "之前，騎士團舉辦小型義賣活動的時候，我也去幫過忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180315,
					"content": "雖然，我幫忙的方式是站在商鋪前唱歌啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180316,
					"content": "對了！那次我還遇到了那位吟遊詩人溫迪喔！他還邀請我即興合作了一曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180317,
					"content": "他演奏的音階古樸又典雅，一開始，我只敢小聲跟唱，就怕哪裡不對破壞了氣氛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180318,
					"content": "好在他用和聲引導著我，我們很快找到了感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180319,
					"content": "最後，聽眾們都很享受，商品也賣得特別好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180320,
					"content": "原來芭芭拉和賣唱的還合作過啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180321,
					"content": "我也有點想聽了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "嗯，只可惜這次時間衝突了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180323,
					"content": "佳釀節期間，西風教會要在風景優美的地方安排特別的唱詩，我還得參加排練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180324,
					"content": "妳去忙吧，沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "嗯，都是很有意義的工作，我們各自加油吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180327,
					"content": "#謝謝{F#妳}{M#你}們！雖然不能留在這裡唱歌，但我也想做點什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180328,
					"content": "#我…我來向大家宣傳{F#妳}{M#你}們的店鋪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180329,
					"content": "唔…該做成大幅海報嗎？還是拿在手裡的傳單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180330,
					"content": "宣傳語得設計一下！附上簽名會不會更有誠意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180331,
					"content": "唔，還是說一個一個通知比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180332,
					"content": "哇，有芭芭拉幫忙做廣告，店鋪知名度會大幅提升吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180333,
					"content": "太費心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "#這是我力所能及的小事，{F#妳}{M#你}們這麼說，我會不好意思的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180336,
					"content": "#那我再琢磨一下，也向其他人請教一下宣傳的經驗！{NICKNAME}、派蒙，我們回頭見了~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180337,
					"content": "#那個…騎士團和教會的大家都會為{F#妳}{M#你}們驕傲的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 705180338,
					"content": "嗯！一起加油喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180339,
					"content": "#這下我更有幹勁了！{NICKNAME}，我們可得好好表現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180334,
					"content": "量力而行就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "義賣交給我們就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "佳釀節快樂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
