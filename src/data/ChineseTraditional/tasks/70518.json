			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"伯恩哈德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "請留步！大名鼎鼎的榮譽騎士，還有「提瓦特最好的嚮導」派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180102,
					"content": "#懇請{F#妳}{M#你}們幫我一把！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180103,
					"content": "噫！居然有人會這樣叫我？我的名號終於傳開了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180140,
					"content": "等等…我怎麼感覺你有點眼熟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180104,
					"content": "我們在騎士團總部大廳見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "沒錯，我是西風騎士伯恩哈德，隸屬赫塔隊長的後勤小隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180106,
					"content": "#按照基本的禮儀，我應該先和{F#妳}{M#你}累積足夠的交情…但時間太緊張了，我只能厚著臉皮求{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180107,
					"content": "#請{F#妳}{M#你}幫幫忙吧，拯救這次義賣活動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180108,
					"content": "拯救？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "義賣活動…好像聽琴團長提起過。你遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180110,
					"content": "是這樣的，西風騎士團打算在佳釀節期間經營一間店鋪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180111,
					"content": "店鋪賺到的錢會被用於慈善事業，提供給生活條件比較艱苦的孩子和老人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180112,
					"content": "而人選是由抽籤決定的，恰巧…就抽到了我。為了不讓這次義賣失敗，我去請教了許多人，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180113,
					"content": "但我平常大多負責倉儲和運輸工作，就連要賣什麼都想了很久，更別提經營店鋪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180114,
					"content": "#所以，我想懇請{F#妳}{M#你}們出手幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180115,
					"content": "可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "對喔對喔，你說話不用這麼客氣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180118,
					"content": "按你的說法，義賣活動是為了蒙德的孩子和老人們好嘛，意義重大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME}是榮譽騎士，我也是騎士團的老朋友了，分擔一點責任也不算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180120,
					"content": "就讓我們出一份力吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "實在感激不盡！那我就長話短說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180123,
					"content": "活動開始前，我們需要籌備<color=#00E1FFFF>「佳釀晶凍」</color>。這是經營店鋪的基礎資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180124,
					"content": "附近的酒商急需釀酒原料，向他們出售原料，就能得到大量「佳釀晶凍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180125,
					"content": "此外，一些外國的客人想要大量採購佳釀節期間的飲品，他們正在尋找幫忙下單的代理人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180126,
					"content": "出於長期合作的考慮，這些客人給出的資金通常很寬裕，和酒商們也有商量價格的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180127,
					"content": "這之間的差價，就是給我們的酬勞了，也能夠換成等價的「佳釀晶凍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180128,
					"content": "也就是說，我們的任務是為酒商提供釀酒材料，還有幫外地客人下單殺價，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180129,
					"content": "完全沒有我想像的那麼難嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180130,
					"content": "都是我們擅長的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "真、真的嗎？那就太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180132,
					"content": "我這裡已經接到了一份委託——須彌的沙瓦瑪先生想要訂購<color=#00E1FFFF>50箱「假日果釀」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180133,
					"content": "這種飲品可以在<color=#00E1FFFF>「天使的饋贈」的攤位</color>買到，店主是<color=#00E1FFFF>格奧爾格</color>先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180134,
					"content": "#格奧爾格先生比較和善，但也不會吃啞巴虧。還請{F#妳}{M#你}們謹慎考慮價格，和格奧爾格先生好好協商了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180135,
					"content": "#我先繼續搭建店鋪。等到{F#妳}{M#你}們籌備到了足夠的「佳釀晶凍」，就回到這裡來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180136,
					"content": "#至於店鋪的相關物資，就不用{F#妳}{M#你}們多費心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180137,
					"content": "我已經聯絡了供應商，只等資金到位，他們就會把東西送過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180138,
					"content": "好喔，分工合作！店鋪佈置交給你，資金籌備就交給我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705180139,
					"content": "幫大忙了，有勞兩位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705180121,
					"content": "需要我們怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "每個人都有不擅長的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
