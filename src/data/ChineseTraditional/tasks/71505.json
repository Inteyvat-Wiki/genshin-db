				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}，{F#妳}{M#你}總算來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050102,
					"content": "調整得還順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "已經調整完畢，雖然有些擔心，不過現在也只能暫時把光釘放在礦道深處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050104,
					"content": "我還拜託海迪夫做了藥，會給老圖和阿昊也送過去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}，啟動光釘，然後封閉掉地脈噴湧黑泥的出口…一定要做到啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050106,
					"content": "原本只是海迪夫叫我過來幫個忙而已，那個時候我心裡想著，要是我解決不了這個問題，大不了就帶著光釘直接回須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050107,
					"content": "反正關於「普爾希娜光釘」的實驗也已經做得夠多，要完成一篇資料詳實的報告根本就是綽綽有餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050108,
					"content": "但是老圖和阿昊呢，這些生活在這裡的人…他們可就只能終身和這些危險的黑泥為伴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050109,
					"content": "如果我的研究無法真的幫助到他們，只是為了一篇報告的話，我想，恐怕這研究也意義不大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050110,
					"content": "所以我才決定，要想辦法解決地脈噴湧黑泥的問題，更何況，接觸這些黑泥…對作為須彌學者的我來說也是一種警醒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050111,
					"content": "#我相信{F#妳}{M#你}的實力，但是黑泥湧出的地方還是很危險，要小心啊，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050112,
					"content": "知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "哈哈哈呃咳、咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050115,
					"content": "#我是說{F#妳}{M#你}，{NICKNAME}，「普爾希娜光釘」在噴口處啟動，雖然能夠減輕黑泥對怪物的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050116,
					"content": "但那裡之前被黑泥招來的怪物數量還是太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050117,
					"content": "#{F#妳}{M#你}一定要小心自己的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715050113,
					"content": "我會小心光釘的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}