			"dialogs": [
				{
					"id": 750700901,
					"content": "#哈哈，完美！副本給{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750700902,
					"content": "哇！果然好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750700903,
					"content": "#來，給{F#妳}{M#你}報酬，這是第二次…不，第三次受你們幫助了，我都懷疑如果沒有你們幫忙，我這次攝影之旅還有沒有辦法走到最後！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750700904,
					"content": "我下一個目的地是這裡…在地圖上幫你們標好了。如果有興趣的話，我時刻等著與你們再次合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750700905,
					"content": "啊…時間差不多了，我要走囉！也祝你們好運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750700906,
					"content": "馬尼菲科收拾好行李，歡快地躍上了熱氣球。\\n隨著熱氣球慢慢遠去，小小的馬尼菲科哈哈大笑，留下了悠遠的回聲。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
