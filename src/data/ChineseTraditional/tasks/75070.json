			"dialogs": [
				{
					"id": 750701401,
					"content": "#可惡，我們又要重來一次了！呃…我是說，如果{F#妳}{M#你}們不介意的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750701402,
					"content": "唉…既然來都來了，沒什麼介意不介意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750701403,
					"content": "我們繼續吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "嗯，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750701405,
					"content": "請讓我們休息一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "跳崖可是苦工，也該讓人家休息一下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750701407,
					"content": "#唔…抱歉，是我考慮不周。等{F#妳}{M#你}們準備好了直接開始就是，我一直在這裡等著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				}
			]
