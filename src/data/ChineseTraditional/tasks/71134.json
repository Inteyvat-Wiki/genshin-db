			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄機"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2131.829,
							396.2,
							2597.355
						],
						"pointId": 311500160
					}
				]
			},
			"dialogs": [
				{
					"id": 711340101,
					"content": "唷！客官，看您這風塵僕僕的樣子，在找喝茶歇腳的地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340102
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340102,
					"content": "你這有茶喝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340103
					]
				},
				{
					"id": 711340103,
					"content": "可不是，方圓幾里，就小的這一家茶攤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340104
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340104,
					"content": "那都有什麼茶呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340105,
					"content": "呃…嗯…爆…火熱爆裂甜甜花蜜茶，嗯，沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340106
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340106,
					"content": "是一種用野生甜甜花和騙騙花蜜融合而成的特飲。入口火熱，回味清涼，驅疲解累，別處可見不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340107
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340107,
					"content": "哦！是沒聽過的茶呢！感覺會很好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340108,
					"content": "不巧的是，小的手頭原料用完了，但旁邊的原料地很危險呢，既要摘甜甜花，又要對付神出鬼沒的<color=#00E1FFFF>火騙騙花</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340118
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340118,
					"content": "假如能有足夠的原料重新支撐小店，付出再多報酬小的又何懼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340109
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340109,
					"content": "但可惜現在…真是難為情啦，客官要不別處轉轉？小的回頭去趟冒險家協會，請他們幫忙取些原料再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340110
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340110,
					"content": "好訊息，我們就是冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340111
					]
				},
				{
					"id": 711340111,
					"content": "呃…咳咳…這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340112
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340112,
					"content": "沒錯，爆裂甜甜花蜜茶，一定要喝到，讓我們去幫你解決原料的問題吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340113,
					"content": "#那…那裡的騙騙花，可就像暝垣山上的石頭一樣多哦！{F#妳}{M#你}們還是別冒這個險吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340114
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340114,
					"content": "…但是如果真的有那麼多，這裡不應該叫騙騙花山才對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340115,
					"content": "呃…我又想起來，其實我和冒險家協會有過合作協議…也就是說，這樣貿然讓兩位接手，也不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340116
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340116,
					"content": "你這個人好奇怪，有現成的冒險家幫你忙，你還不樂意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340117,
					"content": "總之，茶飲雖好，時機不巧，呵呵，客官請回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340119
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340119,
					"content": "好吧，好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340120,
					"content": "#（{NICKNAME}…{F#妳}{M#你}覺得我們要是不聽他的，直接去把原料取來，是不是就有茶喝了啊？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340121,
					"content": "（好想試試看他說的那個茶哦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7113403,
			"completionStepIds": [
				7113403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113403",
							"2"
						],
						"stepId": 7113403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄機"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711340301,
					"content": "#咦？客官{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340302
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340302,
					"content": "原料給你，上茶吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340303
					]
				},
				{
					"id": 711340303,
					"content": "#什麼？{F#妳}{M#你}們真的去解決了那些<color=#00E1FFFF>火騙騙花</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340304
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340304,
					"content": "的確有不少隻哦！不過在我們面前還是不夠看啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340305,
					"content": "有不少隻？啊不不，小的當然知道有不少隻，哈哈，兩位果真是藝高人膽大啊，佩服，佩服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340306
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340306,
					"content": "（還好這兩位沒事…不然我可就失職了…看來下次得換個說辭…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340307
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340307,
					"content": "哼哼，這下你總不能推脫了吧？我們現在就想喝特別的火熱爆裂甜甜花蜜茶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340308,
					"content": "咳咳…好…小的這就準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340309
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340309,
					"content": "（可惡…要怎麼做…應該不會很難吧？！應該把甜甜花和騙騙花蜜倒在一起就好吧？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340310
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340310,
					"content": "#玄機面露難色，但還是拿出{F#妳}{M#你}們帶來的原料，一股腦地放進了一個杯子。不到片刻後，他又取出了一些，但最後，還是都放了回去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340311
					]
				},
				{
					"id": 711340311,
					"content": "#之後他蓋上茶蓋，使勁搖晃起來。不久，一碗漂浮著奇怪泡沫的褐色液體被端到{F#妳}{M#你}們面前。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340312
					]
				},
				{
					"id": 711340312,
					"content": "#{F#妳}{M#你}意識到有什麼不太對，但派蒙接了過來，一飲而盡。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340313
					]
				},
				{
					"id": 711340313,
					"content": "啊呸呸呸——這是什麼東西啊！我從來沒有喝過這麼難喝的東西…你這個茶攤子到底是怎麼開下去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340314,
					"content": "呃哈哈…真、抱歉！讓客官的舌頭受了委屈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340315
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340315,
					"content": "這點小心意，請收下吧！就當是對舌頭的賠罪，還有為兩位找來原料的報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340316
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340316,
					"content": "唔…好吧…雖然你泡茶的手藝不行，人品還是很不賴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340317,
					"content": "呵呵，哪裡的話…總之，託兩位的福，小的原料備齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340318
					],
					"speakerTitle": "玄機"
				},
				{
					"id": 711340318,
					"content": "沒什麼事兩位也盡早回去吧，畢竟是野外，難說還有什麼危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄機"
				}
			]
		},
