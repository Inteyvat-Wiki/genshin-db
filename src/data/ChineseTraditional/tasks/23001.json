			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010101,
					"content": "讓我想想…該選哪一個呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010102
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010103
					]
				},
				{
					"id": 230010103,
					"content": "哦，我在思考今天的「吞金料理」是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010104
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010104,
					"content": "「吞金料理」？是…是金子做的料理嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010105,
					"content": "不，是讓人吃了之後，能夠日進斗金的偉大料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010106
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010106,
					"content": "那我也想要吃！不對…怎麼會有那種東西啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010107,
					"content": "哈哈哈，那妳就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010108
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010108,
					"content": "比方說璃月的摩拉肉，這種以金錢為名的尊貴料理，理所當然地蘊含著強烈的財富運勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010109
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010109,
					"content": "還有奶油雞，豐盛的油水讓人不禁就聯想到豐盛的荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010110
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010110,
					"content": "再比如說蒙德的「堆高高」，從名字到擺盤無一不在象徵財富節節高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010111
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010111,
					"content": "如果吃下這種料理，再去卡里米交易所裡買上幾單期貨，一定就能大賺一筆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010112
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010112,
					"content": "聽起來都感覺有一種強行解釋的感覺啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010113,
						230010133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010113,
					"content": "期貨是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010114
					]
				},
				{
					"id": 230010114,
					"content": "#{F#妳}{M#你}沒有買過期貨嗎？唔…那就讓我跟{F#妳}{M#你}解釋解釋，那是一種和現貨交易對應的未來交易，就比如說，{F#妳}{M#你}身邊的這個小傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010115
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010115,
					"content": "派蒙是派蒙！才不是什麼小傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010116,
					"content": "唔哈哈哈，那麼派蒙小傢伙，妳喜歡什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010117
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010117,
					"content": "欸？派蒙喜歡…嗯…史萊姆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010118,
					"content": "哈哈哈，好！那就假設我手裡有一種史萊姆凝液，價格是一百摩拉一瓶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010144
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010144,
					"content": "今天妳花五萬摩拉從我這裡買入五百瓶史萊姆凝液，這種是現貨交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010119
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010119,
					"content": "這、這也太多了，派蒙吃不完的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010120,
					"content": "這就是一個比方嘛…假設妳今天買了五百瓶，但妳一定不能保證，每天都會向我購買這麼多史萊姆凝液吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010121
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010121,
					"content": "唔…唔，要是吃太飽的話，應該就不會買了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010122,
					"content": "沒錯，而我也不能保證，每時每刻都能向妳提供史萊姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010123
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010123,
					"content": "所以，這個時候期貨就出現了。期貨不是一般的當著面一手交錢一手交貨，而是一種「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010124
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010124,
					"content": "「購買一份史萊姆凝液」和「出售一部分史萊姆凝液」都是一種「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010125
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010125,
					"content": "在我還能提供史萊姆凝液的時候，就會向期貨交易所提交出售史萊姆凝液的「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010126
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010126,
					"content": "而妳需要史萊姆凝液的時候，就可以去期貨交易所查看一下購買史萊姆凝液的「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010127
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010127,
					"content": "「期貨交易」，就是精確而巧妙地購買和賣出這種「交易協定」，從而獲得利潤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010128
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010128,
					"content": "當然啦，我也就是這麼打個比方。如果史萊姆凝液真到了要用期貨交易的地步，只怕野外的史萊姆都要被抓光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010129
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010129,
					"content": "噢…好厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010130,
					"content": "喔…沒聽懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010131
					]
				},
				{
					"id": 230010131,
					"content": "只是期貨市場千變萬化，就算是我這樣經驗豐富的專家，也不敢說買到的期貨一定會賺錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010132
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010132,
					"content": "但如果能先吃下帶來財運的「吞金料理」，情況就不一樣了。唯一的問題是…我今天應該吃哪一種呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010136,
					"content": "#啊，等一下，我剛才沒有注意，{F#妳}{M#你}的頭髮…居然是黃金的顏色啊！真是耀眼，耀眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010137
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010137,
					"content": "#黃金這可是財富的象徵，由{F#妳}{M#你}選出的料理，一定能給我帶來豐厚的財運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010138
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010138,
					"content": "#就由{F#妳}{M#你}來幫我挑選一份「吞金料理」吧？我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010139
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010139,
					"content": "#如果到時候賺了錢，我還有額外的好處給{F#妳}{M#你}，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010140
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010140,
					"content": "萬一虧了的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010141
					]
				},
				{
					"id": 230010141,
					"content": "#哈哈哈，放心吧。我，卡里米的不凡富翁哈特姆在此宣佈——賺了有{F#妳}{M#你}一份，虧了全算我的，這下放心了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010142
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010142,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010143
					]
				},
				{
					"id": 230010143,
					"content": "#那就請{F#妳}{M#你}快幫我選一選，<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>這三道料理，到底哪一道才是「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010133,
					"content": "為什麼不三種全吃掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010134
					]
				},
				{
					"id": 230010134,
					"content": "把所有好的食材混在一起，最後反而做出了黑暗料理，這種事也是常有的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010135
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010135,
					"content": "財富運勢也一樣，全部吃掉只會適得其反，必須選出最有效的一種「吞金料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300102",
							"2"
						],
						"stepId": 2300102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300102"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010201,
					"content": "#怎麼樣？<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>，讓我看看{F#妳}{M#你}選了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300103,
			"completionStepIds": [
				2300103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300103",
							"2"
						],
						"stepId": 2300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010301,
					"content": "啊，我聞出來了，這份料理的香氣…是財富的味道！是黃金的感覺！我感覺這次一定能大賺特賺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010302
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010302,
					"content": "多謝了，等等我要去我的「蓄財之地」，把這份「吞金料理」吃下去。兩位，等我的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010303
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010303,
					"content": "「蓄財之地」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010304
					]
				},
				{
					"id": 230010304,
					"content": "這也是我秘密致富經之一，和「吞金料理」一樣，是會帶來財運給我的好地方。",
					"roleType": "TALK_ROLE_NPC",
