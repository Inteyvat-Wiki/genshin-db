			"dialogs": [
				{
					"id": 230010601,
					"content": "讓我想想…該選哪一個呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010602
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010602,
					"content": "#咦，旅行者，又是{F#妳}{M#你}們，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010603
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010603,
					"content": "你該不會又在挑選「吞金料理」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230010604,
					"content": "#哈哈哈，{F#妳}{M#你}可真是個小聰明！我正打算挑選一份「吞金料理」，然後去期貨市場大殺四方呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010605
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010605,
					"content": "怎麼樣，再幫我一次吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010606,
						230010608,
						230010614
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010606,
					"content": "明白了，今天還是老規矩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010607
					]
				},
				{
					"id": 230010607,
					"content": "#沒錯！跟{F#妳}{M#你}們打交道就是令人愉悅啊，就請幫我在<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>之中選擇一道真正的「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010608,
					"content": "等等，「吞金料理」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010609
					]
				},
				{
					"id": 230010609,
					"content": "是讓人吃了之後，能夠日進斗金的偉大料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010610
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010610,
					"content": "比方說璃月的摩拉肉，這種以金錢為名的尊貴料理，理所當然地蘊含著強烈的財富運勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010611
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010611,
					"content": "還有奶油雞，豐盛的油水讓人不禁就聯想到豐盛的荷包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010612
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010612,
					"content": "再比如說蒙德的「堆高高」，從名字到擺盤無一不在象徵財富節節高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010613
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010613,
					"content": "如果吃下這種料理，再去卡里米交易所裡買上幾單期貨，一定就能大賺一筆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010623,
					"content": "#那麼，為了我的「期貨交易」，就請{F#妳}{M#你}幫我在<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>之中選擇一道真正的「吞金料理」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010614,
					"content": "等等，期貨是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010615
					]
				},
				{
					"id": 230010615,
					"content": "那是一種和現貨交易對應的未來交易，假設我手裡有一種史萊姆凝液，價格是一百摩拉一瓶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010616
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010616,
					"content": "#今天{F#妳}{M#你}花五萬摩拉從我這裡買入五百瓶史萊姆凝液，這種就是現貨交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010617
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010617,
					"content": "#但{F#妳}{M#你}一定不能保證，每天都會向我購買這麼多史萊姆凝液，我也不能保證，每時每刻都能向{F#妳}{M#你}提供史萊姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010618
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010618,
					"content": "所以，這個時候期貨就出現了。期貨不是一般的當著面一手交錢一手交貨，而是一種「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010619
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010619,
					"content": "「購買一份史萊姆凝液」和「出售一部分史萊姆凝液」都是一種「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010620
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010620,
					"content": "在我還能提供史萊姆凝液的時候，就會向期貨交易所提交出售史萊姆凝液的「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010621
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010621,
					"content": "#而{F#妳}{M#你}需要史萊姆凝液的時候，就可以去期貨交易所查看一下購買史萊姆凝液的「交易協定」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010622
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230010622,
					"content": "「期貨交易」，就是精確而巧妙地購買和賣出這種「交易協定」，從而獲得利潤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "哈特姆"
				}
			]
		}
	]
