			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "您好，旅行者。這段時間請盡量待在城裡，不要外出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "外面那些砸落的隕石，您應該也看見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230104,
					"content": "不知道為什麼，這段時間隕石降落的勢頭似乎更猛了，野外也更加危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230105,
					"content": "城內的事務越來越多，騎士團也要忙不過來了。偏偏最近城邊還發現了不少盜寶團的蹤跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230106,
					"content": "這群為了錢什麼都肯幹的傢伙，只怕是想要趁火打劫一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230107,
					"content": "#如果{F#妳}{M#你}願意的話，能幫忙去城邊趕走那些盜寶團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230108,
					"content": "#本來這應該是騎士團的職責，但我們實在抽不出人手來處理這件事，只能拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "#那就拜託{F#妳}{M#你}了，在這種情況下還讓{F#妳}{M#你}幫忙，實在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230111,
					"content": "盜寶團不怕隕石嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "哼，為了錢，那群傢伙應該什麼都不怕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230113,
					"content": "#那就拜託{F#妳}{M#你}了，在這種情況下還讓{F#妳}{M#你}幫忙，實在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
