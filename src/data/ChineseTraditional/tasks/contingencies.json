				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"膽小的莫羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "#咦？怎麼又是{F#妳}{M#你}，{F#妳}{M#你}去做什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230802,
					"content": "我把魔物都打倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "#打倒了…真的假的，就{F#妳}{M#你}一個人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230804,
					"content": "你可以自己去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "呃…我可不敢自己去看，要是被魔物發現了可就完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230806,
					"content": "#算了，不管{F#妳}{M#你}說的是真是假，我都得回去報告一聲。",
					"roleType": "TALK_ROLE_NPC",
