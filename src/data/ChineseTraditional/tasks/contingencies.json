			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "嗚哇！別，別過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230402,
					"content": "#咦？不是魔物…{F#妳}{M#你}，{F#妳}{M#你}是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230403,
					"content": "關於魔物的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "魔物的情況…那還用問嗎？我就是剛從魔物堆旁邊跑過來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230405,
					"content": "就在旁邊，一群魔物已經在那紮堆了，一副要進攻鎮子的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230406,
					"content": "#要不是我跑得快，說不定{F#妳}{M#你}就看不到我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230407,
					"content": "那群魔物在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "就在鎮子旁邊，很近，走幾步就能看見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 411230409,
					"content": "#{F#妳}{M#你}也快點去避難吧，我在這再休息一下…再休息一下就回去把情況告訴鎮子裡的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "膽小的莫羅"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112308",
							"2"
						],
						"stepId": 4112308,
						"stateName": "QUEST_STATE_UNFINISHED"
