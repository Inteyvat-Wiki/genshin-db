			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "#{F#妳}{M#你}把那些盜寶團都趕走了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230302,
					"content": "都趕走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "太好了，實在是幫大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230304,
					"content": "那群盜寶團吃了這個教訓，應該不敢來趁火打劫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230305,
					"content": "沒事的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "#呃，請留步…還有一件事，想要再請{F#妳}{M#你}幫幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230307,
					"content": "其實在隕石落下之後，騎士團就收到很多有關魔物異常的報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230308,
					"content": "這些報告裡面提到，魔物似乎也受到了隕石的影響，變得格外暴躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230309,
					"content": "蒙德城的防衛還算全面，不需要擔心，但是有一顆隕石正好落在了清泉鎮旁邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230310,
					"content": "清泉鎮裡雖然有不少獵人，我們也派了騎士過去協助，但那裡的地形實在難以做到完全防守好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230311,
					"content": "假如漏了魔物進鎮子，那就糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230312,
					"content": "#能請{F#妳}{M#你}去清泉鎮周圍調查一下魔物的情況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230313,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "#那就拜託{F#妳}{M#你}了，我也會盡量快點再安排些騎士過去支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230315,
					"content": "清泉鎮的情況怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "老實說…不太樂觀，除了要處理隕石相關的諸多事宜外，還要提防魔物和盜寶團…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230317,
					"content": "同時要應付這麼多東西，實在是太吃力了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230318,
					"content": "#那這件事就拜託{F#妳}{M#你}了，我也會盡量快點再安排些騎士過去支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
