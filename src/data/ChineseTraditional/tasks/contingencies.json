					"nextDialogs": [
						411230904
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411230904,
					"content": "#十分感謝{F#妳}{M#你}，實在幫大忙了，這些謝禮請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
