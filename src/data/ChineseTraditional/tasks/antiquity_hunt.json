			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丹納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "唔，大家怎麼都一副疲憊的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940102,
					"content": "這裡在舉辦什麼活動嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "#{F#妳}{M#你}是…旅行者對吧？哈哈哈，久仰大名了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940104,
					"content": "沒錯，我們伐護末那學院正在這裡舉辦一個有關「考古」的小遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940105,
					"content": "畢竟我們學院裡有不少研究歷史的學者，在這些學者的研究過程裡，當然就免不了去親自「考古」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940106,
					"content": "哎呀，別緊張，我們可不會讓大家去真的考古啊。這次的活動，只是考古這種「行為」的一種模擬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940107,
					"content": "我們已經預先在須彌城周圍埋了不少「文物模型」…我們就暫且把埋著這些東西的地方稱作「考古區」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940108,
					"content": "參與活動的人，只需要拿著我們特別製作的探查器，在「考古區」內將埋藏的「文物模型」挖出來就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940109,
					"content": "多虧了其他學院的同學，幫忙特製了一批容器和對應的探查器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940110,
					"content": "#怎麼樣，旅行者？{F#妳}{M#你}有沒有興趣試試看啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940111,
					"content": "聽起來倒也不難…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "#哈哈哈，好！這是探查器，{F#妳}{M#你}拿好了。我再把「考古區」所在的位置標在<color=#00E1FFFF>考古手冊</color>上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940114,
					"content": "這樣就行了，快去體驗考古的樂趣吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940115,
					"content": "#如果{F#妳}{M#你}把所有的「文物模型」都找到了，記得回來找我拿禮物啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940116,
					"content": "尋找模型的時候，只要跟著探查器走就好了。為了方便分類，還用元素類別做了區分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940117,
					"content": "不過…那些探查器原來是用來探測元素的，經過臨時改造後，還是可能被一些特定的元素影響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940118,
					"content": "總之，只要把所有的「文物模型」都挖出來，我們還有好禮相贈喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丹納"
				},
				{
					"id": 736940112,
					"content": "試試也沒問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}