			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "呀，戴因在這裡。你有見過琴團長嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030102,
					"content": "我見到她了，但刻意避開了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030103,
					"content": "她是「獅牙騎士」，又是代理團長，必然會對我抱有戒心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030104,
					"content": "若我不謹慎，總有一天會變成她的調查對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030105,
					"content": "話說回來，我這邊只解決了些魔物，沒找到什麼情報。你們那邊，有收穫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030106,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030107,
					"content": "那麼，「世上第一座耕地機」動向的全貌，大致就已經能夠拼湊齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030108,
					"content": "咦？真的嗎？就憑「王狼」說的那些話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030109,
					"content": "不止是憑這一條訊息，而是更綜合的考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030110,
					"content": "#比如，{F#妳}{M#你}們之前告訴我說，教會傳下的那個「老故事」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030111,
					"content": "「暴君的遺怨」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "#沒錯。正是{F#妳}{M#你}口中那位修女提到的，曾被誤認為暴君遺怨的奇怪事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030113,
					"content": "如果從天而降的火球是導彈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "啊，我懂了！所以「暴君的遺怨」，其實是從奔狼領逃走的那座機器，自動發射的導彈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030116,
					"content": "它在「狼的試煉」裡損壞以後，遊蕩到了「舊蒙德」的廢墟，住了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030117,
					"content": "只要有人接近，就咚咚咚——地發射。直到有一天，它終於壞掉了，所以從天而降的火球也消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030118,
					"content": "那時候的蒙德人還沒大量接觸過「遺蹟守衛」，就只能解讀成是「暴君的遺怨」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030119,
					"content": "看來，我們該去那個現在叫做<color=#00E1FFFF>「風龍廢墟」</color>的地方，開始地毯式搜查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030120,
					"content": "不。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "#哦？{F#妳}{M#你}的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030123,
					"content": "我有…現成的「記憶」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "#咦…{F#妳}{M#你}是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030125,
					"content": "哦！我也懂了！沒錯沒錯，那台<color=#00E1FFFF>「坐在高塔上的守衛」</color>，確實很讓人印象深刻呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030121,
					"content": "不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "當時的蒙德想不懂火球是什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "其實芭芭拉是祈禮牧師吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
			"completionStepIds": [
				800305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
