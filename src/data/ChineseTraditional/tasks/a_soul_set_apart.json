			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "就是這個嗎？好，用元素視野看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030302,
					"content": "唔唔唔唔——怎麼樣，有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030303,
					"content": "#欸？{F#妳}{M#你}說什麼都沒發生？明明我還這麼期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030304,
					"content": "怎麼會，是不是哪裡搞錯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030305,
					"content": "是方法的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030306,
					"content": "對「耕地機」用元素視野是不可行的，因為驅動它的能源從來不是「元素」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030307,
					"content": "交給我吧，我來嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030308,
					"content": "…好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030309,
					"content": "哇，這就是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030310,
					"content": "深淵使徒一直尋找的關鍵，「世上第一座耕地機的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030311,
					"content": "如今留存的所有遺蹟守衛，都是這台機器的仿製品。作為「原型機」，它的戰鬥力不受控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030312,
					"content": "「原型機」…難懂的詞，是坎瑞亞人的術語嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030313,
					"content": "正如深淵教團所想，若能將「眼」置於「污穢逆位神像」之手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030314,
					"content": "以此作為基底，接合「漩渦之魔神」奧賽爾的肢體，製造機械魔神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030315,
					"content": "就能為新誕生的污穢魔神，賦予「動搖天空島上神座」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030316,
					"content": "極端又危險的行為…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030319,
					"content": "那那那，這「眼睛」該怎麼處理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030320,
					"content": "找個隱秘的地方藏起來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "不。由我來保管它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030323,
					"content": "欸？！你？戴因…你該不會拿它去做奇怪的事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030324,
					"content": "隨妳質疑我的立場吧，但我必須確保它的力量不被旁人利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030325,
					"content": "隱秘之地會被挖掘，而教會——在我眼中不值得信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030326,
					"content": "呃…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030327,
					"content": "不僅如此，為了永絕後患，我們還要「處理」那座「污穢逆位神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030328,
					"content": "怎麼處理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "不能讓教會介入，我們自己處理。至於「處理」的意思…自然是銷毀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030331,
					"content": "銷、銷毀？！可是，那是七天神像啊！不僅是很有意義的文物，而且是真正的、神靈的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030332,
					"content": "幸虧之前瞞著芭芭拉，否則她現在一定會瘋的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030333,
					"content": "呵…七神之物，難道還要我幫他們悉心愛護？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030334,
					"content": "走吧，回<color=#00E1FFFF>那座遺蹟</color>。我們去砸毀逆位的神像，而且，運氣好的話，還能遇到「深淵使徒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030335,
					"content": "#有我在，它就不可能再從{F#妳}{M#你}眼前消失一次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030329,
					"content": "可以交給教會去處理嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "交給西風教會保管吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "一定要阻止深淵教團。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
