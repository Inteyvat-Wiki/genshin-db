					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030501,
					"content": "看來，我們到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030502,
					"content": "#怪異、枯萎…令人不快的房間。我理解{F#妳}{M#你}們所說的厭惡的氣氛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030503,
					"content": "嗚嗚嗚…還是這麼恐怖的環境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030504,
					"content": "小心，不要被「污穢逆位神像」的力量壓倒了——「深淵使徒」就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030505,
					"content": "呵呵呵呵…敏銳的嗅覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80030506,
					"content": "你還是這麼討人厭啊，教團之敵，戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80030507,
					"content": "我能感受到，你身上有股可怕的血腥味。是來自漆黑的惡夢，亦或是…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80030508,
					"content": "噢噢…真危險。你也有那種「腐朽」的味道，讓我熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80030509,
					"content": "你和我們一樣，都是危險的事物。但「教團」以外的危險之物，都該被放在籠子裡才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80030510,
					"content": "嘖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030511,
					"content": "你的舌頭，恐怕也「腐朽」了太久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030512,
					"content": "該切了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				}
			]
