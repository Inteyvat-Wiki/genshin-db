			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "那，那個人，難道就是…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030202,
					"content": "#{F#哥哥}{M#熒}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#熒}{M#哥哥}…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "#終於找到{F#你}{M#妳}了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#等…等等，{NICKNAME}，{F#他}{M#她}剛才替深淵使徒擋住了攻擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030207,
					"content": "#{F#妳}{M#你}的{F#哥哥}{M#妹妹}好像和「深淵」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030208,
					"content": "#{F#熒}{M#哥哥}，為什麼{F#妳}{M#你}和戴因在一起？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "…什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "（我們分離了這麼久…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030214,
					"content": "#{NICKNAME}，{F#妳}{M#你}的{F#哥哥}{M#妹妹}…認識戴因？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030216,
					"content": "#{F#空}{M#熒}，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030217,
					"content": "#這…這究竟是怎麼回事？戴因也知道{F#他}{M#她}的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030218,
					"content": "#{F#熒}{M#哥哥}…{F#妳}{M#你}不該和這個人同行的。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "這個人…是我的「敵人」。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#空}{M#熒}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030221,
					"content": "等一下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "……",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "#但這是我必須告訴{F#妳}{M#你}的話，{F#熒}{M#哥哥}。不要和戴因聯手阻止我。不要阻止「深淵」。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "那個人…戴因斯雷布。他是坎瑞亞末代宮廷衛隊的「末光之劍」。在五百年前，他未能阻止坎瑞亞的滅國。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "那時他身受不死詛咒，流浪荒野…只能看著他想要守護的人民，化作深淵的怪物。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "#{F#你}{M#妳}說…戴因是坎瑞亞人？！五百年前經歷滅國的坎瑞亞人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030228,
					"content": "#而且{F#你}{M#妳}說「人民化作怪物」…是說現在的深淵教團，不止是「和坎瑞亞有關聯」的程度，根本就是坎瑞亞的「遺民」本身嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030229,
					"content": "#嗚…還有「戴因是{F#妳}{M#你}的敵人」什麼的，一下子完全搞不清狀況了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030230,
					"content": "#先跟我走吧，{F#哥哥}{M#熒}！我們回家吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "家…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "#嗯，當然了。有{F#熒}{M#哥哥}在的地方就是家。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "#但我還不能與{F#妳}{M#你}去往下一個世界、尋找新的家園…至少現在不能。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "在「深淵」淹沒神座之前，我與「天理」，有一場尚未完結的戰爭…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "天…理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#聽我說，{F#熒}{M#哥哥}。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#我已經有過一次旅行。所以，{F#妳}{M#你}也要像我一樣抵達終點，才能在自己的眼中，留下這個世界的沉澱。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "這些事以後再告訴我，我們回家吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#別再說我聽不懂的話了，{F#空}{M#熒}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "（為什麼在說…無關的事？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "#{F#你}{M#妳}問…戴因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "快跟我走！這裡很危險！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
