			"dialogs": [
				{
					"id": 722080201,
					"content": "#謝謝{F#妳}{M#你}！現在我終於可以放心登船了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080202,
					"content": "那船是去往哪裡的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "金的土地，夢的土地。沒有迷霧的國度…我們會在睡夢中再見，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊部"
				}
			]
		},
