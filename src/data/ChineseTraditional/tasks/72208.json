			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "呵呵，雖然釣技不錯，但還有提高空間哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080102,
					"content": "欸？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "哎呀，對不起，對不起…總是忘了打招呼，忘記自己會嚇到別人…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080105,
					"content": "居然還一副樂在其中的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "沒辦法嘛，偶爾嚇唬一下小孩子還是挺好玩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080107,
					"content": "咳咳，我們說回釣魚的事情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080108,
					"content": "是正事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "說來丟人，是這樣的啦…先前在釣魚時，我不小心遺落了牧梨交給我的護身符…裡面有著她的祖靈與雷鳥大人的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080111,
					"content": "這麼重要的東西，如果登船時讓她知道被我搞丟了，可就不得了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080112,
					"content": "#金色的撐船人答應會尋人來幫我一起找…可是等到現在都沒有人影…我就想，既然{F#妳}{M#你}來了，也請拜託幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080113,
					"content": "之前還以為你挺可靠的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "#我經常釣魚的地點就在那邊…可是記憶越來越稀薄了，可能要麻煩{F#妳}{M#你}多找一找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080116,
					"content": "既然是舊日記憶中的場所…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "#唔…{F#妳}{M#你}說什麼？那是外人用來尋找地點的方法嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080119,
					"content": "唉…總之，如果找對地方的話，直接就地搜尋就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080120,
					"content": "我該怎麼搜尋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "呃…用釣的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080122,
					"content": "…可以吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "#雷鳥大人和祖靈護佑{F#妳}{M#你}！拜託{F#妳}{M#你}了，外人朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080117,
					"content": "用「羽毛」應該可以看到吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "真拿你沒辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "在逢嶽之野西邊，面對著三重瀑布的小島…就在那小島更西邊的海裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "伊部"
				},
				{
					"id": 722080109,
					"content": "這人怎麼還在想著釣魚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "請你先打招呼再出現！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
