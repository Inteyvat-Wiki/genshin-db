	"talks": [
		{
			"id": 7301702,
			"completionStepIds": [
				7301702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
