			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭貢迪",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "大樹的根，很好，可以聽到潮濕的呼吸，是昏昏欲睡的曲調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170402,
					"content": "喔…還是沒聽懂蘭貢迪在說什麼，不過算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170403,
					"content": "說起來，裡面居然有這麼大的空間，這就叫「盤根錯節」嗎？而且，總覺得這裡的氛圍和其他地方很不一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170404,
					"content": "要在這種地方找到給法留納神機輸送能量的「葉」嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170405,
					"content": "在這裡，但是又不在。聽得到它的聲音，聞得到它的氣息，看得到它的脈絡，但是派蒙找不到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170406,
					"content": "啊？那是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170407,
					"content": "派蒙找不到，那我呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "金色的那菈，看得到旋律，像夜晚的涼風，倏忽而至的雨，破碎湖面一千片的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170409,
					"content": "聽起來很厲害的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#不愧是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170411,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#嘿嘿…不對啦！{NICKNAME}這不是在搶我的詞嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170413,
					"content": "#那菈{NICKNAME}變成派蒙…比在無留陀和蘑菇一起跳舞更可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170414,
					"content": "無法想像…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "所以說這種事情是不會發生的啦！最好是不要發生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170416,
					"content": "蘭貢迪也是，就不能說得明白點嗎？我們到底要去哪裡找法留納神機的「葉」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170417,
					"content": "在夢裡找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170418,
					"content": "喔…等等，那你為什麼不一開始就這麼說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170419,
					"content": "因為派蒙問為什麼，沒有問在哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170420,
					"content": "欸…我好像突然明白蘭那羅的交流方式了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170421,
					"content": "蘭貢迪可不可以告訴我們要找的三個「葉」分別具體在哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170422,
					"content": "可以呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170423,
					"content": "哇，蘭貢迪是真的只會回答被直接問到的問題…好吧，那這三個地方具體在哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170424,
					"content": "在這邊、那邊和另一邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170425,
					"content": "嗯嗯…不是，你這不是什麼也沒說嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170426,
					"content": "派蒙大失敗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#派蒙大失敗和{NICKNAME}大失敗是一回事啦！蘭貢迪的話根本沒辦法參考嘛…我們該怎麼找到那三個地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170428,
					"content": "法留納神機是最了不起的蘭那羅造的，「枝」和「葉」的聯繫，看不見，又看得見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170429,
					"content": "#那菈{NICKNAME}看得見蘭那羅，看得見蘭那羅的痕跡，就能找到方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170430,
					"content": "我、我居然聽懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170431,
					"content": "跟著蘭那羅的痕跡就能找到，對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "嗚嗚…至少把這次回答的機會讓給我嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
