			"dialogs": [
				{
					"id": 730171001,
					"content": "潮濕的夢，乾燥的夢…叮咚，滴答，沙沙，是桓那的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171002,
					"content": "#那菈{NICKNAME}？「葉」在夢裡，「枝」在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭貢迪"
