			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭貢迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171202,
					"content": "聽到了，嗚咽變成了婉轉的曲調，但是要匯入聲音的大流還需要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171203,
					"content": "還需要蘭貢迪幫忙！嘿嘿，接下來就拜託你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171204,
					"content": "蘭貢迪知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171205,
					"content": "喔！這樣應該沒問題了吧！希望能快點治好法留納神機，不然水天叢林那邊全是孢子…光是想想就…阿嚏——嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171206,
					"content": "真不敢相信蘭那羅居然對孢子沒什麼反應…難道蘭那羅都不會受影響嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171207,
					"content": "蘭那羅會煮蘑菇，不是沒事。「孢子」，太小太多，抓不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171208,
					"content": "法留納神機沒有壞的時候，桓那沒有這麼多蘑菇，所以治好法留納神機，都會變好。除了無留陀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171209,
					"content": "一定會變好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#對呀，我和{NICKNAME}也會幫忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171211,
					"content": "無留陀也會有辦法解決的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#那菈{NICKNAME}是那菈法留納嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171213,
					"content": "欸？為什麼突然這樣問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171214,
					"content": "蘭般度說，那菈法留納是金色的、勇敢的那菈，和蘭那羅一起治好了法留納神機，趕走了黑色的雨和泥，帶回了月亮和太陽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171215,
					"content": "#那菈{NICKNAME}也幫蘭那羅治法留納神機，也是金色的、勇敢的那菈，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171216,
					"content": "可是，那菈法留納不是很早以前的人嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171217,
					"content": "#那菈法留納沒有又回到桓那嗎？那菈{NICKNAME}是完全不一樣的那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171218,
					"content": "不一樣的那菈，也會有相似的旋律嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171219,
					"content": "也許吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "蘭貢迪沒有見過那菈法留納，但是蘭般度講了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171222,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的旋律，一定和那菈{NICKNAME}一樣，聽到就會開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730171223,
					"content": "#是喔，我只要和{NICKNAME}在一起，總是很開心！如果哪天就像那菈法留納離開森林一樣，{NICKNAME}也要離開我的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171224,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171225,
					"content": "#蘭般度一定在「歇腳處」等我們了，那菈{NICKNAME}，和蘭貢迪一起回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "蘭貢迪"
				},
				{
