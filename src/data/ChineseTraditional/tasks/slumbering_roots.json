			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭貢迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "喔！總算找到你啦！你就是蘭貢迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170202,
					"content": "我可以不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170203,
					"content": "嗯？這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170204,
					"content": "因為我可以是樹，可以是雨，可以是桓那的夢，也可以是樂器的弦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170205,
					"content": "喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170206,
					"content": "#完全沒聽懂他在說什麼呢！{NICKNAME}，{F#妳}{M#你}知道他在說什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170207,
					"content": "我也沒聽懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "感覺每個字都知道是什麼意思，但是連成句子就聽不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170213,
					"content": "金色的那菈，和會飛的小東西，為什麼要找蘭貢迪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170214,
					"content": "我不是什麼「會飛的小東西」啦！等等，我好像確實是…？哎！總之，我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170215,
					"content": "#「金色的那菈」也有自己的名字，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}叫{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170216,
					"content": "是蘭般度告訴我們的，說蘭貢迪在夢景林莽，讓我們來看看情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170217,
					"content": "派蒙可以告訴蘭般度，蘭貢迪很好，夢景林莽很好，潮濕的夢也很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170218,
					"content": "#好喔…{NICKNAME}，那我們回去找蘭般度吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170219,
					"content": "…才不是啦！我們是來治好法留納神機的！好險，差點被牽著鼻子走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170220,
					"content": "派蒙可以告訴蘭般度，蘭貢迪不想牽派蒙的鼻子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170221,
					"content": "蘭般度可能不想知道這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "我也不想知道啦！這個蘭那羅到底是怎麼回事嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170223,
					"content": "記得蘭般度說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "蘭般度提到蘭貢迪的時候說，「他和那菈更疏遠」…意思是，他不知道怎麼和人交流嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170225,
					"content": "是我們不知道怎麼和蘭那羅交流。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "啊！說的也是，「入鄉隨俗」，應該是我們學習他們的交流方式才對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170227,
					"content": "不過，事到如今仔細想想，蘭那羅的交流方式到底是什麼樣的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170228,
					"content": "會飛的小東西覺得呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "金色的那菈都不知道，會飛的小東西怎麼會知道呢？不如我們來問問神奇的蘭貢迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170233,
					"content": "蘭貢迪可不可以告訴我們，蘭那羅之間到底是怎麼交流的呢？我們也想認真學習一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170234,
					"content": "為什麼要學？那菈是那菈，派蒙是派蒙，蘭那羅是蘭那羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170235,
					"content": "…啊，知道了，派蒙也想變成種子埋進土裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170236,
					"content": "不想！一點也不想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170237,
					"content": "那金色的那菈想要變成種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170238,
					"content": "謝謝，不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "種子很好，可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170242,
					"content": "扯了半天都快忘記我們來這裡的目的了，是無憂節！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170243,
					"content": "為了無憂節，我們得把法留納神機治好，這樣天氣就會恢復正常了，也不會有那些討人厭的孢子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170244,
					"content": "派蒙說得對，為了無憂節，為了蔚藍大地的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170245,
					"content": "濕氣氤氳的夢景林莽很好，但是「孢子」不好，會跑的蘑菇也不好，雨太多了，蘑菇也變得難煮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170246,
					"content": "喔！你這樣不就很清楚嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170247,
					"content": "#我們去治好法留納神機，那菈{NICKNAME}和派蒙跟蘭貢迪走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730170240,
					"content": "如果可以的話，好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "別信口胡說呀，他會當真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170230,
					"content": "總之先試試比喻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "那我試試！金色的那菈，就像…就像…唔…就像提瓦特煎蛋一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170232,
					"content": "…我們還是問問蘭貢迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170209,
					"content": "大概能猜到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "太厲害了！那麼他的話到底是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170211,
					"content": "他說他可以變形成很多其他的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#真的嗎？{NICKNAME}可不要騙我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301704",
							"2"
						],
						"stepId": 7301704,
