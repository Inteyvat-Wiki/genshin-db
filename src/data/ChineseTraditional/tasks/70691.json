			"dialogs": [
				{
					"id": 706910101,
					"content": "#{M#榮譽騎士哥哥}{F#榮譽騎士姐姐}！這邊這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910102,
					"content": "可莉交到了新朋友！要和我們一起玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910103,
					"content": "哥哥姐姐們教我們一種新遊戲，叫做「雪白迷蹤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910104,
					"content": "規則也不難，就是很特別的捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910105,
					"content": "哇哇，可莉、瑤瑤和早柚，妳們變成朋友了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910106,
					"content": "聽這個遊戲的名字，像是「風行迷蹤」的改良版？和妳們一起玩，一定非常好玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910107,
					"content": "好啊好啊，捉迷藏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "哈啾…雖然在營地裡就不怎麼冷了，但還是有點睏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910110,
					"content": "#唔？我是不是眼花了，怎麼好像看到{NICKNAME}和派蒙了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910111,
					"content": "#妳沒有眼花哦，{NICKNAME}和派蒙的確來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "瑤瑤"
				},
				{
					"id": 706910112,
					"content": "妳們好啊，瑤瑤和早柚！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "動起來，開開心心玩遊戲，就不會打瞌睡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910115,
					"content": "那位嚴肅的菫葵小姐不是也說過嗎？早柚在雪山多轉轉，也對自己的本領有好處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "瑤瑤"
				},
				{
					"id": 706910116,
					"content": "呃…妳們居然都記住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910117,
					"content": "好吧…如果輸給那幾位同行，甚至是超級忍犬的話…之後偷懶肯定會被抓得更嚴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910118,
					"content": "看來這次出遠門的修行，的確要認真起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910119,
					"content": "沒事哦，我準備了新做法的蔬菜燉肉，加入了絕雲椒椒和胡椒的粉末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "瑤瑤"
				},
				{
					"id": 706910120,
					"content": "開玩之前吃幾口，整場捉迷藏都不會冷哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "瑤瑤"
				},
				{
					"id": 706910121,
					"content": "太好了！待會我先來一整碗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910122,
					"content": "我也要，我也要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910123,
					"content": "那——雪山捉迷藏，準備開始啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910124,
					"content": "嘿呀！雪山到處都是白色，我躲起來絕對不容易被發現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910113,
					"content": "要一起來玩捉迷藏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "讓我也認識一下可莉的新朋友~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}