				]
			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "#兩、兩位！請{F#妳}{M#你}們留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780102,
					"content": "怎麼啦，小妹妹，妳有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780103,
					"content": "「承載綻放刺梨的奇蹟，用聖火點燃你的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780104,
					"content": "欸、欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780105,
					"content": "「以悠悠度假村之名，為你獻上歡迎的舞蹈，閃耀吧！皮皮潘偶像！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780106,
					"content": "啊！這句臺詞，又來了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780107,
					"content": "#嗯，是我，「希頓」。嘿嘿，好久不見啊！我又來了！{NICKNAME}{M#哥哥}{F#姐姐}、派蒙姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780108,
					"content": "原、原來是妳啊，「希頓」，我還以為又遇到了什麼可怕的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780109,
					"content": "遇到什麼開心事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "#嘿嘿，我跟{F#妳}{M#你}們說，老爹準備親自指導我，要把我打造成合格的演員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780112,
					"content": "雖然他嘴上凶凶的，結果還是很關照妳的嘛！當然，要是他沒有教妳奇怪的東西就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780113,
					"content": "#對了，這個送給{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780114,
					"content": "這、這是妳的演出服？但是沒有了這個的話，妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780115,
					"content": "嘿嘿，不用擔心，老爹他幫我做了一套更適合我體型的演出服！這次我絕對不會再在舞臺上摔倒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780116,
					"content": "#至於原來的演出服，我已經把它做成擺飾，請{F#妳}{M#你}們收下，把它當成我們友誼的象徵吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780117,
					"content": "#等到下次見面，我會穿上新的演出服，為{F#妳}{M#你}們獻上歡迎的舞蹈的！所以請{F#妳}{M#你}們以後一定要來捧場，我會等著{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780118,
					"content": "嗯，我們一定會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780119,
					"content": "「希頓」！該回來訓練了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780120,
					"content": "#好啦，時間不早了，我準備去鍛煉肌肉了！{NICKNAME}{M#哥哥}{F#姐姐}、派蒙姐姐，再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752780121,
					"content": "嗯嗯，再見哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780122,
					"content": "（妳真的會去嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "一定會的！當然…如果那個時候能看到普通的「偶像」表演就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752780110,
					"content": "最近怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}