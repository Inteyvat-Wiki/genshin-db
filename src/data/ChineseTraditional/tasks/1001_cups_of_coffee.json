			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪達赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "以前在璃月…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "嗯？璃月嗎…我聽商隊的人說，那裡的諸方勢力在神明隕落之際明爭暗鬥，應該會是個不錯的題材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000502,
					"content": "但從商隊那邊能打聽到的，也只是一些斷斷續續，聽起來還不太可靠的傳言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000503,
					"content": "比如說…「一名旅行者著手操辦了送仙典儀，成為各方勢力爭相拉攏的對象」什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000504,
					"content": "確實是參與了送仙典儀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "#唔，再比如說…「{M#他}{F#她}與漩渦之魔神在海上激戰，就連那座群玉閣都被凌厲的劍氣波及，生生墜入海中！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000507,
					"content": "確實是跟魔神對峙過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "#欸！那這則呢？「最後{M#他}{F#她}憑一己之力調停了仙凡間的矛盾，璃月港就此迎來了新的時代。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000510,
					"content": "確實是平息了矛盾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "是靠璃月人的共同努力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "擊退魔神的關鍵是群玉閣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "其實都是在和某人跑腿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
