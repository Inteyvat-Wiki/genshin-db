			"dialogs": [
				{
					"id": 230001401,
					"content": "咳咳，今天要講的故事發生在遙遠的異國。各位請聽：「風與巨龍之詩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001402
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230001402,
					"content": "…彼時那巨龍已降臨，無人知曉其真名。誰人能解蒙德危急，誰人能救此地生靈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001403
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230001403,
					"content": "…勇士伴風而行、詩人撫琴低吟：何故千年守護一朝棄，只因深淵毒血亂龍心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001404
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230001404,
					"content": "…魔風息、毒血淨。後世之子孫，勿忘其名姓，此詩獻予東風之龍特瓦林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001405
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230001405,
					"content": "嘿！這次的故事終於有趣一點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001406
					],
					"speakerTitle": "乃亞卜"
				},
				{
					"id": 230001406,
					"content": "被視作反派的角色其實有著無可奈何的背景…不管在什麼故事裡都讓人動容啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001407
					],
					"speakerTitle": "伊澤姆"
				},
				{
					"id": 230001407,
					"content": "今天的故事就到這裡，歡迎各位下次再來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪達赫"
				}
			]
