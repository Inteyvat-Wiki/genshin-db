			"dialogs": [
				{
					"id": 230000600,
					"content": "以前在稻妻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000601
					]
				},
				{
					"id": 230000601,
					"content": "嗯？雷神庇佑的稻妻嗎…我聽商隊的人說，那裡有人忤逆了神明頒佈的「眼狩令」，應該會是個不錯的題材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000602,
					"content": "但從商隊那邊能打聽到的，都是一些斷斷續續，聽起來還不太可靠的傳言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000603,
					"content": "比如說，「一位異鄉人向愚人眾執行官發起決鬥，一刀就將對手化為灰燼！」什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000604,
					"content": "確實是贏下了決鬥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "#唔，再比如說，「{M#他}{F#她}直面將軍的威壓，毫髮無傷地從『無想的一刀』下逃出生天！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000607,
					"content": "確實是從刀下逃生了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "#欸！那這則呢？「最後{M#他}{F#她}從千手百眼神像中汲取力量，扭轉了神明的意志…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000610,
					"content": "確實改變了將軍的心意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "制勝關鍵是大家的「願望」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "擋下那一刀的是別人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "降下制裁的是將軍啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				}
			]
		},
