			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪達赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "以前在蒙德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "嗯？風神眷顧的蒙德嗎…我聽商隊的人說，那裡出現了一頭掀起狂風的巨龍，應該會是個不錯的題材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000402,
					"content": "但從商隊那邊能打聽到的，也只是一些斷斷續續，聽起來還不太可靠的傳言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000403,
					"content": "比如說…「一名背生雙翼的旅行者破空而來，在萬尺高空之上與巨龍展開追逐！」什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000404,
					"content": "確實是在空中追擊過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "#唔，再比如說…「{M#他}{F#她}隻身潛入教會，盜取了寄宿著風神偉力的強大武器！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000407,
					"content": "確實是潛入過教會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "#欸！那這則呢？「最後{M#他}{F#她}看破巨龍弱點，擊碎舊日創口。沐浴著龍血成為不死之身！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "瑪達赫"
				},
				{
					"id": 230000410,
					"content": "確實是要瞄準某處…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "只是在淨化影響心智的毒血。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "「天空之琴」不是什麼武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "其實是靠風之翼啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
			"id": 2300005,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
