					"nextDialogs": [
						230001006
					],
					"speakerTitle": "乃亞卜"
				},
				{
					"id": 230001006,
					"content": "主角一上來就動手，不由分說就把巨龍打倒…總感覺這個故事哪裡怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
