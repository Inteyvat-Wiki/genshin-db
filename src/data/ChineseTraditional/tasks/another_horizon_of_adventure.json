			"dialogs": [
				{
					"id": 746670201,
					"content": "向著星辰與深淵！歡迎來到冒險家協會，請問有什麼可以幫您的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 746670202,
					"content": "又、又是凱瑟琳。這一位應該也是「人偶」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670203,
						746670204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746670203,
					"content": "應該是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670205
					]
				},
				{
					"id": 746670205,
					"content": "請問我有什麼可以幫您的嗎？您是想要接取委託，還是發放委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670206
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 746670206,
					"content": "我只是順便來看一眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670207
					]
				},
				{
					"id": 746670207,
					"content": "這樣啊…如果您遇見了任何和協會有關的問題，都可以來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670208
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 746670208,
					"content": "我會竭誠為您提供最完善的服務，解答一切能夠解答的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670209
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 746670209,
					"content": "那麼，感謝您對協會做出的貢獻，冒險家。祝您的冒險旅途一帆風順！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 746670204,
					"content": "應該沒有第二種可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
