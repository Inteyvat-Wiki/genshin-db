	"talks": [
		{
			"id": 7370301,
			"completionStepIds": [
				7370301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370301",
							"2"
						],
						"stepId": 7370301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉米雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737030101,
					"content": "啊，那邊的、那邊的兩位請留步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030102
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030102,
					"content": "這裡有一個新的有獎小遊戲想要兩位參加，呵呵，只要完成了挑戰，就能夠獲得豐厚的實驗資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030103
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030103,
					"content": "實驗資金？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030104,
					"content": "啊不是，一時口快說錯了，只要完成遊戲並且填寫完問卷就會獲得挑戰獎金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030105
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030105,
					"content": "挑戰也很簡單哦，輕輕鬆鬆就能拿到獎勵的機會可不多哦，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030106
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030106,
					"content": "唔，看起來有點可疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030107,
						737030108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030107,
					"content": "是什麼新型詐騙嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030109
					]
				},
				{
					"id": 737030109,
					"content": "哎、哎，別這樣，別一言不合就懷疑別人嘛，好吧，我知道在這種地方邀請路過的人進行莫名其妙的挑戰確實有點不合常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030110
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030110,
					"content": "但是聽我辯解，不是，聽我解釋一下嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030111
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030111,
					"content": "好吧，那就給妳一個狡辯的機會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030112
					]
				},
				{
					"id": 737030112,
					"content": "雖然兩位可能看不出來，其實我是個教令院生論派的學者…我的名字叫拉米雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030113
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030113,
					"content": "是學者這點還滿明顯啦，畢竟穿著教令院的衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030114,
					"content": "呵呵，這可不一定，說不定也有假扮學者騙人的傢伙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030115
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030116,
					"content": "我可不是說我自己啊，欸呀，只是提醒一下兩位，我真的是生論派的學者啦，是各位風紀官筆記本裡也排得上名號的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030117
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030117,
					"content": "在風紀官的筆記本裡排得上名號真的是好事嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030118,
					"content": "咳咳，總之，兩位…哦對了，還沒請教兩位的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030119
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030119,
					"content": "我的名字是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030120,
					"content": "#我是{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030121
					]
				},
				{
					"id": 737030121,
					"content": "#呵呵，{NICKNAME}和派蒙，那我就為兩位解釋一下，這個挑戰到底是怎麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030122
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030122,
					"content": "其實這都和我童年的時候讀的故事有關，那是一個小少年變成貓，然後在貓的國度冒險的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030123
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030123,
					"content": "那個故事很可愛，呵呵，主角和美麗貓親近以後重新變回人，和美麗貓最終變成主人和寵物的關係作為結局也很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030124
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030124,
					"content": "不，這個結局顯然很奇怪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030125,
					"content": "最後少年主角還發現美麗貓是一隻公貓，我還覺得這結局滿有文學性的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030126
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030126,
					"content": "呵呵…扯遠了，就是因為這個故事裡有很多描寫是以小動物的第一人稱視角出發，讓我很感興趣，成為學者以後，也一直在做類似的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030127
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030127,
					"content": "透過研發出來的裝置和成熟的虛空技術，就可以連接各種動物們的視覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030128
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030128,
					"content": "這個聽上去終於正經了起來，不過，也像是在用教令院的經費滿足自己的夢想呢，這就有點「公報私仇」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030129,
					"content": "哈哈，應該算是有點「公器私用」啦。雖然確實有點私心，不過這本來也是比較有實際應用前景的課題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030130
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030130,
					"content": "在災後搜尋需要救助的人員，或者查探坍塌的古遺蹟，小動物們會比我們更加靈活，如果能夠借用牠們的視覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030131,
						737030137
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030131,
					"content": "就能潛入不該潛入的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030132
					]
				},
				{
					"id": 737030132,
					"content": "什麼叫不該潛入的地方啦，拉米雅說的用途明明就很正經。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030133,
					"content": "#呵呵，確實如此，真是敏銳啊{NICKNAME}，人會對同類有戒心，但是往往會對動物網開一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030134
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030134,
					"content": "欸——別真的用在奇怪的用途上啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030135,
					"content": "開玩笑的，開玩笑的，每次這種技術的應用都會留下紀錄啦，幹壞事也會立刻被抓到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030136
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030136,
					"content": "不過，怎麼樣，聽起來是很了不起的研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030141
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030141,
					"content": "聽起來倒是還滿厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030142,
					"content": "本來可以慢慢進行研究，可、可是妙論派的傢伙，居然也在做應用前景差不多的課題，他們打算用小型機關來做類似的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030143
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030143,
					"content": "簡、簡直就是邪魔外道！比起冰冷的機關，還是小動物比較可愛吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030144
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030144,
					"content": "#對吧，{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030145
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030145,
					"content": "嗯，這個嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030146,
						737030148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030146,
					"content": "確實是動物比較可愛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030147
					]
				},
				{
					"id": 737030147,
					"content": "#我就知道{NICKNAME}一定能理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030151
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030151,
					"content": "反正，我現在如果不能更快拿出成果的話，一定會被妙論派的課題組搶先。只能出此下策，在野外招攬路過的人進行實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030152
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030152,
					"content": "#呵呵，{F#妳}{M#你}看，這不是什麼可疑的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030153
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030153,
					"content": "這樣一聽倒其實是正經的活動啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030154,
					"content": "「輕鬆拿獎勵的機會可不多…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030155
					]
				},
				{
					"id": 737030155,
					"content": "嗯，那我們就參加好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030156,
					"content": "呵呵，那就感謝兩位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030157
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030157,
					"content": "總之，先拿著這個，這個道具就是我研發出的「銘隨流鏡」，鏡子裡能夠顯現出與其用裝置連結的小動物視角中的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030158
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030158,
					"content": "「銘隨流鏡」會顯現出安裝在牠們身上的裝置裡所擷取到的影像。透過這個影像判斷牠們的位置，抓住牠們就可以領獎了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030159
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030159,
					"content": "咦，那牠們要是跑來跑去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030160,
					"content": "沒關係，呵呵，牠們都是受過訓練的動物，會在這個區域保持小範圍的移動，不會跑到特別遠的地方，這點還請不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030161
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030161,
					"content": "#好！{NICKNAME}，我們這就開始出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030148,
					"content": "我是「嘎嘎——機械」派的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030149
					]
				},
				{
					"id": 737030149,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030150
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030150,
					"content": "哼，不知道你在說什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737030137,
					"content": "就能更快找到要找的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737030138
					]
				},
				{
					"id": 737030138,
					"content": "正是如此，比如，如果能夠借用盜寶鼬的視覺，就能夠更快進行遺蹟發掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030139
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030139,
					"content": "如果能夠借用鳥類的視覺，那麼在高空進行俯瞰，天氣晴朗能見度高的時候，對地形勘測和觀察都會有很大的助益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030140
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 737030140,
					"content": "嗬嗬，怎麼樣，聽起來是很了不起的研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737030141
					],
					"speakerTitle": "拉米雅"
				},
				{
