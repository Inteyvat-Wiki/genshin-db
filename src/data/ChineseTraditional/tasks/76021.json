			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊爾瑪里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "今天也是空手而歸啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210402,
					"content": "你在這裡幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "釣魚。不過到目前為止只釣到些不是魚的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210404,
					"content": "要是沉船裡的小物品之類的倒好，遊商會收。之前釣起過靴子上還連著半截…唉，不說了，說多了魚都給嚇跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210405,
					"content": "附近有什麼值得注意的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "#{F#妳}{M#你}又來尋寶了？什麼只有在月之東、日之西才能找到的「偉大財寶」之類的…聽也知道不會是這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210407,
					"content": "過去這裡的確發生過不少船難，沉船裡或許的確有值錢的東西，不過那可不容易找啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210408,
					"content": "在酒館也聽倖存的水手說起過，那天晚上沒有月亮，在滔天的巨浪中卻能看到發光的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210409,
					"content": "他們說那一定就是獨眼的刻拉蒂了，是連月亮都能吞食的怪獸在和海中的巨蛇爭奪地盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210410,
					"content": "那之後很長一段時間，這一塊都像帳房的墨水瓶似的黑壓壓一片，沒有船敢冒險從這裡經過，都怕被水下的亡魂纏上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210411,
					"content": "不管那些亡魂現在是不是還在附近徘徊，反正我看不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210412,
					"content": "關於那棵樹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "那玩意是真的有點邪門。這裡原本有個漩渦，水手們管它叫「刻拉蒂之眼」，但突然有那麼一天這棵樹就這麼長出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210414,
					"content": "不過那陣子發生的怪事也不只這麼一件，想想看，都是在那些石頭從天上掉下來之後…搞不好這樹也跟石頭一樣來自天外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210415,
					"content": "還有那些偶爾能見到的亮晶晶的小東西，稀罕得很。想著說不定也會有新品種的魚吧，我就是為了這個才來碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210416,
					"content": "原本有個釣友和我一起，但他老說聽到奇怪的歌聲，嚇得不敢再來了。哼，雖然他只算半個霜月之子，但臭毛病是一點也不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210417,
					"content": "關於「識者之證」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "什麼「識者之證」，什麼只有在月之東、日之西才能找到的「偉大財寶」…我說啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210419,
					"content": "被貪慾驅使，追逐本不屬於自己的東西，絕對不會有好下場。就像阿特拉號，聽說船長格瑞蒂爾就是為這些東西著了魔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210420,
					"content": "最後落得個葬身海底的下場，寶藏卻不會永遠與他同眠，真是徹底白忙一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760210421,
					"content": "打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "沒關係。現在是一點魚的影子都看不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊爾瑪里"
				}
			]
		}
	]
}