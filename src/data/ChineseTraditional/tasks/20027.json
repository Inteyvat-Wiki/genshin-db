				"points": []
			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#謝謝，謝謝{F#妳}{M#你}，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270102,
					"content": "我本來是想去看看葡萄藤的情況，結果卻撞上這倒楣事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270103,
					"content": "#唉，請{F#妳}{M#你}別告訴我兒子，他是城裡的西風騎士。他平時工作肯定也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270104,
					"content": "我這個老頭子的一點小麻煩，就不要讓他再煩心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270105,
					"content": "但是最近，酒莊附近總是會出現史萊姆，我每天都在擔心葡萄藤會被史萊姆給毀了，睡也睡不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270106,
					"content": "如果你們有空的話，就幫我老頭子一個忙，再去周圍看看，把史萊姆都趕走，別讓它們再來破壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200270107,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "太好了，我總算能休息一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				},
				{
					"id": 200270108,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "#唉，本來說我自己來也行…但是老頭子我真的動不了了，年輕人，{F#妳}{M#你}就幫幫我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				}
			]
		}
	]
