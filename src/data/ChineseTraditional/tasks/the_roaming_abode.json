			"dialogs": [
				{
					"id": 711051101,
					"content": "#沒事的話老頭子就先走了，{F#妳}{M#你}們還想的話就隨便看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711051102,
					"content": "所以真的沒有香莙這個人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711051103,
					"content": "#老頭子會幫{F#妳}{M#你}們去打聽打聽，沒準是其它地方的小糊塗搞錯了家在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711051104,
					"content": "#也多謝{F#妳}{M#你}們跑了一趟，還替「仙人」澆了他的草藥，他知道了也會感謝{F#妳}{M#你}們，替{F#妳}{M#你}們避災的。",
					"roleType": "TALK_ROLE_NPC",
