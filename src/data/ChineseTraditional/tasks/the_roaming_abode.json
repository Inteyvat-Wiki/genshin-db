			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "「…雖然早就擔心有魔物…但…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050502,
					"content": "「…流了好多…大腿止不住…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050503,
					"content": "「…俺好睏…但懸練山就在前面了…香莙…俺一定會取到仙水的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050504,
					"content": "「…香莙…俺一定會取到仙水的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050505,
					"content": "糟糕了…他被魔物襲擊了，好像受傷很重的樣子…就這樣還要去懸練山取水嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050506,
					"content": "我們趕快過去吧，希望能幫到他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
