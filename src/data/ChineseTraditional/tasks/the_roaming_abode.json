			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "#哦…是旅行者啊，看{F#妳}{M#你}們匆匆忙忙的樣子，遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050802,
					"content": "我們…羅叔知道香莙和他的爺爺家在哪嗎？我們來找他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050803,
					"content": "香莙？沒聽過這個人，是我們這的嗎？莊裡的人，老頭子我應該都認識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050804,
					"content": "沒聽過？不會吧…我們在外面遇到了一個小女孩，她說她叫香莙，家就在翹英莊，她請我們幫她找爺爺的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050805,
					"content": "她還有一個大大的竹筏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050806,
					"content": "#唔…竹筏倒是容易見，但香莙這個名字…老頭子我確認，莊子裡沒有叫這個名字的人。她爺爺叫什麼{F#妳}{M#你}們知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050807,
					"content": "她爺爺是個採藥人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "採藥人？讓老頭子想一想，莊子裡以前的確有個採藥人…但他已經走了三年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050809,
					"content": "走了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050810,
					"content": "#在外面遭遇了魔物…唉…不過他應該不是{F#妳}{M#你}們要找的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050811,
					"content": "因為這位採藥人有點瘋瘋癲癲，一直沒有成家，所以更別提子孫後代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050812,
					"content": "這…這到底是怎麼回事啊？那我們遇見的那個香莙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050813,
					"content": "該不會她才是妖怪吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050814,
					"content": "莊裡的採藥人採的是什麼藥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "都是一些沒見過的花草。老頭子只懂點茶，哪懂那些啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050816,
					"content": "不過老頭子記得，他出事的時候，大家是在懸練山附近發現他的，那時候他手裡還緊握著一瓶水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050817,
					"content": "他說他家院裡有株仙草，一定要澆那種仙水才能成活。老頭子看他真是糊塗啊，都是河裡的水，有什麼特別的？為了這個搭上了性命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050818,
					"content": "唉…死者為大，我們把他安葬之後，還是把他取來的水灑在了他家宅院裡，希望他走好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050819,
					"content": "懸練山的仙水？我們也去了那裡，還取了仙水了呢…這個採藥人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050820,
					"content": "感覺就是一個人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "#那還真是怪事了。不如…{F#妳}{M#你}們跟老頭子來一趟吧，老頭子帶{F#妳}{M#你}們去他的院裡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "羅叔"
				},
				{
					"id": 711050822,
					"content": "#{F#妳}{M#你}們要是也取了水，就灑在他的院裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅叔"
				}
			]
		},
