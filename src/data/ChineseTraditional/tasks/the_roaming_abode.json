			"dialogs": [
				{
					"id": 711050101,
					"content": "爺爺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050102,
					"content": "咦？小朋友，妳怎麼大晚上的一個人在這裡？妳叫什麼名字啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050103,
					"content": "我是香莙…我來找爺爺…爺爺被妖怪抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050104,
					"content": "妖…妖怪？這裡有妖怪？什麼妖怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050105,
					"content": "我…我也不知道…是爺爺說的，他總說山裡有妖怪，所以讓我不要亂跑…但他已經進山三天沒回家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050106,
					"content": "那是嚇唬妳的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "我也覺得…他有說他進山做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050108,
					"content": "爺爺是莊裡的採藥人，最近採回來了一棵仙草，據說要用懸練山附近的仙水澆灌才能長大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050109,
					"content": "所以…他是不是遇到了什麼看守仙水的妖怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050110,
					"content": "小香莙，妳不要擔心，現在很晚了，妳爺爺可能只是遇到了什麼麻煩，我們先送妳回家好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050111,
					"content": "可我要去救爺爺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050112,
					"content": "我們可以幫妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050114,
					"content": "嗯！如果妳不回家的話，說不定會讓給妳爺爺添更多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050115,
					"content": "啊…我不能給爺爺添麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050116,
					"content": "所以我們去找他就好啦，妳家在哪裡呢？我們先送妳回家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050117,
					"content": "#不用不用，{M#哥哥姐姐}{F#兩位姐姐}，我家就在翹英莊，我可以自己回去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050118,
					"content": "#{F#妳}{M#你}們能立刻去找爺爺嗎？我擔心他有危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050119,
					"content": "我們倒是沒問題啦。那…妳知道妳爺爺是去了什麼地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050120,
					"content": "我只知道他是往那邊走的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050121,
					"content": "那我們就先去那邊找找看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "#謝謝{M#哥哥姐姐}{F#兩位姐姐}！那我現在就回去，不能給大家添麻煩…我會安安靜靜在莊裡等著好消息的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
