			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "「睡過頭了！要在明天前趕回去才行，否則香莙就沒人管了…俺真蠢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050202,
					"content": "「俺記得從藥蝶谷去懸練山中間有條小路…走小路，然後穿過一座山洞就能到了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050203,
					"content": "「聽說那附近有魔物，但現在也只能抄近道試試了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "誰人的筆記"
				},
				{
					"id": 711050204,
					"content": "看起來這就是那個爺爺留下的吧？他走小路去了！我們也去找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
