				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "咦？應該就是這裡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050602,
					"content": "怎麼沒有人呢？附近好像也沒有什麼痕跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050603,
					"content": "是不是已經回去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "感覺不太可能啊，香莙的爺爺受了傷，他能走那麼遠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050605,
					"content": "但他也不在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "會不會有人路上遇見了他，把他救回去了？我覺得很有可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050607,
					"content": "不然我們回去翹英莊問問看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050608,
					"content": "先取一點「仙水」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "#取仙水？嗯…{F#妳}{M#你}說的對，如果那個爺爺真的被救走了，他一定還會需要這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050610,
					"content": "#我們就當順便幫忙了。嘿嘿，{NICKNAME}，還是{F#妳}{M#你}想得周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
