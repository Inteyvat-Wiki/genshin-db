	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "#讓我想想，究竟是什麼，讓{F#妳}{M#你}再一次來到我的面前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200302,
					"content": "#{F#妳}{M#你}的愚勇，是為了庇護那些民眾，還是說…覲見我才是{F#妳}{M#你}的本意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200303,
					"content": "愚人眾誘導了雷電將軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "喔？將我從永恆的冥思中喚起，該不會就是為了說這些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200306,
					"content": "#那{F#妳}{M#你}是否有些過於小覷我了。眼狩令的事，我當然知曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200307,
					"content": "外面的事妳都知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "並非如此，我知道的只是一切關於「永恆」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200309,
					"content": "包括眼狩令的頒佈，也是由我所默許的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200310,
					"content": "而那些愚人眾的所為，尚未構成對永恆的威脅，否則…他們早已被肅清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200311,
					"content": "可是眼狩令…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "願望本就是不利於永恆的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200314,
					"content": "#{F#妳}{M#你}或許還沒有意識到，追逐願望…往往會讓人失去更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200315,
					"content": "正如，收繳神之眼一事本身，並不會有人因神之眼離身而喪命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200316,
					"content": "丟掉性命的，反而會是那些執意要追逐願望的人，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200317,
					"content": "哲平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#旅者，{F#妳}{M#你}在我眼中的確是特殊的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200319,
					"content": "#{F#妳}{M#你}的身上似有數之不盡的不確定性，換言之，{F#妳}{M#你}與「永恆」相距最遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200320,
					"content": "#所以，我無意要{F#妳}{M#你}理解其中意義，僅由此身為這天下人間代行「永恆」之道便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200321,
					"content": "此處是妳的「一心淨土」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "是由妳的意識所構成的空間，對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "#沒錯，{F#妳}{M#你}居然會清楚這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200324,
					"content": "#罷了，{F#妳}{M#你}是在尋找…動搖我意志的機會，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200325,
					"content": "我不想和妳爭論了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "我會直接將妳「駁倒」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200328,
					"content": "#好吧，「違逆永恆之人」，讓我看看…{F#妳}{M#你}的覺悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200312,
					"content": "讓稻妻的人民失去了很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "眼狩令本不該頒佈的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "妳敗了，影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200503,
					"content": "…是啊，我敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200504,
					"content": "為什麼不能相信妳的子民，相信他們願望的力量呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200505,
					"content": "那些願望已經超脫了距離、超脫了空間與時間，已經是無人能將其扼殺之物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200506,
					"content": "當人們全力以赴前進時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "#這是{F#妳}{M#你}在璃月的旅途收穫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200510,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "人類向前奔跑，將神明甩在身後的國度嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200512,
					"content": "可是我們又為何要自顧自…一廂情願地放棄前進呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200513,
					"content": "…前進所帶來的那些失去，妳也與我一同見證過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200514,
					"content": "唯有永恆，唯有永恆才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200515,
					"content": "天理…對我來說是不知所謂的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200516,
					"content": "總而言之，妳只是想永遠地守護妳心愛的稻妻，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200517,
					"content": "妳說得有些太過輕描淡寫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200518,
					"content": "可是這個國度，是否有永恆存在的價值呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200519,
					"content": "失去了願望，失去了變化，就僅僅是存在而已的國度，不過是一具空殼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200520,
					"content": "呵，那樣的話，就算毀滅了又何妨呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200521,
					"content": "神子，收回妳的妄言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200522,
					"content": "千世萬代不變不移的永恆，這是我給予臣民的許諾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200523,
					"content": "可是妳的臣民需要的，並非是妳的許諾，他們想要的是妳的「注視」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200524,
					"content": "…神之眼嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200525,
					"content": "人類的壽命僅有百年，他們無力承擔那些失去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200526,
					"content": "經歷過一切的我，才會選擇指引他們去往正確的「永恆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200527,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200528,
					"content": "…可是「永恆」對妳來說，太過殘酷了啊，影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200529,
					"content": "對我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200530,
					"content": "妳不僅不再去注視世人，也已經不再注視自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200531,
					"content": "幾百年來，一個人在這裡，一定很寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200532,
					"content": "可是這是必要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200533,
					"content": "不前進的話，也會錯過很多啊…在此靜止直到永恆的妳，不也在失去著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200534,
					"content": "明明忍受著這樣的孤獨，卻又要為了永恆，而把這份孤獨的時間尺度無限拉長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200535,
					"content": "告訴我，為何此地的天空曾是那樣晦暗…而偏偏此刻又泛起了光芒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200536,
					"content": "這裡是妳的「一心淨土」，是妳的內心世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200537,
					"content": "所以…其實妳很開心可以再次見到我，妳早已無法忍受此地的孤獨了，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200538,
					"content": "我…沒有什麼好說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200539,
					"content": "呵呵，那我可有說不盡的話要和妳講，喔對了，就讓我把這幾百年間的事情講給妳聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200540,
					"content": "幾百年間的事，要講多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200541,
					"content": "狐仙的記憶力可是很好的，幾百年間的每一個細節我都不會忘記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200542,
					"content": "所以大概要講個幾百年吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200543,
					"content": "呵…呵呵…神子，我本以為已經不會再有機會與妳這樣會面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200544,
					"content": "能見到妳，是永恆之中的變數…也算是驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200545,
					"content": "呵呵，既然妳老老實實承認了，還可以繼續做朋友喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200546,
					"content": "真是小孩子氣的談話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200547,
					"content": "#不過，既然我輸給了{F#妳}{M#你}們的計畫，那我便會依照{F#妳}{M#你}們的意志，廢除眼狩令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200548,
					"content": "但關於「永恆」，關於這個國家是否應該前進，我需要再考慮考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20200549,
					"content": "唉呀，自始至終小孩子氣的，都是妳啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200507,
					"content": "可以超乎神明的預料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "甚至將神明的工作取代。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
