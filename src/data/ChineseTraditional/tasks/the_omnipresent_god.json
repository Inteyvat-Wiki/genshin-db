			"dialogs": [
				{
					"id": 20210101,
					"content": "#{F#妳}{M#你}們在雷電將軍的「一心淨土」裡到底做了什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210102,
					"content": "眼狩令居然真的廢除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210103,
					"content": "主要是八重神子的功勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "欸，這樣啊…我還擔心得很呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210106,
					"content": "所以神子這次找我們，難道是要跟我們道謝嗎？嘿嘿…快過去找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210104,
					"content": "是人們的願望傳達到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
