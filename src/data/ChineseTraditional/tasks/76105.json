			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪爾塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}看到那些岩居蟹了嗎？好像在進行什麼神秘的儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050102,
					"content": "這就是牠們的生態吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "是這樣嗎？哦…我好像懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050104,
					"content": "那夏鎮也有很多人跟這些岩居蟹一樣，有的會勾肩搭背走在一起，有的一見面就拳腳問候然後分開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050105,
					"content": "這就是那夏鎮的生態吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050106,
					"content": "沒錯，你理解得很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#那{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}可以讓這些岩居蟹都進到小水潭裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050109,
					"content": "唔…就像把所有的寶藏獵人都叫去「旗艦」？感覺會很好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761051501,
					"content": "#好想看看岩居蟹都聚在一起的時候會發生什麼事哦…{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}現在有空嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪爾塔"
				},
				{
					"id": 761050107,
					"content": "好像有點微妙的區別，不過算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
