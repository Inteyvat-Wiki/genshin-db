			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "欸，太難了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760203,
					"content": "剛剛只是狀態不好而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760204,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}們要再試一次嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760205,
					"content": "#當然了！{NICKNAME}，我們要讓鯨井小弟見識一下我們的厲害才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760206,
					"content": "再來一次！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "好耶！目標是在限制時間內，找到手鞠哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井小弟"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{F#大姐姐}{M#大哥哥}好厲害，一下就找到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760703,
					"content": "#哼哼，{NICKNAME}可是身經百戰，去過很多國度的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760704,
					"content": "哇！難道，「蒙德」也去過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760705,
					"content": "當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "好厲害！聽那個大姐姐說，蒙德有很多很漂亮的地方，像是有好高好高的塔的「風龍遺蹟」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760707,
					"content": "是風龍廢墟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "嗯，不知道是那座塔比較高，還是將軍大人的天守比較高呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760710,
					"content": "鯨井小弟，你為什麼一個人在野外呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760711,
					"content": "因為姐姐釣魚的時候，嫌我會把魚嚇跑，就讓我自己出去玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760712,
					"content": "有一次，遇到了那個冒險家大姐姐。她看我無聊，就送了好多手鞠，讓我「找貪心的旅行者一起玩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760713,
					"content": "貪心的旅行者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "才不是貪心！是擔心！擔心鯨井小弟一個人很無聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760715,
					"content": "#是呀，我也覺得{F#大姐姐}{M#大哥哥}{F#妳}{M#你}們好好心，我很開心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760716,
					"content": "一個人待在野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "你一個小孩子待在野外，不怕遇到危險嗎？而且身上還帶著好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760718,
					"content": "#{F#大姐姐}{M#大哥哥}真好心。不過不用擔心，那個冒險家大姐姐教我，只要特別操作一下，手鞠就可以變成炸彈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760719,
					"content": "好危險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760720,
					"content": "不危險哦！丘丘人呀，史萊姆呀，壞蛋呀，我都炸跑好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760721,
					"content": "危險的是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760722,
					"content": "#對了，{F#大姐姐}{M#大哥哥}如果想要跟別的朋友玩手鞠的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760723,
					"content": "我留個手鞠放在這裡！它的規則是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760724,
					"content": "藏手鞠的時候，要在一首手鞠歌的時間內藏好。找的人呢，也在一首歌的時間內找到。這樣才公平嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760725,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "一想到我們玩的居然是炸彈，就覺得好害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760727,
					"content": "#{F#大姐姐}{M#大哥哥}不用怕，她還跟我說過「只會炸壞人。大概」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760728,
					"content": "「大概」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760729,
					"content": "#那，我去別的地方玩囉！{F#大姐姐}{M#大哥哥}再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760708,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}