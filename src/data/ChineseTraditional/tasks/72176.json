						],
						"stepId": 7217601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"鯨井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#嗨！{F#大姐姐}{M#大哥哥}，我這有好東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760102,
					"content": "謝謝，沒有興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "好可憐，年紀這麼小就被人逼著做可疑的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760104,
					"content": "#不是啦！我是想和{F#大姐姐}{M#大哥哥}玩手鞠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760105,
					"content": "「手鞠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760106,
					"content": "#簡單來說，我會把手鞠藏在附近的某個地方。在一首手鞠歌的時間內，如果{F#大姐姐}{M#大哥哥}能找到，那{F#大姐姐}{M#大哥哥}就贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760107,
					"content": "手鞠是這樣玩的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "咦？是一個很厲害的大姐姐冒險家教我的。她還說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760109,
					"content": "「鯨井，好好記住。你一定要說，『如果你贏了，就可以得到好東西』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760110,
					"content": "#所以，{F#大姐姐}{M#大哥哥}，如果{F#妳}{M#你}贏了，就可以得到好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760111,
					"content": "#是好東西！{NICKNAME}，我覺得陪小孩子玩是天經地義的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760112,
					"content": "可是我還是覺得手鞠不是這麼玩的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "可能是只有當地人才知道的玩法，不要在意這種細節嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760114,
					"content": "是鯨井小弟對吧？我們陪你玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760116,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井小弟"
				},
				{
					"id": 721760115,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
