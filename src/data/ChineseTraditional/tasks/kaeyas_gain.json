			},
			"dialogs": [
				{
					"id": 4630101,
					"content": "「阿卡狄亞遺蹟」就是這裡了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630102,
					"content": "怎麼說…感覺稍微有些普通？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630103,
					"content": "我明白了，正所謂越是普通的地方，越容易被人忽視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630104,
					"content": "真是深刻，凱亞的爺爺果然厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630105,
					"content": "——沙沙，咯噔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "嗯？派蒙，妳聽…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "是老鼠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630108,
					"content": "回答得太輕易了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "唔…別疑神疑鬼了，不會有什麼問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630110,
					"content": "動作要快！寶藏已經在裡面等我們很久啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 46303,
			"completionStepIds": [
				46303
