			"dialogs": [
				{
					"id": 4630001,
					"content": "這下謎團都解開啦，真是花了很多功夫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630014,
					"content": "不過話說回來，這張藏寶圖畫的還真是潦草呢…確實像是出自海盜之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630002,
					"content": "那麼現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630003,
					"content": "先去向凱亞彙報一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "嗯…？派蒙覺得，不，需，要，哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630006,
					"content": "不愧是派蒙的夥伴！和派蒙想的…完，全，一，樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630007,
					"content": "不直接過去的話，萬一被別人搶先可就麻煩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630008,
					"content": "比如凱亞…嗯，凱亞說過的「盜寶團」之類的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630009,
					"content": "總之，我最多只是想借來那把劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630010,
					"content": "不、不，只是想去看一眼而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630011,
					"content": "絕不是想著什麼天下無敵、高枕無憂吃喝玩樂…之類的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630012,
					"content": "好了，閒話就等到找到寶藏以後再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630013,
					"content": "阿卡狄亞尋寶之旅——正式啟程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630005,
					"content": "直奔藏寶地點吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
		{
			"id": 46301,
