				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4630301,
					"content": "呼…這裡就是盡頭了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630302,
					"content": "寶藏~寶藏~藏在哪裡呀~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630303,
					"content": "#{NICKNAME}，一起在附近找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630304,
					"content": "#哈哈哈…這就不用麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630305,
					"content": "剩下的，由我來接手就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630306,
					"content": "盜寶團的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "真是機靈，不過現在才發現是不是有點太晚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "#{F#妳}{M#你}們好，我是伊紮德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630312,
					"content": "替盜寶團說聲謝謝吧，感謝兩位好心人為我帶路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630313,
					"content": "唔啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630314,
					"content": "真是奇怪，我們明明一直都在暗中行動，寶藏的秘密是怎麼洩露的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630315,
					"content": "我倒是完全不覺得奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "哼！我可不會甘心的。喂，盜寶賊！你以為我們不會反抗嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630317,
					"content": "妳要是這麼瞧不起我們的實力，一會就別太吃驚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630318,
					"content": "#只要我一聲令下，外面埋伏的兄弟們就會來和{F#妳}{M#你}們打招呼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630319,
					"content": "可惜啊，他們不會像我這麼好說話的，哈哈哈哈……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630320,
					"content": "（凱亞和西風騎士登場）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630321,
					"content": "在閣下這麼開心的時候來打擾，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630322,
					"content": "至於你的那些兄弟嘛，他們已經沒辦法回應你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630323,
					"content": "恐怕你…只能去蒙德的監獄裡探訪他們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630324,
					"content": "或者，與他們做個獄友，也不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630325,
					"content": "騎士團的人…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630326,
					"content": "哇，是凱亞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630327,
					"content": "——凱亞，他在打你的寶藏的主意！快點把他抓起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630328,
					"content": "嘁，可惡啊，明明就快到手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630329,
					"content": "哦呵，寶藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630330,
					"content": "不好意思了，這裡根本沒有什麼寶藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630331,
					"content": "#辛苦{F#妳}{M#你}們白跑一趟。那麼現在，束手就擒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630332,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630333,
					"content": "沒有…寶藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630334,
					"content": "凱亞剛才是不是說…沒有…寶藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630335,
					"content": "哈哈。被計算了…沒想到騎士也會用這種卑鄙手段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630336,
					"content": "身為盜賊就不要隨便評論騎士的智慧…喂，等等，你想幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630337,
					"content": "#誰要被{F#妳}{M#你}們抓住啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630338,
					"content": "這…這是什麼？我不是故意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630308,
					"content": "…是情報交易所的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "哈哈哈，情報交易所。我倒是和他們打過交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630310,
					"content": "都是些守規矩的商人，發不了大財的傢伙們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 46305,
			"completionStepIds": [
				46305,
				46308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
