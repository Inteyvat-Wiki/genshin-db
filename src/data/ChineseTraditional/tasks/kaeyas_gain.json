			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4630501,
					"content": "呼…沒想到居然混到了被騎士團救命的地步，真是丟臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630502
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630502,
					"content": "別忘了你承諾過什麼，否則剛才的東西絕對不會是你見過最可怕的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630503
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630503,
					"content": "這…喂！你們騎士團都是這樣對待嫌犯的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630504
					],
					"speakerTitle": "伊紮德"
				},
				{
					"id": 4630504,
					"content": "開玩笑的。好了，把他帶回蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630505
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630505,
					"content": "是！凱亞隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630506
					],
					"speakerTitle": "西風騎士"
				},
				{
					"id": 4630506,
					"content": "隊長，這兩個人也要一併帶走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630507
					],
					"speakerTitle": "西風騎士"
				},
				{
					"id": 4630507,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630508,
					"content": "哈哈，不用了。這兩位可是本次行動的功臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630509
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630510,
					"content": "果然是假情報。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630511,
					"content": "果然根本沒有什麼寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "原來我被騙了！震撼彈！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "沒有他們散佈<color=#00E1FFFF>假情報</color>，我們也沒那麼容易搞定盜寶團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630510,
						4630511,
						4630512
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630513,
					"content": "嗚嗚嗚…騙子！喜歡說謊的壞人！騎士團的敗類！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630514,
					"content": "停，停——好啦，好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630515
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630515,
					"content": "儘管寶藏是假的，但至少有那麼一瞬間妳是想要獨吞的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630516
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630516,
					"content": "#不然，{F#妳}{M#你}們為什麼不通知我，而是自己過來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630517
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630517,
					"content": "啊！…唔嗯嗯嗯嗯…哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630518,
					"content": "#{NICKNAME}，我們走！誰有空和這傢伙理論啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630519,
					"content": "哈哈，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630520
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630520,
					"content": "二位幫了我這麼大的忙，謝禮總是少不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630521,
					"content": "這柄劍名為「斬開黎明指向勝利的拂曉神劍」，如它的名字一樣，是象徵光明與勝利之劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630533,
					"content": "不嫌棄的話，這柄我珍藏已久的「黎明神劍」就作為給兩位的謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630522,
					"content": "「黎明神劍」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630523,
					"content": "沒錯。與通情達理的派蒙閣下很相稱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630524,
					"content": "嗯…如果謝禮是這柄「黎明神劍」的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630525,
					"content": "#{F#妳}{M#你}們會理解我的，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630526,
					"content": "#有{F#妳}{M#你}們這樣溫柔又懂得體諒他人的朋友，是我凱亞的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630527,
					"content": "嗯…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4630529,
					"content": "…派蒙已經完全被掌控了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "…不同的伎倆就可以繼續用嗎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630528,
					"content": "這次的事實在抱歉，但請派蒙閣下放心，同樣的伎倆我是不會用兩次的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630531,
					"content": "真是愉快的一天。那麼，我還要回去審訊嫌犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4630532,
					"content": "今天就先告辭了。以後也歡迎來騎士團找我，我們下次再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				}
			]
		},
