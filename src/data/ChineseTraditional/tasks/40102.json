			"dialogs": [
				{
					"id": 401020401,
					"content": "總之我們先敲門試試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020402,
					"content": "（敲門）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "好像沒什麼反應…是沒人在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020404,
					"content": "（敲門）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "艾爾海森，聽得到嗎？你在家裡嗎？我們有事想請你幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020406,
					"content": "#是{F#妳}{M#你}們兩個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020407,
					"content": "卡維！原來你在家呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020408,
					"content": "#…總之先進來吧，我幫{F#妳}{M#你}們開門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡維"
				}
			]
		},
		{
			"id": 4010205,
			"completionStepIds": [
				4010205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
