			"dialogs": [
				{
					"id": 401025001,
					"content": "沒想到有人敢在學院慶典期間動手，看來薩齊因的財產有很大的誘惑力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025002,
					"content": "如果突然有這麼一大筆錢，妳會做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025003,
					"content": "不知道，我從來沒有想過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401025004,
					"content": "那妳想想看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401025005,
					"content": "嗯…購買食物、尋找水源…大概這些吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坎蒂絲"
				}
			]
		},
