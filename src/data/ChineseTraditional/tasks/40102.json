							244.751,
							2659.268
						],
						"pointId": 330201423
					}
				]
			},
			"dialogs": [
				{
					"id": 401020301,
					"content": "呼…妮露，妳有看到艾爾海森嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020302,
					"content": "艾爾海森先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020303,
					"content": "我們正在調查一個人，想拜託他幫忙查查檔案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020304,
					"content": "這樣啊…抱歉，我也不知道他去了哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020305,
					"content": "通常比賽結束後，他就會第一個離開。而且艾爾海森先生也不會向其他人透露自己的行程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020306,
					"content": "好吧。仔細想想他平常也是這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020307,
					"content": "我想想…艾爾海森先生似乎對學院慶典不太感興趣，應該不會留在這附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020308,
					"content": "#對他來說，特邀評論員更像是被安排的工作。{F#妳}{M#你}們知道他平時工作結束後會去哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020309,
					"content": "酒館？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "嗯…可是畢竟還有一輪比賽，艾爾海森先生會在這時候去喝酒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401020311,
					"content": "啊！我想到了，他有沒有可能是回家了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020314,
					"content": "我記得艾爾海森的住宅好像離這邊不遠，我們去他家看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020312,
					"content": "回家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "對喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
