			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}，總覺得{F#妳}{M#你}好像有什麼心事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020102,
					"content": "（比賽開始前見到的白髮男子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}、派蒙，總算找到{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020105,
					"content": "咦，發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020106,
					"content": "#{F#妳}{M#你}們有沒有覺得這次學院慶典有點奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020107,
					"content": "剛剛我和坎蒂絲在咖啡館，好像看到了來這裡辦事的傭兵。他們還特地喬裝打扮了一番，裝作只是來逛街的遊客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020108,
					"content": "但再怎麼裝，身上的血腥味是掩蓋不掉的。看他們那副賊頭賊腦的樣子，接的八成是綁票、暗殺這種下三濫的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020109,
					"content": "我們聽了一下，他們的目標好像是一個叫「薩齊因」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020110,
					"content": "薩齊因？是不是開幕式的時候，卡莉娜提起過的那個人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020111,
					"content": "據說「才識之冠」還有比賽的獎金都是他贊助的。不過這個人好像一直沒有露面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020112,
					"content": "聽起來是個有錢人吧，那就不奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020113,
					"content": "這年頭鍍金旅團的日子也不好過，很多傭兵團會接一些「私工」，盯上的都是有錢有勢的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020114,
					"content": "用他們的話說叫開張吃半年，只要幹成一票，撈到的贖金能讓他們瀟灑過一段日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020115,
					"content": "因為學院慶典，須彌城一下子來了很多遊客，他們應該也是趁機混進來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020116,
					"content": "我和迪希雅原本想直接抓住對方，但他們很警覺，找藉口溜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020117,
					"content": "要不是不想在城裡大打出手，第一時間就該把他們綁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020118,
					"content": "按規定這件事應該誰來管？風紀官？還是三十人團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020119,
					"content": "嗯…如果賽諾在的話，他應該會管。要不然我們先回一趟教令院，把消息告訴風紀官吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020120,
					"content": "迪希雅、坎蒂絲，這次多謝妳們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020121,
					"content": "沒什麼，我們也是碰巧聽到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020122,
					"content": "是啊，不用放在心上。真讓他們得逞了，鍍金旅團的名聲只會變得更差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020123,
					"content": "#這裡畢竟是須彌城，我和坎蒂絲不方便動手，就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 401020124,
					"content": "需要幫助的話，來咖啡館找我們就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401020125,
					"content": "#剛剛我總覺得{F#妳}{M#你}有什麼心事，難道也是在思考學院慶典的問題？聽迪希雅和坎蒂絲說完之後，我也感覺這背後好像藏著一些秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020126,
					"content": "嗯…這樣乾想下去也不是辦法。走，我們去教令院找風紀官吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020103,
					"content": "（第一輪比賽結束後聽到的密談…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
			"completionStepIds": [
				4010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
