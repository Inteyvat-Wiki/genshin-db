					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿拉夫"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-418.417,
							281.227,
							2771.899
						],
						"pointId": 330201419
					},
					{
						"sceneId": 3,
						"position": [
							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "#兩位，好久不見了。{F#妳}{M#你}們有事找我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020202,
					"content": "將迪希雅與坎蒂絲說的情況告訴了阿拉夫。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "預謀綁架薩齊因…居然有人在策劃這種事。不過仔細想想，倒也並不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020204,
					"content": "薩齊因贊助了學院慶典，如今學院慶典的影響力逐步擴大，很多人都聽說了薩齊因的名聲，把他視為超級富豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020205,
					"content": "既然知道有人盯上了他，是不是應該多派點人，把他保護起來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020206,
					"content": "#不瞞{F#妳}{M#你}們說，我們也有過這樣的想法。但聽說薩齊因原本就喜歡外出考察，常年不在須彌城內，沒人能聯絡上他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020207,
					"content": "唯一的線索，就是他曾經說過「每次舉辦學院爭霸賽的時候，我都會在最近的地方觀察，挑選出適合的人來繼承我的產業」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020208,
					"content": "如果薩齊因遵守自己的承諾，現在的他應該就在須彌城內。鍍金旅團的那些人，應該也是聽說了這件事，才來須彌城碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020209,
					"content": "看來那群壞蛋也不知道薩齊因在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020210,
					"content": "應該是這樣。賽諾前輩還在休假，這件事就由我來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020211,
					"content": "放心，在如今的須彌城裡，一小群綁匪掀不起什麼風浪，我自有辦法讓他們現身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020212,
					"content": "#不過，如果{F#妳}{M#你}們對薩齊因的事感興趣，要不要試著去找找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020213,
					"content": "越早弄清楚他在哪裡，我們越能保證他的安全。畢竟風紀官和三十人團的本領再大，也很難保護一個不肯現身的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020214,
					"content": "好吧，那我們去試著找找他。不過該從哪裡開始調查呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020215,
					"content": "風紀官這裡有薩齊因的資料嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "並沒有。薩齊因從未做過任何違法亂紀的事情，風紀官這裡並沒有多少關於他的資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020217,
					"content": "#我聽說艾爾海森大人已經卸任代理賢者，重新當回了書記官，{F#妳}{M#你}們不妨去找他問問看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401020218,
					"content": "有道理。那我們先回主會場，去找艾爾海森！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
