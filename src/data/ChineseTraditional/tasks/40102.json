					}
				]
			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "好多字，看得我頭都暈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020502,
					"content": "總之就是，薩齊因把自己的產業託付給教令院打理，然後自己跑出去做研究了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020503,
					"content": "他還說如果特別認可某位參賽者的話，不光會給他獎金，還會把自己的產業也送給他…那應該值好多好多錢吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020504,
					"content": "什麼？！還有這種好事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020505,
					"content": "薩齊因的資產…應該多到我這輩子也花不完吧。如果我能拿到，豈不是還清欠款、購置新房之後還能剩下數不清的錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020506,
					"content": "到時候我可以再造一座卡薩扎萊宮。不，造一座比卡薩扎萊宮大十倍的宮殿——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020507,
					"content": "還有奧摩斯港那邊的新計畫，說是改裝橋體，想做出最好的效果恐怕要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020508,
					"content": "快醒醒！現在就考慮這些，未免也太早了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020509,
					"content": "也是。當務之急還是拿下冠軍，早點搬出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020510,
					"content": "嗯？等等，資料裡好像還夾著一張紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020511,
					"content": "這是艾爾海森寫的嗎？看起來像是他在思考的時候隨手記下來的…讓我看看，有兩句話被圈起來了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020512,
					"content": "第一句是「薩齊因生死未知」，第二句是…「才識之冠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020513,
					"content": "還有一些看不懂的話。這是別的語言嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020514,
					"content": "我看看…欸？這種文字…唔，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020515,
					"content": "「宏大的理想未必能夠對抗虛無，微小的選擇卻可以」。不能保證翻得全對，但大意應該差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020516,
					"content": "…嗯？底下還有行小字…咦…他這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020517,
					"content": "你居然能讀懂這種看起來很奇怪的文字呢，好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020518,
					"content": "學生時代我跟他合作過課題，題目是「赤王文明古遺蹟中的符文古文字與建築設計方向解讀」。那時候跟著稍微學了一點古文字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020519,
					"content": "原來是這樣！不過…艾爾海森寫的這些是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020520,
					"content": "誰知道呢？那傢伙的思考方式不是普通人能搞懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020521,
					"content": "好吧，看來這裡也沒有更多的線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020522,
					"content": "希望阿拉夫那邊有進展。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "是呀，希望他早點抓住那些壞蛋。在那之前…嗯…我們先去別處逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4010206,
			"completionStepIds": [
				4010206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010206",
							"2"
						],
						"stepId": 4010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020601,
					"content": "剛剛敲門沒有反應，我還以為家裡沒有人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020602,
					"content": "沒辦法。如果是教令院的人來找艾爾海森，我跑過去開門，不就暴露我住在這裡的事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020603
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020603,
					"content": "你在這件事上還真是謹慎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020604,
					"content": "那萬一有人來找艾爾海森，你又剛好在房子裡怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020605,
					"content": "我在自己房間就行。再說，也不會有人到家裡來找艾爾海森的，普通人不敢這樣自討沒趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020606,
					"content": "好吧，你知道艾爾海森去哪了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020607,
					"content": "那傢伙？誰知道，他愛去哪去哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020608,
					"content": "吵架了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "有什麼好吵的，是他說話太難聽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020610,
					"content": "我跟他說了第二輪比賽的過程。最後我不是抽中籤了嗎？這代表好人有好報，現在的我運氣正旺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020611,
					"content": "#但那傢伙…{F#妳}{M#你}們根本猜不到他聽完之後說什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020641,
					"content": "「你總強調自己是學長，處理問題卻沒有學長真正該有的樣子。那所謂的學長尊嚴有什麼用？」什麼叫學長該有的樣子！學長就是學長吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020642,
					"content": "還有啊！他還說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020612,
					"content": "「我勸你好好想想，為什麼每一輪比賽都要拼運氣？你活到現在這個歲數還能對自身最大的困境視而不見，真是難以置信。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020613,
					"content": "哈哈…確實像艾爾海森會說的話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020614,
					"content": "忍無可忍！不只這次，還有上次、上上次，跟他聊天根本會氣死人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020615,
					"content": "反正我們互看不順眼，我會盡快搬出去的，現在就在收拾行李。不會再有人幫他收拾東西打掃屋子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020616,
					"content": "連牆上的掛畫我也要取下來帶走！今後艾爾海森就要生活在跟感性徹底絕緣的地方了，哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020617,
					"content": "等等，你要搬出去了？比賽不是還沒結束嗎，你哪裡來的錢呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020618,
					"content": "現在當然沒有，所以我只是先收拾一下行李，提前做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020619,
					"content": "我挑了新房子，等我拿到獎金，立刻就去把它買下來。再把收拾好的行李運過去，最多三天就能從這裡離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020620,
					"content": "#為了實現這個目標，我已經打定主意了。無論第三輪比賽發生什麼，我都會盡全力去拿下這個冠軍！{F#妳}{M#你}們就等著瞧吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020621,
					"content": "好吧，我們會幫你加油的。不過…你真的沒事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020622,
					"content": "欸？我有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020623,
					"content": "萊依拉跟我們說，她認為你有時會陷入「自我矛盾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020624,
					"content": "#什麼意思，{F#妳}{M#你}們不會也覺得我的性格有什麼問題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020625,
					"content": "我們沒有這麼說啦！但你想啊，說要拿到獎金的是你，拒絕了琺露珊贈送積分提案的也是你，沒辦法放著沙狐不管的還是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020626,
					"content": "等等，這些都是很正常的事吧。理由我之前就說了，不這麼做我會感到愧疚…哪裡矛盾了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020627,
					"content": "為什麼你會感到愧疚呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020629,
					"content": "突然這麼問…是啊，為什麼呢？也許我的性格就是這樣。而且不去做的話，萬一產生不好的後果，我也難辭其咎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020630,
					"content": "但老是這樣想就會活得很累啊。再說你做的事也不是完全沒危險…比如暈倒在沙漠裡什麼的，真的值得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020631,
					"content": "#…兩三句話說不清的，罷了。我的事先放一放，以後再聊。{F#妳}{M#你}們找艾爾海森做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020632,
					"content": "我們想拜託他查薩齊因的檔案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "薩齊因？這幾天好像聽他講到過這個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020634,
					"content": "#當時他帶回來一些資料，一邊自言自語一邊在紙上寫寫畫畫，還說叫我有空也看一眼，不過我沒看。{F#妳}{M#你}們等一下，我找找東西在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020635,
					"content": "#…就是這本。給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020636,
					"content": "呃…這樣真的好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401020637,
					"content": "這有什麼？他從我這拿啤酒的時候要多順手有多順手，從來沒跟我客氣過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020638,
					"content": "再說幾天前他問過我要不要看，當時我覺得用不到，他就放旁邊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020639,
					"content": "按他的習慣，資料沒收起來就是同意其他人翻看，妳不需要擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401020640,
					"content": "那我就放心啦。讓我翻翻薩齊因的檔案裡寫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
