				"points": []
			},
			"dialogs": [
				{
					"id": 3532801,
					"content": "呀，是不是感受到這個世界的「元素」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532802,
					"content": "#看起來，{F#妳}{M#你}只要觸碰神像，就能獲得「風」的元素力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532803,
					"content": "#這個世界的人想要獲得力量，絕對不可能像{F#妳}{M#你}這樣輕鬆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532804,
					"content": "這力量的來源…果然是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "#嗯，因為{F#妳}{M#你}本來就不是這個世界的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532809,
					"content": "從這裡向西走，就可以抵達自由城邦「蒙德」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532817,
					"content": "蒙德是「風」的城市，在七神中供奉的正是風神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532810,
					"content": "#能從神像獲得力量的{F#妳}{M#你}，會不會在那裡找到神的線索呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532811,
					"content": "#而且，蒙德有很多吟遊詩人，說不定能打聽到{F#妳}{M#你}{F#哥哥}{M#妹妹}的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532812,
					"content": "好，那就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532813,
					"content": "這個世界的「元素」回應了祈願，我覺得這算是一個好兆頭哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532807,
					"content": "真是邪門。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "「邪門」這種詞對神靈真是太不尊重了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}