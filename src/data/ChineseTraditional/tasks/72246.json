			"dialogs": [
				{
					"id": 722460301,
					"content": "墨田大人對之後的目的地，有計畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460302,
					"content": "嗯——這麼說來，聽說蒙德城裡有一座很大的圖書館…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "墨田"
				}
			]
		},
		{
