	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"阿釜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "好漂亮的鐲子！好漂亮的花瓶！璃月的東西真漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460102,
					"content": "…啊，不行。這麼匱乏的用詞，實在是愧對小說家的身分吶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460103,
					"content": "買個巧奪天工的瓷瓶，用來當做下一部小說的參考好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460104,
					"content": "嗯…寫個這樣的情節吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460105,
					"content": "「扭轉局面的關鍵，竟然是藏在花瓶裡的神之眼…！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460106,
					"content": "感覺很有意思呢！你覺得呢，阿釜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460107,
					"content": "我無所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460109,
					"content": "…我個人覺得，給「花瓶」的筆墨要控制好。描寫過度的話，意圖會被察覺到。但描寫有所欠缺的話，最後又會顯得太過突兀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460110,
					"content": "哦哦，你說得很對！我記一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460111,
					"content": "啊，抱歉抱歉！我們換個地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460112,
					"content": "還有，說了多少次了，別叫我大人了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460113,
					"content": "嗯？仔細一想，看起來很普通的兩名旅人，其中一位將另一位稱為「大人」，也是常見的情節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "墨田"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"阿釜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "呼啊——真是太愉快了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460202,
					"content": "該說真不愧是北陸最大的圖書館嗎！竟然能有機會一口氣把《少女薇拉的憂鬱》看完！痛快痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460203,
					"content": "墨田大人，小聲一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460204,
					"content": "啊，不好意思。實在是太讓人激動了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460205,
					"content": "不，我是怕您受傷。那個司書小姐有著強者的氣勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460206,
					"content": "欸？是嗎？我倒覺得是個有些懶散的，典型的魔女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460207,
					"content": "…仔細想想，通常這樣的角色才是最強的。不好不好，絕對不能激怒她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460208,
					"content": "啊，對了。有道理。下次就以這樣的角色為中心，寫一篇作品好了。《大圖書館的魔法師》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460209,
					"content": "你們的旅行如何了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460211,
					"content": "#欸，是傳說中的{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460212,
					"content": "旅行啊…以前我也常常外出旅行取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460213,
					"content": "「為了描寫雷災而前往無想刃狹間」、「為了描寫蛇妖而去蛇神之首」、「為了描寫逐電者的生活而請阿釜參軍」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460214,
					"content": "阿釜真不容易…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "沒什麼大不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460216,
					"content": "但是，這次是真正的旅行，漫無目的的遠遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460217,
					"content": "我才發現，值得寫的、有趣的故事，真是太多了。就像《紀野之旅》一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460218,
					"content": "我和阿釜一起尋訪當地人推薦的景點與店鋪。然後，在野外露營時，與陌生的旅人分享篝火與故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460219,
					"content": "醒來的時候，發現旅資都被偷走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460220,
					"content": "…沒問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "沒問題的。找到那些盜賊，發現他們有十幾個人的時候，我還以為沒辦法拿回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460222,
					"content": "但阿釜竟然設法說服了他們，把錢全都拿回來了，還附帶了很多有烏鴉紋樣的紀念幣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460223,
					"content": "明明感覺可以寫成有趣的情節，但阿釜就是不願意告訴我過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460224,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "是我應該做的。墨田大人不必掛心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460227,
					"content": "不，阿釜真的很可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460228,
					"content": "和你在一起，就算旅行到世界盡頭也不會有什麼問題吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460229,
					"content": "而且，總感覺，自從鶴觀以來，你變了很多呢。會有想做的事了，也會提出質疑與觀點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460230,
					"content": "如果墨田大人覺得不妥當的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460231,
					"content": "我覺得很好喔！你的看法，都相當值得參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460232,
					"content": "那麼，我就不打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#嗯。再見，{NICKNAME}。就讓我們像《菲謝爾皇女夜譚》裡那樣，相約在一切的盡頭再會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}，謝謝{F#妳}{M#你}。要多保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460233,
					"content": "或許我們會在別的地方再會吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "阿釜真有本領。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
			"id": 7224603,
