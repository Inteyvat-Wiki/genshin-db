			"dialogs": [
				{
					"id": 722460401,
					"content": "「世界如此寬廣…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460402,
					"content": "是《淨琉璃機動隊》嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "阿釜"
				},
				{
					"id": 722460403,
					"content": "嗯。阿釜你的記性，很不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460404,
					"content": "是您跟我說過的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿釜"
				}
			]
		}
	]
