{
	"id": 71665,
	"type": "WQ",
	"name": "參尋戰記·燃起來了！",
	"description": "接到了一件奇怪的委託，到爆炎樹附近找到委託人瞭解詳情吧。",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5188,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
	"prevMainQuestList": [],
	"steps": [
