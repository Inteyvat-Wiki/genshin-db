	"talks": [
		{
			"id": 7166501,
			"completionStepIds": [
				7166501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166501",
							"2"
						],
						"stepId": 7166501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716650101,
					"content": "#哎喲，總算來了，{F#妳}{M#你}就是「主角」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650102,
						716650104
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650102,
					"content": "我就是主角。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650103
					]
				},
				{
					"id": 716650103,
					"content": "呃…完全搞不懂你提問的意圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650105,
					"content": "啊，抱歉抱歉，看看我這急性子，明明刊登委託的時候也被告知過，應該用簡潔的語言說明委託內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650106
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650106,
					"content": "事情是這樣的，我叫蘭吉特，是個創意料理的廚師。我想和爆炎樹搞好關係，但是它好像不太樂意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650107
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650107,
					"content": "又是吐火球又是撞地，我真的拿它沒轍了，所以需要一個有辦法當故事主角的冒險家來幫幫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650108,
						716650110
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650108,
					"content": "好的，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650109
					]
				},
				{
					"id": 716650109,
					"content": "不要隨便答應這種荒唐的委託啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650111,
					"content": "你是認真的嗎？創意料理廚師和爆炎樹當朋友…怎麼想都很奇怪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650112,
					"content": "是嗎？它作為植物來說脾氣是有點過於暴躁沒錯，不過凡事總要試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650113
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650113,
					"content": "除了爆炎樹，之後我還打算挑戰看看古岩龍蜥、翠翎恐蕈，還有千年珍珠駿麟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650114
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650114,
					"content": "呃…總覺得越說越離譜了。真不知道你這個想法是從哪裡來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650115,
					"content": "其實是因為我前陣子去了趟納塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650116
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650116,
					"content": "納塔真是個神奇的地方——那種新奇的感覺，如果要說有什麼可以比的，恐怕就是第一次吃超辣咖哩時滿頭大汗的感覺了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650117
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650117,
					"content": "明明已經到了口舌能夠承受的刺激極限，但卻忍不住一口又一口地繼續吃下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650118
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650118,
					"content": "…話說回來，那時我在納塔結識了很多朋友，他們都是很好的人，有的教我攀岩，有的帶我泡溫泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650119
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650119,
					"content": "#{F#妳}{M#你}知道嗎？納塔人——特別是戰士——會在穿著上模仿他們的龍。那一身行頭打扮下來，看起來真的就和龍一樣勇猛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650120
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650120,
					"content": "#我照著納塔朋友的帽子也幫自己做了一頂，{F#妳}{M#你}看，很不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650121
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650121,
					"content": "唔…的確是很有特色的帽子，不過光看一頂帽子也看不出什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650122,
					"content": "也是，因為沒有龍夥伴嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650123
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650123,
					"content": "唉…要是我也可以有龍夥伴就好了。但我又不是納塔人，叫我在納塔長住我也安分不下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650124
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650124,
					"content": "於是我就想有沒有辦法在納塔之外的地方，找到可以代替龍的夥伴。不管結果如何，之後回納塔我也才能把這段經歷講給納塔朋友聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650125
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650125,
					"content": "就算是這樣，你也應該挑選一下挑戰的對象吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650126,
					"content": "#欸？{F#妳}{M#你}不覺得那些都是適合的對象嗎？和納塔的龍很像，然後也很強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650127
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650127,
					"content": "畢竟有個馱獸夥伴算不了什麼，既然要講冒險故事給納塔的朋友聽，當然要選一些有挑戰性的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650128
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650128,
					"content": "比較可惜的是我自己當不了「主角」…要讓這些不分白天黑夜都怒氣沖沖的傢伙們冷靜下來還真是不容易啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650129
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650129,
					"content": "不過經驗豐富的冒險家應該很擅長應對這種事吧？當然，我也會從旁輔助的，不管是網子還是料理，就交給我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650130
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650130,
					"content": "#和潛在夥伴們正面「交涉」的工作就拜託{F#妳}{M#你}啦，「主角」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650131
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650131,
					"content": "你怎麼把危險的工作都交給主角啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650132,
						716650134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716650132,
					"content": "你的報酬最好要配得上我的勞動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650133
					]
				},
				{
					"id": 716650133,
					"content": "那當然了！好說好說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650136,
					"content": "好！既然都談妥了，那我們這就出發？鍋子已經架好了，裝備也調整過了，應該沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650137,
						716650138
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650137,
					"content": "出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716650138,
					"content": "還有別的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650139
					]
				},
				{
					"id": 716650139,
					"content": "#沒問題，我就在這裡等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650134,
					"content": "先以理服人，再好好討論。瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650135
					]
				},
				{
					"id": 716650135,
					"content": "#對，{F#妳}{M#你}說的對，是這樣沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716650110,
					"content": "夠簡潔，但完全聽不懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650111
					]
				},
				{
					"id": 716650104,
					"content": "聽不懂你在說什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650105
					]
				}
			]
		}
	]
}