			},
			"dialogs": [
				{
					"id": 740102101,
					"content": "這麼多應該夠了吧，接下來就看花的成長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102102,
					"content": "希望能在柯莎的花圃順利活下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740102103
					]
				},
				{
					"id": 740102103,
					"content": "異國的花朵…柯莎一定會照顧好你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102104
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102104,
					"content": "#派蒙和{NICKNAME}送來了異國的花，柯莎要用花一樣美麗的禮物來報答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102105
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102105,
					"content": "嘿嘿，這個時候再說報答什麼的，超不好意思的…話說，這個零件就是「像花一樣美麗的禮物」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102106,
					"content": "對呀，零件又美麗，在村裡又有用處，柯莎最喜歡了，所以收集了很多，每天看到零件就會很快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102107
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102107,
					"content": "（…說零件有用倒能理解，說零件美麗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102108,
					"content": "（派蒙不也覺得摩拉很美麗嘛。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740102109
					]
				},
				{
					"id": 740102109,
					"content": "（欸嘿嘿，也對哦…而且每天看到摩拉也會很快樂。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102110,
					"content": "人類的生活很辛苦，他們是看到什麼才會快樂呢？…柯莎就去人類的村裡看——原來他們有好多美麗的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102111
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102111,
					"content": "要是海沫村也能有許多美麗的花，那大家一定也會更快樂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102112
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102112,
					"content": "所以柯莎決心成為花匠，要讓村裡也有美麗的花圃！就算必須要付出美麗的零件，還會變得像人類一樣辛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102113
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102113,
					"content": "原來柯莎為了種好自己喜愛的花朵，下了這麼大的決心…嗯！妳的付出絕不會白費，好心腸的派蒙會繼續幫助妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102114,
						740102115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102114,
					"content": "不如派蒙也學習柯莎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740102116
					]
				},
				{
					"id": 740102116,
					"content": "#這個…因為有更好心腸的{NICKNAME}在身邊！所以，所以派蒙只要努力一點點就夠了吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102115,
					"content": "…努力賺自己喜歡的摩拉吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740102116
					]
				}
			]
		},
