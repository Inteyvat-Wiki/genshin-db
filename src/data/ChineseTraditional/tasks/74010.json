			"dialogs": [
				{
					"id": 740100801,
					"content": "#啊，是外面的人。歡、歡迎{F#妳}{M#你}們，可是…可是我現在沒有花可以送給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100802
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100802,
					"content": "送花？也不用這麼隆重吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100803,
					"content": "#好吧，那柯莎只能很熱情很熱情地歡迎{F#妳}{M#你}們來到海沫村了，歡迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100804
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100804,
					"content": "謝謝妳，柯莎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100805
					]
				},
				{
					"id": 740100805,
					"content": "#嗯，柯莎很熱情，所以{F#妳}{M#你}們有什麼想知道的，柯莎都願意告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100806
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100806,
					"content": "那太好啦，柯莎可以簡單介紹一下海沫村嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100807,
					"content": "當然可以。海沫村是很多美露莘的家，嗯…在這裡還看不到，再往前走一點就能看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100808
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100808,
					"content": "#大家都是很好的美露莘，如果{F#妳}{M#你}們也是很好的人的話，大家也會歡迎{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100809,
						740100812
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100809,
					"content": "我是好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100810
					]
				},
				{
					"id": 740100810,
					"content": "那我也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100811,
					"content": "嗯！那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100818
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100818,
					"content": "#接下來應該說什麼呢？柯莎想不起來了…但是記得結尾應該是：「祝{F#妳}{M#你}們在海沫村度過愉快的時光！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100819
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100819,
					"content": "#好呀！{NICKNAME}，不如我們去看看？就暫時先跟柯莎道別吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100820,
					"content": "#再見！希望{F#妳}{M#你}們下次來的時候，柯莎已經準備好花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100812,
					"content": "很難說完全沒做過壞事…",
