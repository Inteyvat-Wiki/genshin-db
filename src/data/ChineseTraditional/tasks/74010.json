	"talks": [
		{
			"id": 7401001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7401001",
							"2"
						],
						"stepId": 7401001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100101,
					"content": "為什麼呢，為什麼不發芽呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100102
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100102,
					"content": "妳是在忙什麼嗎？讓我看看…啊，我懂了，這一定就是所謂的「家庭菜園」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100103,
					"content": "菜、菜園？可是這明明是花圃…居然會被當成菜園…柯莎果然不是稱職的花匠，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100104
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100104,
					"content": "咦，是我認錯了嗎？對不起啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100105,
					"content": "對哦，之前柯莎說過沒有花可以送給我們，就是在說這件事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100106,
					"content": "是呀，柯莎在花圃埋下花的種子，完全沒有動靜。這些花種，該不會全部都壞掉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100107
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100107,
					"content": "好可惜，如果是這樣的話，那只能從頭開始了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100108,
					"content": "是啊，只能從頭開始了呀。柯莎想要美麗的花圃，不想被當成菜園…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100109
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100109,
					"content": "#唔…既然這樣，就讓什麼忙都能幫的小幫手派蒙和大幫手{NICKNAME}來幫幫柯莎吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100110,
					"content": "#派蒙和{NICKNAME}…會種花，會幫助柯莎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100111,
						740100113
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100111,
					"content": "我之前種過一些花卉和作物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100112
					]
				},
				{
					"id": 740100112,
					"content": "真令人羡慕！…柯莎的願望是成為厲害的花匠，可是種下的花朵總是枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100115
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100115,
					"content": "最開始是想要移植，可是移植的花朵總是活不了。之後想到要從花的種子開始培育，種子卻遲遲不肯發芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100116
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100116,
					"content": "花這麼美麗，照顧花卻這麼辛苦…不過人類已經習慣了做辛苦的工作，所以照顧花朵也很輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100117
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100117,
					"content": "可能只是人類種花的地方環境更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100118
					]
				},
				{
					"id": 740100118,
					"content": "環境…賣花的人類也說，「外面的環境對花比較好」。但是種在外面，柯莎就很難去照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100119
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100119,
					"content": "據說，遙遠的地方有各式各樣的花。也許、也許其中有一些，能適應村裡的環境…可惜柯莎出不了遠門，不能自己去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100120
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100120,
					"content": "#嘿嘿，那妳碰到對的人了。派蒙和{NICKNAME}遊歷過許多地方，見到過各式各樣的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100113,
					"content": "我見過別人種花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100114
					]
				},
				{
					"id": 740100114,
					"content": "看過其他人種花的人類，很容易就能學會。柯莎也看過人類種花，自己做卻總失敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100115
					],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100201,
					"content": "比如說風車菊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100202
					]
				},
				{
					"id": 740100202,
					"content": "對呀，風車菊生長在野外，是一種頑強的花朵呢，或許在這裡也能活下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100203,
					"content": "「蜂車菊」，陌生的名字呢…是吸引很多蜜蜂的花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100204
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100204,
					"content": "和蜜蜂沒關係啦…「風車」是種裝在房子上的東西，有許多花瓣一樣的葉片，被風一吹就會咕嚕咕嚕轉圈圈~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100205,
					"content": "風車菊就像風車，也能迎風旋轉哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100206,
					"content": "咕嚕咕嚕轉圈圈？…好奇妙！真想現在就能看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100301,
					"content": "比如說霓裳花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100302
					]
				},
				{
					"id": 740100302,
					"content": "「泥長花」，陌生的名字，也許是種在泥土裡，花瓣長長的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100303
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100303,
					"content": "不是這樣啦…「霓裳」是漂亮衣服的意思，這種花不但美麗，還可以被做成漂亮的衣服穿在身上哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100304,
					"content": "異國的花朵又美麗，又可以穿在身上！…越想越羡慕。好想馬上就能看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201310",
							"3"
						],
						"stepId": 201310,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100401,
					"content": "比如說鳴草。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100402
					]
				},
				{
					"id": 740100402,
					"content": "對呀，鳴草在天天下雷雨的地方都能生長，海沫村至少沒有整天都劈哩啪啦嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100403,
					"content": "「名草」，陌生的名字。人類有「園藝會」評選「名花」，異國也評選「名草」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100404
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100404,
					"content": "不不不，「鳴草」不是草，是一種花啦！即便沒有風，它也會隨雷聲隱隱震動，所以，當地的居民還會用它來預報雷雨呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100405,
					"content": "能自己振動的花朵…是什麼樣子呢？真想早點知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401005,
			"completionStepIds": [],
