			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740101801,
					"content": "這就是，能振動的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101802
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101802,
					"content": "果然，在不打雷的洞窟裡面，鳴草的振動很微弱，幾乎看不出來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101803,
					"content": "…真的很難看出來，不過，振動發出的聲音很好聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101804
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101804,
					"content": "鳴草的振動…發出的聲音好聽？我怎麼聽不見啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101805,
					"content": "…清脆悅耳，怎麼也聽不夠。這麼美麗的花朵，振動的響聲也這麼惹人喜愛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101806
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101806,
					"content": "奇怪，看她那麼陶醉，好像真的能聽到鳴草振動的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101807,
					"content": "…對了，如果打「雷」，鳴草就會振動得更厲害，悅耳的聲音就會更響吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101808
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101808,
					"content": "一定是這樣…花朵都要施肥料，鳴草也一樣。那麼「雷」這種肥料在哪能買到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101809
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101809,
					"content": "從雷電將軍那裡？…不對，「雷」才不是肥料啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7401019,
			"completionStepIds": [],
