					"content": "#嗚哇！{NICKNAME}只是在開玩笑的！我們沒做過要被逐影庭盯上的壞事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100815,
					"content": "…真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100816
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100816,
					"content": "真的！當然是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100817,
