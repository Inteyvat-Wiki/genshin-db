					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740101701,
					"content": "原來霓裳花是像水珠一樣的花朵，晶瑩剔透。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101702
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101702,
					"content": "欸，霓裳花晶瑩剔透？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101703,
					"content": "把晶瑩剔透的霓裳花穿在身上，就像披著瀑布，柯莎沒見過這樣的衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101704
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101704,
					"content": "我其實也沒見過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101705,
					"content": "…對了，這就是人類的「時尚」！「時尚」就是越奇怪越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101706
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101706,
					"content": "霓裳花不是這樣用的，時尚也不是這種東西啦…大概不是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7401018,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
