			"dialogs": [
				{
					"id": 3071101,
					"content": "#{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071102,
					"content": "喏，靠近點。聞到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071103,
					"content": "…沒聞到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "這個<color=#00E1FFFF>神廟</color>裡發生了一些事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071106,
					"content": "史萊姆、丘丘人…還有…風魔龍留下的魔力鏈結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071107,
					"content": "哈哈，裡面肯定很熱鬧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071108,
					"content": "會很危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "嗯…熱鬧歸熱鬧，卻並不危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071112,
					"content": "真遺憾啊，「北風之狼」的廟宇，如今竟被這樣打擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071113,
					"content": "#我們走吧，{F#少女}{M#少年}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071114,
					"content": "雖然「四風守護」已經不再有人祭祀，但古老的風不會消散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071115,
					"content": "現在，要去幫「四風守護」清理一下環境囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071110,
					"content": "只是烏合之眾罷了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "喔！很有氣魄的發言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071104,
					"content": "是火史萊姆燒焦的味道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
