			"dialogs": [
				{
					"id": 3071501,
					"content": "哦！真是精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071502,
					"content": "原來閣下是一位訓練有素的戰士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071503,
					"content": "剛才在廟宇裡，一路上的那些戰鬥，實在令人大開眼界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071504,
					"content": "您過獎了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "哈哈哈。連騎士般的「謙虛」品德也已經具備了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071507,
					"content": "閣下拯救蒙德的英姿，未來一定會傳遍整座自由之城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071508,
					"content": "今後有空的話，還請到騎士團總部來聊聊天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071509,
					"content": "嗯…或者，我也知道一家不錯的酒館哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071505,
					"content": "誇得太肉麻了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				}
			]
