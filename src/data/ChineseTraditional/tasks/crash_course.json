			"dialogs": [
				{
					"id": 3071401,
					"content": "#馬上就要第一次與{F#妳}{M#你}並肩作戰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071402
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3071402,
					"content": "#不知{F#妳}{M#你}我之間…是否合得來呢？",
