			"dialogs": [
				{
					"id": 191211401,
					"content": "#…{F#妳}{M#你}問我，有什麼托馬能做的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211402
					],
					"speakerTitle": "高志"
				},
				{
					"id": 191211402,
					"content": "托馬不是一直很忙嗎？每天都見不到他的人影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "高志"
				},
				{
					"id": 191211403,
					"content": "在社奉行所見到他的時候，他也在忙於打掃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "高志"
				},
				{
					"id": 191211404,
					"content": "我覺得托馬繼續這樣下去就好了，每個人都有自己的生活方式，托馬也不例外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "高志"
				}
			]
		},
