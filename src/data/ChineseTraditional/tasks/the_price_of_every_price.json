			"dialogs": [
				{
					"id": 401960101,
					"content": "幾位好！我們沒來晚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960102,
					"content": "不，剛剛好。休息得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960103,
					"content": "忙碌使人精神煥發。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "的確是保持活力的好方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960105,
					"content": "各位已經在著手準備了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "昨天從阿讓托先生處得到消息，確定了交易的時間與地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960107,
					"content": "說起來，是大家都知道的地方。「今日下午，映影歡樂城餐廳見。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960108,
					"content": "欸？他還真是對那個地方情有獨鍾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960109,
					"content": "這…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#看來{NICKNAME}和我們產生了同樣的擔憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960111,
					"content": "是的，比起空曠的地段，人潮眾多的活動場地會對逮捕行動造成額外的困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960112,
					"content": "犯人可能會混入人群，甚至利用人質逃脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960113,
					"content": "為此我們需要做更多的提前準備，所以從昨天接到消息起，這邊就已經開始安排逐影庭與特巡隊的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960114,
					"content": "嗯，現場會安插很多便衣人員。如果事情進展不順，我們會優先保障市民的人身安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960115,
					"content": "當然，還是祝我們一切順利比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960116,
					"content": "參與人員中有不少我在上起案件中見過的熟悉面孔，比如特巡隊隊長夏沃蕾小姐。所以，我持樂觀態度哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960117,
					"content": "那就借納塔的大英雄吉言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960118,
					"content": "哦，樂平波琳小姐和娜維婭小姐那邊，我們也都進行了溝通與安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960119,
					"content": "刺玫會會在可控範圍內協助支援，不必擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960120,
					"content": "唯一的問題…可能就是愛可菲小姐那邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960121,
					"content": "她不想接待犯過罪的顧客嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "她想用叉子捅犯罪分子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "哈哈，要是這樣反而簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960124,
					"content": "哦，老實說，是個不錯的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960125,
					"content": "咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 401960126,
					"content": "不開玩笑了。愛可菲小姐提出，希望自己的餐廳不要因為本次行動蒙受任何損失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960127,
					"content": "哈哈…我有種預感，絕對不會如願的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960128,
					"content": "需要我做些什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "#說實話，這件事本就與{F#妳}{M#你}無關，發展到這一步已經給{F#妳}{M#你}添了很多麻煩。剩下的應該全權交由楓丹官方處理即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960130,
					"content": "#不過我猜，{F#妳}{M#你}應該也想知道事件的結局吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960131,
					"content": "請務必。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "#嗯，那就請{F#妳}{M#你}在現場見機行事吧。不一定需要{F#妳}{M#你}出手，只是以防萬一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960133,
					"content": "我會盡量不讓事情發展到那一步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960134,
					"content": "基尼奇也要加入？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960136,
					"content": "雖然我心中還有很多疑問，但從現有資訊來看，犯人來自納塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960137,
					"content": "再說，我也算是證人之一，不能放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960138,
					"content": "很有基尼奇的風範呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960139,
					"content": "眾人又討論了一些行動細節和注意事項。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "那麼，閒話就說到這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960143,
					"content": "行動時間選在下午。只要動作夠快，出發前還能喝幾杯茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401960144,
					"content": "#對哦，{NICKNAME}，我們也去吃點東西吧？吃飽肚子才有力氣工作嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960145,
					"content": "派蒙就只是看著吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "陪伴也很重要哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960147,
					"content": "那我就先一步去會場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960148,
					"content": "阿喬這幾天一直吵著要吃活動限定的套餐，還是盡快滿足牠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960149,
					"content": "那麼等會見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960150,
					"content": "嗯，等各位的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				}
			]
		},
