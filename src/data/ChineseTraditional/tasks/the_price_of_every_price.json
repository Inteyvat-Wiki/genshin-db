			"dialogs": [
				{
					"id": 401960301,
					"content": "#喔，{NICKNAME}、基尼奇，你們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960302,
					"content": "剛剛看夏沃蕾帶著犯人離開了，好像心情不錯的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960303,
					"content": "比預想的順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "嘿嘿，讓我們繞了好大的圈子，結果也只是一個沒什麼戰鬥力、只會逃跑的傢伙嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960306,
					"content": "哦對了，萊歐斯利讓我告訴你們，他已經去沫芒宮彙報結果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960307,
					"content": "他說接下來，逐影庭將深入調查灰色賭博產業，有得忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960308,
					"content": "但無論如何，那些都是沫芒宮的工作，和我們關係不大啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960309,
					"content": "我看這位公爵大人跑得這麼快，是為了躲避記者的鏡頭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960310,
					"content": "唉，不過也習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960311,
					"content": "竟然這麼輕易地放棄了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960312,
					"content": "哼哼，反正剛剛已經拍到了超多精彩瞬間，足夠我出一則頭條新聞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960313,
					"content": "所以說，由於公務纏身，忙碌的記者先行告退，回去沖洗畫片啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401960314,
					"content": "要幫派蒙選最帥的角度哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960315,
					"content": "啊，跑得好快，希望她聽到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960316,
					"content": "相信專業攝影師的美感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "嘿嘿，也是哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960318,
					"content": "不過剛剛你們怎麼花了這麼久才過來，是遇到什麼問題了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401960319,
					"content": "阿喬撞到頭，在哭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 401960321,
					"content": "#{F#妳}{M#你}這傢伙，怎麼胡言亂語！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 401960322,
					"content": "我偉大聖龍「庫胡勒阿喬」，何時有過此等醜態！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 401960323,
					"content": "還少嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960329,
					"content": "接下來有什麼打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "嗯…說實話，還沒想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960331,
					"content": "也沒什麼急事，搞不好審判庭還要再叫我去作證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960332,
					"content": "至於那把來自納塔的槍，成了關鍵物證，可能也得等案件審理完成後再帶回納塔了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960333,
					"content": "總之，就讓我再享受一陣沙灘與大海吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960324,
					"content": "基尼奇撞到頭，在哭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "#{F#妳}{M#你}說是就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 401960326,
					"content": "啊哈哈哈哈哈，小小基尼奇，沒人摸摸他的頭，只好自己偷偷哭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "阿喬"
