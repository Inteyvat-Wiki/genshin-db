			"dialogs": [
				{
					"id": 721560101,
					"content": "好！這樣第二座「鎮石」也封印好了，只剩下兩座了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560102
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721560102,
					"content": "那我們就快去看看剩下的兩座「鎮石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560103
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721560103,
					"content": "只要把「鎮石」全部封印的話，雷暴應該就會平息了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560104
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721560104,
					"content": "快出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560105
					]
				},
				{
					"id": 721560105,
					"content": "希望那位「寢子」說的是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721560106,
					"content": "但是，這也是我們手上有關雷暴的唯一線索了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560107
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721560107,
					"content": "無論如何，我們還是快去看看那兩座「鎮石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560108,
						721560109
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721560108,
					"content": "總之先出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560110
					]
				},
				{
					"id": 721560110,
					"content": "雷暴和「鎮石」…回去得向協會好好報告一下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悅子"
				},
				{
					"id": 721560109,
					"content": "先去那附近看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560110
