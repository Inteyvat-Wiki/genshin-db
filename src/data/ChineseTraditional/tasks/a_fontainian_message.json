					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "這還真是巧遇啊，這還真是。您說對吧？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090103,
					"content": "你們是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090104,
					"content": "您看看我，還真是失禮。我是桑尼，朋友們有時候叫我「白手套」。而這位「漁夫」盧卡，在特定的人群中小有名氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090105,
					"content": "喔，你們好！我是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090106,
					"content": "#我明白、我明白，您是派蒙，而這位金髮的{M#先生}{F#小姐}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090107,
					"content": "咦？你認識我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090108,
					"content": "#當然認識，當然！只不過在今天之前，我認識您與{NICKNAME}，就如同我認識那維萊特大人，都是單方面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090109,
					"content": "像兩位這麼傑出的人物，一旦踏上了我們楓丹的土地，自然會有小小鳥跟我們說囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090110,
					"content": "原來我們這麼有名嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "您看看您，真是謙虛！這麼說吧，您出現在我們楓丹，對某些人而言，就像炸彈出現在歐庇克萊的大舞臺上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090112,
					"content": "——當然，是好的意思！您說對吧？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090113,
					"content": "呃，這個要怎樣才是好的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090114,
					"content": "唔…我不善言辭，您覺得呢？親愛的盧卡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090115,
					"content": "林尼與琳妮特的魔術演出。炸彈、逃脫表演。爆炸性新聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090116,
					"content": "精闢！您看，我就想不出這樣的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090117,
					"content": "原、原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090118,
					"content": "不過，為什麼你叫「白手套」呀？你明明沒戴手套…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090119,
					"content": "喔，這真是個刁鑽的問題。該怎麼向您解釋好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090120,
					"content": "設想您戴著白手套。這時，只要摸到髒東西，手套上就會留下汙漬，對吧？所以，我的職責就是找到髒東西，然後處理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090121,
					"content": "喔…也就是負責清潔工作的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090122,
					"content": "說得好，親愛的派蒙！我就沒辦法這麼精簡扼要地總結我的工作性質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090123,
					"content": "所以，楓丹廷的街道這麼整潔，都是多虧了像桑尼這樣的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090124,
					"content": "哈哈哈，您說話還真好聽！您就當作是這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090125,
					"content": "是喔…不過清潔工還需要帶刀嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090126,
					"content": "您就當做是清理一些頑固垃圾的時候，才要派上用場的小道具吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090127,
					"content": "嗯，我明白了！那，盧卡是因為很會釣魚，所以才叫「漁夫」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090128,
					"content": "嗯——也不完全是這樣，不完全是這樣。您看，在我們楓丹，不是有各式各樣的魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090129,
					"content": "而教人如何與繽紛多彩的魚群愉快、平靜地相處，就是他的特長。我說得對嗎？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090130,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090131,
					"content": "咦？我不明白…如果是這樣的話，那——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090132,
					"content": "哎呀呀，親愛的派蒙，您真的很會問問題。問的問題都很刁鑽、很有水準。真希望能多與您聊聊，好好回答您的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090133,
					"content": "派蒙，別問了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "欸？好吧…那桑尼、盧卡，你們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090136,
					"content": "您看，我們對「潛水」非常有興趣，非常有興趣。我們楓丹的水下充滿了數之不盡的財富，無論是自然的還是前人留下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090137,
					"content": "聽說，最近您在這裡認識了一位好朋友，與他一同入水。您本領高強，甚至不需要潛水護具。您說對吧？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090139,
					"content": "你們想問維吉爾的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "沒錯。我們想問維吉爾的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090141,
					"content": "維吉爾…那個壞傢伙！啊啊，氣死我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090142,
					"content": "和派蒙一起，鉅細靡遺地向「白手套」桑尼與「漁夫」盧卡說明了此前的經歷。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "原來如此，原來如此。非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090144,
					"content": "不用謝！哼，那個壞東西，我才忘不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090145,
					"content": "——當然我們很感謝兩位坦誠說明了維吉爾的遭遇。但我更感激的是，兩位並不是他的朋友。不然的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090146,
					"content": "#這樣說吧：不然的話，之於{F#妳}{M#你}我，多少都會有些不便。您說對吧？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090147,
					"content": "應該對付不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090148,
					"content": "我想也是，我想也是。真是太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090149,
					"content": "你在說什麼呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090150,
					"content": "他們是維吉爾的敵人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090152,
					"content": "#您這話還真令人傷心，{M#尊敬的先生}{F#可愛的小姐}。我並沒有敵人，只有許多朋友，維吉爾也是其中之一。只不過，親愛的維吉爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090153,
					"content": "#我們需要和他好好「聊聊」。您應該能理解吧？親愛的{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090154,
					"content": "當然，也自然是要為您與派蒙討個公道。否則的話，對二位貴客就太失禮了，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090155,
					"content": "那個，我沒有聽懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090156,
					"content": "他是「白手套」。知道這個就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "是喔…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090160,
					"content": "我們已經找到維吉爾和他朋友們的據點了。我們不妨在據點會合，您看如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090161,
					"content": "為什麼要我們一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#尊敬的先生}{F#可愛的小姐}！維吉爾對您做出了如此冒犯的事情，我和盧卡若是不與您打招呼，就…和他聊聊的話，那就太失禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090163,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090164,
					"content": "您看，盧卡也懂得這樣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090166,
					"content": "哼！我也要跟維吉爾聊聊！讓他向我們道歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090167,
					"content": "哈哈哈，您還真善良。那我們在目的地會合吧，兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090165,
					"content": "好。走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "這些事情，不用太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#身處世間，太過明白的話，多少有些無趣，不是嗎？{M#尊敬的先生}{F#可愛的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090135,
					"content": "找我們有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
