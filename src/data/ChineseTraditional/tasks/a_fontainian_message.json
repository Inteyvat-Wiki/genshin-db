			"dialogs": [
				{
					"id": 740090301,
					"content": "請您聽我解釋…這一切都是誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090302,
					"content": "桑尼先生…您想，我們也只是想著這筆生意能賺很多，上面又不同意，才想著…想著先賺一筆，將收入交給組織，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090303,
					"content": "可惡，居然無視我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090304,
					"content": "我對組織絕對沒有怨言…對了，我是被那些壞人騙了，才會做出這樣愚蠢的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090305,
					"content": "#真是了不起，了不起。{NICKNAME}，您的身手真是名不虛傳。您不這麼認為嗎？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090306,
					"content": "厲害。真的很強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090307,
					"content": "看在過去的情分上…桑尼先生…盧卡先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090309,
					"content": "哎呀！不、不要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090310,
					"content": "#盧卡。客人還在。我們不能做出失禮的事情，讓{M#他們}{F#她們}不愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090311,
					"content": "明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090312,
					"content": "哼！維吉爾，你知道錯了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090313,
					"content": "啊啊，我錯了、我錯了…請多多諒解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090314,
					"content": "知錯就好，以後不能再這樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090315,
					"content": "#親愛的維吉爾以後絕對不會這樣了，派蒙、{NICKNAME}，我以我「白手套」桑尼的名譽，和我父親與兒子的名譽保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090316,
					"content": "我們走吧，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "嗯！謝謝你們，桑尼、盧卡。看來楓丹還是好人比壞人多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090321,
					"content": "#再見，希望我們還有機會合作，親愛的派蒙、{M#尊敬的先生}{F#可愛的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090322,
					"content": "噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維吉爾"
				},
				{
					"id": 740090317,
					"content": "你們打算怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#身處世間，太過明白的話，多少有些無趣，不是嗎？{M#尊敬的先生}{F#可愛的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090319,
					"content": "如果您實在好奇的話，我們會先慢慢跟他…聊聊。就不耽誤兩位的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "桑尼"
				}
			]
		},
