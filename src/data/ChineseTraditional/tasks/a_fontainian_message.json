			"dialogs": [
				{
					"id": 740090201,
					"content": "#{M#尊敬的先生}{F#可愛的小姐}、親愛的派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090202,
					"content": "請看，這裡就是維吉爾最近使用的據點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090203,
					"content": "真是的，維吉爾大哥怎麼還沒回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "看起來似乎有點壞的人"
				},
				{
					"id": 740090204,
					"content": "他要是再不回來，我就忍不住…忍不住要喝這批樂斯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "看起來稍微有點危險的人"
				},
				{
					"id": 740090205,
					"content": "喂，別鬧！那可是好不容易才弄來的貨。如果敢亂動，維吉爾大哥是不會跟你客氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "看起來不太正經的人"
				},
				{
					"id": 740090206,
					"content": "真是遺憾。親愛的維吉爾似乎還沒回來呢。不過，我們可以先和他們「聊聊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090207,
					"content": "呃，他們看起來…好像不太好聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090208,
					"content": "這個未必，您覺得呢？親愛的盧卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090209,
					"content": "沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 740090210,
					"content": "喂！真的沒問題嗎？總覺得他們應該會直接動手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090211,
					"content": "哎呀！您還真是思慮周全，親愛的派蒙。如果發生了那樣的事情，就太不幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090212,
					"content": "…對他們來說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑尼"
				}
			]
