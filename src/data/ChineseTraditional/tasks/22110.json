				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "怎麼樣？消滅掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100302,
					"content": "已經消滅掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "#連遺蹟獵者都不在話下…無論從哪個角度來看，{F#妳}{M#你}的實力都已經夠強了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100304,
					"content": "…還是沒找到和「劍」有關的東西？呼…意料之中，這個詞我都要說膩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100305,
					"content": "#沒關係，辛苦{F#妳}{M#你}了，完成了我這麼多不知所謂的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100306,
					"content": "「藏鋒」，你究竟藏在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100307,
					"content": "一定會找到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "#…{F#妳}{M#你}是在安慰我嗎？這麼一點小事，連挫折都算不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100310,
					"content": "無論找到什麼時候，什麼地方…我也會把那柄劍找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100311,
					"content": "#我會繼續擴大搜索範圍，以後說不定還會找{F#妳}{M#你}幫忙，放心，我也會付給{F#妳}{M#你}相應的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100316,
					"content": "#好了，這是{F#妳}{M#你}的報酬，拿好。我要去篩選下一批委託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100317,
					"content": "…「藏鋒」，我一定會找到你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100308,
					"content": "這些委託，聽起來和「劍」都沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "那是因為，所有和「劍」有關的委託，我都已經接了個遍…但始終一無所獲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100313,
					"content": "然後，我認為…能逼得大哥丟掉武器的，只能是極其危險的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100314,
					"content": "所以我開始接受其他的委託，在那些足夠危險的地方，尋找那把「藏鋒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100315,
					"content": "#不過，足夠危險的委託數量稍微有點多，我一個人已經忙不過來了，所以我才會請{F#妳}{M#你}來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "嵐姐"
				}
			]
		}
	]
