			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "這個一點用都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "#…看來{F#妳}{M#你}真的還挺閒的，不知道是實力太強，還是實力太弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100104,
					"content": "#不過，我想{F#妳}{M#你}的實力也不會太弱吧，畢竟我給{F#妳}{M#你}的委託，{F#妳}{M#你}都好好完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100105,
					"content": "#既然{F#妳}{M#你}這麼有空，那麼就再接受我的一個委託吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100106,
					"content": "不過這一次，要消滅的目標可能有點危險，是一個「遺蹟獵者」，怎麼樣？要接受嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100107,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "#真是個有自信的冒險家，和我大哥一樣…說不定，{F#妳}{M#你}以後會成就什麼偉業吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100113,
					"content": "好了，閒話說夠了，具體地點是歸離原。好好準備之後，再去把那個遺蹟獵者消滅掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100114,
					"content": "在消滅它之後，如果發現了什麼和「劍」有關的東西，記得帶回來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100115,
					"content": "…如果沒有發現，就直接回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100116,
					"content": "#總之，這份委託就拜託{F#妳}{M#你}了，希望這次…能有所發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100108,
					"content": "這次也要留意「劍」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "#對，在消滅遺蹟獵者之後，{F#妳}{M#你}也要記得留意和「劍」有關的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100111,
					"content": "#但是這次的委託是消滅遺蹟獵者，它可不好對付。把{F#妳}{M#你}所有的注意力都集中在它身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100112,
					"content": "#至於和「劍」有關的東西，找到了最好，如果沒找到也沒關係，只要消滅了遺蹟獵者，我就會付給{F#妳}{M#你}報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
