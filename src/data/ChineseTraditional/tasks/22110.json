			"dialogs": [
				{
					"id": 221100201,
					"content": "怎麼樣？消滅掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221100202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "沒關係，「遺蹟獵者」這種敵人，確實需要謹慎準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
