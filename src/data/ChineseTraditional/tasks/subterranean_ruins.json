			"dialogs": [
				{
					"id": 50220801,
					"content": "早安，昨晚做惡夢了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50220802,
					"content": "#我聽見{F#妳}{M#你}的床上一直傳來翻滾聲，總覺得{F#妳}{M#你}睡得不是很好。是不是決戰快到了，有點緊張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50220803,
					"content": "（昨天晚上的夢…轉眼間記憶已經開始模糊了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "（夢裡的東西就像是隔著一層細紗，看不清楚。努力去回憶的時候，腦袋隱隱作痛…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "嘿嘿，今天是我們與瑪薇卡約好見面的日子，可要打起精神來哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
