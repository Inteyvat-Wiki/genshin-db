				]
			},
			"dialogs": [
				{
					"id": 50220401,
					"content": "（這裡是什麼地方？難道說…是夜神之國？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "（我為什麼會在這裡？剛才我分明是在…呃…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "（頭昏昏沉沉的，沒辦法正常思考。先到附近走一走吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
