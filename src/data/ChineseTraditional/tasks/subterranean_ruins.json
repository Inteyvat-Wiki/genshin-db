				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "（穿過光牆的那一剎那，身體彷彿被凍結了一樣。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "（夜神的庇護似乎無法到達這裡，冰冷與黑暗鑽入五官，耳邊全都是疲憊而痛苦的嘆息。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "（他們不知道已經走了多久，不知道還要走多久…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "（欸，那個人是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "故鄉迢遠，戰火肆燃，我等已流盡最後的鮮血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 50220706,
					"content": "再等一等，戰士們啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 50220707,
					"content": "（為什麼「隊長」會在這裡？他在說什麼…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "終有一日，我會將你們帶到約定的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「隊長」"
				}
			]
		},
