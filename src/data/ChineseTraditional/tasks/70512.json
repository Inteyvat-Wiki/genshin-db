				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}，{F#妳}{M#你}還想讀一讀老爺朋友的筆記嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120414,
					"content": "#如果{F#妳}{M#你}不想讀了，我們就直接過去，湊近點看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
