			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "嗚哇！怎麼突然冒出來這麼多魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120502,
					"content": "等等…那是迪盧克老爺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120503,
					"content": "和平時的迪盧克不太一樣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120504,
					"content": "銳氣滿滿，很有幹勁的樣子！難道這就是「正義人」火力全開的形態嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120505,
					"content": "是以前在這裡戰鬥的迪盧克吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "確實呢，仔細一看，這個迪盧克好像更年輕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120508,
					"content": "但是，以前發生了什麼事呢？迪盧克為什麼要在這裡戰鬥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120509,
					"content": "唔，等到之後去問他本人好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}，我們怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120511,
					"content": "不能草率行動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "好，那就來看看以前迪盧克戰鬥的作風吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120512,
					"content": "先觀察一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "地脈記錄並重現了當時的情景。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
