				{
					"id": 705120703,
					"content": "現在的迪盧克應該已經來過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "所以說，迪盧克已經收工了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120706,
					"content": "如果我們再觸碰那個異常的地脈淤積點，還會有魔物出現嗎？以前的迪盧克呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120707,
					"content": "就像以前在其他地脈淤積點做過的那樣，打敗所有出現的魔物後，異常的現象就會消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "派蒙"
				},
