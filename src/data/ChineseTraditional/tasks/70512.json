			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛德琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "#貴安，兩位。好久不見了，{F#妳}{M#你}們還是很有精神呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120202,
					"content": "愛德琳女僕長，妳好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120203,
					"content": "兩位是來找迪盧克老爺商議要事的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120204,
					"content": "只是為了葡萄汁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "確實，既然愛德琳小姐站在門口，還是直接拜託愛德琳小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120207,
					"content": "愛德琳小姐，我們總是錯過酒莊的特價葡萄汁，這次想早點過來預定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120208,
					"content": "我們多付一點訂金也可以哦，請給我們預留一瓶吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120209,
					"content": "當然沒問題，完全不用訂金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120210,
					"content": "#只不過，要麻煩{F#妳}{M#你}們稍微等等了。晨曦酒莊的特價葡萄汁需要不少準備時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120211,
					"content": "每年夏天，迪盧克老爺都會親自挑選兩桶品質上好的葡萄，用來製作特價葡萄汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120212,
					"content": "為什麼要把良品低價賣出去呢？「品質上好的葡萄」，明明一聽就很貴啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120213,
					"content": "老爺沒有明確解釋過，我也只能揣測他的想法——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120214,
					"content": "特價只是一種手段，標著特價的商品往往能吸引更多顧客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120215,
					"content": "也許老爺希望用這種方法讓果汁流行起來，為人們提供一種新的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120216,
					"content": "酗酒的人能找到理想替代品，這樣就不會在酩酊大醉後鬧事，不能喝酒的人們也可以獲得別樣的樂趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120217,
					"content": "酒莊的生意不會變差嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "老爺不是計較那一點小錢的人。也許，相比毫無節制地增長營收，他更希望人們都能適度飲酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120220,
					"content": "享受美酒和生活的同時也保持理智，不給別人增加麻煩…這不是很好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120221,
					"content": "迪盧克老爺可真是用心良苦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120222,
					"content": "所以現在，迪盧克正在挑選今年的葡萄嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120223,
					"content": "暫時還沒有。等到老爺處理完手邊的麻煩事，就會開始這道工序的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120224,
					"content": "#如果{F#妳}{M#你}們有興趣，老爺或許會邀請{F#妳}{M#你}們，參考{F#妳}{M#你}們的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120225,
					"content": "麻煩事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "兩位是知道的，老爺常常聽見風聲，提前去「招待」一些無禮無德之徒，這次也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120227,
					"content": "今天老爺大概是去鷹翔海灘附近了，還請兩位稍安勿躁，先到酒莊裡面坐坐吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120228,
					"content": "#我還要在門口等待某些客人，海莉和摩可會招待{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120229,
					"content": "無德…無禮？有點不明白愛德琳小姐的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120230,
					"content": "我猜，是迪盧克的「兼職」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "欸？難道說的是暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120232,
					"content": "咳咳！對付暗中作祟的深淵教團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120233,
					"content": "作為迪盧克老爺的夥伴，我們可不能坐視不理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120238,
					"content": "#如果{F#妳}{M#你}們兩位願意協助，也是一件好事。畢竟{F#妳}{M#你}們是老爺信任的人，實力有保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120239,
					"content": "感謝兩位主動伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 705120240,
					"content": "沒什麼啦！迪盧克老爺早點閒下來，我們也能更早買到好喝的葡萄汁嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120241,
					"content": "#走吧，{NICKNAME}，我們現在就去鷹翔海灘那邊看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120234,
					"content": "那就先去酒莊裡等迪盧克吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "唔，總覺得迪盧克在外面忙，我們卻坐在他家裡發呆，有點不合適呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120236,
					"content": "我們還是去鷹翔海灘那邊看看，幫迪盧克搞定那些麻煩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120237,
					"content": "雖然迪盧克老爺很強，但幫手總是多多益善的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120218,
					"content": "這是在開展額外業務嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "好像算不上要事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "看起來不像是迪盧克的帳篷，會是冒險家的營地嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120402,
					"content": "那裡有一張紙條和一本筆記？我們讀讀看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120403,
					"content": "誥告「暗夜英雄」，當年的異常現象再次出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705120404,
					"content": "原本你已徹底解決問題，但這次地脈又受到了某種刺激，再次釋放出了記錄中的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705120405,
					"content": "你想必會在第一時間趕來，處理掉威脅最大的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705120406,
					"content": "我就遵照行動守則，先去通知必要人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "調查"
				},
				{
					"id": 705120407,
					"content": "嗯…看這張紙條的口吻，好像是迪盧克認識的人呢，就先叫他「老爺朋友」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120408,
					"content": "他在這裡發現了什麼不得了的事，留下紙條給迪盧克老爺以後就離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120409,
					"content": "真粗心啊，這種紙條要是被別人看到了怎麼辦？還有筆記本，也沒帶走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120410,
					"content": "不過這麼說來，海灘上那個奇怪的地脈淤積點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120411,
					"content": "就是他所說的「異常現象」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "周圍沒有魔物，也沒有不對勁的地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
