					"nextDialogs": [
						718290704
					]
				},
				{
					"id": 718290704,
					"content": "那什麼…吃白食的，你在旁邊指導一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290705,
					"content": "嗯，首先，用劍把桌上的肉挑去筋絡，細細切碎，再敲打肉末，製成肉茸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290703,
