			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "咦？您可是位稀客。平日裡只有我和那廚子相對無言，今天多了您，說不定也會熱鬧一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290302,
					"content": "但我今天看那廚子愁眉苦臉的，也不知道是不是遇見什麼煩心事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪",
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "這獅子頭的味道果然不錯，這肉入口即化，湯汁也醇厚香濃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290402,
					"content": "唔？竟在肉中加入了蟹膏，怪不得嚐之鮮美異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290403,
					"content": "#來，旅行者，{F#妳}{M#你}也再嚐一個。我教{F#妳}{M#你}，先用筷子撥開獅子頭，再蘸以湯汁，隨米飯同嚼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290404,
					"content": "客氣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "#你們倆吃好喝好啊，反正我馬上就不在這裡幹活了，{F#妳}{M#你}想吃也吃不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290410,
					"content": "不在這裡幹活…這又是從何說起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290411,
					"content": "呀，難不成真是我在你這吃喝太多，惹你被掌櫃的嫌棄了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290412,
					"content": "也不該啊，我也釣了好幾尾好魚送進了客棧裡，應該能抵了飯錢，而且掌櫃的也不是這種小氣之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290413,
					"content": "你趁早給我歇了吧，你那幾條魚夠誰吃的，最後還不是都進了你的肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290414,
					"content": "那究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290415,
					"content": "唉…算了，我還是和你說吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290416,
					"content": "賣相足、味道好、夠大氣、顯手藝，還要有格調…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290417,
					"content": "哈哈哈，掌櫃的這是要你做一道世間不應有的奇菜啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290418,
					"content": "你還給我笑，你去笑吧。我看我走了之後，你還找誰蹭吃蹭喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290419,
					"content": "笑罷了，笑罷了。我說你這個廚子為什麼今天愁眉苦臉的，原來是遇見這樁事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290420,
					"content": "那可不，也不知道掌櫃的怎麼就突然異想天開，給我折騰的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290421,
					"content": "唔，你也莫急。雖然我不會做菜，但還真知道一份奇菜的菜譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290422,
					"content": "這是我當年在外遊歷時，偶然在一家大戶人家吃到的奇菜，叫做「雞豆花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290423,
					"content": "此菜「食肉不見肉」，食之嫩如豆花，卻又葷香醇厚，極盡鮮美，實為「以葷托素」的奇菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290424,
					"content": "我吃過後十分好奇，便去請教了菜譜過來，不過…我卻不擅長做菜，於是這菜譜也只能久壓箱底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290425,
					"content": "這種菜譜，你是怎麼請教到的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "嗯…簡單來說，當時我幫了那戶人家一個忙，他們當時也是設宴請的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290427,
					"content": "研究出這食譜的廚子也很有自信，說天下能做出這菜的人屈指可數，所以食譜抄了給我也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290429,
					"content": "這道菜確實很難做。按那廚子的說法，做這道的廚師不僅得精通廚藝，更要通曉劍術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290430,
					"content": "嘖，什麼菜還要曉得劍術。假若是要剁肉的話，我這刀法就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290431,
					"content": "要是真用你那刀法來錘茸，只怕是肉茸未錘得，案板先被你鎚作了兩段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290432,
					"content": "據那廚子所說，這道菜的精彩之處，皆在肉茸之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290433,
					"content": "須以精妙劍術馭刀，先以刃挑去筋絡，剁肉成泥，再以刀背錘打成茸，爾後再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290434,
					"content": "停，你給我停一下…那你這菜譜，說了不等於白說，我是個慣常使刀的，你是個從來不下廚的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290435,
					"content": "哪裡去找個又會下廚，又善使劍的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290436,
					"content": "這個嘛…遠在天邊，近在眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290437,
					"content": "我…我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "正是。這位旅行者不恰巧既會下廚，也善使劍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290441,
					"content": "#不如，就讓{F#她}{M#他}來試試做這道奇菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290442,
					"content": "但掌櫃的是要言笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "欸，掌櫃的是要這廚子琢磨新菜，只要新菜琢磨出來了，那找誰來做，再商議便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290444,
					"content": "廚子，你說是不是這個道理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290445,
					"content": "啊…對！是這個理，是這個理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290446,
					"content": "但是這雞豆花，究竟要用什麼食材呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290447,
					"content": "食材倒都是尋常的食材，只需禽肉、火腿、鳥蛋和金魚草便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290448,
					"content": "禽肉和火腿廚房裡還有備貨，但鳥蛋和金魚草…好像已經被我用光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290449,
					"content": "唉，早知道就不做那道松茸滑蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290450,
					"content": "#旅行者，請{F#妳}{M#你}幫我找一份鳥蛋，一份金魚草來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290451,
					"content": "找到之後，我們就一起來研究這道雞豆花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290452,
					"content": "#呃…當然，報酬不會少{F#妳}{M#你}的…這件事就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290439,
					"content": "我確實會點廚藝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "也很擅長使劍，對吧？我平日裡也觀察過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290428,
					"content": "這道菜肯定很困難吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "你還滿有心得的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "#哈哈哈，常吃如此美味，就算是我再笨也能吃出心得來，我再教{F#妳}{M#你}如何品這道燉魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290407,
					"content": "你不坐著一起吃嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "我？我可吃不下，我早就被掌櫃的訓飽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "言笑"
				}
			]
		},
