					],
					"speakerTitle": "奇怪的匿葉龍"
				},
				{
					"id": 750221009,
					"content": "#看起來好像不行耶…唉…不過就算牠們互相理解，我們也沒辦法和{REALNAME[ID(2)|SHOWHOST(true)]}說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750221010
					],
					"speakerTitle": "派蒙"
				},
