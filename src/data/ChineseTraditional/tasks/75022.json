			"dialogs": [
				{
					"id": 750220404,
					"content": "唔…沒辦法把牠叫醒嗎？真是的，氣死人了！牠不會是在故意裝睡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220405,
					"content": "嗯唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "睡是真的睡了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "（將夢話的內容說了出來…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "#{F#妳}{M#你}是說牠是故意堵在洞口要吃的？完全就是騙吃騙喝嘛…有種上當了的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220410,
					"content": "哼哼！不過既然這樣，就別怪我們不客氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220411,
					"content": "#不然就讓{REALNAME[ID(2)|SHOWHOST(true)]}鑽進去，把那個寶箱偷出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220412,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "牠不仁，也不能怪我們不義啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220407,
					"content": "在講夢話呢，不過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
		},
