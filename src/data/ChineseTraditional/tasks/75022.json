			},
			"dialogs": [
				{
					"id": 750220801,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "嘿嘿，幹得好！讓我們看看寶箱裡有什麼寶貝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220803,
					"content": "啊，什麼都沒有，怎麼只有一張紙條？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220804,
					"content": "原來留下紙條的才是牠真正的主人？那我們不是被這條龍騙了，是被牠的主人騙了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220805,
					"content": "真是不負責任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "對啊，雖然他重病纏身，但也不能把匿葉龍丟在這種地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220807,
					"content": "居然這樣利用別人的貪心…不對，是利用對龍的同情心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220810,
					"content": "唉…總而言之，總不能繼續讓牠騙吃騙喝，我們去找懸木人的首領，告訴他這件事好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220811,
					"content": "向「懸木人」的首領瓦伊納述說此事，並將他帶了過來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "#唉呀呀，{F#妳}{M#你}們找我的時候我就有所預感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220813,
					"content": "沒想到是「那個傢伙」留下的龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220814,
					"content": "「那個傢伙」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "是個做錯事後，因為害怕被懲罰主動離開部族的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220817,
					"content": "#不過罪人的名字這裡就不贅述了，可能他也覺得不是什麼好事吧？{F#妳}{M#你}看，他自己也未在這樣的信件後面留下名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220818,
					"content": "原來他的龍選擇了和他一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "不，不能說是選擇，龍是單純的生靈，不擅長衡量對錯。大多數時候會依照情感，信任自己的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220820,
					"content": "…果然，他還是本性難移，那點小聰明都用在欺騙的伎倆上。用這種手段騙別人，也騙自己的龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220821,
					"content": "我們會派人定期餵點吃的給這隻匿葉龍，畢竟是部族的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220822,
					"content": "至於「那個傢伙」…唉呀呀，這還真是個悲慘的結局，不過我也不會同情他，人應該對自己的所作所為負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊納"
				},
				{
					"id": 750220808,
					"content": "所以吃太多會被拋棄的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "哇！不要開這種玩笑啦！牠也有點無辜啊…說不定還在原地呆呆地等著主人回來，才不肯離開的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "派蒙"
				}
			]
		},
