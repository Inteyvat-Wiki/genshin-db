			"dialogs": [
				{
					"id": 750220701,
					"content": "嗯！嘿嘿，看起來就不錯，這個牠一定會喜歡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220702,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220703,
					"content": "#眼前的匿葉龍嘓嘓一口嚥下了眼前的食物。\\n{F#妳}{M#你}甚至都沒看清楚牠是怎麼吃下去的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
