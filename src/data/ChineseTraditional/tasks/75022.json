			},
			"dialogs": [
				{
					"id": 750220703,
					"content": "#眼前的匿葉龍嘓嘓一口嚥下了眼前的食物。\\n{F#妳}{M#你}甚至都沒看清楚牠是怎麼吃下去的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "牠牠牠…好會吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220305,
					"content": "派蒙這下有對手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "一份食物…好像不夠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "什麼啊！我對美食可是很講究的，才不會這樣狼吞虎嚥、囫圇吞棗…根本連味道都吃不出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220308,
					"content": "#是…是喔！沒看出來，這傢伙原來是隻「大胃龍」，還好{REALNAME[ID(2)|SHOWHOST(true)]}沒有這麼會吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220309,
					"content": "不過牠是真的餓壞了吧！好可憐，不然再給牠一份好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220310,
					"content": "啊嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想吃嗎？我們先把這隻龍龍餵飽，就給你吃好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220312,
					"content": "#很餓的龍嘓嘓一口嚥下了眼前的食物。\\n{F#妳}{M#你}眨眨眼睛，還以為是同樣的畫面出現了兩次…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "嗯嗯，這下總該吃飽了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220314,
					"content": "喂！等等，你怎麼又坐下來了！難道兩份也不夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220315,
					"content": "哇，吃飽了就趴下去睡，一點都不想讓開這個洞穴的樣子嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220316,
					"content": "#怎麼辦呀{NICKNAME}？這傢伙的行為我已經看不懂了…就算吃飽了要睡覺，也不要堵在洞口睡嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220317,
					"content": "牠好像也沒答應我們會讓開。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "總感覺被騙了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "好生氣，吃了我們那麼多東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220320,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#連{REALNAME[ID(2)|SHOWHOST(true)]}都看不過去了，{NICKNAME}，我們試試看有沒有辦法叫醒牠吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
