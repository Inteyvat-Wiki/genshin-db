			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安娜",
					"安東尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "原來如此，原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200102,
					"content": "哥，你知道這些植物除了做菜之外的用途嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200103,
					"content": "我怎麼可能知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200200104,
					"content": "我只知道在哪可以採到它們，還有它們到底能不能吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200200105,
					"content": "唔…那我就自己出去看看好了，放心啦哥，我只是去採集植物，絕對不會靠近魔物的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200106,
					"content": "唉，妳自己心裡有點數就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200200107,
					"content": "我知道啦。那我今天可要晚點回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200108,
					"content": "妳還在訓練嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "#旅行者！{F#妳}{M#你}來得正好，我正準備去野外觀察植物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200111,
					"content": "賽琉斯叔叔和我說，冒險家會經常在野外露宿，尋找食物是一項很重要的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200112,
					"content": "所以，我打算先去觀察一下野外的植物，把它們的分佈點和特性都記錄好，再慢慢背下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200113,
					"content": "這樣子，以後我在野外尋找食物的時候，至少知道哪些植物能吃，哪些植物不能吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200114,
					"content": "但是…光用文字描述的話，我覺得實在不夠直觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200115,
					"content": "#旅行者，我聽說{F#妳}{M#你}有一種叫做「留影機」的東西，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200116,
					"content": "#能不能請{F#妳}{M#你}幫我用「留影機」記錄一下幾種植物的生長環境？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200117,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "#那就請{F#妳}{M#你}先幫我去記錄一下嘟嘟蓮，小燈草，還有塞西莉亞花的生長環境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200119,
					"content": "然後再把這三種植物採下來帶給我，我要把它們做成標本保存下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200120,
					"content": "植物生長環境的記錄畫片、真實的植物標本，還有詳細的文字說明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200121,
					"content": "我的「冒險家植物筆記」讀起來一定會很不錯的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200122,
					"content": "#那就拜託{F#妳}{M#你}啦，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200123,
					"content": "清泉鎮的那潭泉水旁應該有很多嘟嘟蓮，小燈草能在奔狼領裡找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200124,
					"content": "塞西莉亞花嘛…那當然要去摘星崖啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200125,
					"content": "我得去其他的地方繼續觀察植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200126,
					"content": "#等{F#妳}{M#你}拍到了畫片，我們還是在城裡碰頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200109,
					"content": "妳訓練得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
				2002026
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002025",
							"2"
						],
						"stepId": 2002025,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "#旅行者，{F#妳}{M#你}已經回來了啊，怎麼樣？{F#妳}{M#你}拍到畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201002,
					"content": "全部拍好了，還都採來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#哇！{F#妳}{M#你}怎麼能這麼快全部拍好的…這就是經驗豐富的冒險家嗎？真厲害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201004,
					"content": "#謝謝{F#妳}{M#你}，旅行者！嗯…這樣吧，為了感謝{F#妳}{M#你}，我來親手做一道好菜給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201005,
					"content": "怎麼樣，看起來還不錯吧，要好好品嚐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201006,
					"content": "我回去接著寫筆記去了。嗯…這些植物的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201007,
					"content": "我得去問問傑克，看他知不知道怎麼做植物標本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201008,
					"content": "塞西莉亞花就不做標本了，插在花瓶裡好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
