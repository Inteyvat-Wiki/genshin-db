			"dialogs": [
				{
					"id": 766550101,
					"content": "菲林斯，你也上來了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766550102,
					"content": "兩位辛苦了，有人維護之後，這座燈塔的狀態好了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550103,
					"content": "嘿嘿，舉手之勞。不過就算我們再怎麼維護燈塔，這裡還是那麼黑，總有燈塔照不到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766550104,
					"content": "是的。和外面不同，墳場裡的時間彷彿永遠停在夜晚，停在那場戰鬥結束的晚上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550105,
					"content": "#我原本無意改變這裡的環境，是{F#妳}{M#你}們點亮了燈塔，推動了這裡的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550106,
					"content": "會影響你的生活嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "#如果{F#妳}{M#你}想問這樣是否會為我帶來不便，答案是否定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550110,
					"content": "生命是輪迴，即便沒有我們，這座島上的鬼魂們也會逐漸消散，回到地脈中去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550111,
					"content": "所以不用擔心燈塔無法照亮整座島，隨著鬼魂逐漸消失，籠罩這裡的霧氣也會變淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550112,
					"content": "太陽總要升起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 766550108,
					"content": "這是意外，抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "請不要道歉，我並不厭惡這種改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "菲林斯"
				}
			]
		}
	]
}