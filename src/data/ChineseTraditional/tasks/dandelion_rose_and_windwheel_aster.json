				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "#嗨，小可愛，見到{F#妳}{M#你}真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060102,
					"content": "雖然很少會在這種地方見面，但我此刻的心情，和麗莎是一樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060103,
					"content": "欸，怎麼能叫「這種地方」呢？酒館明明是娛樂休閒的好去處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060104,
					"content": "#{F#妳}{M#你}一定想不到，我可是費盡力氣勸了半天，才把這位大忙人從她那把椅子上請起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060105,
					"content": "才到這裡坐了沒多久，琴那張臉上呀，又寫滿了擔憂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060106,
					"content": "麗莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060107,
					"content": "畢竟騎士團事務繁多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "是啊，琴團長是代理團長嘛，當然會掛念團裡的事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060109,
					"content": "不過那句話怎麼說的…「來都來了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060110,
					"content": "#讓{M#他}{F#她}為妳們調兩杯好喝的吧，喝完就開心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060111,
					"content": "就當換換心情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "唉，需要學會放鬆的，就只有琴啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060113,
					"content": "小可愛，麻煩給我一杯情詩吧，中杯，要甜一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060114,
					"content": "琴呢？來點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060115,
					"content": "我的話…咖啡就好，也要中杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060116,
					"content": "琴團長平時咖啡喝得夠多了吧，要不要換點別的口味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060117,
					"content": "謝謝妳，不過，我還是想喝點提神的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060118,
					"content": "明白了，請稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "#嗯，辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
