			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎",
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "啊…就是這種甜味，真不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060202,
					"content": "咖啡非常醇厚，苦味也恰到好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060203,
					"content": "兩位滿意就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "…麗莎會那樣說，其實我也明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060205,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060206,
					"content": "最近我常常反思自己的不足。工作效率也好，辦事手腕也好…各方面都有提升空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060207,
					"content": "看來我身上這份壓力，已經在不知不覺中擴散給麗莎了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060208,
					"content": "這不完全沒明白嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060210,
					"content": "是啊。喏，小可愛一眼就看出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060211,
					"content": "我是看妳太過操勞，想帶妳品品酒，喝喝茶，體驗點開心的事情而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060212,
					"content": "結果來到酒館，妳還滿心想著工作，這才有些失落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060213,
					"content": "總像這樣緊繃神經，早晚會累趴下的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060214,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#{NICKNAME}，連{F#妳}{M#你}也這樣想嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060216,
					"content": "唔，所以說…學會休息，對我來說才是最大的挑戰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060217,
					"content": "借一句璃月俗語：「張弛有度」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "嗯！該工作的時候工作，該休息的時候休息。簡單來說，就是妳們倆加一加再除以二啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060219,
					"content": "好怪的說法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060221,
					"content": "我，我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060222,
					"content": "#謝謝{F#妳}{M#你}們。沒想到來這裡除了喝飲品，還能讓心情輕鬆不少。這就是麗莎和凱亞喜歡酒館的原因嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060223,
					"content": "是，也不全是。更重要的還要看調酒的是誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060224,
					"content": "#今天也是託小可愛的福才能說動琴，{F#妳}{M#你}真有口才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060225,
					"content": "這沒什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "呵呵，那我們就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705060228,
					"content": "今後有機會的話，我也會考慮再來這裡放鬆一下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060229,
					"content": "好耶，兩位慢走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060226,
					"content": "能幫到妳們就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}