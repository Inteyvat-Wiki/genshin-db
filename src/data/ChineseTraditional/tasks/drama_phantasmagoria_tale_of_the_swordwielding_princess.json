			"dialogs": [
				{
					"id": 790260101,
					"content": "歡迎！歡迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260102,
					"content": "歡迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260104,
					"content": "#您就是大名鼎鼎的{NICKNAME}！還有最好的夥伴——派蒙閣下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260105,
					"content": "哇！你怎麼知道我們的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260106,
					"content": "島上的貴客，我當然知道，因為我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260107,
					"content": "你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260108,
					"content": "我就是大名鼎鼎的暮夜劇團團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260109,
					"content": "原來真的有人自稱大名鼎鼎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "雖然你說自己大名鼎鼎，可是我們沒聽說過你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260111,
					"content": "沒關係！現在兩位已經聽說了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260112,
					"content": "經過緊鑼密鼓的籌備，我們的舞臺劇《王女執劍記》就要首演了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260113,
					"content": "演出一共五幕，每幕分為上下兩場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260114,
					"content": "貴賓們來得正是時候！馬上序幕就要開演！請您就坐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260115,
					"content": "後臺還有些事情需要處理，且容我先行告退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "暮夜劇團團長"
				},
				{
					"id": 790260116,
					"content": "暮夜劇團，傾力打造的舞臺劇，馬上開幕，請您欣賞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "暮夜劇團團長"
				}
			]
		}
	]
