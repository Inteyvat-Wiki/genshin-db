				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "卡嘉的手藝真不錯…還是晚點再回新基捷城好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034016,
					"content": "涅朵奇卡，又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "#哎呀，是要現在來分個勝負嗎？{F#妳}{M#你}、{F#妳}{M#你}這算是偷襲！一定要比的話，不如約好時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034018,
					"content": "我還想悠閒地玩一下呢，之前都沒有好好逛過那夏鎮。勝負的事，不如就以後再說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034002,
					"content": "關於新基捷城…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "在那裡生活的時候常常覺得窒悶，一旦離開了又有些想念…這還是我第一次離家這麼遠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034004,
					"content": "我原本以為其他地方也和新基捷城一樣生活著很多妖精呢，就算是至冬堡也有不少妖精嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034005,
					"content": "結果到了挪德卡萊，根本一個也沒見到，派蒙也說自己不是。應該不是因為他們不喜歡這裡的氣候吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034013,
					"content": "畢竟這裡都沒有暴風雪，在野外也不會因為沒有爐子就寸步難行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034014,
					"content": "對了，我在挪德卡萊看到有人在喝新基捷城產的酒呢，雖然知道酒業和礦業一樣出名，不過在這裡看到還是有點…感動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "涅朵奇卡"
				},
				{
					"id": 760034011,
					"content": "下次見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "#嗯！在那之前，祝{F#妳}{M#你}和我都好運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "涅朵奇卡"
				}
			]
		},
