			"id": 7369601,
			"completionStepIds": [
				7369601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369601",
							"2"
						],
						"stepId": 7369601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴哈爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "#{F#妳}{M#你}好，旅行者，看{F#妳}{M#你}的樣子…應該是來這裡參加學院遊樂會的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960102,
					"content": "有興趣的話，要不要來體驗一下我們室羅婆耽學院舉辦的活動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960103,
					"content": "我記得室羅婆耽學院研究的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "不嚴謹地用一個詞來概括的話，就是…「語言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960105,
					"content": "這就是我們室羅婆耽學院所研究的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960106,
					"content": "怎麼樣？是不是一聽就和學院遊樂會歡樂輕鬆的氛圍不搭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960107,
					"content": "我們學院裡的不少同學也是這麼想的，大家都在熱熱鬧鬧地玩，我們總不可能出去讓人猜謎吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960108,
					"content": "而且猜謎這種小遊戲，實在也無法引起大家的興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960109,
					"content": "在經過很多天的…友好討論後，我們研究出了這種名為「追溯求真」的小遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960110,
					"content": "#這個小遊戲也不需要太多道具，只要{F#妳}{M#你}調整好自己的思維就可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960111,
					"content": "#在這個遊戲的開始，我會向{F#妳}{M#你}講一個小故事。這個小故事也許聽起來沒頭沒尾，有些地方甚至有悖常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960112,
					"content": "#而{F#妳}{M#你}可以向我「提問」。對於{F#妳}{M#你}的提問，我會做出<color=#00E1FFFF>「是」</color>，<color=#00E1FFFF>「否」</color>和<color=#00E1FFFF>「沒有關係」</color>三種回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960113,
					"content": "#{F#妳}{M#你}所要做的，就是藉由{F#妳}{M#你}的「提問」來找出這個故事的「真相」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960114,
					"content": "#但{F#妳}{M#你}也不用太緊張，這個故事的真相不會太複雜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960115,
					"content": "怎麼樣？如果有興趣的話，我們現在就開始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960116,
					"content": "那就開始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "#沒問題，請{F#妳}{M#你}聽好第一個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴哈爾"
				},
				{
					"id": 736960118,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "#這段時間，我會一直在這裡，{F#妳}{M#你}想玩的話可以隨時來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴哈爾"
				}
			]
		}
	]
}