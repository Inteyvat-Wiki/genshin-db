	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮錦",
					"靈淵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "話說回來，這裡就是浮錦的洞天吧？總覺得和我們見過的其他洞天不太一樣，怎麼說呢…好像更…有現實感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270302,
					"content": "既沒有什麼奇奇怪怪的機關，也沒有什麼透明的浮空橋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270303,
					"content": "實在是對不起…之前覺得太丟人了，一直沒能解釋清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270304,
					"content": "我沒辦法像南方眾仙那樣創造出新的空間來。「錦落庭」不是什麼「洞天」，充其量也就只是個「洞穴」而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270305,
					"content": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不過，也不知道浮錦什麼時候才能變回人形呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270306,
					"content": "她累積的力量已經全部逸散到了這片土地上。短時間內應該沒辦法再恢復人形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270307,
					"content": "我耗盡力量的時候也是一樣。主人死去後，從雪落到雪融，再從雪融到雪落，如此反覆不知多少次，我才能再度化為人的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270308,
					"content": "原來是這樣…欸？等一下，原來靈淵也能化成人形嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270309,
					"content": "哼哼，那是當然！兩位有所不知，想當初，在藥君山的時候，靈淵的姿容可是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270310,
					"content": "浮錦。沒必要說下去。這和現在的話題沒有任何關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270311,
					"content": "欸？那化為人形以後，因為在廟會上吃了太多茶糕，哭著跑去求藥君幫自己調配減肥茶的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270312,
					"content": "或者不小心把慶典上的酒當作茶水喝了下去，拽著山間的林豬，問「藥君和我誰更美」的事情，果然還是沒必要說下去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270313,
					"content": "…浮錦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270314,
					"content": "嗚啊，妳這麼一說，我開始好奇靈淵化成的人形到底是什麼樣的了！會是像現在一樣藍藍的嗎？還是會…呃…更白一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270315,
					"content": "我也很好奇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "#我不理解{F#妳}{M#你}好奇的原因。{F#妳}{M#你}也是人。對人的形態感興趣，看看自己就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270321,
					"content": "#呵呵…總之，謝謝{F#妳}{M#你}們，{NICKNAME}和派蒙。我也沒有想到，有朝一日，還能像這樣和其他人交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270322,
					"content": "咳咳——既然小仙我心情大悅，不妨就護佑兩位接下來的旅途能夠一帆風順，時通運泰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270323,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270324,
					"content": "…對不起是我得意忘形了。我剛才想要像仙人那樣，說一下這句話試試看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270325,
					"content": "#無論如何，我都會在這裡祈願，願{F#妳}{M#你}們接下來的旅途一帆風順。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270317,
					"content": "靈淵，可以變一下看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "我拒絕。人類的身軀過於羸弱。沒有撕碎獵物的尖牙、沒有逐狩仇敵的利爪，除非浮錦命令，我不會做那種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270319,
					"content": "…欸？這、這個，我覺得還是應該尊重靈淵的想法吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270320,
					"content": "我沒有什麼想法。妳要是有想法的話，可以直接告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "靈淵"
				}
			]
		},
		{
			"id": 7112704,
