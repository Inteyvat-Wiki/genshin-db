			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"靈淵"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1493.597,
							443.529,
							2844.945
						],
						"pointId": 311600056
					},
					{
						"sceneId": 3,
						"position": [
							1493.036,
							443.555,
							2842.422
						],
						"pointId": 311600077
					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME}，還有派蒙。{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270402,
					"content": "欸，靈淵？為什麼妳會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270403,
					"content": "因為我進不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270404,
					"content": "進不去？是說進不去什麼地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270405,
					"content": "錦落庭。浮錦現在休息的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270406,
					"content": "錦落庭…唔…就是浮錦一開始把我們拉進去的那個地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270407,
					"content": "那裡是她用仙力封鎖的居所。我沒有她的仙力，去不到她的身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270408,
					"content": "啊？可是她之前回去休息的時候，妳也沒提這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270409,
					"content": "我沒想起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270410,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "#{F#妳}{M#你}們擁有她的仙力，能夠開啟錦落庭的大門。是的，希望{F#妳}{M#你}們幫助我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270416,
					"content": "欸？等一下，所以妳是一直在這裡等我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270417,
					"content": "#我不是在等{F#妳}{M#你}們。我是在尋找進入錦落庭的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270418,
					"content": "好像沒什麼不同…總、總之，我們也有些在意浮錦的身體狀況，那靈淵，我們一起去探望她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270419,
					"content": "#好。謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270420,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270412,
					"content": "阿藍，好笨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "就是就是！為什麼連這麼重要的事情都能忘啦！真是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711270414,
					"content": "因為我只是愚鈍的野獸。見到她，想了很多事情，忘了很多事情。是我的錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711270415,
					"content": "#{F#妳}{M#你}們擁有她的仙力，能夠開啟錦落庭的大門。希望{F#妳}{M#你}們幫助我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "靈淵"
				}
			]
		},
