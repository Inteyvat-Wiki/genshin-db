			"dialogs": [
				{
					"id": 740290201,
					"content": "…牠還會被餌料吸引嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊雅蕾"
				}
			]
		},
		{
			"id": 7402903,
			"completionStepIds": [
				7402905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402905",
							"2"
						],
						"stepId": 7402905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊雅蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "伊雅蕾將虛弱的「球球章魚」放入一旁的桶中…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "美麗的捕撈技巧…但是現在牠變得不美麗了。怎麼會這樣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290303,
					"content": "抱歉…沒想到伊雅蕾說的「那個」是指球球章魚，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290304,
					"content": "要怪就怪我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#都怪{NICKNAME}太性急啦！雖然我沒攔住{F#妳}{M#你}也不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290308,
					"content": "#{NICKNAME}老師和派蒙老師不用這樣道歉，牠現在已經在桶子裡了，這樣就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290309,
					"content": "好吧…不過為什麼這裡會有球球章魚？是順著水流意外掉到這裡的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290310,
					"content": "是我從外面抓回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290311,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290312,
					"content": "#因為想要試試看用魚竿釣魚的方法…所以去抓了「那個」，{F#妳}{M#你}們說的球球章魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290313,
					"content": "把牠放在這裡，就可以隨時來釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290314,
					"content": "原本以為是個很好的計畫，可是等了很久牠都不咬鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290315,
					"content": "雖然特地抓了球球章魚放進水池裡用來練習用釣竿釣魚這點也很令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290316,
					"content": "不過剛才我們也只是往水裡撒了一些散餌就把牠吸引到水面了吧？伊雅蕾之前沒有想過多撒一些餌料之類的辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290317,
					"content": "之前試過很多餌料，比如肉糜、麵包屑、蠕蟲、薄荷、零件之類的…牠吃過之後就再不出現啦，我還以為餌料對牠沒用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290318,
					"content": "零、零件？！這聽起來可不像是餌料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290319,
					"content": "不要拿奇怪的東西餵水產。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "嗯！不過水產這個叫法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290323,
					"content": "嗯，而且零件是很重要的東西，不是給球球章魚吃的餌料，得想個辦法取出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290324,
					"content": "#對了，為了感謝{NICKNAME}老師和派蒙老師的幫助，這個零件給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290325,
					"content": "…不、不用了吧，我們也沒幫上什麼大忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290326,
					"content": "欸？可是德拉蘿詩說過，需要別人幫忙的時候，叫對方「老師」，並且「付費諮詢」的話，對方會很高興。難道不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "伊雅蕾"
				},
