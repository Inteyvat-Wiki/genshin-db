			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊雅蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "為什麼要在這種地方放釣竿？難道是在釣魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290102,
					"content": "又有水，又有釣竿，當然是在釣魚啦。明明是從外面來的人，居然這麼沒見識，這就是所謂的「世風日下」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290103,
					"content": "跟世風日下應該沒關係…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "對啊！再說了，我們才不是對釣魚一無所知的門外漢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290107,
					"content": "我想說的是…我還以為美露莘不會用魚竿釣魚，而且…唔，感覺怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290108,
					"content": "哪、哪裡奇怪了？我可是按外面的人教我的方法做的。德拉蘿詩很好，不僅教我釣魚，還送了我釣竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290109,
					"content": "雖然她的釣竿看起來比較厲害，不過她是「專業人士」，我只是「愛好者」，所以有這個就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290110,
					"content": "唔…不過我都等了好久了，為什麼還不上鉤？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290111,
					"content": "#嘿嘿，既然這樣，不如就讓{NICKNAME}老師和派蒙老師來幫妳分析一下原因吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290112,
					"content": "#{NICKNAME}老師和派蒙老師真的比她還厲害嗎？她可是有著美麗釣竿的專業人士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290113,
					"content": "哼，這種時候就該用實力證明自己，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290114,
					"content": "但是這裡真的有魚嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "哦！說起來的確是這樣…一開始我會覺得奇怪也是因為這個！一點魚的影子都看不到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290116,
					"content": "魚…德拉蘿詩說過，水裡的不一定都是水產。唔，「那個」可以算是魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290117,
					"content": "…難道是因為「那個」不是魚，所以我用釣「魚」的辦法才釣不上來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290118,
					"content": "#{NICKNAME}老師…還有派蒙老師！請教教我，應該怎麼做才能把「那個」釣上來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290119,
					"content": "哦、哦！伊雅蕾真有禮貌啊…當然沒問題了，不過妳說的「那個」到底是指…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290120,
					"content": "牠在水裡游得好快，而且滑溜溜好難抓住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290121,
					"content": "聽起來像魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "其他的水下生物也是有可能的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290125,
					"content": "唔…總之，至少能確定應該是在水中生活的生物，既然從水面看不到影子，或許是藏在深水處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290126,
					"content": "依我看，這種時候就應該用「散餌」，用食物把牠從深水處吸引上來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290127,
					"content": "可是牠之前已經吃了很多…不知道換別的魚餌會不會有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290128,
					"content": "嗯，我們先往水裡撒一些散餌，之後再準備好魚竿，最後就只用等牠上鉤啦。雖然還不知道牠是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290129,
					"content": "#美麗的釣魚技巧…我再試試。餌料交給{NICKNAME}老師和派蒙老師，我會看好釣竿做好準備，雖然不是專業人士的美麗釣竿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "伊雅蕾"
				},
				{
					"id": 740290130,
					"content": "沒問題，撒散餌這點小事就交給我們好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290123,
					"content": "聽起來像美露莘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "是伊雅蕾在和其他美露莘玩假裝釣魚的遊戲…這也太奇怪了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740290105,
					"content": "派蒙當然知道釣魚是怎麼回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "#對啊，畢竟我就是被{NICKNAME}用魚竿釣起來的嘛…不對，問題不在這裡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7402902,
