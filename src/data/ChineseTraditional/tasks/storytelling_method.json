			"dialogs": [
				{
					"id": 728120201,
					"content": "好了，故事就到此結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120202,
					"content": "我從來沒這麼累過，這故事真的有這麼複雜嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120203,
					"content": "這就是你不事先定好設定的下場。沒有設定束縛，故事裡的所有元素都會亂七八糟地撞來撞去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 728120204,
					"content": "在這種情況下，你對故事根本沒有任何掌控力，無論寫什麼劇情都會累個半死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 728120205,
					"content": "唉，我沒力氣和你爭了…旅行者，謝謝您做出的這些…判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120206,
					"content": "這些判斷實在是讓我…獲益匪淺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120207,
					"content": "這些謝禮請您收下，我等會就回去接著寫小說去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120208,
					"content": "設定和劇情，唉…到底哪個比較重要呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		}
	]
