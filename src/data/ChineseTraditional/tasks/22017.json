				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "#旅行者，{F#妳}{M#你}把那些小說帶來了吧，快拿出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "這本懸疑小說我記得還流行了很長時間，不是很受歡迎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170402,
					"content": "這本小說之所以成功，就是因為裡面那些巧妙的謎題與劇情設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170403,
					"content": "雖然有很多讀者都說某些劇情太過於跳脫和出乎意料，有點無法理解，但作者還是堅持自己的原則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170404,
					"content": "這樣做之後，這本小說才能從其他懸疑小說裡脫穎而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170405,
					"content": "但這本小說，也有著堅實的設定基礎吧。只有堅實而又絕對不輕易更改的設定，才能支撐這樣一部懸疑小說的劇情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170406,
					"content": "呃…這…旅行者，還有其他的書嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "這本小說？我記得文筆很優秀，劇情和情節也都很嚴謹，編輯們可都是一致稱讚的，當時的銷量也非常不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170502,
					"content": "…是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170503,
					"content": "但這本小說因為過於在意劇情和設定的嚴謹，沒有為故事留出任何延展的空間，到最後只能不斷重複讀者已經知道的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170504,
					"content": "但是，因為再沒有出現任何新鮮的故事，這本小說逐漸失去了一個又一個讀者，到了最後一個讀者放棄它之後，它就這樣默默消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170505,
					"content": "無論是設定還是劇情，如果真的被侷限在一個框架裡，只會讓每個故事都變成一個模樣，然後逐漸變成一灘毫無活力的死水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170506,
					"content": "我不想我的小說也變成這樣！一個好故事，首先應該擁有的就是與眾不同的活力才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170507,
					"content": "而且，如果…如果作者自己都對自己的故事提不起興趣的話，那又要怎麼感動讀者呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170508,
					"content": "阿茂先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170509,
					"content": "…我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170510,
					"content": "沒想到，你這傢伙還想得挺多的嘛，不愧是寫出《鬼武道》的作家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170511,
					"content": "其實，我也並不是想要限制你的創作。但我見過太多的作者，因為過度的想像力和創作欲而毀了自己的作品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170512,
					"content": "順吉，我不知道你身為一個作家，對創作這件事怎麼看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170513,
					"content": "我認為是創作欲。沒有創作欲的作者，一定創作不出能感動讀者的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170514,
					"content": "但在我看來，對一個作家來說，對於創作欲的自制才更加重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170515,
					"content": "還是達不成共識嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "阿茂先生，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170518,
					"content": "但寫這本小說的人並不是我，你才是這本小說的作者，我只是一個盡力幫助你完成這本書的編輯而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170519,
					"content": "如果你真的有自己的想法和堅持，那就按照你自己的想法來創作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170520,
					"content": "我不能說我會和你達成共識，我只能說，我會努力理解你。",
