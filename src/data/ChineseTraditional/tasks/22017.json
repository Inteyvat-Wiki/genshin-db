			"trigger": {
				"objectNames": [
					"順吉",
					"阿茂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170201,
					"content": "旅行者，請去拿幾本小說過來吧，我要好好和他談一談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170202,
					"content": "哼，要是真的讓他隨心所欲地寫，才會真正毀了這本小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿茂"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201703",
							"2"
						],
						"stepId": 2201703,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2201701"
