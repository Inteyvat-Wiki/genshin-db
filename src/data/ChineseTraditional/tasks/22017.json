			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"順吉",
					"阿茂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "不寫了，不寫了！這次你怎麼催我都沒用！我不當作家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170102,
					"content": "你這傢伙…你已經用罷工威脅我七次了，哪次當真過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170103,
					"content": "你們怎麼又吵起來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#{F#妳}{M#你}總算來了，旅行者！{F#妳}{M#你}可得幫幫我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170105,
					"content": "#自從{F#妳}{M#你}上次幫他說話之後，這傢伙可找到了藉口，從那以後他就愈來愈過分，給我定下了幾十條規矩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170106,
					"content": "小到能力命名，大到情節轉折，他全都要弄一套什麼…什麼寫作標準！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170107,
					"content": "這樣子我還寫什麼小說，他自己按流程寫不就好了嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170108,
					"content": "那些可都是我從成功的小說裡提煉出來的寫作原則，都是前人的經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170109,
					"content": "這樣不就是把其他小說的橋段強加到我的作品裡嗎？那到底是我在寫小說，還是那些「前人」們在寫小說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170110,
					"content": "我絕對不會寫這種…這種死板的東西的，要寫的話，你自己去寫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170111,
					"content": "而且，「八重堂」裡不是就有很多這種小說滯銷嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170112,
					"content": "那只是銷售策略的失誤，和小說本身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170113,
					"content": "這根本就和銷售策略什麼的沒關係，純粹是因為這些書的作者們的寫作方式出了問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170114,
					"content": "你可能不會注意到每一本出版的書，我身為作者，可是把「八重堂」出版的每一本都好好讀完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170115,
					"content": "旅行者，請去拿幾本小說過來吧，我要好好和他談一談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "要拿什麼小說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "#{F#妳}{M#你}就把我放在周圍的那幾本小說拿過來吧，我經常拿這幾本小說來…警惕自己，絕對不能寫成這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
