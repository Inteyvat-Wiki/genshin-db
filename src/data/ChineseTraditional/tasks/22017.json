	"talks": [
		{
			"id": 2201701,
			"completionStepIds": [
				2201701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
