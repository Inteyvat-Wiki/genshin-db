				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "你們三個，誰是老大？站出來面對我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350102,
					"content": "我「千日喧嘩大飛車」可是精銳中的精銳，代表「花角玉將」大人，來取你們荒瀧派老大的首級！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350103,
					"content": "嗚哇，好凶好凶！說話也好狠！這次好像真的來了個強人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727350104,
					"content": "什麼亂七八糟的！還有，你的稱號裡居然也用了「大」字，是想和本大爺搶風頭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350105,
					"content": "本大爺揍的就是你這種精銳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350106,
					"content": "好好高的男人，居然還是…鬼族！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350107,
					"content": "如此豪氣颯爽的傢伙，怎麼會玩鬥蟲這種小孩喜歡的遊戲…真是見鬼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350108,
					"content": "你說什麼？你在小看鬥蟲嗎？真是膽大包天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350109,
					"content": "根本不懂鬥蟲精髓的傢伙，必須由熱愛鬥蟲的人來矯正！本大爺就好好教訓你一回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727350110,
					"content": "教訓他！教訓他！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "對對對，可不能讓他一直這麼囂張！就看你的了，放牛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727350113,
					"content": "沒辦法了…來就來，誰怕誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「千日喧嘩大飛車」"
				},
				{
					"id": 727350111,
					"content": "教育他！教育他！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
