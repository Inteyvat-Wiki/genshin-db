			"trigger": {
				"objectNames": [
					"老圖",
					"阿昊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#嘿，{NICKNAME}，我們這剛打包好{F#妳}{M#你}就下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715040202,
					"content": "#那個須彌佬已經跟{F#妳}{M#你}說了吧，要用這個熱氣球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715040203,
					"content": "什麼叫「須彌佬」啊，胡塞尼可是來幫我們處理這些黑泥的，須彌的大學者，你就不能尊重別人一點嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040204,
					"content": "你、你懂什麼，這種稱呼也是一種表示熟絡的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715040205,
					"content": "行了，熱氣球也確定能夠使用，清理黑泥用的儀器也都準備好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}，如果{F#妳}{M#你}需要挖礦巨星我的幫忙…咳咳…咳咳…算了，我大概也幫不上什麼忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715040207,
					"content": "知道就好，你還是好好休息著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040208,
					"content": "#唉，總之，{F#妳}{M#你}要是打算開始搬運，啟動熱氣球就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老圖"
				}
			]
		},
