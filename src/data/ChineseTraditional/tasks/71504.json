				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040102,
					"content": "胡塞尼，你怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040103,
					"content": "之前在礦道處為了想出將「普爾希娜光釘」搬運到地脈噴口的辦法，在礦道逗留了太久，受到了一些影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040104,
					"content": "不過沒什麼大礙，休息一下以後，已經恢復很多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040105,
					"content": "與此同時，我也已經想出了解決方案，只是找一個搬運「普爾希娜光釘」的辦法，還能比找一個拖延交研究報告的藉口困難？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040106,
					"content": "黑泥覆蓋了地面，那就稍微浮空一點，用熱氣球在礦道進行搬運不就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040107,
					"content": "這麼一說，熱氣球確實還算是不錯的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040108,
					"content": "當然，這樣雖然可以一定程度上解決了黑泥的問題，但是有過量黑泥淤塞通道的時候，也還是會影響熱氣球的前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040109,
					"content": "以及，黑泥周圍還會有引來的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040110,
					"content": "#這些恐怕就得交給{F#妳}{M#你}們解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040111,
					"content": "#放心吧，我和{NICKNAME}聯手，一定能把那些靠近熱氣球的怪物統統打跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040112,
					"content": "等等主要看妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "#我、我主要是在旁邊負責幫{F#妳}{M#你}加油打氣嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040115,
					"content": "哈哈哈呃咳、咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040116,
					"content": "這麼笑了一下就咳得那麼厲害…總之老圖和阿昊在幫忙打包「普爾希娜光釘」，做熱氣球的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040117,
					"content": "本來我想親手做「普爾希娜光釘」的打包的，可就多站了一下子，咳嗽咳得手都發抖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040118,
					"content": "真是慚愧，看來以後不僅要做學術研究，還得注意鍛煉一下身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040119,
					"content": "#{F#妳}{M#你}快點去找他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040113,
					"content": "我手上這把劍就暫借妳一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
		{
			"id": 7150402,
