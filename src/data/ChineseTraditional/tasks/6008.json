			"dialogs": [
				{
					"id": 60080101,
					"content": "又過去了幾天，這裡怎麼樣了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080102,
					"content": "變化似乎沒有想像中那麼大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "看來逐漸穩定下來了呢，菈烏瑪真有本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080104,
					"content": "菈烏瑪，我們來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080105,
					"content": "這幾天怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "收尾工作比我想像中複雜很多，打理累積下來的問題並不是一件容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080107,
					"content": "按照現在的進度，大概還需要幾週的時間。所幸，留下的人也像是掃除了心中的迷惘，變得更加積極了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080108,
					"content": "彷彿此時此刻，他們才真正邂逅了屬於自己的信仰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080109,
					"content": "這都是妳的功勞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080110,
					"content": "不要這麼說，我本應該更早去做這件事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080111,
					"content": "#最近我都在調養自己的身體，既然「月髓」現在由{F#妳}{M#你}保管，我應該能試著幫{F#妳}{M#你}探究過去的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080112,
					"content": "謝謝妳，還記得這件事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "說起來，關於那個詭影，妳聽說過什麼新消息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080114,
					"content": "嗯，我嘗試問過一些人，但沒有什麼情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080115,
					"content": "#{F#妳}{M#你}們那邊如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080116,
					"content": "進展不多，但現在是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080117,
					"content": "#大概明白了…{F#妳}{M#你}們的工作也不比任何人輕鬆。請多照顧好自己的身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080118,
					"content": "#那麼，{NICKNAME}，請到這邊來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "#{F#妳}{M#你}看到什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080121,
					"content": "（這裡是…挪德卡萊？我好像對這風景有印象…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "（天空中那是…一顆流星？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "（…！不對！那是我們的飛船！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "結、結束了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080125,
					"content": "這似乎是很久以前發生的事，我感受到的記憶湧動十分紊亂，憑我的力量只能看到這麼多資訊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080126,
					"content": "（至少知道了我們的飛船迫降在挪德卡萊的位置…好像是在星砂灘附近。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#（也和{M#熒}{F#哥哥}告訴我的事實對得上…但，果然還想知道更多…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 60080129,
					"content": "欸，你突然怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080130,
					"content": "花的顏色變了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080131,
					"content": "（這種花是「少女」力量的寫照。難道說她的身體又…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "（我記得她好像說過，想用「月髓」來恢復一些力量…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "嗯，我懂！我們還是快去見她吧，看看有沒有什麼能幫到她的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080135,
					"content": "#那就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080136,
					"content": "對了，這個是妳之前拜託「秘聞館」準備的藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080137,
					"content": "謝謝妳們專程送過來，幫了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080138,
					"content": "#另外…我有一個推測。關於{F#妳}{M#你}的飛船，或許「庫塔{RUBY#[S]月之少女}爾」能為你展現更多片段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60080139,
					"content": "對哦！她可是「月神」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080140,
					"content": "但首先還是確保她沒什麼大礙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080141,
					"content": "那我們待會見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
