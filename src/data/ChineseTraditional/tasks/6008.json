					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "嗯？妳說什麼，可以再說一遍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080402,
					"content": "啊？就是妳…呃，以前的同僚？「木偶」和我們一起在星砂灘的時候，好像也被「狂獵」給打敗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080404,
					"content": "呃…妳剛才是笑了一下嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080405,
					"content": "…沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080406,
					"content": "（絕對是笑了吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080407,
					"content": "妳和她關係不好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080408,
					"content": "不，只是能想像到她不服氣的表情，覺得很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080409,
					"content": "她當時好像很受挫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080410,
					"content": "那只是暫時的，她很擅長自我調適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080411,
					"content": "#話題扯遠了，既然我們已經知道盯上「月髓」的傢伙這麼危險，{F#妳}{M#你}真的還要隨身攜帶它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080412,
					"content": "若是「愚人眾」的情報可靠。那當獵月人施展全力的時候，整個挪德卡萊加起來都不是他的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080413,
					"content": "現在…或許有什麼原因限制了他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080414,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "在決定之前，我有件事想拜託哥倫比婭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080417,
					"content": "#不知道妳能否讓我看到，我和{M#妹妹}{F#哥哥}的飛船剛降落到挪德卡萊時，發生的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "可以哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080419,
					"content": "答應得好乾脆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080420,
					"content": "我說過，這對我來說不過是捧起一束月光而已，沒什麼難的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080421,
					"content": "手給我。做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080422,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "（和之前看到的一樣，只不過更清晰了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "（還好當時安全迫降了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "（好像過了很久…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#（{M#熒}{F#哥哥}和我應該還在裡面，我們居然在飛船裡待了這麼長時間…{M#熒}{F#哥哥}究竟是什麼時候出去的呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#（咦？！那是…{M#熒}{F#哥哥}？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "（為什麼…明明飛船迫降之後，根本沒有人出去過！飛船的門在此之前也沒打開過！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "這裡是…哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#哥哥}{F#熒}！快走，我們離開這裡！",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "…欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}還好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080434,
					"content": "我們的飛船…迫降後過了很長一段時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#從沒有人離開過飛船，但{M#熒}{F#哥哥}…卻是從飛船外找到我的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "欸？！這…這怎麼可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080437,
					"content": "我不知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "回憶中隱藏的秘密就像是餅乾，咬一口就會撒得到處都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080439,
					"content": "（這件事…太蹊蹺了，我必須要追查清楚。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "（但正如奈芙爾所說，如果挪德卡萊在這之前就遭遇毀滅性的災難，那就無從查起了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "「月髓」就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "#欸、欸？呃…好吧，既然{F#妳}{M#你}都這麼說了。但這個東西…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080444,
					"content": "需要我幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080445,
					"content": "妳指的是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "#我可以幫{F#妳}{M#你}們隱藏「月髓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080447,
					"content": "真的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080448,
					"content": "#它在{F#妳}{M#你}體內本來就不易察覺，我可以再教給{F#妳}{M#你}一些使用月矩力的辦法，進一步遮蔽「月髓」的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080449,
					"content": "就像這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080450,
					"content": "哦！就像是一個護盾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080451,
					"content": "（這是…好輕柔的感覺…就像月光一樣…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "感覺到了嗎？現在試著維持它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080453,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "#{F#妳}{M#你}學得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080455,
					"content": "好像還滿堅固的，這關鍵時候都可以用來防身了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080456,
					"content": "謝謝妳教我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "哥倫比婭平時真的都在這裡嗎？也不出去走走？雖然現在出去可能有點危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080458,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080459,
					"content": "不喜歡陌生人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080460,
					"content": "我們算「熟人」了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "比陌生人好一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080462,
					"content": "等「狂獵」的事告一段落…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "對呀對呀，現在「霜月之子」和以前也不一樣了，妳說不定會喜歡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080465,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080466,
					"content": "我會考慮的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080467,
					"content": "她看起來有點累了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080468,
					"content": "好久沒說這麼多話了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "總之，謝謝妳願意幫我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080470,
					"content": "…這沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080471,
					"content": "#這裡的花，喜歡{F#妳}{M#你}這樣的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080463,
					"content": "一起出去走走吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}