			"dialogs": [
				{
					"id": 60080201,
					"content": "「少女」看樣子沒精打采的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080202,
					"content": "打擾了，妳…妳還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080203,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080204,
					"content": "身體情況又惡化了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "…暈暈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080206,
					"content": "…好像要回到月亮上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080207,
					"content": "那倒也不至於吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080208,
					"content": "#嗯？那是…我從{F#妳}{M#你}身體裡…感受到了月亮的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080209,
					"content": "我們從「愚人眾」手中奪回了「月髓」，它能幫到妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "#嗯…這次{F#妳}{M#你}們需要什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080211,
					"content": "怎麼還在說這些啦？現在是妳的身體要緊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080213,
					"content": "（難道說…這是她的某種習慣嗎？因為一直生活在互相利用的環境中…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "或許妳之後可以幫我個忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "…嗯，好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080216,
					"content": "#把{F#妳}{M#你}的手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080217,
					"content": "#呼…謝謝{F#妳}{M#你}，我回到地面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080218,
					"content": "妳本來就在這裡啦…現在怎麼樣？沒問題了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080219,
					"content": "好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080220,
					"content": "妳做了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "#月亮在{F#妳}{M#你}體內安靜得像個水面的倒影…真奇妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080223,
					"content": "我不過從水中捧走了一束月光而已，足夠我暫時回到地面的一束月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080224,
					"content": "我似乎還感受到了一些其他變化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "那是「月神的賜福」。只要同我相觸之物，就會帶上這種印記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080226,
					"content": "這印記是無害的，過一段時間就會自己消去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080227,
					"content": "說到這個，既然妳都恢復力量了，那要不要把「月髓」交給妳保管呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080228,
					"content": "照理說這也是屬於「神明」的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080229,
					"content": "這是「恆月女神·艾莉亞」的遺骸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080230,
					"content": "果然是…欸？！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080231,
					"content": "#{F#妳}{M#你}們之前不知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080232,
					"content": "菈烏瑪只說它和其他碎片不一樣，能從中感受到神明的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080233,
					"content": "她說得沒錯。剛才我捧走月光的時候，也捧回了一些月髓中的「記憶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080234,
					"content": "這份「記憶」讓我知道了，它屬於曾經那位「恆月女神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080235,
					"content": "菈烏瑪應該也藉由「月髓」看過以前的歷史，她怎麼沒發現呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080236,
					"content": "（菈烏瑪說自己只能看到過去的片段，而且還很模糊…說不定這是只有「月神」才能感覺到的東西…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "過去的天空有三月，又有三位女神執掌著屬於自己的月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080238,
					"content": "但葬火之戰後，三位女神均已逝去。三輪月亮則有兩輪在戰爭中破碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080239,
					"content": "恆月的「艾莉亞」死後，其力量凝聚為了這顆月髓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080240,
					"content": "「虹月」的遺骸從未被找到，「霜月」女神雖亡，但月亮的身形不曾破碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080241,
					"content": "正如預言所述，這樣的月亮遲早將孕育出新的神明，也就是「霜月之子」口中的「庫塔{RUBY#[S]月之少女}爾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080242,
					"content": "我能感覺到自己的力量屬於「霜月」。但它位於虛假之天外，離我太遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080243,
					"content": "現在的我不說「操控」它，有時就連「感受」它都顯得吃力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080244,
					"content": "我，我數一下…我們拿到的是「恆月」，「虹月」的找不到…這麼說的話，妳身體裡是有「霜月」的月髓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080245,
					"content": "不，「月髓」是月神死後才會凝結而成的東西。其本質是一種力量核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080246,
					"content": "就像妳不該問月亮上有沒有石頭一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080247,
					"content": "哦！是說妳本身就代表著「霜月」的力量，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080248,
					"content": "#嗯。擁有「神之心」的魔神被稱為神明，擁有「月髓」的{F#妳}{M#你}…是不是也能當「月神」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080249,
					"content": "這不太一樣吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "#{F#妳}{M#你}不想當月神嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080251,
					"content": "問題不在這裡啦！妳好像真的很想把這個稱號讓出去欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080252,
					"content": "總之，拋開誰當月神的問題不談，我們是不是應該把這顆「月髓」還給妳呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080253,
					"content": "我不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080254,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080255,
					"content": "而且它看起來也不想到我這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080256,
					"content": "什麼意思…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080257,
					"content": "剛才接觸它力量的時候，我感受到的是一種「排斥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080258,
					"content": "或許因為我也是「月神」吧，就像兩輪月亮不會同時升起，更無法相互吞噬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080259,
					"content": "那看來還是只能我帶著了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#真的嗎？雖然菈烏瑪說這力量在{F#妳}{M#你}體內藏得很好，但「少女」剛才不也感受到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080261,
					"content": "「狂獵」看起來也不是普通的東西，如果被它察覺到的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080262,
					"content": "#「狂獵」？{F#妳}{M#你}們描述這種現象的語氣像在描述一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080263,
					"content": "因為它看起來就是有幕後黑手嘛，甚至像人一樣有著明確的目的…之前就追著「月髓」不放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080264,
					"content": "聽起來有點耳熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080265,
					"content": "欸？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080266,
					"content": "我還在「愚人眾」的時候，聽同僚們提起過一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080267,
					"content": "他來自坎瑞亞，在災變時期獲得了「深淵」的力量，而且對於「月亮」有很強的執念…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080268,
					"content": "坎瑞亞？雖然那個詭影和坎瑞亞有沒有關係我們不知道，但其他聽起來都對得上欸…那他的名字是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080269,
					"content": "我只知道，別人稱他為——「獵月人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080270,
					"content": "五大罪人？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "哦，是還有這麼一個稱謂沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080272,
					"content": "欸？！是…是戴因提到過的那個？我們現在的對手…是傳說中的五大罪人…「獵月人」雷利爾？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080273,
					"content": "但如果是五大罪人的話…他不該只有這些實力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "聽說「獵月人」在坎瑞亞災變之後不久就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080275,
					"content": "我問同僚他去了哪，他們卻反問我說「妳真的不知道？」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080276,
					"content": "為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080277,
					"content": "因為據說獵月人最後的結局，是掉進了那個再也回不來的「月亮倒影」裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080278,
					"content": "等等等等…東西太多，我都反應不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080279,
					"content": "我那時也這樣。他們總覺得，只要是和「月亮」有關的話題，我就一定知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080280,
					"content": "#但我告訴過{F#妳}{M#你}們了…我的「序章」遺落在虛假之天外，我連自己的名字都不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080281,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080282,
					"content": "總之在「獵月人」消失之後，挪德卡萊的「狂獵」現象急劇惡化，成了深淵災難的代名詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080283,
					"content": "現在的狂獵，只是傳承了那個名字，有相似的現象，但規模和危險程度已經遠超往日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080284,
					"content": "我還是很難相信，我們現在的對手居然是傳說中的「五大罪人」之一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080285,
					"content": "這也太危險了吧！星砂灘那時感覺只是僥倖…或者是他沒使出全力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080286,
					"content": "即使這樣…就連那個「木偶」也還是被他打敗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60080221,
					"content": "或者說，我做了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
