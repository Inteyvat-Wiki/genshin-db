				},
				{
					"id": 730240402,
					"content": "嘿呀！可惡的蘑菇！回去回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240403
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240403,
					"content": "#嗚哇，{NICKNAME}，那個人好像有危險！",
