			"trigger": {
				"objectNames": [
					"拉娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730240501,
					"content": "#哎呀，真是幫大忙了！謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240502
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240502,
					"content": "如兩位所見，我是這邊的巡林官。名字嘛，叫拉娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240503,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "我的名字叫派蒙！我們是從別的國度來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240507,
					"content": "原來如此。嗯…從穿著打扮來看，確實不像是森林的子民…也不像是從黃沙裡來的。透氣性看起來很好，很適合在須彌行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240508,
					"content": "咳咳！不管怎麼說，我們巡林官的職責是保護森林、幫助旅人、提供指引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240509,
					"content": "#誠如{NICKNAME}和派蒙所見，最近林子…應該說狀況不太理想吧？無論是「蕈獸」，還是猛獸，都特別狂躁。還有「死域」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240510,
					"content": "#不如讓我送{F#妳}{M#你}們一程吧？我的巡林路線接下來會經過維摩莊。到那邊沿著水路，無論是去奧摩斯港，還是須彌城，都很方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240511,
					"content": "可以，我們走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "嗯，我會保障兩位平安的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240513,
					"content": "好，不過暫時有點別的事要處理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "#我明白了，我會暫時在這裡等{F#妳}{M#你}們。要注意安全喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240505,
					"content": "我們來自很遠的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#嗯！我叫派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}