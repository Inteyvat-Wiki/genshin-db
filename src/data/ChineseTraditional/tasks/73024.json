			"trigger": {
				"objectNames": [
					"拉娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730240101,
					"content": "#哎呀，真是幫大忙了！謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240102,
					"content": "如兩位所見，我是這邊的巡林官。名字嘛，叫拉娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240103,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "我的名字叫派蒙！我們是從別的國度來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240107,
					"content": "原來如此。嗯…從穿著打扮來看，確實不像是森林的子民…也不像是從黃沙裡來的。透氣性看起來很好，很適合在須彌行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240108,
					"content": "嗯？這麼說來，既然拉娜是巡林官的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240109,
					"content": "應該認識提納里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#喔喔！{NICKNAME}也認識前輩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240111,
					"content": "提納里前輩雖然有著「生人勿近」的氣場，但其實是很不錯的人。見習的時候，受了他很多照顧呢。而且，他的耳朵很漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240112,
					"content": "嗯嗯！其實我也很想摸摸看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240113,
					"content": "其實我也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "嗯…如果悄悄飛過去的話，是不是可以摸到呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240115,
					"content": "哈哈哈，如果貿然動手，提納里前輩應該會生氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240118,
					"content": "對吧？看起來很有光澤，不知道是什麼樣的觸感。他現在在帶的孩子對這個也很有興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240119,
					"content": "咦？拉娜說的，難道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240120,
					"content": "是柯萊嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#咦，{NICKNAME}也認識柯萊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240122,
					"content": "柯萊的身體似乎不太好。就算是這樣，她也很努力地看護著森林、祓除死域。大家都很擔心她的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240141,
					"content": "咳咳！不管怎麼說，我們巡林官的職責是保護森林、幫助旅人、提供指引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240142,
					"content": "#誠如{NICKNAME}和派蒙所見，最近林子…應該說狀況不太理想吧？無論是「蕈獸」，還是猛獸，都特別狂躁。還有「死域」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240143,
					"content": "#不如讓我送{F#妳}{M#你}們一程吧？我的巡林路線接下來會經過維摩莊。到那邊沿著水路，無論是去奧摩斯港，還是須彌城，都很方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240144,
					"content": "可以，我們走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "嗯，我會保障兩位平安的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240146,
					"content": "好，不過暫時有點別的事要處理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "#我明白了，我會暫時在這裡等{F#妳}{M#你}們。要注意安全喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240116,
					"content": "派蒙可以悄悄飛過去摸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "喂！這樣的話，提納里會生氣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240123,
					"content": "應該認識柯萊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#咦，{NICKNAME}和那個孩子見過面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240125,
					"content": "柯萊的身體似乎不太好。就算是這樣，她也很努力地看護著森林、祓除死域。大家都很擔心她的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240126,
					"content": "不過，既然她身邊有那個「耳朵看起來很好摸」的前輩，應該不會有問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240127,
					"content": "咦？耳朵…難道是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "派蒙"
