						730240141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240138,
					"content": "是安柏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240139
					]
				},
				{
					"id": 730240139,
					"content": "「兔兔伯爵，出擊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240140,
					"content": "…怎麼想都不可能是安柏吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240105,
					"content": "我們來自很遠的地方…",
