			"dialogs": [
				{
					"id": 718080301,
					"content": "#{F#妳}{M#你}回來了，情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080302,
					"content": "關於南天門的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "地震、魔物，還有個小女孩…是誰家的孩子失蹤了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080304,
					"content": "關於小女孩說的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "那個孩子說什麼了？「那位」的復甦？見證？這都什麼亂七八糟的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080306,
					"content": "一定是又看了什麼奇奇怪怪的書…算了，我馬上去安排人，把那孩子帶回城裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080307,
					"content": "又是地震又是魔物，那孩子可別被傷著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080308,
					"content": "#謝謝{F#妳}{M#你}，這些東西請{F#妳}{M#你}收下吧，辛苦{F#妳}{M#你}幫我跑這一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718080309,
					"content": "唉，事情真是只多不少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				}
			]
