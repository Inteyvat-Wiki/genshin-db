					"content": "待甦醒之時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080202,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "#{F#妳}{M#你}是要來見證「那位」的復甦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080204,
					"content": "#{F#妳}{M#你}來得稍微早了點…不過，也不算晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080205,
					"content": "她在說什麼呀，完全聽不懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718080206,
					"content": "呃，妳在說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "#呵呵，{F#妳}{M#你}還沒有意識到嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080208,
					"content": "#對{F#妳}{M#你}來說，這樣也不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080209,
					"content": "#回去吧，等到「那位」復甦的時候，{F#妳}{M#你}會明白一切的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿鳩"
				}
			]
		},
