			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}還有派蒙，這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080102,
					"content": "瑪拉妮已經到了啊，呃…那個怪大叔也在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080103,
					"content": "早安，兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080104,
					"content": "早安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080105,
					"content": "我們什麼時候出發？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150080106,
					"content": "哈哈，就像個小孩子一樣，在旅行開始前總是迫不及待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080107,
					"content": "我是想盡快開始辦正事…妳肯定也知道這不是什麼輕鬆的春遊，我希望我們彼此都能拿出一點專業的態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150080108,
					"content": "不用擔心，我作為嚮導是很專業的。咳咳…那麼，我們的神秘島之旅正式開始了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080109,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080110,
					"content": "首先，大家看到這座雕像了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080111,
					"content": "嗯嗯，它是什麼重要的線索嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080112,
					"content": "也不是線索啦…它是我們「流泉之眾」的初代首領從神秘島歸來後立在這裡的，算是個紀念地標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080113,
					"content": "出發前首先要做的事呢，就是觸摸這座雕像向先祖祈福，這樣我們前往神秘島的旅途就會更加順利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080114,
					"content": "…這種說法能找到什麼理論依據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150080115,
					"content": "理論依據？沒有。但我的老師教過我，啟程前往神秘島之前這是必要的一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150080117,
					"content": "很好，你沒有在自己不專業的領域指手畫腳，這也是一種很專業的表現哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080118,
					"content": "好吧，只是這樣就沒辦法寫進論文裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150080119,
					"content": "大家一起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080120,
					"content": "在此向先祖致意，後輩將踏上您走過的旅途，見證您曾完成的壯舉，在您的注視下出發，在您的守望中歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150080121,
					"content": "真的有種要開啟一場偉大冒險的感覺呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080122,
					"content": "接下來請做好準備，我們要去尋找第一個線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				}
			]
		},
