			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726759801,
					"content": "#呶，是{F#妳}{M#你}啊。不得不說，{F#妳}{M#你}還挺有本領的，還有那種「樓影雞」。可惜不是狸子，不然，應該能成為了不起的大妖狸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759802
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759802,
					"content": "不過，可能只有吾輩一半厲害吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759803,
						726759809,
						726759814
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759803,
					"content": "關於氣味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726759804
					]
				},
				{
					"id": 726759804,
					"content": "#{F#妳}{M#你}們第一次來的時候，也是吃了什麼人給{F#妳}{M#你}們做的妖狸飯菜對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759805
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759805,
					"content": "吾等妖狸一族擅長變化，什麼都能變成。吾輩以前和那個臭狐狸鬥法，曾經變成了整個花見坂。不過，最後還是被識破了就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759806
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759806,
					"content": "這件事，當時的人稱為「偽花見坂事件」，還寫成了叫《隱神大囃子》的話本，應該很有名才對…現在的人，都不知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759807
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759807,
					"content": "總之，因為吾等太擅長變化，所以就要用「氣息」來分辨同族。不然的話，可能就會弄錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759808
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759808,
					"content": "#所以，給{F#妳}{M#你}們這些小輩做飯的人，不是那個臭狐狸的話，到底是誰？這麼熟悉吾等妖狸的氣味，還會法術的，應該沒幾個才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759809,
					"content": "關於修行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726759810
					]
				},
				{
					"id": 726759810,
					"content": "吾輩還在吉法師這個年紀的時候，曾經遊歷過去的大妖狸「九百九」的十八所名跡，也就是以前他曾經展現妖狸法力的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759811
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759811,
					"content": "比如說，傳說他曾經在影向參道上變成山鉾隊伍，一路乘歌載舞地上山。還把自己變成了大御所大人，哎呀，真是精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759812
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759812,
					"content": "其他的名所…在好遠好遠的海祇曚雲神社，九百九曾經變成古代的大將惡王，說要讓叫什麼名字來著的巫女出來見他，到處大鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759813
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759813,
					"content": "總之，小狸子不能偏離狸道，要好好修行，才能成為獨當一面的大妖狸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759814,
					"content": "再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726759815
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726759815,
					"content": "#多保重呶。吉法師就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				}
			]
		}
	]
}