					"nextDialogs": [
						728130909
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130909,
					"content": "那個…總之，那位五郎「大將」要我來協助你進行肥料的研究工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130910,
					"content": "之後，我們就好好合作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130911,
					"content": "是嗎…太好了！要是真能成功把肥料製作出來，那海祇島上就能種更多的作物了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130912,
					"content": "記得把肥料堆放遠點。",
