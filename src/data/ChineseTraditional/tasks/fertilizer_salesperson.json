					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "啊？哦…哦，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130914,
					"content": "總之，我們就好好合作吧！請多多指教了，愛拉尼小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130915,
					"content": "好的，我一定會努力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130916,
					"content": "為了我的論文，我一定會努力的，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130906,
					"content": "這是來自須彌的肥料專家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "你好，我叫愛拉尼…等一下，誰是肥料專家啊！",
