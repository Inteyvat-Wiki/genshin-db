			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩田",
					"五郎",
					"派蒙",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "#謝謝，謝謝{F#妳}{M#你}，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130302,
					"content": "我肥料剛做到一半，那些魔物就突然不知道從哪衝了過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130303,
					"content": "#真是莫名其妙…還好{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130304,
					"content": "也許是那堆肥料的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "是、是嗎？不過，我聽說，有這種氣味就是成功的前兆啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130306,
					"content": "#先不說這些了，來來，{F#妳}{M#你}來看看我做的肥料堆，我來打開跟你詳細說說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130307,
					"content": "給我等一等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130308,
					"content": "咦？五郎先生，您今天怎麼有空過來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130309,
					"content": "是在巡邏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "我是在…呃…先不說這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130311,
					"content": "這堆…東西，是你們做的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130312,
					"content": "哈哈哈，是的，這堆肥料正是我和這位旅行者做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130313,
					"content": "五郎先生，難道你也是想要看看這肥料的情況，所以才過來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130314,
					"content": "嘿嘿，你來得正好，我們現在就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130315,
					"content": "等一下！我不是來看這個的，不對，我就是來看這個的…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130316,
					"content": "五郎一臉無法忍受的表情啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130317,
					"content": "我們先離這堆肥料遠點吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "好，我們先去旁邊說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130319,
					"content": "五郎先生，到底您是來做什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130320,
					"content": "最近，很多居民都說聞到了一股可怕的異味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130321,
					"content": "為了保險起見，我就稍微偵察了一下，循著氣味一路找了過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130322,
					"content": "然後，就找到了你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130323,
					"content": "岩田，我聽說你一直在研究肥料，但你這種製作方法，實在是太…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130324,
					"content": "擾民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "沒錯。無論如何，岩田，你先把肥料堆撤掉。關於肥料的事，我會想想其他的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130327,
					"content": "大將！五郎大將！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130328,
					"content": "我在，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130329,
					"content": "大將，我們在外圍抓到了一個鬼鬼祟祟的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130330,
					"content": "那個傢伙鬼鬼祟祟的，一個勁說自己是什麼…肥料的推銷員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130331,
					"content": "我們覺得不對勁，就把那個人給扣了下來，請您趕快過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130332,
					"content": "又是肥料，我今天真是和肥料過不去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130333,
					"content": "我知道了，馬上就過去，你先到那邊維持住秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130334,
					"content": "岩田，你先處理好肥料堆的事情，後面的事後面再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130335,
					"content": "#旅行者，{F#妳}{M#你}也一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130336,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "推銷肥料的人？總感覺，有一種熟悉的感覺…但是又想不起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130339,
					"content": "算了，總之先過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130337,
					"content": "肥料…推銷員？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "刺激。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
