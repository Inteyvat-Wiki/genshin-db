					"愛拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130601,
					"content": "嗚…我只想寫一篇論文，怎麼居然被關起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				}
			]
		},
		{
			"id": 7281307,
			"completionStepIds": [
				7281308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281308",
							"2"
						],
						"stepId": 7281308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"考什克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#圖騰的含義…嗯？旅行者，{F#妳}{M#你}找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130702,
					"content": "關於愛拉尼的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "#{F#妳}{M#你}說愛拉尼來海祇島了？奇怪，她怎麼來這裡了…她不是應該去璃月嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130704,
					"content": "她被士兵抓住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "什麼？唉…在這種情況下來海祇島…她當然會被懷疑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130706,
					"content": "先不說這個了，我們快點過去吧，這孩子太莽撞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "考什克"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281309",
							"2"
						],
						"stepId": 7281309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"考什克",
					"愛拉尼",
					"五郎",
					"博行",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "愛拉尼，真的是妳！妳…妳怎麼來稻妻了？妳不是應該在璃月嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130802,
					"content": "嗚…這個說來話長啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130803,
					"content": "考什克先生，你認識愛拉尼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130804,
					"content": "您是…噢，您是五郎大將吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130805,
					"content": "您說得沒錯，愛拉尼和我一樣，都是在教令院求學的學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130806,
					"content": "我們各自為了不同的課題離開了教令院。沒想到會在這裡遇見她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130807,
					"content": "但是…你們學者，都可以自由離開教令院嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130808,
					"content": "也不能說都能「自由離開」。我和愛拉尼都屬「帝利耶悉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130809,
					"content": "對我們來說，在外遊學是研究的一部分，所以離開教令院是被允許的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130810,
					"content": "五郎大將，我可以為愛拉尼擔保，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130811,
					"content": "有了您做擔保，那就沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130812,
					"content": "呼…得救了…謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130813,
					"content": "博行，大久保，你們也去忙自己的吧，這裡沒事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130814,
					"content": "是，大將。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130815,
					"content": "是，大將。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130816,
					"content": "抱歉了，愛拉尼小姐，之前把妳當做可疑人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130817,
					"content": "嗯…雖然妳的嫌疑已經洗清了，但是妳擅自闖入海祇島，給我們也添了很多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130818,
					"content": "欸？有、有什麼懲罰嗎？我可沒有帶多少摩拉，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130819,
					"content": "既然妳之前說，妳是一個肥料推銷員…而且，還是一個有學者身分的肥料推銷員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130820,
					"content": "那正好，我們這邊有一個叫做岩田的人，正在研究肥料的事，愛拉尼小姐，請妳去協助他一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130821,
					"content": "假如妳能幫助他製作出不那麼「擾民」的肥料，那妳就可以像考什克先生一樣，在這附近自由研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130822,
					"content": "肥、肥料？不，那個，我只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130823,
					"content": "她沒問題的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "愛拉尼，這可是個取材的好機會。妳既然來了稻妻，那就表示，妳的論文應該還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130826,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130827,
					"content": "教令院的畢業規定妳也知道，要是連續幾年都沒辦法畢業的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130828,
					"content": "我、我做！我做就是了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130829,
					"content": "我也在瓦希德先生那邊瞭解過肥料了…看我一口氣搞定它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130830,
					"content": "畢業真是催人成長啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "那這件事就這麼定了，肥料的事就拜託妳了，愛拉尼小姐，我要先去處理其他的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130833,
					"content": "#對了，{F#妳}{M#你}們記得告訴岩田，要他把那個…肥料堆，稍微放遠一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130834,
