			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博行",
					"愛拉尼",
					"五郎",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "老實點！別亂動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130502,
					"content": "我、我也沒動啊！你們聽我解釋，我真的是教令院的學者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130503,
					"content": "妳剛才不是說，妳只是來推銷肥料的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130504,
					"content": "我…教令院的學者也可以推銷肥料啊！你們聽我解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130505,
					"content": "就是這個人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130506,
					"content": "是，大將。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130507,
					"content": "我們抓到她的時候，她正在外面鬼鬼祟祟地遊蕩，還不停地記著什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130508,
					"content": "大將，她一定是幕府那邊派來刺探情報的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130509,
					"content": "我不是！我沒有！都說了我是個學者，正在為論文取材啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130510,
					"content": "別開玩笑了！為了那個什麼論文，妳連戰場都敢來嗎？肯定是有什麼其他的目的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130511,
					"content": "嗚…除了論文之外，我怎麼敢還想著其他的目的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130512,
					"content": "妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "#旅行者！太好了，{F#妳}{M#你}在這裡！{F#妳}{M#你}快和他們說說，我不是壞人，我只是來寫論文的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 728130515,
					"content": "#{F#妳}{M#你}認識她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130516,
					"content": "算是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "須彌的學者…居然能為了「畢業」這件事，做到那種地步嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130518,
					"content": "#不過，聽{F#妳}{M#你}的說法，{F#妳}{M#你}似乎也不知道她的底細。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130519,
					"content": "#至於「從須彌來的學者」這件事，{F#妳}{M#你}也只是從她嘴裡聽說的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130520,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "唔…這些證據，實在都是缺乏可信度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130522,
					"content": "#但有{F#妳}{M#你}擔保，我也願意相信，她應該不是個壞人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130523,
					"content": "大將，我倒是有一個想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130524,
					"content": "您記得考什克嗎？那位一直在研究我們島上文化和歷史的學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130525,
					"content": "他之前就一直待在這裡，學者的身分也很可信…不然，讓他來辨認一下，這位…肥料推銷員，到底是不是學者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130526,
					"content": "#嗯，這樣不錯。旅行者，能麻煩{F#妳}{M#你}跑一趟，把考什克先生帶過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130527,
					"content": "為了防止意外，我會在這裡守著這位…肥料推銷員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130528,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "#那就拜託{F#妳}{M#你}了，請快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130513,
					"content": "愛拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
		{
			"id": 7281306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
