			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"那維萊特",
					"萊歐斯利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140305101,
					"content": "有關昨日那起越獄案，我謹代表逐影庭再一次感謝梅洛彼得堡提供的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305102
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305102,
					"content": "#主要是靠護士長，以及{NICKNAME}和派蒙的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305103
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305103,
					"content": "看希格雯精神不錯，最近的工作應該不太繁重吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305104
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305104,
					"content": "嗯。雖然長期駐留在梅洛彼得堡的醫務人員依然只有她一位，但有醫學知識、願意提供幫助的人一直有不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305105
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305105,
					"content": "聽你這樣說我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305106
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305106,
					"content": "哈哈，你關心護士長的樣子看起來就像她真正的家長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305107
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305107,
					"content": "不瞞你說，我一直都這樣定義自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305108
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305108,
					"content": "這就讓你的年齡有了些實感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305109
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305109,
					"content": "嗯。其實，我時常會忘記我年紀比你大很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305110
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305110,
					"content": "說起來，你在做這份工作之前都在做些什麼呢？每天泡在海裡，從東邊游到西邊，再從南邊游到北邊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305111
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305111,
					"content": "嗯…嗯，有時也從上邊游到下邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305112
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305112,
					"content": "喔，真厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305113
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140305113,
					"content": "…抱歉，剛剛是開玩笑的，請不要當真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305114
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140305114,
					"content": "呵，沒關係，不影響我想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				}
			]
		},
