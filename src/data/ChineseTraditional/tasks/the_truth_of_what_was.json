			},
			"dialogs": [
				{
					"id": 140300201,
					"content": "欸？是那維萊特和萊歐斯利！他們怎麼也在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300202,
					"content": "#{NICKNAME}、派蒙，很高興見到{F#妳}{M#你}們，願一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300203
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300203,
					"content": "一個大新聞，最高審判官因要事出訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300204
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300204,
					"content": "嗯？大家會對這樣的新聞感興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300205
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300205,
					"content": "不會嗎？畢竟是「要事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300206
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300206,
					"content": "哦…的確如此。在關心的人需要情感支撐時出現在適當的時間、地點，是非常必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300256,
					"content": "自從收到逐影庭的報告，我就覺得我必須來一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300207
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300207,
					"content": "請看，這就是那維萊特關心大家的方式。因此我們出現在了這裡——來陪同護士長拜訪她那位已故的老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300208
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300208,
					"content": "這麼說，希格雯準備祭奠的故人就是她的老師？那個「巫婆」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300209,
					"content": "啊，對不起對不起，我不是故意這麼說的，只是之前一直聽希格雯這樣稱呼她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300210,
					"content": "我猜，在她看來這種說法並無冒犯，派蒙不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300211
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300211,
					"content": "嗯，在希格雯看來，這個稱呼可能很親切吧。我曾很多次聽希格雯講起這位醫生，她為人十分寬厚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300212
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300212,
					"content": "在那個大部分人類都排斥美露莘的時代，只有她願意當希格雯的老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300213
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300213,
					"content": "哇，那維萊特和萊歐斯利果然都很貼心呢！這算是關心職場上的後輩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300214,
					"content": "職場上的後輩？也就是這位先生的後輩吧，我可不敢當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300215
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300215,
					"content": "護士長早在幾百年前就已進入梅洛彼得堡服刑，並且在刑期結束後留了下來，成為了梅洛彼得堡管理體系中相當重要的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300216
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300216,
					"content": "嚴格來說，梅洛彼得堡的絕大部分人都是護士長的後輩，自然也包括我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300217
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300217,
					"content": "服刑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300218,
					"content": "希格雯犯過罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300219
					]
				},
				{
					"id": 140300219,
					"content": "是的，早在我任職最高審判官之前，楓丹就有著一條極為古老的律法，禁止任何嘗試將其他物種轉化為人類的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300220
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300220,
					"content": "最初我和大部分研究員一樣，認為這只是一條用來規範科學倫理的律法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300221
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300221,
					"content": "現在想來，更像是厄歌莉婭為了讓自己的子民能夠在不諳真相的同時享受更為純粹、幸福的人生，才制定了這重保險吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300222
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300222,
					"content": "啊，無知是福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300223
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 140300223,
					"content": "希格雯獲得人類外貌的行為切實地違反了這條律法，即便她有自己的苦衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300224
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300224,
					"content": "當年到底發生了什麼？可以講給我們聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300225,
					"content": "沒關係，希格雯並不排斥讓她的朋友知道這件往事，當年的她就是主動找到我並向我坦白了一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300226
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300226,
					"content": "即便自己女兒病情嚴重也要把妳拒之門外嗎？這幫頑固的傢伙…人心裡的成見，也是我治不好的一種病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300227
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300227,
					"content": "唉…可惜我現在沒力氣趕過去，真是一個可笑的老巫婆，想要拯救全楓丹的人，到頭來卻連眼前的病人都救不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300228
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300228,
					"content": "老師，您到底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300229
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300229,
					"content": "我發現了一種怪病，那可能是全楓丹人都患有的一種怪病。沒有目擊者、沒有證據，不會有人相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300230
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300230,
					"content": "我只能拿自己作為實驗對象尋找治療的方法，但到頭來似乎撞上了一條死路，還把自己折騰成了這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300231
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300231,
					"content": "那…我先想辦法治好老師，讓老師去治好她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300232
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300232,
					"content": "不用了…我的情況我明白，妳做不了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300233
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300233,
					"content": "老師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300234
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300234,
					"content": "就像我之前說過的那樣，一名醫生最大的責任是治好自己能治好的病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300235
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300235,
					"content": "我明白了…但是，他們根本不信任我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300236
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300236,
					"content": "咳咳…說起來，那個女孩是妳的第一個病人，你真的很想治好她，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300237
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300237,
					"content": "嗯，我願意做任何事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300238
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300238,
					"content": "即便是觸犯律法、背負刑罰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300239
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300239,
					"content": "…只要不會傷害到別人，我願意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300240
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300240,
					"content": "哈哈，妳果然是我帶出來的學生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300241
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300241,
					"content": "那就讓我再賭一把，把實驗進行到底吧。妳先離開這裡，兩個小時後再來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300242
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300242,
					"content": "如果奇蹟發生，那我已經找到了拯救所有楓丹人的辦法，也有力氣去幫妳治好那個女孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300243
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300243,
					"content": "如果奇蹟沒有發生…那我治不好的病就又多了一種，不要尋找我的下落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300244
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300244,
					"content": "我會留下一份禮物給妳，那是我在研究這種怪病時偶然得到的一個發現。這個發現意義不大，但至少可以幫妳救治眼前的病人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300245
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300245,
					"content": "希格雯返回後，奇蹟並沒有發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300246
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300246,
					"content": "她在桌上找到了一瓶藥水和一張便條，按照指示使用那瓶藥水後，她變成了現在的模樣，也觸犯了楓丹的律法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300247
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300247,
					"content": "我確認了既定的事實，對她做出了判決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300248
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300248,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300249,
					"content": "老師犧牲了自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300250,
					"content": "留下了藥水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300251,
					"content": "這一點，希格雯恐怕是直到楓丹人溶解的真相被揭露後才明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300252
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300252,
					"content": "後來瞭解到這一切的我，感到十分惋惜…我在維護律法公正的同時，也必須接受它的無情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300253
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300253,
					"content": "幸好，經過反覆確認，根據楓丹的律法，希格雯不會因為這部分隱藏的真相而背負額外的刑期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300254
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140300254,
					"content": "真不知道希格雯是什麼感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300255,
					"content": "#既然希格雯主動邀請{F#妳}{M#你}們來到這裡，就說明她準備好與{F#妳}{M#你}們談起這些過往了，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				}
			]
		},
