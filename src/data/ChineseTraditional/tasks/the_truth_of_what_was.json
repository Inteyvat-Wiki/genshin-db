					{
						"sceneId": 3,
						"position": [
							3026.955,
							440.055,
							3892.265
						],
						"pointId": 340400014
					}
				]
			},
			"dialogs": [
				{
					"id": 140300301,
					"content": "#{NICKNAME}，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300302
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300302,
					"content": "我要祭奠的故人就是我的老師哦，她沒留下遺體，只有一座衣冠塚，不過現在已經在水下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300303
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300303,
					"content": "希格雯…那個提供魔藥的巫婆就是妳的老師吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300304,
					"content": "#嗯，看來那維萊特先生跟{F#妳}{M#你}們講了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300305
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300305,
					"content": "知道真相後，心情一定很複雜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300306,
					"content": "嗯…其實我知道那一晚具體發生的事情之後，只是覺得那果然是老師會做的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300307
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300307,
					"content": "甚至連犧牲自己的事也要瞞著妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300308,
					"content": "只要確定一種藥對病情有幫助，哪怕用欺騙的手段也要讓孩子喝下去，老師她本來就是這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300309,
						140300310
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300309,
					"content": "真是一位偉大的醫生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				},
				{
					"id": 140300311,
					"content": "好吧…那最後希格雯為什麼要去自首呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300312,
					"content": "因為觸犯了律法就要接受懲罰哦，老師做出了她的選擇，我也做出了我的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300313
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300313,
					"content": "我知道，只是…之前那個波頓質問希格雯的時候，我很氣憤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300314,
					"content": "我覺得希格雯才不會跟他是一種人呢，聽那維萊特講完真相後，我更這麼覺得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300315,
					"content": "但是一想到最後希格雯也還是一樣被判了罪，進了監獄，就感覺很不好受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300316,
					"content": "派蒙，其實恰恰相反哦。如果沒有那段服刑的經歷，我面對波頓的質問或許就不會那麼堅定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300317
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300317,
					"content": "為什麼希格雯會這樣認為？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300318,
					"content": "#派蒙和{NICKNAME}都很好奇吧，我可以講給{F#妳}{M#你}們聽哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300319
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300319,
					"content": "嗯嗯，這才是我想要的結局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300320,
					"content": "聽完波頓的坦白後，我一直想告訴他，是波頓還是拉瓦特，其實並沒有那麼重要。但還是太晚了，他掌心的溫度已經消失了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300321
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300321,
					"content": "我嘗試過治好他，可惜他的癥結不在臉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300322,
						140300323
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300322,
					"content": "不值得為他感到遺憾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300324,
					"content": "#我明白的，{NICKNAME}，我知道{F#妳}{M#你}和派蒙想開導我，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300325
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300325,
					"content": "這不算什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300326,
					"content": "#另外，邀請{F#妳}{M#你}們來這裡還有一件事，我還沒有把承諾好的報酬交給{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300327
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300327,
					"content": "#逐影庭特批讓我額外調製幾瓶那種藥水，用來給那些被掉包的犯人恢復容貌。我多調製了一瓶，專門留給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300328
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300328,
					"content": "欸？這個我們用不到，不應該拿去銷毀嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300329,
					"content": "#那也應該是我先交給{F#妳}{M#你}們，再由{F#妳}{M#你}們決定送去銷毀哦。{NICKNAME}和派蒙出了很多力，我怎麼能不兌現諾言呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300330
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300330,
					"content": "的確是這個道理，但現在我可不想用這種東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300331,
					"content": "不過，這應該是提瓦特僅剩的一瓶了吧？總感覺不能直接送去銷毀，得想辦法給它一些特殊的意義呢…嗯，有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300332,
					"content": "美露莘的體質沒有因為那場大洪水發生變化，肯定還可以永久享受這種藥水的效果，那希格雯有想過重新變回原本的樣子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300333,
					"content": "畢竟，對於美露莘來說，果然還是美露莘的樣子更可愛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300334,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300335
					]
				},
				{
					"id": 140300335,
					"content": "派蒙，是人類還是美露莘，有那麼重要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300336
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300336,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300337,
					"content": "我在想什麼呢，希格雯早就知道答案了才對，那就在這裡把它銷毀吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300338,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300323,
					"content": "他的確有些可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300310,
					"content": "真是一位古怪的醫生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				}
			]
		},
		{
			"id": 1403051,
