			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法爾博"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736910101,
					"content": "希望大家能夠喜歡這個玩具啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910102
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910102,
					"content": "這邊有什麼好玩的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910103
					]
				},
				{
					"id": 736910103,
					"content": "#{F#妳}{M#你}是…旅行者對吧？我是梨多梵諦學院的學生法爾博。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910104
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910104,
					"content": "#呃…{F#妳}{M#你}知道我們學院是研究什麼的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910105
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910105,
					"content": "唔…我記得應該是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910106
					]
				},
				{
					"id": 736910106,
					"content": "我們梨多梵諦學院專注於研究星象啦，當然，這麼說不太準確，學院裡還細分了很多研究領域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910107
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910107,
					"content": "但很遺憾的是，我們研究的很多東西就算拿出來說，一般人也不一定聽得懂，或者是…有興趣聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910108
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910108,
					"content": "如果直接擺出一個占星攤，我又怕負責攤位的各位同學會不由自主陷入學術討論中，完全沒心思管攤位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910109
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910109,
					"content": "所以，在多方討論之後，我們決定出了一個折衷的方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910110
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910110,
					"content": "#{F#妳}{M#你}看見這個特製星盤了嗎？上面分佈著很多星星，{F#妳}{M#你}所要做的，就是把這些星星拼成一個特定的圖案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910111
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910111,
					"content": "這些圖案也不會特別複雜，更不會涉及某些尚未有結論的學術爭端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910112
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910112,
					"content": "咳，總之就是…一個簡單而快樂，不會引起學術爭執的拼圖遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910113
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910113,
					"content": "你看起來好像滿緊張的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910114
					]
				},
				{
					"id": 736910114,
					"content": "畢竟這個遊戲和星星有關嘛…我們學院的部分學生只要聽見星星兩個字就會十分緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910115
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910115,
					"content": "#{F#妳}{M#你}是不知道，在設計這個玩具的時候，我和多少同學解釋過這只是一個玩具，和學術研究一點關係都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910116
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910116,
					"content": "#不說了不說了，如果{F#妳}{M#你}有興趣的話，就來試玩一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910117,
						736910119
					],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910117,
					"content": "想要試玩看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910118
					]
				},
				{
					"id": 736910118,
					"content": "沒問題，星盤就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾博"
				},
				{
					"id": 736910119,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910120
					]
				},
				{
					"id": 736910120,
					"content": "#唔，反正在學院遊樂會期間，我會一直在這邊開著攤位，{F#妳}{M#你}想玩的話直接過來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾博"
				}
			]
		}
	]
}