					"芙蘿拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "歡迎光臨「花語」，呼呼，有什麼需要瞭解的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700000402,
					"content": "關於薩伊德的畫片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "確實，風花節是蒙德特有的節日呢，須彌人的話，應該不會過風花節吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700000404,
					"content": "要為我和我的花留影？沒問題呀，薩伊德先生的想法真特別，學者就是這樣吧，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
		{
