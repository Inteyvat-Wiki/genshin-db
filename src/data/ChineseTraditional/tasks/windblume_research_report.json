			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩伊德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "#{F#妳}{M#你}們已經拍好畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000602,
					"content": "全都拍好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "#嗯，{F#妳}{M#你}拍得很不錯，我的研究一定能用得上這些畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000604,
					"content": "看到這麼美的景色…我想起了家鄉須彌的節日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000605,
					"content": "須彌有什麼節日？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "#噢，{F#妳}{M#你}應該不知道吧，我們每年都會舉辦「花神誕日」，用來紀念「小吉祥草王」的誕生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000607,
					"content": "但如果就氣氛而言的話，還是和蒙德城的風花節略有差別的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000608,
					"content": "說起來…今年的花神誕日我也沒參加到。唉，過這麼久了，不知道教令院現在是什麼情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000609,
					"content": "#話說遠了，總之感謝{F#妳}{M#你}的幫忙，這些報酬請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩伊德"
				}
			]
		}
	]
