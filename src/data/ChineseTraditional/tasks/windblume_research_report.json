			"trigger": {
				"objectNames": [
					"薩伊德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "多麼浪漫的風俗，這才是真正值得研究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000102,
					"content": "在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "#哦，是旅行者啊，{F#妳}{M#你}也是對蒙德浪漫的歌謠產生興趣，才來圖書館的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000104,
					"content": "不過，我們隨時都能閱讀任何文字紀錄，但發生在身邊的歷史稍不留神就會錯過啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000105,
					"content": "在風花節這樣浪漫愜意的節日裡，蒙德人有許多特別的風俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000106,
					"content": "這些風俗的形式是怎樣的、它們背後的歷史如何？諸如此類，都是絕佳的研究方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000107,
					"content": "#我正在就此撰寫研究報告，只有文字描述當然不行，能請{F#妳}{M#你}幫忙，為風花節的景觀留個影嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000108,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "#感謝{F#妳}{M#你}協助我的學術研究，旅行者，我會讓論文掛上{F#妳}{M#你}的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000113,
					"content": "<color=#00E1FFFF>噴泉廣場上空的花飾</color>、<color=#00E1FFFF>教堂前用花朵裝扮的神像</color>還有<color=#00E1FFFF>忙著出售花朵的花店店主</color>，這些都值得記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000115,
					"content": "#那就麻煩{F#妳}{M#你}幫我記錄這些景觀吧，回頭把拍好的畫片帶給我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000110,
					"content": "你自己去比較好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "不不不，現在我不能走開。我剛剛才擬好報告大綱，如果現在走開，思緒就亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 700000112,
					"content": "#還是得拜託{F#妳}{M#你}，旅行者，雖然不多，但是我會為{F#妳}{M#你}準備報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "薩伊德"
				}
			]
		},
