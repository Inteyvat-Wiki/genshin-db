				]
			},
			"dialogs": [
				{
					"id": 741380101,
					"content": "#嘿，回來了嗎？{F#妳}{M#你}們剛才可錯過了一場好戲啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380102
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380102,
					"content": "好戲？發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380103,
					"content": "剛剛我帶著回收來的水母，在這裡等奧格勞先生核查。結果奧格勞先生還沒來，之前的買家倒是找上門了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380104
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380104,
					"content": "他們說自從放生了前幾批水母，人的精神好了、生意也順暢了，一定是做了好事，有神明眷顧！所以就想找我再買一批去放生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380105,
						741380106
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380105,
					"content": "我這邊還在抓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				},
				{
					"id": 741380107,
					"content": "#唔唔…{NICKNAME}抓、基肖恩先生賣、買家再去放生…喂！你難道是在用這個方法賺錢嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380108,
					"content": "沒有！沒有！怎麼可能！？我可不想再被警備隊的人找麻煩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380109
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380109,
					"content": "咳咳…我跟他們說明了好久，放生這些水母有害無益，但他們就是不聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380110
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380110,
					"content": "他們硬是覺得自己最近走了好運，就是因為做了這種…他們所認為的好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380111
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380111,
					"content": "還覺得我接連倒楣，也是囚禁水母帶給我的報應。唉…這幫人到底在想什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380112
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380112,
					"content": "我們還在爭辯的時候，奧格勞先生就來了，直接把這群人扣了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380113,
						741380114
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380113,
					"content": "好運用盡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380115,
					"content": "…說到底，不去了解生物的習性和生態就胡亂放生，為的究竟是這些生命，還是自己的好運呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380116
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380116,
					"content": "最後還被警備隊抓走了…看起來也沒多少好運嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380117,
					"content": "#哈，順帶一提，警備隊已經免了我的牢獄之災，多虧有{F#妳}{M#你}們幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380118
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380118,
					"content": "除了之前說好的報酬，我還準備了一點紀念品，請不要客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380119
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380119,
					"content": "基肖恩取出了一個水母球…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741380120
					]
				},
				{
					"id": 741380120,
					"content": "欸…這個是？「螢光紫水母」？看起來比之前的小好多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741380121,
					"content": "#沒錯，昨天我從庫存的水母苗裡挑了一些適合的樣本，逐一記錄編號後又多出了幾隻，我想…不如就送給{F#妳}{M#你}們，做個紀念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380122
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380122,
					"content": "剩下的水母我會帶回去繼續培育，看看怎麼讓牠們在自然環境下野化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380123
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380123,
					"content": "而且我也打算留下一些「螢光紫水母」的樣本，研究一下聚集發光的成因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380124,
						741380125
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380124,
					"content": "看起來還滿可愛的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380126,
					"content": "#等、等等——{F#妳}{M#你}可千萬別再把牠們放生了啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741380125,
					"content": "放水裡游起來會不會更可愛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380114,
					"content": "自作自受啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380106,
					"content": "你居然還在賣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				}
			]
		}
	]
}