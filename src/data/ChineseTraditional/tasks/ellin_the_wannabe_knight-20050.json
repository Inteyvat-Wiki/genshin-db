			"dialogs": [
				{
					"id": 200500201,
					"content": "怎麼樣？想到好方法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500202
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500202,
					"content": "還沒有想好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500203
					]
				},
				{
					"id": 200500203,
					"content": "嗯…我之前遇見的冒險家，有些也偶爾會這樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500204
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500204,
					"content": "面對怪物時能俐落地戰鬥，打木樁的時候卻手忙腳亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500205
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500205,
					"content": "而且還用各種手段加固木樁，就像生怕自己能輕鬆擊碎一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500206
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500206,
					"content": "這麼想尋求挑戰的話，直接去野外找強大的魔物不就好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
