			"dialogs": [
				{
					"id": 200500101,
					"content": "傷腦筋…這裡要怎麼解決啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500102,
					"content": "妳在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "為了下一次的騎士選拔，我正在訓練呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500104,
					"content": "唔…不過，我可沒有琴大人那樣的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500105,
					"content": "比起鍛煉「力量」，我覺得學習「技巧」更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500106,
					"content": "比如，一口氣把這些木樁全部破壞掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500107,
					"content": "#{F#妳}{M#你}有空的話，也和我一起來想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "沒關係，好好想喔，木樁不會自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500111,
					"content": "唯一會自己跑掉的只有被消耗的時間和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500114,
					"content": "我聽別人說，元素是能互相作用的，如果能讓這個火盆裡的火稍稍爆炸一下的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500115,
					"content": "不過，這個火盆裡，首先得有火才行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500109,
					"content": "我們兩個一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "#{F#妳}{M#你}習慣團體作戰嗎？真羡慕啊…隨時都能叫到幫手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500113,
					"content": "像我這樣的，只能學習獨自作戰啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
