			"dialogs": [
				{
					"id": 760761101,
					"content": "#{F#妳}{M#你}好，我的朋友，很高興與{F#妳}{M#你}在墓裡再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761102,
					"content": "#向菲林斯描述了{F#妳}{M#你}所見到的「誓言之燈」與燈上不知道是什麼意思的話語。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "「風已醒來，落葉飛旋」…這是人們在加入執燈人時立下的誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761104,
					"content": "平時每一個執燈人成員都會隨身攜帶自己的燈，只有在最無奈的情況下，他們才會放棄顧著自己的燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761105,
					"content": "每一盞無主的燈恐怕都代表著一樁不幸，我很遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761106,
					"content": "不過早在立誓之時，他們就已經清楚這種命運無法避免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761107,
					"content": "如果說還有什麼我們能為他們做的事，那就只有銘記了，銘記他們的誓言吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761108,
					"content": "「守護永燃的希望」…這是他們最大的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		}
	]
}