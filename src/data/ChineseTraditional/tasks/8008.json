			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玥輝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "礦工大哥，我們是來彙報委託結果的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080102,
					"content": "#喔！總算又見到{F#妳}{M#你}們了！之前我還有些擔心，雖然付了錢，可仔細想想，委託別人調查那麼詭異的地方，別出什麼事才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080103,
					"content": "萬一有什麼，我會一輩子良心不安的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080104,
					"content": "沒事沒事，我們是誰呀！你看，我們不是好好的回來了嗎？情況也都調查清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080105,
					"content": "厲害厲害！所以，下面是什麼情況？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080106,
					"content": "唔…欸…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080107,
					"content": "有一群丘丘人在下面養老。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "養老？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080111,
					"content": "總、總之，到下面去的那些丘丘人都沒有什麼攻擊性了，也希望礦工們不要故意打攪它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080112,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "我們這些礦工可怕麻煩了，絕對不會主動招惹它們。我們眼裡啊，只有亮晶晶的東西和金燦燦的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080115,
					"content": "唔，唔…很可信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080116,
					"content": "#雖然不太明白{F#妳}{M#你}們在說什麼，但有二位做擔保，我就放心了，隨時可以繼續開工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080117,
					"content": "#這回多虧二位！跑這麼一趟，辛苦{F#妳}{M#你}們了，這些謝禮就請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080113,
					"content": "可以放心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "下面是丘丘人們的理想鄉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "理想鄉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥輝"
				}
			]
		}
	]
