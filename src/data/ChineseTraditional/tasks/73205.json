			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "#哎呀，我還沒來得及做飯，沒東西招待{F#妳}{M#你}們喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040702,
					"content": "不用麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "#另外一個小朋友是{F#妳}{M#你}的朋友吧，有點可愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040705,
					"content": "#我種的花開了之後，{F#妳}{M#你}們兩個要不要來看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040706,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "#再過陣子它們大概就能開了，{F#妳}{M#你}們以後還能來吧，來看看{F#妳}{M#你}們幫忙種出來的花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040708,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "好好好，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040710,
					"content": "♪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040703,
					"content": "肚子不餓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "來、來，看看這些種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050102,
					"content": "好像沒什麼變化。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "是啊，雖然我種地種了好多年，但種花跟種地還是不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050104,
					"content": "要不然，為什麼這麼久它們都不長呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050105,
					"content": "我看看，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050106,
					"content": "阿凡爺爺，我覺得你的苗圃太乾燥了，阿如村附近土地的養分也可能不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050107,
					"content": "我們之前在村子裡幫人種過花，我們有經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050108,
					"content": "哦，是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050109,
					"content": "有道理，這麼稀有的花種是應該比普通花草嬌弱點，我澆水施肥的確不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050110,
					"content": "不過這塊苗圃離水源有點遠，取水不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050111,
					"content": "我自己儲存的日常用水也不多，要常給苗圃裡的種子澆水還有點麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050112,
					"content": "我可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "#好啊，那就先請{F#妳}{M#你}們給這三顆種子都澆些水吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320503",
							"2"
						],
						"stepId": 7320503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "#很好、很好，{F#妳}{M#你}們兩個真有辦法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050302,
					"content": "我預感，有專業人士指導，這次應該能長好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050303,
					"content": "之前的烤肉卷和米圓塔好吃不好吃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050304,
					"content": "好吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "#好吃我再幫{F#妳}{M#你}們做一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050307,
					"content": "#我的手藝沒有我家去世的老太婆好，{F#妳}{M#你}們不准嫌棄。拿著吧，這次少了一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050308,
					"content": "是好吃的！阿凡爺爺，你真好，以後我們也會常來看你真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050309,
					"content": "#哈哈，{F#妳}{M#你}們之前不是想問我，這花是什麼花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050310,
					"content": "#告訴{F#妳}{M#你}們也沒關係，我種的都是薔薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050311,
					"content": "跟須彌薔薇是同一種花嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "這種花叫作「金薔薇」，哎呀，可比須彌薔薇寶貝多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050313,
					"content": "#我之前說這些花種都是一位朋友留給我的，{F#妳}{M#你}們還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050314,
					"content": "其實啊，這些種子、我現在住的這間舊屋子都是死掉的鬼老頭留給我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050315,
					"content": "#欸，我都忘了，{F#妳}{M#你}們不是阿如村的人，肯定不熟悉這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050316,
					"content": "不熟悉也好，就把這傢伙當成一個會種點花的老頭記住，就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050318,
					"content": "阿凡爺爺突然發起呆來了欸，阿凡爺爺，阿凡爺爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732050319,
					"content": "#哎喲，我剛才是不是恍神了？人年紀大了，注意力不容易集中，讓{F#妳}{M#你}們見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050320,
					"content": "#這次也謝謝{F#妳}{M#你}們兩位小朋友，{F#妳}{M#你}們要是還有什麼想看的，就到處逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050321,
					"content": "我不會再趕人了，不過要小心，別踩到苗圃上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050306,
					"content": "還沒吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
