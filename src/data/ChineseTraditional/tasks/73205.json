				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "先給這三顆種子澆點水吧，施肥的事情我再想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050402,
					"content": "過了幾十年，簡單的肥料該怎麼做我還是懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		}
	]
}