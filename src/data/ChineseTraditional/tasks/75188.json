			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕卡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "#請{F#妳}{M#你}幫個忙，去田裡找找我家的<color=#00E1FFFF>三隻小龍</color>，讓牠們回到我腳邊來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕卡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "#那邊的，對，沒錯，就是{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880202,
					"content": "#看{F#妳}{M#你}走路帶風、跑得飛快，應該滿有力氣的，像是經常鍛煉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880203,
					"content": "#是我們「沃陸之邦」的勇士嗎？還是說{F#妳}{M#你}來自其他部族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880204,
					"content": "我是路過的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "這樣啊，有點可惜了。唉，也是，正缺人的時候突然就碰上個幫忙的，這種好事也只有夢裡才有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880207,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "#是這樣的，{F#妳}{M#你}也看見了，我這裡不是有片農場嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880209,
					"content": "這個農場一直是我一個人打理，但這陣子滿不巧的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880210,
					"content": "前幾天，我去跟部族裡的勇士角力，弄傷了背…是，我知道這件事滿蠢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880211,
					"content": "結果，我現在既不能幫我爸爸開墾新田，也沒法打理自己的農場，說實話，連走路都痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880212,
					"content": "#正想僱個人幫幾天忙，恰好碰上{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880213,
					"content": "#可惜{F#妳}{M#你}只是路過，種地得天天下田，{F#妳}{M#你}要是一下來一下不來，我這片田就荒廢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880214,
					"content": "但我現在也沒力氣跑大老遠去部族裡找人，唉，除了養的幾隻小突角龍，眼前也沒什麼人能幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880215,
					"content": "幾隻小搗蛋鬼這幾天也不聽話，三隻全都賴在田裡，都不肯到我腳邊來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880216,
					"content": "#這樣吧，我能不能請{F#妳}{M#你}幫個小忙，替我把牠們帶回來？我真的不方便走路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880217,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "那就太好了，牠們平時都還聽話，經常陪我在田裡工作，只是這兩天不知道怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880219,
					"content": "#{F#妳}{M#你}招呼牠們一聲，我家的三隻小龍大概自己就會回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880205,
					"content": "我不是納塔人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518804",
							"2"
						],
						"stepId": 7518804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕卡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "#這三個小傢伙都回來了，應該都是{F#妳}{M#你}的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880402,
					"content": "#路過的勇士，謝謝{F#妳}{M#你}這份好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880403,
					"content": "我這背還是痛，但至少有小龍在邊旁邊。有牠們陪著，感覺舒坦多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "帕卡林"
				},
				{
					"id": 751880404,
					"content": "#我也不是很富裕，但一點報酬還是出得起，這些東西請{F#妳}{M#你}拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕卡林"
				}
			]
		}
	]
}