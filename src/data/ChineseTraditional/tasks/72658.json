			"completionStepIds": [
				7265801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265801",
							"2"
						],
						"stepId": 7265801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"咲耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "#{F#妳}{M#你}好！想要試試親手種一盆花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580102,
					"content": "什麼種花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "#喔，{F#妳}{M#你}有興趣嗎？不瞭解也沒關係，我來和{F#妳}{M#你}簡單說明一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580104,
					"content": "我是咲耶，是一個種花的花匠，同時也做一些和花有關的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580105,
					"content": "哈哈哈，雖然說是生意，但其實大部分時候都是幫人送花，或者是幫哪家店製作「插花」啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580106,
					"content": "插花是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "#咦？{F#妳}{M#你}不知道嗎？「插花」在稻妻可是一項很重要的事情喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580108,
					"content": "雖然簡單來說，「插花」就是將花卉和其他植物仔細裁剪處理後，以一個合適的方式擺放起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580109,
					"content": "但在具體製作上…裁剪花卉和植物時，需要細細地把握植物的狀態，細心地為植物修剪掉不體面的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580110,
					"content": "擺放時，又要根據具體的場景氛圍來調整擺放的方式。有時候，甚至要細緻到每一支花卉向外延伸的角度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580111,
					"content": "這些細節，每個都需要細心考究，實在是…繁瑣到了極點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580112,
					"content": "就算是對我這個喜愛插花的人來說，這項工作也夠讓我疲憊的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580113,
					"content": "之前我在城裡還有一個店面，但街上實在太吵，我根本沒法靜下心來插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580114,
					"content": "所以我就關了店面，只在我的花田旁邊接待顧客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580115,
					"content": "但是…雖然店裡是清淨了，但生意也少了一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580116,
					"content": "所以我特意設計了一個推廣計畫，來城裡宣傳一下我的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580117,
					"content": "我把這個計畫叫做…「夢裡生花」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580118,
					"content": "這計畫的詳細內容是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "具體來說，就是一個讓顧客們親手種出花，然後再親手製作插花的活動喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580120,
					"content": "#如果{F#妳}{M#你}有興趣，想要體驗一下的話，就和我說一聲吧。無論是種花和插花，都是很有趣的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咲耶"
				}
			]
		}
	]
}