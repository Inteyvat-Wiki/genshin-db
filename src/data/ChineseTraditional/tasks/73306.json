			"trigger": {
				"objectNames": [
					"提爾扎德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "#…是{F#妳}{M#你}們啊，還有什麼話要說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552502,
					"content": "關於哲伯萊勒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "…我居然到最後還懷疑了他。我真是個混蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552504,
					"content": "現在我對他只有感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552505,
					"content": "之前我一直搖擺不定，無論是學術上還是生活上…但從今往後我不會再動搖了。我會走自己堅信的那條路，無論有多麼艱難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552506,
					"content": "就算是為了告慰哲伯萊勒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552507,
					"content": "關於赤王。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "我開始懷疑自己之前讀到的那些文獻究竟有多少可信度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552509,
					"content": "那首「禱文」…有種說不上來的怪異的感覺，還有薩梅爾…說的那些話…有必要回去之後重新深入研究一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552510,
					"content": "當然，首要任務還是按原計畫寫完論文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552511,
					"content": "關於婕德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "唉…我也希望自己能為她做些什麼，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552513,
					"content": "我什麼都做不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "提爾扎德"
				},
				{
					"id": 730552514,
					"content": "她又什麼都不肯說，但凡她能說出一個願望，只要是我力所能及的，我都願意為她辦到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提爾扎德"
				}
			]
		},
		{
