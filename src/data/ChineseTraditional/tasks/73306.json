			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "抱歉…還不能很好地控制自己的情緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 730552602,
					"content": "不用道歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "對啊…婕德很難過，我們都知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730552604,
					"content": "#謝謝{F#妳}{M#你}們…祝{F#妳}{M#你}們今後的旅途一切順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 730552605,
					"content": "唔…也希望婕德今後可以一切順利…一定會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
