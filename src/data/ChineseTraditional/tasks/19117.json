			"dialogs": [
				{
					"id": 191170106,
					"content": "汪！汪嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170107,
					"content": "好兇！差點又被咬到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170108,
					"content": "我說你啊，肚子都餓扁了，差不多也該吃點東西了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170109,
					"content": "就算你沒有和我回去的想法，也沒必要一點東西都不吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170110,
					"content": "難道是擔心食物中有毒嗎？我親自替你嚐一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170121,
					"content": "看，完全沒問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170111,
					"content": "托馬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "來，稍微吃一點。稍微兩口，我今天就不來打擾你了，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170114,
					"content": "汪！汪汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170115,
					"content": "完全不打算吃我們的食物呢…總覺得牠看起來很焦躁不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170116,
					"content": "海裡有什麼東西嗎？還是周圍有什麼讓牠警惕的東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170117,
					"content": "會不會是那些怪物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "#{F#妳}{M#你}是說牠被周圍的怪物攻擊了嗎…倒也有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170119,
					"content": "人在危險的環境下也吃不下飯吧，我們幫牠把周圍清理一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170120,
					"content": "#辛苦{F#妳}{M#你}陪我一起了，{NICKNAME}。至少讓這裡清淨一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托馬"
				},
				{
					"id": 191170112,
					"content": "好拼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
