			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "#是{F#妳}{M#你}們啊，薔薇還有我們都在等著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090102,
					"content": "賽芭也一早就來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090103,
					"content": "我最近常來這裡，沙法卡特先生留下的手記都看了個遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090104,
					"content": "以前我一直覺得待在阿如村生活很寂寞，但現在感覺不同了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090105,
					"content": "#至少我不完全是一個人，還有這些薔薇，和{F#妳}{M#你}們一起的記憶，還有阿凡先生一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090106,
					"content": "我的生活裡還有些美好的念想，這樣一想就覺得自己沒有那麼寂寞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090107,
					"content": "我和阿凡老先生商量好了，以後我就幫他一起照看金薔薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090108,
					"content": "讓它們越開越多，開滿整個苗圃。至於現在，先讓這幾朵開出花來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090109,
					"content": "#{F#妳}{M#你}還記得之前是怎麼讓我的須彌薔薇開花的嗎？用同樣的方法就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090110,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "#來，看{F#妳}{M#你}的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		},
		{
			"id": 7320903,
