				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "「薔薇啊薔薇，實現我的願望。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "「花從石頭中綻放，金薔薇對我歌唱。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "金色的薔薇花果然很漂亮，看到它們開放，感覺心情也明亮起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090402,
					"content": "這些天的辛苦沒有白費，好開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090403,
					"content": "心願終於實現了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "到最後，我終於有一件能做好的事了。沙法卡特叔叔，你的心願我幫你達成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090406,
					"content": "遺憾的是，他看不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090407,
					"content": "賽芭，不能這樣說啊。妳記得薔薇歌謠最後的那段嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090408,
					"content": "「沒有土地承載我，唯有歌謠承載我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090409,
					"content": "「歌謠戰勝敵視我的命運，戰勝我的結局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090410,
					"content": "「戰勝我戰勝時間，戰勝永不消逝的消逝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090411,
					"content": "沙法卡特叔叔的生命和金薔薇還有他親自編寫的歌謠一起，都留在了我們身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090412,
					"content": "嗯，說的沒錯，他是戰勝了消逝的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090413,
					"content": "#謝謝{F#妳}{M#你}們讓我知道沙法卡特先生的事，這對我來說很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090414,
					"content": "他是在我之前的流放者，看到他的那些生活痕跡，總讓我感覺自己好像跨越了時空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090415,
					"content": "我看著的不僅是沙法卡特先生，還有我自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090416,
					"content": "雖然我不能對他說些什麼，但我可以帶著他的遺憾生活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090417,
					"content": "如果我連帶著他的份一起努力生活下去，那最終我一定能救贖自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090418,
					"content": "希望妳幸福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "#感覺在這裡的生活也並不糟糕了啊，能遇到{F#妳}{M#你}們真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090421,
					"content": "薔薇花果然是能帶給人幸福的花，阿凡老先生，以後我們要更努力種上更多的薔薇花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090422,
					"content": "哈哈哈，那我們就算約定好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090423,
					"content": "嗯，我會努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090419,
					"content": "不要氣餒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "一切都是值得的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
		{
