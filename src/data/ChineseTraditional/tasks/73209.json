			"dialogs": [
				{
					"id": 732090301,
					"content": "「薔薇啊薔薇，實現我的願望。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "「花從石頭中綻放，金薔薇對我歌唱。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
