			"dialogs": [
				{
					"id": 732090601,
					"content": "只要這幾朵能健康地生長，我們以後一定能培育出更多的金薔薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090602,
					"content": "不過在這之前，還是要先看到這幾朵金薔薇開花我才放心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
