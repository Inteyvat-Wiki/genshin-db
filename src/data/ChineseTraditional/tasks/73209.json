				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "老頭子我都快不抱希望了，沒想到這花最後還是種出來了，果然活著就能有奇妙的事情發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090702,
					"content": "小妹妹，還在為沙法卡特叔叔的事情難過嗎？別難過啦，活著的人要帶著死去的人的那些心願活下去，才算對得起他們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090703,
					"content": "老先生…我已經不小了，那些和我一起長大的朋友們，說不定她們的孩子都會去店裡買香料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 732090704,
					"content": "但是無論如何你說得對，既然活著總要開開心心地活下去才可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
