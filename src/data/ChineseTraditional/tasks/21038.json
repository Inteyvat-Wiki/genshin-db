						],
						"stepId": 2103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "#旅行者，{F#妳}{M#你}可算是來了，我還以為今天等不到{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380102,
					"content": "#今天就是我離開璃月港的日子了，之前麻煩了{F#妳}{M#你}那麼多事…我得好好向{F#妳}{M#你}道謝才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380104,
					"content": "#咳…我本來剛才還在打腹稿，想著見了{F#妳}{M#你}之後說些什麼感謝的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380105,
					"content": "#結果現在真要說了，我反倒是忘得一乾二淨，讓{F#妳}{M#你}見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380106,
					"content": "沒關係，以後還會見面的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "#真的？哈哈哈，那就太好了，那我到時候就可以領著{F#妳}{M#你}到處逛逛啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380109,
					"content": "#對了，我今天還要請{F#妳}{M#你}幫最後一個忙。我記得{F#妳}{M#你}有一架「留影機」對吧？我想請{F#妳}{M#你}幫我留個影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380110,
					"content": "我聽一個水手說，在外漂泊，最好留一張故鄉的「畫片」做念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380111,
					"content": "#但我可沒有「留影機」，只能請{F#妳}{M#你}幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380112,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "你擺個好看一點的姿勢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "這、這我擺什麼姿勢好？哎呀，主要是拍後面的景致…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380107,
					"content": "過一段時間，我去楓丹找你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103803",
							"2"
						],
						"stepId": 2103803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#多謝{F#妳}{M#你}了，旅行者。這張「畫片」就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380203,
					"content": "唉，終於還是要走了。雖然平日裡我聽人家說「大丈夫志在四方」、「讀萬卷書，行萬里路」時，總覺得豪氣萬丈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380204,
					"content": "但等到自己真要離鄉遠行，我卻覺得胸中半點豪氣都沒有，只想再多待在這裡一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380205,
					"content": "#旅行者，{F#妳}{M#你}覺得我這趟遠行，真的會找到我想要的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380206,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "哈哈…說的也是，我到底要找什麼東西呢？就連我自己也不知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380210,
					"content": "#好了，時間也差不多了，我要去和那位客商會合了。這些報酬請{F#妳}{M#你}收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380211,
					"content": "師妹…她還是沒來啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380208,
					"content": "看你自己了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "#{F#妳}{M#你}這話說的…差不多等於說「此事隨緣」了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孫宇"
				}
			]
		},
