	"talks": [
		{
			"id": 7601301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7601301",
							"2"
						],
						"stepId": 7601301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760130101,
					"content": "#啊，是可靠的{NICKNAME}！又見面啦！果然，這就是月光連接的「命運」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130102,
						760130106,
						760130141
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130102,
					"content": "關於你的處罰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130103
					]
				},
				{
					"id": 760130103,
					"content": "哼哼，菈烏瑪可比萊赫妲爾阿姨講理多啦！我把事情的緣由跟她說清楚以後，她先是沉默了一分鐘左右…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130104
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130104,
					"content": "隨後就讓我來書庫幫安洛絲整理文獻、抄寫禱歌，說是在我端正心念之前，不用再去那夏鎮工作啦！還有比這更棒的獎賞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130105
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130105,
					"content": "#對了對了！我這幾天抄寫禱歌的時候，也理解愛依菈大人之前說的一些話是什麼意思了！果然，{NICKNAME}就是我的幸運符呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130106,
					"content": "關於先前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130107
					]
				},
				{
					"id": 760130107,
					"content": "#嗯嗯！{NICKNAME}想要問什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130108,
						760130137
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130108,
					"content": "關於愛依菈說的那些話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130109
					]
				},
				{
					"id": 760130109,
					"content": "#哼哼，這{F#妳}{M#你}就問對人啦！我這幾天一直在思考，愛依菈大人那些話究竟是在什麼時候記錄下來的，她說的「毒蛇」又是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130110
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130110,
					"content": "#現在，我已經完全理解了一切！{NICKNAME}還記不記得，影像裡，愛依菈大人管交談的對象叫「索洛維先生」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130111
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130111,
					"content": "那個啊，毫無疑問，應該就是執燈人最初的創立者，至冬貴族出身的「索洛維」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130112
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130112,
					"content": "根據記載，愛依菈大人正是在索洛維的請求下，前往北方的<color=#00E1FFFF>厄布拉神柱</color>，平息了深淵的災厄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130113
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130113,
					"content": "「像是早已知曉他的來意一般，新月的女使為他點燃了驅散黑暗的…」呃，總之就是幫了他的忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130114
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130114,
					"content": "所以呀，我猜她說的「毒蛇」，應該也就是深淵的隱喻吧？怎麼樣怎麼樣，是不是完美無缺的可靠推理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130115
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130115,
					"content": "#至於愛依菈大人提到的「婁維婭」…嗯，我想想，{NICKNAME}知道<color=#00E1FFFF>亥珀波瑞亞</color>這個名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130116,
						760130126
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130116,
					"content": "聽說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130117
					]
				},
				{
					"id": 760130117,
					"content": "#原來如此原來如此，不愧是無比可靠的{NICKNAME}！這樣解釋起來就方便多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130118
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130118,
					"content": "「霜月之子」是亥珀波瑞亞的後裔，直到五百年前——也就是月之{RUBY#[D]庫塔爾}少女誕生以前，沿用的都是亥珀波瑞亞那些古老的祭祀儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130119
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130119,
					"content": "「詠月使」是聖女愛依菈大人最初開始使用的頭銜，在那之前，主持那些祭祀儀式的領袖被稱作「主祭之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130120
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130120,
					"content": "而那位「婁維婭」，就是在愛依菈大人改革了霜月之子的信仰前，領導著亥珀波瑞亞遺民的最後一位「主祭之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130121
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130121,
					"content": "月之{RUBY#[D]庫塔爾}少女尚未誕生、月光的{RUBY#[S]月矩力}祝福日漸枯竭的歲月裡，她為了維持亥珀波瑞亞的古老儀式，犯下了褻瀆神明的罪行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130122
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130122,
					"content": "因為她被施加了除憶…就是抹去了她的歷史紀錄，所以具體的我也不清楚，只知道她和外面的壞傢伙勾結，謀害了許多無辜的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130123
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130123,
					"content": "據說，在愛依菈大人出生前，有位追隨者只是因為愛上了至冬的軍官，就在私奔後，被她直接派人…很過分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130124
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130124,
					"content": "總之，愛依菈大人就是從她手中接過了「霜月之子」，廢止了亥珀波瑞亞的禮儀，要求我們全心全意敬奉月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130125
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130125,
					"content": "#原則上來說，只有執祭以上的追隨者才有資格知道這個名字…不過既然是{NICKNAME}，破例也沒問題吧？嗯，沒問題的！大概！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130126,
					"content": "不太清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130127
					]
				},
				{
					"id": 760130127,
					"content": "嗯嗯，那我就從頭說起好啦！哼哼，別擔心，畢竟我可是無比可靠的執祭，領受月秩的…呃，總之我會說清楚的，大概！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130128
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130128,
					"content": "「亥珀波瑞亞」是個已經滅亡的古代國家，我們「霜月之子」呢，就是那個國家流亡到這裡的遺民後裔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130129
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130129,
					"content": "我們的祖先傳承了很多古老的祭祀儀式，但那些儀式都是要依靠月光的{RUBY#[S]月矩力}祝福才能起效的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130130
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130130,
					"content": "那位「婁維婭」，就是在愛依菈大人改革了霜月之子的信仰前，領導著霜月之子的、很壞的大祭司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130131
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130131,
					"content": "但是呢，那個時候，月之{RUBY#[D]庫塔爾}少女還沒有誕生，月光的{RUBY#[S]月矩力}祝福也非常稀薄，很多儀式都沒有辦法起效了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130132
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130132,
					"content": "為了讓儀式能像往常那樣正常進行，那位很壞的大祭司做了很多壞事，還和霜月之子外的壞人勾結，傷害了許多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130133
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130133,
					"content": "至於那位很壞的大祭司具體做了什麼，我也不清楚，因為她的事蹟已經被徹底從歷史紀錄中抹去了。總之就是很壞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130134
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130134,
					"content": "據說，在愛依菈大人出生前，有位追隨者只是因為愛上了至冬的軍官，就在私奔後，被她直接派人…很過分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130135
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130135,
					"content": "後來，愛依菈大人從很壞的大祭司手裡接過了「霜月之子」，廢止了那些古代的儀式，要求我們全心全意敬奉月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130136
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130136,
					"content": "#原則上來說，只有執祭以上的追隨者才有資格知道這個名字…不過既然是{NICKNAME}，破例也沒問題吧？嗯，沒問題的！大概！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130137,
					"content": "關於那把劍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130138
					]
				},
				{
					"id": 760130138,
					"content": "#哦哦，不必擔心！那把劍的事，我也已經和菈烏瑪說過啦。既然愛依菈大人說要送給{F#妳}{M#你}，那就請隨意使用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130139
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130139,
					"content": "不過——嗚啊，真是令人羨慕！傳說中，愛依菈大人正是用這柄劍，向新誕生的月之{RUBY#[D]庫塔爾}少女獻上了第一滴銀血…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130140
					],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130140,
					"content": "#那可是真正蒙受了祝福的無垢之劍，唯有純淨的人才有資格使用…{NICKNAME}果然是受神明眷愛的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維娜"
				},
				{
					"id": 760130141,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130142
					]
				},
				{
					"id": 760130142,
					"content": "#嗯嗯，那就下次再見啦！一路順——咳，不對，願月光照亮你的前路，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維娜"
				}
			]
		},
		{
