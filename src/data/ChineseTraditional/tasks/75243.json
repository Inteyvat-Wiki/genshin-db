			"dialogs": [
				{
					"id": 752430101,
					"content": "哎呀！客人，多虧您趕走了那些不講理的愚人眾啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752430102,
					"content": "那幫傢伙不知道從哪來的，一句話不說，手就直接往我口袋裡伸！簡直是強盜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752430103,
					"content": "還好有您阻止了他們！不然今天一定會損失慘重了…請一定要收下我的感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752430104,
					"content": "對了，差點忘了跟您介紹，這裡是陽光五彩綿馱園，專門給客人們展出溫順的綿馱獸，當然，還有很多相關玩具售賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752430105,
					"content": "不過剛才那些人把我的員工和客人們都嚇跑了，我要快點去處理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752430106,
					"content": "要是您也想來參觀綿馱園，請明天再來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿羅哈"
				}
			]
		},
