			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "喔呀，這不是丫頭的新朋友嗎？今天又來玩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490102,
					"content": "今天的生意還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "很好，很好！哈哈哈，都是我那丫頭把煙花做得好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490104,
					"content": "#{F#妳}{M#你}們今天，是來找她的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490107,
					"content": "真不巧，那丫頭說，她要去外面找做煙花的材料，已經出門去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490108,
					"content": "那她去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "#什、什麼！{F#妳}{M#你}說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490110,
					"content": "宵宮，她去哪裡了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "喔，哎呀…這個我可不太清楚喲，那丫頭也許說過了，但我這耳朵啊，真是聽不清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490112,
					"content": "你們找那丫頭有什麼事嗎？是想要，買點煙花玩玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490113,
					"content": "想找宵宮玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "唔，這次你們應該是找不到她啦，那丫頭每次出去處理煙花，都不知道什麼時候才回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490115,
					"content": "#不然這樣，那丫頭出門之前，做了一些新煙花放在店裡，{F#妳}{M#你}們就先拿這些煙花去玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490118,
					"content": "我把那些煙花放哪了…好像放屋裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490119,
					"content": "這樣是不是不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "#沒關係，沒關係，店裡還備著很多貨，{F#妳}{M#你}們拿一兩個去玩玩，沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490122,
					"content": "#再說了，我那丫頭本來就打算找人來試玩這些新煙花的，{F#妳}{M#你}們今天過來，也正好來試玩一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490123,
					"content": "#{F#妳}{M#你}們就放心大膽地拿著這些煙花出去玩，玩完了之後，回來告訴我煙花怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490124,
					"content": "等那丫頭回來，我再轉告她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490125,
					"content": "#放心吧，那丫頭要是知道那些煙花是{F#妳}{M#你}們拿去玩的，高興還來不及呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490126,
					"content": "#快點去吧，{F#妳}{M#你}們放煙花的時候記得在城外放。在城裡放煙花啊，又要招來好些人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490120,
					"content": "也沒告訴宵宮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "想玩煙花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "#哈哈，那好說啊。那丫頭出門之前，做了一些新煙花放在店裡，{F#妳}{M#你}們就拿這些煙花去玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490105,
					"content": "請問宵宮在嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "#哎呀，{F#妳}{M#你}們今天是來找她的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "長野原龍之介"
				}
			]
		},
