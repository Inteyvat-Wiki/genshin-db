			"dialogs": [
				{
					"id": 220490301,
					"content": "#{F#妳}{M#你}們回來了，煙花怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490302,
					"content": "很好看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "#{F#妳}{M#你}們喜歡就好，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490306,
					"content": "好了，我也該去打理打理店裡了，最近來買煙花的人真是愈來愈多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490307,
					"content": "那丫頭怎麼到現在還沒回來，到底去哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490304,
					"content": "還沒玩夠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "#{F#妳}{M#你}們很喜歡嗎？那就好，下次{F#妳}{M#你}們再來拿點去玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "長野原龍之介"
				}
			]
		}
