			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "真麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "咦？是客人嗎？抱歉，最近客棧周圍很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030104,
					"content": "有好幾位客人在附近被怪物襲擊，弄得有些客人都不敢來做生意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030105,
					"content": "這樣下去，遲早會惹出大麻煩來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030106,
					"content": "#唔，看{F#妳}{M#你}的打扮，是旅行者吧…{F#妳}{M#你}願意幫忙去周圍看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "#謝謝{F#妳}{M#你}願意幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030113,
					"content": "總之，就拜託您了，我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030108,
					"content": "是怪物很危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "怪物危險？不，怪物倒是次要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030111,
					"content": "主要是…怕哪個怪物觸了那位的霉頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030112,
					"content": "他對付怪物，可從來不看場合和在場的人等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
