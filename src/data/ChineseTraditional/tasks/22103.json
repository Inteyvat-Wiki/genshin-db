					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "太好了…總算能安心做會生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030304,
					"content": "這是給您的報酬，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030305,
					"content": "#「那位」是誰？嗯…{F#妳}{M#你}沒見過他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030306,
					"content": "他有時候會在客棧頂上休息，您說不定看見過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030307,
					"content": "不過，就算您見到他了，最好也別輕易去打擾他，他喜歡一個人待著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		}
