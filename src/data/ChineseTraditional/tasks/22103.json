						221030202
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030202,
					"content": "還沒有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "請您快些吧，那位來無影去無蹤的…說不定什麼時候就會回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221030204,
					"content": "要是他真動起手來，這客棧又要歇業了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
