				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "非常抱歉，剛才我對您失言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570702,
					"content": "啊，您問平藏先生嗎？他應該很痛恨我這種人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570703,
					"content": "雖然他很克制，言語也能保持禮貌友好，但其實我能看得出來，他對騙子和其他犯人的態度還是不一樣的…他好像非常痛恨騙子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570704,
					"content": "難道他也曾被騙過嗎？真不可思議，什麼人能騙到平藏先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
