			"trigger": {
				"objectNames": [
					"鹿野奈奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "旅行者，您好啊，舍弟給您添了不少麻煩吧？那孩子就是太有個性了些，其實沒有壞心思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "鹿野奈奈"
				},
				{
					"id": 190570802,
					"content": "如果有不小心之處冒犯到您，請不要顧忌，狠狠地教訓他吧，他敢反抗您就說是我同意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹿野奈奈"
				}
			]
		},
