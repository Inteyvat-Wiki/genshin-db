				"objectNames": [
					"伊庭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "這平藏小子真是不好惹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570902,
					"content": "欸？二位想知道老頭子當初的事？其實沒什麼好說的，很簡單的過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570903,
					"content": "那時聽說是平藏小子在調查，老頭子就知道已經完了，沒費什麼功夫就全交代了，畢竟遇見的可是「風暴」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570904,
					"content": "「風暴」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "是平藏小子的別稱，你們沒聽過嗎？牢裡的犯人都這樣叫他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570906,
					"content": "逃跑是不可能的，藏也藏不住，對罪犯來說，平藏小子就是像風暴一樣的天災啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570907,
					"content": "唉，早知如此，何必當初…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊庭"
				}
			]
		}
	]
