			"dialogs": [
				{
					"id": 701110301,
					"content": "什麼嘛，虛驚一場，搞了半天原來就只是煙花而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 701110302,
					"content": "何、何等絢爛…某追隨御見鳴神主尊大御所大人征戰時，還從未見過這般奪目的火之花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110303,
					"content": "原來如此，這便是虞黃衣殿下讓某觀賞的奇景嗎…恐悅至極，恐悅至極…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110304,
					"content": "「漆夜如烏玉，夜半雲居綻明花，身似水間沫；須臾一剎終歸寂，星離雨散落片空…」嗟乎，何等風雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "曾我隅田流左近重衡"
				},
				{
					"id": 701110305,
					"content": "雖然不知道你到底在風雅些什麼啦…總之沒事就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
