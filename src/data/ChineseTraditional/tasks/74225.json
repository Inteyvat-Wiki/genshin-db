			"dialogs": [
				{
					"id": 742250201,
					"content": "#謝謝{F#妳}{M#你}，恩人。神王在上，我終於得救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250202,
					"content": "#{F#妳}{M#你}是守備這座城市的軍團士兵嗎？還是路過的正義之士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250203,
					"content": "總之先自我介紹一下，我是法烏斯圖斯，神王委任的邊境商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250204,
					"content": "這次是為了運送南國的香料才來到這裡的，沒想到才一上岸就被這些可惡的龍蜥所圍困…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250205,
					"content": "龍蜥？哪有龍蜥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#嗯？絲毫不將剛剛打倒的敵人放在眼裡嗎？{F#妳}{M#你}果然是位了不起的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250207,
					"content": "請收下這個吧。感謝的話就不多說了，我還要趕緊把貨物運進城裡。說不定我們還會在城裡再見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福斯卡里"
				}
			]
		}
	]
