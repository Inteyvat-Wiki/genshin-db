					"speakerTitle": "艾琳"
				},
				{
					"id": 200660302,
					"content": "原來還能這麼解決…這種方法我想都沒想過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660303
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200660303,
