				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "這艘船…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250102,
					"content": "死兆星號？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "這是艦隊裡的二號艦，死兆星號還在孤雲閣巡邏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250104,
					"content": "是北斗！嗯…是縱橫遠海的傭兵巨頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250105,
					"content": "哈哈，又不是第一次見面，用這麼恭維的稱呼，見外了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250106,
					"content": "說來話長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250107,
					"content": "別乾站著，坐下談吧，我讓兄弟們招待一下客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250108,
					"content": "#原來是這樣，沒想到{F#妳}{M#你}和那位秘聞館的主人也有交情。足跡遍及提瓦特的人，果然會結下不得了的人脈啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250109,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250110,
					"content": "對了，登記的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "差點忘了，我們需要登記妳這邊的參展人員，還有妳準備交易什麼貨物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250112,
					"content": "參展人員的話，記上我和幾名看管貨櫃的兄弟就行，其他人都會留在船上。至於用來交易的貨物…喏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250113,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250114,
					"content": "很早之前凝光就著手改良歸終機，我這二號艦上裝備的就是她改良後的一種型號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250115,
					"content": "這種型號的歸終機可以透過遠程引導精準攻擊目標，威力也十分驚人，在這個展會上肯定會很搶手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250116,
					"content": "這種東西可以拿來賣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250117,
					"content": "哈哈，不用擔心，千岩軍現在裝備的最新型號比這個先進多了，這已經算是被淘汰下來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250118,
					"content": "…算了，就像奈芙爾說的那樣，這裡的交易「無所禁忌」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250119,
					"content": "不過，誰會買這個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "不用擔心，挪德卡萊貿易展會匯聚了來自提瓦特各地的買家，肯定能釣到大客戶的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250121,
					"content": "夜蘭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250122,
					"content": "#怪我，一直忙著卸貨的事，忘了告訴{F#妳}{M#你}們她也在船上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250123,
					"content": "沒關係啦，話說夜蘭也是參展人員嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250124,
					"content": "我只是搭順風船來挪德卡萊處理一些情報工作，就不用登記我的名字了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250125,
					"content": "#有段時間沒見了，{NICKNAME}。如果有機會的話，請代我向秘聞館的主人問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250126,
					"content": "妳這次來準備做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "工作需要，不便多講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250128,
					"content": "那是「不要繼續問了」的表情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402250129,
					"content": "我也這樣認為…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "那我就先下船了，等事情辦完後，我請大家喝一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250131,
					"content": "哈哈，那我可要好好嚐嚐挪德卡萊的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250132,
					"content": "這邊已經幫妳們登記好了，跟我們走吧，接下來帶大家去會場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
