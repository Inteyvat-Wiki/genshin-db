			},
			"dialogs": [
				{
					"id": 402250201,
					"content": "#北斗指揮船員卸下了貨物，並跟隨{F#妳}{M#你}們來到了展會現場。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "就是這裡了吧？好位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250203,
					"content": "#{NICKNAME}，{F#妳}{M#你}有空的時候來幫我測試一下遠程引導吧。很刺激的，{F#妳}{M#你}肯定喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		}
