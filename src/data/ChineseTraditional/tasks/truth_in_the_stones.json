			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "哇，這片礦區可真不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210102,
					"content": "各位，這裡就是事發地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210103,
					"content": "六天前我帶幾個伙計外出辦事，一回來，就聽說留守的四個兄弟不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210104,
					"content": "我帶人搜遍整個礦區，怎麼也找不到他們。實在沒有頭緒，才請幾位來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210105,
					"content": "也就是說，有四位礦工行蹤不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210106,
					"content": "對。原本我們有十個人，丟了阿龍、岑大、岑二、小茂，都是跟著我幹活的礦工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210107,
					"content": "這行工人大多是青壯年男性。四個礦工，會不會是去別處礦洞了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210108,
					"content": "不像。這一帶周圍沒什麼落腳地，我們一路過來也沒看見有其他開採中的礦洞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210109,
					"content": "唔…這麼大的礦區，你們全都找遍了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210110,
					"content": "一寸不落，井下也找過，就差掘地三尺了。可四個大活人，總不能一下鑽進地底吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210111,
					"content": "看過現場才能作出結論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210112,
					"content": "哎，好的好的。我在這裡等著，你們隨意搜查，要是有失踪兄弟的線索，務必告訴我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老戴"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112102",
							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"昆鈞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "小昆，你在看什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210202,
					"content": "是你們啊，來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210203,
					"content": "有什麼發現？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210204,
					"content": "這裡有塊礦石，我想，或許能從中獲得一些線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210205,
					"content": "礦石？這種礦石跟失踪案有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210206,
					"content": "這種事，試試就知道了。稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210209,
					"content": "他好像很專注，是在做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210210,
					"content": "看見了。四個大人…跟著一個像是小孩的身影走出了礦區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210211,
					"content": "小孩？礦區裡怎麼會有小孩子？ ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210212,
					"content": "我也不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210213,
					"content": "還有，「看見」是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210214,
					"content": "啊，就是字面意義的「看見」。你們聽了，可別告訴別人！我覺得這事有點古怪，一直沒敢和人說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210215,
					"content": "其實，我能看見礦石的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210216,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210217,
					"content": "不是猜測，不是估算，而是「看見」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210218,
					"content": "像剛才那樣把手放到石頭上就行了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210219,
					"content": "嗯，對我來說，礦石也有「記憶」。它們偶爾會記錄下周遭發生的事，我只要觸摸並用心感知，就能看見那些「記憶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210220,
					"content": "這麼厲害！那你豈不是什麼都知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210221,
					"content": "還得看具體的石塊。不同礦石記憶能力有所不同，鐵礦、白鐵塊之類的常見礦石基本上派不上用場，記憶很模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210222,
					"content": "石珀、水晶的記憶能力比較強，能記錄的景象更多也更清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210223,
					"content": "以石為目…有趣。這種能力實在罕見，老戴請昆兄出馬，實在是明智之舉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210224,
					"content": "哈哈，能幫上大家的忙就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210225,
					"content": "依我所見，他們應該是沿這條路向前去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111210226,
					"content": "這條路指向北方，沿著它一直走就能離開礦區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210227,
					"content": "他們往北走了，把這條線索記錄下來，告訴老戴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
