			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿虎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "你是這裡的工人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210302,
					"content": "啊對、對！你們是來調查失踪案的吧，求求你們，一定要救回大家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210303,
					"content": "我不知道…不知道發生了什麼，那天天色很陰暗，工頭帶著幾個兄弟去外頭辦事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210304,
					"content": "我和其他四個兄弟留在礦區工作，中間我偷懶了一下子…就一下子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210305,
					"content": "我在最裡面的棚子睡覺，等我醒來，所有人都消失得無影無踪了！明明不久前才跟他們說過話，突然…人就不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210306,
					"content": "該不會、該不會什麼時候就輪到我了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210307,
					"content": "躲在棚子裡的人沒有失踪，在外勞作的人卻沒了踪影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210308,
					"content": "莫非是工作區出了什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210309,
					"content": "呃啊！好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210310,
					"content": "工作區或許有狀況，把這條線索記錄下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "你們看，這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210402,
					"content": "散亂的衣服、褲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210403,
					"content": "擺放在礦區內的生活物資，應該是老戴他們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210404,
					"content": "一、二、三、四…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210405,
					"content": "唔…沒錯沒錯，總共十件衣服，十條褲子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210406,
					"content": "#這些是替換的衣物吧？{F#妳}{M#你}看，老戴身上也穿著一樣的服裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210407,
					"content": "那四個人出門六天至今未歸，卻沒帶換洗衣物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210408,
					"content": "周圍還有洗臉用的布帕和皂角…還有這些腰包，是隨身的小工具包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210409,
					"content": "晨間盥洗的用具，採礦的裝備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210410,
					"content": "也就是說，這些人沒帶行李？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210411,
					"content": "對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210412,
					"content": "也許用不到吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "不像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210415,
					"content": "開採用的礦鎬少了四把，說明他們很可能帶著工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210416,
					"content": "有時間帶工具，卻沒時間打包生活用品？不合常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210417,
					"content": "唔…人在什麼情況下才會不帶行李，只帶工具出門？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210418,
					"content": "第一，他們到附近工作，不需要行李，但這些人至今未歸，這個說法不攻自破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210419,
					"content": "第二，如果他們不是出於自身意願而離開，也就無暇思考行李的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210420,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210421,
					"content": "你是說，是被人帶走的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "這種可能性不小。需要更多線索才能進一步推論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210423,
					"content": "不是自發離開而是被人帶走，把這種可能性記錄下來轉告給老戴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210413,
					"content": "會不會是忘記帶行李了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "你們回來了，調查得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210702,
					"content": "我們在附近找到三條線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210703,
					"content": "第一，礦鎬少了四把，生活用品卻一件都沒帶走，說明那些工人很可能不是自發離開，而是被人帶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210704,
					"content": "被人帶走？！可是…誰會劫持工人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210705,
					"content": "第二，礦區內原本有五名工人。其中一人為了偷懶，離開工作區打了個瞌睡。等他一覺醒來，同伴已經消失得無影無踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210706,
					"content": "留在工作區的人全數失踪，躲在休息區的人卻安然無恙。可見，事情是發生在工作區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210707,
					"content": "這麼一說，阿虎確實提過他偷懶了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210708,
					"content": "難道有人走進工作區帶走了他們？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210709,
					"content": "這正是我要說的第三點。昆兄用他特別的手段推算出來，那些人是被一個孩童帶離了礦區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210710,
					"content": "孩童？！這附近住戶很少，不可能有孩子跑到礦區裡來啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210711,
					"content": "但結果就是，四個工人跟著一個小孩子走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210712,
					"content": "他們去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210713,
					"content": "根據我們的推測，他們沿路向北行走，應該是出了礦區，往遺蹟方向去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210714,
					"content": "北方！好，我這就帶人去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210715,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "都把調查的事交給你們了，跑腿就讓我們弟兄幾個來吧。先走一步，說不定快馬加鞭還能追上他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210717,
					"content": "且慢。事情發生在六天前，哪怕只是步行，他們也走得很遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210718,
					"content": "唔…說得也是。這樣吧，等會我帶兄弟幾個到遠處的住戶那打聽打聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210719,
					"content": "離開礦區，想投宿就只有那麼幾戶人家。調查這些就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210720,
					"content": "幾位，我想麻煩你們繼續追查線索。咱們兵分兩路，要是途中沒有碰面，就於明晚在望舒客棧會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210721,
					"content": "也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210722,
					"content": "那我就和兄弟們先走一步了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210723,
					"content": "現在的情況是，我們繼續調查，他們去附近的住戶那裡打聽消息，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210724,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210725,
					"content": "可是，礦區內沒有更多線索了…我們是不是應該往北方追？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210726,
					"content": "等等，少了一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210727,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210728,
					"content": "對哦，小昆這傢伙，多半還在調查。去叫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
