			"dialogs": [
				{
					"id": 150050201,
					"content": "這裡的景色很不錯，還能偶爾看到鰭游龍，我們找幾頭野生的鰭游龍來合影吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050202,
					"content": "野生的咬人怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "這…反正我覺得鰭游龍滿可愛的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050204,
					"content": "欸？那裡是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050205,
					"content": "救命！誰來幫幫我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050206,
					"content": "哇，野生的鰭游龍真的在咬人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050207,
					"content": "見義勇為！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#對，那兩個人有危險，大名鼎鼎的{NICKNAME}和{M#他}{F#她}的搭檔絕不會袖手旁觀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050209,
					"content": "只能等下再合影了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "是啊，沒時間講這個了。有人在呼救，我們不能袖手旁觀吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
