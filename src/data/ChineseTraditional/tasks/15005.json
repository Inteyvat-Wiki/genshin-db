			"dialogs": [
				{
					"id": 150050101,
					"content": "落敗的鰭游龍四散逃走了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "你們這身打扮…難道是須彌來的學者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050103,
					"content": "#嗯，我是卡嘉，這位是我的前輩維蘭德。真的非常感謝{F#妳}{M#你}們，剛剛太危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050104,
					"content": "#不用謝，對我們來說只是小事一樁啦。我是派蒙，這位是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050105,
					"content": "唉…那些鰭游龍全都跑了，至少要活捉一隻啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050106,
					"content": "活捉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050107,
					"content": "#對了，我看{F#妳}{M#你}們身手不錯，要不然我來做誘餌吸引那些鰭游龍，{F#妳}{M#你}們幫我活捉一隻，我會支付報酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050108,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050109,
					"content": "非常抱歉，維蘭德只是太專注於他的研究了，還請不要見怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050110,
					"content": "沒關係沒關係！話說回來，你們為什麼要招惹野生的鰭游龍呢？還要活捉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050111,
					"content": "#難道{F#妳}{M#你}們也想合影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "肯定跟這個沒關係啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050113,
					"content": "讓兩位見笑了，其實我和維蘭德正在尋找傳說中的神秘島。據說有一條重要的線索就在這些鰭游龍身上，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050114,
					"content": "沒有來自「流泉之眾」的嚮導幫助就貿然接觸牠們，果然很不明智啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050115,
					"content": "神秘島？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050116,
					"content": "嗯，一個來自「流泉之眾」的傳說提到了一座神秘的島嶼，維蘭德相信他的研究目標就在這座島上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050117,
					"content": "#咳咳…{F#妳}{M#你}們真的不考慮一下我剛剛的提議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050118,
					"content": "剛剛的提議…我們才不會把一個大活人當誘餌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050119,
					"content": "那繼續談也是浪費時間，得想想別的辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050120,
					"content": "前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050121,
					"content": "#好吧…剛剛{F#妳}{M#你}們的確救了我和卡嘉，於情於理，我是該向{F#妳}{M#你}們道謝…非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050122,
					"content": "好彆扭喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050123,
					"content": "卡嘉，我們該走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "維蘭德"
				},
				{
					"id": 150050124,
					"content": "真的非常抱歉，維蘭德的確不太擅長處理人際關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050125,
					"content": "沒關係，再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050126,
					"content": "真是稀奇，這樣的兩個人竟然能夠結伴探險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050127,
					"content": "不過話說回來，那位大姐姐提到的神秘島真的讓我很好奇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050128,
					"content": "派蒙也想去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "嗯，或許會有寶藏哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050130,
					"content": "這一路上我們一起探索了那麼多神奇的地方，找到這個神秘島對我們來說也絕對不在話下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050131,
					"content": "但是什麼情報都沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "也是…對了，那位大姐姐說這個神秘島是「流泉之眾」傳說中的一座島嶼，或許我們可以到那裡找人問一問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050133,
					"content": "事不宜遲，現在就開始我們的下一段冒險吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050134,
					"content": "雖說計劃好了找人問問看，但具體該找誰是個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050135,
					"content": "或許可以直接找首領？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "嗯…也對，那位大姐姐提到這個神秘島和「流泉之眾」的一個傳說有關，那「流泉之眾」的首領肯定知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
