							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "先試試看，艾梅莉埃小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "#{F#妳}{M#你}的動作真是賞心悅目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510203,
					"content": "嗯…這是一杯「七時柔燈」的在地版吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510204,
					"content": "非常正確。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "柔和淡雅，層次分明的口感，結合了幾分蒙德特色的香氣，風味相當親切，也避開了可能讓我感到不諧的味覺成分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510207,
					"content": "其實，不用這麼謹慎。對於跳脫常理框架的風味物質，我也有著不錯的接受能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510208,
					"content": "看來現在這杯有點太傳統了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "#這杯非常不錯——當然，如果能有一杯更「深刻」、加入了{F#妳}{M#你}個人獨特理解，也能加深我對蒙德印象的特調，就完美無瑕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510211,
					"content": "我們可以放慢節奏，從閒談中尋找靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510212,
					"content": "這是妳剛買的花卉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "是經營花鋪的酬勞之一，重要的香水材料，幫我完成了貓尾酒館的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510214,
					"content": "許多年前，我研究過蒙德的塞西莉亞花，塞西莉亞花的香氣在一些領域內，直接成為了「蒙德」的代名詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510215,
					"content": "不過，這次情況特殊，有些貓兒不太習慣塞西莉亞花的氣味，需要特別考慮牠們的感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510216,
					"content": "這次換用了什麼植物香氣呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "是風車菊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510219,
					"content": "將風車菊的植株分部位研磨萃取後，適當混合花冠與葉片的香氣。有蜜酒般的酣甜，但也強調了花卉枝葉中的清新氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510220,
					"content": "剛剛在貓尾酒館小小試驗了一番，貓兒們的反應還不錯。客人們也覺得新的香氛既溫馨，又讓他們精神颯爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510221,
					"content": "從外表平凡、未被重視的材料中，提取出卓越的香氣…真是件令人欣喜的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510222,
					"content": "今天的天氣很棒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "（原來用經典話題展開聊天是這種感覺…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "的確，早些時候，低空中徘徊著輕紗般的淡積雲…大氣的濕度適中，風速也相當柔和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510225,
					"content": "這種條件下，人的嗅覺會處於一種…活躍，而不過度敏感的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510226,
					"content": "混合得當的香味成分，能夠自然而然地融入環境，深刻地浸潤至人們的記憶之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510227,
					"content": "居然還有這種理論…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "調飲似乎也有著相通之處——選擇烈度適中的基酒，讓各種香味成分和諧地融入酒體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510230,
					"content": "要是處理得當，一切成分都能共同發揮功用，為味覺帶來最美妙的交響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510231,
					"content": "好像懂了，口感融合很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "嗯…說得對。仔細一想，層次分明的口感，的確不太符合我個人的習慣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510234,
					"content": "平常艾梅莉埃都喝什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "平常啊…工作結束後，執律庭的朋友們偶爾會請我喝兩杯。通常我會選擇果茶，以便在聚餐後快速回到工作狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510236,
					"content": "如果第二天是假期，警員們興高采烈，我也會點一小杯水果氣泡酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510237,
					"content": "有位名叫蒂蕾娜的警官，還經常請我共飲陳年木桶的歌妲酒。不過她調去特巡隊後，我就沒再喝過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510238,
					"content": "原來妳可以接受酒類嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "從科學的角度考慮，酒精是一種使用率極高的溶劑，我許多年前就習慣了高純度酒精的氣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510241,
					"content": "而在微醺狀態下，我的心境會有所不同，進而影響到調香的思緒…無論結果是好是壞，都屬於新的嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510242,
					"content": "所以，我並不抗拒烈度較低的酒飲，在飲品中加入一點點酒類就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510243,
					"content": "最近的調香工作都還順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "嗯，多謝關心，一切都好。只有這次蒙德之行，遭遇了意料外的挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510245,
					"content": "一開始，我就根據《芳香物質與人體感官概論》這本經典，選擇了蒙德地區最傳統的幾種香味物質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510246,
					"content": "沒想到，以落落莓為主調的香氛在酒館中顯得過於香甜，讓人昏昏沉沉…有著漂亮耳朵的調飲師小姐直接倒下睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510247,
					"content": "原來落落莓有這種功效？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "只能說，甜度並非越高越好。對於攝入的甜味物質，適當控制總量，對身體和思維總歸是有益的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510250,
					"content": "日常生活中，我也不會經常吃甜食，並盡量避免食用漿果一類糖分過高的水果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510251,
					"content": "最後，我在調香中完全劃掉了落落莓的相關成分，轉而向風車菊的方向探索出了一番成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510252,
					"content": "我已經有主意了，請稍等，我這就調整配方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "#嗯？只是簡單聊了兩句，{F#妳}{M#你}就找到了方向嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510254,
					"content": "#或許，{F#妳}{M#你}本來就有著很強的研發天賦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510248,
					"content": "聽起來落落莓香氛不太妙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "還以為妳會覺得酒很嗆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "妳比較傾向渾然一體的口味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "第一次聽說，長知識了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "用哪種花卉取代了塞西莉亞？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "艾梅莉埃想要更特別的飲品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "一下就被妳品出來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
