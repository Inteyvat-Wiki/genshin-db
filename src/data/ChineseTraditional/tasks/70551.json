			"dialogs": [
				{
					"id": 705510301,
					"content": "請品嚐這杯專為艾梅莉埃改良的「七時柔燈」。不過，現在還沒想好品名…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "色彩更加清爽，散發而出的香氣也十分淡雅，符合青色的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510303,
					"content": "表面這層斑斕的細末，來自風車菊的花瓣和葉片嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510304,
					"content": "對，一眼就看出來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "味道肯定很不錯…我試試哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510307,
					"content": "嗯…風車菊的花語是「看得見的風」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510308,
					"content": "#{F#妳}{M#你}不僅捕捉到了它們的形態，還將它們捎來的香氣融入了這杯特調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510309,
					"content": "我提議，這杯特調，就命名為「雲風芳跡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510310,
					"content": "蒙德的雲與風在杯中旋繞，留下芬芳之痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510311,
					"content": "不愧是香水專家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "#是嗎？可能是職業的習慣使然，{F#妳}{M#你}滿意就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510314,
					"content": "接下來，容我慢慢品嚐這杯特調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510315,
					"content": "#十分感謝，{NICKNAME}。這次蒙德之行，還真是收獲滿滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510316,
					"content": "這是迄今為止，我印象最深的一杯特調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510317,
					"content": "#返回楓丹後，我會嘗試根據記憶中此刻的印象，以香水和香氛的兩種形式分別再現{F#妳}{M#你}的這杯傑作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510318,
					"content": "我的榮幸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "#調製完畢後，還請{F#妳}{M#你}賞光，來當這兩種新品的首位客戶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510321,
					"content": "到時，楓丹廷見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510319,
					"content": "好耶好耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "命名很有格調！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "正是蒙德特色的花卉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
