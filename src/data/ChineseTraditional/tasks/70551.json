					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#午安，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510102,
					"content": "#沒想到…我會有幸在蒙德見識到{F#妳}{M#你}的「調和」才華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510103,
					"content": "艾梅莉埃小姐來旅行嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "兩者兼有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510106,
					"content": "一位自稱魔女的小姐邀請我來經營她的小花鋪。另外，我還接到了貓尾酒館的委託，為該店調製了新的香氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510107,
					"content": "#以{NICKNAME}親手調製的飲品為今天的忙碌劃上句號，更是絕妙的收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510108,
					"content": "那我要使出拿手好戲了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "#相信{F#妳}{M#你}的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510111,
					"content": "（艾梅莉埃對香味的敏感性強於常人，如果產生了控制不當的複合香氣，或許會讓她覺得不妥？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "（總之，使用香氣包容性較強的材料，再適當加上楓丹風味吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "（那就先來一杯蒙德改良版的「七時柔燈」好了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "我會為妳調一杯驚喜特飲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "艾梅莉埃小姐來出差嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
