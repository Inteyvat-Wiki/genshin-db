					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "這下…就不太好處理了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090902,
					"content": "這次要拍什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "這次…就不勞煩您幫我去留影了，我想請您幫我另外一個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090905,
					"content": "咳，說出來非常不好意思，能不能…請您幫我去找點吃的…比如「蒜香麵包棍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090906,
					"content": "你是…沒帶食物嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "不！我自己帶了很多麵包，還有果醬和肉乾，本來應該夠我今天吃的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090909,
					"content": "但我光顧著畫畫，就把這些食物放在旁邊…當我意識到餓的時候，這些食物已經不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090910,
					"content": "不知道是被動物叼走了，還是被哪個餓壞了的路人偷偷拿走…唉，希望這些食物能填飽他們的肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090911,
					"content": "但我自己饑餓的肚子，就不得不另外找個方法填飽啦…我現在沒辦法回去城裡，我素材還沒找夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090912,
					"content": "你稍等一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "那就拜託您了，「蒜香麵包棍」在城裡的商店裡就能買到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090915,
					"content": "哈哈…我現在有點沒力氣了，不知道是因為餓的關係，還是思考過度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090913,
					"content": "我去幫你拿一點過來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "你是…沒錢買吃的了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "這次要去哪裡留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
