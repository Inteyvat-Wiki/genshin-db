			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "我看看…我的那些朋友給了我一些建議，我把它們都記錄在本子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090202,
					"content": "水底植物…搖擺…光影…變化…我當時在寫什麼，難道是喝多了？呃…對，應該是喝多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090203,
					"content": "咳，請您幫我去水底拍一拍那些水生植物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090204,
					"content": "看起來…寫這些紀錄的我，對於水底植物上的光影變化很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
