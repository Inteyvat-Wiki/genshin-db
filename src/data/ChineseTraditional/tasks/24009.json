			},
			"dialogs": [
				{
					"id": 240090401,
					"content": "我看看…我的那些朋友給了我一些建議，我把它們都記錄在本子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090402,
					"content": "「水底的巨大廢墟！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090403,
					"content": "我怎麼寫得這麼用力，都快把紙戳破了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090404,
					"content": "但水底的巨大廢墟…聽起來確實帶著一點別樣的美感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090405,
					"content": "那就請您幫我去拍一拍水底的廢墟吧，越大越好、越殘破越好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
