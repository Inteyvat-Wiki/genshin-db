					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "您幫我拍到畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090802,
					"content": "拍到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090804,
					"content": "完美的畫片！沒想到您居然在留影方面有著如此造詣，太出色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090805,
					"content": "從這張畫片裡，我一定能篩選出絕佳的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090806,
					"content": "太感謝您了，讓我看看…我的摩拉放在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090807,
					"content": "好了，這些給您，請務必收下！如果之後有機會的話，還請您務必再幫我去留幾張影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090808,
					"content": "接下來…讓我看看怎麼構思畫面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
		},
		{
