			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "旅行者！您來得正好，我剛好找到了一個絕佳的留影地點，就差您幫我一把了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090102,
					"content": "你還在取材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "當然，這些素材還遠遠不夠，一張畫片，是不足以讓我創作出一整幅畫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090104,
					"content": "通常來說，如果我決定用畫片作為參考素材，那所需的畫片少則幾十張，多則上百張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090105,
					"content": "要那麼多啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "就像我之前告訴您的，繪畫的重點在於「創作」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090108,
					"content": "如果只是把所見的東西鉅細靡遺地呈現在畫布上…那不叫「繪畫」，那叫「留影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090109,
					"content": "畫家真正要做的，是用自己的審美和靈性審視他所見的事物，將這些事物篩選、變形、裁剪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090110,
					"content": "直到將每一個事物中最「美」的部分抽象出來，再刻進畫布裡，這樣才能完成一幅畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090111,
					"content": "聽不懂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "您…好吧，簡單來說，我只會用這些畫片裡最好看的部分做參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090114,
					"content": "比如這張畫的光影非常不錯，但景物差了一點，那我就只會參考它的光影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090115,
					"content": "另一張畫片裡有一位行人擺出了非常有趣的動態，下一張畫片裡的建築很雄偉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090116,
					"content": "就像是在您的思維裡玩一場拼圖遊戲，最後拼出來的事物美醜與否，純粹取決於您個人的審美和學識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090117,
					"content": "我這麼說真的非常不嚴謹，因為我們還會把素材裡的景物進行變形啦、抽象啦之類的…但您這麼理解就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090118,
					"content": "所以，你還需要我幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "呃…沒錯！您的留影技巧真的非常高超，我的那些朋友在看了您幫我拍的畫片之後，都恨不得親自來見您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090121,
					"content": "有了您的幫忙，我一定能創作出非常傑出的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090122,
					"content": "哎呀，為了人們的審美，還有我準備好的這些摩拉，請您再幫幫我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240090119,
					"content": "所以，我得繼續幫你取材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "講簡單一點啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "這些畫片的作用不一樣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
