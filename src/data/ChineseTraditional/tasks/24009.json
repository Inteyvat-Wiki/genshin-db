			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "多謝您，這些東西就夠我填飽肚子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091002,
					"content": "這些報酬是給您的，請收下吧。我得趕快吃幾口了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240091003,
					"content": "下次…我還是帶一些能裝進袋子裡的餅乾吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
