				]
			},
			"dialogs": [
				{
					"id": 401480101,
					"content": "#早，今天也有勞{F#妳}{M#你}囉，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480102,
					"content": "#有了前幾次的經驗，{F#妳}{M#你}們愈加得心應手…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "#嗯…{F#妳}{M#你}越來越適應在店裡掌勺了嘛，這下不管來再怎麼麻煩的客人，都不成問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480104,
					"content": "——停！我總覺得每次你一說這話，就會出現麻煩的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480105,
					"content": "嘿，哪有這回事！我又不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480106,
					"content": "——啊哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480107,
					"content": "哎呀，沒想到能在璃月見到兄弟你啊！欸，那句俗話是怎麼說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480108,
					"content": "「他鄉遇故知」，老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480109,
					"content": "對對對，就是這個！你說是吧——綾人兄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480110,
					"content": "呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480111,
					"content": "——放牛的？怎麼又是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480112,
					"content": "嗯？飛行…「破空白鐵小堇瓜」？還有摯友！怎麼今天這麼走運，能夠遇到這麼多老朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480113,
					"content": "你前陣子不是還說要回去好好賺錢嗎…怎麼又跑來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480114,
					"content": "哈哈，以本大爺的身手，想賺錢還不是手到擒來的事？這趟出來，當然是吃香的喝辣的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480115,
					"content": "咳…順便再看看玉將在璃月過得怎麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480116,
					"content": "（阿忍在用眼神示意…現在先不要深究吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "那綾人你又是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "…我聽說前陣子有人在璃月舉辦「鬥蟲試合」，所以特意趕來看看。只可惜，似乎錯過了時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480119,
					"content": "什麼？居然錯過了那場大會！哎，那真是太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480120,
					"content": "是啊，幸好這趟出行遇見了一斗兄弟，可以聽你講講那時的盛況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480121,
					"content": "哈哈，好說好說，我們邊吃邊聊。這間店裡的廚師呢？快叫廚師出來，我要給摯友們來頓豪華的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480122,
					"content": "我就是廚師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480124,
					"content": "喂，放牛的是在學書裡的情節啦…那種大手一揮，就有人跑出來的橋段…這裡還是給他一點面子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480125,
					"content": "…不過還有主廚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "啊…哈哈，摯友真會開玩笑，那就快請那位主廚出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480127,
					"content": "#{F#妳}{M#你}與派蒙回到廚房向言笑說明原委，請他出面圓場…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "呃…那客官是要點什麼？要宴請貴客的話，我們這有「金玉滿堂」、「繁弦急管」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480129,
					"content": "…老大，注意預算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480130,
					"content": "嗯…嗯…那個…有沒有更…實在一點的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480131,
					"content": "實在？呃…倒是有一道「知足常樂」，滷香四溢、回味無窮，是大快朵頤、物美價廉的首選…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401480132,
					"content": "「知足常樂」？好名字！一聽就知道是道紮實菜，就選它了！在座的都是朋友，就不弄那些花裡胡哨的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480133,
					"content": "一斗兄好眼光，我也向來不喜歡過於精緻的菜。嗯…這就是知己吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480134,
					"content": "知己？哈哈，對！就是知己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480135,
					"content": "真的假的…算了，你們兩個開心就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
