						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "菜…菜來囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480202,
					"content": "哈哈，這就是「知足常樂」？果然分量很夠，很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480203,
					"content": "#來來來，摯友{F#妳}{M#你}也坐。在座的都是朋友，誰都不要跟誰客氣！我先來一塊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480204,
					"content": "咳！老大，所謂「入鄉隨俗」，根據璃月的餐桌禮儀，這裡應該讓客人先嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480205,
					"content": "嗯？阿忍妳不是最討厭這些條條框框嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480206,
					"content": "我現在也算客人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "哦？連摯友也…哦哦，一定是太香了對不對？好，既然你們都這麼說的話，本大爺就最後一個吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480210,
					"content": "#{F#妳}{M#你}與派蒙、綾人、阿忍依次吃了一圈，盤中的「肉塊」也少了許多…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "…呵，原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480212,
					"content": "——總算輪到本大爺啦，現在就來一塊最大的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480213,
					"content": "等、等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480214,
					"content": "嗯？又有什麼事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480215,
					"content": "派蒙，這裡就交給妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "我…我盡力吧…呃，剛剛我忘了為你們介紹這道菜的來歷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480218,
					"content": "菜的來歷？這有什麼好聽的，吃不就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480219,
					"content": "呃呃…不聽介紹就吃菜，就像不帶導遊去旅遊！聽完介紹再吃菜，口味一定更精彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480220,
					"content": "的確，就像不同的茶有不同的品法，不聽介紹就品嚐，豈不是浪費了廚師的一片心意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480221,
					"content": "摯友的心意？那的確不能辜負…那就來吧，妳說，我在聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480222,
					"content": "對！我們先說它的原料…啊不，先講講望舒客棧…講講荻花洲的歷史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480223,
					"content": "#（{NICKNAME}，趁現在！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480224,
					"content": "（收到！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "#趁著派蒙吸引住一斗注意，{F#妳}{M#你}與阿忍開始風捲殘雲…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "…荻花洲…居然還發生過這麼感人的故事…能有現在的生活，是該「知足常樂」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480227,
					"content": "（糟糕，不能提到「豆腐」，不知不覺就跑偏了…還好只剩一點了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401480228,
					"content": "（可是我們已經吃不下了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "#啊！阿忍、摯友！{F#妳}{M#你}們什麼時候開始吃的？居然就剩最後幾塊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480230,
					"content": "——現在我是說什麼都不會再讓了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480231,
					"content": "等等！老大，那其實是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480232,
					"content": "且慢，一斗兄，其實…我有一個不情之請，想請你割愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480233,
					"content": "我這趟出門倉促，未能帶上家眷。他們常聞你的大名，對荒瀧派神往已久，可惜這次無緣同席…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480234,
					"content": "不過你若是能將剩下的…「知足常樂」打包送給他們，嗯，他們一定會很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401480235,
					"content": "這個…不太好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480236,
					"content": "老大，璃月還講究「成人之美」…而且你等上菜的時候，不都吃了好幾份烤魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480237,
					"content": "——連我跟綾人先生的份也吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401480238,
					"content": "什麼？那個原來是你們的份嗎…故事講得太投入，完全沒有注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480239,
					"content": "咳咳…那就有勞綾人兄代我向他們問好了！店家，麻煩打包一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401480216,
					"content": "可不可以再表演一次那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "我也想先吃一塊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
