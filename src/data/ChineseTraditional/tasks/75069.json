			"dialogs": [
				{
					"id": 750691201,
					"content": "瀑布，呵呵…因為瀑布的聲音充斥了耳朵，所以就聽不到別的東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691202
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691202,
					"content": "#啊，是{F#妳}{M#你}啊，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691203,
						750691207
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691203,
					"content": "你為什麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "我是…冒險團的戰士，雖然我的勇武，比不上領隊的泰卡大人，不過，也有用得上我的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691205,
					"content": "我負責保護冒險團的營地…有的時候在夜裡也，無法睡去，所以乾脆起來巡邏，保護營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691206,
					"content": "不知道什麼時候，營地裡的人越來越少了…啊，咦，奇怪，為什麼我現在在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691207,
					"content": "沒有什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "是嗎…唉呀，聽我一句勸吧勇士，還是快點離去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
