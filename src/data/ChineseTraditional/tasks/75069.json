					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"0",
							"75069"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"誇恩因"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "唉呀，這裡，很少有人來…因為畢竟是，危險的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750690202,
					"content": "#難道{F#妳}{M#你}也是冒險團的人嗎…哼，聽說黑色巨蛇的影子自天蛇船降臨…{F#妳}{M#你}也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750690203,
					"content": "或者，乾脆早點離開吧，冒險團裡，哈，也藏著非人之物啊…那些聲音，咒罵，好吵鬧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750690204,
					"content": "在這裡反而能夠平靜一點，因為瀑布，呵呵…因為瀑布的聲音充斥了耳朵，所以，就聽不到別的東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
