					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "（破碎的紙張，一開始寫著整齊的文字…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690502,
					"content": "「…深淵的魔物變得越來越多，這些都是可以預見的…冒險團最終還是失敗了，撤退的計畫正在執行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690503,
					"content": "「必須要讓剩下的人安全撤離，要小心防備那些突然在夜晚消失，或是自無光之處重新歸來的人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690504,
					"content": "「…那些深淵的魔物越來越多，據點或許也會被發現，但是要在那之前…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690505,
					"content": "（下面的字開始變得歪歪扭扭起來…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690506,
					"content": "「啊，好冷…好冷，在那裡，在那裡，血也流空了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690507,
					"content": "「瀑布聲音，好大，對，這樣就好。只要這樣…只要在瀑布底下，在那裡就會安靜了，白色的臉、張開的嘴巴、流光的血…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690508,
					"content": "「就在那裡，在…那裡，有什麼東西…有什麼在…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "誇恩因的日記"
				},
				{
					"id": 750690509,
					"content": "「在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因的日記"
				}
			]
		},
