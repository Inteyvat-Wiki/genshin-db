			"dialogs": [
				{
					"id": 750691101,
					"content": "瀑布，呵呵…因為瀑布的聲音充斥了耳朵，所以就聽不到別的東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691102
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691102,
					"content": "#啊，是{F#妳}{M#你}啊，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691103
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750691103,
					"content": "沒有什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691104
					]
				},
				{
					"id": 750691104,
					"content": "是嗎…唉呀，聽我一句勸吧勇士，還是快點離去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
