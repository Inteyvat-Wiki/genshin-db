			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "我看看我看看…嗯？這是蘭那羅的畫嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980302,
					"content": "隨便翻別人的東西不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "是喔？明明，一路上冒險家的營地、遺蹟的寶箱什麼的，我們都清理過不知道多少次啦 ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980304,
					"content": "嗯…不如這麼說吧！這個房子周圍沒見到蘭那羅，我們很擔心，所以想看看有沒有什麼線索。說不定，還能幫助受困的蘭那羅呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980305,
					"content": "#{F#妳}{M#你}說得對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "哼哼，那當然！不管怎麼說，這幅畫看上去…好像是附近的風景，對吧？不得了，說不定是藏寶圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}，我們去畫出來的地方看看吧！或許真的有蘭那羅留下的寶藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980306,
					"content": "哦。那可真是太有道理了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
