					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "嗯…讓我看看…好像又出現新的藏寶圖了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980402,
					"content": "不是說要幫助「受困的蘭那羅」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#咳咳！對，我們這回沒有找到屋主，真是令人擔心！所以，{NICKNAME}，我覺得，我們多去圖畫裡描繪的地方看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980404,
					"content": "到了那些地方以後，我們就能根據上面描繪的地點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980405,
					"content": "找到更多寶藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "對！啊，不對！找到需要幫助的蘭那羅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980409,
					"content": "嗯…感覺這個「信箱」很神奇，說不定之後還會有新的圖畫傳回來。之後，我們多留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980407,
					"content": "找到「受困的蘭那羅」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "嗯！而且，說不定還能得到寶藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "派蒙"
				}
