	"talks": [
		{
			"id": 1104501,
			"completionStepIds": [
				1104501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104501",
							"2"
						],
						"stepId": 1104501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "#想必在旅行的過程中，{F#妳}{M#你}也遇到過很多的謎題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450102,
					"content": "#和體能測試類似，我想藉由實驗觀察{F#妳}{M#你}的智力水準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450103,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "#我希望{F#妳}{M#你}能探索一番這裡的遺蹟，之後給我{F#妳}{M#你}所得到的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450106,
					"content": "在這遺蹟的兩側，各有一處謎題，完成之後，應該就可以啟動中央的機關了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450107,
					"content": "#還是像體能測試那樣，不限制方式，{F#妳}{M#你}所做的一切都是我想要觀察的內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450108,
					"content": "這種事很熟悉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "不愧是經驗老道的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450112,
					"content": "#那麼，就看{F#妳}{M#你}表現了。先去哪一邊，都由{F#妳}{M#你}來決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450110,
					"content": "試試看總會有辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "別忘了這是智力測試，運氣並不在測試內容中哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450104,
					"content": "這種說法是不是怪怪的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450462,
					"content": "不認識的圖案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "據我所知，這個是一種文字，雖然遍佈提瓦特大陸，但又謎團重重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450402,
					"content": "無法理解的地方還有很多，而且，為什麼要將這幾個符文留在這裡，也很奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450403,
					"content": "#總之，我先將它抄錄下來，等對{F#妳}{M#你}的研究結束之後，我會抽時間看看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450404,
					"content": "唉，又是看不懂的東西。我完全不知道這些很奇怪的問題和實驗，能得到什麼結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450405,
					"content": "但看來想要賺取報酬，都要付出與之對應的代價啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450406,
					"content": "這次我實在是收穫了很多很多，相較於此，提供微不足道的報酬，實在是不足掛齒的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450407,
					"content": "#我先回之前的營地去了，等{F#妳}{M#你}們回來的時候，我應該能讓{F#妳}{M#你}們見證一個奇妙的瞬間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450408,
					"content": "那就待會見了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "其實我還是滿期待辛苦了這麼一番之後，能有什麼樣的結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450411,
					"content": "如果沒有什麼事的話，我們也回營地去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450413,
					"content": "別著急離開，在我排除掉所有危險之前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450414,
					"content": "啊？是妳！原來妳沒有離開雪山嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450415,
					"content": "#當然，{F#妳}{M#你}們和阿貝多做的一切，我都看在眼裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450416,
					"content": "#該說{F#妳}{M#你}是沒有戒備心好呢，還是被他獨特的思維模式，還有友善的態度欺騙了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450417,
					"content": "出什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "聽從陌生人的指示行動，喝下完全來歷不明的藥水，參加了諸多結果不明的實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450420,
					"content": "#比起單純，我更願意相信{F#妳}{M#你}是被欺騙，或者說…從一開始就串通好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450421,
					"content": "果然是戒備心很強的修女啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450422,
					"content": "我只是在幫助他的研究。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "#無所謂，阿貝多的事怎麼都好，我對他的瞭解，還是比{F#妳}{M#你}這樣的外鄉人要多一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450425,
					"content": "#我關心的只有一件事，就是{F#妳}{M#你}是否已經被煉金術改造，變成了無法理解的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450426,
					"content": "不會吧？！我完全沒有察覺到！而且，一路上他好像就沒有怎麼用過煉金術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450427,
					"content": "#像他這種級別的煉金術士，想要動點手腳，{F#妳}{M#你}當然察覺不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450428,
					"content": "總之，我是不會把任何的威脅放回蒙德的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450429,
					"content": "那、那妳想怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450430,
					"content": "妳是來確定的，妳就有辦法確定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "#這方面腦子倒是挺靈光的。只要能確定{F#妳}{M#你}們接觸過的所有東西都沒有危險，{F#妳}{M#你}們也就沒有危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450432,
					"content": "其他東西的調查我已經完成了，現在唯獨沒有確認的，就是這些符文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450433,
					"content": "這些符文，我們連看都看不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450451,
					"content": "我知道，而且…嗯，似乎也只是符文，並不是機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450452,
					"content": "但保險起見，還是抄錄下來…唔，還要把這裡作為重要地點，定期巡視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450434,
					"content": "#行吧，既然這樣，{F#妳}{M#你}們就應該沒有危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450435,
					"content": "#這也是我希望的情況，要是因為{F#妳}{M#你}們讓我加班，我就虧大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450436,
					"content": "加、加班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450437,
					"content": "#再見之前，忠告{F#妳}{M#你}一句，外鄉人。別太信任阿貝多了，至少別像這次一樣，幹這麼多不經考慮的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110450439,
					"content": "她走了，真我行我素啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450440,
					"content": "在蒙德，像她這樣的人還真是少見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450441,
					"content": "或許只是沒有安全感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "嗯，不管她了，我們回去見阿貝多吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450442,
					"content": "或許只是有點敏感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "我不認為他是壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "他別有所圖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "看來我的智力沒出什麼問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "總覺得在什麼地方見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "#{F#妳}{M#你}們回來了，正好這裡差不多有結論了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450502,
					"content": "#不過{F#妳}{M#你}們好像花了挺多時間的，難道是路上發生了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450503,
					"content": "沒什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "還是來說結論吧，今天獲得了大量的數據，很難一次性將研究全部完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450507,
					"content": "#但可以給{F#妳}{M#你}一個整體性的初步結論，那就是——{F#妳}{M#你}非常像這個世界的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450508,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "這一眼就能看出來的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450511,
					"content": "我們辛辛苦苦跟你做了這麼多，結果換來的就是這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450512,
					"content": "#別急，別急，可能對{F#妳}{M#你}們來說，覺得是理所當然，但其實這個世界上沒有理所當然的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450513,
					"content": "#{F#妳}{M#你}們有考慮過這種可能嗎？提瓦特這個世界，對外來者持有天然的拒絕態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450514,
					"content": "答案在神那裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "#我提起過這個世界的法則，{F#妳}{M#你}能安然無恙地在這裡與我對話，看起來平常，但其實是奇蹟也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450517,
					"content": "#因為，和{F#妳}{M#你}一樣遠道而來的生命，就是我之前提到過的種子，在提瓦特的法則作用下，甚至沒辦法正常地生長開花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450518,
					"content": "#可是，在觀察過{F#妳}{M#你}之後，我有了其他的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450519,
					"content": "#模仿{F#妳}{M#你}的生命，為煉金術加入我的新靈感，然後——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450520,
					"content": "哇，好像，好像有什麼要出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450521,
					"content": "從無到有，從萌芽到繁盛，再到終結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450522,
					"content": "培育不屬於這個世界的生命，難道不是在培育世界嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450523,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450524,
					"content": "好漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "唉，看來這就是極限了。只能盛開一瞬卻無比美麗的花朵，生命的極致也在於此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450527,
					"content": "我以為我們付出了那麼多，它可以永遠盛開下去。而且好像也沒結出什麼果子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450528,
					"content": "生命是多種多樣的自由之物，不應以長短定義優劣，哪怕只綻放一刹那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450529,
					"content": "短暫的生命也未必是壞事。高效，完美，意味著不會被孤獨所困擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450530,
					"content": "#所以，{F#妳}{M#你}能明白嗎？我剛剛說的，「我們的交談說不定是奇蹟」這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450531,
					"content": "至少我現在還沒有凋零。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "欸？為什麼突然氣氛變成這樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450534,
					"content": "#嘿嘿，別沒精打采的了，{NICKNAME}，{F#妳}{M#你}還有我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450535,
					"content": "還有阿貝多，我很願意跟你當朋友啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110450536,
					"content": "#…謝謝{F#妳}{M#你}們。雖然我不認為排解孤獨是生命的必要之舉…但，也不壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}，是{F#妳}{M#你}提供的幫助讓我找到了靈感，發現了讓它開花的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450538,
					"content": "作為「實驗品」的幫助嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "#不，與{F#妳}{M#你}們在雪山上同行的時光，也是一段很有價值的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450540,
					"content": "#以後…如果還有需要的話，我還能請{F#妳}{M#你}們幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450541,
					"content": "不需要幫忙的時候，也可以找我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "#那…就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450544,
					"content": "#雖然一直在告訴{F#她}{M#他}，說實驗結果是「平凡」的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450545,
					"content": "但這不該出現在瓶底的沉澱，又是怎麼一回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450546,
					"content": "#呼吸黑土則汙穢，呼吸白堊則無垢。{F#妳}{M#你}與我一樣，都是未來尚未完全確定的「質料」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450547,
					"content": "如果有一天，失控的我要把蒙德…把一切都毀滅的話——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450548,
					"content": "#可以期待{F#妳}{M#你}來阻止我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110450532,
					"content": "#（不知道{F#哥哥}{M#妹妹}現在怎麼樣了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "好短暫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "或許吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "就只是這樣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "被修女攔住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "那沒關係，她只是在完成工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "阿貝多"
				}
			]
		},
		{
			"id": 1104506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
