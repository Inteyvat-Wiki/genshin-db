				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂瑪烏斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "不好意思，研究出了很多問題，我埋頭整理出來的很多推論，都和實驗數據矛盾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110450622,
					"content": "反倒是阿貝多先生憑直覺做出的幾段推演，都契合了後來的事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110450623,
					"content": "實驗能有進展我很高興，所以…呃，也算不上垂頭喪氣吧！阿貝多先生鼓勵過我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "蒂瑪烏斯"
				},
