			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "呼啊…還好沒有失誤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663102,
					"content": "嚇…嚇死我了！還…還滿生猛的，換我也不好對付！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663103,
					"content": "璃月的鬥蟲強者都是無師自通的鬼才嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663104,
					"content": "原來鬼兜蟲之間，是這麼一起玩的嗎？暢暢完全明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "「恐怖貓爪草」"
				},
				{
					"id": 716663105,
					"content": "#{F#妳}{M#你}們有時間的話，可以和暢暢再玩幾局嘛？我也會繼續看{F#妳}{M#你}們玩，好好學一學的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "「恐怖貓爪草」"
				},
				{
					"id": 716663106,
					"content": "看來…「恐怖貓爪草」的天分，的確很恐怖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663107,
					"content": "要是放牛的有這種天分，說不定只是聽著鍋巴和「水晶島梆梆旋風」交流，就能明白甲殼生物的交流方式呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663108,
					"content": "哈…哈哈哈…我也希望自己有那麼強啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
