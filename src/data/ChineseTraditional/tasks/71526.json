			"dialogs": [
				{
					"id": 716663001,
					"content": "鬼兜蟲…也可以當成貓貓狗狗一樣的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "「恐怖貓爪草」"
				},
				{
					"id": 716663002,
					"content": "這次也找來了一個孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663003,
					"content": "唔…不過「花角玉將」也年紀輕輕，我記得上次還有一位小朋友，看來鬥蟲的本領和年齡完全無關嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663004,
					"content": "雖然這位人稱…「恐怖貓爪草」的鬥蟲選手沒有鬥蟲經驗，但她的鬼兜蟲夥伴散發出了極強的氣勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716663005,
					"content": "暢暢不懂你在說什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "「恐怖貓爪草」"
				},
				{
					"id": 716663006,
					"content": "暢暢的鬼兜蟲是爸爸上次帶回來的禮物，是爸爸在旅行中交到的朋友送給他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "「恐怖貓爪草」"
				},
				{
					"id": 716663007,
					"content": "哦喲…看來妳的爸爸很懂行嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663008,
					"content": "那我們這邊就派出「破空白鐵小堇瓜」來參戰，免得像是在欺負人家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663009,
					"content": "哼…怎麼說得我好像是最弱的那個一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663010,
					"content": "不過，你們兩個鬥蟲狂人有可能把握不好輕重，的確應該由我來和她較量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716663011,
					"content": "別緊張哦…這位小朋友，只是遊戲而已，開心就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
