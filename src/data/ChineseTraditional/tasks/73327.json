				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}？！是{F#妳}{M#你}…是{F#妳}{M#你}嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270102,
					"content": "#還有派蒙！真沒想到在這裡遇到{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270103,
					"content": "婕德！！真的是妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270104,
					"content": "哈哈，妳小點聲啦！把我的魚都吵走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270105,
					"content": "嗶嗶——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270106,
					"content": "欸…你們在釣魚嗎？可是怎麼沒有看到魚竿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270107,
					"content": "嗶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270108,
					"content": "#奔奔，不要亂說！好啦…{NICKNAME}，我們聊聊別的話題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270109,
					"content": "妳的魚竿呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "#{F#妳}{M#你}…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270111,
					"content": "它…自己壞掉了…嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270112,
					"content": "唉…我也沒想到釣魚和打獵一點也不一樣…太難了，太難了！我是沒耐心枯坐在這裡半天等魚…還不如自己下河抓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270113,
					"content": "結果魚也沒抓到，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270114,
					"content": "哼，當然抓到了，好大一條，比妳還長…嗯，比妳還長半個奔奔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270115,
					"content": "嗶嗶！嗶嗶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270116,
					"content": "我全都烤來吃掉了，沒妳的份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270117,
					"content": "嗶嗶…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270118,
					"content": "嗯，還有奔奔也吃了喔，只有妳沒份哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270119,
					"content": "我才不信咧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270120,
					"content": "哈哈哈哈！妳不信是妳的損失啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270125,
					"content": "妳最近過得怎樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "嗯？挺好的，不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270127,
					"content": "反正也不是第一次孤身一人旅行啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270128,
					"content": "嗶嗶！嗶嗶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270129,
					"content": "哈哈哈，別急！我知道還有你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270130,
					"content": "自從塔尼特的事情之後，沙漠各部族都不再為我提供帳篷和食物…我沒有部族的保護了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270131,
					"content": "後來嘛…雖然「三十人團」的魯克沙大哥願意接納我，但是…城裡讓我很不自在，讓我想起母親…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270132,
					"content": "所以我告別了須彌城，想著…還是去另一個國家吧，看看此前沒見過的景色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270133,
					"content": "於是，我登上商船，不知不覺就來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270134,
					"content": "再然後嘛…哈哈，沒什麼好講的啦！不管哪裡都需要保鏢嘛，尤其這種商隊來來往往的大城市！所以我的日子過得還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270135,
					"content": "嘿嘿，就這樣吧…就這樣過四海為家的日子也挺好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270136,
					"content": "#我和奔奔，就像{F#妳}{M#你}和派蒙，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270137,
					"content": "哼，奔奔可不如我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270138,
					"content": "嗶嗶！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270139,
					"content": "#哈哈哈，好啦好啦…{NICKNAME}，我就不多留{F#妳}{M#你}們啦。本來還想請{F#妳}{M#你}們一起大吃一頓的，但鏢局的規定…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270140,
					"content": "#咳咳！不說不開心的事情了！給{F#妳}{M#你}一千個擁抱，祝{F#妳}{M#你}接下來的旅途一路平安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270141,
					"content": "#{M#別忘啦，我們的旅途，總有一天會再次交會的！}{F#…之前在塔尼特那邊，我和妳說的話，妳也不要忘記啊。等妳什麼時候累了，想要休息了…我們也許會再次相遇。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270121,
					"content": "沒想到會在這裡遇到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "#嗯…我、我也沒想到會在這裡遇到{F#妳}{M#你}們，真的很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270123,
					"content": "嘿嘿，我們沒打擾妳釣…抓魚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270124,
					"content": "閉嘴啦，小派蒙！就妳話多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "婕德"
				}
			]
		},
