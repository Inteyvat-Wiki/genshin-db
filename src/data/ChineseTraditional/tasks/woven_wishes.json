			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050101,
					"content": "嗯？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050102
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050102,
					"content": "是祭典的廣告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050103,
					"content": "這麼說來，我們來稻妻至今還沒去過這種熱鬧好玩的場合呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050104,
					"content": "綾華是想去祭典嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050105
					]
				},
				{
					"id": 120050105,
					"content": "不、不是這樣的！咳咳…我是說，祭典這種活動在稻妻很是常見，我們社奉行早就習慣了這樣的風俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050106,
					"content": "每逢時節，稻妻的居民都會參加祭典，相對的，維護治安的難度也會增加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050107,
					"content": "所以，祭典固然開心熱鬧，對我們來說卻是一件值得操心的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050108
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050108,
					"content": "啊！都怪我考慮工作，害大家離題了…抱歉，我要去的是旁邊這家店鋪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050109,
					"content": "原來不是要看這個招牌啊，那我們去店裡看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050110,
					"content": "最新款式的衣服，來看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050111
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050111,
					"content": "呀，是神里小姐跟異鄉的客人們！歡迎光臨小倉屋，幾位想買布料還是訂做成衣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050112
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050112,
					"content": "您好，我這邊有份服裝設計圖紙，想勞煩您看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050113,
					"content": "喔喔！掏出了早就準備好的圖紙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050114,
					"content": "我看看…嗯？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050115
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050115,
					"content": "依您之見，這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050116,
					"content": "這是一份非常不錯的設計稿喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050117
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050117,
					"content": "神里小姐是想訂做這樣的著物對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050118
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050118,
					"content": "嗯，麻煩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050119
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050119,
					"content": "您願意來本店訂做服裝，我們小倉屋非常榮幸，不過…有件事有點棘手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050120
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050120,
					"content": "訂做您想要的這件著物，需要用到霓裳花製成的絲綢。稻妻的絲綢大多是從璃月港進口的，但眼下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050121
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050121,
					"content": "唉，您也知道，稻妻正處於鎖國狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050122
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050122,
					"content": "說實話，服裝業受到了不小的影響，我們很難進到高檔布料，成衣訂做的業務也因此擱置了好一陣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050123
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050123,
					"content": "不過，要是客人能自備布料，我們就能幫忙做出衣服喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050124
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050124,
					"content": "意思是需要我們自己去買布？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050125,
					"content": "連小倉屋都弄不到的高檔布料…還有哪裡能買到呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050126
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050126,
					"content": "您可以到萬國商會看看。他們的管道比我們多一些，畢竟都是來自全大陸各地的商販。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050127
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050127,
					"content": "就是價格可能有點貴，但在這樣的非常時期，我想…能買到想要的東西就算不錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050128
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050128,
					"content": "原來在稻妻，訂做衣服也變得這麼麻煩了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050129,
					"content": "說起來，萬國商會就是久利須那邊對吧？我們確實是好一陣子沒去離島了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050130,
					"content": "嗯…看來得到萬國商會走一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050131
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050131,
					"content": "非常感謝，等我們買到布料再回來找您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050132
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050132,
					"content": "在此之前，我還有一個小小的請求，能不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050133
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050133,
					"content": "綾華神秘兮兮的，在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050134,
					"content": "嗯、嗯…沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050135
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050135,
					"content": "那就拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050136
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050136,
					"content": "神里小姐客氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050137
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050137,
					"content": "說真的，我們小倉屋也好久沒做絲綢用料的著物了呢，圖紙又很漂亮…我跟幾位一樣非常期待喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050138
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050138,
					"content": "謝謝您。那我們就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050139
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050139,
					"content": "旅行者，派蒙，我們去萬國商會碰碰運氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
			"id": 1200502,
			"completionStepIds": [
				1200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200506",
							"2"
						],
						"stepId": 1200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利須"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050201,
					"content": "#喂{F#妳}{M#你}們看！久利須會長在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050202,
					"content": "應該就是那位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050203
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050203,
					"content": "嗚嗚，這下可怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050204
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050204,
					"content": "久利須先生，您沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050205,
					"content": "噢、噢噢！您是神里家的…綾華小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050206
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050206,
					"content": "您好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050207,
					"content": "#旅行者也在啊。好久不見，我猜{F#妳}{M#你}最近是離開離島了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050208
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050208,
					"content": "是啊，好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050209
					]
				},
				{
					"id": 120050209,
					"content": "#上次的事真是多謝{F#妳}{M#你}啦，多虧了{F#妳}{M#你}，我們商會的生意才又能周轉起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050210
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050210,
					"content": "欸，話說…你怎麼站在這裡發呆呀，是遇到麻煩事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050211,
					"content": "我…我…唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050212
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050212,
					"content": "說來丟人，我們萬國商會的貨物被浪人搶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050213
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050213,
					"content": "貨物的具體內容是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050214
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050214,
					"content": "是一批高檔絲綢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050215
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050215,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050216
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050216,
					"content": "前些年我們從璃月進了一大批絲綢，一直堆在倉庫裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050217
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050217,
					"content": "最近聽說，稻妻城內各個服裝店積壓的絲綢都賣得差不多了，我們正想著把這批貨提出來賣個好價錢，誰知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050218
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050218,
					"content": "唉！那些浪人一截下我們的貨，就立刻帶著東西逃到樹林裡去了。我想報案，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050219
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050219,
					"content": "您也知道，我們這種外國商販本就不受待見。「勘定奉行」的人一點都不想搭理我們，甚至巴不得我們倒楣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050220
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050220,
					"content": "雖然我個人也不怎麼認可「勘定奉行」的行事作風，但久利須先生，這裡畢竟是稻妻，請注意您的發言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050221
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050221,
					"content": "噢，抱歉，忍不住就抱怨了起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050222
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050222,
					"content": "現在也沒有更好的辦法，單憑我們商會，恐怕是沒法追回貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050223
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050223,
					"content": "唉，或許這就是註定的破財之災吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050224
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050224,
					"content": "雖然不能走公務流程，但我可以幫您找回丟失的貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050225
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050225,
					"content": "當然當然，您…哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050226
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050226,
					"content": "哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050227,
					"content": "這樣真的沒關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050228
					]
				},
				{
					"id": 120050228,
					"content": "嗯。不過，雖然是以個人身分出面處理這次的事，但我的一言一行，多少都會關係到社奉行與神里家的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050229,
					"content": "我有一些顧慮，所以…希望您能為我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050230
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050230,
					"content": "另外，人生在世，誰都不能保證遇到困難時會有人對自己出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050231,
					"content": "以您和萬國商會的立場，我建議…平日還是多加小心，以免蒙受不必要的損失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050232
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050232,
					"content": "一定、一定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050233
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050233,
					"content": "可是，這樣會不會給您個人帶去麻煩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050234
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050234,
					"content": "萬一勘定奉行的大人們對您有什麼意見…您在民間聲望很高，犯不著為了我們這種小人物蒙受損失啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050235
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050235,
					"content": "您說笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050236
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050236,
					"content": "怎麼說我也是神里家的大小姐。單憑勘定奉行的各位，應該還沒有資格追究我的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050237
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050237,
					"content": "嗚哇，好有氣勢的發言！這就是貴族大小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050238,
					"content": "久利須先生，請您將貨物被劫的時間、地點以及搶劫者的特徵告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050239
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050239,
					"content": "太感謝了，太感謝了！時間是兩個小時之前，事發地點是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050240
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050240,
					"content": "各位，請隨我到事發地點進行調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050241
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050241,
					"content": "好，出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
