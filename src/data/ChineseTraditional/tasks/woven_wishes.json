				},
				{
					"id": 120050402,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050403,
						120050404
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050403,
					"content": "不愧是綾華。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050405
					]
				},
				{
					"id": 120050405,
					"content": "#不不…{F#妳}{M#你}過獎了，我只是完成應盡之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050406
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050406,
					"content": "#神里小姐，旅行者，{F#妳}{M#你}們沒有受傷吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050407
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050407,
					"content": "不用擔心，我們沒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050408
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050408,
					"content": "那些浪人匆忙地逃走了，看起來什麼都來不及帶走。所以我想，您丟失的貨物都在這裡了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050409
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050409,
					"content": "謝謝您、謝謝您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050410
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050410,
					"content": "清點一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050411,
					"content": "六、八、十…沒錯，確實都在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050412
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050412,
					"content": "太好啦，我們快點購買絲綢吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050413,
					"content": "購買絲綢？莫非，幾位需要用到我這裡的貨物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050414
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050414,
					"content": "實不相瞞，是這樣沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050415,
					"content": "別誤會，幫你忙是順帶的！就算你丟的是胡蘿蔔呀高麗菜之類的東西，我們應該還是會出手相助的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050416,
					"content": "我都覺得我們運氣不錯了呢，要是晚一步，或許真就無法買到絲綢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050417,
					"content": "幾位…實在是感激不盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050418
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050418,
					"content": "不說那麼多了，幾位是需要絲綢對吧？我這就挑一匹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050419
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050419,
					"content": "麻煩您了，一共多少錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050420
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050420,
					"content": "您是我的恩人，怎麼能收恩人的錢啊！我送給您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050421
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050421,
					"content": "不不，該是多少錢就是多少錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050422,
					"content": "商人行商也有難處，如派蒙所說，我幫您絕非是要佔您的便宜。這些貨物，請您按正常的價格出售給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050423
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050423,
					"content": "也不必覺得為難，今天這片樹林裡什麼事都沒有發生，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050424,
					"content": "是啊，我們只是來散步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050425
					]
				},
				{
					"id": 120050425,
					"content": "#各位…我、我無以為報，這次真是太感謝了！{F#妳}{M#你}們的恩情，我會一直牢牢記在心中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050426
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050426,
					"content": "東西還得送回商會裡，幾位，我先失陪了。之後要是有什麼需要，儘管來萬國商會找我久利須就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050427
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050427,
					"content": "嗯，也謝謝您的絲綢，久利須先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050428
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050428,
					"content": "再見——！路上小心，別再被人搶了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050429,
					"content": "#旅行者，剛才謝謝{F#妳}{M#你}出手幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050430,
						120050431
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050430,
					"content": "我答應會幫妳了嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050432
					]
				},
				{
					"id": 120050432,
					"content": "不過，那群浪人似乎不認識妳呢，是因為這些人沒有資格見到神里家的大小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050433,
					"content": "或許是吧。對我來說是件好事，畢竟，我也不希望今天的事被太多人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050434
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050434,
					"content": "嘿嘿，像妳這樣的大人物居然會主動幫久利須，人真好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050435,
					"content": "那個…請不要這麼誇我，我只是做了任何人都會做的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050436
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050436,
					"content": "以我的立場，出手幫他確實有點怪異。可是這些與身分、階層無關…我只是作為我自己，幫助了一個遇到困難的普通人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050437
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050437,
					"content": "我想，這也許是因為，我心底深處並不認為一個民生遭到阻礙的社會可以被稱為絕對的「正確」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050438
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050438,
					"content": "#啊！抱歉，跟{F#妳}{M#你}說了些閒話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050439
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050439,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050440
					]
				},
				{
					"id": 120050440,
					"content": "我們回小倉屋，把這匹來之不易的絲綢交給店主吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050441
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050441,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050431,
					"content": "沒什麼，小事一樁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050432
					]
				},
				{
					"id": 120050404,
					"content": "真可靠呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050405
					]
				}
			]
		},
