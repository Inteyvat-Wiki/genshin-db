					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051001,
					"content": "太好了！唔，除了絲綢，其他材料本店應該都有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051002
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051002,
					"content": "我去清點材料，很快就好，各位，請先在這裡稍等片刻喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051003
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051003,
					"content": "一定要有喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051004,
					"content": "希望這次不缺什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051005
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051005,
					"content": "#說起來，旅行者，其實我一直想幫{F#妳}{M#你}也添置一套新衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051006
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051007,
					"content": "謝謝妳，我這樣就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051008
					]
				},
				{
					"id": 120051006,
					"content": "#只是…不知道{F#妳}{M#你}習不習慣稻妻的特色服飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051007
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051009,
					"content": "這身衣服對我來說具備特殊意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051010,
					"content": "專注外表的話，會讓我的劍變鈍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051008,
					"content": "哎？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051009,
						120051010
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051011,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051012
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051012,
					"content": "果然，優秀的旅行者都有一套自己的行事準則與著裝風格呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051013
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051013,
					"content": "出門在外，很多事也是不得已呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051015,
					"content": "沒有這麼小的尺寸吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051016
					]
				},
				{
					"id": 120051014,
					"content": "不過，我倒是很想試試看稻妻的特色服裝喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051016,
					"content": "什麼嘛，想做的話還是可以做的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051018,
					"content": "綾華，妳太客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051019,
					"content": "派蒙跟我都這樣就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051017,
					"content": "#哈哈哈，{F#妳}{M#你}們的交流真可愛…咳！不、不是，我是說，如果派蒙想要，我可以找人幫妳訂做衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051018,
						120051019
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051020,
					"content": "這樣啊…好的，那就按旅行者說的來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051021
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051022,
					"content": "會穿得非常奇怪喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051023
					]
				},
				{
					"id": 120051030,
					"content": "會穿得非常講究喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051031
					]
				},
				{
					"id": 120051021,
					"content": "說起來，其他國家的人一般都會穿什麼風格的衣服呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051022,
						120051030
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051023,
					"content": "對對，什麼樣子都有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051024,
					"content": "戴著兜帽的、臉上掛著半片面具的、穿得像孔雀的、露出一截肚子的、衣服特別緊身的…沒有不可能，只有妳想不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051025,
					"content": "真的嗎？完全沒有標準，全憑喜好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051026
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051026,
					"content": "哇，真不錯…不知為什麼，有點嚮往…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051027
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051027,
					"content": "莫非妳也想穿奇怪的衣服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051028,
					"content": "不不，怎麼會！我只是…只是很佩服那些隨心所欲的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051029
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051029,
					"content": "真想走遍七國，看看別人過著怎樣的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051031,
					"content": "對對！每個國家各有特色，典雅、高貴、隨性…雖然各不相同，卻又都符合各自特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051032
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051032,
					"content": "著裝是門非常高深的學問，我也還在努力學習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051033
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051033,
					"content": "能讓衣服襯托自身氣質，成為自己身體的延伸…是一件非常棒的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051034
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051034,
					"content": "所以，我並不討厭打扮喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051035
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051035,
					"content": "我懂我懂，確實是這樣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051036,
					"content": "派蒙這麼可愛，穿什麼衣服都會很可愛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051037
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051037,
					"content": "嗚哇——！我被誇了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051038,
					"content": "久等啦，我這邊清點完畢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051039
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051039,
					"content": "有勞您了，還缺什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051040
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051040,
					"content": "好消息，用料全齊！尺寸是…就按圖上的來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051041
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051041,
					"content": "對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051042
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051042,
					"content": "明白了，這就為您安排。價格一共是…這個數！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051043
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051043,
					"content": "請您收下。可以的話，希望能加急些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051044
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051044,
					"content": "剛好最近也沒有其他急件，我們這就著手開始製作。不過，製作衣物需要一定時間，幾位可以稍後過來取貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051045
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051045,
					"content": "在此之前，請找個地方休息休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051046
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120051046,
					"content": "我也這麼想，我們去別處轉轉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051047
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051047,
					"content": "當然，關於這點，我已經提前考慮到了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051048
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051048,
					"content": "接下來，我想帶旅行者和派蒙去餐館用餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051049
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051050,
					"content": "剛好我也餓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051051
					]
				},
				{
					"id": 120051049,
					"content": "喔喔喔！要開飯啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051050
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051051,
					"content": "哼哼，地點是我精心挑選的一家臨街餐館——「木南料亭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051052
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051052,
					"content": "比起過於高檔令人拘謹的高級食堂，我認為那種自在的氛圍更適合我們今天的行程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051053
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051053,
					"content": "那麼我們現在過去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051054
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120051054,
					"content": "嗯嗯，我等不及啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
