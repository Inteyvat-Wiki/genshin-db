			"dialogs": [
				{
					"id": 120050301,
					"content": "小偷，站住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050302,
					"content": "哈？就帶這麼幾個人來，還想把東西拿回去嗎？別做夢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050303
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050303,
					"content": "竟然理直氣壯地說出這種話…你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050304
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050304,
					"content": "有什麼不敢？喂你，我問你，你是別國來的商人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050305
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050305,
					"content": "萬國商會，不就是在稻妻地盤上腆著臉皮苟且偷生的蛀蟲而已嘛！有人保護你嗎？誰要為你出頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050306
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050307
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050307,
					"content": "哈哈哈哈！連自己的立場都不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050308
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050308,
					"content": "在這個稻妻，你們這些無依無靠的商販任人宰割才是常態吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050309
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050309,
					"content": "…可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050310
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050310,
					"content": "喂！外國佬，你想做筆交易嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050311
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050311,
					"content": "交易？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050312
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050312,
					"content": "用錢把這些布料買回去，怎麼樣？總比頭破血流地離開這裡好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050313
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050313,
					"content": "真是欺人太甚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050314,
					"content": "我…唉！算我倒楣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050315
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050315,
					"content": "稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050316,
					"content": "久利須先生，請不要付錢給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050317,
					"content": "可、可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050318
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050318,
					"content": "還記得我們的協議嗎？您守口如瓶，我也會完成答應您的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050319,
					"content": "啊對，對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050320
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050320,
					"content": "那麼請您退到安全的地方，並保護好自身安全。接下來…是我實現承諾的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
