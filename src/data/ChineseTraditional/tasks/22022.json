			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭爾瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "這個食譜的搭配應該是這樣才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220102,
					"content": "妳在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "我正在整理食譜呢，呃…但有些食譜還是記不太清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220104,
					"content": "直接問旭東就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "旭東…我之所以記不清那些食譜，大部分原因就是他成天搞的那些「創意料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220109,
					"content": "每次他拿到新食譜之後，頂多只會按照那些食譜記錄的方法做一兩天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220110,
					"content": "然後，他就會開始…用各種方法「改造」那些食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220111,
					"content": "他為什麼要這麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "據他說，是為了讓那些菜的成本變便宜什麼的…但我是不太清楚他為什麼這麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220118,
					"content": "但不管怎麼說，從結果上來看，他也確實把那些菜改造成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220119,
					"content": "味道和原版的菜大致相同，但製作成本卻低得離譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220120,
					"content": "我之所以會願意和他同行，也是因為他這種離譜的烹飪手法。而他之所以願意接納我，應該也是看中了我的技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220121,
					"content": "所以，妳想讓我幫什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "啊…喔！對，光顧著說旭東的事了，差點忘了正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220128,
					"content": "因為旭東成天都在拉著我改造那些食譜，還直接在那些食譜上寫寫畫畫…有些食譜的配方都亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220129,
					"content": "為了能有個正經的對照物，我還是想要把那些食譜準確地復原出來，然後存檔一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220130,
					"content": "#旅行者，如果{F#妳}{M#你}記得那些食譜的話，能幫我回憶一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220131,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "#那就拜託{F#妳}{M#你}了，我先把那些亂掉的食譜整理一下，{F#妳}{M#你}稍微幫我修正一下不清楚的地方就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220132,
					"content": "我可是吃遍提瓦特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "妳的技術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "我之前沒和你說過嗎？我在教令院的研究課題是「萬能調味料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220125,
					"content": "簡單來說，就是一種只要加入菜裡，無論什麼菜都能變得美味的超級調味料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220126,
					"content": "為了研究出這種調味料，我才外出遊學搜集各種美食的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220127,
					"content": "咳，說遠了，我們還是接著說食譜的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220113,
					"content": "他實際上是怎麼改造的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "嗯…他的改造方法還不同於其他廚師，其他廚師改造食譜，大多是讓食譜變得更加豐富，讓做出來的菜能賣更多錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220115,
					"content": "但旭東改造那些食譜的時候，卻似乎有著另一種完全不同的改造原則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220116,
					"content": "比如他用馬鈴薯、蘑菇…還有另外一些廉價的蔬菜食材做了一道素菜，但是吃的時候，卻是香嫩椒椒雞的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220117,
					"content": "還有用馬鈴薯、稻米、蓮蓬、絕雲椒椒、麵團和獸肉做的簡易版「仙跳牆」，口感和味道居然都和原版差不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220106,
					"content": "你們不是「全能美食隊」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "#拜託{F#妳}{M#你}不要再重複這個名字了，我的論文裡絕對不會出現這五個字的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220108,
					"content": "再說了，我之所以記不清那些食譜，大部分原因也就是旭東成天搞的那些「創意料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "芭爾瓦涅"
				}
			]
		},
