			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭爾瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "蒙德有一道「北地蘋果燜肉」，旭東這傢伙又在亂寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220202,
					"content": "「奶油略貴，獸肉難儲，不如揉和麵團，洗出麵筋，再將麵筋入屜蒸熟，佐以蔬果調味，入口亦有肉感。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220203,
					"content": "這傢伙，奶油哪裡貴了，獸肉直接去買新鮮的不就好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220204,
					"content": "#算了…旅行者，我想問{F#妳}{M#你}的是，這道「北地蘋果燜肉」的原料，除了蘋果、奶油和獸肉之外，還有一項材料是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220205,
					"content": "杏仁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "唔…是這樣嗎？我先記一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220206,
					"content": "胡椒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "唔…是這樣嗎？我先記一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 220220208,
					"content": "絕雲椒椒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "火腿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
		{
