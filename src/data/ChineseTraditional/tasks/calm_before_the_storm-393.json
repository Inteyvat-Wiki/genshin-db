			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3930101,
					"content": "我在想，一切結束以後，我要把這些都寫進歌裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930102,
					"content": "這段時間還真是發生了很多事啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "嗯，這首歌也會像《溫妮莎傳奇》一樣，被蒙德的人們傳唱下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930105,
					"content": "我從小就很喜歡那首歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930106,
					"content": "#那麼，{NICKNAME}…{F#妳}{M#你}今天狀態如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930107,
					"content": "我已經調整到了最佳狀態，一定能成為各位的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3930108,
					"content": "琴團長真可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "說起來，迪盧克老爺也陪我們一路走到了最後呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930111,
					"content": "明明當初只是不小心被捲進來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930112,
					"content": "的…呃…路人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930113,
					"content": "你們向我分享了秘密，我不過是報以相同的信任而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3930114,
					"content": "迪盧克老爺的理由，是「信任」啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "然後，琴團長的理由，是「責任」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930116,
					"content": "那麼，賣唱的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930121,
					"content": "是「自由」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930122,
					"content": "自由…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930123,
					"content": "#{F#妳}{M#你}們來蒙德時，有沒有人對{F#妳}{M#你}們說過，蒙德是「自由之都」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930124,
					"content": "安柏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "啊哈哈，那也是個自由自在的孩子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930126,
					"content": "蒙德是一座沒有「國王」統治的浪漫城邦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930127,
					"content": "而蒙德的國民，是七國中最自由的國民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930128,
					"content": "我希望，曾經守護蒙德的龍也一樣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930129,
					"content": "不該有人欺騙牠，說「這座城市背叛了你」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930130,
					"content": "也不該有人告訴牠，說「守護這座城市是你永恆的義務」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930131,
					"content": "他有選擇自己生活方式的權利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930132,
					"content": "溫迪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930133,
					"content": "#那麼，{NICKNAME}，蒙德的千年流風與{F#妳}{M#你}同在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930134,
					"content": "#接下來我會像上次一樣，為{F#妳}{M#你}引導「風」的元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3930135,
					"content": "你說「上次」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#原來如此！難怪{NICKNAME}說你的聲音很熟悉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930136,
					"content": "我就知道，那時的聲音果然是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "琴團長的理由，是「責任」啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "嗯，迪盧克老爺的理由，是「信任」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930119,
					"content": "那麼，賣唱的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3930120,
					"content": "那麼溫迪呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "放心，我也狀態滿滿！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "和溫迪也快變成老搭檔了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
}