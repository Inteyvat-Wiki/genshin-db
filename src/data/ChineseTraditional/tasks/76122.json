			"dialogs": [
				{
					"id": 761220201,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761220202,
					"content": "努昂諾塔！真的是水靈靈的努昂諾塔！我還以為再也見不到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220203,
					"content": "剛才的畫作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "我們用月光為這孩子勾勒出了形體，我在其中注入了新的力量與賜福，讓它再度誕生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220205,
					"content": "現在的它無須承載我的靈魂，它擁有獨屬於它自己的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220206,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761220207,
					"content": "啊，它飛過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220208,
					"content": "#嗯，我喚醒了它與{F#妳}{M#你}們共度時光裡的所有記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220210,
					"content": "……！……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761220211,
					"content": "嗚，太好了努昂諾塔，今後我一定會對你更加好一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220212,
					"content": "沒想到是這個驚喜…我好喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220213,
					"content": "謝謝妳，哥倫比婭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "沒什麼，能再次見到努昂諾塔，我也很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220216,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761220217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220218,
					"content": "（她還是那麼中意努昂諾塔，但她的神情和從前相比又有不同。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "（好像它之於她不僅是被創造的眷屬，更是熟悉的朋友。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "#去吧，你一定很想{M#他}{F#她}們了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220221,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761220222,
					"content": "#隨時歡迎{F#妳}{M#你}們再來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
