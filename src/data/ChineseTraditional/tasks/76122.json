			"dialogs": [
				{
					"id": 761220101,
					"content": "哥倫比婭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220102,
					"content": "咦？奇怪，剛剛好像聽到了哥倫比婭的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220103,
					"content": "…嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220104,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220105,
					"content": "#{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220106,
					"content": "不好不好，又被妳嚇了一大跳，妳在的話怎麼不早說嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220107,
					"content": "#我想{F#妳}{M#你}們已經熟悉這種遊戲了，所以這次適當增加了一點難度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220108,
					"content": "可惡，下次我也要找機會嚇妳一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220109,
					"content": "好啊，那我期待著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220110,
					"content": "哥倫比婭妳的眼罩呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "哦，似乎是剛才和月靈們玩耍的時候，被它們蹭掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220112,
					"content": "我平時也不用睜眼，這樣沒什麼差別。它們喜歡的話，就讓它們拿著玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220113,
					"content": "話說回來，哥倫比婭不打算多去外面走走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220114,
					"content": "妳不需要再躲著誰了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "嗯…現在時間很多，想什麼時候動身都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220116,
					"content": "#但想到{F#妳}{M#你}們或許會來找我，不告而別的話，可能會讓{F#妳}{M#你}們擔心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220117,
					"content": "這種時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "是啊是啊，只要讓我們知道妳沒事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220120,
					"content": "好的，那我會考慮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220121,
					"content": "只是考慮而已啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220122,
					"content": "說不定哥倫比婭就是喜歡這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "在這裡發生的事，對我來說都是愉快的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220124,
					"content": "#不過，我在這等{F#妳}{M#你}們還有另外一個原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220125,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220126,
					"content": "#我想給{F#妳}{M#你}們一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220118,
					"content": "留張紙條就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
