				"points": []
			},
			"dialogs": [
				{
					"id": 200090101,
					"content": "旅行者，這裡，過來這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090102,
					"content": "#別驚動了那些丘丘人，{F#妳}{M#你}怎麼總是直挺挺地往營地裡面衝呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090103,
					"content": "算了，不管這些了，我一直在研究丘丘人的語言，但是比起記錄，我更想要研究口語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090104,
					"content": "好不容易在這裡遇見了一個完整的丘丘人營地，我可不能放過這個機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090105,
					"content": "#所以，旅行者，{F#妳}{M#你}能和我一起去這營地裡面，找個丘丘人來練習口語嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				}
			]
		},
		{
			"id": 2000902,
			"completionStepIds": [
				2000903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
