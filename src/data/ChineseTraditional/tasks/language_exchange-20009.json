			"dialogs": [
				{
					"id": 200090401,
					"content": "#還好有{F#妳}{M#你}在，不然我都不知道怎麼收場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090402
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090402,
					"content": "我覺得我沒說錯什麼地方呀，到底是哪裡的發音出問題了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090403
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200090403,
					"content": "我回去得再好好研究一下…",
