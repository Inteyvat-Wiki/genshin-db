			"trigger": {
				"objectNames": [
					"小露米埃爾"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3445.134,
							449.586,
							4432.195
						],
						"pointId": 340100504
					}
				]
			},
			"dialogs": [
				{
					"id": 746750101,
					"content": "美好的一天，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750102
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750102,
					"content": "#出名到{F#妳}{M#你}們這種程度，應該不斷會有人向{F#妳}{M#你}們遞名片吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750103
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750103,
					"content": "#唔…你認識我們？{NICKNAME}，這個孩子好老成哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746750104,
					"content": "僅僅因為年紀尚輕就輕視別人，是無知者才會犯的毛病，我想兩位不至於如此膚淺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750105
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750105,
					"content": "儘管我無意自誇，但我和兄長是這裡小有名氣的映影導演，大家更習慣稱呼我為小露米埃爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750106,
						746750107
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750106,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				},
				{
					"id": 746750108,
					"content": "#沒錯，我對{F#妳}{M#你}們的冒險經歷很有興趣。在我們這行，非凡的故事永遠都會受到追捧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750109
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750109,
					"content": "#既然{F#妳}{M#你}們還不認識我，那我就先做個自我介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750110
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750110,
					"content": "#我和我的兄長已經合作拍攝映影很久了，也有過幾部比較出名的映影，或許{F#妳}{M#你}們有看過《工廠大門》…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750111
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750111,
					"content": "沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750112
					]
				},
				{
					"id": 746750112,
					"content": "哦，沒關係，那《進站》呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750113
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750113,
					"content": "也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746750114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750115
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750115,
					"content": "啊，這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750116
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750116,
					"content": "…那也不足為奇，我們兄弟作為映影人的道路還很長，以後會拍出更多家喻戶曉的映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750117
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750117,
					"content": "映影的製作從構思故事、演員表演、攝影師和導演合作拍攝，再到處理成片，都是相當有趣的過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750118
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750118,
					"content": "在這其中，我認為拍攝過程是最具有技術性的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750119
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750119,
					"content": "拍攝重點的取捨決定了觀眾將得到怎樣的資訊、感受到怎樣的氣氛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750120
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750120,
					"content": "雖然旁白也很重要，但我們不能指望只靠旁白來構成一個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750121
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750121,
					"content": "四段鏡頭！我一直相信，只要四段鏡頭就可以構成一個最小的敘事單位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750122
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750122,
					"content": "在這四個鏡頭之內，天才可以創造奇蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750123
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750123,
					"content": "兩位想試試看嗎？藉這個機會，來感受一下映影的魅力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750124
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750124,
					"content": "那我們該怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746750125,
					"content": "#很簡單。我可以為{F#妳}{M#你}們提供一些已經成形的短篇情節作為拍攝主題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750126
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750126,
					"content": "重點是嘗試鏡頭與旁白的多種處理方式，從而完成幾部短篇映影的拍攝，兩位有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750127
					],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750127,
					"content": "聽起來很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750128
					]
				},
				{
					"id": 746750128,
					"content": "太好了！那麼兩位準備好之後，隨時可以前往我挑好的拍攝地點嘗試拍攝，我也會針對拍攝好的成片給予意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小露米埃爾"
				},
				{
					"id": 746750107,
					"content": "你也要給我們名片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				}
			]
		}
	]
}