			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746860101,
					"content": "#{F#妳}{M#你}好啊，大冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860102
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860102,
					"content": "請稱我為大剪輯師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860103
					]
				},
				{
					"id": 746860103,
					"content": "請稱我為廣告高手！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860104
					]
				},
				{
					"id": 746860104,
					"content": "#哈哈，看起來製作廣告片沒讓{F#妳}{M#你}覺得太無聊！還好，不然我就要自我懷疑了——是不是拿寶貴的相聚時間做了無趣的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860105,
					"content": "畢竟我們不是一直都有時間碰面，要找一位在全世界旅行的冒險家，這個難度沒有比把星星從天上扯下來低多少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860106
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860106,
					"content": "#有的時候就像現在，在咖啡廳裡都會碰到{F#妳}{M#你}，有的時候，就算到處向人打聽{F#妳}{M#你}在哪裡也沒人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860107
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860107,
					"content": "#好處是每次見到{F#妳}{M#你}都絕對能聽到跌宕起伏的新故事，永遠不會無聊，壞處是不知道哪一次和{F#妳}{M#你}見面就會變成最後一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860108,
						746860109
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860108,
					"content": "沒這麼糟吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				},
				{
					"id": 746860110,
					"content": "哈哈，好吧，我也覺得自己再抱怨下去，就要變成公益廣告裡的獨居老人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860111
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860111,
					"content": "手頭的廣告片都完成得差不多了，接下來我該為拍出下一部長篇繼續焦頭爛額了。我們不見面的時候，就各自為夢想努力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860112,
					"content": "我會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860113
					]
				},
				{
					"id": 746860113,
					"content": "啊，但我還是要說，有空記得找我吃飯！不在楓丹也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860114
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860114,
					"content": "獵鹿人、萬民堂、蘭巴德酒館之類的…去野炊或打獵也可以考慮…只要我還跟得上…總而言之，保持聯絡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746860109,
					"content": "我會常常找你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				}
			]
		}
	]
}