	"talks": [
		{
			"id": 7365001,
			"completionStepIds": [
				7365001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365001",
							"2"
						],
						"stepId": 7365001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賈米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736500101,
					"content": "完蛋啦，唉…我的學術生涯還沒開始，就已經夭折了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500102
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500102,
					"content": "當什麼學者！當什麼學者！早知道在教令院偷偷自學畫畫當個會畫彩圖的繪圖師，也比現在有前途，呵呵…呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500103
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500103,
					"content": "之前就聽說奧摩斯港有個教令院學者每天唉聲嘆氣的…我還以為是什麼奇怪的傳說呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500104,
					"content": "原來真的有，「唉聲嘆氣教令院學者」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500105,
					"content": "嗯，什麼？什麼「唉聲嘆氣教令院學者」…是說我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500106
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500106,
					"content": "#唉…要是以前我非得就這個外號和{F#妳}{M#你}理論一番，現在就算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500107
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500107,
					"content": "小傢伙，哪來的就回哪去吧，別打擾一個前途渺茫的失志青年。像我這樣的人就應該縮回森林最陰暗的角落當個蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500108
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500108,
					"content": "這樣至少不會浪費教令院的學術資源…啊，說不定還有可能被當作什麼特殊的蘑菇樣品，被採集回來供真正有才能的學者解剖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500109
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500109,
					"content": "「作為實驗樣本的蘑菇賈米」，呵呵，說不定還能用這樣的方式留名研究史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500110
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500110,
					"content": "賈米…你的名字叫賈米嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500111,
					"content": "是啊，怎麼了，小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500112
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500112,
					"content": "我才不是什麼小傢伙呢，我的名字叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500113,
					"content": "#我的名字是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500114
					]
				},
				{
					"id": 736500114,
					"content": "#{NICKNAME}和派蒙，好吧，我記住了，兩位有什麼事嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500115
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500115,
					"content": "我們只是聽說了最近奧摩斯港有「唉聲嘆氣教令院學者」的傳言，所以想知道發生了什麼事而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500116,
					"content": "#唉…{F#妳}{M#你}們知道，對於須彌的眾學者而言，有一件美妙的事，其名曰：「發表研究」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500117
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500117,
					"content": "只要可以獨立「發表研究」，就能被證明是獨當一面的學者，從導師那裡畢業，正經進入學術界，贏得聲望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500118
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500118,
					"content": "這樣就可以以外出取材為由到提瓦特各地旅行，還可以用下發的主題經費吃香喝辣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500119
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500119,
					"content": "吃香喝辣，那個，吃香喝辣的部分說得更詳細一些嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500120,
						736500121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500120,
					"content": "噫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500122
					]
				},
				{
					"id": 736500122,
					"content": "只、只是口頭說一說啦，我內心其實充滿了想要在須彌學術界有所作為的宏大理想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500123
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500123,
					"content": "吃香喝辣啦，四處去旅行啦，變得有名啦，諸如此類的，只是我不怎麼排斥的附帶的部分…咳咳，說遠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500124
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500124,
					"content": "總之就是，我現在就卡在「發表研究」這一環，教令院各種課程本來時間就緊湊，還要在規定的時間內通過提案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500125
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500125,
					"content": "結果光提案就被否決了兩次，第一次我說我想做「蕈豬背部蘑菇的食用價值」，唉，這多好的題目啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500126
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500126,
					"content": "聽起來是需要反覆進行實驗的好主題呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500127,
					"content": "對吧，結果我的導師說什麼「這有什麼好研究的！」就否決了…真是莫名其妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500128
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500128,
					"content": "第二次我說我想研究「浮游水蕈獸的生態環境與養殖」，結果又被導師否決了，說我胸無大志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500129
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500129,
					"content": "眼看提案報告的時間就要過去了，我就賭氣寫了個大的…當時就覺得「啊，該死的老頭子，居然敢說我胸無大志！」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500130
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500130,
					"content": "本來只是賭氣，結果主題提上去當天就被導師通過，還在學院內獲得一致好評，呵呵…騎虎難下，我的主題正式變成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500131
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500131,
					"content": "變成了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500132,
					"content": "呵呵…變成了「生物結構在對敵應激時的防禦缺陷研究」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500133,
						736500134
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500133,
					"content": "對敵應激，什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500135
					]
				},
				{
					"id": 736500135,
					"content": "聽不懂，但是聽起來是又不好吃又不好玩的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500136,
					"content": "研究課題就是要稍微故弄玄虛一點啦，實際上就是在戰鬥中的生物，多多少少都會露出一些防禦上的「破綻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500137
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500137,
					"content": "比如原本保護得很好的弱點部位，在進行一些動作的時候就會暴露出來…類似這樣的，就是我需要收集的「破綻」的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500138
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500138,
					"content": "雖然不是很明白，不過聽起來好像是個很厲害的主題呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500139,
					"content": "厲害有什麼用，又要戰鬥，又要拍攝下素材作為研究論據，唉，我只是個柔弱的學者…也太強人所難了一點吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500140
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500140,
					"content": "我要怎麼完成這個主題啊…唉，沒完成主題，就沒辦法畢業，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500141
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500141,
					"content": "算了，不就是去找那些魔物搏鬥嗎？呵呵…乾脆我受個重傷，說不定導師看在我可憐的份上也會讓我通過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500142
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500142,
					"content": "這可不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500143,
					"content": "唉…提案也交了，根本沒有換主題的時間，還能怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500144
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500144,
					"content": "身為學者，居然被一時衝動左右，不如餵長鬢虎算了…啊，不過那樣有點痛，不如去維摩莊附近跳河吧，那裡河水清涼乾淨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500145
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500145,
					"content": "嗚哇，好可憐…雖然有自作自受的成分，但是還是好可憐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500146,
					"content": "#{NICKNAME}，我們就幫幫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500147,
					"content": "話都說到這份上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500148
					]
				},
				{
					"id": 736500148,
					"content": "欸，真、真的嗎？這可是很危險的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500149
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500149,
					"content": "沒問題的！而且說起戰鬥，我們可是老手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500150,
					"content": "#…真的，我的主題有救了，嗚嗚，如果能夠成功完成報告，把我自己賣給{F#妳}{M#你}都可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500151
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500151,
					"content": "沒必要那麼誇張！而、而且我們也不想要你啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500152,
					"content": "不好意思有些激動了，那這樣，我們這就去之前準備的試驗場地吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500134,
					"content": "什麼…防禦…缺陷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500135
					]
				},
				{
					"id": 736500121,
					"content": "動機不純呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500122
					]
				}
			]
		},
		{
			"id": 7365002,
			"completionStepIds": [
				7365002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365002",
							"2"
						],
						"stepId": 7365002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賈米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736500201,
					"content": "沒想到居然走到這麼遠的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500202,
					"content": "這也沒有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500203
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500203,
					"content": "離奧摩斯港的距離也太遠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500204,
					"content": "畢竟也跟實驗對象有關，雖然我的導師很希望我把全提瓦特所有生物都觀察一遍，但是那怎麼可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500205
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500205,
					"content": "所以就從須彌和璃月分佈的開始研究起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500206
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500206,
					"content": "喔，對了，請拿好這個…這是我為了研究弄來的特殊藥劑，能夠在實驗場地裡生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500207
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500207,
					"content": "其名為「溢神劑」！是阿彌利多學院的前輩做出來的藥劑，造價高、工序複雜，我好不容易才做了這麼一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500208
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500208,
					"content": "嗯？這個藥劑和你的實驗有什麼關係呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500209,
					"content": "其實是這樣，服用了「溢神劑」之後，服用者就會主觀地覺得時間變得非常非常…非常非常慢，幾乎和停了一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500210
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500210,
					"content": "這樣就能更仔細地拍攝和觀察啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500211
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500211,
					"content": "咦，有了這樣的藥劑，你自己也可以做這個實驗嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500212,
					"content": "唉…我本來也是這麼以為的，但是事情哪有那麼簡單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500213
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500213,
					"content": "#我已經說了，是「主觀上」變得非常慢…{F#妳}{M#你}的身體的反應其實還是跟不過來的，身體如果不夠靈敏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500214
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500214,
					"content": "#比如{F#妳}{M#你}在棘冠鱷飛撲過來的時候喝下「溢神劑」，但是{F#妳}{M#你}又沒有反應能力躲避牠的飛撲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500215
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500215,
					"content": "#{F#妳}{M#你}就會看到它的爪子離{F#妳}{M#你}的臉始終有那麼近，像是停在那裡…但身體就是沒辦法躲開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500216
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500216,
					"content": "#「為什麼身子不動呀！」{F#妳}{M#你}這麼想，但是沒有用，爪子還是離那麼近，{F#妳}{M#你}甚至可以看清爪子上的汙水與淤泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500217
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500217,
					"content": "噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500218,
					"content": "所以，不要因為主觀上覺得時間過得慢就輕敵了，這點請注意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500219
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 736500219,
					"content": "我會小心的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500220
					]
				},
				{
					"id": 736500220,
					"content": "唉…我的研究，就交給兩位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈米"
				}
			]
		}
	]
}