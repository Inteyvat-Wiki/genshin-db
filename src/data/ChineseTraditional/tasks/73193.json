			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "#{F#妳}{M#你}能夠使用草元素力？難道我碰上神之眼持有者了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930902,
					"content": "好久沒見過這樣的人了，真讓人懷念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930903,
					"content": "賽芭小姐，賽芭小姐，這樣就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731930904,
					"content": "沒錯，而且直接使用草元素力的話，它們應該很快就能發芽，我們等等看吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930905,
					"content": "慢慢地，幾根細弱的幼芽從土坑裡鑽了出來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "展開幾片綠葉後，幼芽不再生長。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#發芽了發芽了，我就說嘛，{NICKNAME}什麼都能做好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731930908,
					"content": "#果然立刻就看到效果了，感謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930909,
					"content": "可惜沒有開花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "啊，這是很自然的事，不能著急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930911,
					"content": "#植物總要經歷發芽、抽枝、結苞、開花這樣的生長階段，{F#妳}{M#你}能那麼快就讓種子發芽，已經很厲害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930912,
					"content": "多給薔薇點時間，讓它們繼續汲取些養分再開花吧，這樣對它們也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930913,
					"content": "況且今天的事已經讓我很感激了，再麻煩兩位就太不禮貌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "賽芭"
				},
				{
					"id": 731930914,
					"content": "#以後{F#妳}{M#你}們空閒的時候，能來看看它們就很好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽芭"
				}
			]
		}
	]
}