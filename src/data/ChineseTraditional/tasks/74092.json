			"dialogs": [
				{
					"id": 740920101,
					"content": "為什麼…為什麼會這樣…可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920102,
					"content": "克洛妮艾小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}！{F#妳}{M#你}來了，太好了…{F#妳}{M#你}…至少{F#妳}{M#你}還知道真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920105,
					"content": "克洛妮艾小姐，妳冷靜一點，妳…妳怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920106,
					"content": "就算…就算我的報導沒辦法登上報紙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920107,
					"content": "妳的報導怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "嗯，我們還在想什麼時候才會看見妳的報導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920109,
					"content": "#沒看到…沒看到，對，對…{F#妳}{M#你}們應該沒看到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920110,
					"content": "妳怎麼…一副慌張的樣子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "事情是這樣的…自從那天從楓丹科學院回來之後，我就開始著手編撰文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920112,
					"content": "我把所有我看見的、我聽見的、我感受到的全都如實寫了上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920113,
					"content": "比如，楓丹科學院並沒有完全清除始基礦，反而重新啟動了另一項和始基礦有關的專案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920114,
					"content": "一個艾德溫曾經的部下被派去探索楓丹科學院廢墟，但卻在爆炸中喪生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920115,
					"content": "楓丹科學院高級技官雷蒙多拒絕承認他的身亡，並且堅持那些爆炸本就在計畫內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920116,
					"content": "還有廢墟裡那個失控的大機器、被汙染的水體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920117,
					"content": "所有楓丹科學院想要隱瞞的事情，我全部寫進文章裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920118,
					"content": "但是…就在我遞交了這篇報導後，卻被告知楓丹科學院對我發起了訴訟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920119,
					"content": "按照報社規定，我所有和楓丹科學院有關的報導文章都必須接受「可信度審查」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920120,
					"content": "那一篇對楓丹科學院的報導，也被撤了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920121,
					"content": "可信度審查？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "不，這種審查並非是針對某篇報導，而是針對於我這個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920124,
					"content": "簡單來說，楓丹科學院控告我因為利益衝突，而將主觀情緒代入了報導事務，向大眾傳達了錯誤資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920125,
					"content": "但…妳和楓丹科學院有利益衝突嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "克洛妮艾小姐只是拍了幾張畫片，裡面全是爛石頭和不會動的大機器…這有什麼「利益衝突」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740920127,
					"content": "天哪，妳洩露他們的道德水準了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "他們…指控我洩露了最新型的楓達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920129,
					"content": "楓丹科學院的人堅稱我之前在廢墟中所拍的畫片，有一部分涉及到了新型楓達的設計方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920130,
					"content": "他們必須檢查每一張畫片。在那之前，楓丹科學院不會解除訴訟，我也要一直接受可信度審查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920131,
					"content": "我很確定，這就是楓丹科學院為了阻止我刊登報導而採取的手段…但我不會放棄的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920132,
					"content": "來，拿好！這份報紙是我自己偷偷去印的，等會我就出去把這些報紙散發出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920133,
					"content": "我一定要讓所有人都知道真相和楓丹科學院的真面目，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920134,
					"content": "克洛妮艾小姐！您怎麼還在這裡，我找您好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 740920135,
					"content": "天哪！有人過來了，我不能再待在這裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920136,
					"content": "#這份報紙給{F#妳}{M#你}，一定要收好，我把所有的真相都寫在上面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "克洛妮艾"
				},
				{
					"id": 740920137,
					"content": "按照規定，您現在必須去複律庭接受每天的例行審查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 740920138,
					"content": "欸！您別跑啊，克洛妮艾小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 740920139,
					"content": "只不過是楓達而已，說不定是場誤會！只要解釋清楚就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 740920140,
					"content": "等等！請等等啊，克洛妮艾小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "繆妮"
				},
				{
					"id": 740920122,
					"content": "報社認為妳的報導不可信嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "妳在這裡做什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}