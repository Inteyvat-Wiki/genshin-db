						722391902
					]
				},
				{
					"id": 722391902,
					"content": "光明藏於你我之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391903,
					"content": "呼——我快都忘了，有多久沒有聽到這句話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391904,
					"content": "#告訴我，好同志，誰派{F#妳}{M#你}來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391905,
					"content": "須婆達之彥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "斯巴達克老師？！是老師嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391907,
					"content": "他在哪裡？我只知道他在動亂裡被太陽之子的黨羽抓住了。之後就再也沒有他的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391908,
					"content": "他被關在蛇心之地的祭壇…以他的狀態恐怕出不來了，所以拜託我們來尋找你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391909,
					"content": "該死的太陽之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391910,
					"content": "老師讓你們來有什麼吩咐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391911,
					"content": "大叔只讓我們傳句話啦，他說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391912,
					"content": "孩子們，永遠不要放棄，白夜國的希望就在你們之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391913,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391914,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391915,
					"content": "對不起…對不起！老師，我們讓您失望了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391916,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "反抗軍已經不存在了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391918,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391919,
					"content": "老師被抓走之後，反抗軍的骨幹基本上全軍覆沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391920,
					"content": "只剩我們這些平時跟隨老師的學生，因為遠離事件中央而逃過一劫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391921,
					"content": "之後我們這些倖存者逃到了之前準備的藏身處裡，希望能夠重新聚集起力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391922,
					"content": "我們當中本來有傑出的謀士、有專業的學者、有優秀的術士，還有可靠的醫生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391923,
					"content": "聽起來很有希望的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391924,
					"content": "我們也是這樣想的，只要給我們時間，我們就能重新組織起有生力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391925,
					"content": "但這些需要資金…開展任何活動都要資金，我們什麼都有，就是沒有錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391926,
					"content": "最後有人提出了建議——販賣龍骨花凝珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391927,
					"content": "龍骨花凝珠是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "是龍骨花在特殊情況下結出的一種果實，十分罕見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391929,
					"content": "它會產生一種讓人神清氣爽的香氣，使焦慮歸於平靜，憂患一掃而空。所以在市場上價值很高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391930,
					"content": "真的有這麼神奇嗎？不會是騙人的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391931,
					"content": "如果只是神奇就好了…愚鈍的我，最初沒有看清這裡面的危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391932,
					"content": "我已經不記得配方是從哪裡得到的了，只知道，這東西確實給我們帶來了很多資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391933,
					"content": "一切都在往好的方向發展…可慢慢地，我發現我的一些戰友們，居然開始迴避衝突，拒絕戰鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391934,
					"content": "這些人愈來愈多，到了後面，甚至還向我請願，要脫離我們的隊伍，而我根本挽留不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391935,
					"content": "怎麼會這樣？是不是因為賣凝珠賺到太多錢了，就不想打仗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391948,
					"content": "#{F#妳}{M#你}說是金錢的腐蝕嗎？不…我…我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391949,
					"content": "我只知道，當不甘壓迫的人們變得滿足，反抗就無法繼續下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391936,
					"content": "崩塌從那時就開始了，而且無可挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391947,
					"content": "我有時甚至在想，這東西的配方，會不會就是那些卑鄙的大人故意流傳給我們的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391950,
					"content": "這東西的暢銷，會不會也是那些卑鄙的大人一手捏造的假像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391937,
					"content": "唉，如果是老師，他會怎麼處理這種局面呢，會不會在最開始就把一切扼殺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391938,
					"content": "對不起老師，我們沒能成為希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391939,
					"content": "很遺憾聽到這件事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "我無顏面對我的老師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391942,
					"content": "#但無論如何，還是感謝{F#妳}{M#你}們帶來了老師的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391943,
					"content": "#我沒有別的東西能夠感謝{F#妳}{M#你}，如果不介意的話，請讓我把龍骨花凝珠的秘密告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391944,
					"content": "生產它的特殊條件就是必須用常夜靈川——也就是忘川的水來澆灌龍骨花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391945,
					"content": "#也許{F#妳}{M#你}們可以拿去換點金錢，或者自己留著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391946,
					"content": "#但不論如何，希望{F#妳}{M#你}們保護好自己向前的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391940,
					"content": "你希望再去見一見你的老師嗎?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
