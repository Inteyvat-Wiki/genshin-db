			"dialogs": [
				{
					"id": 722392401,
					"content": "（墓石上的字分為兩排，其中，第一排以白夜國文寫就，無法辨認。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "一塊古老的石碑"
				},
				{
					"id": 722392402,
					"content": "（第二排為通用文字，上面寫著：）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "一塊古老的石碑"
				},
				{
					"id": 722392403,
					"content": "「義士斯巴達克，今稱『須婆達之彥』，之憑弔處。以下為其罪詔之翻譯。望參觀諸君謹記歷史。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "一塊古老的石碑"
				},
				{
					"id": 722392404,
					"content": "「賊子須婆達之彥，興大罪之師，動國之根基。今奉常世大神諭，抉其目，菹其魂，羈幻之重獄，永生永世。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一塊古老的石碑"
				}
			]
		}
	]
}