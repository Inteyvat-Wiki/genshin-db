					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "#{F#妳}{M#你}們…{F#妳}{M#你}們是誰？{F#妳}{M#你}們的聲音有熟悉的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390302,
					"content": "欸？這麼快把我們忘了…大叔的狀況已經這麼差了嗎？好擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390303,
					"content": "謝謝，我們真的認識嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390304,
					"content": "我們剛剛才見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "啊，我想起來了…在這裡靈魂會被磨損，我的記憶衰退太嚴重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390307,
					"content": "抱歉，我…唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390308,
					"content": "#{F#妳}{M#你}們找到了有用的資訊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390309,
					"content": "你的名字是須婆達之彥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "須婆達之彥…須婆達之彥，沒錯！我就是反抗軍的首領，斯巴達克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390313,
					"content": "所以須婆達之彥和斯巴達克，都是大叔的名字嗎？不愧是首領大叔啊，連名字都有兩個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390314,
					"content": "#感謝{F#妳}{M#你}們找回了我的名字，我好像還想起了一些別的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390316,
					"content": "「黑暗來自太陽之後，光明藏於你我之中。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390317,
					"content": "這是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "這是我們反抗軍的秘密口令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390319,
					"content": "找回了名字，記憶也逐漸回來了。這應該就是我們的暗號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390320,
					"content": "#現在，讓我把孩子們的藏身處告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390321,
					"content": "有什麼需要我帶話的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "讓我想想，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390323,
					"content": "把我的話帶給他們，讓他們永遠不要放棄，白夜國的希望就在他們之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390324,
					"content": "你希望我帶他們回來見你嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "不，永遠不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390326,
					"content": "我們唯一的優勢，就是敵明我暗，而且所有白夜之民的心都和我們在一起。不要輕易暴露自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390327,
					"content": "更何況，現在我已經不能記住他們每個人的名字了。甚至連自己的名字都已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390328,
					"content": "把我的話帶過去，請他們永遠不要放棄，白夜國的希望就在他們之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390329,
					"content": "如果他們已經不在了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "不會的。只要操縱太陽之子的骯髒大人們還存在一天，他們就一直在。而反抗也會一直繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390331,
					"content": "把我的告誡帶給他們，請他們永遠不要放棄，白夜國的希望就在他們之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390332,
					"content": "這樣就已經足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390310,
					"content": "你的名字是賊子須嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "哎呀，不是賊子須，是須婆達之彥啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390305,
					"content": "我們剛剛在尋找你的身分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
