			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"須婆達之彥",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "孩子們，永遠不要放棄，希望就在你們之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390102,
					"content": "是你們嗎？孩子們，你們成功了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390103,
					"content": "#不，不是…我感覺到了，{F#妳}{M#你}們不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}，他好像個目盲之後被留影的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390105,
					"content": "#不論{F#妳}{M#你}是什麼人，請幫幫我！幫我找到孩子們，我有話要告訴他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390106,
					"content": "可是，你是誰呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "我…我的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390108,
					"content": "我…忘記了我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390109,
					"content": "我只記得…我曾為白夜國站了出來，為了希望戰鬥過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390110,
					"content": "我至今仍然是反抗軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390111,
					"content": "可是在白夜國這樣的地底國家，你在反抗什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390112,
					"content": "當然是廟堂之上汙穢的貴人們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390113,
					"content": "他們號稱接收著神明的旨意，嘴上打著神明的旗號，做的事卻只為滿足他們的低劣欲望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390114,
					"content": "表面上是太陽之子們的監護者，實際上就是國家的統治者，本質上卻是趴在人民身上吸食血肉的蟲豸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390115,
					"content": "他們必須要被消滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390116,
					"content": "這些記得這麼清楚，卻連自己的名字都忘記了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390117,
					"content": "那是因為他們的手段就是這麼殘忍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390118,
					"content": "因為上次的失敗，他們抓住了我，將我囚禁在這處祭壇裡折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390119,
					"content": "這是一個惡毒的囚牢，我能感覺到，我的靈魂被碾磨，有珍貴的東西在流失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390120,
					"content": "#善良的人啊，我懇求{F#妳}{M#你}，趁我還記得這些，請去幫我找到孩子們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390121,
					"content": "告訴他們，永遠不要放棄，希望就在他們之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390122,
					"content": "孩子們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "有一批願意跟隨我的青年人，他們很聰明。他們是我的學生，也是我們的後備軍。我把他們看作是我的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390124,
					"content": "邪惡的大人們想盡各種辦法要撬開我的嘴，讓我交代孩子們的情報，我不可能開口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390125,
					"content": "因為我知道，希望就在他們之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390126,
					"content": "現在這個時間點，他們應該都不在了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390127,
					"content": "不，不會的！他們都是好孩子，一樣懷揣著理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390128,
					"content": "我都沒有放棄…他們一定還在堅持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390129,
					"content": "應該如何找到他們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "我肯定記得，這種事我肯定記得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390131,
					"content": "#我告訴{F#妳}{M#你}他們的藏身處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390132,
					"content": "但是如果找到了他們，要怎樣說明來意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390133,
					"content": "「我們是一位忘記名字的反抗軍大叔派來的」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390134,
					"content": "#不，這還不夠，我把他們教得很好。除非{F#妳}{M#你}們能夠證明自己，否則他們絕對不會信任{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390135,
					"content": "但我現在卻連名字都想不起來了，可惡啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "須婆達之彥"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}，這位大叔看起來曾經是白夜國的重犯。怎麼說也是個歷史裡能留名的級別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390137,
					"content": "他的線索應該不難找到吧，說不定附近就有。我們可以先找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390138,
					"content": "如果在歷史裡留下名字，我希望這名字讓我們事業的後繼者來書寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "須婆達之彥"
				}
			]
		},
