				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "#{F#妳}{M#你}們終於回來了，絕雲間之行成果如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031802,
					"content": "…原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031806,
					"content": "並沒有見到所有仙人…按他們的話說就是「無緣得見」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031807,
					"content": "沒關係！最近如果有空的話，再去碰碰運氣也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031808,
					"content": "#而且，降魔大聖的情報已經很珍貴了。作為回禮，我也有情報提供給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031809,
					"content": "對於神祇之死，璃月七星的反應，十分耐人尋味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031810,
					"content": "他們對外宣稱，由於尚未尋獲真凶，不允許任何人瞻仰「仙祖法蛻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031811,
					"content": "甚至還試圖封鎖消息…但畢竟請仙典儀人來人往，即使七星也難以禁絕流言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031812,
					"content": "仙祖法蛻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031813,
					"content": "以璃月的常識而言，岩王帝君也是一位仙人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031814,
					"content": "岩神是契約之神，同時也被稱作眾仙之祖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031815,
					"content": "如今的所有「三眼五顯仙人」，當年都曾立下守望璃月的契約。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031816,
					"content": "這樣啊…難怪他們對璃月的事這麼在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031817,
					"content": "沒錯，他們既有責任，也有資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031818,
					"content": "——如果掌管璃月的七星出了問題，他們就有興師問罪的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031820,
					"content": "這對我也是很大的麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "我也不能接受這種做法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "岩神靈魂升入高天，留下的軀殼，為何會被七星藏匿？實在可疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031822,
					"content": "啊！沒錯，我們本來就是來找那位神靈的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031823,
					"content": "如果璃月七星把「仙祖法蛻」藏起來、不讓人接近的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031824,
					"content": "#{NICKNAME}想要尋訪全部七神的目標，就會完全落空了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031826,
					"content": "與你無關。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "無可奉告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "#喔？{F#妳}{M#你}們正在尋訪七神？是為了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031828,
					"content": "嘿…不錯的回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031829,
					"content": "輕易被「愚人眾」套話的騎士，可不是一位好騎士，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031830,
					"content": "#不過…這一次，我還是可以幫助{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031831,
					"content": "咦？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031832,
					"content": "給我一點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031833,
					"content": "一點時間…用來找人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031834,
					"content": "#我會為{F#妳}{M#你}找到，能夠突破這僵局的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031835,
					"content": "啊…真有意思。佈局階段壓抑得越平靜，最終爆發出的混亂就越激烈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031836,
					"content": "為了親眼目睹暗流的決堤，一定要堅持到活著與我再相見哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
