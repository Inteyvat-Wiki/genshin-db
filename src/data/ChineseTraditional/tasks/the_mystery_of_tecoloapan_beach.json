						],
						"pointId": 9971
					},
					{
						"sceneId": 3,
						"position": [
							-2606.36,
							-668.697,
							8537.296
						],
						"pointId": 9972
					},
					{
						"sceneId": 3,
						"position": [
							-2604.116,
							-668.697,
							8534.72
						],
						"pointId": 9973
					}
				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "#啊，終於…異邦的勇士啊，若不是{F#妳}{M#你}相助，恐怕此處早已被漆黑的大敵佔據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "虛弱的大靈顯化身"
				},
				{
					"id": 750761202,
					"content": "…許久之前，此處的部族住民受到漆黑大敵顯化的造型蠱惑，諸多夜魂亦被深淵糾纏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "虛弱的大靈顯化身"
				},
				{
					"id": 750761203,
					"content": "受封之處，即便是夜之化身的力量也被一點點蠶食…此處的封印隔絕了外界，也隔絕了部族之人信念的來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "虛弱的大靈顯化身"
				},
				{
					"id": 750761204,
					"content": "唯有揭開封印，才有一戰之力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "虛弱的大靈顯化身"
				},
				{
					"id": 750761205,
					"content": "#多謝{F#妳}{M#你}啊，異邦的勇士…夜魂得以回歸迷夢的故土，避免汙穢的瘤癭佔據夜神的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "虛弱的大靈顯化身"
				},
				{
					"id": 750761206,
					"content": "啊，終於可以回歸夜的靜謐之處了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "虛弱的大靈顯化身"
				}
			]
		}
	]
}