			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩卡烏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "海上的迷霧最近愈加深重了，啊…真是讓人憂心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760404,
					"content": "難道那個傳說是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760405,
					"content": "什麼傳說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "#呃…啊，這就要看異邦的勇士{F#妳}{M#你}要聽什麼樣的傳說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760407,
					"content": "關於海面上浮島與巨大塗鴉的故事，有兩個來由，一個更像故事，一個更像真實的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760402,
					"content": "#異邦的勇士，{F#妳}{M#你}想要聽哪一個呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760408,
					"content": "關於故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "嗯，更像故事的總是比較浪漫啦…迷霧浮島中塗鴉的來源，是《奎伊露和烏庫庫的故事》這個中的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760403,
					"content": "據說名叫奎伊露的少女為了與她的太陽父親聯絡，而在那海濱之處留下了巨大的塗鴉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760410,
					"content": "她的太陽父親在天上看到塗鴉，於是將她從地上接走…大致上就是這樣的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760417,
					"content": "那看起來令人不安的迷霧，據說是太陽父親給予地上部族民的懲罰，因為部族民奪去了他女兒的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760415,
					"content": "唉，不管是傳說還是故事，迷霧自海上升起都不是什麼吉兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760416,
					"content": "異邦的勇士啊…那裡現在說不定很危險，一定要小心，最好不要靠近啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760411,
					"content": "關於真實的傳說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "關於真實的傳說嘛…據說很久以前，有很邪惡的巫師扮作大靈的樣子，蠱惑了部族的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760413,
					"content": "後來，部族的勇士們不得不用巨大的塗鴉，將那個黑漆漆的邪惡巫師關在塗鴉的封印之下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "薩卡烏"
				},
				{
					"id": 750760414,
					"content": "海面之所以會變成這個樣子，據說就是因為邪惡的巫師會突破封印，從封印中跑出來為非作歹的預兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "薩卡烏"
				}
			]
		},
