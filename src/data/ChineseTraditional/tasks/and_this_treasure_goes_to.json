						],
						"stepId": 7155512,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "#謝謝{F#妳}{M#你}們，我還以為我徹底完了…這幫盜寶團應該是一直在跟蹤我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551002,
					"content": "我對這片遺蹟的研究剛剛有了進展，想著要是能挖出埋藏在這裡的寶藏帶回去就再好不過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551003,
					"content": "但是還沒等我做好準備，盜寶團就闖進營地，把我給綁起來帶到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551004,
					"content": "他們還一直逼問我寶藏的下落，還威脅我說，如果我不把寶藏地點說出來，他們就要了我的命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551005,
					"content": "不過我知道，要是我直接把寶藏的線索告訴了他們，那我才是真不要命了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551006,
					"content": "唉，我果然該聽索拉雅小姐的話，考古學家最好別太在意寶藏，只要有學術上的收穫就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551007,
					"content": "但是我的經費就這麼一點，光是幾篇論文，連我自己掏的來往路費都填不平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551008,
					"content": "也不知道索拉雅小姐是怎麼做到一個人在璃月研究這麼久的，光是看她被拒的那麼多論文，我都替她覺得累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551009,
					"content": "那妳接下來打算怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "還能怎麼辦，學術上的資料我已經搜集齊了，寶藏什麼的…就算了，就讓給你們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551011,
					"content": "雜七雜八的推導過程我就不說啦，總之，寶藏就埋在靈矩關最中間的那棵<color=#00E1FFFF>金色大樹下</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551012,
					"content": "你們要的話就去拿吧，我把地址寫下來給你們，免得你們忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551013,
					"content": "我休息一下就回營地收拾東西，我要盡快離開這，免得又有盜寶團過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551014,
					"content": "不知道從這裡走去望舒客棧要花多長時間，別等我到瞭望舒客棧，索拉雅小姐已經走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 715551015,
