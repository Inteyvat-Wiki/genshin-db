			"dialogs": [
				{
					"id": 721570101,
					"content": "這…「鎮石」在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721570102,
					"content": "嘖，果然沒這麼簡單啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570103,
					"content": "還是四處找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "沒辦法了，我們四處找找看，看有沒有相關的線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570105,
					"content": "這裡這麼大，得找到什麼時候啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721570106,
					"content": "呵呵，那就得看我們的運氣了，總之先開始找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570107,
					"content": "看來…「如何找到鎮石」也是我們封印「鎮石」時需要解決的問題之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570108,
					"content": "希望解決這個問題的線索，就在這周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570109,
					"content": "大祐，不要浪費時間了，快點動起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721570110,
					"content": "好、好的，悅子小姐…也只能這樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				}
