					}
				]
			},
			"dialogs": [
				{
					"id": 733540101,
					"content": "燈光的色調和強度恰到好處，特效也相當華麗，綜合表現的效果堪稱完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540102
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540102,
					"content": "太棒了，薩費伊，多虧了你，我們才能將花之騎士傳說中的英姿重現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540103
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540103,
					"content": "唉呀呀，又不是我一個人的功勞，你跑前跑後，比我這個只管書面工作的文職累多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540104
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540104,
					"content": "現在最重要的問題是花之騎士的人選…需要演員擁有非凡身手，氣質又與傳說中的法里斯相似，條件似乎有些苛刻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540105,
						733540106
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540105,
					"content": "你們在聊什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				},
				{
					"id": 733540107,
					"content": "燈光？特效？你們在為演出的事煩惱嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540108,
					"content": "出現了！絕無僅有的大英雄，花之騎士扮演者的無上人選…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540109
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540109,
					"content": "不，應該說您就是當之無愧的花之騎士本尊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540110
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540110,
					"content": "#噫，這個學者好激動！一看到{NICKNAME}，眼睛都亮起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540111,
						733540112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540111,
					"content": "欸呀，沒那麼誇張啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540113,
					"content": "#咳咳，很榮幸再次遇見您，{NICKNAME}{M#先生}{F#女士}，這位是伐護末那學院的民俗學者薩費伊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540114
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540114,
					"content": "最近他趁著「花神誕祭」的熱潮，根據各種歷史文獻和民間傳說，結合楓丹的新技術，設計了一部映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540115
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540115,
					"content": "這部映影的重點是「花之騎士不為人知的戰鬥」，主要在描繪那位騎士為草神大人深入神秘幽邃的險境，斬除邪惡勢力的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540116
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540116,
					"content": "等等，我好像可以猜到了…你們是不是沒有擅長戰鬥的演員，拍不了戰鬥的橋段？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540117,
					"content": "#嚴格說來，無論文戲還是打戲，都沒有比{NICKNAME}{M#先生}{F#女士}更適合的演員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540118
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540118,
					"content": "#要是{NICKNAME}願意參演，這部映影有可能成為須彌歷史上最出色的花之騎士藝術作品，上映後的收入相當樂觀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540119
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540119,
					"content": "當然，絕不會在分成上虧待兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540120
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540120,
					"content": "#嘿嘿，{NICKNAME}的形象，是該這麼有人氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540121,
					"content": "我們算是在「花神誕祭」度假，這段時間不怎麼忙啦。拍幾段戲的空閒應該是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540122,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540123,
						733540126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540123,
					"content": "演戲我不在行，戰鬥我很專業。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540124
					]
				},
				{
					"id": 733540124,
					"content": "您願意參演真是太好了，我們就只拍戰鬥戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540125
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540125,
					"content": "同時，我們會以您的儀容為準，重新設計劇中花之騎士的形象，調整文戲演員的妝髮和服裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540129,
					"content": "#事不宜遲，要是{NICKNAME}{M#先生}{F#女士}準備好了，我們就直接開始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540130
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 733540130,
					"content": "#好，為了{NICKNAME}的大明星形象，還有花之騎士的熱血傳說，開演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733540126,
					"content": "打戲簡簡單單，文戲可以試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540127
					]
				},
				{
					"id": 733540127,
					"content": "您願意參演真是太好了，我們感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540128
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540128,
					"content": "不過文戲和打戲的拍攝是分開的，前者要另定時間，到時候可能還要麻煩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "薩費伊"
				},
				{
					"id": 733540112,
					"content": "說得好，再誇一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540106,
					"content": "好像遇到難題了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				}
			]
		}
	]
}