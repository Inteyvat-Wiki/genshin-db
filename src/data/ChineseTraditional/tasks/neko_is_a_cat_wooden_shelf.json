					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "喵喵喵，那個木頭架子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722090302,
					"content": "已經修好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "喔！真是不錯，這樣子神社也更像樣了，喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722090304,
					"content": "汝再去和那兩個綠色的人類說一聲吧，告訴他們，那個架子已經修好了，他們可以去掛小木塊了。然後，也可以讓其他人類來神社，然後塞錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722090305,
					"content": "妳為什麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "那、那個綠色的，高高的人類很可怕，他很瞭解貓的心思…可以輕而易舉地看穿奴家，喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722090307,
					"content": "而且奴家每次和他說話的時候，他都很激動…喵喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220905",
							"2"
						],
						"stepId": 7220905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大祐",
					"悅子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "#喔，{F#妳}{M#你}好，旅行者，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090402,
					"content": "繪馬架已經修好了喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "#欸？是{F#妳}{M#你}修好的嗎？{F#妳}{M#你}還真是熱心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090404,
					"content": "是代宮司大人的委託。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "#是、是寢子大人親自委託{F#妳}{M#你}的嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090406,
					"content": "難道是寢子大人注意到了我們的行動了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090407,
					"content": "也不完全是啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "悅子小姐！我們去繪馬架那邊看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090410,
					"content": "先是塞錢箱，然後是繪馬架…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090411,
					"content": "這位代宮司大人，是認真想要整修這個神社嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090412,
					"content": "但是，這周圍的居民已經在很久之前都全部遷移走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090413,
					"content": "換句話說，現在這座島上除了我們之外，已經沒有人會來神社參拜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090414,
					"content": "悅子小姐，妳想說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090415,
					"content": "那位代宮司大人，到底有沒有意識到這件事呢？她整修這座神社的目的又到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090416,
					"content": "…抱歉，也許是我多疑了。去繪馬架那邊看看應該也沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090417,
					"content": "但總之，提高警惕總沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090418,
					"content": "悅子小姐，寢子大人只是一隻貓啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090408,
					"content": "這麼說也沒錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
