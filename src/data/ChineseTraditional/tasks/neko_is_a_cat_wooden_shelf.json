			"dialogs": [
				{
					"id": 722090201,
					"content": "那個繪馬架看起來已經壞了很久了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090202,
					"content": "你在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "喔，旅行者。我和悅子小姐正在這神社周圍做調查呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090204,
					"content": "雖然這神社裡的各個設施都破落得不成樣子了…但這些設施還真是齊全啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090205,
					"content": "附近村裡的人都會來這裡參拜吧。看來神社的荒廢，或許和越石村廢村也有關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
