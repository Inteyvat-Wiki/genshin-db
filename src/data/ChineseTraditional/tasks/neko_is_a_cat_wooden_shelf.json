				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "#這繪馬架修得還真不錯…{F#妳}{M#你}手藝可真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090502,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "不過這上面的繪馬…已經完全看不清楚了，到底是過了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090505,
					"content": "悅子小姐！妳看，我從旁邊找到了幾塊木板，削了幾塊…呃…繪馬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090506,
					"content": "既然這繪馬架已經修好了，當然要在上面掛繪馬啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090507,
					"content": "悅子小姐，妳有什麼願望嗎？我可以幫妳畫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090508,
					"content": "在這個神社裡掛繪馬啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090509,
					"content": "呵呵，感覺還真奇妙…把繪馬給我，我來畫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722090510,
					"content": "他們似乎已經在準備掛繪馬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090511,
					"content": "我們回去告訴寢子吧，她一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090503,
					"content": "一點小手藝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
