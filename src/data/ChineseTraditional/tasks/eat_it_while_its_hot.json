			},
			"dialogs": [
				{
					"id": 205210201,
					"content": "#嗯？{F#妳}{M#你}來這裡做什麼，{F#妳}{M#你}也是正在探索雪山嗎？",
					"roleType": "TALK_ROLE_NPC",
