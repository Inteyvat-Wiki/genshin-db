			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "這份「白醬時蔬燴肉」給妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "#是哈里斯讓{F#妳}{M#你}送過來的吧，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210303,
					"content": "吃慣了這種好菜，之後要啃乾糧的時候，說不定我還吃不慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210304,
					"content": "哈哈哈，開玩笑的，既然我是一名冒險家，那該吃苦的時候還是會吃苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210305,
					"content": "妳還會繼續向前走嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "那是當然，這個營地只是做中轉用，等到了合適的時候，我會試試在更前面一些地方設立營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210307,
					"content": "到時候，肯定就沒機會吃到熱菜熱飯了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210308,
					"content": "不過，我也不會貿然前進，再觀察一段時間，我就會回大本營了，等制定了詳細計畫之後再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210309,
					"content": "#謝謝{F#妳}{M#你}專門送這份菜給我，這些東西就當做是報酬了，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
