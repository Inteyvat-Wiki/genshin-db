	"talks": [
		{
			"id": 7152101,
			"completionStepIds": [
				7152101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7152101",
							"2"
						],
						"stepId": 7152101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴特洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715210101,
					"content": "下一幅畫是…嗯，是這一幅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210102
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210103
					]
				},
				{
					"id": 715210103,
					"content": "#您是…{NICKNAME}，久仰大名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210104
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210104,
					"content": "我聽許多同事提起過您，還心想著您會不會來參加這場盛會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210105
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210105,
					"content": "結果，我還真在這裡遇見您了，真是太榮幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210106
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210106,
					"content": "我有很多東西想為您介紹，但在那之前，容我先做個自我介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210107
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210107,
					"content": "我叫巴特洛，是一位畫家…您對畫家這職業應該不陌生，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210108
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210108,
					"content": "但我除了畫家的這個身分之外，還是一名「畫作修復師」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210109
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210109,
					"content": "無論一幅畫作遭到了何種創傷…比如被火燒啦，被老鼠咬啦，或者是發霉腐爛之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210110
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210110,
					"content": "只要到了我手裡！這幅畫都會被復原為它原本最完美的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210111
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210111,
					"content": "修復畫作…是照著原樣畫一遍嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210112
					]
				},
				{
					"id": 715210112,
					"content": "哈哈哈！當然不是。如果只是按照原畫重新畫一遍，那只能叫做「臨摹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210113
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210113,
					"content": "我們要做的，是將畫作修復成它最原本的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210114
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210114,
					"content": "無論是顏色、筆觸…甚至是畫布的材料。任何細節，都必須和這幅畫原有的一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210115,
						715210116
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210115,
					"content": "真複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				},
				{
					"id": 715210117,
					"content": "是的！修復畫作需要高超的繪畫技巧，還有極其精細的畫面認知力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210118
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210118,
					"content": "這也是…我根本就招不到多少幫手的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210119
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210119,
					"content": "如果一個畫家同時具有高超的繪畫技巧，和極其精細的畫面認知力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210120
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210120,
					"content": "那他為什麼不直接自己畫畫，而是跑來幫助人家修復畫作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210121
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210121,
					"content": "更別說修復畫作這項工作既不賺錢，又容易被外人覺得我們只是一群只會依樣畫葫蘆的粗劣畫師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210122
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210122,
					"content": "不過，每一種工作都需要有人來承擔，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210123
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210123,
					"content": "畫是一種很珍貴的事物。一幅優秀的畫作可以承載歷史、故事、情感…還有市場的商業價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210124
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210124,
					"content": "無論外人怎麼看，作為一名畫家，我絕不能看著那些畫白白損毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210125
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210125,
					"content": "…但就像我之前說的那樣，這工作既不賺錢，又遭人誤解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210126
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210126,
					"content": "雖然我一直在努力招募人手，但是到現在還是只有我一個人在做這項工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210127
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210127,
					"content": "我這次之所以來這裡，也是想要將我的工作宣傳給大家，也許這樣就能招到更多的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210128
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210128,
					"content": "但是…人手還沒招募到，我又接到了許多請我修復的古畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210129
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210129,
					"content": "這些畫作來自蒙德和璃月，畫面內容有山水、人物、走獸…甚至…兒童蠟筆畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210130
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210130,
					"content": "蠟筆畫你也修復？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210131
					]
				},
				{
					"id": 715210131,
					"content": "呃…正確來說，只要是畫作，就可以委託我來修復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210132
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210132,
					"content": "況且那幾幅兒童蠟筆畫也包含著那幾位小朋友的心血，說不定這就是他們邁向藝術道路的第一步呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210133
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210133,
					"content": "所以，他們的父母來委託我修復…也無可厚非吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210134,
						715210136
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210134,
					"content": "你怎麼滿臉無奈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210135
					]
				},
				{
					"id": 715210135,
					"content": "什麼？不！我才沒有無奈！我只是…只是…需要去學習一下蠟筆繪畫的知識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210138,
					"content": "#{NICKNAME}，如果您願意的話，能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210139
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210139,
					"content": "#{F#妳}{M#你}也看到了，這裡就我一個人…但為了修復畫作，我必須得去周圍取景才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210140,
						715210141
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210140,
					"content": "還要取景？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210142,
					"content": "唉…是啊！除了取景之外，我還要去找各種和這幅畫作有關的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210143
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210143,
					"content": "比如這幅畫中的景物在成畫年代的模樣，畫中的動物形態究竟是如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210144
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210144,
					"content": "還好，目前我手頭急需修復的畫作的成畫時間距今不長，景物應該沒有什麼變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210145
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210145,
					"content": "我正準備去外面取景，但您也知道…野外十分危險，並不適合我這種只會拿畫筆的人前去冒險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210146
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210146,
					"content": "所以…我想請您幫我去野外取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210147
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210147,
					"content": "我不擅長畫畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210148
					]
				},
				{
					"id": 715210148,
					"content": "不用擔心！我都幫您準備好了…之前我請人幫我去外面取景的時候，也是這麼做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210149
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210149,
					"content": "您看，這是一幅待修畫作的留影畫片，裡面有幾個關鍵的景物…我已經標出來給您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210150
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210150,
					"content": "您只需要前往這個景物的所在地，用留影機替這些景物留個影，一切就完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210151
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210151,
					"content": "所以，我只要幫忙留影就好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210152
					]
				},
				{
					"id": 715210152,
					"content": "沒錯，但在留影之前，您可得好好看看這些畫作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210153
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210153,
					"content": "感受這些畫作中所包含的美學和藝術感…讓這些畫作停留在您的腦海裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210154
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210154,
					"content": "只要完全理解了這些畫作，您在留影的時候，說不定就能感受到這幅畫成畫的全過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210155
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210155,
					"content": "草稿、線稿、上色、修飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210156,
						715210157
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210156,
					"content": "這不就是幻覺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210158,
					"content": "您這句話說得沒錯，在我看來藝術就是一種…幻覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210159
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210159,
					"content": "而藝術家要做的，正是精準地抓住這種幻覺，並將它客觀呈現出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210160
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210160,
					"content": "相信我，只要您仔細觀察我給您的畫片，一定能感覺到這幅畫裡蘊含的「藝術幻覺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210161
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210161,
					"content": "#總而言之，這件事就拜託您了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210162
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210162,
					"content": "而我嘛…要接著修復這些畫作了，嗯…下一幅是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210157,
					"content": "幻覺也太誇張了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210141,
					"content": "好複雜的準備工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210136,
					"content": "那你會畫蠟筆畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210137
					]
				},
				{
					"id": 715210137,
					"content": "我…會！但是會的不多，只是知道一點皮毛。我必須得惡補一下蠟筆繪畫的知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210116,
					"content": "聽起來很厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				}
			]
		}
	]
}