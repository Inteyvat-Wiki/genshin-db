				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維多利亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "#咦？{F#妳}{M#你}好，還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030602,
					"content": "關於芭芭拉的假期…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "#{F#妳}{M#你}說這個啊，沒錯，芭芭拉小姐剛才是向我請了半天假，說是要陪陪一位朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030604,
					"content": "不過，這還真是罕見…芭芭拉小姐居然會專門為了一位朋友請假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030605,
					"content": "#好了，還是先說正事吧，{F#妳}{M#你}找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030606,
					"content": "關於「了不起的夢幻憂鬱珊瑚氣泡茶」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "#欸？芭芭拉小姐要陪{F#妳}{M#你}去買這個…特別飲品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030608,
					"content": "#難道芭芭拉小姐之前說的朋友就是{F#妳}{M#你}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030609,
					"content": "#啊…如果是{F#妳}{M#你}這位「榮譽騎士」的話，倒也說得過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030610,
					"content": "#好吧，情況我瞭解了。那芭芭拉小姐就麻煩{F#妳}{M#你}多多照顧了，「榮譽騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030611,
					"content": "為什麼芭芭拉的假期要報備行程？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "#這個啊…{F#妳}{M#你}也知道，因為各種原因，芭芭拉小姐在蒙德城裡很受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030613,
					"content": "雖然居民們都是出於好意，但好意太多了，芭芭拉小姐有時候也實在忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030614,
					"content": "如果是在工作中，教會裡的人可以及時出來為她解圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030615,
					"content": "但要是在假期中…那就只能靠芭芭拉小姐自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030616,
					"content": "但她又太…溫柔，對居民們的請求向來都會盡量滿足，甚至會把自己弄得比工作日還疲憊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030617,
					"content": "我們就想，讓芭芭拉小姐把自己的假期行程報備一下，要真的需要我們出面解圍，那我們也能及時趕過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030618,
					"content": "真希望芭芭拉小姐不要再勉強自己了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "維多利亞"
				}
			]
		},
