			"dialogs": [
				{
					"id": 190030701,
					"content": "#咦？{F#妳}{M#你}好，還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030702
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030702,
					"content": "關於芭芭拉的行程…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "芭芭拉小姐要去低語森林附近採集藥材嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030704,
					"content": "嗯…芭芭拉小姐剛才是向我請了半天假，說是要陪陪一位朋友，怎麼突然又要去採集藥材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030705,
					"content": "#不過，芭芭拉小姐應該有自己的考量吧…{F#妳}{M#你}是會和她同行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030706,
					"content": "是的，我會和芭芭拉同行的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "#好吧，那我多少放點心了。芭芭拉小姐就麻煩{F#妳}{M#你}多多照顧了，「榮譽騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030708,
					"content": "為什麼芭芭拉的假期要報備行程？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030709
					]
				},
				{
					"id": 190030709,
					"content": "#這個啊…{F#妳}{M#你}也知道，因為各種原因，芭芭拉小姐在蒙德城裡很受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030710
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030710,
					"content": "雖然居民們都是出於好意，但好意太多了，芭芭拉小姐有時候也實在忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030711
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030711,
					"content": "如果是在工作中，教會裡的人可以及時出來為她解圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030712
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030712,
					"content": "但要是在假期中…那就只能靠芭芭拉小姐自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030713
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030713,
					"content": "但她又太…溫柔，對居民們的請求向來都會盡量滿足，甚至會把自己弄得比工作日還疲憊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030714
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030714,
					"content": "我們就想，讓芭芭拉小姐把自己的假期行程報備一下，要真的需要我們出面解圍，那我們也能及時趕過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030715
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030715,
					"content": "真希望芭芭拉小姐不要再勉強自己了…",
					"roleType": "TALK_ROLE_NPC",
