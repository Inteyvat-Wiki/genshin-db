		{
			"id": 1900306,
			"completionStepIds": [
				1900306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1900306",
							"2"
						],
						"stepId": 1900306,
						"stateName": "QUEST_STATE_UNFINISHED"
