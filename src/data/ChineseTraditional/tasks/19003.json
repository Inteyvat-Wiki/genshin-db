		},
		{
			"id": 1900303,
			"completionStepIds": [
				1900303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1900303",
							"2"
						],
						"stepId": 1900303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維多利亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "#{F#妳}{M#你}怎麼又回來了，如果{F#妳}{M#你}還是來找芭芭拉小姐的話，她還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030302,
					"content": "已經在奔狼領找到芭芭拉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "是這樣嗎…她沒什麼事就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030305,
					"content": "但一時半刻她應該也回不來了吧，看來我得把教會的事情拜託給其他人做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030306,
					"content": "我來幫忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "#{F#妳}{M#你}願意幫忙的話那就最好了，真是不好意思，還要麻煩{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030308,
					"content": "#我想想…那請{F#妳}{M#你}幫我去教會周圍打掃一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030309,
					"content": "教會周圍人來人往，地面總是很髒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030310,
					"content": "這些事之前一直是芭芭拉小姐一個人負責，她一不在，周圍就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030311,
					"content": "這麼大的地方，都是芭芭拉小姐一個人打掃嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "是的，芭芭拉小姐一直說自己沒問題，也不讓其他人幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030313,
					"content": "但每次打掃結束後，她的樣子都很疲憊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030314,
					"content": "#說實話，{F#妳}{M#你}願意幫忙，或者說…芭芭拉小姐願意讓{F#妳}{M#你}來幫忙，還讓我滿意外的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030315,
					"content": "不過，這樣她的負擔也許會小一些吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030316,
					"content": "#總之，那清掃的事就拜託{F#妳}{M#你}了，「榮譽騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 190030303,
					"content": "芭芭拉去晨曦酒莊幫特納看病了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
		{
			"id": 1900304,
