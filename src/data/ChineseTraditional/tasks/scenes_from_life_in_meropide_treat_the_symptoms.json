						],
						"stepId": 7403204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"勒克萊德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "我們回來了，醫生要我們把這個交給你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320402,
					"content": "勒克萊德接過「純潔之水」，一飲而盡。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "我覺得好多了！活力重新回到了我的身體！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320404,
					"content": "這樣就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "也太快見效了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320408,
					"content": "阿德納醫生不愧是有資格的醫生，藥到病除。不像我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320409,
					"content": "那黃綠色的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320410,
					"content": "大有問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320411,
					"content": "呃…看來是頭痛治好了，但是另一邊的問題還是沒解決呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320412,
					"content": "#這下我可以繼續工作了。謝謝{F#妳}{M#你}們，辛苦{F#妳}{M#你}們跑這麼一趟，這些特許券{F#妳}{M#你}們就收下吧，一點小小心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "勒克萊德"
				},
				{
