			"trigger": {
				"objectNames": [
					"勒克萊德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "那些黃綠黃綠的石頭…肯定大有問題，我要命喪於此了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320202,
					"content": "呃…你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320203,
					"content": "我…從長遠來看，我們都會沒事的。只是我要先各位一步沒事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320204,
					"content": "沒事就好，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "不不不，怎麼聽都不是真的沒事的意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320208,
					"content": "不，我真的沒事。如果有事，那一定也為時已晚了，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320209,
					"content": "所以到底是有事還是沒事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "我都被弄昏頭了，能不能說清楚一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320211,
					"content": "說得清楚一點，我這陣子一來生產區就頭痛欲裂、手腳發涼，還不時有心悸的症狀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320212,
					"content": "#我肯定是要完蛋了！{F#妳}{M#你}們懂嗎？要完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320213,
					"content": "#一定是那些黃綠色石頭…那是很邪惡的石頭！{F#妳}{M#你}們一定知道吧，楓丹科學院的中央實驗室…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320214,
					"content": "都怪那些黃綠色石頭，把一切都毀了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320215,
					"content": "去看看醫生吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "我自己就是醫生我當然知道！哦不，我現在已經不是醫生了…我已經沒資格了，不能做診斷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320218,
					"content": "#求求{F#妳}{M#你}們，去找真正的醫生，有資格的醫生，救救我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "勒克萊德"
				},
				{
					"id": 740320219,
					"content": "#唔，感覺他真的病得不輕…{NICKNAME}，我們去找醫生問問看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320216,
					"content": "還是你去醫務室休息一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "感覺你在用什麼很新的修辭手法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "聽起來一點也不像沒事的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿德納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "#遇到麻煩了嗎？還是其他人有麻煩？看{F#妳}{M#你}們兩個都面色紅潤，應該是其他人有麻煩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320302,
					"content": "的確是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320303,
					"content": "說明了勒克萊德的情況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "又是他啊…老毛病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320305,
					"content": "那還有得治嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "#{F#妳}{M#你}是指頭痛，還是妄想症？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320307,
					"content": "欸？所以說，他根本沒什麼疾病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320308,
					"content": "從之前檢查的結果來看，大概是沒有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320309,
					"content": "聽說他過去在外面的時候曾經誤診，忽略了早期徵兆，導致患者…唉，總之，或許自那之後他就有點神經過敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320310,
					"content": "對別人是這樣，對他自己更是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320311,
					"content": "那黃綠色石頭沒問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "#{F#妳}{M#你}看除了他之外，其他人不是都活蹦亂跳的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320313,
					"content": "#話雖如此，也不能放著不管，{F#妳}{M#你}們把這個帶給他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320314,
					"content": "這個…這不是「純潔之水」嗎？真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320315,
					"content": "#哦？{F#妳}{M#你}們也知道這個啊？沒關係的，至少對身體無害，還能讓他打起精神來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320316,
					"content": "那他不知道嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "據我所知，他對這些飲料都是敬而遠之，之前也拿給他喝過…以對健康有益的藥劑的名義，他喝完之後的確恢復了活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320322,
					"content": "好吧，那我們就先把這個帶去給他，如果還是不行的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320323,
					"content": "那就讓他去醫務室躺下吧。就說是醫囑，他會聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320324,
					"content": "#好呦！那我們回去找他吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320318,
					"content": "那不如喝楓達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "這就是問題所在，這裡沒有人不知道楓達的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320320,
					"content": "但據我所知，他沒試過「純潔之水」，畢竟流通的範圍相當有限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "阿德納"
				},
				{
					"id": 740320321,
					"content": "之前也拿給他喝過…以對健康有益的藥劑的名義，他喝完之後的確恢復了活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "阿德納"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
