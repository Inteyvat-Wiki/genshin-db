				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"真晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "#{F#妳}{M#你}是…{F#妳}{M#你}也是來挽留手島先生的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040602,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "手島先生他啊，自從三十年前來到這裡之後，就一直守在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040604,
					"content": "趕走盜寶團、擊退附近的魔物、調解村裡的爭吵…他為這裡付出了許多心血，我們也將他視為最尊敬的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040605,
					"content": "但現在他卻突然要離開這裡，難道…是我們哪裡做錯了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040606,
					"content": "如果可以的話，我們願意向手島先生道歉，只求手島先生能繼續留在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真晝"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
						"stepId": 200407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"健次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040702,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "要我說，這事說不定跟「眼狩令」有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040704,
					"content": "手島先生明明什麼都沒做錯，卻被收繳了「神之眼」。然後他就像是…變了一個人一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040705,
					"content": "我說不上來，但感覺他好像失去了什麼重要的東西，獨自一人繞著村子轉了幾圈之後，突然就說要出去雲遊四海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040706,
					"content": "我們其實也不知道該不該挽留他，但總覺得…不能讓他像這樣失魂落魄地離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040707,
					"content": "看來附近的人都很尊敬他呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
