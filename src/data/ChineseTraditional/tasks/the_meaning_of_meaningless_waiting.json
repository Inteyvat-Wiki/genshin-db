			"trigger": {
				"objectNames": [
					"派蒙",
					"手島"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "你就是手島先生吧，為什麼突然要從這裡離開呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040802,
					"content": "我嗎？與其說為什麼要離開…不如說，我不知道自己為什麼要留在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040803,
					"content": "你在這裡生活了很久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "大家也很依賴你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "是啊，但這並不是我留下來的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040806,
					"content": "三十年前，我為什麼要來這裡？三十年來，我又為什麼不願意從這裡離開？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040807,
					"content": "這些我都不記得了。自從「神之眼」被奪走後，我好像忘記了很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040808,
					"content": "以前的我想留在這裡，現在這種執念沒了，就覺得出去走走也好。雖然心裡還是有點不踏實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040809,
					"content": "原來是這樣…也就是說，我們只要幫你找到留下來的理由，你就不會走了對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040810,
					"content": "嗯…不過，連你本人都已經忘了，這可怎麼辦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040811,
					"content": "不然你再努力回憶一下，看看能不能「咻」地一下想起來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040812,
					"content": "說起來，上次給手島先生送水果的時候，好像見到手島先生正在寫日誌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040813,
					"content": "我有這樣的習慣嗎？說實話…我已經不記得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040814,
					"content": "有的有的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040815,
					"content": "太好了！感覺只要找到日誌，就可以留住這位手島先生呢。我們去附近看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040816,
					"content": "#那就拜託{F#妳}{M#你}們了…我們先回村子裡，把手島先生的情況告訴其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真晝"
				}
			]
		},
