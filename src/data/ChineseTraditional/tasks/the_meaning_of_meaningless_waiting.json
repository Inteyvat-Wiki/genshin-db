			"trigger": {
				"objectNames": [
					"派蒙",
					"手島"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "讓我看看，綾華所說的人在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040102,
					"content": "您這是幹什麼，這麼多年了，為什麼突然要離開啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "真晝"
				},
				{
					"id": 20040103,
					"content": "是啊是啊。我們一點心理準備也沒有，突然就聽到了這個消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040104,
					"content": "孩子們還盼著您再帶他們出去玩呢…拜託您了，請您務必再考慮一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040105,
					"content": "那位想必就是綾華所說的人了，我們快過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "這個似乎就是手島先生的日誌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040202,
					"content": "讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040203,
					"content": "「今天和村子裡的大家一起做了乾燒香魚，我的手比較笨，不小心把鍋燒焦了，只好假裝自己做的是乾燒黑魚。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040204,
					"content": "「今天救了村裡落水的小孩，他說自己的好朋友邦布還在水裡。我撈了一下午，才知道邦布原來是他養的小螃蟹。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040205,
					"content": "「今天去放風箏，線突然斷了。我追啊追，發現追不到，就找了個地方坐下來，看著它越飄越遠。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040206,
					"content": "唔…好像都是一些日常的小事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040207,
					"content": "哦？等等，快看這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040208,
					"content": "「今天又去了附近的神龕祈禱，在那裡坐了許久。妳送的御守有點褪色了，但依然是我最珍貴的東西…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040209,
					"content": "感覺是有用的訊息呢，我們去神龕那邊看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
