			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "這就是手島先生說的御守呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040302,
					"content": "看起來像是女孩子的東西呢，不管是顏色還是圖案，…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040303,
					"content": "如果手島先生一直拿著它的話，上面或許會殘留手島先生的元素力，能不能靠這個做些什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "找到了！這裡應該就是手島先生經常來的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040402,
					"content": "土壤有動過的痕跡…難道說手島先生是在這裡埋藏了什麼寶貝，才一直留在這裡的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040403,
					"content": "讓手島先生在這裡守了三十年的寶貝，一定很了不起。快點挖出來看看吧~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040404,
					"content": "這個是…一封信？信紙都已經泛黃了，看起來像是很久之前寫的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040405,
					"content": "紺田村，好熟悉的名字，是哪裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040406,
					"content": "就是這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "欸？所以那位手島先生，其實是在這裡等人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040408,
					"content": "但是已經過去三十年了啊，還是沒有等到嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040409,
					"content": "總之，先把這些東西交還給手島先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"手島",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "不錯，這日誌上確實是我的筆跡，御守與信…應該也是我的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040502,
					"content": "雖然上面所寫的東西，我都已經不記得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040503,
					"content": "但是，我應該確確實實地在這裡等過一個人，等了三十年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040504,
					"content": "在這期間，我每天把有趣的事情記錄下來，為的是今後重逢的時候，能夠把這三十年的歲月一一講給她聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040505,
					"content": "這期間真是發生了很多事情…時間過得好快，一轉眼都這麼久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040506,
					"content": "為什麼我會把這麼重要的事情忘掉呢？仔細想想，神之眼被奪走後，我感覺自己好像被抽乾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040507,
					"content": "愛也好、遺憾也好，與她有關的一切，全部都消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040508,
					"content": "你會難過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "好像，也沒那麼難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040510,
					"content": "畢竟我已經忘記她是誰了。她的容貌、她的聲音、她和我之間的經歷，我都已經記不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040511,
					"content": "就好像她從未出現在我的身邊…就好像這些年不過是一場模糊的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040513,
					"content": "那你還要離開嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "不了吧…都已經等了大半輩子，還是繼續等下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040516,
					"content": "只是，如果等到了她，卻連她的名字都叫不出來，會不會讓她感到難過呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040517,
					"content": "一旦想到這一點，我的心裡就確實有些難過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040518,
					"content": "奇怪，我明明都不記得她，為什麼還會有這樣的想法？之前也是，總覺得心裡空蕩蕩的，好像缺了什麼一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040519,
					"content": "#不管怎麼說，謝謝{F#妳}{M#你}們幫我找回了留在這裡的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040520,
					"content": "我會繼續留在這裡等她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040522,
					"content": "儘管手島先生說他不怎麼難過，但是不知道為什麼，我感覺好難過啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040523,
					"content": "我也一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "果然如同綾華和托馬先生他們所說…失去神之眼的話，與願望有關的一切也會同時失去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040526,
					"content": "這就是手島先生之前那種狀態的原因吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040527,
					"content": "至少我們也算幫到了他…嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040528,
					"content": "唉…我們去找下一個人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20040524,
					"content": "失去難過的理由才是更難過的事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
