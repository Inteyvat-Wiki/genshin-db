	"talks": [
		{
			"id": 7055201,
			"completionStepIds": [
				7055202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
