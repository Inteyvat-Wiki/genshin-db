					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520301,
					"content": "根據優菈的喜好，全新配方的「浪花劍鋒曲」，完成啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520302
					]
				},
				{
					"id": 705520302,
					"content": "呀，顏色很漂亮嘛！還加入了剛剛提到的海露花果實汁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520303
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520303,
					"content": "香氣也非常到位，既有烈性，又不缺果香…容我品一品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520304
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520304,
					"content": "等妳仔細分析！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520305
					]
				},
				{
					"id": 705520305,
					"content": "呼…哇啊…等我想想誇讚的詞，我得好好想一想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520306
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520306,
					"content": "雖然淑女不該這樣，作為合格的品酒人，也該慢慢喝才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520307
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520307,
					"content": "但…口感實在太棒了，失禮了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520308
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520308,
					"content": "能再來一杯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520309,
						705520310
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520309,
					"content": "當然！喜歡就多喝！",
