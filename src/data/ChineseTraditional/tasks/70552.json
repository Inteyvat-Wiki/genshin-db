				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"優菈"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520101,
					"content": "#嗯？現在居然是{NICKNAME}在管理飲品小站…早知如此，我上午就過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520102,
						705520103
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520102,
					"content": "感謝支持，感謝支持！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				},
				{
					"id": 705520104,
					"content": "#說實話，我已經開始好奇了——早就聽說{NICKNAME}有著頂級的調飲才華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520105
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520105,
					"content": "#{F#妳}{M#你}能用格蘭菲狄準備的材料，調出什麼樣的飲品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520106,
						705520107
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520106,
					"content": "不過，優菈似乎也很忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520108,
					"content": "沒辦法，大事一件接著一件…首先，騎士團全員即將迎來一年一度的戰鬥技巧考核，這次考核大幅提高了標準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520109
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520109,
					"content": "作為游擊小隊的隊長，我有必要發揮帶頭作用，至少要在隊長級的實戰對抗中拿到前三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520110
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520110,
					"content": "所以，最近一直在加強練習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520111,
						705520112
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520111,
					"content": "優菈隊長居然是這種作風…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520113,
					"content": "哼，罪人的後裔想要在這個位置上穩穩坐著，也沒那麼容易吧？我可是沒有失職過的哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520114
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520114,
					"content": "另外，總務小隊為了豐富騎士們的戰鬥經驗，邀請了楓丹廷知名的決鬥代理人前來交流劍術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520115
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520115,
					"content": "鑑於我在出勤率最高的幾位隊長中，使用雙手劍的本事還算不錯，也被選為了交流代表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520116
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520116,
					"content": "我得好好準備一番，和那位決鬥代理人認真過招，然後根據結果撰寫至少六份報告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520117
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520117,
					"content": "另外，之前和克洛琳德小姐的幾次切磋，也讓我投入了相當之多的精力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520118
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520118,
					"content": "面對迅捷劍和銃槍的雙重打擊，該如何防守反擊、如何奪取主動權？直到現在，我還在回想一些細節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520119
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520119,
					"content": "結果是樂觀的，這次劍術交流讓我們雙方都獲益匪淺。別說六份不同角度的報告了，二十四份我都能接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520120,
						705520121
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520120,
					"content": "看來要給妳來杯夠狠的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520122,
					"content": "#的確如此。提神為主，什麼種類的飲品都不限，請{F#妳}{M#你}隨意發揮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520123
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520123,
					"content": "（以優菈目前的狀態，幫她調一杯「星月閃亮飲」應該很適合。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705520121,
					"content": "看來妳需要補充能量喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520112,
					"content": "第一次瞭解妳隊長的這面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520107,
					"content": "感覺妳最近上班也滿勤快的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520103,
					"content": "無論何時，為您服務！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				}
			]
		},
		{
			"id": 7055202,
			"completionStepIds": [
				7055206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
