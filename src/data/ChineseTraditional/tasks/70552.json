						],
						"stepId": 7055206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"優菈"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520201,
					"content": "優菈隊長的特調「星月閃亮飲」完成了，請享用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520202
					]
				},
				{
					"id": 705520202,
					"content": "嗯哼，這個語氣，很有自信嘛？那我可要好好品味一番了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520203
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520203,
					"content": "唔？真不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520204
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520204,
					"content": "又甜又酥麻，空氣感很棒，氣泡水是點睛之筆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520205
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520205,
					"content": "身體裡的活力都被喚醒了，一杯不過癮…再給我來杯更有力道的，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520206,
						705520207
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520206,
					"content": "這杯不夠有勁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				},
				{
					"id": 705520208,
					"content": "啊哈，可別綁手綁腳！我的酒量也不至於差到兩杯就倒吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520209,
						705520210
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520209,
					"content": "那我們聊聊天，我再想想！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520211,
					"content": "#好啊，今晚第一小隊沒替我安排文書工作，夠悠閒，就慢慢敘敘舊，試試{F#妳}{M#你}的新配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520212
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520212,
					"content": "之前有一段時間沒見面了，妳一直在雪山附近執勤嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520213
					]
				},
				{
					"id": 705520213,
					"content": "是啊，之前的情況很複雜，一群工程師賊匪團伙居然弄起什麼機關劫持技術，妄想操縱遺蹟重機打劫商隊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520214
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520214,
					"content": "偏偏有幾位常駐荊夫港的老騎士調動到了我的隊裡，她們非常不服我這個「勞倫斯家的小姑娘」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520215
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520215,
					"content": "帶著她們一起出這趟任務也算是充滿波折，在雪地裡潛行三週，不能生火取暖，好不容易才找到對方的據點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520216
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520216,
					"content": "老前輩們捱了不少凍，差點被對方走私的戰鬥機關撂倒…萬幸的是，最後戰鬥順利收場，她們也都心服口服了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520217,
						705520218
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520217,
					"content": "委屈妳了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520219,
					"content": "我？我倒完全沒問題…多謝關心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520220
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520220,
					"content": "當時的確有點心累，好在這次行動也讓她們累得半死，現在她們不會再質疑我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520221
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520221,
					"content": "要是以後還有找我麻煩的新人，就讓這幾位老前輩去指導好了。說是一勞永逸，好像也沒什麼問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520222
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520222,
					"content": "對了，優菈帶來的這瓶是…進口果汁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520223
					]
				},
				{
					"id": 705520223,
					"content": "#對哦，商人說它叫「海露花果實萃取原漿」…它的香味很特別，也送{F#妳}{M#你}一瓶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520224,
						705520225
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520224,
					"content": "最近很常喝這個嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520226,
					"content": "嗯…這是一種必要的禮節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520227
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520227,
					"content": "梅姬斯圖斯小姐借我的那本…《輕劍舞者的二十年後》提到——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520228
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520228,
					"content": "「楓丹的劍客們切磋劍法後，勝者會禮貌地宴請敗者。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520229
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520229,
					"content": "為了體面地招待克洛琳德小姐，我找了好久，才在荊夫港找到一位奇貨商人買到這些絕版貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520230
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520230,
					"content": "聽起來像是小說情節…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520231
					]
				},
				{
					"id": 705520231,
					"content": "嗯…剛開始，我也這麼懷疑過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520232
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520232,
					"content": "但安柏說不管現實的楓丹有沒有這個習俗，至少證明我們有好好瞭解過楓丹的文化作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520233
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520233,
					"content": "再退一步，誰也不會討厭新奇的美食，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520234
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520234,
					"content": "交流劍術後的聚餐上，我就請克洛琳德小姐喝這個好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520235
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520235,
					"content": "交流劍術後的聚餐上，克洛琳德小姐的確很喜歡這種果汁的風味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520236
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520236,
					"content": "快要比試了，優菈心情怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520237
					]
				},
				{
					"id": 705520237,
					"content": "啊呀…說實話，我躍躍欲試…但也有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520238
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520238,
					"content": "經過上次比試，優菈心情怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520239
					]
				},
				{
					"id": 705520239,
					"content": "啊呀…說實話，和克洛琳德小姐交手前，我躍躍欲試…但也有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520240
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520240,
					"content": "克洛琳德小姐的戰鬥流派屬於神秘的「逐影獵人」…圖書館裡，上百年前的楓丹報紙，都提到過這個組織的強大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520241
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520241,
					"content": "前些年的報紙甚至說克洛琳德小姐是某位海底王國的遺孤，戰鬥前會發動儀式，邀請魂靈附在她的劍上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520242
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520242,
					"content": "我不知道後續，但先當這些傳聞屬實，甚至…克洛琳德小姐的實力比這更誇張——做好萬全的心理準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520243
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520243,
					"content": "我不知道報導的後續，但就我個人的感受而言，克洛琳德小姐的實力的確與這種描述相符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520244,
						705520245
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520244,
					"content": "劍術史上的大戰值得一杯特調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520246,
					"content": "#在飲品裡融入「劍術」的元素？{F#妳}{M#你}還真有創意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520247
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520247,
					"content": "#的確有必要打打氣，不過…{F#妳}{M#你}想怎麼用飲品來表達這種意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520248
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520248,
					"content": "#不過，來這麼一杯紀念特調，的確很不錯…{F#妳}{M#你}想怎麼用飲品來表達這種意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520249
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520249,
					"content": "據我觀察…使用迅捷劍的楓丹劍士大多擅長刺擊，專注於…精準而持續地施壓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520250
					]
				},
				{
					"id": 705520250,
					"content": "唔…的確符合書上的描寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520251
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520251,
					"content": "要類比成飲品，就像是咖啡、泡泡桔冰酒…或是蒙德的果釀，入口並不刺激，但有著持續的回味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520252
					]
				},
				{
					"id": 705520252,
					"content": "目前這杯特調的基底，用的正是果釀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520253
					]
				},
				{
					"id": 705520253,
					"content": "還真有道理…不愧是行家，提瓦特應該沒有第二個人能作出這種比喻了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520254
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520254,
					"content": "但優菈的劍術不一樣，妳像雙手劍的領舞人，引導著寬闊的劍身，旋轉翻飛、大開大闔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520255
					]
				},
				{
					"id": 705520255,
					"content": "只要斬中一次，就能發揮雪崩般的破壞力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520256
					]
				},
				{
					"id": 705520256,
					"content": "似乎比較強調…接觸瞬間的衝擊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520257
					]
				},
				{
					"id": 705520257,
					"content": "不…不用說得那麼藝術化！只是宗室流派西風劍術的變體，加一點我個人的發揮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520258
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520258,
					"content": "所以，優菈的格調，更像…入口衝擊強勁，一擊致勝，但又如冰塊般，回甘中不含多餘味道的烈酒——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520259
					]
				},
				{
					"id": 705520259,
					"content": "火水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520260
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520260,
					"content": "最近幾年，火水的確隨著至冬商人的生意繁榮，在各地流行起來，幾乎每個酒吧都有以它作為基底的作品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520261
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520261,
					"content": "我們一起找到了最佳答案！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520262
					]
				},
				{
					"id": 705520262,
					"content": "#真有{F#妳}{M#你}的！那就試試看，把基底的果釀換成火水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520263
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520263,
					"content": "度數的問題…不成問題！雖然遠征隊的同僚們被火水撂倒過，但我…我有信心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520264
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520264,
					"content": "忙的時候通常都吃什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520265
					]
				},
				{
					"id": 705520265,
					"content": "最近的伙食？那可得聊聊後勤小隊的新成就了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520266
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520266,
					"content": "他們發起了一項「騎士飲食改進計畫」，開始替我們這種野外作戰的小隊配發標準化的罐頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520267
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520267,
					"content": "以前我們只能拿到乾貨，需要吃飯的時候，才架起鍋子和篝火，擲骰子選人做飯，其餘騎士輪流值崗警戒…有點麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520268
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520268,
					"content": "現在只需帶上裝著五個罐頭和九個紙包的「標準戰地配給」，把罐頭放在篝火邊烤熱，就能開飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520269,
						705520270
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520269,
					"content": "聽起來還滿方便的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520271,
					"content": "#哈哈，{F#妳}{M#你}也說了是「聽起來」，對吧？罐頭供應商的風評有口皆碑，普通款的口味的確不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520272
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520272,
					"content": "問題就是…給我們的軍用款為了符合保存標準，實在太鹹了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520273
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520273,
					"content": "第五小隊那個喜歡缺德笑話的副隊長評價：「這罐頭一開，璃月那位灶神都要攻打過來了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520274
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520274,
					"content": "總之，吃了一週新罐頭，我的味覺已經麻木了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520275,
						705520276
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520275,
					"content": "這麼恐怖嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520277,
					"content": "這也不怨後勤小隊，畢竟眾口難調嘛。回饋已經交上去了，罐頭的不足之處，應該很快就會被改善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520278
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520278,
					"content": "當然，在營地裡吃小隊專職廚師製作的新鮮飯菜，還是最好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520279
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520279,
					"content": "嗯，一切順利，我明白要怎麼為妳準備第二杯特調了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520280
					]
				},
				{
					"id": 705520280,
					"content": "#好啊，那就開始{F#妳}{M#你}的第二段即興表演吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 705520276,
					"content": "誰該對此負責…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520270,
					"content": "聽起來沒什麼缺點？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520245,
					"content": "要用劍術主題的特調來紀念嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520225,
					"content": "為什麼會隨身攜帶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520218,
					"content": "有沒有著涼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520210,
					"content": "加烈酒還不夠，大改配方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520207,
					"content": "要加更狂的酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				}
			]
		},
		{
			"id": 7055203,
			"completionStepIds": [
				7055210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
