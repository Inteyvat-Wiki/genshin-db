			"trigger": {
				"objectNames": [
					"娜維婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "接下來，我的好搭檔和派蒙，我們要進入「海薇瑪映影歡樂城」的正題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890402,
					"content": "之前說過，這次的「海薇瑪映影歡樂城」由愛好者們發起，刺玫會負責統籌、建造和營運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890403,
					"content": "不過，愛好者畢竟不是全能的專業人士，通常只負責活動展位的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890404,
					"content": "我們的任務，就是進行「長期經營規劃」，制定「標準玩法攻略」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890405,
					"content": "長期、經營、規劃…聽起來好高深！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890406,
					"content": "我們兩個平常都在冒險，甚至都沒怎麼擺攤賣過東西，能搞懂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890407,
					"content": "不是每個老闆都讀過商業學校喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "沒錯，就是這種氣勢！我的好搭檔什麼風浪都見過，影響過不少提瓦特的商業大事件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890410,
					"content": "總之，我們先來看看歡樂城的基本情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890411,
					"content": "#好像大概懂了，{NICKNAME}，{F#妳}{M#你}覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890412,
					"content": "哈哈，這是我的拿手好戲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "嗯！我們一起加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890415,
					"content": "剛才，娜維婭好像還提到了「標準玩法攻略」…難道說，還有不標準的玩法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890416,
					"content": "當然啦，畢竟每個人對映影和遊樂設施的理解都不同，歡樂城裡也不乏驚險刺激的活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890417,
					"content": "說不定，有的遊客認不得路，咕嚕兩下就跑出了遊玩範圍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890418,
					"content": "有的遊客或許會認錯道具的用途，把危險的道具捏在手裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890419,
					"content": "要避免遊客們遊玩時陷入困惑，我們就要給每個活動列出一個「標準玩法」，或者說「流程攻略」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890420,
					"content": "我懂了，就由我來先玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "這麼一說，我也能想像各種意外情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890423,
					"content": "如果碰見太難的關卡，也只有憑我們的實力才能輕鬆應付！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890424,
					"content": "#當然啦，我絕不希望我的好搭檔遇見危險，在{F#妳}{M#你}們來之前，我已經把現有設施統統仔細檢查過了，絕對不會有安全因素的缺陷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890425,
					"content": "#我也希望{F#妳}{M#你}能成為最早體驗到遊樂設施的人，然後說說{F#妳}{M#你}對這些遊樂設施的感受，提提建議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890426,
					"content": "嘿嘿，不愧是娜維婭，總能讓我們安安心心開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890427,
					"content": "#我很期待哦！{F#妳}{M#你}們的意見非常關鍵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890428,
					"content": "總之，我們就先將「繽紛蹈險奇行」投入營運，制定第一份攻略好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890421,
					"content": "我懂了，我來當參考標準。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "哇啊…一邊工作一邊學吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "我們也做過許多賺大錢的生意嘛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
