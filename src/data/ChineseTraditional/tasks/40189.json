					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "#哈哈哈，{F#妳}{M#你}們也不賴嘛，比我更有老闆的氣勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890805,
					"content": "現在，「海薇瑪映影歡樂城」就算正式開張了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890806,
					"content": "經營樂園是個長期的過程，心急賺不了大筆摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890807,
					"content": "這次的工作安排已經差不多了，我們就小小休息一下，等待著這個週期的營收財報出爐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890803,
					"content": "我會好好管理出勤的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
