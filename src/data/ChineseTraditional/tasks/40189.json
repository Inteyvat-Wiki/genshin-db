						"position": [
							3729.029,
							442.806,
							3936.542
						],
						"pointId": 340200187
					}
				]
			},
			"dialogs": [
				{
					"id": 401890601,
					"content": "#{F#妳}{M#你}們似乎比之前更有興致了…看來第一次試玩沒讓{F#妳}{M#你}們失望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890602,
					"content": "挑戰形式非常親切！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "雖然沒看過多少映影，但試過這次的玩法後，我好像…來勁了？很想瞭解一下相關的作品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890605,
					"content": "派蒙真不錯，領會到了愛好者們最純粹的目標！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890606,
					"content": "如果能讓客人們對遊樂設施的原型映影感興趣，這些淳樸的愛好者就再快樂不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890607,
					"content": "在開銷允許的範圍內，他們甚至願意多多自掏腰包！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890608,
					"content": "自…自掏腰包？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890609,
					"content": "沒錯，基本的攤位建材和地租由刺玫會負責，許多愛好者自己出錢製作了宣傳素材和相關商品哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890610,
					"content": "對他們來說，展位的費用並不是主要支出，有人已經開始自行設計映影角色的衍生產品了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890611,
					"content": "比如這次的代言人海薇瑪夫人，她在上次漫畫映影的人氣角色投票中取得了亞軍，評語是「圓圓彈彈終極可愛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890612,
					"content": "許多人都想以她的形象設計抱枕，用最頂級的布料，請最手巧的工匠來批次生產…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890613,
					"content": "下一屆展會上，這種抱枕就會正式發售，類似的商品還有很多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890614,
					"content": "這麼一說，我也有點心動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "很不錯吧！而且，作為肖像權代理人兼海薇瑪夫人的監護人，芙寧娜會拿到銷售額六成的分紅呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890618,
					"content": "畢竟這些都是愛好者們自願的，目的不是賺錢，而是宣傳海薇瑪夫人的可愛形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890619,
					"content": "芙寧娜手裡的摩拉越多，海薇瑪夫人的伙食就越好，大家都會為此開心~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890620,
					"content": "嘿嘿，我喜歡這種感覺！大家為了共同的愛好努力，不計較利潤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890621,
					"content": "話說回來，完全不管摩拉，也有點極端，無論愛好者的作品，還是正規的商業設施，都需要考慮基本的收支平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890622,
					"content": "這次的「海薇瑪映影歡樂城」也是一樣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890623,
					"content": "制定了「標準玩法攻略」後，遊樂設施就可以正式對外開張。不過，我們不可能親自來當售票員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890624,
					"content": "展位上還有許多雜務需要處理，歡樂城也需要我們持續建設。所以，我們需要為每個遊樂設施安排專門的員工，以便維護管理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890625,
					"content": "樂園的告示牌處有個招聘處，收到了許多份履歷，他們各有所長，我們就要根據設施的需要，找出綜合表現最不錯的員工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890626,
					"content": "接下來，員工就能把遊樂設施持續營運下去，為「海薇瑪映影歡樂城」不斷帶來收益！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890627,
					"content": "欸？突然就從試玩專家變成招募員工的…老闆？還沒體驗過這種事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890628,
					"content": "我篩選履歷可是很嚴格的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "#{F#妳}{M#你}也不能把自己當成絕對標準，要求普通人和{F#妳}{M#你}一樣能幹哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890631,
					"content": "好啦，現在是履歷時間！希望有大顯神通的員工來應徵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890629,
					"content": "我肯定是個稱職的老闆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "要不然，多給芙寧娜幾成分紅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "放心哦，芙寧娜是海薇瑪夫人的監護人，代管著她的肖像權，可以拿到銷售額六成的分紅呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 401890603,
					"content": "還結合了映影主題！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
