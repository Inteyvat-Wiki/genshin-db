					"達雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "#{F#妳}{M#你}好，我是剎訶伐羅學院的達雅！{F#妳}{M#你}也是來參加學院遊樂會的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900102,
					"content": "這是我們學院推出的遊戲：「通道計畫」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900103,
					"content": "怎麼樣？要不要試著玩一玩呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900104,
					"content": "我記得剎訶伐羅學院是研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "我們學院的研究很多都與機關和建築有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900107,
					"content": "咳，扯遠了…為了參與這次學院遊樂會，我們學院裡的很多學生群策群力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900108,
					"content": "最終，研究出了「通道計畫」這個遊戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900109,
					"content": "簡單來說，遊玩者需要用我們已經準備好的各種物件搭建道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900110,
					"content": "無論是架橋啦，鋪梯啦…最終的目標，就是搭建出一條可以供人通行，並且直達終點的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900111,
					"content": "在搭建完畢後，我們還會進行一次最終檢驗…就像是驗收搭建好的建築一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900112,
					"content": "總之，只要能搭建出一條安全的道路，就算是獲勝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900113,
					"content": "聽起來很複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "哈哈哈，不用擔心，這又不是在現實裡建設建築。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900116,
					"content": "就算是搭建失誤，道路垮塌了也沒關係，只要重新搭建就好，我們也不會限定嘗試次數的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900117,
					"content": "只要發揮想像力，搭出一條漂亮的道路就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900118,
					"content": "我想試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "沒問題，那麼就請看向這邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900120,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "這樣啊…沒關係，我們的攤位在學院遊樂會期間會一直開設。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900122,
					"content": "#不管什麼時候，只要{F#妳}{M#你}想試玩，直接過來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "達雅"
				},
				{
					"id": 736900114,
					"content": "我沒什麼建築天賦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}