			"dialogs": [
				{
					"id": 700100601,
					"content": "#怎麼樣，{F#妳}{M#你}已經問過大家的意見了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100602,
					"content": "問到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "#{F#妳}{M#你}看，我就說了吧…總之情況就是這樣，我早就習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100604,
					"content": "唉，不管是什麼方法，只要能夠奏效我就謝天謝地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100605,
					"content": "#{F#妳}{M#你}等一下是要回去雪山那邊，向玉霞回報委託的情況吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100606,
					"content": "#那{F#妳}{M#你}順便幫我把這封信帶給她吧，她一定也想知道協會最近的情況，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100607,
					"content": "唉，希望這次能招到新人…不過這樣子招過來的新人，真的能成為像樣的冒險家嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
