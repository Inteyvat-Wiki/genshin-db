				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "#嗯？{F#妳}{M#你}有事嗎？我正想開始彈唱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100502,
					"content": "關於冒險家協會的招募…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "那個啊，我看到告示了。不過我對那個沒有興趣，再說，我不用加入冒險家協會，光用歌聲就能守護蒙德了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100504,
					"content": "而且就算是加入冒險家協會，大部分情況下也是在做雜事吧，這對我沒什麼幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100505,
					"content": "#所以，我對冒險家協會也沒什麼興趣，謝謝{F#妳}{M#你}特意來問我，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100506,
					"content": "這是相關的招募資料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "咦？這是雪山吧，這尊雪中的七天神像還挺有…意境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100508,
					"content": "對了，這裡是不是很高？我聽人家說，雪山是很高的，要是在那裡彈唱的話，聲音一定能傳得更遠吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100509,
					"content": "我等一下去冒險家協會問問好了，我記得，那邊好像能僱用冒險家來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "海倫"
				},
				{
					"id": 700100510,
					"content": "不過，冒險家居然能到這裡地方去，感覺還滿有趣的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海倫"
				}
			]
		},
