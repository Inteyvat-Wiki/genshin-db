	"talks": [
		{
			"id": 7001001,
			"completionStepIds": [
				7001003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001003",
							"2"
						],
						"stepId": 7001003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "關於委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "#{F#妳}{M#你}是看見了我的委託之後過來的嗎？嗯，我確實有一些事想讓{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100103,
					"content": "#具體而言，我想拜託{F#妳}{M#你}幫我去雪山裡跑一趟，給兩個地方留個影，確切的地點我會在地圖上為{F#妳}{M#你}標記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100104,
					"content": "#報酬的話，當然也會按照冒險家協會的規矩，給付{F#妳}{M#你}合理的價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100105,
					"content": "#怎麼樣？{F#妳}{M#你}意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100106,
					"content": "為什麼要在這兩個地方留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "嗯…這件事說到底，也和賽琉斯那小子有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100108,
					"content": "他上次拜託我，要我弄點雪山的特產給他，他要用這些東西製作協會的招募宣傳，拿去在風花節用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100109,
					"content": "風花節都已經開始了，但賽琉斯那小子不知道是不是也忙著過風花節，最近一直沒聯繫我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100110,
					"content": "唔…這麼一想，他確實也到了那個年紀了，的確該忙著過風花節呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100111,
					"content": "他應該已經超出那個年紀很多了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "是嗎？我倒是沒什麼感覺，總感覺…呃，算了，不說這個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100113,
					"content": "我已經搜集了些礦石，還整理了幾本地形圖和魔物記錄，還想要雪山裡的好景色留個影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100114,
					"content": "#旅行者，能請{F#妳}{M#你}幫我去雪山裡跑一趟，為那兩個地方留個影嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "#嗯，那就拜託{F#妳}{M#你}了。我已經把那兩個地方為{F#妳}{M#你}標註在地圖上了，直接過去就行，搞定了之後，就回來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100117,
					"content": "妳不回去看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "城裡的氣氛太熱烈了，我有點承受不住，對我來說，待在這裡反而會更舒服一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100119,
					"content": "而且我在這裡還有很多事要做，暫時就不回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100120,
					"content": "#我已經把最佳取景點為{F#妳}{M#你}標註在地圖上了，直接過去就行，搞定了之後，就回來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
							"2"
						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "關於委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "#怎麼，{F#妳}{M#你}已經把事情搞定了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100203,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "#辛苦了。我也已經把要送給那小子的東西包好了，請{F#妳}{M#你}再幫我跑一趟吧，把東西送過去之後，記得再回來，我會把報酬結給{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100205,
					"content": "雖然不知道這些東西夠不夠用，但如果是要招募新人的話，魔物紀錄和礦石一定最有吸引力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "唉，這個招募計畫看起來沒什麼用啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100302,
					"content": "關於玉霞送過來的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "呃，她送給我東西？哦對…是我上次拜託她的，我自己都忙到忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100304,
					"content": "你真的的在忙著過風花節嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "風花節？我可沒時間，之前那版招募計畫裡的方法已經沒用了，我正忙著制訂全新的招募計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100306,
					"content": "我先看看玉霞寄了什麼給我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100307,
					"content": "礦石…沒用沒用…現在沒有年輕人喜歡這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100308,
					"content": "地形圖…唉，這個給協會裡的人用用還可以，用來招募的話，大概沒人會看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100309,
					"content": "魔物調查筆記…這個也應該給協會裡的冒險家抄幾份…用來招募的話就算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100310,
					"content": "哦？還有這兩張圖，這兩張圖看著還不錯，景色又好，看著也很安全，一定有人會感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100311,
					"content": "為什麼要選這個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "感覺和冒險家有關的東西，反而被剔除了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700100313,
					"content": "#{F#妳}{M#你}是不知道現在協會裡的現狀，現在的年輕人，對什麼魔物啦，礦石啦，地形圖啦已經沒興趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100314,
					"content": "想要吸引他們的注意力，必須要用一些更加…「現實」的東西才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100315,
					"content": "現在正值風花節，年輕人們一定都想著，用一個不那麼尋常，但又不那麼危險的方式展示自己的魅力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100316,
					"content": "進入雪山探險，就是這樣的一種方式，只要有人對此感興趣，就可能來協會詢問相關事宜，也就有可能加入協會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100317,
					"content": "呃…就算他們這樣也不想加入協會，那…那給我們一些委託也好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100319,
					"content": "#而且{F#妳}{M#你}看這兩張畫的位置，都在大路旁邊，只要小心謹慎，一般都不會遇到危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100320,
					"content": "已經要用這種方式了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "但這就是現狀，要不是真的沒辦法了，我也不會想出這種主意來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100322,
					"content": "#唔，要是{F#妳}{M#你}還是不相信，那{F#妳}{M#你}就拿上這兩張畫片，去找周圍的人問問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100323,
					"content": "#{F#妳}{M#你}先和他們說冒險家協會招募的事，然後再拿出這兩張畫片，就說是「招募資料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 700100324,
					"content": "#然後，{F#妳}{M#你}就知道我為什麼會想出這種主意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
		{
