					"六指喬瑟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#嘿，朋友{F#妳}{M#你}好！願意聽聽我的新作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100402,
					"content": "關於冒險家協會的招募…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "冒險家協會的招募？抱歉，我對這個不太感興趣，到處東奔西跑可對寫詩沒有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100404,
					"content": "而且，在這座蒙德城裡，就算要譜寫史詩…當然也是以騎士團為藍本最好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100405,
					"content": "抱歉，我對冒險家協會的招募不感興趣，成為一名幫人家抓貓的冒險家，對於寫詩可沒什麼幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100406,
					"content": "這是相關的招募資料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "這是…雪山裡的景色嗎？看起來還真不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100408,
					"content": "如果能在這種地方遊覽一番，我說不定就能找到新靈感。而且這周圍看起來，似乎也不太危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100409,
					"content": "嗯…我等會去冒險家協會問問吧，就算不加入協會，僱用一位冒險家陪我去那邊看看也不錯啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "六指喬瑟"
				},
				{
					"id": 700100410,
					"content": "遊覽雪山…感覺上應該還不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "六指喬瑟"
				}
			]
		},
