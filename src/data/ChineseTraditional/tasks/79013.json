			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "嗯，甜甜花釀雞真的很好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130202,
					"content": "確實能理解為什麼這個叫「沃爾夫岡」的冒險家會念念不忘呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130203,
					"content": "不過被關在這裡，最後連甜甜花釀雞都吃不到，真是可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130204,
					"content": "這本筆記很舊了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#是哦…但是這麼說來…{NICKNAME}，還記得我們從島上的水池那樣的東西進入另一邊的島嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130217,
					"content": "水池裡島上的建築比起水池外的島，看起來要完整很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130218,
					"content": "現在島上的建築跟那裡的建築比起來，就像遺蹟一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130219,
					"content": "會不會水池裡的建築…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "很有可能！說不定水池裡島上的建築，就是水池外島上遺蹟很久以前的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}，{F#妳}{M#你}說會不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130223,
					"content": "水池裡的島，是以前的島？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130207,
					"content": "#而且，{F#妳}{M#你}看…我們要是找到了以前的這個密室在哪，不就能夠救到這個冒險家了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130208,
					"content": "只是發生在幻境的影響裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "可是…就算一切都是假的，這個冒險家說不定也不存在，但看到他說得那麼可憐，也是想幫一下的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130212,
					"content": "確實，派蒙說得對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#嗯！我就知道{NICKNAME}也會這樣覺得的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130216,
					"content": "我們這就去水池裡的島那裡看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130214,
					"content": "那就去看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "嗯，要是能幫到這個叫「沃爾夫岡」的冒險家就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130209,
					"content": "是改變不了現實的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "水池裡的建築就是原本的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "應該是很久之前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
