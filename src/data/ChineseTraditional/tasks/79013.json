			"dialogs": [
				{
					"id": 790131101,
					"content": "門打開了！真是有點麻煩的機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}，這裡好像還沒有沃爾夫岡的筆記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131103,
					"content": "代表他還沒來過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "那我們就算提前幫他解開密室了…這下他就不會被關起來了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131105,
					"content": "若是反覆觸發的機關…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "那怎麼辦呀…唔，不如我們給他留言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131108,
					"content": "我們用刻痕，把留言留在比較顯眼的地方，告訴他解開機關的方法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131106,
					"content": "就算這次解開了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
