				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "就說怎麼沒有筆記本，原來是把留言刻在柱子上…這傢伙成功到這裡啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131902,
					"content": "不過，他到底哪來的信心…要是沒有我們幫他，他早就困在遺蹟的密室裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131903,
					"content": "他去雪山，一定會被凍成「冷鮮肉」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131904,
					"content": "「冷鮮肉」有點過分了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "我、我是說，他去雪山，肯定會遭遇危險的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131908,
					"content": "我們得告訴他，不能去雪山呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131909,
					"content": "那就再給他留一次言吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "嗯嗯，我也是這麼想的…對了，這一次，再準備一份甜甜花釀雞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
