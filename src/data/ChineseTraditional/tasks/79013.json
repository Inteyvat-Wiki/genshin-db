					"id": 790131201,
					"content": "留在這裡應該夠顯眼了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "留言"
				},
				{
					"id": 790131202,
					"content": "希望沃爾夫岡能夠看到，不要再跑到這個遺蹟的密室裡來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "留言"
				},
				{
					"id": 790131203,
					"content": "我們回去看看吧，說不定這次筆記也會有變化啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言"
				}
			]
