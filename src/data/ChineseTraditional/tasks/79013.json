			"dialogs": [
				{
					"id": 790131801,
					"content": "（老舊的刻痕，留下刻痕的人寫著…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131802,
					"content": "「風很大，就不用筆記本了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131803,
					"content": "「這裡日出很美，歷經艱險來到此處，心中十分滿足。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131804,
					"content": "「不知在我之後，是否有人能來這兒看到同樣的景色呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131805,
					"content": "「…如此險境我也來過了，下次，就去龍脊雪山吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131806,
					"content": "「此處甚好，可惜沒有甜甜花釀雞…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131807,
					"content": "「沃爾夫岡留。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "刻痕"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
