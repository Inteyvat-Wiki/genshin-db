					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "什麼呀，這傢伙只顧著說一些帥氣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131602,
					"content": "不行，我們得去雪山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131603,
					"content": "幻境中的改變，改變不了過去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "…啊…對哦，金蘋果群島整個都被那個裝置影響，沃爾夫岡才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131606,
					"content": "所以我才以為沃爾夫岡已經被救出密室了…其實到最後，他都在最初的密室裡沒有出來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131607,
					"content": "不過！不過這個「沃爾夫岡」還是讓人生氣…我們都那麼幫助他了，他還覺得「幫別人踩雷」就不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131608,
					"content": "他就不能，更珍惜自己的生命一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131609,
					"content": "每個人都有追求之物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "我明白啦，我知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131612,
					"content": "但是我還是覺得他們應該有更好的結局嘛，比如回到蒙德，成為大冒險家…然後還能去餐館逗貓，盡情地吃甜甜花釀雞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131613,
					"content": "為什麼他們就不能有個好結局呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131610,
					"content": "正是因為有他們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "「沃爾夫岡」是到不了雪山的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
