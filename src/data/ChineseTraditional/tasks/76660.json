			"dialogs": [
				{
					"id": 766600101,
					"content": "#歡迎{F#妳}{M#你}，冒險家，需要我為您查看今天的委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600102,
					"content": "果然還是這樣最習慣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "咦，您是…急著辦事嗎？我能為您做些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600105,
					"content": "沒有沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "我們只是單純地很高興見到妳！嘿嘿，還是凱瑟琳最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766600108,
					"content": "謝謝兩位的熱情…抱歉，可能我並沒有理解您的幽默感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600109,
					"content": "但無論如何，歡迎您來到挪德卡萊，這裡是一片充滿機遇的土地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600110,
					"content": "我相信，您一定能在這裡經歷偉大的冒險，取得舉世無雙的寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600111,
					"content": "祝福您，冒險家，繼續冒險吧，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 766600106,
					"content": "我們只是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "還好是妳，凱瑟琳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				}
			]
		}
	]
