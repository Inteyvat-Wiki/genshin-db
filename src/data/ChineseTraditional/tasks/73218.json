			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "「希望教令官能考慮一下收緊喀萬驛的通關限制。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181802,
					"content": "「現在只要是沙漠民就能隨隨便便通關，不僅導致很多盜匪藉此機會逃進叢林裡藏匿，而且還搶佔了我們須彌人的工作機會。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181803,
					"content": "「雖說現在還沒有放開沙漠民的虛空許可權，不過聚砂廳發放的那些委託，早就不限於傭兵的工作了。這樣下去就算都去考教令院，也得有人要當無業遊民了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181804,
					"content": "「你這是什麼話，沙漠民本來也是草神大人的子民，他們也是須彌人，讓他們進城是理所當然的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181805,
					"content": "「你在這裡說這種話可小心挨揍。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
