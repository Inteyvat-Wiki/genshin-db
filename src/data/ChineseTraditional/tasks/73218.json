			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "長期招募工人負責防沙壁的維護工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181602,
					"content": "食宿免費，工資優渥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181603,
					"content": "工作認真突出者還能由本官推薦獲得進入教令院進修的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
