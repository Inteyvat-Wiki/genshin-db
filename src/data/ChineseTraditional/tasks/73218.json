			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "「出售沙漠冒險大禮包，為往來商旅提供最貼心的沙漠冒險解決方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181002,
					"content": "「凡是購買大禮包的顧客，本店保您冒險路上有去有回，如若不然，必有賠償。現在訂購還有折扣哦。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "「聽說在沙漠那邊有個魔鱗病醫院，是以前教令院設立的專門用來收治魔鱗病的醫院，但是後來不知道因為什麼原因廢棄了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181102,
					"content": "「聽阿如村的人說，曾經還有被治癒的魔鱗病患者從那裡逃出來。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181103,
					"content": "「要是那裡留下了什麼資料的話，說不定就能找到治療這種疾病的方法了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "「聽說有我們阿如村的人在教令院當了大官，這下我們沙漠的人說不定要翻身了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181202,
					"content": "「天天搬這些破石頭又賺不到錢，要是能讓我販運點什麼知識罐頭之類的東西出去，只要幹成一次就能回老家結婚了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181203,
					"content": "「但是我聽說那位大人當的就是緝私的官，而且怎麼看也不會偏袒我們。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181204,
					"content": "「嘖，我們沙漠人就是不團結才會變成現在這樣的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "前往沙漠的冒險家請注意，根據教令院規定前往大赤沙海的冒險活動皆需在教令院備案方可進行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181302,
					"content": "在沙漠遺蹟中發現的文物原則上皆歸屬教令院所有，任何人不得佔為己有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181303,
					"content": "由於安全問題，教令院已對大赤沙海外的其他沙漠地區發佈了禁令，嚴禁前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181304,
					"content": "如若不聽勸告，在這些地區發生任何意外，教令院不承擔任何責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
