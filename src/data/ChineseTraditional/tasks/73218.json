	"talks": [
		{
			"id": 7321801,
			"completionStepIds": [
				7321801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
