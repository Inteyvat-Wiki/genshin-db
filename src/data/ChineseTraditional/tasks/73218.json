			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "「以魔瓶君王的名義，我已赦免你們的罪，但我們的罪又當由誰來赦免？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
