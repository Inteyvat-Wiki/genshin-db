					"聰子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "欸？原來你們都在這裡了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120502,
					"content": "聚在一起敘舊，想想過去的事，是我們保持了很多很多年的習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120503,
					"content": "我們的家鄉，在一場災難之後全都被毀了。沒有了能回去的地方，只能把有家鄉人的地方當成是家鄉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120504,
					"content": "我聽他們兩個人說了，你們是在尋找信物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "聰子"
				},
				{
					"id": 111120505,
					"content": "我現在是璃月港的霄燈工匠，能夠代表我的東西，大概就是霄燈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "聰子"
				},
				{
					"id": 111120506,
					"content": "前幾天我購買了幾塊品質上乘的浮生石片，現在就放在碼頭的倉庫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "聰子"
				},
				{
					"id": 111120507,
					"content": "我已經和管理員說過了，能不能麻煩你們再跑一趟，幫我把它拿來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "聰子"
				},
				{
					"id": 111120508,
					"content": "#看來已經不需要解釋什麼了，{NICKNAME}，我們快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
