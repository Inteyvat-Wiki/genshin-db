			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "事情發展成這樣，我已經完全不明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120102,
					"content": "沒想到就這樣找到了狼哥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "這倒是和我想的完全一樣，記得我之前說的嗎？世上哪有那麼多惡鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120105,
					"content": "他只是因為某種機緣巧合從無妄坡跑了出來，又因為某種原因回不去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120106,
					"content": "這種解釋是不是太牽強了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120107,
					"content": "其實…和她說得差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120109,
					"content": "哼哼，切勿質疑我的業務能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120110,
					"content": "我只是很想知道我的朋友現在過得好不好，就很想來璃月港看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120111,
					"content": "我發誓我從來沒有想做壞事或者惡作劇的想法！也絕不主動驚嚇普通人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120112,
					"content": "前幾天有幾個人來無妄坡試膽，聽說他們都是從璃月港來的，我就跟著其中一個人，一路尾隨到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120113,
					"content": "就是那個可憐的洛成吧，雖然沒有親眼看到，但是肯定還是感覺到有人在跟隨他，所以才會做惡夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120114,
					"content": "欸？我、我被發現了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120115,
					"content": "不然也不會嚇成那個樣子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120116,
					"content": "為什麼不直接來找老孟？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "對哦，結果是胡桃和老孟在到處找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120118,
					"content": "這個，其實是因為我沒有找到他們。我從來沒有來過璃月港，然後就在城裡迷路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120119,
					"content": "哦對，這麼說起來，狼哥小時候就分不清楚東南西北。要是我們不帶著他，他都不敢自己下山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120120,
					"content": "居然是這麼現實的理由？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120121,
					"content": "但是鬼怪幽靈好像都會飛吧，只要飛起來，不就能找到路了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120122,
					"content": "我、我不敢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120123,
					"content": "太高了，我會很害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120124,
					"content": "對對對，是的，小時候就只有他不敢從山上往下看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120125,
					"content": "哈哈哈，你果然一點都沒變啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120126,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "我知道我不應該主動出現在人的面前，但是璃月港來來往往的人又那麼多，我就只能找地方躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120129,
					"content": "直到我被地脈鎮石吸引過去，發現了你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120130,
					"content": "原來你沒有變成惡鬼，太好了，真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120131,
					"content": "都說了要相信我的專業判斷嘛。接著只要把這個迷路的孩子送回無妄坡，就什麼都解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120132,
					"content": "不過，他剛剛說，是來看朋友的，那就應該不只是我，還有小五，木木，聰子三個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111120133,
					"content": "那…既然如此，為了滿足狼哥的心願，就幫他辦一場歡送儀式吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120134,
					"content": "我和老孟把狼哥送回無妄坡，你去找這三個人各要一件能象徵他們的信物，然後來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120135,
					"content": "都是朋友，直接叫上他們不好嗎？或者，直接帶狼哥去見他們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120136,
					"content": "這…還是不要了吧，我怕嚇壞他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111120137,
					"content": "我可不希望普通人都變得疑神疑鬼。不該知道的事，不知道更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120138,
					"content": "所以，你們獲取信物的時候，也務必注意方法哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120127,
					"content": "還是別叫「狼哥」了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "狼哥不是惡鬼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "你好，你還記得我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120202,
					"content": "你們…抱歉，我真的不需要往生堂的服務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120203,
					"content": "我們聽說了老孟的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "嗯，我和老孟從小一起長大，現在還經常聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120206,
					"content": "不知道他什麼時候去了往生堂，說實話，我覺得那裡的堂主是個很古怪的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120207,
					"content": "但他可能也有他的理由吧，畢竟現在就他一個人，還有點放不下狼哥的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120208,
					"content": "他告訴你們狼哥的事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120209,
					"content": "嗯嗯，我們都聽說了。那假如說，如果讓你選一件信物交給狼哥，你會選什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120210,
					"content": "只是假如，打個比方，絕對不是我們真的要去紀念他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120211,
					"content": "（這根本就是明示了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "我啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120214,
					"content": "應該會為他做一道菜吧，他是我們當中最能吃辣的，很喜歡吃辣度加倍的香嫩椒椒雞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120215,
					"content": "如果你們能幫我找一些絕雲椒椒來的話，我就能幫你們做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120216,
					"content": "保證是小時候的味道，他一定會很喜歡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120217,
					"content": "好，那等我們一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111120212,
					"content": "（派蒙還是老樣子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "老孟說和你是很多年的好朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
			"completionStepIds": [
				1111203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111203",
							"2"
