						111122302
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111122302,
					"content": "但你那一個，價值上來說，已經是我們的很多很多倍了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
