			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法斯賓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705300201,
					"content": "旅行者！旅行者，請留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300202
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300202,
					"content": "你這裡在舉辦什麼活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300203
					]
				},
				{
					"id": 705300203,
					"content": "舉辦活動？不不不，我可沒那個精力，也沒那個能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300204
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300204,
					"content": "我就是對「留影」這件事很有興趣，前段時間還託人弄了一台「留影機」回來，拍了好多畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300205
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300205,
					"content": "但協會裡的人似乎還滿喜歡這種畫片…賽琉斯先生說，可以把這些畫片整理成冊，以後當做紀念品送出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300206
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300206,
					"content": "最近正好是風花節，賽琉斯先生就請我去蒙德各處拍一些和風花節有關的畫片回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300207
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300207,
					"content": "他想要整理一本風花節紀念畫片集，送給協會裡的各位冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300208
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300208,
					"content": "但是…蒙德雖然有很多可以拍的地方，但我只有一個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300209
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300209,
					"content": "協會裡的冒險家們也都去忙自己的事了，沒有空幫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300210
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300210,
					"content": "#雖然在風花節期間拜託人幫忙很不應該啦…但是旅行者！我聽說{F#妳}{M#你}很擅長使用「留影機」，請{F#妳}{M#你}幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300211,
						705300213
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300211,
					"content": "我的確略懂，略懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300212
					]
				},
				{
					"id": 705300212,
					"content": "呼…那就好那就好，還好我打聽得沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300216,
					"content": "#咳，說正事…旅行者，那我就正式拜託{F#妳}{M#你}，幫我去蒙德各處用「留影機」拍畫片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300217
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300217,
					"content": "#對了，{F#妳}{M#你}就用我的這台「留影機」去拍畫片吧，我平常一直都有在維護它，用起來很順手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300218
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300218,
					"content": "#想要拍出好畫片，那首先就要有一台好「留影機」，{F#妳}{M#你}說對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300219
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300219,
					"content": "#那就辛苦{F#妳}{M#你}了啊，只要和風花節有關，無論什麼畫片都可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300220
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300220,
					"content": "#報酬什麼的{F#妳}{M#你}也不用擔心，我會按照協會裡的規矩算給{F#妳}{M#你}，保證不讓{F#妳}{M#你}白跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300221
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300221,
					"content": "我得先在這裡整理一下畫片，先分個類…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300213,
					"content": "你是從哪聽說的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300214
					]
				},
				{
					"id": 705300214,
					"content": "我是聽協會裡的冒險家們說的，他們之中也有不少「留影機」愛好者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300215
					],
					"speakerTitle": "法斯賓"
				},
				{
					"id": 705300215,
					"content": "我們還打算成立「留影機」愛好協會呢，也不知道賽琉斯先生同不同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "法斯賓"
				}
			]
		}
	]
}