			"completionStepIds": [
				7053002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053002",
							"2"
						],
						"stepId": 7053002,
						"stateName": "QUEST_STATE_UNFINISHED"
