				"points": []
			},
			"dialogs": [
				{
					"id": 736780101,
					"content": "#旅行者，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780102
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780102,
					"content": "告訴你們一個好消息，因為之前找到了雪豬存活的確鑿證據，剛剛我收到了導師的來信，我的論文選題已經在學院通過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780103
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780103,
					"content": "哇，聽起來很順利呀，真是恭喜你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736780104,
					"content": "嗯，雖然說開頭挺不錯，不過後續的研究工作應該還會持續很長時間，我也做好了長期留在蒙德的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780105
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780105,
					"content": "接下來我要弄清楚的，就是雪豬們到底是以何種路徑離開雪山，出現在了森林裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780106
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780106,
					"content": "根據之前找到的痕跡，我推測牠們是從龍脊雪山的西側下山，途徑晨曦酒莊，然後再前往清泉鎮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780107
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780107,
					"content": "如果這個推斷是正確的，我們應該能夠在附近發現牠們的蹤跡，所以今天我們的目標，就是調查這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780108
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780108,
					"content": "原來如此。說起來你身邊這位獵人打扮的大叔是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736780109,
					"content": "#{F#妳}{M#你}們好，我叫瓦爾特，最近負責保護晨曦酒莊附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780110
					],
					"speakerTitle": "瓦爾特"
				},
				{
					"id": 736780110,
					"content": "#{F#妳}{M#你}們找雪豬的事，埃德蒙德那小子已經和我說了，今天{F#妳}{M#你}們就跟我一起行動吧，剛好我這裡也很缺乏人手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780111
					],
					"speakerTitle": "瓦爾特"
				},
				{
					"id": 736780111,
					"content": "唉，昨天晚上有野林豬闖進了附近的農舍，把居民養的鴿子和鴨子都嚇飛了，到現在還沒全部找回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780112
					],
					"speakerTitle": "瓦爾特"
				},
				{
					"id": 736780112,
					"content": "#旅行者，待會我們去捕獵的時候，如果{F#妳}{M#你}發現了這些小動物，就捉住牠們一起帶回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780113
					],
					"speakerTitle": "瓦爾特"
				},
				{
					"id": 736780113,
					"content": "沒問題，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780114
					]
				},
				{
					"id": 736780114,
					"content": "#聽說{F#妳}{M#你}會用獵人的捕獵工具，我在附近也放了一些，到時候{F#妳}{M#你}可以自行取用。等{F#妳}{M#你}做好準備，我們就可以出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780115,
						736780116
					],
					"speakerTitle": "瓦爾特"
				},
				{
					"id": 736780115,
					"content": "準備好了，出發吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736780116,
					"content": "等等，我還有些其他事要做。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780117
					]
				},
				{
					"id": 736780117,
					"content": "#嗯，別著急。我就在這等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦爾特"
				}
			]
		}
	]
}