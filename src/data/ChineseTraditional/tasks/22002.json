			"dialogs": [
				{
					"id": 220020301,
					"content": "#{F#妳}{M#你}找到蓮蓬了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020302,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020304,
					"content": "小蒙，阿飛，快點過來吃蓮蓬啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020305,
					"content": "喂…喂，我們還是在搶劫吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220020306,
					"content": "喔，對啊。那這些錢和東西給你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020307,
					"content": "#{F#大姐姐}{M#大哥哥}扮海盜真厲害，從一個小孩子手裡搶走了這麼多東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020308,
					"content": "總感覺這孩子…話裡有話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220020309,
					"content": "#這次辛苦{F#大姐姐}{M#大哥哥}啦，下次也要陪我們一起玩呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				}
			]
