			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"璐璐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "那我們就開始玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020203,
					"content": "#那麼，就請{F#大姐姐}{M#大哥哥}開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020204,
					"content": "妳好，搶劫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "哼，大白天的就來搶劫，千岩軍的叔叔們就在旁邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220020206,
					"content": "璐璐，快過來，我們快點跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220020207,
					"content": "#{F#妳}{M#你}好，{F#妳}{M#你}是來搶什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020208,
					"content": "呃，應該是錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "可是我沒多少錢可以搶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020213,
					"content": "爸爸說，在船上，最值錢的東西是商人們運的貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020214,
					"content": "#唔，這樣吧。{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}幫我去找點值錢的東西回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020215,
					"content": "這樣子，我就有能被搶走的東西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020216,
					"content": "#我想想…那麼，{F#妳}{M#你}就找點蓮蓬回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020217,
					"content": "#我們三個人都很喜歡吃蓮蓬，{F#大姐姐}{M#大哥哥}作為一個大壞蛋海盜，搶蓮蓬最合適不過啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020209,
					"content": "來搶妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "#{F#大姐姐}{M#大哥哥}，雖然是玩遊戲，但是也要注意喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020211,
					"content": "#{F#妳}{M#你}看，旁邊千岩軍的叔叔們，都往這邊看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "璐璐"
				}
			]
		},
