				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "璐璐，怎麼又是我做船長啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220020102,
					"content": "因為小蒙做船長的時候，我們才玩得最開心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020103,
					"content": "璐璐覺得沒問題，那我…那我也沒問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220020104,
					"content": "你們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "#{F#大姐姐}{M#大哥哥}，我們正準備玩遊戲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020106,
					"content": "小蒙是船長，阿飛是服務員，我是個有錢的商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020107,
					"content": "只缺一個海盜來搶劫我們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020108,
					"content": "#{F#妳}{M#你}願意扮海盜，來陪我們玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020113,
					"content": "#好啦，{F#大姐姐}{M#大哥哥}準備好了，就來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220020111,
					"content": "我想做個好人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#只是玩個遊戲啦，我知道{F#大姐姐}{M#大哥哥}一定是個好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "璐璐"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
