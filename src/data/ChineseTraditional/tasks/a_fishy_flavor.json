				"points": []
			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "汝等回來了啊。真奇怪，那群小傢伙突然都跑回來了，還一副很害怕的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420402,
					"content": "難道，是在野外遇見了那種拿著棒子的毛茸茸人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420403,
					"content": "不過，這群小傢伙回來了也好…汝怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420404,
					"content": "其、其實是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "…真是難捉摸的人類啊！為什麼會想做這件事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420406,
					"content": "想要和這群小傢伙玩的話，就用普通的方式好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420407,
					"content": "喵！怪不得那群小傢伙被嚇成這樣…奴家還要去安慰一下牠們才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420408,
					"content": "真是的，果然不能期望所有的人類都和阿響一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		}
