					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420101,
					"content": "真是群不聽話的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "是汝等啊，那群小傢伙們又跑出去玩了，真是愈來愈不聽話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420104,
					"content": "要我幫什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "有了掛在神社外面的那些鐵球，那群小傢伙們應該知道怎麼回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420107,
					"content": "那群小傢伙們，在外面瘋一瘋也好，免得到時候神社裡來了人類，牠們在人類面前瘋玩，失了神社的威儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420108,
					"content": "但牠們要是玩得太過頭…從太陽還在天上，一直餓到月亮到了天上就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420109,
					"content": "汝等，幫奴家把這些魚帶過去，給那群小傢伙們吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "接下來就把地圖給寢子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220420112,
					"content": "唔，汝還算是有點悟性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420115,
					"content": "好了，汝等快點去吧，奴家還得在這打理神社呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420113,
					"content": "這是地圖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "唔，汝還算是有點悟性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420105,
					"content": "我去找牠們回來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
