			},
			"dialogs": [
				{
					"id": 220420301,
					"content": "汝等回來了，餵過那群小傢伙了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420302,
					"content": "餵過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "這樣就好了，謝謝汝等了，要不然這群小傢伙肯定又會一直瘋玩，然後在野外挨餓了，謝謝汝等幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220420304,
					"content": "唉，真是一群不聽話的小傢伙啊，這樣子怎麼能接待來神社的人類呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
