					}
				]
			},
			"dialogs": [
				{
					"id": 705350201,
					"content": "嗯嗯！可莉知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350202
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350202,
					"content": "但是…魚還是剛剛炸上來的最新鮮嘛，放火上烤一烤，又脆又香又好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350203
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350203,
					"content": "不用擔心，小可莉，琴早就和我叮囑過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350204
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350204,
					"content": "我已經向「獵鹿人」下單了，這幾天，大廚會挑選剛從湖裡釣上來的好魚，快快入鍋烹飪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350205
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350205,
					"content": "配上可莉最喜歡的調味粉和醬料，還有我準備的特製茶點，一定和妳炸魚時的收獲一樣美味~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350206
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350206,
					"content": "好！那就聽麗莎阿…麗莎姐姐的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350207,
					"content": "這幾天，可莉一定專心在城裡玩「嘟嘟可轟轟奇遇記」，不去炸魚，不給阿貝多哥哥的朋友添麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350208
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350208,
					"content": "#那可莉出發去找榮譽騎士{M#哥哥}{F#姐姐}和小派蒙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350209
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350209,
					"content": "嘿嘿，誰要找我們呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350210,
						705350211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350210,
					"content": "難得看見妳們兩個待在一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				},
				{
					"id": 705350212,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}！還有小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350213
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350213,
					"content": "#可莉剛剛在想{F#妳}{M#你}們，{F#妳}{M#你}們就出現了，是有什麼魔法幫可莉把消息傳給{F#妳}{M#你}們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350214
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350214,
					"content": "#啊呀？小可愛和派蒙，{F#妳}{M#你}們來得可真是時候，都不用辛苦我寫信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350215,
						705350216
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350215,
					"content": "是可莉的心意召來了我們！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350217,
					"content": "我們兩個有點閒，原本想來圖書館找書看…但「嘟嘟可轟轟奇遇記」是怎麼回事？聽起來比普通的書有趣多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350218,
					"content": "是麗莎姐姐幫我做的新遊戲哦，名字是我們一起想的。小派蒙一下子就記住了，好聰明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350219,
					"content": "原來麗莎還會設計遊戲啊！我還以為麗莎的博學…是書看得多的那種！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350220,
					"content": "呵呵，我只是參考了學生時期用來消遣的一款遊戲「滾滾炸炸菇」，改進了它的設計，沒有花費多少心力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350221
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350221,
					"content": "只要能讓小可莉開開心心地度過這段「特殊時期」，要我再多設計幾種也沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350222
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350222,
					"content": "「特殊時期」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350223
					]
				},
				{
					"id": 705350223,
					"content": "對哦，我想起來了。剛剛妳們好像還提到了阿貝多的朋友？最近蒙德發生了什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350224,
					"content": "這次的意外嘛，說來不大不小，但確實要謹慎處理——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350225
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350225,
					"content": "近期，果酒湖裡出現了來自須彌的魚類，放任牠們肆意繁殖的話，有可能威脅到蒙德水域的生態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350226
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350226,
					"content": "還好小可莉悄悄溜出去玩的時候，發現了沒看過的魚，嗯…抓了兩條上來，問了問凱亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350227
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350227,
					"content": "不然，等到一般人發現牠們的時候，說不定湖裡的原住民已經被趕到不起眼的角落裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350228
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350228,
					"content": "假如水下的生物群體發生了變化，影響到果酒湖的水質，進而影響酒業…這就是關乎蒙德經濟的大問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350229
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350229,
					"content": "嘿嘿，這一次可莉有功！琴團長知道了以後，還特別表揚了可莉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350230,
						705350231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350230,
					"content": "可莉立大功！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350232,
					"content": "居然還有這種事？真是好險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350233,
					"content": "目前，調查小隊派出了一些隊員，正對果酒湖進行勘測，找出這些魚類「入侵者」的老巢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350234
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350234,
					"content": "這段時間，為防驚擾「入侵者」，可莉就不能帶著她的「寶物」到處跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350235
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350235,
					"content": "調查小隊使用的儀器非常靈敏，湖邊一定距離內的爆炸也會對勘測造成影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350236
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350236,
					"content": "琴說，一直讓小可莉悶在城裡，她一定會覺得無聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350237
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350237,
					"content": "阿貝多正忙著改進游擊小隊的實驗型裝備，凱亞剛好也去出差了，照看她的任務，就落在了姐姐我的肩上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350238
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350238,
					"content": "#現在不無聊啦！麗莎姐姐發明了「嘟嘟可轟轟奇遇記」，可莉很期待！想跟榮譽騎士{M#哥哥}{F#姐姐}和小派蒙一起玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350239,
						705350240
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350239,
					"content": "一起玩吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350241,
					"content": "嗯，「嘟嘟可轟轟奇遇記」的遊戲桌就放在花園那邊，我在「獵鹿人」下的訂單，也會送到那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350242
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350242,
					"content": "一邊享受美食、花香和清風，一邊和小可莉玩遊戲，這麼難得的機會，可要好好享受一番哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350243
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350243,
					"content": "咦，麗莎這話的意思…是不和我們一起去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350244,
					"content": "#身為遊戲的設計者，我參與的話未免有點犯規啦，會影響到{F#妳}{M#你}們遊玩時的驚喜哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350245
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350245,
					"content": "而且，我這個圖書管理員還是要待在崗位上，盡到我最基本的職責嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350246
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350246,
					"content": "聽起來像是妳又在找理由不出門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350247,
					"content": "#乖，{F#妳}{M#你}們安心陪著小可莉去玩就好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350248,
						705350249
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705350248,
					"content": "好耶，麗莎姐姐放心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350250,
					"content": "好吧，那我們之後再見哦，麗莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350249,
					"content": "嗚嗚，辛苦麗莎姐姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350240,
					"content": "玩到天黑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350231,
					"content": "琴團長誇誇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350216,
					"content": "是巧合的魔法找來了我們！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350211,
					"content": "好像達成了什麼重要的約定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				}
			]
		},
		{
			"id": 7053503,
			"completionStepIds": [
				7053503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053503",
							"2"
						],
						"stepId": 7053503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2208.195,
							230.089,
							-803.176
						],
						"pointId": 5744
					}
				]
			},
			"dialogs": [
				{
					"id": 705350301,
					"content": "#就是這裡了，榮譽騎士{M#哥哥}{F#姐姐}，這就是「嘟嘟可轟轟奇遇記」的遊戲桌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350302,
					"content": "嗯！這裡的環境確實很好，遊玩的體驗一定很不錯，麗莎選起地方來真是沒得挑呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350303,
					"content": "那就拜託小可莉教我們基本的玩法了！",
