			"dialogs": [
				{
					"id": 752510101,
					"content": "喝！海內兄弟，繼續喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510102
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510102,
					"content": "嗚哇！你是誰？怎麼從樹上掉下來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752510103,
					"content": "我是帕帕啊，海內兄弟，我們不是說好再喝一輪嗎？今天我們相見恨晚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510104
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510104,
					"content": "唔…？嗯…？",
					"roleType": "TALK_ROLE_NPC",
