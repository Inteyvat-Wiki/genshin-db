						752510105
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510105,
					"content": "嗯…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "#海內兄弟，{F#妳}{M#你}怎麼變成兩個了？一個高海內…一個矮海內…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510107
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510107,
					"content": "喂！你認錯人了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752510108,
					"content": "欸？噢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510109,
					"content": "海內兄！你在哪？我們繼續喝啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510110
					],
					"speakerTitle": "帕帕"
				},
				{
					"id": 752510110,
					"content": "從樹上掉下的醉漢搖搖晃晃地走遠了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
