			"dialogs": [
				{
					"id": 4700101,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700102,
					"content": "是<color=#00E1FFFF>漁人吐司</color>的香氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700103,
					"content": "嗯…嗯。是從「獵鹿人」餐館的方向飄來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700104,
					"content": "鬆軟的吐司麵包切成厚片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700105,
					"content": "鋪滿洋蔥，烤到微焦之後放進嘴裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700106,
					"content": "好，我決定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700107,
					"content": "事不宜遲，就去<color=#00E1FFFF>「獵鹿人」</color>買一份<color=#00E1FFFF>漁人吐司</color>吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4700108,
					"content": "#當然，是{F#妳}{M#你}請客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
