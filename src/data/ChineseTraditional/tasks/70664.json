{
	"id": 70664,
	"type": "WQ",
	"name": "秘境來風",
	"description": "#在璃月，{F#妳}{M#你}遇見了一位冒險家…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5095,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
