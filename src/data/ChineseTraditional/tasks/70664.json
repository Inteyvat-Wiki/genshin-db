	],
	"talks": [
		{
			"id": 7066401,
			"completionStepIds": [
				7066401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066401",
							"2"
						],
						"stepId": 7066401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706640101,
					"content": "每次都派我來解決這種麻煩的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640102,
						706640103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640102,
					"content": "咦？你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				},
				{
					"id": 706640104,
					"content": "#是{F#妳}{M#你}啊！這可真是太巧了，沒想到會在這裡遇見{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640105,
					"content": "你在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640106
					]
				},
				{
					"id": 706640106,
					"content": "#唉，別提了。{F#妳}{M#你}還記得上次那個奇怪的秘境吧？就是…就是那個內部結構會隨人心意變化的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640107,
					"content": "#多虧了{F#妳}{M#你}幫我進入那個秘境探索，我才獲得了不少的情報。在那個秘境消失之後，我就回去向嵐姐覆命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640108
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640108,
					"content": "#我反覆和她說，這件事都是多虧了{F#妳}{M#你}幫忙，我只是做了一點微不足道的輔助工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640109,
					"content": "但嵐姐根本不聽我的，還說什麼她很認可我的工作，然後要我帶一隊人繼續負責探索這類未知的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640110,
						706640111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640110,
					"content": "聽上去不錯啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640112,
					"content": "好什麼啊。我原本就是一個普普通通的冒險家，無拘無束，愛幹嘛就幹嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640113
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640113,
					"content": "雖然之前是賺得少了點，但勝在自由啊。現在嵐姐給我安了這麼個頭銜，我推也推不掉，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640114,
					"content": "#先不說這些，我們說正事。{F#妳}{M#你}看見我旁邊這道門了嗎？門後也是一個奇怪的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640115,
					"content": "這個秘境裡面，佈滿了「風場」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640116,
					"content": "是我理解的那種「風場」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640117
					]
				},
				{
					"id": 706640117,
					"content": "對，就是野外那種…呼呼呼吹來吹去的風場，冒險家們使用風之翼的時候，經常借助它們飛得更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640118,
					"content": "不過這座秘境裡的「風場」的分佈十分混亂，有些風場發出的風甚至會彼此衝撞，形成一個阻飛區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640119,
					"content": "我請了幾位擅長操控風之翼的冒險家進去探索，但他們都沒有探索多遠就被迫退了回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640120
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640120,
					"content": "據他們說，這座秘境裡還分佈著一些機關。在啟動這些機關後，一些風場的狀態好像也發生了變化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640121
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640121,
					"content": "但還沒等他們弄清楚那些機關的具體用途，大量的魔物就突然出現，他們只能撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640122,
					"content": "我們討論之後認為，如果能活用這些機關，也許就能更加順利地探索這座秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640123,
						706640124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640123,
					"content": "你進去探索過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640125,
					"content": "#哎呀，{F#妳}{M#你}又不是不知道，我那個…身體素質不太行，也不太會操縱風之翼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640126
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640126,
					"content": "一般的飛行行動我倒是能夠應付，但以這座秘境裡的風場分佈情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640127
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640127,
					"content": "如果我進去探索，大概只會被吹得漫天亂飛，然後再一頭栽進魔物堆裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640128
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640128,
					"content": "#旅行者，我上次見識過{F#妳}{M#你}的實力。{F#妳}{M#你}的體力不錯，頭腦也很靈活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640129
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640129,
					"content": "#如果{F#妳}{M#你}願意的話，能再幫忙我探索一下這座秘境嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640130
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640130,
					"content": "#報酬的話{F#妳}{M#你}不用擔心，和上次一樣，我保證幫{F#妳}{M#你}備足報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640131,
						706640133
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640131,
					"content": "那我試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640132
					]
				},
				{
					"id": 706640132,
					"content": "#太好了，那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640133,
					"content": "裡面有寶物嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640134
					]
				},
				{
					"id": 706640134,
					"content": "這個我就不清楚了，畢竟我們還沒有在這秘境裡探索多遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640135
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640135,
					"content": "#呃…放心！如果{F#妳}{M#你}在探索的過程裡發現了任何寶物，都可以直接收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640136
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640136,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640124,
					"content": "你沒有打頭陣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640111,
					"content": "這應該是好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640103,
					"content": "又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				}
			]
		}
	]
}