			"dialogs": [
				{
					"id": 701140201,
					"content": "多謝桑多涅小姐的招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "好，我們後會有期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
			]
		}
	]
