			"dialogs": [
				{
					"id": 701140101,
					"content": "桑多涅小姐居然能抽空到蒙德來，真是不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140102,
					"content": "之前在我研究「數秘陣列」的時候，你幫了我很多忙，我想當面向你表示感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140103,
					"content": "不必客氣。這項課題本就是我專業之外的領域，它能完成更多還是桑多涅小姐妳的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140104,
					"content": "這是大家的功勞。咦？這麼說來怎麼沒見杜林？我還以為他不能離你太遠，你算是他的監護人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140105,
					"content": "妳的看法也不能說有錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140106,
					"content": "但最近他已經越來越能融入大家的談話了，所以我在試著讓他自己安排日常生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140107,
					"content": "你不會擔心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140108,
					"content": "會有一點。以前他獨自行動，和一些性格較為強烈的人接觸過後，就會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140109,
					"content": "學到一些奇奇怪怪的東西？模仿奇奇怪怪的口頭禪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140110,
					"content": "嗯，很準確。桑多涅小姐也經歷過類似的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140111,
					"content": "呵，還用說嗎？我太懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140112,
					"content": "一般和法爾伽團長見面過後，我會時不時帶杜林去砂糖那協助做些研究，讓他靜靜心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140113,
					"content": "但和琴團長待太久的話，我又會帶他去見見可莉，讓他重新學會放鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140114,
					"content": "你也真是不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140115,
					"content": "照顧家人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140116,
					"content": "桑多涅小姐又是怎麼處理此類事情的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 701140117,
					"content": "啊？我才沒心情去管這些亂七八糟的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140118,
					"content": "但在我看來，只要一個人本性不壞，就算受到再多影響，最終也還是會回歸到他最真實的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 701140119,
					"content": "唔…不錯的觀點。或許我也該嘗試採納此種想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				}
			]
		},
