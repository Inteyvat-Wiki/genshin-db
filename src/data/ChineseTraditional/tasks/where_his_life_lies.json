					],
					"speakerTitle": "梅莘"
				},
				{
					"id": 741180502,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "向梅莘警官敘述了事情的經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "原來是那位加爾恰先生的事啊，我明白了，我們一起去他那邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
