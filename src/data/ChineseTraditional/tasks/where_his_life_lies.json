			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"路通",
					"加爾恰"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3535.805,
							430.426,
							4553.841
						],
						"pointId": 5693
					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "…先生，也許我們應該先去佩特莉可鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180102,
					"content": "雖然澤維爾先生和菲利斯先生都不在，但梅康頓和巴比斯先生應該還在鎮上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180103,
					"content": "也許他們可以給您一些建議或啟發，就算是最壞的情況，您也有了兩位可以吐苦水的對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180104,
					"content": "不，親愛的路通，不…梅康頓和巴比斯的研究現在正如火如荼地進行中啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180105,
					"content": "他們上次寫信告訴我，佩特莉可鎮裡來了一位從楓丹科學院來的聰明人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180106,
					"content": "這位叫博絮埃的先生頗有學識和見解，幫他們解決了很多問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180107,
					"content": "而我…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180108,
					"content": "加爾恰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}，真是幸會。沒想到可以在楓丹遇見{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180111,
					"content": "雖然…您來的時機實在太湊巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180112,
					"content": "#沒錯，非常湊巧…但還是很高興能夠遇見{F#妳}{M#你}，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180113,
					"content": "嗚哇，他看起來好像很疲憊，黑眼圈也好重…整個人都無精打采的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180114,
					"content": "加爾恰怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "我們…呃，先生的研究遇到了一些…前所未有的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180116,
					"content": "但此事說來話長…我們現在正打算去歐庇克萊歌劇院為他們清算帳目呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180117,
					"content": "在結束工作之後，我們可以找個安靜的地方好好聊一聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180118,
					"content": "你們有其他工作了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "不算是工作，只是到處被人僱去幫忙算數罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180120,
					"content": "最近歐庇克萊歌劇院裡接待了不少劇團，急需做一次整體的帳目清算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180121,
					"content": "所以為了籌措回佩特莉可鎮的費用，我們…我，代加爾恰先生接下了這份委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180122,
					"content": "真是大材小用！那些算數簡單至極，我就算不用計數器，一個下午也可以全部算完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180123,
					"content": "所以這也正是我們籌措經費的好方法，我們快點出發吧，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180124,
					"content": "#對了，{NICKNAME}，我可以請您和我們同行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180125,
					"content": "有您這位聲名不凡的朋友同行，我們也許就不用遭遇一些不必要的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180126,
					"content": "相應的報酬我們也會付給您的，請放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180127,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "這我可不確定…呵呵，總之我們快點出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180128,
					"content": "城裡應該不會出什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "你回楓丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
			"completionStepIds": [
				7411802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
