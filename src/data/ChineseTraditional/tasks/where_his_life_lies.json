						"rawParams": [
							"7411802",
							"2"
						],
						"stepId": 7411802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通",
					"加爾恰",
					"迦雅"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
							461.138,
							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "不得不說這間劇院真的很氣派，賺的錢一定也不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180202,
					"content": "劇院…唉，我們還是快點去工作吧，等了結了這份工作，我們就回佩特莉可鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180203,
					"content": "然後，我就會在鎮上開一家麵包店，從此不再理會什麼計數器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180204,
					"content": "呃…先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180205,
					"content": "路通，你怎麼了？你這副表情…難不成見鬼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180206,
					"content": "真是…見鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180207,
					"content": "加爾恰…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180208,
					"content": "迦雅小姐？！她為什麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180209,
					"content": "這還真是太巧了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "先生，您剛才的發言還真是不太得體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180211,
					"content": "哦，閉嘴，路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180212,
					"content": "#加爾恰，真高興可以在這裡遇見你，還有{NICKNAME}。我猜，你是來幫歌劇院清算帳目的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180213,
					"content": "難道他要清算的帳目就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "並不是。我們劇團並沒有在這間歌劇院演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180215,
					"content": "只不過，以我對加爾恰的瞭解，他從來不是那種會在閒暇時間看歌劇的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180216,
					"content": "之所以會來歌劇院…也只可能是被人僱來工作，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180217,
					"content": "我發自內心地覺得，您更適合代替我待在先生身邊，迦雅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180218,
					"content": "我們每個人都是無可取代的，親愛的路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180219,
					"content": "我…呃…迦雅，很高興見到妳，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180220,
					"content": "…但你看起來不太高興，你的研究似乎不太順利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180221,
					"content": "這妳也猜到了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "#唔…至少他不會因為看見我而感到不高興，也不會因為{F#妳}{M#你}或者路通而感到不愉快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180223,
					"content": "在加爾恰的生活裡，可以讓他這麼不開心的也只有那臺「計數器」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180224,
					"content": "迦雅小姐為什麼這麼瞭解加爾恰呀？明明分開了那麼久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180225,
					"content": "也許是她的直覺吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "您也許應該去咖啡館，坐下來慢慢談，這並不是三言兩語就可以說清楚的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180228,
					"content": "我還要…呃，不，我很高興…但我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 741180229,
					"content": "放心吧，先生。那些算數簡單至極，我一個人就可以搞定所有工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180230,
					"content": "…您總不能把迦雅小姐晾在一邊，直到我們工作結束吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180231,
					"content": "你真貼心，路通。我們會帶一杯咖啡回來給你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180232,
					"content": "謝謝您，小姐。祝您和先生喝得愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180233,
					"content": "加爾恰和迦雅一起離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "他們就這樣去喝咖啡了…好像從頭到尾都沒有我們什麼事耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180235,
					"content": "完全無關。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#不，{NICKNAME}。接下來才是正式的委託內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180238,
					"content": "要找什麼食材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "您真幽默。但我絕沒有任何浪費您時間的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180242,
					"content": "加爾恰先生和我，現在的確處於危險之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180243,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180244,
					"content": "我們去旁邊說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180239,
					"content": "要找什麼零件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "不然我去為他們留個影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "我在這裡幹什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "也許是加爾恰比較好懂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
