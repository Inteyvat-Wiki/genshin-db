					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "…這裡應該沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180302,
					"content": "讓我從頭說起吧。自從您在須彌幫我們改造了計數器後，這臺機器的效能出現了一個飛躍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180303,
					"content": "先生十分振奮，想要繼續改進。但就像他說的，傳統的機關傳動結構有所侷限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180304,
					"content": "這臺計數器的效能已經無法突破了，所以我們就想要回到楓丹尋求其他的研究方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180305,
					"content": "但是當我們回到楓丹後，有一個奇怪的人突然來找加爾恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180306,
					"content": "這個人表示自己可以為加爾恰先生提供研究的資金，甚至是幫他尋找其他合作者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180307,
					"content": "但與之相對地，加爾恰先生必須將計數器的所有設計概念和資料，都與他共享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180308,
					"content": "加爾恰一定不會接受。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "對啊！開口就想要人家的研究成果，這是在搶劫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180311,
					"content": "沒錯。所以加爾恰先生果斷地拒絕了這個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180312,
					"content": "但在那之後，似乎有人一直在尾隨著我和加爾恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180313,
					"content": "而且也有人趁我們離開時進入了我們的房間，並且翻找過什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180314,
					"content": "雖然那個人將所有東西都復原了，但還是被加爾恰先生發現痕跡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180315,
					"content": "好、好可怕…人家不願意把東西給他，他就直接過來搶嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180316,
					"content": "事實上，在發現房間被翻過之後，我們就決定盡快籌錢離開這裡，回到佩特莉可鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180317,
					"content": "等到了那裡之後，我們會聯絡空想俱樂部的其他幾位先生一同解決這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180318,
					"content": "而且佩特莉可鎮算是…呵呵，算是加爾恰先生的大本營。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180319,
					"content": "對他來說，沒有任何地方比佩特莉可鎮更安全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180320,
					"content": "本來今天就是出發日，我們正準備出發去佩特莉可鎮，所以才想請您做我們的護衛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180321,
					"content": "沒想到，居然在這裡遇見了迦雅小姐…為了安全起見，我只能讓加爾恰先生帶著迦雅小姐先回城裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180322,
					"content": "我可以做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "看來，我們的出發日期必須要延遲了。現在請您快趕去加爾恰先生身邊，就像我之前說的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180325,
					"content": "有您這位聲名不凡的朋友同行，我們也許就不用遭遇一些不必要的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180326,
					"content": "我會馬上趕過去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "加爾恰先生會把事情全部告訴迦雅小姐的。至於後面的事…就讓迦雅小姐自己決定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180331,
					"content": "總之，我們快點趕回城裡去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180327,
					"content": "他們應該不會真的遇到什麼危險吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "不會的。加爾恰先生目前還在楓丹廷內，那裡有不少警衛機關巡邏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180329,
					"content": "如果他們想要使用暴力手段，那執律庭就會代替我們解決大部分問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180323,
					"content": "我可以幫上什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "這個人聽起來就不像好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
