			"dialogs": [
				{
					"id": 200620501,
					"content": "到底怎麼訓練才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620502,
					"content": "妳在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "哦，我正在為了騎士選拔做訓練呢。但是怎麼樣都不得要領，而且也沒人指導我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620504,
					"content": "我爸一個勁說他是冒險家，他可以指導我，但是我才不信呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620505,
					"content": "他那樣子，怎麼可能指導我通過騎士選拔啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620506,
					"content": "他還說要幫我準備訓練用的東西，他到底會準備什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
