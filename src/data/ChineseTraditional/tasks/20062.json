			"trigger": {
				"objectNames": [
					"赫爾曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "到底怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "是這樣的…我女兒艾琳想要進入西風騎士團，正在為騎士選拔做準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620104,
					"content": "唉…我本來想要自己指導她，但是她怎麼樣也不相信我之前是個冒險家，堅持自己訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620105,
					"content": "我也沒辦法證明給她看…有了老婆孩子之後，我已經沒有到處肆意冒險的資本了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620106,
					"content": "比起滿足自己的冒險欲望和自尊心，好好照顧家庭才是我現在最重要的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620107,
					"content": "哈哈，不過我這個「冒險家」，終究還是能做點事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620108,
					"content": "我之前到處冒險的時候，留意過那些丘丘人用來訓練的木樁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620109,
					"content": "那些木樁看起來品質很不錯，肯定很適合艾琳用來訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620110,
					"content": "#幫我去找幾個丘丘人訓練木樁回來吧。按照冒險家的規矩，我也不會讓{F#妳}{M#你}幹白工的，{F#妳}{M#你}覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620111,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "#哦，我就喜歡爽快的人，{F#妳}{M#你}很有我當年剛入行時的風采…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620114,
					"content": "開玩笑，開玩笑，好了，快點去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620112,
					"content": "只是丘丘人，你自己也可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "不，不行不行，冒險家的能力也是有極限的。一位冒險家，同時只能應付一場冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620116,
					"content": "而「婚後生活」這場冒險…無論是多偉大的冒險家，都必須要全身心投入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620117,
					"content": "所以，搜集木樁就拜託你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫爾曼"
				}
			]
		},
		{
			"id": 2006202,
			"completionStepIds": [
				2006204
			],
