				"points": []
			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "#{F#妳}{M#你}找到木樁了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "#唔…哈哈，{F#妳}{M#你}看，看起來確實品質不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620204,
					"content": "這木樁能經得起丘丘人折磨，肯定也能經得起艾琳折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620205,
					"content": "#謝謝{F#妳}{M#你}，哦對了，按照冒險家的規矩，這是{F#妳}{M#你}的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫爾曼"
				}
			]
		},
		{
