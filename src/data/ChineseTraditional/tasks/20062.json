			"dialogs": [
				{
					"id": 200620301,
					"content": "#{F#妳}{M#你}找到木樁了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620302,
					"content": "找到了，可是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "#哈…{F#妳}{M#你}下手也太狠了，這麼結實的木樁都被打散了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620304,
					"content": "不過在戰鬥的時候，確實不會有人顧得上為了個木樁收手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620305,
					"content": "雖然不能直接給艾琳…但材料已經有了，我來加工一下就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620306,
					"content": "#勉強是組裝起來了，{F#妳}{M#你}看，呃…還是有點模樣的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620307,
					"content": "#總之謝謝{F#妳}{M#你}了。這是報酬，我說了不會讓{F#妳}{M#你}做白工的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "赫爾曼"
				},
				{
					"id": 200620308,
					"content": "雖然我不是冒險家了，但是冒險家的規矩可不能破壞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫爾曼"
				}
			]
		},
