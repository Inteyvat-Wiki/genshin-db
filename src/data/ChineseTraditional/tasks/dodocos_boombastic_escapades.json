						"position": [
							2209.107,
							230.089,
							-801.605
						],
						"pointId": 9306
					}
				]
			},
			"dialogs": [
				{
					"id": 705460101,
					"content": "方妮雅，我的好姐姐！妳難道不想成為「嘟嘟可砰砰歷險記」的第一位玩家嗎？試試看這款新作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460102
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460102,
					"content": "靈活機動的作戰方式、點對點的精準爆破、和狡猾遊走的敵人鬥智鬥勇，怎麼看都超級好玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460103
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460103,
					"content": "不要，我又不像妳，整天只想著和炸彈過日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460104
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460104,
					"content": "幫妳弄那些測試樣機和桌遊，已經屬於高強度加班了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460105
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460105,
					"content": "我現在只想叫一份「獵鹿人」的外送訂單然後回家，等到門被敲響時，我剛好洗完最後一件衣服，心情愉快地接過我的餐品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460106
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460106,
					"content": "至於這個轟轟砰砰的新遊戲，就等到下次和妳一起值班，閒得無聊時再玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460107
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460107,
					"content": "什麼新遊戲？聽得我都好奇了…可以讓我們也看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460108,
					"content": "#等等，是榮譽騎士和白色小幫手？居然真的能遇見{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460109,
						705460114
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460109,
					"content": "我想起來了，妳是「炸彈怪人」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460110
					]
				},
				{
					"id": 705460110,
					"content": "榮譽騎士認識我？看來上次我在「入侵角魨殲滅戰」的表現很出色…連您都聽說我的名字了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460111
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460111,
					"content": "我我我…我一定繼續加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460112
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460112,
					"content": "最近我正在持續改良炸彈的配方和設計，努力讓我和火花騎士大人的差距再縮小一點點，一點點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460113
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460113,
					"content": "總之上次行動過後，艾瑪托認為只靠遠距離投放炸彈，還是會有不小的作戰死角，而且面對一些遮蔽物和掩體時不夠有效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460119,
					"content": "所以她就開始弄新的裝備，為了驗證這種裝備，還特地改進了火花騎士愛玩的桌遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460120
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460120,
					"content": "沒錯！這幾天來我一直在分析火花騎士的戰鬥方式，想出了另一種炸彈的使用方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460121
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460121,
					"content": "火花騎士的習慣大概是「一份裝藥的威力不夠，就用三份；一枚蹦蹦炸彈解決不了，就丟三枚」，增加威力一定可以解決問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460122
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460122,
					"content": "但這對我們普通騎士來說太困難了，不能在威力上和火花騎士大人的蹦蹦炸彈匹敵，就只能用靈活度和準確度彌補缺點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460123
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460123,
					"content": "如果開發出一種能夠追蹤目標、接近目標設下炸彈的裝備，既可以精準打擊危險目標，又可以最大程度利用負重！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460124
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460124,
					"content": "追…追著敵人放炸彈的裝備？聽起來很厲害，又有點嚇人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460125,
					"content": "假如我是個丘丘人，正和朋友追著野林豬，結果突然蹦出個小東西，二話不說直接把炸彈丟在我們臉上…我應該會嚇得昏過去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460126,
						705460128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460126,
					"content": "好像還滿酷的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460127
					]
				},
				{
					"id": 705460127,
					"content": "也對哦…對魔物和敵人恐怖，就表示對我們、對西風騎士和冒險家有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460130,
					"content": "不過目前這種新裝備還處於早期驗證階段，正式生產和投入使用還需要一段時間，我會加把勁的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460131
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460131,
					"content": "考慮到在野外試驗會影響到蒙德的自然生態，這種小事也不到驚動阿貝多隊長的程度，沒必要特意申請一塊試驗區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460132
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460132,
					"content": "艾瑪托諮詢我後，決定先建造一個小型樣機模擬操縱和爆炸試驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460133
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460133,
					"content": "正好之前有種桌遊很適合模擬測試，艾瑪托就拉著我去找麗莎前輩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460134
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460134,
					"content": "然後獲得了麗莎姐姐的支援和建議，甚至是故事情節的支援，就有了超棒的收穫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460135
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460135,
					"content": "鏘鏘！請看這邊的遊戲桌——「嘟嘟可轟轟奇遇記」第二部，「嘟嘟可砰砰歷險記」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460136
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460136,
					"content": "這次，學會了近距離爆破的嘟嘟可，帶著特別蹦蹦炸彈強勢回歸，順著我們的指揮迎戰捲土重來的敵人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460137
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460137,
					"content": "在嘟嘟可和角角魚大王的鬥智鬥勇中，我們能夠充分享受火花的炙烈和爆炸的快樂…順便為新式裝備記錄寶貴的測試資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460138
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460138,
					"content": "喔！艾瑪托改進的遊戲，嘟嘟可大戰角角魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460139,
					"content": "#看起來，榮譽騎士長官和白色小幫手還滿有興趣的，{M#他}{F#她}們也能夠提出極具參考價值的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460140
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460140,
					"content": "沒錯沒錯，如果榮譽騎士和白色小幫手願意花寶貴的時間來玩，我真是感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460141,
						705460142
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460141,
					"content": "這下我們是第一個試玩的了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460143,
					"content": "既然是嘟嘟可勇鬥角角魚的續作，是不是最應該邀請火花騎士來玩呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460144,
					"content": "嗚！考慮到新遊戲借用了嘟嘟可的形象，我當然無比榮幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460145
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460145,
					"content": "所以我想讓「嘟嘟可砰砰歷險記」更精彩、有趣，盡量在火花騎士大人玩到之前，改進更多不足之處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460146
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460146,
					"content": "哼哼，我明白了！這次我們身兼多職，要幫妳測試新裝備、要擔任遊戲的除蟲玩家，也要負責之後讓可莉開開心心玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460147,
						705460148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460147,
					"content": "正合我意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460149,
					"content": "一拍即合，我和榮譽騎士，還有白色小幫手的默契增加了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460150
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460150,
					"content": "#只是看著{F#妳}{M#你}們玩遊戲，我的熱情也會湧上來！那事不宜遲，我們現在就開始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460148,
					"content": "為了可莉和好玩的遊戲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460142,
					"content": "唔…是不是還忘了一個人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460128,
					"content": "也給我來一臺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460129
					]
				},
				{
					"id": 705460129,
					"content": "我的預感果然沒錯，榮譽騎士也是個爆炸物愛好者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "艾瑪托"
				},
				{
					"id": 705460114,
					"content": "妳們是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460115
					]
				},
				{
					"id": 705460115,
					"content": "嗯…作為西風騎士團裡不起眼的零件，榮譽騎士沒聽說過，或是不記得我們，都沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460116
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460116,
					"content": "我是調查小隊的信號官方妮雅，負責試驗煉金探測裝置。她是我的同僚武器官艾瑪托，對爆炸物有著…獨特的嗜好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460117
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460117,
					"content": "上次我們負責應對須彌「角魨」入侵果酒湖事件，行動還算順利，距今有些年月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460118
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460118,
					"content": "在那之後，艾瑪托認為只靠遠距離投放炸彈，還是會有不小的作戰死角，而且面對一些遮蔽物和掩體時不夠有效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "方妮雅"
				}
			]
		}
	]
}