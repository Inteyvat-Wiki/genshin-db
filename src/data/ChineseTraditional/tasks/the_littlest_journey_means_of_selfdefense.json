			"trigger": {
				"objectNames": [
					"小蒙",
					"老章"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "欸？這個礦石，和這個礦石也不一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300102,
					"content": "那當然了，用這兩種礦石打造出的東西，品質和價錢可是完全不一樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300103,
					"content": "喔…不過，這兩種礦石怎麼都只剩下這麼一點了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300104,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300105,
					"content": "你們在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}好，我正在幫我爸爸檢查他訂的鐵器呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300107,
					"content": "鐵匠叔叔可好了，他還答應我，要幫我做一把小劍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300108,
					"content": "不過，他說最近店裡的原料不夠用，爸爸訂的那批鐵器可能要延期…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300109,
					"content": "我的那把小劍也不知道什麼時候才能做出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300110,
					"content": "唉，這也是沒辦法的事，最近店裡的客人很多，礦石都用得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300111,
					"content": "那些礦物產量豐富的地方，也盤踞著許多魔物，我也不敢貿然過去採礦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300112,
					"content": "只能等我把這段時間先忙過去，再請一位冒險家陪著我出去採礦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300113,
					"content": "可是，那得等到什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300114,
					"content": "#{F#大姐姐}{M#大哥哥}，我聽人家說，{F#妳}{M#你}是不是特別會對付那些魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300115,
					"content": "#{F#妳}{M#你}能不能幫幫忙？拜託拜託，求求{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#旅行者，{F#妳}{M#你}要去看看情況嗎？那我先把我平時採礦的地點幫{F#妳}{M#你}標上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300119,
					"content": "#唔，好了，就是這些地方了。{F#妳}{M#你}去的時候可要小心點，那邊有很多魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300120,
					"content": "#那就拜託{F#妳}{M#你}了，{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300117,
					"content": "好、好…我想想辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
