				"points": []
			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "旅行者，那邊的情況怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300202,
					"content": "那邊暫時安全了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#不愧是{F#大姐姐}{M#大哥哥}，真厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300204,
					"content": "爸爸說，旅行的時候，他們也會雇幾個人來保護我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300205,
					"content": "#希望那些人的身手，能和{F#大姐姐}{M#大哥哥}一樣厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300206,
					"content": "鐵匠叔叔，這樣你是不是就可以繼續去採礦，然後繼續做那批鐵器啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210300207,
					"content": "哈哈哈，那是當然，我準備一下就去採礦，等會回來就可以繼續開工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "老章"
				},
				{
					"id": 210300208,
					"content": "但我一個人能帶的礦石有限…希望那個地方，不要再出現魔物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老章"
				}
			]
		},
