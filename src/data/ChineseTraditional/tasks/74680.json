	],
	"talks": [
		{
			"id": 7468001,
			"completionStepIds": [
				7468001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468001",
							"2"
						],
						"stepId": 7468001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊蓮"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3421.75,
							449.586,
							4453.235
						],
						"pointId": 340100476
					}
				]
			},
			"dialogs": [
				{
					"id": 746800101,
					"content": "「千靈映影節」…做得好呀！幹得漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800102
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800102,
					"content": "這樣一來，想在截止日期前完成專案，根本就是癡人說夢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800103
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800103,
					"content": "嗚嗚嗚…噫啊啊…這次老闆不會痛罵我了…應該會直接幹掉我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800104
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800104,
					"content": "這位小姐怎麼自顧自地哭起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800105,
					"content": "我們需要幫她找醫生嗎？不知道楓丹有沒有專門治療心情的醫生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800106,
					"content": "#唔唔…{F#妳}{M#你}們什麼時候來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800107
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800107,
					"content": "謝謝兩位的關心，現在我更需要…可以讓我即將死亡的職業生涯起死回生的醫生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800108
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800108,
					"content": "這應該不屬於醫生的工作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800109,
						746800111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800109,
					"content": "不就是工作嘛！大不了換一個！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800110
					]
				},
				{
					"id": 746800110,
					"content": "啊——！換工作比死還折磨啊！所有熟悉的做事方法都沒用了，全都要重新學！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800113,
					"content": "這樣聊下去也不是個辦法，還是請妳先說明一下現在是遇到了什麼困難？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800114,
					"content": "有點難…這是技術問題，我想想該怎麼簡單解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800115
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800115,
					"content": "簡單來說，我是「千靈映影節」器材供應商的工程師伊蓮，主要負責開發攝影器材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800116
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800116,
					"content": "為了追求映影的效果，我們的甲方提出需要一種能夠載著映影機快速移動的「穩像平臺」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800117
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800117,
					"content": "同時，這種「穩像平臺」還需要有辦法載模仿演員的人偶或動物模型，來扮演遠方的群眾臨演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800118
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800118,
					"content": "如此一來，他們就能夠在高速移動中穩定跟拍演員，或者省下僱傭大量演員的費用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800119
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800119,
					"content": "而且他們還要求每個平臺的採購價不能高於一臺留影機的三分之一，使用壽命不能低於三十年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800120
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800120,
					"content": "哪有這種要求的！就算是超級厲害的工匠，也不可能做出又便宜、又好用、又耐用的道具吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800121,
					"content": "我做完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800122
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800122,
					"content": "畢竟甲方是不可忤逆之人，以前甲方提過更過分的需求，我也豁出半條命滿足了他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800123
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800123,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800124
					]
				},
				{
					"id": 746800124,
					"content": "…那妳在煩惱什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800125,
					"content": "問題是我沒有測試員！好不容易做出了產品，不經過全面檢測，專案就不算完成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800126
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800126,
					"content": "稍微懂一點機關原理或是體力夠好的測試員，都被「千靈映影節」找去檢查更重要的東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800127
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800127,
					"content": "不經過測試的產品交到甲方手裡後，要是被找出什麼大問題的話，我還要倒賠——賠十倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800128
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800128,
					"content": "我只好在這裡一邊推銷自家的產品，一邊尋找外援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800129
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800129,
					"content": "就算最後入不敷出也只能認了，畢竟和甲方的合約是老闆簽的，但要賠十倍的話…就是我個人要負責了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800130
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800130,
					"content": "事已至此，先說說看測試內容…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800131
					]
				},
				{
					"id": 746800131,
					"content": "#沒錯，如果不是很困難的測試內容，說不定我和{NICKNAME}可以幫忙做點簡單的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800132,
					"content": "聽起來沒什麼難的，實踐起來就不容易了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800133
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800133,
					"content": "為了確認「穩像平臺」在極限速度下的運轉情況，我將它調成了「避開一切接近者」的被動運動模式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800134
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800134,
					"content": "測試員需要在特定場地內追逐「穩像平臺」，並在短時間內盡可能將越多平臺驅趕至目標區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800135
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800135,
					"content": "像我這種體力差的人，稍微追著「穩像平臺」跑兩步，就完全沒力氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800136,
						746800137
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800136,
					"content": "這有什麼難的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800138,
					"content": "妳這麼一說，我們反而放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800139,
					"content": "只不過是幾個機關而已，看我們用飛毛腿追著它們跑…說不定還會被我們超過呢！測試極限什麼的太簡單了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800140,
					"content": "#真的？真的？{F#妳}{M#你}們認真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800141
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800141,
					"content": "#那我我我…我給{F#妳}{M#你}們摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800142
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800142,
					"content": "啊呀，勞動補償…我們也不會拒絕！不過，要是在這種情況下收妳太多摩拉，我們的良心也會抗議的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800143,
					"content": "妳按照正常支付給測試員的費用，給我們適當的摩拉就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800144,
					"content": "神醫！您們就是能讓我瀕死的職業生涯復活的神醫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800145
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800145,
					"content": "測試場就在城區附近的一座無人秘境中，那、那就交給您們兩位了！我伊蓮感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800146
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800146,
					"content": "從業這麼多年，終於走運了一次！明天我不用被老闆幹掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800147
					],
					"speakerTitle": "伊蓮"
				},
				{
					"id": 746800147,
					"content": "呃啊…做完這一單以後，還是建議妳換個老闆比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746800137,
					"content": "不就是跑步！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800111,
					"content": "工作很重要，我們要不要幫幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800112
					]
				},
				{
					"id": 746800112,
					"content": "聽她說得這麼誇張，的確不能再袖手旁觀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}