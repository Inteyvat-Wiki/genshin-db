{
	"id": 74680,
	"type": "WQ",
	"name": "救救可憐的乙方員工！",
	"description": "#歡快的節慶之時，也有映影行業的相關人士愁眉不展，{F#妳}{M#你}與派蒙就在會場附近找到了一位倒楣的乙方員工…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2027,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
