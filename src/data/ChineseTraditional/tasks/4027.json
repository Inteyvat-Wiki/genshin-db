			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"那維萊特"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3329.162,
							454.452,
							3811.095
						],
						"pointId": 340200113
					}
				]
			},
			"dialogs": [
				{
					"id": 40251323,
					"content": "#另外，{NICKNAME}，看{F#妳}{M#你}的表情應該是還有其他事想問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251324
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251324,
					"content": "請發問吧，我都會如實相告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251325,
						40251338,
						40251359,
						40251367,
						40251379
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251325,
					"content": "關於當初對「公子」的判決…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251326
					]
				},
				{
					"id": 40251326,
					"content": "有關「公子」一案，我多方追溯得知他年幼時曾墜入未知的深淵，機緣巧合下喚醒了吞星之鯨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251327
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251327,
					"content": "但於情於理，並不應該因為這種原因，就將「公子」認定為災難的根源，只能算作是連帶責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251328
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251328,
					"content": "至於諭示機在那場庭審中的判決…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251329
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251329,
					"content": "是因為連帶責任，還是因為芙卡洛斯猜到他能與吞星之鯨互相牽制，故意讓他替楓丹拖延時間…就不得而知了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251330
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251330,
					"content": "芙卡洛斯果然還是在為楓丹人著想吧！甚至最後楓丹人真正成為人類也是託她的福…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251331,
					"content": "欸，這麼說起來，我忽然想到一個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251332,
					"content": "楓丹人還沒有成為真正的人類之前，他們生出來的孩子難道也是純水精靈變的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251333,
					"content": "生命本來就如水流般循環不息，妳還記得楓丹人經常會來到露景泉這裡求子的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251334
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251334,
					"content": "嗯，琳妮特說過，這裡是楓丹所有水流的交會處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251335,
					"content": "其實就連那些夫妻自己都不知道，這種求子其實並非只是一種風俗，而是一種儀式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251336
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251336,
					"content": "泉水中那些受到祝福的純水精靈，真的會在數月以後作為新的楓丹人降生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251337
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251337,
					"content": "我…我大概明白了，看來這種儀式如今已經用不到了呢！但大概還是會作為習俗來延續下去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251380,
					"content": "啊！等等，關於神之心的事，我還有一點問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251381
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251381,
					"content": "之前和林尼聊天的時候，林尼說你對送出神之心這件事的態度有過一次明顯的變化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251382
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251382,
					"content": "我們都猜測可能還存在什麼只有你知道的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251383
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251383,
					"content": "難怪壁爐之家可以作為愚人眾的情報機構，竟然這樣敏銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251384
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251384,
					"content": "#關於這個問題，我正好也有件事準備和{F#妳}{M#你}們分享…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251385
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251385,
					"content": "嗯？還有什麼事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251386
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251386,
					"content": "#其實那天我將{F#妳}{M#你}們從原始胎海送回陸地上以後，我和那位名叫絲柯克的小姐之間還有過這樣的對話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251338,
					"content": "關於楓丹的未來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251339
					]
				},
				{
					"id": 40251339,
					"content": "說起來，聽萊歐斯利說芙寧娜已經離開了，那是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251340,
					"content": "芙寧娜女士…民眾只知道她的死刑並未真正執行。她卸任了水神一職，將名義上的事務交付於我，離開了歌劇院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251341
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251341,
					"content": "我忠實而全面地轉述了芙卡洛斯最後的話。她聽完以後，沒有表現出悲傷，也沒有表示欣慰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251342
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251342,
					"content": "只是說…她累了，需要休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251343
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251343,
					"content": "…說完這些，她就收拾東西，像普通人搬家那樣搬出了歌劇院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251344
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251344,
					"content": "芙寧娜…那她現在有地方住吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251345,
					"content": "請放心，我自然會安排妥當，她的衣食住行都不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251346
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251346,
					"content": "其實我…隱約為她感到高興。儘管她精神上累積的創傷需要時間來慢慢修復…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251347
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251347,
					"content": "但不再需要扮演「水神芙卡洛斯」以後，她終於可以放下所有，去過普通的生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251348
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251348,
					"content": "那你自己呢？得到水龍全部的力量以後，你有什麼打算嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251349,
					"content": "芙卡洛斯逝去後，諭示裁定樞機也停止了運轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251350
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251350,
					"content": "這件事會直接影響審判，我慎重考慮後，決定取代它在庭審中的作用。今後我會自行審判，並將結果傳達出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251351
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251351,
					"content": "看來你還是完全在以最高審判官的立場考慮事情呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251352,
					"content": "身為元素龍，我仍有許多未竟之事。但這份力量…這種責任，某種意義上都是被賦予的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251353
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251353,
					"content": "所以在履行其他責任之前，我首先要作為最高審判官繼續為楓丹效力。兩者將在我的生活中並存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251354
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251354,
					"content": "此外，水神的離開還會帶來另一個問題…歌劇院將不再產出「律償混能」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251355
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251355,
					"content": "是啊，那種能量來自於民眾對水神的信仰吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251356,
					"content": "可是現在城裡的機械都在正常運轉啊！能量究竟是怎麼來的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251357,
					"content": "如今的我已經可以完全掌控「芒荒能量」了，它完全可以用作替代能源，這也是我暫時離不開楓丹的原因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251358
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251358,
					"content": "嗚哇！古龍的權能真是好用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251359,
					"content": "關於楓丹的神之心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251360
					]
				},
				{
					"id": 40251360,
					"content": "噢噢對，聽說你把神之心「外交贈予」了「僕人」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251361
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251361,
					"content": "那兩位執行官在這場災難中的確做出了諸多貢獻，暫且不談他們完全出於自願的部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251362
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251362,
					"content": "單論現階段愚人眾在楓丹的目的，表面上看只有一個——那便是神之心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251363
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251363,
					"content": "如今諭示裁定樞機停擺，甚至水神之神座都不復存在，我也並不需要神之心的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251364
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251364,
					"content": "…神之心在楓丹已經徹底失去意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251365
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251365,
					"content": "假如愚人眾的目的並不單純，那不如就趁此機會滿足愚人眾的要求…免去更多不必要的周旋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251366
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251366,
					"content": "還真是複雜的考量啊…我還以為你只是為了感謝「僕人」以及跟「公子」道歉呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251367,
					"content": "關於旅行的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251368
					]
				},
				{
					"id": 40251368,
					"content": "#過一段時間，{F#妳}{M#你}們準備要去納塔了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251369
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251369,
					"content": "#我在做嚮導方面沒有什麼天賦，只能盡可能把我所知道的情報告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251370
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251370,
					"content": "據我所知，納塔可以說是「龍的國度」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251371
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251371,
					"content": "龍的國度？像你這樣的龍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251372,
					"content": "不，我想我在納塔應該並不會受到歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251373
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251373,
					"content": "和像我這樣的古龍不同，納塔的龍類應該經歷過漫長的發展和演化，如今正大量與人類共存著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251374
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251374,
					"content": "那裡也是「戰爭」的國度，大地上延續著無休止的戰火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251375
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251375,
					"content": "#還有一個對於{F#妳}{M#你}們來說可能會有用的情報——那是我之前與「僕人」談判時，不經意間獲知的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251376
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251376,
					"content": "…名為「隊長」的執行官，也已經加入了這場無休止的戰爭之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251377
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251377,
					"content": "「隊長」…聽起來很強的樣子，真是到哪裡都有這些愚人眾執行官在活躍著啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251378
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251378,
					"content": "#建議{F#妳}{M#你}們先做好萬全的準備，再前往納塔。在此之前，楓丹{F#妳}{M#你}們想要駐留多久都歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 40251379,
					"content": "沒什麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251380
					]
				}
			]
		}
	]
}