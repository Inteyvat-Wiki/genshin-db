					"nextDialogs": [
						740841157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740841157,
					"content": "那要怎麼幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841159
					]
				},
				{
					"id": 740841159,
					"content": "鑰匙，鑰匙，鑰匙，數量。",
