			"dialogs": [
				{
					"id": 740840605,
					"content": "快看！祭壇旁邊有一隻龍蜥！牠是不是睡著了？我們要小心點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840601,
					"content": "咦？這裡…這裡怎麼沒有鑰匙？難道這座祭壇已經被提前啟動了？該不會已經有人拿走鑰匙了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840602,
					"content": "吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "沉睡的龍蜥"
				},
				{
					"id": 740840603,
					"content": "不好了！那隻龍蜥醒了！我們快跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840604,
					"content": "#祭壇旁的龍蜥搖晃著醒來，雙眼噴出憤怒與惡意…\\n{F#妳}{M#你}們急忙向岸上游去…但牠在後面緊追不捨…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
