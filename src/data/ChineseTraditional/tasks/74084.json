					"nextDialogs": [
						740841167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740841167,
					"content": "鑰匙，鑰匙，鑰匙，廣場，西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841168
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740841168,
					"content": "西邊的廣場還有三把鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740841169,
					"content": "集齊三把鑰匙去廣場？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841170
					]
				},
				{
					"id": 740841170,
					"content": "#派蒙，美露莘！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841171
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740841171,
					"content": "#哎呀！珀西芙，妳不要老是說這種顯得{NICKNAME}比我聰明的話嘛！明明我和{M#他}{F#她}差不多聰明才對！",
