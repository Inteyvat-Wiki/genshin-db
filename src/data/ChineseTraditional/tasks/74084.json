			"dialogs": [
				{
					"id": 740840801,
					"content": "…美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840802,
					"content": "珀西芙，妳怎麼在這裡？快離開那隻龍蜥，很危險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840803,
					"content": "善良派蒙，珀西芙！危險，美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840804,
					"content": "珀西芙伸出手撫摸著龍蜥的腦袋，暴怒的龍蜥乖乖低下了身子。\\n牠張開嘴，吐出了一顆晶瑩的水珠，然後轉身跳進了水中。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "是鑰匙！鑰匙居然被龍蜥藏在嘴裡了！而且牠居然主動把鑰匙交出來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840806,
					"content": "藍東西，好東西，鑰匙，保護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840807,
					"content": "藍東西是剛剛那隻龍蜥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "珀西芙，妳和那隻龍蜥是朋友嗎？牠在幫妳保護鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840809,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840810,
					"content": "紫東西，搶鑰匙…藍東西，暈過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840811,
					"content": "紫、紫東西？那是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840812,
					"content": "#紫東西，壞東西…藍東西，派蒙，{NICKNAME}，好東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840813,
					"content": "嗯…好吧，雖然聽得出來妳在誇我們，但總覺得有點怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840814,
					"content": "紫東西，十分很壞，伊黎耶，十分美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840815,
					"content": "妳是說…危害這座島的傢伙就是這個紫東西？好在鑰匙現在在我們手裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840816,
					"content": "#派蒙，{NICKNAME}，珀西芙！但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840817,
					"content": "鑰匙，鑰匙，鑰匙，廣場，西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840818,
					"content": "知道啦！珀西芙別著急！我們現在就去西邊的廣場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
