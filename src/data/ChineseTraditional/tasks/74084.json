					"nextDialogs": [
						740841147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740841147,
					"content": "#派蒙，{NICKNAME}，伊黎耶，邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841148
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740841148,
					"content": "#呃…邦邦？呃…妳希望{NICKNAME}和派蒙對伊黎耶島邦邦邦邦這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841149
					],
					"speakerTitle": "派蒙"
				},
				{
