			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "代宮司大人居然這麼高興，看來那個對牠來說，真的是很重要的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722310102,
					"content": "但是，不知道她到底在哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悅子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "確實，「阿響」…「淺瀨神社」和「百目鬼」，都很讓人在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310202,
					"content": "你們是什麼時候冒出來的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "島上鬧出那麼大的動靜，我們自然就過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310204,
					"content": "#不過，有些事我覺得，必須要和{F#妳}{M#你}們說一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310205,
					"content": "大祐，說明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310206,
					"content": "啊…好的，悅子小姐。是這樣的，我要說的是一些…有關這座清籟島的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310208,
					"content": "清籟島的歷史實在是太久遠了，雖然協會已經特地搜索過了資料，但還是幾乎沒找到什麼有用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310209,
					"content": "根據協會給的資料，幾百年前，這裡似乎曾經是一處「海賊」的聚集點，當時，是由幕府出面掃清了所有海賊，並且把島上的居民都遷移到了別處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310210,
					"content": "那個「百目鬼」，沒意外的話，也許正是當時和幕府正面衝突過的海賊頭目「赤穗百目鬼」，卷宗裡明確記錄著他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310211,
					"content": "據協會給我們的那些資料裡記載，這位「赤穗百目鬼」指揮著海賊的船隊，和幕府在海上作戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310212,
					"content": "雖然他的船隊很快被幕府壓制了下去，被迫向清籟島逃竄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310213,
					"content": "但是，幕府的船隊在追擊他的時候，清籟島上突然爆發了一陣不知來由的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310214,
					"content": "赤穗百目鬼的船隊和幕府的船隊一起被雷暴擊中…就這樣全部失去了蹤跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310215,
					"content": "雷暴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "接下來的我來說吧…這件事裡最大的疑點，就是那場突然出現的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310217,
					"content": "雖然赤穗百目鬼的船隊也被雷暴波及，幾乎全滅…但幕府派來清籟島的船隊也幾乎全軍覆沒，被迫退回鳴神島，過了一段時間才重整好了船隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310218,
					"content": "那場雷暴實在來得太過恰到好處，簡直就像是…有人特意操控的一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310219,
					"content": "#{F#妳}{M#你}還記得，這座島上特地被解開封印的那些「鎮石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310220,
					"content": "還有，我們封印了這些「鎮石」之後，島上的雷暴也平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310221,
					"content": "我不想妄下推斷，但是…我感覺這一切多多少少有些關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310222,
					"content": "不然，我們去問問寢子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310223,
					"content": "…算了吧。資料記載那位百目鬼失蹤了。說是失蹤，但被那種雷暴擊中，也許已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310224,
					"content": "我們會繼續在這座島上探索，也繼續搜集關於這件事的線索，等過段時間，我們就會回去向協會報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310225,
					"content": "呵呵，旅行者，說不定到時候我們還會繼續合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310226,
					"content": "到時候請多多關照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "彼此彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310228,
					"content": "大祐，準備一下，我們繼續制訂探索計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310229,
					"content": "呃…悅子小姐，那寢子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310230,
					"content": "你之前怎麼和那隻貓相處，以後也怎麼和那隻貓相處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310231,
					"content": "但是記住，不要說任何不該說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310232,
					"content": "牠…現在應該很開心，不要說任何煞風景的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310233,
					"content": "我知道了！悅子小姐，嘿嘿，妳果然還是很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310234,
					"content": "…只不過是為了更好地完成委託而已，快點去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310235,
					"content": "清籟島…看來這座島上，還有很多秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悅子"
				},
				{
					"id": 722310207,
					"content": "你們知道什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}