				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "嗯？這裡怎麼會有留影機？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630202,
					"content": "#「有新聞的地方就有留影機」，{F#妳}{M#你}們沒聽過這句話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630203,
					"content": "好像聽過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "#可是這句話是我剛編的欸，{F#妳}{M#你}是在哪裡聽過的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630205,
					"content": "唉，果然這世上根本沒有什麼新鮮東西。不管說什麼、寫什麼，都只能是對他者的戲仿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630208,
					"content": "留影機有了，新聞在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "新聞…就像釣魚一樣。需要耐心的等待，在準確的時機做出正確的判斷，這樣才能釣上大魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630210,
					"content": "哦，不，我是說，這樣才能釣到大新聞。嗯？好像也不對，算了，不管了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630211,
					"content": "聽起來好業餘啊，妳不是記者吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "#那{F#妳}{M#你}就看走眼了，哼哼，我是業餘記者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630222,
					"content": "話說回來，業餘記者為什麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630223,
					"content": "為了完成前輩交給我的課題呀，也就是用留影機捕捉梅洛彼得堡看守在工作中的生動瞬間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630224,
					"content": "#但之前為了辦理規範相關的文件耗費了太多時間…{F#妳}{M#你}們看看就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630225,
					"content": "奈莉拿出一大疊文件，密密麻麻寫著各項條款和各種署名，看了感覺頭昏眼花…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "這一套流程全部跑完，都錯過看守值班的時間啦。用釣魚來類比的話，現在根本沒魚可釣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630227,
					"content": "欸？可是這裡明明還有看守在值班吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630228,
					"content": "但我想釣白金典藏型嘛，如果是初始能力型或者水域清理者，總覺得少了點衝擊力…就算完成了課題，前輩也一定不會稱讚我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630229,
					"content": "不想空手而歸的話就別東挑西選了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "說得對，我應該正視自己的能力，不要妄想去釣超出自己能力範圍的魚…嗚嗚，我是個沒用的釣師…哦不，是沒用的業餘記者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630234,
					"content": "好，喪氣話說完了，該振作起來了！兩位如果方便的話…可以幫我一個小忙嗎？拜託了！我會支付報酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630235,
					"content": "變臉變得還真快呀…要幫忙也要看是什麼內容呀！妳要不要先說說看需要我們做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630236,
					"content": "那邊的看守——格蘭維爾，根據我的判斷，他的新聞價值等同勢態控制者在維護機關裡的價值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630237,
					"content": "幫他留影的話，應該能寫出一篇不錯的報導吧！這樣前輩一定也無話可說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630238,
					"content": "但是他根本不過來這邊！兩位能不能把他帶到適合留影的這裡來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630239,
					"content": "妳自己說明情況請他過來不就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "那樣的話他一定會因為太過在意鏡頭而擺出僵硬的姿勢的，那不就太不自然了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630243,
					"content": "我想想，最好是這樣——先把擴音機關掉，然後向格蘭維爾報告說這邊的擴音機故障了，請他來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630244,
					"content": "這樣一定就能拍到梅洛彼得堡看守在工作中的生動瞬間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630245,
					"content": "#課題能否完成就看這一刻了！拜託{F#妳}{M#你}們了，幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630246,
					"content": "#聽起來是不難，{NICKNAME}，我們幫幫她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630241,
					"content": "帶留影機去他那邊不就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "欸——可是這邊更適合取景嘛！而且如果讓他看到留影機，一定會在意得不得了，最後拍出一些姿勢僵硬的畫片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630230,
					"content": "那妳繼續等吧，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "#{F#妳}{M#你}們這樣就要走了嗎？真的要走？不幫幫我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630232,
					"content": "呃…我們也不可能變出妳想要的白金典藏型吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630213,
					"content": "別管新聞了，我也喜歡釣魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "#當真？那太好了，其實我只是釣魚新手，正煩惱有些問題沒人討教，比如說釣到維護機關但它咬人…是{F#妳}{M#你}的話會怎麼應對呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630215,
					"content": "放生就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "#原來如此，這就是{F#妳}{M#你}的選擇啊。嗯嗯，很有參考價值，我記下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630220,
					"content": "#…欸！怎麼突然聊起釣魚了？{F#妳}{M#你}們好擅長引導話題！看來我作為業餘記者還有很多要學的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630221,
					"content": "釣魚的話題根本就是妳自己先提起的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630216,
					"content": "那當然是揍它一頓讓它知道厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "做成料理請派蒙品嚐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#嗚哇！雖然我很信任{NICKNAME}的廚藝，但是那東西怎麼看都不像是可食用的類型吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630206,
					"content": "沒聽過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "#哦哦！那{F#妳}{M#你}們現在聽過了。請記住，如果要在別處引用，一定要註明來源！也就是我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "奈莉"
				}
			]
		},
