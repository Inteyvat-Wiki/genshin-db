	"talks": [
		{
			"id": 7266301,
			"completionStepIds": [
				7266301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266301",
							"2"
						],
						"stepId": 7266301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "#你們來了，很抱歉又來麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630102,
					"content": "妳看起來氣色不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "哈哈，多謝誇獎，我也算是想明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630104,
					"content": "有些事或許就是不能強求的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630105,
					"content": "#晚上能陪我去一趟西邊的海灘嗎？我有東西送給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630106,
					"content": "哇，是什麼大海的寶藏嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630107,
					"content": "去了就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "就是這裡了，當年父親最後一次出海就在這裡，也是這樣的夜晚，之後我就再也沒有見過他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630202,
					"content": "很想念他吧，鯨井小姐的願望是不是再見到一次父親？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630203,
					"content": "哈哈，我確實很想念他，但是，大海的子民總有一天要回歸大海的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630204,
					"content": "但我的願望，其實是要成為超越父親的漁師啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630205,
					"content": "小時候，我總想和父親一起出海，但他只會讓媽媽把我帶回去，有時候甚至帶上了鄰居家的哥哥，都不願帶上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630206,
					"content": "他總是說著，「椛啊，別在海邊晃來晃去，去做些女孩子該做的事。」，「拿著錢去買小裙子吧，不要總往船上跑。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630207,
					"content": "我很不服氣，為什麼？什麼是女孩子該做的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630208,
					"content": "我可以去買糖果，去摘鮮花，當小公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630209,
					"content": "但我不可以去冒險，去遠洋，去遨遊大海嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630210,
					"content": "我偏不，我偏要做。父親走後，我幹起了漁師的行當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630211,
					"content": "他探索不了的海域，我來探索。他捕不了的大魚，我來捕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630212,
					"content": "「鯨井」流的釣魚之法，我來繼承。「鯨井」家的漁師名號，我來發揚光大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630213,
					"content": "就算「海中月」的傳說只是傳說，我也不會止步不前的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630214,
					"content": "嗯，妳會成功的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "#謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630216,
					"content": "既然神魚不在，那我就把心願投入大海吧。我想，父親會看見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630217,
					"content": "#{F#妳}{M#你}們有什麼願望嗎？一起來吧，寫下心願，塞進漂流瓶，然後用力丟出去。它們總有一天會實現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630218,
					"content": "嗚哇——這樣可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630219,
					"content": "可是我有好多願望，要寫哪一個呢…好糾結！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630220,
					"content": "#這段時間，辛苦你們了！我都不知道該如何感謝{F#妳}{M#你}們，只有一些禮物，希望不要嫌棄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630221,
					"content": "#哇——{F#妳}{M#你}們看，那是什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630222,
					"content": "好大一群魚哦！還在發光，牠們好像很喜歡我們的漂流瓶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630223,
					"content": "這些傢伙聚在一起，倒是很像一顆海裡的大月亮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630224,
					"content": "這…這些魚，這些魚是「月光鰭」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630225,
					"content": "啊！我知道了…我知道了！原來如此，原來這就是「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630226,
					"content": "欸？這就是「海中月」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630227,
					"content": "沒錯，我不會忘記牠的樣子，這星星點點的月光啊…當年那隻「海中月」，也是在嘉瑋投下漂流瓶後出現的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630228,
					"content": "難怪這麼多年，都沒有人真正捕獲過「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630229,
					"content": "原來是因為，牠是由一群「月光鰭」彙聚組成啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630230,
					"content": "這些「月光鰭」…居然會喜歡這種普普通通的漂流瓶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630231,
					"content": "嘿嘿，說不定牠們是喜歡人們往瓶子裡灌注的心願呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630232,
					"content": "哈哈！既然如此，那就看我鯨井椛把它們全部釣上來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630233,
					"content": "我們也來！我們也來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726630234,
					"content": "#既然如此，那請允許我把這根釣竿送給{F#妳}{M#你}們，這是我鯨井家為了追捕「海中月」特製的釣竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630235,
					"content": "#雖然遠不能表達對{F#妳}{M#你}們的感謝，但也是我的一點心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630236,
					"content": "就用它把「月光鰭」全部釣上來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		}
	]
}