			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安內特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736800101,
					"content": "#{F#妳}{M#你}們好，歡迎參加歸風佳釀節，願巴巴托斯大人祝福{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800102
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800102,
					"content": "#咦，{NICKNAME}，{F#妳}{M#你}看，這裡立著一塊公告板，上面還貼了不少紙片，難道說是有什麼委託嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800103,
					"content": "呵呵，並不是委託哦，這些都是尋找「豐饒之箱」的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800104
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800104,
					"content": "什麼什麼，「豐饒之箱」？是什麼寶物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800105,
					"content": "#唔，這麼理解倒也沒錯啦。看起來{F#妳}{M#你}們是第一次參加佳釀節，如果有興趣的話，我來稍微講解一下怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800106,
						736800107
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800106,
					"content": "既然派蒙這麼感興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				},
				{
					"id": 736800108,
					"content": "好的。簡單來說，「豐饒之箱」是蒙德居民在佳釀節期間，為幸運的陌生人準備的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800109
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800109,
					"content": "因為佳釀節不僅是迎接巴巴托斯大人歸來的節日，也是大家共同分享豐收喜悅，回顧美好往事的節日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800110
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800110,
					"content": "大家會把禮物放在橡木桶造型的木箱中，藏在某個對自己來說充滿回憶的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800111
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800111,
					"content": "接下來，禮物的主人會留下線索，無論是誰，只要能最先找到箱子，就能獲得禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800112
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800112,
					"content": "除了禮物，大家還會在箱子裡留下給找到禮物人的贈言。這份誠摯的祝福，往往比禮物本身要更有價值喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800113
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800113,
					"content": "聽起來好像挺有趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800114,
					"content": "怎麼樣，兩位要來試試尋找「豐饒之箱」嗎？只要對蒙德的風土人情有一定瞭解，應該能很容易破解線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800115
					],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800115,
					"content": "#{NICKNAME}，那我們就來試試看吧，說不定還能找到我們認識的人留下的禮物呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736800116,
					"content": "祝兩位好運，在佳釀節玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安內特"
				},
				{
					"id": 736800107,
					"content": "那就拜託妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				}
			]
		}
	]
}