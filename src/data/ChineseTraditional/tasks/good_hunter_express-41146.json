			"dialogs": [
				{
					"id": 411460101,
					"content": "我這就送過去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460102
					]
				},
				{
					"id": 411460102,
					"content": "#那就拜託{F#妳}{M#你}啦，那地方太遠了，我們實在是分不出人手來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411460103,
					"content": "對了，送的時候千萬小心，<color=#00E1FFFF>不要跑得太快，也不要用風之翼，更不要去爬山什麼的…</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411460104,
					"content": "要是路上被撞了一下，肉醬和麵說不定就會完全分開了…那樣的話，客人肯定不會收下這份餐的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
