			},
			"dialogs": [
				{
					"id": 701060401,
					"content": "關於「大雪豬王」的肉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "#哦，{F#妳}{M#你}已經拿到「大雪豬王」的肉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060403
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060403,
					"content": "都搜集齊了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060404
					]
				},
				{
					"id": 701060404,
					"content": "這樣的話…食材就齊全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060405
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060405,
					"content": "#我趁著{F#妳}{M#你}去搜集食材的期間，也把食譜整理好了。和那道「古代食譜」還差得挺多的…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060406
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060406,
					"content": "#不過嘛，不管做法怎麼樣，只要好吃就行了。我把這道菜命名為「稠汁蔬菜燉肉」，做起來倒也方便…唔，{F#妳}{M#你}要不要自己來試試看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060407
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060407,
					"content": "#{F#妳}{M#你}自己來試試看吧，如果學會了的話，以後{F#妳}{M#你}也可以自己做著吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				}
			]
		},
		{
			"id": 7010605,
