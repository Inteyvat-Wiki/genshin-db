					"哈里斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060501,
					"content": "#嗯，就是這種味道，{F#妳}{M#你}還挺有做菜天賦的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060502
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060502,
					"content": "#好了，這些東西請{F#妳}{M#你}收下，就當做是謝禮了。我得再去燉點菜給其他人吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060503
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060503,
					"content": "#哦對了，{F#妳}{M#你}晚上再來找我吧，我再做幾份這種菜給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060504
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060504,
					"content": "#多吃點好吃的，對{F#妳}{M#你}在雪山裡的冒險也有幫助，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				}
			]
		},
