			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"哈里斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "就差這些食材了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "啊？是旅行者啊，我正在琢磨一道「古代食譜」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060104,
					"content": "不久之前，有一隊探險隊進入雪山探索，我認識的一位冒險家也在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060105,
					"content": "雖然他們因為惡劣的氣候也沒有探索多遠，但那位冒險家說，他們在躲避風雪的時候，意外撞進了一處遺蹟裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060106,
					"content": "裡面都是書籍一類的東西，他們還從裡面發現了一份…食譜，居然保存地還算完好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060107,
					"content": "那位冒險家把這份食譜交給了我，拜託我試試復原這道「古代美食」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060108,
					"content": "說實話，那份食譜上的很多材料我都沒聽說過，一些做法我也是聞所未聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060109,
					"content": "所以，我就自己改造了一下那份食譜，只保留了最核心的幾道特殊食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060118,
					"content": "#如果{F#妳}{M#你}願意的話，能幫我搜集一下那些特殊食材嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060110,
					"content": "交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "哦，很有氣勢嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060113,
					"content": "我聽人說，一些小豬誤入雪山後，也被凍在了冰裡，我想…這些豬肉的味道，也許會有些新奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060114,
					"content": "#所以，我想請{F#妳}{M#你}去找到那些被凍住的小豬，搜集十份「冷鮮肉」來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060115,
					"content": "冷鮮肉是什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "啊，是我給那些小豬的肉取的名字。被冷凍在冰裡保持著鮮美的豬肉，不就是「冷鮮肉」嗎？哈哈哈，這個名字是不是很不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060117,
					"content": "#那就拜託{F#妳}{M#你}了，找齊食材之後就拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060112,
					"content": "需要什麼食材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
		{
