			"dialogs": [
				{
					"id": 701060201,
					"content": "關於冷鮮肉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "這些「冷鮮肉」看起來還不錯啊…嗯，這樣只差一種食材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060203,
					"content": "#{F#妳}{M#你}聽過「大雪豬王」嗎？據說，牠是生活在雪山深處的猛獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060204,
					"content": "我看有些食譜上說，「大雪豬王」的肉品質極佳，無論是煎炸烹煮都很不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060205,
					"content": "#旅行者，還得麻煩{F#妳}{M#你}幫忙跑一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "哈里斯"
				},
				{
					"id": 701060206,
					"content": "報酬的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "#別擔心，報酬我已經為{F#妳}{M#你}準備好了。那麼就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里斯"
				}
			]
		},
