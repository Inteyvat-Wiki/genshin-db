			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅蒂",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "嗚哇！這傢伙是不是好像比之前更大了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760141702,
					"content": "哼哼，那是當然的。吃了我辛辛苦苦找回來的這麼多白靈果，現在的沙皇老爺已經是比派蒙還要圓潤的沙皇老爺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141703,
					"content": "喂！不要拿我做這種奇怪的比較啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760141704,
					"content": "#嗚哦！怎麼了？看到{NICKNAME}{M#大哥}{F#大姐}，好像突然變得很有精神…或者說興奮起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141705,
					"content": "#好像是打算和{NICKNAME}{M#大哥}{F#大姐}比試一下…哈，是因為之前被打得毫無還手之力，所以不服氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141706,
					"content": "正合我意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#小心點哪，{M#大哥}{F#大姐}。這傢伙現在可比上次更強了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141708,
					"content": "欸？現在嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#也沒必要照著牠的性子來啦，等{M#大哥}{F#大姐}有興趣了再回應牠的挑戰也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141710,
					"content": "這傢伙現在也算是我罩的了，我說話牠還是會聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141711,
					"content": "來，乖，坐下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141712,
					"content": "牠是妳養的狗嗎！不對，螃蟹不一直是坐著的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
