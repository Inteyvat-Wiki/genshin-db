	"talks": [
		{
			"id": 7601414,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608201",
							"2"
						],
						"stepId": 7608201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅蒂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#怎麼了，{M#大哥}{F#大姐}？還有什麼想問的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141402,
					"content": "關於那隻螃蟹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "唉，那傢伙雖然看起來很嚇人，其實個性一直都滿溫和的。沒了那塊奇怪的石頭，之後應該也會恢復正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141404,
					"content": "至於現在嘛，就讓牠躲起來老老實實反省吧。不管受到什麼影響，做過的壞事依然是做過的壞事，被牠傷到的小螃蟹依然受了傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141405,
					"content": "就和大盜雷德·米勒當初對付的、被鏡子迷惑的壞總督一樣，找再多藉口也沒意義，悔過總必須要有實際行動啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141406,
					"content": "關於那塊奇怪的石頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "哼哼，那就是能操縱人心的{RUBY#[D]圖瓦道茨基之石}欲之石…嗯，我記得希丁芭大姐說的應該是這個名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141408,
					"content": "咳，總、總之，看來和霜月那邊的大石頭一樣，是從天上掉下來的東西。既然飛走了，應該也不會對我們造成什麼威脅了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141409,
					"content": "關於海螺幫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#嗯？{M#大哥}{F#大姐}想知道海螺幫的事呀。沒問題，既然{M#大哥}{F#大姐}已經是海螺幫的朋友了，想問什麼都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141411,
					"content": "#我們算是…嗯，同路的同齡人之間的「互助協調組織」吧。雖說{M#大哥}{F#大姐}的年齡應該沒辦法加入我們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141412,
					"content": "但要是在那夏鎮有什麼需要「互相幫忙」的事，只要是我能幫上忙的，就告訴我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141413,
					"content": "關於之前那個奇怪的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "#哦，{F#妳}{M#你}說那個紫色祭司啊。既然那傢伙暫時沒對我們出手，就表示至少她現在不是我們的敵人，她的事我們也盡量少管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141415,
					"content": "好奇心是會要了命的。卡嘉大姐也說，盡量別和霜月那群怪人接觸。就連我這種大盜，之前也差點被他們抓住，獻祭給月神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141416,
					"content": "獻祭？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "是啊，那群傢伙邪門得很，據說還會把不同人的血…唔，想想就覺得可怕，還是別說了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141418,
					"content": "幸虧當時抓住我的是個什麼都不懂的小女孩，稍微講幾個故事給她聽，她就願意放過我了。要不然啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141419,
					"content": "#我、我倒是也沒在怕啦，大盜當然是不會害怕的！只是勸{M#大哥}{F#大姐}一句，盡量少攪和他們的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141420,
					"content": "啊，對了，差點忘了，之前說好的情報來源。關於霜月之子的事，都是希丁芭大姐告訴我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141421,
					"content": "要是想找她的話…嗯，她應該還在那夏鎮附近吧？稍微打聽一下，應該很快就能找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141422,
					"content": "她大概要隱退一段時間了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#嗯？原來{M#大哥}{F#大姐}已經見過希丁芭大姐了嗎？隱退的事情我可沒聽她說過…算了，之後再打聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141424,
					"content": "聽到感覺心裡好不安…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "別擔心，她超可靠的。我梅蒂都這樣保證了，不用覺得不安啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				},
				{
					"id": 760141426,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "好，一路順風啊，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅蒂"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
