					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "應該就是這裡了。不過，確實沒看到什麼可疑的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140202,
					"content": "#難道說是躲起來了嗎？{NICKNAME}，我們在附近搜尋一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140203,
					"content": "這些<color=#00E1FFFF>雷元素方碑</color>感覺有點可疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "呼…終於搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140502,
					"content": "真是個難對付的傢伙啊，不過這裡為什麼會有這麼大一個丘丘雷兜王呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140503,
					"content": "想不明白…而且這裡的氣氛也有點古怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140504,
					"content": "總之，這裡的事情應該已經搞定了，我們還是快跑吧…欸，哲平，你怎麼也在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140505,
					"content": "#咳咳…我也很驚訝，原來是{F#妳}{M#你}們在這裡調查啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140506,
					"content": "我剛剛運完物資從前線回來，想要順便清理一下附近的威脅。咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140507,
					"content": "沒事吧，你看起來有點怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140508,
					"content": "沒事沒事，應該是前兩天出海的時候冷到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140509,
					"content": "路過這裡的時候，我聽說有人不久前剛剛登島調查，就想過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140510,
					"content": "#萬一有什麼危險，說不定我還可以當一回英雄…可惜遇到的是{F#妳}{M#你}們，看來我算是白來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140511,
					"content": "哲平，你有沒有覺得這裡的氛圍有點特別？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140512,
					"content": "嗯…這麼說的話，確實有一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140513,
					"content": "可能是因為這裡靠近魔神奧羅巴斯的骸骨，祟神的氣息比較濃郁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140514,
					"content": "魔神奧羅巴斯，那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140515,
					"content": "妳看，那個就是奧羅巴斯留下來的骸骨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140516,
					"content": "嗚哇！這麼大的蛇骨，看起來好嚇人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140517,
					"content": "是奧羅巴斯把我們的祖先從淵下宮帶到地面上，才有今天的海祇島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140518,
					"content": "我們的祖先一直視牠為守護神，但魔神戰爭期間，奧羅巴斯入侵了八醞島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140519,
					"content": "雷電將軍親自趕來，以「無想的一刀」將其斬殺。那一刀，也形成了如今的「無想刃狹間」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140520,
					"content": "「無想刃狹間」，居然是被雷電將軍砍出來的…好厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140521,
					"content": "是啊，不過魔神戰爭異常殘酷，八醞島在那場戰役中化為廢墟，據說將軍也曾在那時失去了珍視的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140522,
					"content": "奧羅巴斯死後，海祇島與幕府就多有不和。但這次成立反抗軍，不是為了信仰，只是針對眼狩令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140523,
					"content": "奧羅巴斯毀滅文明，是將軍站出來阻止了牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140524,
					"content": "如今將軍頒佈眼狩令，剝奪民眾的願望，也必須有人站出來阻止將軍…咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140525,
					"content": "我先回去了，剛解決完幕府軍的精銳武士，我回去休息一下，等會還有其他要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140526,
					"content": "#{F#妳}{M#你}們也趕緊向珊瑚宮大人彙報吧。這裡說不定還有殘留的祟神氣息，長時間待在這裡，對身體不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140527,
					"content": "咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140528,
					"content": "你也注意身體。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "別擔心，我的身體很硬朗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140531,
					"content": "沒想到哲平已經能和幕府軍的武士交戰了，不知不覺他也成長了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}，我們回去向<color=#00E1FFFF>心海</color>彙報吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140529,
					"content": "你也當心點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "心海，我們回…咦，五郎也在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140602,
					"content": "發生什麼事了嗎？他們的表情看起來好嚴肅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140603,
					"content": "出現這種異常情況的人，大概有多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140604,
					"content": "還沒來得及完全統計…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140605,
					"content": "心海，五郎，發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}，最近反抗軍部分軍士，出現了詭異的老化症狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140607,
					"content": "我將他們叫來盤問，才知道他們私底下從資助方那裡拿到了一些「秘密武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140608,
					"content": "他們大多爭強好勝，對眼狩令極為不滿，拿到這些秘密武器後，一直在悄悄使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140609,
					"content": "難怪最近戰局異常順利…但這絕非正道，必須盡快禁止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140610,
					"content": "五郎，你有拿到他們所謂的「秘密武器」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140611,
					"content": "大部分持有秘密武器的人不肯交出，但我還是拿到了一枚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140612,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}，{F#妳}{M#你}知道這個東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140614,
					"content": "愚人眾的…邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "這麼說，資助方的身分其實是愚人眾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140616,
					"content": "可是愚人眾為什麼要這麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140617,
					"content": "沒時間細想了，現在最重要的是，盡快通知軍隊放棄使用邪眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140618,
					"content": "最近有異常的士兵都需要接受治療，希望還趕得上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140619,
					"content": "#等等，{NICKNAME}，說到有異常的士兵…",
					"roleType": "TALK_ROLE_NPC",
