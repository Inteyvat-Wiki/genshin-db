					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "應，應該不會吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140622,
					"content": "我們快過去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
