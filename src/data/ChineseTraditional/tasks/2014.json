			"dialogs": [
				{
					"id": 20140801,
					"content": "哲平！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140802,
					"content": "#啊…是{F#妳}{M#你}們啊。{F#妳}{M#你}們來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140803,
					"content": "等一下啊，我先站起來…奇怪，總覺得身體沒什麼力氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140804,
					"content": "哲平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140807,
					"content": "#喔喔，還沒來得及跟{F#妳}{M#你}細說。我最近啊，又立了好幾件功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140808,
					"content": "乘船與幕府軍海戰、一個人擊退幕府武士、營救被圍困的同伴，以前的我做夢都不敢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140809,
					"content": "如果我能再強一點就好了。再強一點，就能做到更多的事了…奇怪，我的「秘密武器」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140810,
					"content": "那東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "#什麼時候…大概是在{F#妳}{M#你}被封為劍魚二番隊隊長不久之後，我遇到了資助方的神秘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140813,
					"content": "他們給了我這個。然後跟我說，只要想變強，這個秘密武器就會回應我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140814,
					"content": "哈哈，簡直就像是「神之眼」一樣吧？我沒用過神之眼，也不知道有什麼不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140815,
					"content": "這是…邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "邪…眼？聽起來是個不太好的東西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140817,
					"content": "和神之眼有什麼不一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140818,
					"content": "會透支使用者的生命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140820,
					"content": "這樣嗎…確實，像這樣來歷不明的東西，有風險也很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140821,
					"content": "最近這幾天，我愈來愈疲倦，心裡也隱約有一種不好的預感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140822,
					"content": "之前只是戰鬥後會更累一些，結果今天回來之後，我突然發現自己看不清東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140823,
					"content": "#真是遺憾啊，本來還以為，要趕上{F#妳}{M#你}了…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140824,
					"content": "果然，我沒有被神明注視著啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140825,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#{NICKNAME}，能拜託{F#妳}{M#你}一件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140827,
					"content": "#等到我們的隊服做好了，{F#妳}{M#你}幫我，把我那份也拿回來…我們一起換上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140828,
					"content": "#{F#妳}{M#你}那是什麼表情啊，夥伴。別擔心，讓我休息一會…休息一會…說不定就沒事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
