	"talks": [
		{
			"id": 7469701,
			"completionStepIds": [
				7469701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469701",
							"2"
						],
						"stepId": 7469701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746970101,
					"content": "咦？那不是瑞希和她的兩位小貘嗎？已經和芭比洛斯女士聊上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746970102,
					"content": "#{NICKNAME}和派蒙…？我剛聽芭比洛斯女士提起{F#妳}{M#你}們，還想著能不能和{F#妳}{M#你}們巧遇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970103
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970103,
					"content": "呵…現在看來，「命運」已經安排好我們相會的地點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970104
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970104,
					"content": "瑞希是來旅行的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970105
					]
				},
				{
					"id": 746970105,
					"content": "嗯…算是吧。如果那部心理知識科普映影的籌備工作順利的話，我的確可以去周圍散散心。但在那之前，還是得專注工作才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970106,
						746970107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970106,
					"content": "心理知識的映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970108
					]
				},
				{
					"id": 746970108,
					"content": "映影還能做這個？聽起來好厲害喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746970109,
					"content": "嗯，是我剛琢磨出來的新想法。之前宣傳「秋沙錢湯」時，我就參考了楓丹映影，錄製了幾期綜藝節目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970110
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970110,
					"content": "大家對那幾期映影很感興趣，不僅每一期都看得很仔細，甚至連節目裡講的那些心理學知識都記得很牢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970111
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970111,
					"content": "我就想，不如直接以「心理疾病」為題材拍攝幾部映影，以這種寓教於樂的方式，為大家講解一些心理學常識吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970112
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970112,
					"content": "…具備了常識之後，大家或許對於「心理疾病」就能有一個初步的客觀認知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970157
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970157,
					"content": "…而不是盲目地將這個客觀存在的病症視為無稽之談，或者是洪水猛獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970113
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970113,
					"content": "這樣一來，我為大家做診療時，說不定也會更順利一些吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970114,
						746970115
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970114,
					"content": "瑞希思考得好多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970116
					]
				},
				{
					"id": 746970116,
					"content": "是啊。畢竟心的病症無形無色，想要抓住…甚至意識到它的存在，都並不是一件容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970117
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970117,
					"content": "呵…我甚至都不知道怎麼將它抓起來，然後融入映影的劇本裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970118
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970118,
					"content": "說來慚愧，雖然我平時也寫了不少有關心理疾病的論文，但在寫映影劇本的時候，卻格外卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970119
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970119,
					"content": "有的時候，我一整天都要悶在房間裡，圍繞著幾行對白，幾十秒的情節去反覆推敲，最後可能還得不到結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970120,
						746970121
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970120,
					"content": "感覺好辛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970122
					]
				},
				{
					"id": 746970122,
					"content": "#也許只差一點靈感？我和{NICKNAME}被一件事卡住的時候，就去做一點別的，說不定就「噼喀」一下想通了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746970123,
					"content": "嗯，小派蒙和我想的一樣。所以我才會來到這裡，想要體驗一下這種和「御神籤」完全不一樣的占卜形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970124
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970124,
					"content": "希望，這位魔女的「月諭聖牌」，能為我帶來一些別樣的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970125
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970125,
					"content": "靈感…之前安雅的確說想要為「月諭聖牌」的每一張牌，都寫一篇特別的童話故事。但她想寫的故事太多，時間卻…呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970126,
					"content": "既然妳想要尋找靈感，那就抽一張牌吧，妖怪小姐。希望那位魔女未完成的童話，能指引妳尋覓到故事的靈光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970127
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970127,
					"content": "好的，芭比洛斯女士。不過…我之前所知的「占卜」之事，大多和…鳴神大社有關。用卡牌來占卜還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970128
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970128,
					"content": "要是有什麼不符合儀式規範的行為，還請您及時糾正。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970129
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970129,
					"content": "哎呀，逆位之「月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970130
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970130,
					"content": "「月」的正逆位意義相似——「逃避」、「蒙蔽」、「自欺欺人」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970158
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970158,
					"content": "就像是行走在暗月下的人，迷失了前進的方向，卻不知曉應當如何脫身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970131,
						746970132
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970131,
					"content": "聽起來不太妙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970133
					]
				},
				{
					"id": 746970133,
					"content": "是啊，怎麼這張牌的釋義，聽起來和警告似的…怎麼都感覺有點不太妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746970134,
					"content": "不過，既然夢見月小姐還能聽到這則預言，就說明事情還沒有凶險到那個地步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970135,
					"content": "稍加努力，說不定便能走出蒙蔽前路的陰霾，尋得企求之物…說不定是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970136,
					"content": "逃避與蒙蔽…還有「自欺欺人」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970137
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970137,
					"content": "單純解讀牌面的話，就是這樣。用更直白的說法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970138,
					"content": "大概意思就是，妳正在逃避著某一個近在眼前的答案，甚至不惜捨近求遠，也要遠離它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970139,
					"content": "這意思是說，能為我研判劇本的人，其實就近在眼前嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970140
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970140,
					"content": "倒也不侷限於劇本，不過，具體要如何理解牌面的寓意，就只能看妳自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970141,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970142
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970142,
					"content": "近在眼前的答案、捨近求遠的逃避…我大概明白這是在指向什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970143
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970143,
					"content": "呵…這麼說來，我的確是在「自欺欺人」…或者說，不由自主地開始「捨近求遠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970144
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970144,
					"content": "雖然我之前也想過去八重堂拜訪，也向八重宮司請教一番有關映影劇本的事，但卻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970145
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970145,
					"content": "如果從心理診療的角度來說，我這也算是「不自覺迴避」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970146
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970146,
					"content": "感謝您的占卜，芭比洛斯女士，您果然為我找到了靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970147
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970147,
					"content": "不必感謝我，我什麼都沒有做。是妳自己為自己理順了命運的絲線，我只是把線頭遞到了妳手裡而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970148,
					"content": "只不過，那位八重宮司也是位被命運裹挾之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970149,
					"content": "絲線的交纏往往會帶來麻煩，從這個角度來說，妳與她保持距離，倒也不是一件完全的壞事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970150
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746970150,
					"content": "如果只是請八重宮司幫忙看看映影稿件、給些意見，想必也牽涉不到那些「命運」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970151
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970151,
					"content": "正如我先前所說，這要看妳如何理解，夢見月小姐。我無法從一張牌裡看到妳未來的全部細節。",
					"roleType": "TALK_ROLE_NPC",
