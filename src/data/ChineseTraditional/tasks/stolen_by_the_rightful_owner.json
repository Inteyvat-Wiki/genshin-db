				}
			]
		},
		{
			"id": 7106607,
			"completionStepIds": [
				7106601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106601",
							"2"
						],
						"stepId": 7106601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔列辛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "咳咳…抱歉，抱歉，身為詩人總會嘗試更為戲劇化的表達，試驗更新穎的故事嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660702,
					"content": "嘿嘿，其實那枚戒指是幾年前，我從盜寶鼬的窩裡掏來的…看起來保存狀況還不錯，也挺好看的，就留在身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660703,
					"content": "哼，原來是偷了小偷的贓物呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660704,
					"content": "不要說得那麼難聽嘛…是拾取，拾取才對！我還是很珍惜這件寶物的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660705,
					"content": "關於戒指，有什麼線索嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "嗯…聽說附近經常有盜寶鼬出沒，說不定是這些小東西趁我睡下，把我的戒指偷走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660707,
					"content": "原來還有人睡覺會摘戒指的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660708,
					"content": "沒聽說過呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "反正我是不會啦！摘下戒指還要考慮放在哪裡，就浪費了好好睡覺的時間啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660710,
					"content": "真的有給派蒙戴的小戒指嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "#哼，當然有啦。世界之大，{F#妳}{M#你}不知道的東西還多得是呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660712,
					"content": "好了，請兩位不要再隨意評論別人的生活習慣，然後自顧自扯閒了！很不禮貌的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660713,
					"content": "總之，如果要幫忙找戒指的話…嗯，請找一找有沒有盜寶鼬的巢穴吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660714,
					"content": "#我聽說在地圖的這個地方…盜寶團設立了可疑的營地。來，我為{F#妳}{M#你}標出來好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660715,
					"content": "據說在這一帶常有盜寶鼬出沒，很可能與那些鬼鬼祟祟的盜寶團有關…總之，還是請先去這裡察看一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660716,
					"content": "哼…從盜寶鼬窩裡偷來的戒指，又被盜寶鼬偷回去，也算是物歸原主了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660717,
					"content": "請不要再挖苦我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
