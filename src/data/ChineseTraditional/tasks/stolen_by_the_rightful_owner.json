			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "#{F#妳}{M#你}好，最近發生什麼事情了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660802,
					"content": "關於盜寶鼬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "#喔喔，{F#妳}{M#你}是說層岩巨淵的盜寶鼬吧？哈哈…原本是歸我管的，結果被我搞砸了…沒什麼好說的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660804,
					"content": "嗯…喔，讓我把牠們再抓起來是不太可能啦…畢竟這些小傢伙神出鬼沒，實在難以追蹤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660805,
					"content": "不過呀，如果有誰的東西被那些壞傢伙偷掉的話，我能提供一點小小的提示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660806,
					"content": "盜寶團訓練飼養盜寶鼬，都會在固定的時間進行餵食。其中有三種不同的盜寶鼬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660807,
					"content": "最厲害的「大黃金盜寶鼬」…然後呢，是比較常見的「藏金盜寶鼬」，還有笨笨的「新手盜寶鼬」，不過出現的時間…",
					"roleType": "TALK_ROLE_NPC",
