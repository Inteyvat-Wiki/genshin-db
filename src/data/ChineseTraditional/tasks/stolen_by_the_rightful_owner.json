					"塔列辛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "唉…奇怪，奇怪，真是奇哉怪也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660102,
					"content": "應該還在的才對…可是怎麼也找不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660103,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "我的戒指…不見了。那枚戒指對我來說很重要，如果丟在這裡可不行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660105,
					"content": "你的戒指是什麼樣子的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "戒圈是黃銅的，上面鑲嵌了一枚漂亮的紅色寶石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660107,
					"content": "我是在傳說中魔龍杜林隕落之地旁邊的熔岩池拾到它的，這應當能解釋為何它會有陰燃的黑暗火焰光澤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660108,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660109,
					"content": "傳說它的主人一旦戴上它，就會受到「深淵之大君」的凝視，被它的黑暗大軍追殺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660110,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
