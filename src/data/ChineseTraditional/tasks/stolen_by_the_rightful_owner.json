				"points": []
			},
			"dialogs": [
				{
					"id": 710660201,
					"content": "#{F#妳}{M#你}回來了！怎麼樣，收穫如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660202,
					"content": "你看看，是不是這枚戒指？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106603,
			"completionStepIds": [
				7106604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106604",
							"2"
						],
						"stepId": 7106604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔列辛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "#沒錯，就是這枚！太感謝{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660302,
					"content": "#請收下這些報酬吧，雖然不是很多…不過請{F#妳}{M#你}不必介意，我也一定會把這件事寫進詩裡傳揚四方的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
			]
		},
		{
			"id": 7106605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
