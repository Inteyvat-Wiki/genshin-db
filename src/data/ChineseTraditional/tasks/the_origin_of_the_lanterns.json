			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "今年「明霄燈」的造型是紀念「移霄導天真君」啊，那個喜歡逞威風的傢伙應該會高興的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010602,
					"content": "關於「移霄導天真君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "今年海燈節在建造的「明霄燈」，就是「移霄導天真君」的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010604,
					"content": "希望他們會把鹿角修得大一些，畢竟頭上的角可是那位仙人最引以為傲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010605,
					"content": "據說，他的角吸收了岩王帝君岩之力的神髓，曾是整個璃月最堅硬的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010606,
					"content": "但就在「那場決戰」中，勁力迸出，山嶽傾倒，他為了不波及到山腳的村莊，主動讓朋友將他的鹿角砍下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010607,
					"content": "他將那鮮血淋漓的鹿角作為支點，撐起了整個山嶽。而他自己也堅持戰鬥到自己流盡最後一滴血…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010608,
					"content": "如今，曾被他撐起的「天衡山」依然巍然屹立，他死戰之中流出的鮮血則匯聚而成「碧水河」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010609,
					"content": "#呵呵…不論{F#妳}{M#你}是否相信我講的，能有人願意聽聽這些陳年舊事，就已經是很大的安慰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010610,
					"content": "海燈節之所以存在，也是因為那些「老朋友們」不甘寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010611,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "再見。願薪火相傳，美德不滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
		{
			"id": 4131106,
			"completionStepIds": [
				4131106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131106",
							"2"
						],
						"stepId": 4131106,
						"stateName": "QUEST_STATE_UNFINISHED"
