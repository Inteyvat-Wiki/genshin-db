			"trigger": {
				"objectNames": [
					"暢暢"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "暢暢呀，剛才把布娃娃捐了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "暢暢"
				},
				{
					"id": 400010902,
					"content": "昨晚我夢到她說想要飛到天上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "暢暢"
				},
				{
					"id": 400010903,
					"content": "我就把她捐給大鹿燈那邊的姐姐了，馬上她就會實現願望了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "暢暢"
				},
				{
					"id": 400010904,
					"content": "暢暢是做了件好事嗎？海燈節是實現大家願望的日子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "暢暢"
				}
			]
		},
		{
			"id": 4131105,
			"completionStepIds": [
				4131105
			],
