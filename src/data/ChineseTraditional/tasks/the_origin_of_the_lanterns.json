			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110101,
					"content": "海燈節又快到了啊，今年要不要把客棧打扮一下呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110102
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110102,
					"content": "海燈節？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110103
					]
				},
				{
					"id": 413110103,
					"content": "#{F#妳}{M#你}不知道嗎？每年的第一個月圓之夜，就是璃月的「海燈節」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110104
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110104,
					"content": "這是一個紀念英雄的節日，在夜裡，人們會放出「霄燈」和「明霄燈」，升上夜空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110105
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110105,
					"content": "那些燈的寓意，是「願薪火相傳，美德不滅」。我們相信夜海的明燈會引導過往的英魂歸鄉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110106
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110106,
					"content": "哇…聽起來是個很盛大的節日呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110107,
					"content": "說不定…還會有很多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110108,
					"content": "#{NICKNAME}，{F#妳}{M#你}能聽懂我的意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110109,
					"content": "你們是想要去參加海燈節嗎？那剛好。「海燈節」當夜之前的一段時間，都可以算是節日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110110
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110110,
					"content": "在這段時間裡，可以祈禱平安、祛除厄運。用璃月人的話說就是「辭舊迎新」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110111
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110111,
					"content": "如果你們想要參加的話，現在去也不遲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110112
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110112,
					"content": "還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110113
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110113,
					"content": "還有？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110114
					]
				},
				{
					"id": 413110114,
					"content": "如果可以的話…嗯…你們要試試邀請魈一起去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110115
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110115,
					"content": "他和我們的關係不近，我去問他也不太適合。但我看你們好像已經有點混熟了，不如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110116
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110116,
					"content": "可是，考慮到魈現在的心情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110117
					]
				},
				{
					"id": 413110117,
					"content": "嗯，這幾天去打擾他，確實有點不太好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110118,
					"content": "是嗎…沒關係！這也只是我隨口一說而已。你們還是快點去<color=#00E1FFFF>璃月港</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110119
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110119,
					"content": "要是去太晚，城裡就全都是人了，想要逛逛玩玩也就很吃力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110120
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 413110120,
					"content": "快去吧，祝你們海燈節玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
		{
			"id": 4131103,
			"completionStepIds": [
				4131103
