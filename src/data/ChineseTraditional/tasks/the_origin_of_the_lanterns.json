			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010203,
					"content": "多少錢也不賣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010205,
					"content": "你出不起我心中的價位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010202,
					"content": "#冒昧問一下。{F#妳}{M#你}身邊飄著的這個小東西，多少錢可以賣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010204,
					"content": "多少錢也不賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010206,
					"content": "這話聽起來怪怪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010207,
					"content": "說實話還有點在意…究竟這個價位是多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010208,
					"content": "#算了，我就當{F#妳}{M#你}是在說「多少錢也不賣」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010209,
					"content": "哈哈哈哈，最近手頭周轉不開，的確出不起價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010210,
					"content": "畢竟我只是個普通商人，也不販售奇珍異寶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010211,
					"content": "…聽語氣感覺很可疑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010212,
					"content": "別這麼說嘛。小傢伙，妳要吃糖嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010220,
					"content": "真不愧是派蒙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}，我認為這個人可以信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010214,
					"content": "對了，你們來璃月，也應該是衝著「海燈節」來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010215,
					"content": "今年的「明霄燈」壯景可期啊。用來讓巨燈浮空的那塊「浮生石」，是二十年來最大的一塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010216,
					"content": "大到讓人不禁要想，神話中雲間的浮城要是真的存在的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010217,
					"content": "也只是下面裝了一塊差不多大的浮生石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010218,
					"content": "聽起來好厲害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010219,
					"content": "#哈哈哈哈，有緣再見吧。歡迎{F#妳}{M#你}們來璃月——這話代表不了<color=#00E1FFFF>璃月港</color>，但我的小店永遠歡迎{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
