			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#{NICKNAME}，快看！那塊石頭浮在空中欸，而且連繩子都拉直了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110602,
					"content": "如果沒有繩子拴住，不知道它會飛去哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110603,
					"content": "這就是用來製作「明霄燈」的浮生石。整個「霄市」就是圍繞著它佈設的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110604,
					"content": "啊，請問妳是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110605,
					"content": "我是江舟，最近負責明霄燈的建設進度統計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110606,
					"content": "看樣子你們是第一次來璃月見識海燈節吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110607,
					"content": "沒錯…妳怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110608,
					"content": "去年我可不記得有帶著奇怪吉祥物的旅行者來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110609,
					"content": "所以妳說的「明霄燈」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "節日裡，人們手中放飛的小燈叫做「霄燈」。而全璃月人共同建造的巨燈，就是「明霄燈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110611,
					"content": "「霄市」上的攤位，是璃月各路商行一年一度、難得不為賺錢，只為籌集「明霄燈」的建設資材而開設的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110612,
					"content": "那「霄市」裡面，會有好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110613,
					"content": "那當然不少，而且如果問我的話，海燈節正是最適合品嚐璃月美食的節日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110614,
					"content": "這可是璃月一年裡最盛大的節日，要是能在海燈節上向大家展現出自家的手藝，必然能博得口碑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110615,
					"content": "所以，雖然不為賺錢，但各個商家暗地裡都卯足全力，在海燈節上一拼手藝的高低呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110616,
					"content": "從各個方面來說，璃月人都很厲害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110617,
					"content": "如果你們還有什麼問題的話，可以去找海燈節的負責人<color=#00E1FFFF>望雅</color>小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110618,
					"content": "她通常會在「霄市」附近待著，你們有什麼問題都可以去問她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110619,
					"content": "她會知道什麼店賣的東西最好吃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110620,
					"content": "那當然，海燈節的一切事情，望雅小姐都再清楚不過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110621,
					"content": "#知道啦，{NICKNAME}，我們趕緊去「霄市」上找那位<color=#00E1FFFF>望雅</color>小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110622,
					"content": "然後…去東西最好吃的那個攤販上吃個飽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4131107,
			"completionStepIds": [
				4131107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131107",
							"2"
						],
						"stepId": 4131107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110701,
					"content": "#{F#妳}{M#你}好，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110702,
					"content": "#看{F#妳}{M#你}的樣子…應該不是璃月人吧，是旅行者嗎？歡迎{F#妳}{M#你}來「霄市」玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110703
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110703,
					"content": "請問，妳是海燈節的負責人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110704
					]
				},
				{
					"id": 413110704,
					"content": "負責人…倒也算不上，海燈節是全璃月的節日，不是哪個人能夠負責的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110705
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110705,
					"content": "我也只是負責管理一些瑣事，努力讓海燈節更熱鬧罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110706,
					"content": "我有些事情想問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110707
					]
				},
				{
					"id": 413110707,
					"content": "我們想問問，「霄市」裡哪個攤子上賣的東西最好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110708,
					"content": "最好吃？各有各的特色吧，我也不能下結論。但是，我能告訴你們目前人氣最高的小吃攤位，是<color=#00E1FFFF>宜年</color>的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110709
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110709,
					"content": "如果那邊的人再多點，我就要去申請千岩軍維持秩序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110710,
					"content": "你們要去的話就快點去吧，趁現在人還沒把路佔滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110711
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110711,
					"content": "對了，你們要去找宜年的話，就順便幫我把這份文件帶給他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110712,
					"content": "這是我們總務司根據去年海燈節資料總覽，給各位商家的營業建議。你們既然要去，就順便幫我個忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110713,
					"content": "回來之後，我會送你們一件小禮物，作為報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				}
			]
		},
		{
			"id": 4131108,
			"completionStepIds": [
				4131108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131108",
							"2"
						],
						"stepId": 4131108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宜年"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110801,
					"content": "人手真的不夠，早知道就再帶點人出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110802
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110802,
					"content": "這裡有什麼好吃的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110803,
					"content": "是客人嗎？看這邊，菜單上寫的能做，你們想吃什麼直接說，我也能做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110804
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110804,
					"content": "哇！那我要吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110805,
					"content": "不過，雖然說是小吃攤…但看起來什麼都有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110806,
					"content": "那當然，什麼菜我不會做，快點點菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110807
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110807,
					"content": "這是望雅給你的文件。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110808
					]
				},
				{
					"id": 413110808,
					"content": "又來了，每年都來，什麼營業建議——除了菜餚的味道之外，我不需要什麼其它手段！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110809
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110809,
					"content": "算了，把這文件給我吧，我等等就把它餵給爐子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110810
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110810,
					"content": "快點菜吧，你們不是來吃東西的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110811
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110811,
					"content": "這麼多好吃的，這個看起來不錯，這個我也想吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110812,
					"content": "咦，「烤吃虎魚」？我記得，那好像是那位「銅雀」很喜歡吃的菜來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110813,
					"content": "唔…既然海燈節是紀念英雄的節日，那我們就點這道菜吃，也用這種方式來紀念一下他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110814,
						413110815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110814,
					"content": "妳明明就是自己想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				},
				{
					"id": 413110816,
					"content": "妳這小傢伙還挺會吃的，一點就點到了我們最有特色的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110817
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110817,
					"content": "那你們在這等一下，菜一會就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110819
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110819,
					"content": "好了，這是你們點的「烤吃虎魚」，吃吃看味道怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110820
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110820,
					"content": "好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110821,
					"content": "派蒙對於吃真是很在行啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110822
					]
				},
				{
					"id": 413110822,
					"content": "#那當然，我可是{F#妳}{M#你}最好的嚮導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110823,
					"content": "哈哈哈，那你們慢慢吃吧，我要接著去招呼客人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110824
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110824,
					"content": "如果還想再吃的話，過來點就是了，我隨時歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110815,
					"content": "真是派蒙的作風…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				}
			]
		},
		{
			"id": 4131111,
			"completionStepIds": [
				4131111
