			"dialogs": [
				{
					"id": 3900401,
					"content": "看來我們破除機關的方式是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3900402,
					"content": "現在這座塔裡，還有三層護封的輝環…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900403
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3900403,
					"content": "也就是說，還要尋找三座<color=#00E1FFFF>「導光機關」</color>，才能解開所有封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900404
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900404,
					"content": "看，從這裡就能看到一座…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900405,
					"content": "剩下的也一定都在廢墟內部，圍繞這座高塔分佈。找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3900406,
					"content": "……住在這種又是機關又是封印的地方，特瓦林平常回家不嫌麻煩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3900407,
					"content": "牠不用從走人的地方走啊，牠用飛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3900408,
					"content": "…你，說得很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
