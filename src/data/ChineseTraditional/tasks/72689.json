			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "#兩位，{F#妳}{M#你}們果然按時前來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890102,
					"content": "#經過兩次修習，{F#妳}{M#你}們對於花藝的理解有了質的飛躍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890103,
					"content": "因此，今天的「花題」將稍有變化，在兩位的構圖思維中開墾一方新的培土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890104,
					"content": "我們準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "唔…這麼一說，我忽然有點緊張了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726890106,
					"content": "呵呵，不必忐忑。放鬆身心，平心靜氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890107,
					"content": "憑兩位的才華，深思「花題」後，相應的圖景就會在腦海中浮現出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890108,
					"content": "過獎了，請賜教。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "那麼，今天的花題是「棲憑翠羽，遐籟生花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890110,
					"content": "兩位會給出怎樣的答卷呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890111,
					"content": "還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "沒關係。「插花」需要安神定氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890113,
					"content": "等到二位忙完手頭的事，擺脫了喧擾。必定能將題中的「花庭」構築得更加完滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268903",
							"2"
						],
						"stepId": 7268903,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268901",
							"2"
						],
						"stepId": 7268901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "接下來的幾天，我會一直守候在這裡，引導容彩祭的客人們，讓他們感受「花影瑤庭」的精妙之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "#兩位也別忘了每天揭曉一道的「花題」喔，一共有四道「花題」等著{F#妳}{M#你}們作答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "#當然，要是兩位還有其他問題，我也會盡力為{F#妳}{M#你}們解答的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "關於這裡的花卉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有著難以挑剔的品質和親民的價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "#也許{F#妳}{M#你}們已經見過咲耶了，我們曾在同一位老師門下學習「插花」的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "咲耶對於花藝的理解也可圈可點，但是聽說容彩祭的客人絡繹不絕時，她似乎有些怯場，認為在這種環境裡難以靜下心來插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "所以，我也會向其他客人宣傳她的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "有機會的話，我們也可以幫忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870219,
					"content": "那麼，還有什麼問題嗎，兩位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "謝謝妳，柴染小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "#不用客氣。如果{F#妳}{M#你}們有空，隨時都可以來找我喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "關於社奉行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行一直支持著稻妻的花藝事業。準確來說，為這次活動出資的貴人，是那位白鷺公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鷺公主自小就表現出驚人的花藝天賦。我曾看過她的「插花」表演，有幸與她交流過心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "雖說我比她年長，但論插花的技巧和對花藝的理解，完全沒法與她相提並論呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "在條件允許的情況下，白鷺公主每年都會提供資金，推廣「插花」這門藝術。聽說有時她還會用掉自己的積蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鷺公主曾坦率表達過自己的願望——她想讓更多人瞭解「插花」，對花藝產生興趣，進而沉下心來修習這門學問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "原來綾華為稻妻的花藝付出過這麼多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870217,
					"content": "希望她的願望能實現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "#感謝兩位，{F#妳}{M#你}們真是善解人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "暫時沒有問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "#如果{F#妳}{M#你}們有空，隨時都可以來找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}