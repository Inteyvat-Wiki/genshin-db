			"dialogs": [
				{
					"id": 741870601,
					"content": "咳咳，第九軍團的士兵們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870602,
					"content": "#嗯？{F#妳}{M#你}們又是什麼人？該不會是那個埃斯特找來的幫手吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870603,
					"content": "的確如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "不是普通的幫手，是很強的幫手！我們是跟著卡西奧多大人一起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870609,
					"content": "#（看來{NICKNAME}和派蒙也頗有演戲的天分呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741870610,
					"content": "嗯…卡西奧多大人嗎？我聽說偉大的至尊將他派往埃雷莫利卡了，難道這麼快就回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870611,
					"content": "這個嘛，其實我們旁邊這隻就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870612,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741870613,
					"content": "咳，總之，我們是過來視察前線軍團情況的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870614,
					"content": "好吧，我猜也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870615,
					"content": "雖然我們沒有跟隨大部隊一起前往卡布狄斯堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870616,
					"content": "但作為殿後，留在這裡完成最後的「清理」工作，也算是合情合理吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870617,
					"content": "這也是「福波斯」的命令嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "這個嘛…「福波斯」本應指引我們的一切行動，但自從來到這裡之後，我們卻常常無法接收到「福波斯」的旋律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870619,
					"content": "因此，我們只能按照波愛修斯大人的指示來行動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870620,
					"content": "那個沒禮貌的傢伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "#喂，{F#妳}{M#你}這傢伙，竟然對波愛修斯大人出言不遜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870622,
					"content": "作為尊貴的調律師，波愛修斯大人凡事都遵照至尊的諭示行動，他的命令就等同於「福波斯」的律令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870626,
					"content": "或許「福波斯」也會犯錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "#{F#妳}{M#你}是雷穆利亞人嗎？難道{F#妳}{M#你}不知道創造「福波斯」的是全能的至尊與完美的先知？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870628,
					"content": "但你們也沒接收到旋律。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "唔…的確如此，但除了「福波斯」我們還可以相信什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870630,
					"content": "倘若我們走上了歧途，它怎麼會無動於衷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870623,
					"content": "至尊沒有要你們殘害無辜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "殘害無辜…雖然在戰爭開始前，至尊的命令是要我們救助這些脆弱的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870625,
					"content": "但現在我們的行為也被「福波斯」所默許，難道「福波斯」的律令會與至尊的聖意相違背嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870605,
					"content": "我們是至尊派來的特遣官。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "特遣官是什麼…喔，也沒錯啦，我們是跟著卡西奧多大人一起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870607,
					"content": "我們是卡西奧多的侍從。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "沒錯，我們可是卡西奧多大人的侍從呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "派蒙"
				}
			]
		},
