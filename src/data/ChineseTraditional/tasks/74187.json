					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870702,
					"content": "自從戰爭爆發以來，我的心中總有一種奇怪的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870703,
					"content": "我們追求的本應是自由與幸福，但「福波斯」卻一步一步將我們引向了這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870704,
					"content": "到底出了什麼問題呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870705,
					"content": "#如果{F#妳}{M#你}們回去的時候能面見至尊大人的話，也請將這裡的情況和我們的疑惑稟報給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870706,
					"content": "#拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "領頭的傢伙"
				},
				{
					"id": 741870707,
					"content": "嗯嗯，我們當然會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
