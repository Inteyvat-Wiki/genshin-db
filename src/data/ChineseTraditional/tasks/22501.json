					"content": "你確定能解決所有危險？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010902
					]
				},
				{
					"id": 225010902,
					"content": "我去的時候，自然會雇人與我同行，以防萬一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010903
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010903,
					"content": "現在很難得雇到人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010904
					]
				},
				{
					"id": 225010904,
					"content": "呃，這個…這個…這個倒真是個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
