			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "嗯…這一句還是不妥，不妥。唉，說不得還是要去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "您好您好，在下清晝，自詡詩客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010104,
					"content": "最近我偶得妙詩一句，卻始終不知道如何能續，思索至今，始終不得頭緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010105,
					"content": "最近天有異象，眾多隕石墜地，此類景觀實在人間少有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010106,
					"content": "我想，要是能去隕石近前一觀，搜得些許靈感，那下一句詩說不定就能水到渠成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010107,
					"content": "不，不太合適…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "不太合適？您這又是從何說起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
