			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "您說的「不太合適」，到底是指什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010202,
					"content": "摸到隕石的話會陷入昏睡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "唔，這件事我也有所耳聞，但如果只是近觀一番，想必也沒有什麼大礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010204,
					"content": "你能保證絕不摸隕石嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "這個…這個我心中自有分寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
