					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "#我思來想去，{F#妳}{M#你}的擔心不無道理，我還是不去隕石旁邊自找麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011202,
					"content": "那就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "況且，好詩未必一定以新奇詞句見長，於細微處見博大胸懷才更妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011204,
					"content": "以花草等微小之物入詩，或許也能寫出妙句，但世間詠花的詩文實在數量眾多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011205,
					"content": "#唔，俗話說「旁觀者清」，以{F#妳}{M#你}看來，何種花入詩合適？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
		{
			"id": 2250113,
			"completionStepIds": [
