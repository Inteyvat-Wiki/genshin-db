					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011301,
					"content": "唔…我思來想去，隕石是難得一見的異象，還是去看看才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011302
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011302,
					"content": "你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "但是，如果我直接到隕石前近觀，未免被隕石吸引了視線，只見隕石，不見周遭世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011304,
					"content": "「一葉障目」是詩客大敵。如果一開始就一味觀察隕石，反而做不出好詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011305,
					"content": "所以，我想要先遠觀隕石，概覽周遭，然後再近前細觀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011306,
					"content": "然後…這個，呃，路上魔物眾多，我又暫時沒法雇到人與我同去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011307,
					"content": "不知道您願不願意幫我個忙，去掃清了堵路的那些魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011308,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "好！好好好，那就勞煩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011310,
					"content": "你先答應我不會去摸隕石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "#這個…我，我答應{F#妳}{M#你}就是。哎呀，既然知道觸摸隕石就會昏睡不醒，我又怎麼會自涉險地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011312,
					"content": "不過…不知道那些觸摸隕石後昏睡之人，會做什麼樣的夢…我還真是挺好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225011313,
					"content": "咳咳，咳！那個，我開玩笑而已，請您快去掃清魔物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
