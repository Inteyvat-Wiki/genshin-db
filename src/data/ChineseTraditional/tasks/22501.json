				{
					"id": 225010801,
					"content": "萬一陷入昏睡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010802
					]
				},
				{
					"id": 225010802,
					"content": "#這{F#妳}{M#你}大可放心，我心中自有分寸。但是，觸摸隕石就會陷入昏睡，那昏睡之人，又會夢到什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010803
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 225010803,
					"content": "#真是讓人好奇…咳咳！咳，我只是說說，{F#妳}{M#你}放心吧，我絕不會把自己置於險地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
