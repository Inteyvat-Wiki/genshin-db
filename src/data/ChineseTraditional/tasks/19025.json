			"trigger": {
				"objectNames": [
					"重雲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "沒想到這麼容易就被找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250502,
					"content": "經驗不足吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "我還覺得我選的地方，應該能把我藏得很好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250505,
					"content": "我平時追尋的妖邪，都是隱藏蹤跡的大師。它們會藏在什麼地方，我粗略地總結了一些經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250506,
					"content": "就像這裡，周圍都是方正的東西，不少都積了灰，而光線也不能照得很通透，妖邪很喜歡停留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250507,
					"content": "還是把捉迷藏和方術關聯在一起了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "嗯，果然不該借鑑這樣的經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250511,
					"content": "既然被找到了，我就果斷認輸吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250512,
					"content": "不過投入進去以後，我覺得這種簡單的遊戲，也很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250513,
					"content": "那下次再一起玩吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "好啊，我們都多叫些朋友來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250517,
					"content": "那我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250515,
					"content": "幸好沒讓你當鬼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "呵呵，說得沒錯，我來找的話，恐怕一個時辰都找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250509,
					"content": "可是，一眼就被看到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "唔，確實，太緊張了，忽略了最應該注意的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250503,
					"content": "…為什麼會選在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
