				},
				{
					"id": 190250402,
					"content": "#{F#妳}{M#你}沒偷看吧，真的沒偷看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小樂"
				}
			]
		},
		{
			"id": 1902505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
