			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "怎麼樣，素材收集器的使用還順利吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950302,
					"content": "滿順利的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "這個「素材收集器」也是我的得意之作，不管是像之前那樣收集原材，還是像現在這樣儲存元素力，都能巧妙地做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950304,
					"content": "其實我也有把這個「素材收集器」重新命名的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950305,
					"content": "我覺得「素材收集器」就很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950306,
					"content": "確實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "是嘛，我倒是覺得這個名字的指代性質有些偏少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950309,
					"content": "好，把「素材收集器」交給我吧，這次也是一樣，試作工序需要一些觀察，尤其涉及到了元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950310,
					"content": "大概得等「大工機」裡的元素反應穩定下來以後才能繼續下一段工序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950311,
					"content": "#到時候再拜託{F#妳}{M#你}們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950307,
					"content": "非常合適。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
