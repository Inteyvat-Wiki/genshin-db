				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "伯特蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950102,
					"content": "#是{NICKNAME}和派蒙啊，來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950103,
					"content": "#我的獨一無二…我的「大工機」已經處理完{F#妳}{M#你}收集到的素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950104,
					"content": "處理的結果如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "那畢竟是我製作的機器，怎麼可能有問題！別看我這樣，我的技術可是在楓丹磨練出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950106,
					"content": "我好歹也是楓丹人，這世上沒人比我們更懂精密儀器的製作和操作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950107,
					"content": "上次只不過是準備倉促，又沒有人幫忙收集試運行的素材才會導致產出的玩具爆炸，這次就不一樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950108,
					"content": "是嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950109,
					"content": "如果這次玩具還是爆炸了，那跟著爆炸的就會是我最後的存款和下半生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950110,
					"content": "#{F#妳}{M#你}就算不相信我，也要相信我賭上下半生的覺悟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950111,
					"content": "我之前可沒覺得玩具製造商是需要這等覺悟的職業…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950112,
					"content": "好了好了，接下來就要進行下一道工序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950113,
					"content": "#以防萬一，我就在這裡問一下{F#妳}{M#你}們，三道工序裡，我們已經完成的是「原材收集」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950114,
					"content": "那下面的工序是「核心收集」還是「充能收集」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950115,
					"content": "「核心收集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "#恭喜{F#妳}{M#你}…答錯了。要是{F#妳}{M#你}真的去收集核心，那毀滅我下半生的功勞就將有{F#妳}{M#你}的一份了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950117,
					"content": "正確答案是「元素充能」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950121,
					"content": "總之…所謂的「元素充能」，就是帶著「素材收集器」處在被元素影響的狀態中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950122,
					"content": "比如我想收集水元素，就帶著「素材收集器」站在河流之中一段時間，我想收集雷元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950123,
					"content": "就得被雷劈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950124,
					"content": "#哎呀，{F#妳}{M#你}們可是冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950125,
					"content": "#我相信{F#妳}{M#你}們作為冒險家的體質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950126,
					"content": "相信的居然是體質嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "其實接觸元素生物是最好的辦法，我之前在稻妻旅遊的時候就標記了三處地點，經常有元素生物出沒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950128,
					"content": "本來我想如果實在沒有助手，就自己偷偷坐船去這些地方接觸元素生物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950129,
					"content": "那也太危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950130,
					"content": "#現在不是有{F#妳}{M#你}們在嘛，{F#妳}{M#你}們去這些地方碰碰運氣，看看有沒有元素生物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950131,
					"content": "#「元素充能」就交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950118,
					"content": "「充能收集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "哈哈，雖然看起來好像對了，但其實不是「充能收集」而是「元素充能」啦，沒想到我給出的兩個選項都不是正確答案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950120,
					"content": "他笑得真的好讓人生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "派蒙"
				}
			]
		},
