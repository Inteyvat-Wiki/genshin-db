			"dialogs": [
				{
					"id": 726950201,
					"content": "嗯…要是素材收集器每完成一次工序就要將素材導入機器，一次製造就要往返三次，收集素材就變得太麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726950202,
					"content": "我得想想有什麼改善的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				}
			]
