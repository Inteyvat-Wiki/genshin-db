			"trigger": {
				"objectNames": [
					"維納亞克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "真是難懂啊…明明是她說要去咖啡館寫報告的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190102,
					"content": "你怎麼一個人在這？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "唉，別提了，她一個人寫報告去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190105,
					"content": "昨天我們倆約在咖啡館見面，但她花了好長時間才出現，甚至連寫報告用的材料跟紙筆都沒帶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190106,
					"content": "我說她不該浪費寫報告的時間，結果她突然就又生氣了！說什麼報告她一個人寫就好了，還把我給趕了出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190107,
					"content": "#——真是豈有此理！{F#妳}{M#你}說對不對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190108,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "唉，不過她這反反覆覆生氣的性子，我也早就已經習慣啦，過幾天就會正常的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190110,
					"content": "——要是她的心情，也像機關那麼簡單就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190111,
					"content": "祝你好運。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "#嗯？怎麼連{F#妳}{M#你}說話也怪怪的…算啦，話說回來，這附近還有一些受影響的沙蟲，雖然放著不管也會慢慢消停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190114,
					"content": "#不過為了防止牠們威脅到過往的行人，{F#妳}{M#你}要是有空就幫忙解決一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190115,
					"content": "——順便一提，現在的元素環境和充能裝置都已經恢復正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190116,
					"content": "要想體驗「對沙蟲用殺蟲炮」的全功率輸出，現在就是最好的機會啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735190112,
					"content": "自求多福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "施芮婭上哪去了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}