			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲倆阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381101,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381102
					]
				},
				{
					"id": 705381102,
					"content": "咦！有新朋友來了！請坐請坐，一起喝茶吃飯聊聊天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381103
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381103,
					"content": "我叫哲倆阿，從須彌來，是個商人。最近我剛剛做完一單大生意，正在享受蒙德的自然風光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381104
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381104,
					"content": "我們還是第一次碰見在這個地方露營的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381105,
					"content": "通常來說，商人不是應該…守著自己的店鋪和貨物嗎？妳要是沒有直接說，我們完全猜不到妳的身分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381106,
					"content": "哎呀！商人也要休息的嘛，誰沒有幾個興趣愛好了？適度休息、適度休息~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381107
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381107,
					"content": "要知道，在我們須彌，就連每時每刻都被學業折磨的學生，都很看重這一點，會自己發明遊戲來解悶的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381108
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381108,
					"content": "我的第一桶金，就是代理一位學生發明的桌遊「滾滾炸炸菇」賺到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381109
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381109,
					"content": "那位天才般的學生說過，「工作是做不完的，要適當抽點空…偷偷懶~」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381110
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381110,
					"content": "她為我帶來了以前不敢想的財富，所以，我把她的話當成了人生信條！果然，每天都過得很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381111,
						705381112
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381111,
					"content": "這名字怎麼有點耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				},
				{
					"id": 705381113,
					"content": "哲哲哲…哲倆阿小姐，妳能不能仔細說說，代理那個…「滾滾炸炸菇」的經過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381114,
					"content": "#咦？{F#妳}{M#你}們也聽說過這個遊戲嗎？明明是好久以前的遊戲了…幾年還是十幾年？時間過得真的好快啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381115
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381115,
					"content": "說來很巧，當時，那位學生正打算返回家鄉，所以把不方便帶走的東西都賣掉，其中就包括「滾滾炸炸菇」的棋子和棋盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381116
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381116,
					"content": "那時的我只是個收廢品的雜貨商，有幸遇見了她，問了問棋子的事，她才想起自己發明的遊戲好像還有用，簡單向我介紹了一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381117
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381117,
					"content": "她說，如果我有心力，可以試著繼續營運這個遊戲。我就試著復刻了幾份，真的賣得很不錯！我的收入瞬間就漲了上去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381118
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381118,
					"content": "雖然「滾滾炸炸菇」沒能流行多久，就被其他遊戲取代了，但我賺到了做大生意的本錢，再也不用靠賣雜貨維持生計了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381119
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381119,
					"content": "可以說，那位天才學生的無心之舉，改變了我的命運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381120,
						705381121
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381120,
					"content": "真的會有這麼巧的事嗎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381122,
					"content": "仔細一想，其實也滿符合她的作風呢…說不定當時她隨手就做了好幾個遊戲？「滾滾炸炸菇」其實沒那麼重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381123,
					"content": "但用商人的方法，管理這些遊戲的這個權、那個權，一定很麻煩…她應該是覺得，省點心比賺摩拉更重要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381124,
					"content": "#沒錯吧，{F#妳}{M#你}們也覺得很神奇吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381125
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381125,
					"content": "後來我聽說，那位天才學生的家鄉是蒙德，從此就對蒙德有了無限的好感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381126
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381126,
					"content": "所以這麼多年來，我一直想找個機會，到蒙德來做一次生意，感受一下當地的風土人情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381127
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381127,
					"content": "蒙德果然沒讓我失望！我簽了一個大單，玩得很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381128
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381128,
					"content": "#所以{F#妳}{M#你}們兩位也不妨試試看哦，勞逸結合，找到讓自己舒舒服服生活的節奏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381121,
					"content": "居然就這麼出讓了作品！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381112,
					"content": "妳說的學生該不會是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				}
			]
		},
