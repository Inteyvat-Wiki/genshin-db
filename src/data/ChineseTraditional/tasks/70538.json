				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"波爾托"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2261.872,
							235.99,
							-784.188
						],
						"pointId": 6247
					}
				]
			},
			"dialogs": [
				{
					"id": 705380301,
					"content": "不愧是榮譽騎士和白色小幫手，兩三下就找到了這個逃犯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380302
					],
					"speakerTitle": "波爾托"
				},
				{
					"id": 705380302,
					"content": "之前，我的同僚們將她鎖定為嫌疑人，確認她的身分和離開蒙德的時間點後，誤以為她向荊夫港的方向逃走了，準備乘船離境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380303
					],
					"speakerTitle": "波爾托"
				},
				{
					"id": 705380303,
					"content": "沒想到，她居然深入了明冠山地，難怪怎麼樣都找不到她的蹤跡…反偵察意識還滿強的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380304
					],
					"speakerTitle": "波爾托"
				},
				{
					"id": 705380304,
					"content": "呃，我覺得她根本沒有躲避你們的意思，畢竟她根本沒有意識到發生了什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380305,
					"content": "總之，哲倆阿小姐雖然的的確確犯了錯，但她應該不是出於惡意的！請你們也不要對她太凶哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380306,
					"content": "那是當然，我聽說她態度還滿好的！對於積極配合的犯人，我們也會心平氣和地講道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380307
					],
					"speakerTitle": "波爾托"
				},
				{
					"id": 705380307,
					"content": "調查小隊說目前的事態和損失完全可以控制，我們只需要走一遍正規的流程，評估她導致的損失，罰她一筆適當的罰金就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380308,
						705380309
					],
					"speakerTitle": "波爾托"
				},
				{
					"id": 705380308,
					"content": "這種懲罰就夠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				},
				{
					"id": 705380310,
					"content": "呼…沒想到我們也參與了這次的事件…作為騎士團抓到犯人，居然是這種感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380311,
					"content": "話說回來，還好哲倆阿小姐是個冒失犯，而不是蓄意要破壞蒙德的酒業呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380312,
					"content": "不然，如果抓住了一個凶惡的傢伙，那人死不悔改，還大聲嚷嚷的話，我們一天的好心情也會被毀掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380313,
					"content": "希望哲倆阿小姐瞭解了自己的過失，受到懲罰後，不會太沮喪吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705380309,
					"content": "畢竟她本心不壞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				}
			]
		},
		{
			"id": 7053811,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
