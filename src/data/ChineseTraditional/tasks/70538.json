			},
			"dialogs": [
				{
					"id": 705381301,
					"content": "（看她好悠閒，不打擾她了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381302
					]
				},
				{
					"id": 705381302,
					"content": "（有道理，在這種偏僻地方露營的人，應該很不希望被打擾吧…我們悄悄離開好了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7053814,
			"completionStepIds": [
				7053801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
							"2"
						],
						"stepId": 7053801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲倆阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381401,
					"content": "（身為榮譽騎士，不能坐視不理！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381402
					]
				},
				{
					"id": 705381402,
					"content": "那…對不起了，熱情的哲倆阿小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381403,
					"content": "請妳理解，畢竟妳無意中犯下的錯，闖了很大的禍，事關蒙德的法律…我們只能出手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381404,
					"content": "#欸？{F#妳}{M#你}們在說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381405
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381405,
					"content": "#等等！{F#妳}{M#你}們怎麼在…摩拳擦掌？是要去打獵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381406
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381406,
					"content": "不用的不用的！我這裡的儲備食材還很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381407
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381407,
					"content": "哇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲倆阿"
				}
			]
		},
		{
			"id": 7053815,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
							"2"
						],
						"stepId": 7053801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲倆阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381501,
					"content": "（我不想越權行事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381502
					]
				},
				{
					"id": 705381502,
					"content": "（越權？怎麼突然說出這麼奇怪的一個詞…又好像在哪裡聽過…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381503,
					"content": "#（難道{F#妳}{M#你}的意思是，抓住犯人是其他騎士的職責？我們不能把自己分外的工作也做了…搶走別人的功勞？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381504,
					"content": "（嗯…想想也有道理呢！哲倆阿小姐雖然犯下了錯，但不像是凶惡的壞人…一般的騎士也能抓住她吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381505,
					"content": "（對於一般的騎士來說，這是輕輕鬆鬆就能累積功績的好機會，而這種功績對於我們來說也沒什麼用，就讓給他們好了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381506,
					"content": "（但哲倆阿小姐現在的地方又很偏，騎士們會不會一時半會找不到她？要想個辦法讓哲倆阿小姐回到蒙德城附近去才可以。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381507,
					"content": "#{F#妳}{M#你}們在小聲說什麼呢？難道是對我的放生理論很有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381508
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381508,
					"content": "啊！我們剛剛…聽哲倆阿小姐說到魚…突然在想晚餐該吃什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381509,
						705381510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381509,
					"content": "我突然想吃烤魚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				},
				{
					"id": 705381511,
					"content": "咦？唔…哦！對對對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381512,
					"content": "既然哲倆阿小姐都來到蒙德了，那一定不能錯過蒙德烤魚，吃起來又香又方便！還有…蜜醬胡蘿蔔煎肉，堆高高和火火肉醬麵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381513,
					"content": "#哎呀！{F#妳}{M#你}們不說我都忘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381514
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381514,
					"content": "之前光顧著談生意，談完生意就在遊山玩水，完全沒想起來在蒙德城內好好吃一頓飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381515
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381515,
					"content": "只是聽說，當地一間叫「獵鹿人」的餐館物美價廉，還有外送服務，就隨手下了幾天的訂單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381516
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381516,
					"content": "可是當時我也忘了問，哪些是蒙德當地的特色菜，送餐的服務生也未必能找到我露營的這個地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381517
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381517,
					"content": "還是說，妳過一段時間，還是回蒙德城裡，去好好吃一頓大餐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381518,
					"content": "嗯！我要順帶再找當地人問問蒙德的其他特產，帶回去給朋友們當伴手禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381519
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381519,
					"content": "我記得城門旁邊就有兩個騎士在站哨，他們應該很在行，可以給我很好的建議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381520
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381520,
					"content": "事不宜遲！我現在就回去一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381521
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705381521,
					"content": "哲倆阿興致勃勃地離開了營地，向著蒙德城的方向小跑步離去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705381522
					]
				},
				{
					"id": 705381522,
					"content": "結果哲倆阿小姐自己提出要去找騎士聊天了…不知道會不會在聊天的過程中直接被抓起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381523,
					"content": "不過，到時候騎士們應該也會意識到，她之前做的事是無心之舉吧，畢竟，哪有蓄意搞破壞的犯人會自己找上門來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381524,
						705381525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705381524,
					"content": "哲倆阿應該不會被嚴厲懲罰的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
