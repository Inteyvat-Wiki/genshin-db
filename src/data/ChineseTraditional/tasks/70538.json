					}
				]
			},
			"dialogs": [
				{
					"id": 705380101,
					"content": "真悠閒啊~蒙德的山林，的確是個露營的好地方！這趟生意跑得真值得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380102
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 705380102,
					"content": "濕度和溫度正剛好，不會隨便工作一下就渾身濕透，陽光也不刺眼，還有一股乾爽的香氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲倆阿"
				}
			]
		},
		{
			"id": 7053803,
			"completionStepIds": [
				7053803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
