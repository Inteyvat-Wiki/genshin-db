			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "剛才那個傢伙到底是什麼？簡直是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110402,
					"content": "嚇到了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "…簡直是完美的生命體，令人讚嘆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110405,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "他身上透露的那股神秘的氣息，危險卻又優雅的力量，真是太吸引人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110407,
					"content": "#真虧{F#妳}{M#你}能將這樣的存在擊敗，{F#妳}{M#你}的實力有點超乎我的想像了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110408,
					"content": "你的品味還真是獨特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "我們繼續前進吧，我已經越來越好奇、越來越興奮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110409,
					"content": "我只是經驗豐富罷了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "我以前見過類似的傢伙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
