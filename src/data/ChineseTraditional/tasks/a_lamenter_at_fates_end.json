			"trigger": {
				"objectNames": [
					"埃德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "好像…不是卡利貝爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110102,
					"content": "不是他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "嗯。卡利貝爾手臂上的絲巾是我以前送給他母親的禮物，如今被我拿來做記號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110105,
					"content": "我大概是眼睛也快撐不住了，連自己的兒子都認不清了，這副身體…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110106,
					"content": "不過這個丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "是啊，好像對我們完全沒有興趣，只是堅定地往那個方向走…那邊有什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110109,
					"content": "不清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "嗯，關於丘丘人…知道得越多越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110110,
					"content": "跟過去看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "稍微有點奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "他的手臂上沒有絲巾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
