			"dialogs": [
				{
					"id": 80110301,
					"content": "停下，人類。汝等並未獲准來此地探尋「命運」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "命運使徒"
				},
				{
					"id": 80110302,
					"content": "（深淵使徒？不對，好像從未在深淵教團見過這樣的傢伙…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "怎麼，汝等執意要「覲見」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "命運使徒"
				},
				{
					"id": 80110304,
					"content": "…也無妨，那就賜予汝等「命運的試煉」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "命運使徒"
				}
			]
		},
		{
