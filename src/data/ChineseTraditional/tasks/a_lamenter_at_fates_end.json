			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "卡利貝爾，謝天謝地，這裡一切如常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110602,
					"content": "不去祭拜七天神像了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "我…只是隱隱有種感覺，剛剛的事是某種命運的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110605,
					"content": "在我最不想祭拜神像的時候，發生了剛才的那件事，彷彿是對我的某種引導…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110606,
					"content": "#聽{F#妳}{M#你}說，我好像在「那個東西」前跪拜了，說不定…效果也差不多呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110607,
					"content": "真是莫名其妙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "#不管{F#妳}{M#你}怎麼說，我都要先嘗試一下…是{F#妳}{M#你}說過的，「總是要嘗試所有的可能性」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110610,
					"content": "再一次將藥餵給了丘丘人…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "卡利貝爾…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110612,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110613,
					"content": "爸…爸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110614,
					"content": "啊…卡利貝爾！天哪，這是真的，這是奇蹟，我的卡利貝爾！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110615,
					"content": "居然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "看到了吧，有效果了，卡利貝爾又能說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110618,
					"content": "媽媽呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110619,
					"content": "媽媽她…卡利貝爾，你先看著我，你認得出我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110620,
					"content": "嗯，你是爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110621,
					"content": "哈…哈哈哈…救贖，這就是獲得救贖的感覺嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110622,
					"content": "你現在感覺還好嗎，卡利貝爾，意識還清醒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110623,
					"content": "嗯…我好像睡了很久，夢裡我躲在一個小房間裡，一直一直不敢出去，但也不想出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110624,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110625,
					"content": "我的身體！我的身體怎麼了！這、這是我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110626,
					"content": "爸爸…這是怎麼回事！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110627,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110628,
					"content": "…不要慌張，兒子，只是…只是在你睡著的時候，我們到了一個童話裡的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110629,
					"content": "這個世界不再有坎瑞亞，不再有我們的家園，但同樣也沒有了紅色的天空和末日一樣的災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110630,
					"content": "你會像這樣，以一個小怪獸的模樣，和爸爸永遠在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110631,
					"content": "我…我是死了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110632,
					"content": "沒有，別亂說，卡利貝爾…你看你的手臂上還有媽媽的絲巾，她也在祝福和保佑你呢，你怎麼可能死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110633,
					"content": "這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110634,
					"content": "嗯，剛醒來的你可能有點混亂，你就先在這裡好好休息吧…一切都會好起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110635,
					"content": "哦對了…你一定要記得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110636,
					"content": "不要摘下面具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110637,
					"content": "記住了嗎？不要摘下面具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110638,
					"content": "好的…好的爸爸，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "卡利貝爾"
				},
				{
					"id": 80110639,
					"content": "父子間的對話持續了很久，埃德彷彿得到了救贖一般…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "從那一天起，我就從來沒有像現在這樣開心過…這居然是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110641,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "哼，我就知道什麼七神根本不可能依靠，呸…我居然還祭拜了七天神像，真是我此生最大的恥辱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110644,
					"content": "凶手，永遠都會是凶手，想要祂們拯救什麼，我真的是太天真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110645,
					"content": "反倒是，我們在洞穴裡見到的那位不知名的神，那才是真正偉大的神明，和七神什麼的不一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110646,
					"content": "那神秘的力量，令人癡迷…一定是我之前虔誠跪拜的緣故，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110647,
					"content": "哦這麼說來，向神明許願，願望得以實現之後，是不是應該…應該那個叫什麼「還願」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110648,
					"content": "反正求神的事我不太懂，但這次我覺得一定有必要去「還願」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110649,
					"content": "可是…那並不是神明，埃德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "#「罪人」？喂，{F#妳}{M#你}在胡說什麼，{F#妳}{M#你}對那位神明有什麼瞭解，怎麼敢如此出言褻瀆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110652,
					"content": "#祂的神力{F#妳}{M#你}也已經看到了，七神怎麼可能帶來這樣的奇蹟？祂只會是高於七神之上的神，「罪人」什麼的根本莫名其妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110653,
					"content": "#算了…不管{F#妳}{M#你}如何看待，都影響不了我的虔誠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110654,
					"content": "#我現在就去還願，{F#妳}{M#你}不跟著來也無所謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110655,
					"content": "你這傢伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "（埃德的心智好像受到了影響…雖說他本來就不太正常，但現在這種狂熱實在有點…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "（唉，還是追過去看看吧，記得那附近魔物不少，總不能眼睜睜看著他落在魔物手裡…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "隨便你吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "那是…「罪人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "的確不可思議。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "不可思議。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110608,
					"content": "好吧，如果你執意要這麼認為…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110603,
					"content": "怎麼直接回來了。",
					"roleType": "TALK_ROLE_PLAYER",
