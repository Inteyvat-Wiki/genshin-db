			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "這裡好陰森。這個地方…以前也存在嗎？好像從來沒有發現過這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110202,
					"content": "你看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "啊？他們…他們是在膜拜什麼嗎？一邊走，一邊跪拜…看起來很虔誠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110205,
					"content": "我從未見過這樣的景象，這個地方究竟藏了些什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110206,
					"content": "只有一探究竟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110207,
					"content": "（這裡的氣氛、詭異的情景，難道…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "那些丘丘人在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
