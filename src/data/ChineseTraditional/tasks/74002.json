			"dialogs": [
				{
					"id": 740021001,
					"content": "#{F#妳}{M#你}們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021002
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021002,
					"content": "#凱特上校和莫里在{F#妳}{M#你}們行動的期間，也來和我們會合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021003
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021003,
					"content": "哼哼，我們已經拿到莉利絲公主的寶物啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021004,
					"content": "#幹得好，士兵！這可是大功一件。抵抗陣線為{F#妳}{M#你}們驕傲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021005
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021005,
					"content": "凱特，別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021006
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021006,
					"content": "#等等，「上校」。{NICKNAME}是我們管弦樂團的聯絡人，才不是什麼雜牌軍炮灰小兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021007
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021007,
					"content": "#哈！如果你們組織容得下{NICKNAME}，那豈不是要改名叫{NICKNAME}管弦樂團才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021008
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021008,
					"content": "#哼！你上校的頭銜應該讓給{NICKNAME}才對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021009
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021009,
					"content": "讓士兵流血，自己居功的長官很常見，但「上校」您這樣不但一事無成，連風頭都讓士兵搶走的軍官，那就真的是稀有動物了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021010
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021010,
					"content": "#你…！你蹲在這裡無所事事的時候，我可是把穹頂水中的水泡陣地拿下來了，{NICKNAME}{M#他們}{F#她們}才能順利拿到寶物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021011,
						740021014,
						740021015
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021011,
					"content": "大家，請不要為我爭吵了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021012
					]
				},
				{
					"id": 740021012,
					"content": "#嗚哇，好有{F#女主角}{M#主角}氣勢的發言！那個，要不…要不然這麼辦吧！就叫「派蒙上校抵抗陣線」和「派蒙管弦樂團」怎麼樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021013,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021016,
					"content": "啊啊，煩死了！莫里，上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021017
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021017,
					"content": "汪汪！壞傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021018
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 740021018,
					"content": "莫里將雅克拱翻在地。\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740021019
					]
				},
				{
					"id": 740021019,
					"content": "莫里將雅克拱翻在地。\\n凱特上校幸災樂禍地笑了。\\n隨後莫里轉身又將凱特拱翻在地。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740021020
					]
				},
				{
					"id": 740021020,
					"content": "最後在阿爾與小高麗菜的調解下，騷動平息下來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740021021
					]
				},
				{
					"id": 740021021,
					"content": "真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021022
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021022,
					"content": "莫里在這種時候很可靠呢…在某種意義上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021023,
					"content": "該做正事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021024
					]
				},
				{
					"id": 740021024,
					"content": "嗯！總這樣也不是辦法，而且，如果不繼續行動，大家又會吵起來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021025,
					"content": "#嗯…{NICKNAME}騎士、派蒙，{F#妳}{M#你}們說得對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021026
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021026,
					"content": "那麼，安來一段演講吧！振奮人心的那種！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021027,
					"content": "欸？但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021028
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021028,
					"content": "我很贊同派蒙的說法。在這種時刻，冒險團的「團長」才更應該站出來，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021029
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021029,
					"content": "我不擅長這種事情…而且，說我是「團長」也實在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021030
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021030,
					"content": "我以上校的名譽擔保，如果水仙十字冒險團需要一個軍官的話，你是最合適的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021031
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021031,
					"content": "且不提上校的名譽一文不值，我們的看法是一致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021032
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021032,
					"content": "#那個，我不懂什麼團長、什麼名譽的事情喔，不過，如果沒有安、沒有安帶來的{NICKNAME}騎士和派蒙，現在我都不知道怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021033
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021033,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021034
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021034,
					"content": "#{NICKNAME}騎士、派蒙，{F#妳}{M#你}們覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021035,
						740021036
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021035,
					"content": "這是大家的願望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021038
					]
				},
				{
					"id": 740021038,
					"content": "嗯…那，作為冒險團的團長，這時候我應該做什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021039
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021039,
					"content": "唔，我想想…既然我們拿到了莉利絲公主的寶物，接下來就應該進入高塔、解救莉利絲公主了，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021040
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021040,
					"content": "那在行動前，團長應該發表激勵人心的演說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021041
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021041,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021042
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021042,
					"content": "#派蒙，妳有沒有興趣當團長？或者，{NICKNAME}騎士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021043
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021043,
					"content": "喂！怎麼可以這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021044,
					"content": "#畢竟，都是依靠{F#妳}{M#你}們的力量，才有這樣的進展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021045,
						740021046,
						740021047
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021045,
					"content": "歸根結柢，我們只是外援。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021051
					]
				},
				{
					"id": 740021051,
					"content": "總之，只有安才適合擔任水仙十字冒險團的團長，這也是大家的願望，妳就別推辭了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021052
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021052,
					"content": "支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021053
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021053,
					"content": "啊啊！團長什麼的，這樣一來，感覺以前很輕鬆的事情，現在都變得有點沉重了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021054
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021054,
					"content": "那麼…咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021055
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021055,
					"content": "不管組織的名字是什麼，我們大家都是水仙十字冒險團的成員。我們有著一致的目的，那就是拯救莉利絲公主…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021056
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021056,
					"content": "莉利絲小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021057
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021057,
					"content": "…或者莉利絲小姐，並將水仙十字王國…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021058
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021058,
					"content": "共和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021059
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021059,
					"content": "（發出威脅的低吼聲。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021060
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 740021060,
					"content": "咳咳。安，請繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021061
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021061,
					"content": "…並將水仙十字王國光復，讓這片土地與其中的水域，再次變得閃閃發光，讓向日葵再度盛開。沒有錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021062
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021062,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021063
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021063,
					"content": "我們在漫長的歲月中經歷了許許多多的鬥爭與分離，當初冒險團的夥伴們有的已經不在我們的身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021064
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021064,
					"content": "但我永遠不會忘記一同度過的時光。我們永遠都是朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021065
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021065,
					"content": "…對啊，我明白了。儘管我現在是水仙十字冒險團的團長，但在作為大家的團長之前，我首先應該是大家的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021066
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021066,
					"content": "凱特上校、雅克，你們也一樣。不要因為信念和立場的區別，就忘記友誼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021067
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021067,
					"content": "（安說出了很成熟的話呢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021068,
						740021071
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021068,
					"content": "好！（鼓掌）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021069
					]
				},
				{
					"id": 740021069,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021070
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021070,
					"content": "真是的，別捉弄我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021072
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021072,
					"content": "#這次，藉助{NICKNAME}騎士與派蒙的力量，我們終於取得了莉利絲公主的寶物。塵封的時間將再度流逝，我們將拯救莉利絲公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021073
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021073,
					"content": "#正直又厲害的{NICKNAME}騎士、派蒙，謝謝{F#妳}{M#你}們，{F#妳}{M#你}們永遠都會是我們的朋友。我相信，莉利絲公主也會很高興地將{F#妳}{M#你}們視為朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021074
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021074,
					"content": "好、好了，講完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021075
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021075,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021076,
						740021078
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021076,
					"content": "好！（鼓掌）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021077
					]
				},
				{
					"id": 740021077,
					"content": "好！那麼，接下來…我們應該怎麼做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021079
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021079,
					"content": "這個嘛…我想想，這時候應該向停滯的高塔，釋放寶物中的力量。這樣一來，「時間」就會再度開始流逝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021080
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021080,
					"content": "像這樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021081
					]
				},
				{
					"id": 740021081,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021082
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021082,
					"content": "#由衷感謝{F#妳}{M#你}，{NICKNAME}騎士。這樣一來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021083
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021083,
					"content": "很遺憾，接下來會發生什麼事情，恐怕我{RUBY#[D]水仙十字冒險團}們誰也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021084
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021084,
					"content": "但是，既然現在公主的高塔封印已經解除，我們要盡快行動才行，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021085
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021085,
					"content": "嗯，小高麗菜說得對。我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 740021078,
					"content": "接下來應該怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021079
					]
				},
				{
					"id": 740021071,
					"content": "（很不容易呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021072
					]
				},
				{
					"id": 740021046,
					"content": "舉手之勞而已，我就不僭越了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021051
					]
				},
				{
					"id": 740021047,
					"content": "那我就會變成「騎士團長」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021048
					]
				},
				{
					"id": 740021048,
					"content": "聽起來好累，還是算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021049
					]
				},
				{
					"id": 740021049,
					"content": "#如果有一天，{NICKNAME}變成了騎士團長，記得要讓我當榮譽騎士喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021050
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021050,
					"content": "榮譽騎士派蒙，聽起來很響亮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021051
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021036,
					"content": "這是你們之間的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021037
					]
				},
				{
					"id": 740021037,
					"content": "#{NICKNAME}的意思是，既然大家都這麼說了，安你就接受吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021014,
					"content": "我聽夠了，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021016
					]
				},
				{
					"id": 740021015,
					"content": "首先，我沒加入你們任何一方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021016
					]
				}
			]
		},
		{
			"id": 7400213,
			"completionStepIds": [
				7400213
