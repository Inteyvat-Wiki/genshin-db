					"nextDialogs": [
						740021607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021607,
					"content": "#嗯。{NICKNAME}騎士、派蒙，我們要小心。莉利絲公主只能靠我們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 740021606,
					"content": "去看看傳送門的另一邊有什麼吧。",
