			"dialogs": [
				{
					"id": 740020801,
					"content": "終於找到了…最珍貴的寶物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020802
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020802,
					"content": "看起來是一塊懷錶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740020803,
					"content": "似乎不會動了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740020804
					]
				},
				{
					"id": 740020804,
					"content": "唔，一直泡在水裡，應該早就壞了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740020805,
					"content": "在這裡面，滿滿地裝著莉利絲公主所有珍貴的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020806
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020806,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020807
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020807,
					"content": "我們回去吧。回到高塔下，與朋友們再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
