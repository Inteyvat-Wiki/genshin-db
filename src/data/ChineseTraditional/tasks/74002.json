			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅克",
					"阿爾",
					"安",
					"小高麗菜",
					"凱特上校",
					"莫里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740021301,
					"content": "納西索斯手下這些嘍囉怎麼這麼多頭銜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021302,
					"content": "越是沒用的人，越是需要帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021303
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021303,
					"content": "#其實，這些都是納西索斯手下的猛將，和我們交鋒多次，也對我們造成了不少損失。但{NICKNAME}實力高強，所以他們不構成威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021304
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021304,
					"content": "#抱歉喔…{NICKNAME}騎士，我們的攻擊對納西索斯的爪牙沒有效果，所以只能辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021305,
						740021306
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021305,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021307
					]
				},
				{
					"id": 740021307,
					"content": "唔…不過，莉利絲公主在哪裡呢？接下來好像也無路可走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021308,
					"content": "接下來的事情，我也沒想過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021309
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021309,
					"content": "唔…那就向上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021310
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021310,
					"content": "欸？要怎麼上去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021311,
					"content": "派蒙飛上去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021312
					]
				},
				{
					"id": 740021312,
					"content": "喂！就算我自己能上去…如果在上面，遇到了納西索斯的手下怎麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021313,
					"content": "#就算上面都是水仙十字王國的寶藏…也要和{NICKNAME}一起，才有找到寶藏的感覺嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021314,
					"content": "向上啊…我明白了。我們或多或少也擁有一定的力量，雖然說仰仗的是莉利絲公主分給我們的魔法，但也能做到一些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021315
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021315,
					"content": "嗯…但是，這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021316
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021316,
					"content": "明明我們都是同源的，這種事情你應該最容易理解、最容易接受才對。而且，以前不是也經歷過嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021317
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021317,
					"content": "我知道，道理我都懂。但是，對這種事情，不知道為什麼，我就是很討厭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021318
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021318,
					"content": "別露出這樣的表情嘛，安。我們原本是同樣的一團水，不分彼此，只是為了陪伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021319
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021319,
					"content": "為了陪伴公主，所以用薄薄的膜將自己包裹，化成了不同的身形。那為了公主，我們再度聚合在一起，也沒什麼奇怪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021320
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021320,
					"content": "所以，你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021321,
					"content": "只要我們放棄形體聚合在一起，就能產生相對比較強大的魔力。這樣的話，就能夠把你們送上塔頂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021322
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021322,
					"content": "欸？但那樣的話——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021323,
					"content": "毋須擔心，朋友。我們來自同樣的水體，放棄形體並不如妳所想意味著死亡。純水能化作林野百態，而這種變化並非是單向的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021324
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021324,
					"content": "嗯！就算沒有一起冒險與戰鬥，我們也能這樣一起前進！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021325
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021326
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021326,
					"content": "#{NICKNAME}騎士、派蒙，{F#妳}{M#你}們覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021327
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021327,
					"content": "這件事不應由我們做主。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021328,
						740021329,
						740021330
					]
				},
				{
					"id": 740021328,
					"content": "只有你能決定水仙十字冒險團的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021331
					]
				},
				{
					"id": 740021331,
					"content": "#唔…{NICKNAME}說得對，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021332,
					"content": "團長，請下令吧！高塔的封印已經解除，也失去了抵禦納西索斯入侵的能力！我們應當分秒必爭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021333
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021333,
					"content": "…好吧。那就拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021334
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021334,
					"content": "得令！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021335
					],
					"speakerTitle": "凱特上校"
				},
				{
					"id": 740021335,
					"content": "#交給我們吧！安，你要跟{NICKNAME}騎士和派蒙一起，把莉利絲公主救出來喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021336
					],
					"speakerTitle": "小高麗菜"
				},
				{
					"id": 740021336,
					"content": "哼。莉利絲小姐就交給你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021337
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 740021337,
					"content": "那麼，親愛的小高麗菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021338
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021338,
					"content": "…還有莫里、凱特上校，和雅克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021339
					],
					"speakerTitle": "阿爾"
				},
				{
					"id": 740021339,
					"content": "嗯。拜拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021340
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 740021340,
					"content": "啊，和之前在莫里的噴泉那邊的，一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740021341,
					"content": "我們的力量，都來自莉利絲公主。所以，只要能下定決心，也能夠再現她的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021342
					],
					"speakerTitle": "安"
				},
				{
					"id": 740021342,
					"content": "#啊啊不行！要打起精神來！{NICKNAME}騎士、派蒙，我們上去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 740021329,
					"content": "只有你能決定是否應該繼續前進。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021331
					]
				},
				{
					"id": 740021330,
					"content": "這是你的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021331
					]
				},
				{
					"id": 740021306,
					"content": "勉勉強強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021307
					]
				}
			]
		},
