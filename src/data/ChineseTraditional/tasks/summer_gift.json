				"points": []
			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "應該就是這個了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080102,
					"content": "嗯？旁邊還有一封信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080103,
					"content": "致有緣來到這裡的朋友，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080104,
					"content": "你好呀，遠方的人。如果你能看到這封信，應該是找到了我留下的羽球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080105,
					"content": "金蘋果群島上有不少跟羽球有關的遊戲，我和我的朋友們在這裡度過了一個非常快樂的夏天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080106,
					"content": "所以我在這裡留下我製作的羽球，但願偶然發現這個羽球的你也能體驗到與我相同的快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080107,
					"content": "請盡情享受陽光、海風與夏日遊戲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080108,
					"content": "——芭芭拉",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "調查"
				},
				{
					"id": 790080109,
					"content": "不愧是芭芭拉，托她的福，我們也有羽球啦！走吧，讓我們玩個痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調查"
				}
			]
		},
