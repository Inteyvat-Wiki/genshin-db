			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲林斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#哦？是{NICKNAME}和派蒙兩位。沒想到會在如此偏僻的地方與{F#妳}{M#你}們重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030102,
					"content": "#{F#妳}{M#你}們是追尋著某種線索而來，還是意外地迷路至此？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030103,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "原來如此。從這艘廢船的甲板望去，月矩力試驗設計局那龐大的輪廓，的確有種…異樣的壯觀，如同蟄伏的巨獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030106,
					"content": "是啊，光是這樣遠遠地看著，都很有壓迫力呢。不知道裡面到底藏著多少秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030107,
					"content": "#嗯，對於尋求獨特素材的{F#妳}{M#你}們而言，它能提供不少靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030108,
					"content": "畢竟，光明與黑暗的交界，往往最能誕生引人入勝的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030109,
					"content": "嘿嘿，菲林斯站在這裡，身邊總伴著那盞幽藍的燈，看起來就很有故事性呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030110,
					"content": "說起來，你今天不用駐守在…呃…那個地方嗎？是在休假？還是在巡邏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030111,
					"content": "算是兩者兼而有之吧。守望那些可能從陰影中滋生的災禍，便是我們「執燈士」永恆的職責。無論身處何地，這股警覺都不能鬆懈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030112,
					"content": "#不過，目前為止，此地的氣息還算平穩。{F#妳}{M#你}們大可不必過於緊張，安心進行{F#妳}{M#你}們的創作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030113,
					"content": "機會難得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "為我留影嗎？這倒是有點出乎我的意料。說實話，我並不太習慣站在鏡頭面前，成為被審視的對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030116,
					"content": "#{F#妳}{M#你}們一定能夠理解的。我更習慣與沉默的墓碑為鄰，與逝者的低語為伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030117,
					"content": "不過，若是拒絕朋友這個真誠的請求，未免也太不解風情，失了待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030118,
					"content": "#請隨意，記錄{F#妳}{M#你}們認為值得留存的瞬間。我很樂意為{F#妳}{M#你}們的藝術創作增添一份微不足道的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030114,
					"content": "可以為你拍攝畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
