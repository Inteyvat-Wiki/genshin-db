			"trigger": {
				"objectNames": [
					"瓦樂瑞娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "#嗚啊，是貓貓救星和白貓魔法師！居然等來了{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470102,
					"content": "咦？妳剛剛叫我們什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470103,
					"content": "好像有點耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "唔…總感覺，我們之前應該見過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470106,
					"content": "哈哈！白貓魔法師對我還有印象，瓦樂瑞娜大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470107,
					"content": "敘舊可以等到稍後，現在，要不要先試試我贊助的新遊戲？讓我最近開心整整一星期的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470108,
					"content": "嘟嘟可爆轟大亂鬥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470109,
					"content": "有…有好多種嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470110,
					"content": "而且每種都很眼熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#{F#妳}{M#你}看，貓貓救星…咳咳，應該說，閃閃發光的！可敬的榮譽騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470113,
					"content": "這個嘟嘟可玩偶就是以您為形象參考設計的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470114,
					"content": "#真，真的欸，配色和花紋都是{NICKNAME}的風格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470115,
					"content": "在遊戲中，火花嘟嘟可、閃光嘟嘟可、騎兵嘟嘟可、魔法嘟嘟可要有效合作，使用炸彈戰勝前所未見的敵人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470116,
					"content": "我只負責遊戲的贊助和營運，不懂開發的細節，也不知道這些敵人的原型在現實中長什麼樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470117,
					"content": "但我相信，就算哪天真的碰面了，奇妙無比的嘟嘟可一定能打敗它們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470118,
					"content": "那是當然，什麼樣的魔物都擋不住小可莉和她的好夥伴嘟嘟可，我們也這麼覺得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705470119,
					"content": "那就來試試看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "#嘿嘿，{F#妳}{M#你}們一定也能從中獲得快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705470120,
					"content": "新的嘟嘟可遊戲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "原型顯而易見了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "沒聽過的新外號…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}