	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊維斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "真是倒楣，我絕對不能再下水了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "是您啊。見到您真好，呼…我差點把命丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200105,
					"content": "我剛剛和往常一樣下水工作。下潛了之後，我避開了水草、躲過了垃圾，也沒被什麼東西劃傷或者刺中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200106,
					"content": "但就在我打撈東西的時候，水底的泥巴裡突然竄出了一群怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200107,
					"content": "我不記得到底是什麼怪物了，只記得它們猛烈地撞了過來，我只能趕緊逃跑，一直往上游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200108,
					"content": "但游了沒多遠，又遇到了一群奇奇怪怪的機關，它們看見了我，也跟瘋了一樣朝我衝了過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200109,
					"content": "我都不知道是怎麼逃上岸的，還好沒受什麼傷，潛水服也沒損壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200110,
					"content": "這麼危險，那就別在這裡打撈了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "那怎麼可以。這裡是戈爾德曼劃定的地點…之前就有不少人在這裡打撈時受了傷，甚至丟了命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200113,
					"content": "久而久之，就算是戈爾德曼威脅說要扣工資，也沒有人願意來這裡打撈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200114,
					"content": "過了一段時間，戈爾德曼就換了個方法，他說只要有人願意來這裡打撈，就能拿到三倍的錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200115,
					"content": "於是…我和幾個非常缺錢的潛水員就接下了這份工作，在這裡輪班打撈，還買了幾根魚矛、魚叉用來在水下防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200116,
					"content": "但還沒撈幾天，這些武器有的斷了、有的弄丟了…其他人只能去城裡再買一批，而我在這裡守著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200117,
					"content": "那你剛才還下水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "他們這麼長時間還不回來，再不開工，我今天又不知道要熬到多晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200120,
					"content": "我來幫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "不行！這真的不行，這水底下是真的有怪物，普通的冒險家都對付不了它們，我才不能讓您冒這個險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200122,
					"content": "我不是普通的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "您…的確看起來不太一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200125,
					"content": "好吧，既然您堅持的話，我把那些東西的位置都幫您標好，請您千萬要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊維斯"
				},
				{
					"id": 240200123,
					"content": "你覺得我看起來像普通的冒險家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "沒防身的武器你還下水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "太危險了，不然還是換個地方吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "你發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
