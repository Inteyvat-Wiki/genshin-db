			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "#怎麼樣，{F#妳}{M#你}把漂流瓶放出去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261002,
					"content": "小蒙真的能撿到嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "嗯…應該很難吧。一般來說都是撿不到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261004,
					"content": "那不就完全沒有意義了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210261005,
					"content": "哎呀，別急嘛。我都說了，某位可靠的成年人會幫他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261006,
					"content": "#{F#妳}{M#你}們知道「須彌」這個地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261007,
					"content": "我正好有幾個做生意的兄弟。他們正在籌劃做點蘑菇生意，最近正準備去那邊考察一下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261008,
					"content": "#哈哈哈，{F#妳}{M#你}們也知道。說是去須彌「考察」，其實也就是去那邊玩一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261009,
					"content": "既然那位叫小蒙的小朋友有外出旅行的念頭，那我也正好幫他聯絡一下，看我的那些兄弟們能不能多帶個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261010,
					"content": "#{F#妳}{M#你}們就別操心了，這件事我來安排吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261011,
					"content": "這封信我抄了一份，還有別的用途。至於那個漂流瓶…就隨它去吧。我估計也不會有人撿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261012,
					"content": "謝謝你願意幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "#成年人幫小孩子圓夢，這不是很正常的事嗎？這件事就交給我了，{F#妳}{M#你}們放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261015,
					"content": "對了，我還得讓我那幾位兄弟穿正式點，別嚇著人家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261013,
					"content": "你為什麼願意幫小蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
		{
