			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "這漂流瓶裡信的字跡，看著像是個小孩子寫的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260102,
					"content": "小蒙？這孩子是誰啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260103,
					"content": "咦？這個漂流瓶是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "#旅行者？聽{F#妳}{M#你}這口氣，{F#妳}{M#你}是認識寫這封信的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260105,
					"content": "算認識吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "原來是這樣。這孩子想得倒挺多的。想要變得成熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260108,
					"content": "我想，他只要能去外面旅行一次，開開自己的眼界，這些煩惱說不定就能迎刃而解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260109,
					"content": "這麼一說，小蒙自己也說過，想要去璃月港外面看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260110,
					"content": "不過，我們明明也邀請過他，為什麼他不直接答應呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260111,
					"content": "哈哈哈，也許這是那位小小男子漢的一點「倔強」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260112,
					"content": "既然是自己的煩惱，當然是要自己親手解決，不能一味依靠別人來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260113,
					"content": "那小蒙光是丟漂流瓶，也不能解決問題啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260114,
					"content": "所以，這個時候就要有一位可靠的成年人來幫幫他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260115,
					"content": "來，旅行者，我們一起給這位小朋友寫一封信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260116,
					"content": "用這封信來告訴他，外面的世界會有什麼新奇的事物在等著他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260117,
					"content": "#不過…嘿嘿，我沒去過多少地方，具體要寫什麼地方的新奇事物，還是由{F#妳}{M#你}來決定吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260118,
					"content": "關於被暴風圍繞的高塔廢墟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "說慢點，說慢點。我還沒記完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260122,
					"content": "唔，這裡…要這麼寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260123,
					"content": "好！完成了，不知不覺居然寫了這麼多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260124,
					"content": "#哈哈哈，聽著{F#妳}{M#你}說的這些，我都有點想去外面旅行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260125,
					"content": "出去旅行也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "我都這個年紀了，有太多的事要做，已經沒有隨意出去旅行的權利啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260127,
					"content": "#這封信我已經裝在漂流瓶裡了，{F#妳}{M#你}快去放進河裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260119,
					"content": "關於被雷暴圍繞的海外群島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "關於被雷神一刀斬開的島嶼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "是璃月港裡的一個孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
