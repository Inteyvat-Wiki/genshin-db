				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020301,
					"content": "這附近應該就有月蓮生長，我們接下來就分頭尋找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020302
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020302,
					"content": "#{F#妳}{M#你}們只要幫忙採集四株就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020303
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020303,
					"content": "等採到足夠的藥材之後，我們就在這附近會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300204,
			"completionStepIds": [
