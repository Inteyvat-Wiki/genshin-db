				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020801,
					"content": "停，不要再向前走了，仔細看遠處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020802
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020802,
					"content": "遠處…啊，那邊看起來灰濛濛的，植物好像都枯萎了。空氣裡還有一些灰燼一樣的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020803,
					"content": "我感覺有點害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020804,
					"content": "那就是「死域」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020805
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020805,
					"content": "旅行者，接下來我們就要進入死域的內部了。在那裡能夠找到死域的「癥結所在」，只要消滅了它們，就可以拯救這片區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020806
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020806,
					"content": "我和你一起去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020807
					]
				},
				{
					"id": 30020807,
					"content": "#謝謝。不過{F#妳}{M#你}之前沒有處理過這些事，不要勉強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020808
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020808,
					"content": "#即使{F#妳}{M#你}有元素力，在裡面也一定會感到非常不適。如果支撐不住就出來休息，畢竟這可是性命攸關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020809
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020809,
					"content": "我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300209,
			"completionStepIds": [
				300208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300208",
							"2"
						],
						"stepId": 300208,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"300209",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020901,
					"content": "啊，你們看，那邊看起來灰濛濛的，果然是「死域」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020902,
					"content": "雖然之前也已經見過了，不過我還是覺得有點害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020903,
					"content": "#旅行者，接下來我們就要進入死域的內部了。既然{F#妳}{M#你}已經有清理死域的經驗，應該知道要怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020904
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020904,
					"content": "#不過{F#妳}{M#你}要記住，一定不要勉強，如果支撐不住就出來休息，畢竟這可是性命攸關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020905
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020905,
					"content": "我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300210,
			"completionStepIds": [
				300210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300210",
							"2"
						],
						"stepId": 300210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30021001,
					"content": "成功啦，周圍又變回鬱鬱蔥蔥的樣子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021002,
					"content": "#多虧{F#妳}{M#你}的幫助，才能這麼快就讓這裡恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021003
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021003,
					"content": "提納里，雖然你話是這麼說，但總覺得你並不是很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021004,
					"content": "有這麼明顯嗎？唉，好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021005
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021005,
					"content": "因為最近死域出現的速度明顯變快了很多。即使像我們剛才那樣消除了一片死域，很快又會有新的死域產生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021006
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021006,
					"content": "如果只是我的工作因此變多，倒也沒什麼。但是死域的狀況會對雨林的方方面面產生影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021007
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021007,
					"content": "就比方說，即使我們剛才讓這片區域恢復了正常，其中的植物也無法全部重現生機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021008
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021008,
					"content": "目前雨林裡已經有多種植物的數量嚴重下降，而植物的數量變化，也會影響到與之相關的動物。雨林的生態正變得岌岌可危。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021009
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021009,
					"content": "另外…自從死域的情況開始變糟，柯萊的魔鱗病也變得嚴重起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021010
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021010,
					"content": "咦，怎麼會這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021011,
					"content": "具體的原因還不清楚。不過前幾天我收到了一個教令院熟人的來信，他告訴我的確有許多病人都有相似的狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021012
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021012,
					"content": "就沒有根除死域的辦法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021013
					]
				},
				{
					"id": 30021013,
					"content": "據我所知沒有。死域已經在須彌存在了上千年了，而且它的誕生來自這個世界更深層的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021014
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021014,
					"content": "#{F#妳}{M#你}聽說過「世界樹」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021015,
						30021016
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021015,
					"content": "沒聽說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021017
					]
				},
				{
					"id": 30021017,
					"content": "#「世界樹」就位於我們腳下的大地深處，雖然它並非生物學意義的樹，但{F#妳}{M#你}可以大致把它看做一棵倒著生長的大樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021018
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021018,
					"content": "#{F#妳}{M#你}應該知道「地脈」吧，它們就像是「世界樹」的根系，在地底縱橫交錯，從深邃的巨大空洞一直延伸至地面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021019
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021019,
					"content": "（「縱橫交錯」、「巨大空洞」…總覺得和失去意識那時看到的東西有點像。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021020
					]
				},
				{
					"id": 30021020,
					"content": "「地脈」會不斷吸收這個世界的記憶，「世界樹」中也匯集了世間從古到今的全部情報與智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021021
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021021,
					"content": "草神之所以也被稱為「智慧之神」，正是因為她的意識連接著世界樹。草神的力量，其實也可以說是世界樹力量的一種體現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021022
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021022,
					"content": "死域的出現，其實是世界樹的疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021023
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021023,
					"content": "世界樹病了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021024
					]
				},
				{
					"id": 30021024,
					"content": "對。很久以前，我的祖先從大慈樹王的眷屬那得知了這件事，但那些神秘的生靈也不知道要怎樣治癒世界樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021025
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021025,
					"content": "我們巡林員，恐怕還要長久地和死域戰鬥下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021026
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021026,
					"content": "好了，這個話題就先說到這裡吧。既然這裡的事情結束了，我們現在就回化城郭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021016,
					"content": "總覺得好像在哪聽過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021017
					]
				}
			]
		},
		{
			"id": 300211,
			"completionStepIds": [
				300211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300211",
							"2"
						],
						"stepId": 300211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30021101,
					"content": "提納里先生，你們回來了，辛苦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021102
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30021102,
					"content": "你們之前發現的那片死域已經處理乾淨了，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021103
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021103,
					"content": "嗯？那個是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021104
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021104,
					"content": "糟了，是海芭夏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021105
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021105,
					"content": "提納里你怎麼了，突然就跑了過來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021106,
					"content": "#這隻暝彩鳥是專門為海芭夏傳遞緊急消息的——{F#妳}{M#你}還記得「海芭夏」這個名字嗎？就是{F#妳}{M#你}們之前遇到的那個學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021107
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021107,
					"content": "原來是她，她出什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021108,
					"content": "我看看信上寫了什麼，呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021109
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021109,
					"content": "你的表情怎麼突然變得這麼古怪？讓我也看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021110,
					"content": "唔，上面好像只畫了三條歪歪扭扭的線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021111,
					"content": "#我來解釋一下，事情是這樣的：那天我們從海芭夏那帶{F#妳}{M#你}們來化城郭後，她就重新開始了冥想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021112
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021112,
					"content": "等她再次睜開眼睛的時候，應該就是剛才了。她已經將近三天沒吃東西，但又忘了提前備好乾糧，所以讓我們趕快過去救她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021113
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021113,
					"content": "什麼，她竟然一直在那裡坐了這麼久——欸不對，你是怎麼從幾條線裡看出這麼多內容的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021114,
					"content": "當然是因為這樣的事情之前也發生過，上次她畫了五條線！算了…我不太想回憶當時的情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021115
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021115,
					"content": "海芭夏現在的情況應該還不至於太糟，但還是早點去看看她為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021116
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021116,
					"content": "#我這裡有些應急的食物，{F#妳}{M#你}們能幫我帶過去給她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021117
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021117,
					"content": "#咦，我們嗎？可是海芭夏那裡有靈酚香，{NICKNAME}會不會又出什麼問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021118,
					"content": "#{NICKNAME}，現在{F#妳}{M#你}再來聞聞這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021119
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021119,
					"content": "感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021120,
						30021121
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021120,
					"content": "有股很清新的香氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021122
					]
				},
				{
					"id": 30021122,
					"content": "#咦，{F#妳}{M#你}已經不會再難受了嗎？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021123,
					"content": "#提納里，你是怎麼知道{M#他}{F#她}已經痊癒了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021124,
					"content": "#在{M#他}{F#她}幫忙清理死域的時候，我看到{M#他}{F#她}已經能夠熟練運用草元素的能力，當時就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021125
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021125,
					"content": "#{NICKNAME}，在我和{F#妳}{M#你}們說起世界樹根系的時候，{F#妳}{M#你}當時是不是在想，那些東西聽起來和{F#妳}{M#你}的「幻覺」很相似？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021126
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021126,
					"content": "我看到的不是「幻覺」，對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021127
					]
				},
				{
					"id": 30021127,
					"content": "對，那些並不是幻覺。不過我不打算對之前的謊言道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021128
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021128,
					"content": "#因為{F#妳}{M#你}能夠看到的東西，對於須彌乃至世界來說，都非常重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021129
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021129,
					"content": "#我的祖先曾受過大慈樹王大人極大的恩惠，我們立誓與她一同守護這個國度。所以，我有責任確認{F#妳}{M#你}是否值得須彌信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021130
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021130,
					"content": "#但現在{F#妳}{M#你}已經用行動獲得了我的尊敬，因此我認為不必再對{F#妳}{M#你}保守秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021131
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021131,
					"content": "我之前看到的究竟是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021132
					]
				},
				{
					"id": 30021132,
					"content": "#其實，那時候{F#妳}{M#你}的意識連接上了世界樹，看到的是世界樹中的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021133
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021133,
					"content": "#不過更詳細的東西，去問問海芭夏會更好。因為無論是冥想還是靈酚香，都是為了讓她能夠與{F#妳}{M#你}做到同樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021134
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021134,
					"content": "可是，她真的會回答我們嗎？我們第一次見到她的時候，她連一句話都不願意和我們說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30021135,
					"content": "那是因為她現在正處於特殊的修行狀態，要盡量避免和他人交談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021136
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021136,
					"content": "#{F#妳}{M#你}們在這裡稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021137
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021137,
					"content": "提納里離開了片刻…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30021138
					]
				},
				{
					"id": 30021138,
					"content": "#拿著這些。這是給海芭夏的便當，應該能救個急。這裡還有一些食材，{F#妳}{M#你}們也一併帶去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021139
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021139,
					"content": "#這個信封裡是我寫給海芭夏的信。只要給她看了這個，她應該就會解答{F#妳}{M#你}們的所有疑問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021140
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021140,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021141
					]
				},
				{
					"id": 30021141,
					"content": "#不用。我才應該感謝{F#妳}{M#你}們這幾天的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				},
				{
					"id": 30021121,
					"content": "沒什麼不舒服的感覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021122
					]
				}
			]
		},
