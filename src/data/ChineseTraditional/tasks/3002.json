				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020401,
					"content": "提納里，我們已經完成任務啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020402,
					"content": "#讓我看看…嗯，品質都很好，{F#妳}{M#你}們選得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020403
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020403,
					"content": "#{F#妳}{M#你}們野外探索經驗豐富，的確幫忙節省了不少時間。看來我們接下來還能再去儲備點其他的藥材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020404
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020404,
					"content": "喂——提納里先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020405
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020405,
					"content": "提納里，那邊有人在叫你，看服裝似乎是巡林員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020406,
					"content": "確實是熟人，是阿米爾他們。但他們不是才剛出發沒多久嗎？怎麼這時候就回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020407
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020407,
					"content": "走，我們過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300205,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300207",
							"2"
