			"dialogs": [
				{
					"id": 30025101,
					"content": "#海芭夏那邊，就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30025102
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30025102,
					"content": "我先去幫柯萊熬藥，我們採回來的月蓮，趁新鮮入藥才能發揮最大功效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30025103
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30025103,
					"content": "放心吧，柯萊吃過藥之後，很快就會好起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
