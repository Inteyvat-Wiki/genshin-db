	"talks": [
		{
			"id": 300201,
			"completionStepIds": [
				300201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300201",
							"2"
						],
						"stepId": 300201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020101,
					"content": "#是{F#妳}{M#你}們啊，我正準備去找{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020102
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020102,
					"content": "咦，提納里，你怎麼在這裡？柯萊她人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020103,
					"content": "我過來看看柯萊的情況。簡單地說，她病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020104
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020104,
					"content": "她病了？怎麼會…等等，難道說是因為昨天我的錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020105,
					"content": "不用擔心，妳這小傢伙還不至於造成那麼嚴重的後果，柯萊的病是舊疾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020106
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020106,
					"content": "#但實事求是地說，{F#妳}{M#你}們來後這幾天，柯萊的確有點興奮過頭，忽視了自己的身體狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020107
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020107,
					"content": "唉，不過這也沒辦法，畢竟她已經很久沒見到朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020108
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020108,
					"content": "提納里，柯萊她究竟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020109,
					"content": "我們換個地方說話吧。她剛吃了藥睡下，這裡需要安靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300202,
			"completionStepIds": [
				300203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300203",
							"2"
						],
						"stepId": 300203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020201,
					"content": "好了，我們就在這裡繼續之前的話題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020202
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020202,
					"content": "#其實直到剛才柯萊和我說起，我才意識到原來{F#妳}{M#你}就是那位蒙德的榮譽騎士。{F#妳}{M#你}在璃月和稻妻的其他義舉，我也有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020203
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020203,
					"content": "#但我要聲明一下，我把柯萊的真實情況告訴{F#妳}{M#你}們，跟{F#妳}{M#你}們的身分和過往經歷無關，而只是基於一個理由——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020204
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020204,
					"content": "是柯萊拜託我這麼做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020205
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020205,
					"content": "#說實話，我個人並不建議柯萊把自己的過往經歷也告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020206
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020206,
					"content": "#但柯萊卻對我說，{F#妳}{M#你}們把她當做朋友，真誠地對待她，所以她也應該這樣對待{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020207
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020207,
					"content": "提納里，柯萊她到底得了什麼病？你剛剛說是「舊疾」，她難道已經病了很久了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020208,
					"content": "對，其實柯萊從小就患有一種叫做「魔鱗病」的疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020209
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020209,
					"content": "「魔鱗病」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020210,
					"content": "這是一種須彌獨有的病症，因為患者身上會出現灰黑色的鱗片狀組織而得名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020211
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020211,
					"content": "一開始患者只是感覺皮膚發生變化的區域有些麻木，可隨著病情發展，會出現力量減退、手指和腳趾偶爾喪失知覺的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020212
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020212,
					"content": "最終，患者將會變得無法控制自己的身體，徹底失去行動能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020213
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020213,
					"content": "聽起來有點可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020214,
					"content": "「無法控制自己的身體」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020215
					]
				},
				{
					"id": 30020215,
					"content": "等等，難道說之前柯萊有點笨手笨腳的感覺，其實都是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020216,
					"content": "對，是魔鱗病的影響。所以我讓她盡量不要拿東西，避免傷到自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020217
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020217,
					"content": "這種病可以治癒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020218
					]
				},
				{
					"id": 30020218,
					"content": "如果治療方法得當，患者的病情發展能夠得到有效控制。遺憾的是，魔鱗病至今尚無法治癒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020219
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020219,
					"content": "但曾經卻有人騙柯萊的母親說，有根除魔鱗病的辦法，讓她把女兒交給了一個叫做「愚人眾」的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020220
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020220,
					"content": "什麼，愚人眾？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020221,
					"content": "#看來{F#妳}{M#你}們知道愚人眾，這樣正好，省去了解釋的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020222
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020222,
					"content": "總之，把柯萊拜託給我照顧的人說，柯萊被送到了名為「博士」的執行官那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020223
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020223,
					"content": "我不知道「博士」是怎麼做到的，她的魔鱗病的確在那些年被完全遏制了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020224
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020224,
					"content": "但在愚人眾那裡的日子，對她來說絕對不是什麼愉快的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020225
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020225,
					"content": "雖說她很堅強，也一直努力表現得開朗，可直到現在，她偶爾還是會對他人的觸碰感到畏懼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020226
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020226,
					"content": "原來柯萊之前經歷過這麼多痛苦的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020227,
					"content": "#對了派蒙，柯萊讓我告訴妳，她很抱歉昨天嚇到了妳。此外她還說：對不起，一開始對{F#妳}{M#你}們隱瞞了病情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020228
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020228,
					"content": "這不是柯萊的錯，她不需要道歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020229,
					"content": "#嗯，這些話我希望下次{F#妳}{M#你}們見到她時，能夠親口告訴她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020230
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020230,
					"content": "#她曾經一度認為自己沒有獲得友誼的資格，請{F#妳}{M#你}們不要讓我的弟子再次經歷類似的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020231
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020231,
					"content": "提納里，你放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020232,
					"content": "柯萊她現在病情如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020233
					]
				},
				{
					"id": 30020233,
					"content": "還好，不算太嚴重。這次倒下主要是因為這兩天體力有點透支。現在已經吃了藥，再休息一下就能好轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020234
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020234,
					"content": "不過她剛到化城郭的時候，情況的確要比現在好不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020235
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020235,
					"content": "那時因為她對巡林員的工作感興趣，也很想學習知識，我就讓她加入了我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020236
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020236,
					"content": "最近她的精力下降了不少，雖說應該保持適量的運動，但遠途的巡邏已經不太適合她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020237
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020237,
					"content": "#好了，柯萊的情況我已經都告訴{F#妳}{M#你}們了。現在我要去幫她採些藥回來，就不多閒聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020238
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020238,
					"content": "我們也能一起去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020239
					]
				},
				{
					"id": 30020239,
					"content": "對，提納里，我們也想為柯萊做點什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020240,
					"content": "#…也行。不過因為雨林裡很危險，旅行者也正在恢復中，所以希望{F#妳}{M#你}們能在途中聽從我的指示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020241
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020241,
					"content": "嗯，我們明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020242,
					"content": "走吧。我們要去採集的是一種叫做「月蓮」的植物，它對魔鱗病患者恢復精力很有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 300203,
			"completionStepIds": [
				300204
			],
