			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020501,
					"content": "提納里先生，沒想到竟然在這裡遇到你了，我們正準備回化城郭找你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020502
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020502,
					"content": "出什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020503
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020503,
					"content": "我們剛剛發現「死域」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020504
					],
					"speakerTitle": "娜絲琳"
				},
				{
					"id": 30020504,
					"content": "「死域」？今天你們走的這條路線，應該是一週前剛徹底清理過才對，竟然這麼快就又出現了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020505
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020505,
					"content": "具體位置在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020506
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020506,
					"content": "就在前面的河谷深處。因為這次出現的地方幾乎把河谷狹窄的區域都堵住了，所以我們就趕快回來找你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020507
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020507,
					"content": "半徑呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020508
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020508,
					"content": "不好意思，之前看得不是太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020509
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020509,
					"content": "今天我們隊裡的人都沒有神之眼，而且我們感覺它可能還在擴張期，所以不敢靠太近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020510
					],
					"speakerTitle": "娜絲琳"
				},
				{
					"id": 30020510,
					"content": "#嗯，你們的判斷是正確的。我馬上就去處理，你們就先帶{M#他們}{F#她們}兩個一起回化城郭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020511
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020511,
					"content": "等等呀提納里，為什麼突然要讓我們回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020512,
					"content": "#哦，{F#妳}{M#你}們才剛來到須彌，還不太瞭解這裡的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020513
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020513,
					"content": "在須彌的雨林中，有些區域會出現一種獨特的異變現象，那些地方叫做「死域」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020514
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020514,
					"content": "「死域」不僅會使植物枯萎，也會奪走動物和人類的生命。如果沒有神之眼的話，絕對不能貿然靠近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020515
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020515,
					"content": "#他說得沒錯。我之前告訴{F#妳}{M#你}們雨林中存在十分危險的區域，並不是危言聳聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020516
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020516,
					"content": "只有擁有神之眼——也就是能駕馭元素力的人，才能在一定時間內抵禦死域的侵蝕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020517
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30020517,
					"content": "是啊，所以對於我們這些普通的巡林員來說，發現死域後，會先記錄下位置，然後交給提納里先生這樣的專業人士來處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020518
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020518,
					"content": "畢竟只有他們才能深入到死域內部，找到消除死域的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020519,
						30020520
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020519,
					"content": "我或許也能幫上忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				},
				{
					"id": 30020521,
					"content": "#可是{F#妳}{M#你}看起來好像並沒有神之眼的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020522
					],
					"speakerTitle": "阿米爾"
				},
				{
					"id": 30020522,
					"content": "#你們放心吧，{M#他}{F#她}雖然沒有神之眼，但卻是使用元素力的老手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30020520,
					"content": "我也能使用元素力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				}
			]
		},
