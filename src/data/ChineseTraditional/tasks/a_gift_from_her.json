			"dialogs": [
				{
					"id": 761230101,
					"content": "好香的味道，又遇到哥倫比婭的用餐時間了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230102,
					"content": "月靈們…正在一個個排隊，盛湯的是哥倫比婭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230103,
					"content": "稍等一下哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230104,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761230105,
					"content": "哇，這個好喝欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230106,
					"content": "清香爽口的甜果子湯，是在別的地方沒喝過的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230107,
					"content": "再來一碗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230108,
					"content": "兩碗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230109,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761230110,
					"content": "哥倫比婭最近在學習烹飪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "嗯，我向伊涅芙要了一些基礎食譜，已經嘗試了幾次，月靈和小動物們的反應都不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230112,
					"content": "有遇到什麼困難嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "唔，袖子太寬了，一不小心就會沾到鍋邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230114,
					"content": "（原來不是烹飪本身的困難啊。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "不過，在製作點心類食物的時候，會有些應付不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230116,
					"content": "它們對於溫度和比例的要求很嚴格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230117,
					"content": "（看來她以前很少自己做東西吃。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "（而且點心類的料理如果只靠自己摸索的話，的確不容易…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "要我來幫妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "好啊，先從蛋捲開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230121,
					"content": "一段時間過後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "嚐嚐看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230123,
					"content": "（咬一小口。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230126,
					"content": "（第一口好酸，感覺臉都快皺在一起了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "（但稍微吞下去一點，甜味就重新出現了…可能習慣之後會好一點…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230129,
					"content": "合格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "我錯過了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230132,
					"content": "派蒙，快來吃吃看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230134,
					"content": "#嗚哇哇哇，好酸哦，{F#妳}{M#你}們欺負人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230135,
					"content": "哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230136,
					"content": "回甘的部分還是不錯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "重點是一開始啊！根本沒人提醒我要少咬一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230138,
					"content": "#{F#妳}{M#你}不說的話，我還以為{F#妳}{M#你}想搞惡作劇…看別人吃的反應什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230139,
					"content": "好吧，我再試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230140,
					"content": "又一段時間過後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "給，試試看這次的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230142,
					"content": "（唔…！這次的好多了！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "這次的真好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "真的嗎？我也要我也要！唔…！這個好這個好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230146,
					"content": "能送得出手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230147,
					"content": "當然可以！哦，哥倫比婭妳學烹飪、做蛋捲，是想要為誰準備禮物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230148,
					"content": "嗯…想送給朋友們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230149,
					"content": "很好的主意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "#還記得{F#妳}{M#你}們第一次一起來這邊的時候嗎？{F#妳}{M#你}們為我準備了一些飯菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230151,
					"content": "與我流失的力量相比，食物沒辦法提供多少補充，但在吃完之後我的內心卻舒緩了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230152,
					"content": "雖然那時沒有細想其中的緣由，但現在我已經明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230153,
					"content": "親手製作、用心付出…賦予食物靈魂的是人們所花費的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230154,
					"content": "我享用的不是飯菜本身，而是背後那雙手中的溫暖與善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230155,
					"content": "它越是不求回報，便越是珍貴，唯有同等的溫暖與善意才能與它相輝映。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230156,
					"content": "哎呀，說得我都不好意思了，我們那時候還是滿想討好妳的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230157,
					"content": "不過現在不一樣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "嗯，但在理解這些之後，我也想多付出一點…感覺很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230160,
					"content": "可以和我一起出門拜訪朋友們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230161,
					"content": "除了蛋捲，我還準備了一些別的小禮物。哦，不過，是悄悄地送喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230162,
					"content": "為什麼是「悄悄地」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230163,
					"content": "以前都是你們給我「驚喜」，我也想看看朋友們收到「驚喜」時的反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230164,
					"content": "呼，跑了好多地方，終於送完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230165,
					"content": "大家的反應都有些意想不到呢，雖然有的人好像根本沒有意識到這是哥倫比婭的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230166,
					"content": "愛諾只顧著吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "沒關係，這也在我的預期之中。只要朋友們收到禮物時開心就好，這才是最重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230168,
					"content": "這麼說的話，菈烏瑪看起來倒是發現了她桌上的蛋捲和花環是哥倫比婭送的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230169,
					"content": "花環捨不得戴我倒是能理解，但那個蛋捲…她足足看了十分鐘都沒捨得吃呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230170,
					"content": "都怕她要供起來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "但雅珂達好像被嚇了一跳…是不是不該悄悄把東西放到她身後呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230172,
					"content": "真的嚇了一「跳」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "可能她本身就比較有警覺心吧？但在阿舍魯過來抓妳送的貓抓板後，她好像就冷靜下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230174,
					"content": "#其他最近不在挪德卡萊的朋友，就拜託{F#妳}{M#你}們送去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230175,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "長翎䴉"
				},
				{
					"id": 761230176,
					"content": "哥倫比婭還滿會準備禮物的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "給。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230178,
					"content": "噢！終於輪到我們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230179,
					"content": "欸？是糖果？我還以為會跟大家一樣是蛋捲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761230180,
					"content": "那個已經在試吃的時候吃過了吧？來點不一樣的不是更好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230181,
					"content": "嗯…很好吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230184,
					"content": "#還有一份，給{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230185,
					"content": "這是…風之翼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "我聽說天空屬於飛鳥，陸地屬於走獸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230187,
					"content": "而天與地之間的廣闊間隔，是留給身披風之翼的冒險家穿梭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230188,
					"content": "#希望在有它相伴的日子裡，{F#妳}{M#你}的前路始終會像被月光照拂那般明朗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230189,
					"content": "我很喜歡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "#謝謝{F#妳}{M#你}的陪伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230182,
					"content": "比祈月之夜的糖果還好吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "有什麼想吃的就儘管說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "妳學東西真快！",
