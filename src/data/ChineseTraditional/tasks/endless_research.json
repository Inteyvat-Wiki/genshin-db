			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "嗚…這根本就沒辦法寫論文嘛，怎麼辦才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100102,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "#我…咦？是{F#妳}{M#你}啊！{F#妳}{M#你}還記得我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100104,
					"content": "#我就是那個，在靈矩關被盜寶團關在籠子裡…的人…哈哈…總之，謝謝{F#妳}{M#你}救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100105,
					"content": "你怎麼在這？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "#哎呀，上次被{F#妳}{M#你}救了之後，我就去望舒客棧找索拉雅小姐了，我運氣不錯，剛好找到她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100107,
					"content": "索拉雅小姐真是個好人啊，不僅請我吃了東西，還幫我整理了我蒐集到的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100108,
					"content": "不過…整理到最後她告訴我，我選的這個課題，在教令院已經有好多人寫過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100109,
					"content": "除非我寫得非常出色，不然肯定無法順利過關…她建議我換個切入角度來寫，比如元素力什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100110,
					"content": "但我又沒有「神之眼」，沒辦法使用元素力，完全不知道怎麼切入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100111,
					"content": "所以我只能先來城裡碰碰運氣，看能不能再找到點資料什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100112,
					"content": "#等等…{F#妳}{M#你}在救我的時候，戰鬥方式好像很特別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100113,
					"content": "#{F#妳}{M#你}擁有「神之眼」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100114,
					"content": "我沒有「神之眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "#咦？{F#妳}{M#你}沒有「神之眼」都可以用那種方式戰鬥嗎？這到底是什麼原理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100116,
					"content": "#不，不，先不管是什麼原理，肯定是非常複雜的原理…總之，我有件事要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100117,
					"content": "#{F#妳}{M#你}可以再向我展示一下{F#妳}{M#你}的戰鬥方式嗎？說不定，我能找到一些有用的細節，完善我的那篇論文…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100118,
					"content": "拜託、拜託，我再不完成這篇論文，回去教令院我一定會完蛋的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100119,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "#謝謝{F#妳}{M#你}！那我們就去野外吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100121,
					"content": "#我之前注意到了一個丘丘人的聚落，{F#妳}{M#你}就以它們為目標，向我展示一下{F#妳}{M#你}的戰鬥方式吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100122,
					"content": "教令院…有這麼可怕嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "非常可怕哦，非常的可怕…如果作夢夢到的話，我一定會哭著醒過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100124,
					"content": "我寧願被盜寶團關在籠子裡，也不想再去做論文答辯和改論文了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100125,
					"content": "好了好了，不要再說教令院了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100126,
					"content": "#我之前注意到了一個丘丘人的聚落，{F#妳}{M#你}就以它們為目標，向我展示一下{F#妳}{M#你}的戰鬥方式吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "#哇…{F#妳}{M#你}的戰鬥方式還真特別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100202,
					"content": "對了，我聽說「神之眼」的持有者還能感知道元素的痕跡，說是叫「元素視野」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100203,
					"content": "#雖然{F#妳}{M#你}沒有「神之眼」，但上次我看見{F#妳}{M#你}使用了元素的力量…{F#妳}{M#你}應該也有這種能力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100204,
					"content": "#嘿嘿，我剛才發現這周圍有一些史萊姆，拜託{F#妳}{M#你}，再向我展示一下「元素視野」…用「元素視野」來找到它們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "#哈哈哈…在我這種沒有「神之眼」的人看來，{F#妳}{M#你}開啟「元素視野」的時候和平時也沒什麼不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100302,
					"content": "唔，也許只有擁有「神之眼」的人才能看出不同來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100303,
					"content": "#不過，還是謝謝{F#妳}{M#你}展示了這麼多東西給我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100304,
					"content": "唉，我真想要個「神之眼」啊…最好是「雷」屬性的那種，又帥氣又能防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100305,
					"content": "不對，雷屬性的「神之眼」，應該最不可能了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100306,
					"content": "只要努力的話就會有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "不可能啦，雷屬性的「神之眼」就算努力也拿不到的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100308,
					"content": "#咦？{F#妳}{M#你}、{F#妳}{M#你}不知道嗎？從大概一年前開始，好像就再沒有人獲授雷屬性的「神之眼」了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100309,
					"content": "據說教令院還專門為這個事研究了很久，最後的結論是…不再向人授予「神之眼」這件事，是那位「雷之神」的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100310,
					"content": "而且我聽人說，那位統御著稻妻的「雷之神」，還頒佈了一條「眼狩令」。說是要把稻妻裡大部分「神之眼」持有者的「神之眼」都收上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100311,
					"content": "要是「神之眼」持有者拒不上交的話，好像還會被重重罰則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100312,
					"content": "雖然我曾經想去稻妻以這個為主題寫一篇論文，但、但是…稻妻聽起來好危險，我還是有點不敢去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100313,
					"content": "你沒有「神之眼」，沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "#別這麼說我啦！而且{F#妳}{M#你}想，有「神之眼」的人都這麼慘，沒「神之眼」的人，那不就會更慘了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100315,
					"content": "我還是安心在璃月把論文搞定吧，然後趕緊回須彌去教令院交差吧，再拖久一點，我又不知道要聽多少嘮叨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 718100316,
