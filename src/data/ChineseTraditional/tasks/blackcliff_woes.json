					],
					"speakerTitle": "阿寬"
				},
				{
					"id": 708230509,
					"content": "但這麼拖下去，廠裡的單子說不定有些要延期了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230510
					],
					"speakerTitle": "阿寬"
				},
				{
