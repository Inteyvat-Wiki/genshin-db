			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "哦？您問我泰克胡的眼睛？哈哈，這是男人一生必須修煉的三件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540604,
					"content": "第一，一具飽經風霜的身體。至少要有一道傷疤，否則就不能暗示這個男人曾經歷過的複雜人生，這會使他失去厚度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540605,
					"content": "第二，用服裝或者飾品遮住傷疤。保持低調但不要全部遮住，否則旁人就無法意識到這個男人的特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540606,
					"content": "第三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540607,
					"content": "停一下，我根本沒有問你的眼睛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "是吧？沒錯！這就是我要說的第三點：如果旁人還是沒有注意到，一定要想辦法主動提起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
