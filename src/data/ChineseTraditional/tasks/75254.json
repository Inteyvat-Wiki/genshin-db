			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "哦，朋友！歡迎來到夢中的帕依提提——提提島！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540102,
					"content": "往前走就是「醅蜜」酒吧和「嚐露」酒吧，我是酒吧的迎賓泰克胡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#親愛的朋友，既然{F#妳}{M#你}喝了我的歡迎果汁，那讓我給{F#妳}{M#你}一個忠告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540202,
					"content": "#要是{F#妳}{M#你}只是個過來享受假期的普通人，那就別靠近提提島的最北邊，那裡沒有能讓{F#妳}{M#你}放鬆的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泰克胡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "好吧，那你的眼睛是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "哼哼，是一個光頭幹的，他在我身上留下了這印跡…他現在也在這個島上，哼，我會好好「感謝」他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540311,
					"content": "我知道聽了我的故事，您一定也想為我復仇吧？但不必了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540312,
					"content": "親愛的朋友，在這個如此美麗的夏日，沒有人應該感到悲傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540313,
					"content": "請享用我為每位客人準備的歡迎果汁，盡情揮霍這段休閒的時光吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540314,
					"content": "果汁就在那邊的櫥櫃上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
