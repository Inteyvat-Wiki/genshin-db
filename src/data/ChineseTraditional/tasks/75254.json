				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "我們好像在哪見過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "朋友，這是命運給不凡之人打上的標記，讓您與我初次相遇，也如同久別重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752540502,
					"content": "看到我這惡狼般的眼罩，想必就已經意識到了我的不凡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
