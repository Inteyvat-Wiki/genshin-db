			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "居然是住在<color=#00E1FFFF>遺蹟</color>裡的嗎？蒙德人偶爾也有奇怪的癖好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010702,
					"content": "請不要這麼隨意揣測蒙德人的居住習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010703,
					"content": "我倒是覺得更像那些不討人喜歡的「搗亂分子」的作風呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010704,
					"content": "是丘丘人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "偷盜書本的事可不太適合丘丘人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010706,
					"content": "畢竟它們大概只會把書本點著來取暖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010712,
					"content": "還是<color=#00E1FFFF>深淵教團</color>作案的可能性大一些，畢竟本來就是些神出鬼沒的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010713,
					"content": "況且…這遺蹟入口的元素封印，也像是深淵法師留下的魔力痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010714,
					"content": "是封印嗎，那要怎麼解開呢…該不會又要花很多功夫吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010715,
					"content": "如果這點程度的元素力，就想把我拒之門外，那還真是小看人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010716,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010717,
					"content": "我們進去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010718,
					"content": "嗚…哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010719,
					"content": "這就是工作中的麗莎小姐嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010707,
					"content": "是深淵教團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "#不愧是{F#妳}{M#你}，跟我心有靈犀哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010709,
					"content": "是冒險家協會？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "嗯…從總是在地下遺蹟鑽來鑽去的角度上確實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010711,
					"content": "但他們不會隨便拿別人的東西…唔，更正一下，至少不會拿活著的人的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "麗莎"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "是<color=#00E1FFFF>《白之公主與六侏儒》</color>！我記得這個名字，應該就是它了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010802,
					"content": "是的哦，好在書本沒有受到什麼損壞呢，不然的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010803,
					"content": "不然的話？難道麗莎還有什麼更厲害的懲罰方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010804,
					"content": "呵呵，那大概就要運用一些我在藥劑學上的成果了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010805,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010806,
					"content": "不過話說回來，這本書根本不是「禁書區」的書，所以才會放心借給一般市民啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010807,
					"content": "除了我做的標記之外，也沒有任何異常的元素波動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010808,
					"content": "是喔。感覺完完全全只是一本普通的童話書而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010809,
					"content": "但為什麼深淵教團…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "（很神秘，令人好奇…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "從圖書管理員的角度來看，麻煩的工作已經做完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010812,
					"content": "#既然對這本書這麼感興趣，不如轉借給{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010813,
					"content": "那…那還書期限是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "我可不想受到「懲罰」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "#期限是無限期哦。我會把{F#妳}{M#你}登記為「保管人」而不是「出借人」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010816,
					"content": "這是對值得信賴的好市民的特殊福利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010817,
					"content": "說是福利…怎麼感覺只是把麻煩甩給了別人的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010818,
					"content": "哦~？對我的工作有什麼不滿嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 101010819,
					"content": "沒、沒有！",
					"roleType": "TALK_ROLE_PLAYER",
