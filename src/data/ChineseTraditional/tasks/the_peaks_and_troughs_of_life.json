	],
	"talks": [
		{
			"id": 7467101,
			"completionStepIds": [
				7467101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7467101",
							"2"
						],
						"stepId": 7467101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪卡德爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746710101,
					"content": "見鬼！這核心的輸出頻率還是太不穩定了，這樣下去，我的計畫可就要徹底完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710102
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710103
					]
				},
				{
					"id": 746710103,
					"content": "欸！您…您嚇我一跳，要是我手裡的按鈕按下去，說不定就要出大亂子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710104
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710104,
					"content": "看您的樣子…也不像是冒險家協會派來的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710105,
						746710107
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710105,
					"content": "你在協會刊登委託了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710106
					]
				},
				{
					"id": 746710106,
					"content": "不是，我可沒有錢發委託…而且我最不擅長和冒險家交流了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710109,
					"content": "我只不過是正在和冒險家協會進行一場「合作」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710110
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710110,
					"content": "哎喲，我都忘了介紹我自己，我叫瑪卡德爾，是一名楓丹科學院的研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710111
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710111,
					"content": "我參與的計畫題目是「小型便攜式芒荒能量儲存裝置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710112
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710112,
					"content": "在所有組員的共同努力下，研究順利地推進著，也做出了第一臺原型機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710113
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710113,
					"content": "然後…就像所有人都知道的那樣，楓丹科學院發生了一場巨大的爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710114
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710114,
					"content": "在這場爆炸中，我研究計畫團隊的組長和大部分組員都不幸遇難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710115
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710115,
					"content": "除了我之外，幾乎沒有人能繼續工作並且推進研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710116
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710116,
					"content": "但是…以目前院內的這種情況，我所在的這個項目想要繼續存在的話，就必須盡快展示這個計畫的價值所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710117
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710117,
					"content": "所以，在徵詢了各方意見後，我和冒險家協會達成了合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710118
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710118,
					"content": "我想以「小型便攜式芒荒能量儲存裝置」原型機為核心，製作一臺「超高壓衝擊器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710119
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710119,
					"content": "我想用這臺「超高壓衝擊器」的運作狀態證明「小型便攜式芒荒能量儲存裝置」的可靠性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710120
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710120,
					"content": "我確實也順利地把這臺機器給製造了出來，並且啟動了它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710121,
						746710123
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710121,
					"content": "聽起來還滿順利的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710122
					]
				},
				{
					"id": 746710122,
					"content": "哈哈哈，是的…一切都非常順利，直到這臺「超高壓衝擊器」開始運作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710125,
					"content": "唉…每次說這件事的時候我都會頭痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710126
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710126,
					"content": "不知道是那臺原型機的設計有問題，還是我製作的「超高壓衝擊器」的能量傳輸方式有缺陷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710127
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710127,
					"content": "從「小型便攜式芒荒能量儲存裝置」輸入「超高壓衝擊器」的能量，總是忽大忽小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710128
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710128,
					"content": "這讓「超高壓衝擊器」的出力強度…也總是忽大忽小！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710129
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710129,
					"content": "出力大的時候，這臺機器能輕鬆擊碎石頭。但在出力小的時候，它連在泥巴上鑽個洞都很吃力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710130
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710130,
					"content": "以院內現在的情況，我想要回去重新改造「小型便攜式芒荒能量儲存裝置」基本上是不可能了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710131
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710131,
					"content": "我只能在原型機上額外安裝一個監測裝置，隨時監控原型機所輸出的能量強度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710132
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710132,
					"content": "只要在輸出能量強度高的時候啟動「超高壓衝擊器」，就一定能讓它以最高強度出力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710133,
						746710135
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710133,
					"content": "太複雜了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710134
					]
				},
				{
					"id": 746710134,
					"content": "但這已經是我能想出成本最低的最佳解決方案了，這下該怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710137,
					"content": "唉，難道冒險家協會的人也這麼想，所以他們才遲遲沒有派人過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710138
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710138,
					"content": "該怎麼辦，要是沒有測試資料，我要怎麼回院裡做報告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710139
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710139,
					"content": "旅行者…如果您願意的話，能幫幫我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710140
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710140,
					"content": "我向您保證，這臺裝置絕對可靠！我甚至還為它做了不少額外的配件，能夠增強它的各種功能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710141,
						746710144
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710141,
					"content": "我要是把握不住時機怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710142
					]
				},
				{
					"id": 746710142,
					"content": "沒關係，最多也就是…也就是出力的強度偏低，這臺機器也不會爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710143
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710143,
					"content": "您只需要等著下一個能量波峰到來，然後啟動這臺機器，讓它以最高強度出力就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710148,
					"content": "放心吧，旅行者，這臺機器絕對安全，而且…測試完成後，我還會付您錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710149
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710149,
					"content": "那就交給您了！我的未來、這臺機器的未來…還有我所在計畫的未來，都託付給您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710144,
					"content": "它不會突然在我身邊爆炸吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710145
					]
				},
				{
					"id": 746710145,
					"content": "絕無可能，我為它配置了大量的安全與監測裝置，最多也就是出力強度偏低，爆炸是不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710146
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710146,
					"content": "就算是您沒有把握住能量波峰，那也沒有任何關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710147
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710147,
					"content": "只需要等著下一個能量波峰到來，然後啟動這臺機器，讓它以最高強度出力就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710135,
					"content": "這根本不能用嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710136
					]
				},
				{
					"id": 746710136,
					"content": "別這樣啊！這是我能想到的最佳方案了，我保證這東西真的能用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710123,
					"content": "聽起來沒什麼問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710124
					]
				},
				{
					"id": 746710124,
					"content": "是的，除了這臺機器本身之外，一切都幾乎沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "瑪卡德爾"
				},
				{
					"id": 746710107,
					"content": "你雇冒險家保護你了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710108
					]
				},
				{
					"id": 746710108,
					"content": "我可雇不起那些冒險家，他們的開價實在太高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "瑪卡德爾"
				}
			]
		}
	]
}