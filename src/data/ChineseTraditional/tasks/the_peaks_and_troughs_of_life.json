{
	"id": 74671,
	"type": "WQ",
	"name": "人生的波峰與波谷",
	"description": "楓丹科學院的研究員瑪卡德爾似乎正在為了什麼而發愁…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
