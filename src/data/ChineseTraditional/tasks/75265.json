			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪納奧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "嘿！朋友，我這有好東西，價格也漂亮，要看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650102,
					"content": "欸？這不是那些鰭游龍玩偶嗎？好像在悠悠市集看過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650103,
					"content": "真有眼光，但我這貨便宜，五折就賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650104,
					"content": "為什麼這麼便宜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "#嘿嘿，朋友，這{F#妳}{M#你}就別管了，我有我的管道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650106,
					"content": "雖然便宜了很多，但是感覺這些玩偶的顏色有點怪怪的，不會是假貨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650107,
					"content": "假貨？妳這個不識貨的小東西…一邊去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650108,
					"content": "#快走快走！我不賣給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪納奧"
				}
			]
		},
		{
			"id": 7526502,
