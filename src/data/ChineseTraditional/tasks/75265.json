			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "#嘿！朋友，我這有好東西…又是{F#妳}{M#你}們？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650302,
					"content": "說了不賣，聽不懂？一邊去，別在這裡礙事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650303,
					"content": "你這傢伙…現在跟我們道歉還來得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752650304,
					"content": "#{F#妳}{M#你}們有什麼毛病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "瑪納奧"
				},
				{
					"id": 752650305,
					"content": "你在賣假貨吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "#啊？是又怎麼樣？我勸{F#妳}{M#你}們少管閒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪納奧"
				}
			]
