					},
					{
						"sceneId": 3,
						"position": [
							-1378.848,
							144.201,
							7574.74
						],
						"pointId": 9216
					}
				]
			},
			"dialogs": [
				{
					"id": 755000101,
					"content": "嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000102,
					"content": "仔細看才發現，臺上這些「回聲之子」跳的舞真厲害哇！人的身體居然有辦法做出這麼誇張的動作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000103,
					"content": "配合節奏感超強的音樂還有刺激的火光，相比其他國家的藝術，有著完全不同的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000104,
					"content": "#這位容光煥發的{M#少年}{F#少女}，還有飄著的哇音玩偶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000105
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000105,
					"content": "#我看{F#妳}{M#你}們感官敏銳，氣質不凡，鐵定可以成為前衛藝術的先鋒，塗鴉畫師的超新星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000106
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000106,
					"content": "要跟著我「炫彩呆子」一起混，把握最新潮的藝術理念嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000107
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000107,
					"content": "哇啊，又是奇怪的外號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000108,
						755000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000108,
					"content": "妳還在哇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000110
					]
				},
				{
					"id": 755000110,
					"content": "這次我才不會被帶偏——重點不在哇不哇或是新外號，而是這個「炫彩呆子」說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000111,
					"content": "「前衛的理念」…聽起來好像是…納塔藝術與眾不同的關鍵點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000112,
					"content": "悟性不錯~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000113
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000113,
					"content": "如妳所見，富有張力的舞姿、律動跳脫的音樂，還有色彩鮮明的塗鴉，這些都離不開前衛理念的薰陶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000114
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000114,
					"content": "在納塔人口中，時尚、潮流、新奇之類的說法，全都是前衛理念的同義詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000115
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000115,
					"content": "而我「炫彩呆子」作為「塗鴉聯盟」的中流砥柱，正試著讓更多人理解前衛、踐行前衛、用前衛把世界碾一遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000116
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000116,
					"content": "進而讓更多藝術不斷進步，創造出非同凡響的美學產物，畫出更狂猛的大尺寸塗鴉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000117,
						755000118
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000117,
					"content": "好難懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000119
					]
				},
				{
					"id": 755000119,
					"content": "那就說點具體的，例如舞臺背景的那幅大型塗鴉，我也有參與繪製。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000120
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000120,
					"content": "假如背景換成一幅寫實的風景畫、楓丹的唯美油畫，或是須彌的壁畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000121
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000121,
					"content": "#{F#妳}{M#你}覺得搭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000122
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000122,
					"content": "這個比方倒是很直白，我好像有點懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000123,
					"content": "如果背景的圖形和配色沒有現在的塗鴉這麼誇張，音樂和舞蹈好像的確也少了點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000124,
					"content": "當然，我並不是說風景畫、油畫或壁畫就不好，只是在需要強調張力和銳氣的場合，就沒有前衛的塗鴉那麼適合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000125
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000125,
					"content": "我覺得不管納塔的哪個部族都有一種向上衝擊、追求銳勢的氣魄，因此前衛也可以說是納塔的基調！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000126
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000126,
					"content": "明明名字裡有「呆子」這個詞，懂的道理卻滿多的嘛，妳好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000127,
						755000128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000127,
					"content": "妳要收我們為徒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000129
					]
				},
				{
					"id": 755000129,
					"content": "#嘿！{F#妳}{M#你}這反應很老練哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000130
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000130,
					"content": "不用緊張，我們不拘泥於死板的師徒關係、不在乎錢和名分，我們注重的是分享經驗，期待分享之物到處開花結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000131
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000131,
					"content": "#只要{F#妳}{M#你}能夠洞察到前衛藝術的精髓，並創作出相應的塗鴉作品，我就非常滿意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000132
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000132,
					"content": "#甚至會大把大把倒貼{F#妳}{M#你}摩拉和物資，幫助{F#妳}{M#你}迅速成長為可靠的塗鴉高手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000133
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000133,
					"content": "然後來幫我畫稿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000134,
						755000135
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000134,
					"content": "啊？我來畫稿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000136
					]
				},
				{
					"id": 755000136,
					"content": "或是幫我把塗鴉藝術宣傳到其他地方，吸引更多人才加入塗鴉聯盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000137
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000137,
					"content": "畢竟我們的目標是在納塔的每座山畫上無比前衛的塗鴉，只憑寥寥十幾個人鐵定忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000138
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000138,
					"content": "我的背，我的腰…唉呀…整天舉著染料罐畫來畫去，說不定骨頭都歪了，肩膀和大腿都錯位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000139
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000139,
					"content": "本來想說事出反常必有妖，換成其他人，我甚至有點擔心是不是騙子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000140,
					"content": "不過看妳說得這麼誠實，好像的確沒什麼可疑的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000141,
					"content": "#學一手塗鴉的本領，說不定以後還可以派上用場，像是…畫一面「{NICKNAME}和派蒙領地之牆」，嚇跑魔物和壞人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000142,
					"content": "不愧是我看中的人選，痛快！那我們就進入正題了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000143
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000143,
					"content": "塗鴉這門手藝對畫技的要求並不嚴苛，在我看來，與其先練畫，不如先去找前衛理念的準繩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000144
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000144,
					"content": "準繩？是…原則的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000145,
					"content": "差不多吧！總之要找到超脫拘束的靈感，並且自由自在地表達出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000146
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000146,
					"content": "#為此，{F#妳}{M#你}們可以像我一樣，在競速挑戰中捕捉風景扭曲形變的樣貌，在近身搏鬥中找尋人體動作的極限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000147
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000147,
					"content": "如此一來，就能構思塗鴉所需要的誇張線條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000148
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000148,
					"content": "至於色彩方案，將多種自然界的物品混搭、綜合配色，往往能夠獲得意想不到的驚喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000149
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000149,
					"content": "聽起來有點熟悉…又不太對勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000150,
						755000151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000150,
					"content": "在競速和打架中觀察線條。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000152
					]
				},
				{
					"id": 755000152,
					"content": "這種研究「藝術理念」的方法還真不一樣，果然納塔人思考的方式真的很特別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755000153,
					"content": "那麼，收下我的這份塗鴉指南，帶著這臺留影機，在納塔各處大鬧一番，順帶好好感受這個國家獨特之氣的薰陶吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755000154
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000154,
					"content": "#等到{F#妳}{M#你}們歸來的時候，我就可以根據{F#妳}{M#你}們的見聞，幫{F#妳}{M#你}們總結出最能夠讓{F#妳}{M#你}們理解的前衛理念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755000151,
					"content": "收集各種物產，研究色彩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000152
					]
				},
				{
					"id": 755000135,
					"content": "欸？這樣抓助手的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000136
					]
				},
				{
					"id": 755000128,
					"content": "學妳的本事要幾摩拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000129
					]
				},
				{
					"id": 755000118,
					"content": "太抽象了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000119
					]
				},
				{
					"id": 755000109,
					"content": "哇音派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755000110
					]
				}
			]
		}
	]
}