			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沉香"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "豆豆乖，吃了藥病才能好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080102,
					"content": "不嘛不嘛！藥太苦了，我不想吃嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "紅豆"
				},
				{
					"id": 220080103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "是旅行者嗎…是這樣，我家豆豆身子一直不太好，之前求著白先生給開了個方子治病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080105,
					"content": "可豆豆總說不卜廬的藥太苦，怎麼都不肯吃，唉，這世上的藥哪有不苦的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080106,
					"content": "為了讓這孩子吃藥，我答應她，每次喝完藥之後就能吃一份「杏仁豆腐」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080107,
					"content": "旅行者，如果您有空的話，能幫我去找份「杏仁豆腐」來嗎？我還得再哄哄豆豆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "那就拜託您了，一份給豆豆吃就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080110,
					"content": "她得了什麼病？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "唉，我也說不好，但是據白先生說，這病極難治根，但就算只治表，也要一直吃藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080112,
					"content": "說不定，豆豆將來要吃一輩子的藥，她才這麼小…我真是想都不敢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080113,
					"content": "我真是恨不得是我自己得病。但是…現在我也只能盼著豆豆能少遭點罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080114,
					"content": "旅行者，拜託您了，幫我去找份杏仁豆腐回來吧，一份就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080115,
					"content": "豆豆，妳為什麼不肯吃藥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "那藥太苦了！璐璐她們的藥都沒這麼難吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "紅豆"
				},
				{
					"id": 220080117,
					"content": "豆豆，璐璐她們是在做遊戲呀，那些都是杏仁豆腐的糖水，不是藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080118,
					"content": "那…那我吃杏仁豆腐不能治好病嗎？非得吃那麼苦的藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "紅豆"
				},
				{
					"id": 220080119,
					"content": "豆豆乖，只要病好了，以後吃什麼都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080120,
					"content": "為什麼藥不能和杏仁豆腐一樣，都是甜的呢，真討厭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "紅豆"
				},
				{
					"id": 220080121,
					"content": "這孩子真是，唉…旅行者，麻煩您了，請幫我找份杏仁豆腐來吧，一份就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				}
			]
		},
