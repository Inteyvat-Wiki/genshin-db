					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080403
					]
				},
				{
					"id": 220080403,
					"content": "杏仁豆腐…可我還是要吃藥呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "紅豆"
				},
				{
					"id": 220080404,
					"content": "豆豆乖，吃了藥妳的病才能好，而且，這不是有杏仁豆腐了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080405,
					"content": "嗚…白朮哥哥那麼厲害的人，為什麼不能把藥做成杏仁豆腐味呢…",
					"roleType": "TALK_ROLE_NPC",
