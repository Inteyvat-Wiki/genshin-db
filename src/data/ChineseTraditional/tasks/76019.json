					"nextDialogs": [
						760190302
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190302,
					"content": "#嗚啊，我跟{NICKNAME}才不會做這麼可怕的事！只要妳之後不要再騙人就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
