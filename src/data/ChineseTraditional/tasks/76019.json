							1492.601,
							204.17,
							9487.794
						],
						"pointId": 13244
					}
				]
			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "「識者之證」？難道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190102,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}們湊過來幹什麼，我們在談很秘密的話題，關於雷德·米勒「偉大財寶」的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190103,
					"content": "太好了，也算我一份吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "唔…對了，既然這樣，那我們組隊好了，我正煩湊不齊啟動資金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190106,
					"content": "我一個，你一個，還有會飛的一個，一共三份，我們三個正好，一人五十萬摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190107,
					"content": "五十萬摩拉？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190108,
					"content": "唉，維里小弟，不是說好了這是我們兩個之間的秘密嗎？我是信任你，才會告訴你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190109,
					"content": "可是一百五十萬摩拉，對我來說實在不是啟動資金級別的數目呀，五十萬還勉強能夠湊齊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190110,
					"content": "他們兩個看起來也像是有經驗的冒險者，我們組隊的話，成功機率不是更高嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190111,
					"content": "#唉，我是很看好維里小弟的，既然{M#他們}{F#她們}是你看好的人選，那我也願意交往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190112,
					"content": "不過呢，這位會飛的朋友，體型和我們不一樣，自然要特別關照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190113,
					"content": "哇，是有什麼禮物要送給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190114,
					"content": "嗯，因為是特別訂製的，相比納塔原版的「強水」，能夠適應的人群也更廣，會飛的朋友當然也能放心使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190115,
					"content": "至於價格嘛，要是別人，按理是得收兩百萬摩拉的，但看在你們是維里小弟的朋友的份上，就只要一百萬摩拉好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190116,
					"content": "一百萬摩拉？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190117,
					"content": "是驚喜大禮啊，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "根本就是驚嚇才對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190121,
					"content": "就是啊，希丁芭小姐，會飛的這個原本我就沒指望她能派上用場，「強水」就不必分給她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190122,
					"content": "等一下，你這根本就不是在幫我說話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190123,
					"content": "哼，原本只是想聽聽看有沒有寶物的線索，結果你們兩個傢伙，根本就是一個壞一個笨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190124,
					"content": "#想要騙我和{NICKNAME}可沒那麼容易！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190125,
					"content": "誰是壞人？誰在欺騙？線索是真的，貨品也半分不假，至於價錢嘛…那也是你情我願的買賣。而像妳這樣聒噪的小東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190126,
					"content": "…我呢，最看不慣的就是妳這樣自以為是的傢伙了，明明自己沒多大本事，卻腆著臉狐假虎威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190127,
					"content": "希、希丁芭小姐…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "維里"
				},
				{
					"id": 760190128,
					"content": "維里小弟也是，既然是秘密的話題，當然要貼近了小聲地說，可是你呢，卻大著嗓門把這兩個不速之客招來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190129,
					"content": "我現在很煩，不讓你們吃點教訓，實在是心火難消呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190130,
					"content": "看招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190119,
					"content": "五十萬摩拉，不賣我就走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "你怎麼開始砍價了？我們根本不需要這種東西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190104,
					"content": "已經被人聽到就算不上秘密了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
