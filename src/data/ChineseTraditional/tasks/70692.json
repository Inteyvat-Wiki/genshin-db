			"dialogs": [
				{
					"id": 706920101,
					"content": "哇哇，騎士先生，你把我們的大英雄引過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "「狂圖捕手」"
				},
				{
					"id": 706920102,
					"content": "#是榮譽騎士前輩，還有白色小幫手！{F#妳}{M#你}們好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920103,
					"content": "米卡和…納塔的朋友？你們在忙什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920104,
					"content": "我們正在推廣一種對冒險家團體很有幫助的「前哨龍龍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920105,
					"content": "它結合了安柏前輩從須彌帶回來的「偵察夥伴」機關核心，還有納塔朋友們送我的小龍玩偶外形…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920106,
					"content": "夥伴機關…哦哦，我還有印象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920107,
					"content": "與須彌的「偵察夥伴」的功能類似，「前哨龍龍」可以幫忙偵察魔物、勘測地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920108,
					"content": "不過，由於重點放在後者，它更側重行動的可控性和精準度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920109,
					"content": "…榮譽騎士前輩有興趣試飛一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920110,
					"content": "真是一本正經的介紹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "欸？是…是我太緊張了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920113,
					"content": "#好像的確…明明之前基本都放鬆下來，可以比較自然地面對{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920114,
					"content": "#但最近從不少其他國家的朋友那裡聽說了{F#妳}{M#你}的事蹟，感覺{F#妳}{M#你}越來越厲害，越來越了不起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920115,
					"content": "#一想到以後要幫上{F#妳}{M#你}的忙，不能拖{F#妳}{M#你}的後腿，下意識又繃緊了神經。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920116,
					"content": "還真是米卡特有的邏輯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920117,
					"content": "已經很不錯了，騎士先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "「狂圖捕手」"
				},
				{
					"id": 706920118,
					"content": "#在納塔啊，部族裡的戰士要是碰見了{NICKNAME}，有的會激動到語無倫次，有的還會半個字都說不出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "「狂圖捕手」"
				},
				{
					"id": 706920119,
					"content": "#你作為{NICKNAME}的同事，也能算得上傳奇級高手，和我們的部族首領對話都不必害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "「狂圖捕手」"
				},
				{
					"id": 706920120,
					"content": "沒錯沒錯，米卡要有自信一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706920121,
					"content": "原來還有這種事…這樣的思考角度，我完全沒想過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920122,
					"content": "#總之，如果{NICKNAME}試飛過「前哨龍龍」後感到滿意，這個可愛又可靠的輔助機關，肯定能造福更多冒險家團體！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920123,
					"content": "這個我在行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "好的！我這就調整好「前哨龍龍」，試飛很快就能開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卡"
				},
				{
					"id": 706920124,
					"content": "讓我試試看龍龍的效能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "可以不用這麼正式的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}