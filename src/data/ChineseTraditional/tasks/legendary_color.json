					"nextDialogs": [
						150251013
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150251013,
					"content": "我們也會幫忙的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
