							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托爾特克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#{NICKNAME}，我記得我們之前就進去過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250202,
					"content": "我們是被選中的人嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "奇怪的是作品完成之後，那些先祖也沒有解開禁制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250204,
					"content": "這個山洞被封閉後，只有兩百年前的那位大薩滿維奇琳再次進去過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250205,
					"content": "據她所說，那些塗鴉作品講述了一位英雄的故事，主角的名字叫做昆圖爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250206,
					"content": "啊，抱歉，我很喜歡塗鴉這種藝術，說著說著就有點入迷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250207,
					"content": "你不跟我們一起進去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250208,
					"content": "不了，我之前嘗試深入山洞過，可惜被那道禁制擋住去路時，即便藉助了暝視龍夥伴的力量也沒能解開它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250209,
					"content": "那道禁制或許就是先祖的考驗吧…無法通過考驗，也就沒資格欣賞他們的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250210,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250211,
					"content": "兩位不必替我困擾，就算不考慮這一點，我也不能跟隨兩位進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250212,
					"content": "我沒有首領那樣質疑傳統的魄力，既然只有暝視龍大長老指定的人才能完成這項使命，我一起跟進去恐怕會壞事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250213,
					"content": "好吧…那我們去去就來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
