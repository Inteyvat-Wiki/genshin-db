					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "請看，這面織物是部族先祖留下的作品之一，我們要完成的就是這樣的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250702,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250703,
					"content": "畫面中的人物是我們部族的傳奇薩滿維奇琳，她生活在兩百多年前，曾經也是被暝視龍大長老選中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250704,
					"content": "她尤其擅長駕馭色彩的秘術，並出色地完成了自己的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250705,
					"content": "兩位面前的織物所記載的正是她一生的事蹟，這面織物很有可能也是她的作品，其品質即便放在同類織物裡仍舊令人驚嘆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250706,
					"content": "不過很可惜，她離世後被選中的人只能寄希望於「神靈的饋贈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250707,
					"content": "你要重新延續這份傳承，對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "#說得不錯，{NICKNAME}。不過有一點我還是想糾正一下，重新延續這份傳承的，是「我們」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250709,
					"content": "嗯嗯！忽然有點激動呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250710,
					"content": "將樣品取來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250711,
					"content": "一名煙謎主族人將測試用的織物樣品拿來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "#{NICKNAME}，雖然幫織物上色的方法比較複雜，但我相信{F#妳}{M#你}有能力掌握，只要認真聽從我的指導就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250713,
					"content": "沒問題，我們開始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "樣品上已經預先製作好了底紋，根據底紋來區分色塊。調製好的染料浸入織物需要時間，請耐心等待，防止混到顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250715,
					"content": "（根據指導將織物上色。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "很好，染料浸染得很不錯，花紋也很清晰。接下來把剩餘的特殊染料都用上去，應該就可以重現那種特殊的「色彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250717,
					"content": "哦哦，最後一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250718,
					"content": "（用完剩餘的染料。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "嗯…現在算是成功了嗎？好像什麼都看不出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250720,
					"content": "那種「色彩」沒有被重現…染色失敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250721,
					"content": "難道是因為我的手法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "不，閣下的悟性很高，很快就掌握了我教給閣下的上色技巧。即便由我親自來，也不會有什麼區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250723,
					"content": "那這是怎麼回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250724,
					"content": "或許是有特殊的編織技巧，或許上色流程也與普通織物不同…我最終還是沒有解開這個謎題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250725,
					"content": "抱歉沒能真的幫上忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250726,
					"content": "應該道歉的是我，讓兩位白跑了一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250727,
					"content": "之前說好的報酬我還是會付給兩位，但我也希望兩位不要放棄這項使命。我會繼續調查，只要有新的線索就會立刻聯絡兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250728,
					"content": "#不用擔心，我和{NICKNAME}從來不會放棄使命的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250729,
					"content": "不過…其實我有個問題，既然製作這種織物這麼難，為什麼不改用文字記錄歷史呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250730,
					"content": "你一直希望做出變革吧？那不妨就從這裡開始，用文字記錄歷史更方便，也更詳細不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250731,
					"content": "閣下對我的理念好像有些誤解…沒關係，我可以回答閣下的疑問，只是希望閣下能隨我去一個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150250732,
					"content": "嗯…好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
