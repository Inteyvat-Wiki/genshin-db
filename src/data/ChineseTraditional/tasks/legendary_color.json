					"speakerSubtitle": "煙謎主首領"
				},
				{
					"id": 150251007,
					"content": "其一，便是「講述歷史的方式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "庇蘭",
					"speakerSubtitle": "煙謎主首領"
				},
