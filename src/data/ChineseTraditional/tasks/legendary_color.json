			"dialogs": [
				{
					"id": 150250101,
					"content": "兩位就是被特拉波長老選中的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "托爾特克"
				},
				{
					"id": 150250102,
					"content": "你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150250103,
					"content": "我就是首領安排給兩位的領路人，叫我托爾特克就好。首領的信使已經向我講明了具體情況，兩位請隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托爾特克"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
