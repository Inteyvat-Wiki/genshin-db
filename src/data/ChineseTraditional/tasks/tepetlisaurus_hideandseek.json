			"dialogs": [
				{
					"id": 750250101,
					"content": "嗚啊，這是什麼神奇的地方？居然有這麼多小嵴鋒龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250102,
					"content": "難道是什麼嵴鋒龍的…聚集地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250103,
					"content": "呀！…唔呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#難得遇到這麼多同伴，{REALNAME[ID(2)|SHOWHOST(true)]}看起來也很興奮呦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250105,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#哦，你是想去那邊和牠們一起玩嗎？唔…{NICKNAME}，這麼一想，{REALNAME[ID(2)|SHOWHOST(true)]}真的很少和小嵴鋒龍們一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250107,
					"content": "注意安全哦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#雖然還是有點擔心，不過現在我們就找個地方坐下來，邊吃東西邊聊天邊等{REALNAME[ID(2)|SHOWHOST(true)]}好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250111,
					"content": "#{F#妳}{M#你}和派蒙在附近找到了一塊不錯的休息處，等待{REALNAME[ID(2)|SHOWHOST(true)]}結束遊玩歸來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "只不過，等待的時間似乎長了一些…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#…咦？{REALNAME[ID(2)|SHOWHOST(true)]}怎麼還沒有回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250114,
					"content": "不會是出了什麼事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250115,
					"content": "也許是玩得太開心了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "就算是這樣也要好好說說牠，天都要黑了還不回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250117,
					"content": "唔…我們快點去找牠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750250108,
					"content": "要及時回來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
