			"dialogs": [
				{
					"id": 210240802,
					"content": "#不錯，這些「夜泊石」我就收下了。這是貨單，{F#妳}{M#你}拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240803
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240803,
					"content": "#好了，拿到了就快點走吧。那個託{F#妳}{M#你}辦事的人，想必已經等得心急如焚了。",
