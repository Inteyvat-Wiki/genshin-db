			"dialogs": [
				{
					"id": 210240901,
					"content": "您找到了貨單了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240902,
					"content": "全部找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "謝謝您，太感謝您了，太好了，總算沒出大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240904,
					"content": "要是這些貨單丟了，老闆不知道會發多大火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240905,
					"content": "呃，您是想問「這些貨單到底是什麼生意」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240906,
					"content": "抱歉，我真的不能告訴您，這些都是機密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240907,
					"content": "這是您的報酬，請收…等會，這個盒子怎麼被打開過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240908,
					"content": "…在野外遇見了一個人，她撿到盒子之後打開看了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240909,
					"content": "完了，完了，全完了！不行…得快點去告訴老闆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240910,
					"content": "哦，您放心，我不會懷疑您的，畢竟您的事蹟我已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "蘭達"
				},
				{
					"id": 210240911,
					"content": "咳！我，我得想辦法和老闆聯繫了，請您去忙自己的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭達"
				}
			]
		},
