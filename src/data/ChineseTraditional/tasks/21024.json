			"trigger": {
				"objectNames": [
					"寶兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "看起來沒什麼用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240602,
					"content": "請問妳見過一個盒子嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "盒子？哦，我確實撿到了一個盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240604,
					"content": "我已經打開看過了，是一批貨單呢，看起來還是一筆很大的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240605,
					"content": "哎呀，不知道這個盒子的主人，願意付多少錢把盒子拿回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240606,
					"content": "…什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "#別這麼一副緊張的樣子，我就是和{F#妳}{M#你}開個玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240608,
					"content": "這貨單上記的貨物價值可不低，也不知道是璃月港裡哪位大老闆的大手筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240609,
					"content": "我可不是不識時務的人，既然知道大概是塊鐵板，那就沒有還硬往上踢的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240610,
					"content": "#不過，我費心費力保管著這貨單，{F#妳}{M#你}一句話就想要走，是不是…有點說不過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240611,
					"content": "這樣好了，我們就用最傳統的「以物易物」來解決這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240612,
					"content": "#{F#妳}{M#你}去給我找三顆「夜泊石」來，我就把這貨單給{F#妳}{M#你}，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240613,
					"content": "畢竟，和這些貨單上記著的大買賣相比…這三顆「夜泊石」可真算不上什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240614,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "#那{F#妳}{M#你}就快去找吧，找到了之後，我們再一手交石，一手交貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240616,
					"content": "…這上面記了什麼買賣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "#{F#妳}{M#你}不知道嗎？{F#妳}{M#你}只是來幫別人辦事…哼，這樣也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240619,
					"content": "#聽我一句勸，這種規模的買賣，{F#妳}{M#你}還是不要多打聽比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240620,
					"content": "#好了，{F#妳}{M#你}去把「夜泊石」拿來給我，我把貨單給{F#妳}{M#你}，{F#妳}{M#你}再把貨單給那個託{F#妳}{M#你}辦事的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 210240621,
					"content": "事情辦完，乾淨俐落，一點麻煩也不惹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				}
			]
		},
