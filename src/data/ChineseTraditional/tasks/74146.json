					"安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460101,
					"content": "#{NICKNAME}騎士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460102,
						741460107,
						741460114,
						741460120
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460102,
					"content": "關於現在的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460103
					]
				},
				{
					"id": 741460103,
					"content": "我好像想起了一些…一些很模糊的感覺。我不知道這些感覺能不能稱為「記憶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460104
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460104,
					"content": "雖然不知道人類的記憶到底是保存在頭腦裡還是心中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460105
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460105,
					"content": "但純水精靈好像既沒有頭腦也沒有心，只有水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460106
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460106,
					"content": "要是我也能像笨狗那樣，只要坐在那裡唸叨什麼「零碎資料整理」之類的就能想起一切，那該多好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460107,
					"content": "還想瞭解一些關於安的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460108
					]
				},
				{
					"id": 741460108,
					"content": "#我不知道還有什麼可以告訴{F#妳}{M#你}的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460109
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460109,
					"content": "我是「瑪麗安」幻化出來的部分，可是…可是她拒絕了我，也拒絕了其他人…我是說，其他存在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460110
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460110,
					"content": "我想要解救的莉利絲公主並不存在，「瑪麗安」也不是瑪麗安，不是笨狗的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460111
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460111,
					"content": "不知道為什麼看到笨狗就覺得，內部好像湧起了什麼…像氣泡一樣的感情！快要想起什麼的時候，泡泡就破開了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460112
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460112,
					"content": "卡特皮拉好像知道什麼的樣子，可是他沒有十足的把握就不願多說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460113
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460113,
					"content": "明明來到了名字裡有「水仙十字」的地方，卻還是什麼也沒弄清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460114,
					"content": "還想瞭解一些關於莉利絲公主的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460115
					]
				},
				{
					"id": 741460115,
					"content": "莉利絲公主善良又勇敢，所以為了保護朋友，才讓自己陷入困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460116
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460116,
					"content": "之前我只想，我一定也是她的夥伴，她曾經保護過我，所以在她遇到困難的時候，我必須去解救她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460117
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460117,
					"content": "雖然她可能不希望我去救她…因為她太善良了，寧可自己受困也不要朋友遇到危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460118
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460118,
					"content": "但是我如果不去救她，怎麼配當她的朋友，受她的保護呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460119
					],
					"speakerTitle": "安"
				},
				{
					"id": 741460119,
					"content": "「記憶」…是模糊的，好像水裡的渦流。感情…願望，卻那麼真實。即使現在我已經知道她卻只是故事裡的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741460120,
					"content": "沒什麼，妳先休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460121
					]
				},
				{
					"id": 741460121,
					"content": "#嗯。晚安，{NICKNAME}騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
		{
			"id": 7414602,
