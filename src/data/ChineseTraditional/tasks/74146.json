			"dialogs": [
				{
					"id": 741460201,
					"content": "#…演算流程中止。{NICKNAME}{M#先生}{F#小姐}，請問有何吩咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460202,
						741460209,
						741460214,
						741460220
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460202,
					"content": "關於現在的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460203
					]
				},
				{
					"id": 741460203,
					"content": "經過與純水精靈·安，以及水仙十字結社殘黨·卡特皮拉的溝通，獲得了部分有效資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460204
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460204,
					"content": "我是原型機4ACV07，由吉約丹設計，用以陪伴並保護我的主人瑪麗安小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460205
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460205,
					"content": "很遺憾，目前沒有獲得更多有關瑪麗安小姐的有效資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460206
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460206,
					"content": "此外，純水精靈·安能夠提供的資訊很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460207
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460207,
					"content": "水仙十字結社殘黨·卡特皮拉沒有提供全部資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460208
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460208,
					"content": "需要更多時間進行分析…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460209,
					"content": "還想瞭解一些關於西摩爾的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460210
					]
				},
				{
					"id": 741460210,
					"content": "我是原型機4ACV07，由吉約丹設計，用以陪伴並保護我的主人瑪麗安小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460211
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460211,
					"content": "我搭載了楓丹自然哲學學院最先進的光學設備、記憶儲存單元、邏輯單元，以及各種功能模組。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460212
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460212,
					"content": "讓我得以在記錄瑪麗安小姐日常生活之餘，也作為探員助手發揮實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460213
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460213,
					"content": "目前的首要目標是：找到瑪麗安小姐，並確保她的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460214,
					"content": "還想瞭解一些關於瑪麗安的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460215
					]
				},
				{
					"id": 741460215,
					"content": "我被設計、製造的目的即是為了陪伴及保護我的主人瑪麗安小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460216
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460216,
					"content": "目前的首要目標是：找到瑪麗安小姐，並確保她的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460217
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460217,
					"content": "純水精靈·安的部分行為表現出了與瑪麗安小姐過往行為相似的特徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460218
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460218,
					"content": "但構成她們的要素…（嘈雜的機械音），…（嘈雜的機械音）。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460219
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460219,
					"content": "提示：定期清除紀錄空間，能夠有效降低此類問題的發生頻率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 741460220,
					"content": "沒什麼，再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460221
					]
				},
				{
					"id": 741460221,
					"content": "#收到。祝您一切順利，{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩爾"
				}
			]
		},
		{
			"id": 7414603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
