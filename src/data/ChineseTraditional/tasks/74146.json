			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡特皮拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741460301,
					"content": "怎麼了，還有什麼想聊聊的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460302,
						741460311,
						741460317,
						741460324
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460302,
					"content": "關於現在的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460303
					]
				},
				{
					"id": 741460303,
					"content": "真好啊，時隔數百年，這裡又熱鬧起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460304
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460304,
					"content": "…只是開個玩笑。我想這都是有意義的，我是說我們像這樣聚在一起。如果只當作巧合，未免太過無趣、太過愚鈍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460305
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460305,
					"content": "我們的相遇一定是某種開端的徵兆，就像被壓抑的存在將要萌芽，將要迸發之前的異象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460306
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460306,
					"content": "但是話說回來，在真正的末日到來以前，又有誰會在荒謬中覓得意義，確信那些異象預示著一個莊重的時刻必將到來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460307
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460307,
					"content": "除了納齊森科魯茲…過去我也曾將他稱作「主人」，不管怎麼說，他的確能夠被稱為「大師」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460308
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460308,
					"content": "就像我們的道路在此處——在這末日時鐘之下交會，若我們循著交織的路繼續前進，或許能夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460309
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460310
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460310,
					"content": "…剩下的話，還是留到旅途的終點再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460311,
					"content": "還想瞭解一些關於卡特皮拉的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460312
					]
				},
				{
					"id": 741460312,
					"content": "關於我自己還有什麼可說的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460313
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460313,
					"content": "我時常感到在自己本質的根底存在著相斥的屬性，它們分別都是純粹的，但同時，對彼此來說也是異質的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460314
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460314,
					"content": "#因此當它們交融時，各自都混入了雜質。{F#妳}{M#你}能理解嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460315
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460315,
					"content": "我的自我是不牢固的…我有時是勇者，有時是惡龍，我的自我是用他者的敘述堆砌成的謊言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460316
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460316,
					"content": "但我相信答案是存在的，唯一正確的答案。時鐘的指針再次走動，我已經做好準備踏出這一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460317,
					"content": "還想瞭解一些關於莉諾爾的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460318
					]
				},
				{
					"id": 741460318,
					"content": "雖然只是很短的一段時間…我也沒有想到自己會這樣熱衷在她面前扮演保護者的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460319
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460319,
					"content": "的確是很新奇的體驗。也許是被她的純粹所吸引了吧，因為那恰恰是我不可能具有的特質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460320
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460320,
					"content": "但保全她純粹的卻是梅洛彼得堡…一個她本不應在的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460321
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460321,
					"content": "為了給她選擇的機會，必得先從她手中奪走選擇的權利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460322
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460322,
					"content": "一想到現在，塵世已經進入了她的心坎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460323
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741460324,
					"content": "之後再聊吧。",
