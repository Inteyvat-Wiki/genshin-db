				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100301,
					"content": "非常不錯的薄荷。請稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100302,
					"content": "賈法爾拿出其它食材開始烹飪…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "#這是用{F#妳}{M#你}帶來的食材製作出的「薄荷豆湯」，請嚐嚐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100304,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "不用客氣。專心享受這道美味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100306,
					"content": "對我來說，在享受美食的時候，我會把那些讓人疲倦的課題和研究統統拋在腦後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100307,
					"content": "就這麼任我的思維沉默地流淌過那道寂靜的小溪…這就是我的休憩方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100308,
					"content": "#好了，還請{F#妳}{M#你}細細品嚐這道美味。希望{F#妳}{M#你}的思緒也能從中得到休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈法爾"
				}
			]
		},
