			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賈法爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "#朋友，{F#妳}{M#你}看起來很匆忙，有什麼在讓你憂心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100102,
					"content": "有很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "#喔…我發現{F#妳}{M#你}的神情很疲憊，但動作還是匆忙無比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100104,
					"content": "#{F#妳}{M#你}一定是在為某個問題而憂心忡忡，但這個問題{F#妳}{M#你}又不得不盡快找到解決方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100109,
					"content": "#如果{F#妳}{M#你}願意讓我耽誤一會的話，我希望{F#妳}{M#你}能坐下來，和我一同品嚐一道美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100110,
					"content": "四處奔波固然是人生常態…但我們常說，奔湧向前的洶湧河水，偶爾也會沉默地淌過寂靜的小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100111,
					"content": "再如何奔忙，總要留給自己一點時間休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100112,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100113,
					"content": "不如我們一同來品嚐一道「薄荷豆湯」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100114,
					"content": "你無需付給我摩拉，只需要為我找到一株薄荷就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100115,
					"content": "喔，對了，找薄荷的時候，記得不要太挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100116,
					"content": "#記住，{F#妳}{M#你}只是在尋找一株普通的薄荷，不是在尋找任何問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100105,
					"content": "其實還好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "喔，那樣就最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100107,
					"content": "#但{F#妳}{M#你}的腳步如此匆忙，想必是正在為解決某個問題而奔走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100108,
					"content": "#唔，雖然我不知道{F#妳}{M#你}要處理什麼問題，但我有一個建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "賈法爾"
				}
			]
		},
