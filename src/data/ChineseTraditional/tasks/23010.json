				"objectNames": [
					"賈法爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "#朋友，{F#妳}{M#你}看起來很匆忙，有什麼在讓你憂心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100802,
					"content": "有很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "#喔…我發現{F#妳}{M#你}的神情很疲憊，但動作還是匆忙無比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100804,
					"content": "#{F#妳}{M#你}一定是在為某個問題而憂心忡忡，但這個問題{F#妳}{M#你}又不得不盡快找到解決方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100809,
					"content": "#如果{F#妳}{M#你}願意讓我耽誤一會的話，我希望{F#妳}{M#你}能坐下來，和我一同品嚐一道美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100810,
					"content": "四處奔波固然是人生常態…但我們常說，奔湧向前的洶湧河水，偶爾也會沉默地淌過寂靜的小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100811,
					"content": "再如何奔忙，總要留給自己一點時間休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100812,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100813,
					"content": "不如我們一同來品嚐一道「烤肉卷」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100814,
					"content": "#{F#妳}{M#你}無需付給我摩拉，只需要為我找到一份獸肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100815,
					"content": "無論用什麼方法找到獸肉都沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100816,
					"content": "#記住，{F#妳}{M#你}要找到的只是一份獸肉，而不是一個難關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100805,
					"content": "其實還好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "喔，那樣就最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100807,
					"content": "#但{F#妳}{M#你}的腳步如此匆忙，想必是正在為解決某個問題而奔走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "賈法爾"
				},
				{
					"id": 230100808,
					"content": "#唔，雖然我不知道{F#妳}{M#你}要處理什麼問題，但我有一個建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "賈法爾"
				}
			]
		},
