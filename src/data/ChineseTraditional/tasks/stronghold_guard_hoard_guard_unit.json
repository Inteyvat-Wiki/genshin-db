			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"青霆",
					"洋蔥尾巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#哦呦，{NICKNAME}和派蒙，{F#妳}{M#你}們好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800102,
					"content": "既然巧遇了，要不要來看看我青霆的鼬鼬？牠叫洋蔥尾巴，很可愛哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800103,
					"content": "…喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "洋蔥尾巴"
				},
				{
					"id": 766800104,
					"content": "喂喂，洋蔥尾巴，你不是這樣叫的！這兩位應該不懂阿舍魯老師的語言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800105,
					"content": "…咕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "洋蔥尾巴"
				},
				{
					"id": 766800106,
					"content": "也不能用團雀語哦，拜希麥小姐已經回須彌去休養了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800107,
					"content": "對不起啊，我家洋蔥尾巴和別的動物交流太多，一時錯亂了，暫時找不回自己的頻道，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800108,
					"content": "先讓牠休息一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800109,
					"content": "妳也是動物專家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "唔，怎麼感覺妳和我們很熟，說話很自然的樣子…難道以前調查過我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800112,
					"content": "#放鬆，放鬆，我是{F#妳}{M#你}們的自己人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800113,
					"content": "#我為夜蘭老闆工作，而{F#妳}{M#你}們是夜蘭老闆最最重要的賓客，我們關係有多牢靠，不用多說了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800114,
					"content": "那的確是自己人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "哎呀，早說嘛！害我緊張了一小下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800117,
					"content": "話說回來，妳和洋蔥尾巴在這個荒郊野嶺呆呆站著，是在忙什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800118,
					"content": "忙著看大門…或者說，檢驗我的「看大門軍團」能不能好好上工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800119,
					"content": "看大門？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "#都是自己人，我悄悄告訴{F#妳}{M#你}們——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800122,
					"content": "這附近的地下藏著我的一座物資據點，但最近，據點老是被各種魔物撬開大門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800123,
					"content": "於是我花費重金，請叮鈴哐啷蛋捲工坊的天才機械師為我打造了看門的機關軍團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800124,
					"content": "咳咳，正確描述，應該是保全系統。能夠自行選擇部署地點，多種功能組合搭配的防禦體系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800125,
					"content": "我運氣不錯，再過不久，那位大師就要帶著她的作品參加展會，賣給我的這套就當成前期驗證的款式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800126,
					"content": "所以我在據點前方打造了一條複合防線，請君…不對，是請魔物入甕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800127,
					"content": "這樣，不僅能試出多個保護據點的方案，還能為大師提供許多資料，一舉兩得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800128,
					"content": "原來妳買到了愛諾的傑作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "要來試試看嗎？我已經藉助它們搞定許多魔物了，感覺非常舒壓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800131,
					"content": "#{F#妳}{M#你}們也來舒壓一下，順帶讓我參考參考{F#妳}{M#你}們的方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800132,
					"content": "當然，酬勞好說。都是自己人，開價得是普通顧問的兩倍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "青霆"
				},
				{
					"id": 766800133,
					"content": "沒錯，都自己人，多給一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "嗯…嗯嗯！考慮到幫妳也是變相幫了夜蘭，這件事對大家都有好處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800136,
					"content": "就讓經驗豐富的我們露兩手好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766800134,
					"content": "哎呀，這怎麼好意思呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "聽起來還滿有趣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "軍團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "夜蘭的朋友也是我們的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "妳也是動物朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}