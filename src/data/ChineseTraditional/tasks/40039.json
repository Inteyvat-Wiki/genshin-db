			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390101,
					"content": "#北斗正在孤雲閣那邊幫我打撈散落的群玉閣藏品。{F#妳}{M#你}們若有興趣，可以去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "還真是少了很多東西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390202,
					"content": "什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "與先前相比，如今這座群玉閣裡少了許多東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390204,
					"content": "我收藏的許多書籍、家具和小飾品，都隨著那座群玉閣墜入海中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390205,
					"content": "這些物品大都在那場大難中毀壞了，少部分倖存的散落在海面上，極難回收。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390206,
					"content": "只有擅長水上工作的人才能替我辦到這件事。只是…不知道北斗能不能把它們都撈回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390207,
					"content": "撈回來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "欸？妳讓北斗去撈那些東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400390209,
					"content": "「讓」這個字，不夠精準。我們之間向來是公平交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390210,
					"content": "北斗拿錢辦事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "除了「錢」之外，還有其他的「報酬」…呵呵，這些事複雜著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390212,
					"content": "總之，北斗現在正在孤雲閣一帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390213,
					"content": "#{F#妳}{M#你}們若有興趣，可以去看看。說不定，{F#妳}{M#你}們也能幫到她的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003904",
							"2"
						],
						"stepId": 4003904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "那個麻煩的女人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390402,
					"content": "那座群玉閣在海上撞了個粉碎，裡面的東西肯定也都被撞壞了，怎麼可能撈得上來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390403,
					"content": "打撈還順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "#旅行者？{F#妳}{M#你}們怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390405,
					"content": "我是來幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "#哦！{F#妳}{M#你}來得正好，現在全船的人都出動了，人手實在是不夠用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390407,
					"content": "#{F#妳}{M#你}看，我連辛焱都拉來幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390408,
					"content": "辛焱居然也來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "對喔，辛焱怎麼會在船上？難道是有演出？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400390410,
					"content": "是啊！雖然也算不上正式音樂演出啦，是北斗姐說想辦宴會，請我來唱兩首歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400390411,
					"content": "但什麼都還沒開始，忽然有個自稱是凝光秘書的人過來，把北斗姐叫走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400390412,
					"content": "是叫百聞還是百曉來著？唔…有些記不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390413,
					"content": "反正就是凝光又突發奇想，要我幫她到海上打撈藏品，作為交換她會支付一大筆勞務費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390414
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390414,
					"content": "哼…既然資金到位，這活兒我們接就接了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390415
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390415,
					"content": "打撈啊，必須得用小船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390416
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390416,
					"content": "船隊裡能動用的小船都出發了，不過眼下還缺一艘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390417
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390417,
					"content": "我有一艘小船。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390418
					]
				},
				{
					"id": 400390418,
					"content": "#{F#妳}{M#你}有船？那正好，我們就坐{F#妳}{M#你}的船出海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390419
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390419,
					"content": "多一個人多一份力量嘛。早點忙完，我們才好回來辦宴會慶祝過節啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
