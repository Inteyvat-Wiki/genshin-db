			"dialogs": [
				{
					"id": 400390801,
					"content": "停手！都給我停手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390802,
					"content": "你們這幫不長眼的，連北斗大姐都不認識了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390803,
					"content": "嘿嘿…北斗姐，這麼長時間沒見，您身手還是這麼好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390804,
					"content": "卡門，一段時間不見，你怎麼又胖了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390805,
					"content": "再胖下去，你躲在草叢裡的時候可就要藏不住自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390806,
					"content": "您說笑了，說笑了…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390807,
					"content": "說正事吧，這些東西我要了。把東西放下，我不為難你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390808,
					"content": "是是是，都聽北斗姐的…把東西都放下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390809,
					"content": "東西都給您放在這了，那…那兄弟們就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "卡門"
				},
				{
					"id": 400390810,
					"content": "卡門帶著盜寶團迅速離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "居然答應得這麼爽快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400390812,
					"content": "投降得很俐落。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "跑得也很俐落啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400390814,
					"content": "別在他們身上浪費時間了，我們快點去海上接著打撈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390815,
					"content": "對了，還得把這些東西搬上船才行…旅行者，過來搭把手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		},
