					"nextDialogs": [
						400391110
					],
					"speakerTitle": "溜溜"
				},
				{
					"id": 400391110,
					"content": "兄弟們忙前忙後，好歹得喝一口湯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391111
					],
					"speakerTitle": "溜溜"
				},
				{
					"id": 400391111,
					"content": "這東西不是你們能碰的。我再說一遍，把東西放下，然後有多遠滾多遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391112
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400391112,
					"content": "這…不太好吧…北斗姐，不然我們再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391113
					],
					"speakerTitle": "溜溜"
				},
				{
					"id": 400391113,
					"content": "呼…看來你是在拖時間啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391114
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400391114,
					"content": "那也別廢話了，來吧，我們過兩招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
