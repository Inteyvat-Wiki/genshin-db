			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯恩哈德",
					"莫娜",
					"菲謝爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705190201,
					"content": "伯恩哈德，我們籌集到足夠的資金啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190202,
					"content": "#居然這麼快？{F#妳}{M#你}們的效率也太驚人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190203
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190203,
					"content": "萬事俱備，只差開店了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190204
					]
				},
				{
					"id": 705190204,
					"content": "好，我這邊也和供應商們談好了，請稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190205
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190205,
					"content": "伯恩哈德向供應商交付了「佳釀晶凍」，不久後就將店鋪搭建完畢。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190206
					]
				},
				{
					"id": 705190206,
					"content": "#怎麼樣，看起來還不錯吧！如果{F#妳}{M#你}們有什麼靈感，隨時可以調整店鋪的裝潢喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190207
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190207,
					"content": "有模有樣，很有感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190208,
					"content": "我來給店鋪取一個名字吧…就叫「西風呼呼義賣鋪」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190209,
						705190211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190209,
					"content": "很有派蒙的風格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190210
					]
				},
				{
					"id": 705190210,
					"content": "#就當{F#妳}{M#你}是在表揚我好了！那，伯恩哈德，還需要我們做點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190213,
					"content": "#籌集資金是門苦差事，已經讓{F#妳}{M#你}們受累了。繁瑣的工作不勞{F#妳}{M#你}們，全都交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190214
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190214,
					"content": "#{F#妳}{M#你}們見多識廣，還請{F#妳}{M#你}們確定本店的經營方向，比如銷售方針、服務特點和品管原則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190215
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190215,
					"content": "#這些詞是我從其他店主那裡聽來的，我不太理解，但知道它們很重要，還是由{F#妳}{M#你}們來決定為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190216
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190216,
					"content": "也就是說，我們兩個來當店主，負責店鋪的整體策略，而你來當店員，負責具體的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190217,
					"content": "是的，我就擅長執行，請把我當成「工具人」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190218
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705190218,
					"content": "好強的覺悟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190219
					]
				},
				{
					"id": 705190219,
					"content": "呃，倒也不用這麼誇張啦，我們也不是黑心店長嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190220,
					"content": "#你先去休息一下吧，伯恩哈德，我和{NICKNAME}要好好商量一下策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190221,
					"content": "根據以往的見聞，和派蒙研究了店裡的商品，討論了經營店鋪的要點…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190222
					]
				},
				{
					"id": 705190222,
					"content": "好，要點很清楚，目標是做成「市集上最棒的小吃店」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190223,
					"content": "接下來就拿出最好的狀態，迎接第一批顧客吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190224,
					"content": "開店開店！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190225
					]
				},
				{
					"id": 705190225,
					"content": "#{NICKNAME}和派蒙？沒想到能在這裡碰見{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190226
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190226,
					"content": "莫娜和菲謝爾！妳們也來市集玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190227,
					"content": "呵！不枉本皇女採信那冥冥之中的預感，讓梅姬斯圖斯卿陪同我前來巡視這凡俗的節慶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190228
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190228,
					"content": "即便是平平無奇的秋日，也隱伏著常理之外的轉機…妙哉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190229
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190229,
					"content": "#小姐正按捺著喜悅的嗓音，能見到{F#妳}{M#你}們，她的心情好得出奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190230
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190230,
					"content": "奧…奧茲！添油加醋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190231
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190231,
					"content": "哼哼，還是由我來說明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190232
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190232,
					"content": "不久前皇女殿下做了個不錯的夢，感覺最近會有好事發生，想來找我諮詢星象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190233
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190233,
					"content": "另外，她發現佳釀節辦得滿熱鬧的，就問我要不要一起去逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190234
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190234,
					"content": "我當然答應囉。剛好可以趁著節日促銷採購一大批物資，為趕稿做準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190235
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190235,
					"content": "其實，也多虧皇女殿下的提醒，我才知道佳釀節已經到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190236
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190236,
					"content": "梅姬斯圖斯卿，本皇女必須強調，那個夢是九天前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190237
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190237,
					"content": "在此期間，梅姬斯圖斯卿一直沒有回信，本皇女才蒞臨妳的住所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190238
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190238,
					"content": "等等…已經過去九天了？九天？！怎麼這麼快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190239
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190239,
					"content": "念在這次的文稿對於梅姬斯圖斯卿至關重要，本皇女就不計較了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190240
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190240,
					"content": "不過還請梅姬斯圖斯卿留意，門口的信箱塞得非常滿，可能有不少人以為您失聯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190241
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190241,
					"content": "莫娜還真是沉浸在學術研究裡啊，忘記了時間、忘記回信給別人，也沒注意到這麼盛大的慶典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190242,
						705190243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190242,
					"content": "不被外界干擾有時很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190244,
					"content": "總…總之！時間緊迫，我要快點採購完所有物資！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190245
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190245,
					"content": "#話說回來，真想不到{NICKNAME}和派蒙會親自開店啊，還是我最關注的小吃店！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190246
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190246,
					"content": "我們也是受人所託啦，嘿嘿，請多多關照小店生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190247,
					"content": "莫娜有什麼想買的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190248
					]
				},
				{
					"id": 705190248,
					"content": "#讓我想想…{F#妳}{M#你}們有沒有推薦的…嗯…下酒菜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190249
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190249,
					"content": "當然有了，要多少有多少！讓我看看菜單啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190250,
					"content": "等等…欸？下酒菜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190251,
					"content": "難道說，莫娜妳因為稿子進展不順利，開始酗酒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190252,
					"content": "這樣說來，小姐近來常去拜訪，可能確實耽誤了不少時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190253,
						705190255
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190253,
					"content": "要振作啊，莫娜！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190254
					]
				},
				{
					"id": 705190254,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190257,
					"content": "不是啦，跟喝酒和拜訪都無關啦！你們別緊張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190258
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190258,
					"content": "之前皇女殿下請我品嚐過她拿手的冷肉拼盤…不好意思，是「祝聖交響樂」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190259
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190259,
					"content": "滋味獨特，每一口都能帶來實實在在的肉的滿足感，我還沒回過神來就全吃完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190260
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190260,
					"content": "呃…客人享受食物，對廚師來說也算是一種認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190261,
					"content": "冷肉拼盤確實很棒。能補充能量，還可以長期保存。通常是被用來當作下酒菜的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190262
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190262,
					"content": "除了價格因素，其他方面確實遠勝過「滿足沙拉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190263
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190263,
					"content": "但反過來思考，佳釀節的主題是美酒，下酒菜會跟著打折出售。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190264
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190264,
					"content": "天賜良機，必須要牢牢把握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190265
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190265,
					"content": "歡愉吧，梅姬斯圖斯卿！那是本皇女出遊期間一時興起的作品，妳還有機會享受到至為臻美的佳餚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190266
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190266,
					"content": "小姐的意思是，她還沒有施展全部本領。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190267
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190267,
					"content": "我知道的！皇女殿下的廚藝遠遠不只那盤菜的水準…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190268
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190268,
					"content": "但我作為臣子，怎麼能讓皇女殿下親自下廚呢…不對，我是說，我怎麼能讓來家裡的客人做飯呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190269
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190269,
					"content": "至少，我也得多備點和沙拉不一樣的…說不定能找出妳喜歡的口味呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190270
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190270,
					"content": "欸？原來莫娜是這樣想的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190271
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190271,
					"content": "小姐，這種時候表現得「早有所料」和「眼觀大局」更符合妳的作風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190272
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190272,
					"content": "咳咳！沒錯！梅姬斯圖斯卿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190273
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190273,
					"content": "作為本皇女認可之人，妳應當盡覽星天的奧秘…無需另做取悅本皇女之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190274
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190274,
					"content": "別在意，我也不是每天都這麼忙的…等有空之後拓展一下其他領域，也不是什麼難事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190275
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190275,
					"content": "那麼——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190276
					]
				},
				{
					"id": 705190276,
					"content": "那麼，就由我們「西風呼呼義賣鋪」來解決這個難題吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190277,
					"content": "店裡不僅有即食的下酒菜，還有各類半成品，莫娜可以各買幾種！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190278
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190278,
					"content": "加工半成品花不了多少時間，也不容易出錯，能讓莫娜快速熟悉烹飪的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190279,
					"content": "等到妳不那麼忙了，再去挑戰難度更高的菜餚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190280
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190280,
					"content": "#當然，我們也可以上門教學！{NICKNAME}做菜可是很有一套的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190281
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190281,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190282
					]
				},
				{
					"id": 705190282,
					"content": "哈哈，真是個好主意！我都想提高預算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190283
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190283,
					"content": "梅姬斯圖斯卿，本皇女期待著妳的傑作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190284
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190284,
					"content": "但也請務必牢記派蒙卿的建議，合理分配時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190285
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 705190285,
					"content": "哼哼，好好等著看吧。下次你們再來我家的時候，就能享受到不一樣的美味了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190286
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705190286,
					"content": "莫娜買到了理想的物資，鄭重道謝後，與菲謝爾和奧茲心滿意足地離去了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190287
					]
				},
				{
					"id": 705190287,
					"content": "嘿嘿，「西風呼呼義賣鋪」獲得了第一筆收入！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190288,
						705190289
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190288,
					"content": "雖然營收不算多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190290,
					"content": "沒錯呢！看見客人買到了喜歡的商品，我也跟著高興起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190291
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190291,
					"content": "原來出售別人需要的商品是這種感覺啊，當店主也很有意思嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190292
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190292,
					"content": "#好了，{NICKNAME}，我們就一鼓作氣，打響這間店鋪的名號吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705190289,
					"content": "但意義相當重大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190255,
					"content": "收斂點啊，皇女殿下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190256
					]
				},
				{
					"id": 705190256,
					"content": "欸、欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705190243,
					"content": "專注力讓人羡慕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190211,
					"content": "還需要我們做些什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190212
					]
				},
				{
					"id": 705190212,
					"content": "喂，不要無視我取的名字呀？至少也點一下頭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "派蒙"
				}
			]
		},
