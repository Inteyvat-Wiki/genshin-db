			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#哦！這不是{NICKNAME}嘛，來得正好，坐下喝兩杯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080102,
					"content": "#能在這裡見到{F#妳}{M#你}，真叫人高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080103,
					"content": "兩位怎麼會來這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "等等，妳們倆該不會是結伴來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080105,
					"content": "這位大人心血來潮說要好好休個假，就決定來這一帶旅遊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080106,
					"content": "不過嘛，我倆對旅遊的理解好像不太一樣。山都沒上幾座，就到這裡歇腳了，真是富貴病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080107,
					"content": "這話說的，真叫人難過。我可是投妳所好，特意挑了能喝酒的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080108,
					"content": "只可惜大船長見多識廣，對這座小酒館意見頗多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080109,
					"content": "好吧，這頓我請，行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080110,
					"content": "北斗要請客？那我們有份嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080111,
					"content": "派蒙，我們是酒保啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "對哦，習慣性蹭上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705080113,
					"content": "兩位貴客，喝點什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "給我來一杯小杯樺樹吧，最好能酸一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080115,
					"content": "大杯的暮色，謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080116,
					"content": "明白了，請稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
