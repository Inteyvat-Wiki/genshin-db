					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "馬上就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "您拍好畫片之後，就請拿來給我吧！",
					"roleType": "TALK_ROLE_NPC",
