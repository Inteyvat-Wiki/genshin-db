			"dialogs": [
				{
					"id": 741270301,
					"content": "這就是楓丹科學院的「學術會堂」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270302,
					"content": "我承認，這棟建築看起來的確滿像「會堂」的，但學術在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270303,
					"content": "學術在研究員們的腦子裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "好吧，幸好我今天不是為了學術而來的。無論如何，這棟建築看起來還滿…完整的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270306,
					"content": "也只剩下完整了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "咳！來吧，我們去周圍逛逛，我覺得這裡一定很適合來一張合影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270308,
					"content": "我要先去找個好角度，免得到時候洛耶茨先生問起來，我又手忙腳亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}，請您也幫我去拍幾張畫片吧！我聽說您很擅長留影，一定拍得比我好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270310,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "反正絕對不在這些石頭裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
