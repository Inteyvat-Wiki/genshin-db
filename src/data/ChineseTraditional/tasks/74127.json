					},
					{
						"sceneId": 3,
						"position": [
							4754.352,
							530.368,
							4283.871
						],
						"pointId": 6038
					}
				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "…就像我之前強調的那樣，親愛的複律官。規定如此，我也沒有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270102,
					"content": "洛耶茨先生的確已經將所需文件的清單寄來了，我也已經準備好那些文件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270103,
					"content": "但是，你不能就這樣走過來「取走文件」，這並不符合寄送信函的規定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270104,
					"content": "欸？艾尤恩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "你好呀，艾尤恩！看起來你狀態不錯嘛！嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270108,
					"content": "您好，這都是多虧了洛耶茨先生和瑟米安先生的幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270109,
					"content": "#咦？艾尤恩，你認識{NICKNAME}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270110,
					"content": "#當然！{NICKNAME}之前幫了我很大的忙，要是少了{M#他}{F#她}，我絕對不會繼續在複律庭工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270111,
					"content": "#竟然還有這種事？{NICKNAME}不愧是我們楓丹科學院的榮譽高級研究員啊，哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270112,
					"content": "我很擅長提供精神上的幫助的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "無論如何，要是當初沒有您的幫忙，我絕對…絕對沒辦法撐下去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270115,
					"content": "我剛才聽舒瓦瑟爾先生說，您是楓丹科學院的「榮譽高級研究員」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270116,
					"content": "對呀！我還有獎狀呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "還拍了畫片呢！畫片裡還有我，可惜我沒有獎狀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270118,
					"content": "#沒錯，為了表彰{NICKNAME}之前所作出的功績，本院已授予了{M#他}{F#她}榮譽高級研究員稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270119,
					"content": "#至於這個「功績」是什麼…就讓{NICKNAME}自己告訴你吧！我們還是繼續談正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270120,
					"content": "那份文件我的確無法現在就交給你，艾尤恩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270121,
					"content": "但你之前說想要請一位研究員為你帶路，去楓丹科學院附近留影…這件事毫無問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270122,
					"content": "#我認為{NICKNAME}非常適合，{M#他}{F#她}對這周圍的地形再熟悉不過了，一定能勝任這份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270123,
					"content": "#您怎麼說？{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270124,
					"content": "沒問題，交給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "您真好心，有您同行我就放心了。我來的時候看見這周圍又是失控的機關、又是魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270127,
					"content": "但留影這件事並不是重點…說真的，舒瓦瑟爾先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270128,
					"content": "艾尤恩，我也想幫你，但規定如此我也是心有餘而力不足啊！你就不要為難我這個只會蓋章的事務官了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270129,
					"content": "好吧，好吧…我回去和洛耶茨先生再商量一下這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270130,
					"content": "再見，舒瓦瑟爾先生，祝您有愉快的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270131,
					"content": "謝謝你，也祝你在楓丹科學院裡過得愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "舒瓦瑟爾"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}，那麼帶路的事就拜託您了，我們先去「瑪麗安紀念公園」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270125,
					"content": "很高興能幫上艾尤恩的忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "我只是修了一下自動蓋章機啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "那等會我帶著你再飛過來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}！我真高興能在這裡見到{F#妳}{M#你}，真是太巧了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "艾尤恩"
				}
			]
		},
