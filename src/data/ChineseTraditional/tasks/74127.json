					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "呃…這裡就是「瑪麗安紀念公園」嗎？完全看不出來有公園的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270202,
					"content": "洛耶茨先生絕對要失望了，他還打算請人來這裡辦個演講呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270203,
					"content": "看看這個環境，演講應該是辦不成了…而且連代表性建築都沒有，合影也合不成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270204,
					"content": "可以抓點機關回去當紀念品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "哈哈哈，您真幽默，但複律庭裡是沒有地方放這種東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270206,
					"content": "而且就算抓回去了，我還要把這個機關拿去估價、備案、分類，然後再封存…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270207,
					"content": "喂！我們只是開個玩笑，不要突然這麼認真地開始思考工作的事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270208,
					"content": "說起備案…我還是沒把那份文件拿到手，洛耶茨先生一定又要嘆氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270209,
					"content": "舒瓦瑟爾為難你了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "也說不上是為難，我…我的請求的確有點違反規定，他不答應是很正常的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270212,
					"content": "事情是這樣的，楓丹科學院不是正在籌劃重建工作嗎？一些物資和人員的調度需要經由複律庭來溝通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270213,
					"content": "複律庭很重視這件事，於是就讓洛耶茨先生組成一支考察隊，準備來科學院附近實地考察一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270214,
					"content": "於是，洛耶茨先生留在複律庭裡統計人員，我則來科學院協調接待事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270215,
					"content": "正好科學院要寄一份信函回複律庭，我就想著，既然我都來這邊了，就順便把信帶回去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270216,
					"content": "但舒瓦瑟爾先生卻說這種行為不符合規定，怎麼樣都不給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270217,
					"content": "不符合規定？又是不符合哪一條規定呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270218,
					"content": "拿個文件都有規定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "嗚哇！難道又是那些跑來跑去蓋章、到處簽字，最後聽人囉哩囉嗦之類的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270220,
					"content": "簡單來說，複律庭內大部分的公務信函往來，都必須要使用「信件投遞」的模式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270221,
					"content": "欸？那…那假如要寄信的部門只隔著一條街，或者根本就在正對面呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270222,
					"content": "…那也要用信件投遞。這是為了保證複律庭內所有公務信函的「可追溯性」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270223,
					"content": "他們真是不嫌麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "我在猜，大家應該已經習慣麻煩了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270225,
					"content": "算了，先不說這些，我們去下一個地方吧！讓我看看洛耶茨先生寫給我的備忘錄…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270226,
					"content": "這個地方叫…楓丹科學院的「學術會堂」。真奇怪，我來的時候沒有看到掛著這個牌子的建築啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270227,
					"content": "我知道在哪，你跟著我走吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "您真是可靠！一如既往地可靠，沒有您我要怎麼工作呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270229,
					"content": "那我們就快點出發吧！說不定這周圍還有更多失控的機關呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270211,
					"content": "你和舒瓦瑟爾討論了什麼啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
