			"dialogs": [
				{
					"id": 207400401,
					"content": "關於那些花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "#{F#妳}{M#你}採到那些花了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400403,
					"content": "都採到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "#都是很新鮮的花…謝謝{F#妳}{M#你}，這些花擺在店外，一定能吸引到很多客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400405,
					"content": "然後，我還有一個小小的請求…風刮起來的時候，店裡的蒲公英也都被吹走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400406,
					"content": "雖然蒲公英籽被風帶走不是件壞事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400407,
					"content": "但是蒙德城的花店裡沒有蒲公英，感覺還是有點說不過去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400408,
					"content": "蒲公英就不能直接摘掉帶回來了，要從頭種起才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400409,
					"content": "#所以，能拜託{F#妳}{M#你}幫我去找一份蒲公英籽回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400410,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "#那就拜託{F#妳}{M#你}啦，在蒙德城外，我記得就有很多蒲公英。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 207400412,
					"content": "到哪裡採？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "蒙德城外就有很多蒲公英，很容易就能採到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
