			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"黛安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "歡迎光臨「貓尾酒館」的店鋪！兩位有什麼想買的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220202,
					"content": "妳好啊，黛安小姐，我們幫妳帶來了一筆大生意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220203,
					"content": "向黛安說明了曲清的採購需求。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "哦？璃月北碼頭新開的那間小店？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220205,
					"content": "荊夫港來的水手們提到過那位店長呢，瑪格麗特老闆好像也從她那裡採購過原料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220206,
					"content": "最近，曲清小姐在碼頭向水手們出售解渴的飲品時，也會拜託水手們宣傳輕策莊的山泉水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220207,
					"content": "她從輕策莊高價取水，轉賣到有需求的地方，只賺取個人勞動的基本費用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220208,
					"content": "有她在中間牽線，外地的人能用輕策莊的泉水釀出風味獨特的酒，輕策莊的老人們也能獲得不少收入，可謂一舉兩得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220209,
					"content": "原來還有這種隱情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "曲清小姐原來是這樣的好人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220211,
					"content": "嗯，也許以後貓尾酒館會和她長期合作哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "黛安"
				},
				{
					"id": 705220212,
					"content": "#好了，言歸正傳，{F#妳}{M#你}們要買這麼多「薄荷莓果」，打算出多少錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黛安"
				}
			]
		},
