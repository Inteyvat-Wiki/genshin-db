			"dialogs": [
				{
					"id": 705220301,
					"content": "曲清小姐，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220302,
					"content": "妳需要的飲品已經下單了，明天就會裝船，盡快送到碼頭這邊來！請妳拿好這份單據！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220303,
					"content": "#這就談好了？{F#妳}{M#你}們辦事的效率未免也太高了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220304,
					"content": "#我我我，我這就用最好的山泉水泡一壺茶給{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220305,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "對哦對哦，我們還要去幫其他人訂貨，就不麻煩妳招待我們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220308,
					"content": "祝妳生意順利！下次我們再來妳這裡享受好喝的飲料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220309,
					"content": "#嗚…那下次我一定會準備{F#妳}{M#你}們喜歡的飲品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220310,
					"content": "一定要常來玩啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220306,
					"content": "我們也收了辛苦費。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
