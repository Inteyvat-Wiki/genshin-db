					"曲清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "#訂單的事就辛苦{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220402,
					"content": "有了這一批特色飲品，水手們就能換著口味解渴解乏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220403,
					"content": "口味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "水手們的喜好各不相同，有人喜歡清淡的茶水，有人想要酸酸甜甜的果汁…總是喝同一種飲品，時間長了也會膩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220405,
					"content": "所以我經常向店裡補充不同口味的飲品，想盡量滿足水手們的需要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220406,
					"content": "關於店鋪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "因為水手們幫過我一個大忙，我最近才在碼頭這邊開店，為水手們提供飲品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220408,
					"content": "不過我還不太熟練，店裡的生意不太行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220409,
					"content": "晚點見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "#再見！祝{F#妳}{M#你}們一路順風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				}
			]
		},
