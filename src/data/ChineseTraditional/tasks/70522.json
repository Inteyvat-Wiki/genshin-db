				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曲清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "歡迎光臨，兩位客人想喝點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220102,
					"content": "#唔…看{F#妳}{M#你}們的裝束，好像不是本地人？不知道我這裡的茶飲合不合{F#妳}{M#你}們的口味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220103,
					"content": "#我先給{F#妳}{M#你}們泡一壺雲來白毫吧，如果{F#妳}{M#你}們不習慣，可以過段時間再來，到時我應該能託人在蒙德的佳釀節上採購一批特色飲品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220104,
					"content": "謝謝啦，我們不是客人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "對哦，我們是辦事可靠的跑腿人！聽說妳在佳釀節上發布了委託，想請內行的人幫妳訂購飲品，所以我們就找過來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220107,
					"content": "妳想訂購什麼飲品，就儘管和我們說吧，我們幫妳去下單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220108,
					"content": "#為了幫客人們下單…專門跑到璃月來了？{F#妳}{M#你}們真是熱心腸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220109,
					"content": "#我還擔心沒人會接受這麼麻煩的委託呢…那就麻煩{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220110,
					"content": "我聽去過蒙德的水手說，<color=#00E1FFFF>貓尾酒館</color>的特色飲品「薄荷莓果」既解渴又安神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220111,
					"content": "所以我想訂購<color=#00E1FFFF>65箱「薄荷莓果」</color>，和其他飲品交替著賣給水手們。如此一來，他們就能保持好心情和工作效率了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220112,
					"content": "#以前蒙德的商人也會根據我的需要準備指定的等價物。這次我按佳釀節的規矩，提前籌集了一些「佳釀晶凍」，都交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220113,
					"content": "我準備的採購資金是從寬預估的，餘下的部分就是兩位的辛苦費了，雖然這還不足以完全表達我的謝意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220114,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#放心吧，65箱「薄荷莓果」是吧！訂購的事交給我和{NICKNAME}就好，我們已經算是行家啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220117,
					"content": "我們去去就回哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705220115,
					"content": "小事一樁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "我們是幫忙採購飲品的跑腿人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
