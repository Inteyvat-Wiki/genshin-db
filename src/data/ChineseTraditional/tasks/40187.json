						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "危機解除，我們的天權大人怎麼還板著一張臉啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870502,
					"content": "#託胡堂主與{NICKNAME}的福，問題算是圓滿解決了。可危機的原因我們仍尚未知曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870503,
					"content": "船長消息靈通應當知道，最近納塔同樣發生了關乎地脈與生死的大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870504,
					"content": "我在想，其中是否有某種更加隱秘的關聯呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870505,
					"content": "要有那種事，不可能只在璃月與納塔，我會託生意夥伴幫妳留意其他地界的風聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870506,
					"content": "至於現在嘛，我建議妳還是先把心思收回來，別辜負了美景佳節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870507,
					"content": "呵呵，怎麼會？我像是刻晴那種不懂適當休息的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870508,
					"content": "那妳怎麼還戴著這支老釵？我的那份酬勞，不是讓妳去買支新的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870509,
					"content": "不多確認幾次，我怎麼敢動北斗船長的錢？萬一某人心不誠，拿我開玩笑呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870510,
					"content": "哈哈哈哈，妳這女人，非讓我替妳挑嗎？行行，走，跟我一起去街市逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870511,
					"content": "哎呀，北斗船長什麼時候這麼善解人意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870512,
					"content": "哈哈，少說那些，走不走啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870513,
					"content": "有何不可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4018706,
