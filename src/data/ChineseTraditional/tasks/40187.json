					}
				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#那日，妳該陪同{NICKNAME}一起進入邊界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870402,
					"content": "#降魔大聖恐怕是關心則亂。要有什麼事連{NICKNAME}也犯難，我就更派不上用場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870403,
					"content": "況且，是凝光差我去了層岩巨淵，我也分身乏術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870404,
					"content": "降魔大聖若是不滿意，不如改日去玉京臺，告她一狀如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870405,
					"content": "呵，向天權…告天權？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870406,
					"content": "降魔大聖把玉衡星放在哪裡了？她可不怕找誰的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870407,
					"content": "罷了，最後無事便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870408,
					"content": "嗯，望舒客棧真是個好地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870409,
					"content": "整個璃月都是好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870410,
					"content": "哈哈，說的不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870411,
					"content": "店家，再來一份沾露蝦仁，帶辣碟的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870413,
					"content": "還要一份杏仁豆腐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
		{
			"id": 4018705,
