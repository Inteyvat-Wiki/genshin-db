						],
						"pointId": 10624
					}
				]
			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "甘雨，還在忙嗎？辛苦妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870602,
					"content": "#欸？刻晴…沒有啦，我也沒有做什麼了不起的事。這次的問題，全靠{NICKNAME}和胡堂主才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870603,
					"content": "#別妄自菲薄呀，{M#他們}{F#她們}兩個當然是最大的功臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870604,
					"content": "不過我們也沒有辜負大家的信任，總務司反應得很快，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870605,
					"content": "雖然明面上這次的事件不比當初的魔神之災，但若危機爆發出來，後果就很難說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870606,
					"content": "嗯…對了，說起這個，其實我一直有個疑惑。那八門七門的陣法，我在月海亭的資料裡從未見過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870607,
					"content": "哦，妳在想陣法的來歷啊——那是凝光變出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870608,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870609,
					"content": "哈哈，只是說笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870610,
					"content": "那日，撰有此陣法的籙箋是憑空出現在玉京臺的，連夜蘭都沒能查到來歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870611,
					"content": "憑空出現的？那…凝光是不是太過冒險了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870612,
					"content": "看似冒險，但若深想一些，就明白其中的合理之處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870613,
					"content": "放眼璃月，既知危機，又曉秘法，還能在玉京臺避夜蘭耳目、雪中送炭之人…有幾位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870614,
					"content": "啊…難道是師父他們…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870615,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				}
			]
		},
