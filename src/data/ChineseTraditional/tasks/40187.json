					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#嘿！{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870102,
					"content": "香菱！找我們有什麼事呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870103,
					"content": "哈哈，我還能有什麼事？當然就是祭祭五臟廟的事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870104,
					"content": "終於可以吃飯了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "嗯！應該有空吧？不能再推託了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870106,
					"content": "一直沒空的不是我們啊，是胡桃那個傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870107,
					"content": "誰讓她是堂主呢？架子大得很哦！不多來幾個人都約不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870108,
					"content": "#不過{F#妳}{M#你}們放心，這回都說好了，我們逼著她不許找藉口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870109,
					"content": "哦？還有別人出手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870110,
					"content": "#嘿嘿，是行秋啦。他說早想約大家一起聚一聚了，可是{F#妳}{M#你}們也知道他太爺爺的事吧？所以一直不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870111,
					"content": "不過海燈節那晚，行秋太爺爺突然就醒了，別提他有多高興了，這才有機會出來，我們當然一拍即合啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870112,
					"content": "哇！老太公沒事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870113,
					"content": "嗯，大夫都看了，沒一點毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870114,
					"content": "行秋說他太爺爺一醒來就大吃特吃，和派蒙一樣，胃口好得不得了，家人們這會開始擔心，老太公別又撐壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870115,
					"content": "怎麼感覺像我一樣不是什麼好話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870116,
					"content": "當然是好話呀！派蒙的胃口是一種積極的人生態度哦——人生得意須盡吃，莫使金箸空對月呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870117,
					"content": "唉呀，香菱說得真好！我就是帶著這種理念才一步一步走到今天的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870118,
					"content": "有這回事？我怎麼不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "哼哼，就有！人生得意須盡吃，莫使…莫使什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870120,
					"content": "哈哈，小派蒙，把妳的理念留到飯桌上再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870121,
					"content": "嘿嘿，沒問題！那我們在哪裡吃飯呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870122,
					"content": "在遺瓏埠，就今晚，行秋他們都還在那邊呢。對了，胡桃說她還有一位特別嘉賓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870123,
					"content": "哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "#晚上到了{F#妳}{M#你}們就知道了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870125,
					"content": "啊！我大概猜到是誰了，嘿嘿，但是我不說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870126,
					"content": "我也猜到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "#欸？{F#妳}{M#你}猜是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870128,
					"content": "我也不說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "哼，那我們晚上看看誰猜得比較準！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4018703,
