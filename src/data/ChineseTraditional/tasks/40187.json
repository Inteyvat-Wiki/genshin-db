			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雲堇"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "要說誰更厲害的話，我選萬象風角靈官——畢竟他是奇門算術開派祖師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870302,
					"content": "嗯！我也投我祖宗爺爺一票，再加上玄燕仙子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "藍硯"
				},
				{
					"id": 401870303,
					"content": "那我就要選連山二賢了，那些世外高人都是深藏不露的，小說裡都是這樣寫的啦。你說勒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870304,
					"content": "如果是武俠小說，我可能也會這麼選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870305,
					"content": "但很不巧，我讀過《竹林月夜》，所以我認為最強的是桃都三仙裡的白馬仙子，她身上肯定有秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870306,
					"content": "咦？沒人選雲來釣叟嗎？連玉衡大人都說她的劍法來自雲來釣叟的拋竿姿勢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870307,
					"content": "話是這麼講…不過好像少了點排場喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870308,
					"content": "唔…可釣魚客裡出大神，這倒也是事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870309,
					"content": "唉，你們都錯啦！最厲害的當然是無妄姥爺和幽蝶仙子。要是沒有他們，可就沒有今天的往生堂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870310,
					"content": "這樣說也很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870311,
					"content": "唉呀，原來大家都到了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們總算來了。歡迎歡迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870313,
					"content": "呀！胡桃，妳的帽子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870314,
					"content": "這回眼睛很尖嘛，派蒙。是啦，我又做了一根梅枝哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870315,
					"content": "#哦~這下妳和{NICKNAME}的成一對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870316,
					"content": "話說回來，你們在幹什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870317,
					"content": "我們在討論八奇裡誰比較厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "藍硯"
				},
				{
					"id": 401870318,
					"content": "哈哈哈，都是你有你講他有他講而已，不會有結論的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870319,
					"content": "嗯，除非我們有那種輕小說裡的眼鏡，戴上就能看見大家的戰鬥力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870320,
					"content": "哈哈，重雲是被行秋傳染了輕小說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870321,
					"content": "#{NICKNAME}，歡迎{F#妳}{M#你}。我聽家人說{F#妳}{M#你}和胡桃完成了一個很有風險的祭儀，所以太爺爺的病才能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870322,
					"content": "大恩不言謝，今後不論遇到何種麻煩，都歡迎來與我們飛雲商會商量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870323,
					"content": "還有其他人的功勞哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "嗯，我知道，父親和大哥會一一擇日登門拜訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870325,
					"content": "有什麼好謝的啦，行秋。不如你現在就乖乖承認，最厲害的是無妄姥爺和幽蝶仙子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870326,
					"content": "哎呀，別再討論這種沒有結果的事啦！既然大家都到了，我們就快吃飯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870327,
					"content": "派蒙，快，傳授人生理念的時候到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870328,
					"content": "我、我嗎？呃…我想想…好像是人生得意須盡吃，莫使…莫使什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870329,
					"content": "莫使金箸空對月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "哦對對，就是這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870331,
					"content": "哇，派蒙，連人生信條都講得磕磕絆絆地？小心人生也磕磕絆絆喔。加油！喊多一次來聽聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870332,
					"content": "人生得意須盡吃！莫使金箸空對月！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870333,
					"content": "很有精神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "嘿嘿，那我們可以開吃了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870335,
					"content": "派蒙，妳是不是忘了還有一位特別嘉賓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870336,
					"content": "對哦！我想起來了，其實我早就猜到是誰了啦，但是我不說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870337,
					"content": "咦？派蒙的語氣有點心虛呢，其實根本猜不出來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870338,
					"content": "#唉呦，我真的猜出來了，就是那個人…{NICKNAME}，快幫幫我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870339,
					"content": "是雲堇吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "#沒錯！就是我們的好雲堇，看來{F#妳}{M#你}也沒忘記她說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870341,
					"content": "看，雲堇上臺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870342,
					"content": "哇！那不是雲翰社的當家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "利興"
				},
				{
					"id": 401870343,
					"content": "真走運，沒想到雲先生來遺瓏埠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "捷悟"
				},
				{
					"id": 401870344,
					"content": "諸位有禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870345,
					"content": "今夜再唱一曲八奇煉桃都，給幾位錯過海燈節的好友。沒有那晚的舞臺，還請不要見怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870346,
					"content": "#嗚哇！雲堇專門唱給{F#妳}{M#你}們這些錯過的人聽呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401870347,
					"content": "噓！她要開始啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870356,
					"content": "想那桃都狂言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870348,
					"content": "妖嘶嘶怪喧喧樹下吵鬧，有情鬼無緣人唯我令號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870349,
					"content": "離愁界入紅塵怨火焦燎，骨作刀血化馬九霄直搗，爾的野心可笑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870350,
					"content": "補天濟世傳燈火，戈槍劍戟影婆娑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870351,
					"content": "生死陰陽可奈何，你害生肥己種因果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870352,
					"content": "天道中正不多少，貪慾有餘是爾過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870353,
					"content": "萌誓願除魔非是我，共八門刀起桃都落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870354,
					"content": "身前力竭銷魂魄，身後有人代辨清濁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 401870355,
					"content": "折柳灑淚落田陌，來年飛燕銜枝蕩春波。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲堇"
				}
			]
		},
