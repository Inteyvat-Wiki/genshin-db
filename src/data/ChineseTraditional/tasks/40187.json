				]
			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "往生堂那丫頭，真有幾分了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870702,
					"content": "早前只因為帝君在那當什麼客卿，本仙才對她有些興趣，如今方知其中真意啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870703,
					"content": "話雖如此，但能聽見留雲借風這番稱讚，倒是稀奇得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870704,
					"content": "如何稀奇了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870705,
					"content": "若是以往，想必是：「那丫頭雖有兩把刷子，但若換我們申鶴、甘雨，也不差幾分。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 401870706,
					"content": "哼！本仙豈是那種凡事喜歡尊己卑人之輩？那丫頭有此大義，不值得本仙一句稱讚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870707,
					"content": "呵呵呵，當然是值得。我在璃月港住久了，早已知道往生堂這地方，代代有英才啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870708,
					"content": "歌塵說得不錯。昔日那魔神桃都與我等雖非敵，亦非友，若不是他仍心繫眾生，甘願自煉己身，平定幽冥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870709,
					"content": "莫說八奇，就是再來八仙，又奈他何？那之後他身化邊界，不想竟由凡人維護至今，可嘆，可嘆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870710,
					"content": "話說回來，那往生堂小女，姓甚名誰，我倒還不知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 401870711,
					"content": "堂主姓胡，名桃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870712,
					"content": "蝴蝶的蝴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870713,
					"content": "胡鬧的胡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870714,
					"content": "淘氣的淘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870715,
					"content": "桃都的桃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870716,
					"content": "哦，蝴蝶的蝴，桃都的桃，好名字，人如其名的好名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 401870717,
					"content": "是胡鬧的胡，胡攪蠻纏、胡吃海喝的胡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870718,
					"content": "妳看妳，我不就是活躍一下氣氛嗎？怎麼？她胡鬧得，我胡鬧不得？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 401870719,
					"content": "哦？你幾時改的名號啊？胡山胡水真君？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "閒雲"
				},
				{
					"id": 401870720,
					"content": "呵呵，還是來喝茶吧，這是帝君從輕策帶回的鬼山靈芽，頗為罕見，莫要錯了時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870721,
					"content": "希望來年也有好茶喝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 401870722,
					"content": "嗯，會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
