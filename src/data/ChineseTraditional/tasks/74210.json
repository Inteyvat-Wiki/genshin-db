			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷蒙多",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "您有什麼想問的話，榮譽高級研究員？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361202,
					"content": "關於納克和艾德溫的處理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "他們會暫時待在梅洛彼得堡裡，為他們所犯下的罪行悔過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361204,
					"content": "當然，以艾德溫的個性來說，大概是不會做「悔過」這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361205,
					"content": "但無論如何，只要能讓艾德溫遠離研究器材和始基礦就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361206,
					"content": "至於納克…我想他不會再給我們添麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361207,
					"content": "唉！希望我不要遇見那種…非他們不可的事務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361208,
					"content": "菲希里耶之前很崇拜艾德溫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "…艾德溫·伊斯丁豪斯先生是一個天才。和他在同一個領域工作的人要嘛自暴自棄，要嘛就是成為他的信徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361210,
					"content": "菲希里耶小姐是一位非常有熱情和創意的研究員，經常用很低的成本做出精彩的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361211,
					"content": "在加入始基礦研究專案團隊的第三技術組後，她負責抑制器的結構設計工作，和艾德溫的接觸次數很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361212,
					"content": "也許就是那個時候成為了艾德溫的信徒吧？和其他的信徒一樣，艾德溫的認可是她唯一的追求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361213,
					"content": "在爆炸後，她不願意相信艾德溫是爆炸的肇事者，主動申請參與調查來試圖為艾德溫翻案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361214,
					"content": "#{F#妳}{M#你}也和艾德溫打過交道了，對他感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361215,
					"content": "是個除了研究之外什麼都不管的怪人！就只會推卸責任，而且連菲希里耶小姐的名字都記不住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361216,
					"content": "沒錯，他就是這樣的人。除了手上的研究之外，幾乎沒有任何東西和人值得他注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361217,
					"content": "只要研究順利，他也幾乎不會管其他任何事務，就連他手下的研究員偷偷倒賣研究資產也毫不關心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361218,
					"content": "我之所以答應菲希里耶參與調查…只是希望她能早日明白，自己所追逐的是一個由她自己想像出來的幻影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361219,
					"content": "現在幻影終於破滅了，希望她能早日振作起來…楓丹科學院不能再失去任何研究員了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 741361220,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "再見，榮譽高級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
