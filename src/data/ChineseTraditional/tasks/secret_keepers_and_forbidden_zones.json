			"dialogs": [
				{
					"id": 40090901,
					"content": "到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090902
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090902,
					"content": "公爵！您來得正好，最新一次試做的資料已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090903
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090903,
					"content": "等等朱里厄，有別的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090904
					],
					"speakerTitle": "露爾薇"
				},
				{
					"id": 40090904,
					"content": "咦？朱里厄和露爾薇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090905,
					"content": "不用緊張，這兩位已經知道我們的計畫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090906
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090906,
					"content": "什麼？虧您還說不能向任何人透露我們的計畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090907
					],
					"speakerTitle": "露爾薇"
				},
				{
					"id": 40090907,
					"content": "#我也抱有同樣的疑問。您確定{F#她}{M#他}們可信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090908
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090908,
					"content": "你已經看到結果了不是嗎？這兩位知道的事可能比你們想的還多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090909
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090909,
					"content": "…好吧，如果您堅持的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090910
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090910,
					"content": "#我從{F#她}{M#他}們身上感覺不到惡意…應該是可信的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090911
					],
					"speakerTitle": "露爾薇"
				},
				{
					"id": 40090911,
					"content": "#重新介紹一下，這位是朱里厄，楓丹科學院最高級研究人才之一，曾在艾德溫手下工作。{F#妳}{M#你}們知道艾德溫吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090912,
						40090914
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090912,
					"content": "知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090913
					]
				},
				{
					"id": 40090913,
					"content": "很好，省去了解釋的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090916,
					"content": "艾德溫主攻的研究方向是始基礦和重力儀，朱里厄作為助手，也瞭解相關技術。我聘請他擔任我的技術顧問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090917
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090917,
					"content": "你…你要把梅洛彼得堡炸上天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090918,
					"content": "啊，這句話很美妙。我開始想像了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090919
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090919,
					"content": "我也有點心動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090920
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090920,
					"content": "先生們，注意分寸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090921
					],
					"speakerTitle": "露爾薇"
				},
				{
					"id": 40090921,
					"content": "正直的露爾薇小姐同樣是我請來的技術顧問，很巧，朱里厄以前是艾德溫的助手，而她以前是朱里厄的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090922
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090922,
					"content": "還能這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090923,
					"content": "有什麼必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090924
					]
				},
				{
					"id": 40090924,
					"content": "你看，大家都這麼問。你們其實是藉職務之便談戀愛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090925
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090925,
					"content": "什…公爵，我們沒在談戀愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090926
					],
					"speakerTitle": "露爾薇"
				},
				{
					"id": 40090926,
					"content": "除非我瘋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090927
					],
					"speakerTitle": "朱里厄"
				},
				{
					"id": 40090927,
					"content": "噢，當我沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090928
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090928,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090929
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090929,
					"content": "哇，又是一扇會升起來的門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090930,
					"content": "妳這樣稱讚會讓我對梅洛彼得堡產生不必要的自信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090931
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090931,
					"content": "嘿嘿…我是真的覺得很厲害嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090932,
					"content": "普通的房間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090933
					]
				},
				{
					"id": 40090933,
					"content": "再來一點小把戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090934
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090934,
					"content": "請看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090935
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090935,
					"content": "這是…？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090936
					]
				},
				{
					"id": 40090936,
					"content": "這麼大的…船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090937,
					"content": "而且這裡是沒見過的工廠區…這是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090938,
					"content": "#不知道{F#妳}{M#你}們對楓丹歷史瞭解多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090939
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090939,
					"content": "呃…瞭解得很少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090940,
					"content": "#那{F#妳}{M#你}們或許還不知道雷穆利亞的故事。簡單來說，古代楓丹受雷穆利亞王朝統治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090941
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090941,
					"content": "傳說雷穆利亞的帝王雷穆斯受天啟感召而來，尋到化身為金蜂的先知西比爾。帶著金蜂與大船法圖納號，在海上建立自己的國家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090942
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090942,
					"content": "他以雷穆利亞稱呼這個國家，並靠法圖納號繼續不斷尋找新的島嶼和部落，號召他們歸入帝國統治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090943
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090943,
					"content": "這個故事裡也有船…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090944
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090944,
					"content": "與水有關的地方總會有船。人們相信船能帶領大家找到希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090945
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090945,
					"content": "你也信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090946,
					"content": "我的話，半信半疑。但妳也看到了，我擁有一整座工廠的原料、技術和人力，試一試沒什麼不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090947
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090947,
					"content": "所以，第一次猜想那扇閘門下可能是胎海時，我就想到要做這件事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090948
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090948,
					"content": "是傳說中的法圖納號啟發了你嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090949
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090949,
					"content": "天災在即，楓丹人需要這樣的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090950,
						40090951
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090950,
					"content": "這是一個偉大的計畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090952,
					"content": "如果讓這裡的犯人知道大船背後我們要面臨的災難，那在真正的災難到來前，暴亂會先毀掉梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090953
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090953,
					"content": "身為管理者，我不能認可這種莽撞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090954
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090954,
					"content": "#好了，我說得夠多了，需要再喝三杯茶。{F#妳}{M#你}們還有什麼疑問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090955
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090955,
					"content": "#看來沒有了。那請吧，我送{F#妳}{M#你}們回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090951,
					"content": "為什麼要偷偷進行？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090914,
					"content": "不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090915
					]
				},
				{
					"id": 40090915,
					"content": "#艾德溫，就是炸飛了整個楓丹科學院的傢伙。他是公認的腦袋有問題，不過{F#妳}{M#你}不是在地人，不知道也不是很稀奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "朱里厄"
				}
			]
		},
