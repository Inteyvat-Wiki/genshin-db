			},
			"dialogs": [
				{
					"id": 40091201,
					"content": "#就送{F#妳}{M#你}們到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091202
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40091202,
					"content": "噢！呃…謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40091203,
					"content": "#別客氣。不過記住了，要不要將資訊分享出去取決於{F#妳}{M#你}。{F#妳}{M#你}的舉動很可能影響那幾個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091204
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40091204,
					"content": "（他的意思是，我是否說出梅洛彼得堡的秘密，將直接決定林尼他們的下一步行動。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091205
					]
				},
				{
					"id": 40091205,
					"content": "（…也就是說，如果我要將真相告訴林尼，就必須讓他明白現在不能有太多紛爭。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091206
					]
				},
				{
					"id": 40091206,
					"content": "我們會認真考慮的，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40091207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40091207,
					"content": "嗯，會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40091208
					]
				},
				{
					"id": 40091208,
					"content": "好，容我期待之後的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				}
			]
		}
	]
