			"dialogs": [
				{
					"id": 40090601,
					"content": "這裡就是「禁區」？藏得那麼隱蔽，進來一看沒什麼特別的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090602,
					"content": "那是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090603
					]
				},
				{
					"id": 40090603,
					"content": "門好大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090604,
					"content": "類似的隔離門總共有三道，通常來說沒人能進入門內，除了我。顧名思義，「禁區」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090605
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090605,
					"content": "#不過{F#妳}{M#你}們一定會把資訊分享給愚人眾那幾位對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090606
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090606,
					"content": "的確沒想過要瞞著他們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090607,
					"content": "#哈哈，該不該這麼做，還是等{F#妳}{M#你}們看完再決定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				}
			]
		},
