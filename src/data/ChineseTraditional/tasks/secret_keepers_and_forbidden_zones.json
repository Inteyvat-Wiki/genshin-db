			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲米尼",
					"琳妮特",
					"林尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 40090101,
					"content": "林尼…呃，對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090102,
					"content": "我也很抱歉，哥哥。我應該更謹慎一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090103
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090103,
					"content": "別說這種話。都是我的錯…該謹慎的人是我。你們差點就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090104
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090104,
					"content": "如果我實力更強一點，也許現在已經找到「公子」大人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090105,
					"content": "不對，你怎麼能這麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090106
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090106,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090107,
					"content": "…抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090108
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090108,
					"content": "也就是說，我們都不夠謹慎，對嗎？共同責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090109
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090109,
					"content": "啊，對！共同責任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40090110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090111
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40090111,
					"content": "哥哥，你擔心我們，我們也擔心現在的你。不要露出這種表情…請你打起精神來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090112
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40090112,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
