			"dialogs": [
				{
					"id": 40090201,
					"content": "打擾了喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090202
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090202,
					"content": "看來菲米尼先生情況穩定下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090203
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090203,
					"content": "當然，否則我不會離開醫務室的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090204
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090204,
					"content": "那兩位過來很正常，但護士長是有何貴幹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090205
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090205,
					"content": "我來看看克洛琳德小姐。妳感覺還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090206
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090206,
					"content": "嗯，沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090207
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 40090207,
					"content": "可以的話，我想幫妳再做個檢查，很快的，請給我幾分鐘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090208
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40090208,
					"content": "好吧，謝謝。那我就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090209
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 40090209,
					"content": "該向我們解釋了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090210,
					"content": "哈哈，解釋，我不太喜歡這個說法。「說明」如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090211
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090211,
					"content": "願聞其詳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090212
					]
				},
				{
					"id": 40090212,
					"content": "#不過要從哪裡說起呢？煩請{F#妳}{M#你}們提問吧，從最想知道答案的問題開始好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090213
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090213,
					"content": "唔…那我問了哦，你從一開始就知道林尼他們的目的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090214,
					"content": "#不，我只知道他們隸屬愚人眾，受「僕人」命令進入梅洛彼得堡，具體目的嘛，隨著{F#妳}{M#你}們行動推進才查清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090215
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090215,
					"content": "都不知道目的，卻能仔細地防著他們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090216,
					"content": "他們來意不善，我很擅長分辨這類信號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090217
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090217,
					"content": "為什麼不阻止他們的行動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090218
					]
				},
				{
					"id": 40090218,
					"content": "一開始，我認為他們的目的是查清「公子」為什麼失蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090219
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090219,
					"content": "林尼猜測是我故意放走他，實際上，我們並沒有特意阻攔或是縱容他的行為。他只是就那樣自然地找到幫手，自然地離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090220
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090220,
					"content": "至冬執行官在楓丹境內失蹤，這件事一定會被「僕人」拿來大做文章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090221
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090221,
					"content": "我也有點好奇這位執行官去了哪裡，反正一樣要查，就讓愚人眾自己的人來查吧。我只等結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090222
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090222,
					"content": "你想坐收漁翁之利啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090223,
					"content": "#有什麼不可以的呢？可惜，後來情況有變，菲米尼應該告訴{F#妳}{M#你}了，梅洛彼得堡周圍的海水正在變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090224
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090224,
					"content": "#「禁區」一直是林尼的調查目標，{F#妳}{M#你}來了之後也被牽扯其中。為了{F#妳}{M#你}們的安全，也為了不讓梅洛彼得堡惹上更多麻煩事，我開始著手干涉{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090225
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090225,
					"content": "傳聞是真的嗎？你以前真的是罪犯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090226,
					"content": "什麼話？都當梅洛彼得堡的管理者了，天天待在這裡，不就是變相坐牢嗎？只是這裡的人比較服我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090227
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090227,
					"content": "對了，誰找克洛琳德來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090228,
					"content": "當然是我。我花錢請她來梅洛彼得堡出外勤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090229
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090229,
					"content": "克洛琳德小姐是決鬥代理人，相當於第三方勢力。我需要請一個實力超群的幫手應對接下來的危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090230
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090230,
					"content": "比如救起菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090231,
					"content": "妳就這麼理解好了。那位先生確實是個好手，要是條件不那麼苛刻，他可能已經追上失蹤的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090232,
						40090233
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090232,
					"content": "「禁區」真實存在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				},
				{
					"id": 40090234,
					"content": "#這不是{F#妳}{M#你}該打聽的事，那維萊特委託{F#妳}{M#你}的工作也只是探查「公子」的去向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090235
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090235,
					"content": "#我只需向{F#妳}{M#你}證明「禁區」與公子的失蹤無關，這一點上菲米尼就是人證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090236
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090236,
					"content": "可是，我們都查到醫務室了，你剛才也問了一堆事…反而是我們問的最後一個問題你還沒回答呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090237,
					"content": "#噢，說得我都不好意思了。{F#妳}{M#你}們真的那麼想知道答案啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090238
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090238,
					"content": "對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40090239,
					"content": "#哪怕說出真相也未必能讓{F#妳}{M#你}高興？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090240
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090240,
					"content": "…是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090241
					]
				},
				{
					"id": 40090241,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 40090233,
					"content": "裡面有什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090234
					]
				}
			]
		},
