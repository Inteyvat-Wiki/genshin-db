			"dialogs": [
				{
					"id": 401181001,
					"content": "真想和「軍師」姐姐一起呼呼——地坐飛車呀！可是，她好像會暈倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401181002,
					"content": "可莉真敏銳啊，一定是從「軍師」姐姐眼睛裡看到了旋轉的星星吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401181003,
					"content": "今天的少了一點哦！昨天有很多很多金色的星星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401181004,
					"content": "媽媽要是在的話，可能會說這些星星全是掉進雲朵的魚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		},
