			"dialogs": [
				{
					"id": 752330801,
					"content": "嗯，很不錯！這位正在見習的演員同學，說說妳的感想吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330802
					],
					"speakerTitle": "約娜"
				},
				{
					"id": 752330802,
					"content": "好、好棒！度假村的那套真的有悠悠度假村的感覺！海洋的那套，也真的很有海洋的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330803
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330803,
					"content": "妳這感想還真的滿直白的…總而言之，就是根據主題聯想關鍵字，比如度假可能聯想到休閒，海灘則會聯想到炎熱，明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330804
					],
					"speakerTitle": "約娜"
				},
				{
					"id": 752330804,
					"content": "完全明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330805
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330805,
					"content": "別急，先實踐一下看看結果…這次就嘗試一個常見的關鍵字吧。唔，「簡約」如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330806
					],
					"speakerTitle": "約娜"
				},
				{
					"id": 752330806,
					"content": "「簡約」，嗯就是簡單的意思吧？說到簡單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330807
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330807,
					"content": "哦？「希頓」的目光銳利起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330808,
					"content": "我知道了！簡約就是簡單，簡單的極致就是無！就是拋棄一切不必要的要素！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330809
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330809,
					"content": "#糟糕，{NICKNAME}，我有些不好的預感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330810,
					"content": "喝哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330811
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330811,
					"content": "我就知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330812,
					"content": "怎麼樣、怎麼樣？老師，果然，沒有任何配飾就是對演出服最好的裝飾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330813
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330813,
					"content": "我…嗯…妳…啊，那個…算了，或許皮皮潘演員都是這樣的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330814
					],
					"speakerTitle": "約娜"
				},
				{
					"id": 752330814,
					"content": "說不定有問題的真的是我，我放棄了，妳、妳合格了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330815
					],
					"speakerTitle": "約娜"
				},
				{
					"id": 752330815,
					"content": "我、我好像可以理解妳的感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
