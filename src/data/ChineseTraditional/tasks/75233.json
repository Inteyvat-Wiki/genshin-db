							14271.43
						],
						"pointId": 12079
					}
				]
			},
			"dialogs": [
				{
					"id": 752330101,
					"content": "#「承、承載綻放刺梨的奇蹟，用聖火點燃{F#妳}{M#你}的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330102
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330102,
					"content": "嗚、嗚哇！怪物啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330103,
					"content": "#「以悠悠度假村之名，為{F#妳}{M#你}獻上歡迎的舞蹈，閃耀吧！皮皮潘偶像！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330104
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330104,
					"content": "#要、要打過來了！{NICKNAME}，救、救命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330105,
					"content": "啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330106
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330106,
					"content": "咦，它怎麼自己摔倒了…喂，怪怪的傢伙，妳好嗎…有、有沒有摔到哪裡啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330107,
					"content": "又、又失敗了，我果然還是跳不好這個舞，好羞恥…啊——好想原地消失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330108
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330108,
					"content": "那個…原、原來妳剛才是在跳舞嗎？不然妳再跳一次試試看？這次說不定會有好結果呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330109,
					"content": "不行不行不行，我不行的，我做不到啊…果然，我還是沒有辦法成為皮皮潘偶像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330110
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330110,
					"content": "完了，我現在完全搞不懂它在說什麼了…欸？等一下，這個是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330111,
					"content": "唔——《皮皮潘偶像大賽宣傳冊》？原來皮皮潘偶像是這個意思啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330112,
					"content": "那、那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330113
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330113,
					"content": "哦！我知道了，妳應該是對比賽沒有自信，所以想要找我們給一些建議對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330114,
					"content": "#…我、我不行的，我就連在{F#妳}{M#你}們面前跳舞都做不好，而、而且老爹他也說我不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330115
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330115,
					"content": "老爹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330116,
					"content": "嗯，我的老爹也是演員，也是我的偶像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330117
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330117,
					"content": "老爹他跳舞很厲害的！還教出了很多的優秀演員！只不過…他不願意教我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330118
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330118,
					"content": "啊？為什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330119,
					"content": "他、他說——「『希頓』，我在妳的身上根本沒有看到決心！沒有決心的人是沒辦法跳好舞蹈的！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330120
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330120,
					"content": "為了讓老爹承認我，我跟他打了賭，如果我成為了皮皮潘偶像，證明了自己，他就會對我傾囊相授…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330121
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330121,
					"content": "可、可是，我不僅連歡迎的舞蹈都跳不好，還出了個大醜，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330122
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330122,
					"content": "#別、別哭啦，妳看，妳不是遇到我們了嗎？我和{NICKNAME}可是知名冒險家，走南闖北見得多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330123,
					"content": "有我們的幫助，妳一定可以成為皮皮潘偶像，在老爹面前證明自己的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330124,
					"content": "真、真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330125,
						752330126
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330125,
					"content": "既然派蒙都這麼說了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330129
					]
				},
				{
					"id": 752330129,
					"content": "好啦，打起精神來！是時候出發去獲得參賽資格啦！放心，有我們在，一定會讓妳的老爹對妳刮目相看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330130,
					"content": "#謝、謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330126,
					"content": "噹噹，閃耀吧！皮皮潘偶像！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330127
					]
				},
				{
					"id": 752330127,
					"content": "#求、求求{F#妳}{M#你}，不要再說這句臺詞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330128
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330128,
					"content": "不要再打擊她了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330129
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7523302,
			"completionStepIds": [
				7523309
