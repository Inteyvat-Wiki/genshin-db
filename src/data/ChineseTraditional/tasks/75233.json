			"dialogs": [
				{
					"id": 752330401,
					"content": "你好！請問是奧胡帝亞嗎，我們是來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330402,
					"content": "欸呀呀！對對對，就是我。兩位貴客，歡迎光臨奧胡帝亞旅行社！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330403
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330403,
					"content": "您來得太是時候了，現在五天四夜悠悠度假村雙人行，全程導遊服務，外加全程留影和鰭游龍接送，只需十萬摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330404
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330404,
					"content": "等一下、等一下。我們不是來諮詢旅行套餐的，我們是來接受大賽參賽資格考驗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330405,
					"content": "嘖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330406
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330406,
					"content": "你這態度差距也太明顯了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330407,
					"content": "別在意這些細節，我問妳，年輕的皮皮潘，妳認為身為偶像最重要的是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330408
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330408,
					"content": "是肌肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330409
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330409,
					"content": "沒錯！就是服務態度！只有永遠為粉絲們提供高品質的服務，哪怕是面對不需要導遊套餐的遊客，也要拼盡全力保持笑容！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330410
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330410,
					"content": "…你自己最好能先做到這點啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330411,
					"content": "#哼，這個小傢伙…能指出我的問題，就表示{F#妳}{M#你}們對服務精神已經有所感悟了！好，那就讓我來深入地考驗{F#妳}{M#你}們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330412
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330412,
					"content": "好、好生硬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330413,
					"content": "面對偶像如何服務粉絲這一問題，我們皮皮潘偶像組委會給出的答案是——合照會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330414
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330414,
					"content": "來來來，跟我來，皮皮潘妳扮演偶像，剩下的兩位來扮演粉絲。就讓我看看妳的服務態度如何吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330415,
						752330416
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330415,
					"content": "終於正常起來了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 752330416,
					"content": "這才像試煉嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
