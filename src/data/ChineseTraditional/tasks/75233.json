			"dialogs": [
				{
					"id": 752330601,
					"content": "啊！痛痛痛！別打了別打了！都說是演戲了，怎麼真的下狠手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330602
					],
					"speakerTitle": "看起來很魁梧的人"
				},
				{
					"id": 752330602,
					"content": "不、不好意思，你們演得太逼真了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330603
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330603,
					"content": "…咳，做得好！妳合格了！真正的偶像就是要全力以赴，只要永遠全力以赴，又何愁服務態度不夠好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330604
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330604,
					"content": "我很感動，皮皮潘偶像就是應該是妳這個樣子的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330605
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330605,
					"content": "我已經有點搞不懂皮皮潘偶像到底是什麼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330606,
					"content": "好！接下來只需要為演員們賠償足夠的醫藥費，就可以獲得我的證明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330607
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330607,
					"content": "我也不騙你們，一個人十萬，一共三十萬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330608
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330608,
					"content": "你們果然還是來騙錢的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330609,
					"content": "如此，方才能被稱為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330610
					],
					"speakerTitle": "奧胡帝亞"
				},
				{
					"id": 752330610,
					"content": "偶像才不是這樣的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330611,
					"content": "經過一番漫長的唇槍舌劍，奧胡帝亞終於心甘情願地自掏腰包，為演員們付了醫藥費，並將證明交給我們。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
