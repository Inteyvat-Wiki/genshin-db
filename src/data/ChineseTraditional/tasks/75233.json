			"dialogs": [
				{
					"id": 752330201,
					"content": "「承載綻放刺梨的奇蹟，用聖火點燃你的笑容！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330202
					],
					"speakerTitle": "練習中的演員"
				},
				{
					"id": 752330202,
					"content": "說了多少次了，喊口號的時候聲音要洪亮！是點燃笑容！要有熱情懂嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330203
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330203,
					"content": "保持住這個姿勢，收緊你的腰腹，別把腿放下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330204
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330204,
					"content": "那、那個，老、老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330205
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330205,
					"content": "哦？竟然是妳？好！給我站到舞臺上面去！現在就去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330206
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330206,
					"content": "嗚哇！好、好凶的人，「希頓」真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330207,
					"content": "先靜觀其變。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752330208
					]
				},
				{
					"id": 752330208,
					"content": "告訴我，偶像最重要的是什麼？對！是肌肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330209
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330209,
					"content": "只有強健的肌肉才能跳好舞蹈，只有強健的肌肉才能打敗所有的競爭對手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330210
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330210,
					"content": "這、這是哪裡的偶像啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330211,
					"content": "記好了，偶像即戰爭，只有強者才能生存。偶像之路可是很殘酷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330212
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330212,
					"content": "欸，不是也有那種，用溫柔的笑容治癒大家的偶像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752330213,
					"content": "#大錯特錯，那只會讓喜愛偶像的人變得軟弱…真正的偶像之力可是用肌肉鑄就的。起舞吧！讓我看看{F#妳}{M#你}們的偶像之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330214
					],
					"speakerTitle": "「坎帕」"
				},
				{
					"id": 752330214,
					"content": "我…我真的可以嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752330215
					],
					"speakerTitle": "「希頓」"
				},
				{
					"id": 752330215,
					"content": "#沒事的，妳放心跳就好啦！我和{NICKNAME}，會在一旁支援妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
