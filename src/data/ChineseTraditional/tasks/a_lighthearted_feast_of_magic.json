			"dialogs": [
				{
					"id": 756750101,
					"content": "嘿！哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750102,
					"content": "我的腦袋已經被音樂佔滿了，跳舞跳舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750103,
					"content": "搖擺搖擺~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "瑟琪"
				},
				{
					"id": 756750104,
					"content": "快快樂樂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "梅內婭"
				},
				{
					"id": 756750105,
					"content": "嗚啊嗚啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "莫烏"
				},
				{
					"id": 756750106,
					"content": "還賺了外快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750107,
					"content": "咦？妳這小妞，什麼時候的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750108,
					"content": "努斯妲小姐忙不過來，我就抽空去支援了她的學徒，清剿了幾個魔物的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750109,
					"content": "在納塔，戰鬥和跳舞一樣盡興，喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750110,
					"content": "真是麻煩妳了，瑪因。我的本意是讓新人們多多鍛煉，沒想到他們還是不能獨立完成那一組任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750111,
					"content": "等我回去後，給他們狠狠加練！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750112,
					"content": "不麻煩，他們也打得很漂亮。只不過之前沒想到，巢穴裡的魔物有預估的七倍罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750113,
					"content": "「花羽會」給的好多，我為愛貝爾買禮物的錢都湊到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750114,
					"content": "但妳的假期時間好像也差不多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750115,
					"content": "再玩幾天，就可以預訂船票琢磨返程的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 756750116,
					"content": "不急，還可以跳舞。小蘿克珊、勒泰利埃、謝妮和弗雷瑞斯最近在搶任務做，我不能和他們搶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 756750117,
					"content": "那就繼續跳舞，繼續開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "瑟琪"
				},
				{
					"id": 756750118,
					"content": "跳累就吃，吃飽就睡，無憂無慮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "梅內婭"
				},
				{
					"id": 756750119,
					"content": "咿啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "莫烏"
				},
				{
					"id": 756750120,
					"content": "美露莘們和小鰭游龍排成一列，向著舞臺蹦蹦跳跳過去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "真是一群可愛的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750122,
					"content": "嘿嘿，妳也很享受嘛，努斯妲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756750123,
					"content": "笑容更輕鬆暢快了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "當真？那以後，每次「舞力聚會」我都非來不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750126,
					"content": "要讓那些見面就叫我大姐——甚至是阿姨的後輩…有一天發現，我的精神面貌比他們都年輕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750127,
					"content": "以後的「舞力聚會」應該以這次為典範，辦得越頻繁越好！成為每個月都有的慣例，都在情理之中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 756750124,
					"content": "好像整個人都年輕了不少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}