			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海芭夏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "既然我們已經到了須彌，接下來的目標就是前往須彌城，想辦法見到「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000102,
					"content": "#說起「小吉祥草王」，我們之前雖然打聽到的消息不多，但她不太像是當年帶走{M#你妹妹}{F#妳哥哥}的那位神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000103,
					"content": "不過，須彌也被稱為「智慧的國度」，如果能見到這位智慧之神，應該能從她那裡獲得一些有價值的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000104,
					"content": "我也這麼覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "不知道須彌城在什麼方向，我們要不爬到七天神像所在的那塊大岩石上看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000106,
					"content": "就算看不見須彌城，至少也能找找附近有沒有村子什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000107,
					"content": "#等等，{F#妳}{M#你}看，前面有行人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000108,
					"content": "太好啦，這下就省了我們到處找路的功夫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000109,
					"content": "妳好——我們是外國來的旅行者，想向妳問個路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000110,
					"content": "難道是沒聽見…喂——前面的行人，不好意思能向妳問個路嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30000112,
					"content": "這到底是怎麼回事啊？她明明聽見我們在叫她，卻對我們不理不睬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000113,
					"content": "別生氣，應該只是個例…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "哼！不過…雖說她不肯理睬我們，但只要我們遠遠跟著她的話，應該就能走到有人煙的地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000116,
					"content": "到時候，我們再向其他人問路好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000114,
					"content": "或許是有什麼原因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海芭夏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "咦，她走到那個小瀑布旁邊不見了，我們也過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000302,
					"content": "還以為這個山洞會是通往村子的入口什麼的，看來是我猜錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000303,
					"content": "#{F#妳}{M#你}看，她在那邊坐下了，該不會她就住在這吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000304,
					"content": "我們現在怎麼辦，要試著再向她問問路嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000305,
					"content": "努力和她溝通一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "嗯，好吧。好不容易才碰到一個行人，哪怕她不太歡迎我們，只要能說服她幫我們指個方向就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000309,
					"content": "嗯…好清新的香味啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000310,
					"content": "是從那個香爐裡傳來的吧。雖說住在這麼簡陋的地方，但能沐浴在芬芳中冥想，似乎也是種不錯的生活呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000311,
					"content": "——！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "#{F#妳}{M#你}怎麼了？突然臉色變得這麼難看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000313,
					"content": "這種香味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "#什麼，香味讓{F#妳}{M#你}感覺不舒服嗎？可是為什麼我什麼感覺也沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000316,
					"content": "（我必須離開這裡！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "（糟糕，我的意識…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#{NICKNAME}，{F#妳}{M#你}怎麼了？振作一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000314,
					"content": "我感覺有點奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "還是不要打擾她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "唔，她那種狀態應該是叫做「冥想」吧。如果我們打斷了她，可能就不是像剛才瞪我們一眼那麼簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "…真的不要緊嗎？可是都已經過了這麼長時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001002,
					"content": "#妳別著急…師父的知識很淵博的，既然說了{M#他}{F#她}沒事，那就肯定不會有什麼問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001003,
					"content": "#啊，{F#妳}{M#你}醒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001004,
					"content": "#{NICKNAME}，太好了，{F#妳}{M#你}總算醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001005,
					"content": "這裡是什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "#這裡是…啊，對哦，之前{F#妳}{M#你}昏迷的時候我太緊張，都忘了問這裡究竟是哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001007,
					"content": "這裡叫「化城郭」，最早是須彌的學者們在雨林中搭建的臨時休息處，現在這裡主要由巡林員駐紮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001008,
					"content": "#{F#妳}{M#你}好，那個…我叫柯萊，是個見習巡林員。今天我和師父在巡視時剛好發現{F#妳}{M#你}暈倒，於是就把{F#妳}{M#你}帶到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001009,
					"content": "謝謝妳的幫助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "#不不，不用謝我，我其實沒做什麼。對了，{F#妳}{M#你}現在感覺怎麼樣，有沒有哪裡不舒服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001011,
					"content": "身體沒有不舒服。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "#哈哈…那是師父調配的湯藥，剛才他在{F#妳}{M#你}昏迷的時候灌了一點給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001014,
					"content": "#啊對了，師父說等{F#妳}{M#你}醒來之後，還要再喝一次才行，我拿藥給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001015,
					"content": "嗚哇…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001016,
					"content": "柯萊，怎麼了？是想拿藥嗎？都說過了，這些妳別亂碰…等一下我來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001017,
					"content": "對不起師父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001018,
					"content": "唉，「道成林食用蕈圖譜」就在公告板上，如果法伯德再記不住，就只能換個地方——貼在他額頭上，讓其他人去提醒他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001019,
					"content": "就是，他這個月都吃壞肚子兩次了，我去好好說說他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "娜絲琳"
				},
				{
					"id": 30001020,
					"content": "但如果他就是喜歡眼前有彩色小人跳舞，剛才的話就算我沒說。不過下次再抓藥給他，就得找他要錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001021,
					"content": "#怎麼樣，{F#妳}{M#你}好些了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001022,
					"content": "這位就是我師父，巡林官提納里先生，也是化城郭所有巡林員的上司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001023,
					"content": "#{F#妳}{M#你}失去意識的原因我之前對派蒙解釋過，既然{F#妳}{M#你}醒了，我就再向{F#妳}{M#你}說明一遍：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001024,
					"content": "須彌有些學派的學者需要在林中修行，他們會藉助一種叫做「靈酚香」的植物薰香穩定心神，進入沉思狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001025,
					"content": "#{F#妳}{M#你}們兩個為了問路，靠近了學者海芭夏隱居的山洞，那時候洞裡就正燃燒著這種薰香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001026,
					"content": "#薰香對大多數人沒有影響，但它的確會刺激極少數人的精神，{F#妳}{M#你}就是這種情況。我解釋清楚了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001027,
					"content": "解釋得很清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "#嗯，那就好。接下來回答個問題：在倒下之後{F#妳}{M#你}有沒有什麼其他的感覺？比如{F#妳}{M#你}還有自我意識嗎？看到了什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001029,
					"content": "描述了在黑暗中見到的景象…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001031,
					"content": "柯萊，妳去通知一下其他人，讓他們先不要把巡查日誌拿到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001032,
					"content": "啊，什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001033,
					"content": "#因為這幾天{M#他們}{F#她們}會暫時住在我的房間，我去阿米爾家擠一擠。照我說的做，快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001034,
					"content": "啊、是，我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30001035,
					"content": "等一下等一下，現在是什麼情況？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001036,
					"content": "#情況是這樣的：原本我以為{F#妳}{M#你}醒後再喝一碗藥就可以走了，但現在我覺得，{F#妳}{M#你}有必要待在化城郭療養觀察一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001037,
					"content": "「療養觀察」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001038,
					"content": "可是我還要去須彌城…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "#{F#妳}{M#你}先別急，{F#妳}{M#你}只要是個明辨是非的人，聽我說完就能明白情況的嚴重性了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001040,
					"content": "#從{F#妳}{M#你}剛才的描述看，薰香讓{F#妳}{M#你}產生了非常強烈的「幻覺」，{F#妳}{M#你}的精神狀況很不樂觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001041,
					"content": "#如果{F#妳}{M#你}還是沒辦法相信的話，可以聞一聞這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001042,
					"content": "唔——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "#哇，{F#妳}{M#你}沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001044,
					"content": "#是不是和{F#妳}{M#你}倒下那時的感覺很像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001045,
					"content": "#雖說{F#妳}{M#你}目前神智清醒，可是如果貿然讓{F#妳}{M#你}離開，{F#妳}{M#你}很可能又會突然在什麼地方失去知覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001046,
					"content": "雨林裡有不少猛獸，也存在十分危險的區域，到時候可能就不會像這次一樣好運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001047,
					"content": "#這些天{F#妳}{M#你}需要每天按時吃藥，盡量不要獨自行動，直到{F#妳}{M#你}聞到這種氣味不再感到不適，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001048,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "#{F#妳}{M#你}再休息一下吧，我去重新熬一碗藥湯給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30001050,
					"content": "#唉，怎麼會這樣…我們才剛到須彌，{F#妳}{M#你}就碰上了這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001051,
					"content": "#{NICKNAME}，我知道{F#妳}{M#你}想早點見到小吉祥草王，不過{F#妳}{M#你}現在的情況確實有點嚴重，還是先恢復身體吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001052,
					"content": "#喂，{F#妳}{M#你}到底有沒有在聽我說話？我很擔心{F#妳}{M#你}呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001053,
					"content": "我覺得有點奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "#奇怪？{F#妳}{M#你}是說{F#妳}{M#你}的身體狀況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001055,
					"content": "身體的確不太對勁，不過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "#{F#妳}{M#你}是說{F#妳}{M#你}看到的那些樹根和紅色的天空？可是如果不是幻覺的話，那些究竟是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001058,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "（那個時候我有種感覺，我正站在很深的地底。那片紅色的天空，難道是…「坎瑞亞」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "#唔…好吧。{F#妳}{M#你}的體質特殊，我相信{F#妳}{M#你}的判斷。可是{F#妳}{M#你}剛才為什麼不把這件事告訴提納里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001061,
					"content": "#現在他誤判了{F#妳}{M#你}的病情，{F#妳}{M#你}的情況不會越變越糟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001062,
					"content": "我覺得他沒有誤判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "#欸，{F#妳}{M#你}的意思是…提納里知道{F#妳}{M#你}看見的不是幻覺，卻故意這麼說來搪塞我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001065,
					"content": "對。所以我想弄清真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "#好吧，我明白{F#妳}{M#你}剛才保持沉默的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001067,
					"content": "#那這段時間我們就安心留在這裡，一邊恢復身體，一邊想辦法弄清楚{F#妳}{M#你}究竟看到了什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001068,
					"content": "#不過，直接向提納里打探看來不太行，{F#妳}{M#你}有什麼想法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001069,
					"content": "和柯萊聊聊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "有道理，柯萊對我們還是挺親切的，明天我們也可以先向她打聽一下草神和須彌的風土人情什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001071,
					"content": "在房間裡休息了一夜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "只是沒有說實話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "那些應該不是「幻覺」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001012,
					"content": "只有嘴裡…好苦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				}
			]
		}
	]
}