			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪薔薇啊薔薇，實現我的願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050502,
					"content": "#嗯？{F#妳}{M#你}們還在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050503,
					"content": "為什麼住在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "#呵呵，反正我是個怪老頭，「怪老頭做事哪有為什麼」，很少有人像{F#妳}{M#你}這樣問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050505,
					"content": "我啊，這一輩子總想出去闖蕩，想抓住機會做點什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050506,
					"content": "剛結婚不久的時候差點跟著鍍金旅團離開，但想想總覺得不能拋下老婆出去漂泊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050507,
					"content": "後來遇到行腳商，我又想跟著出去跑生意，最終因為本錢不夠沒走成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050508,
					"content": "再後來老太婆不在了，我沒牽掛了，可是年紀已經太老，沒辦法離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050509,
					"content": "拖拖拉拉混到今天，我錯過的事情太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050510,
					"content": "回過頭發現自己不屬於這個村子，也不屬於其他任何地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050511,
					"content": "最後結果嘛，就是我一個人搬到村子邊上生活才舒服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050512,
					"content": "幾十年也就這麼回事，算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050525,
					"content": "#這些花開了我就叫{F#妳}{M#你}們來看，明天或者後天，它們說不定就開了，{F#妳}{M#你}有空來看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050526,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "好好好，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050528,
					"content": "♪薔薇啊薔薇，實現我的願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050513,
					"content": "關於鬼老頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "也就只有外來的人會打聽鬼老頭的事了，我們村裡的小孩可都知道這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050515,
					"content": "#哪家孩子不聽話，孩子的父母就會嚇他：鬼老頭馬上就要來把{F#妳}{M#你}抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050516,
					"content": "這些年輕人啊，一個都不認識鬼老頭，倒挺會把他的名字搬出來嚇人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050517,
					"content": "我小的時候可是見過鬼老頭本人的，他是討厭小孩子沒錯，但長得也不恐怖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050518,
					"content": "不知道怎麼就被傳成了鬼老頭，我看都是一群閒人在背後胡說八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050519,
					"content": "你們不是朋友嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "我還小的時候，經常溜到他的小花園附近玩，他一發現，就會揮著鋤頭把我趕走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050521,
					"content": "他八成只把我當成去搗亂的調皮小子，哪裡會記得我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050522,
					"content": "雖然他不一定認識我，但我還是一直記得他和他的小花園。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050523,
					"content": "#{F#妳}{M#你}說他是我的朋友也沒錯，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732050524,
					"content": "就當是為了還原我記憶裡的小花園，我也會把這些花種出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
