			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "#{F#妳}{M#你}們來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060102,
					"content": "種子怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "所有的種子都還沒有發芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060104,
					"content": "我檢查過種子表面了，連一點點發芽的跡象都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060105,
					"content": "這到底是為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060106,
					"content": "種子我肯定沒認錯，它們都是我照著鬼老頭的手記從儲藏室裡翻出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060107,
					"content": "按照他的紀錄，種子的保存時間很長，只要確保乾燥，它們就不會壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060108,
					"content": "栽培方式也不該有問題，該澆的水和該施的肥料我都沒有落下，到底為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060109,
					"content": "別著急呀，阿凡爺爺，再等等看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732060110,
					"content": "#每次我和{NICKNAME}去野外摘果子摘花，摘完之後也要等好幾天它們才能重新長出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732060111,
					"content": "有耐心一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "#唉，也只能等等看了，{F#妳}{M#你}們今天有空嗎？能不能再幫我澆點水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060114,
					"content": "我剛把苗圃鬆過土，忙了好久，實在沒力氣跑回去打水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060115,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "#謝謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060112,
					"content": "試試看繼續澆水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"2"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "水還是要澆，肥還是要施，有沒有用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060302,
					"content": "我也不知道了，唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060303,
					"content": "我糊里糊塗活到今天，終於下定決心要做一件事，結果還是失敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060304,
					"content": "鬼老頭，辜負了你的囑託，對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732060305,
