			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "#{F#妳}{M#你}們是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370302,
					"content": "你就是安貞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370303,
					"content": "沒錯，是我。我感覺…有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370304,
					"content": "我記得我一直在追那群傢伙，然後拔下來了一個核心丟在營地裡。之後我因為自己也受傷挺重的，有點發睏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370305,
					"content": "#現在醒來看到{F#妳}{M#你}們，我覺得還挺有精神的。我是不是快死了迴光返照了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370306,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "#先不說這些了。{F#妳}{M#你}們是來捉拿我回去的嗎？我已經證明了自己的清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370308,
					"content": "是坎瑞亞的傢伙，他們偷走了圖書館的書。我雖然是接待他們的保鏢衛士，但我絕無可能和他們沆瀣一氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370309,
					"content": "我在這邊追查到了使團的蹤跡，打倒了他們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370310,
					"content": "我為了停下他們的機關巨物，和它周旋了很久。最後我扯下了它的核心。但是我也因此受了重傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370311,
					"content": "失去動力的機器壓在了遺失的書上面。我已經沒辦法把它取出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370312,
					"content": "白夜國的地走官可真厲害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370313,
					"content": "#{F#妳}{M#你}們不是地走官或者候補嗎？唉，無所謂了。最早地走官都是對抗深海龍蜥的勇士，後來才變成執法人員、幽冥判官的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370314,
					"content": "#核心就在營地裡。{F#妳}{M#你}們不信我的話，可以拿著核心去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
