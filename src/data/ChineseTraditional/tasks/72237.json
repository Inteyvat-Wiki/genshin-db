					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7223708",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "我聽聞鳴神島的使節談到過鳥這種生物。有翅膀，能夠在高天裡飛翔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370402,
					"content": "#太夢幻了，{F#妳}{M#你}們可以想像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370403,
					"content": "也有人認為，牠們是神明的使者，會特地前來傳達人的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370404,
					"content": "如果有人因為流放之罰而最終曝屍荒野的話，同一種鳥還會過來啄食他的凡軀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370405,
					"content": "我對這種生靈很著迷。如果今天以後，還有機會見到天光，我一定要養一隻鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安貞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "#{F#妳}{M#你}們拿到書了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370502,
					"content": "拿到了。安貞你確實是無辜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370503,
					"content": "從剛才的話來看，你們並不是地走官，有點可惜。不然就能現場正式承認我的無罪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370504,
					"content": "不然就能立刻證明我的清白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370505,
					"content": "我現在感覺非常有精神，但是之前那種流血過多的疲倦感也很真實。我是不是真的快要死了所以迴光返照啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370506,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370507,
					"content": "#唉，我問{F#妳}{M#你}啊，陌生人。被白夜國所判的冤罪，是罪孽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370508,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "如果此刻的我，因為這種難以平復的心境，被常世大神留為罪影。這是罪孽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370510,
					"content": "我，有罪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370511,
					"content": "你沒有罪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#喂，{NICKNAME}，{F#妳}{M#你}要小心點說話。讓他意識到了…意識到那件事的話，他會消失的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370513,
					"content": "你只是安貞留下的殘影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370515,
					"content": "你是無罪的，我會讓所有人知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "哼哼，是嗎。原來我只是生前的一個影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370517,
					"content": "原來，我是無罪的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				},
				{
					"id": 722370518,
					"content": "安貞的殘影開始背誦斷章——\\n「我究竟觸犯了哪一條神律…不幸的人為什麼要仰仗神明？\\n我的作為是否有意義，既然我的虔誠之行換取了負罪之名？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安貞"
				}
			]
		}
	]
}