					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070101,
					"content": "鍾…鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070102,
					"content": "許久不見，近來可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070103,
					"content": "不不不對…鍾離，你怎麼會在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070104,
					"content": "既是閒遊，就不該侷限於眼前。風之國土自由豐饒，是一大好去處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070105,
					"content": "#能在這裡遇見{F#妳}{M#你}們，實屬意外之喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070106,
					"content": "要來一杯什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "#一杯煙霞蔽芾。茶濃些更好，有勞{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070107,
					"content": "可以邊喝茶邊聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050703",
							"2"
						],
						"stepId": 7050703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "久等啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070202,
					"content": "請慢用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "茶湯透亮，色澤宜人，入口甘醇，更伴有花果香。嗯，相當難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070204,
					"content": "哇，鍾離在喝茶方面也是行家呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070205,
					"content": "像我「咕嘟」一口就喝下去了，只能說出好喝兩個字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070206,
					"content": "用心品嚐，是對沏茶者的敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070207,
					"content": "好茶十分難得，能將好茶泡得怡景怡情的沏茶者，更是難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070208,
					"content": "謬讚了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "好吧，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070211,
					"content": "那…教教我你是怎麼品茶的吧。我看是先聞再喝，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070212,
					"content": "不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070213,
					"content": "茶葉各有特徵，喝得多了，自然有些心得。茶品好壞，聞香味便可略知一二了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070214,
					"content": "有些茶聞起來濕膩，焦香過重，應是次品。另有一些，聞起來甘醇典雅，幽香撲面，這類茶多為上品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070215,
					"content": "若想再講究些，按璃月古時傳統，還應備上「品香盞」。這件器皿能盛放茶湯，專用於品香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070216,
					"content": "怎麼辦，感覺我之前都虧了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070217,
					"content": "無妨。學問甚多，何時開始都不算遲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070218,
					"content": "初學者可以試著這樣品鑒：先觀察水色，再輕嗅茶香，最後才是品茗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070219,
					"content": "「由淺入深」，對萬事萬物的掌握皆是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070220,
					"content": "收穫不小…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "璃月西北的「翹英莊」，以茶業聞名。日後若有機會，不妨前去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070223,
					"content": "今日所說種種，大多是我這個老派璃月人的習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070224,
					"content": "各地飲茶習慣與茶文化均有不同。身處不同國度，理應尊重當地風俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070225,
					"content": "我完全理解了！但能不能記住就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070226,
					"content": "意料之中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#{NICKNAME}，今日多謝{F#妳}{M#你}了。有幸喝到這等好茶，不虛此行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070228,
					"content": "#他日{F#妳}{M#你}若坐鎮茶館，我定來捧場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070229,
					"content": "但我們很忙，大概沒有時間去茶館打零工吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070230,
					"content": "誰知道呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "總之，如有機會，我一定支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070232,
					"content": "#今天就到這裡吧。不多叨擾了，祝{F#妳}{M#你}工作順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070233,
					"content": "嗯，慢走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "嗯，開銷就按照習慣，記在往生堂帳上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070236,
					"content": "慢走慢走，代我們跟堂主問好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705070234,
					"content": "那個，結帳的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "還想學更多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "有點不好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}