					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10010",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732321801,
					"content": "#完成「祭水之儀」後，{F#妳}{M#你}們沿著甘露的流向，跟隨斯露莎離開了「萬種母樹」回到花海…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321802
					]
				},
				{
					"id": 732321802,
					"content": "#而祖爾宛也已經在此等候著{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321803
					]
				},
				{
					"id": 732321803,
					"content": "#沒想到{F#妳}{M#你}們真的完成了「祭水之儀」，這番功績已可比擬古代的英雄，真是讓我驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321804
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321804,
					"content": "妳明明就是一副一點也不驚訝的樣子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321805,
					"content": "「焚真之天象」已經熄滅，大地也得到了淨化，沒想到不靠犧牲也能夠做到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321806
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321806,
					"content": "下了一場好大的雨啊，天上的大窟窿不見了，枯樹樁也重新長成了大樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321807,
					"content": "不用再承受汙穢侵蝕，神明大人應該也沒有那麼痛苦了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321808,
					"content": "那麼關於五百年前的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321809
					]
				},
				{
					"id": 732321809,
					"content": "對哦，剛才斯露莎在大樹裡面看到了過去的記憶，果然最開始抵抗魔物的矯論團先輩裡面有坎瑞亞的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321810,
					"content": "#哎呀，別這麼嚴肅嘛。既然{F#妳}{M#你}們已經接觸了來自過去的記憶，那麼接下來我要說的，就不是故事，而是事實了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321811
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321811,
					"content": "很久很久以前，當我第一次從花海中醒來時，除了這一方小小的淨土，天空中到處是黑淵的異象，外面也都是魔物的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321812
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321812,
					"content": "循著神鳥遺願的指引，我召集靈光的力量，離開花海以鎮壓地上的魔物，直到在荒野中遇到了那個金髮的男人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321813
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321813,
					"content": "那個傢伙一半的身軀已形同魔物，但身上卻沒有魔物的氣息，我發現他時，他的手中還緊緊握著一枚戒指。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321814
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321814,
					"content": "我將他帶到花海之中，醒來之後他自稱是荼訶的劍士，因身負詛咒才活了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321815
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321815,
					"content": "後來一段時間，我便與這位蒙面的劍士同行，共同對抗進攻花海的迪弗們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321816
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321816,
					"content": "身負詛咒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321817
					]
				},
				{
					"id": 732321817,
					"content": "嗯，據說那場災厄之中，荼訶人都受到了不同程度的詛咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321818
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321818,
					"content": "那之後不久，從沙漠的東方來了一群學者裝束的人，為首的是一位獨臂的賢者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321819
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321819,
					"content": "他們自稱是曾與荼訶人的勇士並肩作戰之人。據他們所說，那是一群即便知道已背負上汙名，卻依然循著本願而行的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321820
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321820,
					"content": "背負著勇士們的遺願，為了徹底消除黑淵的災禍，他們循著勇士們曾走過的道路而溯行至此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321821
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321821,
					"content": "後來，我們共同進入了荼訶人留下的遺蹟，發現了那些曾經與魔物對抗的機關，它們也隸屬於曾與學者們並肩作戰的戰團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321822
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321822,
					"content": "最後獨臂的賢者靠著荼訶人留下的文獻，找到了得以穿過黑淵進入母樹的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321823
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321823,
					"content": "於是我們便一同進入母樹，用甘露淨化了天上與地上的汙穢。此後花海中不斷有花靈誕生，地上的魔物則漸漸消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321824
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321824,
					"content": "#後來，蒙面的劍士隨一位與{F#妳}{M#你}有著同樣金色頭髮的{M#少女}{F#少年}離開了花海，賢者則獨自進入地下的遺蹟再也沒有回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321825
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321825,
					"content": "剩下的人則與新生的花靈結成了夥伴，自稱為「矯論團」，在這裡生活了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321826
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321826,
					"content": "如今金髮的勇士又回到了花海，雖然不是當初的那位，不過我也能感受到某些東西又開始重新流逝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321827
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321827,
					"content": "#這也是為什麼我一開始就選擇了拜託{F#妳}{M#你}們的原因啊，有{F#妳}{M#你}們在我就不用再想著去哪找出一位能與花靈並肩作戰的勇士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321828
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321828,
					"content": "教導人類的工作可是很辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321829
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321829,
					"content": "怎麼妳們花靈一個比一個懶啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321830,
					"content": "喂，白飄飄說的這句話別把我算進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321831
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321831,
					"content": "哎呀，既然完成了「祭水之儀」，汙穢一時半刻也沒辦法威脅這裡，我也可以趁機好好休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321832
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321832,
					"content": "#至於斯露莎，我就把她交給{F#妳}{M#你}們了，{F#妳}{M#你}們可要在旅途中好好教導她，畢竟這也算是「謁頌主」的工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321833
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321833,
					"content": "我才不想被白飄飄指導…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321834
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732321834,
					"content": "嘿嘿，斯露莎要好好聽話！不過怎麼祖爾宛說的就像是以後不會再見面了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732321835,
					"content": "#反正{F#妳}{M#你}們又不會留在這裡陪我，{F#妳}{M#你}們這些人都一樣啦，永遠也不打算停下腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321836,
						732321837
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321836,
					"content": "我們還會回來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				},
				{
					"id": 732321838,
					"content": "哎呀，我是不會再相信這種話了，畢竟已經不是第一次聽了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321839
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321839,
					"content": "#說到這個，也不知道那位蒙面的劍士現在怎麼樣了，{F#妳}{M#你}們要是見到他麻煩幫我問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321840
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321840,
					"content": "#畢竟{F#妳}{M#你}們都是旅人嘛，總是會有機會見面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321841
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321841,
					"content": "#好啦，{F#妳}{M#你}們該回到屬於{F#妳}{M#你}們的地方去了，別太想我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732321837,
					"content": "還會有機會見面的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				}
			]
		},
