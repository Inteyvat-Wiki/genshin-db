			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320301,
					"content": "這裡是，那棵大樹樁的上面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320302,
					"content": "明明好不容易才穿過了大窟窿到達這裡，怎麼又被攔住了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320303,
					"content": "按理來說我已經獲得了「雙角的花冠」，應該不會被母樹拒絕的才對…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320304
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320304,
					"content": "唔，怎麼了斯露莎，妳看起來好像很難受的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320305,
					"content": "嗚嗚…是「雙角的花冠」…好像有什麼東西在湧進來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320306
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320306,
					"content": "哇啊，斯露莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320380,
					"content": "古樹的根脈縱橫交錯，每一個連接處都發出微弱的光芒。\\n隨著隙間光影交錯，一個又一個畫面閃過。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320381,
					"content": "在荒莽的群山中，勇士們手持各色武具，身後則是連成一線的花靈。\\n即便黑雲壓境，也未後退分毫。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320382,
					"content": "在漆黑的淵底下，巨大的機械閃耀著微光。\\n在熊熊黑火的灼燒之中，掩護著逃生的人群。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320383,
					"content": "在無邊的荒原上，蒙面的劍士與獨臂的賢者相背而立。\\n在靈光的庇佑下，對抗著潮水般湧來的魔物。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320384,
					"content": "靈光指引著所有人的前路，也化為所有人的歸途。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320385,
					"content": "無數的光芒匯聚為極小的光點，白光自樹底上升。\\n最終，點燃了原本漆黑一片的天空。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7323206,
			"completionStepIds": [
				7323206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323206",
							"2"
						],
						"stepId": 7323206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "喂喂！快醒醒，斯露莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320602,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320603,
					"content": "呼，妳終於醒過來了，剛才在上面的時候妳突然就暈過去了，嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320604,
					"content": "嗯…我沒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320605,
					"content": "不過在那之後母樹就打開了，然後我們就跟著來到了這裡，這裡該不會是…祖爾宛說的那個巨蓮「伽烏迦那」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320606,
					"content": "所以斯露莎剛才到底是怎麼了啊，是花冠出了什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320607,
					"content": "我剛才好像看到了大地回歸母樹的記憶。無數的花靈、荼訶的機關與人類的勇士，與魔物交戰然後犧牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320608,
					"content": "蒙面的劍士、獨臂的賢者與元祖的花靈降服了自淵底而出的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320609,
					"content": "而他們的意志最後都隨著靈光回到了母樹當中，化為從天而降的甘霖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320610,
					"content": "荼訶的機關…聽起來該不會真的像那先朱那說的那樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320611,
					"content": "看來還是得問祖爾宛才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "嗯，不過現在我們接下來該怎麼辦呢，我記得祖爾宛是說要清除什麼汙穢來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320613,
					"content": "只有進入神明大人的「神識」所依附的「染境」，將那些被汙穢困在其中的「慈心」帶出來，才能重新喚醒「神識」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320614,
					"content": "在我所看到的記憶中，那是個無邊虛無的空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732320615,
					"content": "既然這樣，那我們要怎麼樣才能進去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732320616,
					"content": "跟著我來就行，只要沿著古代英雄們的「心跡」，就能到達那裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				}
			]
		},
