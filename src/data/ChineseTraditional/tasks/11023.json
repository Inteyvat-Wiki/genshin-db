			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛煙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "…這一路上的，都是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231132,
					"content": "他們，看到了什麼…又做了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231133,
					"content": "然後…又發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231134,
					"content": "既然妳無法信任我，那我們就繼續向前吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231135,
					"content": "那時候發生的一切，這扇門後留下的痕跡，都會如實記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛煙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "這裡就是現場，赫烏莉亞形骸潰散，只留下些許鹽跡。臨終的畫面，也定格於此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231103,
					"content": "故事的後續是：她的子民中，有人終於意識到，這位仁善卻柔弱的魔神，在戰爭中保護不了任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231104,
					"content": "魔神戰爭是很殘酷的。與其讓她經受戰敗後的折磨，不如，賜予她相對輕鬆的解脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231105,
					"content": "可是，這些「雕像」…又是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110231106,
					"content": "再怎麼弱小的魔神，死亡時流失的力量，也非凡人之軀所能承受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231107,
					"content": "沒能逃走的人，全都變成了這副模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231108,
					"content": "未經此災的鹽神子民離開了她的領地，前往璃月，請求岩王帝君的庇護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231109,
					"content": "他們的後代害怕赫烏莉亞留下的魔神殘渣，害怕她施予他們永世的詛咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231110,
					"content": "於是，他們冒著危險回到這裡，將劍折斷、供奉，希望能夠平息她留下的怒火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231111,
					"content": "但其實他們是多此一舉了。這位直到最後都沒有反抗過的魔神，又怎麼會對自己的子民…心懷忿怒呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231112,
					"content": "我…我…就算是這樣，我不接受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231113,
					"content": "騙局…虛假的歷史…一切…都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231114,
					"content": "別想動搖…我的信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110231116,
					"content": "這一次，鍾離也真是不留情呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110231117,
					"content": "這就是她要付出的代價了，但…這也並不失為一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231118,
					"content": "看她的模樣，恐怕還會繼續動搖一陣…不過，即使不能馬上解脫，只是認清現實，也還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231119,
					"content": "你對鹽之魔神的遭遇太熟悉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "嗯，在很久很久以前，赫烏莉亞的故事對我來說，也是一份告誡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231123,
					"content": "信仰一位已經逝去的神，實在沒有什麼好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231124,
					"content": "…不論是對赫烏莉亞的信仰，還是對摩拉克斯的信仰，都是一樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231125,
					"content": "璃月人總有一天也會明白的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "好了。接下來，陪我去一趟「孤雲閣」如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231127,
					"content": "嗯？鍾離要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110231128,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231129,
					"content": "重遊故地，又講了這麼多故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231130,
					"content": "難免對那些故人，心生懷念了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110231121,
					"content": "解印的辦法，不只是道聽塗説吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "真是敏銳，不過…也只是因為我活得比較長而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
}