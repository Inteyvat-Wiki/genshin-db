			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "這個裡面，有裝了一半的鹽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230302,
					"content": "不過就是個鹽罐子而已，看來「鹽之魔神」是個窮酸的魔神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230303,
					"content": "據我瞭解，它並不普通。雖然只有一半，但永遠都有一半——換句話說，就是無盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230304,
					"content": "什麼？！我就算一直往外面倒，裡面的鹽也不會減少嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230305,
					"content": "正是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230306,
					"content": "能夠產生無窮無盡的鹽，果然，「鹽之魔神」所擁有的權能是很強大的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230307,
					"content": "辛苦了這麼久，終於讓我遇到寶貝了！這東西歸我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230308,
					"content": "我只需要把鹽倒出來，搞個幾千幾萬袋，靠賣鹽都能發財了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230309,
					"content": "喂！「鹽之魔神」的遺產，怎麼可以用來做這麼膚淺的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230310,
					"content": "如果克列門特先生想要這個鹽盞，那麼按照契約，下一件物品，就是屬於宛煙女士的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230311,
					"content": "沒問題沒問題，哼哼，怎麼會有比這個還值錢的東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230312,
					"content": "既然有「契約」，我也沒必要和他爭搶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230313,
					"content": "那麼，我們繼續前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "哼，一把尺而已，看起來就沒什麼用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230502,
					"content": "這是…我記得沒錯的話，這個應該是一種量器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230503,
					"content": "確實如此。但「鹽之魔神」亦有權能在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230504,
					"content": "這鹽尺一旦插進地面，土壤之上就會像漲水那樣，被鹽覆蓋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230505,
					"content": "越是深入，鹽粒就會越多，換言之，就是鹽的「豐收」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230506,
					"content": "這、這…這不是比鹽盞還要厲害？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230507,
					"content": "那麼，按照契約，這鹽尺就屬於宛煙女士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230508,
					"content": "不行！我不同意！錢是我出的，這場探索也是我組織的，憑什麼要我吃虧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230509,
					"content": "而且這小姑娘一點用都沒有，為什麼要把東西送給她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230510,
					"content": "他果然還是這麼做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230511,
					"content": "唉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "那也就是，你想破壞「契約」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230514,
					"content": "破壞又怎麼樣？這遺蹟裡的機關，我也差不多看明白了。所以，你已經沒用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230515,
					"content": "說到底，我是雇傭你的人。憑什麼我要按照你的規矩來做事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230516,
					"content": "因為你立下了契約。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230517,
					"content": "岩王帝君曾說，「契約既成，食言者當受食岩之罰。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230518,
					"content": "那是你們璃月的神，我是至冬來的，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230519,
					"content": "「食岩之罰」，你自己感受一下吧…可不會太輕鬆的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230512,
					"content": "既然說了這種話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "你的收穫，也由我沒收了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230702,
					"content": "你沒有繼續前進的資格了，就這樣離開吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230703,
					"content": "可惡…你給我等著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110230705,
					"content": "說是考古勘探，終於還是裝不下去了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230706,
					"content": "幸好早有提防。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "就是，幸好我已經有敏銳的嗅覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230710,
					"content": "克列門特的錯誤，在於貪欲。但在貪欲之外，也還有許多令人想要違背契約的誘惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230711,
					"content": "面對「渴望之物」，究竟有多少人能夠克制欲望、遵循契約…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230712,
					"content": "不如，就趁這個機會講清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230713,
					"content": "嗯？要講什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230714,
					"content": "這一個臨時的考古小隊，其實沒有人是來「考古」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230715,
					"content": "為、為什麼這麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230716,
					"content": "這位女士，妳缺乏最基本的考古常識，文物也不識幾件，但在「鹽之魔神」上的知識，又特別精通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230717,
					"content": "比起考古與文物，還是「鹽之魔神」本身，才更讓妳感興趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230718,
					"content": "妳在珠鈿舫提到的那些關於鹽之魔神的傳說，據我所知，是在「銀原廳」流傳得最多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230719,
					"content": "別、別再說了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230720,
					"content": "…先生你果然博學多才，我鼓起勇氣向你提問，看來是正確的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230721,
					"content": "——沒錯，我不是什麼考古學家。我來自璃月「七星八門」中的一門，主管鹽業的「銀原廳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230722,
					"content": "我們的祖輩，就是在魔神戰爭席捲大陸的苦難時期裡，曾受「鹽之魔神」庇護的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230723,
					"content": "話說，從沒聽妳喊過「帝君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "對喔，這樣一提醒的話，確實很少有璃月人會把「摩拉克斯」掛在嘴上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230726,
					"content": "在戰爭中，摩拉克斯暗殺了我們的神！他嫉妒「鹽之魔神」的權能，讓我們流離失所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230727,
					"content": "我…我們恨他！但璃月是摩拉克斯的璃月，歷史一定是任由他粉飾的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230728,
					"content": "所以，我想要證明！摩拉克斯也有罪惡！他手上沾著血，他有殘忍無情的一面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230730,
					"content": "我們簽過「契約」，要直面真相，對吧，鍾離先生！對這件事，你要有公正的判斷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230731,
					"content": "那是自然。而且，璃月已經不再是摩拉克斯的璃月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230732,
					"content": "跟我走吧，一切答案就在前方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230724,
					"content": "話說，從沒聽妳喊過「岩王爺」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "以後派蒙可別變成他那樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "我喜歡摩拉，但我不幹壞事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "這是…劍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230902,
					"content": "啊！是斷裂的劍！這就是證據！證明「鹽之魔神」曾經是反抗過的！只是沒能抵擋摩拉克斯下的毒手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230903,
					"content": "相比「鹽盞」和「鹽尺」，這「劍」的力量，一定是遠遠超越它們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230904,
					"content": "如果能修好這把劍，就能向其他人展示「鹽之魔神」曾經的權能了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230905,
					"content": "看起來…確實很像戰敗之後留下的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230906,
					"content": "兩段斷劍，以考古角度來看，是兩件文物。按照「順次取物，每次一件」的契約，妳只能帶走其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230907,
					"content": "為、為什麼？雖說是順次取物，可是，克列門特已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230908,
					"content": "是的，但是「每次一件」仍然有效。想要同時取走兩件文物，是不可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230909,
					"content": "這、這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230910,
					"content": "唔…鍾離，她不是惡意，也沒有爭搶，是不是可以通融一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230911,
					"content": "「契約」不可通融，若不遵守，就是破壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230912,
					"content": "不行！如果只帶走一半，那、那就沒辦法修好，也沒辦法重現「鹽之魔神」的權能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230913,
					"content": "無論如何，為了我對她的信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230914,
					"content": "即使是破壞契約，我也在所不惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230915,
					"content": "妳已經下定決心了嗎？那麼，這是有代價的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230916,
					"content": "鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230917,
					"content": "這就意味著，妳要承受「食岩之罰」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230918,
					"content": "那也…沒關係。「鹽之魔神」為保護她的信徒，連生命都願意付出。我的犧牲，微不足道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230919,
					"content": "你要怎樣懲罰都沒關係，只要讓我帶回…我信仰的證明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230920,
					"content": "不、不可以打女孩子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230921,
					"content": "…如果那樣就能獲得解脫，說不定是更輕鬆的方法。但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230922,
					"content": "作為「懲罰」，我會告訴妳「真相」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230923,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230924,
					"content": "真相？你說真相…是對我的懲罰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230925,
					"content": "是的。接下來妳將聽到的事實，就是妳破壞了「契約」的代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230926,
					"content": "——很遺憾，鹽之魔神，赫烏莉亞，並不是一位權能強大的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230927,
					"content": "相反，她過於弱小——過於遷就、過於柔弱，是絕無可能登上七神之位的…敗者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230928,
					"content": "你說什麼…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230929,
					"content": "魔神戰爭時期，塵世間的魔神們為了爭奪提瓦特大陸，拼盡了全部的力量與智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230930,
					"content": "但赫烏莉亞選擇了逃避。她認為只要在爭鬥發生之前就放棄，戰爭就永遠不會波及到自己和子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230931,
					"content": "可是，在漫長的戰爭歲月裡，「退讓」是不會有止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230932,
					"content": "在無底線的退讓中，赫烏莉亞失去了所有土地，只剩下最後的容身之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230933,
					"content": "不…不…沒可能的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230934,
					"content": "在她最後的時刻，她連一把能舉起來保護子民的兵刃，都沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230935,
					"content": "連兵刃都沒有？可是，這劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230936,
					"content": "是的，這把斷劍並非「鹽之魔神」的遺物，而是…殺死她的兇器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230937,
					"content": "兇器…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230938,
					"content": "不！這是假的，你說的都是假的，你想要迷惑我對神明的信心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230939,
					"content": "我說過，我只陳述事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230940,
					"content": "豈有此理！你…你也是摩拉克斯的信徒，你別想騙我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110230942,
					"content": "喂！喂，別跑啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110230943,
					"content": "對她來說打擊太大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "畢竟，這是懲罰。若非如此，我也不想講出這麼殘酷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230947,
					"content": "我們也繼續往深處走吧。在那裡…恐怕會有，令她無論如何都不得不接受「真相」的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110230945,
					"content": "鍾離說的，的確是「真相」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "嗯，不然也不會把「真相」當作懲罰了。我也不想講出這麼殘酷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102310,
