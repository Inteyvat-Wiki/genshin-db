			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭沙恭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "你就是蘭沙恭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670402,
					"content": "嗚嗚…蘭沙恭確實是我的名字，嗚哇，別突然靠那麼近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670403,
					"content": "雖然很感謝兩位將我救出險境，但、但是蘭沙恭還是請求兩位能保持一定的距離…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670404,
					"content": "這樣能讓蘭沙恭，稍微安心一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670405,
					"content": "什麼呀，剛剛明明就是我們把你救出來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670406,
					"content": "#啊啊，對不起對不起，是蘭沙恭提出的要求太過分了…才讓{F#妳}{M#你}生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670407,
					"content": "可是蘭沙恭被圍困在此，驚魂未定，嗚嗚，就算有失禮之處，還希望兩位能夠原諒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670408,
					"content": "沒關係啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670409,
					"content": "那就好那就好，不知蘭沙恭能知道兩位的名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670410,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670411,
					"content": "#我是{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#嗚嗚，金色的那菈{NICKNAME}和派蒙，那個…為何會知道蘭沙恭的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670413,
					"content": "我們看了屋子裡的筆記…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#金髮的那菈{NICKNAME}，看到了筆記，便來尋找蘭沙恭的蹤跡，又幫蘭沙恭解圍，真是心善又厲害的好那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670415,
					"content": "嗚嗚…如果蘭沙恭沒有失去「勇氣」，就不會像剛才那樣被困住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670416,
					"content": "對喔，之前在筆記裡也看到了，蘭沙恭，你說自己失去了「勇氣」到底是怎麼一回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670417,
					"content": "這是很久以前的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670418,
					"content": "在許多月亮之前，蘭沙恭就像現在這樣，是沒有「勇氣」的蘭沙恭…那時，即使是樹枝斷裂的聲音，也會讓蘭沙恭夜不能寐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670419,
					"content": "但是，即使是膽小的蘭沙恭，也有一個願意陪伴蘭沙恭的那菈朋友，雖然那菈朋友不是偉大的那菈法留納，但也是很好的那菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670420,
					"content": "他從不會因為蘭沙恭膽小而故意捉弄蘭沙恭，在蘭沙恭覺得害怕的時候，會主動握起蘭沙恭的手…是蘭沙恭永不會忘記的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670421,
					"content": "可有一天，那個那菈被「毛毛臉面具魔王」抓走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670422,
					"content": "等等，所以那個「毛毛臉面具魔王」是什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670423,
					"content": "「毛毛臉面具魔王」，就是毛毛臉，戴著面具的，魔王呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670424,
					"content": "…是、是喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670425,
					"content": "派蒙知道是什麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "能知道才奇怪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670429,
					"content": "總之，就是那個「毛毛臉面具魔王」抓走了蘭沙恭的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670430,
					"content": "…「毛毛臉面具魔王」，十分陰險狡猾，只是想想，蘭沙恭全身就開始顫抖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670431,
					"content": "…嗚嗚，那時蘭沙恭的那菈朋友被抓走，十分害怕，蘭沙恭雖然害怕被「毛毛臉面具魔王」打，但更害怕再也見不到那菈朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670432,
					"content": "所以蘭沙恭很努力的，閉著眼睛！咬著牙！用手拍拍！救出了蘭沙恭的那菈朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670433,
					"content": "那之後呀，那菈朋友就用花做了「勇氣的護身符」，對蘭沙恭說，「蘭沙恭是有勇氣的好蘭那羅！不是膽小的蘭那羅！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670434,
					"content": "蘭沙恭因此獲得了「勇氣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670435,
					"content": "咦，可是照這樣來說，你的「閉著眼睛！咬著牙！用手拍拍！」不就是很有勇氣的行為了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670436,
					"content": "不是的不是的，蘭沙恭是那之後才從那菈朋友那裡，獲得了「勇氣」的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670437,
					"content": "可是，你救你的朋友本身，就很勇敢了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670438,
					"content": "沒有沒有，在救那菈朋友的時候，蘭沙恭可害怕了，手軟軟腳軟軟，可是獲得了「勇氣」後，蘭沙恭就再沒有手軟軟腳軟軟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670439,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670440,
					"content": "護身符只是契機！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#嗚嗚…那菈{NICKNAME}的話好複雜，蘭沙恭只知道，「勇氣護身符」在，蘭沙恭就有「勇氣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670443,
					"content": "之前蘭沙恭的「勇氣」被偷走，所以就想來「毛毛臉面具魔王」的洞穴偷偷尋找，希望能尋到蘭沙恭的「勇氣」的蹤跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670444,
					"content": "結果就被幾隻史萊姆圍困在了洞穴裡呢…幸好沒被那個什麼「毛毛臉面具魔王」發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670445,
					"content": "#啊，說到這個，{NICKNAME}，還記得我們之前從丘丘人那裡撿到的…不會就是蘭沙恭的護身符吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670446,
					"content": "蘭沙恭，我們說不定撿到你的「勇氣」啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670447,
					"content": "#真的嗎！那菈{NICKNAME}和派蒙，真的撿到蘭沙恭的「勇氣」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670441,
					"content": "勇氣本就存在蘭沙恭心中！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "是蘭那羅風格的回答呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "是啊，完全猜不到那個「毛毛臉面具魔王」是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "派蒙"
				}
			]
		},
