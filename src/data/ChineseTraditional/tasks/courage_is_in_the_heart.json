				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "咦，這些丘丘人好像掉了一個奇怪的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670102,
					"content": "看起來好像是用花朵做的，奇怪，明明只是普通的花，已經摘下來很久了…卻沒有壞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670103,
					"content": "上面能感受到相當多的草元素…而且還丟在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670104,
					"content": "肯定是蘭那羅的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "嗯，一定是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670108,
					"content": "唔，這個花朵做的東西上有那麼多的草元素，就連在丘丘人手裡都沒有枯萎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670109,
					"content": "也許是一直隨身攜帶著…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "嗯，我們還是盡快把這個東西還給蘭那羅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670112,
					"content": "#我們進屋子看看，{NICKNAME}，說不定那個丟了東西的冒失鬼正在房子裡唉聲嘆氣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670110,
					"content": "也許是很寶貴的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "是草元素丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "那是什麼啦，怎麼想都是住在這裡的蘭那羅掉的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
