			"dialogs": [
				{
					"id": 730670701,
					"content": "雖然隱約猜到了…不過「毛毛臉面具魔王」真的就是丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670702,
					"content": "丘丘人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "蘭沙恭"
				},
				{
					"id": 730670703,
					"content": "嗯，「毛毛臉面具魔王」是丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "派蒙"
				},
				{
