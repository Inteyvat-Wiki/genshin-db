			"trigger": {
				"objectNames": [
					"滿",
					"曜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "明天午飯做幾道菜好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020202,
					"content": "我家孩子是越來越能吃了，多做點總歸沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020203,
					"content": "咦？請問您是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020204,
					"content": "請問這是竺子家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "是的，請問您有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020207,
					"content": "這是竺子讓我帶給你們的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "信，這孩子為什麼突然要寫信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020209,
					"content": "還寫這麼長…明明都已經回家了，有什麼話直接對我們說不就好了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020210,
					"content": "…什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#這位…旅行者，{F#妳}{M#你}聽起來好像很意外？雖然我們家竺子確實外出遊歷過一陣子，但她現在已經回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020213,
					"content": "#既然回家了，又有什麼必要請人送家書呢，{F#妳}{M#你}們是找錯人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020214,
					"content": "等一下，孩子她媽，我掃了一眼這封家書，這筆跡、這口吻的確是我們的女兒竺子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020215,
					"content": "信中也確實說到，她短期內不打算回來，讓我們保重身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020216,
					"content": "這到底是怎麼回事？不會是這孩子一邊託這位旅行者帶信回來，一邊自己回來了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020217,
					"content": "我覺得這其中可能有點誤會，等孩子回來了，我們問一問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020218,
					"content": "旅行者，不巧我家竺子今天有事外出了，等她回來我們夫妻倆會去問清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020219,
					"content": "#如果{F#妳}{M#你}願意的話，就明天晚上再過來找我們吧，讓那孩子當面跟{F#妳}{M#你}解釋清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020220,
					"content": "現在她在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "這孩子說自己要忙工作的事，吃了飯之後就急匆匆地離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020224,
					"content": "是啊，每天都早出晚歸的，只有晚上我們才能見著她，真不知道這孩子到底在忙什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020225,
					"content": "#總之，請{F#妳}{M#你}明天晚上過來吧，要真是那孩子弄錯了，一定讓她跟{F#妳}{M#你}當面道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020226,
					"content": "#還麻煩{F#妳}{M#你}跑了這麼長一段路，真是不好意思啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020227,
					"content": "竺子這孩子，真是不讓人省心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020222,
					"content": "為什麼是晚上？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "這孩子說自己要忙工作的事，每天白天吃了飯之後都會離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020211,
					"content": "竺子…回家了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "請問是竺子的父母嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
			"id": 7280203,
