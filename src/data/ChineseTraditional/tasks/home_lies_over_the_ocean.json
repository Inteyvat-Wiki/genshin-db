			"dialogs": [
				{
					"id": 728020301,
					"content": "女兒回家的日期…怎麼比這家書上落款的日期還早？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020302,
					"content": "別胡思亂想了，大概只是誤會，還是好好幫我想想明天午飯做什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "滿"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280204",
							"2"
						],
						"stepId": 7280204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曜",
					"滿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "#我們家竺子現在不在，請{F#妳}{M#你}等到晚上再來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020402,
					"content": "等到了晚上，竺子應該就會回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "滿"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竺子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "竺子一家應該都在屋子裡了，我們敲敲門吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020502,
					"content": "他們好像在聊些什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "說起來，不知道我們之前救下的那隻狸貓怎麼樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020504,
					"content": "妳呀，太善良了，那隻狸貓不過是腿上受了點小傷，其實把牠留在草叢裡，讓牠自己休養也能好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020505,
					"content": "我捨不得嘛，牠當時都看著我流眼淚了，可憐巴巴的，我怎麼能不把牠帶回家照顧呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020506,
					"content": "算啦，行善總是好事，就是牠吃的實在有點多，快趕上我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020507,
					"content": "敲門",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020509,
					"content": "是之前來過的旅行者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "哦，是那位旅行者吧，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020511,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}好！我是竺子，初次…不…又見面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020512,
					"content": "#不好意思，因為實在太想家，所以我在把信交給{F#妳}{M#你}們之後又變了主意，坐船回了家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020513,
					"content": "#啊哈哈…之前都是誤會，抱歉啦，讓{F#妳}{M#你}跑這麼一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020514,
					"content": "妳有辦法回到稻妻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "#…啊，我有自己的途徑哈哈，這個{F#妳}{M#你}就不用管了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020516,
					"content": "#那個，報酬我已經準備好了，請收下吧，多謝{F#妳}{M#你}們幫忙。快點…呃，快點忙{F#妳}{M#你}們的事去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020517,
					"content": "竺子小姐的話怎麼前後不一？要是往返稻妻有這麼容易的話，當初幹嘛還要拜託我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020518,
					"content": "妳在璃月的產業呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "產業？什麼產業，我在璃月還有產業的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020522,
					"content": "…啊，這種東西都是身外之物，和家人相比完全不重要，我早就託付給別人啦，啊…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020523,
					"content": "喂喂，真正的竺子在璃月找工作都有問題，怎麼會搖身一變成有錢人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728020524,
					"content": "妳到底是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "我…我當然是竺子了！長得是竺子，聲音是竺子，這有什麼好懷疑的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020526,
					"content": "#我說{F#妳}{M#你}啊！真是糾纏不休…算了，我不和{F#妳}{M#你}說了，明天我還要工作，先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020527,
					"content": "欸，竺子！這孩子…怎麼突然火氣這麼大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020528,
					"content": "抱歉啊，旅行者，這孩子肯定是工作太累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020529,
					"content": "#但{F#妳}{M#你}也看到了，這確實是我們的女兒，{F#妳}{M#你}帶來的那封信…說不定真是這孩子忘記了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020530,
					"content": "#不過無論如何，還是謝謝{F#妳}{M#你}幫忙跑這一趟，報酬的話…還請{F#妳}{M#你}再稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020531,
					"content": "發生什麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "那倒沒有，報酬我們還是拿得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020534,
					"content": "竺子這孩子，白天不是去工作嗎？但她每天拿回來的工錢總是有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020535,
					"content": "有的是一些奇怪的種子，有的是一些野果子，就是不直接拿摩拉回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020536,
					"content": "雖然這些東西也值些錢，但我們還得把它們拿出去賣掉才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020537,
					"content": "#對{F#妳}{M#你}這樣的旅行者來說，報酬肯定也是直接拿摩拉比較方便吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020538,
					"content": "#請{F#妳}{M#你}明天再過來一趟吧，到那時候，我會直接把摩拉給{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020532,
					"content": "如果有困難的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "妳在璃月的豪宅呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "豪宅？什麼豪宅，我在璃月還有豪宅的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				}
			]
		},
