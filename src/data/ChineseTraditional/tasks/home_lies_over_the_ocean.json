			"dialogs": [
				{
					"id": 728020601,
					"content": "女兒又跑哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020602,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "就算是工作，她走之前也會跟我們說一聲，但今天這孩子怎麼不聲不響地就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020605,
					"content": "#昨天晚上{F#妳}{M#你}離開之後，竺子說覺得很累，直接就回房睡下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020606,
					"content": "等到天亮之後，我們夫妻倆起床一看，她就已經不在自己的床上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020607,
					"content": "我們到處找也沒有找到女兒，我丈夫就直接到更遠的地方去找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020608,
					"content": "但我在這一帶找了半天，完全沒找見女兒的蹤跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020609,
					"content": "啊，這孩子不會又出去旅行了吧？真是叫人怎麼辦才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "滿"
				},
				{
					"id": 728020610,
					"content": "孩子她媽，別著急，我待會再去找找，妳先在家把竺子的房間掃一掃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020611,
					"content": "那孩子走的時候也不關好窗戶，搞得房間裡被吹進了一大堆樹葉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020612,
					"content": "#對了，旅行者，這些是說好的報酬，請{F#妳}{M#你}拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020613,
					"content": "唉，竺子這孩子到底又去做什麼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "滿"
				},
				{
					"id": 728020603,
					"content": "竺子又去工作了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
