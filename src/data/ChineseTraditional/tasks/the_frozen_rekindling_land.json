			},
			"dialogs": [
				{
					"id": 751491001,
					"content": "#咦，{REALNAME[ID(2)|SHOWHOST(true)]}，怎麼了，你發現什麼東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491002,
					"content": "呼嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491003
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491003,
					"content": "啊，這個雕像，不就是之前被絨翼龍抓著的雕像嘛，居然也一起掉下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491004,
					"content": "#看上去就像是一個團起來的…大耳朵{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491005,
					"content": "唔嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491006
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491006,
					"content": "是嘛，你覺得不像啊，我覺得還是滿像的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491007,
					"content": "啊…它動起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491008,
					"content": "喀…喀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491009
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491009,
					"content": "自我檢查執行中…關節處有些許積灰…儲存介質活化，話語…遠端提取…介入允許…喀喀…性格模組修正…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491010
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491010,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491011
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491011,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491012
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491012,
					"content": "原來不是雕像，而是什麼機關嗎…仔細一看，的確和秘源機關長得有點像，它身上飄著的奇怪的光，總覺得在哪看到過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491013,
					"content": "咦，怎麼了，怎麼不動了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491014,
					"content": "「嗚哇！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491015
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491015,
					"content": "嗚哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491016,
					"content": "「發聲模組看來沒有問題，好了，尊貴的客人們，我已經在此等候你們許久…怎麼了？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491017
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491017,
					"content": "怎麼突然發出這麼大的聲音，真是嚇人一跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491018,
					"content": "「那真是太好了，這樣的登場才能留下點印象，不然我還擔心你們會覺得自己受了冷落呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491019
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491019,
					"content": "咦，你是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751491020,
					"content": "「你問我是誰？嗯，這副身軀的名字叫厄卡特爾，你可以這樣稱呼，不過，名字在此地沒有太多意義…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491021
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491021,
					"content": "個體識別的稱呼，變更請求是…透過紀錄…在那場戰爭後的一百五十年…變更名為，戰亡名錄——厄卡特爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491022
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491022,
					"content": "「沒錯，自那以後，就叫厄卡特爾…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491023
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491023,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491024
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491024,
					"content": "「對，是我，我是『呼喚』你到來者，來吧，到聖山之心…在一切還為時未晚之前。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491025
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751491025,
					"content": "「不過還不用著急，先讓厄卡特爾為你開闢眼前的一點點黑暗…我知道你們心中還有疑惑，但先隨我來吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「厄卡特爾」"
				}
			]
		},
