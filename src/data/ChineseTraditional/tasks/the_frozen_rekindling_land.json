			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「厄卡特爾」",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490201,
					"content": "「我得事先說明，這裡原先沒有那麼暗…雖然，這裡毫無疑問是火山的『內部』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490202
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490202,
					"content": "「只不過在那場戰爭結束之後，整座城市被毀滅殆盡，那之後，作為巨大機構的所有功能都不得不停擺…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490203
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490203,
					"content": "戰爭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490204,
					"content": "「對，是殘存的龍裔與人類的戰爭，也是令原初執掌火焰的主人死去的戰爭…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490205
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490205,
					"content": "「這座城的主人已經死了，唯留這座城市依然苟活…不過也說不定，也許這座城市其實也早就死了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490206
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490206,
					"content": "「…又或者很多東西曾經存在，其實只不過是一種錯覺。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490207
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490207,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490208,
					"content": "「我們各取所需，小傢伙，你有來的需要，而我又希望依靠你的力量解決一些問題…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490209
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490209,
					"content": "「你們必須得到聖山之心去…但可惜因為之前的戰爭，整座聖山的力量也在戰爭中被封絕。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490210
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490210,
					"content": "「儘管那封絕之力在我看來猶如只困得住稚童的細索，但按照誓約，只有『人』才能夠將它們開啟…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490211
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490211,
					"content": "「有趣的事是，用了這樣的方法侵入聖山的可憐的孩子，最後可以說是毀於他人幾乎相同的手段。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490212
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490212,
					"content": "「呵呵，總是如此啊…就像暴君的追隨者們被英雄驅逐，經歷漫長的流浪，其後裔終結了另一個國度的暴君…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490213
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490213,
					"content": "「世事如同被人安排的戲碼那般，因果流轉，恩仇覆反，在支離破碎的歷史中輪番上演…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490214
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490214,
					"content": "「說遠了，來吧…啟動它，讓這座垂死的城再掙扎一番吧。現在，此世唯有你有這樣的資格。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「厄卡特爾」"
				}
			]
		},
		{
