						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "「我有向你們正式介紹它的名字嗎？似乎沒有…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490302,
					"content": "「但沒關係，歡迎，歡迎來到初始聖城{RUBY#[D]源火之地}圖蘭。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490303,
					"content": "哇，沒想到火山裡面，居然是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490304,
					"content": "這真的是火山裡嗎？不會是我們在穿過火山口的時候，被人偷偷送到了別的地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490305,
					"content": "唔…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "「這裡毫無疑問是聖山之內，不過即使是我…也不知道上一次看到如斯景象是什麼時候了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490307,
					"content": "「啊啊…在光芒重新照亮你時，我竟才發現你已這樣朽敗啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490308,
					"content": "厄卡特爾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490310,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "「哦，抱歉，只是陷入了沒有必要的感懷罷了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490312,
					"content": "介質儲能低…即將休眠，請及時替換或連接…儲能介質…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490313,
					"content": "「哈哈，看來長期『流亡在外』的厄卡特爾並不能撐更久了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490314,
					"content": "啊，難道，厄卡特爾要、要死掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490315,
					"content": "「厄卡特爾，擁有這個名字的傢伙早就不在了…長話短說，重啟圖蘭或許會消耗掉許多力量，不能白費，你們需要…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490316,
					"content": "「其他兩個『象擬{RUBY#[D]茲茲米特爾}聚星』，破壞其中一個的封印…和另一個」…「才能真正，開啟中央的天軸」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490317,
					"content": "「呃…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490318,
					"content": "你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "…「沒事，我們還會…再見面的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490320,
					"content": "「唉…向前吧，受龍所選者…啊，軀體失去生機的痛苦，即使許多年，我也…無法那樣適應…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490321,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "「厄卡特爾」"
				},
				{
					"id": 751490323,
					"content": "圍繞在它身邊的光消失了…唔，厄卡特爾也變得一動不動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490324,
					"content": "我還是沒太懂，那個說話的人到底是厄卡特爾，還是其實是別的人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490325,
					"content": "以後總會知道的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "對喔，不過，剛才他說什麼，「象擬聚星」，難道就是剛才的大火球？那天軸呢？不知道究竟是什麼東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490328,
					"content": "唔，我們就先到處看看，找找他說的那些奇怪的東西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751490329,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "現在就先繼續往前吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
		},
