			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聆聽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "你是楓原？快上船，我送你走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "聆聽"
				},
				{
					"id": 400670402,
					"content": "您…為什麼要幫我？我可是通緝犯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670403,
					"content": "當然是社奉…啊咳咳！是有人付了錢，說要把你安全送出稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "聆聽"
				},
				{
					"id": 400670404,
					"content": "不過，別人能幫的實在有限，後面的路還得靠你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聆聽"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
