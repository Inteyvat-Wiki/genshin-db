					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "萬葉，找到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671202,
					"content": "來得不快也不慢，剛剛好，容我想完了迄今為止的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671203,
					"content": "楓原家的盆景，你感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671204,
					"content": "古老，又有沉澱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "古老的東西，往往都伴隨著遺憾。楓原亦是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671206,
					"content": "但無妨，散也是聚。不在此處，便是在他鄉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671209,
					"content": "這片秘境很有趣，像戲劇一樣，每一齣都比上一齣更特別、更震撼人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671210,
					"content": "占星術士都是見多識廣的人。能讓你這樣說，這片幻境也不枉存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671211,
					"content": "喂，汝…心情如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400671212,
					"content": "小姐的意思是問候萬葉卿，希望你心情別太低落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400671213,
					"content": "回憶這樣的經歷，不可能高興的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671214,
					"content": "哈哈，說得也是。感謝各位的關心。幸好，這些事對我而言都是過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671215,
					"content": "#第一眼看見盆景，我就想到了這種可能性…我在等{F#妳}{M#你}們，或許這正是我被獨自留在終點的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671207,
					"content": "並不完滿，但你也無愧於它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4006713,
