					"聆聽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "喂老弟！你沒事吧！要不要上來避避難？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "聆聽"
				},
				{
					"id": 400671002,
					"content": "海盜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "聆聽"
				},
				{
					"id": 400671003,
					"content": "哈，沒錯，就是海盜！你就說，要不要來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聆聽"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
