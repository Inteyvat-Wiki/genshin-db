					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4005914",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "那盆瓷盆裡，應該有棵枯死的植物才對。但在這裡，枯木沒有出現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670502,
					"content": "#…{F#妳}{M#你}們不在的時候，我想了許多，總算是明白過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670503,
					"content": "這裡是我的幻境，盆景中空無一物，意味著它即是我的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670504,
					"content": "心中「淨」澈，萬物天地皆為「淨」；心至「空」處，天地萬物皆為「空」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670505,
					"content": "淨與空，便是我如今的心境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670506,
					"content": "不過，那也未必不是遺憾。心中缺損，亦作「空」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670507,
					"content": "所以這盆景才出現在我的幻想之中，給我機會完成心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670508,
					"content": "真沒想到，在我內心深處，竟然也想製作屬於自己的盆景…如此，才算是真正繼承了楓原的傳統吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
