				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "…沒想到，會在景色如此美妙的地方處理這種不可思議的事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670202,
					"content": "感覺如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "#還行。如果{F#妳}{M#你}能幫上我的忙就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670204,
					"content": "那具體需要我們做些什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670205,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670206,
					"content": "唔…唔…好像也沒什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670207,
					"content": "妳、妳小看我們？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670208,
					"content": "#不，我是剛剛才意識到，雖然{F#妳}{M#你}話不多，卻總是把事情辦得很漂亮，悄悄地為大家做了很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670209,
					"content": "#{F#妳}{M#你}這樣的人，應該是大家最需要的同伴。只要{F#妳}{M#你}在，好像就能放心許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670210,
					"content": "雖然擅自期待或許會給對方帶去壓力，但我認為…占星術士要有觀察力，而發現他人的優點，也是一種觀察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670211,
					"content": "所以妳只是想誇我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670212,
					"content": "#只是陳述事實而已，沒在誇{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670213,
					"content": "原來如此，莫娜不肯承認…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "不肯承認她在誇獎別人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670215,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}笑什麼，都說了是客觀評價，沒在誇{F#妳}{M#你}！沒——在——誇{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670216,
					"content": "#之後的日子裡，我會繼續觀測星象。保持聯繫，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
