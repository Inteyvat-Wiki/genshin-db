			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘟嘟通訊儀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "…似乎每次跟你見面都是這種情況呢。占卜、解讀、鎖定目標，再解決問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670102,
					"content": "你身邊圍繞著各種各樣的朋友、秘密和命運，真不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670103,
					"content": "對哦，萊納德事件也是跟莫娜和菲謝爾一起解決的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670104,
					"content": "對占星術士來說是好事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "勉強算是啦。但願這一回我們也能強強聯手，盡快解決問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670106,
					"content": "#強強聯手，是說{F#妳}{M#你}們倆，還是說我們三個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670107,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670108,
					"content": "好啦好啦，不會排擠妳的。有時候派蒙的眼光獨到又銳利，對我幫助很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670109,
					"content": "真的？我有點開始欣賞妳了，天才莫娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670110,
					"content": "對吧對吧？像我這樣聰明又迷人的占星術士，世界上再也找不出第二個了，哦呵呵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670111,
					"content": "妳什麼都好，就是能不能…不要學菲謝爾笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670112,
					"content": "咳！不好意思…跟朋友相處久了，難免受影響…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670113,
					"content": "#之後的日子裡，我會繼續觀測星象。保持聯繫，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
