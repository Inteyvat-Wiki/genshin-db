					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "呼啊，走了不少路，都有點睏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671302,
					"content": "大家都辛苦了，今天要不早點休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400671304,
					"content": "嗯？怎麼了，妳臉色不太好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671305,
					"content": "沒什麼。本皇女感到疲憊，或許是今日舟車勞頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400671306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400671307,
					"content": "小姐，您還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400671308,
					"content": "奧茲，不要多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400671309,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400671310,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671311,
					"content": "我去找找有沒有可以吃的東西，你們要是累了就先坐一會，還有精力的可以來幫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671312,
					"content": "我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671313,
					"content": "我也可以幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671314,
					"content": "別人都那麼積極，我們也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671315,
					"content": "那我和派蒙也來幫妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "不至於不至於，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671317,
					"content": "我看皇女殿下有些憂鬱，莫娜，妳跟她比較熟，不如陪她出去散散心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671318,
					"content": "原來妳也發現了。我剛想著趁準備食物的時候跟你們提一下這事呢。既然如此，那邊就交給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671319,
					"content": "好嘞，那我們幾個來準備食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671320,
					"content": "莫娜對我們眨眨眼，跑去陪伴菲謝爾了。剩下的人一起找了些能烹飪成佳餚的食材…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "嗯，這些就夠了，一會兒烤著吃吧。下回要是走過那些沒人的營地，可以找找有沒有燉鍋，這樣還能做菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671322,
					"content": "真周到呀！明明不是廚師，卻這麼會照顧人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671323,
					"content": "嘿嘿，做些力所能及的小事而已，不值得妳這麼誇啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671324,
					"content": "辛焱是連「死兆星號」的兄弟們都認可的好夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671325,
					"content": "嗯！我們眼裡萬葉也是這麼可靠的人哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671326,
					"content": "哈哈哈，說得好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671327,
					"content": "嗯…既然如此，我作為可靠的夥伴，剛巧有些話想說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671328,
					"content": "#聽{F#妳}{M#你}們說的，那片不可思議的幻境，根本是依照「楓原萬葉」迄今為止的人生創建而成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671329,
					"content": "…簡直像是我的一場夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671330,
					"content": "或許就是代表著「夢」呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "萬葉，你是不是…一直也想要完成屬於你的「盆景」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671332,
					"content": "是嗎…到頭來，居然是實現了我的願望嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671333,
					"content": "既然我會遇到這種情況，那是不是意味著，我們大家都有這種可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400671334,
					"content": "嗯，我也這麼想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "我也同意。只是，不知道下一個類似的場所會是跟誰有關的幻境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671336,
					"content": "哈，這麼一說，要是我也能有這樣的美夢該多好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671337,
					"content": "妳居然很想要這樣的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671338,
					"content": "如果我能擁有這樣的領域，應該會是跟音樂有關的東西吧。嗯哼哼，到時候就能一展身手啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671339,
					"content": "不會是要突然演奏吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671340,
					"content": "很正常吧？任何搞音樂的人來到這片群島，面對如此美景，不想來點音樂才奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400671341,
					"content": "好強健的心智、好樂觀的精神，我有點佩服了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671342,
					"content": "#啊對了！{NICKNAME}，我想吃山崖邊的水果，陪我去摘好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671343,
					"content": "（嗯？莫非…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "二位先忙，我陪派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4006714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006714",
							"2"
						],
						"stepId": 4006714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘟嘟通訊儀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "今天這些奇怪的房子，幻境一樣的…呃…盆景？總之就是那堆怪事啦！我覺得，是不是應該告訴溫迪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671402,
					"content": "我猜就是這件事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400671405,
					"content": "嘟嘟可——嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400671406,
					"content": "沒有回應…奇怪，他怎麼不理我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671407,
					"content": "不應該這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "難道說，溫迪又恍神了？還是演出期間沒把炸彈帶在身邊？又或者是喝醉了，正在大樹底下打盹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671409,
					"content": "唔…好奇怪，要不然…要不然明天再聯繫他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671410,
					"content": "#旅行者、派蒙，{F#妳}{M#你}們在這兒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671411,
					"content": "是莫娜！妳跟菲謝爾聊完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671412,
					"content": "啊哈哈，算是吧…她有點憂鬱，我猜…可能是跟今天遇到的幻境有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671413,
					"content": "菲謝爾對這次旅行非常積極，但我有種感覺，她似乎並不想見到屬於自己的幻境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671414,
					"content": "為什麼？她不是應該最嚮往這些事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671415,
					"content": "…還不能下結論，不過我會多留意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671416,
					"content": "#我是想跟{F#妳}{M#你}們說另一件事。剛才我在海邊又做了一次占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671417,
					"content": "水占盤依然渾濁，但不同的是，隱約能從中感覺到某股力量。我無法看清它的位置，但能感受到，它在變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671418,
					"content": "看不見要怎麼感受啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671419,
					"content": "#該怎麼給外行解釋呢…啊！{F#妳}{M#你}就理解成，屋裡有條裂縫，我們不知道它在哪裡，但有風漏了進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671420,
					"content": "不僅如此，屋裡的溫度也一直在下降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671421,
					"content": "哦！這麼說的話，我好像明白了。妳是想找出那條裂縫在哪裡對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400671422,
					"content": "可以這麼說。我需要先看到那條牆縫，才能決定接下來怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400671403,
					"content": "那我們來聯繫他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
}