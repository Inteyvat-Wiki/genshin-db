			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "這裡怎麼搞的，碎成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670302,
					"content": "…沒落的權貴之家，就是如此嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400670303,
					"content": "支離破碎，而且空無一人。應該是已經走到末尾了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400670304,
					"content": "走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
