			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "那萬葉想做的事，應該已經完成了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400670602,
					"content": "嗯，可以這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670603,
					"content": "#{F#妳}{M#你}們見證了過去的我，還與他告別。等{F#妳}{M#你}們親眼看完屬於我的一切，它們才真正成為歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670604,
					"content": "人一生最重要的是與他人的牽絆，而非對自己的苛責。駐足過去的人，不會有未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400670605,
					"content": "#所以請{F#妳}{M#你}們相信，我走到了這裡，也將繼續走下去。將來，就請各位多關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
