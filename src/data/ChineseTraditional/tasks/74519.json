					"諾艾爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "啊…前輩好！是來找琴團長的嗎？還是說…有什麼需要我幫忙的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190402,
					"content": "我只是在四處逛逛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "我正在做騎士團辦公區域的例行大掃除。目前灰塵已經基本上清理完成，接下來就是整理舊檔案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190405,
					"content": "那些文件堆積了很久，我想如果能夠分門別類歸檔，大家以後查閱起來就會方便很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190406,
					"content": "而且，整理前人的紀錄，也能學到很多東西。對我來說，這也是一種修行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190407,
					"content": "諾艾爾還是這麼認真可靠啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "這是我應盡的職責。而且，前輩和騎士團的大家都在不斷前進，我也想盡快追上你們的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190409,
					"content": "那麼為了紀念這份決心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "欸？前輩要拍畫片？我…當然非常樂意！但是我剛剛才結束掃除，身上還沾著灰塵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190412,
					"content": "我想拍的就是諾艾爾努力的樣子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "這、這個稱呼還是太早了！不過，既然是前輩想拍…那就算帶著灰塵，我也覺得很榮幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190415,
					"content": "那就請在前輩認為最適合的時機按下快門吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 745190413,
					"content": "這是女僕騎士的「決定性瞬間」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "我來幫妳拍一張畫片吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "諾艾爾又在忙什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
