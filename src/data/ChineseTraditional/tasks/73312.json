			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733120201,
					"content": "沒想到竟然變成這副模樣了…還真是可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120202
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120202,
					"content": "咦，斯露莎在說什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120203,
					"content": "沒什麼，不過是看到了一些同族終末的醜態罷了，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120204
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120204,
					"content": "唔，這種說法反而更讓人在意了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120205,
					"content": "讓我看看…喔喔，那邊有棵好奇怪的樹呢，團成一圈感覺就像是個門一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120206,
						733120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120206,
					"content": "要是穿過去的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120208
					]
				},
				{
					"id": 733120208,
					"content": "這麼一說，有點躍躍欲試了起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120209,
					"content": "…這些「靈谷木」並不是什麼門扉，若是冒冒失失地穿過去的話，可是會打擾到寄宿在其中的殘靈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120210
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120210,
					"content": "喔喔，原來是叫「靈谷木」嗎？不過妳說殘靈…明明什麼都看不到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120211,
					"content": "白飄飄當然看不到，畢竟這些殘靈還停留在過去的執念當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120212
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120212,
					"content": "雖說未必是其本心所願，不過這般執著於世的樣子，實在是慘不忍睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120213
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120213,
					"content": "明明看起來還很茂盛，感覺很親切呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120214,
					"content": "哼，白飄飄懂什麼，這些「靈谷木」乃是那些與侵害大地的汙穢戰鬥到最後一刻的花靈，用盡最後的力量所化而成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120215
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120215,
					"content": "耗盡了力量而無法維持形體，又因為沾染了汙穢而被花海所拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120216
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120216,
					"content": "傳說在古時矯論團會為她們舉行淨罪的儀式，使她們得以重回「甘露花海」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120217
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120217,
					"content": "不過如今矯論團早已無人能夠主持這樣的儀式，最多只能勉強維持這些「靈谷木」不至於枯死罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120218
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120218,
					"content": "但這也不過是延長了她們的痛苦，看她們如今的樣子，大概除了需要獨自忍受的苦痛追憶外，早已什麼都不剩了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120219,
						733120220
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120219,
					"content": "看來應該幫幫她們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120221
					]
				},
				{
					"id": 733120221,
					"content": "對啊，什麼獨自受苦，聽起來也太可憐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120222,
					"content": "說是這樣說，不過這也算是吾輩花靈的命運，說不定用這種方式守護大地也正是她們的願望呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120223
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120223,
					"content": "唔，雖然斯露莎是這樣想的啦，不過說不定她們會有不同的想法呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120224,
					"content": "畢竟如果是我的話，比起待在這種地方，還是更想回到花海和大家待在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733120225,
					"content": "白飄飄還真是看輕我們花靈了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120226
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120226,
					"content": "#哼，也罷，就姑且以吾之力量將其喚醒，讓{F#妳}{M#你}們聽聽她的終末之聲好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733120220,
					"content": "這樣說就是有解救的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120221
					]
				},
				{
					"id": 733120207,
					"content": "說不定會通往何處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733120208
					]
				}
			]
		},
