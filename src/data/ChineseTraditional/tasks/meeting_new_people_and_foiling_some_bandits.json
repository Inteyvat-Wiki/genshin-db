			"dialogs": [
				{
					"id": 710410401,
					"content": "就是這裡了，前輩。咳咳…真不巧，大門鎖上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410402,
					"content": "必須要同時拿到兩個鑰匙才能開門…唉，你們璃月人呀，總是在這種不知所謂的地方如此用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410403,
					"content": "少說些沒用的話啦…你看大門旁貼的通知單，好歹我們還是知道，炮彈確實在庫房裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410404,
					"content": "炮彈是一回事，我們還不知道引信的保存狀況呢？我看還是從長計議比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410405,
					"content": "好啦…你這傢伙不要說喪氣話了。什麼事都不做，只會烏鴉嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410406,
					"content": "況且我們何必要聽從一個盜寶團的質疑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410407,
					"content": "克里托夫說的不是沒有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "對呀，你們兩個就不要吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410410,
					"content": "哼…就聽前輩的。我們先繼續吧，說不定瑾武姐知道該如何打開庫房大門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
