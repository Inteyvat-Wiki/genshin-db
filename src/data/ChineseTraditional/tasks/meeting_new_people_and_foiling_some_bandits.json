			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫",
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "#呼…謝謝各位英雄，謝謝{F#妳}{M#你}們救了我一命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410102,
					"content": "等等…我認得你，你就是之前在礦上那個托克里夫吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410103,
					"content": "啊，不…那個不是我，我不賣假藥的。我是克里托夫，不賣藥的克里托夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410104,
					"content": "原來你賣的是假藥？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "#不是…怎麼可能！我賣的藥可都是貨真價實的大漢藥水！{F#妳}{M#你}看，礦工們喝了不也很有精神嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410106,
					"content": "你不是不賣藥的克里托夫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410107,
					"content": "啊…對，那是在我的賣藥生涯結束之後了…因為那個…對，都怪那個托克里夫，取了個假名招搖撞騙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410108,
					"content": "他用假名賣假藥，臭了我的名聲！所以我從此以後發誓，再也不賣藥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410109,
					"content": "結果剛改行沒多久，就讓這幫盜寶團的賊人給抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410110,
					"content": "這麼說，那個賣假藥的真是可恨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410111,
					"content": "對呀對呀，連賣藥的同行都騙，真是個壞人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410112,
					"content": "「托克里夫」的假名是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "克里托夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410114,
					"content": "…啊，不是…克里托夫不是假名，是真名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410115,
					"content": "那托克里夫就是假名囉…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410116,
					"content": "沒…是、是他冒用我的名字，所以克里托夫就成了假名，明白了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410117,
					"content": "喔…所以「托克里夫」就成了真名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410118,
					"content": "真可惜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "可惜什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410120,
					"content": "可惜你差點就不打自招囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410121,
					"content": "我們帶他上去吧，讓千岩軍的大哥們問問他到底怎麼回事好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410122,
					"content": "或者我們就在這裡解決掉他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "啥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410124,
					"content": "喂，不要突然開這種玩笑呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410125,
					"content": "哈，哈，笑死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410126,
					"content": "妳都沒在笑吧！這一點也不好笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410127,
					"content": "確實不好笑，因為我們要來真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "#請{F#妳}{M#你}冷靜點，前輩，現在不是拷問時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410129,
					"content": "#我可不想揹著一個被{F#妳}{M#你}們嚇暈的盜寶團跑來跑去…不管怎樣，先把他帶回營地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410131,
					"content": "#等等，我對{F#妳}{M#你}們很有用的！請帶上我一起探險吧！畢竟…{F#妳}{M#你}看，我已經被盜寶團掃地出門了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410132,
					"content": "現在我也多少算是…清白之身了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410133,
					"content": "原來這就算清白之身了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410134,
					"content": "你都會些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410135,
					"content": "唔…比如說…調配炸藥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410136,
					"content": "還是假藥嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410137,
					"content": "是炸藥，不是假藥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "不是假炸藥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410139,
					"content": "這次是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410140,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410141,
					"content": "#…我可沒權力讓{F#妳}{M#你}輕易入隊，怎麼處置{F#妳}{M#你}這樣的傢伙，得讓瑾武姐定奪。不過我猜她也只會把{F#妳}{M#你}移交千岩軍的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410142,
					"content": "但是我們會好好盯著你的。盜寶團的傢伙，怎麼看都覺得不應該信任。更何況是賣假藥的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410143,
					"content": "都說過我不賣假藥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410144,
					"content": "哎呀知道啦！我們快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410130,
					"content": "很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
			"completionStepIds": [
				7104109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104109",
							"2"
						],
						"stepId": 7104109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫",
					"派蒙",
					"志瓊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "…閉鎖機構還沒有生鏽，有潤滑油的痕跡…似乎在封礦之後也有人護理過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410302,
					"content": "炮栓也是完好的…只是保險機處於閉鎖狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410303,
					"content": "聽不懂…那是什麼呀，咒語嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710410304,
					"content": "前方的礦道先前撤離礦工時被人用巨石封堵了…看起來這門炮又要派上用場囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410305,
					"content": "沒有炮彈的話，大炮就形同虛設。我們還需要找到炮彈才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710410306,
					"content": "哼…別說得好像我不知道一樣，聰明鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410307,
					"content": "附近有一處庫房，那裡大概儲存著炮彈…希望當年撤離的時候沒有把炮彈也都搬走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710410308,
					"content": "我們出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克里托夫"
				}
