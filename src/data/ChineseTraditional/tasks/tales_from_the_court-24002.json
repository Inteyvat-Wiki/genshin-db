	"talks": [
		{
			"id": 2400201,
			"completionStepIds": [
				2400201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
