							3473.039,
							424.581,
							4601.303
						],
						"pointId": 4424
					}
				]
			},
			"dialogs": [
				{
					"id": 240020201,
					"content": "伊莎朵小姐，有什麼事需要我幫助嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020202,
					"content": "繆妮警官，我想請問一件事。您還記得早上我抱著一疊帳單來辦公室嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020203,
					"content": "記得，您不是還被紫金漁鷗襲擊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020204,
					"content": "對、對！在那群討厭的紫金漁鷗飛走之後，我就趕快跑進辦公室了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020205,
					"content": "請您回憶一下，在我跑走之後，有帳單被我遺落在地上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020206,
					"content": "唔…我不太記得了，那個時候我也要處理其他工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020207,
					"content": "如果您真的很著急，我可以陪您進行一遍「重演」。也就是順著您上班的路，重新倒著走一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020208,
					"content": "欸？可以嗎？這也太麻煩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020209,
					"content": "只不過是找東西而已，和沫芒宮裡的那些事情相比，可以說是十分輕鬆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020210,
					"content": "伊莎朵小姐，我記得您懷裡抱著的文件都是捆成一疊一疊，是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020211,
					"content": "是的！您的眼力真好。因為費用審算時，申報條目需要十分精確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020212,
					"content": "大到請工匠過來整修沫芒宮外牆，小到辦公室桌子的抽屜換了一個鎖，都需要列出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020213,
					"content": "所以幾乎每個月的審算帳單都厚厚一疊，必須要用繩子捆好才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020214,
					"content": "所以，不可能出現「某一頁帳單飛出去」的情況，就算是掉了，也是厚厚一疊文件掉在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020215,
					"content": "現在離您來辦公室上班的時間不久…我們馬上出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "繆妮"
				}
			]
		},
		{
