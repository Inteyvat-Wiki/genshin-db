				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "這就是我要找的文件！全都在這，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020402,
					"content": "妳為什麼會在咖啡店做帳啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "因、因為我要喝很多咖啡，才能算清楚帳啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020404,
					"content": "這裡可是整個沫芒宮內所有辦公室的公務費用帳單，本來應該是五個人一起做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020405,
					"content": "但除了我之外，其他人總是被其他辦公室借用，要嘛去做外勤，要嘛去做訪問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020406,
					"content": "結果到了要審算的時候，整個辦公室就只有我一個人在算帳，我都好幾天沒有睡過覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020407,
					"content": "不僅要算帳，就連對帳的工作都交給了我，我都要眼花了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020408,
					"content": "總之，帳單找到了就好。伊莎朵小姐，我陪您回沫芒宮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "繆妮"
				},
				{
					"id": 240020409,
					"content": "謝謝您。唉，繆妮警官，在最近的三個月裡，我只遇見了您和這位旅行者兩位好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020410,
					"content": "其他人不是對我大喊大叫，就是只會催我去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020411,
					"content": "不行、不行。不能抱怨了，我必須快點回去，不然凱澤小姐又要唸我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊莎朵"
				}
			]
		}
	]
}