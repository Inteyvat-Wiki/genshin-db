			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊莎朵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "咦？去哪了？真是倒楣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020102,
					"content": "糟糕了，我是沒有辦法再寫一份的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020103,
					"content": "妳弄丟什麼東西了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "是的，我是一個樂觀的人，希望那個東西真的只是我弄丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020105,
					"content": "這…能算是樂觀想法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "哈哈…畢竟我要找的那個東西是辦公室半年度公務費用審算帳單嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020108,
					"content": "這一批帳單馬上就要提上去給凱澤小姐入帳了，但我卻突然發現這批帳單裡少了五頁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020109,
					"content": "而且這五頁分別來自五個不同的月份，包含了許多費用支出項目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020110,
					"content": "我剛才在最後一次統審的時候，發現這幾個月份的帳單不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020111,
					"content": "如果這些帳單不是我意外弄丟，而是根本沒做的話…那最後的這個公務費用總額，我又是怎麼算出來的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020112,
					"content": "嗚…不能接著往下想了，如果真的是我漏算了，那加德梅小姐一定會逼我把之前十年內做的所有帳都翻出來重新核對一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020113,
					"content": "聽起來還滿嚴重的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "是啊。要是真的漏算或者遺失的話，到了下個月，應該會有好幾個辦公室發生撥款問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020115,
					"content": "真是倒楣…我只記得我昨天熬夜做好了帳單，今天早上帶著它們來到沫芒宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020116,
					"content": "走到這裡的時候，遇見了一大群的海鷗，我被嚇了一跳，手也鬆了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020117,
					"content": "唉，說不定就是那個時候把文件弄丟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020118,
					"content": "我幫妳找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "您願意幫忙嗎？那就太好了，我們一起順著這條路去找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020121,
					"content": "這些數據不涉及什麼秘密內容，所以您撿起來的時候也大可放心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020122,
					"content": "對了！我來的時候還遇見了繆妮警官！她還幫我趕走了海鷗喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020123,
					"content": "我們去問問她，有沒有看見帳單吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊莎朵"
				},
				{
					"id": 240020119,
					"content": "我們一起找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "弄丟了東西反而是好事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
		{
