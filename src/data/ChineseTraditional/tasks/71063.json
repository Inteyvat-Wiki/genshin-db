			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐無仇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630101,
					"content": "哼哼，怎麼成天有人覬覦我的琉璃百合大花園，要是再有偷花賊膽敢靠近，我就必要讓他們嘗嘗古華派武功的厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐無仇"
				}
			]
		},
		{
			"id": 7106302,
			"completionStepIds": [
				7106302
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106302",
							"2"
						],
						"stepId": 7106302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐無仇",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630201,
					"content": "#{F#妳}{M#你}們是何方宵小之徒！可不知此處的這些花已是名花有主！豈可隨意採擷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630202
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630202,
					"content": "還不速速住手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630203
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630203,
					"content": "啊！難道說，這些花是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630204,
					"content": "正是我慧眼發現，從三日前開始細心呵護的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630205
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630205,
					"content": "原來不是你種的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630206,
					"content": "咳咳，雖然不是我所種，但是現在已經屬於我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630207
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630207,
					"content": "我甚至在心中暗中發誓，必要認真培育這些花，在此處打造一個美麗非凡的琉璃百合大花園。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630208
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630208,
					"content": "咦，琉璃百合大花園…靠這些花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630209,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630210,
					"content": "#怎麼了？{F#妳}{M#你}以為本大俠是個不識風雅的庸人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630211
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630211,
					"content": "#看來{F#妳}{M#你}也不過是個以貌取人之徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630212
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630212,
					"content": "你說要建一個琉璃百合大花園，可是這些花是清心，不是琉璃百合喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630213,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630214
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630215
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630215,
					"content": "…哼哼哼哼哼，哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630216
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630216,
					"content": "#我懂了，{F#妳}{M#你}們是想說這些假話來動搖我的意念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630217
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630217,
					"content": "#我可是古華派第三百二十代傳人唐無仇，{F#妳}{M#你}以為這樣就能夠騙過我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630218,
						710630220
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630218,
					"content": "古華派有那麼多代嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630219
					]
				},
				{
					"id": 710630219,
					"content": "#{F#妳}{M#你}竟敢質疑古華派的悠久歷史，還不速速納命來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630220,
					"content": "明明穿著盜寶團的衣服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630221
					]
				},
				{
					"id": 710630221,
					"content": "哼，衣服不過是身外之物罷了，真正能夠決定一個人的是他的內心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630222
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630222,
					"content": "#我古華派弟子唐無仇，今天就要替天行道，將{F#妳}{M#你}這偷花賊擊退，好教{F#妳}{M#你}們知道古華派的厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "唐無仇"
				}
			]
		},
		{
			"id": 7106303,
			"completionStepIds": [
				7106304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106304",
							"2"
						],
						"stepId": 7106304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐無仇",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630301,
					"content": "痛痛痛痛痛，我錯了我錯了，別再打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630302
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630302,
					"content": "這個人的武功真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630303,
					"content": "十分稀爛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630304
					]
				},
				{
					"id": 710630304,
					"content": "#沒想到我苦修這麼多載，還是不如{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630305
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630305,
					"content": "啊這個，正所謂好馬配好鞍，好船配好帆…不對，呸呸呸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630306
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630306,
					"content": "正所謂寶劍配英雄，這朵琉璃百合就送給英雄您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630307
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630307,
					"content": "都說了這是清心啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630308,
					"content": "對對對，是清心是清心，您說啥就是啥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630309
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630309,
					"content": "你真的是古華派的嗎…嗯，你認不認識一個人，名字叫行秋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630310,
					"content": "行秋此名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630311
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630311,
					"content": "我是聞所未聞啊，怎麼，難道這個叫行秋的傢伙自稱古華派弟子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630312
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630312,
					"content": "那怎麼能讓他敗壞我古華派的聲名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630313
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630313,
					"content": "（看來他真的不是古華派的人…而且，敗壞古華派聲名的人不就是他自己嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630314,
					"content": "等等，等等，你口口聲聲說自己是古華派的人，有什麼證據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630315,
					"content": "那當然是有證據的，看，我身上這枚玉佩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630316
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630316,
					"content": "這枚玉佩…是古華派代代相傳的寶物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630317,
					"content": "這枚玉佩我一位老友在分別時賣於我，我心中暗自決定，這以後就是我們古華派代代相傳的寶物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630318
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630318,
					"content": "戴上這枚玉佩以來，每次我練武，腦內都會有隱約刺痛之感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630319
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630319,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630320,
					"content": "怎麼想都是這枚玉佩有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630321,
					"content": "怎麼可能，我佩戴這枚玉佩的第一天，就有仙人入夢，授我古華派絕學，說明我與這玉佩有緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630322
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630322,
					"content": "而且腦內的刺痛感，是精神逐漸漲大成長之痛，小說裡都寫了，這是意念在逐漸加強的前兆，怎麼會有問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630323
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630323,
					"content": "難道…好啊，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630324
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630324,
					"content": "…哼哼哼哼哼，哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630325
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630325,
					"content": "#我明白了，{F#妳}{M#你}們其實想要這一塊玉佩…只是不好意思開口，藉口說這玉佩有問題，還真是道貌…咳咳…還真是委婉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630326
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630326,
					"content": "這塊玉佩可是我古華派的至寶，即使是您二位，想要從我手中奪去此寶，那也得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630327
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630327,
					"content": "那也得拿什麼價格相同的來換吧，比如什麼鴿子蛋大小的寶石之類的…不然我這個古華派三百二十代傳人面子上可掛不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630328
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630328,
					"content": "#{NICKNAME}，看來就是這塊奇怪的玉佩讓他以為自己是古華派傳人，還這麼瘋瘋癲癲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630329,
					"content": "要是他一直帶著那個玉佩，還在那麼高的地方，肯定會出事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630330,
					"content": "他不是要我們拿什麼鴿子蛋大小的寶石換嘛，他這樣看起來也沒法分辨好壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630331,
					"content": "我們就，給他幾個鳥蛋試試好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7106304,
			"completionStepIds": [],
