			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老臭",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710631001,
					"content": "哎呀，兩位，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631002
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631002,
					"content": "#{F#妳}{M#你}們是不是也想來玩挖寶的遊戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631003
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631003,
					"content": "哼，今天我們倆過來，是有別的事要找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631004,
						710631005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710631004,
					"content": "這枚玉佩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710631006
					]
				},
				{
					"id": 710631006,
					"content": "啊，這枚玉佩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631007
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631007,
					"content": "確確實實是從我這裡脫手賣出去的…來，讓我看看，這質地，這水潤，這透亮，這不是我賣給唐無仇的那一枚嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631008
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631008,
					"content": "這枚玉佩的材質，看起來就和別的貨不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631009
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631009,
					"content": "我當時還想靠著這個大賺一筆呢，結果被唐無仇一眼看中，賴死賴活地，就便宜賣給他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631010
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631010,
					"content": "這種材質的只有這一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710631011,
					"content": "我倒是還想再翻出來第二個呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631012
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631012,
					"content": "唉…幸好只有這一個，這個材質的礦石富含元素力，如果是沒有「神之眼」的人接觸了，就會性格大變，滿嘴胡話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710631013,
					"content": "唐無仇現在以為自己是古華派的大俠，每天瘋瘋癲癲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710631014,
					"content": "啊？怎、怎麼會這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631015
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631015,
					"content": "仔細一看，這確實就是傳說中會讓佩戴之人產生不適的「翠玨岩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631016
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631016,
					"content": "以前就曾聽老一輩人說過，說是「翠玨岩」雖然寶貴，但要是長時間貼身攜帶，往往攜帶者都會遭受厄運，邪門得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631017
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631017,
					"content": "是我害了老唐啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631018
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631018,
					"content": "唉，我和老唐以前都是盜寶團的，之前在層岩巨淵幹了一票，大家決定分道揚鑣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631019
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631019,
					"content": "唐無仇不知道跑哪去了，可是我…唉，我被以前盜寶團的人找到，受他們脅迫，買他們在這做的劣質首飾，在璃月轉手賣出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631020
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631020,
					"content": "美其名曰幫忙銷售，可是他們做的…是材料比得上「盛露廳」啊，還是造型打製比得上「明星齋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631021
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631021,
					"content": "還不是要我幫他們做出來的玩意保本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631022
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631022,
					"content": "可憐我是低價再低價，賠了本，才賣得出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631023
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631023,
					"content": "之前賺的錢全都賠了進去…好在那群爺可能醒悟過來，直接賣材料還賣得貴些，最近終於不來找我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631024
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631024,
					"content": "唉，說遠了…唐無仇的事我也很抱歉，但是我現在值錢的東西，都、都被我埋在土堆裡了，好做些小生意賺點錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631025
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631025,
					"content": "#不如這樣，這次就讓{F#妳}{M#你}們挖一次寶，挖出什麼，就帶給唐無仇算作賠禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631026
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631026,
					"content": "怎麼樣，要不要聽一下這個挖寶怎麼玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631027,
						710631028
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631027,
					"content": "不用了，我知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710631032
					]
				},
				{
					"id": 710631032,
					"content": "那，不如現在就開始來一局吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631028,
					"content": "行啊，你說一下規則吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710631029
					]
				},
				{
					"id": 710631029,
					"content": "簡而言之，就是每個土堆下面都有些好東西，但是也有炸藥…不過不用擔心，都是些長時間沒人用的啞彈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631030
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631030,
					"content": "#要是能挖到寶貝，就給{F#妳}{M#你}們，算作給老唐的賠禮，原本要是挖到炸彈就算輸了，不過這次嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631031
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631031,
					"content": "#算了，等{F#妳}{M#你}們挖到再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710631032
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710631005,
					"content": "這是你這裡賣的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710631026
					]
				}
			]
		},
