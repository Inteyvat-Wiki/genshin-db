					"唐無仇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630401,
					"content": "#怎麼樣，要是能拿出等價的事物，我要換給{F#妳}{M#你}，也不是不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630402
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630402,
					"content": "（那就給他一枚鳥蛋吧……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106305,
			"completionStepIds": [
				7106306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106306",
							"2"
						],
						"stepId": 7106306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"唐無仇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630501,
					"content": "這個給你，換你那枚玉佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630502,
					"content": "這可是…這可是鳥蛋大小的寶石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630503,
					"content": "鳥蛋大小？我原本以為鴿子蛋大小的寶石已是登峰造極，沒想到還有鳥蛋大小的寶石呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630504
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630504,
					"content": "嘿嘿，拿一個玉佩換回如此大的一枚寶石，真是穩賺不賠啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630505
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630505,
					"content": "#這也多虧我古華派素有仁義之心…咳咳，看{F#妳}{M#你}們求寶心切，才願意做這樣的交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630506
					],
					"speakerTitle": "唐無仇"
				},
				{
					"id": 710630506,
					"content": "唐無仇將玉佩取下，遞了過來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106306,
			"completionStepIds": [
				7106307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106307",
							"2"
						],
						"stepId": 7106307,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"3"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_FINISHED"
					}
