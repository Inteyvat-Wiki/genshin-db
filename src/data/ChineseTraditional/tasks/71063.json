			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老臭",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710630601,
					"content": "哎呀，兩位，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630602
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630602,
					"content": "#{F#妳}{M#你}們是不是也想來玩挖寶的遊戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630603
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630603,
					"content": "哼，今天我們倆過來，是有別的事要找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630604,
						710630605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630604,
					"content": "這枚玉佩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630606
					]
				},
				{
					"id": 710630606,
					"content": "啊，這枚玉佩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630607
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630607,
					"content": "確確實實是從我這裡脫手賣出去的…來，讓我仔細看，這質地，這水潤，這透亮，這不是我賣給唐無仇的那一枚嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630608
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630608,
					"content": "這枚玉佩的材質，看起來就和別的貨不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630609
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630609,
					"content": "我當時還想靠著這個大賺一筆呢，結果被唐無仇一眼看中，賴死賴活的，就便宜賣給他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630610
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630610,
					"content": "這種材質的只有這一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630611,
					"content": "我倒是還想再翻出來第二個呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630612
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630612,
					"content": "唉…幸好只有這一個，這個材質的礦石富含元素力，如果是沒有「神之眼」的人接觸了，就會性格大變，滿嘴胡話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630613,
					"content": "唐無仇現在以為自己是古華派的大俠，每天瘋瘋癲癲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710630614,
					"content": "啊？怎、怎麼會這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630615
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630615,
					"content": "仔細一看，這確實和傳說中會讓佩戴之人產生不適的「翠玨岩」十分相像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630616
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630616,
					"content": "以前就曾聽老一輩人說過，說是「翠玨岩」雖然寶貴，但要是長時間貼身攜帶，往往攜帶者都會遭受厄運，邪門得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630617
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630617,
					"content": "是我害了老唐啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630618
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630618,
					"content": "唉，我和唐無仇以前都是盜寶團的，之前在層岩巨淵幹了一票，大家決定分道揚鑣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630619
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630619,
					"content": "唐無仇不知道跑哪去了，可是我…唉，我被以前盜寶團的人找到，受他們脅迫，買他們在這做的劣質首飾，在璃月轉手賣出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630620
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630620,
					"content": "美其名曰幫忙銷售，可是他們做的…是材料比得上「盛露廳」啊，還是造型打製比得上「明星齋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630621
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630621,
					"content": "還不是要我幫他們做出來的玩意保本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630622
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630622,
					"content": "可憐我是低價再低價，賠了本，才賣得出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630623
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630623,
					"content": "之前賺的錢全都賠了進去…好在那群爺可能醒悟過來，直接賣材料還賣得貴些，最近終於不來找我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630624
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630624,
					"content": "他們都被潛入的千岩軍剿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630625
					]
				},
				{
					"id": 710630625,
					"content": "向老臭告知千岩軍搗毀走私窩點的始末…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710630626
					]
				},
				{
					"id": 710630626,
					"content": "剿得好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630627
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630627,
					"content": "說要向千岩軍告我的案底，哼，這下自己進去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630628
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630628,
					"content": "唉，說遠了…唐無仇的事我也很抱歉，但是我現在值錢的東西，都、都被我埋在土堆裡了，好做些小生意賺點錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630629
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630629,
					"content": "#不如這樣，這次就讓{F#妳}{M#你}們挖一次寶，挖出什麼，就帶給唐無仇算作賠禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630630
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630630,
					"content": "怎麼樣，要不要聽一下這個挖寶怎麼玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630631,
						710630632
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630631,
					"content": "不用了，我知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630636
					]
				},
				{
					"id": 710630636,
					"content": "那，不如現在就開始來一局吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630632,
					"content": "行啊，你說一下規則吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630633
					]
				},
				{
					"id": 710630633,
					"content": "簡而言之，就是每個土堆下面都有些好東西，但是也有炸藥…不過不用擔心，都是些長時間沒人用的啞彈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630634
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630634,
					"content": "#要是能挖到寶貝，就給{F#妳}{M#你}們，算作給老唐的賠禮，原本要是挖到炸彈就算輸了，不過這次嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630635
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630635,
					"content": "#算了，等{F#妳}{M#你}們挖到再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710630636
					],
					"speakerTitle": "老臭"
				},
				{
					"id": 710630605,
					"content": "這是你這裡賣的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710630630
					]
				}
			]
		},
