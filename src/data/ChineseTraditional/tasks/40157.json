		{
			"id": 4015705,
			"completionStepIds": [
				4015705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4015705",
							"2"
						],
						"stepId": 4015705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鹿野院平藏"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3615.737,
							201.872,
							-906.978
						],
						"pointId": 321000267
					}
				]
			},
			"dialogs": [
				{
					"id": 401570501,
					"content": "#哎呀呀！{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570502
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570502,
					"content": "嗚哇！是阿忍！還有平藏！你居然也來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570503,
					"content": "#真是意外又不那麼意外之喜啊。我剛才還在和阿忍小姐說，感覺馬上就會遇到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570504
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570504,
					"content": "#呵呵，鹿野院同心剛才一路提到{F#妳}{M#你}們好幾次。這就叫念念不忘，必有迴響吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570505
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570505,
					"content": "是直覺啦，直覺。我習慣在關鍵的時候想到關鍵的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570506
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570506,
					"content": "很高興見到你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570507
					]
				},
				{
					"id": 401570507,
					"content": "真沒想到，平藏居然是我們之外第一個到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570508,
					"content": "老大叮囑了我，給天領奉行的邀請函要盡快，他特別邀請了九條裟羅大人和鹿野院同心兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570509
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570509,
					"content": "那…那裟羅怎麼沒來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570510,
					"content": "肯定是因為她完全不想見到一斗老兄吧，畢竟邀請函上最後寫著：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570511
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570511,
					"content": "「九條天狗！跟本大爺在珊瑚宮之巔來一場熱血燃情搖滾相撲吧！！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570512
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570512,
					"content": "如果我是九條裟羅大人，一定想要把老大從珊瑚宮頂上推下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570513
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570513,
					"content": "然後心海會把裟羅也推下去吧？在她頭頂上叮呤哐啷的簡直吵死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570514,
					"content": "哈哈哈，總之，我覺得九條裟羅大人脾氣還是太好了點，她還送給我們一筐堇瓜作為賀禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570515
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570515,
					"content": "脾氣好嗎？嘿嘿，我怎麼覺得，那個女人另有深意呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570516
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570516,
					"content": "什麼深意啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570517,
					"content": "「荒瀧小鬼跟我一斗？奉行之所堇瓜管夠。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570518
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570518,
					"content": "什麼嘛，平藏你也太有心眼了吧！我看你們帶來了兩筐堇瓜，另一筐是不是你送的？是不是也另有深意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570519,
					"content": "哈哈，另一筐是奉行所裡的大家湊的啦。有我，有抓過一斗老兄的其他同心，還有一斗老兄的一些獄友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570520
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570520,
					"content": "所以這筐堇瓜的祝福大概就是「要常來找我們玩哦！」的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570521
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570521,
					"content": "這種祝福還是不要讓老大聽見為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570522
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570522,
					"content": "嗯，送到了堇瓜，還見到了想見的人，我也差不多該要先走一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570523
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570523,
					"content": "咦？平藏不參加活動了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570524,
					"content": "放心，我不會錯過最後的慶典，只是現在還要去離島辦點事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570525
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570525,
					"content": "還要去離島啊，當偵探真忙…欸對了！平藏聽過戰場中的忍犬嗎？好像就是在離島流傳起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570526,
					"content": "噢…那隻狗啊。是不是這次音樂節的靈感來源？阿忍小姐倒是有跟我介紹過主題和故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570527
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570527,
					"content": "好吧，我以為奉行所會知道什麼內情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570528,
					"content": "但按經驗…我猜這只是個鄉野傳說，根本沒有什麼狗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570529
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570529,
					"content": "#怎麼？{NICKNAME}，看{F#妳}{M#你}的表情，好像有點在意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570530
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570530,
					"content": "有意思…不如我順便打聽打聽吧，反正我要去趟離島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570531,
						401570532
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570531,
					"content": "會不會影響你辦事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				},
				{
					"id": 401570533,
					"content": "#這種話就太客氣了。{F#妳}{M#你}在意的東西，我通常都很感興趣哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570534
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570534,
					"content": "嘿嘿，那等我消息吧，回頭見了各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570535
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401570535,
					"content": "鹿野院同心果然是個自由的行動派啊，我也該繼續去送邀請函了，不管怎麼說，最後的慶典晚會才是重點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570536
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570536,
					"content": "那我們也不能落後，不知道待完成清單怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570537,
					"content": "久等了兩位，請收好這份清單。之後按照這個來就沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570538
					],
					"speakerTitle": "德沃沙克"
				},
				{
					"id": 401570538,
					"content": "#太好了，大叔來的正是時候！{NICKNAME}，這下我們也可以準備準備出發了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401570539,
					"content": "請兩位費心了。如果想要演奏樂曲放鬆一下，我就在樂曲排練區等著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德沃沙克"
				},
				{
					"id": 401570532,
					"content": "需要付委託費嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				}
			]
		},
		{
