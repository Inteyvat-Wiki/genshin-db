					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "兩位，這一天終於來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900102,
					"content": "#對於「花影瑤庭」的構圖之道，{F#妳}{M#你}們已經領會到了精髓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900103,
					"content": "是時候來一場花藝的真劍試煉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900104,
					"content": "等等？原來我們已經領會到精髓了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900105,
					"content": "真劍試煉的意思是最難的題目吧！我突然有點害怕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900106,
					"content": "明明接觸插花的時間還不長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "製作花材的手法的確需要長期的磨練，而規劃「花庭」的圖景與結構，更側重意會和靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900108,
					"content": "只論後者，兩位的確表現出了驚人的天賦，不再需要「花題」的錘煉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900109,
					"content": "或許是因為，兩位經歷過迷人的旅程，見證過我無法想像的景致，才有了不同於平凡之人的心境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900110,
					"content": "是，是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900111,
					"content": "#說起來，{NICKNAME}，我們的確去過不少地方了呢，原來一起旅行的過程中，我們也會獲得更多靈感啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900112,
					"content": "那這段時間，我們一直在學習花藝，又消耗掉了多少靈感呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900113,
					"content": "旅程還會繼續下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "嗯，有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900116,
					"content": "謝謝妳，柴染小姐！要不是有妳指點，我們還沒發現我們居然有這方面的才能呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900117,
					"content": "不必客氣。請用至美的「花庭」為這次的花藝體驗之旅劃上句點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900118,
					"content": "請出題吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "那麼，今天的花題是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900120,
					"content": "「斜枝宛虹，繪染斑彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900121,
					"content": "#期待著{F#妳}{M#你}們技藝大成的「花影瑤庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900122,
					"content": "還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "沒關係。「插花」需要安神定氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900124,
					"content": "等到二位忙完手頭的事，擺脫了喧擾，必定能將題中的「花庭」構築得更加完滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900114,
					"content": "靈感會越來越多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269003",
