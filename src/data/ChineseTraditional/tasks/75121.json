			"trigger": {
				"objectNames": [
					"黑田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "有人託我來找兩本書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "#{F#妳}{M#你}向黑田描述了茜特菈莉想要的絕版書。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "《轉生成為雷電將軍，然後天下無敵》的第一版和《拜託了我的狐仙宮司》的限量精裝版…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210104,
					"content": "#不得不說，{F#妳}{M#你}的這位朋友真的很專業。談到收藏價值，目前八重堂發行的書籍都比不上這兩本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210105,
					"content": "這樣的讀者我竟然不認識，真是遺憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210106,
					"content": "現在還有辦法找到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "無論哪一本都不可能再從市面上找到了，庫存更不用說，早就被搶購一空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210108,
					"content": "不過，我這裡剛好各有一本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210109,
					"content": "我可以花錢買。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "#不不，這兩本藏書還是在{F#妳}{M#你}那位朋友手裡更能體現它們的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210111,
					"content": "#就讓我把這兩本作為禮物送給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黑田"
				}
			]
		}
	]
}