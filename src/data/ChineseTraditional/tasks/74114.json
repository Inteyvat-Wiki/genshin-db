			"dialogs": [
				{
					"id": 741140201,
					"content": "唉，那些映影畫片不會被水泡壞吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140202,
					"content": "放心吧老闆，這個箱子可牢靠了，水滲不進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 741140203,
					"content": "還好我們的映影機沒有掉進水裡，不然就完蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "興曄"
				}
			]
		},
