					}
				]
			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}，向您介紹，這就是那位映影大師，熱塞爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140602,
					"content": "#熱塞爾先生，這是{NICKNAME}，一位身手高強的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140603,
					"content": "#您要是以後準備拍武打類的映影，{NICKNAME}絕對能做一號演員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140604,
					"content": "呵呵，邱老闆也說得太誇張了，我並不是什麼映影大師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140605,
					"content": "我只不過是對映影中的光影運用方式略有研究罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140606,
					"content": "哎呀，您太謙虛了。您那些映影裡的光影，簡直都能開口說話啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140607,
					"content": "映影中光影的運用方式？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "是的。在我的映影理論中，光影的運用，即是情緒的運用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140611,
					"content": "但是…怎麼說呢，現在楓丹的映影界裡，我的這種理論目前還沒有受到重視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140612,
					"content": "大部分導演還是更喜歡用直接的動作，或者場景來表達映影故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140613,
					"content": "我拍攝了好幾部用純粹的光影變化敘事的映影，幾乎沒有人有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140614,
					"content": "但是現在，總算有一位導演認為我的光影理論有價值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140615,
					"content": "導演？我？哈哈哈，您別開玩笑了，我之前只是個賣茶葉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140616,
					"content": "誰說賣茶葉的商人不能做導演？我之前還只是一位記者啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140617,
					"content": "記者…那您之前，肯定也很擅長寫報導？就是報紙上的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140618,
					"content": "算是吧。怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "熱塞爾"
				},
				{
					"id": 741140619,
					"content": "嗯…那正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140620,
					"content": "啊！沒什麼！沒什麼！我們之後合作的時間還多的是啊，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140621,
					"content": "在邱老闆爽朗的笑聲中，大家都入了座。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "#吃完飯後，邱老闆又額外做了一份食物，打包完後，塞進了{F#妳}{M#你}的背包裡…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "光影在映影裡很重要嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "當然了。在我的映影理論中，光影是表達畫面情緒的重要方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "熱塞爾"
				}
			]
		},
