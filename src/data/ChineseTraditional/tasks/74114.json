			"dialogs": [
				{
					"id": 741140401,
					"content": "這鍋還真是奇特，唔…但用法應該和璃月的一樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140402,
					"content": "老闆，菜都買回來了，但那家店裡的茉潔草都賣光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140403,
					"content": "我一時半刻也找不到其他店賣這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140404,
					"content": "#這…就差這一份食材。那個，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140405,
					"content": "我去拿一點回來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "#多謝您幫忙。放心，我懂冒險家的規矩，絕不會讓{F#妳}{M#你}白跑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140406,
					"content": "一起算進報酬裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
