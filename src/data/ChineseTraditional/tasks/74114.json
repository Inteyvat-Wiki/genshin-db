			"dialogs": [
				{
					"id": 741140301,
					"content": "#哎喲，還是您可靠，{NICKNAME}。還是您可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140302,
					"content": "要是沒您幫忙，這一整箱的映影畫片全得泡湯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140303,
					"content": "我們得先回城裡，把這些映影畫片交給熱塞爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140304,
					"content": "#然後…再順便吃頓飯。{NICKNAME}，如果您有興趣的話，也請一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140305,
					"content": "等吃完了飯，我再把報酬給您結清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140306,
					"content": "好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "行！那事情就這麼定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140309,
					"content": "弈豐，等會你去把這箱子映影畫片帶去交給熱塞爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140310,
					"content": "興曄…你去周圍買點好菜。我最近研究了一下那道白淞鮮湯，今天正好給熱塞爾先生露一手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140311,
					"content": "老闆，我們都去飯館吃飯了。您為什麼非得自己動手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140312,
					"content": "這不是…便宜嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140313,
					"content": "咳！事情就這麼定了，趕緊出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}，您就跟著我走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140307,
					"content": "剛好餓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
