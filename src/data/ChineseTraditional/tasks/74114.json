			"dialogs": [
				{
					"id": 741140101,
					"content": "沒關係，我們的那個箱子是防水的。現在我們只需要潛下去，把箱子撈上來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140102,
					"content": "老闆，但我們三個人誰都不會潛水啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140103,
					"content": "我是會游泳，但潛水真的一竅不通啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 741140104,
					"content": "我們…上次去冒險家協會發佈的委託，還掛在委託板上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140105,
					"content": "老闆，你上次不是說要我們趕緊去把那委託給撤了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 741140106,
					"content": "我們昨天才把這件事給辦了，協會那邊說，今天就能把我們預付的委託費給退回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140107,
					"content": "呃…如果我們想重新發佈委託，要交額外的手續費嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140108,
					"content": "你們拍好映影了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#冒險家…{NICKNAME}，您真是我們的及時雨啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140111,
					"content": "您會潛水嗎？或者說，您能幫忙找一位有空來幫忙的潛水員嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140112,
					"content": "你們要…到水下拍映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "我們可沒那個本事，也買不起防水的映影設備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 741140114,
					"content": "只是單純因為，我們裝映影畫片的箱子掉進水裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140115,
					"content": "#好了，你們倆個少說兩句吧！{NICKNAME}，請您務必幫幫忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140116,
					"content": "報酬的事您不用擔心，和上次一樣，當面給您結清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 741140109,
					"content": "你們怎麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
