			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "健康之家乃阿彌利多學院下屬的醫療服務機構，為須彌內外居民提供免費醫療。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940702,
					"content": "該處執業醫師皆獲得生論派授予的行醫許可，診療方案提供虛空多次審核，為百姓提供最專業、最安全的服務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940703,
					"content": "請廣大居民切勿相信來路不明的醫師，以免人財兩空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
