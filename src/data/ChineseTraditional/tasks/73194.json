			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "特別提醒，整個須彌的傭兵行業都由「鍍金旅團」承接，絕無別家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940602,
					"content": "請勿輕信他人，以防被來頭不明的人騙取傭金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940603,
					"content": "如需僱傭保鏢、守衛亦或有其他需求，請聯繫「三十人團」掌旗官魯克沙或透過教令院聯絡員阿芬迪派發委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
