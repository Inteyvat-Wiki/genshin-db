			"dialogs": [
				{
					"id": 731940801,
					"content": "請勿在城裡人多的地方攜帶過多的金錢，以防遭遇偷竊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940802,
					"content": "如若發生財物被竊，也請不要向附近巡邏的鍍金旅團求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940803,
					"content": "因為很可能正是他們拿走了你的錢財。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
