				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "既然教令官以後不用這個地方發公告了，那就正好當作我們蘭巴德酒館的留言板吧，以後有什麼事情大家都可以在這留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731941102,
					"content": "「老闆，我之前訂的十箱酒到貨了嗎，昨天我按約定時間來的結果沒拿到。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731941103,
					"content": "怎會如此！之前有個金髮的傢伙自稱是你的室友，已經把酒全都提走了。我記得你們還一起來過呢，該不會是搞錯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731941104,
					"content": "「…好的，我知道了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
