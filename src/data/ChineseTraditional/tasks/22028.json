			"trigger": {
				"objectNames": [
					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#大姐姐}{M#大哥哥}！{F#妳}{M#你}聽我說！{F#妳}{M#你}聽我說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280102,
					"content": "上次供奉了神龕以後，我的願望真的實現了…一小部分！雖然只有一部分…但這肯定是神明的回應吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280103,
					"content": "你許的是什麼願望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "呃…我上次許的願望是，希望神明讓我看的那冊漫畫的作者再畫快點，最好兩天出一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280105,
					"content": "然後，那個作者真的在一期裡更新了兩倍的量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280106,
					"content": "不過…據說接下來就要連續休刊三期了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280107,
					"content": "這實現願望的方式還真是均衡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "唔…不管怎麼說，神明應該是已經聽見我的願望了。之所以沒有完全實現，肯定是因為我供奉得不夠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280110,
					"content": "所以今天，我們就把其他地方的神龕也供奉了吧！這樣神明大人肯定會完全實現我的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280111,
					"content": "我問過爸爸和媽媽了，這附近還有兩個神龕，一個在木漏茶室附近，一個在出城的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280112,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}覺得我們先去哪個神龕比較好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280108,
					"content": "感覺反倒是少刊了一期啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
