			},
			"dialogs": [
				{
					"id": 220280501,
					"content": "就是這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280502,
					"content": "我聽人說，很久以前，有一位同心大叔向這個神龕供奉了許多紙鶴，許願花見坂的大家都能平平安安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280503,
					"content": "後來這附近發生了一場火災，有一棟屋子著了火，但那棟屋子本來就是偷工減料建的，一下子就被火燒完塌掉了，火勢根本沒來得及向外蔓延…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280504,
					"content": "大家都覺得，這是神明大人在保佑呢…嘿嘿，所以我還專門折了紙鶴帶過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280505,
					"content": "先不說這些了！這一次，我們供奉什麼比較好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280506,
					"content": "和同心大叔一樣，供奉紙鶴的話，或許也能得到回應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280507,
					"content": "不過我覺得，這個神龕既然是在茶室附近，那供奉抹茶味的金平糖會不會更有誠意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280508,
					"content": "唔，而且我還挺喜歡吃抹茶味金平糖的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280509,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
