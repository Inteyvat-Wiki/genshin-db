					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280803,
					"content": "明天我就來看看，有沒有什麼特別的跡象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280804,
					"content": "#對了，謝謝{F#妳}{M#你}陪我到現在，這些東西給{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "翔太"
				},
				{
