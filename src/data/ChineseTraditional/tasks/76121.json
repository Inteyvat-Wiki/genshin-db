			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "這樣對嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540302,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540303,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540304,
					"content": "月亮…月亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "這裡怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "這次是我贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "我的三個月亮連起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "嗯，這樣就贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "嗯…月升月落，真是漫長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "我們的月亮誰都不讓誰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "是不是…快平手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "#原來{F#妳}{M#你}喜歡深思熟慮後再做決定，嗯，沒事，我們有很多時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "#忘了怎麼將「月亮」放上「夜空」嗎？要不要我幫{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "不喜歡這個遊戲嗎？我覺得還滿有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "#嗯？{F#妳}{M#你}是在盯著我看嗎？我感覺得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "我的臉上…有關於「月亮」的答案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "棋盤在那邊哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "#嗯，是{F#妳}{M#你}的「月亮」獲勝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "#這片夜空屬於{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "啊…一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "與哥倫比婭在遊戲中度過了一段愉快的時光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "三個月亮連成一條線…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210203,
					"content": "怎麼了？還在想剛剛那盤棋的輸贏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210204,
					"content": "哦，沒有。只是…如今回頭看這遊戲，會有些不可思議的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210205,
					"content": "對哦，妳獲得了三個月亮的力量，那已經不只是能主宰夜空這種等級的東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210206,
					"content": "嗯，我也會想，若是當初三位月之女神沒有產生分歧的話，世界的命運說不定就變得不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210207,
					"content": "她們看起來如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "唔…我最先見到的是虹月女神，桑娜妲。她比我想像中活潑一些，像個貪玩的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210209,
					"content": "恆月女神艾莉亞是三位女神中最穩重的一位，富有領導力，對他人也很溫柔。啊，就像菈烏瑪一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210210,
					"content": "霜月女神卡儂…看起來是位既智慧，又有遠見的女神，也就是她把自己的月亮讓給了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210211,
					"content": "聽起來都是善良的神明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "沒錯，儘管有所分歧，但她們都愛著提瓦特這個世界，愛著這個家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210213,
					"content": "當我說起未來的事情，她們看起來都很欣慰。一種為這個世界仍有如此豐富的未來感到高興的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210214,
					"content": "也正因如此，她們才給予我力量，幫我回到了這個「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210215,
					"content": "唔…真想見她們一面，對她們好好道一聲謝呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210216,
					"content": "我也這麼想，不過…那大概是不可能的事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210217,
					"content": "好在這個世界仍在前行，她們所保護的人類也活了下來，傳唱著她們的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210218,
					"content": "沒錯！只要好好地過日子，不讓壞蛋毀了這個世界，就是對三位女神最好的感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210219,
					"content": "妳還真會說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "那派蒙每天都在感謝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "那當然！我絕對每天都會把日子過得開開心心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210222,
					"content": "哥倫比婭也是哦！每天都應該吃飽睡好，想玩遊戲了就來找我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210223,
					"content": "哈哈，好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210224,
					"content": "以後玩「月亮棋」的時候，我或許都會想起那三位善良的女神吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
