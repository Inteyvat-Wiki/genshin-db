			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210102,
					"content": "哥倫比婭，妳好啊，妳今天心情很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210103,
					"content": "哈…上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210104,
					"content": "噢！妳是又想玩「月亮棋」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210105,
					"content": "嗯，很久沒玩了，有點想念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210106,
					"content": "規則還和以前一樣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "不會因為妳變成了三月女神，每次妳都能多動幾顆棋子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210108,
					"content": "那就變成作弊了，我不會用這種方式贏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210109,
					"content": "嘿嘿，我知道的啦，開個小玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210110,
					"content": "那麼，我們開始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
		{
			"id": 7612102,
