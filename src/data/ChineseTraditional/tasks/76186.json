			"dialogs": [
				{
					"id": 761860101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860103,
					"content": "…「霜月之子」，最近還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860104,
					"content": "還不錯。月神的回歸，也讓我們堅定了自己應走的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860105,
					"content": "是嗎？那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860108,
					"content": "哈…果然我們之間還是聊不了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860109,
					"content": "這…恐怕是因為「霜月之子」與「愚人眾」之間，有過太多不愉快的過往了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860110,
					"content": "從我個人的角度來說，自然是感激桑多涅小姐妳在保護挪德卡萊和迎回月神上的付出。但對其他人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860111,
					"content": "我懂。曾經的種種原因，讓我們沒能建立良好的友誼，哪怕是互利關係也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860112,
					"content": "可是現在「愚人眾」不再從「霜月之子」手中渴求什麼了，我也提醒過自己的部下不要對「霜月之子」有所刁難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860113,
					"content": "從我個人的角度來說，既然大家都是鄰居，就算做不到和諧共處，也還是以互相尊重的態度交往為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860114,
					"content": "這恐怕需要時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860115,
					"content": "當然。但不如從一次次嘗試開始吧——嚐嚐我泡的香草茶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860116,
					"content": "香草茶？哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860117,
					"content": "嗯…居然能做到如此醇厚…是「霜月之子」的泡法？我記得外面的人不喜歡這種喝法，妳是怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860118,
					"content": "學習。還有尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860119,
					"content": "哈…看來，這的確是一次不錯的嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860120,
					"content": "希望合妳口味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860121,
					"content": "嗯，我很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860122,
					"content": "茶飲間的禮尚往來，向來都是鄰居間友好相處的良好開端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860123,
					"content": "我想，這次也不例外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				}
			]
		},
