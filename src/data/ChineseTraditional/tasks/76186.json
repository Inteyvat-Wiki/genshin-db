			},
			"dialogs": [
				{
					"id": 761860201,
					"content": "十分美味的香草茶，桑多涅小姐。我從中感受到了妳的用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761860204,
					"content": "好。下次就換我邀請妳來「霜月之子」品茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761860203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
