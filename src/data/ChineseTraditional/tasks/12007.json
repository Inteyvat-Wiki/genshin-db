			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "這就是高人的居所嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070102,
					"content": "嗚…怎麼感覺涼颼颼的呀…真有人住在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070103,
					"content": "我、我也覺得有點意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070104,
					"content": "奇怪，筆記上說的確實是這裡沒錯啊，難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070105,
					"content": "也許我們搞錯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "嗚…內心有點動搖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070108,
					"content": "不過既然已經走到這裡，我認為，我們還是應該進去一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070109,
					"content": "嗯，也有道理，萬一有什麼驚喜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070110,
					"content": "對了，那本筆記上是怎麼說的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070111,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070112,
					"content": "「鶴銜來<color=#00E1FFFF>一</color>朵裝飾髮梢的鮮花，白兔將<color=#00E1FFFF>四</color>片月光縫成裙擺，我打扮得當，<color=#00E1FFFF>向著東方</color>喊了<color=#00E1FFFF>七</color>聲椿的名字，轉眼便站在去往她家的小徑上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070113,
					"content": "好像童話故事一樣…難道說，妳媽媽以前就是這樣讓「椿」出來迎接她的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070114,
					"content": "越來越像仙人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "總覺得，也像是某種暗號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070116,
					"content": "我們靠近一點再判斷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070117,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070106,
					"content": "說不定是狐狸神使？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
