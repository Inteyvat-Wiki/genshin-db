					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "到這裡就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070302,
					"content": "快看看筆記裡寫了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070303,
					"content": "嗚~會不會是神秘寶藏呀，好期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070304,
					"content": "派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "怎麼了？突然那麼小聲，搞得我也緊張起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070306,
					"content": "我們到旁邊去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070308,
					"content": "原來是不想打擾綾華看筆記啊，看來，那本筆記真是有來頭的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070309,
					"content": "不過看她的神情…大概不是藏寶圖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070310,
					"content": "唔，裡面會有什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070311,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070312,
					"content": "呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070313,
					"content": "#旅行者，派蒙，抱歉讓{F#妳}{M#你}們久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070314,
					"content": "才一下子而已，妳已經看得很快啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070315,
					"content": "筆記看完了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "嗯，看完了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070317,
					"content": "#我想，我應當和{F#妳}{M#你}們分享這本筆記的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070318,
					"content": "雖然，裡面的內容跟我想的完全不同就是了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070319,
					"content": "不同？這不是狐狸神使的筆記嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070320,
					"content": "不是狐狸神使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070321,
					"content": "「椿」的真身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070322,
					"content": "就是我的母親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070323,
					"content": "哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070324,
					"content": "很驚訝對吧？我、我也很驚訝…但這本筆記一開始便這樣寫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070325,
					"content": "「椿與平時的我既相同又不同，身為椿時，我不是神里華代，而是一個最最平凡的女子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070326,
					"content": "「以下所有，僅僅是一個普通的我所記錄的生活瑣事罷了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070327,
					"content": "筆記中寫的，大多是母親平日裡私密又瑣碎的小心思…那些我們以為與「椿」有關的事，其實也是她的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070328,
					"content": "意思是說，設計圖紙跟異國料理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070329,
					"content": "嗯，都是我母親想要嘗試的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070330,
					"content": "#或許對{F#妳}{M#你}們來說有些奇怪，但對我而言，非常能夠理解母親的這種行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070331,
					"content": "倒不如說，其實…其實我自己也有這樣的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070332,
					"content": "看筆記的時候甚至有點不知所措，就好像是我的一些想法被人看穿了、寫到筆記上一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070333,
					"content": "綾華…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070334,
					"content": "母親嫁給我父親之後，就一直以神里家主母的身分掌管各項事宜。社奉行身分相對尊貴，需要打點的方面非常多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070335,
					"content": "不僅如此，她的一舉一動都代表著神里家族。人們總是注視著她，在這種情況下，她一定沒有太多時間去做自己想做的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070336,
					"content": "父母過世後，我和哥哥接手了神里家的一切。期間遇到的許多困難，可能對外人來說有點難以想像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070337,
					"content": "每當我遇到麻煩事，總是會想：母親當年是否也這樣做過？這樣的事，她會怎麼處理呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070338,
					"content": "或許，真是太久沒見她了吧。不知不覺中，就連我的記憶裡也幾乎只剩下母親威嚴和高貴的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070339,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "但…這是不對的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070341,
					"content": "當我看到這本筆記，就意識到了…她和我完全一樣，無論我們背負著怎樣的職責，也都只是一介普通人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070342,
					"content": "喜歡漂亮的著物、想品嚐每個地區的美食、渴望不曾見過的美景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070343,
					"content": "#也許{F#妳}{M#你}們聽見這樣的話會笑我不夠成熟，但…我確實也有這樣的想法。不是身為神里綾華，而是以一個尋常女子的身分去生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070344,
					"content": "母親寫到，她一直想參加稻妻本地的民間祭典。她說，天氣晴朗的夜晚，自家中向遠方眺望，偶爾能看見祭典的燈火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070345,
					"content": "我也看到過喔！非常熱鬧，人很多，燈籠裡的火非常明亮，能照亮大片夜空…有時我們還要擔心那裡的治安問題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070346,
					"content": "只是，以我們的身分，貿然參加祭典或許並不合禮數。尤其在我父母的時代，社奉行與民眾的關係還沒有那麼親近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070347,
					"content": "就算沒有人限制我們，社奉行的人突然出現在人群中，大家多少也會投來異樣的眼光吧。會想著，我們去那裡是要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070348,
					"content": "母親說，她不想讓別人感到拘謹，希望大家盡情享受祭典的快樂與自由…她不願打擾別人，也沒有那麼多閒暇，便一次都沒有去過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070349,
					"content": "原來是這樣…所以那張設計圖紙上畫的是她打算穿去祭典的衣服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070350,
					"content": "是的。祭典上有時會售賣異國料理，那些也是她想要嘗試的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070351,
					"content": "說來有些冒昧，但…真沒想到我的媽媽也有這麼少女心的一面呢，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070352,
					"content": "才不冒昧呢，我認為，妳媽媽是個可愛又有責任心的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070353,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070354,
					"content": "不知不覺中，我為母親完成了一些願望。唯獨去祭典一事，我無法替她完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070355,
					"content": "似乎…也沒有機會見到她完成這件事了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070356,
					"content": "妳已經做得很棒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "嗯，我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070359,
					"content": "#…謝謝{F#妳}{M#你}們，我好像明白了一些事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070360,
					"content": "母親和我，在某些方面是完全一樣的。她所面臨的事，同樣也是我將要面對的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070361,
					"content": "她把無法實現的事寄託在「椿」身上，而我…已經下定決心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070362,
					"content": "咦！難道妳也要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070363,
					"content": "不，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070364,
					"content": "我不打算用這樣的方式。我想…我有了新的目標，我會不留遺憾地度過每一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070365,
					"content": "那個…旅行者，我…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070366,
					"content": "呼…放鬆，放鬆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070367,
					"content": "#{F#妳}{M#你}對我們這裡的祭典有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070368,
					"content": "從看到海報開始，我就一直想去喔！綾華是不是也有興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070369,
					"content": "綾華，妳也沒去過祭典嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "啊啊，請不要笑話我！我、我也曾擔心過那些事…不過，已經不要緊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070371,
					"content": "#我打算真誠地面對自己的心，完成這個同樣屬我的願望。如果是{F#妳}{M#你}的話，一定不會責怪我的任性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070372,
					"content": "#我想…我想請{F#妳}{M#你}和我一起去祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070373,
					"content": "我非常樂意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "要去要去！祭典上肯定有很多好吃的吧？還有好玩的，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070375,
					"content": "#…太好了，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070376,
					"content": "現在去的話，應該還能趕上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070377,
					"content": "對喔，今天好像是最後一天吧？還等什麼，快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070357,
					"content": "不是綾華的問題喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}