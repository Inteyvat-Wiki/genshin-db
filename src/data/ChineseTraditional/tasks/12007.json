			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "開了嗎開了嗎？有沒有仙人留下的財寶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070202,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070203,
					"content": "唔…這是書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070204,
					"content": "看起來也是本筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070205,
					"content": "難道這會是「椿」的筆記嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070206,
					"content": "各位，我們還是到外面去吧。這裡氣氛跟我想的有些不同，總覺得…不太想在這裡翻開這本筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070207,
					"content": "說得對，光線不好容易看壞眼睛喔。走吧走吧，去外面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
