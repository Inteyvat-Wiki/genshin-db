			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1876.556,
							59.205,
							8977.04
						],
						"pointId": 12625
					}
				]
			},
			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}，{F#妳}{M#你}來{F#妳}{M#你}來，有好東西要給{F#妳}{M#你}看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690102,
					"content": "#{F#妳}{M#你}看，這些都是我在旅行路上拍的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690103,
					"content": "#我們又走過了好多地方，在{F#妳}{M#你}四處探路的時候，我也沒有閒著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690104,
					"content": "#{F#妳}{M#你}看，這些都是我拿自己的留影機拍下的畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690105,
					"content": "#對了，{F#妳}{M#你}還記得我們在達莫維百貨買過兩本留影冊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690106,
					"content": "記得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "#我就知道{F#妳}{M#你}還記得，當時我可是提前好久、拿出存了好久的零錢才預訂到那兩本留影冊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690111,
					"content": "那兩本留影冊我們兩個人一人一本，款式一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690112,
					"content": "#我的那本里已經有好厚好厚的一疊畫片，不知道{F#妳}{M#你}的那本有沒有拍滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690113,
					"content": "#我剛買了一本新的留影冊，本來打算留作備用的，但如果{F#妳}{M#你}的留影冊已經拍滿了，就拿去用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690114,
					"content": "派蒙喜歡留影嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "#對啊，{F#妳}{M#你}想，我們一起走過了那麼多地方，看過了那麼多普通人想都不敢想的風景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690116,
					"content": "如果不留一些紀念下來，就太可惜了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690121,
					"content": "而且，更重要的是，這是我們兩個人的重要回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690122,
					"content": "過去的回憶和未來的經歷都要好好珍惜，這句話是嵴鋒龍部落的帕加爾大叔跟我說的，很有道理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690123,
					"content": "#這次，我就再把自己的留影機借給{F#妳}{M#你}，再多留下一些畫片好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690124,
					"content": "馬上就要踏上至冬的領土了，我總有種預感，下一段旅程可能不會很輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690125,
					"content": "在那之前，好好地整理一下我們一路旅行感受到的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690126,
					"content": "這樣不管碰到什麼困難，只要想起我們共同經歷的點點滴滴，一定會充滿勇氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690117,
					"content": "派蒙真大度！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "哼哼，那還用說，全提瓦特最好的嚮導派蒙身上可不只有大度這一種優秀品質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690119,
					"content": "特意多買一本留影冊其實也是因為我喜歡留影嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690120,
					"content": "我們一起旅行的路上見過了那麼多特別的風景，不留下一點紀念實在太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690108,
					"content": "不記得了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "欸，居然不記得了嗎？當時我可是提前好久、拿出存了好久的零錢才預訂到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690110,
					"content": "#算啦，{F#妳}{M#你}每天要操心的事也滿多的，寬容大度的嚮導派蒙我不會介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}