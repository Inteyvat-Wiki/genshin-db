			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "「從『三十人團』退休後，我每天都會來這裡喝一杯咖啡。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011102,
					"content": "「每天代理店長都會幫我泡同一種咖啡，說書人也會講同一個故事。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011103,
					"content": "「或許這樣的周而復始才是須彌生活的真諦吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "「瑪達赫先生的說書題材內容雖然老套，不過在對故事節奏的把握上還是相當老練的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011202,
					"content": "「只不過現在大家都已經習慣了透過虛空獲取資訊，習慣性地忽視了這些技術上的『考究』與藝術形式上的『熟成』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011203,
					"content": "「這就是你所言甚虛了，一切藝術形式皆有定時，一旦其能創造的『實利』被剝削殆盡，也就到了被淘汰的時日。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011204,
					"content": "「正如果實到了爛熟的時刻，就應該降解進入土壤，為新的植物提供養料。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011205,
					"content": "「所以我一貫蔑視你這樣的實利主義者，藝術創作來源於寶貴的閒暇，怎麼能與目的為商業消費的生產和剝削等同呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011206,
					"content": "「閒暇的人就像球狀大地上行走的人，是不存在的。不如你自己動腦好好想想，有誰的生產活動能夠離開商業交換？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011207,
					"content": "「兩位的紙上爭論還是一貫的犀利呢…不過卡維先生這個月的帳單該結了哦，仍舊是記在艾爾海森先生帳上嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011208,
					"content": "「不，我要讓這個被慣壞了的傢伙體驗一下商業社會的險惡。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011209,
					"content": "「代理店長小姐，這個人的欠帳麻煩記在桑歌瑪哈巴依老爺帳上，畢竟咖啡要足夠才能好好玩藝術嘛！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
