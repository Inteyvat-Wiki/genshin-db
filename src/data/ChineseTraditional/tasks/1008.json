			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "仙人饒命！仙人饒命…求仙人網開一面，放我們兄弟一條生路，仙人饒命，仙人饒命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080202,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}…{F#妳}{M#你}是誰？怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080204,
					"content": "明明是我們在提問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080205,
					"content": "啊！您能在這絕雲間安全行走…我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080206,
					"content": "您一定是…仙使吧！是仙人派您來解救我兄弟的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080207,
					"content": "這個人到底在說什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080208,
					"content": "仙使慈悲，求仙使搭救！我們兩兄弟只因實在無錢供養家裡，又聽人說，琥牢山中的琥珀藏有寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080209,
					"content": "一時間犯了糊塗，只想從山中琥珀裡尋得幾件寶物，賣了錢，再回去接濟家裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080210,
					"content": "我們<color=#00E1FFFF>順著山路</color>一路往上，但不曾想，我兄弟李當就突然被琥珀給…給吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080211,
					"content": "我一路奔逃到了這裡，細細想來，只怕是我們衝撞了仙家府邸，這是仙人下的懲誡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080212,
					"content": "我不知道如何搭救我兄弟，只能在此求仙人開恩…懇求許久，才等來了二位仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080213,
					"content": "仙使？我們不是什麼仙使，我們也是來找仙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080214,
					"content": "#不，不不不，{F#妳}{M#你}們肯定是仙使，{F#妳}{M#你}們肯定是仙使！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080215,
					"content": "李當被關在山裡不知道哪個琥珀裡面，求仙使慈悲，求仙使搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080216,
					"content": "好吧…我去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "好，好！謝謝仙使慈悲，我等以後再也不敢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080218,
					"content": "本仙知道了，此後莫再犯糊塗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "#嗚哇…{F#妳}{M#你}還真的入戲了，而且還挺有「仙使」氣勢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080220,
					"content": "謝謝仙使，謝謝仙使，我等以後再也不敢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
