			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "#我都聽我兄弟說了，謝謝{F#妳}{M#你}們，謝謝{F#妳}{M#你}們搭救我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089702,
					"content": "唉，我們也是迫不得已，實在是無錢供養家庭，又聽人說，琥牢山上的琥珀中藏有寶物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089703,
					"content": "我們就鬼迷心竅，偷偷上山，想從琥珀裡尋得幾件寶物，拿回去賣點錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "李當"
				},
				{
					"id": 10089704,
					"content": "#結果…您也看到了，仙人對我施以懲誡，我就被琥珀給吞了下去，如果沒{F#妳}{M#你}們搭救，還不知道什麼時候能出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "李當"
				},
				{
					"id": 10089706,
					"content": "仙，仙使？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "本仙知道了，此後莫再犯糊塗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "#還好仙人慈悲，派下{F#妳}{M#你}們這兩位仙使搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089707,
					"content": "#是啊，我剛在山上祈禱，{F#妳}{M#你}們就搭救了我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089708,
					"content": "#{F#妳}{M#你}們一定是仙人派下來的仙使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李當"
				},
				{
					"id": 10089710,
					"content": "#…嗚哇，{F#妳}{M#你}怎麼入戲這麼快，不過…確實挺有「仙使」氣勢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089711,
					"content": "是，是，我們兄弟受教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089712,
					"content": "蒙仙使搭救，我們兄弟以後一定痛改前非，去尋個正路賺錢，哪怕是去碼頭賣點力氣，也是個說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089713,
					"content": "啊，對了，可不能再叨擾仙府，我們這就下山，謝謝仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089714,
					"content": "謝謝仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "李當"
				},
				{
					"id": 10089715,
					"content": "…要是我們真是什麼「仙使」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080609,
					"content": "總感覺，這位仙人的脾氣不太好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080610,
					"content": "不過我們也沒有做什麼壞事，應該也不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089601,
					"content": "擅擾山門，又私放受誡賊人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10089602,
					"content": "無知凡眾，還不速速前來領誡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水疊山真君"
				}
			]
