			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "謝謝仙使，謝謝仙使救我兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080602,
					"content": "你們見過仙人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "啊？我們…我們也只是聽說，這琥牢山是仙人府邸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080604,
					"content": "但我們這種凡夫俗子，自然是無緣得見仙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080605,
					"content": "不過您貴為仙使，肯定與我們不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080606,
					"content": "啊，對了，可不能再叨擾仙府，我們這就下山，謝謝仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080607,
					"content": "謝謝仙使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "李當"
				},
				{
					"id": 10080608,
					"content": "…要是我們真是什麼「仙使」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080609,
					"content": "總感覺，這位仙人的脾氣不太好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080610,
					"content": "不過我們也沒有做什麼壞事，應該也不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10089601,
					"content": "擅擾山門，又私放受誡賊人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10089602,
					"content": "無知凡眾，還不速速前來領誡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水疊山真君"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"理水疊山真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "…不僅闖入「琥牢山」，毀壞山上琥珀，還擅放了正受誡的賊人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080702,
					"content": "#這幫賊人確是不曉仙威，但{F#妳}{M#你}們，也同樣無禮至極。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080703,
					"content": "嗚啊！我們，我們是有理由的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080704,
					"content": "請看這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "…「百無禁忌籙」，沒想到世間還有此物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080708,
					"content": "哦？這是「百無禁忌籙」？世間居然還有此物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080709,
					"content": "昔日帝君鑄此神籙，賜予凡人，本就數量稀少，千百年來也散失得差不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080710,
					"content": "#{F#妳}{M#你}們先陳明詳情吧，我會聽{F#妳}{M#你}們說的，稍後我會查證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080711,
					"content": "璃月港也並不遠在天邊，若有虛言，也騙不過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080712,
					"content": "帝君…遇刺了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080713,
					"content": "還是在「請仙典儀」上？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080714,
					"content": "璃月…凡間…誰敢如此！不…這世上又有多少力量，能刺殺帝君？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080715,
					"content": "我等眾仙遵帝君律令，護佑璃月。因人間興盛，逐步退於山野，這本是對凡人的好意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080716,
					"content": "但如今…帝君…帝君…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080717,
					"content": "#旅者，{F#妳}{M#你}述之事我已知曉。削月築陽真君延請我等的意思，也已經很明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080718,
					"content": "待我將此山之事稍作處理，就去會見眾仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080719,
					"content": "話說，那些琥珀是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "我知道！一定是這位仙人的仙力啦，就和小說裡寫的一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080721,
					"content": "羽毛就能化為草木，唾液也能化為瀑流。這些琥珀，一定也是類似的形成原理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080722,
					"content": "類似「燕窩」的原理嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "…這又是什麼說法。這些琥珀，來自於我植下的花，名叫「踱山葵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080725,
					"content": "它本身大部分隱於地下，若被踩到，就會生出琥珀，將入侵者包裹在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080726,
					"content": "我歸隱到此處後，為了山門清靜，將它種植在四周，這些年為我擋了不少滋擾，不過，也關了許多莫名的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080727,
					"content": "所以，這些「琥珀」，其實都是…活的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10080728,
					"content": "正是如此。所以，若我離開此山，只怕害了無辜性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080729,
					"content": "#我稍作處理後，就會動身。{F#妳}{M#你}們自行速速離去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水疊山真君"
				},
				{
					"id": 10080723,
					"content": "…呃，有點噁心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "是削月築陽真君讓我們來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "削月築陽真君…他託凡人帶口信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水疊山真君"
				}
			]
		},
