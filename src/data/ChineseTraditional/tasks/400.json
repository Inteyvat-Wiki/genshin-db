	"talks": [
		{
			"id": 39607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"40001",
							"2"
						],
						"stepId": 40001,
						"stateName": "QUEST_STATE_UNFINISHED"
