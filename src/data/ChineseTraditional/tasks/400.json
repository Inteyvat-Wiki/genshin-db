				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "想多聊些什麼的話，就趁現在聊吧。因為吟遊詩人，可不會總在同一個地方駐唱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960702,
					"content": "關於特瓦林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "特瓦林…到最後也還記得「四風守護」的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960704,
					"content": "所以，我也並不打算強行卸下他身上的責任、把我理解的「自由」強塞給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960705,
					"content": "——而是希望，特瓦林能自己選擇、自己理解，何為自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960706,
					"content": "因為我在成神之前，也是這樣被一個朋友…教導了「何為自由」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960707,
					"content": "關於深淵教團…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "#嗯？{F#妳}{M#你}說凱亞的情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960709,
					"content": "#…原來如此，深淵教團裡有一位「{F#王子}{M#公主}」，主導了腐化特瓦林的計畫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960710,
					"content": "#看來是想把特瓦林改造成深淵的戰爭兵器吧。話說回來，我可從沒聽說過，深淵教團裡有什麼「{F#王子}{M#公主}」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960711,
					"content": "看來那不是教團的古老傳承。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960714,
					"content": "#但最近才出現的「{F#王子}{M#公主}」，又為什麼能走上統領深淵教團的位置呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960712,
					"content": "看來是最近才出現的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "關於「女士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "剛才的愚人眾執行官，搶走「神之心」以後，馬上就離開了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960717,
					"content": "這是為了避免出現「騎士團的目擊證人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960718,
					"content": "畢竟這種事要是留下把柄，就等於公開毀滅與西風騎士團的外交關係了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960719,
					"content": "做出這種事來，卻還好意思繼續當蒙德的盟友嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960720,
					"content": "唉…面對深淵教團的威脅，人類的七國本該結成聯盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960721,
					"content": "「愚人眾」擁有七國最強的武力，卻用來盜竊天空之琴、覬覦神力、借龍災對騎士團施壓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960722,
					"content": "啊，說到「天空之琴」…那時，好像聽迪盧克提過這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960723,
					"content": "他說，「愚人眾」能夠橫行七國、威脅西風騎士團，完全是由於這十一位執行官的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960724,
					"content": "是的，就像我剛才說的，他們被冰之神賜予了權柄，獲得了超越凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960725,
					"content": "「冰之女皇」…五百年沒見了，她究竟在想什麼呢？又在計劃著什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960726,
					"content": "#這件事的答案，或許也會對{F#妳}{M#你}尋找七神的旅途，產生未知的影響吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960727,
					"content": "關於神靈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "剛才說過，「神之眼」的擁有者，被世界稱作「原神」，擁有登上天空島的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960729,
					"content": "「神之心」是更高位的元素控制中樞，是七神之座的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960730,
					"content": "#對不起，我不知道是七神中的哪一位，帶走了{F#妳}{M#你}的{F#哥哥}{M#妹妹}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960731,
					"content": "呀，話說回來，身為七神之一，我自己的嫌疑都還沒洗清…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960732,
					"content": "你長得和那個神一點都不像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "可是，「賣唱的」只是化身形象，不能作為判斷依據——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960734,
					"content": "相處這麼久，不用繼續懷疑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#啊哈哈，我們確實是很好的搭檔呢。等{F#妳}{M#你}找回{F#哥哥}{M#妹妹}，有沒有興趣來當新的「四風守護」啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960736,
					"content": "也許…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#嗯？{NICKNAME}，{F#妳}{M#你}好像不太熱衷的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960738,
					"content": "那麼賣唱的！如果當了「四風守護」就有民眾供奉好吃的話，不如考慮一下…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960739,
					"content": "哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960741,
					"content": "沒別的事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "那麼，就往<color=#00E1FFFF>璃月</color>去吧。錯過今年的「請仙典儀」的話，就要再等一整年囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		}
	]
}