			"dialogs": [
				{
					"id": 191430901,
					"content": "剛才我在館裡打掃的時候，外面突然吵鬧了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 191430902,
					"content": "我剛一出門，就看到…<color=#00E1FFFF>有個黑影從樹下一下子竄了上去！</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 191430903,
					"content": "人來人往的，不會是什麼小偷強盜吧…",
