						191431102
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 191431102,
					"content": "明、明白了，我們是真的跑不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 191431103,
					"content": "現在是跑不動，等休息夠了，不會又想逃跑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 191431104,
					"content": "不敢不敢！我們再也不敢了！",
