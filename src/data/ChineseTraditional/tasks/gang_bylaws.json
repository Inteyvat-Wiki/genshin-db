			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "怎麼辦？難道今天就玩不了《七聖召喚》了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431002,
					"content": "要不然換個地方？可是除了橋底下，還有什麼地方不容易被大人發現啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431003,
					"content": "啊啊…乾脆去請宵宮姐姐放點煙花，把佔地方的人給嚇出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431004,
					"content": "這不太好吧？雖然確實是他先動手把我們趕出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431005,
					"content": "所以全都是他不好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431006,
					"content": "我覺得…我們是不是，該回家寫作業了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "由真"
				},
				{
					"id": 191431007,
					"content": "老是打牌不學習的話，將來不會也變成<color=#00E1FFFF>橋底下那種大人</color>吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由真"
				}
			]
		},
