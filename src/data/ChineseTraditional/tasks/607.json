			"dialogs": [
				{
					"id": 6070201,
					"content": "汝等無需驚恐，魔物已被消滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 6070202,
					"content": "小姐的意思是，接下來也請不要隨意外出，留在室內便好。我們會盡可能確保這一帶居民的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 6070203,
					"content": "非常感謝！非常感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070204,
					"content": "不過，這隻…這隻大鳥竟然也會說話嗎？哎呀…這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070205,
					"content": "噢，您不必多慮，我只是小姐的臣子，絕不是鄉野魔物，更不會對各位造成任何威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 6070206,
					"content": "這兩位都是好人，請放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "啊、啊當然，我不是那個意思！抱歉，抱歉，都怪我口不擇言的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "帕斯里"
				},
				{
					"id": 6070208,
					"content": "嗯哼，無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 6070209,
					"content": "#扈從，還有要事在身嗎？儘管去剷平餘孽吧，光輝的皇女祝福{F#妳}{M#你}的前路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲謝爾"
				}
			]
