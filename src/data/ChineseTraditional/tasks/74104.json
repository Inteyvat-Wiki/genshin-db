	"talks": [
		{
			"id": 7410404,
			"completionStepIds": [
				7410404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410404",
							"2"
						],
						"stepId": 7410404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫特羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741040401,
					"content": "兩、兩位是來應徵研究助手的嗎？抱、抱歉，我現在有點脫不開身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040402,
						741040403
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040402,
					"content": "看得出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040405
					]
				},
				{
					"id": 741040405,
					"content": "先不管這些了，你怎麼被關在籠子裡了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040406,
					"content": "和研究夥伴的意見有點分歧…庫特羅…他要我在這裡冷靜一下。對、對了，還沒有自我介紹，兩位就叫我…叫我奎瑟爾好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040407
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040407,
					"content": "呃，就是…就是奎瑟爾的發條工坊，那個奎瑟爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040408
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040408,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}…說起來剛才的確聽到吵架的聲音，原來那個聽起來很凶的傢伙是你的研究夥伴啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040409,
						741040411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040409,
					"content": "要不要換個夥伴啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040410
					]
				},
				{
					"id": 741040410,
					"content": "#就是說嘛！好的夥伴應該像我一樣…{NICKNAME}能有我這樣的夥伴，真是個走運的傢伙呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040413,
					"content": "可、可不可以麻煩兩位放我出來？如果能啟動旁邊的儲能裝置，應、應該就能夠把門打開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040414
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040414,
					"content": "拜、拜託了！之前來應徵研究助手的人也因為受不了他火爆的脾氣，很快就離開了，這裡現在只有我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040415
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040415,
					"content": "#唔，既然是這樣，{NICKNAME}，我們就幫幫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040411,
					"content": "那你繼續冷靜吧，不打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040412
					]
				},
				{
					"id": 741040412,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040403,
					"content": "只是隨便進來看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040404
					]
				},
				{
					"id": 741040404,
					"content": "參、參觀嗎？當、當然也是很歡迎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040405
					],
					"speakerTitle": "庫特羅"
				}
			]
		},
		{
			"id": 7410405,
			"completionStepIds": [
				7410406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410406",
							"2"
						],
						"stepId": 7410406,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7410401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫特羅"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4944.755,
							367.04,
							4455.18
						],
						"pointId": 6729
					}
				]
			},
			"dialogs": [
				{
					"id": 741040501,
					"content": "門已經打開了，你不出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040502,
					"content": "其、其實還有件難以啟齒的事…如果我現在走出牢籠，恐、恐怕這裡會爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040503
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040503,
					"content": "爆炸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040504,
					"content": "是、是的…之前也有說過，我的研究夥伴是個…脾氣火爆的人，所以在牢籠下加裝了特殊的觸發裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040505
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040505,
					"content": "欸？！那現在該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040506,
						741040508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040506,
					"content": "用其他重物代替一下可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040507
					]
				},
				{
					"id": 741040507,
					"content": "普、普通的重物恐怕不行…中間的原理很複雜，呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040510,
					"content": "#好心的{NICKNAME}{M#先生}{F#小姐}，如果{F#妳}{M#你}能暫時代替我…在籠中稍候，我、我可以去解除這個特殊的觸發裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040511
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040511,
					"content": "畢、畢竟是多年共同研究的夥伴，他的心裡在想些什麼，我一清二楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040512,
						741040515
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040512,
					"content": "我的重量應該不夠，還是派蒙也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040513
					]
				},
				{
					"id": 741040513,
					"content": "#可、可是{F#妳}{M#你}看我一直都是浮在空中的，一定根本沒有重量！嗯，沒有重量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040514,
					"content": "呃…這個觸發裝置非常特殊，並不是單純透過重量判斷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040516
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040516,
					"content": "請相信我，只要頂替我一下，我會很快解除觸發裝置回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040517
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040517,
					"content": "#…或許{F#妳}{M#你}知道楓丹科學院，或者聽過雷蒙多先生和博絮埃先生的名字？我、我也曾經受到他們的指導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040518
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040518,
					"content": "這、這類技術問題，不難，不會花費很多時間的。只要一下就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040519
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040519,
					"content": "唔…那好吧。不過你要快點哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040520,
					"content": "小心翼翼地和奎瑟爾交換了位置…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040521
					]
				},
				{
					"id": 741040521,
					"content": "欸？門怎麼又關起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040522,
					"content": "呃，可、可能是出了什麼故障。我、我去看一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040523
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040523,
					"content": "不祥的預感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040524
					]
				},
				{
					"id": 741040524,
					"content": "別、別擔心，我會盡快處理的。解除觸發裝置的終端不在這裡，我暫時離開一下，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040525
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040525,
					"content": "看來我們只好耐心等待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040526,
					"content": "等待了一段時間…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040527
					]
				},
				{
					"id": 741040527,
					"content": "他怎麼去這麼久…該不會是出了什麼意外吧？不過他之前有說，這裡現在只有他和他的研究夥伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040528,
						741040530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040528,
					"content": "說不定他又被關進別的籠子裡了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040529
					]
				},
				{
					"id": 741040529,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040532,
					"content": "我過去常想，「善良」真的能被稱為美好的品德嗎？徒有善良的人…善良對他的人生又有什麼益處呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040533
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040533,
					"content": "…欸？是誰在說話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040534,
					"content": "#這裡根本沒有什麼會引發爆炸的觸發裝置，但牢籠的門的確被鎖上了。兩位，{F#妳}{M#你}們會怎麼選？是繼續等待，還是起身行動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040535
					],
					"speakerTitle": "庫特羅"
				},
				{
					"id": 741040535,
					"content": "這個人在說些什麼呀！而且總覺得他的聲音聽起來…有點像奎瑟爾，又有點像之前跟他吵架的人，怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040536,
					"content": "先想辦法讓我出去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040537
					]
				},
				{
					"id": 741040537,
					"content": "#對哦！可是…可是{F#妳}{M#你}被關在籠子裡，該怎麼打開被鎖起來的門呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040538,
					"content": "全靠妳了，派蒙，救救我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040539
					]
				},
				{
					"id": 741040539,
					"content": "嗚哇！怎麼會這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040540,
					"content": "#不過幸好我沒有和{F#妳}{M#你}一起被關進籠子…唔，按照和剛才一樣的方法應該可以把門打開吧？就讓我試一試好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040530,
					"content": "我們應該是上當了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040531
					]
				},
				{
					"id": 741040531,
					"content": "#{F#妳}{M#你}是說他騙了我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040515,
					"content": "感覺有點可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040516
					]
				},
				{
					"id": 741040508,
					"content": "沒轍了，我們去楓丹廷找人幫你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040509
					]
				},
				{
					"id": 741040509,
					"content": "是、是不用這麼麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "庫特羅"
				}
			]
		},
