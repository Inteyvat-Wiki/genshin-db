			"dialogs": [
				{
					"id": 741040801,
					"content": "仔細看看，這裡有兩個終端和兩個儲能裝置。如果能啟動門邊的儲能裝置，應該就可以打開牢籠的門了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040802,
					"content": "那我該去哪邊呢？門那邊的終端，還是牢籠那邊的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040803,
						741040805
					],
					"speakerTitle": "派蒙"
				},
				{
