				]
			},
			"dialogs": [
				{
					"id": 756720101,
					"content": "這裡怎麼有個蹦蹦跳跳的阿夏，還有…欸？班尼特？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720102,
					"content": "#啊，是{NICKNAME}和派蒙！又見面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720103
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720103,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720104
					],
					"speakerTitle": "「調色家阿夏」"
				},
				{
					"id": 756720104,
					"content": "班尼特這是又回悠悠度假村來玩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720105,
					"content": "#對呀，如果{NICKNAME}有印象的話，我之前寫信告訴過你們——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720106
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720106,
					"content": "前幾個月，我準備了好久，拿下了不少報酬豐厚的委託，存夠了錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720107
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720107,
					"content": "總算成功邀請老爹們和朋友們，來「悠悠度假村」盡情遊玩了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720108
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720108,
					"content": "老爹們親眼看見，我在納塔幾乎和倒楣絕緣，一個個都非常感動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720109
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720109,
					"content": "對哦，對班尼特來說這麼好的事，的確要讓大家都知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720110,
						756720111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720110,
					"content": "真是大好的消息！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				},
				{
					"id": 756720112,
					"content": "#要是再早一週遇見{F#妳}{M#你}們，說不定，大家還能聚個餐呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720113
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720113,
					"content": "#嗯，那就等到{F#妳}{M#你}們之後回蒙德了，找個萬無一失的地方，好好再吃一頓「安全冒險山洞晚飯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720114
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720114,
					"content": "等等？聽班尼特的意思是，現在老爹們和朋友們都回去了，你獨自留在度假村了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720115,
					"content": "說來也有點巧，老爹們剛剛玩到盡興，就得知了一個消息，貓尾酒館的迪奧娜小姐之後會出差一段時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720116
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720116,
					"content": "為了多喝幾杯特調，他們就沒有延長假期，選擇按計畫準時回了蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720117
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720117,
					"content": "不過別擔心，我留下的理由，也和意外延誤，船票被偷什麼的無關，而是碰見了需要幫助的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720118
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720118,
					"content": "我們在海邊釣魚的時候，發現了幾位被叫做「調色家」的阿夏，它們正在為了什麼而煩惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720119
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720119,
					"content": "憑藉以前的經驗，我大概能理解，它們想要尋找不同凡響的寶物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720120
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720120,
					"content": "唔，既然被冠上了「調色家」的頭銜，那對它們而言的寶物應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720121,
						756720122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720121,
					"content": "超棒的顏料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720123,
					"content": "是的！阿夏們除了到處塗鴉，還喜歡自己尋找顏料，用心收藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720124
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720124,
					"content": "「調色家阿夏」們就在某座秘境裡發現了非常特殊的品類…是一種游離的染色成分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720125
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720125,
					"content": "那些游離的色彩像晶蝶會到處亂逃，「調色家」們一時不知該怎麼處理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720126
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720126,
					"content": "這個好說，我們也來幫忙吧。去秘境裡一看就能明白情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720127,
					"content": "說不定，我們以前搞定過類似的麻煩呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720128,
						756720129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756720128,
					"content": "阿夏需要幫助，我義不容辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720130,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720131
					],
					"speakerTitle": "「調色家阿夏」"
				},
				{
					"id": 756720131,
					"content": "那太好了！我們一起來幫「調色家」，你們怎麼做，我就跟著照做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720132
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720132,
					"content": "希望這些阿夏能收集到最棒的顏料，調出特別漂亮的色彩，繼續傳遞不一樣的快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756720129,
					"content": "收集特別的東西，我們在行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720122,
					"content": "貴重的顏料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720111,
					"content": "我每次聽都很高興！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				}
			]
		}
	]
}