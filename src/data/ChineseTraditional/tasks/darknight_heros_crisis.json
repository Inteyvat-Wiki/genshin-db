					"nextDialogs": [
						4650221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650221,
					"content": "想必那是一種只有他們才懂的，在內部流傳的「暗文」格式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650222,
					"content": "難道「戰書」其實是給自己人看的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "所以那不僅僅是「戰書」，更是他們自己的「行動通告」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "迪盧克"
				},
				{
