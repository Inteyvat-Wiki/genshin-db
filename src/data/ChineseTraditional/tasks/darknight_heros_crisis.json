			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "霍夫曼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650102,
					"content": "#哦，是{F#妳}{M#你}們。感謝{F#妳}{M#你}們二位的配合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650103,
					"content": "上次我們聊到「暗夜英雄」的事…請問還有其他情報可以提供嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650104,
					"content": "我可以先問問發生什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "說的也是，提問之前自己要先提供必要的情報，是我疏忽了騎士的禮節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650108,
					"content": "#其實事情是這樣的…{F#妳}{M#你}們先看看這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650109,
					"content": "嗚哇，好醜的字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650110,
					"content": "唔，仔細看看…好像有很多地方看不太懂的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650111,
					"content": "確實，雖然是「通用語」，但很多地方寫成了「密文」的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650112,
					"content": "只看可以讀懂的部分倒是也能大致理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650119,
					"content": "這是，深淵教團對「暗夜英雄」下的戰書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650113,
					"content": "也就是說「暗夜英雄」徹底被壞蛋盯上囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650114,
					"content": "這麼說沒錯。所以可能的話，我們希望盡早與他一同商議對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650115,
					"content": "畢竟這不僅是「暗夜英雄」一個人的事，也是整個蒙德城的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650116,
					"content": "謝謝你分享情報。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "嗯，最近如果有什麼發現，歡迎隨時來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650117,
					"content": "我會留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "抱歉，真的沒有別的情報了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "是嗎…那可真是遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 46502,
