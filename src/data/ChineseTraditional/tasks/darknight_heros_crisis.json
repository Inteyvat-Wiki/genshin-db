			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪盧克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "迪盧克老爺！快聽我說，剛剛我們在騎士團…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650202,
					"content": "是深淵教團下的戰書吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650203,
					"content": "#我已經知道了，謝謝{F#妳}{M#你}們特地跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650204,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650205,
					"content": "晨曦酒莊的情報網可並不限於商業情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650206,
					"content": "那麼迪盧克老爺打算怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650207,
					"content": "#{F#妳}{M#你}們的意見呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650208,
					"content": "還是和騎士團聯手吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "那樣就正中深淵教團的下懷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650210,
					"content": "他們看準我與騎士團合不來，想要逼我在他們面前現身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650211,
					"content": "一旦我的身分暴露，以後的行動就難免會受到騎士團的干預。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650212,
					"content": "畢竟沒有哪個掌控著權利的組織，甘願由外人來「代行正義」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650217,
					"content": "唔…深淵教團這下可真是出了個大難題呀，好狡猾的傢伙們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650218,
					"content": "辦法還是有的，只是需要先建立一些情報優勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650219,
					"content": "…戰書裡的那些被刻意掩蓋的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4650220,
					"content": "刻意掩蓋？你指的是看不懂的那些部分嗎？",
