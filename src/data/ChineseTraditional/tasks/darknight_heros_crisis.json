					"id": 4650228,
					"content": "…唔哇…是不是當英雄的都要有你這麼厲害的頭腦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "派蒙"
				},
