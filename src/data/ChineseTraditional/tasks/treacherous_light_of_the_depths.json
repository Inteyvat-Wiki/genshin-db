					"content": "#打孔紙帶放在裡間的書架上了，{F#妳}{M#你}們找找看吧！其他的研究資料就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811002
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811002,
					"content": "看一下應該也沒關係吧？反正沒什麼機密資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑟維妮"
				}
			]
