						],
						"pointId": 6385
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "呃…我們、我們該不會闖了大禍吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811702,
					"content": "真奇怪，剛才感覺到一陣晃動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811703,
					"content": "我也感覺到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "唔，可能是因為我們剛才動了上層的裝置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811706,
					"content": "這裡的門原本是鎖上的吧？還特地放了一些發條機關在門口看守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811707,
					"content": "我請它們休息之後把門打開了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "這、這也沒辦法嘛！是它們先攻擊我們的，我們這樣算是正當防衛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811710,
					"content": "梅雅德前輩的試驗機…原本應該是關機狀態吧？畢竟前輩自從在伊黎耶島覓得了一塊好場地，就幾乎不回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811711,
					"content": "想想也是，如果能在花園舞池那樣風景優美的地方向眾人展示研究成果，又有誰會願意回到這種陰濕破敗的研究室來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811712,
					"content": "博絮埃先生卸任之後，大家就像這裡的物資器材一樣四散到楓丹科學院的各處，就連沙發都一個也不剩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811713,
					"content": "只有試驗機還留在這裡等那些不會回來的人，原本只是站在這裡待機，對它們來說應該也不算什麼吧！不過現在完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811714,
					"content": "#{F#妳}{M#你}們看看，被打得七零八落，發條都快掉出來了！要是被梅雅德前輩知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811715,
					"content": "是我做的，對不起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "對不起…這、這個試驗機很貴嗎？如果要賠償的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811719,
					"content": "不用緊張。我是想說，梅雅德前輩要是知道了，一定會笑出聲的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811720,
					"content": "畢竟他自己以前就常主動打斷試驗機的舞蹈，被打倒後又坐在原地哈哈大笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811721,
					"content": "#對了，說了這麼久，都還沒自我介紹。我是楓丹科學院的研究員，{F#妳}{M#你}們可以叫我瑟維妮。兩位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811722,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}，我們是…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811723,
					"content": "只是路過而已，絕對沒有別的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "對！我們只是路過而已，絕對不是以為這裡有什麼寶藏所以才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811726,
					"content": "#哦！{F#妳}{M#你}們是說會安排一些尋寶行程的廢墟旅遊？那{F#妳}{M#你}們就找錯地方了，這裡雖然看起來像廢墟…不，實際上也算廢墟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811727,
					"content": "但是這裡還沒有被納入廢墟旅遊的推薦地點哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811728,
					"content": "好吧，那我們現在就走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811729,
					"content": "#…等等，{F#妳}{M#你}們知道新楓丹科學院吧？要走的話剛好幫我一個忙，幫我去新楓丹科學院找希塞蕾前輩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811730,
					"content": "可是我們沒有要去新楓丹科學院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "那怎麼辦才好呢？我還有工作沒處理完，梅雅德前輩的試驗機又被打壞了，需要盡快找人回收…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811733,
					"content": "#唔唔…{NICKNAME}，不然我們還是幫她這個忙吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811734,
					"content": "#太好了！既然{F#妳}{M#你}們同意幫忙傳話給她，那回收打孔紙帶的工作也拜託{F#妳}{M#你}們好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811735,
					"content": "早知道不要亂動外面的裝置了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "別這麼說嘛，反正不是什麼難事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811737,
					"content": "有了幫忙回收研究資料的名義，委託的報酬就可以報銷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811738,
					"content": "欸？這樣做真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811739,
					"content": "畢竟是真的協助了研究工作，名正言順，當然沒問題啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811740,
					"content": "而且如果真的不符合規定的話，是會被事務員駁回的。那樣就只好我自行承擔委託的費用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811741,
					"content": "妳們常常做這種事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "我本人是沒有啦！其他人的話我就不知道了，以前的確聽過一些傳聞，不過…哎呀！這也不是值得和外人講的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811743,
					"content": "要回收的打孔紙帶有三份。應該說，書架上只有三份打孔紙帶，應該很容易就可以找到，就麻煩兩位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811744,
					"content": "在此期間，我還要再檢查一下試驗機，畢竟很久都沒有人維護過它們了…如果失控了就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811745,
					"content": "好吧，那我們回收完打孔紙帶再來找妳確認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740811736,
					"content": "沒問題，交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "我們還有別的寶藏要找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "請問這裡有寶藏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "有考慮提升試驗機的強度嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "#梅雅德前輩的確有考慮，或許最終的成品能夠符合{F#妳}{M#你}對強度的預期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "瑟維妮"
				},
				{
					"id": 740811708,
					"content": "對啊，真奇怪，門怎麼打開了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "是妳的錯覺吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
