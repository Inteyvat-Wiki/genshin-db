			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"飛飛",
					"楓原萬葉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "可、可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20021102,
					"content": "不要，不要，只有烙印千萬不要…！求求你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20021103,
					"content": "生死攸關，已盡全力之人，依然無法令神明垂青。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021104,
					"content": "留下神之眼快走吧，我改變心意了，之前的懲罰就算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021105,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20021106,
					"content": "怎麼，難道你又想主動受罰了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021107,
					"content": "那我當然無所謂，這種符合武士之道的覺悟值得讚賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021108,
					"content": "不不不，怎麼可能，感謝高抬貴手，謝謝大人有大量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20021110,
					"content": "不太明白，你只是故意想嚇唬他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021111,
					"content": "我沒有這種詭異的興趣，只是神之眼還在他手上，我想試試最後的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021112,
					"content": "人被逼入絕境時，會爆發出相當強大的力量，我原本以為，這會成為神之眼亮起的契機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021113,
					"content": "可惜，什麼都沒有發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021114,
					"content": "從頭到尾，都是為了這件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "是的，我只想知道熄滅的神之眼，有無重燃的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021116,
					"content": "從察覺到他在偷那顆神之眼的時候起，我就決定用他來做這場「實驗」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021117,
					"content": "而且在過去我也已經嘗試過許多種辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021190,
					"content": "雖然「無主的神之眼還能重新發光」這種事，我只在少數傳說中聽說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021191,
					"content": "#但既然見識到了{F#妳}{M#你}可以同時掌控多種元素，還有什麼是不可能的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021192,
					"content": "#來，{F#妳}{M#你}也試試看吧，看看{F#妳}{M#你}能不能給我理想的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021118,
					"content": "我試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "看起來，沒有什麼特別的反應呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021121,
					"content": "#原來如此，就算是{F#妳}{M#你}也不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021122,
					"content": "沒關係，這也是意料之中的事，那這枚神之眼，就可以繼續陪著我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021123,
					"content": "為什麼這麼執著？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "對哦，這個神之眼有什麼特殊的由來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021126,
					"content": "那就，不得不提及一位故人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021127,
					"content": "可能我現在做的一切，最後會發現都是沒有意義的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021128,
					"content": "但浪人武士一生，除了旅途的「意義」和沿途的花鳥風月，還有心中的「道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021129,
					"content": "萬葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20021130,
					"content": "呵呵，不過是隨性而為而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021131,
					"content": "好了，是時候回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021132,
					"content": "嗯，走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "#那麼，就再一次由我引{F#妳}{M#你}乘風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021134,
					"content": "再散散心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "…不必顧慮我的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021136,
					"content": "#不過，還是謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20021124,
					"content": "一定要點亮它嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
