		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "唔，怎麼還沒有來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020202,
					"content": "#算了，還是先開始{F#妳}{M#你}的隆重登場好了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020203,
					"content": "各位，安靜一下，注意這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020204,
					"content": "緊張刺激的「南十字武鬥會」，終於來到了最後的決賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020205,
					"content": "經歷了許多許多驚心動魄的比試之後，終於有兩位選手來到了今天的舞台之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020206,
					"content": "#首先，我要介紹的這一位，大家就算沒有見過，也一定聽過{F#她}{M#他}的名聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020207,
					"content": "#{F#她}{M#他}就是，令魔神奧賽爾也為之膽寒，愚人眾的執行官也聞之色變的，璃月的異鄉人英雄！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020208,
					"content": "哦哦哦哦哦哦哦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "參賽者"
				},
				{
					"id": 20020209,
					"content": "等了好久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "參賽者"
				},
				{
					"id": 20020210,
					"content": "#想必在準決賽的時候，大家都看到了{F#她}{M#他}的精彩表現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020211,
					"content": "今天的決賽，精彩程度一定會更勝一籌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020212,
					"content": "而我們的另一位選手…唔，現在還沒有到場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020213,
					"content": "真是的，搞什麼去了。決賽又不能像是之前的比賽，直接判定棄權…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020214,
					"content": "抱歉抱歉，麻煩大家再稍等一會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020215,
					"content": "會不會是記錯時間了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "不管怎麼樣，如果還不到場的話，這場決賽就只能延期了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020218,
					"content": "等等，我覺得有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020219,
					"content": "大姐頭，我們去檢查一下獎品吧，就是那個放置神之眼的盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}，{F#妳}{M#你}也跟我們過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020216,
					"content": "會不會是不敢來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200204",
							"2"
						],
						"stepId": 200204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"派蒙",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020402,
					"content": "嗯…那顆神之眼居然不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020403,
					"content": "是被偷了嗎？光天化日之下，誰能做得到這種事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020404,
					"content": "而且也不知道是什麼時候下的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020405,
					"content": "呵，沒想到趁我興起，有人敢在我北斗頭上動土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020406,
					"content": "不用太著急，再高明的手法也瞞不過自然的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020407,
					"content": "嗯…行竊的人是剛剛下手的，並且還沒有跑得太遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020408,
					"content": "神之眼是我許諾的獎品，沒有看好它也是我的責任，我會負責把它找回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020409,
					"content": "唔，既然你這麼說，那只能這樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020410,
					"content": "我要留在這裡，給這些來看武鬥會的人一個解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020411,
					"content": "#對了，{NICKNAME}，{F#妳}{M#你}也跟我一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020412,
					"content": "沒辦法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "但是，這裡是個島啊，要追的話，該往哪裡追？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020415,
					"content": "跟我來吧。我能感覺到，「風」快要來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020413,
					"content": "反正對手也沒有來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"飛飛",
					"楓原萬葉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "怎麼會有人比我跑得還快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020902,
					"content": "為了順利逃跑，我還提前準備了船，居然一下子就被追上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020903,
					"content": "船再快，也比不上風的速度啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020904,
					"content": "風？你在說什麼…啊，我明白了，是你神之眼的能力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020905,
					"content": "可惡，要是我也有神之眼…或者如果我能讓這顆神之眼亮起來，你們怎麼可能追得到我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020906,
					"content": "這和神之眼無關。或許你很擅長在「人群」中銷聲匿跡，但顯然你還不知道如何甩開「自然」的目光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020907,
					"content": "此外，逃跑路徑的選擇也破綻百出，而且，我循風而來的路上，還聽到了你得意洋洋的炫耀與放聲大笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020908,
					"content": "換句話說，神偷的三項信條，「迅速」、「隱秘」、「優雅」，你一項都沒有做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020909,
					"content": "你、你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020910,
					"content": "但比起這些，更令我失望的是你手中神之眼的狀態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020911,
					"content": "——果然，它不會無差別地回應「願望」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020912,
					"content": "好啦好啦！這次算我認栽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020913,
					"content": "這神之眼我盯上它很久了，聽說這次武鬥會的參賽者都是不入流的傢伙，我就報了名，一路打到了決賽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020914,
					"content": "原來你就是我們的決賽對手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020915,
					"content": "#本來我以為憑實力奪冠也沒問題！結果，就是因為{F#妳}{M#你}們突然殺了出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020916,
					"content": "我看了準決賽，我當場就知道我沒有半點勝算，但都已經到這個地步了，我絕對不甘心放棄神之眼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020917,
					"content": "#既然明爭行不通，那…我就趁大家的注意力在北斗和{F#妳}{M#你}的身上時，用上了我老本行的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020918,
					"content": "明明我的準備已經夠充分，結果還是被你們追上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020919,
					"content": "走投無路了就識相點吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "該死，還是不甘心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020923,
					"content": "再抵抗的話，代價就大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "赤裸裸的威脅啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020928,
					"content": "#行，不過{F#妳}{M#你}要說話算話！反正我拿到它，它也沒被喚醒，那就只是個沒用的殼子而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020929,
					"content": "那怎麼行，光是偷東西這一項罪責，按海上的規矩，就應該斷臂贖罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020930,
					"content": "欸？！不至於吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020931,
					"content": "再加上你偷走了獎品，沒有參加決賽，讓「南十字」船隊的首領北斗丟了面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020932,
					"content": "看來，還要用燙紅的烙鐵，在你的臉上烙下「小偷」兩字，才算公允吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20020933,
					"content": "喂喂，不用這麼狠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20020934,
					"content": "可惡，沒想到你這個人這麼心狠手辣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020935,
					"content": "既然沒得談，那還廢話什麼，我跟你們拚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020921,
					"content": "把東西交出來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "可是，好不容易才拿到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020925,
					"content": "乖乖聽話的話就什麼事都沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "真、真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "飛飛"
				},
				{
					"id": 20020927,
					"content": "東西交出來就放過你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
