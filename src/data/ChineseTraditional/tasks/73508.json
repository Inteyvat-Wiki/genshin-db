					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"貝爾福",
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735080101,
					"content": "#這些天來多謝{F#妳}{M#你}們了，「黃金流星」{NICKNAME}和「白銀伴星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080102
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080102,
					"content": "#我記錄下了{F#妳}{M#你}們每次遊玩「靈蕈棋陣」的過程，根據{F#妳}{M#你}們的遊玩記錄，可以得出許多資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080103
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080103,
					"content": "#{F#妳}{M#你}們屬於「頂尖水準」的試玩者，將{F#妳}{M#你}們的記錄和普通試玩者的相結合，就能分析出合適的改進方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080104
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080104,
					"content": "#當然，最後還要請{F#妳}{M#你}們分享關於整體風格的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080105,
					"content": "#{F#妳}{M#你}們的回饋不止對「靈蕈棋陣」這個遊戲有正面意義，還在一定程度上影響著下一屆大賽的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080106
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080106,
					"content": "#還請{F#妳}{M#你}們大概說說自己的傾向。比如…是更重視趣味性，還是競技性呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080107,
						735080112,
						735080117
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080107,
					"content": "我更看重與夥伴們的合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080108
					]
				},
				{
					"id": 735080108,
					"content": "對哦！比賽和對抗確實很重要，不過，我們希望之後的挑戰更能考驗我們和蕈獸夥伴的默契！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080109,
					"content": "和蕈獸夥伴們的默契嗎…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080110
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080110,
					"content": "貝爾福先生，記得我之前和你說過的，最重要的理念吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080111,
					"content": "#瞭解！下次大賽，我會爭取設計一些考驗{F#妳}{M#你}們配合的挑戰，讓{F#妳}{M#你}們和蕈獸夥伴在高效的溝通中發揮全力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080121,
					"content": "#{F#妳}{M#你}們兩位還真是一點都沒變呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080122
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080122,
					"content": "總之，這樣一來，本次「靈蕈棋陣」的測試就大功告成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080123,
						735080125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080123,
					"content": "有勞你們了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080124
					]
				},
				{
					"id": 735080124,
					"content": "好耶！完成工作後，我們就能拿到一筆辛苦費，買些好吃的犒勞自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080127,
					"content": "等等…不對不對！我們是下次大賽的主辦方，而海妮耶和貝爾福在為下次大賽做準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080128,
					"content": "海妮耶是我們的好幫手，理論上來說，貝爾福也算是我們的員工了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080129,
					"content": "那是不是應該…唔…由我們發辛苦費給好幫手，發薪水給員工？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080130,
					"content": "#不不不！{F#妳}{M#你}們未免也太好心了！這都是我自願付出的工作，我也有非常多的收穫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080131
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080131,
					"content": "我畢竟也算是個商業人士，這次開發並營運「靈蕈棋陣」的經驗和履歷，對於我們這類人彌足珍貴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080132
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080132,
					"content": "#要是這份工作對外開放，不知道會有多少人拿著一大筆錢來求{F#妳}{M#你}們授權呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080133
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080133,
					"content": "而且，「靈蕈棋陣」盈利後，貝爾福先生投入的錢也有著落了，他還會將大部分收入交給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080134
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080134,
					"content": "我會將一部分收入存起來，作為下次大賽的預備資金，一部分用來好好照顧蕈獸夥伴們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080135,
					"content": "不止是「咚咚小圓帽」它們，還有諸如「信風舞姬」那樣的，選手們託我照顧的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080136
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080136,
					"content": "#也就是說，{F#妳}{M#你}們幫助我們改進了「靈蕈棋陣」，可以帶來大量的收益，還為蕈獸夥伴們提供了保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080137
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080137,
					"content": "原來是這樣嗎…雖然聽不太懂什麼盈利、收入之類的，但感覺好像，所有人都有很大的收穫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080138,
					"content": "那我也更有成就感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080139,
					"content": "#{NICKNAME}，有機會的話，我們也和須彌的朋友們分享「靈蕈棋陣」的事，讓更多人知道這個遊戲吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080140,
					"content": "當然當然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080141
					]
				},
				{
					"id": 735080141,
					"content": "接下來，我就要和蕈獸夥伴們先行一步，去城外會合助手，回營地去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080142
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080142,
					"content": "如果離開營地太久，留守的蕈獸夥伴們會擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080143
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080143,
					"content": "#貝爾福先生還會在這裡繼續宣傳測試版的「靈蕈棋陣」，如果{F#妳}{M#你}們還沒盡興，可以繼續玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080144
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080144,
					"content": "對，玩個痛快吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080145
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080145,
					"content": "嗚，海妮耶要走了嗎？要帶著「咚咚小圓帽」它們離開了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080146,
					"content": "我還想跟「咚咚小圓帽」再玩一下下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080147,
					"content": "不過…這次見到海妮耶後，我越來越安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080148,
					"content": "特別是確認了蕈獸夥伴們都健健康康，和我們的默契一點也沒有減少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080149,
					"content": "放心，也許不過多久，我們就會再見面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080150
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080150,
					"content": "#雖說{F#妳}{M#你}們經常四處旅行，但我也有辦法和{F#妳}{M#你}們聯絡。比如透過冒險家協會把信件轉達給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080151
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080151,
					"content": "#我保證，之後與{F#妳}{M#你}們再見時，我和蕈獸夥伴們都健健康康，精力充沛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080152
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080152,
					"content": "請靜候佳音吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080153
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080153,
					"content": "嗯！我們相信妳，海妮耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080154,
						735080155,
						735080156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080154,
					"content": "加油啊，海妮耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080157,
					"content": "#那就下次再見了，「黃金流星」{NICKNAME}和「白銀伴星」派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080155,
					"content": "照顧好蕈獸夥伴們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080156,
					"content": "也別忘了照顧好自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080125,
					"content": "記得報酬哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080126
					]
				},
				{
					"id": 735080126,
					"content": "對對對，用工作賺到的摩拉買到的食物，好像都更香一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080112,
					"content": "我更傾向於戰鬥的華麗和爽快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080113
					]
				},
				{
					"id": 735080113,
					"content": "嗯！這次和蕈獸夥伴們見面後，我更加確定了，我們和蕈獸夥伴們之間的默契，只會變強，不會被時間沖淡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080114,
					"content": "下次再和蕈獸夥伴們一起參賽時，我們的配合不知道會有多厲害，肯定要用華麗的戰鬥體現出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080115,
					"content": "#原來如此，{F#妳}{M#你}們覺得適當的挑戰，可以展現出蕈獸夥伴的全部實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080116
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080116,
					"content": "那下次比賽，就要適當增加一些挑戰性的內容了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735080117,
					"content": "我沒什麼特別的想法，開心就好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080118
					]
				},
				{
					"id": 735080118,
					"content": "嗯！不管怎麼樣，只要能和蕈獸夥伴們一起玩，一起通過考驗，戰勝困難，我們就很開心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735080119,
					"content": "明白了，樂趣和挑戰並存，這句話說起來簡單，不過做起來很難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080120
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735080120,
					"content": "#都交給我了，我會盡全力拿出讓{F#妳}{M#你}們滿意的方案的！",
