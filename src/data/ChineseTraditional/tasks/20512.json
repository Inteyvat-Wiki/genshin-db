					"安東尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "藥方越來越怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120102,
					"content": "安娜怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "#是{F#妳}{M#你}啊，呃，雖然說出來{F#妳}{M#你}可能不信，但是安娜說自己確實感覺好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120104,
					"content": "難道是那位醫生的藥方真的起作用了？我自己都不信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120105,
					"content": "不過，不管是不是真的，總之還是先吃藥吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120106,
					"content": "#這次的藥方是…我看看，{F#妳}{M#你}能幫我找一份「水史萊姆的濃厚凝液」來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120107,
					"content": "這次的還算正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "…呃，正常嗎？我覺得這次的反而更不正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120109,
					"content": "不過，這次倒是挺好找的，「濃厚凝液」我也問過別人，只要消滅大型史萊姆應該就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120110,
					"content": "我還聽傑克說，如果想引出大型史萊姆，就要先不斷消滅小型的史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120111,
					"content": "#我是沒這種戰鬥力的，所以，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120112,
					"content": "也許能入口，放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "#{F#妳}{M#你}怎麼知道的，{F#妳}{M#你}難道嘗試過嗎？呃，{F#妳}{M#你}怎麼突然不說話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120114,
					"content": "算了先不說這個，水史萊姆應該很好找。「濃厚凝液」我問過別人，只要消滅大型史萊姆應該就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120115,
					"content": "我還聽傑克說，如果想引出大型史萊姆，就要先不斷消滅小型的史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120116,
					"content": "#我是沒這種戰鬥力的啦，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120117,
					"content": "好說，我知道在哪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "#嚯…真可靠啊，看來{F#妳}{M#你}已經很熟悉怎麼對付史萊姆了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120119,
					"content": "#那就麻煩{F#妳}{M#你}了。「濃厚凝液」，只要消滅大型史萊姆應該就能拿到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120120,
					"content": "我還聽傑克說，如果想引出大型史萊姆，就要先不斷消滅小型的史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205120121,
					"content": "那麼，就萬事拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		},
