			"dialogs": [
				{
					"id": 705590101,
					"content": "大家好啊！看起來，你們的精神都不錯呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590102,
					"content": "多謝關心，這幾天收穫很多，還要多多感謝米卡教官、埃洛雯，還有榮譽騎士和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590103
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590103,
					"content": "唔，好像有點在發表什麼獲獎感言？不過好像也可以這樣說，畢竟特雷斯的成果可以算是大獲成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590104
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590104,
					"content": "沒錯…從騎士團任務的角度來看，特雷斯目前的測繪技巧，已經足以應對九成以上的情景了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590105
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590105,
					"content": "當然，要不是榮譽騎士前輩挑戰「測繪尋物」的方式帶給了我們啟發，這次的訓練可能還需要三倍的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590106,
					"content": "#代表我們配合得好，有默契，對不對？{NICKNAME}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590107,
						705590108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590107,
					"content": "本次體驗相當新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590108,
					"content": "尋物挑戰也給了我靈感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590109,
					"content": "真、真的嗎？榮譽騎士前輩這麼說了之後，不知道為什麼，好像緊張都消散一些了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590110
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590110,
					"content": "我總是擔心如果我做不好，就會出現像米卡教官說的那種情況——「結果影響的往往不僅僅是你自己」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590111
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590111,
					"content": "可惡！但你已經獲得了榮譽騎士的認可…如果我能等到這一句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590112
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590112,
					"content": "埃洛雯也很棒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590113
					]
				},
				{
					"id": 705590113,
					"content": "欸…欸？！真的嗎？我嗎？我、我會好好記住的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590114
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590114,
					"content": "讓我好好想想…要用什麼方式來慶祝這一天呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590115
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590115,
					"content": "說到慶祝，我倒是有個想法…有什麼比一頓熱氣騰騰的美食更適合慶祝呢？聽說埃洛雯的手藝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590116
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590116,
					"content": "嗯？想嚐嚐我的手藝嗎…之前我只在行軍路上做過飯，因為我總是倒楣抽到壞籤…當然，如果你們不嫌難吃的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590117
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590117,
					"content": "怎麼會？埃洛雯的手藝在騎士團裡也算是遠近聞名了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590118
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590118,
					"content": "沒錯…目前還沒有聽過一句負評呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590119
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590119,
					"content": "嗚哇！那我更好奇了！埃洛雯，讓我們嚐嚐妳的手藝嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590120,
					"content": "既然大家都這樣說了，那就沒問題！我想，我只需要一些準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590121
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590121,
					"content": "眾人一起備料、搭建臨時灶臺後，埃洛雯烹飪了許多看起來平平無奇，但香氣卻很誘人的美食…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						705590122
					]
				},
				{
					"id": 705590123,
					"content": "呼…吃飽了！真是吃了以後…又滿足又暖洋洋的料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590124,
					"content": "我什麼都吃了一口，現在馬上快要飛不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590125,
					"content": "這就是騎士的營地餐嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590126
					]
				},
				{
					"id": 705590126,
					"content": "連我都很久沒吃這麼撐過了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590127
					]
				},
				{
					"id": 705590127,
					"content": "畢竟是為了在雪山附近長期執勤而設計的料理，用料紮實，熱量也不能少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590128
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590128,
					"content": "榮譽騎士前輩和派蒙，休息一下後，可以適當做做運動哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590129
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590129,
					"content": "百聞不如一嚐，這次，真的是沒有遺憾了！希望以後還能多和游擊小隊這樣合作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590130
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590130,
					"content": "但吃飽了，就到了要說再見的時間呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590131
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590131,
					"content": "之前收到了同僚的信，隊裡建議我盡早返程，下輪定期訓練又快來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590132
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590132,
					"content": "現在想想，認真學點什麼的時候，時間真的過得好快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590133
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590133,
					"content": "也正是驗證學習成果的時候了，放輕鬆，你可以做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590134
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705590134,
					"content": "恭喜特雷斯從米卡這裡畢業啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705590135,
					"content": "課程大成功！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590136
					]
				},
				{
					"id": 705590136,
					"content": "我一定會拿出全力，充分運用米卡教官傳授給我的所有知識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590137
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705590137,
					"content": "等你也變得赫赫有名的時候，我就可以和別人說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590138
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705590138,
					"content": "欸，你知道那個騎士團裡的特雷斯嗎？他是我測繪課的同學哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛雯"
				}
			]
		}
	]
}