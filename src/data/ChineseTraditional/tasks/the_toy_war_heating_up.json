							3557.77,
							446.167,
							4435.818
						],
						"pointId": 340100225
					},
					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745010101,
					"content": "怎麼感覺留言板上的評價不太對勁呢，不應該全都是猛烈讚美嗎？以前並不是這樣的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010102
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010102,
					"content": "不符合預期，一定是有人在抹黑我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010103
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010103,
					"content": "還好老闆高明，早就準備了應對方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010104
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010104,
					"content": "那當然，不然人能當老闆嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010105
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010105,
					"content": "阿爾邦、阿爾貝，利弗老闆在嗎？他找我們有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010106,
					"content": "太好了，應對方案來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010107
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010107,
					"content": "什麼應對方案？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010108
					]
				},
				{
					"id": 745010108,
					"content": "兩位貴客就是應對方案，哦，這也是老闆的主意，不過他現在不在店裡，還是讓我們來講講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010109
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010109,
					"content": "那就再簡單說兩句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010110
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010110,
					"content": "這兩天我們店裡把「決鬥代理人」企劃對外宣傳了，廣告發遍了全城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010138
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010138,
					"content": "預購也開放了，只要繳交一半的訂金就能獲得搶先體驗的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010111
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010111,
					"content": "除此之外還設置了評價欄，就是店門口那塊留言板，大家可以在上面留下自己的讚美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010112
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010112,
					"content": "嗯，這叫造勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010113
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010113,
					"content": "一開始跟老闆想的一樣，店裡的人氣一下就旺了起來，但就是參加預購的人沒幾個，評價欄也沒有收到什麼讚美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010114
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010114,
					"content": "什麼「誠意不足」啊、「缺乏內容」、「時代變了」啊，都是這樣的留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010115
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010115,
					"content": "看來市場也不是像你們想得那樣嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010116,
					"content": "沒這麼簡單，楓丹有句老話：沒有火就沒有煙。意思是事情不會憑空而起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010117
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010117,
					"content": "也就是說，有人在造謠生事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010118
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010118,
					"content": "惡意抹黑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010119
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010119,
					"content": "信口雌黃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010120
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010120,
					"content": "無事生非！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010121
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010121,
					"content": "老闆說，絕對是他弟弟雇人抹黑我們，沒有別人了，「決鬥代理人」企劃要是成功，最著急的就是勒波特鐘錶店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010122
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010122,
					"content": "那你們打算怎麼樣，該不會是雇我們去抹黑他們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010123,
					"content": "芙寧娜大人在上！您怎麼會這麼想呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010139
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010139,
					"content": "再怎麼說，我們老闆也是卡隆老闆的大哥，就算他們用了這種手段，我們也得堂堂正正地擊敗他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010124
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010124,
					"content": "對啊，這才能達到哥哥教育弟弟的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010125
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010125,
					"content": "那我們要做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010126
					]
				},
				{
					"id": 745010126,
					"content": "讓他們坦白一下誠意和內核！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010127
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010127,
					"content": "坦白？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010128,
					"content": "這樣才公平不是嗎？楓丹是講究公平的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010129
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010129,
					"content": "公平不是這個意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010130,
					"content": "老闆說了，既然大家覺得別人包裝的東西有誠意，那我們也可以跟人家保持一致嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010131
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010131,
					"content": "他們怎麼包裝冒險家，我們就怎麼包裝決鬥代理人，這樣再加上我們在資料豐富度上的優勢，一定能反敗為勝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010132
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010132,
					"content": "他們哪有什麼包裝啊，就是單純地把一個冒險家的故事做成了玩具而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010133,
					"content": "那個故事！去問問是什麼故事，求您了，那個故事一定就是包裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010134
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010134,
					"content": "我也聽到過小道消息，卡隆老闆有天在喝酒的時候無意中說了，這個玩具是因為某人而做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010135
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010135,
					"content": "能說出這種話，他和那個冒險家是不是經歷了什麼不得了的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010136
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010136,
					"content": "#哦？！卡隆老闆和那個冒險家？我突然一下就好想知道是什麼故事喔，{NICKNAME}，不如我們再去問問看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010137,
					"content": "#太棒了！派蒙女士、{NICKNAME}{M#先生}{F#女士}，就交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿爾邦"
				}
			]
		},
		{
			"id": 7450102,
			"completionStepIds": [
				7450102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
