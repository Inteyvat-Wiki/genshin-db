						],
						"stepId": 7450102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡隆"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3626.387,
							446.167,
							4476.965
						],
						"pointId": 340100124
					}
				]
			},
			"dialogs": [
				{
					"id": 745010201,
					"content": "又見面了，兩位客人，不知道最近怎麼樣？有試玩過冒險家玩具嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010202
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010202,
					"content": "嘿嘿，卡隆老闆好呀，其實我們就是有點事想來詢問一下，剛好就是關於那個玩具的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010203,
					"content": "#哦——剛好，我喜歡剛好，想睡懶覺剛好休息，想買東西剛好買得起。所以，有什麼{F#妳}{M#你}們儘管問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010204
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010204,
					"content": "想知道關於這個玩具的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010205
					]
				},
				{
					"id": 745010205,
					"content": "沒錯！我們聽說卡隆老闆是因為某人而做的玩具，一定就是以那個作為主角的冒險家吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010206,
					"content": "哈哈，原來是這個啊，那位冒險家確實是讓我印象深刻的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010207
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010207,
					"content": "那是我快要離開蒙德的時候，在清泉鎮外面遇見的一位冒險家，當時他好像搞砸了一個委託，叫什麼餐品訂單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010208
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010208,
					"content": "據說是路途上連續遇到了好幾波魔物，一來耽誤了時間，二來把餐品弄灑了，我略懂廚藝，就主動幫他重新做了一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010209
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010209,
					"content": "卡隆老闆真熱心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010210,
					"content": "#哈哈，但這點熱心完全不夠用，{F#妳}{M#你}們一定很難想像，只是做份料理而已，為什麼會有那麼多意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010211
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010211,
					"content": "生火的柴被打濕啦…鍋底被鏟了個大洞啦…裝盤時被不明飛石砸中啦這些…有一個還彈到了我的腦袋上，還真的滿痛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010212
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010212,
					"content": "雖說最後勉強完成了委託，但還是被客人投訴了，理由是吃到了讓門牙斷裂的石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010237
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010237,
					"content": "芙寧娜大人在上，該不會就是砸中我們腦袋的那個吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010213
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010213,
					"content": "這個冒險家，是不是叫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010214
					]
				},
				{
					"id": 745010214,
					"content": "叫班尼特，該不會…兩位客人也認識他吧？這傢伙真是太神奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010215
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010215,
					"content": "後來他為了感謝我，帶我去了蒙德各種人跡罕至的地方，雖然路很難走，但風景特別美麗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010216
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010216,
					"content": "我還以為他是兼職什麼資深旅遊愛好者，沒想到他告訴我，這些他若不是冒險時失足跌落，就是不小心迷路誤闖過去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010217
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010217,
					"content": "我返程的那天，他來與我告別，我問他，這種倒楣的體質是不是很麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010218
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010218,
					"content": "結果他笑著豎起了大拇指，說：「世上就是有各式各樣的人，也許我就是最倒楣的那個。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010219
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010219,
					"content": "「但正因為這樣，我剛好又成了最有勇氣的那個。所以這是世上只屬於我的風景喔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010220
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010220,
					"content": "真是厲害的說法。走在不幸鋪就的路上，卻還是大笑著向前，也許這就是真正的冒險家吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010238
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010238,
					"content": "沒錯！班尼特就是最冒險家的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010239,
					"content": "呵呵，我在想要是霉運會傳染，那這種冒險精神一定也能傳染，而且能傳染到更遠的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010221
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010221,
					"content": "#不知道這個故事，夠不夠讓{F#妳}{M#你}們回去交差啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010222
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010222,
					"content": "啊…卡隆老闆，你怎麼又知道了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010223,
					"content": "沒有火就沒有煙，這就是楓丹人的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010224
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010224,
					"content": "#{F#妳}{M#你}們如果很想知道這個故事，第一天就會問了，今天才來問，大概是受我大哥之託吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010225
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010225,
					"content": "真是一下子就被看穿了！明明卡隆老闆溫柔又有智慧，好難相信利弗老闆會對這樣的弟弟有偏見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010226,
					"content": "那是因為大哥在生氣吧，覺得我背叛了他，他一定到現在還在生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010227
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010227,
					"content": "欸？！背叛？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010228,
					"content": "我們家祖上就是以發條手藝聞名的，我從小就很擅長做一些發條玩具，雖然這方面大哥不如我，但他在商業上很有頭腦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010229
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010229,
					"content": "因為都喜歡玩具，我們就約定，長大了要開一家最厲害的玩具店。但是長大了才知道，家業是必須有人來繼承的，就是這家鐘錶店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010230
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010230,
					"content": "大哥和父親大吵了一架，出去自立門戶了，但我被說服了，沒有跟隨大哥，這是背叛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010231
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010231,
					"content": "唔…這算什麼背叛啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010232,
					"content": "至少也是沒有冒險精神的體現了，我也擔心沒有闖出什麼成就，又得灰頭土臉地回來。把愛好當作事業，那樣的壓力我承受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010233
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010233,
					"content": "從小我就是這樣的，遇到找麻煩的混混我第一個哭，但大哥就會把我擋在後面說，「看大哥把他們一拳打飛！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010234
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010234,
					"content": "你們兄弟的關係好像還有點複雜呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010235,
					"content": "呵呵，剛好就是這樣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010236
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745010236,
					"content": "總而言之，如果還有什麼疑問，我就在這裡，隨時歡迎兩位光臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡隆"
				}
			]
		},
