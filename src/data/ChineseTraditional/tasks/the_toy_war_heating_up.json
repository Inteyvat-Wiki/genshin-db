			},
			"dialogs": [
				{
					"id": 745010301,
					"content": "老闆，兩位客人回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010302
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010302,
					"content": "兩位還是這麼迅速啊，這次一定也是收獲滿滿吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010303
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010303,
					"content": "利弗老闆，你怎麼總是在第二時間出現啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010304,
					"content": "怠慢了，下次我保證第一時間出現。嘿嘿，關於那個玩具的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010305
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010305,
					"content": "將班尼特的故事告訴了利弗，他的眉頭蹙了起來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010306
					]
				},
				{
					"id": 745010306,
					"content": "為一個名叫做班尼特的冒險家而製作的玩具？原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010307
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010307,
					"content": "利弗老闆，還有一件事哦，雖然沒有問，但我覺得你弟弟沒有抹黑你們店啦，他一定不會做這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010308,
					"content": "此話怎說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010309
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010309,
					"content": "他好像對利弗老闆心懷歉意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010310
					]
				},
				{
					"id": 745010310,
					"content": "#將卡隆的話轉述了出來，利弗的眼神漸漸穿過{F#妳}{M#你}們，望向了忽遠忽近的飄渺處，如同一臺正在調整焦點的留影機。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010311
					]
				},
				{
					"id": 745010311,
					"content": "過了好一段時間，他才從胸膛擠出了一聲小小的不滿。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010312
					]
				},
				{
					"id": 745010312,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010313
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010313,
					"content": "真要說的話，我也沒覺得那臭小子會做這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010314
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010314,
					"content": "什麼嘛，那還搞什麼應對方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010315,
					"content": "老闆是在找藉口啦，給自己有個台階下，順便找個瞭解那個故事的藉口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010316
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010316,
					"content": "我看八成也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010317
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010317,
					"content": "做生意的嘛，哪有不要面子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010318
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010318,
					"content": "而且還是大哥，大哥的面子比天空還大，所以才叫大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010319
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010319,
					"content": "再多嘴就把你們一拳打飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010320
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010320,
					"content": "利弗老闆還真的是像卡隆老闆說的那樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010321,
					"content": "兩位貴客，我剛剛在想，我也許應該去見那臭小子一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010322
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010322,
					"content": "哇！卡隆老闆這是要放下哥哥的架子，虛心請教弟弟了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010323,
					"content": "當然不是，我的意思是，要不要給他一個當面跟我道歉的機會，他不是也說覺得背叛我了嗎？他不是對我心懷歉意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010324
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010324,
					"content": "呃…雖然是這麼說了…但總覺得不是那種應該道歉的背叛啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010325,
					"content": "那…就先這麼決定了。阿爾邦，把之後的預購都取消了，訂金該退的退，評價板也先收起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010326
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010326,
					"content": "什麼？老闆！難道企劃不做了嗎？那之後的資料收集怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010327
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010327,
					"content": "其實也有調整修改的餘地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010328
					]
				},
				{
					"id": 745010328,
					"content": "#不，資料收集工作還要繼續，我另有打算。而且至少要讓{F#妳}{M#你}們把薪水拿完，對吧？我做生意很講誠信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010329
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010329,
					"content": "噫，老闆的誠信出現在了奇怪的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010343,
					"content": "老闆不愧是老闆啊，連任性的樣子都那麼老闆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010330
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010330,
					"content": "哼，那小子對玩具的態度，也不是完全沒有可取的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010331
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010331,
					"content": "等過幾天資料收集的事結了，我就登門拜訪一下勒波特鐘錶店，希望兩位貴客那天也能來一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010344
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010344,
					"content": "今天店裡還有點事，就先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010345
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745010345,
					"content": "利弗轉身走進了店裡。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010332
					]
				},
				{
					"id": 745010332,
					"content": "啊…利弗老闆的脾氣還真怪啊…該不會真的打算要求人家道歉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010333,
					"content": "哎呀，這樣看，這次又是第三人帶來了轉機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010334
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010334,
					"content": "什麼？什麼第三人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010335,
					"content": "#就是兩位貴客啦，因為{F#妳}{M#你}們的出現，利弗老闆和卡隆老闆的矛盾又有緩和的跡象了，以前也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010336
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010336,
					"content": "以前也是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010337
					]
				},
				{
					"id": 745010337,
					"content": "嗯，貴客們有注意到嗎？我們的店和勒波特鐘錶店中間隔了一個北國銀行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010346
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010346,
					"content": "最早老闆其實是想把店面開在勒波特鐘錶店隔壁的，和他們針鋒相對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010338
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010338,
					"content": "但後來那個位置被北國銀行預定走了，雖然他們大概不知道老闆的事，但某種意義上，就像變成了中間調停的第三人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010339
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010339,
					"content": "真有趣，雖然愚人眾很喜歡插手別人的事，不過這樣的好像還是第一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745010340,
					"content": "所以說，第三人很重要，就像雙人喜劇還需要至少一個觀眾那麼重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010341
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745010341,
					"content": "那單人喜劇呢？一個演員加一個觀眾就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010342
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745010342,
					"content": "你說什麼？你這傢伙也要背叛我嗎？小心我一拳把你打飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿爾邦"
				}
			]
		},
