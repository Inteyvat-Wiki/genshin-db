			"dialogs": [
				{
					"id": 740450601,
					"content": "#又見到{F#妳}{M#你}們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450602,
					"content": "是想知道什麼關於礦石的事情嗎？不管是什麼都可以問我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450603,
					"content": "雖然芙佳也不一定知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450604,
					"content": "關於珍貴的寶石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "雖然附近的礦脈有很多閃亮亮的、好看的石頭，但是距離真正的寶石還有很大的差距…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450606,
					"content": "如果我也能夠找到真正的寶石的話，說不定就能像希露艾姐姐一樣擁有自己的寶石工坊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450607,
					"content": "關於礦石的用途…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "欸？芙佳從來沒有想過這些…我只是覺得好看才會收集各式各樣的石頭的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450609,
					"content": "沒問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "#嘿嘿，謝謝{F#妳}{M#你}們過來找芙佳玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
