			"dialogs": [
				{
					"id": 740450101,
					"content": "芙佳妳怎麼又跑到這裡來了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450102,
					"content": "雖然附近應該不會再出現什麼魔物了，但也不知道還會不會有其他危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450103,
					"content": "一個人的話還是不要到處亂跑比較好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450104,
					"content": "#派蒙和{NICKNAME}{M#哥哥}{F#姐姐}，我沒有亂跑啦…其實我是過來找我的「信物」的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450105,
					"content": "欸？妳的「信物」弄丟了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450106,
					"content": "嗯…應該是在我之前撿石頭的那個地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450107,
					"content": "唔…該不會是上次被困住的時候，一不小心丟在那裡的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450108,
					"content": "嗚嗚…應該就是那個時候弄丟的沒錯…當時因為太害怕了，完全顧不了這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450109,
					"content": "雖然現在想起來也有點可怕，但是「信物」很重要，必須找回來才可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450110,
					"content": "唔…不過要是芙佳一個人過去找的話也太危險了，既然這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}，我們就再去一趟之前那個地方，幫芙佳把「信物」找回來吧，芙佳就先回家等我們好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450112,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#謝謝{F#妳}{M#你}們，{NICKNAME}{M#哥哥}{F#姐姐}，派蒙！我會乖乖待在家裡等{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450113,
					"content": "正好趁機探索一番。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
