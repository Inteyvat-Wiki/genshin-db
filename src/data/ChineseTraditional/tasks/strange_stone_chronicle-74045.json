			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "芙佳，我們回來啦！妳的信物已經找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450202,
					"content": "將找到的信物交給芙佳。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "#嗯嗯，就是這個沒錯，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450204,
					"content": "不過，我們在找信物的時候還發現了這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450205,
					"content": "是之前從來沒有看過的礦石，想說搞不好會是什麼珍貴的寶石的說，所以就一起帶回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450206,
					"content": "我記得芙佳說自己以前經常在這附近撿好看的石頭回來，應該也有看過這種的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450207,
					"content": "讓我看看…真的很好看！不過…不是什麼珍貴的石頭，只是普通的石頭而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450208,
					"content": "雖然在其他地方可能沒有這樣的礦石，不過在這裡的礦脈附近到處都是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450209,
					"content": "什麼嘛，原來只是普通的石頭啊，我還以為會很值錢耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450210,
					"content": "看起來也沒有什麼其他用途，我們就找個地方把它丟掉好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450211,
					"content": "不過外面的人說不定沒看過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "#哦哦，{F#妳}{M#你}的意思是說，如果拿到外面去賣的話，說不定可以賣個好價錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450214,
					"content": "#的確外面的人一定不會想到來美露莘的村子裡面採礦，他們應該也沒看過這種礦石…好聰明啊，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450215,
					"content": "既然這樣，我們就把這個石頭拿去楓丹廷，給那裡的商人看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450216,
					"content": "#嗯，{F#妳}{M#你}們要是想知道更多關於礦石的事情的話，也歡迎隨時來這裡找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450217,
					"content": "雖然我不像姐姐一樣擁有自己的寶石工坊，鑑定處理之類的事情我也不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450218,
					"content": "比起那些珍貴的寶石，我更喜歡收集各式各樣有趣的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450219,
					"content": "所以這附近礦脈的情況我還是很瞭解的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740450220,
					"content": "嗯嗯，知道啦，芙佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740450212,
					"content": "不過如果只在這裡有的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
