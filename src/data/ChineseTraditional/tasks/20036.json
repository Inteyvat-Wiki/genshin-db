			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛蘿麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "…古德溫…到底什麼時候能回來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360102,
					"content": "妳好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "這個聲音…是遠方來的旅行者嗎？感謝風神大人，一定是他的風將您帶來的…請您聽聽我的請求吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360104,
					"content": "我的…唔，男朋友，西風騎士古德溫離開蒙德城已經很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360105,
					"content": "這麼久了，我一直沒有收到他的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360106,
					"content": "我很擔心古德溫。他要和那些難纏的丘丘人，還有他和我說過的深淵教團戰鬥，要是他受了傷怎麼辦，而且離開那麼久，要是他遇見了哪位溫柔的女騎士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360107,
					"content": "抱，抱歉！我，我自顧自說太多了！我聽我母親說，蒲公英能夠帶著人們的思念，被風一直帶到很遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360108,
					"content": "所以我的請求是…能不能請您幫我去風起地搜集三份蒲公英籽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360109,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "太感謝您了，願風神保佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360110,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "等一下！求您了，對您這樣的旅行者來說，這肯定只是舉手之勞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛蘿麗"
				}
			]
		},
