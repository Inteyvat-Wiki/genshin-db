			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛蘿麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "您回來了，蒲公英搜集到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360202,
					"content": "已經搜集好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "謝謝您，請您把蒲公英籽放在我手上，好嗎？我看不見，怕把它們都弄撒了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360204,
					"content": "這些夠了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "請您先把蒲公英籽放在我手上吧，這樣我才能感受一下它們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360206,
					"content": "這些就夠了，我要把想和古德溫說的話都告訴它們才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360207,
					"content": "唔——請您捂住耳朵，別偷聽，這是戀人之間的悄悄話哦。您肯定也…嘻嘻，您有過這種體驗嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360208,
					"content": "好啦。請您帶著這些蒲公英籽去風神像上，然後把它們灑在風中，讓風神大人帶走它們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360209,
					"content": "希望風神大人，能夠把它們帶到古德溫身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛蘿麗"
				}
			]
		},
		{
			"id": 2003603,
			"completionStepIds": [
				2003606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
