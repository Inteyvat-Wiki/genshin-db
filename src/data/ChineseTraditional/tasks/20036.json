			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛蘿麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "您已經完成了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360302,
					"content": "頂上的風真大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "這樣子才好，能讓蒲公英飛得更遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360304,
					"content": "這樣子，古德溫說不定就能收到，我對他說的話了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360305,
					"content": "您伸出手來吧，讓我能碰到…請拿好了，這些謝禮是給您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200360306,
					"content": "我還有很多話想要和古德溫說，之後，說不定也要多多麻煩您啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛蘿麗"
				}
			]
		}
	]
