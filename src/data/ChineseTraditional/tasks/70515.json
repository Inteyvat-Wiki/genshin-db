				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "太棒了！整整六幅「恆動械畫」部件！接下來，我們只需要再把他們全都拼起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150102,
					"content": "全、全都拼起來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "那是當然，這六幅小型的「恆動械畫」部件可以再次組裝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150104,
					"content": "拼接成一幅…龐大的！絕美的…大型「恆動械畫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150105,
					"content": "來吧，接下來我們只需要把它們都拼接起來就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150106,
					"content": "不用燒鑄什麼的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "不，不不不不，絕對不用，我的機器不是那種笨拙地強捏在一起的金屬垃圾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150109,
					"content": "每一個零件，都簡潔又巧妙地組裝在一起，就像是…呃…就像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150110,
					"content": "算了，打比方的事我從來不在行，我在修辭學方面的靈感全讓澤維爾偷走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150111,
					"content": "總之，請您來親手試試吧，相信我，這會很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150107,
					"content": "需要什麼額外工藝嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
