			"trigger": {
				"objectNames": [
					"菲利斯·尤格"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "完美，太美麗了！您的理解力和動手能力真不錯，真是超乎我的預料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150202,
					"content": "哈，《蒸汽鳥日報》還有幾篇荒謬的稿件把您形容地就像是一個…一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150203,
					"content": "一個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "呵…呵呵…一個…樂於用劍來說服人的…直爽勇者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150206,
					"content": "荒謬，愚蠢！寫這幾篇稿件的記者簡直是無事生非！您明明是一位敏銳、聰慧、謙遜…又直爽的勇者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150207,
					"content": "等我有空了，我一定要寫封信去狠狠駁斥他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150208,
					"content": "對了，這份機關就請您收下吧，無聊的時候，您可以用它來解悶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150209,
					"content": "而我嘛…嗯…我得開始籌措去璃月的路費了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705150204,
					"content": "你接著說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
