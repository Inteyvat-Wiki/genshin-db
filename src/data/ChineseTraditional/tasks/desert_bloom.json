			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#旅行者，{F#妳}{M#你}來得正好，快來嚐嚐我做的薄荷豆湯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410303,
					"content": "這些材料是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "有些是我託人買回來的，但是薄荷嘛…是我自己種的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410305,
					"content": "里夫不是送了我一套園藝工具，還有一堆肥料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410306,
					"content": "如果僅僅是種一盆花，我覺得實在是太浪費了…所以，我就拜託阿扎萊幫我買了一些薄荷種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410307,
					"content": "把薄荷種子種下去之後，我就和照顧那盆花一樣照顧著它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410308,
					"content": "照顧著照顧著，薄荷就順利地成長…成熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410309,
					"content": "我就摘了一些下來，做成了「薄荷豆湯」，怎麼樣，味道還不錯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410310,
					"content": "#那…{F#妳}{M#你}既然喝了我做的「薄荷豆湯」，就得幫我個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410311,
					"content": "那個，我沒喝完…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "#別呀！我開玩笑的，會好好付給{F#妳}{M#你}報酬的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410314,
					"content": "#我就是想請{F#妳}{M#你}去幫我採三顆「墩墩桃」回來，里夫很喜歡吃這種水果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410315,
					"content": "我想把它們加入「薄荷豆湯」裡，然後送去給里夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410316,
					"content": "現在「薄荷豆湯」我已經會做了，就等人幫我去拿「墩墩桃」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410317,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "#謝謝{F#妳}{M#你}啦，等{F#妳}{M#你}回來之後，我再請{F#妳}{M#你}喝一碗「薄荷豆湯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410321,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。採到「墩墩桃」後就帶回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410319,
					"content": "他在工作時能喝嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "就只是喝點東西而已啦，他的工作沒有那麼緊張。",
