			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "呼…這樣鬆土應該就可以了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410102,
					"content": "妳還在照顧這盆花嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "嗯，庫爾蘇姆奶奶教了我很多照顧花的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410104,
					"content": "比如要幫它鬆土啦、定時修剪葉片啦、用各種方法除蟲啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410105,
					"content": "還有澆水不能澆得太多，不然花的根部就會被水泡爛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410106,
					"content": "哎呀，我還以為要每天澆花，時刻讓土壤保持濕潤呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410107,
					"content": "不過這樣也好，我就不用每天都去打水了，取水的地方離這裡很遠啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410108,
					"content": "#我得接著修剪枝葉，旅行者，{F#妳}{M#你}能幫我去打一小壺水過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410109,
					"content": "我已經和卡桑說過了，他答應我可以去取水澆花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410110,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "#水壺就在那邊，{F#妳}{M#你}打水的時候可要注意喔，可不要打上來太多泥沙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410111,
					"content": "這都是庫爾蘇姆奶奶告訴妳的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "唔…差不多吧，庫爾蘇姆奶奶知道的事非常多，我經常去找她請教喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410113,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者，只要打一小壺水過來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "內爾敏"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
				2304111,
				2304116,
				2304117
