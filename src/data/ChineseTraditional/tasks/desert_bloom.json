				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "嗚…又有幾片葉子被咬破了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410202,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "#旅行者，{F#妳}{M#你}看呀！又有小貓過來咬花了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410204,
					"content": "#{F#妳}{M#你}看這片葉子，這片…還有這片！都被咬下去了一大塊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410205,
					"content": "小貓餓了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "里夫也這麼說，他還專門帶著吃的到處去餵貓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410207,
					"content": "但是第二天，還是有小貓過來咬花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410210,
					"content": "現在小貓只是咬葉子，但我就怕小貓有一天開始咬花莖…那就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410211,
					"content": "不過，我也狠不下心去把牠趕得很遠，畢竟外面就是沙漠，牠除了這個村子之外，也無處可去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410212,
					"content": "#旅行者，{F#妳}{M#你}能幫我再去餵餵牠嗎？希望小貓吃飽了之後，別再來咬花了，花葉也不是什麼好吃的東西呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410213,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者，我把那隻小貓經常待的地方幫{F#妳}{M#你}標在地圖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410217,
					"content": "我要在這盆花旁邊守著，免得又有其他的小貓過來咬花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410214,
					"content": "我很擅長和貓打交道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "那樣就最好了！我每次看見小貓的爪子，都擔心牠會突然撲上來給我一爪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230410208,
					"content": "小貓是…咬著玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "我是搞不懂小貓喜歡玩什麼啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "內爾敏"
				}
			]
		},
		{
			"id": 2304103,
			"completionStepIds": [
				2304101,
