			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621201,
					"content": "#我們很快就會撤離，如果阻礙了{F#妳}{M#你}的冒險，那麼實屬抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621202,
						710621210,
						710621213,
						710621221
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621202,
					"content": "關於與千岩軍的合作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621203
					]
				},
				{
					"id": 710621203,
					"content": "很久以前的事情了，這裡剛剛封閉，我們就找上了璃月的七星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621204
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621204,
					"content": "開始大家談得還可以…「女士」大人還順勢談成了幾筆有利於雙方的貿易協定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621205
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621205,
					"content": "而愚人眾先遣部隊進駐層岩巨淵，原本是附加條件之一…我們來到這裡為的是調查和消滅異變源頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621206
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621206,
					"content": "我們調查所得的一切情報，則是由至冬國和璃月公平共用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621207
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621207,
					"content": "你們沒有別的目的了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621208
					]
				},
				{
					"id": 710621208,
					"content": "至少就我們所知，沒有。我們出發時還受到了市民們的祝福，大家都認為…我們是犧牲自己保護別人的英雄部隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621209
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621209,
					"content": "唉…誰知道，現在事情變成了這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				},
				{
					"id": 710621210,
					"content": "關於「黑災」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621211
					]
				},
				{
					"id": 710621211,
					"content": "或者「漆黑災禍」，或者隨便怎麼稱呼…五百年前的那場大災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621212
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621212,
					"content": "總之…是我們至冬人永恆的敵人，我們相信的是…五百年來，災禍一直在潛伏著，而我們會永遠保持警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				},
				{
					"id": 710621213,
					"content": "關於你們自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621214
					]
				},
				{
					"id": 710621214,
					"content": "我們自己？有什麼好說的…我們在努力戰鬥了，但失敗了，就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621215
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621215,
					"content": "下來的時候我們是第九連隊，六十四人。可到現在呢？包括連長在內…犧牲或失蹤的可能超過一半以上，也可能不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621216
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621216,
					"content": "但大致上差不多…我們都被打散了，彼此失去了聯繫…我們已經輸了，早就該撤離了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621217
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621217,
					"content": "你們在地面的同僚攻擊了璃月港。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621218
					]
				},
				{
					"id": 710621218,
					"content": "…很驚訝，但完全理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621219
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621219,
					"content": "為了協助更有意義的冒險，「公雞」大人自然會拋棄相對低價值的資產，這是他的理性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621220
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621220,
					"content": "我們作為他的直屬部下，對此完全可以接受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				},
				{
					"id": 710621221,
					"content": "關於卡塔琳娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621222
					]
				},
				{
					"id": 710621222,
					"content": "#{F#妳}{M#你}遇見她了？她還活著…？我希望她能原諒我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621223
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621223,
					"content": "她和她的弟弟，尼古拉下士，都是在「壁爐之家」長大的…是女皇陛下的孩子們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621224
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621224,
					"content": "她和我說一定要找到弟弟才行，我以為是下面的環境搞壞了她的腦子才讓她那樣子出醜…她的弟弟不可能活下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621225,
						710621230
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621225,
					"content": "所以你們拋棄了她？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621226
					]
				},
				{
					"id": 710621226,
					"content": "拋棄…？不，她…她是自願要留下的。畢竟，我們中的任何人帶著不必要的牽掛…只會拖慢整個隊伍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621227
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621227,
					"content": "畢竟我們…每一個人都要做好為眾人犧牲自己，或為眾人犧牲重要之人的準備…這是作為愚人眾的覺悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621228
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621228,
					"content": "卡佳她一定也做好了這樣的覺悟，科利亞也是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621229
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621229,
					"content": "如果他們對我做出相同的事情，我也完全可以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				},
				{
					"id": 710621230,
					"content": "她的狀況沒你說的那麼差。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621231
					]
				},
				{
					"id": 710621231,
					"content": "#因為{F#妳}{M#你}是外人。愚人眾不能也不應該對平民失態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621232
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621232,
					"content": "但對於她來說，我們是家人。她也是我們的家人…曾經是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621233
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621233,
					"content": "是她自己執意要找科利亞的…希望她能原諒我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				}
			]
		},
