				"objectNames": [
					"拉多米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710622801,
					"content": "#謝謝{F#妳}{M#你}的食物，有什麼話請跟安東連長說吧，我沒什麼可以告訴{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622802
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710622802,
					"content": "#呃…請不要誤會，我是說，關於部隊機密，{F#妳}{M#你}明白的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622803
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710622803,
					"content": "咳咳，總之…希望我們下次能作為朋友再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉多米爾"
				}
			]
		},
