			"trigger": {
				"objectNames": [
					"元成"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "什麼兄弟，大哥們只會把好東西自己先拿到手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070302,
					"content": "老頭子也是一副老糊塗的樣子，睜一隻眼閉一隻眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070303,
					"content": "他們應該還不知道，寶貝在礦洞裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070304,
					"content": "必須要快點去拿寶貝，然後就走…走得遠遠的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元成"
				}
			]
		},
