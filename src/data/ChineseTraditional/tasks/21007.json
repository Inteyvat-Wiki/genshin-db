			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"元青"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "嗚哇…是，是之前的那些人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210070602,
					"content": "孤木孑立，無林可依…哈哈，一個人，果然是什麼都做不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070603,
					"content": "紅葉萋萋，無風自離…如果我能相信大哥和老頭子的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070604,
					"content": "紅葉簌簌，乘風散去…寶貝，寶貝…為了寶貝，什麼都沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070605,
					"content": "盤木森森，蔭蔽家庭…孩子們，我們都是一家人吶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070606,
					"content": "你們都覺得，我把寶貝藏在了礦洞裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070607,
					"content": "但是，我哪裡有什麼寶貝…你們還記得這棵樹嗎，這是你們小時候，我們全家一起栽的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070608,
					"content": "我每年都會過來，在這裡面埋點東西，希望你們長大之後，我們全家再一起去挖出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070609,
					"content": "到時候，我們就用這裡面的東西去買點好吃的，買點小酒，全家在一起，聊聊過去的小事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070610,
					"content": "孩子們哪，孩子們哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元鴻"
				}
			]
		}
	]
}