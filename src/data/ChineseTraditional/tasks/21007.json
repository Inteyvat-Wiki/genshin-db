			"trigger": {
				"objectNames": [
					"元良"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "嘿嘿…這下寶貝都是我的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070402,
					"content": "大哥和小弟可真是傻子，抓了兩句就跑，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070403,
					"content": "什麼祖訓，有用的就一句，寶貝就在礦洞裡，嘿嘿嘿，這下子寶貝全都是我的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元良"
				}
			]
		},
