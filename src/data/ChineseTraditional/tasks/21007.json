			"dialogs": [
				{
					"id": 210070201,
					"content": "可惡！可惡！我到底是造了什麼孽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070202,
					"content": "好不容易趁他們沒反應過來，搶先跑過來礦洞裡拿寶貝，怎麼這麼多怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070203,
					"content": "可惡，可惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元青"
				}
			]
		},
