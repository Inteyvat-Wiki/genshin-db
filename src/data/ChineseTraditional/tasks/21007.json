			"trigger": {
				"objectNames": [
					"元鴻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "走啦…都走啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070502,
					"content": "元青，元良…還有元成，傻孩子們，你們再好好看看，再好好想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元鴻"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
