			"dialogs": [
				{
					"id": 726920201,
					"content": "朋友，畫片已經準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726920202,
					"content": "在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "讓我看看…嗯，很好，我已經有些想法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726920204,
					"content": "#朋友，這次我也根據{F#妳}{M#你}帶來的畫片，寫了不同版本的詩句，就由{F#妳}{M#你}來選選看用哪一句吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊內"
				}
			]
		},
