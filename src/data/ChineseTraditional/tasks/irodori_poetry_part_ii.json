			"dialogs": [
				{
					"id": 726920501,
					"content": "#朋友，既然大伴先生和{F#妳}{M#你}都很喜歡這一句，那就這麼決定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726920502,
					"content": "萊內先生的詩，與畫片相得益彰，伴著畫片讀詩，詩也越發生動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920503,
					"content": "#{M#小哥}{F#姑娘}，其實最近我也正在寫一首詩，明天也要勞{F#妳}{M#你}相助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920504,
					"content": "大伴先生也需要畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "呵呵，我們明天再詳談吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
