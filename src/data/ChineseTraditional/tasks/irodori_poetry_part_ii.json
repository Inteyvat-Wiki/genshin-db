			"dialogs": [
				{
					"id": 726920601,
					"content": "哈哈，我聽說像風一樣自由地飛行是所有蒙德人的夢想，這句詩可說是極有萊內先生的風格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920602,
					"content": "只可惜我小時候並不喜歡出門。如果那時候能有大伴先生作陪的話，可能我現在就有飛行執照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
