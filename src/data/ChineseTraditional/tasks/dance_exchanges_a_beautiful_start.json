					}
				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "最近「流泉之眾」是在舉辦什麼活動嗎？好像多了一些遊客？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080102,
					"content": "那邊有一位須彌客人…在為大家表演舞蹈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080103,
					"content": "啊呀呀，閃亮亮的大英雄和可愛的派蒙參謀也來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080104,
					"content": "向您致以最真摯的問候，我最敬重的戰士、武力和舞力的雙重勇者，以及生活享受家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080105,
					"content": "咦，這位小姐有點眼熟欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080106,
					"content": "#而且，妳怎麼知道{NICKNAME}跳起舞來很開心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080107,
					"content": "#當然是在聖火競技場前看過{M#他}{F#她}歡快的舞姿啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080108,
					"content": "#合過影後，我找了個不那麼顯眼的地方，一邊吃龍龍餅乾，一邊看完了{NICKNAME}的祝福舞蹈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080109,
					"content": "#跳舞就是要輕輕鬆鬆，釋放自我嘛！我都想上去為{NICKNAME}伴舞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080110,
					"content": "想起來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "我的榮幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080114,
					"content": "言歸正傳，如您所見，最近有些須彌朋友盛情來訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080115,
					"content": "經過穆托塔、阿米娜、帕加爾和瑪拉妮的商量，我們「花羽會」決定聯合「回聲之子」與「流泉之眾」，好好招待他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080116,
					"content": "看起來，有不少「鍍金旅團」的傭兵呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080117,
					"content": "讓我猜猜，是不是在沙漠旅行時，不打不相識，打成了朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080118,
					"content": "哎，八九不離十了！不過，不是我們之間互鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080119,
					"content": "我們在千壑沙地南邊大辦烤肉聚會時，引來了一群凶狠的赤鷲，牠們專挑我們吃撐喝撐，跑不動的時機下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080120,
					"content": "打法還十分狡猾，我們一番苦鬥無果，被牠們利用熟悉地形的優勢打得疲憊不堪，只能先撤離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080121,
					"content": "沒想到，一隊傭兵出現在我們後退的路上，對著赤鷲們跳起了神秘的戰舞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080122,
					"content": "結果那些赤鷲好像和他們達成了共識，退了回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080123,
					"content": "用、用戰舞讓赤鷲離開了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080124,
					"content": "是舞姿怪異嚇退了牠們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "很神奇，對不對？我們也很好奇那種舞蹈的奧秘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080127,
					"content": "收拾好營地後，我們一起大口吃肉大桶喝酒，等到酒足飯飽，就開始交流舞蹈的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080128,
					"content": "要是中途還有別的魔物和野獸來打攪我們的興致，我們就一起抄傢伙上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080129,
					"content": "不出兩個禮拜，我們就成了過命的戰友和舞友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080130,
					"content": "分別前，我們約好，以後還要正式造訪各自的營地，繼續「舞術交流」，這次就是開頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080131,
					"content": "#說得對，{NICKNAME}，好像以前我們還沒參加過這種…須彌和納塔朋友互相交流跳舞的活動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080132,
					"content": "的確新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "這可是難得的好機會，來為我們指導一番，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080135,
					"content": "瑪拉妮也在場哦，她算是我們之中最為歡樂的舞蹈代言人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080136,
					"content": "而且，「鍍金旅團」的朋友還花重金邀請了當地有名的舞者，來作為須彌方的領隊和顧問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080137,
					"content": "#我想，{F#妳}{M#你}們肯定也認識那位舞者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080138,
					"content": "好像已經猜到是誰了，嘿嘿，待會我們給她一個大驚喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080139,
					"content": "好啊好啊，我要加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "哈哈哈哈！這下更熱鬧了，用瑪拉妮的話來說，氣氛達到了最嗨點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080142,
					"content": "走吧，我們去找塔拉內小妹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080140,
					"content": "這種活動，不能錯過！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "想要看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "還是兩邊本來就認識？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "以後肯定記住。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "那說明我工作還不夠賣力，沒留下什麼亮眼的成就，仍需努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "努斯妲"
				}
			]
		},
		{
			"id": 7650803,
