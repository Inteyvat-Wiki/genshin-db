				]
			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#啊呀，啊呀呀！這不是大名人{NICKNAME}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "塔拉內"
				},
				{
					"id": 765080302,
					"content": "我以為請到妮露小姐已經是萬幸中的萬幸了，沒想到還有高手中的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "塔拉內"
				},
				{
					"id": 765080303,
					"content": "#多誇誇{NICKNAME}，我愛聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080304,
					"content": "欸？這不是我的臺詞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080305,
					"content": "沒錯！同樣的字詞由派蒙參謀說出來，聽感靈巧輕盈，好比悠可琴的音軌，軟軟彈彈可可愛愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080306,
					"content": "而由我來說，聽感就像是…鼓手喝了半桶酒後打出來的段子，抑揚頓挫、勁道踏實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080307,
					"content": "當然，依照伊安珊大師的教誨，大鼓的雙踏也多多益善，最好像自動槍一樣連綿不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080308,
					"content": "這樣，就算我們說了一樣的臺詞，也不嫌重複囉嗦，而是互相補全多個聲部，還可以讓妳卡準節奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080309,
					"content": "還、還有這種事？聽得都暈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080310,
					"content": "努斯妲大姐講到重點了——節奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "塔拉內"
				},
				{
					"id": 765080311,
					"content": "我們的舞蹈自由而張揚，但也不能完全無拘無束。至少，最關鍵的動作需要精準卡點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "塔拉內"
				},
				{
					"id": 765080312,
