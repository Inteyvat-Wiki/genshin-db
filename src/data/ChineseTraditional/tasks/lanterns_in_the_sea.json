			"dialogs": [
				{
					"id": 400050501,
					"content": "原來事情是這樣。人類的行為總是愚蠢得如此隨機…不過，我無所謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050502,
					"content": "好了。你們把我喊到能看見「明霄燈」的地方來，究竟是為了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050503,
					"content": "當然是為了「明霄燈」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "明明海燈節紀念的英雄裡也包括你…為什麼你卻不想去看燈呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050506,
					"content": "我無法靠近人群。那些，無憂無慮的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050507,
					"content": "苦行與殺戮的日子，我已經過得太久…已經成為習慣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050508,
					"content": "這個話題就到這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050509,
					"content": "再見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050510,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050511,
					"content": "不過，如果你在璃月遇到了鬼神之難，就直呼我名吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050512,
					"content": "#不論是{F#妳}{M#你}，還是璃月。所有的燈火，所有祈求平安的願望，我都已經聽到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050513,
					"content": "那麼，新年快樂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "新年快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050504,
					"content": "當然是為了海燈節。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
	]
