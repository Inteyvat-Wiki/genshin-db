			"dialogs": [
				{
					"id": 400050201,
					"content": "兩位就是來自盜寶團的朋友嗎？我明明已經在密信中說自己會喬裝，也請兩位盡情喬裝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050202,
					"content": "而今這位朋友卻以本來面目現身，實在坦蕩，在下佩服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050203,
					"content": "哼哼。我們和你這種藏頭露尾的人不一樣，我們可沒有做過不戴上面具就不敢出現的虧心事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050204,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050205,
					"content": "是他說盡情喬裝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "你們，不是盜寶團的人！你們是什麼人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050206,
					"content": "其實我覺得這樣還蠻帥的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
