				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "快把你的陰謀詭計招了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050402,
					"content": "我招我招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050403,
					"content": "不招的話，就嘗嘗我…欸！招得這麼快嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050404,
					"content": "其實我…是嚮往「盜寶團」威名的新手盜賊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050405,
					"content": "新手盜賊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050406,
					"content": "像我這樣初出茅廬，又孤身一人的新手…盜寶團就是我心中的聖地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050407,
					"content": "等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050408,
					"content": "所以我想要幹出一樁大買賣，去納投名狀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050409,
					"content": "等一下！完全搞不明白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050410,
					"content": "這和我想像的，兇殘又邪惡的縱火黑手，完全不一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050411,
					"content": "縱火，什麼縱火？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050412,
					"content": "你一直在易燃物堆放的地方晃蕩，難道不是為了縱火嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050413,
					"content": "啊啊，你說那裡啊。我只是在那裡踩點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050414,
					"content": "我的計畫和那些建築材料沒有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050415,
					"content": "沒有關係？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050416,
					"content": "我是為了…偷走那塊二十年一遇的巨大「浮生石」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050417,
					"content": "我的計畫是，趁著夜色砍斷一半繩索，就這樣讓它往海的方向飄——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050418,
					"content": "哦哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050419,
					"content": "再想辦法讓它沉到雲來海的淺水灣裡，這樣就是完美犯罪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050420,
					"content": "不完美的地方太多了！比如你要怎麼把浮空的浮生石沉到水裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050421,
					"content": "我也在思考這個問題，所以一直沒動手嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050422,
					"content": "這人真的腦子不清楚啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050423,
					"content": "#好了，{NICKNAME}，給他一個教訓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400050424,
					"content": "那麼，我們去和夜叉小哥覆命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
