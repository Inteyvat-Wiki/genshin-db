			"dialogs": [
				{
					"id": 140250801,
					"content": "今天要去哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140250802,
					"content": "到遠一些的地方試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
		{
			"id": 1402510,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1402505",
							"2"
						],
						"stepId": 1402505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"那維萊特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "之前提到過，我可以輕易地和他人的情感產生共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140251002,
					"content": "然而在幾次見面中，我幾乎無法從這位執行官的身上感受到任何東西。她的內心就像平靜的湖水，幽暗深邃沒有任何漣漪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140251003,
					"content": "我不清楚她是天生如此，還是已經能靠自我意志來掌控情感。無論是哪一種，都意味著她很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140251004,
					"content": "#我不會過問{F#妳}{M#你}們跟隨她行動的原因。但請{F#妳}{M#你}們務必要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				}
			]
		}
	]
}