						],
						"pointId": 340300430
					}
				]
			},
			"dialogs": [
				{
					"id": 140250201,
					"content": "#又見面了。看{F#妳}{M#你}們一臉憔悴，昨晚沒休息好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250202,
					"content": "是有一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250203,
					"content": "少一點心事，說不定可以睡個好覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250204,
					"content": "接下來想做什麼，睡個回籠覺，還是絞盡腦汁想些新的話題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250205,
					"content": "#我的確有點好奇，今天「公子」不在，{F#妳}{M#你}們要找什麼理由把我留在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250206,
					"content": "（！！！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "妳、妳在說什麼呀，我們只是來隨便聊聊天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250208,
					"content": "沒想好的話，陪我去個地方如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250209,
					"content": "別緊張，我們會繞開那些鬼鬼祟祟的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250210,
					"content": "啊…今天的海風好舒服呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250211,
					"content": "妳都知道了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "孩子們總是自認為能騙過大人的眼睛，可那些小算盤我看得一清二楚。讓他們多折騰一段時間吧，我有足夠的耐心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250213,
					"content": "我先走了，想清楚就跟上來，我們在沫芒宮門口見面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250214,
					"content": "乖乖聽話，或許他們還有一線生機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250215,
					"content": "怎、怎麼辦啊！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250216,
					"content": "她剛剛的語氣，很明顯是知道我們做的事了吧？而且她擺明了是在要挾我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250217,
					"content": "先放飛林尼給我們的魔術鴿子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "嗯，希望林尼能及時收到我們的預警…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250219,
					"content": "接下來，我們還是要去一趟沫芒宮吧。她都這麼說了，感覺不去的後果很嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250220,
					"content": "也沒什麼更好的辦法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "那我們快跟上去。如果她等急了，直接去找林尼，那就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250221,
					"content": "走一步看一步吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
