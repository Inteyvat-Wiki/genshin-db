							-16.329
						],
						"pointId": 84
					},
					{
						"sceneId": 1083,
						"position": [
							-35.909,
							0.334,
							-18.022
						],
						"pointId": 85
					},
					{
						"sceneId": 1083,
						"position": [
							-35.757,
							0.351,
							-14.567
						],
						"pointId": 86
					}
				]
			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "許久不見，那維萊特先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250402,
					"content": "沒想到我的會見申請這麼快就能被批准，沫芒宮的效率真是讓人由衷讚嘆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250403,
					"content": "對一位聲名在外的外交官，這是必要的尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250404,
					"content": "但客觀來說，我原以為「贈予神之心」會是我們最後一次見面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250405,
					"content": "#…這次還帶上了{NICKNAME}和派蒙，到底所為何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250406,
					"content": "我很快就要離開楓丹了，臨走之前，還有一件放心不下的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250407,
					"content": "幾句話未必能說清楚，我寫好了一份提案，請那維萊特先生過目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250408,
					"content": "僕人遞出一份文件，之後優雅地端起杯子，品嚐著杯中的水。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "我明白妳的請求了。恕我直言，我無法理解妳這麼做的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250410,
					"content": "聽聞那維萊特先生有品水的愛好，我就用水來做比喻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250411,
					"content": "家就像一個巨大的湖泊，無數條河流匯聚而入，無數條河流奔湧而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250412,
					"content": "作為一個每天注視著湖泊的人，我希望每一條流出的河都能抵達大海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250413,
					"content": "然而客觀事實告訴我這是不可能的。絕大部分河流都會在半路乾涸，滲入泥土中，再無聲息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250414,
					"content": "我想給那些「看不見海的水」，找一些存在的意義。比如灌溉兩岸的田地，或是成為某個人杯中的甘泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250415,
					"content": "#喂，{F#妳}{M#你}聽懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140250416,
					"content": "不是很懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "我有必要提醒妳，無論妳如何美化它們，都沒有人想要品嚐「渾濁的水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250419,
					"content": "是「曾經渾濁的水」。別擔心，我會濾淨水中的泥沙，讓它們回到最純淨的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250420,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250421,
					"content": "既然妳提到這是「交易」，那我們聊一聊細節吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250422,
					"content": "如果那維萊特先生同意我的提案，我的勢力會逐漸撤出楓丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250423,
					"content": "今後非必要情況，我們不會在楓丹執行「特殊任務」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250424,
					"content": "妳的意思是，今後不會發生「達爾杜弗遇刺」這種事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250425,
					"content": "你說那個貪汙善款的偽君子？我對他的遇害表示沉痛的悼念，不過目前好像並沒有證據指向壁爐之家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250426,
					"content": "當然，如果那維萊特先生答應我的提案，我可以幫忙做一些事情，讓類似的麻煩少一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250427,
					"content": "真是滴水不漏的發言。好吧，我原則上同意妳的提案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250428,
					"content": "感謝您的寬宏，那維萊特先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250429,
					"content": "交易達成，我們也該告退了。我託人帶了兩瓶來自至冬的泉水，希望下次有機會聽聽您的感想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250430,
					"content": "下次再會。記得妳的承諾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 140250431,
					"content": "#好了，{NICKNAME}、派蒙，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 140250417,
					"content": "半懂不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				}
			]
		},
