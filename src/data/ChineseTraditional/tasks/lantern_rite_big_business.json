			"dialogs": [
				{
					"id": 413342601,
					"content": "謝謝老闆招待了，這是錢，您點一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342602
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342602,
					"content": "好好，這些錢夠了…看二位的樣子，是要接著趕路？還是說，要回去城裡看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342603
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342603,
					"content": "我聽說今年那「明霄燈」可不一般，神氣得很哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342604
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342604,
					"content": "我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342605
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342605,
					"content": "如果有機會的話，我們會去看的，謝謝老闆提醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342606
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342606,
					"content": "不過…老闆，可否再賣我們一盞霄燈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342607
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342607,
					"content": "就算是沒機會去城裡看「明霄燈」，放一放霄燈也是好的…對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342608
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342608,
					"content": "小姐說的是，海燈節當然應該放霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342609
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342609,
					"content": "那好說，沒問題，我手頭上正好有幾盞新編的霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342610
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342610,
					"content": "喏，送給妳們一盞了，大過節的，霄燈就不收妳們錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342611
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342611,
					"content": "多謝老闆了，那我再多問一句，這周圍有什麼適合放霄燈的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342612
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342612,
					"content": "放霄燈的地方…那得高一點，沿著這條路往山上走，我記得有個適合放霄燈的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342613
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342613,
					"content": "不過，我聽說這山裡有魔物出沒，妳們可要小心點啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱老闆"
				}
			]
		},
