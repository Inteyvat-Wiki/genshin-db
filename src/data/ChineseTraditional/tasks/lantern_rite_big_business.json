			"dialogs": [
				{
					"id": 413342701,
					"content": "#旅行者，抱歉打擾{F#妳}{M#你}，請問…{F#妳}{M#你}願不願意護送我們上山去放霄燈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342702,
						413342703
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342702,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342704
					]
				},
				{
					"id": 413342704,
					"content": "抱歉，因為某些事情…我們暫時不方便回城裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342705
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342705,
					"content": "#那就拜託{F#妳}{M#你}護送一下我們了，快些出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342706
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342706,
					"content": "放完霄燈後…我們就要接著趕路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342703,
					"content": "為什麼妳們不回城裡去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342704
					]
				}
