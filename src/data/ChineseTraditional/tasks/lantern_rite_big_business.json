					"朱老闆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413342501,
					"content": "二位這邊請，這邊請，我們這什麼都備齊了，這邊坐就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342502
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342502,
					"content": "老闆，這兩位是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342503
					]
				},
				{
					"id": 413342503,
					"content": "哦，我剛才也自己出去招攬客人了，走到下面的時候，就遇見了這兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342504
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342504,
					"content": "是的，這位是明華錢莊的小姐，我是明華錢莊的員工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342505
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342505,
					"content": "我和小姐本來正在出行遠遊，恰逢海燈節，小姐有些…想家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342506
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342506,
					"content": "所以我們就想要挑個地方看看霄燈，恰巧走到這裡，就遇見了這位老闆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342507
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342507,
					"content": "那是，我這店裡正好新編了許多霄燈，這不是巧了。但是…明華錢莊？這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342508
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342508,
					"content": "啊…咳咳！我不多問了，不多問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342509
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342509,
					"content": "二位走了這麼長的路肯定累了，請在這裡先歇著吧，我去為你們準備飯菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342510
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342510,
					"content": "#旅行者，請{F#妳}{M#你}也幫個忙吧，他們兩個人，上菜可不能慢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342511
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342511,
					"content": "#請{F#妳}{M#你}幫我準備一道「美味的珍珠翡翠白玉湯」來吧，拜託了，報酬到時候我一起算給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱老闆"
				}
			]
		},
