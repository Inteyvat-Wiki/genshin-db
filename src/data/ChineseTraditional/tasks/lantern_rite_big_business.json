			"dialogs": [
				{
					"id": 413342201,
					"content": "怎麼樣，菜做好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342202
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342202,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342203
					]
				},
				{
					"id": 413342203,
					"content": "#好，好，這樣菜就齊了。謝謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342204
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342204,
					"content": "二位，久等了啊，哈哈哈，請慢用，請慢用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342205
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413342205,
					"content": "謝謝老闆。這位旅行者…幫忙跑前跑後的，很辛苦，就請坐下一起吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342206
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342206,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342207
					]
				},
				{
					"id": 413342207,
					"content": "#呵呵，看{F#妳}{M#你}的樣子，應該和我們一樣也是遠遊之人，大過節的，大家一起吃一頓飯，好歹也有些熱鬧的氣氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342208
					],
					"speakerTitle": "鑒秋"
				},
				{
					"id": 413342208,
					"content": "嗯，請老闆也一起吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342209
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342209,
					"content": "哎喲，那好，那我也就不客氣了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱老闆"
				}
			]
		},
