			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱老闆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "得想個辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340102,
					"content": "想什麼辦法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "啊…是旅行者啊，不是在過海燈節了嗎？我想要藉著這次海燈節，讓我這裡的生意熱鬧一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340104,
					"content": "#{F#妳}{M#你}看，我這裡的位置不錯，環境也挺好，菜色嘛…也不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340105,
					"content": "等城裡放飛「明霄燈」的時候，坐在我這裡，好景好酒好菜，感覺肯定很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340106,
					"content": "#我準備就以這個為賣點招攬客人，{F#妳}{M#你}覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340107,
					"content": "這裡看得到「明霄燈」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "呃…應該看得到吧，「明霄燈」那麼大，怎樣都能看到一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340110,
					"content": "這…沒關係，到時候再說吧，我得先打理一下店裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340111,
					"content": "#旅行者，能請{F#妳}{M#你}幫忙搜集一些做霄燈的材料來嗎？我想要掛點霄燈在店裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340112,
					"content": "不如我直接編給你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "沒關係，只要材料就可以了，編霄燈也挺麻煩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340115,
					"content": "#{F#妳}{M#你}搜集好了之後，就直接把材料給阿笨吧，他會把霄燈編好的。我也得去準備點其他的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340116,
					"content": "#當然，我肯定也不會讓{F#妳}{M#你}白忙，等到時候招攬到了客人，做好了生意，自然有報酬奉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340117,
					"content": "那要是沒客人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "呃…就算是…沒客人，我也會給您準備好報酬的，請您儘管放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340119,
					"content": "總之，等把店整理好了，客人們也差不多就該來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340120,
					"content": "#咳…那{F#妳}{M#你}把材料交給阿笨就行了，等明天我看情況給{F#妳}{M#你}結算報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱老闆"
				},
				{
					"id": 413340113,
					"content": "只要材料嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "這裡應該看不到「明霄燈」吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
