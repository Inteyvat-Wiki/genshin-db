			"dialogs": [
				{
					"id": 745250401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250402,
					"content": "你看起來表情有點嚴肅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "#是{F#妳}{M#你}啊。不，今天的調查任務已經結束了，附近暫時沒有發現異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250405,
					"content": "我只是在想，剛才那群路過的鍍金旅團，為什麼看起來無精打采的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250406,
					"content": "難道是因為旅途太累了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "我猜測可能是經濟原因。畢竟，一支「鍍金」旅團如果沒有了「金」，那不就「沒勁」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250409,
					"content": "…那來點「有勁」的事情如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "我明白了。不過，如果只是站著不動，畫面可能會有些單調，缺乏衝擊力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250412,
					"content": "#放心，我會調動雷元素力，讓{F#妳}{M#你}的畫面真正做到令人「眼前一亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250413,
					"content": "…想法不錯，我會抓準時機的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "#嗯。交給{F#妳}{M#你}了，別錯過「決定性瞬間」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 745250410,
					"content": "讓我為你拍張畫片吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "難道是因為任務失敗了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "難道是在追捕犯人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
