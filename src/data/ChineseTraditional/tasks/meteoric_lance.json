			"dialogs": [
				{
					"id": 740741901,
					"content": "仔細檢查了機關頂部的空間，什麼都沒有發現。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "結果最後這裡什麼都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740741903,
					"content": "並不是，看起來是已經被人拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740741904,
					"content": "那豈不是我們的計畫已經失敗了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740741905,
					"content": "「理性」的誕生需要四個象限合一。只要我們能拿到剩下的幾個，我們就還有機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740741906,
					"content": "既然如此，我們就快點去接下來的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
