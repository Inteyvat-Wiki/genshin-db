			"dialogs": [
				{
					"id": 740742001,
					"content": "仔細檢查了機關頂部的空間，什麼都沒有發現。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740742002
					]
				},
				{
					"id": 740742002,
					"content": "這裡依舊什麼都沒有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740742003,
					"content": "所以卡特皮拉你能告訴我們，我們究竟要找什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742004
					],
					"speakerTitle": "安"
				},
				{
					"id": 740742004,
					"content": "我們是在尋找鍛鑄水仙十字聖劍的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742005
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742005,
					"content": "水仙十字結社依據地下之國與古楓丹的神秘哲學，在物質世界重現了必要的四種架空物質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742006
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742006,
					"content": "無法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742007
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740742007,
					"content": "神秘的東西本身只作用於體驗，可以說比元素力還要跳脫常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742008
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742008,
					"content": "幾十年前我輸入過教令院的素論派入門及中級教科書，元素力也沒有那麼神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742009
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740742009,
					"content": "是嗎？那反正從結論上來說，這是楓丹古法與地下古國技術的交匯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742010
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742010,
					"content": "世界上出現了「記憶」、「願望」、「靈魂」與「人格」這四種物質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742011
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742011,
					"content": "為了防止歧義，我們把它們叫做「記憶」之塊、「願望」之塊、「靈魂」之塊與「人格」之塊好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742012
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742012,
					"content": "為什麼這些東西會用來打造聖劍啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740742013,
					"content": "水仙十字結社的神秘哲學裡，神殿是宇宙的縮影，社員是眾神的代行，聖油是錘鍊的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742014
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742014,
					"content": "聖劍，則是破開一切的「理性」。它需由完整的人之意志誕生而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742015
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742015,
					"content": "好玄學。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742016
					]
				},
				{
					"id": 740742016,
					"content": "哎呀！神秘哲學就是這樣，看起來相似就可以攀附。當這種東西變成魔法就以假成真的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742017
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740742017,
					"content": "總之，我們趕快去下一個地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
