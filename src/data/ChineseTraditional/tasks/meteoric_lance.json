			"dialogs": [
				{
					"id": 740740101,
					"content": "…不是，比起這個，你不是更應該在意視野內還躺著一個人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "安"
				},
				{
					"id": 740740102,
					"content": "欸？哇！怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740103,
					"content": "抱歉小姐，剛才把尋找石碑提到最優先了。現在請讓我來掃描…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740740104,
					"content": "…很抱歉，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740740105,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740106,
					"content": "他雖然還活著，但是生命的氣息已經從他的孔竅中溜走了。我認識這個手段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740107,
					"content": "嗚嗚…我不敢看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740108,
					"content": "趕快去找人幫忙吧！不能就這樣放著不管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740109,
					"content": "一同將失去意識的人送到了柔燈港。\\n柔燈港的人立刻出發，將他送去救治。\\n放下心來後，與眾人一起回到了原來的位置。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "好啦！我們看看石碑吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740111,
					"content": "「此處乃願望之象限，願望之神殿，願望之間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740740112,
					"content": "「常與相違」…「生於一瞬，伴你長眠，從不分離」…「有染罪果」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740740113,
					"content": "又是謎語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740114,
					"content": "為什麼要在這裡做這麼可怕的事情…和謎底難道有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740740115,
					"content": "因為楓丹人是「罪人」，是「有染原罪」的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740116,
					"content": "因此答案是「生命」。我已經猜出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740117,
					"content": "你能確定是這個答案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "安"
				},
				{
					"id": 740740118,
					"content": "我太熟悉水仙十字結社的那套語言符號系統了。不出意外就是這個答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740740119,
					"content": "好了，讓我們開始爭分奪秒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
