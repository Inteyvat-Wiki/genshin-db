	],
	"talks": [
		{
			"id": 7368901,
			"completionStepIds": [
				7368901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368901",
							"2"
						],
						"stepId": 7368901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿納托爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736890101,
					"content": "唉，完全不具備復現實驗的條件。派翠克啊，不是我不想幫你，這次你就自求多福吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890102
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890102,
					"content": "我是沒什麼辦法了，還不如想想能去哪裡吃點好的。對，醃篤鮮，去吃醃篤鮮吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890103
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890103,
					"content": "哇，那能吃醃篤鮮的地方離這裡可遠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890104,
					"content": "說得也是啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890105
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890105,
					"content": "#嗚哇，{F#妳}{M#你}們是誰，怎麼會出現在這種人跡罕至的地方…有點可疑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890106
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890106,
					"content": "啊，真的那麼可疑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890107,
						736890108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890107,
					"content": "對啊，派蒙，妳怎麼出現在這！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				},
				{
					"id": 736890109,
					"content": "#唔，明明我和{F#妳}{M#你}一起的啦，怎麼連{F#妳}{M#你}也這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890110,
					"content": "好生氣，讓我想想怎麼反駁…哦對了，我們出現在這裡很可疑，你這個楓丹的傢伙出現在這裡不是也很可疑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890111,
					"content": "…真的嗎？在其他人眼裡我真的很可疑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890112
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890112,
					"content": "畢竟是楓丹人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890113
					]
				},
				{
					"id": 736890113,
					"content": "#是啊是啊，我和{NICKNAME}四處冒險，出現在這裡…也算正常，你這個楓丹人出現在這裡，比我們奇怪多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890114,
					"content": "#這倒也是啦…嗯，四處冒險的{NICKNAME}。{F#妳}{M#你}的名字是{NICKNAME}，那妳呢？會飛的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890115
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890115,
					"content": "我的名字是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890116,
					"content": "嗯，那我也做個自我介紹好了，我是楓丹科學院的工程師，我的名字叫阿納托爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890117
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890117,
					"content": "實不相瞞，我之所以會從楓丹遠道而來，其實也是楓丹科學院大人們的意思，就是為了研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890118
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890118,
					"content": "研究璃月美食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890119,
					"content": "璃月美食，嘿嘿…啊不對，科學院其實是負責研究機械與能源的機構，不過，說得好啊，真希望有研究美食的部門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890120
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890120,
					"content": "說遠了，其實事情是這樣的，有一位與我同期進入楓丹科學院的同僚，一直在研究礦石和元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890121
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890121,
					"content": "#對了，{F#妳}{M#你}們如果經常在附近活動的話說不定也見過他，他的名字叫派翠克，{F#妳}{M#你}們有印象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890122,
						736890125
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890122,
					"content": "沒有什麼印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890123
					]
				},
				{
					"id": 736890123,
					"content": "真的不太記得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890124,
					"content": "唉，派翠克…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890128,
					"content": "按照他的研究想法，需要很大批量且特定種類的璃月礦石，但是嘛，因為預算、實驗場地的經費和一些眾所周知的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890129
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890129,
					"content": "沒有辦法進行實驗嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890130,
					"content": "對…結果有一天，他突然帶著剩餘的實驗經費和實驗器材消失了，大家都說一定是他終於受不了楓丹科學院捲款跑走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890131
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890131,
					"content": "我先聲明啊，我一直相信他能夠完成自己的研究，可沒有在背後腹誹他。跟那些總是閒言碎語的傢伙不一樣，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890132
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890132,
					"content": "總之，就在前陣子，他不僅活著回了楓丹科學院，還帶來了課題實驗結果，哎，真是令人感動的研究精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890133
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890133,
					"content": "據他自己說，他直接到了璃月，就地佈置實驗…克服了許多難以想像的困難，最終完成了自己的課題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890134
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890134,
					"content": "哇，那不是很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890135,
						736890137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890135,
					"content": "是啊，聽起來結果不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890136
					]
				},
				{
					"id": 736890136,
					"content": "事情到這裡可以說是一個足以鼓舞後輩的勵志故事，不過…唉，很多事就是怕這個不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890139,
					"content": "畢竟他跑到這裡進行實驗本身其實就是違規行為…其實也能理解，如果按正常流程，各種繁雜的申請表和說明就要填半個月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890140
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890140,
					"content": "當然了，實驗過程無人複核，他拿出的資料又過於詳實…按照審核文件的說法：「詳實得和編出來的一樣呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890141
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890141,
					"content": "雖然派翠克一再申明，這些資料之所以如此詳實，是由於當地冒險家協會對實驗的鼎力協助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890142
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890142,
					"content": "不過上面的人才不會相信這些說辭，所以按照流程，就得有人再次進行重複實驗，以驗證他求得的數據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890143
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890143,
					"content": "唔…那也就是說，為了重複實驗，就必須找一個倒楣鬼從楓丹跑到這裡，再做一遍派翠克做的事情囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890144,
					"content": "這個倒楣鬼是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890145,
					"content": "是啊，這個倒楣鬼是誰呢，哈哈，這個倒楣鬼就是我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890146
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890146,
					"content": "派翠克是個好人，所以我也想幫他驗證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890147
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890147,
					"content": "不過真的到了這裡才發現，雖然符合要求的礦石好找，但是要一個人完成實驗，根本不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890148
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890148,
					"content": "怎麼這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890149,
					"content": "派翠克一個人完成實驗，所以我也得一個人完成實驗，大概是這樣的想法吧…啊呀，這該死的機構，活該被炸上天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890150
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890150,
					"content": "炸…炸上天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890151
					]
				},
				{
					"id": 736890151,
					"content": "咳咳，楓丹科學院以前因為一場相當慘烈的實驗失控，曾經狠狠爆炸過一次，但那又怎麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890152
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890152,
					"content": "冗長奇怪的流程和過度複雜的管理系統，沒在爆炸裡消失，到現在反而更加「精益求精」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890153
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890153,
					"content": "唉…資料驗證的實驗是別想了。申報的經費如果不花掉，也不過是白白縮減明年的預算，不如就去璃月好好地吃上一頓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890154
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890154,
					"content": "怪不得你之前在說什麼醃篤鮮什麼的，原來是這樣…唔，可是這樣的話，派翠克怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890155,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890156
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890156,
					"content": "#如果沒碰到{F#妳}{M#你}們，我大概就放棄了，但是，四處冒險的{NICKNAME}…還有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890157
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890157,
					"content": "#能不能幫我，幫我完成這場驗證實驗，看得出來，{F#妳}{M#你}們絕對有這樣的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890158
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890158,
					"content": "報酬的話，去掉來往的開銷，經費大概還剩下三成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890159
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890159,
					"content": "#倒不是因為經費啦，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890160,
						736890162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890160,
					"content": "好吧好吧，都是為了派翠克！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890161
					]
				},
				{
					"id": 736890161,
					"content": "#我就知道{F#妳}{M#你}會答應的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890164,
					"content": "那還真是感謝兩位了。呼…那我接下來說明實驗的內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890165
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890165,
					"content": "按照派翠克留下來的紀錄可以得知，有一種名為「振晶」的礦石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890166
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890166,
					"content": "「振晶」中的「響振晶」受到特定的刺激後，可以放出能量，激發「應振晶」的共鳴，兩者之間存在著「映射關係」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890167
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890167,
					"content": "好像是這種「映射關係」能夠產生…什麼力量、什麼共鳴，會對某種…特定的對象產生影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890168
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890168,
					"content": "唔，阿納托爾，你真的看過他的筆記嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890169,
					"content": "總之都是差不多的東西，咳咳，憑空捏造的術語只是裝飾…對於實驗來說，唯有數據才是真實的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890170
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890170,
					"content": "#結論就是，{F#妳}{M#你}們需要在「振晶映射」的影響下，在實驗場所中進行戰鬥，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890171
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890171,
					"content": "#早這麼說嘛！放心吧，要論戰鬥，{NICKNAME}可是很強的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890172,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890173
					]
				},
				{
					"id": 736890173,
					"content": "好！稍後就開始實驗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890174
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890174,
					"content": "只是，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890175
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890175,
					"content": "怎麼了，為什麼又突然唉聲嘆氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890176,
					"content": "醃篤鮮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890177
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890177,
					"content": "別惦記你的醃篤鮮了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890162,
					"content": "那把給派蒙那份給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890163
					]
				},
				{
					"id": 736890163,
					"content": "啊，真是的，小氣，我明明不是這個意思啦！咳咳…忙我們會幫的，但是經費也得拿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890137,
					"content": "但這和你有什麼關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890138
					]
				},
				{
					"id": 736890138,
					"content": "唉，有點複雜，這事情後面的發展就讓人備感遺憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890125,
					"content": "好像有點印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890126
					]
				},
				{
					"id": 736890126,
					"content": "雖然記得不是很清楚，不過好像確實在這裡見過一個擺弄礦石的楓丹人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736890127,
					"content": "那大概就是他啦，倒楣的派翠克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "阿納托爾"
				},
				{
					"id": 736890108,
					"content": "派蒙，妳好可疑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				}
			]
		}
	]
}