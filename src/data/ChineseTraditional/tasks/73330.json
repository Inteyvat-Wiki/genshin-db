			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"馬爾科佐夫",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "喂，心懷不軌的人類，勸你們盡快離開此地。吾輩花靈的傳承與隱藏可不是爾等可以輕易觸達的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300702,
					"content": "花靈？花靈！多麼新奇的體驗啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300703,
					"content": "#喔！還有{M#精幹的少年}{F#小小的女士}和{M#他的}{F#她的}…寵物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300704,
					"content": "#哇！你這傢伙也太失禮了！我可是{M#他}{F#她}最好的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300705,
					"content": "夥伴…當然、當然！最好的夥伴，多麼動聽的詞彙！我從孩提時代起就盼望著能有這樣一個「最好的夥伴」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300706,
					"content": "#{M#精幹的少年}{F#小小的女士}，您應該不需要兩個「最好的夥伴」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300707,
					"content": "什麼意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "我的意思是…太奢侈了！即便是對您來說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300711,
					"content": "我無法原諒這樣的不公…所以懇請您，將花靈交給我。關於花靈的待遇，您大可放心，我一定會物盡其用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "馬爾科佐夫"
				},
				{
					"id": 733300712,
					"content": "無禮的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300713,
					"content": "這也太不講道理了，根本沒辦法溝通嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300714,
					"content": "#這世上有比語言更通行的道理…吾之「謁頌主」，聰慧如{F#妳}{M#你}，應該明白我的意思吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300715,
					"content": "我猜斯露莎是說，給他點顏色瞧瞧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733300716,
					"content": "哼，不用白飄飄多話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733300708,
					"content": "倒是不介意有更多夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "那怎麼行！不行不行，「最好的」夥伴只可以是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}