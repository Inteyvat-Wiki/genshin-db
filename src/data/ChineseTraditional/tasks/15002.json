			},
			"dialogs": [
				{
					"id": 150020201,
					"content": "#{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020202
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020202,
					"content": "基尼奇！居然在這裡見到你！我們先前還想找找你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020203,
					"content": "你好，又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020204
					]
				},
				{
					"id": 150020204,
					"content": "#我就開門見山了。我聽說{F#妳}{M#你}們接受了特立尼達長老的邀請？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020205
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020205,
					"content": "啊！那個…你是說回火夜嗎？呃…長老說本來是要請你去的…但是…唉呀…該怎麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020206,
					"content": "#別緊張，我是有重要的事告訴{F#妳}{M#你}們——特立尼達長老可能隱瞞了他真正的目的，他想一次解決山王的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020207
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020207,
					"content": "一次解決？以後不辦回火夜了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020208,
					"content": "#對，他希望藉{F#妳}{M#你}們之手，讓山王回歸夜神的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020209
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020209,
					"content": "回歸夜神的國度…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020210,
					"content": "就是送山王去死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020211
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020211,
					"content": "等一下！等一下！你能不能別這麼直接…我有點不敢相信…這是真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020212,
					"content": "妳想要我委婉一點？嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020213
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020213,
					"content": "#可能也許說不定是這樣…特立尼達長老希望{F#妳}{M#你}們殺了山王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020214
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020214,
					"content": "怎麼會這樣…山王不是你們活著的榮耀嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020215,
					"content": "榮耀背後也有代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020216
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020216,
					"content": "沒錯，山王是我們活著的榮耀，但這榮耀也伴隨代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020217
					],
					"speakerTitle": "特立尼達",
					"speakerSubtitle": "懸木人長老"
				},
				{
					"id": 150020217,
					"content": "唉…南娜已經不是第一個了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020218
					],
					"speakerTitle": "特立尼達",
					"speakerSubtitle": "懸木人長老"
				},
				{
					"id": 150020218,
					"content": "是因為他的龍夥伴南娜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020219
					]
				},
				{
					"id": 150020219,
					"content": "嗯，南娜大概也不是最後一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020220
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020220,
					"content": "但…就直接要殺死山王嗎？這好像也太極端了一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020221,
					"content": "那他要怎麼殺死山王？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020222
					]
				},
				{
					"id": 150020222,
					"content": "山王身上的深淵汙染與普通災害不同，數百年來被邪惡力量侵蝕，牠的身體已經不可逆地深淵化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020223
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020223,
					"content": "可以說既是深淵力量使牠瘋狂，也是深淵力量維持了牠的生命。換言之，如果進行徹底的驅散，山王將安息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020224
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020224,
					"content": "往年的儀式只會驅散近半的深淵力量，這是一個使牠既不會死亡又不會醒來的平衡線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020225
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020225,
					"content": "長老好像沒和我們說過具體要驅散多少…但他說今天要聊一聊細節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020226,
					"content": "#那{F#妳}{M#你}們很快就能確認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020227
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020227,
					"content": "…如果長老真的想要殺死山王，我們要怎麼辦啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020228,
						150020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020228,
					"content": "我們好像蹚了灘渾水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				},
				{
					"id": 150020230,
					"content": "#這個消息可能有些衝擊，{F#妳}{M#你}們可以先當作不知道。稍後{F#妳}{M#你}們和特立尼達長老聊完後，方便來首領這邊一趟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020231
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020231,
					"content": "#我想和{F#妳}{M#你}們談個交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020232
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020232,
					"content": "交易？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020233,
					"content": "#我準備了還不錯的價格，{F#妳}{M#你}們應該也還有不少問題，等會是個好時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020234
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020234,
					"content": "我們等一下就過去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020235
					]
				},
				{
					"id": 150020235,
					"content": "那稍後見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020229,
					"content": "現在退出還來得及嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				}
			]
		},
