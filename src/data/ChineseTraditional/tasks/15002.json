			"dialogs": [
				{
					"id": 150020301,
					"content": "#{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020302
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020302,
					"content": "基尼奇！特立尼達長老他說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020303,
					"content": "#嗯，{F#妳}{M#你}們臉上已經寫了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020304
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020304,
					"content": "#{NICKNAME}和派蒙？沒有迎接兩位的到訪，是我作為一族首領的失職。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020305
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020305,
					"content": "瓦伊納首領，你好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020306,
					"content": "我昨天才從特立尼達那裡得知消息，所以託基尼奇請兩位過來一敘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020307
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020307,
					"content": "不用這麼客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020308
					]
				},
				{
					"id": 150020308,
					"content": "#呵呵，基尼奇應該已經告訴了{F#妳}{M#你}們情況，那閒話我也不多說了。我很贊同兩位來主持回火夜的儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020309
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020309,
					"content": "但我有一個請求：希望兩位能確保山王的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020310
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020310,
					"content": "懸木人的孩子都是聽著部族的英雄傳說長大的，從竊火的尤潘基，到征戰深淵的布基納和山王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020311
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020311,
					"content": "那是給予我們驕傲與信念的寶貴歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020312
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020312,
					"content": "現在要殺死山王，無異於要殺死我們自己的精神。如果發生這樣的事，我將無顏面對夜神之國的祖先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020313
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020313,
					"content": "我為南娜的事悲傷，所以我不會苛責特立尼達。但為了部族，絕不能讓山王有生命危險，這是懸木人的立身之根。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020314
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020314,
					"content": "希望兩位貴客能慎重考慮這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020315
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020315,
					"content": "就沒有兩全其美的辦法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020316
					]
				},
				{
					"id": 150020316,
					"content": "或許有，但還沒顯現出來。我們已經做過許多嘗試，現在，我希望能聽見兩位的態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020317,
						150020319,
						150020321,
						150020323
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020317,
					"content": "或許我會尊重首領的意見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020318
					]
				},
				{
					"id": 150020318,
					"content": "雖然知道您可能還沒有完全想好，但聽見您這樣說，我還是放心了許多。離儀式還有三天，到時候希望您能確定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020326,
					"content": "對了基尼奇，你剛剛不是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020327,
					"content": "#{NICKNAME}、派蒙，我帶{F#妳}{M#你}們去族裡走走吧，順便聊一聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020328
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 150020328,
					"content": "也好…我們可能是需要暫時放鬆腦子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020319,
					"content": "或許我會尊重特立尼達長老的意見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020320
					]
				},
				{
					"id": 150020320,
					"content": "您的想法令人擔憂，但我知道您一定還在考慮中，沒關係。離儀式還有三天，到時候希望您能確定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020321,
					"content": "我還需要考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020322
					]
				},
				{
					"id": 150020322,
					"content": "我明白，離儀式還有三天，到時候希望您能確定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				},
				{
					"id": 150020323,
					"content": "派蒙，我們今晚就溜去其他部族吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020324
					]
				},
				{
					"id": 150020324,
					"content": "#但是事情放在這裡，它也不會自己解決的…我知道{F#妳}{M#你}一定還沒想好要怎麼辦，沒關係，我們可以一起來想辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020325,
					"content": "感謝您，離儀式還有三天，到時候希望您能確定自己的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "瓦伊納",
					"speakerSubtitle": "懸木人首領"
				}
			]
		},
