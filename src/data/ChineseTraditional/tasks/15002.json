							8416.729
						],
						"pointId": 9148
					}
				]
			},
			"dialogs": [
				{
					"id": 150020101,
					"content": "#異邦的強者，{F#妳}{M#你}們來了，休息得還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020102
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020102,
					"content": "還…還不錯哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020103,
					"content": "那就好。我這邊的進展也很順利，不少長老都聽說過您的事蹟，包括首領在內都對您表示了認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020104
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020104,
					"content": "雖然也還有人堅持儀式應由「馬{RUBY#[D]回火}力卜」的繼承者來主持，但這種想法實在陳舊，我們得與時俱進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020105
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020105,
					"content": "基尼奇好像自己也不想來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020106,
					"content": "沒錯，所以現在我們可以說一下儀式的細節了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020107
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020107,
					"content": "昨天我已經告知過您傳火儀式的部分，在這之後就是淨化山王的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020108
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020108,
					"content": "要怎麼淨化？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020109
					]
				},
				{
					"id": 150020109,
					"content": "很簡單，用聖火就好。這麼多年的儀式，我們對這項工作都已經非常熟悉，對您一定也沒什麼難度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020110
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020110,
					"content": "而我要說的關鍵在於希望您可以用聖火盡可能驅散深淵能量，這樣可以最大程度維持山王沉睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020111
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020111,
					"content": "就只是維持沉睡嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020112,
					"content": "沒錯。往年的儀式裡，遊火人往往無法驅散足夠的深淵能量，所以我們才需要定期重複這一場儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020113
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020113,
					"content": "但我知道您在對抗深淵方面很有經驗，昨天您對聖火的使用也十分老道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020114
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020114,
					"content": "我想如果是您的話，或許能夠將山王體內的深淵能量全部驅散，這樣就能保護我們在很長時間內免遭威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020115
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020115,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020116,
					"content": "知道了，還有別的要注意的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020117
					]
				},
				{
					"id": 150020117,
					"content": "您聽到這個要求居然一點也不擔憂，看來是對自己很有信心了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020118
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020118,
					"content": "其他就沒有特別需要注意的了，儀式定在三天之後，屆時我會再來通知您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020119
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020119,
					"content": "這段時間如果您有空，可以在部族裡逛一逛，長老們也希望您能多在族人面前露露臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020120
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020120,
					"content": "要是您還願意順手解決一些族人們的麻煩，那就再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020121
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020121,
					"content": "還要幫別人解決麻煩啊？這算不算額外的價格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150020122,
					"content": "哈哈，這只是小小的建議。我真心認為您這樣的英雄，值得在部族裡獲得更多聲望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020123
					],
					"speakerTitle": "特立尼達"
				},
				{
					"id": 150020123,
					"content": "這幾天我都會待在族內，如果有什麼問題可以隨時找我解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特立尼達"
				}
			]
		},
