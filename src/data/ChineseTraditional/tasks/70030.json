	"talks": [
		{
			"id": 7003001,
			"completionStepIds": [
				7003002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003002",
							"2"
						],
						"stepId": 7003002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"重佐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "喲！旅行者，好久不見，別來無恙啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300102,
					"content": "我們見過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "#啊…{F#妳}{M#你}…居然就這樣把我忘了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300104,
					"content": "#我是「死兆星」號的大副重佐啊，{F#妳}{M#你}之前還搭我們「死兆星」號去稻妻的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300105,
					"content": "#沒有沒有，重佐大副，我們當然記得你啦，{NICKNAME}又在開玩笑了，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300106,
					"content": "欸——我說呢！這才對嘛，畢竟我堂堂「死兆星」號的大副…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300107,
					"content": "咳咳，有什麼要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "啊，其實不是我，是那位暫留在我們船隊的萬葉小兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300109,
					"content": "#{F#妳}{M#你}應該有印象的吧？從稻妻返航的時候，他也跟著回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300110,
					"content": "不知道怎麼了，這一路上感覺他心情很不錯，有事沒事就拉著大家吟詩作歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300111,
					"content": "可惜我們船上，上到北斗大姐頭、下到小月小丫頭，哪找得出半個有這種…有這種…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300112,
					"content": "雅興！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "對！雅興！哪找得出半個有這種雅興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300116,
					"content": "所以啊，剛到璃月，他就下船遊山玩水去了，看來真是被我們這幫大老粗憋壞囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300117,
					"content": "#可是他才走沒多久，就傳來訊息，拜託我們留意一下{F#妳}{M#你}的行蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300118,
					"content": "他遇到麻煩了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "#詳細情況倒是沒提，只說要是見到了{F#妳}{M#你}，就請{F#妳}{M#你}前去一敘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300120,
					"content": "#聽口氣沒那麼要緊，但如果是小事，我想也用不著旅行者{F#妳}{M#你}出馬吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300121,
					"content": "#其實我們也經常處理小事的，是吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300122,
					"content": "嗯，經常餵鴿子什麼的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "#噢——真沒想到，{F#妳}{M#你}還會幫大家做這些不起眼的工作啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300126,
					"content": "#怪不得大姐頭那麼欣賞{F#妳}{M#你}，看來{F#妳}{M#你}身上有著她所謂的「煙火氣」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300127,
					"content": "#哎呀！閒話扯太多了，還是請{F#妳}{M#你}快去萬葉小兄弟那裡看看吧，他最近應該在璃月港北邊那一帶活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300128,
					"content": "#我還要去忙船隊的事，就不送{F#妳}{M#你}們了，路上多小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300123,
					"content": "嗯，經常替餐館送餐什麼的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "嗯，經常打掃環境什麼的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "怪癖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "不不，應該叫雅興！哪找得出半個有這種雅興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "琴音嘒嘒，琴枕槁槁，獨弦繫世，獨木終老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300202,
					"content": "喲！萬葉小兄弟！你在這裡呀？我們來幫忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300203,
					"content": "#哦？{F#妳}{M#你}們來了，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300204,
					"content": "「萬葉小兄弟」這個稱呼，從派蒙嘴裡說出來，倒確實別有一番風味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300205,
					"content": "嘿嘿嘿，我和重佐大副學的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300206,
					"content": "你挺悠閒嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "#哈哈，難道在{F#妳}{M#你}眼中，我是那種肩挑惡命、步履深沉之人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300209,
					"content": "是重佐大副說你有事找我們啦，誰知道你這麼悠哉，還在這看風景，還吟詩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300210,
					"content": "稻妻事了，我已經心無他念。再訪璃月，自然該廣習此間詩賦，遍聞懸月妙音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300211,
					"content": "#至於請{F#妳}{M#你}們幫忙一事，原先是沒有的，但可惜{F#妳}{M#你}們來遲了一步，所以現在有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300212,
					"content": "欸？好暈，「原先是沒有的…所以現在又有了…」，什麼嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300213,
					"content": "你這傢伙，是不是在山裡吃了壞東西，怎麼連話都說不明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300214,
					"content": "噓——二位請聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300215,
					"content": "二位有什麼感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300216,
					"content": "嗚哇，這琴聲…要我說的話，好像跟賣唱的彈的差不多嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300217,
					"content": "#哦，賣唱的？希望有日能結識一番。旅行者，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300218,
					"content": "這琴壞了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "不錯，確實如此，不過更關鍵的是，它有一種奇妙的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300221,
					"content": "這把無名古琴，是我遊覽群山間，偶然在一座遺落洞府裡得來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300222,
					"content": "那時這琴雖老舊，但仍完好。我見獵心喜，不自覺便撥弄了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300223,
					"content": "沒想到，琴聲初起，我便一陣恍神，彷佛有人正與我合奏，那感覺，似曾相識...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300224,
					"content": "讓我想想，你真的沒有吃到什麼讓人產生幻覺的東西嗎?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300225,
					"content": "大概是沒有，因為一曲落下，我便醒過神來，這才仔細端看起那洞府，果然大有玄機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300226,
					"content": "那府內雜草橫生，主人想必已經離去許久。可那一桌一椅皆纖毫不染，更有陣陣幽香撲鼻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300227,
					"content": "就連風中一直吵鬧的雜音也在那偃息了。此等神異，我猜測，那就是璃月傳說中的仙家寶地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300228,
					"content": "哇喔喔喔！所以這把琴是仙人留下來的寶物嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300229,
					"content": "哈哈，誰知道呢？那之後我又想，此等妙事，當然要跟朋友分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300230,
					"content": "#可我在璃月，除了大姐頭外，就只有{F#妳}{M#你}一位朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300231,
					"content": "#大姐頭對這種事情恐怕是毫無興趣，我便想著，不如請{F#妳}{M#你}來體會一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300232,
					"content": "#於是便拜託了重佐大副，讓他留意{F#妳}{M#你}的行蹤。只可惜在{F#妳}{M#你}們來之前，這琴損壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300233,
					"content": "嗯，是我的過失，我拿著它遊歷各處，使用太頻繁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300234,
					"content": "啊，仙人的寶物也會壞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300235,
					"content": "連那位雷神大人都沒辦法握住永恆…就更別說其他事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300236,
					"content": "#嗚嗚，{NICKNAME}，{F#妳}{M#你}、{F#妳}{M#你}一定要保護好我們的塵歌壺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300237,
					"content": "不過好在，這種損壞是可以修復的，因為它更像是休眠，是琴中的能量隨著時間流逝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300238,
					"content": "所以只要找到正確的材料，就能喚醒它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300239,
					"content": "如果我沒有聽錯的話，這種材料大概是...琉璃百合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300240,
					"content": "你怎麼知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "我有說過吧，風會帶著萬物的呢喃在世間穿行，而我恰好能夠聽見其中幾縷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300242,
					"content": "所以我知道了一些，關於這古琴往昔的隻言片語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300243,
					"content": "#去吧，我在這裡等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300244,
					"content": "#{F#妳}{M#你}是璃月港的大英雄，這點小事應該不成問題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300219,
					"content": "這琴挺貴的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "你挺不務正業嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
		{
			"id": 7003003,
