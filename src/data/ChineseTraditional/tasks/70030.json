			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "#風兒都還沒有帶回{F#妳}{M#你}的消息，{F#妳}{M#你}就已經出現了。真是讓我大開眼界，{F#妳}{M#你}是怎麼做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300302,
					"content": "#嘿嘿，{NICKNAME}比你想像的還要厲害哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300303,
					"content": "咳咳，這些夠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "給我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003007",
							"2"
						],
						"stepId": 7003007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "嗯，品質很好，這些就足夠了，將它們搗成汁液，浸入琴身，應該就能讓古琴回春了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300402,
					"content": "嗯——這熟悉的感覺。它醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300403,
					"content": "#來，{NICKNAME}，試試吧，它就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300404,
					"content": "交給我是什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "#哈哈，難道詩人不可以直抒胸臆嗎？「交給{F#妳}{M#你}」的意思就是：這把琴，送{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300406,
					"content": "再訪璃月，我是來傾聽這一方世界的。能在這片岩神守護的古老大地中，聽見那些生生不息的低語，我很滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300407,
					"content": "#當然，要是哪天這琴{F#妳}{M#你}不要了，我會來拿的。但...希望永遠不要有那一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300408,
					"content": "好了，我要繼續上路了，這種時候璃月人會怎麼說？啊，對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 700300409,
					"content": "#{NICKNAME}，「後會有期」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		}
	]
}