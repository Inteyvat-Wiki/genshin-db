			"dialogs": [
				{
					"id": 750360801,
					"content": "出來吧出來吧，小小的種子~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360802,
					"content": "出來吧出來吧，開漂亮的小花~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360803,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360804,
					"content": "唔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#啊，{NICKNAME}，燃素的能量沒有了，那種子一定是好好吸收了，只是…怎麼一點反應都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360806,
					"content": "唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "說不定種子只是需要時間成長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "是嗎？！不過想想也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360809,
					"content": "只要「呼——」地一吹蒲公英就會飛出好多白色的小傘，鉤鉤果會掛在小狼的身上，一直跑到很遠的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360810,
					"content": "種子的生命力都是很頑強的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360815,
					"content": "那我們就先不要打擾它了，過一陣子再來看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360816,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "說不定種子只是被嚇到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "真、真的嗎？也對哦！是不是我太心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360813,
					"content": "#種子又是被{REALNAME[ID(2)|SHOWHOST(true)]}挖出來，又是被飛蟲偷取養分，還被怪物「轟隆隆」地打擾了一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750360814,
					"content": "聽到有人在花田上打架，對埋在土裡的種子來說就像聽到暴風和雷聲一樣嚇人，然後它就悄悄地縮在土裡，一動也不敢動了…嗯！一定是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "派蒙"
				}
			]
		},
