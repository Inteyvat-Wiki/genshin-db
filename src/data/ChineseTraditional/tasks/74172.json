	"talks": [
		{
			"id": 7405389,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7417201",
							"2"
						],
						"stepId": 7417201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷蒙多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740538901,
					"content": "我有什麼能幫您的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538902,
						740538917,
						740538930,
						740538946,
						740538949,
						740538968
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538902,
					"content": "你為什麼認為納克沒死？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538903
					]
				},
				{
					"id": 740538903,
					"content": "如果考慮到科學院的利益，再從我個人角度出發…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538904
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538904,
					"content": "我真心希望，他和那枚「始基動能核心」一起徹底在爆炸中灰飛煙滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538905
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538905,
					"content": "這樣的話，艾德溫·伊斯丁豪斯在院內的最後一絲影響力也會徹底消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538906
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538906,
					"content": "但就像我之前所說，那場爆炸，實際上是小範圍內的始基礦碎片共振。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538907
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538907,
					"content": "而且…爆炸區域內的始基礦碎片也大多是能量枯竭的廢礦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538908
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538908,
					"content": "照理來說，就算是大型始基礦失控，並讓這些廢礦發生共振，也不該發生如此劇烈的爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538909
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538909,
					"content": "唯一的可能性，就是有人專門搜集了其他區域內未枯竭的始基礦，堆放在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538910
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538910,
					"content": "然後，再刻意讓那顆大型始基礦超載，使那些始基礦開始共振並引發爆炸，從而掩蓋某些痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538911
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538911,
					"content": "納克之前一直跟隨艾德溫研究，對始基礦的性質十分瞭解，他做這些事並不會費太多功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538912
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538912,
					"content": "但這些也只是我的初步推測，之後…就要等科學院進行更深入的調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538913
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538913,
					"content": "但他為什麼要偷走這顆核心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538914
					]
				},
				{
					"id": 740538914,
					"content": "這顆「始基動能核心」是楓丹科學院到目前為止最為尖端的技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538915
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538915,
					"content": "無論是將它賣掉，或者是用來開發什麼專案…哼！都是很不錯的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538916
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538916,
					"content": "不過，考慮到他的學術能力…我寧願他把這顆「始基動能核心」賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538917,
					"content": "關於「始基動能核心」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538918
					]
				},
				{
					"id": 740538918,
					"content": "在談這件事之前，我想您應該聽納克，或者克洛妮艾小姐提過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538919
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538919,
					"content": "我和艾德溫·伊斯丁豪斯的研究專案在某些方面有重合之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538920
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538920,
					"content": "這樣的說法並不完全準確…事實上，這個「始基動能核心」正是我與艾德溫共同的研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538921
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538921,
					"content": "在理論上，如果給這顆動能核心持續注入滿額能量，它就可以輕鬆驅動「實驗性場力發生裝置」，讓其以滿額功率運轉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538922
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538922,
					"content": "在製造出這個核心後，我們都意識到了一個問題——我們幾乎找不到能夠持續對其輸入滿額能量的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538923
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538923,
					"content": "我和艾德溫嘗試過混合芒荒湮滅能和始基礦能量為其供能，或是將大量始基礦串聯起來，形成一個超大能量組…但都不管用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538924
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538924,
					"content": "直到我們找到了那顆巨型始基礦…雖然它始終處於惰性態，但我和艾德溫很確定，這顆礦石具有前所未有的純淨度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538925
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538925,
					"content": "只要將這枚礦石稍加處理，它就一定能輸出我們所需的高額能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538926
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538926,
					"content": "然後，我和艾德溫就產生了分歧。我提出了一個偏保守的方案，而他想要…更快速地解決這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538929
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538929,
					"content": "之後的故事，您應該已經知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538930,
					"content": "關於艾德溫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538931
					]
				},
				{
					"id": 740538931,
					"content": "他是科研領域的天才。毫不誇張地說，他的才華僅次於我們的第一任院長——阿蘭·吉約丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538932
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538932,
					"content": "但他同時也是一個…不近人情的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538933
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538933,
					"content": "除了科學研究之外，其他的任何事物對他來說都毫無意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538934
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538934,
					"content": "只要能夠推進研究的進度，艾德溫願意做任何事，或者是付出任何代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538935
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538935,
					"content": "除了研究成果之外，他也不會要求其他更多的報酬，他曾經這麼說：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538936
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538936,
					"content": "「我不需要任何報酬，對我來說，研究本身就是最好的獎勵。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538937
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538937,
					"content": "不過，雖然艾德溫是一個純粹的研究者，但他手下的那些人…哼！真是一個比一個還汲汲營營。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538938
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538938,
					"content": "有的人偷偷販賣研究資產，有的剽竊研究成果，還有的人打著艾德溫的旗號在外面招搖撞騙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538939
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538939,
					"content": "楓丹科學院的名聲，就這樣被他們一步步給糟蹋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538940
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538940,
					"content": "但就像之前說的，只要研究能夠推進，艾德溫就什麼也不會管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538941
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538941,
					"content": "就這樣，這群人就打著艾德溫的旗號，逐漸蠶食著整個科學院的資源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538942
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538942,
					"content": "院內只能不斷地對艾德溫專案團隊的人員和經費進行詳細審查，舒瓦瑟爾先生就曾領導過多次審查行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538943
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538943,
					"content": "但在那群人的嘴裡，這些行為被解讀為了「官僚化的頤指氣使」和「對研究員的不信任」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538944
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538944,
					"content": "越來越多的矛盾在科學院裡湧現…沒有人知道該如何解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538945
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538945,
					"content": "但現在…這些矛盾已經全部不存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538946,
					"content": "關於科學院的現狀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538947
					]
				},
				{
					"id": 740538947,
					"content": "呵呵，您這個問題並不是一個技術問題，而是一個行政問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538948
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538948,
					"content": "比起我，您更應該去問舒瓦瑟爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538949,
					"content": "你為什麼認為是納克偷走了核心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538950
					]
				},
				{
					"id": 740538950,
					"content": "您還記得，我之前翻看了一下克洛妮艾小姐在廢墟中拍攝的畫片嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538951
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538951,
					"content": "裡面有一張納克在抑制器前操作的畫片，雖然非常模糊…但我很確定，那個動作絕對不符合操作規範。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538952
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538952,
					"content": "那也說明不了什麼呀！說不定…說不定是有小偷從旁邊的山頭飛過來，然後把這個核心偷走了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538953
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740538953,
					"content": "呵呵，這絕對不可能。這片廢墟裡的始基礦能量流就是最好的防盜措施，普通人才受不了這玩意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538954
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538954,
					"content": "而且，那臺「實驗性場力發生裝置」的啟動時機太巧了，絕對不可能是剛好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538955
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538955,
					"content": "我有一個不太成熟的揣測。納克…或者說，「竊取核心的人」應該早就卸除了「始基動能核心」，啟動了備用能源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538956
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538956,
					"content": "但「芒荒湮滅能核心」是一種相對低效率的能源，它必須要持續輸出能量，才能達到這個大傢伙的啟動閾值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538957
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538957,
					"content": "所以，這人刻意活化了那顆大型始基礦，引起了一場不大不小，但頗能吸引注意力的爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538958
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538958,
					"content": "這樣，當院裡派人上來的時候，一定會先維修始基礦抑製器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538959
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538959,
					"content": "當他們意識到必須去拿「實驗性場力發生裝置」內的備用能源時，「實驗性場力發生裝置」也充能完畢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538960
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538960,
					"content": "從技術角度，這麼做有極大的可行性。而在楓丹科學院內，能夠做到這件事的，這樣的人只有我、艾德溫，還有納克先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538961
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538961,
					"content": "艾德溫應該沒有機會來做這件事…剩下兩個嫌疑人，只有我和納克先生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538962
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538962,
					"content": "說不定就是你幹的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538963
					]
				},
				{
					"id": 740538963,
					"content": "對呀，你之前說納克說謊，可是你也一直在說謊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538964
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740538964,
					"content": "說不定就是自導自演，想騙我們保護你過來拿什麼東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538965
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740538965,
					"content": "#{F#妳}{M#你}們的指控不完全是沒有道理，我之後也會申請一次院內的可信度審查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538966
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538966,
					"content": "但就我來看，犯下這次罪行的人，更有可能是納克先生。如果此事真是他所為，那在這次的事件中他的獲利最大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538967
					],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538967,
					"content": "就算我和他一起並列為嫌疑犯…那他被定罪的機率一定也遠大於我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				},
				{
					"id": 740538968,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538969
					]
				},
				{
					"id": 740538969,
					"content": "再見。祝您今天有個好心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷蒙多"
				}
			]
		},
		{
