			},
			"dialogs": [
				{
					"id": 750860301,
					"content": "#{F#妳}{M#你}來了！塔盧加一直說{F#妳}{M#你}很厲害，叫我在飛行競賽時不要跟丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860302,
					"content": "這孩子，話裡頭一點都沒有我會贏的意思，讓我做姐姐的面子往哪裡擺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860303,
					"content": "#所以待會的比試我是不會放水的，{F#妳}{M#你}也不要有所保留，讓我們各自全力以赴，分個高下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860304,
					"content": "妳會後悔讓我動真格的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "就是這個氣勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860308,
					"content": "#話不多說，{F#妳}{M#你}準備好了的話，我們這就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860306,
					"content": "我的目標是參加獎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "#{F#妳}{M#你}這樣說難道是想讓我放鬆警惕？哼哼，我才不會上當！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "莉瓦"
				}
