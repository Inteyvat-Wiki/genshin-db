				]
			},
			"dialogs": [
				{
					"id": 742500101,
					"content": "這麼想想，以前你們到至冬時，都沒這樣好好地招待過你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500102,
					"content": "請別這麼說，桑多涅女士。即便那時沒像這樣一起坐下來聊天，但您每次都為我們準備了美味的茶點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500103,
					"content": "唉，抱歉。以前在那邊太忙了，下次你們去的時候會多照顧你們一些的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500104,
					"content": "妳以前也從不給我玩妳發明的機械。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500105,
					"content": "那是其他原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500106,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500107,
					"content": "其實「父親」大人也和我們說過，盡量不要打擾桑多涅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500108,
					"content": "沒事，我不在意。下次多來我這邊喝點下午茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500109,
					"content": "真的嗎？我其實…一直都想讓您幫我看看佩伊…有些改進的方向想向您請教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500110,
					"content": "好啊，這可是我的專業領域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500111,
					"content": "…謝謝桑多涅女士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500112,
					"content": "當「執行官」真的很辛苦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500113,
					"content": "妳要這麼問的話…是有點吧。要考慮的事情很多——儘管工作中更多不爽的地方是來源於同事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500114,
					"content": "也就是說…與他人的相處很重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500115,
					"content": "算是吧。我看林尼在這方面應該沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500116,
					"content": "哈哈，不敢不敢，桑多涅女士抬舉我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500117,
					"content": "你想成為「執行官」嗎？算了，這話題不應該我來問。當我沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500118,
					"content": "嗯…這話題對我來說還有些遠呢。或許以後再想也不遲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500119,
					"content": "當「執行官」是不是就沒時間和我們一起行動了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500120,
					"content": "如果是這樣的話…難道說…我和琳妮特也必須成為「執行官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500121,
					"content": "你們兩個，說了這是以後考慮的問題啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500122,
					"content": "而且，不論到哪裡，我都不會拋下你們的，這我保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500123,
					"content": "哈…有時真羨慕你們這一家子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
