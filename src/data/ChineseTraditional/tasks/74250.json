			"dialogs": [
				{
					"id": 742500201,
					"content": "多謝桑多涅女士的款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500204,
					"content": "嗯，您慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
