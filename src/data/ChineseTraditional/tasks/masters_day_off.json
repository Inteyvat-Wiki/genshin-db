			]
		},
		{
			"id": 49001,
			"completionStepIds": [
				49001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"49001",
							"2"
						],
						"stepId": 49001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900101,
					"content": "芭芭拉小姐，我們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900102,
					"content": "歡迎回來，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900103
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900103,
					"content": "琴好點了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900104
					]
				},
				{
					"id": 4900104,
					"content": "芭芭拉小姐也辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900105
					]
				},
				{
					"id": 4900105,
					"content": "沒關係，照看病患本來就是我的日常工作之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900106
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900106,
					"content": "琴已經恢復意識了哦，只是身體還稍微有點虛弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900107
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900107,
					"content": "真的嗎！那可真是好消息，讓我們去看看她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900108,
					"content": "不過她剛剛已經離開教堂了呢，明明都和她說了還要再休息一段時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900109
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900109,
					"content": "…可是琴還是硬撐起一副沒關係的樣子，執意要出去走走。大概又去<color=#00E1FFFF>溫妮莎大人那裡</color>了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900110
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900110,
					"content": "「溫妮莎大人那裡」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900111,
					"content": "啊，我是說大英雄溫妮莎的象徵，<color=#00E1FFFF>風起地的那棵大樹</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900112,
					"content": "每當琴感覺迷惘的時候，都會去那裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900113
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900113,
					"content": "芭芭拉小姐對琴團長的事真是瞭解，連這樣的事都能猜到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900114,
					"content": "…只是、只是琴離開前自己說的而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900115
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900115,
					"content": "琴的身體還很虛弱吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900116
					]
				},
				{
					"id": 4900116,
					"content": "她自己這樣出城去沒關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900117
					]
				},
				{
					"id": 4900117,
					"content": "我也很擔心她。可是我在這邊還有工作要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900118
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900118,
					"content": "明白啦，就由我們兩個去護衛病患的安全吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900119,
					"content": "#嗯！那樣我也就能放心了，願風神護佑{F#妳}{M#你}們…和琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 49003,
			"completionStepIds": [
				49003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"49003",
							"2"
						],
						"stepId": 49003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900301,
					"content": "琴小姐，妳的身體沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900302,
					"content": "#嗯，我已經沒事了。真沒想到{F#妳}{M#你}們會到這裡來，謝謝{F#妳}{M#你}們的關心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900303
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900303,
					"content": "真的嗎？可是剛才看見琴的背影…感覺還是很疲憊的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900305,
					"content": "可以多依靠一下騎士團的大家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900306
					]
				},
				{
					"id": 4900306,
					"content": "可以多依靠一下我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900307
					]
				},
				{
					"id": 4900304,
					"content": "是不是有點太過勉強自己了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900307,
					"content": "#啊…{F#妳}{M#你}們的這份心意，就足夠讓我恢復精神了，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900308
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900308,
					"content": "可是如果連這點程度都無法獨自應付的話，又怎麼能像溫妮莎大人那樣守護整個蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900309
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900309,
					"content": "琴真的很憧憬溫妮莎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900310,
					"content": "嗯，最初的騎士團長，溫妮莎大人，是位溫柔而又堅強的人，我一直在追尋著她的腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900311
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900311,
					"content": "以「獅牙騎士」的勇武推翻舊貴族，又作為「蒲公英騎士」建立西風騎士團，將恩澤遍及蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900312
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900312,
					"content": "「蒲公英騎士」…那不是說琴的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900313,
					"content": "不論「蒲公英騎士」還是「獅牙騎士」，都是歷代騎士團長沿襲下來的稱謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900314
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900314,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900315,
					"content": "那麼現在的琴既是聽起來很溫柔的「蒲公英騎士」，又是聽起來很威風的「獅牙騎士」囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900316,
					"content": "是的，繼承溫妮莎大人的名號雖然十分榮幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900317
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900317,
					"content": "但對我來說，可能更多是意味著責任吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900318
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900319,
					"content": "「獅牙騎士」也很適合琴呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900320
					]
				},
				{
					"id": 4900320,
					"content": "還是「蒲公英騎士」更適合琴一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900321
					]
				},
				{
					"id": 4900318,
					"content": "畢竟，要有配得上它們的「堅強」才行呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900319
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900321,
					"content": "說得沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900323
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900323,
					"content": "琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900324,
