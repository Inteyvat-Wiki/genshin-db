				{
					"id": 722060401,
					"content": "怎麼？準備讓我開開眼界了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060402,
					"content": "這些是你要的蘑菇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
			"completionStepIds": [
				7220607
			],
