			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220607",
							"2"
						],
						"stepId": 7220607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "哦哦！哈哈…真是奇形怪狀！它們也有自己的「靈」嗎？它們也凝結著人的記憶嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060502,
					"content": "還有這個…軟軟呼呼的，小翅膀一樣，它是會飛嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060503,
					"content": "唉呀…沒完沒了的好奇，船夫都要生氣了…真是不好意思，最終還是該走了，該上船囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				}
			]
		}
	]
}