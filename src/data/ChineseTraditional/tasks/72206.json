			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "喂！我還在這呢！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060102,
					"content": "現在的年輕人都是怎麼回事，一點公德心都沒有嗎！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060103,
					"content": "對、對不起！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "#哼…這還差不多，認錯就好，那點蘑菇就當我送{F#妳}{M#你}的了…不要亂碰我的蘑菇啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060105,
					"content": "這是你的蘑菇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "#關{F#妳}{M#你}什麼事！別再亂採了，乖乖離開就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220602",
							"3"
						],
						"stepId": 7220602,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220603",
							"2"
						],
						"stepId": 7220603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "#哇啊！剛剛那個傢伙…{F#妳}{M#你}看到了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722060202,
					"content": "沒看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "唔…真邪門。我們再摘幾棵蘑菇就快點離開吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722060203,
					"content": "是幻覺吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "#喂！我沒有警告過{F#妳}{M#你}們嗎！{F#妳}{M#你}們是耳朵不好還是沒長眼睛呀？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060302,
					"content": "哇，是幽靈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "哇啊！什麼幽靈？！哪裡有幽靈！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060304,
					"content": "就在這裡哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "#呀啊！去，去！惡靈速去！！以我阿部的氏名，命{F#妳}{M#你}快快離去！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060307,
					"content": "唉呀，邪門，邪門！我活了這麼些年，還沒見過如此兇惡的靈！！為何還不速去！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060308,
					"content": "我是從島外來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "#霧海外的惡靈嗎…哼，我可不怕{F#妳}{M#你}！{F#妳}{M#你}在這裡站著別動，等著讓雷鳥大人把{F#妳}{M#你}驅走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060310,
					"content": "雷鳥不會再來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "#{F#妳}{M#你}說什麼…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060313,
					"content": "大家都已經離去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "#什麼…{F#妳}{M#你}在說什麼啊…別說讓我害怕的話呀，雞皮疙瘩都起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060316,
					"content": "不過…島上的人是越來越少了…之前木奈那孩子說，大家都去坐船了呢…唉，也不知道那孩子跑去哪裡玩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060317,
					"content": "#對了，島外來的惡靈大人，{F#妳}{M#你}不去嗎…？海邊那條銀璨璨的船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060318,
					"content": "我沒看到哪裡有船。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "哼…我就知道，那船呀，島外的人是看不到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060321,
					"content": "#謝謝{F#妳}{M#你}催我上船，島外的惡靈大人。只不過呀…我活了這麼些年，還有好些東西沒見識過呢，可捨不得離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060322,
					"content": "你需要什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "需要？哈哈，不算需要吧…也就是看個新鮮而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060324,
					"content": "我很小、很小的時候，曾經和宇奈大姐打過一個賭…我說島外一定有不一樣的蘑菇，可她就是不信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060325,
					"content": "後來…她的丈夫出海去了外人的土地，就再也沒能回來…他的靈也只能在外人的土地上遊蕩了…可憐呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060326,
					"content": "於是，宇奈大姐一直一個人過日子到現在…一想起來我就…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060327,
					"content": "請不要惦記別人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "我還求過祭司大人呢…好歹要給人家一個歸宿…嗯？哦，對了，對了，蘑菇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060330,
					"content": "咳咳…就要登船了，我也沒什麼可遺憾的…就是沒有見識過島外的玩意。可是我最在意的呢…也就每天都在關照的蘑菇們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060331,
					"content": "#就請{F#妳}{M#你}幫我帶來一些霧海外的蘑菇吧…也讓我長長見識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060332,
					"content": "#拜託{F#妳}{M#你}了，島外的惡靈大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060328,
					"content": "關於蘑菇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "那不是為我準備的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "是時候告別了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "「霧海」已經是過去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "就是我啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
