			"dialogs": [
				{
					"id": 790490101,
					"content": "這麼隱蔽的角落裡，居然藏著日記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790490102,
					"content": "原來外面那塊超大的石板，是伊迪婭給這個畫家的畫板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790490103,
					"content": "嗯，看樣子，他在「琉形蜃境」裡找到了喜歡的美景，還和「小水珠」們成為了好朋友，有了新的創作靈感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790490104,
					"content": "這樣的遭遇非常幸運。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "#咦！{F#妳}{M#你}不說我還沒想到，好像的確有些比較固執的人，受到打擊後就發了瘋一樣逼自己，最後整個人都變得不正常呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790490107,
					"content": "還好還好…多虧伊迪婭提供了工具，還有「小水珠」們陪著這個畫家，他才沒有走錯路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790490105,
					"content": "比苦練到走火入魔要好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
