			},
			"dialogs": [
				{
					"id": 790720101,
					"content": "#哎呀，真是榮幸。您就是那位{NICKNAME}吧？旁邊這位一定是您的同伴派蒙小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720102,
					"content": "嘿嘿，沒錯，就是我們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790720103,
					"content": "我們有這麼出名？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "星軌王城裡的消息總是比其他地方更靈通一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720105,
					"content": "不得不說您來得正好，我剛好做完了這個名為「飛帽」的遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720106,
					"content": "雖然我不能像那篇《飛帽匠》裡的帽子匠人一樣，讓所有人都擁有一頂漂亮的帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720107,
					"content": "但我相信這個「飛帽」遊戲，一定能將歡樂帶給所有遊玩的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720108,
					"content": "我還為這款遊戲設計了三種完全不同的玩法，呃…當然！規則也絕不複雜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720109,
					"content": "我相信您只要玩個一局就有辦法完全理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720110,
					"content": "想要試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "沒問題，請到這邊來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德維特"
				},
				{
					"id": 790720112,
					"content": "目前沒空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "別擔心，等您有空了再來找我吧，我這段時間會一直待在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德維特"
				}
			]
		}
	]
