						"stepId": 7101302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "我雖幸獲<color=#00E1FFFF>『神之眼』</color>，但心中亦有疑惑。世間魔物不絕，以凡人之力，何日能蕩清世間？而且那些魔物既有言語，也擅工造，亦有喜怒哀樂，除樣貌形狀外，實與人無異…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "遺蹟寶藏"
				},
				{
					"id": 710130202,
					"content": "我將心中疑問刻於碑上，不知道後世觀此碑者，能否為我解惑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遺蹟寶藏"
				}
			]
		},
