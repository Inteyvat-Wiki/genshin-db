			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "我與師弟自幼習武，勵志除魔衛道。但想要衛道世間，沒有<color=#00E1FFFF>『神之眼』</color>相助，又談何容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "遺蹟寶藏"
				},
				{
					"id": 710130102,
					"content": "我和師弟潛修於此，欲求<color=#00E1FFFF>『神之眼』</color>，立此碑為證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "遺蹟寶藏"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
							"2"
