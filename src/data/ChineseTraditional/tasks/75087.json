			},
			"dialogs": [
				{
					"id": 750870501,
					"content": "#既然{F#妳}{M#你}們都找到這裡了，那我也不用再扮演什麼善良的商人了吧？我已經受夠和笨蛋打交道，是時候透透氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870502,
					"content": "妳這傢伙，居然把自己幹的壞事說成是別人幹的！害我們被白白誤會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870503,
					"content": "#我是壞人，當然要幹壞事。再說了，{F#妳}{M#你}們被那三個笨蛋誤會，不就代表我的壞事幹得不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870504,
					"content": "#呵呵，現在我要幹更壞的事了，{F#妳}{M#你}們可別逃跑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870505,
					"content": "上吧！毛球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870506,
					"content": "吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "毛球"
				},
				{
					"id": 750870507,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#上吧！{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}！居然要挑戰比自己大很多的對手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870510,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870511,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "奧伯龍沒什麼精神的樣子，也不知道是因為和塔盧加分開而感到不安，還是單純因為龍龍餅乾吃太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}會不會是想替牠打氣，所以才勇敢地站出來保護我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870514,
					"content": "這世上多的是光靠勇氣無可奈何的事，比起那些虛無縹緲的東西，還是絕對的支配力更可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870515,
					"content": "攻擊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870516,
					"content": "#居然！{REALNAME[ID(2)|SHOWHOST(true)]}躲過了對方的攻擊！這正是嵴鋒龍的特長，就算是天空的王者也拿牠沒辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870517,
					"content": "攻擊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}擺出了進攻的架勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870530,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "攻擊命中了！而且還造成了…造成了微量傷害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870532,
					"content": "呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "好好，沒有被對方閃避而是成功命中已經很了不起了！呼——雖然才進行了一回合，但是已經覺得很累了，怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870534,
					"content": "那接下來輪到我了吧？攻擊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870535,
					"content": "#面對對手凌厲的進攻，{REALNAME[ID(2)|SHOWHOST(true)]}緊急採取防禦態勢！牠擋下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870536,
					"content": "居然在進攻之後又自己選擇防禦，可惡的規則破壞者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870537,
					"content": "回合制取勝的方法就是不要回合制！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "接下來該怎麼做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870539,
					"content": "…嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870540,
					"content": "欸？奧伯龍好像振作起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870541,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "雖然聽不懂這是在說什麼，但是看樣子牠們之間好像達成了某種默契…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870543,
					"content": "合力攻擊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "哦！也讓我們見識一下飛行學校明日之星的本領吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870552,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#哦！奧伯龍封住了向空中躲避的路線，再由{REALNAME[ID(2)|SHOWHOST(true)]}發起主動進攻，一次漂亮的合力攻擊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870554,
					"content": "對毛球造成了不小的傷害！是打到腳了嗎？想像一下腳趾撞到桌腳的感受！對手看起來已經陷入動搖，無法繼續行動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870555,
					"content": "攻擊，但是由我發起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#雖然也是一種選擇…但是難得有{REALNAME[ID(2)|SHOWHOST(true)]}表現的機會，就讓給牠嘛！不要這麼小孩子氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870565,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870566,
					"content": "呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#嗯？{REALNAME[ID(2)|SHOWHOST(true)]}和奧伯龍好像有什麼計畫的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870568,
					"content": "龍龍餅乾！哪裡來的龍龍餅乾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870569,
					"content": "嗚！啊嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870570,
					"content": "難、難道是藏在翅膀下帶出來的？真是隻狡猾小龍…塔盧加要應付你也真的很不容易耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870571,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870572,
					"content": "現在還不是時候！喂！停下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750870573,
					"content": "嗯？毛球無視了指令，徑直朝龍龍餅乾走去！恢復5點體力的誘惑實在太大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870574,
					"content": "牠沒有察覺到真正被放上餐盤的龍龍就是牠自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870575,
					"content": "#總而言之，之後也是如此這般你來我往的戰鬥。\\n{REALNAME[ID(2)|SHOWHOST(true)]}自然是表現得十分英勇，像是要證明自己一樣。雖然不能在飛行學校取得優秀學員的稱號，但還是可以靠其他本領幫忙夥伴。\\n令人意外的是，就連奧伯龍在體重上的意外成長也並非沒有作用——靠著比普通小絨翼龍大一點的體型，成功封鎖空中的戰場，並且重擊毛球…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "葵莉婭本人似乎並沒有任何戰鬥能力，在毛球喪失戰意後，她也不得不退場。\\n「可惡的規則破壞者，下次…下次我不會讓你贏得這麼輕鬆！給我洗乾淨脖子等著吧！」\\n說完廉價反派退場時一定要說的臺詞後，帶著負傷的毛球逃跑了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "唉呀！剛才忘記問她塔盧加在哪裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870578,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870579,
					"content": "哇，你先不要難過，塔盧加那麼聰明，一定不會有事的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870580,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#嗯嗯，{REALNAME[ID(2)|SHOWHOST(true)]}也是這樣覺得的對不對？現在我們先把奧伯龍送回飛行學校吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870557,
					"content": "說服對方投降。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "如果光靠對話就能解決問題，這個世界上為什麼還會有這麼多紛爭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870559,
					"content": "咳…我的意思是成功率應該很低啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870560,
					"content": "使用神奇道具收服。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870562,
					"content": "趁現在逃跑吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "嗚…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}都洩氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870545,
					"content": "防禦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "明明是二對一卻選擇防禦，對方應該也不能同時攻擊牠們，這樣不是會浪費掉一回合嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870547,
					"content": "道具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "使用龍龍餅乾恢復了5點體力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870549,
					"content": "…根本沒這種必要吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870550,
					"content": "逃跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "#現在明明形勢大好，{F#妳}{M#你}怎麼還想著逃跑啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870519,
					"content": "防禦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "嗚…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}似乎認為採取防禦太過保守，會浪費大好機會，於是擺出了進攻的架勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870522,
					"content": "道具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "我們現在哪有可以用的道具啊！就算是想要放捕獸夾也太晚了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870524,
					"content": "嗚…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#哦！{REALNAME[ID(2)|SHOWHOST(true)]}擺出了進攻的架勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870526,
					"content": "逃跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "現在不是逃跑的時候吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870528,
					"content": "嗚嗚…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#就連{REALNAME[ID(2)|SHOWHOST(true)]}都知道哦，看，牠擺出了進攻的架勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "派蒙"
				}
			]
		},
