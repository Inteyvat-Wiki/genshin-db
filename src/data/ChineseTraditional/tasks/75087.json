			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "欸？塔盧加！你已經回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870702,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}！幸好{F#妳}{M#你}們也沒事…我已經向姐姐他們說明情況了，拉密薩納就跟我想的一樣，是個笨蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750870703,
					"content": "啊嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870704,
					"content": "對啊，比你還要笨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750870705,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870706,
					"content": "#好啦好啦，牠和你分開這麼久一定也很不安，而且剛才牠和{REALNAME[ID(2)|SHOWHOST(true)]}的配合也很不錯哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870707,
					"content": "還有教化的空間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "嗯，牠還是隻小龍嘛，只要塔盧加好好和牠相處，之後絕對可以成長為一隻出色的絨翼龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870709,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870710,
					"content": "對了，你是怎麼回來的？是其他人找到你，先把你救出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870711,
					"content": "我是自己逃出來的。本來想帶奧伯龍一起走，但牠貪吃龍龍餅乾，怎麼勸都不肯動，我太生氣了就自己一個人走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750870712,
					"content": "欸？這麼容易嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870713,
					"content": "摸清看守龍的行動路線之後，我發現還是有可趁之機，很順利地就逃出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750870714,
					"content": "搞不好塔盧加才是這裡最可靠的一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870715,
					"content": "#{F#妳}{M#你}們怎麼來了！我正準備去找那個騙子算帳…還有、還有向{F#妳}{M#你}們正式道歉…是我太武斷了，險些誣陷了好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750870716,
					"content": "太晚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "對嘛！事情都結束了才現身，不是搶功勞是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870720,
					"content": "#我無話可說。之前約定的報酬也好現在的賠償也好，我都不會吝嗇。對了，如果這樣能讓{F#妳}{M#你}們消氣，給我一拳也可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750870721,
					"content": "我也是個男子漢，該負責任的時候不會推脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750870722,
					"content": "#讓{REALNAME[ID(2)|SHOWHOST(true)]}給你一拳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "好痛！還沒被踢就已經覺得很痛了！唯獨這點還請高抬貴手…也請高抬貴腳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750870727,
					"content": "剛才還說自己是男子漢不會推脫，真是沒出息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870728,
					"content": "#算了，我們也不是這麼小心眼的人物，對吧，{NICKNAME}、{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870729,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "#感謝{F#妳}{M#你}們的寬容，飛行學校…呃雖然沒有大門——但是還請意會一下——大門隨時向{F#妳}{M#你}們敞開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750870731,
					"content": "#嗯，看到{F#妳}{M#你}們和{REALNAME[ID(2)|SHOWHOST(true)]}關係這麼好，我也想要請教和小龍融洽相處的訣竅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750870732,
					"content": "嘿嘿，好喔，如果之後有空的話我們會再來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870724,
					"content": "#讓{REALNAME[ID(2)|SHOWHOST(true)]}踢你腳趾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "我要申請賠償金！還有參加獎。",
