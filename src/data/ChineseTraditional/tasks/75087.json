			"dialogs": [
				{
					"id": 750870301,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870302
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870302,
					"content": "嗚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870303
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870303,
					"content": "難道…難道是奧伯龍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870304,
					"content": "啊嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870305,
					"content": "呃…一下子不見，你成長了很多呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870306,
					"content": "塔盧加說牠容易胖，真的一點也不假。對了，他人呢？怎麼沒和你在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870307,
					"content": "嗚…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750870308,
					"content": "唔…總之先帶牠離開這裡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750870309,
					"content": "哦對，反正已經找到奧伯龍了，我們也不用東躲西藏了吧？塔盧加的下落也很叫人擔心…必須要快點了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
