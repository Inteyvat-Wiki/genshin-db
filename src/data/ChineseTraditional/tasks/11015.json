				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150101,
					"content": "凝光小姐的小秘書，我們把材料找齊啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150102,
					"content": "哦？這麼快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150103
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150103,
					"content": "而且三位是一起找齊的嗎…原來如此，我懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150104
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150104,
					"content": "千奇核心和仙家符籙都沒什麼問題。看來這場比賽，要分出勝負了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150105
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150105,
					"content": "#我宣佈，這次材料籌備競賽的三位優勝者，分別是{NICKNAME}、雲堇和北斗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150106
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150106,
					"content": "不是，這就結束了？我浮生石還沒找到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150107
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110150107,
					"content": "我不能接受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150108
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110150108,
					"content": "唉，緊趕慢趕，還是慢人一步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150109
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110150109,
					"content": "那就有請三位優勝者，先移步到群玉閣，凝光大人已經在上面等著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150110
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150110,
					"content": "咦？北斗哪去了，剛剛還看見她在這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150111,
					"content": "北斗小姐有些事情，可能會晚一點到。幾位先隨我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150112
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110150112,
					"content": "好吧，那我們先到群玉閣上看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150113,
					"content": "上次登上群玉閣，好像還是很久之前呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101502,
			"completionStepIds": [
				1101506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101506",
							"2"
						],
						"stepId": 1101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150201,
					"content": "將仙家符籙與千奇核心相結合，放入群玉閣控制倉內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150202,
					"content": "如此一來，群玉閣就算正式重建完畢。之後收起鐵索，它便會升入高空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150203,
					"content": "#辛苦幾位。現在該由我兌現承諾，給{F#妳}{M#你}們獎勵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150204
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150204,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150205,
					"content": "雲先生的來意，我稍有耳聞。妳正在為新的戲曲尋找合適的舞臺，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150206,
					"content": "正是。不知道凝光小姐有什麼建議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150207
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150207,
					"content": "既然是雲先生隆重準備的新戲，想必極有分量，初演不如就選在這新建成的群玉閣上，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150208
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150208,
					"content": "群玉閣地勢極高，由此向外，能一覽眾山小。高處知風勁，又可觀人間眾相，我想，天下怕是沒有比這裡更適合先生的戲臺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150209,
					"content": "多謝凝光小姐。稍後我會備好戲曲道具，勞煩凝光小姐一併帶上群玉閣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150210
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150210,
					"content": "名戲佳曲，值得如此。不必客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150211
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150211,
					"content": "#{NICKNAME}、申鶴，還有小派蒙，我先告辭了。記得來聽我的戲哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150212
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150212,
					"content": "#{F#妳}{M#你}呢？{NICKNAME}，{F#妳}{M#你}想問我什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150213,
					"content": "#事先說明，{F#妳}{M#你}{F#哥哥}{M#妹妹}的行蹤我也不清楚，就不要浪費這個問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150214,
					"content": "唔…凝光小姐總是未卜先知的樣子呢…既然這樣，就輪到派蒙來問了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150215,
					"content": "#…經商可沒有{F#妳}{M#你}們想的那麼容易。資金、人脈、對風向的感知、對機遇的嗅覺…凡此種種，缺一不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150216,
					"content": "#{F#妳}{M#你}們若是想問怎麼賺錢，我自會按照約定回答。但對現在的{F#妳}{M#你}們來說，未必有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150217,
					"content": "哇——明明我還什麼都沒有問呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150218,
					"content": "#心思都寫在臉上了，一看便知。當然，{F#妳}{M#你}們幫我重建群玉閣，恩情重大，我絕不會虧待{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150219
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150219,
					"content": "#我可以許諾，若有一天{F#妳}{M#你}們急需接濟，可以來我這裡尋個差使。至於薪水待遇，我當然會按最高規格來給。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150220,
					"content": "太好啦！下次摩拉用完的時候，我們來找凝光小姐就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150221,
					"content": "那我們倆都沒有問題了，申鶴有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150222,
					"content": "我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150223
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150223,
					"content": "是呀！因為材料是大家一起找齊的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150224,
					"content": "多謝…但我實在沒有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150225
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150225,
					"content": "是嗎？那這個千載難逢的提問機會，怕是要浪費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150226
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150226,
					"content": "怎麼可以這樣，不可以浪費！唔，讓我們再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150227,
					"content": "…凝光小姐，妳覺得我能融入璃月港嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150228
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150228,
					"content": "這倒是一個有趣的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150229
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150229,
					"content": "璃月港是一座包容的城市，只要妳遵守這裡的規章制度，它就不會拒絕妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150230
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150230,
					"content": "所以，重要的是，妳能否對璃月港產生「歸屬感」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150231
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150231,
					"content": "歸屬感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150232
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150232,
					"content": "是啊。喜歡一個地方，融入一個地方…總是要有理由的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150233
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150233,
					"content": "或許是在這裡遇見過什麼人、經歷過什麼事，也或許只是享受璃月的氛圍，習慣了這樣去生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150234
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150234,
					"content": "總之，每個人都需要一個留下來的理由，希望妳也能早日找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150235
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150235,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150236
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150236,
					"content": "喲，幾位正聊著呢？剛剛去了趟船隊，來晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150237
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150237,
					"content": "快來快來，正好輪到北斗啦！北斗有什麼想問的問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150238,
					"content": "我？我沒什麼想問的。本來就是被她強拉來幫忙，順便參賽而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150239
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150239,
					"content": "凝光，上次跟妳說的事，妳可別忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150240
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150240,
					"content": "那東西不好對付，光靠我的船隊，很難擺平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150241
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150241,
					"content": "放心吧，我準備好了。傷藥準備妥當，千岩軍也提前趕過去埋伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150242
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150242,
					"content": "那就好。妳自己當心點，不要掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150243
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 110150243,
					"content": "北斗，凝光小姐，妳們在聊什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150244,
					"content": "#等群玉閣升空，{F#妳}{M#你}們自會明白。但…不是什麼愉快的事，不知道或許更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150245
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150245,
					"content": "第一次登上群玉閣的時候，我站在高臺邊緣，從空中遙望著璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150246
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150246,
					"content": "那時我想，終有一日我會讓群玉閣的影子覆蓋七國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150247
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150247,
					"content": "時至今日，我的願望依然未變。不過，這次重修群玉閣，卻不只是為了我自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150248
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150248,
					"content": "我希望，無論何時群玉閣都能一直浮在璃月港上空，見證人間的繁榮安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150249
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150249,
					"content": "…也希望各位，與我一同見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150250
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150250,
					"content": "升空儀式，開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 1101503,
			"completionStepIds": [
				1101503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101503",
							"2"
						],
						"stepId": 1101503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150302,
						110150303
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150302,
					"content": "沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				},
				{
					"id": 110150304,
					"content": "只是力量有些消耗過度，沒關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150305
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150305,
					"content": "#本來想一個人把那傢伙處理掉，沒想到{F#妳}{M#你}還是追下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150306
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150306,
					"content": "放心，她暫時不敢來了。受了那麼嚴重的傷，應該已經遁逃到別處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150307
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150307,
					"content": "方才在水下，情況如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150308,
					"content": "解決掉了。她在潛入水下前就受了傷，我們沒費太大力氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150309
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150309,
					"content": "#那就好。無論如何，總算是平安度過本次危機了。之後請到群玉閣來，我會好好招待{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150310,
					"content": "凝光大人，船隊傳來消息，那隻水怪已經離開了孤雲閣附近，周圍海域恢復正常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150311
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150311,
					"content": "辛苦你們了，千岩軍情況如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150312
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150312,
					"content": "多虧了凝光大人準備的傷藥，以及刻晴大人的臨陣指揮，我們盡可能將損傷控制到了最低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150313
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150313,
					"content": "當然，也要感謝這位小姐出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150314
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150314,
					"content": "我替千岩軍所有的兄弟們，向妳表示感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150315
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150315,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150316,
						110150317
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150316,
					"content": "申鶴主動保護了我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150318,
					"content": "太好了。下次聽雲先生唱戲，我應該可以對那些讚美感到坦然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150319
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150319,
					"content": "#雖然我並未想做英雄，只是想保護{F#妳}{M#你}而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150320
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150320,
					"content": "讓士兵們好好休養。但不可過於懈怠，嚴防她捲土重來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150321
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150321,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150322
					],
					"speakerTitle": "正茂"
				},
				{
					"id": 110150322,
					"content": "暗中觀察這麼久，可有結論？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150323
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150323,
					"content": "哼，妳問本仙的意見？若非申鶴出手，絕不會如此順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150324
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150324,
					"content": "這一點我不否認。不過，無非是過程艱辛一些罷了，最終的勝利仍屬於我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150325
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150325,
					"content": "大不了，我可以再砸一個群玉閣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150326
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150326,
					"content": "…本仙看過了你們仿製和改造的歸終機，你們確實有一些新奇的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150327
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150327,
					"content": "從失敗中吸取經驗，提前佈局應對危機，相比上次有了長足的進步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150328
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150328,
					"content": "姑且算你們勉強過關吧，今後想必還有更多考驗，本仙會一直看著你們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150329
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150329,
					"content": "只要我還身居天權之位，我就會守護好璃月的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150330,
					"content": "申鶴，幾年前我看著妳偷溜下山，又面色難過地悄悄回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150331
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150331,
					"content": "這次來璃月港，妳的心境可有所不同？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150332
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150332,
					"content": "有。雖然說不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150333
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150333,
					"content": "不過，比想像的開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150334
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150334,
					"content": "#那就好。旅行者，申鶴這孩子，就有勞{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150335
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150335,
					"content": "說來，本仙記得許多她小時候的趣事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150336
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150336,
					"content": "這個就不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150337
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150337,
					"content": "是嗎？哼，一個兩個都這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150338
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150338,
					"content": "不愛聽也罷，本仙不說就是。本仙回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150339
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110150339,
					"content": "兩位先好好休息一番。等疲憊消失，就到群玉閣上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150340,
					"content": "既要慶祝群玉閣建成，也要慶祝璃月順利度過危機。這次的宴會，一定空前熱鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150317,
					"content": "就像戲曲中的英雄一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150318
					]
				},
				{
					"id": 110150303,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150304
					]
				}
			]
		},
		{
			"id": 1101504,
			"completionStepIds": [
				1101505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
