	"talks": [
		{
			"id": 1101501,
			"completionStepIds": [
				1101501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
