			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150401,
					"content": "哇哦…大家都落座了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150402,
					"content": "我還是第一次在群玉閣上參加凝光小姐的宴會呢！感覺有好多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150403,
					"content": "諸位都是我凝光的貴客。今日來此，可要盡興而歸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150404
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150404,
					"content": "不能喝酒的客人，請以飲品代替。美酒宜人，宜人的卻不只是美酒。相信群玉閣上的美景也能醉人心脾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110150405,
					"content": "聽說了嗎？今天好像有雲先生登臺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150406
					],
					"speakerTitle": "永業"
				},
				{
					"id": 110150406,
					"content": "呵，實不相瞞，我就是衝著這個來的！雲先生的戲，我可是一場不落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150407
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150407,
					"content": "這次據說唱的是《神女劈觀》，雲先生的父親寫的戲。我期待得兩三個晚上沒睡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150408
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150408,
					"content": "哎，你們看，雲先生上臺了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150409
					],
					"speakerTitle": "詩羽"
				},
				{
					"id": 110150409,
					"content": "怎麼樣，我唱得還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150410
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150410,
					"content": "太好聽了！有機會的話，派蒙也想學！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150411,
					"content": "很好聽。而且…謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150412
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150412,
					"content": "不客氣，多虧有妳，《神女劈觀》才能變得更加完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150413
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150413,
					"content": "戲會落幕，人生卻不會。相信今後，妳一定可以順利融入璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150414
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 110150414,
					"content": "謝謝。我想，我已經找到改變的「契機」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150415
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150415,
					"content": "雲先生…嗝…原來妳在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150416
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150416,
					"content": "嗯？這位白、白髮姑娘看著好特別，簡直就像是仙人一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150417
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150417,
					"content": "#莫非妳就是那位神女？還有這位，這位不是大名鼎鼎的{NICKNAME}嗎？嘿嘿嘿，看來這次我真是不虛此行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150418
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150418,
					"content": "不介意加張椅子吧，來，咱們一起聊聊天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150419
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150420
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150420,
					"content": "如果你不想用鼻子或者眼睛把剩下的酒喝完，就快點離開比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150421
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110150421,
					"content": "這熟悉的感覺…好像又回到第一次和申鶴見面的時候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110150422,
					"content": "看來還有很長的路要走呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150423
					]
				},
				{
					"id": 110150423,
					"content": "噫！妳想幹什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150424
					],
					"speakerTitle": "朱陶"
				},
				{
					"id": 110150424,
					"content": "冷靜，申鶴。冷靜呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
