			"dialogs": [
				{
					"id": 110143001,
					"content": "#啊，是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143002
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143002,
					"content": "七七怎麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143003
					]
				},
				{
					"id": 110143003,
					"content": "海邊，很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143004
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143004,
					"content": "七七正在，幫忙，疏散人群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143005,
						110143006
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143005,
					"content": "「危險」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143007
					]
				},
				{
					"id": 110143007,
					"content": "嗯。凝光說，海裡有不好的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143008
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143008,
					"content": "所以，派七七來，疏散人群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143009
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143009,
					"content": "不過，沒有人聽七七說話，七七只能守在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143010
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143010,
					"content": "萬一有危險，七七就站出來，保護大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110143011
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110143011,
					"content": "#{F#妳}{M#你}們，也不要靠近海邊，會遇到危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "七七"
				},
				{
					"id": 110143006,
					"content": "「疏散人群」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110143007
					]
				}
			]
		}
