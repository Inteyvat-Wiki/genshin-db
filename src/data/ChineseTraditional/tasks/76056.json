			"dialogs": [
				{
					"id": 760560601,
					"content": "竟然真的輸給了一個過路人…三次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "英凱莉"
				},
				{
					"id": 760560602,
					"content": "不不不，你我各輸了兩次，老大只輸了一次而已，還好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560603,
					"content": "#唉！輸了就是輸了，多想也沒用！{NICKNAME}真的很強嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560604,
					"content": "你們兩個平常連我都打不過，現在見識到真正的強者了吧？你們還要多訓練才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560605,
					"content": "至於我嘛！看來要考慮早點退休了，不知道瓦伊諾的訓練場還有沒有在招人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特爾霍"
				}
			]
		},
