			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特爾霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "抱歉，我還有事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "#沒關係，反正我們也是在這裡打發時間。等{F#妳}{M#你}有空了，閒得發慌的時候再來找我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特爾霍"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特爾霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "對不起老大…我讓大家丟臉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560402,
					"content": "哎，本來就是打發時間，輸了也沒關係。彼伊列，你先去旁邊休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560403,
					"content": "#這位朋友，{F#妳}{M#你}的身手很矯健嘛！我的名字叫特爾霍，幸會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560404,
					"content": "#我是{NICKNAME}，幸會！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "#{F#妳}{M#你}看起來是有不少實戰經驗的高手，那我們就要認真一點了。剛才那次不算，再比試一次！英凱莉，輪到妳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560406,
					"content": "老大每次都是遇到麻煩才想起我…真是沒辦法。那麼，這位高手，我們開始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "英凱莉"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
							"2"
						],
						"stepId": 7605603,
						"stateName": "QUEST_STATE_UNFINISHED"
