				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特爾霍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "我、我竟然輸了…被一個隨隨便便的路人打敗了…這…怎麼可能？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "英凱莉"
				},
				{
					"id": 760560502,
					"content": "唔…竟然贏過英凱莉了…是我太輕敵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560503,
					"content": "不是老大的錯，畢竟誰想得到會有這麼強大的對手恰巧路過這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "彼伊列"
				},
				{
					"id": 760560504,
					"content": "老大！不能放他們走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "英凱莉"
				},
				{
					"id": 760560505,
					"content": "哦？難道不只是想切磋而已？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "別誤會，英凱莉的意思是不能就這樣認輸罷了。我們畢竟也算是有點尊嚴的寶藏獵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}，我鄭重地向{F#妳}{M#你}發出正式挑戰。這一次可就不是過招了，我們拿出真本事來打一場怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "特爾霍"
				},
				{
					"id": 760560508,
					"content": "那就請三位一起上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "好，那我們就不客氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特爾霍"
				}
			]
		},
		{
			"id": 7605606,
