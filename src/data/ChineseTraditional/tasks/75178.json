					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "這範圍太大了！怎麼想都不可能吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781009,
					"content": "唉…就沒有什麼更實際的辦法嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781010,
					"content": "呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#等等！{REALNAME[ID(2)|SHOWHOST(true)]}，不要亂跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781005,
					"content": "火山裡應該有很多熔岩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "哦！我懂了，讓小傢伙幫忙挖個洞，然後用火山的熔岩來加熱溫泉對吧？是個不錯的辦法呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781007,
					"content": "呀！呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#才怪呢！用熔岩是會鬧出人命來的！認真一點啦！{F#妳}{M#你}看{REALNAME[ID(2)|SHOWHOST(true)]}都信了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "派蒙"
				}
			]
