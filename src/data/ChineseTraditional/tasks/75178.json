				{
					"id": 751780901,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，{F#妳}{M#你}們好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780902,
					"content": "怎麼無精打采的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "其實…相比之前，溫泉的水溫好像還是有點冷…這次我闖了好大的禍，回去以後該怎麼辦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780905,
					"content": "別擔心，再等等看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "嗯，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780903,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#唔…路上小心，{NICKNAME}{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
