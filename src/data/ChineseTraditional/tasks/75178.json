			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "#異邦的勇士，如何？{F#妳}{M#你}們找到通向「最強」的道路了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "盧施"
				},
				{
					"id": 751780502,
					"content": "關於「最強」的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "#往山上走，有一片充滿「烈度之水」的山地。在那裡，{F#妳}{M#你}們或許能找到「最強」的身影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盧施"
				},
				{
