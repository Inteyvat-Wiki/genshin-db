			"dialogs": [
				{
					"id": 751781401,
					"content": "咦，小鰭游龍？怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781402,
					"content": "——奇歐奇歐！你果然在這裡…如、如果你們再不出來的話，我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781403,
					"content": "萬一受傷了怎麼辦？下次可不許亂跑了，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781404,
					"content": "別、別哭了，妳看，小龍不是好好的嗎？很有精神的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781405,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "嗯，沒、沒問題的。我、我叫莉娜夏，是「流泉之眾」那邊的…平時都是我負責照看小鰭游龍的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781407,
					"content": "負責照看小鰭游龍？真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781408,
					"content": "沒、沒有啦…我要是能像派蒙姐姐一樣的話，牠們肯定就不會跑丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781409,
					"content": "剛剛我就在想，是不是大家都跑去噴口玩了，所以才找不到。現在來看，果然是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781410,
					"content": "原來溫泉變冷，是因為小鰭游龍們把燃素噴口堵住了啊。怪不得管理員都沒發現呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781411,
					"content": "派、派蒙姐姐！其實…我還有兩隻龍夥伴沒找到，牠們大概也是躲在燃素噴口裡玩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781412,
					"content": "沒問題，妳放心吧！我們在調節水溫的時候，會順便幫妳把小鰭游龍們找回來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751781413,
					"content": "嗯，有派蒙姐姐在，我就放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781414,
					"content": "啊哈哈，那當然，我可是傳說中的冒險家，這等小事肯定是手到擒來！",
