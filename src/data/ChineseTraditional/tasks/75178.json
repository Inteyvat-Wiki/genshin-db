			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "有、有沒有人來幫忙！有人暈過去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "尤魯赫"
				},
				{
					"id": 751780202,
					"content": "#完、完蛋了！大師好像暈過去了！我們也快去幫忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "#大師似乎只是熱暈了過去，身體並沒有大礙。在{F#妳}{M#你}們的幫助下，暈倒的大師被尤魯赫接走了…\\n看起來，大師本人的「烈度」，或許還有待進一步的提升…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
