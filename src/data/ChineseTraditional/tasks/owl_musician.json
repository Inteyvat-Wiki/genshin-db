					}
				]
			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#歡迎來到星軌王城，{NICKNAME}、派蒙小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710102,
					"content": "#我已經從同僚那邊聽說過{F#妳}{M#你}們的名字和事蹟，兩位的確是勇武之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710103,
					"content": "如果不是我必須負責守衛的訓練事宜，也想與兩位切磋一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710104,
					"content": "你是王城的守衛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "正是。我等奉城主大人之命守衛星軌王城，維護其安寧和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710106,
					"content": "而我的職責則是鍛煉守衛，使守衛的武力配得上職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710107,
					"content": "所以這後面的門就是通往訓練場的門？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "果然敏銳。這個入口通往一處秘境，前段時間我們方才改造完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710109,
					"content": "在這個訓練場中，受訓者必須按照特定的節奏揮劍，場地的照明環境在戰鬥時也會不斷變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710110,
					"content": "好嚴格的訓練…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "聽起來好複雜…戰鬥時還要按照特定的節奏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790710112,
					"content": "這一步驟其實是來源於一篇名為《貓頭鷹樂師》的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710113,
					"content": "前段時間這篇故事在守衛之中頗為流行，不少人看得開心，就連訓練也忘了參加，甚至還有人耽誤了日常巡邏的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710114,
					"content": "既然大家都如此喜愛這本書，那我覺得將這個故事的元素加入訓練之中，大家一定會更喜愛訓練吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710115,
					"content": "從結果上來說訓練效果的確顯著，至少…沒有人再因為個人原因耽誤巡邏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710116,
					"content": "呵呵…不知道兩位對我們的訓練有沒有興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710117,
					"content": "我想以兩位的勇武之能，訓練場中的各類考驗一定都不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710118,
					"content": "想要試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "好，勇氣可嘉，請您踏入秘境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛夫"
				},
				{
					"id": 790710120,
					"content": "還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "無妨，兩位可以有空再來。我這段時間會一直守在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃洛夫"
				}
			]
		}
	]
}