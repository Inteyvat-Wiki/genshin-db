					}
				]
			},
			"dialogs": [
				{
					"id": 715060101,
					"content": "胡塞尼，你不是說理論上沒有問題的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715060102,
					"content": "光釘反而讓黑泥湧出來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060103
					]
				},
				{
					"id": 715060103,
					"content": "我想想，原來是這樣…居然沒有考慮到地面係數的變更，真是意料之外的失誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060104,
					"content": "地面係數？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715060105,
					"content": "對，以前的實驗場地，基本上都是在較鬆軟的土地上進行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060106,
					"content": "可在層岩巨淵這裡，光釘的能量傳播的介質不是泥土，而是材質屬性不同的岩石，這種變化使原先計算的結果產生了偏差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060107,
					"content": "果然，真理並不存在於臆造的想像，而是需要腳踏實地，於現實中進行驗證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060108,
					"content": "這驗證也太危險了。而且…怎麼會一下出現這麼多黑泥呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715060109,
					"content": "確實，這麼說來，這裡明明離礦區還有一定的距離，按理來說黑泥不應該湧到這裡才對…情況比想像中還要緊急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060110,
					"content": "以及，「普爾希娜光釘」確實能夠對黑泥環境造成影響，那就說明黑泥氾濫正如我們所猜測的，是地脈造成的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060111,
					"content": "這證明了實驗和實證的必要性，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060112,
					"content": "雖然，如果是我自己進行試運轉，恐怕就會被怪物襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060113,
					"content": "我受傷還是小事，要是「普爾希娜光釘」一旦有什麼損失，我怎麼跟大導師菲爾納斯還有「妙論派」諸多學者交待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060114,
					"content": "還是多關注一下自己的安全吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060115
					]
				},
				{
					"id": 715060115,
					"content": "嗯，這次試運轉得到的資料可以修正計算結果，解決這種參數干擾的辦法有…對，有四種，但是其中最有效的應該只有一種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060116,
					"content": "#{NICKNAME}，這次試運轉真是多謝{F#妳}{M#你}了，我會對「普爾希娜光釘」再做些調整的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060117,
					"content": "等過段時間，就把它搬到礦區進行運作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060118,
						715060119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060118,
					"content": "搬到礦區？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060120
					]
				},
				{
					"id": 715060120,
					"content": "那倒不是，原本我和海迪夫商量，雇傭層岩巨淵本地的礦工進行搬運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060121,
					"content": "不過有幾名礦工聽說我的目的是為了解決出現在礦區的黑泥之後，他們就堅持不肯要酬勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060122,
					"content": "但是我和海迪夫跟總務司管理層岩巨淵的沐寧先生聊過，這筆錢會當做補貼發放給他們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060123,
					"content": "#等到光釘被搬到那裡之後，還得拜託{F#妳}{M#你}幫忙啟動機器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715060119,
					"content": "你一個人搬嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060120
					]
				}
			]
		}
	]
}