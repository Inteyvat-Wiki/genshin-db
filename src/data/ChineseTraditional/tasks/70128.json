			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "欸，這個瓶子沉甸甸的，好像裡面有什麼東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280102,
					"content": "「我們的老朋友昨天來了，帶來了壞消息…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280103,
					"content": "「很久以來一直沒有得到回應。或許他說的對，我應該接受現實。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280104,
					"content": "「但無論如何。假如妳還在東奔西走，假如妳收到了這條訊息，希望妳能回應我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280105,
					"content": "「隨信附上妳的徽章，以便到時候我會借它認出妳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280106,
					"content": "「還記得『烏有亭』嗎？我們會在那裡相聚，酒錢也隨信寄來了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280107,
					"content": "「如果收到這封信的您，並不是我所期待的人…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280108,
					"content": "「也希望您留下這枚信物，或許您能幫助我尋得它的舊主，這些摩拉權作謝意。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
}