	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔耶芙爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "欸？這不是塔耶芙爾姐姐嗎？沒想到又見面了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240202,
					"content": "#唉呀，是{F#妳}{M#你}們，冒險家和{F#她}{M#他}的小助手，上次忘記問{F#妳}{M#你}們的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240203,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}。上次多虧有妳，我們才能成功用「海螺琴」演奏古代的樂譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240204,
					"content": "不過塔耶芙爾姐姐怎麼到佩特莉可鎮來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240205,
					"content": "#這個問題我也想問{F#妳}{M#你}們呢，我可是一聽到風聲就趕過來了。不過既然{F#妳}{M#你}們是冒險家，會捷足先登也是理所當然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240206,
					"content": "風聲，妳是說什麼風聲呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240207,
					"content": "講到佩特莉可鎮，最近最大的新聞不就是那個嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240208,
					"content": "我們一不小心拯救了世界？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "#嗯？{F#妳}{M#你}在說什麼啦，當然是傳說中的褪色城堡被再度發現的事情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240211,
					"content": "#上一次有關於褪色城堡的記載還是幾百年前的事情，我還以為{F#妳}{M#你}們是為了這個才來的耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240212,
					"content": "這個嘛，雖然和我們好像是有一些關係啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240213,
					"content": "#{F#妳}{M#你}們應該知道吧？褪色城堡曾經屬於楓丹歷史上最重要的音樂家波愛修斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240214,
					"content": "無論是波愛修斯所創作的歌劇，還是他整理的古雷穆利亞樂譜，在音樂史上都有著特殊的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240215,
					"content": "既然是他曾經居住過的城堡，就一定存有大量的資料。這對於我們音樂家協會來說可是重要的文獻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240216,
					"content": "因此一聽到這個消息，我就趕緊跑了過來，想趕在其他冒險家之前把重要的文獻存起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240217,
					"content": "#沒想到還是讓{F#妳}{M#你}們搶先一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240218,
					"content": "（怎麼辦？要不要告訴她那個波愛修斯其實是個大壞蛋，還利用那些音樂做了一大堆壞事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240219,
					"content": "（要是知道真相的話，她該不會要傷心吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240220,
					"content": "「樂章」已經做不了壞事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "#嗯？{F#妳}{M#你}們在偷偷說些什麼啊？該不會{F#妳}{M#你}們已經發現什麼古代的樂譜了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240223,
					"content": "那個…假如…我是說假如哦…假如波愛修斯是個很壞很壞的人，你們還會想要他留下的什麼樂譜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240224,
					"content": "#嗯…雖然不知道{F#妳}{M#你}說的很壞很壞是什麼意思，不過波愛修斯除了音樂之外，在歷史上也沒有留下什麼好名聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240225,
					"content": "從他留下的浪漫主義歌劇《漂泊的異鄉人》也可以看出來，直到去世前他都沒有放棄重建雷穆利亞，並因此敵視著新生的楓丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240226,
					"content": "而且根據歷史學家的說法，楓丹剛建立時的戰亂也與他有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240227,
					"content": "不過音樂上的成就又是另一回事了，就算他創作的那些音樂有著錯誤的歷史，也無法否定那些音樂在藝術上的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240228,
					"content": "而且在我看來，這本來也是歷史的一部分。就算是純粹的藝術也有可能被用來做壞事，作為音樂家也必須要牢記這一點才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240229,
					"content": "如果是妳的話一定不會用來做壞事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "哈哈，我只是個研究者罷了，能夠聆聽這些古老的曲調就是我最大的願望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240233,
					"content": "#話說回來，既然這麼巧遇到{F#妳}{M#你}們，可以請{F#妳}{M#你}們幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240234,
					"content": "#也算是作為上一次我幫助{F#妳}{M#你}們的回報，禮尚往來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240235,
					"content": "妳上一次不是說不用報酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "嘿嘿，那就當作是幫幫我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240240,
					"content": "總之呢，就像剛才說的，我到這裡來是為了尋找遺失的著名歌劇《漂泊的異鄉人》的曲譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240241,
					"content": "#根據幾百年前一個叫魯傑羅的人留下的紀錄，這個曲譜應該就藏在褪色城堡的某處，如果{F#妳}{M#你}們可以幫忙找的話那就再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240242,
					"content": "#畢竟探索遺蹟這種事應該還是{F#妳}{M#你}們比較專業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}，既然她都這樣說了，我們就幫幫她吧。反正那些樂譜應該都已經沒有「那種力量」了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240244,
					"content": "#嗯嗯，那我就當{F#妳}{M#你}們答應了哦，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240245,
					"content": "#就拜託{F#妳}{M#你}們了，在{F#妳}{M#你}們回來之前，我會在鎮上靜候佳音的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240237,
					"content": "我可是要收報酬的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "#我當然會給{F#妳}{M#你}們報酬，我們音樂家協會可不是什麼窮酸的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240239,
					"content": "我已經猜到會這樣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "真是了不起的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "嘿嘿，只是我個人的見解啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240221,
					"content": "這件事想說清楚也有點困難…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "難道是佩特莉可鎮大催眠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
		{
			"id": 7422404,
			"completionStepIds": [
				7422404
			],
