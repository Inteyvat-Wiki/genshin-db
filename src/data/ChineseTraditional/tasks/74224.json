			"trigger": {
				"objectNames": [
					"塔耶芙爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "這裡的風景還真不錯。雖然我們每年要從鎮上訂購很多樂器，不過以旅客的身分過來還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240802,
					"content": "關於曲譜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "沒事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "#就拜託{F#妳}{M#你}們了，在{F#妳}{M#你}們回來之前，我會在鎮上靜候佳音的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙爾"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422409",
							"2"
						],
						"stepId": 7422409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔耶芙爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "#這個是…嗯，果然是《漂泊的異鄉人》的曲譜沒錯，{F#妳}{M#你}們竟然真的找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240902,
					"content": "#一定費了一番工夫吧，不愧是了不起的冒險家，相信{F#妳}{M#你}們果然沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240903,
					"content": "嘿嘿，不過塔耶芙爾姐姐要拿這個曲譜做什麼呀？該不會是想要在歐庇克萊歌劇院演出，然後大賺一筆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240904,
					"content": "這個嘛，雖然賺錢也很重要啦，不過我是沒有打算把這個曲譜私藏起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240905,
					"content": "這些古老的藝術應該是全人類的財富，在完成整部《漂泊的異鄉人》的研究後我就會把這個公之於眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240906,
					"content": "復原了失傳的劇目，填補藝術史上缺失的一頁，難道不是更加了不起的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240907,
					"content": "加油！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "那我也要趕快回去研究這張曲譜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240911,
					"content": "#這些是給{F#妳}{M#你}們的報酬，我們就有緣再見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙爾"
				},
				{
					"id": 742240908,
					"content": "不要忘了我的貢獻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "#那當然囉，我會在扉頁上寫上{F#妳}{M#你}們的名字的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "塔耶芙爾"
				}
			]
		},
