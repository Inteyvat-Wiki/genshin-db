			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法爾伽"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530101,
					"content": "喲！我們的榮譽騎士也被赫塔「逮捕」，來幫忙做事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530102
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530102,
					"content": "之前聊到飲料攤位的時候，我看著酒單，就有些按捺不住了，現在正好驗收一下成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530103
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530103,
					"content": "雖然不久前才在廣場上喝過兩杯，但…酒這種好東西，在不傷身的範圍內，多多益善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530104
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530104,
					"content": "既然事情已經告一段落，接下來，就是輕鬆享受的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530105,
						705530106
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530105,
					"content": "是平等僱傭關係哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				},
				{
					"id": 705530107,
					"content": "#那可不得了，我必須好好嚐嚐{F#妳}{M#你}的手藝！給我來杯適合慢慢閒聊，但又夠有勁的酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530108,
						705530109
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530108,
					"content": "這個要求還真像在開玩笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530110,
					"content": "當然不衝突！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530111
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530111,
					"content": "「夠烈」，就意味著不能一口喝完，「要閒聊」的話就不能太嗆辣，尾韻最好偏甜，正巧卡在那個平衡點上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530112
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530112,
					"content": "酒單裡目前最適合的選擇就是「帶刺鏡湖」了，幾乎每個酒吧都會出售這款烈性特調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530113
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530113,
					"content": "當然，知道了配方還不夠，調製的過程才是重點…有的酒保選擇堅持經典，有的則會適當加入自己的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530114,
						705530115
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530114,
					"content": "那我就來試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530116,
					"content": "氣勢不錯！那就大展身手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530115,
					"content": "知道配方就能開工了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530109,
					"content": "大團長這是正經的考驗嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530106,
					"content": "我好歹也是天才酒保！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				}
			]
		},
		{
			"id": 7055302,
			"completionStepIds": [
				7055306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
