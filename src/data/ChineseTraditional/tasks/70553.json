						"stepId": 7055306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法爾伽"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530201,
					"content": "大團長，請檢驗這杯「帶刺鏡湖」的成色！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530202
					]
				},
				{
					"id": 705530202,
					"content": "嗯，色彩和香氣到位了，酒體的火候嘛…入口便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530203
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530203,
					"content": "不錯，每種成分的用量都相當準確，可惜，還是顯得太有「禮貌」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530204,
						705530205
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530204,
					"content": "禮貌？酒要怎麼禮貌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				},
				{
					"id": 705530206,
					"content": "#當然是謙遜的禮貌！{F#妳}{M#你}選擇了嚴格按照配方——甚至更保守的比例，來調和這杯「帶刺鏡湖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530207
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530207,
					"content": "好像在擔心…只要這杯酒的口味有那麼一丁點偏差，就會讓我失望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530208,
						705530209
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530208,
					"content": "的確是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530210,
					"content": "喂，我們並肩作戰了這麼久，搞定了神明都覺得棘手的大麻煩，稱得上生死的交情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530211
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530211,
					"content": "#大可以放開一點，施展{F#妳}{M#你}天才酒保的鬼點子，給我來杯驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530212,
						705530213
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530212,
					"content": "那我就好好改進一番。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530214,
					"content": "#慢慢來，不用著急！邊聊邊想，看看{F#妳}{M#你}能把什麼樣的靈感攪拌到酒杯裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530215
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530215,
					"content": "除了「禮貌」，這杯「帶刺鏡湖」還有別的問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530216
					]
				},
				{
					"id": 705530216,
					"content": "我想想…大概還有一點是——缺少「衝擊力」。在配方相同的情況下，混合各種成分的手法，也會對口感造成影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530217
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530217,
					"content": "有時，在酒體之間刻意營造出分層感，反而能強調兩種酒體分別拍擊味蕾時的「浪濤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530218
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530218,
					"content": "#這方面，{F#妳}{M#你}也採用了非常柔和的手法，要不要試試看再放開一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530219,
						705530220
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530219,
					"content": "好像…懂了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530221,
					"content": "哈哈哈哈，果然一點即通，不用多說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530222
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530222,
					"content": "這個巨大的酒杯是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530223
					]
				},
				{
					"id": 705530223,
					"content": "看起來滿不錯的吧？像個錘子，能裝酒，還能用來敲釘子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530224
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530224,
					"content": "這是霍夫曼的主意、查爾斯設計、瓦格納幫忙鑄造，還有十來個騎士每人出一份心意錢，共同為我準備的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530225
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530225,
					"content": "他們早就等著和我痛痛快快喝一場了，這個酒杯就是我和他們公平對決的重要「武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530226,
						705530227
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530226,
					"content": "…公平？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530228,
					"content": "我是大團長，酒齡比他們大一點、練得比他們多一點，身形也比他們壯一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530229
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530229,
					"content": "所以我每杯多喝一點，對部下們才公平，很有道理吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530230,
						705530231
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530230,
					"content": "這一杯可不只一點點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530232,
					"content": "當然，也有酒齡和我差不多的老夥計，我就不照顧他們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530233
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530233,
					"content": "譬如「果榛03」和「果榛05」，當年和我一起給了伊洛克兩頓迎頭痛擊的好手，現在我讓他們幫琴分攤雜務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530234
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530234,
					"content": "今天的下班酒會，他們硬是要和我喝個盡興，結果輸掉了飛鏢遊戲，不省人事了，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530235
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530235,
					"content": "我已經告訴琴了，明天無論如何都不幫他們批假！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530236
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530236,
					"content": "在花園和酒館裡喝酒的感覺不一樣吧？考慮到環境，也許可以加一些植物香氣的元素？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530237
					]
				},
				{
					"id": 705530237,
					"content": "#哦，{F#妳}{M#你}倒是滿有格調！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530238
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530238,
					"content": "說到這個花園，我就想起許多年前的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530239
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530239,
					"content": "我年輕時，總喜歡去找遺蹟守衛練拳練劍…有次，我不小心放跑了它們的飛彈，流彈炸壞了城牆上的一座哨塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530240
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530240,
					"content": "結果我被罰繞城長跑五十圈，修好哨塔後，再到這座花園，幫忙砌好碎塊打壞的磚牆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530241,
						705530242
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530241,
					"content": "聽起來鬧得還滿大的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530243,
					"content": "的確是年輕犯下的錯誤當中記憶比較深的一次…因為那天，克利普斯看見了灰頭土臉的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530244
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530244,
					"content": "他帶來了兩瓶百年陳釀，讓迪盧克…比現在的米卡看起來還年輕的迪盧克…支開了看守我的費魯，方法很機靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530245
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530245,
					"content": "那天真熱啊…我都快被曬暈了…一時興起摘了幾片薄荷葉塞進酒瓶…結果味道好得出奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530246
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530246,
					"content": "克利普斯照樣子試過後也連連誇讚，後來還把我靈機一動的產物寫進了正式配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530247
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530247,
					"content": "酒客們的反應都很不錯呢！過了好幾個夏天，克利普斯還在不停寫信，說要給我分成…那我能要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530248,
						705530249
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530248,
					"content": "聽起來太久遠了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530250,
					"content": "是啊，克利普斯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530251
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530251,
					"content": "費魯都退休好幾年了吧…每次見面，還對我板著一張臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530252
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530252,
					"content": "啊哈，那個老頑固…頂替他的迪盧克，還有後來的凱亞幹得無可挑剔，新時代永遠屬於年輕人，他早該認輸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530253
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530253,
					"content": "下次找個機會，讓凱亞帶著他見識一下騎兵小隊驚人的發展好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530254
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530254,
					"content": "話說回來，這座花園也成了舉辦活動的熱門場所了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530255
					]
				},
				{
					"id": 705530255,
					"content": "哈哈，這花園可是騎士團打理了好多年的寶地，用來辦活動當然是最適合的選擇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530256
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530256,
					"content": "#我聽說了，遠征隊在外的這段時間，多虧有{F#妳}{M#你}幫忙操持，大家有了許多釋放活力的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530257
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530257,
					"content": "有時候，我也會找找各種活動拍下的畫片，可惜，不是每個人都入鏡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530258
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530258,
					"content": "結論是，蒙德應該提升留影機的普及率！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530259
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530259,
					"content": "如果大團長沒去遠征，這些活動會辦成什麼樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530260
					]
				},
				{
					"id": 705530260,
					"content": "我來管活動？那大概…每次的主題都要包含美酒，或者在活動裡加入一次酒會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530261
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530261,
					"content": "譬如，把這次的飲品小站做大，向全城人開放，每個小隊都派出一名甚至幾名調飲代表來好好比試一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530262,
						705530263
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530262,
					"content": "果然會變成這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530264,
					"content": "哈哈哈，也只能想想罷了！肯定不能鬧得太過火…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530265
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530265,
					"content": "要是敢大張旗鼓辦酒會，琴一定會提著劍找上門來…不，芙蕾德莉卡也會加入對我的討伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530266
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530266,
					"content": "哪怕在挪德卡萊，我們也有個規矩——執勤期間的隊員絕不能喝醉，否則有可能釀成玩忽職守的惡果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530267,
						705530268
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530267,
					"content": "我覺得這樣很對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530269,
					"content": "嗯，隨著遠征的成員回歸各個小隊，希望這個規矩也能慢慢融入本土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530270
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530270,
					"content": "就像火水，還有酸奶油這種挪德卡萊的風味食材，走進了蒙德的家庭，成為了生活習慣的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530271
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530271,
					"content": "年輕人們也要懂得自然而然地克制啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530272,
						705530273
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530272,
					"content": "沒想到大團長也有這一面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530274,
					"content": "說到底，酒量不夠好，就不要打腫臉充胖子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530275
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530275,
					"content": "酒量不到我的三成，就別談什麼在工作日「享受微醺」了，多半會喝茫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530276
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530276,
					"content": "週末跟著我慢慢練吧，哈哈哈。把他們灌個東倒西歪，保證一週都不想碰酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530277
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530277,
					"content": "好像感動得有點早…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530278
					]
				},
				{
					"id": 705530278,
					"content": "好消息，我找到方向了，借你的酒杯一用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530279
					]
				},
				{
					"id": 705530279,
					"content": "哦？那就拿去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530280
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530280,
					"content": "這架勢不一般啊，我有種撞上頭彩的預感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530273,
					"content": "這就是酒豪的張弛有度嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530268,
					"content": "愛好不能影響正事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530263,
					"content": "還真是你的風格！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530249,
					"content": "是我來蒙德很久前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530242,
					"content": "團長也有這麼狼狽的時候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530231,
					"content": "你考慮公平的對象是不是反了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530227,
					"content": "…對決？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530220,
					"content": "之前沒注意到這個細節…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530213,
					"content": "有你這話，我就要來真的了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530209,
					"content": "怎麼可以給行家亂調。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530205,
					"content": "難道是諧音笑話…狸貓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				}
			]
		},
		{
			"id": 7055303,
			"completionStepIds": [
				7055310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7055310",
							"2"
						],
						"stepId": 7055310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法爾伽"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530301,
					"content": "大團長，請收下你的特調！這次絕對可以喝個盡興了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530302
					]
				},
				{
					"id": 705530302,
					"content": "怎麼搞的？這股氣勢…滾滾湧來的火水氣味，好像要把空氣點燃…這才對嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530303
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530304
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530304,
					"content": "#痛快！我感受到了…{F#妳}{M#你}放下拘謹後，拿出了驚豔的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530305
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530305,
					"content": "入口瞬間，薄荷發動清涼的佯攻，暫時掩蓋火水的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530306
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530306,
					"content": "等到那股甜味消散，火水已經滑下喉嚨，強勁的酒精味瞬間在口腔中爆發開來，正是我想要的衝擊感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530307,
						705530308
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530307,
					"content": "然後再用酸奶油收尾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530309
					]
				},
				{
					"id": 705530309,
					"content": "這一點尤為精妙！火水的尾段太過平淡，甚至是純淨無味，一直被人詬病，而酸奶油恰好將口感維持在熱烈的峰值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530310,
						705530311
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530310,
					"content": "唉呀，把我誇得都不好意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530312
					]
				},
				{
					"id": 705530312,
					"content": "很難想像這居然是一位…不喝火水的酒保調製出來的絕品。我覺得它有成為蒙德與挪德卡萊雙重名酒的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530313,
						705530314,
						705530315
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530313,
					"content": "「北風騎士」象徵著狼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530316,
					"content": "#「狼與鐵」…好啊！夠文雅，又狂放，還真是只有{F#妳}{M#你}能想出來的酒名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530317
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530317,
					"content": "#我看啊，以後這騎士團的飲品小站，不如直接冠上{F#妳}{M#你}的稱號，就叫「榮譽騎士特調屋」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530318
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530318,
					"content": "事不宜遲，我這就和赫塔的弟子聊聊看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705530314,
					"content": "騎士團堅強如鐵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530315,
					"content": "這杯就叫「狼與鐵」如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530311,
					"content": "都是和大團長聊出來的靈感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530312
					]
				},
