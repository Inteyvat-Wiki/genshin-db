				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "#謝謝{F#妳}{M#你}，旅行者，嗚，我就知道，我肯定會把工作給搞砸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180102,
					"content": "就是運一車酒而已我都能搞砸，我到底能做成什麼事情呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180103,
					"content": "這麼下去肯定會被酒莊開除，康納先生說不定早就覺得我工作能力不行，埃澤先生也許把我的辭退信都擬好了，完了，全都完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180104,
					"content": "你…你冷靜點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "唉，我肯定完蛋了，但是這車酒還是要運到才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180106,
					"content": "#車也被打壞了…旅行者，能麻煩{F#妳}{M#你}幫我找點材料來嗎？只要一塊<color=#00E1FFFF>結實的木板</color>就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "害怕的瑪伽"
				}
			]
		},
