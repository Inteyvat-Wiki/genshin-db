			"dialogs": [
				{
					"id": 200180401,
					"content": "#呼…謝謝，旅行者，還好有{F#妳}{M#你}在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180402,
					"content": "不過這麼一弄，這車我已經不知道怎麼修了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180403,
					"content": "這裡是壞的，那裡也是壞的…這就算是勉強修好了，走著走著也會散架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180404,
					"content": "算了，總之先把車弄到鎮裡去，再慢慢想辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180405,
					"content": "我記得車上有繩子來著…肯定是被那群傢伙拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "害怕的瑪伽"
				},
				{
					"id": 200180406,
					"content": "旅行者，幫我去旁邊樹林裡找找看吧，如果<color=#00E1FFFF>繩子</color>在那就好了。",
					"roleType": "TALK_ROLE_NPC",
