			},
			"dialogs": [
				{
					"id": 140240413,
					"content": "各式各樣的事情縈繞在心裡，始終無法入眠…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 140240401,
					"content": "呼哇…說著要早點睡，結果完全睡不著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240402,
					"content": "#{F#妳}{M#你}說，「僕人」如果知道了林尼他們做的事，會不會很生氣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240403,
					"content": "#她平時笑著的時候，我就覺得有點嚇人。要是她發起火來…嗚嗚，到時候{F#妳}{M#你}一定要保護我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240404,
						140240406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240404,
					"content": "其實我也有點怕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240405
					]
				},
				{
					"id": 140240406,
					"content": "放心躲在我身後就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240407
					]
				},
				{
					"id": 140240405,
					"content": "#{F#妳}{M#你}也有同樣的感覺嗎？那、那到時候我們一起逃跑吧！拉著林尼他們，有多快跑多快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240407,
					"content": "#嘿嘿，我就知道{F#妳}{M#你}靠得住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240409,
					"content": "#{F#妳}{M#你}{F#妳}{M#你}、{F#妳}{M#你}快看那邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240410,
						140240411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240410,
					"content": "克雷薇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240411,
					"content": "她怎麼跑出來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240412,
					"content": "要是被人發現就糟糕了…我們快跟上去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
