					},
					{
						"sceneId": 3,
						"position": [
							2806.94,
							362.234,
							4147.252
						],
						"pointId": 340300432
					}
				]
			},
			"dialogs": [
				{
					"id": 140240301,
					"content": "林尼！怎麼樣，有什麼進展嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240302,
					"content": "說來話長，我這邊遇到了一點麻煩——克雷薇沒辦法去有陽光的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240303
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240303,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240304
					]
				},
				{
					"id": 140240304,
					"content": "我讓她跟在我身旁，然後帶她到地面上。最開始一切都很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240305
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240305,
					"content": "但是當我領著她穿過陰影，走入陽光的時候，我突然發現她不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240306
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240306,
					"content": "回過頭，就看到她停留在陰影的邊緣，靜靜地望著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240307
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240307,
					"content": "難道她害怕陽光嗎？不對不對，如果是這樣的話，她就不會提出「在陽光下生活」的願望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240308,
					"content": "呃…要不推她一下試試？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240309,
					"content": "能推的話就不叫「亡魂」了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240310
					]
				},
				{
					"id": 140240310,
					"content": "也對哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240311,
					"content": "總之，我嘗試了各種方法，都沒能成功。眼見太陽落山，我只能先帶著克雷薇回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240312
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240312,
					"content": "琳妮特，妳那邊情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240313
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240313,
					"content": "我拿到名單了，在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240314
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240314,
					"content": "真的嗎？快讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240315,
					"content": "居然有這麼多！要完整看完要花多長時間呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240316,
					"content": "我們分一分吧，每人看一部分，給。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240317
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240317,
					"content": "拉普亞德…朗杜瓦…讓貝爾…奧爾內…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240318,
					"content": "嗚哇，這個奧爾內臉上有好深的疤痕，看上去就是個很可怕的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240319,
					"content": "哦，我跟他接觸過。他是某次執行任務的時候受的傷，當時他還跟我開玩笑，說以後要被愛人嫌棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240320
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240320,
					"content": "那你怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240321,
					"content": "我問他有愛人嗎？他說沒有，聊天到這裡就結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240322
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240322,
					"content": "後來我聽說他真的喜歡上了一個人，為了她不惜從家裡逃跑，但沒能成功。有一天他被「父親」叫出去…之後我就再也沒有見過他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240323
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240323,
					"content": "也就是說，他被「僕人」給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240324,
					"content": "雖然殘酷，但這就是家的規矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240325
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240325,
					"content": "在壁爐之家，每個人都知道太多秘密，所以這裡容不下背叛。想從家裡離開，必須付出生命的代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240326
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240326,
					"content": "眾人懷著沉重的心情看完了處刑名單，但裡面並沒有克雷薇的名字。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240327
					]
				},
				{
					"id": 140240327,
					"content": "沒有啊…這也在預料之中。這份名單並不完整，只有近五年的紀錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240328
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240328,
					"content": "還是從別的地方入手吧，菲米尼，你打聽到什麼情報了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240329
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240330
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240330,
					"content": "菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240331
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240331,
					"content": "抱歉，我剛剛在想事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240332
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240332,
					"content": "我認真地跟其他人聊了聊，感覺家裡的氣氛有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240333
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240333,
					"content": "奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240334
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240334,
					"content": "嗯。其實以前，家裡就有許多爭吵。比如沙普洛和菲約爾之間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240335
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240335,
					"content": "是我們分發物資的時候見過的那些人嗎？他們看起來的確不太一樣，聊的話題也完全不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240336,
					"content": "很簡單。「父親」將我們帶到壁爐之家，教我們知識和武藝，但並非每個人都發自內心地想留在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240337
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240337,
					"content": "在加入壁爐之家後，我們就帶上了「愚人眾」的標籤。在很多人看來，這並非是一個光明正大的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240338
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240338,
					"content": "隨著年齡增長，一部分人的心裡有了別的想法。只是囿於壁爐之家的規矩，不敢輕易開口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240339
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240339,
					"content": "沙普洛、福爾茨他們更擁護和認可「父親」，以身為愚人眾為傲。而在菲約爾、南特伊心裡，這種感情要平淡許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240340
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240340,
					"content": "這種矛盾一直都存在，「父親」應該也知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240341
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240341,
					"content": "但我覺得情況好像變嚴重了。菲約爾他們…似乎私下裡會聚在一起聊什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240342
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240342,
					"content": "雖然只是我的猜測，但我覺得他們應該見過克雷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240343
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240343,
					"content": "你覺得克雷薇在煽動他們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240344
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240344,
					"content": "不像，但克雷薇可能跟他們說了一些「家裡不為人知的黑暗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240345
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240345,
					"content": "她也跟我說過這些，比如拿孩子們做實驗、強迫沒有力量的人上戰場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240346
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 140240346,
					"content": "菲約爾他們相信了？這些事完全沒有證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240347
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240347,
					"content": "我覺得他們未必相信，但克雷薇的話提供了一個藉口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240348
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240348,
					"content": "唉…根源還是在「嚴冬計畫」上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240349
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240349,
					"content": "等一下，你們講慢點啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240350,
					"content": "「僕人」好像也提到了「嚴冬計畫」，這個到底是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240351,
					"content": "抱歉，具體內容我也不瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240352
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240352,
					"content": "我只是聽「父親」說過，是由「公雞」與「富人」兩位執行官聯手推動計畫，涉及到愚人眾接下來的戰略安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240353
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240353,
					"content": "因為順利拿到了神之心，壁爐之家得到了嘉獎，並將在嚴冬計畫中承擔非常重要的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240354
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240354,
					"content": "這對你們來說不是好事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240355,
					"content": "「重要」等同於「危險」，對我們來說是很大的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240356
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240356,
					"content": "「父親」也很頭疼，但又沒法拒絕。他們的計畫合情合理，甚至給我們調撥了大量經費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240357
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240357,
					"content": "但是——按照這個計畫執行，我們會犧牲很多人。這也算一種變相打壓，他們對不受掌握的情報部門感到不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240358
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240358,
					"content": "（看來愚人眾內部正在策劃什麼大事。不過林尼他們對此並不知情，打聽不到太多情報。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240359
					]
				},
				{
					"id": 140240359,
					"content": "（今後和愚人眾接觸的時候，仔細觀察一下吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240360
					]
				},
				{
					"id": 140240360,
					"content": "沒想到愚人眾內部這麼複雜，不過這和你們家裡的矛盾有什麼關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240361
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240361,
					"content": "外界的壓力會加速內部的分化。死亡的恐懼壓在心頭，可能會讓一些人做出錯誤的舉動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240362
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240362,
					"content": "我本來以為解決克雷薇的事情，一切就可以恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240363
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240363,
					"content": "現在看來情況比我預想的更麻煩。如果放任菲約爾他們不管，「父親」遲早會對他們動手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240364
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240364,
					"content": "哥哥，我們只能做好眼前的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240365
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140240365,
					"content": "也是。現在去找菲約爾他們，一時間也不會有什麼結果，反倒會適得其反。還是先想辦法送別克雷薇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240366
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240366,
					"content": "今天很晚了，我們先各自去休息。明天太陽昇起，立刻出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240367
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240367,
					"content": "琳妮特，這次妳跟我一起去外面。菲米尼，拜託你盯著菲約爾他們，盡量不要讓他們做錯事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240368
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140240368,
					"content": "今天辛苦大家了。晚安，明天再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
