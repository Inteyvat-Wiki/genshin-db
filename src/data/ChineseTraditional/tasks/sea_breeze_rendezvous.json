					}
				]
			},
			"dialogs": [
				{
					"id": 140240601,
					"content": "克雷薇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240602,
					"content": "噓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240603
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240603,
					"content": "趁沒有人盯著，我把窗戶打開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240604
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240604,
					"content": "#{F#妳}{M#你}們看，外面的景色很漂亮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240605,
						140240606
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240605,
					"content": "窗戶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				},
				{
					"id": 140240607,
					"content": "只可惜，這就是我能做的極限了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240608
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240608,
					"content": "#在{F#妳}{M#你}們眼中，我所做的事情是不是很可笑呢？相較於這種看不到希望的反抗，還是生活在美好的夢裡比較輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240609
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240609,
					"content": "克雷薇，妳到底知道什麼呀？能和我們具體說說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240610,
					"content": "#可以呀，雖然{F#妳}{M#你}們可能會後悔聽到這些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240611
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240611,
					"content": "包括我在內，這個家裡的所有人都只是「工具」與「消耗品」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240612
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240612,
					"content": "有利用價值的人暫時留著，沒有價值的人，被送給「博士」做實驗。我親眼見過許多人生不如死的模樣，我已經受夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240613
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240613,
					"content": "妳說的這些都是「僕人」做的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240614,
					"content": "我覺得不像吧。雖說她看起來很可怕，但好像也沒壞到這個程度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240615,
					"content": "#嗯，我知道{F#妳}{M#你}們不會相信我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240616
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240616,
					"content": "每個人都覺得她是個好人，都覺得她是一位真正的「母親」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240617
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240617,
					"content": "「母親」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240618,
					"content": "可她玷汙了這個稱呼。如果可以，我永遠都不想再見到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240619
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240619,
					"content": "假如佩佩在這裡就好了，她一定能明白我的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240620
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240620,
					"content": "佩佩…又是這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240621,
					"content": "#說起來，{NICKNAME}，{F#妳}{M#你}有沒有一種奇怪的感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240622,
					"content": "她和我們之間就好像隔著什麼東西一樣。她真的是在和我們說話嗎，還是把我們錯認成了別人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240623,
						140240624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240623,
					"content": "我也想不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240625,
					"content": "好吧，不過我感覺她好像很願意向我們傾訴，不如我們就多陪她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240626,
					"content": "她看起來年齡很小，不過心裡好像藏著許多事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240627,
					"content": "起風了，該關上窗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240628
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240628,
					"content": "#月色很漂亮吧？悄悄告訴{F#妳}{M#你}們哦，據說至冬夜裡的極光，比今晚的月亮還要美麗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240629
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240629,
					"content": "真想看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240630
					]
				},
				{
					"id": 140240630,
					"content": "我跟佩佩約好了，長大後一起去看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240631
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240631,
					"content": "可我最近找不到佩佩了。難道說她也被…不對，她是「特別」的，母親很喜歡她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240632
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240632,
					"content": "我得去找母親大人談談。但我們剛吵了架，她不想見我，我也不敢見她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240633
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240633,
					"content": "我到底該怎麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240634
					],
					"speakerTitle": "克雷薇"
				},
				{
					"id": 140240634,
					"content": "之後，克雷薇像是陷入思考。她靜靜地站在那裡不再說話。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240635
					]
				},
				{
					"id": 140240635,
					"content": "許久後，克雷薇才回過神，虛弱地笑了一下，獨自走了回去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240636
					]
				},
				{
					"id": 140240636,
					"content": "呼…真是搞不懂她在想什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240637,
					"content": "我們也回去吧，明天還要早起呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140240624,
					"content": "畢竟是難以理解的「亡魂」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240606,
					"content": "這裡什麼也沒有吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				}
			]
		}
	]
}