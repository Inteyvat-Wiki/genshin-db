			"dialogs": [
				{
					"id": 140232201,
					"content": "克雷薇，我想帶妳去個地方。妳願意跟我一起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140232202
					],
