			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "看，<color=#00E1FFFF>「輝煌勇氣之劍」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120402,
					"content": "不會吧？就是一把超普通的舊劍而已啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120403,
					"content": "丘丘人為什麼要圍著這種東西膜拜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120404,
					"content": "（恐怕只是，有人把劍扔進了丘丘人本來就在膜拜的戰利品堆裡吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120405,
					"content": "這、這也太舊了！而且…該怎麼說呢，普通到讓人說不出話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101120406,
					"content": "不，傑克，你有沒有見過蒙德城外飛舞的風晶蝶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120407,
					"content": "這種蝴蝶在白天毫不起眼，到了漆黑的夜晚卻會光彩奪目，簡直就像是會飛的寶石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120408,
					"content": "勇氣不也是這樣嗎？一帆風順的人不會明白它的可貴，可是當你身處絕境，勇氣就是令你奮起抗爭、走出絕境的唯一之光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120409,
					"content": "溫迪也只剩一張嘴了嗎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "你、你說得太對了！沒錯就是這樣，這一定就是「輝煌勇氣之劍」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101120413,
					"content": "嗯，那麼，劍已經找到，只差盾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120414,
					"content": "在附近轉轉吧！東西一定就在<color=#00E1FFFF>達達烏帕谷</color>裡——嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120415,
					"content": "哎呀？那邊好像有個人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120416,
					"content": "史丹利？他怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120417,
					"content": "他的樣子有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120418,
					"content": "出什麼事了嗎？為什麼突然停下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101120419,
					"content": "沒什麼，剛才有只會撒金幣的「盜寶鼬」跑過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120420,
					"content": "什麼？在哪！我也要看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101120421,
					"content": "你不是來找神器的嗎？就別看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120410,
					"content": "令人震撼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "我都快信了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
