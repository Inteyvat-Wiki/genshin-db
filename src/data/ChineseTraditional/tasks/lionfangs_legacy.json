			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丘丘人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "看，<color=#00E1FFFF>「光耀意志之盾」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120602,
					"content": "騙人！那根本就是塊普通木板吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120603,
					"content": "破破爛爛的，還帶著桶箍！誰會把這種東西當成盾牌啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120604,
					"content": "而且上面還有酒漬…像是從酒桶上隨便拆下來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101120605,
					"content": "可是按我吟遊詩人的直覺，這就是「光耀意志之盾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120606,
					"content": "戰士以身上的疤痕為榮，盾牌也是一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120607,
					"content": "一面盾牌越是完整，越說明它遠離戰場。盾牌的破舊，不正是它身經百戰的證明嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120608,
					"content": "即使身軀殘破，也要在戰場上拼殺到最後一刻，要戰鬥到流乾最後一滴血為止。這樣的意志，難道不珍貴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120609,
					"content": "溫迪說得對！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "說得也是…哪有乾乾淨淨的盾牌啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120613,
					"content": "那我們…想辦法問問它，能不能把「光耀意志之盾」轉讓給我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120614,
					"content": "你好，丘丘人先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120615,
					"content": "Dala？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120616,
					"content": "#哇，{NICKNAME}還是{F#妳}{M#你}來吧。試試平時聽過的那些丘丘語音節？或者用肢體語言交流吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120617,
					"content": "我用摩拉和你換盾牌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120623,
					"content": "呃…它好像<color=#00E1FFFF>不太開心</color>的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120624,
					"content": "這朵甜甜花，送給你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120628,
					"content": "嗯，看起來它的情緒還挺<color=#00E1FFFF>穩定</color>，也許可以繼續談…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120631,
					"content": "溫迪，唱歌。盾牌，給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "嗯？好吧，那我就稍微彈一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101120634,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120635,
					"content": "嗯，看起來它的情緒還挺<color=#00E1FFFF>穩定</color>，也許可以繼續談…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120633,
					"content": "Mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
