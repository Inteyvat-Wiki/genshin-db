					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120637,
					"content": "呃…它好像<color=#00E1FFFF>不太開心</color>的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120625,
					"content": "我收繳的丘丘面具，送給你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120630,
					"content": "呃…它好像<color=#00E1FFFF>不太開心</color>的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "請把盾牌送給我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 101120621,
					"content": "嗯，看起來它的情緒還挺<color=#00E1FFFF>穩定</color>，也許可以繼續談…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101120610,
					"content": "我也覺得這就是那面盾牌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "不愧是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
