			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "謝謝你們，謝謝你們！我找到我要的東西了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101121002,
					"content": "爸爸媽媽！看看我找到的神器吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101121003,
					"content": "哎？等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121004,
					"content": "說好的酒呢！我幫這麼多忙也是很累的吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121005,
					"content": "嗯？這不是史丹利嗎，你到這裡來散步嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121006,
					"content": "啊、啊哈哈哈哈，這不是吟遊詩人嗎！真巧，你也來這裡散步？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101121007,
					"content": "是啊，吃完飯出來走走，陪朋友找點東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121008,
					"content": "（我越來越覺得，史丹利先生可能是騙子了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121009,
					"content": "（我也這麼想…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "（所以史丹利是為了不傷害傑克的感情，才故意提前一步，到這裡佈置劍和盾嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121012,
					"content": "大冒險家一定很熟悉達達烏帕谷吧？畢竟，這裡是你戰鬥過的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121013,
					"content": "當然，當然，我閉著眼睛都能把這裡走遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101121014,
					"content": "原來如此，真佩服你的記性和毅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121015,
					"content": "我是大冒險家嘛，應該的！倒是你們，這裡有很多丘丘人，可別掉以輕心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101121016,
					"content": "那、那就再見了，年輕人們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101121017,
					"content": "他果然非常心虛啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121018,
					"content": "沒辦法，誰叫他對傑克誇下海口了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121019,
					"content": "不過…再看一次，果然有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121020,
					"content": "不願遺忘「過去」，而拋棄「現在」的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121021,
					"content": "如果他被迫邁出「向未來」的第一步，又會踏在什麼方向呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121022,
					"content": "嗯？什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101121023,
					"content": "哈哈，自言自語而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121024,
					"content": "#對了，{NICKNAME}。今晚，我們去<color=#00E1FFFF>「天使的饋贈」</color>看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101121010,
					"content": "（不是可能，是一定。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
		},
