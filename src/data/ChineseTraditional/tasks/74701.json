					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "咦？怎麼感覺這邊多了一個池子？牌子上寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010102,
					"content": "「危險，請勿靠近」？什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010103,
					"content": "字面意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010104,
					"content": "哇！桑多涅。嚇我一跳，這牌子是妳立的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010105,
					"content": "嗯，免得誰好奇心重掉到了這池子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010106,
					"content": "這池裡有什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010107,
					"content": "食人魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010109,
					"content": "哈哈，逗妳玩的，還真的信啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010110,
					"content": "我早些時候發現水族箱裡有些魚領地意識比較強，性格也比較暴躁，會攻擊其他小魚，就把牠們移到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010111,
					"content": "嚇我一跳…所以說，這裡就像是魚兒們的特殊療養所一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010112,
					"content": "嗯，這池子水比較深，空間也大許多，能讓那些領地意識較強的魚冷靜冷靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010113,
					"content": "我還找梅洛彼得堡的希格雯護士要了一些特製的餌食，緩解緩解牠們暴躁的脾氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010114,
					"content": "哦，原來是這樣。妳還是滿關心這些魚的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010115,
					"content": "看牠們在魚缸裡打架誰都不好受吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010116,
					"content": "的確。那乾脆這個工作也交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010117,
					"content": "好啊。總之只要池子裡的魚有心情到水面上來透氣，就證明牠們療養得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010118,
					"content": "治好了牠們的脾氣，就又能把牠們放回水族箱裡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010119,
					"content": "#放回哪裡隨{F#妳}{M#你}們自己定。我只負責把不聽話的撈到這個池子裡而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010120,
					"content": "好吧，但妳的告示牌也太嚇人了，要不要換一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010121,
					"content": "#唔…也行。{F#妳}{M#你}們捕的魚，聽{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
}