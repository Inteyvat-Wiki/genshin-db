				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "荒瀧派，我來和你們決鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320102,
					"content": "怎麼回事？「花角玉將」那傢伙又派了個小孩來出戰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320103,
					"content": "該不會是人手不夠了，想要草草應付我們了事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320104,
					"content": "…你不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320105,
					"content": "吵吵鬧鬧的人，通常都是雜魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320106,
					"content": "#這位金髮的{M#大哥哥}{F#大姐姐}很沉穩，有一股強者的氣勢。{M#他}{F#她}才是你們荒瀧派的老大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320107,
					"content": "#嘿嘿嘿，這位朋友的眼光很毒辣嘛！多誇{NICKNAME}幾句！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320108,
					"content": "啊？妳在胡說八道什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320109,
					"content": "#我的摯友確實強得離譜，但這次，{M#他}{F#她}只是我們荒瀧派的援手！幫派的名字寫得清清楚楚，老大當然永遠是我荒瀧一斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320110,
					"content": "那我就把名字加上限時前綴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "對耶，荒瀧派的實力先放在一邊，當老大到底是什麼感覺呢？我也有點好奇了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320113,
					"content": "如果你答應我們，我也可以是「荒瀧（三天後到期）派蒙」，或者「荒瀧派派蒙（臨時老大）」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727320114,
					"content": "#喂喂喂！{F#妳}{M#你}們兩個！不要被對手帶偏了啊！她明顯是…想讓我們起內訌！她在耍陰謀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320115,
					"content": "等到本大爺戰勝了她的老大，她就要為這番大話後悔，慌慌張張收回它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727320116,
					"content": "省省吧…你們荒瀧派內部的事，我可不關心，我只想和厲害的對手較量一番！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320117,
					"content": "#先讓我領教一下這位{M#大哥哥}{F#大姐姐}的鬥蟲本領吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「怪力三十三」"
				},
				{
					"id": 727320111,
					"content": "老大的位置借我坐幾天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}