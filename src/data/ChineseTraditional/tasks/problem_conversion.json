			},
			"dialogs": [
				{
					"id": 230190401,
					"content": "#怎麼樣，{F#妳}{M#你}檢查完那艘船了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190402,
					"content": "已經檢查完了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "在描述了船隻情況之後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "原來如此，那些為了省錢而用了取巧的方式，結構果然出問題了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190405,
					"content": "但維修這種結構要花不少錢，那個船主人，我記得手頭一直很拮据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190406,
					"content": "唉，我還是去和他談談吧，和錢相比，肯定是命更重要啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				}
			]
		}
