			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉菲克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "果然，這樣做會更花錢啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190102,
					"content": "你在說什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "#啊，{F#妳}{M#你}好，我正在研究一艘船隻的設計問題呢，現在…遇到了一些瓶頸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190104,
					"content": "簡單來說，就是我想在不提高造價的情況下，讓船能裝更多的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190105,
					"content": "一旦重量大了，結構會變得更容易破損，重量不均勻的情況下平衡也會出現問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190106,
					"content": "解決這些問題的最好方法，就是用更好的材料，但這樣…問題就又回到了造價問題上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190107,
					"content": "唉，其實說白了就是我沒錢，但又想要造出一艘好船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190108,
					"content": "所以某些用錢就能搞定的問題，我只能想辦法用一些技術性的手段完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190109,
					"content": "真的能這麼做嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "#哈哈哈，說出來{F#妳}{M#你}可能不信，但其實有很多人都這麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190111,
					"content": "畢竟我們造的船也都是不會遇見什麼風浪的近海漁船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190112,
					"content": "大家都秉承著能省則省，修修補補的原則造船…湊合湊合，能用就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190113,
					"content": "拜這原則所賜，我們修船的生意每天都好得不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190114,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，就幫我去那邊檢查一下那艘剛回港的船吧，它貌似因為經常運載重物出了點問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190115,
					"content": "我剛好就在研究這方面的問題，說不定能從它身上找到點靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "#那就拜託{F#妳}{M#你}了！我得趕緊去修另外一艘船去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190118,
					"content": "#{F#妳}{M#你}自己怎麼不去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "我也想自己去，但我還被人拜託去維修另外一艘急著要再出海收網的船…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230190120,
					"content": "#所以就只能拜託{F#妳}{M#你}了，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				}
			]
		},
