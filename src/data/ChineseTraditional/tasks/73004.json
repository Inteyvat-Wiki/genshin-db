					"nextDialogs": [
						730040111
					]
				},
				{
					"id": 730040111,
					"content": "總之，之後有機會可以打聽一下，那是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
