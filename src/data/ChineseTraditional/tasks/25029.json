			"dialogs": [
				{
					"id": 250290201,
					"content": "乖乖喔，今天吃飽了嗎？有沒有力氣訓練啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290202,
					"content": "嗚，嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250290203,
					"content": "嗚哇，這麼有活力？好！那今天可要加把勁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290204,
					"content": "一起加把勁吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#欸？您好啊，{M#大哥哥}{F#大姐姐}！我們正在做爬山訓練哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
