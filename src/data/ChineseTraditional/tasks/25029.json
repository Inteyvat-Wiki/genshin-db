					"nextDialogs": [
						250290216
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290216,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}可以再示範一遍嗎？",
