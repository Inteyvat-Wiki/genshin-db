					"nextDialogs": [
						250290310
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250290310,
					"content": "#{M#大哥哥}{F#大姐姐}，謝謝{F#妳}{M#你}幫忙，這枚「苦種」給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "特拉忒"
				},
