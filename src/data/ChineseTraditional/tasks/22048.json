			"dialogs": [
				{
					"id": 220480101,
					"content": "神社又有些亂了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "唔喵，是汝等啊，來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480104,
					"content": "神社周圍又有些亂了，落葉都積在地上，很難看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480105,
					"content": "這樣子可不能接待來神社的人類啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480106,
					"content": "汝等，能和上次一樣，幫奴家打掃一下神社嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480107,
					"content": "不是有大祐和悅子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "奴家可不會去主動找那兩個綠綠的人類說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480109,
					"content": "那個高高的人類，看奴家的眼神總是很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480110,
					"content": "另外一個綠綠的人類，又總是那副提不起勁的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480111,
					"content": "喵喵，無論怎麼想，都是兩個靠不住的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480115,
					"content": "總之，就拜託汝等了。就和上次一樣，用長棍子來「打掃」，汝等明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480116,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "總之，這件事就拜託汝等了，奴家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480119,
					"content": "奴家在這裡等著汝等，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480117,
					"content": "差不多明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "可以拜託大島先生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "那個石頭人類一直在忙個不停，不知道在咚咚咚地敲什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220480114,
					"content": "明明石頭已經敲好了，為什麼還在咚咚咚呢，真煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「寢子」"
				}
			]
		},
