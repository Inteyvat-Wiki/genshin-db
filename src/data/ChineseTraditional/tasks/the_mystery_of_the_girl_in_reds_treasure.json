			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "啊，是秘境的入口！深淵法師一定是逃進去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010302,
					"content": "那它也就沒有退路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "呼…呼……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010305,
					"content": "小可莉，還跑得動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010306,
					"content": "要不要留在這裡，我們討來寶物之後還給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010307,
					"content": "…不，不行，我要跟你們一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010308,
					"content": "毛茸茸偷的是我的東西，我自己也要負責把它奪回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010309,
					"content": "很有勇氣呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "嘿嘿，可莉是很厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010312,
					"content": "#榮譽騎士{F#姐姐}{M#哥哥}，我們走我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010310,
					"content": "但是秘境很危險哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "我們追上去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
			"id": 1020104,
			"completionStepIds": [
				1020111
			],
