			"dialogs": [
				{
					"id": 102010101,
					"content": "到了到了！就在這附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010102,
					"content": "你們看，我那~~麼大一個寶物，之前就是埋在這的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010103,
					"content": "被挖出了一個坑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010104,
					"content": "等等，那邊有誰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "是深淵法師？！難道它就是琴團長之前警告的，偷偷接近蒙德城的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010106,
					"content": "咦？它手裡拿著的是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010107,
					"content": "是我的寶物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010109,
					"content": "嘁，那女孩居然帶了幫手。計畫有變…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010110,
					"content": "喂！你有本事別逃呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010111,
					"content": "我們追。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
