				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "哼，追上來了嗎。看來你們還算有兩下子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010402,
					"content": "不過，你們也就到此為止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010403,
					"content": "你想要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010404,
					"content": "哈哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010405,
					"content": "我們可是在人類的傳言裡，收集到了詳細的戰力情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010406,
					"content": "這個紅衣服的小女孩，擁有蒙德城最厲害的寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010407,
					"content": "現在寶物在我手上，你們再著急也沒用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010408,
					"content": "好——就用這個寶物來對付你們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010409,
					"content": "不行！千…千萬別動它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010410,
					"content": "哼哼，看妳慌張的樣子，終於知道害怕了嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010411,
					"content": "讓我看看，哦…火焰的標記嗎，哼哼哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010412,
					"content": "嘣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "深淵法師"
				},
				{
					"id": 102010501,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010502,
					"content": "生存守則之——「炸彈傷人琴找上門」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010503,
					"content": "完了完了…這下全完了嗚嗚嗚……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010505,
					"content": "可莉的「寶物」，原來是炸彈嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010506,
					"content": "好厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "唔，難怪會有可莉是蒙德最強戰力的傳言呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010509,
					"content": "至少我是肯定不敢跟她打架的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010510,
					"content": "但是，她為什麼要逃走呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010511,
					"content": "她好像提到了生存守則。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "唔，也對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "派蒙"
				},
				{
