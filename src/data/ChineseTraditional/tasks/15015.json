					{
						"sceneId": 3,
						"position": [
							-1539.939,
							162.305,
							7889.229
						],
						"pointId": 350400221
					}
				]
			},
			"dialogs": [
				{
					"id": 150150901,
					"content": "好了，我把嬸嬸鎖在了屋裡，也捆上了好幾道繩子。等會我就把她帶去部族，讓她受到應有的懲罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150902
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150902,
					"content": "現在嘛…我們就先離那個屋子遠一點，在這裡曬曬太陽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150903
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150903,
					"content": "折騰那麼久，我真的要累癱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150904
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150904,
					"content": "一下子全都安排好了，希諾寧的效率還真高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150905,
					"content": "唉…現在想想也好可怕，特拉佐莉居然想把收養來的孩子變成妮赫佳，還差點成功了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150906,
						150150907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150906,
					"content": "還好我們發現得及時。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150908
					]
				},
				{
					"id": 150150908,
					"content": "是啊，希諾寧倒數的時候真帥氣，呼咻一下就衝了上去，一口氣搞定了所有事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150909,
					"content": "這也是多虧了妮佩卡一直沒有放棄。要是沒有她一直那麼勇敢地嘗試求救，我可沒那麼容易就察覺到嬸嬸的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150910,
						150150911
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150910,
					"content": "妮佩卡很勇敢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150912
					]
				},
				{
					"id": 150150912,
					"content": "#是希諾寧姐姐、派蒙姐姐和{NICKNAME}{M#哥哥}{F#姐姐}鼓勵了我，而且這也是我能想到的最後一個辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150913
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150913,
					"content": "之前我嘗試了好多次，但那些來家裡做客的叔叔和阿姨，要嘛被特拉佐莉用各種方法請走，要嘛就是都不相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150914
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150914,
					"content": "就算我把所有事都說出來，特拉佐莉也會用我生病了做藉口掩蓋過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150915
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150915,
					"content": "只要她一流淚…客人們就會光顧著安慰她，完全忘記聽我說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150916
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150916,
					"content": "我寄出去的信、收到的禮物，全都是被她檢查過的，只要…只要我不聽她的話，就會被灌下去一種奇怪的藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150917
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150917,
					"content": "喝下去之後我就會一直睡好幾天，記性也變得特別差。睡覺的時候…我還看見了好多東西，而且周圍的牆壁也一直在說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150918
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150918,
					"content": "我每天都好害怕…如果這次求救也沒成功的話，也許我真的會放棄了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150919
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150919,
					"content": "一切都結束了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150920
					]
				},
				{
					"id": 150150920,
					"content": "#我們就在妳旁邊，妮佩卡。誰再敢傷害妳，{NICKNAME}和希諾寧會馬上把他們全部打飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150921,
					"content": "嗯…嗯，對不起，我就是…忍不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150922
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150922,
					"content": "妳已經很勇敢了啊。而且還找了希諾寧幫忙，嘿嘿，妳可是找對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150923,
					"content": "希諾寧才不是那種會被眼淚分神的人，她聽人說話的時候很仔細的，什麼細節都不放過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150924,
					"content": "#我之所以能聽到那些「細節」，也是因為有{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150925
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150925,
					"content": "#沒有{F#妳}{M#你}們，妮佩卡就很難有機會發出求救的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150926
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150926,
					"content": "如果是我去和她說話，特拉佐莉肯定會馬上提起警惕，把妮佩卡再次關回屋子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150927
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150927,
					"content": "嘿嘿，那我們還滿重要的嘛！不過為什麼她敢這麼做啊？當初真正的妮赫佳活著的時候，部族裡肯定有不少人去照顧過她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150928,
					"content": "她就不怕突然有人發覺到妮佩卡並不是妮赫佳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150929,
					"content": "她早就開始使用「燃晶名刻」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150930
					]
				},
				{
					"id": 150150930,
					"content": "的確有這種可能性。特拉佐莉製造的「燃晶名刻」不僅可以搜集有關妮赫佳的過去，也可以清除人們記憶中和妮赫佳有關的過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150931
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150931,
					"content": "就像是塗鴉，想要在已經被塗鴉了的山崖上畫上新圖案，首先要做的就是想辦法把舊的圖案刨除掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150932
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150932,
					"content": "說不定我也是特拉佐莉的目標之一，所以她才會大大方方地把那枚「中樞名刻」交給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150933
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150933,
					"content": "嗚哇！那妳還拿！要是我的話，肯定把這個東西丟得遠遠的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150934,
					"content": "不冒點風險，怎麼能找到真相呢？如果不是親手拆解了那枚「中樞名刻」，我也不會意識到嬸嬸真正想要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150935
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150935,
					"content": "所以妳從一開始就懷疑她了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150936
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150936,
					"content": "沒有，那可是我嬸嬸，我怎麼可能一開始就把她當做壞人揣測？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150937
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150937,
					"content": "我最多…在心裡多保留一種「可能性」，和與之相對應的預案。誰知道，最壞的情況還是成真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150938
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150938,
					"content": "不過從結果來看，我們的確也拯救了一個正在受苦的孩子，也算是歪打正著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150939
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150939,
					"content": "好了好了，慶功會上的互相誇獎和總結環節到此為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150940
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150940,
					"content": "現在一切都結束了，妮佩卡也已經安全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150941
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150941,
					"content": "希諾寧姐姐…我接下來，該做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150942
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150942,
					"content": "當然是想做什麼就做什麼，現在沒有人會把妳關在屋子裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150943,
					"content": "可是，我…我不知道能做什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150944
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150944,
					"content": "我所知道的一切都和妮赫佳姐姐有關，她喜歡什麼樣的飯菜、喜歡什麼樣的花、怎麼說話、怎麼做事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150945
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150945,
					"content": "我、我不是她…但我…我也只能是她。我…我不知道…希諾寧姐姐，我不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150946
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150946,
					"content": "放心吧，妮佩卡，「燃晶名刻」已經停止運轉了，不會再有人強迫妳變成另外一個人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150947
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150947,
					"content": "可是…現在我除了自己的名字之外，什麼也不記得。我會不會什麼也想不起來…就這麼丟掉所有的過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150948
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150948,
					"content": "希諾寧姐姐，我…我好害怕，嗚…我該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150949
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150949,
					"content": "別哭，妮佩卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150950
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150950,
					"content": "喏，拿著這個。我從特拉佐莉的收藏裡拿了點礦石，敲打出了一個模子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150951
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150951,
					"content": "「燃晶名刻」！希諾寧，妳也會做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150952
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150952,
					"content": "當然不是。這枚名刻就只是一枚單純的漂亮石頭，拿著吧。上面刻著妳的名字「妮佩卡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150953
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150953,
					"content": "這是妳最初擁有的「祝福」，來自於一對全心愛著妳的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150954
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150954,
					"content": "它一直在保護著妳、陪伴著妳，無論是過去、現在還是未來，始終未曾遠離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150955
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150955,
					"content": "但是…我連爸爸媽媽的名字都不記得了，我…我什麼都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150956
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150956,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150957
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150957,
					"content": "我不會對妳誇下海口，說一切都必然會回歸原狀…我並不清楚妳究竟會面臨怎樣的未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150958
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150958,
					"content": "我只能向妳保證，無論未來的日子會如何，妳的「名字」都不會消逝，這是一名「鑄名師」送給妳的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150959
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150959,
					"content": "妮佩卡，妳會慢慢長大，就像樹苗總是會往上茁壯成長，鳥兒則總是會振翅高飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150960
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150960,
					"content": "「妮佩卡」這個名字是妳最初的起點，也是指引妳成長的路標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150961
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150961,
					"content": "記住妳的名字和妳經歷過的一切，妳一定會知道如何向著未來前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150962
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150962,
					"content": "我…會努力想的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150963
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150963,
					"content": "加油啊！妮佩卡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150964
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150964,
					"content": "我們會一直陪著妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150965
					]
				},
				{
					"id": 150150965,
					"content": "#謝謝{F#妳}{M#你}們，希諾寧姐姐、派蒙姐姐、{NICKNAME}{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150966
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150966,
					"content": "要是實在想不出來的話也沒什麼關係，放輕鬆、放輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150967
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150967,
					"content": "反正妳和我是同族的，大不了我去找族裡的老人幫妳查一查身世就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150968
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150968,
					"content": "在查到之前，妳就在我的工坊裡暫住著，最多就是多添一個碗的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150969,
						150150970
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150969,
					"content": "原來還有備案…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150971
					]
				},
				{
					"id": 150150971,
					"content": "唉呀，我又不知道這個方案能不能成功，我連具體找誰都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150972
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150972,
					"content": "與其指望這種純粹靠運氣的方案，還不如自己先踏實地努力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150973
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150973,
					"content": "好了好了，別糾結。我先去把特拉佐莉送去部族裡，妮佩卡，妳跟著我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150974
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150974,
					"content": "啊…好像晚飯還沒吃，妳喜歡吃什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150975
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150975,
					"content": "欸？我、我都可以，我不會挑食的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150976
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150976,
					"content": "那就好。走吧，好多事情要做，未來有得忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150977
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150977,
					"content": "噢…再多說一句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150978
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150978,
					"content": "生日快樂，妮佩卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150970,
					"content": "真的查得到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150971
					]
				},
				{
					"id": 150150911,
					"content": "妮佩卡很聰明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150912
					]
				},
				{
					"id": 150150907,
					"content": "希諾寧判斷也很迅速。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150908
					]
				}
			]
		},
		{
