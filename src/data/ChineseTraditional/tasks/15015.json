					}
				]
			},
			"dialogs": [
				{
					"id": 150150101,
					"content": "剛才我看見妮赫佳了，她和我說了話，她去哪了…去哪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150102
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150102,
					"content": "妮赫佳！妮赫佳！妳在哪？！回答媽媽！求求妳…求求妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150103
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150103,
					"content": "希諾寧…！妳剛才也看見了對吧？妳也看見我的小妮赫佳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150104
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150104,
					"content": "我摸到她的手了，也抱住她了…我是對的…我是對的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150105
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150105,
					"content": "那些灰色的影子只是一點小錯誤…只要再啟動一次…對，再啟動一次，妮赫佳一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150106
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150106,
					"content": "…嬸嬸，妳還沒察覺到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150107
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150107,
					"content": "察覺到…什麼？沒什麼錯，一切都沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150108
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150108,
					"content": "她只是在生我的氣，不願意理我…這孩子就喜歡鬧脾氣，我…我能理解，我能接受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150109
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150109,
					"content": "特拉佐莉！夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150110
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150110,
					"content": "妳用「燃晶名刻」召出來的，根本不是真正的妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150111
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150111,
					"content": "妳搜集了無數人有關妮赫佳的「回憶」，但是卻漏了一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150112,
					"content": "那些被搜集的記憶中，除了真實的「回憶」外還有著無數的「情緒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150113
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150113,
					"content": "妳難道沒有意識到…當人們探望病重中的妮赫佳時，會產生什麼「情緒」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150114
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150114,
					"content": "當人們握住一個臨終孩子的手，感受著她無力的呼吸、絕望的眼神…還有逐漸降低的體溫時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150115
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150115,
					"content": "除了痛苦和悲傷，他們還能感受到什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150116
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150116,
					"content": "我…把這些情緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150117
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150117,
					"content": "這些「情緒」全都被妳吸納進了「燃晶名刻」中，作為實際的「過去」固化了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150118
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150118,
					"content": "那些灰色的人影是那些「過去」的「投射」，她們只會重複著妮赫佳臨終前的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150119
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150119,
					"content": "而真正的妮赫佳想要說的話，都被這些被扭曲的悲苦思緒所掩蓋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150120
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150120,
					"content": "我…我不想這樣…我只是想要記住妮赫佳，我只是想…只想再見她一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150121
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150121,
					"content": "…妮赫佳，一直都陪在妳身邊，嬸嬸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150122
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150122,
					"content": "那枚被妳稱作「毫無作用」的「古名」，早就記錄了一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150123
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150123,
					"content": "妳用盡了一切方法、拋下了一切，試圖拯救自己的女兒…這是不可動搖的事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150124
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150124,
					"content": "妳難道忘了自己「古名」的真義了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150125
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150125,
					"content": "我的「古名」是…「翁{RUBY#[D]親}杜{RUBY#[D]情}古」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150126
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150126,
					"content": "這枚「古名」，早就將妳和妮赫佳之間不可動搖的親情記錄在內，但妳卻對此視而不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150127
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150127,
					"content": "「名字是過去對未來的祝福。」這是妳告訴我的，嬸嬸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150128
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150128,
					"content": "是妳為妮赫佳取了名，是妳為妮赫佳送出了最初的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150129
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150129,
					"content": "現在，卻親手將妮赫佳這枚名字扭曲成了囚牢，囚禁著那個無辜的孩子…也囚禁了妳自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150130
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150130,
					"content": "…妮赫佳是我生命的全部。失去了她，我根本看不見未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150131
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150131,
					"content": "至於祝福…哈哈…從妮赫佳離開後，我就再也感覺不到「祝福」了。我只會每天夢見那孩子抓著我的手，說自己很痛，求我抱她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150132
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150132,
					"content": "我卻什麼也看不見，也抓不住妮赫佳的手，只能不斷地喊她的名字，直到從夢裡驚醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150133
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150133,
					"content": "每一天，每一天…我都痛恨我自己，也痛恨「古名」。妮赫佳…或許也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150134
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150134,
					"content": "妳覺得…妮赫佳也會恨妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150135
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150136
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150136,
					"content": "嬸嬸，妳還記得妮赫佳對妳說的最後一句話嗎？還記得…妮赫佳真正的遺言是什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150137
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150137,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150138
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150138,
					"content": "妳之所以感覺不到「祝福」，是因為妳已經遺忘了真正的「過去」…嬸嬸，妳只是沉溺在自己所想像出的回憶中，不願自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150139
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150139,
					"content": "失去「過去」的「名字」，只是一根無根的枯木，除了衰朽外，再無未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150140
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150140,
					"content": "結束了。嬸嬸，一切都結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150141
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150141,
					"content": "唉呀，慢一點，不然妳還是躺著吧？呃…不對不對，躺在這裡也不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150142,
					"content": "希諾寧！妮赫佳…妮佩卡已經可以站起來了，我們過來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150143,
						150150144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150143,
					"content": "我來扶妳吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				},
				{
					"id": 150150145,
					"content": "#謝謝{F#妳}{M#你}們，派蒙姐姐、{NICKNAME}{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150146
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150146,
					"content": "我真的沒事，剛才妮赫佳姐姐幫了我，已經沒那麼不舒服了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150147
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150147,
					"content": "那就好。如果妳真的變成了妮赫佳，那這個故事就真的要變成《勇敢的特奎》了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150148
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150148,
					"content": "這裡不是聊天的地方，走吧，我們先出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150149
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150149,
					"content": "那…特拉佐莉女士怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150150,
					"content": "放心吧，她已經做不出出格的舉動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150151
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150151,
					"content": "#一切都結束了，{F#妳}{M#你}們離開這座工坊。出去後，希諾寧拜託{F#妳}{M#你}們先去陪妮佩卡，她還有事要和特拉佐莉單獨談談…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150150144,
					"content": "我可以背妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				}
			]
		},
