			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希諾寧"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1542.261,
							162.018,
							7891.087
						],
						"pointId": 350400220
