					"希諾寧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150151101,
					"content": "#噢，{F#妳}{M#你}們來了啊。事情都處理完了，呼啊…我正打算去睡覺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151102,
						150151107,
						150151112,
						150151116
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151102,
					"content": "關於特拉佐莉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151103
					]
				},
				{
					"id": 150151103,
					"content": "嬸嬸啊，部族裡還在商量怎麼處罰她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151104
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151104,
					"content": "畢竟用古名技術來犯罪的人，古往今來也沒多少…帕加爾要頭痛一陣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151105
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151105,
					"content": "至於她的工坊，部族裡已經派人去看著了，過幾天應該就會徹底封閉，剩餘那些未成型的「燃晶名刻」應該也會徹底銷毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151106
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151106,
					"content": "還好她的「古名」沒出問題，不然亂子可就大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151107,
					"content": "關於「燃晶名刻」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151108
					]
				},
				{
					"id": 150151108,
					"content": "說到這個，倒是有個好消息。「燃晶名刻」所汲取的記憶是可恢復的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151109
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151109,
					"content": "在「燃晶名刻」徹底停運後，那些回憶應該就會順著原路物歸原主了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151110
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151110,
					"content": "嬸嬸想要妮赫佳回來，所以讓整個部族的人都忘記了妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151111
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151111,
					"content": "現在妮赫佳真的離開了，大家卻又即將想起她…真是亂七八糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151112,
					"content": "關於妮佩卡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151113
					]
				},
				{
					"id": 150151113,
					"content": "妮佩卡啊，現在正在我的工坊裡幫忙。我也聯絡了同族的人，準備查一查這孩子的身世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151114
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151114,
					"content": "現在族裡還沒回信給我，所以我就先照顧著她，順便教她點手藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151115
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151115,
					"content": "妮佩卡的學習速度雖然慢了點…但態度還不錯，等她再成長一些，說不定也能成為一名鑄名師哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150151116,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151117
					]
				},
				{
					"id": 150151117,
					"content": "#嗯，再見。這件事情有什麼新進展了，我會告訴{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				}
			]
		},
