						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150150701,
					"content": "#居然來得這麼快，真佩服{F#妳}{M#你}們的腳力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150702
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150702,
					"content": "妮赫佳在上面！妳到底想對她做什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150703,
					"content": "#我沒有對{F#妳}{M#你}們撒謊。從頭到尾，我都只是在救我的女兒妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150704
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150704,
					"content": "雖然她現在還不是我的孩子…但等一切都結束，她就會真正成為妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150705
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150705,
					"content": "還、還不是妮赫佳？這到底是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150706,
						150150707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150706,
					"content": "注入記憶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				},
				{
					"id": 150150708,
					"content": "#{F#妳}{M#你}已經想通了？沒錯，我想要用「記憶」讓妮赫佳醒過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150709
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150709,
					"content": "那孩子在夜神之國待得太久了…她怕黑，也怕冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150710
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150710,
					"content": "是我讓妮赫佳一個人待在那裡的，我必須把她帶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150711
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150711,
					"content": "#別怕，妮赫佳，媽媽什麼都沒有忘記，媽媽一直記得{F#妳}{M#你}的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150712,
						150150713
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150712,
					"content": "夜神之國？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150714,
					"content": "恐怕…的確如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150715
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150715,
					"content": "那…那上面躺著的那個是誰啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150716,
					"content": "她也是我同族的孩子。父母在之前那次深淵襲擊中去世了…說來也巧，她的生日，和我的小妮赫佳是同一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150717
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150717,
					"content": "我收養了她，照顧了好久好久。本來…我以為這能讓我好過一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150718
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150718,
					"content": "當這孩子第一次願意叫我媽媽的時候，我先是很開心，然後…突然害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150719
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150719,
					"content": "她是我的孩子？我的孩子…她的名字是妮赫佳，只能是妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150720
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150720,
					"content": "我怎麼能開心？我…我的小妮赫佳，她還在等著我…等著我帶她回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150721
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150721,
					"content": "我說過，只要能讓妮赫佳回來，我即使獻出一切，也在所不惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150722
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150722,
					"content": "現在，是獻出一切的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150723
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150723,
					"content": "至於我這枚沒用的「古名」，哼…也是時候讓它派上點用場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150724
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150724,
					"content": "既然妳不願意幫我，那就成為妮赫佳「古名」的燃料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150725
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150725,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150726
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150726,
					"content": "希諾寧，妳到現在還沒有採取行動，是在觀察這周圍的刻錄圖嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150727
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150727,
					"content": "沒用的，我已經佈置好了所有的「燃晶名刻」，刻錄圖早就開始運轉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150728
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150728,
					"content": "多虧了妳為我提供的想法，這枚「中樞名刻」會真正成為妮赫佳的「古名」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150729
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150729,
					"content": "等妮赫佳回來後，我會請妳參加她的生日宴會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150730,
						150150731
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150730,
					"content": "放了那孩子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150732,
					"content": "#{F#妳}{M#你}要…{F#妳}{M#你}要硬闖上去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150733,
						150150734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150733,
					"content": "妮赫佳已經死了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150735,
					"content": "…這幅刻錄圖有缺陷，薄弱點即將運轉過來，聽我口令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150736
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150736,
					"content": "妮赫佳…別怕，別怕…媽媽在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150737
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150737,
					"content": "三。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150738
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150738,
					"content": "媽媽會一直陪著妳，絕不會忘記妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150739
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150739,
					"content": "二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150740
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150740,
					"content": "妮赫佳…快醒過來吧，求求妳，快點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150741
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150741,
					"content": "一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150150734,
					"content": "不能讓她傷害無辜的孩子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150731,
					"content": "派蒙，到我身後去！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150713,
					"content": "難道…妮赫佳已經去世了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150707,
					"content": "遺忘過去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				}
			]
		},
		{
			"id": 1501509,
			"completionStepIds": [
				1501509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
