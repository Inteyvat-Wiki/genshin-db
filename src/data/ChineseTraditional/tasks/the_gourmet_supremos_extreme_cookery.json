			"dialogs": [
				{
					"id": 220300201,
					"content": "就是這裡了。兩處魔物分別在左右兩邊紮了營。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300202,
					"content": "在下悄悄去偵察了一番，左邊營地的魔物雖然弱小，但數量眾多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300203,
					"content": "右邊營地的魔物雖然數量略少，但卻格外強壯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300204,
					"content": "有勞閣下清剿一處魔物，另一處交給在下即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				}
			]
		},
