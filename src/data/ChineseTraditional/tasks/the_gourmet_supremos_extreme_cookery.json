			"trigger": {
				"objectNames": [
					"龜井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "閣下，又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300102,
					"content": "恕在下唐突，今天有一事想請閣下幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300103,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "在受旭東閣下雇傭後，我一直與他們同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300107,
					"content": "為了報答旭東閣下收留我之恩，我想做些謝禮贈予他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300108,
					"content": "但旭東閣下比起武藝，更喜歡美食，所以我想要親手製作些食品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300109,
					"content": "在下本來已經看好了兩處食材的所在地，打算等這些食材成熟後再去取用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300110,
					"content": "可是，卻有兩股魔物分別佔據了那兩處食材所在地，而且還都已經把食材取下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300111,
					"content": "我所要製作的那道菜，最重要的就是食材新鮮，我本來打算先取一處，再去另外一處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300112,
					"content": "但現在兩邊魔物都已經取下了食材，想要烹製那道菜，在下必須快些把那兩樣食材都拿到手才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300113,
					"content": "但在下…分身乏術，就算能對付一處的魔物，另一處的食材想必也早已被魔物糟蹋殆盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300114,
					"content": "所以，我想請閣下與我共同出手，一起擊倒那些魔物，取得食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "多謝閣下，在下感激不盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300119,
					"content": "唔…在這裡說也無用，閣下，請與我一同去前面一些的地方看看，然後我們再做商議吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300117,
					"content": "做完了食物之後能分我點嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "那是自然，閣下當取第一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220300104,
					"content": "不用這麼客氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "是在下有求於閣下，這種禮節也是應當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "龜井宗久"
				}
			]
		},
		{
