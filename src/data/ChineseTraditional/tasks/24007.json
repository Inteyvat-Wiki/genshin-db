			"dialogs": [
				{
					"id": 240070101,
					"content": "洛薇？妳找到什麼好東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070102,
					"content": "沒有呀，這裡什麼也沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070103,
					"content": "你們在做什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#{M#大哥哥}{F#大姐姐}，我們正在「尋寶」唷，嘿嘿…{F#妳}{M#你}要不要和我們一起呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070105,
					"content": "尋寶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "別聽韋呂吹牛啦，其實我們就是想在這裡撈一些零件上來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070107,
					"content": "這些零件就是寶物…咦？這裡應該有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070114,
					"content": "唔…看來這裡是找不到了，我換個地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070115,
					"content": "好啊！我們再往前面走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070116,
					"content": "我和你們一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "#嗚哇，{M#大哥哥}{F#大姐姐}說話的語氣好像哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070119,
					"content": "那我們再往前走走，我記得這附近的水裡有很多零件的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070117,
					"content": "千萬不要到處亂跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "怎麼沒看見奧雷勒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "哥哥去城裡找德勒呂叔叔啦，他說有些問題想要請教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070110,
					"content": "我們呢，就只能乖乖聽話不亂跑…一直在這裡「尋寶」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240070111,
					"content": "#嘿嘿…{M#大哥哥}{F#大姐姐}要不要和我們一起呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
