			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉米雅",
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "歡迎大家加入「伴爪同行」動物救助會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#是{NICKNAME}啊，{F#妳}{M#你}好{F#妳}{M#你}好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680105,
					"content": "我們商會正在辦活動，有沒有興趣來看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680106,
					"content": "是什麼樣的活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "簡單來說就是加入飛雲商會資助的「伴爪同行」動物救助會，和我們一起認養被拋棄或瀕危的動物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680108,
					"content": "飛雲商會一直在和世界各國的志工合作，藉由社會認養的方式來解決遍及各地的流浪動物問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680109,
					"content": "最近這幾年救助會越做越大，我們開始考慮和拉米雅女士這樣的學者合作，接觸瀕危動物保護的領域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680110,
					"content": "可以把研究成果用在這種地方我也很開心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680111,
					"content": "哈哈，能和您合作對我們來說也是件樂事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680112,
					"content": "多虧我們的志工和拉米雅女士這樣有遠見的研究人員，才讓很多流浪動物都有了一個家，讓瀕危的動物得到了保護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680113,
					"content": "除了璃月這裡，還有蒙德、須彌…只要是飛雲商會活躍的國家，到處都有「伴爪同行」的動物飼養點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680114,
					"content": "為了感謝志工們，也為了讓大家都知道「伴爪同行」有很多很多夥伴，我們才舉辦了這個活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680115,
					"content": "#{F#妳}{M#你}可以前往被認養動物棲息的區域找一找，去看看牠們實際的生活狀態，順便領取一份小禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680116,
					"content": "#禮物是由救助會的工作人員和其他認養人共同準備的，當然在領取禮物之前，{F#妳}{M#你}也要準備一點東西給其他認養人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680117,
					"content": "屆時會有專人回收禮物再轉交給原本的認養人。禮物不需要多貴重，只要能傳遞心意就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680118,
					"content": "#怎麼樣，{NICKNAME}，有興趣參加嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680119,
					"content": "可以看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "#太好了，有{F#妳}{M#你}這樣的社會名人參與，我們也很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680122,
					"content": "#{F#妳}{M#你}準備好了的話，現在就可以把禮物交給我，由我們的工作人員在活動結束後分送給認養人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680123,
					"content": "對了，以我和認養人打交道的經驗來看，有些認養人對地區特產有興趣，有些比較喜歡美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680120,
					"content": "我想參加。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
