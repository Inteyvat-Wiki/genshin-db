			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉米雅",
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "好，這些食物我們會用盒子裝好送出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680402,
					"content": "每一隻動物都有自己獨特的習性，我們並不會把動物關在籠子裡，而是會僱用專業的飼養人員追蹤、監控牠們的身體狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680403,
					"content": "#要找到牠們不是件容易的事情，{F#妳}{M#你}會需要拉米雅女士研製的特殊器材「銘隨流鏡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680404,
					"content": "這方面我沒有她懂，還是請她解釋吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680405,
					"content": "嗯，還是讓我來說明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680406,
					"content": "#「銘隨流鏡」這種裝置的底層技術和虛空有一定關係，執行邏輯的細節可能有點複雜，總之{F#妳}{M#你}放心，是實測過確定安全的裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680407,
					"content": "因為我們已經在動物身上綁上了微型發信裝置，所以使用的時候只要讀取裝置訊號，鏡子裡就會顯露出動物視角中的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680408,
					"content": "儘管這個裝置還有需要改良的地方，但這些影像暫時夠我們定位活躍中的動物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680409,
					"content": "#大體來說就是這樣，如果{F#妳}{M#你}準備好了，歡迎加入「伴爪同行」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680410,
					"content": "#用「銘隨流鏡」找一找我們的動物朋友，認養人的禮物和小動物們都在等著和{F#妳}{M#你}打招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				}
			]
		},
