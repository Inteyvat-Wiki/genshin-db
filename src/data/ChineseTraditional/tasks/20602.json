			"dialogs": [
				{
					"id": 206020501,
					"content": "#{F#妳}{M#你}回來了，情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206020502,
					"content": "魔物似乎還在活躍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "居然還有魔物在周圍活躍嗎？看來那場風暴的影響還遠沒有消散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206020504,
					"content": "哈哈哈，還有機會！還有機會讓人們感受到冒險家協會的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206020505,
					"content": "西風騎士團依舊在專注於防守城內和蒙德城附近，看來野外的這些魔物，還是得我們冒險家協會出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206020506,
					"content": "#我知道了，謝謝{F#妳}{M#你}幫忙調查，我會重新考慮發佈的委託，這些東西請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
