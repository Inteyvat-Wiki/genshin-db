			"dialogs": [
				{
					"id": 731961701,
					"content": "「我就不多作介紹了，反正桑歌瑪哈巴依老爺的名字你們一定都聽過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961702,
					"content": "「總之最近新到一批毛毯，不會飛，不過比蘇萊卡家的好，大家欲購從速哦，購買方法還是老樣子，嘿嘿。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961703,
					"content": "「喂！不要太過分啊多莉！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
