				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "本司經營海外貿易服務，與「南十字船隊」等有力船隊皆有長期合作，為您的生意保駕護航。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961202,
					"content": "今夏增開四條航線，涉及絲綢、香料、礦石等大宗商品，新購商船載貨量大，誠邀各路商主加盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961203,
					"content": "如需承包整條航線，請洽老闆法爾扎妮面談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
