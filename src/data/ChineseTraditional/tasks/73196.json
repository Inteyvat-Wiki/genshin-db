				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "本店誠收「卡茲尼的失落金人」，價格可與店主當面詳談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960802,
					"content": "如有相關情報也請至梅娜卡里商鋪聯繫收藏家哈立德，有重金酬謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
