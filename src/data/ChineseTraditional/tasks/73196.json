			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "「說到大巴扎，絕對不能錯過的地方就是祖拜爾劇場了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961502,
					"content": "「而祖拜爾劇場當中，最不能錯過的就是妮露小姐的舞蹈了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961503,
					"content": "「來須彌沒有看過妮露小姐的花神之舞的話，可以說算是白來了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
