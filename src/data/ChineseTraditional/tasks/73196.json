			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "小店經營各類日用雜貨，每一件商品都由店主本人親自把關，品質包您滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960702,
					"content": "「老爹，能再借我一筆錢嗎？我都打聽好了，棗椰的價格最近會大漲，這次一定能狠狠賺上一筆。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
