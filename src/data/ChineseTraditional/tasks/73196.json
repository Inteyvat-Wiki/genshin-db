			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "本行即將在須彌設置辦事處，諸位未來客戶敬請期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960402,
					"content": "如需辦理業務，請聯繫維克多轉璃月分行代辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960403,
					"content": "如有貸款事務，請與您遇到的債務處理人詳談！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
