			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "艾尼洗染坊，手法細膩，技藝精湛，為您的衣物增添新的色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961102,
					"content": "「老闆，我上個月送來洗染的衣料能取到了嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961103,
					"content": "「實在抱歉！昨天我老婆生孩子，沒時間做工。請你明天再來吧，我保證按時交貨。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961104,
					"content": "「都已經過去三個月了，請您把衣料還給我吧，我不要洗染了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961105,
					"content": "「不好意思！你的衣料我本來已經染好了，結果晾曬時不知道被哪個賊人偷走了，你若要取，就去找偷衣料的賊人吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
