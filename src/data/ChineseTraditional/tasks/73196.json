			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "品質優秀，價格實惠。朱特香料店，您身邊的香料店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960602,
					"content": "現在購買還有禮品贈送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
