			"dialogs": [
				{
					"id": 731960901,
					"content": "正宗沙漠燒烤，赤王秘傳醬料配方，沙海原產香辛料烤製。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731960902,
					"content": "提供大家都能吃到喝到的好東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
