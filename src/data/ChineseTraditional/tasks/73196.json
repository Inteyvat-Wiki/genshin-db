			},
			"dialogs": [
				{
					"id": 731961401,
					"content": "關於普斯帕咖啡館的所有權問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961402,
					"content": "經查原店主於三年前在沙漠考察中失蹤，現咖啡館依照規定應收歸上級部門伐護末那學院管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961403,
					"content": "裁判結果：因主張人撤訴，無限期中止執行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
