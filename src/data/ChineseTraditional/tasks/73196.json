				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "為了追求人生的幸福，離開家園，去開拓遠方吧。現在就加入「冒險塚協會」，首月會費僅需五摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961602,
					"content": "真正的知識只有在實行中才能獲得。即使在遠行中離開世間，也比在苟活中蹉跎一生高貴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961603,
					"content": "「大家看清楚，這個不是冒險家協會。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961604,
					"content": "「什麼！我都交了一年的會費了，我的錢還要得回來嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
