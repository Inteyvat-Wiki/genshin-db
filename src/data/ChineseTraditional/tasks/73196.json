			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "「過去我曾擁有取之不盡的財富，但無論怎樣揮霍也無法讓我的內心得到平靜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961002,
					"content": "「經過這次旅行，現在我的錢袋裡連一個摩拉都沒有，可是我卻覺得寧靜無比。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961003,
					"content": "「若想聽聽我的故事，就來蔬菜攤找我吧。當然，能買點蔬菜的話就更好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
