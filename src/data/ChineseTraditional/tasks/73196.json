			"dialogs": [
				{
					"id": 731961301,
					"content": "根據消費者投訴，艾尼洗染坊涉嫌盜竊衣料，現已查封。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731961302,
					"content": "經查，該染坊現已空空如也，別無他物。投訴人所損失的財物正在努力追繳當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
