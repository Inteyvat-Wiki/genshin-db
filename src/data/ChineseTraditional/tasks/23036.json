				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "凱萬先生，你就再用新型的魚餌試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 230360102,
					"content": "我都試了多少次了，完全和之前一樣嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360103,
					"content": "咦？你們兩個怎麼又在一起釣魚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230360104,
					"content": "旅行者，又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360105,
					"content": "#兩位，{F#妳}{M#你}們好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 230360106,
					"content": "你找到釣不到魚的原因了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "哈哈，完全沒有。我和那位學者先生嘗試了改進魚竿、改進魚餌，改進手法各種方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360109,
					"content": "還換了不知道多少個水域，多少個角度…甚至還讓我在一個全都是魚的魚池裡下竿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360110,
					"content": "但我無論如何，都只能釣起來那些不是魚的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360111,
					"content": "放心啦，凱萬先生，那位學者不也承諾會繼續研究下去嗎？他一定會幫你找到原因的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 230360112,
					"content": "你看，他都為你設計了新型魚餌，還要我一直陪在你身邊，記錄你釣魚的各種細節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "荷貝特"
				},
				{
					"id": 230360113,
					"content": "希望他真的能找到吧…但在那之前，我還是按照自己的方法來釣魚好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360114,
					"content": "#旅行者，如果{F#妳}{M#你}有空的話，就再幫我去找點魚餌素材吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱萬"
				},
				{
					"id": 230360107,
					"content": "去向學者請教後有收穫了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
