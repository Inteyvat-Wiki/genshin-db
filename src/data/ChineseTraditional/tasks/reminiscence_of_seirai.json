			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古谷升"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "真是頭疼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630202,
					"content": "關於這張圖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "這張圖上的地形，看起來像是清籟島的某處呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630204,
					"content": "你是怎麼看出來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "畢竟協會也發佈過一些和清籟島有關的探索委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630206,
					"content": "那些接下了委託的冒險家，回來協會報告的時候，也帶回來了一些和清籟島有關的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630207,
					"content": "但因為人手問題，我們暫時也沒辦法組織大規模的探索，只能每隔一段時間派遣幾位冒險家過去探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630208,
					"content": "#所以，我手裡關於清籟島的情報也有限，沒辦法再幫{F#妳}{M#你}繼續解讀這張圖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630209,
					"content": "不過，我倒是知道城裡有一位和清籟島有關的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630210,
					"content": "他叫太田太郎，據他說…他的祖先曾經居住在清籟島，後來因為各種原因才移居到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630211,
					"content": "前段時間，他還來過協會，說是想雇傭幾位冒險家，陪他回去清籟島看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 721630212,
					"content": "#{F#妳}{M#你}可以拿著這張圖去找太田太郎先生問問，說不定他會知道些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷升"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216302",
							"2"
						],
						"stepId": 7216302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
