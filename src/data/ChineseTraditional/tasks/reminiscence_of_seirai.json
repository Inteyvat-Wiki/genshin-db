			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"太田太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "唉，什麼時候才能找到人陪我回去看看呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630302,
					"content": "關於這張圖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "#{F#妳}{M#你}是…冒險家協會的冒險家嗎？他們終於抽出人手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630304,
					"content": "我只是個路過的旅行者啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "#好吧…{F#妳}{M#你}想給我看什麼圖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630306,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630307,
					"content": "這、這！難道這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630308,
					"content": "你看出什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "這不是清籟島嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630311,
					"content": "是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "哈哈哈，真是清籟島嗎？我也是猜的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630314,
					"content": "雖然我祖上曾經住在清籟島上，但那已經是很久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630315,
					"content": "到了我這一代，對清籟島就基本上都沒什麼印象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630316,
					"content": "家裡和清籟島有關的東西…也只有三張清籟島的景致畫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630317,
					"content": "那你為什麼想回去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "這個嘛…怎麼說呢，那裡畢竟也算是我的「故鄉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630319,
					"content": "我總有一種…無論如何都得去看看的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630320,
					"content": "不過現在我的生意忙得不行，一時間抽不開身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630321,
					"content": "而且…我也找不到能護送我去清籟島的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630322,
					"content": "所以，我就退而求其次，在冒險家協會那邊掛了一個委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630323,
					"content": "希望有冒險家可以代我去清籟島上，找到那三張畫裡的地點，用「留影機」記錄幾張畫片回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630324,
					"content": "但是到現在也沒有冒險家接下這個委託，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630325,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "#是、是嗎？！{F#妳}{M#你}願意幫忙的話那就太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630328,
					"content": "#報酬的事不用擔心，我一定為{F#妳}{M#你}準備齊全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630329,
					"content": "#那就拜託{F#妳}{M#你}了。算上{F#妳}{M#你}拿過來的那一張圖，總共四張圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630330,
					"content": "#請{F#妳}{M#你}去清籟島上，在這四個地點，分別記錄一張畫片回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630326,
					"content": "我可以幫你跑這一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "你說得很對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "這是你家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216307",
							"2"
						],
						"stepId": 7216307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"太田太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "#{F#妳}{M#你}回來了，怎麼樣？{F#妳}{M#你}記錄到畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630402,
					"content": "已經記錄到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "太好了，我來看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630404,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630405,
					"content": "哈哈哈，完全看不出來是什麼地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630406,
					"content": "不過，那三張畫上的景致，還真是變了不少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630407,
					"content": "不知道那位藤原俊子小姐…能不能認出這些地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630408,
					"content": "不過…哈哈，我想她應該也很難能認出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630409,
					"content": "她也是從清籟島來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "準確地說，是和我一樣，祖上曾經在清籟島上居住過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630411,
					"content": "哎呀，其實稻妻城裡還有很多祖上曾經住在清籟島上的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630412,
					"content": "你們為什麼從清籟島搬走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "我記不太清楚了…畢竟是好久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630414,
					"content": "好像是因為雷暴太猛了，還是為了預防偷渡和走私什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630415,
					"content": "總之，在幕府的統一安排下，清籟島上的人基本上都遷到了鳴神島上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630416,
					"content": "#哦，先不說閒話了，這些東西給{F#妳}{M#你}，收下吧，謝謝{F#妳}{M#你}幫我跑這一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630417,
					"content": "唉，我到底什麼時候才能親自去一趟清籟島呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630418,
					"content": "還是先忙完手上這一單生意吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				}
			]
