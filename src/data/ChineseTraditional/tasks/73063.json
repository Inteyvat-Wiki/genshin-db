	"talks": [
		{
			"id": 7306305,
			"completionStepIds": [
				7306305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306303",
							"2"
						],
						"stepId": 7306303,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306305",
							"2"
						],
						"stepId": 7306305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭迦魯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730630501,
					"content": "#金色的那菈和白色的飛飛，{F#妳}{M#你}們來啦！我是蘭迦魯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630502
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630502,
					"content": "#草木和蘑菇告訴我{F#妳}{M#你}們會來，我已經等了很久啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630503
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630503,
					"content": "咦…？你認識我們嗎…？你有什麼事情找我們呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630504,
					"content": "有事情！有很大很大的事情喔！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630505
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630505,
					"content": "哇，別激動啦，跟我們慢慢說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630506,
					"content": "嗯，「無留陀」在長大，越長越大，森林都不敢說話，不敢呼吸…因為「無留陀」在，「無留陀」會吃掉他們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630507
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630507,
					"content": "為了阻止「無留陀」，蘭納迦在忙「蘭赫瑪」的儀式。但是「蘭赫瑪」…還缺少「缽參花」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630508
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630508,
					"content": "這樣啊…可是，「缽參花」從哪裡找呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630509,
						730630511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630509,
					"content": "派蒙這次居然沒唸錯名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630510
					]
				},
				{
					"id": 730630510,
					"content": "哼哼，缽！參！花！厲害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630512,
					"content": "「缽參花」在生著蘑菇的地方，很多很多個月亮升起和落下之前，那裡曾是那菈的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630513
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630513,
					"content": "但是後來…濕濕的土掩埋了那菈的夢，他們的記憶生出了新的草木，一代又一代地乾枯又復生…我們要去的，就是這樣的地方呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630514
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630514,
					"content": "唔…雖然聽不太明白，但總覺得很可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630515,
					"content": "不可怕，不可怕。那菈害怕的地方，草木喜歡。所以那裡很多草木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630516
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630516,
					"content": "那裡有那菈們和蘭那羅一起留下來的符文，為了不忘記，為了忘記後可以查看。去那裡，可以找到「缽參花」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630517
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630517,
					"content": "唔…那我們就一起去他說的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630518,
					"content": "對了、對了！還有，「苦舍桓」呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630519
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630519,
					"content": "有「苦舍桓」的話，蘭那羅就有力氣，有力氣，就能幫大家開路！蘭迦魯可以打碎石塊！哈！哈！轟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630520
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630520,
					"content": "蘭迦魯個子小小，力氣大大呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730630521,
					"content": "嘿嘿，沒錯，力氣大大！嗯…不過要是有綠色藤蔓的石塊才行啦，一整個的話…沒有裂隙，就沒有力氣打破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630522,
						730630525
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630522,
					"content": "「苦舍桓」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630523
					]
				},
				{
					"id": 730630523,
					"content": "「苦舍桓」是記憶和夢的容器，胖胖的、苦苦的，裡面滿是力量。是開花的植物結出的果，也是新的種子，有全新的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630524
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630524,
					"content": "#這個，給你。請好好珍惜。蘭那羅只會把它託付給重要的對方，所以…唔，{F#妳}{M#你}們不要吃掉啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630527,
					"content": "唔…月亮來了又去，已經不剩下很多了…會走的蕈類一直在裡面，越來越多…很不好，我們要盡快才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630525,
					"content": "「缽參花」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630526
					]
				},
				{
					"id": 730630526,
					"content": "「缽參花」是蘭那羅的好夥伴，是為了成就「蘭赫瑪」而生的花朵，是靈藥的源泉。唔…只有犧牲汁液，才能提煉「蘭赫瑪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730630511,
					"content": "應該很不好找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630512
					]
				}
			]
		},
		{
