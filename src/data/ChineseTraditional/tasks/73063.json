						730632306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632304,
					"content": "這裡好平靜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632305
					]
				},
				{
					"id": 730632305,
					"content": "是呀，安靜到讓我好不安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632308,
					"content": "「呿波境」很脆弱了…蕈類走進來，吃掉了許多養分，但「缽參花」沒有受傷害…還沒有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632309
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632309,
					"content": "我們去解開他的封印，然後再和他說話吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632310
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632310,
					"content": "嗯，我們解開封印，你去和他說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
