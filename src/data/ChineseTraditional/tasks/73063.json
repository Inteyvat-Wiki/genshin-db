					"content": "沒有呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730631606,
					"content": "嗯，這是因為飛飛很笨。",
