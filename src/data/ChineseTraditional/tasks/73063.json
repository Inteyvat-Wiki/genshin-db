					"content": "喔……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730631604,
					"content": "白飛飛聽懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631605
					],
					"speakerTitle": "蘭迦魯"
				},
				{
