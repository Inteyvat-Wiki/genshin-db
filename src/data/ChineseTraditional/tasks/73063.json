			"dialogs": [
				{
					"id": 730632901,
					"content": "蘭迦魯，來和「缽參花」說話，就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632902,
					"content": "噓——！噓——！小點聲啦，不要吵到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632903
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632903,
					"content": "蘭迦魯和「缽參花」私語了一會…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730632904
					]
				},
				{
					"id": 730632904,
					"content": "「缽參花」被我們從夢中吵醒，很生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632905
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632905,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632906,
					"content": "但是，如果是為了「蘭赫瑪」，就勉強原諒我們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632907
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632907,
					"content": "#「缽參花」，「缽參花」，為了蘭赫瑪，為了「無郁夷摩」的復生…請{F#妳}{M#你}與我們一起吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632908
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632908,
					"content": "咦…？哦…欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632909,
						730632911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632909,
					"content": "派蒙在幹什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632910
					]
				},
				{
					"id": 730632910,
					"content": "我在聽「缽參花」回應了他什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632913,
					"content": "太好了，「缽參花」同意與我們一道冒險啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632914
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632914,
					"content": "好耶！「缽參花」取得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632915,
					"content": "唔，接下來…「缽參花」說，小心保護腦袋喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632916
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632916,
					"content": "…什麼意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632917,
					"content": "小心保護腦袋和根系，不然等到水來了，會撞壞的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632918
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632918,
					"content": "欸…？等等…什麼聲音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730632919,
					"content": "小心！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730632911,
					"content": "能聽懂他們說什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632912
					]
				},
				{
					"id": 730632912,
					"content": "…聽都聽不見呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "派蒙"
				}
