				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860301,
					"content": "綾華、千里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860302,
					"content": "#旅行者、派蒙，好久不見，原來{F#妳}{M#你}們最近也在稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860303
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860303,
					"content": "嗯，其實我們決定參加「演武傳心劍道大賽」了，聽說妳們正在離島做準備，所以就過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860304,
					"content": "#這真是好巧，我們才聊完「代神使」的工作，剛說到旅行者會不會對「演武傳心」感興趣呢，{F#妳}{M#你}就出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860305
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860305,
					"content": "「代神使」？那是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860306,
					"content": "#欸，{F#妳}{M#你}們還不知道？難道說，{F#妳}{M#你}們不是因為收到綾華小姐的信才趕回稻妻的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860307
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860307,
					"content": "咦，信？什麼信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860308,
					"content": "#啊，沒什麼，{F#妳}{M#你}們別在意。派蒙，妳剛剛是問「代神使」對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860309
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860309,
					"content": "對，那是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860310,
					"content": "「代神使」是「演武傳心」中一項很特殊的職責。說起這個，就不得不提起這一賽事的由來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860311,
					"content": "「演武傳心」起源於稻妻古代傳說，據說在很久以前，劍術冠絕稻妻的武人，將獲得面見將軍大人，與之切磋劍術的殊榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860312
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860312,
					"content": "只不過，將軍大人的實力實在高出人類太多，如果直接與武人較量，這場對決恐怕瞬間就結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860313,
					"content": "因此，將軍大人派出自己的眷屬作為接引武人的使者，並在切磋中為武人提供援護，讓兩人一同與自己對戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860314,
					"content": "由於將軍大人選擇以演武的形式，將自身的技藝與守護稻妻的意志傳達給子民，因此這場切磋被稱為「演武傳心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860315
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860315,
					"content": "後來，「演武傳心」的傳說演變成了劍道比賽，這場神明傳授技藝的切磋，也作為賽事最後的「表演賽」被保留了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860316,
					"content": "透過它，後世就能瞭解「演武傳心」的由來，也能瞭解到武藝所承載的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860317,
					"content": "聽起來是很重要的表演呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860318,
					"content": "是的。現在的表演賽上，將軍大人雖然不會親自出席，但會派遣特使代表自身參戰，以示神威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860319,
					"content": "飾演「武人」的，自然就是大賽的勝者了；「神明眷屬」會由一位官家出身的劍士飾演，這一職責也被稱為「代神使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860320
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860320,
					"content": "本次，就是由我來擔任「代神使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860321
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860321,
					"content": "原來如此！我總算知道這次比賽那麼熱門的原因了！畢竟綾華在稻妻民眾眼裡，就是很有人氣的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860322,
					"content": "派蒙說得沒錯，白鷺公主雖然會出席一些祭典儀式，但能近距離見識到她超群劍術的場合可不多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860323
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860323,
					"content": "將軍大人說，這次要打造以大眾為對象的賽事，要選一位有號召力的形象大使。既然這樣，「代神使」一職也就非綾華小姐莫屬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860324
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860324,
					"content": "噢對了，這位是八重堂的小野寺先生，專門負責籌備各類活動，也是我們的援手。最早就是他建議由綾華小姐來擔任「代神使」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860325
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860325,
					"content": "除此之外，他提出的「擴大受眾面」、「提升話題度」這兩個方案，也大大增加了賽事的討論度，真是幫了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860326
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860326,
					"content": "聽起來好專業！這些方案都是什麼意思呀，快跟我說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860327,
					"content": "說到「擴大受眾面」，自然是要讓更多的人能參與比賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860328,
					"content": "過去演武傳心的參賽者，必須是稻妻劍道流派的人。這次則不同，不論國籍與身分，只要有向武之心，就都能參與。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860329
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860329,
					"content": "同時在比賽中，使用的武器也不僅僅局限於單手劍。只要是近戰武器，並且符合比賽要求的長度與重量規則即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860330
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860330,
					"content": "至於「提升話題度」，就我個人的經驗來說，最有效的辦法就是——舉辦投票。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860331
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860331,
					"content": "投票？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860332
					]
				},
				{
					"id": 736860332,
					"content": "沒錯。「代神使」在表演賽中穿著的華服，以往都是由將軍大人指定，但這次在將軍大人支持下，我們把選擇權交給了觀眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860333
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860333,
					"content": "大家可以在「春櫻」、「秋葉」等象徵四季風物的款式中選擇一種進行投票，神里小姐將身著得票最多的服裝出席表演賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860334
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860334,
					"content": "雖然投票要到比賽當天才會開始，但最近我家僕人已經在猜測服裝的主題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860335
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860335,
					"content": "多虧神里小姐答應擔任「代神使」一職，這些方案才能夠成立。我知道這對於神里小姐來說，也是不小的壓力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860336
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860336,
					"content": "沒關係，能對推廣劍道有幫助，對我而言也是一種榮幸。小野寺先生為賽事盡心盡力，大家有目共睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860337
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860337,
					"content": "神里小姐過獎了。各位，我還要回去準備投票的事，就先走一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860338
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860338,
					"content": "#旅行者、派蒙，既然{F#妳}{M#你}們來了，我和千里小姐就帶{F#妳}{M#你}們去比賽的場地看看吧，也能熟悉一下環境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860339
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860339,
					"content": "好呀好呀，那我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7368604,
			"completionStepIds": [
				7368606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368606",
							"2"
						],
						"stepId": 7368606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華",
					"柊千里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860401,
					"content": "好氣派的賽場啊…原來遠國監司裡還有這種地方，我之前都不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860402,
					"content": "這裡是勘定奉行的室內練兵場。這次多虧有千里小姐幫忙，才能借用到這裡的場地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860403
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860403,
					"content": "不用客氣，綾華小姐，能幫上忙我也很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860404
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860404,
					"content": "千里，那邊那個是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860405,
					"content": "喔，那個啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860406
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860406,
					"content": "#旅行者，現在方便…稍微和{F#妳}{M#你}說幾句話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860407
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860407,
					"content": "當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860408
					]
				},
				{
					"id": 736860408,
					"content": "嗯，這件事應該從何說起才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860409
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860409,
					"content": "綾華，難道是想說「信」的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860410
					]
				},
				{
					"id": 736860410,
					"content": "#啊…果然瞞不過{F#妳}{M#你}的眼睛。其實，一開始聽說大家希望由我來擔任「代神使」時，我心裡真的有些忐忑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860411,
					"content": "雖說我從小就經常在公眾面前露面，但擔任劍道賽事的活動大使，還要身著盛裝參加演武，這還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860412
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860412,
					"content": "以前，有資格擔任「代神使」的，都是稻妻官家劍術最精湛的武者，我自知和他們比起來還差得太遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860413
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860413,
					"content": "#我擔心自己無法勝任這一職責，所以那個時候，我曾想寫封信給{F#妳}{M#你}，問問{F#妳}{M#你}的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860414,
						736860415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860414,
					"content": "我們是朋友，妳不用顧慮的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				},
				{
					"id": 736860416,
					"content": "嗯，是啊，我知道的。不過，大概正因為知道這一點，我最後才沒有寄出那封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860417
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860417,
					"content": "#之前，{F#妳}{M#你}已經幫了我很多次，也傾聽了我的許多煩惱。但如果我總是向{F#妳}{M#你}尋求幫助的話，就感覺自己有點「輸給{F#妳}{M#你}」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860418
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860418,
					"content": "呵呵，身為朋友，會這樣想很奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860419,
						736860420
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860419,
					"content": "並不奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860421,
					"content": "#謝謝{F#妳}{M#你}。但今天得知{F#妳}{M#你}也來參加比賽了，我真的很開心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860422,
					"content": "#綾華…欸，{F#妳}{M#你}們兩個剛剛在說什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860423,
					"content": "#我剛剛在說，得知旅行者來參加比賽，我覺得很高興。以{M#他}{F#她}在稻妻的人望，一定又能為賽事增加不少話題度呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860424,
					"content": "#嘿嘿，我覺得有{M#他}{F#她}出場的話，比賽一定會很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860425,
					"content": "#派蒙說的沒錯，我也很看好{F#妳}{M#你}喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860420,
					"content": "我能夠理解妳的心情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860415,
					"content": "我很願意為妳分憂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				}
			]
		},
		{
