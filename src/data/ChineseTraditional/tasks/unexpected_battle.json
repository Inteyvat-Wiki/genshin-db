			},
			"dialogs": [
				{
					"id": 736860501,
					"content": "#天色不早了，我和千里小姐就先回去了。{F#妳}{M#你}們這兩天也要好好休息，不要太過辛勞。我們比賽當天再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860502
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860502,
					"content": "嗯，綾華、千里，我們比賽當天見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
