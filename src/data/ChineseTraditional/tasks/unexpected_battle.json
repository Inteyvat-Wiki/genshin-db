					"水田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860601,
					"content": "#{NICKNAME}，{F#妳}{M#你}看，綾華和千里她們在那邊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860602,
					"content": "#旅行者、派蒙，{F#妳}{M#你}們來了。昨天休息得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860603,
						736860605
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860603,
					"content": "休息得不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860604
					]
				},
				{
					"id": 736860604,
					"content": "不愧是旅行者，一副氣定神閒的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860607,
					"content": "哼哼，賽前保持良好狀態可是很重要的，這次的比賽我們志在必得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860608,
					"content": "各位看起來狀態不錯，今天的開幕賽一定會順利的…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860609
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860609,
					"content": "說起來，難道這兩個箱子裡裝著的就是選票？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860610,
					"content": "#我都安排好了，左邊這箱是演武傳心的選票，右邊是其他活動用的，投票的結果將會在{F#妳}{M#你}們參加第三輪比賽的時候揭曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860611
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860611,
					"content": "以旅行者的實力，進入第三輪比賽絕對是毫無疑問的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860612
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860612,
					"content": "那還用說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860613,
					"content": "小野寺先生，那我們就先把「演武傳心」用的投票箱拿走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860614
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736860614,
					"content": "好的，辛苦你們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860615
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860615,
					"content": "#{NICKNAME}，時間差不多了，我們準備進賽場吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860616,
					"content": "#旅行者，祝{F#妳}{M#你}比賽取得好成績。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860617
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860617,
					"content": "好啦，我和綾華小姐也該去場邊觀賽了，晚點見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860605,
					"content": "沒怎麼睡著呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860606
					]
				},
				{
					"id": 736860606,
					"content": "#話雖這麼說，但{F#妳}{M#你}還是平常那個氣定神閒的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				}
			]
		},
