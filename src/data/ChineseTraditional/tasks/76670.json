			"trigger": {
				"objectNames": [
					"莉莉希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "莉莉希，最近情況如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766700102,
					"content": "啊！您好，菈烏瑪大人，最近店裡的事情一切順利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700103,
					"content": "食材的供應沒有斷過，也沒有人來搗亂，而且我做菜的手藝也越來越好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700104,
					"content": "對了，上次您說的「朋友」，是…那些動物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700105,
					"content": "牠們都好乖喔。一直盯著排隊的人，我想要餵牠們一點吃的，牠們都不吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700106,
					"content": "那些孩子都知道自己身負責任，在履職之時，自然會堅守崗位，聚精會神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766700107,
					"content": "不過，在牠們交班之後，妳就可以稍微款待牠們一下了，呵呵，我想牠們也會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766700108,
					"content": "好啊，那我今天要做一頓好吃的，好好感謝一下牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700109,
					"content": "辛苦妳了，莉莉希，若是需要人協助，直接告訴我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766700110,
					"content": "不用的不用的，我打理得過來，況且還有坎托爾先生和雅珂達小姐幫忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700111,
					"content": "好吧，那我就不打擾了，再見，莉莉希。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766700112,
					"content": "嗯，我也要去把新的一輪餐點端出來了…對了，菈烏瑪大人，請您也吃吃看這份餐點吧。我剛做好的，很新鮮哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766700113,
					"content": "好，接下來要把餐點擺在盤子上…咦？我剛剛洗好的盤子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				}
			]
		}
	]
}