	"talks": [
		{
			"id": 7265201,
			"completionStepIds": [
				7265201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265201",
							"2"
						],
						"stepId": 7265201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726520101,
					"content": "#旅行者，{F#妳}{M#你}好！最近過得怎樣？有沒有興趣幫幫南十字船隊呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520102,
						726520103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520102,
					"content": "南十字船隊…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				},
				{
					"id": 726520104,
					"content": "欸…啊哈哈哈哈，抱歉抱歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520105,
					"content": "#我是「死兆星號」的首席技術官慕珍。我以往一直都待在船艙裡不太出來，{F#妳}{M#你}不認識我也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520106,
					"content": "結果這不是被海龍大哥一腳踢出來了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520107,
					"content": "「動動妳的懶骨頭吧！曬曬太陽又沒壞處！」這麼說著就把我趕到岸上來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520108
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520108,
					"content": "可是他自己連下船都不敢，一站上陸地就頭暈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520109,
						726520110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520109,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520111,
					"content": "哦哦，真不好意思。光顧著笑話別人，把正事忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520112
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520112,
					"content": "#為了幫北斗大姐頭的下一班航程做技術準備，我得拜託{F#妳}{M#你}幫忙辦一些雜務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520113
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520113,
					"content": "以往這種事都是大姐頭親自來做的，因為身為「南十字」的總領，要有身先士卒探索未知險境的自覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520114
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520114,
					"content": "這是我們「南十字」的規矩，不論我們當中誰做了老大，都要承擔這份義務才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520115
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520115,
					"content": "但是大姐頭她現在在稻妻還有更優先的訂單要完成，不能為了這種小事耽誤了手頭的任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520116
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520116,
					"content": "所以就推給我們囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726520117,
					"content": "嘿嘿，我身為技術官不擅長打架嘛…而且船上的大家都各有各的工作。都忙得很，抽不出身來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520118
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520118,
					"content": "好了，閒話不多說啦。事情是這樣的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520119
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520119,
					"content": "下一趟運單的雇主需要一批樣品，就是產自此地的某種特殊遺蹟機械的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520120
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520120,
					"content": "根據雇主交給我們的目擊記錄分析，那些機械…或是生物，就藏匿在稻妻列島，非常有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520121,
						726520125,
						726520130
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520121,
					"content": "雇主…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520122
					]
				},
				{
					"id": 726520122,
					"content": "怎麼，想打探「南十字」的商業機密嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520123
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520123,
					"content": "#哈哈，不必緊張，如果我知道的話，我也會很樂意告訴{F#妳}{M#你}…不過這在行規上可是「死罪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520124
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520124,
					"content": "#所以不好意思囉。雇主是誰我也不知道，對{F#妳}{M#你}來說也不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520134,
					"content": "它們在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520135
					]
				},
				{
					"id": 726520135,
					"content": "#唉，{F#妳}{M#你}算是問到重點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520136
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520136,
					"content": "苦惱的是，我也不知道它們的具體位置在何處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520137
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520137,
					"content": "不過在島上的某些地方，出現了一些奇異的雷元素活動現象。根據我的監測，它們的頻率與島上的其他雷元素活動有很大差異…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520138
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520138,
					"content": "總之，我認為應該先調查一下那些異常區域，很可能會將結果導向我們的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520139
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520139,
					"content": "#對了，如果它們會產生什麼副產品的話，希望{F#妳}{M#你}能順便帶回一些供我研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520140
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520140,
					"content": "放心，報酬我會如數付清的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520125,
					"content": "機械生物…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520126
					]
				},
				{
					"id": 726520126,
					"content": "…嗯，層岩巨淵的礦工以前也挖出過類似的東西，據說和五百年前的災難有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520127
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520127,
					"content": "總之都是些…徘徊在遺蹟的不祥之物，令人生畏，卻也令人興奮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520128
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520128,
					"content": "一想到它們就在這裡就受不了，真想拆一台來解解手癢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520129
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520129,
					"content": "#不過{F#妳}{M#你}不是技術員，這種心情恐怕不懂啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520130,
					"content": "有趣…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520131
					]
				},
				{
					"id": 726520131,
					"content": "#唔…{F#妳}{M#你}就不想親手拆解一台來試試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520132
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520132,
					"content": "不是很想…吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726520133,
					"content": "哼，好吧…可能只有技術員才理解我的熱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520110,
					"content": "有什麼需要幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520103,
					"content": "我認識妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				}
			]
		}
	]
}