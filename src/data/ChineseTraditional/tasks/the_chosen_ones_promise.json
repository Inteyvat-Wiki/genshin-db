			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#真是太好了，{NICKNAME}在那個…呃，好難解釋，總之就是{F#她}{M#他}在夢裡看到你和奇怪的人在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380104,
					"content": "你在天蛇船上有遇到什麼奇怪的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380105,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "欸？那到底是有還是沒有啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380107,
					"content": "嗚…呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "哇，完全搞不懂你想說什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380109,
					"content": "#既然{REALNAME[ID(2)|SHOWHOST(true)]}沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "是哦，不過玻娜呢？玻娜去哪裡了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380111,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "難道你們走散了嗎？還是說玻娜她真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380113,
					"content": "或許玻娜只是故事中的角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "#嗯…{F#妳}{M#你}說的也對，普通人是沒辦法活幾百年的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380115,
					"content": "但至少我們完成了她未完的冒險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "沒錯，我們也答應過她要好好宣傳這段冒險經歷。等大家都知道我們找到了天蛇船，玻娜也會成為大名鼎鼎的冒險家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380117,
					"content": "接下來就應該要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "接下來就該去火山找「那個人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "把事情弄清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380120,
					"content": "這樣說來，那個傢伙該不會就是「盜火賢者」吧？一路上都是他留下來的訊息，我真的是越來越好奇了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380121,
					"content": "而且那傢伙還說自己會假扮成不同的身分，就算遇到了我們也不一定認得出來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#果然你也很好奇吧，{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380124,
					"content": "#既然信物也已經找齊了，接下來我們就和{REALNAME[ID(2)|SHOWHOST(true)]}一起去火山吧，解開所有的秘密，然後幫{REALNAME[ID(2)|SHOWHOST(true)]}解除詛咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751380125,
					"content": "對不起喔，玻娜，「通牒金盤」我們要先帶走囉。等到我們把所有事情都搞清楚之後，再把一切告訴妳吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
