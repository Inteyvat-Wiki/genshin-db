			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "兩位是來抓藥的嗎？可還記得藥方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 110090302,
					"content": "清心、琉璃百合、琉璃袋，各要半斤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090303,
					"content": "這是什麼藥方？簡直是拿藥當飯吃…給，這就是本店全部的存貨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 110090304,
					"content": "多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090305,
					"content": "真，真的在吃欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090306,
					"content": "在眾人震驚的目光中，申鶴將眼前的藥材掃蕩一空。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "不餓了，多謝款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090308,
					"content": "味道如何…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "不好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090311,
					"content": "其味雖略帶清香，但吃多了就只剩下苦、酸、澀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090312,
					"content": "那申鶴為什麼寧願吃這些，也不吃飯館裡的菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090313,
					"content": "要是我有很多摩拉的話，我肯定要去最高檔的餐館，點好多好多好吃的，一口氣全部吃掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090314,
					"content": "因為我也不確定，以後自己會不會留在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090315,
					"content": "人間的飯菜固然美味，但若是我將來回歸山野，對美食的回味反而會成為修煉的阻礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090316,
					"content": "所以淺嚐輒止，明白個中滋味便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090317,
					"content": "#回歸山野…{NICKNAME}，不會錯，這個人絕對是仙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090318,
					"content": "我的事暫且不提，兩位接下來有什麼打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090319,
					"content": "對哦！差點忘了，我們可是來參加重修群玉閣比賽的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090320,
					"content": "耽、耽誤太多時間，事情可就做不完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090321,
					"content": "原來如此。那個比賽，我剛剛路過的時候也有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090322,
					"content": "嘿嘿…畢竟贏了的話，不管什麼事情都可以問呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090323,
					"content": "申鶴也是來參賽的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090324,
					"content": "我確實是為重修群玉閣而來，不過此前並沒有參賽的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090325,
					"content": "#如今承蒙{F#妳}{M#你}們照顧，我也想助{F#妳}{M#你}們一臂之力。放心，並不需要什麼回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090326,
					"content": "哇…這怎麼好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090327,
					"content": "不過有仙人幫忙的話，事情應該會好辦許多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090328,
					"content": "那我們就一起行動吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "那事不宜遲，眼下我有一個作戰方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090331,
					"content": "好欸！申鶴提出來的方案，一定很厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090332,
					"content": "厲不厲害我不太清楚，不過應該很有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090333,
					"content": "只要把排名比我們靠前的人全部幹掉，我們就會成為第一名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090334,
					"content": "…不可以！怎麼想都不可以吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090335,
					"content": "是嗎？但我聽說競爭本身就是相互傾軋、相互算計…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090336,
					"content": "我們可是要堂堂正正地拿下第一名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090337,
					"content": "「鳴霞浮生石」、「千奇核心」，還有「仙家符籙」…我們就按順序找好了，首先是浮生石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090338,
					"content": "#我說怎麼店外就能聽到爭論的聲音，原來是{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090339,
					"content": "白朮！你怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090340,
					"content": "凝光小姐要採購一批傷藥，店裡的藥材不一定夠用，所以我親自過來籌備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090341,
					"content": "咦，凝光小姐要這麼多傷藥做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090342,
					"content": "我也不清楚，聽說她要重建群玉閣，可能是工地上要用吧？總之是客人的隱私，我不便多問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090343,
					"content": "她還從我這裡借走了七七，不卜廬現在非常缺人，幾位要不要留下來做份兼職？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090344,
					"content": "不了不了，我們還有別的事情…說起來，白朮見多識廣，有沒有聽說過「鳴霞浮生石」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090345,
					"content": "是說群玉閣要用的那種嗎？我記得《七臧山經》裡提到過，鳴霞浮生石啟用後可直上雲霄，非常稀有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090346,
					"content": "有明文記載的鳴霞浮生石基本已經被開採完畢，皆是有主之物。比起我，飛雲商會應該對此更為瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090347,
					"content": "原來如此，那我們去飛雲商會問問吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090348,
					"content": "謝謝你啦，白朮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090349,
					"content": "#不客氣，祝{F#妳}{M#你}們順利。有什麼需要的話，來不卜廬找我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白朮"
				},
				{
					"id": 110090329,
					"content": "隨時歡迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "真的好吃嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
