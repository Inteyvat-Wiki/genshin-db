			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "今天召集諸位，是想宣佈一件重要的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090102,
					"content": "或許有人已聽到過風聲，最近我確實打算重修群玉閣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090103,
					"content": "重修群玉閣？這可是個大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090104,
					"content": "坊間傳聞確有其事啊，難怪前段時間建材價格飛漲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090105,
					"content": "群玉閣對凝光大人意義非凡，如果能搭上這條線…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090106,
					"content": "凝光大人，有什麼需要我們幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090107,
					"content": "不必心急。前些日子消息傳開後，有不少人透過各種管道聯繫我，想要加入到這個工程中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090108,
					"content": "眼下我手裡確實有幾件事，想委託給諸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090109,
					"content": "如今工程已經完成選址，各式建材準備妥當，但尚有三件至關重要的物品沒有著落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090110,
					"content": "這三件物品，分別是「鳴霞浮生石」、「千奇核心」以及「仙家符籙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090111,
					"content": "這…恕我冒昧，除了浮生石外，後面兩樣我從未聽說過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090112,
					"content": "規格夠大的浮生石，才能冠以「鳴霞」之稱，這是保證群玉閣能夠升空的基礎。千奇核心，則是群玉閣內機械結構的核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090113,
					"content": "至於仙家符籙，它的效用是將機械裝置與仙家術法有效結合，同樣不可或缺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090114,
					"content": "雖是三樣罕見之物，但以諸位的人脈和能力，找齊它們應該只是時間問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090115,
					"content": "兵貴神速，一切全看效率。我會以好價收購你們找來的材料。此外，前三位找齊材料的人，將得到一次向我提問的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090116,
					"content": "無論是什麼問題，我都會回答。我相信，以此為報酬，必不會令各位失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090117,
					"content": "這東西雖然難找，但如果能問到璃月港明年的規劃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090118,
					"content": "那就是天價的生意了。誰從凝光大人那裡問到消息，誰就掌握了先機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090119,
					"content": "哈哈，真是巧了！不久前我剛聽說過有關浮生石的傳聞。各位，恕不奉陪了，我先行一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "宏飛"
				},
				{
					"id": 110090120,
					"content": "可惡…我們也趕緊出發，不能被別人搶先了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "昌貴"
				},
				{
					"id": 110090121,
					"content": "重修群玉閣…這麼重要的事情，我們也去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090122,
					"content": "#方才我說的話，{F#妳}{M#你}們都聽到了吧。如何？可有興趣參與此事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090123,
					"content": "真的什麼都可以問嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "只要是我知道的事，均可如實相告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090125,
					"content": "#（說不定可以問到關於{F#哥哥}{M#妹妹}的事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "真的嗎？那我要問，凝光小姐是怎麼經商的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090127,
					"content": "這樣以後旅行，我們就再也不缺摩拉用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090128,
					"content": "呵呵，當然可以。不過，傳授多少心得，全看二位的表現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090129,
					"content": "群玉閣重建一事佔地較大，我將地址安排在黃金屋外的廢棄礦場。收集到的材料，都送去那邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090130,
					"content": "#我另有要事，不能陪{F#妳}{M#你}們前往現場。{F#妳}{M#你}們到了那裡，聯繫我的秘書就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090131,
					"content": "千萬注意時間。難得的機會，可別被別人搶先了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090132,
					"content": "凝光小姐真是個大忙人呢…我們也快點出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090133,
					"content": "#首先得先從玉京臺離開…咦？{NICKNAME}{F#妳}{M#你}看，那邊氣氛好像有些微妙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090134,
					"content": "小姐，我看妳風度翩翩、氣質不凡，一看就是在這次重修群玉閣中獨佔鰲頭的料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090135,
					"content": "我們這裡有關於那些材料的情報，來，咱們找個安靜的地方說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090136,
					"content": "不需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090137,
					"content": "別這麼說嘛。哎，別走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090138,
					"content": "愣著幹什麼，還不快跟上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090139,
					"content": "是…是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿強"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "嘿嘿，小姐，這次妳終於沒地方跑了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090202,
					"content": "放心，我們也不是什麼壞人。出點錢就能換到寶貴的情報，大家誰都不虧嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090203,
					"content": "老大，我總有種不好的感覺。你看她身上的氣質明顯和別人不同，頭髮也是白的，不像是普通人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "阿強"
				},
				{
					"id": 110090204,
					"content": "那又如何？好不容易遇見一隻肥羊，不宰她一刀，咱們的賭債怎麼還？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090205,
					"content": "我說了，我不需要你們的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090206,
					"content": "如果你們剛剛沒有聽到，那我再重複最後一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090207,
					"content": "唉…小姐，妳說妳這麼大一個人，怎麼一點常識也沒有啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090208,
					"content": "這不是妳需不需要的問題，妳只要乖乖地把錢拿出來，交給我們就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090209,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090210,
					"content": "別狡辯！妳有錢，我看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090211,
					"content": "妳先去琉璃亭，點了滿滿一桌子菜，卻只是稍微嚐了嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090212,
					"content": "然後又去新月軒、萬民堂，把招牌菜全點了一遍，又是每樣只吃一口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090213,
					"content": "如果不是富家千金小姐，哪來如此奢侈的習慣？既然妳這麼有錢，分我們一點怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090214,
					"content": "雖然師父叮囑過，不要在璃月港裡動手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090215,
					"content": "算了。或許…這也是命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090216,
					"content": "老大，好像有點不太對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "阿強"
				},
				{
					"id": 110090217,
					"content": "怕什麼，咱們賣情報又不犯法，她要是敢動手，咱們告她個傾家蕩產！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090218,
					"content": "就是他們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "哦？又是你們幾個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "老鄭"
				},
				{
					"id": 110090221,
					"content": "#千岩軍？千岩軍怎麼來了…是{F#妳}{M#你}幹的？哼，多管閒事，信不信我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090222,
					"content": "住口！還敢威脅別人是吧，跟我們走一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "老鄭"
				},
				{
					"id": 110090223,
					"content": "呵呵…大人別生氣，您聽我慢慢跟您解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "刀疤劉"
				},
				{
					"id": 110090224,
					"content": "圍住白髮女子的流氓被千岩軍帶走了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090226,
					"content": "妳沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "…申鶴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090229,
					"content": "申鶴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090230,
					"content": "我的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090231,
					"content": "#哦哦，原來妳叫申鶴呀！我的名字是派蒙，這位是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090232,
					"content": "#我聽說過{F#妳}{M#你}們。剛剛，謝謝{F#妳}{M#你}們幫我解圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090233,
					"content": "雖然我自己也能解決。據我判斷，只要抓著那個人的腦袋敲三下地面，他應該就會服軟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090234,
					"content": "嗚哇！不，不可以用那麼暴力的辦法啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090235,
					"content": "這裡可是璃月港，要遵守璃月港的律法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090236,
					"content": "律…法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090237,
					"content": "申鶴沒有聽說過律法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "我確實沒有聽過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090239,
					"content": "真的假的，那妳以前——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090241,
					"content": "好像有什麼聲音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "是我的肚子在響。因為沒有吃飽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090243,
					"content": "居然這麼坦率地承認了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090244,
					"content": "說起來，剛剛聽那些人說，妳到許多餐館點菜，每樣卻只嚐一口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090245,
					"content": "這樣肯定是吃不飽的吧！妳有什麼想吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090246,
					"content": "清心、琉璃百合、琉璃袋…這些是我平時吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090247,
					"content": "這些都是藥材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "藥材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 110090249,
					"content": "好像解釋不通…不卜廬就在這附近吧，我們不如帶申鶴去飽餐一頓好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090250,
					"content": "畢竟吃飽了才有力氣幹活嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090227,
					"content": "放心，這樣就沒問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "這幾個人在敲詐勒索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
