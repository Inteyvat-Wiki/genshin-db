	"talks": [
		{
			"id": 1100901,
			"completionStepIds": [
				1100901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100901",
							"2"
						],
						"stepId": 1100901,
