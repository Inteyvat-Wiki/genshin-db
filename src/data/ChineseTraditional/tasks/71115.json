			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "呼…對啦，就是這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150602,
					"content": "先前洞府藥君曾引彩蝶點綴門戶，後來洞府機關破敗，這些彩蝶與藥罐，原是用於滋養那棵仙樹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150603,
					"content": "仙樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150604,
					"content": "哼哼，沒錯！想當初，這仙樹乃是藥君大人親手栽下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150605,
					"content": "雖說現在已經枯萎，但藥君大人說過，只要彩蝶還沒有散盡，那棵樹便可以復生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150606,
					"content": "唉…自從無力維持人形之後，她很快便離開了，不知如今過得如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150607,
					"content": "所以我要怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "啊，不好意思，一不小心就沉浸在藥君大人的回憶裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150609,
					"content": "咳咳，聽好了啊，人類！只要把那些彩蝶趕進罐子裡，就能滋養那棵枯木啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150610,
					"content": "哼哼，這就是藥君大人設計的仙家機關，很神奇吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150611,
					"content": "我試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "#嗯嗯，那就拜託{F#妳}{M#你}們了，好心的人類！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150613,
					"content": "為什麼是彩蝶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "欸？對喔，為什麼呢…也許是因為藥君大人比較喜歡彩蝶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150615,
					"content": "#呃…總之，拜託{F#妳}{M#你}們幫忙把那些彩蝶趕回罐子裡吧，好心的人類！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「慢悠悠仙像」"
				}
			]
		},
