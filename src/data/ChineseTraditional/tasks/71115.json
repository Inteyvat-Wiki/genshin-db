				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "呼…對啦，就是這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150502,
					"content": "先前洞府藥君曾引彩蝶點綴門戶，後來洞府機關破敗，這些彩蝶與藥罐…原是用於滋養那棵仙樹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150503,
					"content": "仙樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150504,
					"content": "哼哼，沒錯！想當初，這仙樹乃是藥君大人親手栽下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150505,
					"content": "雖說現在已經枯萎，但藥君大人說過，只要彩蝶還沒有散盡，那棵樹便可以復生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150506,
					"content": "唉…自從無力維持人形之後，她很快便離開了，不知如今過得如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150507,
					"content": "「彩蝶匯壇中，復枯木逢生之貌…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "#沒錯沒錯！只要…不對，{F#妳}{M#你}們是怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
