				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "唔…嗯？爾等何人？擾我好夢…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150402,
					"content": "欸？！什麼東西在說話？好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150403,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150404,
					"content": "哇啊啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150405,
					"content": "#哈哈哈哈哈！害怕就對了！若我未被山石所困，{F#妳}{M#你}們早就進我肚子裡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150406,
					"content": "什麼…？啊！原來只是會說話的石像呀…我還以為是什麼怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150407,
					"content": "哼，什麼叫「只是會說話的石像」！石像會說話難道不可怕嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150408,
					"content": "呃…像這樣的石像，我們在外面已經見過很多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150409,
					"content": "#什、什麼！唉，好吧，那看來是嚇不到{F#妳}{M#你}們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150410,
					"content": "為什麼非要嚇到別人呀，真是的！明明只是個石像而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150411,
					"content": "哼！就算我「只是個石像而已」，此地可是藥君大人的洞府！藥君大人還在的時候，就不喜歡別人隨意打擾她的安寧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150412,
					"content": "所以呀，我就要把討厭的傢伙全部嚇跑！就算藥君大人離開了也是一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150413,
					"content": "#不過，{F#妳}{M#你}們的氣息和那些普通的凡人好像也有些不同，而且也沒有被我嚇到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150414,
					"content": "#可不可以拜託{F#妳}{M#你}們…幫我一個忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150415,
					"content": "哦？那你要我們幫什麼忙呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150416,
					"content": "#咳咳，{F#妳}{M#你}們看這些彩色的蝴蝶！自從洞府的主人離開後，這些小傢伙就散落得遍地都是，到處亂飛——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150417,
					"content": "噓…先等一下，你頭上就有一隻呢！稍等一下，讓我們幫你拿下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
