			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "上層召龍平臺全天開放，有意加入馬塔伽特訓場的人與龍請至上層召龍起飛。謹記：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "醒目的標語"
				},
				{
					"id": 750440702,
					"content": "以認真積極訓練為榮，以怠惰消極偷懶為恥！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "醒目的標語"
				},
				{
					"id": 750440703,
					"content": "今天你我不努力，明天只能吃垃圾！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "醒目的標語"
				},
				{
					"id": 750440704,
					"content": "努力奮勇向前，擁抱卓越龍生！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "醒目的標語"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "口令是先吹左邊的號角，然後是右邊的，接著是左邊的，最後是右邊的，不要亂吹，後果自負！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "馬塔伽！記得！！"
				},
				{
					"id": 750440802,
					"content": "最好餵一點禽肉，防止龍心情不好導致自己被啄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "馬塔伽！記得！！"
				},
				{
					"id": 750440803,
					"content": "（似乎是一個叫馬塔伽的人寫給自己看的備忘錄，即使透過文字也感受得到激烈的情緒。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "馬塔伽！記得！！"
				},
				{
					"id": 750440804,
					"content": "（不過每一個備忘錄都加上感嘆號，不就等於沒有加？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塔伽！記得！！"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "「…奉聖火的{RUBY#[D]雅豪卡阿胡克}看護者、至仁至耀的聖{RUBY#[D]蒂沙庫恩}王奧奇坎陛{RUBY#[D]卡洛穆特}下之命，為興修水利設施，現於諸部族徵募勞工…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "「…不計定額，全憑自覺自願…建設聯盟…望各部族積極響應為要…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "「奉聖火的{RUBY#[D]雅豪卡阿胡克}看護者、至仁至耀的聖{RUBY#[D]蒂沙庫恩}王奧奇坎陛{RUBY#[D]卡洛穆特}下之命，即日起封鎖受詛之地，全聯盟成員一律禁止入內。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "「擅自闖入者將被正式認定為聯盟的敵人，這是（…）、納茨卡延、梅茲特利、維茨特蘭與特特奧坎的共同宣言。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "「願榮耀永遠屬於聖火的{RUBY#[D]雅豪卡阿胡克}看護者，偉大的和{RUBY#[D]卡塔茲傑}平締造者，至仁的聖{RUBY#[D]蒂沙庫恩}王奧奇坎。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "「鑑於本區域排水工程整體進展較為緩慢，為確保聯盟不可阻擋的勝利，現適當微調輪調制度。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "「將勞工劃分為三隊，每隊工作十六小時，兩日循環一次。表現卓越的小隊將額外獲得穀物配給。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "「<color=#00E1FFFF>排光積水</color>的勝利曙光近在咫尺，待溝渠完工<color=#00E1FFFF>抽水機</color>便可以正常運作。再加把勁！」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "「…同胞們、親人們，為聯盟不可阻擋的勝利而奉獻的兄弟姐妹們…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "「…至仁的…自（…）調撥一批新式機關，以支援運輸、（…）與<color=#00E1FFFF>水下打撈</color>…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "「…前進，再前進，不惜代價前進…為了聯盟輝煌的未來，為了我們每個人的自由與榮耀，為了不再被惡龍凌壓的家園…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "「…未經許可…禁止擅自觸動<color=#00E1FFFF>操作桿</color>…跌落事故…已致使三名勞工…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "「…北邊的石壁後有一條通往瀑布上方的小徑，似乎可以被用作<color=#00E1FFFF>儲藏室</color>…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "「…稍稍做了一些標記，以免自己之後也忘了怎麼走…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "「…薩雅妮的傷勢又惡化了，環境過於潮濕…勸她休息，笑著拒絕了…說是會拖慢小隊進度，害大家拿不到額外配給…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "「…夜裡要趁著別人不注意，去上面幫她帶一支火炬，用來燎燒傷口，否則她的四肢也會一起腐爛…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
