					"nextDialogs": [
						750444603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750444603,
					"content": "不過，咦？我們之前扔進去的東西不見了…我們的確扔進去了才對吧？等等，總覺得有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750444604,
					"content": "罐子裡是不是有什麼別的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "派蒙"
				},
