			"dialogs": [
				{
					"id": 750444701,
					"content": "（用幼稚而潦草的字寫著：）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "小孩的筆記"
				},
				{
					"id": 750444702,
					"content": "這個遊戲叫做「咚咚凍凍龍咚咚」，規則是這樣：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "小孩的筆記"
				},
				{
					"id": 750444703,
					"content": "1.在咚咚幻寫靈不咚咚的時候騎在龍雕像的背上，龍雕像就會往前走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "小孩的筆記"
				},
				{
					"id": 750444704,
					"content": "2.咚咚幻寫靈倒數到「咚！」的時候，必須從龍雕像身上下來，不然就會輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "小孩的筆記"
				},
				{
					"id": 750444705,
					"content": "3.最先跑到咚咚幻寫靈身邊的就贏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "小孩的筆記"
				},
				{
					"id": 750444706,
					"content": "不許說「寫那麼多，不就是一二三木頭人嘛！」，規則是很重要的，而且就是因為不尊重規則大家才贏不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小孩的筆記"
				}
			]
		}
	]
