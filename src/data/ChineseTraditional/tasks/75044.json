			"dialogs": [
				{
					"id": 750442401,
					"content": "「…願榮耀永遠…和平締造者…至仁的…奧奇坎…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "「…工匠馬胡欽特利、特拉南庫，並…負責建設抽水…消極怠工，以致延誤…仁慈…不施以刑罰…暫停配給三週…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "「…啟動<color=#00E1FFFF>抽水機關</color>的<color=#00E1FFFF>石造鑰匙</color>…置於…不得擅自…直至另行調配工匠…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
