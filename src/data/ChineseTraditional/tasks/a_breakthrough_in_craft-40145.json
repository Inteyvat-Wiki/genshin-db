			"dialogs": [
				{
					"id": 401450101,
					"content": "經過一段時間的試營業，煉金店鋪紅紅火火地開起來了……",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "呼，這段時間客人越來越多，我都要忙得頭暈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450103,
					"content": "生意好起來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "現在這個訂單量，光靠我倆果然還是有點勉強吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450106,
					"content": "是不是該找點新的幫手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450107,
					"content": "#小可愛，{F#妳}{M#你}們現在在休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450108,
					"content": "#我剛剛看了最近的營收資料，{F#妳}{M#你}們果然很有經營天賦，這段時間賣出了不少藥劑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450109,
					"content": "麗莎妳來了！我們正好在商量找幫手的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450110,
					"content": "#哦？是不是現在訂單多起來了，{F#妳}{M#你}們逐漸忙不過來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450111,
					"content": "是啊，一開始沒想到會有這麼多客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450112,
					"content": "呵呵，我對此倒是有所預料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450113,
					"content": "#其實在{F#妳}{M#你}們忙著開店的同時，我和芙里達討論了一下提升經營效率的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450114,
					"content": "#我觀察了{F#妳}{M#你}們的經營情況，發現不管是煉金工藝，還是培育藥材和售賣環節，都有不少的提升空間呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450115,
					"content": "哇，麗莎居然在悄悄注意這些事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450116,
					"content": "我還以為妳一直在偷懶呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450117,
					"content": "說什麼呢，姐姐在關鍵時候也是很可靠的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450118,
					"content": "那妳說的提升效率，具體要怎麼做呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450119,
					"content": "這個嘛，具體的升級方案，我已經跟芙里達討論過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450120,
					"content": "#詳細的情況，{F#妳}{M#你}們直接去找她聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401450104,
					"content": "打響名號了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
