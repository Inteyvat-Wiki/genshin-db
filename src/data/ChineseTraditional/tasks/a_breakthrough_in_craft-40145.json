			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們好呀！有什麼可以幫到{F#妳}{M#你}們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450202,
					"content": "嗯，我們最近有點人手不足呢，麗莎建議我們提升一下經營效率…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450203,
					"content": "哦，這件事呀，麗莎已經跟我詳細地探討過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450204,
					"content": "目前可以提升的方向有煉金工藝、培育技術和銷售規模。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450205,
					"content": "#效率提升之後，{F#妳}{M#你}們經營起來也會更輕鬆哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450206,
					"content": "哇，聽起來好厲害…我們趕快試試看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450207,
					"content": "提升經營效率。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "升級所需的準備已經做好了，請多多嘗試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450209,
					"content": "物資採購。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "最近新到了一批物資，請看看有什麼需要哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里達"
				},
				{
					"id": 401450211,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "#祝{F#妳}{M#你}們經營順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里達"
				}
			]
		}
