						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"3"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"繪星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130201,
					"content": "#好久不見了，{NICKNAME}和派蒙，海燈節快樂呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130202
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130202,
					"content": "謝謝妳哦，繪星小姐，妳也要開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130203,
					"content": "海燈節快樂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130204
					]
				},
				{
					"id": 715130204,
					"content": "我們發現「死兆星」號上多了不少海貨和裝飾，和城裡一樣熱鬧呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7151303,
			"completionStepIds": [
				7151301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151301",
							"2"
						],
						"stepId": 7151301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"繪星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130301,
					"content": "還不錯吧！所有裝飾都是大姐頭挑選的，她想讓值崗的兄弟姐妹們有種待在家裡過節的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130302
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130302,
					"content": "不僅如此，這次海燈節前，大姐頭還給每個船員發了一筆獎金，組織了好幾次盛大的聚餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130303
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130303,
					"content": "每次聚餐的飯菜都從有口皆碑的好店訂購，除了我們常去的萬民堂，還有新月軒和琉璃亭這樣的大飯店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130304
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130304,
					"content": "大家都吃飽喝足，心滿意足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130305
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130305,
					"content": "我也想看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130306,
					"content": "嗚哇，過節的獎金，還有大餐？真好啊…沒想到，北斗也有這麼細心的一面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130307,
					"content": "其實大姐頭一直都把船隊的事務打理得天衣無縫哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130308
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130308,
					"content": "不止給我們這些船員發放了超優渥的薪水，以前過節的時候，還會給我們的家人準備禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130309
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130309,
					"content": "之前，大姐頭還從天權大人那裡得到了一些商業情報，改進了「南十字」船隊的經營策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130310
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130310,
					"content": "船隊的收入大漲了一截，大姐頭也提高了我們的待遇。如此一來，船員們就能以最佳狀態迎接各種挑戰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130311
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130311,
					"content": "即將到來的新人聽說「南十字」船隊的工作環境這麼舒服，也會更有幹勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130312,
						715130313
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130312,
					"content": "挑戰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				},
				{
					"id": 715130314,
					"content": "咦？海燈節期間，大家不都應該在放假嗎？難道你們還要…加班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130315,
					"content": "#沒那種事啦，{F#妳}{M#你}們放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130316
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130316,
					"content": "大姐頭事先調查了所有人的意向，安排一部分船員提前放假，另一批船員則稍晚幾天休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130317
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130317,
					"content": "這樣一來，所有人得到了充足的假期，也不至於把「死兆星」號孤零零地晾在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130318
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130318,
					"content": "我就屬於前者，精神飽滿地回到了崗位，好好規劃我的訓練考核「煙海梭巡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130319
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130319,
					"content": "鹽海…什麼巡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130320,
						715130321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130320,
					"content": "是新挑戰嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130322,
					"content": "#沒錯，{F#妳}{M#你}們猜得很準！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130323
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130323,
					"content": "這兩年來，璃月港的海運貿易量正在飛速上漲，不少人加入了海員的行列。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130324
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130324,
					"content": "航海是一門對耐心、勇氣和洞察力都有著很高要求的技能，海員們需要接受充分的訓練，才能安全地駕馭船隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130325
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130325,
					"content": "除了考取總務司規定的「四大證」和「五小證」，共計九種航海相關的資格證書，還需要為期兩年的海上訓練和實習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130326
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130326,
					"content": "九種證書？還需要額外兩年的訓練？這也太難了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130327,
					"content": "好嚴格！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130328
					]
				},
				{
					"id": 715130328,
					"content": "還好啦還好啦，畢竟在工作前做好嚴格的準備，總歸是比出海後遇見沒法應付的問題要划算嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130329
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130329,
					"content": "總務司會安排絕大多數的訓練科目，足以應對常見情況下的航行，這些科目也不算太難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130330
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130330,
					"content": "當然，部分商船也有著穿過凶險海域的需求，希望給予海員們更充分的鍛煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130331
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130331,
					"content": "鑑於「南十字」船隊應對惡劣海況的經驗豐富，總務司和我們共同組織了強化版的航海訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130332
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130332,
					"content": "通過這些訓練的船員，可以在證書上獲得「危險海域通行資質」的認證，和總務司準備的獎品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130333
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130333,
					"content": "考慮到我對周圍海域的海況最瞭解，大姐頭就讓我來規劃這場訓練考核…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130334
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130334,
					"content": "#等等，說起來…{F#妳}{M#你}們兩位好像也很擅長駕駛浪船？有興趣來試試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130335
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130335,
					"content": "#不介意的話，還請{F#妳}{M#你}們留意訓練設計的可取之處和缺點，給我建議，好讓我及時做出改進！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130336
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130336,
					"content": "唔，我確實也很想看看，船員們究竟需要多高超的本領，才能在最危險的海域航行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130337,
					"content": "而且也有額外的獎勵呢，怎麼想都很賺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130338,
						715130339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130338,
					"content": "讓我們見識一下吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130340,
					"content": "#真有氣勢！那我就為{F#妳}{M#你}們標記出「煙海梭巡」的航道了，請加油哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130339,
					"content": "船員們獨特的考驗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130321,
					"content": "和新人有關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130313,
					"content": "新人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				}
			]
		}
	]
}