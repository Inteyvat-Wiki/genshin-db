					"繪星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130101,
					"content": "#{F#妳}{M#你}們好啊，{NICKNAME}和派蒙，海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130102
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130102,
					"content": "謝謝妳哦，妳也要開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130103,
					"content": "海燈節快樂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130104
					]
				},
				{
					"id": 715130104,
					"content": "等等，妳認識我們嗎？請問妳是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130105,
					"content": "我叫繪星，是「南十字」船隊的航海士。這次海燈節期間，也負責籌備一些船隊相關的活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130106
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130106,
					"content": "#我從北斗大姐頭那裡聽說過{F#妳}{M#你}們的事蹟，{F#妳}{M#你}們也是膽識過人的豪傑，令人欽佩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130107
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130107,
					"content": "#如果有什麼關於「死兆星」號的問題，只要是我知道的，一定為{F#妳}{M#你}們作出最詳細的解答！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130108
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 715130108,
					"content": "好客氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130109,
					"content": "我們確實想要仔細瞭解「死兆星」號啦，如果有什麼好奇的事，肯定會來問妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130110,
					"content": "說起來，這次「死兆星」號上就多了不少海貨和裝飾，和城裡一樣熱鬧呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7151302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151301",
							"2"
						],
