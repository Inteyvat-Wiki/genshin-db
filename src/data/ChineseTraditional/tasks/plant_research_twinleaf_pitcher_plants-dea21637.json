			"dialogs": [
				{
					"id": 762000501,
					"content": "露米，你也覺得牠就在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000502,
					"content": "呀吼吼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "露米"
				},
				{
					"id": 762000503,
					"content": "解救了被困住的虎紋貓…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "他們要找的就是你吧？看起來沒什麼皮外傷，不過要是再晚一點就不好說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000505,
					"content": "總之，先去找你的夥伴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈婭"
				}
			]
