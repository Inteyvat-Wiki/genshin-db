			"dialogs": [
				{
					"id": 762000201,
					"content": "小妹妹，耽誤妳一點時間。想問問妳有在附近看過一隻虎紋貓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "朱卡"
				},
				{
					"id": 762000202,
					"content": "虎紋貓？好像沒有——露米有看到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000203,
					"content": "呀吼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "露米"
				},
				{
					"id": 762000204,
					"content": "看來露米也沒有印象…你們的貓不見了嗎？我可以幫忙找找看！這一帶的環境我還滿熟悉的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000205,
					"content": "喂，朱卡！我們哪有什麼閒錢僱傭冒險家啊…再說了，不就是隻笨貓，大不了不要牠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "瑪爾佳"
				},
				{
					"id": 762000206,
					"content": "瑪爾佳，別說這種話，牠要是聽到了會傷心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "朱卡"
				},
				{
					"id": 762000207,
					"content": "牠根本聽不到吧！要是聽得到，也不會我們喊了半天也沒回音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "瑪爾佳"
				},
				{
					"id": 762000208,
					"content": "這點小事就不用委託費啦。而且我正好要在附近調查，就當是順便好了。走吧，露米！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000209,
					"content": "（前陣子還什麼都沒有，現在居然長出這麼多雙葉籠草…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762000210,
					"content": "（說不定是什麼動物帶來了雙葉籠草的種子，不過放任它們這樣下去可不行啊…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈婭"
				}
			]
		},
