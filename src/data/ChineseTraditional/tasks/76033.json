				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"執著於食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "喂，新來的，菜不能這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330102,
					"content": "我們做出來的食物要供給島上的執燈士，必須以他們的口味為準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330103,
					"content": "這些菜完全不行，一是不夠好，二是不符合我們的餐食標準，必須要改。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330104,
					"content": "#{F#妳}{M#你}還得練，從我們挪德卡萊的本土菜做起吧——譬如挪德卡萊熱狗，做好了再拿給我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執著於食物的幽影"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"執著於食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "嗯，熱狗裡的香腸烤得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330202,
					"content": "#如果{F#妳}{M#你}是在外面的餐廳工作，這個能力夠{F#妳}{M#你}做副主廚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330203,
					"content": "但是！我們是要為島上的所有執燈士供餐，重要的不是菜有多精緻，重要的是夠吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330204,
					"content": "麵包做厚一點，現在的蔬菜種類太少，除了香腸之外，還可以放點別的肉類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330205,
					"content": "#{F#妳}{M#你}還得練，下次再來做漿果煎肉試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執著於食物的幽影"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"執著於食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "肉切得夠厚，厚切的同時煎得又很熟，很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330302,
					"content": "#但是我要提醒{F#妳}{M#你}一點，做煎肉要注意配菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330303,
					"content": "本來肉吃多了就容易膩，所以才會放漿果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330304,
					"content": "在島上，我們負責管理所有人的飲食健康，一定要注意蔬菜和肉類的平衡搭配。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330305,
					"content": "這盤煎肉裡的配菜放得太少了，這點很不好，不夠到位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330306,
					"content": "#{F#妳}{M#你}還得練，下次再來做白靈果釀雞試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執著於食物的幽影"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603308",
							"2"
						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"執著於食物的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "#雞肉夠入味，配菜量也放得夠多，{F#妳}{M#你}這樣我很難挑毛病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330402,
					"content": "#算了，本來就不是為了為難人，才盯著{F#妳}{M#你}們這些新人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330403,
					"content": "我只是個廚師，做好廚師該做的事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330404,
					"content": "就算狂獵真的來了，我也做好準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "執著於食物的幽影"
				},
				{
					"id": 760330405,
					"content": "只是可惜，來不及把做好的菜送給他們了…飯菜都灑了…灑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執著於食物的幽影"
				}
			]
		}
	]
