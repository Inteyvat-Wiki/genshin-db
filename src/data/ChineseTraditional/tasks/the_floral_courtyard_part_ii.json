			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "又見面了，兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880102,
					"content": "#上次的「花影瑤庭」令人欣喜，看來{F#妳}{M#你}們天賦異稟，很快就能領會花藝的精髓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880103,
					"content": "新的「花題」正等待兩位作答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880104,
					"content": "現在就開始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "嗯嗯！我們準備好了喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726880106,
					"content": "兩位的眼中有著瑰麗的光彩，像是映照著絢爛的花海，令人驚嘆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880107,
					"content": "#那麼，今日的「花題」稍稍提升了難度，有助於{F#妳}{M#你}們深究構圖的技巧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880108,
					"content": "「錦繡槃固，池中溪客」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880109,
					"content": "#請領會題中的含義，謹慎挑選花材，悉心構築{F#妳}{M#你}們的「花庭」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880110,
					"content": "還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "沒關係。「插花」需要安神定氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726880112,
					"content": "等到二位忙完手頭的事，擺脫了喧擾。必定能將題中的「花庭」構築得更加完滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268801",
							"2"
						],
						"stepId": 7268801,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268803",
							"2"
						],
						"stepId": 7268803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "接下來的幾天，我會一直守候在這裡，引導容彩祭的客人們，讓他們感受「花影瑤庭」的精妙之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "#兩位也別忘了每天揭曉一道的「花題」喔，一共有四道「花題」等著{F#妳}{M#你}們作答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "#當然，要是兩位還有其他問題，我也會盡力為{F#妳}{M#你}們解答的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "關於這裡的花卉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有著難以挑剔的品質和親民的價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "#也許{F#妳}{M#你}們已經見過咲耶了，我們曾在同一位老師門下學習「插花」的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "咲耶對於花藝的理解也可圈可點，但是聽說容彩祭的客人絡繹不絕時，她似乎有些怯場，認為在這種環境裡難以靜下心來插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "所以，我也會向其他客人宣傳她的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "有機會的話，我們也可以幫忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870219,
					"content": "那麼，還有什麼問題嗎，兩位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "謝謝妳，柴染小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "#不用客氣。如果{F#妳}{M#你}們有空，隨時都可以來找我喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "關於社奉行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行一直支持著稻妻的花藝事業。準確來說，為這次活動出資的貴人，是那位白鷺公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鷺公主自小就表現出驚人的花藝天賦。我曾看過她的「插花」表演，有幸與她交流過心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "雖說我比她年長，但論插花的技巧和對花藝的理解，完全沒法與她相提並論呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "在條件允許的情況下，白鷺公主每年都會提供資金，推廣「插花」這門藝術。聽說有時她還會用掉自己的積蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鷺公主曾坦率表達過自己的願望——她想讓更多人瞭解「插花」，對花藝產生興趣，進而沉下心來修習這門學問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "原來綾華為稻妻的花藝付出過這麼多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870217,
					"content": "希望她的願望能實現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "#感謝兩位，{F#妳}{M#你}們真是善解人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "暫時沒有問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "#如果{F#妳}{M#你}們有空，隨時都可以來找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}