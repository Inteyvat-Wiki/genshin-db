							9442.872
						],
						"pointId": 12536
					}
				]
			},
			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}！快過來這邊！給{F#妳}{M#你}看一個超級棒的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000102,
					"content": "#噹噹——！{F#妳}{M#你}看，這是我費了好大勁，才從這個亂糟糟的市集裡挖到的好寶貝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000103,
					"content": "這留影機…看起來很有年代感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "聽那個神秘兮兮的賣家說，這可是幾十年前，楓丹那位超級有名的攝影大師——皮埃爾·勒布朗先生用過的留影機哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000107,
					"content": "據說啊，他當年用這臺留影機拍攝的畫片，每一張都很受歡迎，時不時就會登上《蒸汽鳥報》的頭條呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000108,
					"content": "#如果{NICKNAME}也用了這麼厲害的相機，說不定也能拍出傳世名作呢！搞不好還能賣出天價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000109,
					"content": "這相機…應該不便宜吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "欸嘿嘿，還好啦！派蒙也是有悄悄存下一點「應急儲備金」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000111,
					"content": "#只要{NICKNAME}喜歡，這點摩拉不算什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000116,
					"content": "謝謝妳，派蒙。我很喜歡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "#太好了，{F#妳}{M#你}喜歡就好！剛好我們來到了新的國家，這裡一定有很多好玩的好看的，把這些統統都拍下來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000119,
					"content": "#新的留影冊，我也早就替{F#妳}{M#你}準備好了。是不是超級貼心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000120,
					"content": "好啦好啦，我們一起去發掘那些有趣的地方吧！出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000117,
					"content": "我會努力用它拍出好畫片的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "派蒙沒有遇上無良商人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "放心啦，為了確保萬無一失，我已經拜託一位非常可靠的工程師幫忙鑑定過了，這就是勒布朗大師當年使用的那個型號，錯不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000114,
					"content": "而且，工程師拆開機器的時候，還發現內部有一個小小的、刻著他名字縮寫的印記呢。這可是獨一無二的證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000115,
					"content": "#哼哼，身為{F#妳}{M#你}的嚮導，我還是很靠得住的。關鍵時刻絕不出錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000104,
					"content": "派蒙打算做古董生意了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "#才不是呢！這是我特地為{F#妳}{M#你}準備的驚喜禮物!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}