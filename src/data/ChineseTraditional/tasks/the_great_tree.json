				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "#旅行者，真巧，又見到{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270202,
					"content": "妳還在研究嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "嗯，拉德普和法爾希說還需要搜集更多數據，我就只能繼續我的工作啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270204,
					"content": "不過，也不知道那些根系現在是什麼情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270205,
					"content": "#旅行者，如果{F#妳}{M#你}有空的話，就請再幫我去記錄一下那些根系的情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				}
			]
		},
