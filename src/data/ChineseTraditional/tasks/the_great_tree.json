			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "果然還是得好好照看一下啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270102,
					"content": "妳在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#{F#妳}{M#你}是…喔，看樣子是位旅行者，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270104,
					"content": "我是阿彌利多學院的學生，雅絲敏，正在這裡研究這棵「聖樹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270105,
					"content": "這棵「聖樹」歷經的歲月，比奧摩斯港裡所有手抓飯的飯粒數量加起來都多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270106,
					"content": "同時它又托舉著教令院…重要性堪比唐杜爾烤雞底下墊著的蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270107,
					"content": "這都是些什麼比喻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "但如果它出了問題，那須彌城也會面臨巨大的災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270111,
					"content": "比如，它遭到了蟲害，比屋頂還大的蝗蟲從樹的內部衝出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270112,
					"content": "或者是它的枝幹生長失去控制，龐大的根系宛如洪水般從地底湧出，摧毀了所有房屋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270113,
					"content": "又或者，這棵「聖樹」飛速枯萎，倒下的樹身壓垮了半個須彌城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270114,
					"content": "應，應該不會這樣吧？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "喔，那當然，到目前為止，它的情況一切正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270116,
					"content": "#但話也說回來，在{F#妳}{M#你}去樹林摘蘑菇的時候，襲擊{F#妳}{M#你}的蕈獸也不會提前告知{F#妳}{M#你}它們的到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270117,
					"content": "我之所以在此研究，也是在觀察這棵大樹的情況，為各種可能發生的意外做準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270118,
					"content": "#不過如{F#妳}{M#你}所見，就算我的思維如同暝彩鳥一般敏捷，但我的體力也如同星蕈一般孱弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270119,
					"content": "#所以旅行者，{F#妳}{M#你}能幫我去記錄幾處「聖樹」根系的狀況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270120,
					"content": "平常我都會雇傭冒險家和我同行，但現在他們似乎都沒空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270121,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "你們學者都是這麼說話的嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "#欸？{F#妳}{M#你}是說這些比喻嗎？抱歉呀，我的說話方式一直是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270124,
					"content": "學院裡也有很多人和我說過這個問題，但我一時半會是改不回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270125,
					"content": "#那這件事就拜託{F#妳}{M#你}了，我就在這裡等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230270108,
					"content": "派蒙肯定能聽懂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "真是一棵很偉大的樹啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "派蒙"
				}
			]
		},
