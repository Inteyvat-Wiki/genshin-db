					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "#{F#妳}{M#你}們回來了，聖樹根系的情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230271102,
					"content": "向雅絲敏敘述了根系的情況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "…喔，既然有生物聚集在那裡，那就說明那塊土地還有著很強的活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230271104,
					"content": "聖樹的根系一定也能安穩地生長，暫時不會出太大的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230271105,
					"content": "唯一要擔心的問題…就是周圍的水體會不會過營養化，從而滋生更多的蕈獸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230271106,
					"content": "#喔，這是{F#妳}{M#你}們的報酬，謝謝{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "雅絲敏"
				},
