			"dialogs": [
				{
					"id": 732441901,
					"content": "「充能轉化容器」，希望拿到那個東西以後，就能夠讓奔奔恢復過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441902,
					"content": "如果實在不安心的話，我也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441903,
					"content": "妳在這裡陪奔奔吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "#嗯，那我就在這裡等{F#妳}{M#你}的好消息，一定要安全回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441904,
					"content": "我們馬上就會回來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
