			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "怎麼會…我居然忘記了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440102,
					"content": "希望還來得及，至少，得去他的帳篷裡先找一找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440103,
					"content": "婕德！咦，怎麼了，妳現在正要去哪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440104,
					"content": "#派蒙，還有{NICKNAME}…{F#妳}{M#你}們倒是來的正好，嗯，我現在得立刻去辦件事情，我要去…阿德菲住的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440105,
					"content": "阿德菲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440106,
					"content": "#那個傢伙不是和愚人眾勾搭在一起的叛徒嗎…哦！我懂了，{F#妳}{M#你}是想去搜刮他的帳篷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440107,
					"content": "不，我對那傢伙留下來的東西毫無興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440108,
					"content": "部族對這些叛徒遺留的東西應當如何處置有特定的規矩，哼…要不是因為這個，我恨不得把那傢伙留下的東西全部燒光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440109,
					"content": "我要去他的帳篷是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440110,
					"content": "是因為奔奔吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "啊，對哦！奔奔在阿德菲那裡，這可怎麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440112,
					"content": "嗚，婕德，妳怎麼把奔奔交給了那樣的傢伙呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440113,
					"content": "唉，在、在那之前，我也不知道他是叛徒啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440114,
					"content": "總之，得快點去阿德菲那裡看看才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}，我們也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440116,
					"content": "事不宜遲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "嗯，奔奔可千萬別出事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440117,
					"content": "現在就出發吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "快看，這裡好像有點東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440302,
					"content": "不過看起來不像是一份什麼檢查紀錄，而是一封信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440303,
					"content": "什麼信，快打開看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440304,
					"content": "看這封信上的意思，奔奔原來只是沒有能量了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440305,
					"content": "這麼一想，不管是打開赤王陵的大門，還是為我們啟動了許可權，奔奔在一路上幫我們做了很多事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440306,
					"content": "就算是奔奔，也會覺得累吧…可能就是因為為我們做了那麼多事，所以它才失去了能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440307,
					"content": "上面提到有什麼特殊的「充能轉化容器」，可是帳篷裡好像沒有看到類似的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440308,
					"content": "難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440309,
					"content": "藏在某個地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "不太像，只是用來維修奔奔的話，也不用特地藏起來，直接使用不就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440311,
					"content": "我明白了！一定是這場交易還沒發生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440314,
					"content": "所以奔奔沒被阿德菲帶到交易現場，當然也沒有「充能轉化容器」…那剩下的問題只有一個了，阿德菲交易的對象是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440315,
					"content": "哈，真是問了個蠢問題，會和他在部族外做這種交易的恐怕只有一類人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440316,
					"content": "是須彌的學者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "是愚人眾啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440320,
					"content": "那我們現在怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440321,
					"content": "還能怎麼辦，跟那群愚人眾還有什麼好話可說，當然是到了交易地點，把那些「充能轉化容器」搶過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440322,
					"content": "好欸，搶過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440323,
					"content": "可是奔奔…奔奔現在的狀態，沒法攜帶在身上，當然也不可能帶去交易現場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440324,
					"content": "如果放在別的地方，也並不安全。把它獨自留在別處這種事…有一次就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440325,
					"content": "#那就這樣好了，我和{NICKNAME}去搶愚人眾，妳和奔奔在這裡等著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440326,
					"content": "好耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "好耶！我們去搶愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440330,
					"content": "#雖然很想自己去，但是…{NICKNAME}、派蒙，奔奔能不能恢復，就拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440331,
					"content": "以及，雖然對方只是一些愚人眾，但是也要注意安全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440332,
					"content": "沒事的！就放心交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440333,
					"content": "嗯，我也…不能讓奔奔留在阿德菲這個叛徒這裡，我先把它帶到我那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440334,
					"content": "等拿到「充能轉化容器」，就在我的帳篷那會合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440328,
					"content": "搶愚人眾！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "嗯嗯，反正也不是第一次啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732440318,
					"content": "是愚人眾！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "想也知道，不會有別人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732440312,
					"content": "還沒有拿到？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "#啊，我明白{F#妳}{M#你}的意思了，這場交易還沒有發生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "婕德"
				}
			]
