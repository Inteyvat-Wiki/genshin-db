						732441703
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441703,
					"content": "被打的人說這話還真有說服力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441704,
					"content": "說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441705,
					"content": "快說！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "#我說我說，{F#妳}{M#你}們想知道什麼我都說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441707,
					"content": "先說說你知道什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441708,
					"content": "我、我們只是一直和阿德菲做一些交易而已…據說塔尼特的主母偏愛什麼阿薩里格…還有那個新來的小姑娘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441709,
					"content": "哼，雖說不知怎麼回事，阿薩里格似乎也失蹤了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441710,
					"content": "那個女人心狠手辣，不會容留對部族失去價值的人…所以，阿德菲為了保障自己的地位聯絡了我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441711,
					"content": "之前我們在沙漠裡的工作開展一直不是很順利，這下倒是、倒是有點一拍即合的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441712,
					"content": "失去價值…你是什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "我不知道…我真的不知道！那是他們沙漠人內部的事務…不過要我猜的話，可能是因為那個女人認為我們不可信任了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441714,
					"content": "…所以她才會疏遠我們，而經常與我們聯絡的阿德菲也為此不安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441715,
					"content": "畢竟我們還能撤離這個鬼地方，而他只能被榨乾價值，然後任部族處置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441724,
					"content": "只是阿德菲這個人異常狡猾，他要的東西我們給了不少，我們要的東西卻一點眉目沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441725,
					"content": "不過聽說他出事了…雖然不知道出了什麼事，但我們想，這不正好是個好機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441726,
					"content": "好機會？什麼好機會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441727,
					"content": "我們大概之後也沒有什麼和阿德菲做交易的機會，所以就讓他帶上前幾次信裡說的什麼特殊元能構裝體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441728,
					"content": "如果可以就奪過來，等過幾天我們完全撤離了以後，也不算毫無所得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441729,
					"content": "什麼，原來你們也想來搶東西，怪不得，既沒有貨物也沒看見那些「充能轉化容器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441730,
					"content": "啊？「也」想來搶東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441731,
					"content": "對，快把「充能轉化容器」交出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "唔，不會那個什麼「充能轉化容器」也是你們編的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441734,
					"content": "不，「充能轉化容器」倒是真的，不過因為也是古代的東西，有很多，但不知道其中有沒有能用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441735,
					"content": "那這些「充能轉化容器」在什麼地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441736,
					"content": "派蒙的氣勢真不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#嘿嘿，是嘛…{NICKNAME}不要轉移話題啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441738,
					"content": "快、快把你們放東西的地點說出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441739,
					"content": "…就在附近的一個據點，這個就是據點的鑰匙…我知道的我全告訴你們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441740,
					"content": "走吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "好好好，我這就消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441741,
					"content": "別讓我們再看見你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "遇上我們算你運氣不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "你們在沙漠裡的工作…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "…機密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441718,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#你看，你惹{NICKNAME}生氣啦！{M#他}{F#她}生氣的後果很嚴重哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441720,
					"content": "唔…！好吧，好吧！請別生氣，我說就是了！雖然…雖然我知道的也不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441721,
					"content": "我們的任務是調查沙漠住民各部族現狀，以貿易的方式拉攏和滲透他們，吸引賢者注意…為須彌城內的執行官大人提供方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441722,
					"content": "另外…佛羅德洛克教授也在沙漠裡尋找活體樣本，他一向不服從「博士」大人的領導…要我說，這就是嫉妒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "愚人眾交易人員"
				},
				{
					"id": 732441723,
					"content": "咳咳，扯多了、扯多了…總之，阿德菲是我們的聯絡人，我們的物資交易一直由他負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "愚人眾交易人員"
				}
			]
		},
