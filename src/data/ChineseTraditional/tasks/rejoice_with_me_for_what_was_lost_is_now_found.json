			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "啊，是奔奔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441002,
					"content": "幸好阿德菲還沒來得及把奔奔帶走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441003,
					"content": "不如說，這裡的東西都跟之前一模一樣，根本沒有變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441004,
					"content": "這傢伙不會以為自己能夠成功推翻主母，然後安然無恙地回到自己的帳篷裡吧…？真是自大的蠢貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441005,
					"content": "不過也多虧了這份愚蠢，奔奔才沒出什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441006,
					"content": "這也叫沒出什麼事嗎…奔奔，奔奔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441007,
					"content": "怎麼會變成這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "對啊，它怎麼躺在地上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441010,
					"content": "奔奔到底出了什麼事呀，上次見到的時候還好好的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441011,
					"content": "奔奔…在離開聖顯廳之後，就逐漸變得虛弱起來了，看起來像是有什麼地方出了故障，發出的聲音也越來越小…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441012,
					"content": "直到發不出聲音，甚至也沒法移動，就像是，擁有的生命力一點一點流失掉了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441013,
					"content": "那個時候，整個部族裡，除了阿德菲，沒人對奔奔身上發生什麼有概念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441014,
					"content": "所以我就把奔奔放在了阿德菲這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441015,
					"content": "怎麼會這樣…奔奔，奔奔不會就這樣再也醒不了了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441016,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441017,
					"content": "總之，奔奔既然還在，總有一天能找到讓它恢復的辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441018,
					"content": "可像這樣，一點頭緒都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732441019,
					"content": "我想想，我記得上次阿德菲還和我說，不是什麼很嚴重的問題，這兩天就會有結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441020,
					"content": "按這傢伙的習慣，如果做了什麼檢查，肯定會留下什麼紀錄才對。我們在周圍先找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441021,
					"content": "如果不是什麼「嚴重的問題」的話，說不定我們也能解決一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732441008,
