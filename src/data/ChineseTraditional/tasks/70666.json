			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "#喵！「真是了不起，恭喜{F#妳}{M#你}突破了牌手等級的試煉，現在已經是高級牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660202,
					"content": "喵？「只是完成一次試煉就成為了高級牌手？哎呀，因為世上大部分人把打牌視為玩樂，所以不太認真對待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660203,
					"content": "「也就是說，認真玩樂的人反倒才是少數。但是，就算是玩樂，也有認真投入的價值。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660204,
					"content": "#喵！「啊，對了，現在{F#妳}{M#你}獲得了我的認可，也可以挑戰酒館裡其他的傢伙設下的牌局，嗯…他們應該會喜歡{F#妳}{M#你}的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660205,
					"content": "其他的傢伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "喵。「嗯，當然和我一樣，是酒館裡的貓…可別小看他們。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660207,
					"content": "喵~「到時候就讓恕筠為他們執牌吧，好了，按照慣例，得說一句那個！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660208,
					"content": "#「{NICKNAME}，希望{F#妳}{M#你}能感受到『七聖召喚』的樂趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
