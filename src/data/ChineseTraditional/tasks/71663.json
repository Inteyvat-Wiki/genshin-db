			"completionStepIds": [
				7166302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166302",
							"2"
						],
						"stepId": 7166302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"娜扎法琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716630101,
					"content": "#{F#妳}{M#你}遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630102,
					"content": "我確實遇到了一些棘手的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630103
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630103,
					"content": "草王在上，二位大人一定是來拯救可憐的娜扎法琳的大英雄吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630104
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630104,
					"content": "對了，這就是所謂的那個什麼…呃？天冷有人送被子？雨、雨中送炭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630105
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630105,
					"content": "呃…這是什麼須彌人特有的說話方式嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630106,
						716630107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630106,
					"content": "恐怕只是她特有的說話方式…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				},
				{
					"id": 716630108,
					"content": "而且是雪中送炭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630109,
					"content": "對對對，雪中送炭，這真是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630110
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630110,
					"content": "咳…先不管這些，總之妳叫做娜扎法琳對吧？那麼娜扎法琳，有什麼我們可以幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630111,
					"content": "您真是機靈，總能說到重點！事實上，娜扎法琳我正遇到我人生中最大的困難！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630112
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630112,
					"content": "#叫我派蒙就好了，這是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630113,
					"content": "#那個，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630114
					]
				},
				{
					"id": 716630114,
					"content": "很高興認識二位大人！我叫娜扎法琳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630115
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630115,
					"content": "妳之前已經說過名字了啦…所以，妳遇到了什麼困難呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630116,
					"content": "是這樣子的，我有個志向遠大的好朋友叫做芭爾瓦涅。她曾經和我說，她要製作一種讓大家都變得幸福的調味料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630117
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630117,
					"content": "欸，能讓大家都變幸福的調味料？調味料…怎麼能讓人變得幸福呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630118,
					"content": "嗯…娜扎法琳也不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630119
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630119,
					"content": "不過芭爾瓦涅說，只要加入那種調味料，無論是什麼菜都會變得格外美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630155
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630155,
					"content": "只要人們能吃到格外美味的菜，一定就會感覺到幸福了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630120
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630120,
					"content": "唔喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630121,
					"content": "一下子就被說服了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630122
					]
				},
				{
					"id": 716630122,
					"content": "她之所以要出發去旅行，也是為了找到製作那種調味料的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630123
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630123,
					"content": "不過，她邊旅行邊研究，就像一隻忙碌的小蜜蜂。我身為她最好的朋友，卻只能留在須彌幫不上什麼忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630124
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630124,
					"content": "多麼可憐。所以我想為她做點什麼，順著她之前和我聊過的想法，我想了又想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630156
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630156,
					"content": "一連茶不思飯不想地想了好幾天，我終於知道我能做什麼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630125
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630125,
					"content": "茶不思飯不想好像不是這麼用的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630126,
					"content": "噢，謝謝您的提醒。璃月的熟語真的是很難運用呢，我要多多學習才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630127
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630127,
					"content": "我們回到話題上來吧，然後妳想出了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630128,
					"content": "我想出了一個辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630157
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630157,
					"content": "那就是…我也可以依照芭爾瓦涅的想法想一些調味料配方，然後再把這些調味料加入菜裡，聽聽人們對於這些菜的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630129
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630129,
					"content": "就這樣幫芭爾瓦涅做一些市場調查，再把搜集到的資訊整理起來交給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630130
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630130,
					"content": "您也是知道的，實際的調查也在研究中非常重要。這是我唯一能為我那忙碌的好朋友做的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630131
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630131,
					"content": "雖然我想出來的這種調味料配方，肯定不是她想要的那種調味料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630132
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630132,
					"content": "但大家對於這種調味料的回饋，一定能給聰明的芭爾瓦涅幫助，讓她快快地做出那種很厲害的調味料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630133
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630133,
					"content": "所以我來了七國之中，以飲食文化出名的璃月！據說這裡民以食為天，一定能給我非常多的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630134
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630134,
					"content": "所以，其實配方妳還沒有想出來？要我們幫忙想配方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630135,
					"content": "噢不，草王在上，想配方這件事情，還是讓身為須彌人的我來做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630136
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630136,
					"content": "須彌人非常擅長在料理裡使用調味料，您瞧，和二位大人談話間我已經想好一個配方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630137
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630137,
					"content": "所以，我要再次謝謝二位大人！二位大人真的是來拯救可憐的娜扎法琳的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630138
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630138,
					"content": "不客氣…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630139,
					"content": "所、所以我們到底要幫妳什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630140
					]
				},
				{
					"id": 716630140,
					"content": "事實上，嗯…雖然我想出了一些調味料的配方，但是可憐的娜扎法琳在璃月一個人都不認識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630141
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630141,
					"content": "而且我不是專業的冒險家，收集這麼多的原料對我來說，難度實在太高，不亞於手無縛雞之力的菜鳥獨闖鍍金旅團的老巢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630142
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630142,
					"content": "鍍金旅團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630143
					]
				},
				{
					"id": 716630143,
					"content": "噢，那是須彌的雇傭兵組織，只要給錢他們什麼都幹。有些成員甚至還能役使一些詭異的力量，非常難纏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630144
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630144,
					"content": "光是想想就覺得可怕，讓我們回到之前的話題上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630145
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630145,
					"content": "#現在，娜扎法琳想要拜託派蒙閣下和{NICKNAME}閣下，按照配方收集原料，再製作出調味料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630146
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630146,
					"content": "再把調味料加到料理裡，請二位大人熟悉的人試吃，最後把感想記錄下來給娜扎法琳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630147,
						716630148
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630147,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630149,
					"content": "妳早說呀。就交給我們吧，我們認識的人可多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630150,
					"content": "草王在上，感謝二位大人的熱心腸！這段時間我也會陸續想點配方，等新的配方想出來之後，會直接告訴二位大人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630151
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630151,
					"content": "請收下這口鍋子，這是我請須彌工匠特製的，用它一定能做出讓大家都幸福的調味料的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630152
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 716630152,
					"content": "#{NICKNAME}快行動起來吧！我為{F#妳}{M#你}當第一位試吃員，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716630153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630153,
					"content": "怪不得妳這麼積極想幫忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630154
					]
				},
				{
					"id": 716630154,
					"content": "嘿嘿…快點快點！我們該行動啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716630148,
					"content": "就是找人試吃啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630149
					]
				},
				{
					"id": 716630107,
					"content": "以前遇到的須彌人都不是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716630108
					]
				}
			]
		}
	]
}