							8663.825
						],
						"pointId": 9241
					}
				]
			},
			"dialogs": [
				{
					"id": 250280301,
					"content": "啊…箱子好像被打壞了…上面的唱片也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250280302,
					"content": "應該是那傢伙把我們往那邊帶的，唉…他到底是從哪裡學來這一身毛病的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280303
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280303,
					"content": "#{F#妳}{M#你}們是被米盧·努伊先生拜託來取唱片的吧？我之前有看到{F#妳}{M#你}們在和他談話，猜得出{F#妳}{M#你}們的來意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280304
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280304,
					"content": "我們都是「流泉之眾」的人。那傢伙…之前還算是好人，最近不知道從哪裡學來那一身壞毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280305
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280305,
					"content": "抱歉，忘了自我介紹。我是利洛，再次替我的…同伴，向您道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280306
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280306,
					"content": "…這個談話場面實在不太講究，如果是在部族裡的話，至少還能請您喝個一杯水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280307,
						250280309
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280307,
					"content": "作為冒險家，我已經習慣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280308
					]
				},
				{
					"id": 250280308,
					"content": "是嗎？看您的模樣和剛才的身手，的確也像是一位經驗豐富的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280313,
					"content": "咳…先不說這些，我們先收拾一下周圍吧。我會把唱片碎片收集好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280314
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280314,
					"content": "#我和{F#妳}{M#你}們一起去見米盧·努伊先生，必須要向他當面道歉才可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280309,
					"content": "你曾經和璃月人一起工作過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280310
					]
				},
				{
					"id": 250280310,
					"content": "是的。我曾經被一位璃月的先生僱用，陪著他一起進山去探查礦脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280311
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280311,
					"content": "在和他一起工作的那段時間裡，我受益良多，他在離開納塔時，還送給我一個璃月的名字——「逸揚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280312
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280312,
					"content": "據他說，這是代表著「在空中飄逸飛揚」的意思。呃…雖然我是不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "利洛"
				}
			]
		},
