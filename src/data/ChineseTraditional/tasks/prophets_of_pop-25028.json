			"dialogs": [
				{
					"id": 250280401,
					"content": "很好！兩位戰鬥的英姿真是讓人印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280402
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280402,
					"content": "不僅很有力，而且非常有節奏，簡直就像是拿著指揮棒在指揮這場戰鬥啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280403
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280403,
					"content": "最重要的是…唱片也非常完整！感謝您，我的那些朋友們總算能睡個好覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280404
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280404,
					"content": "咦，等等…節奏？沒錯，我要找的就是這種節奏感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280405
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280405,
					"content": "用這種節奏作為基礎旋律…不對，要選用聲音更低沉的樂器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280406
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280406,
					"content": "這些東西給您，請您收下吧！利洛老兄，我們快回部族去，我有靈感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280407
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280407,
					"content": "見鬼，我要把那些節奏記下來…對了，衣服，我要記在衣服上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
		},
