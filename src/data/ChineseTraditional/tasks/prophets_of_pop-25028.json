				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米盧·努伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280101,
					"content": "完了，完了！我的流行大作…要被吃光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280102
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280102,
					"content": "早知道這樣，我還不如讓帕卡把唱片放在兒童歌曲區…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280103
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280103,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280104
					]
				},
				{
					"id": 250280104,
					"content": "#{F#妳}{M#你}是…等等，{NICKNAME}！太好了，{F#妳}{M#你}來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280105
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280105,
					"content": "#我有重要的事情要委託給{F#妳}{M#你}！納塔的…不對，世界流行音樂的未來！就等著{F#妳}{M#你}去拯救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280106,
						250280107
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280106,
					"content": "你、你慢慢講！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280109
					]
				},
				{
					"id": 250280109,
					"content": "請您快點去拯救我的唱片！不然他們就要被那群小鰭游龍吃掉…或者被那些不懂音樂的傢伙毀掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280107,
					"content": "欸？你怎麼看出來我擅長唱歌的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280108
					]
				},
				{
					"id": 250280108,
					"content": "呃…那個…我很高興您有這種特長，之後我們也許可以合作…但現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280109
					],
					"speakerTitle": "米盧·努伊"
				}
			]
		},
		{
			"id": 2502802,
			"completionStepIds": [
				2502807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502807",
							"2"
						],
						"stepId": 2502807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2502802",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米盧·努伊",
					"利洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280201,
					"content": "好，利洛老兄，我們今天的目標就是那群傢伙了，做好準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280202
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280202,
					"content": "沒問題，都準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280203,
						250280204
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280203,
					"content": "又在忙著做唱片？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				},
				{
					"id": 250280205,
					"content": "您好啊，居然能在這裡見到您。沒錯，我們正在為新的歌曲取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280206
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280206,
					"content": "上次的事情之後，我和利洛老兄仔細談了談有關唱片的問題，獲得了不少新靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280207
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280207,
					"content": "您說得太誇張了。我只是建議米盧·努伊先生換一個方法，或是找其他素材來製作音樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280208
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280208,
					"content": "我之前在部族中聽到的音樂，有些甚至把武器的碰撞聲、戰鬥的吶喊聲、人奔跑的腳步聲加進歌曲之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280209
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280209,
					"content": "這樣子做出的歌曲很受歡迎，傳播的速度也很快…我想，也許這就是米盧·努伊先生想要的「流行感」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280210
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280210,
					"content": "沒錯！所以我們一直在尋找戰士，想要看看他們是怎麼戰鬥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280211
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280211,
					"content": "那你們找到取材對象了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280212
					]
				},
				{
					"id": 250280212,
					"content": "找到了，就是前面那幾位！我們在部族裡打聽到這群人一直在外面尋找對手，實力也很強…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280213
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280213,
					"content": "咳…簡單來說，這群人成天在外面惹事，遇到人就上去問：「要不要切磋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280214
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280214,
					"content": "如果輸給他們，還會被逼著拿出東西作為輸掉的賭注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280215
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280215,
					"content": "我也有好幾位音樂家朋友被他們劫掠…真是不可原諒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280216
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280216,
					"content": "沒錯，部族裡的人也快受不了了，想要找人去教訓一下他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280217
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280217,
					"content": "聽起來不像是什麼正常人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280218
					]
				},
				{
					"id": 250280218,
					"content": "誰知道他們怎麼想的？說真的，我從來都不理解這種人的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280219
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280219,
					"content": "要是您願意的話，就和利洛老兄一起去教訓他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280220
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280220,
					"content": "您的身手我早有見識。如果能看見您施展拳腳，我一定能夠找到更多、更好的靈感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280221
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280221,
					"content": "但…請您注意！如果那群傢伙手裡有唱片的話，您千萬不要弄壞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280222
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280222,
					"content": "不然我那些音樂家朋友一定會再暈過去一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280223,
						250280224
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280223,
					"content": "沒問題，你看好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280225,
					"content": "好啊！哈哈哈，那就太好了，有您幫忙，我一定能夠做出最優秀的歌曲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280224,
					"content": "讓你見識一下我的身手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280204,
					"content": "你們在取材嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				}
			]
		},
		{
			"id": 2502803,
