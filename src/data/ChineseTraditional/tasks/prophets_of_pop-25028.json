			},
			"dialogs": [
				{
					"id": 250280801,
					"content": "您把我的唱片拿回來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280802
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280802,
					"content": "你的唱片為什麼會被牠們搶走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280803
					]
				},
				{
					"id": 250280803,
					"content": "這個…說來話長…我本來剛做出一首全新的歌曲，主題是歌頌春天和動物之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280804
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280804,
					"content": "結果帕卡那小子聽完之後，伸手就把我的歌又放到了兒童區！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280805
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280805,
					"content": "還說什麼這種有趣又簡潔的曲調，孩子們和龍寶寶們一定會喜歡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280806
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280806,
					"content": "可惡！我做的是正經的流行樂，不是什麼兒童歌曲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280807
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280807,
					"content": "我氣不過，就帶著唱片來這裡，想要自己享受一下自己做的音樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280808
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280808,
					"content": "結果…聽著聽著，一群小鰭游龍就聚集了過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280809
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280809,
					"content": "還沒等我反應過來，牠們就一下子竄了過去，一口咬起唱片跑掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280810
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280810,
					"content": "我本來想要追著牠們過去，但追到一半卻發現有一群看起來很暴躁的人聚在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280811
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280811,
					"content": "說不定就是那群傢伙指使小鰭游龍搶走我的唱片，他們一定在覬覦我的音樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280812
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280812,
					"content": "#啊啊啊——不能再說了！冒險家，算我米盧·努伊求求{F#妳}{M#你}了，快去把我的唱片拿回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280813
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280813,
					"content": "如、如果可以的話…還請您盡量讓我的唱片保持完整。不然，我這幾天的努力…全都白費了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
		},
