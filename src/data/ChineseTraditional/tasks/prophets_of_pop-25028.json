				]
			},
			"dialogs": [
				{
					"id": 250280701,
					"content": "啊…我的唱片…這個是原型唱片…原型唱片啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280702
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280702,
					"content": "非常抱歉，如果有什麼我可以幫上忙的，您儘管說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280703,
						250280704
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280703,
					"content": "至少不是孤本…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280704,
					"content": "至少沒有失傳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280705,
					"content": "算了，都碎成這樣…也沒有辦法再修復了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280706
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280706,
					"content": "事到如今，我只想問你一個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280707
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280707,
					"content": "…你們在聽我的唱片時，有覺得好聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280708
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280708,
					"content": "不是那種會吸引孩子和龍寶寶們的「好聽」，而是那種…有流行感的「好聽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280709
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280709,
					"content": "你懂嗎？在你們聽這個唱片時，有這種感覺嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280710
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280710,
					"content": "流行感？那個…您稍微等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280711
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280711,
					"content": "你們之所以派龍寶寶來搶走唱片，就是因為喜歡裡面的流行感，對不對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280712
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280712,
					"content": "那個，您聽我解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280713
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280713,
					"content": "我們…從來沒有「指使」過龍寶寶們去拿您的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280714
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280714,
					"content": "是牠們…被您唱片裡的歌曲吸引，才自己跑了過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280715
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280715,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280716
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280716,
					"content": "您的歌曲非常優秀啊！相信我，每次我放您的唱片時，龍寶寶們都圍著我們瘋狂地跑，開心得要命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280717
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280717,
					"content": "什麼？可惡…我的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280718
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280718,
					"content": "我明白您的心情。這麼優秀的唱片被毀壞，我很抱歉——但我願意和您一起再次製作唱片！有我在，沒有人可以再搶走您的唱片了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280719
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280521,
					"content": "我的唱片！不是這種兒歌啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
		},
