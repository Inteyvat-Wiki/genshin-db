			"dialogs": [
				{
					"id": 250281201,
					"content": "很好！兩位戰鬥的英姿真是讓人印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281202
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250281202,
					"content": "不僅很有力，而且非常有節奏，簡直就像是拿著指揮棒在指揮這場戰鬥啊！但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281203
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250281203,
					"content": "…那些碎成不知道幾片的唱片，實在是這場演奏中的不和諧音符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281204
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250281204,
					"content": "願大靈保佑我那些倒楣的朋友們…無論如何，我至少能把一部分唱片帶回去給他們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281205
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250281205,
					"content": "這些東西給您，請您收下吧！利洛老兄，我們回部族去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281206
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250281206,
					"content": "希望我的好朋友們不會暈倒，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
