			"dialogs": [
				{
					"id": 250280501,
					"content": "我的唱片！太好了，這些唱片沒有損壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280502
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280502,
					"content": "非常抱歉。米盧·努伊先生，我的同伴搶走了您的唱片，我替他向您道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280503
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280503,
					"content": "唱片沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280504
					]
				},
				{
					"id": 250280504,
					"content": "#呼…{F#妳}{M#你}說得沒錯，這個是原型唱片，要是損壞的話，我非去跳崖不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280505
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280505,
					"content": "…這位叫利洛的老兄，你也別低著頭了。既然唱片沒事，我也不會太計較這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280506
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280506,
					"content": "你只需要回答我一個問題，今天的事就可以一筆勾銷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280507
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280507,
					"content": "請您說吧，我一定會盡力回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280508
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280508,
					"content": "你們在聽我的唱片時，有覺得好聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280509
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280509,
					"content": "不是那種會吸引孩子和龍寶寶們的「好聽」，而是那種…有流行感的「好聽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280510
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280510,
					"content": "你懂嗎？在你們聽這個唱片時，有這種感覺嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280511
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280511,
					"content": "流行感？那個…您稍微等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280512
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280512,
					"content": "你們之所以派龍寶寶來搶走唱片，就是因為喜歡裡面的流行感，對不對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280513
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280513,
					"content": "那個，您聽我解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280514
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280514,
					"content": "我們…從來沒有「指使」過龍寶寶們去拿您的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280515
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280515,
					"content": "是牠們…被您唱片裡的歌曲吸引，才自己跑了過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280516
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280516,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280517
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280517,
					"content": "您的歌曲非常優秀啊！相信我，每次我放您的唱片時，龍寶寶們都圍著我們瘋狂地跑，開心得要命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280518
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280518,
					"content": "什麼？可惡…我的唱片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280519
					],
					"speakerTitle": "米盧·努伊"
				},
				{
					"id": 250280519,
					"content": "我明白您的心情，如此珍貴的唱片居然會遭到威脅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280520
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280520,
					"content": "但我願意做您的無償護衛，直到您做出一張新唱片為止！有我在，就沒有人可以再搶走您的唱片了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280521
					],
					"speakerTitle": "利洛"
				},
				{
					"id": 250280521,
					"content": "我的唱片！不是這種兒歌啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米盧·努伊"
				}
			]
