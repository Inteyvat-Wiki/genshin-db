					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "凝光…甘雨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160302,
					"content": "暗流湧動的這些天裡，她們所處的位置，究竟是在第幾層呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "那個自稱甘雨的使者，丟下這幾句話，就消失了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161002,
					"content": "不過，我們居然收到了「璃月七星」的邀請函，真是不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}！跟有錢人見面，一定要注意禮儀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161004,
					"content": "我本來就很講禮貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "呵呵…有幸受邀前往「群玉閣」作客的人，確實很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10161007,
					"content": "#{F#妳}{M#你}們去吧，不過別忘了「送仙典儀」的事。{F#妳}{M#你}們從群玉閣回來以後，我們下一步會合的地點，是荻花洲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10161008,
					"content": "嗯，我們不會忘的。約好時間，荻花洲，不見不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161005,
					"content": "派蒙又在盤算什麼主意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}