				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "#嗯，{F#妳}{M#你}們來了。不必點單，我都已經點好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160102,
					"content": "這家「三碗不過港」，可不像蒙德的那些酒館。在這裡，酒肆主人是會拒絕果汁這種「不上道」的東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160103,
					"content": "所以這次，終於能被請一杯酒了？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "#所以這次，我給{F#妳}{M#你}點了一碗酒釀圓子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160105,
					"content": "哈。我也不是猜不到這種結局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "…各位客官要是願意聽，我就繼續講講凝光大人的「群玉閣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160107,
					"content": "哇，這裡還有說書人！氛圍真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160108,
					"content": "所謂市井盛讚，除了酒好，當然環境也要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160109,
					"content": "但這裡所說的「環境」，與「提瓦特遊覽指南」裡評判大酒樓的「環境」，就是兩種意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160110,
					"content": "列位都知道，在咱們這港口上邊呀，有那雲上仙府、煙霞行宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160111,
					"content": "什麼叫手眼通天？您瞧瞧，這就叫手眼通天，這就是凝光大人置辦下的通天產業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160112,
					"content": "在那天朗氣清之時，您從那宮門外的甲板上往下一望——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160113,
					"content": "好厲害！那就是大半個璃月港的天地風光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160201,
					"content": "您且想想，這玩意雖是紙屑，但凝光大人用來決策的「思路」，那得多珍貴呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160202,
					"content": "您要能多搶一兩張，這凝光大人指縫裡漏出的好處，就能比同行多得一兩分囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "田鐵嘴"
				},
				{
					"id": 10160203,
					"content": "「天權」凝光…最近一直聽到這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160204,
					"content": "璃月人在談她，「愚人眾」討厭她，藏「仙祖法蛻」的好像也是她，「請仙典儀」上我們還見過她一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160205,
					"content": "不知道她究竟是個怎樣的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160207,
					"content": "#終於找到{F#妳}{M#你}了，「絕雲間歸來之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160208,
					"content": "誰？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160209,
					"content": "派蒙，我們走…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "#請等一下。我不是千岩軍，也不是前來緝拿{F#妳}{M#你}們的捕快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160211,
					"content": "#但我的確是「璃月七星」的使者——我是甘雨，月海亭的秘書，為見{F#妳}{M#你}們而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160212,
					"content": "使者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "確切地說，本職工作是對「七星」全體負責的秘書，而這次的臨時身分，是凝光小姐的特別使者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160215,
					"content": "哇，說凝光，凝光…的使者到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160216,
					"content": "絕雲間歸來之人…恕我身處坊間，禮數不周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160217,
					"content": "但我帶來的這封信，是凝光小姐以「天權」身分，正式擬定的邀請函。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160218,
					"content": "邀請您前往那座「天上的宮殿」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160219,
					"content": "妳說…邀請函？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160220,
					"content": "是的。凝光小姐是這樣說的：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160221,
					"content": "#「請{F#她}{M#他}來。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160222,
					"content": "#「我要見{F#她}{M#他}。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160223,
					"content": "#「在群玉閣，我會陪{F#她}{M#他}一根一根地…剪斷繁雜的暗流之線。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160213,
					"content": "秘書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
			"id": 101603,
			"completionStepIds": [],
