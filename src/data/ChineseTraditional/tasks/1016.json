	"talks": [
		{
			"id": 101601,
			"completionStepIds": [
				101607,
				101609
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101609",
							"2"
						],
						"stepId": 101609,
						"stateName": "QUEST_STATE_UNFINISHED"
