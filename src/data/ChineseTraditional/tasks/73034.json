				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "#唔？{F#妳}{M#你}在看什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340202,
					"content": "這筆記本裡寫著照顧花的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "真的嗎？我也看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340204,
					"content": "「…需要安置於開闊地帶，多接受日照…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340205,
					"content": "柯萊應該是沒來得及把它搬出去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340206,
					"content": "嘿嘿，那我們來幫柯萊照顧一下這盆花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340207,
					"content": "唔…總之，先把這盆花搬出去，就放在屋子旁邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340208,
					"content": "也別放太遠了，不然柯萊回來找不到的話會著急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "咦？這封信…看起來好像是柯萊留下的，我們去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340602,
					"content": "但她人怎麼還是不在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "也許又是和提納里一起出去工作了吧，他們一直都很忙的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340604,
					"content": "還是快看看信吧。看這筆跡，柯萊下筆的時候還真用力呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340605,
					"content": "#「{NICKNAME}和派蒙，謝謝你們幫我照料這盆花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340606,
					"content": "「這段時間林子裡有太多事要處理，我一忙起來就會忘記打理…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340607,
					"content": "「再次謝謝你們幫忙，等我有空了，我們一起去賈漢吉爾先生的店裡吃『馬鈴薯船』吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340608,
					"content": "喔！你看，柯萊說要請我們吃好吃的！記下來記下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340609,
					"content": "就是不知道柯萊到底在處理什麼事，感覺她都要忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730340610,
					"content": "希望她能好好休息，別累壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}