					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "在一斗的連番催促下，眾人再次前往秋沙錢湯…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "哈哈哈！這裡應該就是最熱的了！今天我們就來比一比誰能在溫泉裡堅持最久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930203,
					"content": "呵呵，一斗兄如此盛情，我又怎麼能不奉陪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 401930204,
					"content": "我說…這又不是在洗三溫暖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930205,
					"content": "溫泉…好暖和…呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 401930206,
					"content": "不、不要在浴池裡睡著啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401930207,
					"content": "唔…毛皮變得好重，感覺有點頭暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 401930208,
					"content": "哈哈哈！五郎兄弟！可別說這就不行了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930209,
					"content": "喂——浴場內禁止喧譁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 401930210,
					"content": "與此同時，在另一邊…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "呵呵，一斗兄弟還是那麼有精神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930212,
					"content": "兄長，對局中分神可不好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401930213,
					"content": "#哦哦——比賽已經來到了最膠著的階段！{NICKNAME}會怎麼應對呢？兩位大師！你們有什麼看法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 401930214,
					"content": "嗯…如果是我的話，會考慮步步為營，鞏固優勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401930215,
					"content": "唔…積極進攻，險中求勝…也是一個好辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "鹿野院平藏"
				},
				{
					"id": 401930216,
					"content": "（穩紮穩打…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "哦？竟有如此妙手？看來我敗局已定，不必繼續了。那按照之前抽籤的順序，接下來就該輪到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930219,
					"content": "綾華，要玩得開心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401930220,
					"content": "#啊…好！好的！{NICKNAME}，請多指教…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401930221,
					"content": "（綾人這傢伙，八成是想讓綾華多玩一下才故意輸的吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "（賭一把！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
