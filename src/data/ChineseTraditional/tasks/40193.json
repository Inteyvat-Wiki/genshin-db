			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "#哦！摯友，聽說{F#妳}{M#你}們昨晚去了「秋沙錢湯」對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930102,
					"content": "#我打算找所有人再去「秋沙錢湯」好好地慶上一回功！怎麼樣？{F#妳}{M#你}也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930103,
					"content": "欸，可是昨晚不是已經去過一次了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401930104,
					"content": "呃…妳看這不是還有昨晚沒去成的嗎？譬如阿忍…五郎…還有綾人兄弟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401930105,
					"content": "簡單來說，是老大聽說過後自己很想去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401930106,
					"content": "#總…總之！{F#妳}{M#你}要是逛得差不多了，就來跟我說一聲，大家一起去泡！溫！泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
