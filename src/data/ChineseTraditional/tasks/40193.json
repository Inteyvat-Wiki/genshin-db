			"dialogs": [
				{
					"id": 401930301,
					"content": "老闆！這「三川花祭」可真不錯！這幾天來我們這裡的遊客數量比平時翻了三倍啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930302,
					"content": "這個月的營業金額…恐怕能有這個數字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930303,
					"content": "很不錯嘛…看來這個月說不定能正面擊敗八重堂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930304,
					"content": "什麼事情這麼高興？怎麼不叫我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930305,
					"content": "啊哈…也沒什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930306,
					"content": "哦，我倒是有個好消息忘了跟妳分享…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930307,
					"content": "「三川花祭」的三成收益都會記到八重堂的帳上哦。這個月應該能創紀錄了吧？來恭喜我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930308,
					"content": "什麼——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 401930309,
					"content": "那…那不如，恭喜老闆在第三百三十三次挑戰八重堂營收的嘗試中，取得了亞軍的好成績！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 401930310,
					"content": "呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 401930311,
					"content": "…祝願今夜，人人皆得「好夢」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
