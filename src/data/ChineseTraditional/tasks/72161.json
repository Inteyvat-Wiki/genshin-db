			"dialogs": [
				{
					"id": 721610601,
					"content": "外國人，最近如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610602,
					"content": "抱歉，這裡不是待客的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610603,
					"content": "#不過…我很高興{F#妳}{M#你}能來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610604,
					"content": "你看起來好多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "#嗯，又欠{F#妳}{M#你}一個人情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610606,
					"content": "哈哈，真可惜我又撐下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610607,
					"content": "這不是好事嗎。有什麼可惜的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610608,
					"content": "接下來有什麼打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "我還沒想好接下來怎麼做，不過我想我不會回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610611,
					"content": "雖然九條政仁公子人還不錯，但是他家的老頭子正叫喚著抓逃兵立威呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610612,
					"content": "我可不能撞到他的刀口上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610613,
					"content": "或許我會脫下這身甲冑吧，就這樣一個人過日子也不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610614,
					"content": "直到平靜的日子沒辦法讓我自欺欺人，記憶告訴我自己依然是那個染血的傷兵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610615,
					"content": "唉…總之，以後的事，誰知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610616,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "話說回來，我從未質疑過大御所大人的一切決定，所以我想，即使離去也不會有什麼悔恨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610619,
					"content": "唔…話題突然變沉重了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610620,
					"content": "啊，說到這裡…我也該去拜訪一下老戰友了，他們還一直在這座島上陪著我呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610621,
					"content": "稻妻的傳統是獻上「血斛」，一種嬌貴妖豔的花朵…是武人宿命的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610622,
					"content": "#順便，如果{F#妳}{M#你}接下來在旅途中遇到了我的老戰友們，也請勞煩停留一下，認識認識他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610617,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "有想過回去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
