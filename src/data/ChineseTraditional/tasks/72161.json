			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "#把草藥搗成藥糊還要很長時間，{F#妳}{M#你}可以走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610506,
					"content": "#…不，我不是在趕{F#妳}{M#你}走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610507,
					"content": "過一段時間再回來吧，能有個人聊聊天…也不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610508,
					"content": "我明白的。",
