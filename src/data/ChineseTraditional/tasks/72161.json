			"trigger": {
				"objectNames": [
					"稻葉久藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "哼，真是丟人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610102,
					"content": "明明救了你一命，你還罵我們丟人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610103,
					"content": "他在說他自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "想不到我會落到被外國人搭救，又任之評頭論足的境地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610106,
					"content": "唔…話說回來，武士先生，你還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610108,
					"content": "看起來滿有精神的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "#我欠{F#妳}{M#你}們一個人情，外國人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610111,
					"content": "還有，剛才打得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610112,
					"content": "#{NICKNAME}，有幸相識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "少得寸進尺了，外國人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610114,
					"content": "…稻葉藤三郎久藏，叫我久藏就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610115,
					"content": "那些是什麼人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "是海賊，名椎灘一帶有不少他們的據點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610118,
					"content": "流竄的賊人、失去主業的礦工和漁民、「眼狩令」逃犯，或者戰爭兩方的逃兵，有時就會紮堆嘯聚，墮落成賊匪…妄圖逃脫大御所大人的制馭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610119,
					"content": "「浮浪人」也好，「海亂鬼」也好，一群無法無天之徒…我們前陣子一直在清剿他們，直到叛軍毀掉了島上的鎮物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610120,
					"content": "踏鞴砂與礦場的難民紛紛逃離，其中一些鼠輩投奔此間，充實了海賊的隊伍，他們就更加肆無忌憚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610121,
					"content": "剛剛那群海賊是從南邊營地來的，他們盯上了這艘船上的貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610122,
					"content": "只可惜我礙了他們的事，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610123,
					"content": "這不是你的船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "這艘？原本是珊瑚宮叛軍的船。我也不太清楚…總之我來到這裡的時候，船上就已經沒有人影了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610125,
					"content": "於是，我就住下來了，像寄居蟹一樣活到現在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610126,
					"content": "這麼長時間以來，這還是我頭一次說這麼多話。真是累人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610127,
					"content": "#對了，如果{F#妳}{M#你}不介意的話，順便幫我一個忙吧…等我養好傷，欠下的人情總會還{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610128,
					"content": "我剛剛提過，周圍的海賊營地，幫我清理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610129,
					"content": "只有這樣，野狗一樣的海賊才不會繼續來騷擾我。或許還能威懾其他海賊營寨，令他們不敢輕易打這艘破船的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610130,
					"content": "#那就讓我再看看{F#妳}{M#你}的本事，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610131,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "哼，淨是大話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610134,
					"content": "對了，外國人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610135,
					"content": "別太得意了，下去時小心別摔壞了腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610132,
					"content": "去去就回。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "你為什麼會被圍攻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "很明顯自尊受了傷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "是武士特有的矯揉造作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
