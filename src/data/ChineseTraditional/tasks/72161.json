					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "保重，外國人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻葉久藏"
				},
				{
