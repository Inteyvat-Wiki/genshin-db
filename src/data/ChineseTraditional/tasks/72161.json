				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "#怎麼又是{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611402,
					"content": "#我不是跟{F#妳}{M#你}說過——唉，算了。隨{F#妳}{M#你}高興吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611403,
					"content": "#別弄亂了我的東西，船上補給還夠分{F#妳}{M#你}一點。滿意了就快點離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611404,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "#不需要。{F#妳}{M#你}沒看到我過得很好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611406,
					"content": "但你的傷口…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "#那是我的傷口，不是{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611408,
					"content": "喂，我們是出於好心才問的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721611409,
					"content": "#那我也出於好心回答{F#妳}{M#你}們：別煩我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611410,
					"content": "我可以幫你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "怎麼幫我，把我交給幕府軍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611412,
					"content": "#哈哈，我勸{F#妳}{M#你}別傻了…我會被當成逃兵的。九條大人對逃兵從不留情面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611413,
					"content": "#{F#妳}{M#你}要是真想幫我，就讓我一個人好好靜靜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721611414,
					"content": "哇，這個固執的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
