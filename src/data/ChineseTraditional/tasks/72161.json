					"稻葉久藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "#{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610302,
					"content": "都解決了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "哇…突然氣氛好奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610305,
					"content": "#拜託{F#妳}{M#你}這個局外人做這種髒活，實在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610306,
					"content": "你不像這麼客氣的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610309,
					"content": "藥草已經用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610310,
					"content": "之前用來外敷的已經見底了，但傷口還沒有消腫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610311,
					"content": "不過…沒必要擔心我，我還撐得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610312,
					"content": "#去關心{F#妳}{M#你}自己的事情吧，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610313,
					"content": "像個小孩子一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610315,
					"content": "#{F#妳}{M#你}說什麼…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610316,
					"content": "在說你呀，就像個小孩子一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610317,
					"content": "明明情況很糟糕，就差哭著鼻子喊救命了，卻還是強撐著裝硬漢…一點也不坦誠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610318,
					"content": "只有小孩子才會這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610319,
					"content": "而且久藏先生，你可不要忘了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610320,
					"content": "你還欠著我們人情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "#哼…真拿{F#妳}{M#你}們沒辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610323,
					"content": "那就請幫我弄來些鳴草吧，在這座島上隨處可見。葉片飽滿的最好，方便榨出漿液外敷消炎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610324,
					"content": "就這樣吧。讓我小睡一下，別再煩我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻葉久藏"
				},
				{
					"id": 721610321,
					"content": "我們是來幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "傷口好點了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "足夠安生一陣子了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
