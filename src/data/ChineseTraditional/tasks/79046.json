			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "可惡，根本不可能躲開這一大片視線，這是耍賴，耍賴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461002,
					"content": "好想把那些幽魂的機關一腳踢翻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461003,
					"content": "等等，「小水珠」，你要幹什麼？那邊是幽魂的視野，危險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461004,
					"content": "吵鬧的傢伙，你瘋了嗎？還是你已經放棄希望了，想要和你的同伴在另一個世界相見？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "憤怒的幽魂首領"
				},
				{
					"id": 790461005,
					"content": "不對，它要用身體遮擋視線…怎麼會有這麼古典的獻身思想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "愉悅的幽魂首領"
				},
				{
					"id": 790461006,
					"content": "事態出現了轉機！落單的水形幻靈攔在了幽魂前方，慢慢化為了石像，用自己的身體擋住了致命的視線！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790461007,
					"content": "「小水珠」…主動變成石頭了…全都是為了讓我們拿到鑰匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461008,
					"content": "「小水珠」還能恢復！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "對、對哦！只要被幽魂盯住的時間不長，應該沒有問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461011,
					"content": "難道「小水珠」反過來利用了這一點？好聰明，好勇敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}，我們趕快去找鑰匙，拿回解藥，不要讓「小水珠」難受太久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461009,
					"content": "我們要抓緊時間！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
