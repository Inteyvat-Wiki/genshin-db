			"dialogs": [
				{
					"id": 790460901,
					"content": "「小水珠」變成不能動的石頭了，還能喝下解藥嗎？而且，水要怎麼喝水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460902,
					"content": "難道說，這種藥劑是外用的？我們快試試看！",
					"roleType": "TALK_ROLE_NPC",
