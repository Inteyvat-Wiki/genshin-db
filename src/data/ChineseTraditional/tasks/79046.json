			"dialogs": [
				{
					"id": 790460101,
					"content": "參演人員已就位，所有機關運轉正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790460102,
					"content": "「黛依阿的三日遐想」之「瞳孔裡的固形魔咒」，正式開幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790460103,
					"content": "在幽深詭異的密林邊緣，兩位兼具學識與膽量的智者，發現了一位落單的水形幻靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790460104,
					"content": "誰來幫幫我…我不想拋棄我的伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460105,
					"content": "「小水珠」？「小水珠」居然說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460106,
					"content": "其實是喇叭在代它說話吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "原來如此，這位「小水珠」就是話劇裡的關鍵演員了，要和我們配合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460109,
					"content": "真是萬幸，兩位智者對於水形幻靈的言語早有研究，聽懂了水形幻靈的求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790460110,
					"content": "這簡直是命運的安排！如此令人感動的相逢，豈有不幫水形幻靈的道理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790460111,
					"content": "我們也有新的設定嗎？聽起來滿厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460112,
					"content": "還是言歸正傳吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "我們…我們在森林裡迷路時，找到了一座古堡，不小心吵醒了古堡裡的幽魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460115,
					"content": "兩個幽魂首領對我們降下了…魔咒，只要被幽魂們看見，就會變成石頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460116,
					"content": "我好不容易才逃出來，但其他同伴都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460117,
					"content": "嗚…他們一定很痛苦…這是我們的錯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460118,
					"content": "當然不是了，就算有起床氣，也不能這樣欺負人家吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460119,
					"content": "可惡…把迷路的「小水珠」變成石頭這種事，已經不是欺負的程度了，那些幽魂都是超級壞傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460120,
					"content": "把它們狠狠修理一頓的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "應該沒辦法，兩個幽魂首領從來不露面，古堡又很大，本領再強的人都無法找到它們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460123,
					"content": "但我聽其中一個幽魂說，古堡深處的寶箱裡，有著破除魔咒的古老藥劑，那是唯一的希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460124,
					"content": "寶箱被鎖在一間密室裡，還需要找到附近的鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460125,
					"content": "可是，我已經中了魔咒，獨自回到古堡的話，肯定會被其他幽魂盯上，慢慢石化，最後永遠被固定住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460126,
					"content": "那也沒什麼難的嘛！就由我們來護送你，回到古堡裡去尋找鑰匙，拿到最關鍵的藥劑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460127,
					"content": "只要幫你避開那些什麼…幽魂的視線，應該就沒問題了吧？聽起來不算難嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460128,
					"content": "#沒錯，{F#妳}{M#你}們是…智者，{F#妳}{M#你}們應該有辦法…求求{F#妳}{M#你}們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790460129,
					"content": "派蒙很快就進入了角色嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "嘿嘿，聽起來還滿簡單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460132,
					"content": "雖然不能把幕後黑手揍一頓，但你可以打趴所有幽魂，幫「小水珠」救出同伴還不是輕輕鬆鬆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460133,
					"content": "放心吧，「小水珠」，我們一起出發，找到那個藥劑，解除你身上的魔咒，救出你的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790460130,
					"content": "準確猜到了劇情的走向哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "是不是就能救出你的同伴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "你的同伴怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "當成「小水珠」的臺詞就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
