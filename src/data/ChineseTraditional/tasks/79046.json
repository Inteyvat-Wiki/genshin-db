			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "來自喇叭的旁白繼續描述著眼前的神奇景象——\\n兩位智者將藥劑輕輕滴在水形幻靈的石像上，奇妙的現象發生了…\\n時間彷彿發生了倒轉，石化的水形幻靈恢復如初…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "嗚…原來徹底變成石頭是這樣的感覺…好難受好難受，不能讓同伴們繼續忍受這種委屈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461103,
					"content": "「小水珠」，你怎麼一聲不吭就衝了上去，嚇死我了啦！還好我們馬上就拿到了解藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461104,
					"content": "剛才那些幽魂一直在怪叫，我好害怕，完全不敢說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461105,
					"content": "#而且{F#妳}{M#你}們是智者，我覺得，根本不用我來提醒{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461106,
					"content": "#就算我徹底變成了石頭，拿到解藥後，{F#妳}{M#你}們也會第一時間救我的，和之前沒什麼區別，不用這麼著急！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461107,
					"content": "呃啊…難道，難道是我太投入了嗎？只顧著擔心「小水珠」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461108,
					"content": "投入也是好事哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "噫！明明是來玩的遊客，自己卻演上癮了，有點難為情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461111,
					"content": "總之…我們已經成功了，接下來，你就拿著這份解藥，去拯救你的同伴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461112,
					"content": "#謝謝，太謝謝{F#妳}{M#你}們了，我…無比感激{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461113,
					"content": "#我和夥伴們會一直牢記{F#妳}{M#你}們的恩情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "落單的水形幻靈"
				},
				{
					"id": 790461114,
					"content": "沒關係！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "也不知道那些壞傢伙會不會繼續搗亂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461117,
					"content": "你們以後在森林裡玩的時候，還要小心一點，不要再到這個古堡來了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461118,
					"content": "可喜可賀，可喜可賀！兩位智者無懈可擊的計策與水形幻靈的勇氣形成了完美的配合，幽魂魔咒的危機即將被徹底解除！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790461119,
					"content": "智者們的到來讓幽魂們不敢再肆意妄為，落單的水形幻靈和夥伴們又可以無憂無慮地玩耍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790461120,
					"content": "原本陰森詭異的密林，漸漸展現出了寂靜與祥和的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790461121,
					"content": "「瞳孔裡的固形魔咒」全劇終，感謝您的觀看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790461122,
					"content": "好了，我們完成了「瞳孔裡的固形魔咒」！代入感還不錯嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461123,
					"content": "這樣看來，如果臺詞和旁白恰當，確實能影響觀眾的情緒呢…黛依阿究竟是從哪些地方學到的這些方法的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461124,
					"content": "如果有機會見到黛依阿，我們仔細問問她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790461115,
					"content": "不用客氣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "表示派蒙很享受！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
