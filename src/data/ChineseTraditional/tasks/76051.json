			"dialogs": [
				{
					"id": 760510301,
					"content": "這樣就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510302,
					"content": "~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510303,
					"content": "哦！它已經開始畫起來了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510304,
					"content": "咳咳，請各位評委拭目以待，這次天才月靈畫家梅拉，又會為我們呈現出怎樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510305,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510306,
					"content": "欸！這就畫好了？我好不容易為你編的熱場詞都還沒說完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510307,
					"content": "哦！果然這次畫的也是哥倫比婭嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510308,
					"content": "看起來真美好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "這是…在挪德卡萊的森林裡嗎？有好多小動物欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510311,
					"content": "那恐怕…是我還沒離開「霜月之子」的時候才有的景色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510312,
					"content": "哇，好羨慕，那些小動物真的會這麼聚集過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510313,
					"content": "嗯，牠們大多是喜歡我散發出的月矩力，覺得趴在我身旁睡覺會很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510314,
					"content": "天啊！那豈不是可以隨便摸牠們也不會亂跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510315,
					"content": "唔…最好摸的應該是帔髦獾，牠的尾巴又大又蓬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510316,
					"content": "凜角鹿脖子上的毛也很軟，用來當枕頭會睡得很舒服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510317,
					"content": "#{F#妳}{M#你}們喜歡哪一種呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510318,
					"content": "為什麼是以我們也體驗過為前提問的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510319,
					"content": "但要說試的話…我可能會想摸摸帔髦獾的尾巴吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510320,
					"content": "有些帔髦獾很怕生，如果周圍不是很安全的話，牠們是不會讓人摸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510321,
					"content": "啊…不過派蒙要小心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510322,
					"content": "欸？怎麼了？牠們會咬人嗎？我…我不會把牠們摸生氣的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510323,
					"content": "不，是要小心天上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510324,
					"content": "天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510325,
					"content": "嗯，有的長翎䴉會捕捉小體型的動物。以前也是在我提醒之後，牠們才慢慢改掉了捕捉月靈的習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510326,
					"content": "這種危險在我們第一次見面的時候就該說呀！我到今天都沒被抓走已經是奇蹟了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510327,
					"content": "唔…好吧，下次見到長翎䴉的時候，我會提醒牠們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510328,
					"content": "現在就去提醒吧！不然我都不敢出這個門了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510329,
					"content": "那我應該和長翎䴉們說，派蒙是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510330,
					"content": "最好的夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "對對，不能把好夥伴抓走哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510336,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510337,
					"content": "這孩子…好像對派蒙被長翎䴉抓走的樣子很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510338,
					"content": "不要拿這種畫面來當素材呀喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510332,
					"content": "最好的嚮導。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "#呃…{F#妳}{M#你}這麼記著我倒是很開心，但長翎䴉不知道什麼叫「嚮導」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510334,
					"content": "吃了會吃壞肚子的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "不要以吃進肚子為前提啦！萬一長翎䴉真的想試試看怎麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510309,
					"content": "看起來真開心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
