			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}、派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510102,
					"content": "怎麼了，哥倫比婭？妳看起來像是遇到了什麼麻煩一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510103,
					"content": "#{F#妳}{M#你}們身邊有顏料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510104,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510105,
					"content": "呀！你是…是梅拉對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510106,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510107,
					"content": "你又想要畫畫了嗎？怎麼還把自己身上弄得到處都是顏料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510108,
					"content": "它出去一趟回來之後，就變成了這樣子。這些顏料一時間也洗不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510109,
					"content": "難道是外出取材的時候遇到麻煩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510110,
					"content": "不過這樣看起來也不錯啦，很有藝術氣息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510111,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510112,
					"content": "哦！說回顏料，只要像上次一樣給它一些有顏色的東西就行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510113,
					"content": "~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510114,
					"content": "嘿嘿，看它這麼開心，一定是取材的時候找到了些不錯的靈感吧！還是很歡快的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510115,
					"content": "那我們這次找些溫暖、愉快的顏色給梅拉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
