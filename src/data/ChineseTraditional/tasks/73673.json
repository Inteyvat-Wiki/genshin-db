				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "#{F#妳}{M#你}好，歡迎來到聚砂廳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730102,
					"content": "#這裡是「三十人團」彼此聯絡、協調事務的地方，看裝束，{F#妳}{M#你}並不是他們的成員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730103,
					"content": "#我明白了，{F#妳}{M#你}是聽到招募消息，來應募的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730106,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "果然如此，很好。以防萬一，我再次說明一下工作的情況與內容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730108,
					"content": "我名叫阿芬迪，受教令院委派擔任聯絡員一職，負責疏通協調教令院和「三十人團」之間的合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730109,
					"content": "#{F#妳}{M#你}可能知道，「三十人團」受教令院雇傭，負有護衛整個須彌城的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730110,
					"content": "除此之外，他們還負責處理居民們在生活中遇到的部分困難，這樣一來，整體的工作量就很大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730111,
					"content": "為了分擔壓力，我和掌旗官商量之後，決定招募一位協助人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730112,
					"content": "#當然，城內的關鍵防務工作並不需要{F#妳}{M#你}勞心，只要協助解決居民們的生活委託就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730113,
					"content": "至於生活委託的具體內容，大都比較細碎繁瑣，為了方便理解我還是舉幾個例子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730104,
					"content": "應募？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "#{F#妳}{M#你}還沒細看招募內容就來了嗎？算了，這也沒關係，我來說明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "阿芬迪"
				}
			]
		},
		{
			"id": 7367302,
			"completionStepIds": [
				7367302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367302",
							"2"
						],
						"stepId": 7367302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "#大致就是這樣的委託工作，如果{F#妳}{M#你}有意願也有空閒接手的話，那就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730202,
					"content": "#我和後勤官已經協商好，{F#妳}{M#你}接手後，每完成一項工作，都能獲得充足的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730203,
					"content": "#雖然這些委託裡小事居多，但我希望{F#妳}{M#你}不要小看這份工作的尊嚴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730204,
					"content": "#能幫助大家解決生活中遇到的困難，所有人都會衷心感激{F#妳}{M#你}、尊重{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730205,
					"content": "#只要堅持下去，{F#妳}{M#你}在居民中的聲望想必也會提高，大家也會更願意接納{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730206,
					"content": "#到那時，我也會把更複雜更重要的工作交給{F#妳}{M#你}處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730207,
					"content": "#好了，這份工作的大致情況就是這樣，希望{F#妳}{M#你}能好好考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730208,
					"content": "#如果{F#妳}{M#你}決定接手的話，隨時歡迎前來登記領取委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				}
			]
		}
	]
}