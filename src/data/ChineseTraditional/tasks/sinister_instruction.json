				{
					"id": 721411801,
					"content": "你來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411802
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411802,
					"content": "你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "謝謝你寬恕我的罪惡，請讓我回歸於你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411804,
					"content": "你在和我說話嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "什麼…但為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411806,
					"content": "我主持了每一次祭獻，我接受了你的每一場恩典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411807,
					"content": "而她，被你所標記，為你所成就，卻逃離你的恩賜，背叛了我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411808,
					"content": "你在說什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "呀啊！唔呃…對不起…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411810,
					"content": "不應該懷疑「他」的選擇，繼續隱忍，繼續拜祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411811,
					"content": "聽得到我說話嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "繼續隱忍…繼續拜祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "鷲津"
