			},
			"dialogs": [
				{
					"id": 721410601,
					"content": "#如何？「他」的教誨，{F#妳}{M#你}是否有幸聽到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410602,
					"content": "什麼也沒聽到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "無妨，無妨，「他」在看著，「他」在聽著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410605,
					"content": "「他」很欣慰，而喜悅「他」的人，必獲得獎賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410606,
					"content": "「他」的獎賞不在彼岸，就在明天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410607,
					"content": "你知道自己在說什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "下次再來此處，自見分曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410608,
					"content": "恕我淺薄，道理尚有不明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "福分淺薄，無緣一聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				}
			]
		},
