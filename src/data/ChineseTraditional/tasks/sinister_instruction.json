				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411101,
					"content": "拜祭，傾聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411102,
					"content": "「他」因傾聽而強大，因強大而能見一切，能聽一切。由是而無所不見，無所不聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411103,
					"content": "珊瑚宮的愚人也好，鳴神島的妄人也好，對此毫無理解，毫無感受。所以他們只知道互相廝殺，讓血蒙蔽雙眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411104,
					"content": "#但{F#妳}{M#你}要理解這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411105,
					"content": "什麼亂七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "答案就在拜祭中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411108,
					"content": "切記，每日拜祭三番，必有回賜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411106,
					"content": "大概能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				}
			]
		},
