			"dialogs": [
				{
					"id": 721411201,
					"content": "「他」要來了！不要停止拜祭！不能停止拜祭！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411202,
						721411203
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411202,
					"content": "你還好嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "「他」在慍怒，「他」要發怒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411205,
					"content": "什麼…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "因為什麼！因為那個女人！那個拒絕恩賞的邪佞之人！邪佞之人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411208,
					"content": "女人…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "她在逃跑，但她怎麼逃得過「他」！十八雙血色的眼睛！千千萬萬鋒利的毒牙！永遠渴求鮮血的、數不清的口與舌！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411211,
					"content": "她躲不過的，躲不過的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411212,
					"content": "啊，沙的寡情的國度，龜縮雨林自稱智慧的愚昧乞丐，你們統統庇護不了她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411213,
					"content": "請你冷靜一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "#{F#妳}{M#你}拿到了恩賞，速去拜祭！速去拜祭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411214,
					"content": "哦哦，說得好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "哦哦，真該死！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "哦哦，要發怒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "哦哦，「他」要來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
