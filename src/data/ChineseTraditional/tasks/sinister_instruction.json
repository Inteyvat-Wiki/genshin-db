					"鷲津"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "必須平息「他」的怒火，必須安撫「他」的憤怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411702,
					"content": "#{F#妳}{M#你}做得很好，{F#妳}{M#你}做得很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411703,
					"content": "#切記，有的人會戴著面具，欺騙{F#妳}{M#你}，但「他」會幫助{F#妳}{M#你}，「他」永遠襄助{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411704,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "那個女人就像傳說中的狐狸妖怪，我放跑了她，「他」很生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411707,
					"content": "「他」現在又生氣了…這是我的罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411708,
					"content": "請原諒我…我會再次獻祭，我會為您尋找下一個「回歸」的祭品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411709,
					"content": "請原諒我，請原諒我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411710,
					"content": "請原諒我，請原諒我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411705,
					"content": "好吧…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
		},
