			},
			"dialogs": [
				{
					"id": 721410701,
					"content": "與「他」的莫大福澤相比，這只不過是一點小小賞賜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410702,
					"content": "祈禱吧，拜祭吧，傾聽「他」，並且讓「他」傾聽你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410703,
					"content": "#然後，{F#妳}{M#你}將同我一樣，聽到「他」的話語，從{F#妳}{M#你}的心內傳出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410704,
					"content": "#然後，「他」將引{F#妳}{M#你}脫離苦痛，得大恩賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410705,
					"content": "唔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "記住，每日拜祭三番，必有回賜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410708,
					"content": "切記，切記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410706,
					"content": "隨便你怎麼說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
			]
		},
