					"鷲津"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721410101,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410106,
					"content": "你在聽我講話嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410108,
					"content": "你好…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "#…請{F#妳}{M#你}不要打擾我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410111,
					"content": "「他」很不悅，不悅於口舌之語的擾亂，遮蔽了「心之語」的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410112,
					"content": "口舌之語…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "口舌之語就像驟雨，敲振耳膜，攪擾心智。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410114,
					"content": "而「心之語」則像霧氣，自然而來，氤氳而入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410116,
					"content": "噓…！「他」在聽著，「他」在說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410117,
					"content": "不要用口舌，不要用耳朵，用心來聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410118,
					"content": "來這裡，拜祭，祈禱，然後傾聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410119,
					"content": "要拜祭三番，記住，三番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410120,
					"content": "（試試好了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "還是不了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "如果能說話就點點頭吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
