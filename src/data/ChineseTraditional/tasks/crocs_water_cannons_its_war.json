{
	"id": 73527,
	"type": "WQ",
	"name": "鱷魚？水炮？大作戰！",
	"description": "#偶然闖入某片「危險區」後，{F#妳}{M#你}和派蒙發現了一位特別的工程師，他正操作的裝置似乎大有來頭…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2023,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
