	"talks": [
		{
			"id": 7352701,
			"completionStepIds": [
				7352701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352701",
							"2"
						],
						"stepId": 7352701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沙蒂永"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735270101,
					"content": "#沒想到啊，被警告後，{F#妳}{M#你}們兩位不是直接離開，而是順著廣播的聲音找過來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270102
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270102,
					"content": "#不好意思，這個遊樂設施還沒正式開放，要麻煩{F#妳}{M#你}們再等一下，幾分鐘就好，我正在做最後的調試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270103,
						735270104
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270103,
					"content": "你在謀劃什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				},
				{
					"id": 735270105,
					"content": "我們聽見了很危險的詞——水炮！應該就是那邊的大東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270106,
					"content": "嗚哇！光看外形就很嚇人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270107,
					"content": "你想在這裡搞什麼東西？我們不能坐視不理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270108,
					"content": "不不不，兩位誤會了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270109
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270109,
					"content": "我是遊樂設施「飛迸湍流大作戰」的負責人沙蒂永，這個設施只是個以海上大戰為背景的，輕鬆愉快的遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270110
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270110,
					"content": "#「飛迸湍流大作戰」得到了伊迪婭女士的批准，安全性{F#妳}{M#你}們大可放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270111
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270111,
					"content": "要是不信我，可以看看伊迪婭女士簽名的文件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270112
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270112,
					"content": "可疑的工程師沙蒂永找來了相關證明，均為用詞相當嚴謹正式的文書，每一份都可見伊迪婭字跡靈動的簽名。\\n旁邊還附上了幾句祝福，單論字跡和用字風格，的確是伊迪婭本人沒錯…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735270113
					]
				},
				{
					"id": 735270113,
					"content": "原來是伊迪婭允許的遊樂設施啊…嚇我們一大跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270114,
					"content": "那你提到過的水炮，是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270115,
					"content": "只是一個簡單的比喻而已，遊樂裝置的全名實在太長了，一般人肯定會根據外形，直接叫它們水炮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270116
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270116,
					"content": "不過，這種裝置發射的水球是無害的，只不過打中靶標後，飛濺的水可能把附近遊客全身弄濕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270117
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270117,
					"content": "有的人喜歡被水打濕後冰涼涼的感覺，有的人卻很討厭濕漉漉的衣服貼在身上，不能讓後者心情不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270118
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270118,
					"content": "如果有餘力，我還想在附近佈置一些警示牌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270119
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270119,
					"content": "沒想到你還挺貼心的嘛，說得很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270120,
						735270121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270120,
					"content": "我也有點好奇了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270122,
					"content": "其實是「鱷型渦流聚引原理鱷式外甲海戰用重型艦炮式娛樂水球發射炮」，兼顧了原理和外形的準確命名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270123
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270123,
					"content": "真的好長！完全沒記住也沒理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270124,
					"content": "但簡稱成水炮，好像又缺少了一點氣勢？那不如就叫它…「鱷鱷炮炮」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270125,
					"content": "這種疊詞的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270126
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270126,
					"content": "很形象！既簡單好記，又模擬了海戰過程中，炮彈飛掠而過的聲音，我覺得好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270127
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270127,
					"content": "鱷鱷~炮彈來襲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270128
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270128,
					"content": "鱷鱷~水球發射！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270129,
						735270130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270129,
					"content": "你認真的嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270131,
					"content": "#總而言之，我覺得我們很合拍！{F#妳}{M#你}們一定也能在這個遊樂設施中找到獨一無二的樂趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270132
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270132,
					"content": "#不如，就由{F#妳}{M#你}們兩位來當「飛迸湍流大作戰」的第一批遊客吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270133
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270133,
					"content": "遊戲的原理很簡單！調整「鱷鱷炮炮」的指向，打中各種氣球標靶，就能獲得相應的積分，得分夠高時還能獲得一些獎勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270134
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270134,
					"content": "也對，聊了這麼久，我也想試試看了，操縱「鱷鱷炮炮」究竟是什麼樣的感覺呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270135,
						735270136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270135,
					"content": "那好吧，我也來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270137,
					"content": "#完美！我這就把最後一點設備調整完畢，{F#妳}{M#你}們馬上就可以開始遊戲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270138
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270138,
					"content": "#希望{F#妳}{M#你}們玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270136,
					"content": "鱷鱷炮炮~開火！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270130,
					"content": "不准敷衍派蒙哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270121,
					"content": "它的本名是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270104,
					"content": "趕快住手吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				}
			]
		}
	]
}