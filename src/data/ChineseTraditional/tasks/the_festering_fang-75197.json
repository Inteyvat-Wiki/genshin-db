					"烏爾班"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970505,
					"content": "烏爾班開始製作武器…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "做好了！哈哈哈，來，拿好了，是不是很有份量感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970502,
					"content": "我要付多少錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "#錢？不需要，{F#妳}{M#你}能拿來這些材料讓我製作武器，我就已經很滿足了，{F#妳}{M#你}不需要再付錢給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970504,
					"content": "好了，拿著這把武器去冒險吧，你可要好好珍惜它啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏爾班"
				}
			]
		},
		{
