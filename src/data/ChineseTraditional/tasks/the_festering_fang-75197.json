			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏爾班"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "#{F#妳}{M#你}回來了，那些「牙齒」…哦，{F#妳}{M#你}已經找齊了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970103,
					"content": "#{F#妳}{M#你}們去冒險的時候，我這邊遇到了一點問題，無論我用什麼方法，都沒辦法從這枚「牙齒」上敲下來一點碎屑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970104,
					"content": "我還從沒遇到過這樣的奇事，於是就託人去問了阿貝多先生，該怎麼處理這樣的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970105,
					"content": "#於是——喏，{F#妳}{M#你}看，阿貝多先生託砂糖小姐送來了一塊符石，就擺在那邊的煉金合成台上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970106,
					"content": "欸，符石？這和我們找到的「龍牙」有什麼關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970107,
					"content": "這個嘛，按照砂糖小姐轉述阿貝多先生的說法，要想用這種材料來鍛造武器，必須先做一些特殊處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970108,
					"content": "其中一種處理方法，就是讓一枚龍牙汲取到某種和龍有關的「生命力」，再用它來處理其他龍牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970109,
					"content": "這枚符石——我想想砂糖小姐是怎麼說的——哦對，據說是「一千年前幫助蒙德反抗舊貴族的某支流浪樂團留給騎士團的遺物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970110,
					"content": "那支樂團的笛手，曾在燼寂海與當地人稱作「巴窟納瓦」的可怖魔獸交戰，從它身上斬下了這塊符石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970111,
					"content": "咦？等一下喔，如果我沒記錯的話，茜特菈莉好像說過，燼寂海是在五百年前，因為桑哈傑的戰鬥，才成為燼寂海的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970112,
					"content": "那支樂團真的是一千年前的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "哈哈，這怎麼可能有錯呢？那支流浪的樂團可是活躍在舊貴族時代的英雄，《列王與宗室史》中就有記載。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970114,
					"content": "總之，阿貝多先生說，這塊符石中就蘊藏著與龍的力量相近的「無限的生命力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970115,
					"content": "只要藉助煉金合成台，用龍牙汲取符石中的生命力，就能用它來鍛造武器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970116,
					"content": "聽、聽起來好像很厲害…該說不愧是阿貝多嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970117,
					"content": "之後要謝謝阿貝多才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#是呀是呀！否則真不知道要怎麼辦才好…總之，{NICKNAME}，我們接下來就試試汲取符石的力量吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970120,
					"content": "#哈哈，那就太好了。來，這枚「牙齒」給{F#妳}{M#你}，這件事就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970121,
					"content": "不過，煉金術的力量還真神奇啊，居然能從千年前的石頭裡提取出「生命力」…究竟是怎麼做到的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏爾班"
				},
				{
					"id": 751970119,
					"content": "好，就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
