			},
			"dialogs": [
				{
					"id": 402170401,
					"content": "你好，請問瓦雷莎和希諾寧在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170402,
					"content": "哦，是找隊長和副隊長的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170403
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170403,
					"content": "#…{NICKNAME}？我還差點以為自己認錯了，真的是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170404,
						402170408
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170404,
					"content": "愛拉尼，妳的論文怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170405
					]
				},
				{
					"id": 402170405,
					"content": "#拜託{F#妳}{M#你}不要一見面就說這麼殘忍的話，現在是難得的假期時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170406
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170406,
					"content": "再怎麼為論文頭痛，我也是血肉做的人，是會被反覆折磨人的現實打倒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170407
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170407,
					"content": "#我已經被論文打倒了，讓我在地上躺一會再重新面對吧。在這裡就不要提這件事了，我求{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170412,
					"content": "哎呀，到處都是熟人，提瓦特真小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170413,
					"content": "既然大家都認識瓦雷莎和希諾寧，那就好解釋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170414,
					"content": "我們聽說她們來雪山這裡比賽了，就來打招呼了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170415,
					"content": "瓦雷莎和希諾寧現在不在，不介意的話，可以先在營地裡等等看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170416
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170416,
					"content": "好啊，你們的帳篷很有特色呢…喔，這裡果然有好多漫畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170417,
						402170418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170417,
					"content": "安柏沒說錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170419,
					"content": "對了，有個朋友跟我們說，她聽見你們聊漫畫聊得熱火朝天，覺得很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170420,
					"content": "不知道你們在聊的是什麼漫畫，能告訴我們嗎？我也有點好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170421,
					"content": "#漫畫？原來{F#妳}{M#你}們也對漫畫感興趣嗎？呵呵，果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170422
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170422,
					"content": "所謂「烈度」與「烈度」終會相互吸引，「最強」與「最強」定會相遇，就是這個意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170423
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170423,
					"content": "#那麼，既然{F#妳}{M#你}誠心誠意地問了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170424
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170424,
					"content": "#我湯義剛就大發慈悲地告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170425
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170425,
					"content": "這部漫畫就是我們「熾魂鬥士特戰隊」的聖典——《熾魂鬥士戰記》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170426
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170426,
					"content": "#{F#妳}{M#你}接下來會問熾魂鬥士是一群什麼人？「熾魂鬥士特戰隊」又是一個什麼樣的組織？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170427,
						402170428
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170427,
					"content": "誰問了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170429,
					"content": "義剛，告訴我，熾魂鬥士的原則是什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170430
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170430,
					"content": "「第一、認為用眼淚和勸誡足以維持和平的話，就太天真了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170431
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170431,
					"content": "「第二、就算耗盡了生命，永恆的黑暗也不會為我俯首，但我依然堅持戰鬥！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170432
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170432,
					"content": "我們「特戰隊」誓死追隨熾魂鬥士，我們的宣言是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170433
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170433,
					"content": "絕不畏懼失敗與痛苦，永遠守護愛與想像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170434
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170434,
					"content": "順帶一提，剛才說到的兩條熾魂鬥士原則，出自《熾魂鬥士戰記》第六冊·暗域魔影篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170435
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170435,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170436,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170437
					]
				},
				{
					"id": 402170437,
					"content": "#怎…怎麼一點反應都沒有？{F#妳}{M#你}們難道不覺得，自己內心深處的熱情被點燃了那麼一瞬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170438
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170438,
					"content": "說實話，沒有。妳的解釋有點抽象，我沒聽懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170439,
					"content": "這是何等的挫敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170440
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170440,
					"content": "別再點燃「熱情」了，燃燒過頭的話，你們一個個都要化成灰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170441
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170441,
					"content": "太好了，副隊長回來了。妳聽我說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170442
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170442,
					"content": "#好了，我看{NICKNAME}和派蒙的表情，就知道是什麼情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170443,
						402170444
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170443,
					"content": "誰幫我解釋一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170445,
					"content": "#剛才愛拉尼和湯義剛，一定是對{F#妳}{M#你}說了一些…不太好理解的話，對吧？{F#妳}{M#你}就理解成是開玩笑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170446
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170446,
					"content": "他們剛才所說的「臺詞」，都是出自一部由八重堂出版的長篇戰鬥漫畫《熾魂鬥士戰記》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170447
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170447,
					"content": "#而那個「熾魂鬥士特戰隊」，{F#妳}{M#你}可以簡單理解為「漫畫興趣小組」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170448
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170448,
					"content": "哦…喔！這下清楚多了，那你們這個興趣小組，為什麼會在蒙德聚會呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170449,
					"content": "我不知道，但他們肯定會用氛圍啦、熱血啦之類的話回答妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170450
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170450,
					"content": "斬釘截鐵地說出來了呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170451
					]
				},
				{
					"id": 402170451,
					"content": "#愛拉尼肯定也不知道，如果{F#妳}{M#你}問的話，他們肯定會用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170452
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170452,
					"content": "我們是熾魂鬥士嘛！蓬勃的青春熱血，就要搭配最有挑戰性的場地，才能綻放出光彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170453
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170453,
					"content": "#…這樣的話來回答{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170454
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170454,
					"content": "實際上，是他們的一位隊員明妮推薦了這次聚會的舉辦場地，也提議了這次「雪山越野賽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170455
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170455,
					"content": "在多方考慮之後，他們認為這個方案很不錯，就按照明妮的建議繼續推進了下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170456
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170456,
					"content": "所以最後，「熾魂鬥士特戰隊」和我，就來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170457,
						402170458
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170457,
					"content": "那我們可以借漫畫書嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170459,
					"content": "能的能的，我來之前想著說不定能遇到對漫畫感興趣的人，特意多帶了幾本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170460
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170460,
					"content": "#{F#妳}{M#你}的朋友是哪一位？在這附近嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170461
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170461,
					"content": "其實我們是替組委會的朋友安柏來借的，就是那個綁著紅色蝴蝶結，性格很活潑的騎士——你們有印象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170462,
					"content": "哦，我記得她，她很熱心的！那我直接把漫畫拿去給她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170463
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170463,
					"content": "我和妳一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170464
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402170464,
					"content": "#那正好，就辛苦你們了。{NICKNAME}，{F#妳}{M#你}還想和瓦雷莎打招呼對吧？她正在訓練場地那邊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170465
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170465,
					"content": "希諾寧不一起來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170466
					]
				},
				{
					"id": 402170466,
					"content": "#…我才想休息一會。好吧，既然{F#妳}{M#你}都說了，那就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170458,
					"content": "我的朋友可以來看漫畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170444,
					"content": "（疑惑地搔頭）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170428,
					"content": "不是，我沒問。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170418,
					"content": "看來是漫畫迷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170408,
					"content": "我們見過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170409
					]
				},
				{
					"id": 402170409,
					"content": "不記得我嗎…倒也正常，經歷過那麼多大事，人的記性遲早會麻木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170410
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170410,
					"content": "我是愛拉尼，教令院訶般荼…下面一點點的帝利耶悉哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170411
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402170411,
					"content": "不過只要我完成了畢業論文，遲早能成為訶般荼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "愛拉尼"
				}
			]
		},
