			"dialogs": [
				{
					"id": 402170301,
					"content": "妳好啊，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170302,
					"content": "#啊，是榮譽騎士和派蒙，又見面啦！抱歉，剛才忙著說話，都沒注意到{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170303,
						402170304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170303,
					"content": "妳好，安柏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				},
				{
					"id": 402170305,
					"content": "#我正和海因茨先生在說比賽的事呢。對了，{F#妳}{M#你}們怎麼到雪山來了，該不會還有委託要處理吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170306
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170306,
					"content": "沒有沒有，我們收到了比賽的宣傳單，有點好奇，就來看看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170307,
						402170308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170307,
					"content": "湊熱鬧我等不到明天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170309,
					"content": "#那{F#妳}{M#你}們找對人了！正巧，我和海因茨先生都是大賽組委會的工作人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170310,
					"content": "#{F#妳}{M#你}好，榮譽騎士，這位想必就是派蒙了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170311
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170311,
					"content": "#我是騎士團第一小隊的佐官海因茨，很榮幸見到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170312
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170312,
					"content": "比賽還沒有正式開始，現在正是發放觀眾票和嘉賓票的階段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170313
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170313,
					"content": "#來，請兩位收下，這是為{F#妳}{M#你}們預留的嘉賓票。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170314
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170314,
					"content": "謝謝你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170315
					]
				},
				{
					"id": 402170315,
					"content": "不客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170317
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170317,
					"content": "我記得傳單上提到過一個「龍脊雪山國際越野賽組委會」，安柏說的組委會就是它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170318,
					"content": "沒錯，這屆組委會由西風騎士團成員和清泉鎮鎮民代表共同組成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170319
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170319,
					"content": "具體來說，我和海因茨先生負責管理報名流程和賽場安全，清泉鎮的各位負責裁判和後援管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170320
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170320,
					"content": "要是遇到問題，儘管找我們！我們會保障所有參賽者和觀眾開心享受比賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170321,
						402170322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170321,
					"content": "安柏一如既往可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170323,
					"content": "這屆比賽的規模比以往都要大，來了不少外國選手，甚至還有納塔人，肯定很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170324
					],
					"speakerTitle": "海因茨"
				},
				{
					"id": 402170324,
					"content": "哦，我知道你想到誰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170325,
					"content": "是那支隊伍吧…其中一位成員的頭髮是粉色的，頭上還有一對氣派的白色大角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170326
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170326,
					"content": "她的胃口尤其驚人呢！有位工作人員跟我說，他們特別喜歡和這位朋友同桌吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170327,
					"content": "哈哈，她吃起飯來特別享受，看得別人都想多添一碗飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170328
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170328,
					"content": "還有一位成員身上有一條黃黑斑紋的尾巴，一看就很好摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170329
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170329,
					"content": "不過她的樣子酷酷的，我沒好意思提這個要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170330
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170330,
					"content": "這個描述…我怎麼覺得是認識的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170331,
						402170332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170331,
					"content": "像瓦雷莎和希諾寧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170333,
					"content": "噢噢，是熟人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170334,
					"content": "要去找她們的話，那支隊伍的營地在那裡，就是那個畫著特別圖案的帳篷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170335
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170335,
					"content": "她們的營地滿漂亮的，還放了不少漫畫書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170336
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170336,
					"content": "看到了看到了，我們一會就去看看，謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170337,
					"content": "對了，如果方便的話，能幫我向她們借一本漫畫書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170338
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170338,
					"content": "那支隊伍裡的選手總是在聊漫畫，聽得我特別好奇，但我有事要忙，又走不開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170339
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 402170339,
					"content": "沒問題，包在我們身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170332,
					"content": "我們去打個招呼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170322,
					"content": "我們會來觀賽的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170308,
					"content": "來看看有沒有老朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170304,
					"content": "在忙什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				}
			]
		},
