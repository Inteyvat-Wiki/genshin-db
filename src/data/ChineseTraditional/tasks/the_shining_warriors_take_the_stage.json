			"dialogs": [
				{
					"id": 402170501,
					"content": "瓦雷莎，我們來看妳們訓練啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170502,
					"content": "#欸，是派蒙的聲音？派蒙——{NICKNAME}——好想{F#妳}{M#你}們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170503
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170503,
					"content": "和希諾寧一起解釋了與眾人相遇的前後經過。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170504
					]
				},
				{
					"id": 402170504,
					"content": "啊哈哈！愛拉尼和義剛，怎麼用了漫畫裡的臺詞來開場啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170505
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170505,
					"content": "就是啊就是啊，連我都接不上話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170506,
					"content": "如果是我，開頭應該會說：「力量啊，爆開吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170507
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170507,
					"content": "妳這話也滿不好接的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170508
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170508,
					"content": "而且，其他人和妳見面的時候，誰都還沒來得及說話，就見到妳把明妮舉起來轉了好幾圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170509
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170509,
					"content": "嗚啊，現在想想怪不好意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170510
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170510,
					"content": "畢竟這是我們第一次見面，之前只停留在互相寫信、寄插畫的環節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170511
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170511,
					"content": "這回認出明妮的時候，我一不小心就激動了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170512
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170512,
					"content": "不過，既然妳們兩個是一起來的，為什麼剛才介紹大家的時候，希諾寧說的是「『熾魂鬥士特戰隊』和我」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170513,
					"content": "聽起來好像是不同隊的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170514
					]
				},
				{
					"id": 402170514,
					"content": "因為我本來就不是這個興趣小組的成員，妮佩卡才是，這一趟我也算是替她來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170515,
						402170516
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170515,
					"content": "妮佩卡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				},
				{
					"id": 402170517,
					"content": "一切正常。能吃能睡，學習的進度也沒落下，不僅迷上了看漫畫書，甚至還認識了明妮這位筆友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170518
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170518,
					"content": "妮佩卡時不時地就來我耳朵旁邊唸，說明妮既能畫畫又會做漫畫道具，還很擅長開導人，是個很好很好的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170519
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170519,
					"content": "聽她的描述，我還一度懷疑過明妮的年齡。但這次過來一看，沒想到明妮的年紀真的這麼小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170520
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170520,
					"content": "聽說明妮提議大家參加「雪山越野賽」，妮佩卡也想來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170521
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170521,
					"content": "但…她也知道自己的身體狀況，所以就拜託我替她參加，也向明妮問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170522
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170522,
					"content": "欸嘿嘿，我之前就做好了旅行的準備，所以我和希諾寧就正好同行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170523
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170523,
					"content": "是啊，還莫名其妙給我冠了個副隊長的名號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170524
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170524,
					"content": "當、當然了！希諾寧的實力，絕對是隊長級的！就是那種…隊長級的副隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170525
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170525,
					"content": "既然是有隊長的實力，到底為什麼還要做副隊長？算了算了，我差點跟妳認真起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170526
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170526,
					"content": "反正這次過來，我也主要是為了幫妮佩卡買點《熾魂鬥士戰記》的…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170527
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170527,
					"content": "周邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170528
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170528,
					"content": "好吧，周邊。大概就是一些徽章、畫著角色的紙、漫畫的複製稿、畫著漫畫角色的硬木板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170529
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170529,
					"content": "瓦雷莎，妳為什麼用這種疑惑的表情看我，哪裡錯了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170530
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170530,
					"content": "沒錯，完全沒問題。只不過聽希諾寧這麼一本正經地介紹周邊，總感覺有點奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170531
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170531,
					"content": "全能大工匠希諾寧，抱著成箱成箱的周邊回去的畫面…哇啊，想不出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170532
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170532,
					"content": "這麼多，都是妮佩卡要的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170533
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170533,
					"content": "沒有。以妮佩卡的性格，她並不會開口要什麼禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170534
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170534,
					"content": "但以我對妮佩卡的瞭解，她收到這些…周邊的時候，會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170535
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170535,
					"content": "那是當然啦。能拿到這種禮物，妮佩卡肯定會特別開心的！嘿嘿，希諾寧這麼懂妮佩卡，簡直就是妮佩卡的姐姐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170536
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170536,
					"content": "這麼說也沒錯，我們本來就是家人。至於瞭解…我和妮佩卡相處時間不長，算略微瞭解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170537
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170537,
					"content": "呼啊…伏地挺身…瓦雷莎…我做完伏地挺身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170538
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170538,
					"content": "好，那就是做完第四組了，嗯，稍微休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170539
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170539,
					"content": "#明妮，我來為妳介紹，這兩位是我和希諾寧在納塔認識的朋友，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170540
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170540,
					"content": "金色頭髮…飛著的白色…簡直就像…蒙德的榮譽騎士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170541,
						402170542
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170541,
					"content": "正是在下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170543,
					"content": "真的是本人！我哥哥在酒館工作，經常帶回來一些小道消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170544
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170544,
					"content": "#酒客們說，{F#妳}{M#你}們走到哪個國家名聲就響到哪個國家。感覺就像漫畫裡畫的那樣，特別厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170545
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170545,
					"content": "#我能問問{F#妳}{M#你}們印象最深的冒險經歷嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170546
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170546,
					"content": "#{F#妳}{M#你}沉思片刻，看著身邊的兩位納塔友人，{F#妳}{M#你}決定講述一部分在納塔所經歷的事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170547
					]
				},
				{
					"id": 402170547,
					"content": "太震撼了，原來菲耶蒂娜生活過的國家真的有那麼奇妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170548
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170548,
					"content": "還有還有哦！我們「沃陸之邦」旁邊還有一座大火山，時不時地就會往外噴出火球！雖然很危險，但特別適合英雄的試煉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170549
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170549,
					"content": "瓦雷莎妳知道的，我一直都很想離開蒙德去外面的世界看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170550
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170550,
					"content": "可以的哦！我聽說，蒙德人是很自由的，應該…去哪裡都沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170551
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170551,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170552
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170552,
					"content": "如果要像榮譽騎士這樣，一路堅持走下去，碰到什麼危險都不退縮，得有很堅韌的內心才能做到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170553
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170553,
					"content": "#的確，很少有人像{NICKNAME}這麼厲害…但我們也可以在自己的路上努力嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170554
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170554,
					"content": "別忘了，保持韌性，堅定向前，這也是菲耶蒂娜的精神之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170555
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170555,
					"content": "也對。嗯，我要加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170556
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170556,
					"content": "而且為了和父母的約定，我也得努力練習，跑出成績。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170557
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170557,
					"content": "約定？之前沒有聽妳提起過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170558
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170558,
					"content": "啊…那個啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170559
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170559,
					"content": "沒事的，每次賽前，我也會和伊安珊老師約好，這次的表現一定要比上次更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170560
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170560,
					"content": "雖然不好說最後能發揮到什麼程度，但有的時候，有一點壓力才會有動力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170561
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170561,
					"content": "不過，也不能忘了要「玩得開心」喔！最開始，就是為了和大家一起高高興興地玩，才有了這次的雪山聚會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170562
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170562,
					"content": "我知道的！瓦雷莎姐姐，不過…怎麼說也是比賽，嘿嘿，我還是想要拿個好成績的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170563
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170563,
					"content": "好！既然妳那麼想，我來陪妳繼續練習吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170564
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170564,
					"content": "好的！瓦雷莎姐姐，我會跟上妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170565
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170565,
					"content": "行了。妳們不是剛剛練習完嗎？瓦雷莎也許無所謂，但明妮還是先休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170566
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170566,
					"content": "我還可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170567
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170567,
					"content": "咕嚕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170568
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170568,
					"content": "聽這聲響，是該吃飯的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170569
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402170569,
					"content": "對啊，要先吃好，才能練好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170570,
						402170571
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402170570,
					"content": "必須好好吃飯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170572,
					"content": "沒錯，飲食也是訓練裡的重要環節！我把伊安珊老師的特別食譜分享給妳，保證妳明天精力滿滿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170573
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170573,
					"content": "真的？瓦雷莎姐姐知道蒙德有哪些菜適合訓練後吃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170574
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170574,
					"content": "不太清楚欸，但吃東西這種事…相信肚子的直覺就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170575
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170575,
					"content": "先從獸肉旋風開始好了…然後吃薄荷醬烤魚、塔塔可、夾心馬鈴薯泥、粒果肉湯還有蘋果捲捲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170576
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170576,
					"content": "欸——這些全都要吃完嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170577
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402170577,
					"content": "嗯嗯，放開肚子，享受食物的美味，不知不覺就會吃完的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402170571,
					"content": "保持適量訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170542,
					"content": "妳也認識我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
