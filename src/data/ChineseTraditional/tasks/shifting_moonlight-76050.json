			"dialogs": [
				{
					"id": 760500101,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500102,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500103,
					"content": "哇，今天這裡好熱鬧啊，有好多月靈都在哥倫比婭身邊起舞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500104,
					"content": "呃，等等…好像不是跳舞！月靈們是想和她撒嬌嗎？哥倫比婭快要被淹沒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500105,
					"content": "救…救救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500106,
					"content": "把手給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "#呼…謝謝{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500108,
					"content": "剛才那是發生什麼了？月靈們平時不會那麼激動吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500109,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500110,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500111,
					"content": "我陪這些孩子玩了點遊戲，它們似乎很享受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500112,
					"content": "享受完遊戲時間之後圍到妳身邊轉…怎麼感覺像狗狗一樣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500113,
					"content": "這就是它們表達感謝的方式吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "只不過這次一不留神，謝意就像雪堆一樣積起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500115,
					"content": "說是這麼說，妳不還是很寵它們嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500116,
					"content": "#{F#妳}{M#你}們也想試試看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500117,
					"content": "被圍在中間的感覺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "#嗯…這個也行。只要{F#妳}{M#你}回答得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500121,
					"content": "好啊，我倒要看看是什麼遊戲，那麼受月靈歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500122,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500123,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500124,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500119,
					"content": "和月靈玩遊戲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
