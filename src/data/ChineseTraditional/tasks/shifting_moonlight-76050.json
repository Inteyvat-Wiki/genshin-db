					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "怎麼猜錯了的人也有獎勵啦——難道是參加獎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
