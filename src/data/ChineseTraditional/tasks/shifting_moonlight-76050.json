			"dialogs": [
				{
					"id": 760500301,
					"content": "猜猜看這是什麼圖案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500302,
					"content": "欸？這…這也太抽象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500303,
					"content": "哥倫比婭，妳剛剛真的答對了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500304,
					"content": "好像錯的時候更多一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500305,
					"content": "#我放棄了。{NICKNAME}，{F#妳}{M#你}猜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500306,
						760500310,
						760500315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500306,
					"content": "凜角鹿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 760500308,
					"content": "噢！看這反應是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500309,
					"content": "恭喜，猜對了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500310,
					"content": "長頸角犀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "好擔心啊！牠的脖子是不是出了點問題啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500312,
					"content": "嗯…是沒有見過的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500313,
					"content": "正確答案是凜角鹿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500314,
					"content": "月靈們，回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500315,
					"content": "翻折了一根叉刺的魚叉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "好豐富的想像力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "派蒙"
				},
				{
