					{
						"sceneId": 3,
						"position": [
							3521.644,
							207.707,
							-346.917
						],
						"pointId": 16317
					}
				]
			},
			"dialogs": [
				{
					"id": 700820101,
					"content": "奧多夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820102,
					"content": "#嘿，派蒙，還有{NICKNAME}…感謝{F#妳}{M#你}們的幫忙，這下溫斯洛再也不會吵說要把那些對抗深淵的騎士們的墓遷走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820103
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820103,
					"content": "說起這件事，我還覺得奇怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820104,
					"content": "那些弄出風來的只是狂風之核，結果你非要在溫斯洛面前說是騎士團的幽靈作祟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820105,
					"content": "「幽靈」其實不是別人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820106
					]
				},
				{
					"id": 700820106,
					"content": "「幽靈」就是你，奧多夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820107
					]
				},
				{
					"id": 700820107,
					"content": "咦，是這樣嗎？可是他剛剛還喝了一口啤酒，幽靈能喝啤酒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820108,
					"content": "此「幽靈」非彼幽靈，啊呀，我以為我藏得很好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820109
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820109,
					"content": "欸…難道說…其實一開始就沒有什麼幽靈，其實都是奧多夫搞的鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820110,
					"content": "我第一次覺得「搞的鬼」這個說法很貼切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820111
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820111,
					"content": "我調整了機關，然後弄了一點能夠引誘元素生物的誘導素——我一開始只是想稍微嚇嚇溫斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820112
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820112,
					"content": "如果只是來了一些風史萊姆，過個幾天就自己跑光了…正好至冬那邊來了生意，我以為我回來的時候這件事說不定都結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820113
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820113,
					"content": "結果引來了狂風之核…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820114
					]
				},
				{
					"id": 700820114,
					"content": "對，這就讓問題複雜了很多，我只是不想讓他遷那些墓，並不想讓他變成那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820115
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820115,
					"content": "#所以我…看到{F#妳}{M#你}們出現的時候真是感謝風神保佑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820116
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820116,
					"content": "咦，那如果我們沒來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820117,
					"content": "那我會去試著趕跑那個狂風之核，或是把真相告訴騎士團的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820118
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820118,
					"content": "但知道真相的溫斯洛可能會大發雷霆，說不定會把墓碑都砸了…他就是那種個性的人，這麼多年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820119
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820119,
					"content": "#所以幫了大忙了，{NICKNAME}和派蒙，我代表那些抗擊深淵時犧牲在這裡的西風騎士感謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820120
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820120,
					"content": "唔，雖然感覺很奇怪，但是從結果上來說也還是做了好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700820121,
					"content": "哈哈哈，對的，啊呀，要怪就怪我吧…「能擋住一切鬼祟的其實只有寬闊的胸懷和坦蕩的心靈」…但我也沒能做到這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820122
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700820122,
					"content": "知道道理和踐行總歸是兩碼子事嘛！不過我也有在反省了，風神在上如有所知，就饒過我這一回吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧多夫"
				}
			]
		}
	]
}