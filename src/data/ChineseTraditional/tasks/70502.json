				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"查爾斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "沒想到是老面孔，今天想喝點兒什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020202,
					"content": "你好，查爾斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "查爾斯，我們是來當酒保的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020204,
					"content": "#當酒保…啊，原來盧卡招攬到了{F#妳}{M#你}們嗎，他運氣真夠好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}，我很信任{F#妳}{M#你}處理問題的能力，不過，調酒畢竟是個技術活，希望{F#妳}{M#你}不要掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020206,
					"content": "原料的配比，混合的手法…都會影響出品的品質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020207,
					"content": "#沒事，{M#他}{F#她}做的菜可好吃了，美食的原理是相通的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020208,
					"content": "好，還有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020209,
					"content": "之前活動中有位實習生，憑自己的理解混合了三種烈酒，結果一杯就灌倒了客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020210,
					"content": "#從那之後，我們就不敢再向新人提供含酒精的材料了，這點請{F#妳}{M#你}見諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020211,
					"content": "能夠理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "#好，那就全部交待完了。手法和技巧，就在實際調製過程中教{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查爾斯"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
