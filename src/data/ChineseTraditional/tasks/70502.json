			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"盧卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#{F#妳}{M#你}好，想必{F#妳}{M#你}就是那位大名鼎鼎的旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020102,
					"content": "我就是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "喂，還有我呢，我是大名鼎鼎的派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020105,
					"content": "#是這樣的。最近「天使的饋贈」酒館在舉行「酒保體驗週」的活動，我想{F#妳}{M#你}或許會感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020106,
					"content": "#簡單來說，{F#妳}{M#你}可以親自參與調酒…或者調別的什麼，原料隨便用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020107,
					"content": "#只要不浪費，成品也供{F#妳}{M#你}們無限暢飲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020108,
					"content": "無限暢飲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020109,
					"content": "#另外，如果能讓顧客們滿意，報酬肯定也不會少{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020110,
					"content": "哇，還有報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020111,
					"content": "派蒙徹底淪陷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "我們參加吧！好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020113,
					"content": "雖說是「體驗週」，其實對考勤沒有要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020114,
					"content": "現在做不了決定也沒關係，可以先來試一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020115,
					"content": "#怎麼樣，{F#妳}{M#你}意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705020103,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
