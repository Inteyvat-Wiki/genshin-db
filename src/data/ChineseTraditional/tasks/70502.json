				"objectNames": [
					"查爾斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "#{F#妳}{M#你}學得很快，味道也確實不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020302,
					"content": "嗯嗯，我也覺得好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020303,
					"content": "剛才只是情景模擬。實際上，顧客可能也會有一些個性化點單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020304,
					"content": "#濃一點、酸一點，諸如此類。{F#妳}{M#你}只需要將對應口味的配料加量就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020305,
					"content": "我想要一杯焦糖松果，甜一點，最大的杯子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020306,
					"content": "差不多就類似這樣。但對一個優秀的酒保來說，除了具備調製技術，還需要掌握和客人聊天的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020307,
					"content": "交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "#那好，這吧檯的位置就交給{F#妳}{M#你}們了。遇到問題或者有什麼需要，可以隨時找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 705020310,
					"content": "呼…終於學完了！不對…我的焦糖松果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705020311,
					"content": "原來妳真的在點單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "我很會聊天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
