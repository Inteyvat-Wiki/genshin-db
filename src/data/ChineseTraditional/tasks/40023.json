			"dialogs": [
				{
					"id": 400230101,
					"content": "#旅行者，{F#妳}{M#你}們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400230102,
					"content": "我向天領奉行說明了情況，出示了當年的公文。他們總算相信了——我和「訣籙陰陽寮」是清白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400230103,
					"content": "太好了，這樣一來，「式大將」就能專注於自己的使命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400230104,
					"content": "沒錯，現在「訣籙陰陽寮」被我復原成了最初的模樣，修煉武藝的純粹秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400230105,
					"content": "這座秘境運轉一段時間後，可能再次耗盡符法之力。到時我會將它封閉，讓它慢慢累積力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400230109,
					"content": "機會難得，想來挑戰一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400230106,
					"content": "我準備好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "嗯！我也很想見識一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400230107,
					"content": "熱血沸騰了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				}
			]
		}
	]
