					"雅絲敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "也差不多是時候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290102,
					"content": "妳還在研究聖樹根系嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#旅行者，每次{F#妳}{M#你}都來得這麼巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290104,
					"content": "#非常感謝{F#妳}{M#你}之前的幫助，聖樹的情況非常好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290105,
					"content": "我和拉德普討論過後，認為這種好情況還會保持很長一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290106,
					"content": "這下我們終於可以留點時間來，為我們的論文做一些準備工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290107,
					"content": "瞧，我從法爾希那邊借來了一部「留影機」，正準備去記錄一下聖樹的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290108,
					"content": "#旅行者，{F#妳}{M#你}也幫我去一個地方記錄一下聖樹的全貌吧，我把地點給{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290109,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "妳怎麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "呃，那邊…那邊…太高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290112,
					"content": "我每次一個人去到很高的地方都會很害怕…總覺得會有一股風把我…或者我的文稿給吹走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290113,
					"content": "#平常都是法爾希去那邊記錄，但今天他似乎有別的事要忙，所以就只能拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				}
			]
		},
