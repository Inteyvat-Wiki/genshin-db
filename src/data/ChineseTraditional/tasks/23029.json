			},
			"dialogs": [
				{
					"id": 230290401,
					"content": "#怎麼樣，{F#妳}{M#你}們記錄到聖樹的全貌了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290402,
					"content": "已經記錄到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "喔！讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290404,
					"content": "真不錯，角度很好，記錄得也很清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290405,
					"content": "#這些報酬給{F#妳}{M#你}，謝謝{F#妳}{M#你}幫忙，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290406,
					"content": "主幹沒有問題…周圍的枝幹輪廓也沒有變…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "雅絲敏"
				},
				{
					"id": 230290407,
					"content": "剩下的就等拉德普和法爾希搜集好資料，我們就可以繼續下一個課題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅絲敏"
				}
			]
		}
