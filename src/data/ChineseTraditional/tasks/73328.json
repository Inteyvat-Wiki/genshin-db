			"dialogs": [
				{
					"id": 733280201,
					"content": "#給{F#妳}{M#你}一千個擁抱！期待下次再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280202,
					"content": "下次我會在哪裡見到妳呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "誰知道呢？天空島？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280204,
					"content": "#哈哈哈哈哈，開玩笑的！不過如果{F#妳}{M#你}想要在那裡看到我，我也一定會在那裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280205,
					"content": "不要問為什麼，我就是知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280208,
					"content": "總之，期待下一次的相見吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280206,
					"content": "#也給{F#妳}{M#你}一千個擁抱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "哈哈，謝啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "婕德"
				}
			]
