			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "是妳，婕德——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}？！還有小派蒙！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280103,
					"content": "嗶嗶——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733280104,
					"content": "哈哈，我之前說過什麼！我們又見面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280105,
					"content": "妳在這裡做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "嗯…成熟女人的小秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280107,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280108,
					"content": "#{M#意思就是不要打聽啦！我也是有隱私的…}{F#去找一家居酒屋，想辦法讓我開心，我說不定會告訴妳…還要我教妳嗎？}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280109,
					"content": "#{M#噗…是鏢局的規定，我也不能說，抱歉啦。}{F#開、開玩笑啦，別當真呀！是鏢局的規定…這一趟貨要嚴格保密，抱歉啦。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280110,
					"content": "哼，神神秘秘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280111,
					"content": "所以…最近過得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280112,
					"content": "還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "嗯…我也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280115,
					"content": "#好啦，我不多留{F#妳}{M#你}了。唉…還有自己的事情要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280116,
					"content": "欸，婕德這麼忙的嗎…以前也不是這樣子呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733280117,
					"content": "噗…這不是找到了「穩定」的工作了嘛，雖然工作內容和以前差不太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280118,
					"content": "在鏢局找到了工作沒多久，就又開始懷念以前無拘無束的日子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280119,
					"content": "#雖然不知道{F#妳}{M#你}那邊情況如何，但我一直在期待著{F#妳}{M#你}的故事，我也有很多故事要跟{F#妳}{M#你}講喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280120,
					"content": "不過現在不著急啦，現在不著急…好的故事要多多累積，多多發酵嘛，曾經在沙漠裡，旅人是要靠它來活命的！嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280121,
					"content": "#嗯…總之，請{F#妳}{M#你}保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280122,
					"content": "妳也保重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "#嗯，一千個擁抱，我會一直為{F#妳}{M#你}祈禱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280124,
					"content": "嗶嗶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733280125,
					"content": "哈哈，奔奔也一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733280113,
					"content": "一般般…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
