				"points": []
			},
			"dialogs": [
				{
					"id": 742460101,
					"content": "得嘞，客人，您要的霄燈零件我都做好了，每一份都單獨做了防水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460102
					],
					"speakerTitle": "豐泰"
				},
				{
					"id": 742460102,
					"content": "每一份都包了五、六層油紙，丟到水底泡個七、八天都不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460103
					],
					"speakerTitle": "豐泰"
				},
				{
					"id": 742460103,
					"content": "辛苦老闆了，該付的工本費我也會如數支付。現在不是海燈節，採購這些一定很麻煩吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460104
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 742460104,
					"content": "哎——小問題小問題，不需要這麼客氣，咱們做生意，主打的就是一個急客人之所急啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460105
					],
					"speakerTitle": "豐泰"
				},
				{
					"id": 742460105,
					"content": "對了，您上次買的茶葉，喝得還順口嗎？要不要再看看剛到的沉玉仙茗？剛炒出來不久，可都是上好的貨啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460106
					],
					"speakerTitle": "豐泰"
				},
				{
					"id": 742460106,
					"content": "唔，如果有折扣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				}
			]
		},
