					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "…艾莉亞姐姐、卡儂姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760302,
					"content": "這已經不是第一次了。這已經…遠超「懲罰」的範圍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760303,
					"content": "無論是王託付給我們的那座屬於龍的城市，還是那些由小小的人類建立，脆弱卻又美麗的家園…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760304,
					"content": "妳們還要看著多少無辜的生靈死去，才能不再袖手旁觀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760305,
					"content": "要是我們的王還在——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760306,
					"content": "——我們的王不在，桑娜妲妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760307,
					"content": "如果那位遠非全能的主宰將蒼白可怖的命運視為「秩序」，如果這是讓這個註定毀滅的世界免遭吞噬的唯一可能，那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760308,
					"content": "不管它索取的代價多麼沉重…也不管這代價多麼讓我悲傷，它都遠比漆黑的死寂要好得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760309,
					"content": "既然世界註定要迎來毀滅…那對抗漆黑又有什麼意義呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760310,
					"content": "…桑娜妲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760311,
					"content": "沒、沒什麼，艾莉亞姐姐！我什麼都沒說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760312,
					"content": "我只是覺得，我們不該坐視那位暴君屠戮信任著我們的生靈…無論是龍，還是那些小小的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760313,
					"content": "我們…難道不該救他們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760315,
					"content": "…我能理解桑娜妲的憤怒，艾莉亞。在我看來，那位主宰的所作所為，也未免過於殘忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760316,
					"content": "哪怕只有一絲可能…我也希望竭盡全力，救下那些能得救的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760317,
					"content": "可是…那些沒有得救的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760318,
					"content": "那些沒有被救下的人，沒有被救下的生命…他們的血淚與哀泣，難道就理應消失得無影無蹤嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760319,
					"content": "不…不應該是這樣的。我希望人人都能得救，沒有一人沉淪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760320,
					"content": "只要它的「秩序」與它一同死去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760321,
					"content": "…桑娜妲，請妳不要忘記我們最初誕生的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760322,
					"content": "我們的使命只有維繫這個世界，直到賜予我們生命的王從遠方歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760323,
					"content": "從一開始，我們就清楚這種秩序的代價…因為我們無法放任這個世界行往毀滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 761760324,
					"content": "…不，這甚至與秩序無關，艾莉亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760325,
					"content": "桑娜妲，對我們來說…對我來說，妳是最重要的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760326,
					"content": "所以…請不要做出會讓艾莉亞和我痛苦的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760327,
					"content": "不要直接與高天的秩序相抗。至少…不是世界依然脆弱不堪的現在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760328,
					"content": "卡儂姐姐…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760329,
					"content": "伊斯塔露和我說過一個只屬於人類的詞語…「希望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 761760330,
					"content": "只要有生命，就會有希望…總會有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡儂"
				}
			]
		}
	]
}