			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "阿祇，我們做到了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510102,
					"content": "#我已經看到{F#妳}{M#你}們的成果了。三座塔確實都處理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510103,
					"content": "傷患和軍士們因為淵下宮環境的恢復，都已經加速撤離了。呃，大部分都撤離了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510104,
					"content": "不過似乎發生了一些沒有預料到的事情。兩位請隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿祇"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "大日御輿內部出現了翻湧的黑暗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510202,
					"content": "本來按照常理，現在淵下宮應該全境都恢復如初了才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510203,
					"content": "很遺憾，現在這裡變成了最危險的地方。我也不知道為什麼會這樣，應該怎麼辦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510204,
					"content": "#不過我能告訴{F#妳}{M#你}幕後黑手現在正在何處。只能麻煩{F#妳}{M#你}前去對付那個幕後黑手，讓他把計畫全盤托出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510205,
					"content": "這是怎麼辦到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510206,
					"content": "我一直在觀察黑霧的流動，大概還是能看出一些異樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510207,
					"content": "有一個微弱的渦漩，之前在持續吸引黑霧。應該是他對深淵之力有所需求引發的微弱流動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510208,
					"content": "那個傢伙很危險，一般龍蜥可能都不是他的對手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510209,
					"content": "放心吧，本來就準備揍他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "#如此甚好，那麼就麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510212,
					"content": "如果推測沒錯的話，他應該就在<color=#00E1FFFF>圖書館</color>一帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400510210,
					"content": "放心吧，那傢伙本來就喜歡挨揍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自稱「淵上」之物"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "嚯，該說意外呢，還是說毫不意外呢。在這種黑暗之中，仍然要執意前行，破開霧霾，來到我的面前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510302,
					"content": "#如果還有人能做到這點，那恐怕就只有{F#妳}{M#你}了。但是，{F#妳}{M#你}居然會和它們聯手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510303,
					"content": "你又想靠著聊天拖延時間了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510304,
					"content": "#…這樣啊，看起來{F#妳}{M#你}們是真的不知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510305,
					"content": "見到我血氣上湧可以理解，但是跑了這麼久還這麼精力充沛，還真的有點麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510306,
					"content": "#陪{F#妳}{M#你}們運動一下吧。直到{F#妳}{M#你}能停下來聽我說話為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "自稱「淵上」之物"
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自稱「淵上」之物"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "停一下停一下！再打我要死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510502,
					"content": "衝著這個來的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "那個女人，細長瞳孔的女人，她自稱的名字是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510504,
					"content": "欸，你為什麼知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510505,
					"content": "她叫什麼名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510506,
					"content": "她自稱，阿祇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510507,
					"content": "哼，明明只是條蜥蜴，學人學得有模有樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510508,
					"content": "蜥蜴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "#{F#妳}{M#你}也想到了，對吧。深海龍蜥可是很聰明，而且進化很快的族群。早在千年之前，就有過這種傳說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510510,
					"content": "——龍蜥人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510511,
					"content": "龍蜥…人？聽起來像是我會取的外號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510512,
					"content": "很久以前，淵下宮就有這樣的傳說了。深海龍蜥被擊退之後，為了生存開始了新的進化。牠們開始模仿勝者的姿態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510513,
					"content": "最後出現了除了瞳孔之外，和人類別無二致的龍蜥族群——龍蜥人。傳說他們滲透進了淵下宮，替換掉了要人們的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510514,
					"content": "怎麼樣，有想起誰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510515,
					"content": "阿祇的瞳孔，好像聽說確實是豎著的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510516,
					"content": "#蜥蜴在光線充足的地方，眼瞳就是細長的一條豎線哦。這個可是她背叛{F#妳}{M#你}們的鐵證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510517,
					"content": "但是她一直在幫助我們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510518,
					"content": "#她只是在利用{F#妳}{M#你}們對我復仇罷了，畢竟我也背叛了牠們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510519,
					"content": "我之前與龍蜥結成過同盟。我可以用黑霧籠罩整個淵下宮，方便牠們的精銳潛下大日御輿，拯救被囚禁的同族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510520,
					"content": "作為協助，牠們許可深淵教團在牠們領地上通行，並且出功出力同我一起改造了三塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510521,
					"content": "但是牠們沒有預料到，深淵的黑霧對元素生物來說是更加可怕的劇毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510522,
					"content": "所以，龍蜥們認為這是背叛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510523,
					"content": "我自己都認為這個是背叛啊。畢竟要是龍蜥能在深淵力量下活蹦亂跳，深淵教團豈不是很沒面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510524,
					"content": "你這傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510525,
					"content": "#現在的情況就是那個女人利用完{F#妳}{M#你}們，轉手就自己利用大日御輿的力量壓制珊瑚蟲，製造黑暗掩護龍蜥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510526,
					"content": "牠們應該現在正在潛下深處，準備拯救那些被囚禁的同伴吧。如此一來，血枝珊瑚的來源就斷絕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510527,
					"content": "雖然那些深海龍蜥確實很可憐，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510528,
					"content": "#如果{F#妳}{M#你}們還打算保護海祇島的未來，就得趕快囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510529,
					"content": "使用我之前留下的機關，引導光路去驅散大日御輿的黑暗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510530,
					"content": "你這個人說話我們再也不會相信了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510531,
					"content": "#真是的，現在難道{F#妳}{M#你}們還有得選嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510532,
					"content": "反正我這次來依舊是一無所獲。不過無所謂了，我在教團之中也不過是邊緣人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510533,
					"content": "和那些圍著殿下團團轉的傢伙不同，我總是執著於一些無所謂的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510534,
					"content": "#啊，時間拖延得差不多了。這次我也先走一步了，應該不會再見了吧。這個東西就作為臨別贈禮給{F#妳}{M#你}吧，我之前在大日御輿拿到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "自稱「淵上」之物"
				},
				{
					"id": 400510535,
					"content": "這個東西，似乎和心海給我們的是一套欸。不對，不是在意這個的時候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510536,
					"content": "真是生氣啊，這傢伙又跑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400510537,
					"content": "我覺得他說的再有道理我們也不能相信，先回去找阿祇問問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "震驚，居然真的能解決問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511102,
					"content": "這一次那個傢伙沒有騙我們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511103,
					"content": "嚴格來說，他沒怎麼騙過我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "#按照他那套詭辯來說是這樣啦，{F#妳}{M#你}怎麼感覺有點和他互相理解了！這可不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511105,
					"content": "現在大日御輿的通路應該被再次打開了，我們趕緊下去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿祇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "是，是阿祇！她在大日御輿面前想幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511502,
					"content": "#既然{F#妳}{M#你}們返回了這裡，那我想問問，我們的營救成功了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511503,
					"content": "有一些年幼的龍蜥已經被救走了。但是老弱的龍蜥在我們打敗精英之後，躲回了水裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511504,
					"content": "阿祇，妳真的是龍蜥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511505,
					"content": "#我不打算和{F#妳}{M#你}多解釋什麼。雖然我有和{F#妳}{M#你}們溝通的能力，但是我已經明白了，和人的交流只能以背叛作結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511506,
					"content": "我們兩個物種，只能夠一直廝殺下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511507,
					"content": "在我離開之前，我要摧毀這個燈塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511508,
					"content": "憑妳做得到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "#{F#妳}{M#你}不要靠近了，也不要妄圖偷襲我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511510,
					"content": "這座高塔…似乎能聽到我的願望。只要我想，它就可以為了我變化光暗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511511,
					"content": "甚至，只要我想，它就可以在我面前崩毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511512,
					"content": "只需要差不多捏緊拳頭程度的念想，我就可以摧毀這個給龍蜥帶來痛苦的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511513,
					"content": "但是，為什麼…無法動手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511514,
					"content": "#嗚啊，這可比失去血枝珊瑚要嚴重多了！{NICKNAME}，{F#妳}{M#你}有什麼辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511515,
					"content": "阿祇，妳認得這個嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "這是…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511518,
					"content": "阿祇想到了自己的掛墜，並將其與碎片拼合在了一起。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "這是，三條蛇糾纏在一起樣式的…掛墜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511520,
					"content": "#這條掛墜，自我記事起就在我的身邊。為什麼能和{F#妳}{M#你}的兩塊掛墜拼合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511521,
					"content": "妳心裡應該有自己的答案了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "#笑話，{F#妳}{M#你}是想說…想說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511523,
					"content": "我不太明白…這塊是心海的掛墜，這一塊來自大日御輿，阿祇的那塊從小就伴在身邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511524,
					"content": "妳屬於海祇島。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511526,
					"content": "我從小就和龍蜥一起長大。除了這個掛墜伴身之外，還有幾箱的書卷。我透過它們學習了人類語言和文字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511527,
					"content": "但是淵下宮在不久之後，就一個人類都沒有了。空空如也。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511528,
					"content": "直到最近，我才有機會和人類接觸。直到最近，我才知道書卷裡的內容和意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511529,
					"content": "阿祇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511530,
					"content": "#{F#妳}{M#你}們人類書上有句俗話，我一直不明白。不過我剛才理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511531,
					"content": "「人屬於他出生的地方，畜生屬於牠吃飽的地方。」我是龍蜥，我不是人。所以我要回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511532,
					"content": "大日御輿，就隨便了吧。總有一天，我們還會回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "阿祇"
				},
				{
					"id": 400511534,
					"content": "阿祇，走掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511535,
					"content": "所以最後為什麼她突然改變心意了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511536,
					"content": "或許心海能明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "嗯嗯，沒錯。如果是那個心海的話，應該預料到了這個情況，才會把碎片掛墜給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511538,
					"content": "現在問題也算是圓滿解決了。我們回去告訴她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511516,
					"content": "阿祇，請收下這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
		{
			"id": 4005116,
			"completionStepIds": [
				4005116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005116",
							"2"
						],
						"stepId": 4005116,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511601,
					"content": "喂，心海！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511602,
					"content": "#啊，{F#妳}{M#你}們回來了。剛才撤回的軍士們和我說了一下前情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511603
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511603,
					"content": "#{F#妳}{M#你}和那個名叫阿祇的巫女合作，成功清除了黑霧，但是大日御輿卻突發了異變。是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511604
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511604,
					"content": "是這樣的。後面發生了一些很離奇的事情哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511605,
					"content": "和心海講述了之後發生的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511606
					]
				},
				{
					"id": 400511606,
					"content": "這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511607
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511607,
					"content": "唔，有點對不起心海。我們把妳給我們的掛墜送出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511608,
					"content": "不用介意。就像我之前說的，海祇島已經不再需要它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511609
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511609,
					"content": "它是最初海祇大御神在淵下宮整頓朝官，改革制度時留下的東西。三枚掛墜分別留給大日御輿、珊瑚宮一脈和海祇御使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511610
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511610,
					"content": "本意也是想讓鄉人、地走官和神使之間能互相監督。但是如今除去鄉人後代興旺，其他兩系凋敝。這個掛墜也沒什麼用處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511611
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511611,
					"content": "妳說海祇御使…似乎也有士兵認為阿祇是海祇神的使者來著？可惜豎眼瞳其實是蜥蜴的特徵，我們都被騙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511612,
					"content": "並不是哦。海祇御使的造像通常半人半蛇，用以象徵他們乃是蛇神的眷屬。但是後期海祇御使除去瞳孔，確實與人無異。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511613
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511613,
					"content": "反而龍蜥人、地底蜥蜴人的故事…從來就是小說裡才會有的設定吧。珊瑚宮的機密文件裡都沒有這種東西存在的證據哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511614
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511614,
					"content": "啊，所以說，阿祇其實不是龍蜥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511615,
					"content": "海祇大御神耗盡力量創造海祇島之後，力量逐漸衰弱。因此海祇御使不再誕生了。最後有記錄的一位御使…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511616
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511616,
					"content": "被寄予厚望，能溝通龍蜥與人類的御使——她在嬰孩時代，隨同其監護巫女，在淵下宮邊陲被龍蜥襲擊，自此下落不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511617
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511617,
					"content": "很多人都認為她死了，不過也有一部分人認為她被龍蜥們撫養長大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511618
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511618,
					"content": "御使一族對海祇民恩重如山。如今龍蜥和海祇島不再有生存領土的爭端，我真心地祝願那位能找到自己的歸處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511619
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511619,
					"content": "原來阿祇的身世是這樣的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400511620,
					"content": "不過，如果血枝珊瑚的原理是這樣的話，我作為珊瑚宮的現人神巫女，可能需要思考一個新的方法來對抗「聖土化」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511621
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511621,
					"content": "#說回眼前。這次託{F#妳}{M#你}們的福，「聖土化」的問題得到了解決。接下來的數十年裡，海祇島得到了太平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511622
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 400511622,
					"content": "#十分感謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
