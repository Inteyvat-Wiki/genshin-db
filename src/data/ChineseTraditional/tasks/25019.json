			"dialogs": [
				{
					"id": 250190101,
					"content": "這是…燼芯花啊…不錯，不錯，一定能派上大用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190102
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190102,
					"content": "喵喵？喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190103
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250190103,
					"content": "會長，這朵花恐怕沒辦法在楓丹養活的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190104
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190104,
					"content": "如果您堅持的話…唔…做成書籤怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
		{
			"id": 2501902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2501904",
							"2"
						],
						"stepId": 2501904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190201,
					"content": "喵，喵喵喵，喵喵喵，喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190202
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250190202,
					"content": "沒問題，會長，我會簡短介紹的…您就原諒我這張嘴吧。嘴巴總是停不下來，我也沒有另一張嘴來訓斥啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190203
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190203,
					"content": "#簡單來說，{NICKNAME}，我想要請您去收集帶有「燃素」的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190204
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190204,
					"content": "讓我想想…呃…我一直在用「燭傘蘑菇」來提取燃素，就請您幫我找些「燭傘蘑菇」來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190206,
					"content": "不過我聽說「燼芯花」裡也有不少燃素…如果您能把它拿來給我的話，也不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190205
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190205,
					"content": "只要提取足夠的燃素，我就可以在此開始研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "格里斯潘"
				}
			]
		},
		{
			"id": 2501903,
			"completionStepIds": [
				2501903,
				2501904,
				2501911
			],
