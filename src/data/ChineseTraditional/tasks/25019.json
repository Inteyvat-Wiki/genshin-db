				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190301,
					"content": "我們一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190302
					]
				},
				{
					"id": 250190302,
					"content": "一起？那就更好了！我早就想要實地考察了，有您在旁邊我就沒什麼好怕的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190303
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190303,
					"content": "#來吧，我們這就出發。親愛的{NICKNAME}{M#先生}{F#小姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190304
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190304,
					"content": "#至於會長您…就留在這裡吧。請您放心，有親愛的{NICKNAME}{M#先生}{F#小姐}在，我的人身安全絕對有保障！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190305
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190305,
					"content": "喵…喵喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190306
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250190306,
					"content": "呃…差點忘了，我先為您把考察地點標在地圖上，那邊的燭傘蘑菇很好的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
