			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190403,
					"content": "哦！您可是鼎鼎大名啊，實在幸會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190404
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190404,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190405
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250190405,
					"content": "會長也向您問好。要是我們在佩特莉可鎮，我必然會請您喝一杯好茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190406
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190406,
					"content": "但現在…哈哈哈，我既找不到茶，也不能算好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190407
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190407,
					"content": "唔？你們遇見什麼事情了嗎？看你滿頭大汗的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250190408,
					"content": "納塔很熱，可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190409
					]
				},
				{
					"id": 250190409,
					"content": "#哈！讓人愉快的{M#先生}{F#小姐}。從我到納塔開始，您是唯一一個和我幽默感對得起來的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190410
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190410,
					"content": "但納塔的熱度也比不上我內心的焦急。唉…怎麼事情全都擠在一起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190411
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190411,
					"content": "不僅沒有收集到足夠的燃素，就連鎮上也失去了消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190412
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190412,
					"content": "#親愛的{NICKNAME}，我知道初次見面就委人任務實在不算禮貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190413
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190413,
					"content": "但我真的很需要一個可靠的人…您無疑是最佳人選了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
