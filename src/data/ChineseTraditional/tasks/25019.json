			"dialogs": [
				{
					"id": 250191301,
					"content": "#親愛的{NICKNAME}{M#先生}{F#小姐}，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191302
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191302,
					"content": "上次多虧了您幫忙，我的研究又前進了一大步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191303
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191303,
					"content": "照這樣下去，我很快就可以達到預定目標了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191304,
						250191315
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191304,
					"content": "你的預定目標是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191305
					]
				},
				{
					"id": 250191305,
					"content": "我沒向您介紹？天啊，看看我這個腦袋，讓我簡單為您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191306
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191306,
					"content": "喵！喵喵喵喵。喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191307
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250191307,
					"content": "咳，您說得對，會長，我會以最簡短的方式敘述的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191308
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191308,
					"content": "簡單來說，我想要收集燃素是因為想要用「熱能」來「催眠」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191309
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191309,
					"content": "我的催眠裝置不在身邊…但請您想像一個半身高，可以容得下一個人坐在裡面的箱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191310
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191310,
					"content": "那個箱子裡有一個可以不斷產生熱氣的蒸汽裝置，讓箱內的溫度始終保持在一定數值之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191311
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191311,
					"content": "被催眠者坐在裡面露出腦袋，身體則在箱子裡加熱…我相信這種方式可以讓催眠術更快發揮作用，催眠效果也更好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191312
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191312,
					"content": "你純粹就是想把人熱暈啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191313
					]
				},
				{
					"id": 250191313,
					"content": "您說得也有幾分道理，但我們對於「暈」的定義可能不太一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191314
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191314,
					"content": "但現在我們還是先放下這些細枝末節吧，我依然想要請您幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191317
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191317,
					"content": "還是和之前一樣，我想要請您去收集帶有「燃素」的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191318
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191318,
					"content": "我想想，唔…還是請您拿一些「燼芯花」來吧。這種植物裡的確含有不少燃素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191319
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191319,
					"content": "當然，「燭傘蘑菇」也依然是我的重要實驗材料。您看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191315,
					"content": "你又想要我幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191316
					]
				},
				{
					"id": 250191316,
					"content": "#敏銳的{M#先生}{F#小姐}！我就知道您是一個容易合作的好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191317
					],
					"speakerTitle": "格里斯潘"
				}
			]
		},
