			"dialogs": [
				{
					"id": 250190901,
					"content": "#多謝您搭救，{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190902
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190902,
					"content": "您看看，這還真是一場驚心動魄的冒險啊，還好我說服會長讓牠留在部族裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190903
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190903,
					"content": "會長最不喜歡的就是這種不可控的突發事件，我才不想被牠教訓半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190904
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190904,
					"content": "不過，從結果上來說，我還是有採到足夠的材料，一切皆大歡喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190905
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190905,
					"content": "#這些東西給{F#妳}{M#你}，{NICKNAME}{M#先生}{F#小姐}，再次感謝您的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190906
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190906,
					"content": "等研究成功後，我願意請您第一個來體驗「熱能催眠術」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
