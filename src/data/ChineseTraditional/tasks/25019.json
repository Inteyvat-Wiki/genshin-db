					"content": "這個地方的確夠火熱了…會長，您感覺還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190702
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190702,
					"content": "喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190703
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250190703,
					"content": "抱歉，會長，埃斯特和梅康頓兄弟還沒回信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190704
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190704,
					"content": "見鬼…鎮上到底出了什麼事…現在也沒辦法馬上趕回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190705
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190705,
					"content": "你看起來不像納塔人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190706
					]
				},
				{
					"id": 250190706,
					"content": "您看起來也像是個外鄉人啊。向您問好，我是格里斯潘，楓丹空想俱樂部的會員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190707
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190707,
					"content": "這位則是我們俱樂部的會長…部長？呃…總之是負責人，格羅貝爾小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
