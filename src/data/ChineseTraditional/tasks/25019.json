			"dialogs": [
				{
					"id": 250191201,
					"content": "你是空想俱樂部的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191202
					]
				},
				{
					"id": 250191202,
					"content": "咦？等一下，我們之前就聽埃斯特先生他們提過格里斯潘這個名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250191203,
					"content": "您去過俱樂部？露景泉在上，我總算撞上了好運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191204
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191204,
					"content": "您知道俱樂部出了什麼事嗎？我已經接連寄了好幾封信，但就是沒有人回我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191216,
					"content": "關於佩特莉可鎮的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191206
					]
				},
				{
					"id": 250191206,
					"content": "向格里斯潘講述佩特莉可鎮所發生的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250191207
					]
				},
				{
					"id": 250191207,
					"content": "喔，噢，唉…真是讓人…震驚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191208
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191208,
					"content": "喵…喵喵。喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191209
					],
					"speakerTitle": "格羅貝爾"
				},
				{
					"id": 250191209,
					"content": "沒錯，會長，我真的被震驚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191215
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191215,
					"content": "我真不敢相信我竟然錯過了這麼一場超級大催眠。天啊！看在露景泉的份上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191211
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191211,
					"content": "我要是在鎮上，一定可以收集到一大堆可用的實驗紀錄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191212
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191212,
					"content": "會長，看來我們要盡快結束研究，回去俱樂部看看情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191213
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191213,
					"content": "#咳，抱歉，{NICKNAME}，我知道初次見面就委人任務，實在不算禮貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191214
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191214,
					"content": "但我真的很需要一個可靠的人…您無疑是最佳人選了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "格里斯潘"
				}
			]
		},
