			"dialogs": [
				{
					"id": 60280201,
					"content": "這裡就是…亥珀波瑞亞時期，人們與「月亮」溝通的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280202,
					"content": "恆月、霜月、虹月…當三個月亮的力量匯聚時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60280203,
					"content": "通往月亮的門就會打開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280204,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60280205,
					"content": "月髓已經準備就緒，只差最後一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60280206,
					"content": "現在的那夏鎮，應該是最熱鬧的時候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280207,
					"content": "是啊，可惜我們不得不在這種時候送妳回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60280208,
					"content": "沒關係的，作為最後一份，也是唯一一份行李，我很滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280210,
					"content": "我已經感受到了，來自月亮的召喚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280212,
					"content": "妳的家就在這束光的彼岸，哥倫比婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60280213,
					"content": "以後終於有對真正的月亮祈禱的理由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60280214,
					"content": "哥倫比婭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "嗯，我聽著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280216,
					"content": "如果有機會，就多回來看看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "哈…當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280218,
					"content": "如果沒有…也請記得，在這個星球上有一群想念著「哥倫比婭」的朋友們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "嗯，一定會的，謝謝你們為我做那麼多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280220,
					"content": "也請你們記得，月光永遠連結著我們，不論日夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280221,
					"content": "呼…那麼…再見了，我的朋友們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
