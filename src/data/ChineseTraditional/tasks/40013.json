				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "這是…等等，我都糊塗了，這是什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130202,
					"content": "整座島，簡直像是藏在能量罩底下的巨大禮物箱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130203,
					"content": "那裡好像有什麼東西哦，不去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400130204,
					"content": "嗯，要看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130205,
					"content": "邪惡的紅色女孩，妳終於來了。我等得太久太久，實在是好無聊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130206,
					"content": "妳膽敢面對我——嘟嘟一族的統治者——嘟嘟大魔王，勇氣可嘉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130207,
					"content": "勇氣雖然值得敬佩，但現在已經沒有意義了，因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130208,
					"content": "因為嘟嘟大魔王就是我，妳的媽媽艾莉絲喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130209,
					"content": "咦，媽媽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130210,
					"content": "艾莉絲…是那個寫《提瓦特遊覽指南》的人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130211,
					"content": "可莉，還有陪同可莉一起前來海島的各位，你們好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130212,
					"content": "如何，這片海島好玩嗎？夏天的陽光和海灘，嗯~應該是個不錯的假日吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130213,
					"content": "不用找了，我不在你們身旁。面前這台正在說話的機器是我發明的「艾莉絲留聲機」，用來傳遞媽媽的愛喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130214,
					"content": "哦？這可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400130215,
					"content": "啊呀，不會嚇到大家了吧？抱歉抱歉，我家可莉喜歡玩各式各樣的小玩具，作為母親的我當然要支持了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130216,
					"content": "這些玩具一點都不小！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130217,
					"content": "媽…媽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400130218,
					"content": "不能見面很可惜，但我會從遠方留意著你們的一舉一動，像過去那樣守望著各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130219,
					"content": "竟然是艾莉絲女士！我…我太大意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130220,
					"content": "哎？哎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130221,
					"content": "也許各位會為這一切感到奇怪，為什麼一個離家千里的母親要大費周章地建造這樣一座水上樂園呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130222,
					"content": "叮叮！沒錯，我也親自去過那座島，對島上古老的遺蹟和特殊的地形很是喜愛，為了讓大家都享受到這份快樂，才做了這些安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130223,
					"content": "可莉的媽媽也是個非常自由的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130224,
					"content": "哦呵呵，是不是有人在說我壞話呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130225,
					"content": "哎？沒、沒有啊！她是在監聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130226,
					"content": "不，不需要這麼麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130227,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130228,
					"content": "可莉的母親艾莉絲是一位極其神秘又近乎萬能的魔女。千萬別太驚訝，她就是這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400130229,
					"content": "你們一定在想，那些信是怎麼回事，那些船又是怎麼回事，還有那些浮標、能量罩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130230,
					"content": "嗯嗯~其實我也覺得有點大費周章，但只有這樣，才能把各位請來這裡，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130231,
					"content": "那座島本就很有故事，原住民、沉船、神秘機械…無數巧合匯聚在此，要是不做些佈置，豈不是太浪費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130232,
					"content": "讓我猜猜看，收到信的各位應該都在吧。凱亞先生、迪盧克先生、雷澤小朋友、琴小姐、芭芭拉小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130233,
					"content": "#然後是可靠又聰明的小阿貝多，以及…神秘的旅行者和{F#她}{M#他}的好夥伴，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130234,
					"content": "你們都是受我邀請前來陪伴可莉的人。謝謝你們，讓這孩子過了一個不錯的夏天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130235,
					"content": "島上的一切都是我給你們的禮物，謝謝你們陪著她。不過等你們聽到這段錄音，我應該已經在別處旅行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130236,
					"content": "旅行生活是如此匆忙又有趣，哈哈，問問你們身旁那位旅行者就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130237,
					"content": "艾莉絲女士，是因為太忙無法陪伴可莉才做這些的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130238,
					"content": "不是哦，媽媽就是這樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130239,
					"content": "各位，如果你此刻正在思考更深一層的用意，我必須得說，情況沒有你想得那麼復雜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130240,
					"content": "我之所以中意蒙德這座城邦，是因為自由也正是我們母女的期望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130241,
					"content": "我的願望很簡單，希望可莉懷抱著好奇心與善意長大，只要她想，她就能做任何事，去任何地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130242,
					"content": "原來如此…確實是艾莉絲女士的風格，抱歉，是我誤會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130243,
					"content": "總覺得是好有性格的媽媽呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130244,
					"content": "嗯！媽媽是最好的媽媽哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130245,
					"content": "媽媽，這次我們抓魚、開船、游泳…玩了很多很多東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130246,
					"content": "大家都超——級超級好，對可莉非常溫柔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130247,
					"content": "下次妳也一起來，我們再到這裡玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130248,
					"content": "母女倆都是自由自在的精靈啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400130249,
					"content": "夏天啊…說到夏天，我去那座島時，剛好也是夏天呢。坐在沙灘上，傾聽著海浪拂過腳背發出的細響，就想到了妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130250,
					"content": "可莉，妳是出生在夏天的孩子，是海與風送給媽媽的禮物。媽媽很感謝妳的誕生，也想送點東西給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130251,
					"content": "於是媽媽在島上做了些佈置，把古老的遺蹟改造成夏日遊樂園，再用嘟嘟大魔王的名義請妳過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130252,
					"content": "異世界傳說裡有過一座以「金蘋果」為名的奇蹟之島。它有多種化名，承載著人們對美好幻夢的想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130253,
					"content": "媽媽很喜歡那個故事，也希望妳能享受到故事中的美好之事。所以媽媽送妳碧藍的海水、珍珠般白亮的細沙、不可思議的樂園…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130254,
					"content": "和那些愛妳的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130255,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130256,
					"content": "所以水晶才只有三塊嗎…花瓣般的淺紅色、海浪般的淺藍色、秋葉般的淺黃色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130257,
					"content": "或許在艾莉絲看來，這片群島就是天然存在的第四塊水晶吧…位於大海正中，被植被覆蓋的、綠寶石般璀璨的「夏之水晶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130258,
					"content": "可莉，妳和媽媽一樣，是比普通人更長壽的種族。對我們而言，時間是一陣風，吹過便是結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130259,
					"content": "在如此漫長的生命裡，父母不過是孩子人生的第一環。即使我們不願分離，終有一日，妳也會走上屬於自己的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130260,
					"content": "可莉，媽媽會一直愛妳，但除了媽媽，還會有許多人圍繞在妳身旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130261,
					"content": "陪伴妳的好友、教導妳的老師、哪怕知道有蹊蹺也願意為了妳留在島上的人們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130262,
					"content": "夏天是屬於大家的。無論生活如何變化，無論這一年發生多少事，夏天都不會消失，就像人們之間的愛一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130263,
					"content": "希望妳從今以後無論去往何處都不要忘記，世界上有那麼多愛妳的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130264,
					"content": "啊對了，在家也要聽阿貝多哥哥的話，媽媽會定期回來探望你們。其實啊，我一有空就會偷偷回來探望可莉和大家喔。嘻嘻，誰都沒有發現吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130265,
					"content": "還是老樣子啊，艾莉絲阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400130266,
					"content": "阿貝多這傢伙，該不會從一開始就知道了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130267,
					"content": "唔？時間差不多了，就先說到這裡吧。對了對了，我做這些費了不少力氣，你們一定要盡情地玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130268,
					"content": "那麼各位，還有我的寶貝可莉，下次再見囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 400130269,
					"content": "媽媽再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130270,
					"content": "可莉好像非常開心呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "嘿嘿…大魔王就是媽媽，不知為什麼，可莉覺得好開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130272,
					"content": "不管是炸蒙德大門的媽媽，被關禁閉的媽媽，還是寫奇怪的信給我的媽媽…可莉都好喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130273,
					"content": "可莉不會覺得寂寞嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "不會，因為媽媽是最厲害的大魔女，無論在哪都陪著可莉，永遠不會讓可莉感到無聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130275,
					"content": "可莉最最最最喜歡媽媽啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130276,
					"content": "#榮譽騎士{F#姐姐}{M#哥哥}，{F#妳}{M#你}喜歡可莉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130277,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
