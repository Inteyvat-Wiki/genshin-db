				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "可莉——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130102,
					"content": "我們把魚鱗放好了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "#{F#妳}{M#你}真棒！嘿嘿嘿，那接下來就輪到可莉了對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130104,
					"content": "對，那邊的機關就交給妳啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130105,
					"content": "好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130106,
					"content": "可莉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130108,
					"content": "請務必注意安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "嗯，可莉知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130112,
					"content": "可莉，怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130113,
					"content": "可莉…可莉擔心…如果這裡面真的是嘟嘟大魔王該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130114,
					"content": "萬一嘟嘟大魔王不認同可莉成為嘟嘟可的家人，或者、或者萬一可莉輸給了他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130115,
					"content": "那嘟嘟可就不能陪著可莉了，媽媽也會很難過…嘟嘟可是媽媽送給可莉的重要朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130116,
					"content": "然後就…不敢按了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400130118,
					"content": "#榮譽騎士{F#姐姐}{M#哥哥}，能不能請{F#妳}{M#你}來幫我按呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130119,
					"content": "#可莉，{F#姐姐}{M#哥哥}不能幫妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "為什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130121,
					"content": "#因為{F#姐姐}{M#哥哥}要握緊武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "這樣才能保護妳啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "是啊，可莉，我們大家都在這裡陪著妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400130124,
					"content": "人多勢眾說的就是這種場面吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400130125,
					"content": "不論是什麼樣的敵人，只要有我們在就不用害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 400130126,
					"content": "正好，我也想見識一下這座島上的敵人有多強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 400130127,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400130128,
					"content": "我在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400130129,
					"content": "大家，不要說這種話呀…萬一嘟嘟大魔王只是請可莉去他家友好商談呢？又或者…對！說不定他已經承認了可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400130130,
					"content": "他會承認可莉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130131,
					"content": "為什麼不會呢？可莉非常認真，做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400130132,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130133,
					"content": "可莉是最好的小朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130136,
					"content": "那，可莉要上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130137,
					"content": "按鈕按鈕…按！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 400130134,
					"content": "他會承認的，我保證。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "我們都會陪妳一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
