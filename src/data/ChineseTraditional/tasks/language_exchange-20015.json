				},
				{
					"id": 200150402,
					"content": "我覺得我沒說錯什麼地方呀，到底是哪裡的發音出問題了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150403
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
