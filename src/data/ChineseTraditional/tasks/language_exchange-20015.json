			"dialogs": [
				{
					"id": 200150601,
					"content": "Olah! Muhe mimi, nye, eh... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150602
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200150602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150603
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150603,
					"content": "Buka...mita nye, guru-guru...yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150604
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200150604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150605
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150606
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200150606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150607
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200150607,
					"content": "嘻嘻，看這個丘丘人的動作，好像很開心的樣子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150608
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200150608,
					"content": "看樣子這次的交流成功了，我的丘丘人口語果然很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				}
			]
		},
