			"dialogs": [
				{
					"id": 150450601,
					"content": "噢，真好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450602,
					"content": "各位，來我這裡集合！要拍照啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450603,
					"content": "嗯…不錯嘛！所有人的精神狀態都很飽滿，沒有黏答答的瀏海或者熬夜的黑眼圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450604,
					"content": "妳拍照前還會幫忙檢查這些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450605,
					"content": "拍照不夠細心還怎麼聲稱自己是好嚮導？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450606,
					"content": "愛喝酒的吟遊詩人才能成為好旅伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450607,
					"content": "這話到底是怎麼接上的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450608,
					"content": "哈哈，但氣氛很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450609,
					"content": "大家變成一起說胡話的朋友了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "#這真的是個好方向嗎？{F#妳}{M#你}也跟班尼特一樣在慣著賣唱的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450611,
					"content": "至少不壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450612,
					"content": "#來，{NICKNAME}，把這個阿夏髮箍戴上。這是大家一起為{F#妳}{M#你}買的紀念禮物噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450613,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "#嗯，很適合{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450615,
					"content": "那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450616,
					"content": "三、二、一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450617,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450618,
					"content": "派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450619,
					"content": "…不好意思，胡話聽多了之後腦袋突然卡殼了，沒想出要說什麼詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450620,
					"content": "再加上還有點捨不得大家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450621,
					"content": "覺得當自己這麼說出來的時候，彷彿就是在為假期劃下句點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450622,
					"content": "妳…！妳還說「調停人」不會讀心術！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450623,
					"content": "哈哈，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450624,
					"content": "沒事的，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450625,
					"content": "夏天一定還會到來，就像妳和火神大人許願的那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450626,
					"content": "大家的旅程都在繼續。但只要我們都珍惜著彼此，總有一天還會相聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450627,
					"content": "班尼特是不是變得相當能說啊，溫迪老師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450628,
					"content": "啊呀，不是我教的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450629,
					"content": "不是你教的你語氣那麼得意幹嘛呀！真是的，我好不容易有點感動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450630,
					"content": "那我們重新來一次？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450631,
					"content": "大家一起吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450632,
					"content": "喊什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450633,
					"content": "幸運之星？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450635,
					"content": "三、二、一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450636,
					"content": "幸運之星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450641,
					"content": "和朋友們共度了一段愉快的時光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "…班尼特之後有什麼打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450643,
					"content": "對啊，如果現在不好做決定的話，可以來我們「流泉之眾」坐坐，想待多久都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450644,
					"content": "…嗯，謝謝妳的好意，瑪拉妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450645,
					"content": "在這之前，我去見了火神大人，向她鄭重表達了我的感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450646,
					"content": "她告訴我，那片空間是由深淵擬態而成的燼寂海，空間本身極不穩定，現在已經徹底消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450647,
					"content": "後面聊到我的事之後，火神大人歡迎我留在納塔，但也說會尊重我的決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450648,
					"content": "我思考再三…還是決定回蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450649,
					"content": "放心不下老爹們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450650,
					"content": "這也是原因之一。我答應要把收穫的故事講給老爹們聽，不能失約。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450651,
					"content": "其餘的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450652,
					"content": "告別的時候，我對爸媽說了，我一定會成為提瓦特最偉大的傳奇冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450653,
					"content": "冒險家，可不能只待在一個地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450654,
					"content": "班尼特…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450655,
					"content": "要是你在離開納塔之後，又變得不幸起來…那要怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450656,
					"content": "哈哈，這也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450657,
					"content": "在這次旅程中獲得的溫暖，足以讓我面對未來的所有挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450658,
					"content": "我想把握自己的命運。我想將這份家人和朋友帶給我的溫暖，繼續傳遞下去。這個想法一直沒變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450659,
					"content": "敬我們的團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450660,
					"content": "敬班尼特團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450661,
					"content": "乾杯乾杯——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450662,
					"content": "呃…竟然快要通宵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450663,
					"content": "玩得盡興嘛！接下去輪到誰表演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450664,
					"content": "我看班尼特好幾次要睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450665,
					"content": "沒有，沒有…我還可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450666,
					"content": "大家都回去休息吧，瑪拉妮，這麼有力氣就交給妳收拾場地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450667,
					"content": "欸？為什麼是我——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}，再陪我散散步？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450669,
					"content": "我知道一個風景不錯的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
