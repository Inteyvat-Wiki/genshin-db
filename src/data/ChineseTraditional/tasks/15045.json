						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "賣唱的，你還是那麼會挑地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450702,
					"content": "很高興妳能喜歡。有些故事不適合飛鳥，只能說給高處的星辰聽呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450703,
					"content": "要講睡前故事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "哈哈，這篇故事，要從「時間」開始說起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450705,
					"content": "很久很久以前，「時{RUBY#[D]伊斯塔露}間」開始記錄這個世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450706,
					"content": "她對棲息在塵世的生靈一視同仁，與此同時，這些生靈在她心中也是同等的無足輕重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450707,
					"content": "她就好像一張古老的卷軸，將所有人、所有事、所有的相遇與別離都刻印在自己的記憶中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450708,
					"content": "那時還是風精靈的我，在千風神殿與「時間」偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450709,
					"content": "她聆聽我的願望，將部分力量與權能的碎片出讓給了我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450710,
					"content": "風帶來了種子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "看來這不是你第一次聽說「時間與風」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450713,
					"content": "這不是很有韻味嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450714,
					"content": "靠著銘刻在祭禮、詩歌、遺蹟和古籍中的記憶，被視作微不足道的生靈們一次次「見」到了時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450715,
					"content": "這就是你要說的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450716,
					"content": "嗯…只能算是故事的「序章」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450717,
					"content": "燼寂海的汙染是具有時間特性的，換句話說，它的災害存在於時間的每一處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450718,
					"content": "不同於「時間」本身，我的心中，一直存在諸多願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450719,
					"content": "五百年前，為了防止燼寂海的汙染繼續擴散，影響特諾奇茲托克以外的更多區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450720,
					"content": "我將燼寂海從時間軸上吹了出去，讓它成為了「無風之地」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450721,
					"content": "這就是燼寂海消失之謎的真相嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "#哎呀，好像讓{F#妳}{M#你}弄混了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450723,
					"content": "#如果{F#妳}{M#你}問的是二三十年前，燼寂海從特諾奇茲托克消失的事，或許有比我更適合的講述人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450724,
					"content": "燼寂海承載了太多不應屬於它的故事…我僅參與了其中一個篇章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450725,
					"content": "而我在五百年前做出的選擇，也有代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450726,
					"content": "#有些靈魂因此無法返回蒙德…另有些靈魂沉澱在這塊土地上，和幻寫靈結合，成為了{F#妳}{M#你}我所見的阿夏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450727,
					"content": "所以，你這次來特諾奇茲托克是為了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450728,
					"content": "沒錯，我需要和現任火神瑪薇卡合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450729,
					"content": "是在點燃蠟燭的時候嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "猜對了，火光是我們的暗號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450731,
					"content": "由瑪薇卡從那片空間中開啟通往真正燼寂海的裂隙，我才能悄悄鑽進去，把所有願意回家的靈魂都接送回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450732,
					"content": "至於帶回記憶這種小把戲…欸嘿，也不是第一次了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450733,
					"content": "#瑪薇卡還和我提到了{F#妳}{M#你}想幫忙引薦的事…沒想到還是被我搶先了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450734,
					"content": "很高興看到她也熱愛著美酒與自由…我們很聊得來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450735,
					"content": "真有你的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "我可是累了好幾天，差點就要再度沉睡過去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450738,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450739,
					"content": "但想到蜜釀和蒲公英酒都沒喝夠，說什麼都得再多撐一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450740,
					"content": "我看你還不夠累，只用這點理由別想讓我們請客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450741,
					"content": "哎——太嚴格了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450742
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450742,
					"content": "溫迪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450743
					]
				},
				{
					"id": 150450743,
					"content": "#{NICKNAME}，{F#妳}{M#你}會接濟美酒給我的，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450744,
						150450745
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450744,
					"content": "我有點好奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450746,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450747
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450747,
					"content": "或許就是守護蒙德這個地方，讓所有願意在蒙德駐足的人都有選擇的自由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 150450745,
					"content": "你現在的願望是什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450736,
					"content": "做了那麼大一件事…",
