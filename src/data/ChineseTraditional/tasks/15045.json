			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#{NICKNAME}、派蒙！我帶著豚豚球來跟{F#妳}{M#你}們問早哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450402,
					"content": "早啊，瑪拉妮，妳怎麼那麼有精神？昨晚玩得最瘋的不就是妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450403,
					"content": "那已經是昨晚的事啦！睡一覺，疲勞就統統掃清！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450404,
					"content": "#喏，收下這個。是紀念冊的獎勵，我幫{F#妳}{M#你}一起領回來了，免得{F#妳}{M#你}多跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450405,
					"content": "噢噢！真貼心啊瑪拉妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450406,
					"content": "急人所急，想人所想，才算是個好嚮導，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450407,
					"content": "說到工作，算算時間，假期差不多要結束了。再不回家，我怕我家小狗都要認不出我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450408,
					"content": "我問了問其他人，大家也有各自的牽掛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450409,
					"content": "想念家人的，想念蒲公英酒味道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450410,
					"content": "就連恰斯卡嘴上沒說什麼，一到傍晚，她就翹著腿坐在樹梢上，往「花羽會」的方向望了又望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450411,
					"content": "能夠理解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "所以呀，在這個美妙的夏天結束之前，讓我們再做一些有紀念意義的事情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450413,
					"content": "比如…再拍一張合照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150450414,
					"content": "要在這裡拍嗎？住了那麼久，還滿有感情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450415,
					"content": "採納！再把牆面裝飾一番吧，我喊大家過來集合…廣場見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				}
			]
		},
