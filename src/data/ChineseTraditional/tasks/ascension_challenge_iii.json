			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "#喵！「真是了不起，恭喜{F#妳}{M#你}突破了牌手等級的試煉，現在已經是大師牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680202,
					"content": "#喵。「成為大師牌手的意思就是…{F#妳}{M#你}的牌技已經超過很多鑽研此道的人了，不付出努力的人是達不到這樣的境界的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680203,
					"content": "「當然，不願意付出努力的人，一定也無法理解為何我們會孜孜不倦地在他們看來只是玩樂的遊戲上付出時間吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680205,
					"content": "#喵！「被{F#妳}{M#你}邀請過來的牌手，如果聽聞{F#妳}{M#你}已經獲得了大師的頭銜，想必也會更認真地對待與{F#妳}{M#你}的對局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680206,
					"content": "#「說不定也有聽聞{F#妳}{M#你}成為大師牌手後，才願意讓{F#妳}{M#你}去挑戰他設下的牌局的牌手呢…酒館裡也有這種乖僻的傢伙。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680207,
					"content": "#喵…「那麼，{NICKNAME}…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680208,
					"content": "#「希望{F#妳}{M#你}能感受到『七聖召喚』的樂趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
