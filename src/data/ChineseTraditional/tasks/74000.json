			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉諾爾",
					"恩肖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000701,
					"content": "這任務…比想像中麻煩欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000702,
					"content": "因為花園裡的巨人真的很愛那些紫色的小花，而且總是有很多規矩嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000703
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000703,
					"content": "不聽話的孩子就該早點學會守規矩，免得長大了更難管教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000704,
						740000706
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000704,
					"content": "派蒙，聽到了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000705
					]
				},
				{
					"id": 740000705,
					"content": "欸？關我什麼事呀，我才不是不聽話的小孩，哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000708,
					"content": "你們都玩累了吧？正好今天也做了塔塞斯雜燴，一起坐下吃一點吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000709
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000709,
					"content": "#是呀是呀！{NICKNAME}{M#哥哥}{F#姐姐}、派蒙姐姐，我們一起吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000710
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000710,
					"content": "#好欸！既然莉諾爾都這麼說了，{NICKNAME}，我們就不要推辭了吧，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000711,
					"content": "那就感謝招待了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000712
					]
				},
				{
					"id": 740000712,
					"content": "#{F#妳}{M#你}們是莉諾爾的朋友，不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000713
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000713,
					"content": "被邀請到室內，享用了並不精緻但十分美味的塔塞斯雜燴。\\n席間，分享了一些旅途的見聞，引得老人嘖嘖稱奇，少女哈哈大笑。\\n在談笑聲中度過了一段歡樂的時光…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740000714
					]
				},
				{
					"id": 740000714,
					"content": "怎麼樣？外公的手藝是不是勝過韋爾賽叔叔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000715,
						740000716
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000715,
					"content": "的確。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000718
					]
				},
				{
					"id": 740000718,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}、派蒙姐姐，{F#妳}{M#你}們知道嗎？我也有幫忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000719
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000719,
					"content": "雖然現在還只是幫一點點小忙，但是外公說了，只要多練，總有一天我也可以做出那麼美味的塔塞斯雜燴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000720
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000720,
					"content": "#哼哼！到時候一定讓{M#哥哥姐姐}{F#姐姐們}也嚐嚐我的手藝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000721
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000721,
					"content": "那我們約好了！真讓人期待呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000722,
					"content": "話說回來，我們打擾了這麼久，也該告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000723,
					"content": "欸——這樣就要走了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000724
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000724,
					"content": "#莉諾爾，聽話，{M#他們}{F#她們}也有自己的事要做，不可能一直陪妳玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000725
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000725,
					"content": "唔…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000726
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000726,
					"content": "別這麼難過嘛，以後有機會的話，一定還會再見面的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000727,
					"content": "真的嗎？那下次見面的時候，卡特哥哥也會一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000728
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000728,
					"content": "這個嘛…應該也不是完全沒機會吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000729,
					"content": "#好喔，那在下次見面之前，我會準備很多很多精彩的故事，到時候講給{F#妳}{M#你}們聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000730
					],
					"speakerTitle": "莉諾爾"
				},
				{
					"id": 740000730,
					"content": "嗯嗯，他一定也很期待莉諾爾的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000731,
					"content": "#好孩子，謝謝{F#妳}{M#你}們來看莉諾爾，還陪她玩鬧。這裡還有些塔塞斯雜燴，{F#妳}{M#你}們帶著路上吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000732
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000732,
					"content": "冒險家經常要在野外露宿吧？記得吃飽穿暖，別餓到或著涼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000733
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000733,
					"content": "知道啦！恩肖爺爺和莉諾爾也要照顧好自己哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000716,
					"content": "感覺都差不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000717
					]
				},
				{
					"id": 740000717,
					"content": "我覺得還是恩肖爺爺做的塔塞斯雜燴比較美味欸，該怎麼說呢，很有家庭的味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000706,
					"content": "把不聽話的小孩都關進花園。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000707
					]
				},
				{
					"id": 740000707,
					"content": "嘿嘿！可是我根本不會踩到花，而且不需要女巫幫忙就可以飛過高牆哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "派蒙"
				}
			]
