			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "#{F#妳}{M#你}消滅它們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "不用心急，心急的冒險家，只會將自己陷入困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080204,
					"content": "#但也別太慢慢吞吞了，因為{F#妳}{M#你}的報酬也和時間掛鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
