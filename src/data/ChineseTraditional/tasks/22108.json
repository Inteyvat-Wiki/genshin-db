			"dialogs": [
				{
					"id": 221080301,
					"content": "#{F#妳}{M#你}消滅它們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080302,
					"content": "已經全部消滅了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "#不錯，{F#妳}{M#你}做事還挺俐落的，也算是有個冒險家的樣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080304,
					"content": "#這是{F#妳}{M#你}的報酬，辛苦{F#妳}{M#你}了，消滅了它們，周圍也會安寧許多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080305,
					"content": "沒有找到任何與「劍」有關的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080306,
					"content": "…是這樣嗎，沒關係，這也在我預料之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080307,
					"content": "#辛苦了，這是給{F#妳}{M#你}的報酬，拿好了，去忙{F#妳}{M#你}自己的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		}
