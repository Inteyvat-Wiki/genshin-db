			"trigger": {
				"objectNames": [
					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "這一次也沒找到，線索已經快沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "#{F#妳}{M#你}是誰？如果要瞭解協會的事，{F#妳}{M#你}去找旁邊的凱瑟琳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080104,
					"content": "#{F#妳}{M#你}已經是冒險家了嗎，抱歉，雖然是分會長，但我不太關心協會的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080105,
					"content": "#所以，新人我也不太認識…不過看{F#妳}{M#你}這副樣子，是對冒險已經有點心得了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080106,
					"content": "那麼就幫我個忙吧，怎麼樣？但是先說好，這並不是協會的任務，而是我個人的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080107,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "真爽快，不過連情況都不問就接下委託，可不太明智。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080111,
					"content": "#關於委託，我想請{F#妳}{M#你}去消滅兩隻舉著巨盾的強壯丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080112,
					"content": "它們的盾牌上，有著「岩」屬性的力量，雖然不算太危險，但也要小心應付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080113,
					"content": "#{F#妳}{M#你}要做的就是消滅它們。消滅了之後，再回來找我，我會付{F#妳}{M#你}合適的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080114,
					"content": "對了，如果發現了有什麼和「劍」有關的東西，就帶回來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080115,
					"content": "#如果沒發現也沒關係，只要消滅了丘丘人，我就會付給{F#妳}{M#你}正常的報酬，{F#妳}{M#你}就放心準備去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221080108,
					"content": "是什麼委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "#{F#妳}{M#你}還真謹慎，是之前踩過什麼坑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
