			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "哇，好多魚肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030802,
					"content": "#啊，不可以亂動喔，金髮的{M#大哥哥}{F#大姐姐}！那些是用來吸引浮流鳥的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030803,
					"content": "呃…吸引浮流鳥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030804,
					"content": "對啊，我和伊瓦伊正在等這些浮流鳥上岸，反正也沒有什麼別的事情好做嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030805,
					"content": "嗚，嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030806,
					"content": "好啦好啦，伊瓦伊是乖孩子，對吧？要有耐心，不可以著急喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030807,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030808,
					"content": "總之，我們本來打算來這裡玩。畢竟除了朗戈叔叔以外，平常是不會有人到這裡來的，所以這就是我們的秘密基地——之類的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030809,
					"content": "結果沒想到，今天反而被這些浮流鳥搶走先機了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030810,
					"content": "所以呢，我就準備了這些魚肉，打算把浮流鳥們吸引過來。浮流鳥是很喜歡吃魚肉的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030811,
					"content": "但浮流鳥好像並沒有被吸引過來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "對啊，可能是因為距離太遠了，沒聞到魚肉的氣味吧？要是可以想辦法先把牠們引到岸上來的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030817,
					"content": "要是朗戈叔叔的話，大概會說：<color=#00E1FFFF>「只要把牠們撞上岸就好！」</color>之類的吧…可惜我和伊瓦伊力氣太小，只會反過來被撞飛啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030818,
					"content": "#嗯…{NICKNAME}，要不然我們來試試看吧？如果把浮流鳥引到岸上來的話，說不定牠們就會被魚肉吸引了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030812,
					"content": "原來如此，派蒙其實也是浮流鳥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "圓滾滾的、喜歡吃魚肉…原來如此，真的是浮流鳥耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030814,
					"content": "嗯，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030815,
					"content": "才不是呢！話說回來，這些浮流鳥根本完全沒被吸引過來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "派蒙"
				}
			]
		},
