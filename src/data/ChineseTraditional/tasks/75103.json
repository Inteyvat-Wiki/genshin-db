			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕尼婭",
					"伊瓦伊"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2948.067,
							200.301,
							8506.227
						],
						"pointId": 9629
					}
				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "哇，好多魚肉！你們在這裡幹什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030102,
					"content": "#欸？啊，{F#妳}{M#你}們好！金髮的{M#大哥哥}{F#大姐姐}，還有白色的…白色的…呃，應該是妹妹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030103,
					"content": "我和伊瓦伊正在等這些浮流鳥上岸，反正也沒有什麼別的事情好做嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030104,
					"content": "呃…等浮流鳥上岸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030105,
					"content": "嗚，嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030106,
					"content": "好啦好啦，伊瓦伊是乖孩子，對吧？要有耐心，不可以著急喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030107,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030108,
					"content": "總之，我們原本打算來這裡玩。除了朗戈叔叔，通常沒有人會來這裡，所以這裡就是我們的秘密基地！大概是這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030109,
					"content": "結果沒想到，今天反而被這些浮流鳥搶走先機了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030110,
					"content": "所以呢，我就準備了這些魚肉，打算把浮流鳥們吸引過來。浮流鳥是很喜歡吃魚肉的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030111,
					"content": "但浮流鳥好像並沒有被吸引過來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "對啊，可能是因為距離太遠了，沒聞到魚肉的氣味吧？要是可以想辦法先把牠們引到岸上來的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030117,
					"content": "要是朗戈叔叔的話，大概會說：<color=#00E1FFFF>「只要把牠們撞上岸就好！」</color>之類的吧…可惜我和伊瓦伊力氣太小，只會反過來被撞飛啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030118,
					"content": "#嗯…{NICKNAME}，要不然我們來試試看吧？如果把浮流鳥引到岸上來的話，說不定牠們就會被魚肉吸引了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030112,
					"content": "原來如此，派蒙其實也是浮流鳥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "圓滾滾的、喜歡吃魚肉…原來如此，真的是浮流鳥耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "帕尼婭"
				},
				{
					"id": 751030114,
					"content": "嗯，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030115,
					"content": "才不是呢！話說回來，這些浮流鳥根本完全沒被吸引過來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "派蒙"
				}
			]
		},
