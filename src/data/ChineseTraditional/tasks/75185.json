				"points": []
			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "現在只需要完成一個小小的「火山蛋挑戰」——將那邊的地熱噴口打破，取出裡面的烏烏黑蛋，就能品嚐到新鮮出爐的美味了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "倫圖"
				}
			]
		},
		{
			"id": 7518503,
