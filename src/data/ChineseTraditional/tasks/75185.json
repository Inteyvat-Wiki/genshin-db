			"dialogs": [
				{
					"id": 751850701,
					"content": "#是{F#妳}{M#你}們啊，身手矯健的異邦旅人。怎麼樣，有嘗試自己動手製作烏烏黑蛋嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850702,
					"content": "試過了，吃完渾身有力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "對吧，對吧，這可是蘊含了火山精華的美味啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850704,
					"content": "據說每天都吃的話，能讓身體變得越來越健壯喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850705,
					"content": "烤過頭了，吃完差點暈過去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "哈哈哈，那個味道很讓人印象深刻吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850707,
					"content": "我倒是覺得吃習慣之後，也沒那麼難以下嚥啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850710,
					"content": "還沒有，下次試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "#沒問題，願{F#妳}{M#你}旅途一切順利！",
