					"倫圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "烏烏黑蛋是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "說到烏烏黑蛋，那可是只有我們火山地區才能創造的美食啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850303,
					"content": "將鳥蛋放在地熱噴口上，利用火山噴出的氣態燃素烘烤，等到火候正好的時刻取出，就能得到一枚完美的烏烏黑蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850304,
					"content": "不過，要是不小心烤焦了，味道就會變得相當…非比尋常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "倫圖"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
