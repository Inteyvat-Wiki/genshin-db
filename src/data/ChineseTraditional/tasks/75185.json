			"dialogs": [
				{
					"id": 751850401,
					"content": "兩位真是好身手啊，咻咻咻地幾下就完成了挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850402,
					"content": "讓我看看——哦哦，這個黝黑的色澤和濃厚的氣味，真是讓人胃口大開啊。快趁熱品嚐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "倫圖"
				},
				{
					"id": 751850403,
					"content": "#這份食譜{F#妳}{M#你}們也拿著，以後如果還想品嚐烏烏黑蛋，可以自己動手烹飪看看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "倫圖"
				}
			]
