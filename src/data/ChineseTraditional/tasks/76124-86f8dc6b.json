			"dialogs": [
				{
					"id": 761240401,
					"content": "咦？這邊好像還有一幅畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240402,
					"content": "啊哈，好眼色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240403,
					"content": "這是那些個自稱古華傳人的小娃娃先前委託卡斯蒂廖內畫出來的玩意，說是他們引以為傲的「演武場」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240404,
					"content": "不過嘛，他們心氣都高傲得很。覺著自個已經是絕頂高手，早就不需要這般基礎的修習了，就把畫送給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240405,
					"content": "欸？妳不是古華派的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240406,
					"content": "哈哈哈，我倒想說自己是。可惜呀可惜，古華小子怕是沒膽子收我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240407,
					"content": "當初他跟我在歸離原剿滅賊匪的時候，那小子還險些因為學藝不精丟了性命，叫我不得不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240408,
					"content": "罷了罷了，都是些沒意思的事，不過這畫倒是還有些意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240409,
					"content": "#{F#妳}{M#你}要是有興趣，不妨攤開看看？撕壞了也沒事，反正卡斯蒂廖內一天到晚也閒得無事可做，叫他再畫一幅便是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸"
				}
			]
		}
	]
}