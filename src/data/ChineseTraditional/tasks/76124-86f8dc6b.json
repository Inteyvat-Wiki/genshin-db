			"dialogs": [
				{
					"id": 761240301,
					"content": "好嘞，結束！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240302,
					"content": "#多謝兩位，讓我開心得很。尤其是這位金髮的{M#小哥}{F#小妹}，身手著實不凡，怕是比我知道的古華小子強多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240303,
					"content": "不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "拜兩位所賜，我也久違地有了些感悟。魚醬果然還是得加點剁碎的新鮮獸肉提味，否則放久了以後，腥氣還是遮不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240307,
					"content": "哦哦，原來如此原來如…咦？好像完全不合理啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240308,
					"content": "#哈哈，這種小事就別放在心上啦！等我下回讓卡斯蒂廖內給我多畫些魚，我再請{F#妳}{M#你}們吃魚醬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240304,
					"content": "過奬了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "#哈，不必謙虛。{F#妳}{M#你}的劍技很強，這我還是看得出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "妌癸"
				}
			]
		},
