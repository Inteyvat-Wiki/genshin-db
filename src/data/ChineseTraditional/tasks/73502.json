				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "「與白晝交班的白晝，從橋上能看見燈塔匆匆下班的背影。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "調查"
				},
				{
					"id": 735020102,
					"content": "這，這是什麼啊…是謎語嗎？還是什麼諺語之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735020103,
					"content": "與白晝交班的白晝？下、下班的背影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735020104,
					"content": "#這不是旅行者嗎？{F#妳}{M#你}們也對德魯蘇先生的謎語感興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020105,
					"content": "這真是謎語嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "設置這段謎語的人是教令院的一位學者，德魯蘇先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020108,
					"content": "據我所知…那位先生在教令院裡也算是一個怪人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020109,
					"content": "他最喜歡的就是和人討論各式各樣的謎語，還有研究各種加密方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020110,
					"content": "但他的謎語有的實在是太晦澀難懂了，所以也沒多少人願意和他交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020111,
					"content": "所以，他就想出了這種「有獎解謎」的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020112,
					"content": "簡單來說，這段謎語實際上是在暗示著一個「藏寶地點」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020113,
					"content": "只要在正確的時間，用正確的方式，到達正確的地點，就能夠獲得寶藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020114,
					"content": "德魯蘇先生也給了提示，說是這些「藏寶地點」都在須彌城內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020115,
					"content": "#但是如{F#妳}{M#你}們所見，目前依然還沒有一個冒險家能夠解開這道謎語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020116,
					"content": "#如果{F#妳}{M#你}們有興趣的話，也可以試試看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020117,
					"content": "#但我從個人角度來說，我其實更建議{F#妳}{M#你}們去做點正事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡瑪爾"
				},
				{
					"id": 735020106,
					"content": "你知道是誰設置的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德魯蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "今天也沒人來嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020302,
					"content": "這就是「知識殿堂的正門」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "沒錯！這裡就是「知識殿堂的正門」，您…看來是解開了我所有的謎語啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020304,
					"content": "太好了！我還以為今天也沒人能做到這件事呢！再等一會我可就要回去吃午飯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020305,
					"content": "你為什麼要寫這些謎語？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "當然是因為「有趣」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020307,
					"content": "回答得好快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735020308,
					"content": "#除了這個理由之外，{F#妳}{M#你}們覺得我又為什麼會寫下這些謎語呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020309,
					"content": "#難道{F#妳}{M#你}們以為，我就是單純地在享受刁難人的感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020310,
					"content": "說不定喔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "#哈哈哈，那{F#妳}{M#你}們就和教令院裡的某些人一樣誤解我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020313,
					"content": "我之所以寫下這些謎語，就是單純地喜愛解讀謎語時的那種思辨感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020314,
					"content": "#{F#妳}{M#你}們現在回過頭來看我的謎語，裡面總是有一個能夠解開謎語的「關鍵字」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020315,
					"content": "只要以這個關鍵字為突破口不斷思考，就一定能解開謎語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020316,
					"content": "如果我是單純地想要刁難人，那我只要抹去一切線索，把這段謎語變成真正的「無解之題」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020317,
					"content": "#先不說這些了，既然{F#妳}{M#你}們解開了我所有的謎語，那這些東西{F#妳}{M#你}們就拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020318,
					"content": "#這是{F#妳}{M#你}們用自己的「思辨」贏來的獎勵，可要收好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735020311,
					"content": "我不予置評。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
