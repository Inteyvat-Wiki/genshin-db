			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可疑的木箱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "姑且研究一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "這個箱子上的留言…聽起來很恐怖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371103,
					"content": "明明是危險物品，卻被放在果酒湖邊？難道是那邊那兩個騎士的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371104,
					"content": "木板上好像有個很寬的縫，可以看到裡面裝了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371105,
					"content": "讓我看看…裡面好像塞著很多…圓圓的…比日落果還大很多的…紅色的球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371106,
					"content": "等等…難道是炸彈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371107,
					"content": "騎士團為什麼會在湖邊放一箱炸彈啊？難道就是要用來炸那些…麗莎提過的入侵果酒湖的魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可疑的木箱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "哈哈！是炸彈！我要玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "#{F#妳}{M#你}怎麼突然興奮起來了？現在還不知道這些炸彈的威力有多大，萬一傷到無辜路人就不妙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371203,
					"content": "反正都是炸魚，就丟進湖裡吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371206,
					"content": "#被{F#妳}{M#你}這麼一說，我也有點心癢癢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371207,
					"content": "平常總是聽說，可莉想炸魚、在炸魚、炸了魚，然後因此受了罰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371208,
					"content": "結果自己身邊放著一箱炸彈，站在湖邊的時候…的確也想試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371209,
					"content": "應該沒關係吧？只丟一個的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371210,
					"content": "我們一人一個！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "與派蒙一起打開了可疑的木箱，各自取出了炸彈，研究了點火的方法，倒數「三、二、一」，拉響引信，一同把炸彈遠遠丟進了果酒湖裡…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "#水下傳來低沉的轟鳴，兩朵水花在湖面上爆開，幾條角魨旋轉著飛散…\\n{F#妳}{M#你}和派蒙相視一笑，開心地擊掌，隨後便快速拾掇首次炸魚的收穫，準備離開現場…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "#但這次「一時興起的隱秘炸魚行動」似乎並不成功，幾乎在炸彈起爆的同時，{F#妳}{M#你}們就暴露了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "啊！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705371216,
					"content": "我的耳朵！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705371217,
					"content": "嚇死我了！怎麼了方妮雅，妳沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚慌失措的呼聲"
				},
				{
					"id": 705371218,
					"content": "水下突然發生了爆炸…差點把我給震聾！這個聲紋的質感，一定是妳的炸彈，艾瑪托！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371219,
					"content": "哈？我不是一直乖乖站在妳附近，什麼都沒做嗎？妳看我手裡都沒有炸彈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371220,
					"content": "妳！妳一定是想看我狼狽不堪的模樣，事先設定好了定時引信，丟了幾個炸彈到湖裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371221,
					"content": "那按照妳的說法，我應該準備好留影機，抓準妳現在跪在地上抱頭哭哭的模樣拍起來，不然我豈不是太虧了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371222,
					"content": "妳！下個月的房租，別指望我再幫妳打折扣了！還有之前沒計較的水費、家具費、搭飯的伙食費…都給我補上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371223,
					"content": "不不不不不！我錯了！方妮雅，我的好姐姐！就算以前的幾十次惡作劇都我做的…剛才的那次也絕對不是我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371224,
					"content": "如果我能隨便就做幾個…沉進水裡很長時間，還超級可靠的定時引信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371225,
					"content": "那上次我們兩個一起算計那幫丘丘人的時候，還需要我拼死拼活衝到伏擊點旁邊，手動引爆炸彈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371226,
					"content": "…也對，妳頭腦這麼簡單，應該想不到用定時引信來戲弄我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371227,
					"content": "妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371228,
					"content": "妳也騙了我！妳不是說過，在妳用那套偵測設備的時候，任何一點大動靜都會損傷妳的聽力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371229,
					"content": "我看妳現在也沒聾啊，還能這麼有精神地和我吵架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371230,
					"content": "妳根本就不懂！聽力的損傷是慢慢累積，階段性爆發的！妳現在這麼大聲和我頂嘴，也是在加重我的聽力損傷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371231,
					"content": "有可能在將來的某一天，我突然就分辨不出細緻的聲紋了，那便是我失業之日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371232,
					"content": "到時候，妳也沒房子住了！因為我會把整套房子租給出價更高的人！然後去…去…去當漁民！反正不管妳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "超級幽怨的聲線"
				},
				{
					"id": 705371233,
					"content": "那，那我小聲一點和妳吵不就好了嘛…我小聲點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "驚魂未定的話音"
				},
				{
					"id": 705371234,
					"content": "………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "艾瑪托",
					"speakerSubtitle": "朦朧不清的話音"
				},
				{
					"id": 705371235,
					"content": "………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "方妮雅",
					"speakerSubtitle": "漸不明晰的聲線"
				},
				{
					"id": 705371236,
					"content": "聽不太清楚那邊在說什麼…她們只顧著自己吵架去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371237,
					"content": "耶！感覺超級好玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "超級好玩！再丟一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371240,
					"content": "不對不對，一次就夠了，多來幾次，可能那邊的兩個人就會過來調查了，我們可不能被抓住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371241,
					"content": "雖然感覺，我們好像闖了一個…不大不小的禍？但滿足了我一直以來的好奇心，心滿意足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705371238,
					"content": "也沒什麼問題嘛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371211,
					"content": "用力丟出炸彈！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371204,
					"content": "妳不想知道丟炸彈的感覺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				}
			]
		},
		{
			"id": 7053713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
