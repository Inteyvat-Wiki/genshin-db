					"nextDialogs": [
						111030708
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030708,
					"content": "話說此地是何處，本仙明明剛在望舒客棧安安穩穩地睡下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030712,
					"content": "對了，嗯，原來如此，不愧是本仙哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030713,
					"content": "本仙一定是在做夢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030714,
					"content": "嗯…對這個無可救藥的人，似乎沒法達到預期的效果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030715,
					"content": "這不是做夢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "哦？你們想怎麼樣，在本仙的夢裡豈能容忍你等歹人放肆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111030718,
					"content": "嗯…動手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030716,
					"content": "理由是…你會痛！",
