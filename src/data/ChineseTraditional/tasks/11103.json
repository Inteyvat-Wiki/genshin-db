			"dialogs": [
				{
					"id": 111031001,
					"content": "老闆，請問「掇星攫辰天君」是住在這裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031002,
					"content": "「掇星攫辰天君」…是說那個戴著面具的假仙人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 111031003,
					"content": "他在我這裡登記的名字是「王平安」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 111031004,
					"content": "真是個菜市場名…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "他已經把客房退了，說是要去獨自遊歷山川…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 111031007,
					"content": "#哦對了，那人還說如果有位帶著「會說話的小仙靈」的旅行者來找他，就把這封信給{F#她}{M#他}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 111031008,
					"content": "會說話的小仙靈？誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031009,
					"content": "#嗯…他說的旅行者就是{F#妳}{M#你}吧。喏，信在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 111031010,
					"content": "居然有信留給我們，該不會是什麼新的騙術吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031011,
					"content": "趕快先拆開看看吧！我很好奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031019,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031012,
					"content": "啊，他好像確實隨信附送了一些東西給我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031013,
					"content": "裡面還有「百無禁忌籙」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031014,
					"content": "真是好久沒見過這麼識相的壞蛋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031015,
					"content": "令人感動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "是呀…哦，對了，我們快把「百無禁忌籙」送去給魈吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031016,
					"content": "是魈的功勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "聽起來的確只是個普通人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
