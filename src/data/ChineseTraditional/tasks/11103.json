					"nextDialogs": [
						111031104
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031104,
					"content": "需要點菜嗎，這位先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "秀華"
				},
				{
					"id": 111031105,
					"content": "一份「烤螭虎魚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031106,
					"content": "好的，馬上為您準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "秀華"
				},
				{
					"id": 111031107,
					"content": "嗯？這次居然不是杏仁豆腐，對魈來說太少見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031108,
					"content": "這是「銅雀」生前喜歡吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031109,
					"content": "我只是想，嚐嚐是什麼味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031110,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031111,
					"content": "「驚濤入海覓螭虎，風雪歸山斬妖邪」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031113,
					"content": "兩位還有事嗎？我比較習慣一個人吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111031114,
					"content": "那就不打擾了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "嗯，派蒙和旅行者，就這樣帥氣地，靜靜地離開吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111031115,
					"content": "那麼，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
