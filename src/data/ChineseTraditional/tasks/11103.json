			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"銅雀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "青山碧水魂飄飄，浮生得閒把扇搖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030102,
					"content": "不好意思，打擾你的雅興了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030103,
					"content": "我們想借一下這裡的香爐和燈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "…這還真是天底下最稀罕的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030105,
					"content": "來到廟裡不求仙，不拜神，反倒要把香爐都搬走，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030106,
					"content": "我們也知道是很無禮的要求，但真的只借一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030107,
					"content": "是「夢遊諸境法」的儀式所用吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030108,
					"content": "啊…你怎麼會知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030109,
					"content": "#我在此廟的時間，絕對遠比{F#妳}{M#你}們想像得長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030110,
					"content": "可能是心誠所致吧？「仙法」也有幸悟得一二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030111,
					"content": "還有這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030112,
					"content": "#罷了罷了，{F#妳}{M#你}們拿去吧。今天能有機會成人之美，也算一件幸事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030113,
					"content": "…再留在此地，本身也沒什麼意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030114,
					"content": "你好像有什麼心事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "不必在意我，想要什麼就快去取吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銅雀"
				},
				{
					"id": 111030116,
					"content": "那總之…多謝了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "沒關係，想要什麼就快去取吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銅雀"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110301",
							"2"
						],
						"stepId": 1110301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "這個香爐…應該沒問題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030202,
					"content": "至少不像這座廟一樣破破爛爛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030203,
					"content": "香爐之後…還要收集附近的「七星燈」，趕快行動吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "咦？怎麼沒人了，之前明明就在這裡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030302,
					"content": "#想不到{F#妳}{M#你}們還會在意我的去向…本以為{F#妳}{M#你}們拿了東西便會走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030330,
					"content": "啊！…是剛才那位先生的聲音！你、你在哪裡！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030303,
					"content": "#我的形體，千年之前就不在了。{F#妳}{M#你}們方才見到的，是「浮世留形法」所造的幻影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030304,
					"content": "#如今{F#妳}{M#你}們將「浮世留形法」所用的香爐與七星燈拿去，自然就見不到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030305,
					"content": "你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "我本是夜叉中的小仙，岩王帝君賜我仙名「銅雀」，數千年前實力不濟，戰死沙場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030309,
					"content": "今天是我的忌日，看看今日的璃月是我的遺願，因而冒昧在此施術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030310,
					"content": "#話說…{F#妳}{M#你}們是從「降魔大聖」那裡來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030311,
					"content": "原來你們之間認識嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030312,
					"content": "#我能從{F#妳}{M#你}們身上感受到他的氣息…還有，愈發濃郁的「業障」的氣息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030313,
					"content": "唉…數千年來，他還一直在忍受著那樣的痛苦嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030314,
					"content": "…真是令我無地自容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030315,
					"content": "別這麼說，「銅雀」先生不是為了璃月獻出了生命嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030316,
					"content": "性命雖然珍貴…但比起「降魔大聖」所承受的，死亡不過是一種苟且偷安而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030317,
					"content": "「銅雀」先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030318,
					"content": "哈哈，真是不好意思。生日要快樂地度過，但忌日就難免感傷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030319,
					"content": "「浮世留形法」的效力也快散盡了，請二位珍重，替我問候「降魔大聖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030320,
					"content": "一定會的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "唉，好想再吃一次正宗的「烤螭虎魚」呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030323,
					"content": "「驚濤入海覓螭虎，風雪歸山斬妖邪…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030325,
					"content": "…已經完全消失了嗎，真希望能有人記住這位名叫「銅雀」的夜叉呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030326,
					"content": "我們也走吧？等以後有空了，再來上炷香吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030321,
					"content": "「銅雀」先生也請保重…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "見、見鬼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "哈哈哈…這麼說也沒錯。「仙」與「鬼」原本就是一線之隔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "派蒙"
				}
			]
		},
