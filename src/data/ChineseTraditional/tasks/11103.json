					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "儀式道具已經備齊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030502,
					"content": "#這香爐和七星燈的式樣很完美，簡直像是為仙法特製的…{F#妳}{M#你}們從哪裡弄來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030503,
					"content": "從名叫「銅雀」的夜叉那裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "而且「銅雀」先生託我們向你問好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030505,
					"content": "「銅雀」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030506,
					"content": "…原來是他啊，確實有他的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030507,
					"content": "果然「銅雀」也放不下璃月吧…但願璃月今日的光景可以讓他放心安息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030508,
					"content": "那麼現在開始儀式的準備吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030509,
					"content": "香爐置正中尊位，七星燈散落周圍，極寒之物於其間點綴，安排好之後我們再繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030510,
					"content": "嗯，如此便可。接下來是「夢遊諸境法」的關鍵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030511,
					"content": "施術的過程共有四個環節：獻香，冥思，施咒，放矢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030512,
					"content": "啊…還要這麼麻煩呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030513,
					"content": "仙法乃是絕雲仙人千年所悟，其中玄奧頗深，切不可輕慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030514,
					"content": "否則可能反噬自身，魂魄離體難以復歸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030515,
					"content": "對不起，我又說錯話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030516,
					"content": "「獻香」，就是在香爐上香一柱，心懷對岩王帝君的敬畏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030517,
					"content": "「冥思」，斷絕一切雜念，將施術對象的形象在腦中定格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030518,
					"content": "「施咒」，厲聲將咒文念出——「帝婆夜叉，三屍押來」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030519,
					"content": "「放矢」，對兩尊夜叉雕像各射出一箭，作為使役的契約。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030520,
					"content": "沒有意外的話，片刻後那人的魂魄便會出現於此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030521,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "沒有疑問的話，就趕快開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111030524,
					"content": "那總之…先上炷香吧？要心懷對岩王帝君的敬意什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111030522,
					"content": "（吞口水）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
