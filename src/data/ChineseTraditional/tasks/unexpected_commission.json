			"dialogs": [
				{
					"id": 706900101,
					"content": "哇，這些書也太多了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900102,
					"content": "雖說看到去圖書館整理書籍這種事，居然會被列為特級委託的時候就已經做好心理準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900103,
					"content": "不過看到這副壯觀的樣子也還是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900104,
					"content": "#哎呀，這不是小可愛和派蒙嗎？{F#妳}{M#你}們怎麼有空回蒙德來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900105
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900105,
					"content": "該不會是因為太想念姐姐，特意專程回來看我的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900106,
						706900108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900106,
					"content": "被妳猜中了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900107
					]
				},
				{
					"id": 706900107,
					"content": "#這麼久沒見，{F#妳}{M#你}也是越來越會說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900109
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900109,
					"content": "終於找到妳了，麗莎小姐，我們還以為妳今天不在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900110,
					"content": "呵呵，本來今天的確沒打算工作的。不過聽凱瑟琳說，終於有人接下了圖書館的重要委託，這才想著過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900111
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900111,
					"content": "#嗯？這麼巧，該不會接下委託的就是{F#妳}{M#你}們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900112,
						706900113
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900112,
					"content": "正是在下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900114
					]
				},
				{
					"id": 706900114,
					"content": "#那真是再好不過了。如{F#妳}{M#你}所見，圖書館最近收到了一大批來自某位不願意透露姓名的贊助人捐贈的書籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900115
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900115,
					"content": "我看了一下書目，居然都是圖書館裡沒有收藏過的新書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900116
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900116,
					"content": "不僅什麼類別的書都有，而且還有好幾本是相當麻煩的禁書…這樣的話，也就不能隨便找個人過來打雜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900117
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900117,
					"content": "這可就傷腦筋了，要是讓我一個人把它們分門別類整理入庫，那還不知道需要多久呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900118
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900118,
					"content": "#不過現在{F#妳}{M#你}們來了，我就可以放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900119
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900119,
					"content": "#本來還想請{F#妳}{M#你}們先喝一杯下午茶，但是看起來這裡現在的條件也不是很允許。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900120
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900120,
					"content": "沒關係，既然是麗莎小姐的委託，就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900121,
					"content": "小派蒙真是善解人意，那麼這裡的事情就拜託囉，我先不打擾了~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900113,
					"content": "這裡應該也沒有其他人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900114
					]
				},
				{
					"id": 706900108,
					"content": "還是先說正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900109
					]
				}
			]
		},
		{
			"id": 7069002,
			"completionStepIds": [
				7069001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾莉絲",
					"麗莎"
				],
				"points": [
					{
						"sceneId": 1004,
						"position": [
							-16.379,
							-5.223,
							-16.718
						],
						"pointId": 286
					}
				]
			},
			"dialogs": [
				{
					"id": 706900201,
					"content": "呼，總算是只剩下最後這一疊書了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900202,
					"content": "不過這都是些什麼書啦…《丘丘人逃生教學》——丘丘人也不會看書吧？還有《騙騙花培育指南》，誰會想培育這種東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900203,
					"content": "這裡還有一本《小魔女辭典》…唔，名字看起來就很可疑，而且這邊我們不是整理過了嗎？剛才有看到這本書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900204,
						706900206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900204,
					"content": "書目上好像沒看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900205
					]
				},
				{
					"id": 706900205,
					"content": "而且說到魔女，總會想到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900207,
					"content": "#嗨呀，{F#妳}{M#你}們是在找我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900208
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900208,
					"content": "欸？是艾莉絲，妳從哪裡突然冒出來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900209,
					"content": "#小派蒙可能還沒發現，不是我突然冒出來，而是從剛才打開那本辭典開始，{F#妳}{M#你}們就已經進入了魔女的「領域」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900210
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900210,
					"content": "哇啊，我就說那本書有問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900211,
					"content": "#嗯哼，不知道{F#妳}{M#你}們有沒有讀過一本叫《小魔女與不熄滅的火》的故事書呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900212,
						706900214
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900212,
					"content": "好像在哪裡看過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900213
					]
				},
				{
					"id": 706900213,
					"content": "那就好解釋了，雖然內容毫無關聯，不過本書姑且算是為了那本故事書所寫的辭典呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900216
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900216,
					"content": "妳這樣解釋完，我就更搞不懂啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900217,
					"content": "#哎呀，讓我想想該從哪裡開始說起…{F#妳}{M#你}們應該知道魔女會曾在三方會晤中給予過法爾伽「許諾」的事情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900218
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900218,
					"content": "「在蒙德最需要幫助的時候，魔女們將歸來此地，成為蒙德的助力。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900219
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900219,
					"content": "不過老老實實等待危機降臨可不是魔女會的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900220
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900220,
					"content": "「比起在故事的最後關頭突然跳出來機械降神，還是早早就埋下伏筆更容易讓人接受」——M是這樣說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900221
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900221,
					"content": "況且誰知道危機什麼時候會到來呢？說不定是下輩子，也說不定是明天，不做好準備可不行呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900222
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900222,
					"content": "所以我就拜託魔女們寫了這本辭典，當然是打著那本故事書的名義，才好不容易把人湊齊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900223,
						706900224
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900223,
					"content": "還真是費心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900225
					]
				},
				{
					"id": 706900225,
					"content": "簡單來說呢，這本辭典裡裝滿了魔女們在看了芭比的水占盤後，為蒙德的大家量身訂製的「課題」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900226
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900226,
					"content": "為了共同的目標，與夥伴們一同努力戰勝困難，從中獲得成長，從來都是危機到來前能夠做的最好的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900227
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900227,
					"content": "妳說得就像是有什麼不得了的事情要發生了一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900228,
					"content": "我可沒有這樣說過哦。不過說到「夥伴」，能夠和蒙德的大家都稱得上「夥伴」的人選，恐怕也就只有一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900229,
						706900230
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900229,
					"content": "這下聽懂了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900231
					]
				},
				{
					"id": 706900231,
					"content": "該不會妳從一開始就是為了這件事才把我們算進來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900232,
					"content": "哦？竟然會有這種事，真是讓人不敢相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900233
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900233,
					"content": "哇，艾莉絲好狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900234,
					"content": "哈哈哈哈，不過這麼重要的東西原本也不能隨隨便便地就帶進提瓦特來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900235
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900235,
					"content": "俗話說藏木於林，這些書的確都是我為了掩人耳目，才捐給圖書館的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900236
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900236,
					"content": "#總之這也不是壞事嘛。況且對{F#妳}{M#你}們來說也是個能去和夥伴們見面的好機會，就當是幫幫我好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900237
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 706900237,
					"content": "真拿妳沒辦法，不過既然能幫助蒙德的大家，我們就答應妳好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900238,
					"content": "這本辭典我們就收下了。接下來如果遇到大家的話，就把書裡的「課題」帶給他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900239
