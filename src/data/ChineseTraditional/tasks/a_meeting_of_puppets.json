			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿帽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "各有各的路要走，不必多言。茶倒是不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "阿帽"
				},
				{
					"id": 733560202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 733560204,
					"content": "行，再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿帽"
				},
				{
					"id": 733560203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
}