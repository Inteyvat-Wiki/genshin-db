			"dialogs": [
				{
					"id": 741560401,
					"content": "#我好緊張！{NICKNAME}，按照紙條上說的，我們只要在這裡等他就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560402,
					"content": "耐心等待吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "#好，我聽{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560405,
					"content": "#安靜地等待了一會後，窗戶隨著一個「吱呀」聲被一張{F#妳}{M#你}們熟悉的面孔打開了。伯努瓦向外探了探頭，看見{F#妳}{M#你}們後，他小心地從窗戶爬了出來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "伯努瓦，這到底是怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560407,
					"content": "快走快走，被他們發現就糟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741560403,
					"content": "我有些問題想問他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
