			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "你好呀，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560802,
					"content": "…完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741560803,
					"content": "秋告訴我你要逃跑的時候我還滿驚訝的，我們已經關了你這麼久，你居然還沒有崩潰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560804,
					"content": "而且還有辦法抓住機會教唆這兩位「正義使者」幫你逃跑，你的求生意志令我動容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560805,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560806,
					"content": "明明有那麼多地方可以跑，怎麼最後偏偏選了你經常帶秋來郊遊的地方？真是愚蠢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560807,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741560808,
					"content": "不用解釋，我懂人在危急關頭慌不擇路，就習慣性地選了自己最熟悉的那條路對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560809,
					"content": "還好秋在你們後面出發，還沒有趕到這裡…我不想在她面前聊這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560810,
					"content": "所以你到底是怎麼想的？我實在搞不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560811,
					"content": "你以婚姻的名義把她當商品賣給了別人——還賣了兩次。第一次你用她換來了楓丹廷的大房子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560812,
					"content": "第二次你隨便選了一個人，只為了把她送走，房產和其他財物都歸你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560813,
					"content": "你甚至在她受到欺凌的時候選擇視而不見…但她還是把第二次婚姻生下的孩子都交給你撫養了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560814,
					"content": "她的孩子也被你送走了，我猜是換了一大筆贍養費之類的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560815,
					"content": "今天你到底為什麼還能夠心安理得地送小孩子點心、邀請他們去你家裡做客呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560816,
					"content": "你都沒有一瞬間覺得良心不安嗎？我百思不得其解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560817,
					"content": "說實話，我是在秋流浪的時候才遇到她。她是一個很溫柔的母親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560818,
					"content": "她對我朋友的女兒佩妮非常溫柔，才一天不見，小佩妮就嚷嚷著要找秋姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560819,
					"content": "哦，以防你覺得自己還有翻盤的可能，除了我之外，秋現在還有很多朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560820,
					"content": "你跑到哪裡都沒有用，我們會追你追到天涯海角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560821,
					"content": "為什麼是她這樣一無所有的人在受折磨？你這樣的傢伙卻窮到只剩錢？我覺得這件事不太對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560822,
					"content": "收起你多餘的好奇心，他不值得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741560823,
					"content": "哎呀，被妳聽到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560824,
					"content": "原來妳就是秋，我總算知道怎麼回事了。勒魯瓦這一家真複雜，唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}，我們一路跟伯努瓦走到這裡，結果發現好多事都和我們之前以為的不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560826,
					"content": "#到這個地步，{F#妳}{M#你}覺得我們還應該管這件事嗎？我聽{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
