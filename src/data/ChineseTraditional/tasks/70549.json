							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "這杯新作品…就叫「悠閒雷光」好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "決鬥代理人專享特調，請用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490304,
					"content": "嗯？是用了果味的淡酒嗎？這種口感非常不錯，對我來說恰到好處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490305,
					"content": "鹽雕的淡淡鹹味和入口時的果酸，柔和的焦糖甜味混合在一起，每種都處於最佳的邊界線上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490306,
					"content": "名字和酒的顏色很搭，雷光這個詞的意象，也對上了「烈焰焦糖長詩」的火元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490307,
					"content": "不過，「悠閒」是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490308,
					"content": "不覺得蒙德很悠閒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "原來如此…的確很契合這杯酒給我的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490311,
					"content": "它獨特的香氣和口感，會在我對蒙德的記憶中佔據最關鍵的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490312,
					"content": "克洛琳德喜歡就好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "#{F#妳}{M#你}覺得，如果時機得當，{F#妳}{M#你}有興趣在咖啡館或德波大飯店，再扮演一回調飲師嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490315,
					"content": "咦，為什麼這樣問？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "#就我個人的層面，自然還想喝到{F#妳}{M#你}的傑作，但我主要是為娜維婭還有芙寧娜小姐這麼問的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490317,
					"content": "當然沒問題，讓大家都來喝喝看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "明白了，我不會強求…總之，感謝招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "克洛琳德"
