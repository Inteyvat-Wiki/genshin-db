						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "嗯，確認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490102,
					"content": "#在附近徘徊時，我就察覺到熟悉的氣息，走近一看，果然是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490103,
					"content": "妳好啊，克洛琳德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "#要是夏洛蒂小姐看見了這一幕，肯定會為{F#妳}{M#你}連拍數百張畫片，並寫下如下報導——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490106,
					"content": "#《輝煌執劍者{NICKNAME}的兼職生活，每杯調飲都千金難求》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490107,
					"content": "#第二天，{F#妳}{M#你}就會登上各大報紙的頭條，可能還會有大量楓丹遊客慕名而來，將這裡擠得水洩不通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490108,
					"content": "想像了一下，場面有點誇張…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "幸好這次我婉拒了夏洛蒂小姐隨行的請求，上述情景不會發生，讓我們默默慶祝此刻的清閒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490111,
					"content": "言歸正傳，請給我一杯「烈焰焦糖長詩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490112,
					"content": "#…看{F#妳}{M#你}的表情，似乎還有很多事想問我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490113,
					"content": "先幫妳調酒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "#從容不迫、游刃有餘，原來{F#妳}{M#你}對這門工作頗有心得啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490114,
					"content": "妳邊喝，我們邊聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "要是真的這樣，我會招架不過來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "請坐，我的客人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
			"completionStepIds": [
				7054906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
