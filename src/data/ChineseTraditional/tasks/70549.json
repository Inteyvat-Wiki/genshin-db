			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克洛琳德"
				],
				"points": [
					{
						"sceneId": 51204,
						"position": [
							2192.178,
							230.089,
							-778.359
						],
						"pointId": 1
					},
					{
						"sceneId": 51204,
						"position": [
							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "妳點的「烈焰焦糖長詩」完成了，請慢用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "還真是酒如其名，色澤如火…散發著侵略性的香氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490203,
					"content": "咳…似乎有點烈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490204,
					"content": "沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "沒關係，只是需要時間來適應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490207,
					"content": "印象裡，上次喝酒還是去年被娜維婭邀請去了一次品酒會，淺嚐過一小口希斯嘉葡萄酒，力道遠遠不如這杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490208,
					"content": "這跟完全不喝哪裡不一樣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "以理性思維而言，酒精容易讓人暈眩，對工作不利，自然是別碰為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490211,
					"content": "但送我去港口時，芙寧娜小姐提到蒙德是「美酒與詩篇的國度」——既然都來了，自然要試試這裡的特色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490212,
					"content": "沒錯，不然有點可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "而且，據我收集到的情報，即將與我切磋的那位游擊小隊隊長…就有著很強的美酒鑑賞力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490215,
					"content": "那位隊長允許對外公布的戰報，實在是賞心悅目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490216,
					"content": "而且，之前與我好好切磋一番的優菈隊長…就有著很強的美酒鑑賞力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490217,
					"content": "她還送了我一瓶楓丹本土都已停產，只有海外還有存貨的海露花果實汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490218,
					"content": "出於對這位好手十二萬分的尊重，我也需要加深對蒙德美酒的瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490219,
					"content": "那我好好想想，再調一杯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "#麻煩{F#妳}{M#你}了，十分感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490222,
					"content": "克洛琳德在蒙德城裡玩過了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "嗯，剛到蒙德第一天的上午，就四處逛了逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490224,
					"content": "娜維婭曾經做過分析——不少「桌上劇團」的場景和插畫都參考了蒙德城的景觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490225,
					"content": "但劇本中的城鎮與蒙德的整體氣質，還是差別很大。蒙德城給我留下最深的印象，是劍與盾的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490226,
					"content": "劍與盾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "可能是因為我主要去鐵匠鋪和訓練場參觀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490229,
					"content": "最近蒙德新生產的武器與鎧甲，採用了與楓丹完全不同的熱處理工藝，表層滲碳的含量更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490230,
					"content": "雖說韌性略差，但抗衝擊性能大大提升。散發著一種…煮過頭的咖啡味，嗯，還加了三匙滿滿的鹽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490231,
					"content": "還真的沒注意過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "這種氣息給了我良好的第一印象。因為楓丹特有工藝的合金，經常用一種摻有茉潔草成分的保護劑來維護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490234,
					"content": "時間一長，那種淡淡的香味就會變得過於甜膩…令人牙痛。而蒙德的劍與盾所散發的氣息，不會對我帶來這種煩擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490235,
					"content": "學到了新領域的學問！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "當然，這個問題也有解法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490238,
					"content": "#下次在楓丹再見時，我向{F#妳}{M#你}推薦另一款保護劑，質感清淡如水，沒有多餘的香氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490239,
					"content": "#如果{F#妳}{M#你}也不習慣長久的甜味轟炸，這款保護劑應該能讓{F#妳}{M#你}滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490240,
					"content": "克洛琳德平常都喝什麼飲品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "平常嗎？如果是工作期間，我常喝咖啡。佐餐的話，我會傾向於偏淡的泡泡桔果汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490242,
					"content": "因為我常吃肉類菜餚，微酸的果汁能夠減輕油膩感，長此以往，就習慣了酸味果汁的口感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490243,
					"content": "今天的交流結束後，熱情的騎士們就請我吃了蒙德特色的料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490244,
					"content": "我嚐過的八道肉菜都相當不錯，分量驚人，使用的肉類品質紮實，而且處理的火候絕佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490245,
					"content": "當然，也有改進空間，比如蜜醬胡蘿蔔煎肉和堆高高…提供給外地遊客的版本，醬汁的口味可以清淡一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490246,
					"content": "聽起來吃了不少…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "紅肉料理的話，的確如此。這頓飯的熱量足以支撐三天的工作，之後的用餐邀請，我都婉拒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490249,
					"content": "當務之急是解膩…總會有辦法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490250,
					"content": "這是騎士們送妳的禮物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "沒錯，代號「果榛03」和「果榛05」的騎士送了我這枚徽章，我認為它設計得相當精妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490252,
					"content": "#他們說這種紀念章剛剛定型，專門用於贈送給重要的賓客。專屬於{F#妳}{M#你}的勳章，也還在設計中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490253,
					"content": "我第一次聽說這兩位騎士…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "…說得有道理，我也不可能記住每個沫芒宮文員的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490256,
					"content": "#不過，{F#妳}{M#你}以後應該還會結識他們的，他們一看就是經驗豐富的老兵，作為文職，還穿著全套鎧甲上班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490257,
					"content": "安排好我的事務後，他們就去酒館聚會了，說是要繼續昨晚的對局，分出個酒量的高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490258,
					"content": "前一天晚上喝下成桶的啤酒，第二天居然能清醒地上班，並且不露破綻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490259,
					"content": "蒙德的風格就是這麼隨意嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "也就是說，蒙德人有著看似隨性，實則能夠準確把握喝酒「分寸」的習慣，值得敬佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490262,
					"content": "對了，艾梅莉埃小姐也來過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "哦？看來她已經忙完了委託，效率真高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490264,
					"content": "回到楓丹後，我大概可以告訴希格雯，準備購入她的新香水了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490265,
					"content": "咦，妳好像還滿瞭解她的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "或許稱不上瞭解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490267,
					"content": "來蒙德的途中，我碰巧和艾梅莉埃小姐乘坐了同一艘船，閒聊了幾句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490268,
					"content": "之前常聽希格雯誇讚她的傑作，這次交流一番後，我發現…她是一位難能可貴、淡雅的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490269,
					"content": "淡雅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "溫柔、從容，但不會與他人走得太近…可能是職業原因吧。這樣的感覺我覺得很理想，能讓內心長期維持寧靜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490272,
					"content": "不太懂…以後邀請妳們再聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "感謝，不過也不用特意為我們創造互相熟悉的機會。我們的工作沒什麼交集，人際關係圈也沒多少重疊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490275,
					"content": "順其自然就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490276,
					"content": "艾梅莉埃偏好茶類，克洛琳德呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "#難道，{F#妳}{M#你}已經開始考慮之後招待我們的細節了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490278,
					"content": "經過之前的嘗試，我猜測，我能接受的烈度應該和艾梅莉埃相近，最多就到果味利口酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490279,
					"content": "#到時，{F#妳}{M#你}幫我們準備類似的飲品，總歸是妥當的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490280,
					"content": "我找到改進配方的方向了，請稍等。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "好的，我也做好了心理準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490282,
					"content": "就算這杯依然有點烈，也盡量試著喝完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490273,
					"content": "回楓丹後，請妳們一起來玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "這個形容有點高深。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "蒙德人習慣了下班喝酒放鬆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "騎士團真是個好多好多人的組織…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "蒙德特色的肉類料理都吃過了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "原來劍的材料還有這麼多門道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "克洛琳德的比喻真厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "我改個配方，努力讓妳滿意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "只要控制住量，應該還好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "沒有喝酒的習慣就別勉強哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "來杯水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
		{
			"id": 7054903,
