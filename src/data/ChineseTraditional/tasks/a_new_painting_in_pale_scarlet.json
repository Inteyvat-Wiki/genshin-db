			"dialogs": [
				{
					"id": 400570501,
					"content": "將紙張小心地浸入水中…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570502
					]
				},
				{
					"id": 400570502,
					"content": "哇，你們看，紙上果然出現了很多字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570503,
					"content": "快給我看看上面寫了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570504,
					"content": "唔…故事裡說，墨染拿到了赤人的詩集後，把詩集放到了溪水裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570505,
					"content": "然後，被指認抄襲的那篇詩的字跡就暈開了…為什麼會這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570506,
					"content": "派蒙，在過去印刷尚不發達的年代，手寫在書上的文字很容易因為受潮變模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570507
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570507,
					"content": "為了讓字跡保存更久，往往不是使用特製的墨水書寫，就是在寫完後，在紙面刷一層防水的塗料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570508
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570508,
					"content": "特製的墨水製作起來費時費力，刷塗料的辦法也並不輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570509
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570509,
					"content": "不過，赤人的詩集既然是要呈給將軍品鑑的重要物品，肯定會採用兩種辦法之一才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570510
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570510,
					"content": "但現在抄襲的那篇詩作上，不僅缺少赤人的印章，字跡在遇水後的狀況也和其他紙面大不相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570511,
						400570512
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570511,
					"content": "這首詩不是赤人寫的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				},
				{
					"id": 400570513,
					"content": "也就是說赤人並沒有做壞事，他是被人陷害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570514,
					"content": "對，這就是墨染的故事想要告訴我們的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570515
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570515,
					"content": "雖然故事令人唏噓，但現在「赤人」和「墨染」這兩幅畫的內容，已經能決定下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570516
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570516,
					"content": "萬葉，綾華，不知道你們願不願意擔任模特兒呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570517
					],
					"speakerTitle": "阿貝多"
				},
				{
