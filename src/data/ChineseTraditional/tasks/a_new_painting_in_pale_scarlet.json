							"2"
						],
						"stepId": 4005703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們好。我聽說容彩祭會有嚮導，卻沒想到是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570102,
					"content": "嘻嘻，我們也沒想到，萬葉竟然會以容彩祭嘉賓的身分回到稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570103,
					"content": "接到邀請函時我也有點詫異，不過在外面漂泊久了，能藉此機會回到故土，祭拜一下故人也不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570104,
					"content": "萬葉，我們剛才遠遠地看見你好像正在找什麼東西，發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570105,
					"content": "是這樣的，剛才我跟著大家下船的時候，突然聽到身邊響起了很輕的腳步聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570106,
					"content": "那種腳步絕不是一般乘客，可我回過頭時，那人已經不見了，只有棧橋下傳來了「噗通」一聲響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570107,
					"content": "我沒找到對方的蹤影，不過卻在腳邊發現了一張奇怪的紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570108,
					"content": "萬葉，你撿到的紙上是不是寫了一首詩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570109,
					"content": "#咦，{F#妳}{M#你}們怎麼知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570110,
					"content": "把之前幾天發生的事告訴了萬葉…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "竟然還有這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570112,
					"content": "萬葉，能給我們看看那張紙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "在這裡，請吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570114,
					"content": "上次葵之翁的詩最後提到了「赤人」，果然這一篇就是赤人的故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570115,
					"content": "這次的故事大致是說：赤人因為喜歡用紅色的印章才有了這個雅號，不過他卻因為剽竊被將軍發現，然後被流放了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570116,
					"content": "怎麼說呢，如果要評價的話，今天的故事聽起來不是很吉利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570117,
					"content": "其實之前的也好不到哪去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "我倒覺得這篇故事並無不妥，我之前也曾經是被幕府通緝的要犯，和故事裡的赤人也差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570119,
					"content": "這篇故事裡的赤人做了壞事，被將軍流放是咎由自取，和萬葉一點都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570120,
					"content": "#喂，{F#妳}{M#你}在想什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570121,
					"content": "故事裡的「印章」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "#對了，{F#妳}{M#你}們剛才提到，有位朋友最近正苦於簽名太慢是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570124,
					"content": "在璃月和稻妻，的確都有「印章等同於簽名」的說法，這說不定是個可行的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570125,
					"content": "在海上航行時，我偶爾會雕刻些東西打發時光，如果要做印章，或許我也能出一份力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570126,
					"content": "哇，那就太好了！我們現在，先去找阿貝多商量一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570122,
					"content": "說不定能幫行秋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
		{
			"id": 4005702,
			"completionStepIds": [
				4005704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005704",
							"2"
						],
						"stepId": 4005704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "阿貝多，我們找到幫行秋的辦法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570202,
					"content": "把剛才發生的事告訴了阿貝多。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "五歌仙的故事果然又出現了，而且還來了這麼一個辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570204,
					"content": "印章，嗯，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570205,
					"content": "確實是個高效率的方案，這樣一來行秋就不用苦於字跡問題了。不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570206,
					"content": "「不過」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "因為行秋的簽名之前已經對讀者公佈過，如果這次的新刊上只有他使用印章，未免顯得誠意不足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570209,
					"content": "我想到了另一個主意，當然印章也是其中一部分。我們現在就去烏有亭，和大家商量一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570207,
					"content": "還有什麼問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
		{
			"id": 4005703,
			"completionStepIds": [
				4005706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005706",
							"2"
						],
						"stepId": 4005706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570301,
					"content": "加油啊枕玉老師，今天寫出來的字已經很有進步了，說明昨天的特訓很有效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570302
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570302,
					"content": "唉，不行了，我的手已經痠得抬不起來了…早知道這樣，之前就不在書法課上看小說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570303
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570303,
					"content": "剛剛已經休息了十分鐘了，再堅持一下啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570304
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570304,
					"content": "編輯長不愧是我們之中催稿最可怕的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570305
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570305,
					"content": "嗯，難怪一遇到麻煩的作者，八重大人最後總會派編輯長出馬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570306
					],
					"speakerTitle": "村田"
				},
				{
					"id": 400570306,
					"content": "太可怕了，才一陣子沒見，行秋就已經要變成行屍走肉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570307,
					"content": "編輯長，其實剛才我們找到了一個辦法，或許可以解決大家的困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570308
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570308,
					"content": "璃月和稻妻，印章使用都很廣泛，印章也往往視作與簽名等同之物。或許可以用這個想法，讓簽名變得容易些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570309
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570309,
					"content": "當然，只有印章是不行的，簽名需要由兩部分組成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570310
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570310,
					"content": "首先是個人的圖章，這部分以枕玉老師的簽名為範本刻製就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570311
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570311,
					"content": "同時，我會再為枕玉老師設計一個美觀易寫的圖案，枕玉老師只需在每本書上簽下這個圖案即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570312
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570312,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570313
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570313,
					"content": "嗯，這辦法可行！不僅出自作者親筆，而且效果應該也會十分美觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570314
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570314,
					"content": "真的嗎，這麼說來我終於得救了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570315,
					"content": "編輯長，我突然想到，之前我們之所以放棄了現場簽售，是因為考慮到作者簽名會花費比較長時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570316
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570316,
					"content": "但如果是這種形式的簽名的話，是不是在現場簽售也來得及？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570317
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570317,
					"content": "而且如果所有作者都採用類似的形式，也不會讓枕玉老師的簽名顯得突兀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570318
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570318,
					"content": "如果你們覺得可行，我當然也很樂意為其他作者設計簽名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570319
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400570319,
					"content": "雕刻印章的事可以交給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570320
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400570320,
					"content": "既然這樣，我現在就去聯絡新刊發售會的其他兩位作者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570321
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570321,
					"content": "不久後，兩位作者趕來了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570322
					]
				},
				{
					"id": 400570322,
					"content": "竟然能獲得白堊老師設計的簽名，真是太榮幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570323
					],
					"speakerTitle": "聰美"
				},
				{
					"id": 400570323,
					"content": "因為我的筆名很複雜，不適合進行簽售，這下終於可以實現心願了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570324
					],
					"speakerTitle": "勘解由小路健三郎"
				},
				{
					"id": 400570324,
					"content": "太好啦，看來大家都同意這個提案呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400570325,
					"content": "讓枕玉老師忙了這麼多天，實在不好意思，接下來這幾天就請您好好休息，後續事宜就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570326
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570326,
					"content": "已經簽好的這些書，將來也會作為八重堂活動的特殊獎品使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570327
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570327,
					"content": "呼…得救了，終於得救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570328,
					"content": "多虧大家相助，我和小野寺先生才能徹底擺脫困境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570329
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570329,
					"content": "嘻嘻，行秋終於自由啦，出去好好呼吸一下新鮮空氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
