			"dialogs": [
				{
					"id": 400575101,
					"content": "小野寺，等會就由你把發售會的變化告訴八重大人吧，這個主意八重大人一定會喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575102
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575102,
					"content": "你的腦子動得很快，只要行事再穩妥一些，將來一定能有所作為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575103
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575103,
					"content": "非常感謝，編輯長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575104
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400575104,
					"content": "這大概就是所謂的因禍得福吧？新刊發售會變成「簽售會」，讀者們也一定會高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "村田"
				}
			]
		}
