			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "啊啊糟了…傷腦筋…這該怎麼辦呢……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610102,
					"content": "怎麼了，凱亞？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#哦，感謝千風。{NICKNAME}，{F#妳}{M#你}的出現一定是神對我的恩賜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610105,
					"content": "#風神派來拯救凡人的使者喲，請問{F#妳}{M#你}現在有空嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610106,
					"content": "唔哇，好肉麻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610107,
					"content": "也不能說沒空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "那可太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610110,
					"content": "#其實有件事不方便讓騎士團的同事知道，非{F#妳}{M#你}幫忙不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610111,
					"content": "我想借一步說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610112,
					"content": "不如我們就到騎士團旁邊的庭院去吧，隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610113,
					"content": "怎麼搞得這麼神神秘秘的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610109,
					"content": "先說說究竟發生了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "你好像不是會這麼慌張的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "好了，就在這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610202,
					"content": "別吊胃口啦，到底有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610203,
					"content": "#該從何說起呢…對了。先告訴{F#妳}{M#你}們一個秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610204,
					"content": "那是有關我個人過往的秘密，請千萬不要對別人提起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610205,
					"content": "放心，我的口風可是很緊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610206,
					"content": "其實啊…我的爺爺…是個海盜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610207,
					"content": "哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610208,
					"content": "…不不。這反應也太冷淡了。難道妳不相信我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610209,
					"content": "看！我的眼罩就是海盜爺爺的遺傳，這就是血親的證明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610210,
					"content": "眼罩原來還能遺傳的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#啊哈哈，{NICKNAME}，{F#妳}{M#你}還真是沒有常識呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610212,
					"content": "這就像許多孩子頭上的辮子也遺傳自媽媽，是一樣的道理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610214,
					"content": "昨晚我翻閱爺爺留下來的手記，偶然發現了爺爺留下的<color=#00E1FFFF>寶藏</color>訊息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610215,
					"content": "…寶藏？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610216,
					"content": "根據手記上的情報，似乎寶藏被埋藏在「失落的阿卡狄亞遺蹟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610217,
					"content": "寶藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610218,
					"content": "但這遺蹟的位置具體在哪裡，目前還沒有線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610219,
					"content": "寶藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610220,
					"content": "凱亞！那究竟是什麼寶藏！黃金嗎？還是寶石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610221,
					"content": "哼哼，只有財寶的寶藏，不過都是三流貨色而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610222,
					"content": "我爺爺的寶藏，是「劍」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610223,
					"content": "據說是一柄只要握住，就可以獲得無敵力量的神劍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610224,
					"content": "哇——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610225,
					"content": "那劍是天空島上的神明失手落入海中的，被爺爺他們碰巧打撈起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610226,
					"content": "他握住劍柄的瞬間，電閃雷鳴，巨浪翻騰，原本晴空萬里的海上忽然捲起風暴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610227,
					"content": "依靠神劍的力量，爺爺一路擊敗了八頭海蛇、銀髮女妖、深淵邪龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610228,
					"content": "但這力量過於強大，令其他海盜覬覦不已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610229,
					"content": "為了避免爭端，爺爺只能把神劍藏了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610230,
					"content": "八頭海蛇、銀髮女妖…真的存在嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "這世界就是因為充滿了未知，所以才會有趣的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610233,
					"content": "精彩到令人難以置信的冒險，只屬於海盜的浪漫，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610234,
					"content": "嗚~~~~~~哇！！簡直太厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610235,
					"content": "最近有一夥<color=#00E1FFFF>盜寶團</color>非常活躍，好幾處遺蹟已經發生文物失竊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610236,
					"content": "我擔心「阿卡狄亞遺蹟」也很快會被他們發現，那柄神劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610237,
					"content": "那可不行！與其落在壞人手裡，還不如我們來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610238,
					"content": "#…總之，你放心吧！我和{NICKNAME}會幫忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610239,
					"content": "哦~？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610240,
					"content": "#那可真是太棒了，還請記得保守秘密，我會等{F#妳}{M#你}們的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4610241,
					"content": "#喂，怎麼樣，{NICKNAME}？不覺得很激動嗎？那可是超——級厲害的神劍呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610242,
					"content": "那是真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "嗯…不如先去<color=#00E1FFFF>冒險家協會</color>附近打探一下情報？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610245,
					"content": "關於遺蹟的情報，冒險家們會比較清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610243,
					"content": "那真的是真的嗎？",
