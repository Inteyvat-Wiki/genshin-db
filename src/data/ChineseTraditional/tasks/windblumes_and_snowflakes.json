			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "薯叔，你們驢人眾，過不過風畫節呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090102,
					"content": "唔，我應該過不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090103,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "#咦？怎麼是{F#妳}{M#你}，喂，{F#妳}{M#你}為什麼又是一副懷疑的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090105,
					"content": "我在這裡陪著這孩子說說話，又沒做什麼壞事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090106,
					"content": "看來愚人眾真的不過風花節。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{F#大姐接}{M#大葛哥}，泥也不過…過風畫節呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090108,
					"content": "#欸，就是說啊。身為蒙德城的「榮譽騎士」過什麼風花節啊，{F#妳}{M#你}應該得去執勤吧，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090109,
					"content": "你怎麼一臉得意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "#咳…咳，算了，不和{F#妳}{M#你}說這麼多了，我看{F#妳}{M#你}閒著也是閒著，不如來幫我個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090111,
					"content": "這孩子的父母，因為城裡這個吵吵鬧鬧的節日，也要出去採購，所以就把這孩子放在這裡，拜託修女照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090112,
					"content": "#但是{F#妳}{M#你}也知道，風花節嘛，城裡城外都忙成了一團，修女們各忙各的，也沒空來陪這孩子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090113,
					"content": "#所以，她就纏上我了，堅持要我陪她玩，但{F#妳}{M#你}也知道，我不可能出教堂。所以我也只能在這陪她說說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090114,
					"content": "可惜啊，我是個「愚人眾」，就算是和這孩子說話，旁邊的那位修女也在不停地瞪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090115,
					"content": "我看，她一定是覺得我這個「愚人眾」圖謀不軌，又想打什麼壞主意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090116,
					"content": "哼，為了不讓那位修女過來煩我，也為了這孩子的「身心健康」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090117,
					"content": "#我想拜託{F#妳}{M#你}這位光榮又正派的「榮譽騎士」，陪著這孩子出去玩玩，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090118,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "#哦唷，這麼乾脆。不愧是「榮譽騎士」嘛，我還以為{F#妳}{M#你}還要和我討價還價，要點什麼報酬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090120,
					"content": "那快帶著這孩子出去玩吧，我繼續在這裡待著，吃那些修女的白眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090121,
					"content": "唉，這種日子什麼時候才能結束啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090122,
					"content": "你其實只是希望莉莉能出去玩吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}算了吧，我是「愚人眾」，是壞人，知道了嗎？怎麼可能有這麼好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090124,
					"content": "#哎呀，好了好了，{F#妳}{M#你}快點帶著這孩子出去玩吧，我看她在教堂裡都要悶死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090125,
					"content": "我嘛…我就繼續在這裡待著，吃那些修女的白眼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090126,
					"content": "唉，這種日子什麼時候才能結束啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
