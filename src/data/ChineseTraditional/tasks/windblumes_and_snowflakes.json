			"dialogs": [
				{
					"id": 700090502,
					"content": "#莉莉，旅行者，{F#妳}{M#你}們回來了？怎麼樣，找到小狗了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090503
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090503,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "嗯！謝謝大姐接，窩和牠們玩得狠好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090505,
					"content": "#這樣就好了。對了，{F#妳}{M#你}們要是有空的話，也可以去芙蘿拉小姐那邊看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090506,
					"content": "畢竟是風花節，能夠帶一束花回去的話，感覺也不錯，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090507,
					"content": "#哇…窩想去看看，{F#大姐接}{M#大葛哥}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090508
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090508,
					"content": "我們過去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090509
					]
				},
				{
					"id": 700090509,
					"content": "#謝謝{F#大姐接}{M#大葛哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
