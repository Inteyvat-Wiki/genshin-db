			"dialogs": [
				{
					"id": 700090602,
					"content": "#呼呼，{F#妳}{M#你}們好呀？{F#妳}{M#你}們是來買花的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090603
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090603,
					"content": "真的有好多花花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090604
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090604,
					"content": "咦，莉莉？妳怎麼和這位旅行者在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090605
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090605,
					"content": "#把拔和麻麻有很縱要的事要做！所以這個{F#大姐接}{M#大葛哥}在帶我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090606
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090606,
					"content": "重要的事啊…我差不多也猜到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090607
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090607,
					"content": "#先不說這些了，{F#妳}{M#你}們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090608
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090608,
					"content": "是來看花的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090609
					]
				},
				{
					"id": 700090609,
					"content": "看花…唔，這樣吧，我這裡剛好有一株蒲公英，送給妳吧莉莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090610
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090610,
					"content": "真的嗎？謝謝——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090611
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090611,
					"content": "為什麼突然就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090612
					]
				},
				{
					"id": 700090612,
					"content": "其實…是因為魯道夫先生之前剛在我這裡訂了一大捧花，要送給吉麗安娜小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090613
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090613,
					"content": "現在只是送一株蒲公英而已，沒什麼大問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090614
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 700090614,
					"content": "蒲公英真好看…不過，窩應該要回去了，不然把拔麻麻回來看不見我會著急的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090615
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090615,
					"content": "#對了，回去之前…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，尼知道城裡哪裡有那種…大大的鍋嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090616
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090616,
					"content": "#窩之前看過我麻麻做「烤鬆餅」…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}陪我玩了這麼久，窩來做點好次的給尼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
