					"nextDialogs": [
						700090811
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090811,
					"content": "好吧…妳都送我禮物了，那我就再講幾個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090812
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 700090812,
					"content": "好耶！那窩要聽…驢人眾的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090813
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090813,
					"content": "咳！這個…這個沒什麼…沒什麼趣，我想個更有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
