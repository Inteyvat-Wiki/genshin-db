			"dialogs": [
				{
					"id": 700090401,
					"content": "狗狗來這邊…有很好疵的喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090402
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090402,
					"content": "哇！狗狗真過來了，嘻嘻，窩要去摸摸牠啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090403
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090403,
					"content": "嘻嘻，狗狗摸起來好軟…那個驢人眾薯叔說，他們家辣邊，也有狠多狗狗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090404
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090404,
					"content": "但他說，他家那邊的狗狗，都狠大狠大，毛也狠多狠多…一定也狠好摸吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
