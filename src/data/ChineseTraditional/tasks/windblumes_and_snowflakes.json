							"7000904",
							"2"
						],
						"stepId": 7000904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "#{F#大姐接}{M#大葛哥}，為什麼那個驢人眾的薯叔，不過風畫節呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090202,
					"content": "他有重要的工作要做。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "縱要的工作？唔…比過風畫節還縱要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090207,
					"content": "可是，那個薯叔就算做了這麼壞這麼壞的事，只要改掉，他也能變成很好很好的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090208,
					"content": "嗯！窩要去和那個薯叔說，只要變得很好很好，他就能過風畫節了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090209,
					"content": "那個叔叔現在很忙，我們出去玩玩，好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "#欸…好吧。那，{F#大姐接}{M#大葛哥}，{F#妳}{M#你}可以帶窩出去玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090211,
					"content": "沒問題，別走太遠就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "好欸！那窩們快出去玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090204,
					"content": "「愚人眾」應該參加不了風花節。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "為森麼呀？是不是因為…驢人眾很壞很壞？把拔縮，碎覺噗刷牙、疵飯時用手抓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090206,
					"content": "唔唔，辣樣是很壞呢，薯叔的把拔看了一定會生氣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "莉莉"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布蘭琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "#旅行者？{F#妳}{M#你}有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090303,
					"content": "還有…莉莉？妳怎麼來了，妳爸爸和媽媽呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090304,
					"content": "#把拔和麻麻有很縱要的事要做！所以這個{F#大姐接}{M#大葛哥}在帶我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090305,
					"content": "很重要的事？魯道夫先生和吉麗安娜小姐還真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090306,
					"content": "大姐接，剛才那隻小狗狗在哪裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090307,
					"content": "剛才的小狗？唔…我也不知道，平時牠們基本上都躲在自己的窩裡，只在我在碗裡放食物的時候，牠們才過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090308,
					"content": "可能是因為現在城裡太熱鬧了，牠們都被吵得跑出來了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090309,
					"content": "怎麼了，莉莉，妳是想和牠們玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090310,
					"content": "嗯！窩想和牠們玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090311,
					"content": "這樣啊…我想想，光是找一定找不到的…那你們試試看去那邊的碗裡放點吃的，把牠們引出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090312,
					"content": "唔，我想想…小狗的碗裡最好放些禽肉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "布蘭琪"
				},
				{
					"id": 700090313,
					"content": "欸…可是這些，都要去辣裡找呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090314,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090315
					]
				},
				{
					"id": 700090315,
					"content": "#哇！謝謝{F#大姐接}{M#大葛哥}，那窩們快點去餵牠們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
