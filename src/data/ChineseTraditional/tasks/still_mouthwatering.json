			"trigger": {
				"objectNames": [
					"恩里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "抗議！抗議！為我的勞動權利抗議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430202,
					"content": "你要的核心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "哦？讓我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430204,
					"content": "為什麼在這裡抗議…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "在哪裡跌倒的，就要在哪裡站起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430206,
					"content": "我原本是要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "真拿你沒辦法，在地上和水下的一些地方，有人部署了這種奇怪機器。識別的方法也很簡單，機器的周圍會產生很奇怪的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430208,
					"content": "將它解決掉，並把裡面這種特定的核心帶給我，一共<color=#00E1FFFF>需要七個</color>。拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				}
			]
		},
