			"dialogs": [
				{
					"id": 740430301,
					"content": "嗯，確實收到了，七個神秘的核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430302,
					"content": "所以核心到底是做什麼用的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "我怎麼知道？老闆只是說，需要七個這些神奇機器裡的神奇核心。能弄到核心，就能賺大錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430304,
					"content": "#這樣好了！我跟老闆約好了今天在這裡見面，彙報工作進度。{F#妳}{M#你}們當面問他吧？反正也要等他結帳，我才能跟{F#妳}{M#你}分錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430305,
					"content": "真拿你沒辦法。既然恩里都這麼說了，就等一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430306,
					"content": "等了一會…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "親愛的恩里，情況如何啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430308,
					"content": "好得很，老闆！您要的七個神秘核心都收集齊完了。來來，讓我介紹一下，這是我的合夥人…叫什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430309,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430311,
					"content": "呃呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430312,
					"content": "哎？你們認識啊？那就好說了！事情是這樣的，老闆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430313,
					"content": "#「哎呀！是{NICKNAME}！為什麼{NICKNAME}在這裡？！」\\n「老闆」轉身就跑，卻被不知從什麼地方冒出來的亨特和特納逮住了！\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "哎呀！饒命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430316,
					"content": "嗚哇，這兩個人好熟練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430317,
					"content": "老闆別擔心，沒有生命危險的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430318,
					"content": "當然，當然。當然不會有生命危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430319,
					"content": "就目前而言的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430320,
					"content": "就、就目前而言…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430321,
					"content": "接下來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430322,
					"content": "是烤雞，抑或是…烤雞以外的東西，就取決於老闆您的態度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430323,
					"content": "噫噫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430324,
					"content": "你們怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430325,
					"content": "上次，我們…有幸相遇以後，我們決定監視恩里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430326,
					"content": "等等，為什麼要監視我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430327,
					"content": "不對，歸根到底，你們為什麼要針對我！明明我只是在努力工作而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430328,
					"content": "你拆掉的機器是楓丹科學院的人用來監測、改善水質的裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430329,
					"content": "欸？不是用來製造汙染的機器嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430330,
					"content": "拆出來的核心包含著最先進的機芯和楓丹的水文資料。我們希望能…認識您的交易對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430331,
					"content": "欸？欸？什麼？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430332,
					"content": "恩里！你騙我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "震驚！我們被騙了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "#不對不對，{F#妳}{M#你}是我的大恩人，我怎麼可能騙{F#妳}{M#你}啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430335,
					"content": "老闆，你騙我！你竟然騙我把這麼重要的東西弄壞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430336,
					"content": "我、我不是故意…我只是最下面的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430337,
					"content": "啊啊？老闆，您說什麼我沒聽清楚，還以為您說自己「不是故意的」…您再說一遍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430338,
					"content": "噫噫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "「老闆」"
				},
				{
					"id": 740430339,
					"content": "這位老闆看來是累了，睜著眼睛暈過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430340,
					"content": "呃呃，我、我們也不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430341,
					"content": "關於這個嘛，我們決定，不追究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430342,
					"content": "欸？沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430343,
					"content": "反正只要核心完好，其中的資料完好，機器根本無所謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430344,
					"content": "#上面說了無所謂。反正不能跟{F#妳}{M#你}們過不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430345,
					"content": "有什麼跟我過不去的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "沒什麼，沒什麼。您看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430347,
					"content": "我們只是在散步而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430348,
					"content": "真是偶遇，不是嗎？美好的天氣、美好的邂逅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430349,
					"content": "但是美好的邂逅總會結束，我們該…告別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430350,
					"content": "就讓美好的邂逅留在心中，或者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430351,
					"content": "忘了更好，忘了更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430352,
					"content": "欸…所以我們沒事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430353,
					"content": "怎麼，你想有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430354,
					"content": "沒事沒事！哈哈，當然沒事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430355,
					"content": "唉，本來我還以為遇上了好心人，總算能透過勞力改變命運了。到頭來，這世上還是壞人多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430356,
					"content": "…喂，恩里。來幫個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430357,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430358,
					"content": "真是不幸啊，這位好心的老闆神智不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430359,
					"content": "我們需要一位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430360,
					"content": "做事認真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430361,
					"content": "忠實可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430362,
					"content": "希望用勞力改變命運的…好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430363,
					"content": "沒錯，一位好朋友。來幫忙把這位好老闆帶到我們的安全屋去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430364,
					"content": "我們才方便…好好跟這位好心的老闆聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430365,
					"content": "當然了，我們會充分地…表達我們的謝意，透過摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "特納"
				},
				{
					"id": 740430366,
					"content": "嗯？嗯！算我一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430367,
					"content": "#太好了！謝謝你們！也很感謝{F#妳}{M#你}們，那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430368,
					"content": "#我是{NICKNAME}，她是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#謝謝{F#妳}{M#你}們，{NICKNAME}、派蒙！遇到{F#妳}{M#你}們以後，我的命運都改變啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430370,
					"content": "不用謝！要加油哦，恩里！不要再被騙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430371,
					"content": "嗯！不會的！我要努力工作，成為大富翁！以後雇用別人幫我做事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430372,
					"content": "亨特、特納和恩里將不省人事的愚人眾挖了出來，帶走了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "希望恩里能獲得幸福啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430374,
					"content": "等等！恩里說好的，給我們的報酬呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}