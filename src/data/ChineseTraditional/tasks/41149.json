			},
			"dialogs": [
				{
					"id": 411490301,
					"content": "聽說有特別訂單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "#對啊，{F#妳}{M#你}來得正好。早些時候，瓦里特先生在我們這訂了一份莊園烤鬆餅，錢也已經預付好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490303,
					"content": "然後，他讓我們晚些時候把餐送到明冠峽南面的一個地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490304,
					"content": "但不知道為什麼，最近要求外送的餐品越來越多，我們的人手都不夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490305,
					"content": "#如果{F#妳}{M#你}願意的話，就請幫忙跑一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
