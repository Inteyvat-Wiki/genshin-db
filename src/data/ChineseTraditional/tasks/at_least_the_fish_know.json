			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "這些機關魚…真是煩死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140802,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "修好過，但很快又壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140805,
					"content": "這片區域裡的機關魚不知道為什麼，就像是發瘋了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140806,
					"content": "我剛把魚苗投放出去，它們就直接撲了過來，不停地吃著魚苗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140807,
					"content": "因為有幾隻魚苗掛在了潛水服上，所以有些機關魚直接朝我撲了過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140808,
					"content": "雖然我知道它們其實不會攻擊我。但我…還是害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140809,
					"content": "然後，我就在水裡胡亂地掙扎，手腳亂揮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140810,
					"content": "不知道什麼時候，又把潛水服撞出了一道大裂縫…還好當時離岸邊不遠，我用盡方法，總算是上了岸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140811,
					"content": "但看現在的情況，我暫時是無法下水繼續投放魚苗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140812,
					"content": "#旅行者，{F#妳}{M#你}還願意再幫我去投放一下魚苗嗎？無論深水區或淺水區都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140803,
					"content": "妳修好潛水服了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}