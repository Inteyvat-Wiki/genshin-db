			"dialogs": [
				{
					"id": 240140101,
					"content": "…這裡的魚群又減少了，難道機關魚又開始活躍了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140102,
					"content": "必須把魚苗投入更深的水域才行，但潛水服怎麼這個時候壞掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140103,
					"content": "妳在做什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "#{F#妳}{M#你}好，初次見面，我叫莉諾蕾婭，是一名專職於報導環境問題的記者，正在這裡…投放魚苗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140105,
					"content": "記者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "#是的。就是{F#妳}{M#你}所理解的那種記者。但我和那些專注於公眾人物花邊新聞，或者是不斷重覆無聊消息的記者不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140107,
					"content": "我所關注的問題，是一件楓丹廷內正在發生、危害著公眾生活安全的嚴肅公共事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140108,
					"content": "而這件事，也是我來這裡投放魚苗的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140110,
					"content": "…您知道有關「機關魚」的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "莉諾蕾婭"
				},
				{
					"id": 240140111,
					"content": "沒聽說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "這是楓丹廷特有的魚類嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "為什麼要投放魚苗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
