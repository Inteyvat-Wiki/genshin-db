			"dialogs": [
				{
					"id": 740410601,
					"content": "嗯，讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740410602,
					"content": "如果能把先前收集到的資料匯總起來，應該能取得不錯的成果…恢復水文監測的事情，指日可待，指日可待呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740410603,
					"content": "哦哦，那真是太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410604,
					"content": "咦？總覺得好像缺了一部分資料…是錯覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740410605,
					"content": "為什麼說得這麼不確定啦！這不是你自己負責的資料嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740410607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410608,
					"content": "…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "…呃，抱歉，走錯房間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740410610,
					"content": "愚人眾指揮官，以一種與體型完全不符的敏捷，飛也似地溜走了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "等…等一下，剛才什麼東西過去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410612,
					"content": "好快，比龍蜥還要快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "不不不，現在好像不是關心那種事情的時候啦！那傢伙是愚人眾吧！為什麼會出現在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}，我們快點追上去，好好問個清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410613,
					"content": "還真是個靈活的傢伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
