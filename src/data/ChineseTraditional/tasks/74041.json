				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "不要再打了！我投降！投降！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411302,
					"content": "你…你們是為了這些紙帶來的吧？全都給你們！不要再打啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411303,
					"content": "愚人眾指揮官老老實實地交出了所有的研究資料…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "怎麼樣，布羅意，這些就是全部了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411305,
					"content": "呃，這個…也許吧？嗯，沒錯，這應該就是全部了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411306,
					"content": "算了，就當我沒問吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411307,
					"content": "你們的目的是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "對啊，老實交代！你們占領這些觀測站，到底是想要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411310,
					"content": "是…為了偷懶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411311,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411312,
					"content": "我的名字是馬林諾夫斯基，第三十四獨立偵察小隊的隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411313,
					"content": "一開始，我們剛被調派到楓丹的時候，大家過得都很開心，也沒有什麼困難的任務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411315,
					"content": "呃…所以這跟你占領觀測站有什麼關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411316,
					"content": "沒想到，就在幾個月前，由於人事異動，至冬那邊分派了一個叫舒米洛夫的傢伙給我，作為我的新副官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411317,
					"content": "舒米洛夫？啊，是之前在桔桔薄餅站那邊見到的那個小隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411318,
					"content": "是啊！我實在是受不了那傢伙了！但是又沒有辦法解決掉他，只好找個借口，主動外出執行任務，以便從他身邊逃開——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411319,
					"content": "等等，你講得我都糊塗了…那個叫舒米洛夫的傢伙，是你的副官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411320,
					"content": "是啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411321,
					"content": "那他不就是你的下屬嘛，上司為什麼必須聽下屬的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411322,
					"content": "那個可惡的傢伙，分明是我的下屬，卻總是擺出一副嚴肅的樣子來，讓其他人努力工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411323,
					"content": "他說的還都是無法反駁的正論——我總不能當著其他人的面，公開跟他說大家其實根本不想工作吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411324,
					"content": "正好，我看到附近有一些奇怪的塔，乾脆就說我們要來這邊調查，然後偽造了複律庭的信件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411325,
					"content": "哼，果然是你們偽造的！想想也是，複律庭怎麼可能把水文監測站交給你們管理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411326,
					"content": "布羅意，你還有什麼想問他的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411327,
					"content": "嗯…原來如此，您占據我們的觀測站，只是想要偷懶…不，只是想要在這個喧囂的世界中獲得片刻的安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411328,
					"content": "所以呢？您覺得在這裡休息的感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411329,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411330,
					"content": "呃…非常舒服？附近的風景也很漂亮，稍微午睡一下，就覺得心情都變得舒暢起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411331,
					"content": "對吧？尤其是一覺醒來，發現自己沒有任何不得不做的緊急工作，也沒有討厭的人盯著您，只要安心享受午後的陽光與微風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411332,
					"content": "就像是從一場夢醒來，立刻就進入了另外一場不必為任何事憂慮的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411333,
					"content": "呵，這才是生活，先生！真遺憾，您應該還沒有品嚐過瓦薩里迴廊限量販售的紅茶吧？要是您有機會的話——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411334,
					"content": "不不不，你們怎麼突然開始聊這種莫名其妙的話題啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411335,
					"content": "好了，你這傢伙，還是老老實實跟我們走一趟吧！是時候向楓丹科學院細數你的罪惡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411336,
					"content": "噫嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411337,
					"content": "請、請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411338,
					"content": "#{M#兩位恩人}{F#兩位恩人小姐}！這位先生實際上並沒有對我們的水文研究造成任何破壞，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411339,
					"content": "從客觀結果上來說，這位先生甚至還幫助我們收集了一部分資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411340,
					"content": "更何況，他也只是不想工作，想要過上美好幸福清閒的生活而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411341,
					"content": "是、是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411342,
					"content": "不，就算你們兩個說得這麼理直氣壯，這也不是什麼值得驕傲的事情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411343,
					"content": "#拜託了，好心的{M#先生}{F#小姐}！看在科學的份上，就請您寬宏大量，放過他這一次吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "布羅意"
				},
				{
					"id": 740411344,
					"content": "雖然和科學好像沒什麼關係…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "謝…謝謝你，先生，還有兩位！我發誓，我絕對絕對不會再做這種事了！從今往後，我一定會拼盡全力，只靠自己的能力偷懶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "馬林諾夫斯基"
				},
				{
					"id": 740411347,
					"content": "沒錯！最重要的就是那樣的決心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
