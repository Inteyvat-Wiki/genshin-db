					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "我放棄了自己的過去，今後也不想再對這個世界訴說些什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590303,
					"content": "#只想找人聊天的話，{F#妳}{M#你}不該找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590304
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590304,
					"content": "#{F#妳}{M#你}走吧。",
