			"dialogs": [
				{
					"id": 721590401,
					"content": "#呵呵，竟然還是贏不過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590402
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590402,
					"content": "#也罷，{F#妳}{M#你}的武技仍在精進，我卻因為心性所限再也悟不出更高深的奧義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590403,
					"content": "#不過，若{F#妳}{M#你}習得了新的技藝，我依然樂於見識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590404
					],
					"speakerTitle": "「公義」"
				},
				{
					"id": 721590404,
					"content": "那麼，下次再會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公義」"
