			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "#咳，不說這麼多了，不如{F#妳}{M#你}直接來試玩一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590302,
					"content": "遊玩「風行迷蹤」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "離開。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "好吧，如果有興趣試玩「風行迷蹤」的話，就過來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉蓋克斯"
				}
			]
		}
	]
