						"position": [
							3459.075,
							446.463,
							4717.811
						],
						"pointId": 340100825
					}
				]
			},
			"dialogs": [
				{
					"id": 746910101,
					"content": "#…咦？{NICKNAME}，我、我是看錯了嗎？那邊…是不是有一個嘟嘟可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910102,
						746910103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910102,
					"content": "這裡是楓丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				},
				{
					"id": 746910104,
					"content": "不…不對！那邊就是有一個嘟嘟可，看起來還是…那個…芭比洛斯女士的嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910105,
						746910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910105,
					"content": "太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910107,
					"content": "#哎呀，這可真是巧遇。{NICKNAME}，還有小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910108,
					"content": "從芭比洛斯女士這麼厲害的占卜師嘴裡聽到「巧遇」兩個字，總覺得有點微妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910109,
					"content": "真的是「巧遇」，我可沒有開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910110
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910110,
					"content": "#{NICKNAME}作為從世界之外而來的「降臨者」，命運沒有被錨定在提瓦特之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910111
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910111,
					"content": "#呵呵呵，包括我在內的許多占卜師，應該都無法預測{NICKNAME}的未來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910112
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910112,
					"content": "不過，這次的「巧遇」還真是恰到好處。前不久，我偶然窺見了一縷奇異的預兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910113
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910113,
					"content": "因為正好閒來無事，所以我就對著這一縷預兆稍做占卜，又對著占卜的軌跡外出追尋…算是找點樂子，小小休一個假吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910114,
					"content": "哦對了，在追逐預兆的過程中，我也捉到了幾根縹緲的命運之絲，也窺見了它們主人的樣貌，就是這幾位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910115
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910115,
					"content": "全都是…熟人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910116
					]
				},
				{
					"id": 746910116,
					"content": "#{F#妳}{M#你}看，我就說嘛，{NICKNAME}的朋友很多的，一定認識他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910117,
						746910118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910117,
					"content": "這聲音是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910119,
					"content": "#嗨，{F#妳}{M#你}們好啊，我們是不是好久沒見了？這次芭比進行占卜的時候，我也有參與喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910120,
					"content": "是的。要不是艾莉絲堅持，我就會將這些名字作為可忽略的變量，從占卜算式中去除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910121
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910121,
					"content": "那樣的話，妳不就沒辦法休假了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910122,
					"content": "而且！既然魔女得出了預言，那就絕對不能讓和預言有關的小朋友們失望啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910123,
					"content": "每一位小朋友都渴望著新奇的禮物、偉大的使命，還有神秘的預言…總之，絕對不能省略！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910124,
					"content": "…真是服了妳了。但是，如果能將這些微小的變量聚攏起來，應該也能稍微修正一下我的占卜算式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910125
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910125,
					"content": "所以我來了這裡，打算見一見他們，如果可能的話，也為他們送上一次簡單的占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910126,
					"content": "呃…那他們什麼時候會來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910127
					]
				},
				{
					"id": 746910127,
					"content": "我沒有空詳細占卜這些事，但總而言之——他們遲早會來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910128,
					"content": "所以才在這裡擺了個攤子，打算就這麼一直等下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910129,
					"content": "沒關係，這個嘟嘟可只是一個替身，我本人還在繼續做正經的研究呢，不算浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910130
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910130,
					"content": "沒錯！我還為芭比的嘟嘟可裝了自動感應系統，只要對應的人來到了攤位前，她就會得到提醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910131,
					"content": "而且，嘟嘟可也會扭動得更加開心，保證來的人移不開目光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910132
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910132,
					"content": "你怎麼又回來了？挪挪你的手臂，你快把我的水占盤推到地上了。還有，拿穩杯子，別把熱巧克力灑在我的稿紙上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910133,
					"content": "好嘛好嘛，你們稍等一下…這樣就可以了，對了芭比，這杯是妳的，真的只是微甜，我保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910134,
					"content": "妳所接受的微甜，和我所接受的微甜，絕對不是同一個甜度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910135,
					"content": "咳，說正事！總之呢，在芭比占卜出結果後，我本來打算跑一趟，把那群人聚在一起好好地辦一個超棒的聚會呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910136,
					"content": "我連送信的方式都想好了，還特意去找了好多帥氣的鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910137
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910137,
					"content": "想想看，在寂靜的深夜，純白的巨鳥咬著一封神秘的信件來訪，只要打開這封信，你就會面對一個全新的世界——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910138,
					"content": "可是，艾莉絲這麼做，只會擾亂命運的軌跡。而且，要處理一個這麼小的預言非常麻煩，所以我阻止了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910139,
					"content": "真遺憾，但聚會還是可以辦的，等到了適合的時機，我會來邀請所有人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910140
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910140,
					"content": "#為了讓聚會快點舉辦——{NICKNAME}、小派蒙！把這些人帶過來的任務，就交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910141,
					"content": "可、可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910142
					]
				},
				{
					"id": 746910142,
					"content": "哈哈…這樣應該也算是擾亂命運的軌跡吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910143,
					"content": "#嗯…這群人本就和{NICKNAME}有所關聯，從理論上來說，命運也已經糾纏在了一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910144,
					"content": "#由{NICKNAME}出面，將他們請過來，倒是對占卜影響不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910145
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910145,
					"content": "#不愧是{NICKNAME}，果然可靠。為了聚會，這件事就拜託{F#妳}{M#你}們啦，我保證為{F#妳}{M#你}們留兩個離蛋糕最近的好位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910146,
					"content": "…芭比，妳怎麼開始撕紙了？要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910147,
					"content": "我要塞住我的耳朵，妳和尼可兩個人一個吵耳朵，一個吵腦子。天啊，我真想念歐科塔維亞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910118,
					"content": "艾莉絲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910106,
					"content": "世界終於被嘟嘟可佔領了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910103,
					"content": "應該是之前看太多嘟嘟可了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				}
			]
		}
	]
}