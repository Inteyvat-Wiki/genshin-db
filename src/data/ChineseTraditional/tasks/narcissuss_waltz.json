			"dialogs": [
				{
					"id": 742540601,
					"content": "真是平靜愜意的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "瑪麗安"
				},
				{
					"id": 742540602,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742540604,
					"content": "嗯，感謝妳的邀請，桑多涅…妹妹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪麗安"
				},
				{
					"id": 742540603,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
