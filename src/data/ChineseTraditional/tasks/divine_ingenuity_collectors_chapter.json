			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "怎麼這次跑到蒙德來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740102,
					"content": "宏朗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "#旅行者！真是太巧了，沒想到會在這裡遇見{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740105,
					"content": "#至於現在的情況…看看旁邊這道門，{F#妳}{M#你}應該差不多明白了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740106,
					"content": "上次的那種秘境又出現了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "#沒錯。多虧了{F#妳}{M#你}上次幫忙探索了那個秘境，我們得到了很多寶貴的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740109,
					"content": "不過…雖然協會也已經幫忙四處調查，但幾乎沒有從外界找到更多有價值的資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740110,
					"content": "我們正準備派出更多人手探索，甚至聯絡了其他協會的人來幫忙，這個秘境卻突然消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740111,
					"content": "直到今天，它才突然出現在蒙德…多虧了蒙德冒險家協會的兄弟告訴我這個消息，我才能第一時間趕來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740112,
					"content": "你們開始探索了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "那是當然，秘境就在眼前，我們沒有退縮的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740114,
					"content": "這個秘境的「規則」似乎沒有變太多，仍然是根據進來的人的念頭而擬想出某種物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740115,
					"content": "但在探索過程中，我們發現…這處秘境居然可以變出一些「敵人」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740116,
					"content": "這些「敵人」會對我們發動攻擊，被攻擊到後，我們也會感受到真實的痛感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740117,
					"content": "怎麼說呢…簡直和真實的「戰鬥」沒什麼兩樣了，冒險家們對這件事也十分感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740118,
					"content": "但是，有些冒險家連自己擬想出的「敵人」都打不過，還要別人幫他搞定，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740119,
					"content": "#咳！不說這些了，旅行者，如果{F#妳}{M#你}願意的話，就再和我們一起探索這個秘境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740120,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "#哈哈哈，那太好了！有{F#妳}{M#你}幫忙，我們的工作一定能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740122,
					"content": "我不會遇到什麼危險吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "#呃…以{F#妳}{M#你}的身手，只要提高警覺，應該不會有問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740124,
					"content": "#總之，如果{F#妳}{M#你}願意的話，就幫我們探索一下這處秘境吧，有{F#妳}{M#你}幫忙，我們的工作一定能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740107,
					"content": "是你一直在研究的那種秘境？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}