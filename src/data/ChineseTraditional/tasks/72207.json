					"岻伽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722070101,
					"content": "還不夠呢…還不夠喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070102,
					"content": "哥哥留給我的寶藏，都在海螺裡喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070103,
					"content": "海螺呀海螺，散落得到處都是呢…到處都是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070104,
					"content": "是哥哥的寶藏喲…我還不能離開呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070105,
					"content": "寶藏…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "哥哥去了霧海以外的地方，祭司大人很生氣…他說哥哥的靈再也回不來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070108,
					"content": "但哥哥說：「那裡有好看的花，有珍珠的海…爸爸也在那裡划著船，帶著小妹妹招手呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070109,
					"content": "哥哥留下了他的寶藏，就沒有再回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070106,
					"content": "關於你的哥哥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
