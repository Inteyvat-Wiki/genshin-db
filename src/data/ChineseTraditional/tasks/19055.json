			"dialogs": [
				{
					"id": 190550901,
					"content": "轟大叔，貨已經到了，請來清點一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190550902,
					"content": "嗯，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "轟大叔"
				},
				{
					"id": 190550903,
					"content": "轟…唔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190550904,
					"content": "噓！別出聲，我們偷偷跟上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹿野院平藏"
