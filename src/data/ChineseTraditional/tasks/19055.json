			"trigger": {
				"objectNames": [
					"德田",
					"轟大叔",
					"將司"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "大叔的情報很準確啊，我們到的時候，那夥野伏眾居然還在睡大覺，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551002,
					"content": "被我們一網打盡，貨物也全部收繳回來了，都在這了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551003,
					"content": "我來清點…嗯…都沒問題，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "轟大叔"
				},
				{
					"id": 190551004,
					"content": "哪裡的話，多虧了轟大叔的商隊去努力貿易，村裡糧食的價格才能降下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551005,
					"content": "就是就是，還有我們這些老傷號，誰會想到打仗留下的後遺症這麼厲害啊，幸好有轟大叔帶回來的救命藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "將司"
				},
				{
					"id": 190551006,
					"content": "要多謝上面的支援，所以情況才會變好。村裡的庫存情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "轟大叔"
				},
				{
					"id": 190551007,
					"content": "今晚就要確認，明天一早，我去珊瑚宮請示五郎大人後，就得出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "轟大叔"
				},
				{
					"id": 190551008,
					"content": "放心，轟大叔，我們把清單都整理好了，跟我們來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "將司"
				}
			]
		},
