			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}，再次向{F#妳}{M#你}道歉，我沒有對{F#妳}{M#你}說實話，真的很過意不去，但我…不得不這麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551602,
					"content": "我理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "對了，心海知道這事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "珊瑚宮大人麼…只能說，戰爭帶來了很多糟糕的東西，也讓我們成長了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551605,
					"content": "那到底是知道還是不知道啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190551606,
					"content": "#這…{F#妳}{M#你}們不好奇，是誰推動的新商品法案嗎？不可能是勘定奉行，這對他們沒有直接好處，我們也沒有熟人在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551607,
					"content": "是哦，這樣說起來，就好像是神明的援手一樣，突然幫了你們一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190551608,
					"content": "哈哈，神明嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551609,
					"content": "前一陣子鳴神島那邊舉辦了容彩祭，我和珊瑚宮大人也應邀前去參加了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551610,
					"content": "那時我在集市等待，而珊瑚宮大人去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
		},
