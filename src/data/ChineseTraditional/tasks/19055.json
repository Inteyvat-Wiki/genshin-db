			"dialogs": [
				{
					"id": 190551701,
					"content": "她去見了那位神子大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551802,
					"content": "她去勘定奉行府見了那位神子大人，名義上是輕小說的鑑賞會，但會晤還有其他內容，雖然沒有公開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551803,
					"content": "在她回來以後，我們就開始了提振商貿的措施，而鳴神島那邊，很快也有了新商品法案的推動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551804,
					"content": "所以，你們覺得珊瑚宮大人知道這件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
		},
