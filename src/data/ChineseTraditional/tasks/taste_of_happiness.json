			"dialogs": [
				{
					"id": 730390101,
					"content": "哥哥們已經好好反省過了，無憂節是快樂的日子，蘭帕卡提不應該再生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730390102,
					"content": "對，蘭帕卡提不要再生氣了，快樂的日子，應該拿出「快樂的味道」來慶祝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730390103,
					"content": "是時候展示「烹飪修行」的成果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "蘭茶荼"
				},
				{
					"id": 730390104,
					"content": "早就準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730390105,
					"content": "嗯嗯！是無憂節大餐！我期待好久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730390106,
					"content": "好耶！無憂節大餐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "有桓那蘭那的水，最好的水，能做出最好的湯，那菈喝了一定滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730390109,
					"content": "#要把「快樂的味道」送給那菈{NICKNAME}和派蒙，應該讓那菈{NICKNAME}和派蒙來「指導」哥哥們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730390110,
					"content": "只有這樣，才能做出讓那菈滿意的菜餚，這才是招待「客人」的「禮節」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730390111,
					"content": "#那菈{NICKNAME}，願意「指導」哥哥們的烹飪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730390107,
					"content": "最好不要太過期待…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
