			"dialogs": [
				{
					"id": 710201001,
					"content": "這下可麻煩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201002
					],
					"speakerTitle": "小安"
				},
				{
					"id": 710201002,
					"content": "小昭讓我送這個給你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710201003
					]
				},
				{
					"id": 710201003,
					"content": "啊？港口裡的船隻情況統計表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201004
					],
					"speakerTitle": "小安"
				},
				{
					"id": 710201004,
					"content": "這個，怎麼說呢，雖然我其實最開始就準備好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "小安"
				},
				{
					"id": 710201005,
					"content": "但是還有新入貨物統計表、各種船隻報上來的船員情況、出入港口的外國人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "小安"
				},
				{
					"id": 710201006,
					"content": "要統計的表實在是太多了，我做了這個，又做那個，根本就忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小安"
				}
			]
		},
