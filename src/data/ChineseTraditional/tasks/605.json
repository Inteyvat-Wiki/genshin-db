			},
			"dialogs": [
				{
					"id": 6050201,
					"content": "兩位辛苦了，防禦得非常完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 6050202,
					"content": "接下來這裡交給我們就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 6050203,
					"content": "凱亞隊長，斯萬他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 6050204,
					"content": "喂！我沒事。倒是你的小腿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 6050205,
					"content": "斯萬、勞倫斯，都到西風教會接受治療吧，別勉強。我們會接手這一帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 6050206,
					"content": "可是，迪盧克老爺也…您不是早就已經離開騎士團了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 6050207,
					"content": "是啊，但也不是只有騎士團的人才能看守這扇大門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 6050208,
					"content": "老爺一向很熱心，唉，你就別管了。市民願意做些什麼，那就讓他做吧，也沒什麼不好，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 6050209,
					"content": "…我明白了。非常抱歉，我衷心感謝您能支援我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "斯萬"
				},
				{
					"id": 6050210,
					"content": "我們會盡快回來，多謝兩位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 6051104,
					"content": "趁現在有空，我打算做些藥劑分發給附近的戰士，應該能夠幫上一點忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 6051105,
					"content": "穩妥的判斷，辛苦妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 6051106,
					"content": "注意安全。雖然我不覺得會有這種情況，但如果出現妳無法應對的情況，立刻撤離到安全地區。不用擔心陣線問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 6051107,
					"content": "是，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "砂糖"
				}
			]
		},
