			"dialogs": [
				{
					"id": 6051101,
					"content": "#阿貝多先生！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 6051102,
					"content": "情況應該還好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 6051103,
					"content": "嗯！剛才有一些怪物衝進了城內，不過我跟迪盧克老爺和凱亞先生一起擊退了它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 6059901,
					"content": "不久之前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
