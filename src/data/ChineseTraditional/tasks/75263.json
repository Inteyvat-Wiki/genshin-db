			"dialogs": [
				{
					"id": 752630501,
					"content": "比賽結束！比賽結束！令人震驚的結果出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630502,
					"content": "#我宣布，本場比賽最終的勝者是——{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630503,
					"content": "#哇！{M#他}{F#她}也太強了吧！居然能打敗「來無影」和「去無蹤」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{F#她}{M#他}的身影就像一道金色閃電！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "喂喂，沒有銀色閃電嗎？你們都沒看見銀色閃電嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752630506,
					"content": "我輸得好徹底…這大概是我永遠抵達不了的速度吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "「疾風娜娜絲」"
				},
				{
					"id": 752630507,
					"content": "不要放棄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "#我…我會以{F#妳}{M#你}為目標的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "「疾風娜娜絲」"
				},
				{
					"id": 752630509,
					"content": "♪、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "#請收下我們為本屆冠軍準備的獎品，這是{F#妳}{M#你}應得的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630512,
					"content": "#{F#妳}{M#你}的名字將會被悠悠極速大賽的賽史永遠銘記！",
