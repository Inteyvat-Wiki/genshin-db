				"objectNames": [
					"基努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "各位遊客，悠悠極速大賽馬上就要開始了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630102,
					"content": "誰能擊敗昨天、前天和大前天的衛冕冠軍「疾風娜娜絲」，誰就能得到我們今天的驚喜大獎！請還沒有報名的遊客把握最後的時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630103,
					"content": "哼，面對我「疾風娜娜絲」，已經沒有人敢再報名了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630104,
					"content": "唉，「疾風娜娜絲」太強了，已經連續三天拿走獎品了，沒有人能贏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "嗷！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "欸？你想試試看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "哼，已經淪落到只敢讓龍出場了嗎？膽小鬼們，把你們各自的龍都派上來吧，我「疾風娜娜絲」會告訴你們什麼才是速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630108,
					"content": "真是一場別開生面的悠悠極速大賽！讓我們看看強壯的龍夥伴們能否擊敗三連冠的「疾風娜娜絲」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基努"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
