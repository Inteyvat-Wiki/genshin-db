			"dialogs": [
				{
					"id": 752630301,
					"content": "太不可思議了！真的有人擊敗了「疾風娜娜絲」！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630302,
					"content": "#這位挑戰者用來去如風的步伐奪得了今天的冠軍，讓我們恭喜{M#他}{F#她}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630303,
					"content": "我居然輸了…這不可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "「疾風娜娜絲」"
				},
				{
					"id": 752630304,
					"content": "#{M#他}{F#她}好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "但是——！老觀眾們應該都知道，「疾風娜娜絲」並不是悠悠極速賽場上出現過最強的選手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630306,
					"content": "在「疾風娜娜絲」之前，還有兩位堪稱恐怖統治級的本土選手，它們今天也來到了賽場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630307,
					"content": "讓我們歡迎來無影——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630308,
					"content": "♪、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "去無蹤——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630310,
					"content": "♫、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#挑戰者，這兩位可是真正可怕的對手，以{F#妳}{M#你}剛才表現的實力，要戰勝它們恐怕難於登天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630312,
					"content": "#{F#妳}{M#你}準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630313,
					"content": "準備好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "#員工們佈置好了賽場，觀眾也聚攏起來…{F#妳}{M#你}們站上了起跑線…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
