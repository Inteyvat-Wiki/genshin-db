				"objectNames": [
					"基努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "我也要報名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "出人意料的轉折，一位英勇的挑戰者出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630203,
					"content": "哦？不自量力的小鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630204,
					"content": "真是千迴百轉的進展…最後的贏家到底是誰？那就讓我們拭目以待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630205,
					"content": "#員工們佈置好了賽場，觀眾也聚攏起來…{F#妳}{M#你}們站上了起跑線…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
