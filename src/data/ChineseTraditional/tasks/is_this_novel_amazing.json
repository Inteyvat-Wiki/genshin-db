					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "火花飛濺，鐵錘和鐵砧不停碰撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100602,
					"content": "「天目鍛冶屋」真是個熱情澎湃的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100603,
					"content": "鐵匠們只用簡單的工具，就能把粗糙的原胚和礦石變成性能卓越的兵器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100604,
					"content": "那要是在鍛造的過程中，使用煉金術，豈不是能製造出無堅不摧的神兵利器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100605,
					"content": "煉金術沒有這麼誇張…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "嗯！這個主意不錯，讓主角擁有一把…由煉金術鑄就的最強武器！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100609,
					"content": "而且還要讓這把武器有一個好名字…和一個好來歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100610,
					"content": "沒錯，就這麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100611,
					"content": "旅行者，我們回去吧，我要把我的構思告訴阿茂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100606,
					"content": "你對煉金術有誤解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "誤解？什麼誤解，煉金術不就是那種…把不可能化為可能的技術嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "順吉"
				}
			]
		},
		{
