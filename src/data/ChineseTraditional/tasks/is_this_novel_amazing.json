				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "順吉，明天是交稿的最後期限，絕對不能再拖延了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100102,
					"content": "你再怎麼催我都沒用，劇情卡在關鍵的地方了，我不知道該怎麼寫才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100103,
					"content": "你們在吵什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "#是…是旅行者？{F#妳}{M#你}來得正好，正好{F#妳}{M#你}來評評理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100105,
					"content": "我是「八重堂」的編輯阿茂。這位是我負責的作家順吉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100106,
					"content": "他的新小說《鬼武道》本來很受歡迎，但他總是不能按時交稿，有時會拖延好幾週。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100107,
					"content": "這次他又犯老毛病了，如果明天還不交稿，這個月的小說合刊就沒法按時送印了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100108,
					"content": "實在不行，就延期發售吧，反正忠實的讀者還是會掏錢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100109,
					"content": "別開玩笑了，要是不能持續更新的話，小說的口碑會一口氣跌到谷底的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100110,
					"content": "但我沒有靈感啊。與其寫一些無趣的灌水章節，還不如好好思索一下真正有趣的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100111,
					"content": "但其他作者都已經都差不多交齊了，就差你一個人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100112,
					"content": "或許順吉先生真的需要靈感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "沒錯！這位朋友就很內行，我需要靈感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100114,
					"content": "也許四處轉轉，找找靈感，我就知道接下來該怎麼寫了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100115,
					"content": "喂，上次你就是拿這個藉口又拖了一天，還想來這套嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100116,
					"content": "這次絕對不會了，你也相信我一回啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100117,
					"content": "真是的…好吧，就再相信你一回…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100118,
					"content": "一定，一定不能再拖了，知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220100119,
					"content": "我知道了，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100120,
					"content": "呼…這回看來是真的不能拖了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100121,
					"content": "我們現在就去取材吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "我們還是去找靈感吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "但靈感這東西，有時候找也找不到啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100124,
					"content": "不過現在也只能四處找找看了，不然阿茂非把我的屋子給掀了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
