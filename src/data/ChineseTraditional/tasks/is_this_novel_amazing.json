					"nextDialogs": [
						220100811
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100811,
					"content": "好了，就這麼辦，我們回去把我的構思告訴阿茂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
