			"dialogs": [
				{
					"id": 220100801,
					"content": "同心們維持著花見坂的治安，可疑人士根本逃不過他們的監視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100802,
					"content": "敵國的騎士，和同心有著相同的職責，但為了更大的看頭，就設定成同心的…十倍實力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100803,
					"content": "這數值也太隨意了！",
