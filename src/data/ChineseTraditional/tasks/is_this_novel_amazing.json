				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "「九十九物」裡有著各式各樣的商品，和冒險途中收集到的物品很像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100702,
					"content": "葵小姐總是說，「一些其貌不揚的東西，也會被特定的買方看重」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100703,
					"content": "唔…看來想要讓商品賣出高價，看準買方重視的因素才是關鍵呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100704,
					"content": "但如果要這麼寫的話，就要花很大的功夫描寫心理博弈，和「鬼武道」這本小說的主題有點違和啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100705,
					"content": "不如讓主角可以讀心好了，這樣他就可以準確洞察買方的需求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100706,
					"content": "別突然增加設定啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "這就是人物的「成長」啦，沒關係的沒關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100710,
					"content": "我有靈感了，我明白該怎麼寫了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100711,
					"content": "旅行者，我們回去吧，我要把我的構思告訴阿茂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100708,
					"content": "都沒有劇情鋪陳的嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "劇情鋪陳…唔，這個我寫的時候會考慮的，應該不會有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "順吉"
