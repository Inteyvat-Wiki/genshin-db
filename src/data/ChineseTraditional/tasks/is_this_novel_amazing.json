			"dialogs": [
				{
					"id": 220100401,
					"content": "我正在構思的章節裡，主角獨自去往了敵人的領地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100402,
					"content": "想要在那裡對抗敵人們，蒐集情報是一項必要的工作，該怎麼讓他從容地度過這關呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220100403,
					"content": "唔，我們不如先去觀察一下同心們的工作吧。",
