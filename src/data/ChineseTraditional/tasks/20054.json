					"nextDialogs": [
						2005410116
					],
					"speakerTitle": "特納"
				},
				{
					"id": 2005410116,
					"content": "這些您拿著，留著路上用。還有那些戰利品，老頭子我也用不上，您也留著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005410117
					],
					"speakerTitle": "特納"
				},
				{
					"id": 2005410117,
					"content": "我們家，總算是要好起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				},
				{
					"id": 2005410113,
					"content": "您要回信給他嗎？",
