			"dialogs": [
				{
					"id": 2005416101,
					"content": "#{F#妳}{M#你}把戰利品和信給我老爹了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416102
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416102,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005416103
					]
				},
				{
					"id": 2005416103,
					"content": "「導能繪卷」的話…能從那些丘丘人薩滿身上找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416104
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416104,
					"content": "我想…它們是不是透過這個，來使用一些奇怪的力量呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416105
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416105,
					"content": "找到之後，就把信和戰利品一起送給我老爹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416106
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416106,
					"content": "虧我老爹還總是說「我們家就指望你了」，「我相信你會成為全蒙德最偉大的騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416107
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416107,
					"content": "可是我現在除了守門什麼也做不好，將來也完全不知道會怎樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005416108
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005416108,
					"content": "唉，我到底怎麼辦才好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蓋伊"
				}
			]
		},
