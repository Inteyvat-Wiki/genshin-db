					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005403105,
					"content": "#找到之後，就和信一起送給我老爹吧，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
