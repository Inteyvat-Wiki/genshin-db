			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蓋伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005401101,
					"content": "唉，天天守門，哪有什麼工作細節能寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401102
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401102,
					"content": "不，不如說是連工作內容都沒有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401103
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401103,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401104
					]
				},
				{
					"id": 2005401104,
					"content": "哦，這個啊…是我老爹的事，他叫特納，在晨曦酒莊工作。我當了西風騎士之後，他一直很高興，來信也盡是問我工作情況啦什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401105
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401105,
					"content": "但我就在這守門啊！還守的是個壓根沒多少人走的側門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401106
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401106,
					"content": "老爹還一直盼著我成就個什麼偉業…守個門怎麼能成就偉業嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401107
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401107,
					"content": "但是他身體一直不好，要是知道我在這守門，說不定就氣出個意外來，所以我在信裡說，我一直隨著騎士團的精銳在野外戰鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401108
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401108,
					"content": "但是一個勁地寫信，一點證據沒有，老爹肯定會懷疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401109
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401109,
					"content": "#{F#妳}{M#你}是準備出去冒險吧，能幫我去找點戰利品嗎？給我的信增添一點可信度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401110,
						2005401111
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401110,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401112
					]
				},
				{
					"id": 2005401112,
					"content": "太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401111,
					"content": "你不如自己去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401113
					]
				},
				{
					"id": 2005401113,
					"content": "雖然守門沒什麼前途，但是這也是騎士團分配給我的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401114
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 2005401114,
					"content": "我可不敢擅離職守…要是丟了這份工作，老爹非氣昏過去不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蓋伊"
				}
			]
		},
		{
