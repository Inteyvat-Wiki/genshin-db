					"nextDialogs": [
						2005410110
					],
					"speakerTitle": "特納"
				},
				{
					"id": 2005410110,
					"content": "這樣子下去，他一定能成大事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005410111
					],
					"speakerTitle": "特納"
				},
				{
					"id": 2005410111,
					"content": "客人，您在這等等，休息一下，我去拿點吃的給您…",
