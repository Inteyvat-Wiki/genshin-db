			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "阿貝多——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110102,
					"content": "回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110103,
					"content": "我們可是努力了好久，快看看劍的進展如何！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110104,
					"content": "你看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "唔…果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110106,
					"content": "和我想的一樣，這把劍會隨著戰鬥成長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110107,
					"content": "它又不是人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110108,
					"content": "所以這就是它的特殊之處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110109,
					"content": "對了，先說一件比較重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110110,
					"content": "我調查了附近的雪地，發現有不同尋常的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110111,
					"content": "呀，不會是小偷吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110112,
					"content": "不是說我們才是小偷嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "也對哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110115,
					"content": "我認為那些痕跡並不尋常，有調查的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110116,
					"content": "是小偷，還是別的東西，調查完自然會有結論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110113,
					"content": "盜寶團應該不這麼想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "居然是愚人眾？而且還選在盜寶團的營地裡襲擊我們…莫非他們是跟著我們來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110202,
					"content": "可是，為什麼要跟著我們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110203,
					"content": "#啊！該不會是{F#妳}{M#你}背著我去犯了什麼事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110204,
					"content": "#{F#妳}{M#你}犯事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110205,
					"content": "怎麼可能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "唔…那就不是我們的錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110208,
					"content": "我猜愚人眾也在找這把劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110209,
					"content": "哎哎？可是你不是把這把劍藏得很好嗎，愚人眾怎麼會知道它的存在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110210,
					"content": "#或許是{F#妳}{M#你}在雪山戰鬥的樣子被他們看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110211,
					"content": "如果愚人眾的人眼光夠好，就會發現這把劍的與眾不同之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110212,
					"content": "愚人眾怎麼什麼都要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110213,
					"content": "這可不是什麼都要哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110214,
					"content": "我記得我有聽說過相關消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "愚人眾在搜集與神有關的東西，你們應該已經知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110216,
					"content": "呀，這麼一說，確實聽迪盧克老爺提起過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110217,
					"content": "杜林是風神的仇敵，具有相當的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110218,
					"content": "說它是「能匹敵神的存在」也好，「與神有關的存在」也好，都不為過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110219,
					"content": "難怪這把劍會被愚人眾當成目標。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "原來是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110221,
					"content": "不久前來附近寫生，我有個新發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110222,
					"content": "從這裡向前，有一處較為特殊的土地。它的地脈流向與別處都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110223,
					"content": "周邊的怪物被它吸引，又受它影響，久而久之，身體素質會比同類更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110224,
					"content": "還有這種好事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110225,
					"content": "我們是要幫助這把劍成長對吧？來都來了，不如去試試手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110226,
					"content": "沒錯。順便還能觀察不同敵人對這把劍造成的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110206,
					"content": "我絕不可能做這種事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "有什麼感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110302,
					"content": "劍上的力量更強了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "我有一個推測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110305,
					"content": "這把劍從敵人身上吸收力量後，會與這座雪山深處暗藏的杜林亡骸發生共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110306,
					"content": "哇…好像很厲害呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412110307,
					"content": "如果這一猜想成立，那麼這座雪山上的怪物也可能與杜林的亡骸共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110308,
					"content": "為什麼會跟龍的亡骸共鳴呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "恐怕與這一帶怪物的力量來源有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110310,
					"content": "杜林不是一般的怪物。哪怕在它已經死亡的現在，整座雪山也依然受到它亡骸的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110311,
					"content": "神秘的龍之力…或許也是某種詛咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110312,
					"content": "#資訊還是不夠。想瞭解更多，就需要更多數據。這也正是我找{F#妳}{M#你}的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412110313,
					"content": "沒想到，聽故事也成了體力活呢…",
