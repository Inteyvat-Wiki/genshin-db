			"dialogs": [
				{
					"id": 105020501,
					"content": "關於莫娜的來歷與困境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020502,
					"content": "原來是這樣，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020503,
					"content": "蒙德城裡，有一間空著的<color=#00E1FFFF>魔法實驗室</color>，但被不知道什麼人施加了一個封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020504,
					"content": "雖然有幾位專家可以解開封印，但他們都有自己的實驗室了，對這件事不感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020505,
					"content": "#我覺得，如果{F#妳}{M#你}提到的占星術士能解開那個封印，房子的主人應該就會同意她住下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020506,
					"content": "我覺得她應該有辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "#好的，那我這就告訴{F#妳}{M#你}房子的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 105020507,
					"content": "我帶她去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
