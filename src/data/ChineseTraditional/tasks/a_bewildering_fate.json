	"talks": [
		{
			"id": 1050201,
			"completionStepIds": [
				1050202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050202",
							"2"
						],
						"stepId": 1050202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "#馬上就要見到那位繼承者了，{F#妳}{M#你}準備好了嗎？可別讓{F#妳}{M#你}的師父丟臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020102,
					"content": "我又不會算命…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "也對…不對！就算是假的弟子，也不能一問三不知吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020105,
					"content": "#雖然師門有規定，不得傳授外人，不過…如果是{F#妳}{M#你}，也未嘗不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020106,
					"content": "我的占星術是「水占術」，顧名思義，是透過水中的倒影觀看真正的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020107,
					"content": "#讓我先給{F#妳}{M#你}示範一下，看仔細了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020108,
					"content": "就目前的星象和走勢來看，嗯，那位繼承者是西風騎士，年輕有為…女性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020109,
					"content": "聽這個描述…唔…難道是麗莎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020110,
					"content": "我們馬上就會在這裡遇見她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020111,
					"content": "好了，有這麼多訊息應該就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020112,
					"content": "就，就結束了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "唉，看來就算是最基礎的占星術，也不是一目了然的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020115,
					"content": "#算了，等會再詳細跟{F#妳}{M#你}講，她已經來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020116,
					"content": "#哇，是榮譽騎士{F#姐姐}{M#哥哥}！還有小派蒙，{F#妳}{M#你}們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020117,
					"content": "——就是她！偉大學識的繼承者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020118,
					"content": "…妳說可莉？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "繼承者…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020121,
					"content": "沒錯，我就是那個洞悉了星海秘密的占星術士！妳也早就計算出我的到來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020122,
					"content": "星海？星海是什麼，星海裡也有魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020123,
					"content": "魚…？不，別裝糊塗了。妳是在害怕我的挑戰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020124,
					"content": "姐姐妳才是，在說什麼呀！我一點都沒聽懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020125,
					"content": "這樣聊下去會沒完沒了的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "但我的占星術是不會錯的…唔，以防萬一我還是問一下，妳的媽媽叫「艾莉絲」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020128,
					"content": "對啊。哦！姐姐是媽媽的朋友啊。但是，媽媽現在去了很遠的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020129,
					"content": "這個我知道——是占星的結果。但在她走之前，應該把她懂得的神秘學知識，都留給妳了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020130,
					"content": "神秘學，知識…聽不太懂，媽媽只教了我要怎麼做蹦蹦炸彈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020131,
					"content": "原來可莉的媽媽，就是莫娜師父的「朋友兼勁敵」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020132,
					"content": "是的。我師父雖然很擅長占星術，但她也只懂占星術。艾莉絲就不一樣了，她是精通各種神秘領域的全才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020133,
					"content": "所以…可莉年紀這麼小，就算聽了那些高深的知識，也聽不懂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020134,
					"content": "嗯，看來是只繼承了血脈，還沒繼承知識…真是失算，這根本沒法較量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020135,
					"content": "對了，這位小朋友。艾莉絲走之前，告訴過妳「五十年之約」，和那個箱子的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020136,
					"content": "哦哦，這個我知道！原來姐姐是來拿那個箱子的呀。我找找，等一下哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020137,
					"content": "不是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020138,
					"content": "也不是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020139,
					"content": "不對不對，這個也不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020140,
					"content": "啊！我想起來了，我把它和我的新寶物都藏在<color=#00E1FFFF>風起地</color>了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020141,
					"content": "不會又是炸彈吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "#{F#妳}{M#你}們等我一下，我馬上拿過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020144,
					"content": "別跑啊！妳包裡的東西都不要了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020145,
					"content": "#我幫她收拾這些東西，{F#妳}{M#你}們去追她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020146,
					"content": "唉，看她這麼冒冒失失的，我真擔心箱子會出什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105020142,
					"content": "為什麼總把重要的東西埋在野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "所以說絕對是搞錯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "絕對是搞錯了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "我還沒看清呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "我又不會占星…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050204",
							"2"
						],
						"stepId": 1050204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "到了到了，就是這裡，我們來把寶物挖出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020202,
					"content": "這一定是草史萊姆吧。",
