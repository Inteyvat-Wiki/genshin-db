					"content": "我找到了，就是這個箱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 105020302,
					"content": "沒有被炸壞真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105020303,
