			"dialogs": [
				{
					"id": 747050101,
					"content": "…我覺得是這條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050102,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747050103,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050104,
					"content": "看看這尾巴的顏色，整個水族箱裡沒有比牠更時髦的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050105,
					"content": "雖然顏色豔了點，但好吧，就當妳是在誇我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050106,
					"content": "哇！好多人啊！大家都是來逛水族館的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050107,
					"content": "嗯，剛拍完一個鏡頭，趁休息時間來欣賞一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747050108,
					"content": "妳們剛剛在聊什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050109,
					"content": "哪條魚和千織比較像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050110,
					"content": "怎麼妳們也…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050111,
					"content": "啊…哈哈，好像是聊天時聽哥倫比婭小姐提到類似的話題，覺得很有趣，我們不知不覺就也這麼玩起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747050112,
					"content": "原來這東西還能傳染的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050113,
					"content": "哦！那條像妳，夏沃蕾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050114,
					"content": "怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050115,
					"content": "一閒下來就繞著水缸游圈圈，在鍛煉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747050116,
					"content": "…我在妳心裡就這個形象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏沃蕾"
				}
			]
		}
	]
