					}
				]
			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "啊…奈芙爾老闆！天啊，您來得正巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380102,
					"content": "下定決心了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380103,
					"content": "欸？下定…您、您說什麼？難道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380104,
					"content": "我知道，你一直想要去「霜月之子」那邊拜訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380105,
					"content": "所以，你希望先結識莉莉希，想要用這段友誼作為拜訪「霜月之子」的敲門磚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380106,
					"content": "您…您都知道了，唉呀，我明明都把這件事憋在心裡，沒怎麼和別人說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380107,
					"content": "祖潘科先生，人在保守秘密時，也要學會隱瞞「正在保守秘密」這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380108,
					"content": "不然的話，你在心裡豎起的那道牆，遲早會開始漏風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380109,
					"content": "唉，我在家鄉的時候，就不怎麼會隱瞞心思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380110,
					"content": "算了，既然您都知道了，那您能幫我引薦一下嗎？我是外鄉人，貿然去打擾莉莉希小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380111,
					"content": "她們「霜月之子」的人都好心得很，別說來訪者是外鄉人，就算不是人，也會溫柔地接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380112,
					"content": "啊？真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380113,
					"content": "但無論如何，貿然打攪總是不太禮貌，還是請奈芙爾老闆代為引薦一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380114,
					"content": "好，現在她們應該剛好發放完餐點了，是一個不錯的聊天時機，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380115,
					"content": "啊…這一次就不用收費了，我只是恰巧路過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761380116,
					"content": "謝謝您，奈芙爾老闆！我這就去收拾東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖潘科"
				}
			]
		},
