			},
			"dialogs": [
				{
					"id": 40190201,
					"content": "猜猜下一張是什麼花色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190202,
					"content": "唔…呲牙咧嘴貓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190203,
					"content": "#啊，是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190205,
					"content": "#{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190206,
					"content": "菲米尼看起來恢復得差不多了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190207,
					"content": "嗯，託大家的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190208,
					"content": "對了！我…我鼓足勇氣跟克洛琳德小姐道過謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190209,
					"content": "哇，她有什麼反應？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190210,
					"content": "她說沒關係…她好像完全不覺得救人是件大事，還要我別放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190211,
					"content": "是不想給你壓力。確實別太在意比較好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190212,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190213,
					"content": "聽我說！我們回了一趟歌劇院，在那裡遇到了「僕人」哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190214,
					"content": "#「父親」？她有對{F#妳}{M#你}們說什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190215,
					"content": "說了一些比較奇怪的話，還說期待未來某日跟我們合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190216,
					"content": "有點意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "#「父親」對{F#妳}{M#你}們的態度比我們想的還要好一些…太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190218,
					"content": "#{NICKNAME}，{F#妳}{M#你}得相信「父親」，她有她的職責，必要時她會聯合一切可動用的力量，其中也包含{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190219,
					"content": "嗯，「父親」非常優秀，值得信賴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190220,
					"content": "噢，說到這個，她還說林尼太好強了，偶爾也要學著依賴別人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190221,
					"content": "呃…我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190222,
					"content": "果然是「父親」會說的話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190223,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190224,
					"content": "#{F#妳}{M#你}們會暫時留在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190225,
					"content": "應該是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190226,
					"content": "好，我們可以開茶會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190227,
					"content": "真的？那我還想吃蛋糕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190228,
					"content": "#「還」的意思是，{F#妳}{M#你}們在上面吃了好吃的蛋糕。嗯，真好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190229,
					"content": "下次也跟我們一起喝茶吃點心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳妮特"
				}
			]
		},
