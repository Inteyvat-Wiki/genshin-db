			"dialogs": [
				{
					"id": 40190101,
					"content": "護士長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190103,
					"content": "還好嗎？沒有傷到哪裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190104,
					"content": "請放心，我們很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "沒事哦！你們呢？發生那麼大的事，亂成一團，沒出太大問題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190106,
					"content": "少數人受了點外傷，整體還好。那維萊特先生過來了一趟，多虧他我們才能暫時壓制住危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190107,
					"content": "#也要謝謝{F#妳}{M#你}們幫的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190108,
					"content": "那維萊特怎麼知道這裡需要他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190109,
					"content": "那維萊特先生與水元素的呼應很強，漲水時海洋產生了巨大的波動，他能感受到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190110,
					"content": "#我幫犯人包紮時還遇到那對炸彈兄弟一直說{F#妳}{M#你}們兩個頭也不回的跑去樓下了呢，看見{F#妳}{M#你}們沒事我才能放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190111,
					"content": "不趕時間的話，請在這裡多留幾天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190112,
					"content": "有什麼想吃的隨時跟我說，我請韋爾塞先生去安排，累了也可以到醫務室休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190113,
					"content": "#我剛好也想多觀察觀察{F#妳}{M#你}們的面部肌肉。{F#妳}{M#你}們開心的笑容非常有感染力，很不錯喲，讓我念念不忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				}
			]
		},
