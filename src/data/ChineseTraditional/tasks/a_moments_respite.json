			"dialogs": [
				{
					"id": 40190401,
					"content": "#咦？{F#妳}{M#你}們…{F#妳}{M#你}們怎麼回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "庫斯圖"
				},
				{
					"id": 40190402,
					"content": "庫斯圖！拉韋蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190403,
					"content": "#喂，{F#妳}{M#你}們不是被抓回來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "拉韋蘭"
				},
				{
					"id": 40190404,
					"content": "欸？沒有啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190405,
					"content": "#該死！還以為{F#妳}{M#你}們趁著上次的騷動逃出去了呢，我以為{F#妳}{M#你}們是難得的成功逃獄者，沒想到{F#妳}{M#你}們…{F#妳}{M#你}們根本就沒走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "庫斯圖"
				},
				{
					"id": 40190406,
					"content": "啊哈哈…不好意思，我們只是有點事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190407,
					"content": "#好了好了，別糾結這些。沒事就好，這傢伙一度很擔心{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "拉韋蘭"
				},
				{
					"id": 40190408,
					"content": "別光說我！你不也是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "庫斯圖"
				},
				{
					"id": 40190409,
					"content": "嗯，我也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "拉韋蘭"
				},
				{
					"id": 40190410,
					"content": "這幾天我也被調去廚房幫忙了，剛才工作的時候庫斯圖還對著胡蘿蔔喃喃自語：「那兩個傢伙沒事吧？還活著嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "拉韋蘭"
				},
				{
					"id": 40190411,
					"content": "這種時候我就說：「沒事的，一定已經在哪裡喝著飲料看風景了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "拉韋蘭"
				},
				{
					"id": 40190412,
					"content": "#欸！關心一下獄友很正常吧？{M#他們}{F#她們}都這麼愛聽我講八卦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "庫斯圖"
				},
				{
					"id": 40190413,
					"content": "這兩個傢伙…比想的更熱心更有人情味呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190414,
					"content": "最近的福利餐一定會很好吃吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "#…嘿，{F#妳}{M#你}這傢伙。記得多吃點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫斯圖"
				},
				{
					"id": 40190415,
					"content": "兩位大哥幫忙，餐廳會很厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
