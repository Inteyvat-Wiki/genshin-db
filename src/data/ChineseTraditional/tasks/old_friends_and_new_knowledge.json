			"trigger": {
				"objectNames": [
					"賽巴斯",
					"阿貝多",
					"「萊茵多特」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1195.911,
							375.446,
							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "阿貝多，難得見到你這麼閒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051302,
					"content": "不過，既然完成了萊茵多特主人留下的「課題」，你的確也應該放鬆放鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051303,
					"content": "#{F#妳}{M#你}看！{F#妳}{M#你}話都沒說完，麻煩就找上門了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051304,
					"content": "賽巴斯，你怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051305,
					"content": "阿貝多認識牠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "是，牠也是我老師萊茵多特的造物，勉強算是我的「家庭成員」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051307,
					"content": "不愧是你的家庭關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "勉強？你這是什麼口氣？那麼大一個屋子，就我一個管家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051309,
					"content": "你和萊茵多特主人用過的瓶瓶罐罐，可都是我一隻貓來清理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051310,
					"content": "你…不是一隻貓嗎？貓要怎麼做管家啊？還要收拾瓶瓶罐罐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051311,
					"content": "妳怎麼會飛在天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051312,
					"content": "欸？我一直都會啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051313,
					"content": "我也一直都會。請不要把事實當做問題，這種問題找不到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051314,
					"content": "你，你你你…好生氣！我要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051315,
					"content": "牠的主人是萊茵多特…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "我…我要拒絕聽牠講話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051318,
					"content": "閒話就到此為止。阿貝多，我此次前來，是受萊茵多特主人所命，向你遞送口信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051319,
					"content": "咳咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051320,
					"content": "「親愛的阿貝多，很高興你為那個課題找到了『自己認可的解』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051321,
					"content": "「不過，被解答後的問題，就失去了為之思考的意義。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051322,
					"content": "「你腦子裡那枚閒不下來的鐘擺，現在應該已經快要擺向『無聊』那一端了吧？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051323,
					"content": "「那麼，你不如嘗試一下，自己向自己提問吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051324,
					"content": "「丟開『已知的答案』，尋找『未知的問題』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051325,
					"content": "「問題總是比答案更有趣的，也更能打發時間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051326,
					"content": "「我很期待下次見面時，你會為我帶來什麼樣的『問題』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051327,
					"content": "「如果你能找到連我都未曾設想過的問題，那就最好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051328,
					"content": "「雖然這種可能性不太大，但你還是先努努力吧。如果你運氣夠好，說不定真的能嚇我一跳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051329,
					"content": "「對了，別想著造一個專門用來思考或者回答問題的『自己』。師父我已經試過了，壓根沒用。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051330,
					"content": "「最後說一句，我讓賽巴斯順便替你帶了一份禮物，注意收起來，也別餵牠吃東西，牠根本不會餓。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051331,
					"content": "謹遵老師教誨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051332,
					"content": "咳，咳咳咳，萊茵多特主人就說了這麼多…真是費勁，咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051333,
					"content": "你已經聽到口信了，我就不在這個冷得要命的地方陪你玩了。我接下來還得去蒙德城裡送口信呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051334,
					"content": "蒙德城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "蒙德城裡還有和萊茵多特有關的人…啊！難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051336,
					"content": "雖然他剛剛「誕生不久」，但萊茵多特主人早已預見了他所需要解決的「課題」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051337,
					"content": "好了好了，我真的要走了，這地方太冷，凍得我尾巴痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051338,
					"content": "萊茵多特主人給你的「禮物」我放桌上了，記得收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "賽巴斯"
				},
				{
					"id": 100051339,
					"content": "阿貝多…你的家庭關係，好像越來越複雜了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051340,
					"content": "又突然冒出來這麼一隻貓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "但話又說回來，這隻貓真的能算成你的「家庭成員」嗎？雖然牠自稱是管家什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051342,
					"content": "賽巴斯的確很早就被老師創造出來了。如果按照一般人的理論，賽巴斯應該算是我的「長輩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051343,
					"content": "不過，鑑於我們並不是一般的「家庭」，所以這一層關係也沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051344,
					"content": "但我當時的確受了賽巴斯不少照顧，牠除了幫我收拾瓶瓶罐罐外，有時候甚至會當我的素描模特兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051345,
					"content": "等一下，你今天畫的這隻貓，難道就是賽巴斯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051346,
					"content": "沒錯，這是我的一個習慣。在思考某些問題時，我會讓我的手進行一些無意識的工作，以此來輔助思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051347,
					"content": "這個時候，我一般就會選擇默畫賽巴斯的畫像…畢竟畫了不知道多少遍，已經很熟練了，基本不用動腦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051348,
					"content": "這樣一說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "我還以為那就是普普通通的一隻小貓呢！怎麼來頭也這麼大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051351,
					"content": "#現在，妳知道這隻貓的真名了。之後要是有空，我可以為{F#妳}{M#你}們多講一些牠和我的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051352,
					"content": "但現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051353,
					"content": "「樹為最完美的果實驕傲，它是如此圓滿而無瑕疵。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051354,
					"content": "「但是寄宿了夢的種子啊，不要只當果殼中的宇宙之王。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "「萊茵多特」"
				},
				{
					"id": 100051355,
					"content": "…我要繼續思考了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100051349,
					"content": "之前的確見過阿貝多畫貓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "派蒙，不然還是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
