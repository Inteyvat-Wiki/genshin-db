			"dialogs": [
				{
					"id": 100050201,
					"content": "阿貝多，你果然在這裡啊。嗯…你是在畫畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050202,
					"content": "嗯，之前太忙沒空畫畫，最近正好閒下來，想重新撿起畫筆，練習一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050203,
					"content": "之前的確經歷好多事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "#是啊。但好在有{F#妳}{M#你}們和騎士團的大家協助，算是有驚無險地解決了那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050205,
					"content": "而且，我還完成了老師留給我的最後一個課題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050206,
					"content": "要論結果，可以說是再完美不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050207,
					"content": "砂糖最近也學習得很快，已經能獨立處理很多和煉金相關的事務了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050208,
					"content": "騎士團暫時也沒什麼需要我出面解決的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050209,
					"content": "沒有課題、沒有事務、沒有麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050210,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "沒什麼。我想，或許是習慣了每天都高頻用腦的日子吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050213,
					"content": "就這樣完全地閒下來，老實說，我還真的有點不適應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050214,
					"content": "總是不由自主地思考還有什麼問題等待著我去解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050215,
					"content": "但是很遺憾，在目前的蒙德城，似乎所有問題都已經有了「完美的解」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050216,
					"content": "休息一下也沒什麼不好啊。要是每天都忙忙碌碌的，那身體不就累壞了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050217,
					"content": "實在不行，就和我們一起出去玩吧！我可是很懂怎麼偷懶的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050218,
					"content": "呵呵，那就要請派蒙好好教教我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 100050219,
					"content": "要是你真的想找點麻煩解決…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "#呸呸呸，不許說！每次{F#妳}{M#你}說這種話的時候，麻煩就會——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050220,
					"content": "那也好辦，只要有我在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "是遇到新麻煩了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
		{
