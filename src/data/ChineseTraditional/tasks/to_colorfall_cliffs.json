			"dialogs": [
				{
					"id": 150400101,
					"content": "到了！這裡就是地圖上說的「沫彩花海」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400102,
					"content": "怎麼…那麼綠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400103,
					"content": "比起花海更像是草海。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "哈哈，和我想像中的畫面是有點不一樣…不過這種事情也是經常發生的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400105,
					"content": "你說景點的宣傳比實際更好？從我的角度出發，眼前的程度已經到可以投訴的地步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400106,
					"content": "如果我不投訴，我的客人也會投訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400107,
					"content": "不不不，是我沒有表達清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400108,
					"content": "我說的是有落差感這件事。我看到的，經常和我想像的不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400109,
					"content": "該不會是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400110,
					"content": "嗯，比如為了眺望風景登上山頂，山間卻突然升起了濃霧，連下山路都看不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400111,
					"content": "或者回到帳篷之後發現裡面鑽進了一隻火史萊姆，把收集來的木材全點燃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400112,
					"content": "聽起來有點可憐啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400113,
					"content": "我倒是已經習慣了，總結來說，都是冒險路上的波折！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400114,
					"content": "所以，這一帶風景廣袤無垠，嗯…空氣清爽又乾淨，還沒有出現魔物…已經很幸運了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400115,
					"content": "我認為最幸運的是你能保持這樣的心態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400117,
					"content": "阿夏是不是發現了什麼？聽它叫聲是那個意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400118,
					"content": "才過多久呀，你們熟悉得太快了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400119,
					"content": "（看了閱讀物）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "這就是所謂的「死對頭」嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400121,
					"content": "如果雙方都是人，還可以透過溝通來解決，可惜對方是隻阿夏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400122,
					"content": "好，我們來伸出援手吧！阿夏，準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400124,
					"content": "啊？我聽漏了什麼？怎麼這就到「開始行動」這一步了？你們要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400125,
					"content": "阿夏們的愛好非常容易觀察總結，那就是染色，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400126,
					"content": "沒錯倒是沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400127,
					"content": "而阿夏的心思都很單純。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400128,
					"content": "比起存心要給負責這片區域的工作人員添麻煩，我想，更有可能的是它不喜歡平平淡淡、毫無藝術特色的草地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400129,
					"content": "再加上那兩位的溝通很不順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400130,
					"content": "嗯，所以只要我們能把草地噴塗成漂亮的顏色，符合大家對於「花海」的想像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400131,
					"content": "說不定既能得到藝術家阿夏的認可，又能為那位員工解決煩惱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400132,
					"content": "沒錯，這就是我想做的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400133,
					"content": "有想法，看來你也滿適合做「調停人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400134,
					"content": "我也加入。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400136,
					"content": "哈哈，好癢…別這樣…等等，我們這是要去哪裡？遠不遠？要跟朋友先說一聲——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400137,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400138,
					"content": "翻譯小姐，妳看懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400139,
					"content": "可能是要搬什麼東西，或者附近還有更迫切需要幫忙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400140,
					"content": "這兩者的意思幾乎沒關聯吧！還有…妳是怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400141,
					"content": "嗯…看多了就覺得它們的肢體語言跟龍有不少相似之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400142,
					"content": "呃…妳別騙我，真的有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400143,
					"content": "我的「媽媽」會用舉起翅膀這個動作表達「今天早點回來吃飯」和「你小子找打」這兩種截然不同的含義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400144,
					"content": "那妳要怎麼區分呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400145,
					"content": "小時候就是區分不清楚，早早回家結果挨了一頓打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400147,
					"content": "結構很牢固，運行速度也快…這就是納塔的熱氣球嗎？太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400148,
					"content": "各位，我們回來啦！看天上看天上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				}
			]
