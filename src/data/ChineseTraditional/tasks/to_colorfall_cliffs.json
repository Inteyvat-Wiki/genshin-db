			"dialogs": [
				{
					"id": 150400301,
					"content": "哇，效果真棒！「沫彩花海」終於像模像樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150400302,
					"content": "各位都辛苦啦，剩下的，只需要找到那位工作人員說一聲就行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400303,
					"content": "幾位請留步，呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400304,
					"content": "說來就來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400305,
					"content": "別急，請慢點說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400306,
					"content": "呼…好的，我是負責彩彩崖主要挑戰設施「飄飄巡風阿夏」的工作人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400307,
					"content": "剛才從高處看到這裡的草地突然之間變成了花海，還是那麼富有藝術美感的配色，嚇得望遠鏡都快掉了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400308,
					"content": "你們…你們簡直是彩彩崖的救星啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150400310,
					"content": "舉手之勞，嘿嘿，出力的主要是他們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400311,
					"content": "#{M#兩位救星先生}{F#救星小姐和救星先生}，請問你們願意嘗試我這邊的設施…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400312,
					"content": "不…請問你們願意為我們的標誌性建築染上色彩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400313,
					"content": "聽著好厲害啊…真的可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400314,
					"content": "當然可以，絕對可以，不如說…懇請你們答應！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400315,
					"content": "一想到我那位同事平白蒙受了各位的照顧，我理應替他答謝你們！我想這份體驗或許比酬金更特殊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "提可菈"
				},
				{
					"id": 150400316,
					"content": "那我還是覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150400317,
					"content": "她的意思是我們答應了！哈哈，請問要怎麼過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150400318,
					"content": "請隨我來，我們乘坐熱氣球上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提可菈"
				}
			]
