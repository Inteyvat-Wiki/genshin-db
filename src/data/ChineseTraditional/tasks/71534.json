			"dialogs": [
				{
					"id": 715340101,
					"content": "唔…還是先參考一下其他「祝柬」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340102,
					"content": "#{NICKNAME}，許久未見…{F#妳}{M#你}為什麼一副驚訝的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340103,
					"content": "不，只是沒想到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "沒想到我一介武人也有來海燈節的雅致？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340105,
					"content": "平常都沒怎麼看妳放鬆過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "「天領奉行」責任重大，我身為其中一員，平時容不得一絲一毫的放鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340107,
					"content": "在旁人看來，我或許的確是一位不懂雅致的武人…與花見坂裡的那些舞樂之聲格格不入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340108,
					"content": "但是如果我在平日裡隨意放鬆心神，讓宵小之徒有可乘之機，那…只怕不僅是我，整個花見坂的舞樂聲都會沉寂下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340109,
					"content": "最多，就像這樣見縫插針，勉強抽出些空閒來四處走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340110,
					"content": "抱歉，佳節當前，不該說這些嚴肅的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340111,
					"content": "#我正在試著做一封「祝柬」，但始終不得其法，如果{F#妳}{M#你}願意的話，能給我一些製作的建議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 715340112,
					"content": "好啊，讓我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
