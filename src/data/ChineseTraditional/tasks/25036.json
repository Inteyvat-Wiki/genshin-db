			"dialogs": [
				{
					"id": 250360101,
					"content": "…果然這個問題還是太簡單了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360102,
					"content": "喔，真不好意思，我剛才在思考，沒注意到您過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360103,
					"content": "向您問好，我是「煙謎主」的凱塔，正在這裡做學徒，負責管理資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360104,
					"content": "你在思考什麼問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "啊…只是一些有關納塔的過去、現在和未來的簡單問題，不值一提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360106,
					"content": "您看起來是一位來自遠方的旅者，我可以感覺得到您交遊良多，所思甚廣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360107,
					"content": "如果您願意的話，可以體驗看看我已經記錄在冊的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250360108,
					"content": "這些問題的答案就在您的旅途之中——無論過去、現在還是未來的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱塔"
				}
			]
		},
