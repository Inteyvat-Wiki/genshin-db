					"speakerTitle": "凱塔"
				},
				{
					"id": 250361304,
					"content": "固晶甲蟲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250361002
					]
				},
				{
					"id": 250361002,
					"content": "唔…略有差池，尚需思慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250361303,
					"content": "燃素。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250361001
					]
				},
				{
					"id": 250361001,
					"content": "的確如此，毫無錯漏。",
