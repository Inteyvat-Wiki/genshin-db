					"nextDialogs": [
						250361204,
						250361205,
						250361203,
						250361206
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250361204,
					"content": "「煙謎主」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250361002
					]
				},
				{
					"id": 250361002,
					"content": "唔…略有差池，尚需思慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250361205,
					"content": "「浮燃鳥」部族。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250361002
					]
				},
				{
					"id": 250361203,
					"content": "「懸木人」。",
