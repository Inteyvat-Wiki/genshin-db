			"dialogs": [
				{
					"id": 250361101,
					"content": "群山之中始終迴響著「回聲之子」的鍛錘聲，他們是優秀的匠人、堅忍的戰士，再堅硬的岩石也無法阻擋他們的腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250361102
					],
					"speakerTitle": "凱塔"
				},
				{
					"id": 250361102,
					"content": "我的問題是：「回聲之子」的夥伴們是誰？真名為何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250361103,
						250361104,
