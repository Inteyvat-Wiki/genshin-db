					"哈里森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090108,
					"content": "這些東西總算是送到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090109,
					"content": "拖了這麼長時間，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090110,
					"content": "這箱怎麼還破了個角，哎喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090111,
					"content": "叫他小心點！不會把裡面的東西給碰碎了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090112,
					"content": "還好，沒有瓶子碰碎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090113,
					"content": "咦？這瓶的蓋子怎麼鬆了…得先擰下來，再裝上去才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090114,
					"content": "咳！咳…這調酒材料的味道可真是…太激烈了，還是快點搬走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090115,
					"content": "欸，什麼，怎麼這麼多史萊姆？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里森"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈里森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "#謝謝，謝謝，太謝謝{F#妳}{M#你}了，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090205,
					"content": "#要是沒{F#妳}{M#你}幫忙，我今天非折在這裡不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090206,
					"content": "這營地是你建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "呃…算是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090210,
					"content": "#{F#妳}{M#你}們也知道，在離島做生意可不容易，這個營地…算是我做生意的一點小訣竅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090211,
					"content": "前些日子，我託一位…朋友，幫我從蒙德那邊帶一批釀酒材料過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090212,
					"content": "他前不久拜託一個朋友從「晨曦酒莊」那裡拿到了一批試做的新貨，這幾天剛運過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090213,
					"content": "可是那傢伙手腳沒輕沒重，把箱子碰壞了，裡面裝著的一瓶釀酒材料的蓋子也鬆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090214,
					"content": "我就想去把蓋子先擰下來，然後再重新裝上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090215,
					"content": "沒想到，我剛擰開蓋子，一堆史萊姆就衝了過來，真是莫名其妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090216,
					"content": "「晨曦酒莊」的釀酒材料嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "算了，先不管了，釀酒材料的事，等那傢伙下次過來的時候，我再和他算帳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090218,
					"content": "#{F#妳}{M#你}們救了我，我得給{F#妳}{M#你}們點謝禮才行…這些東西{F#妳}{M#你}們先收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090219,
					"content": "#除了這些之外，{F#妳}{M#你}們看見旁邊的那艘小船了嗎？那是我的另外一個…小訣竅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090220,
					"content": "#用那艘船，{F#妳}{M#你}們就可以從這裡悄悄地前往鳴神島了，嘿嘿，是不是非常方便？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090221,
					"content": "我為什麼要「悄悄的」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "哎呀，總之…以備不時之需嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090223,
					"content": "#好了，我還得回去清點貨物，就先不在這裡多待了，再次謝謝{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090224,
					"content": "看來我得再換個接貨的地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090208,
					"content": "你在這做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "我…在這搬貨呢，哈哈哈，搬貨呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "哈里森"
				}
			]
		}
	]
}