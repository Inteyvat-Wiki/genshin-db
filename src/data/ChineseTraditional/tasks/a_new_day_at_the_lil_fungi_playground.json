			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~♪♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737100102,
					"content": "♫♫~♫~♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "歡騰之火"
				},
				{
					"id": 737100103,
					"content": "我們回來啦，海妮耶、左右加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100104,
					"content": "#遠遠就聽見「咚咚小圓帽」和「歡騰之火」歡樂的腳步聲，看來{F#妳}{M#你}們這次的確玩了個痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100105,
					"content": "這麼遠就能聽出歡樂嗎？我到現在都無法辨別蕈獸夥伴腳步聲裡傳達的情緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100106,
					"content": "看來我還要再多學習啊…學無止境！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100107,
					"content": "欸嘿嘿，這次出遊的感覺的確很不一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100108,
					"content": "帶著蕈獸夥伴們玩了一圈，再回到「小小靈蕈樂園」附近，感覺和玩累了回家吃飯有點像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100109,
					"content": "不如，現在就一起合個影吧？我看《蒸汽鳥報》提到的許多知名遊記，都把旅途的各種畫片依照時間連起來哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100110,
					"content": "「白銀伴星」這樣一講，我才想起來，這些年來和蕈獸夥伴們相處得理所當然，沒怎麼合過影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100111,
					"content": "嗯！兩位大老闆都很懂「完美收場」的儀式嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "歡騰之火"
				},
				{
					"id": 737100114,
					"content": "好哦，那就用「咚咚小圓帽」的這個相機，加上支架，來張定時合照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100115,
					"content": "等到海妮耶和左右加不那麼忙了，我們還要一起像這樣開心地出去玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100147,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100116,
					"content": "對了，「咚咚小圓帽」拍照很有天賦哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100117,
					"content": "我挑了幾張拍得不錯的，就和我們的合照放在一起，海妮耶和左右加也可以看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100118,
					"content": "居然全都考慮好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "還有還有…來，海妮耶和左右加，我為妳們帶了紀念品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100121,
					"content": "是妳們之前沒吃到的馬卡龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100122,
					"content": "咦！我只是隨口一說，妳居然記住了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100123,
					"content": "「白銀伴星」…令人感動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100124,
					"content": "為了以後不再這麼麻煩妳，我必須改掉毛病，出遊前做好萬全的規劃…並且不能停留在紙面上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100125,
					"content": "好朋友放鬆閒聊時隨口說的事情，也能反映心裡的真實想法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100126,
					"content": "什麼時候買的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "在楓丹廷拍照時候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100129,
					"content": "#{F#妳}{M#你}陪著「咚咚小圓帽」專心看眼前景色的時候，我找了個報童幫忙，給了她一點跑腿費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100130,
					"content": "#放心，{F#妳}{M#你}的那份我當然也有準備啦！怎麼會忘了{F#妳}{M#你}呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100131,
					"content": "#我有好好叮囑過報童說進店後，第一個就去找{F#妳}{M#你}最愛吃的口味哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100132,
					"content": "不過我們早就吃遍了楓丹廷的甜點，應該沒什麼新鮮感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100133,
					"content": "只要是派蒙買的甜點，就好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "#真的嗎？嘿嘿…那我以後多買給{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100136,
					"content": "可惜沒有專門給蕈獸夥伴們吃的甜點…要是可以抱著蕈獸夥伴一起享用桌上滿滿的美食，該有多好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100137,
					"content": "這方面不用擔心，我在完善的《蕈獸族群綜論》中，就有從底層研究蕈獸愛吃的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100138,
					"content": "目標是找出蕈獸和人類共通的食材，讓夥伴們不用一年到頭都吃各種口味的「妙妙瓊脂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100139,
					"content": "遲早有一天，我會找出兼顧人類和蕈獸味覺的食材，設計出雙方共通的美味料理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100140,
					"content": "等到實踐下廚，就由我來負責！以防海妮耶燒壞我們的第十一口鍋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100141,
					"content": "這樣聽起來，以後和蕈獸夥伴們坐成一圈聚餐的那天不遠了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737100142,
					"content": "就等海妮耶的好消息！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "#那還請常回「小小靈蕈樂園」來看看，我們和各位蕈獸夥伴隨時等著{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737100145,
					"content": "#說不定驚喜會比{F#妳}{M#你}們預想的來得更早哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737100146,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咚咚小圓帽"
				},
				{
					"id": 737100143,
					"content": "就等左右加的大餐了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "派蒙主動買給我的，不一樣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "我都沒有注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "派蒙，周到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}