			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "咳，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "#{F#妳}{M#你}好{F#妳}{M#你}好，終於等到一個看起來合適的人了，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700104,
					"content": "而且還是熟人，這下我不用擔心樣本不夠了嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700105,
					"content": "等了這半天，不是老年人就是小孩子，完全不夠用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700106,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "啊，這麼快就把我忘了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700108,
					"content": "我又不是什麼圖謀不軌的惡人，不用這樣假裝不認識我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700111,
					"content": "#{F#妳}{M#你}仔細看看，是我啊，我們在稻妻的離島還見過面的，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700112,
					"content": "真的很可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "#看起來{F#妳}{M#你}真是忘記我了，唉，那就來自我介紹一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700114,
					"content": "我是須彌「教令院」的學者胡塞尼，為了在稻妻開展調研項目，一路跋涉好不容易抵達稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700115,
					"content": "可惜…咳…要在稻妻開展調研實在限制太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700116,
					"content": "雖然我最終也不是一無所獲，但是跟這一路的顛簸坎坷比起來，總有點得不償失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700117,
					"content": "研究經費已經所剩無幾了，我只能取道璃月回「教令院」，不過我還是希望利用回程的時間做點補救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700118,
					"content": "我想，不如繼續在曾經獲得「教令院」肯定的「導能原盤」項目上下功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700119,
					"content": "#至於「導能原盤」，不知道{F#妳}{M#你}記不記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700120,
					"content": "那是一件珍貴的古代遺物，能夠借助無所不在的地脈，增強使用者的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700121,
					"content": "咳咳，這個研究項目仍在初期階段，我之前上交的調查報告也只相當於完整研究的緒論部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700122,
					"content": "要弄明白整個「導能原盤」的運作原理與應用可能性，還有許多工作要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700123,
					"content": "所以我正在這裡徵召志願者，邀請他們使用「導能原盤」，以獲得更多的新數據，支撐我的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700124,
					"content": "#我…咳…可不是什麼可疑分子，{F#妳}{M#你}別誤會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700125,
					"content": "原來如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "#沒錯…咳…那麼我現在可以問了，旅行者，{F#妳}{M#你}願不願意成為志願者，幫忙試用「導能原盤」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700127,
					"content": "可以試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "#請先允許我表達感謝，{F#妳}{M#你}一直樂於為追求智慧這項事業做出奉獻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700129,
					"content": "#不過在我將「導能原盤」正式交{F#妳}{M#你}保管之前，還是讓我們先來做一個小小的熱身活動吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700130,
					"content": "這也是為了確認志願者是否有能力自保…咳…畢竟，負責任的學術項目是不會拿志願者的生命安全冒險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700131,
					"content": "#如果{F#妳}{M#你}已經準備好了的話，就到指定的地點去，試著清理那裡的營地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700132,
					"content": "#我會在這裡等{F#妳}{M#你}回來，一定要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700109,
					"content": "…你打算做什麼！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "我看起來像是那種綁架路人做實驗的瘋狂學者嗎？別用這種防賊一樣的口氣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "胡塞尼"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "#{F#妳}{M#你}們回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700202,
					"content": "毫髮無傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "#哈哈…咳，是我多慮了，{F#妳}{M#你}的實力很強，我可以放心地把「導能原盤」交{F#妳}{M#你}保管了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700204,
					"content": "#「導能原盤」的使用方法簡單易懂，{F#妳}{M#你}看到就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700205,
					"content": "不過使用時務必小心，這可是真正的古代遺物，如果弄丟了或者弄壞了，我就得倒大楣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700206,
					"content": "#{F#妳}{M#你}可以先熟悉一下「導能原盤」，之後再嘗試測試工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700301,
					"content": "怎麼樣，能理解「導能原盤」的使用方法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700302,
					"content": "不算太複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "的確，和「教令院」裡的某些器械比起來，「導能原盤」算是比較易用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700306,
					"content": "#以{F#妳}{M#你}的水準，如果擴大測試規模，應該也沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700307,
					"content": "我聽路過的冒險家說，他們新發現了一處奇特的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700308,
					"content": "因為之前似乎沒有人發現過這個地方，所以其中彙聚的魔物數量不少，能力也比野外遊蕩的魔物強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700309,
					"content": "如果把那裡當作測試場地的話，一定能獲得更全面的數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700310,
					"content": "#畢竟{F#妳}{M#你}之前的表現…咳…實話說很出色，「導能原盤」中留下的記錄反而有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700311,
					"content": "#是{F#妳}{M#你}的話，出入這種秘境大概不是難事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700312,
					"content": "那還用說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
					"content": "#要是別人這麼說，我八成不信，但是{F#妳}{M#你}的話，我覺得肯定沒問題哈哈…咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700314
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700314,
					"content": "#那我來幫{F#妳}{M#你}把秘境地點標註在地圖上吧，測試任務就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700304,
					"content": "有點不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700305
					]
				},
				{
					"id": 726700305,
					"content": "#這很正常。放心，作為非專業人士，{F#妳}{M#你}只需掌握基礎操作就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}