	"talks": [
		{
			"id": 7267001,
			"completionStepIds": [
				7267001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
