			"dialogs": [
				{
					"id": 60110501,
					"content": "老闆，那個…就是那個…我還是需要探探妳的口風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60110502,
					"content": "如果以後我們又要和其他人合作，那「秘聞館」究竟應該出幾成的力啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60110503,
					"content": "呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60110504,
					"content": "一成？！是不是太低了點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60110505,
					"content": "再猜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60110506,
					"content": "不出力？！那不就成了掛名的嗎？還不如散夥呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60110507,
					"content": "唉，雅珂達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60110508,
					"content": "我的意思是，不設上限，不設下限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60110509,
					"content": "噢！不愧是老闆，想得就是深遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60110510,
					"content": "不對啊，這不是說了跟沒說一樣嘛！所以到底是幾成啦，老闆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
