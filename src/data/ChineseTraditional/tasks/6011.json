					"nextDialogs": [
						60111102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111102,
					"content": "#——感謝{F#妳}{M#你}知道那麼多，還願意為我保守秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111103,
					"content": "之前沒機會問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "因為不想被執燈長找麻煩。如果沒辦法被感應到，大概上面會硬塞給我一盞執燈士的燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111106,
					"content": "手提兩盞燈的執燈士，實在是太怪異了。美感上實在難以容忍呢，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60111104,
					"content": "你的燈怎麼會被執燈人感應到呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
