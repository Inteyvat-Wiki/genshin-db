			"dialogs": [
				{
					"id": 60110401,
					"content": "蛋捲製作完畢，請趁熱享用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110402,
					"content": "感謝妳一直將這些事情放在心上，伊涅芙小姐。這份美味是可貴友誼的見證，願它經年而不變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60110403,
					"content": "收到。但蛋捲的保質期很短，可能一週即變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110404,
					"content": "哦，我說的「經年不變」是…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60110405,
					"content": "嗯？那邊似乎躲著一些客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110406,
					"content": "大家循著蛋捲香氣而來…沒關係，靠近點吧，無須顧忌，伊涅芙小姐是我們的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60110407,
					"content": "沒錯。我可以依照各位的喜好，製作一份穀物蛋餅，碾碎成屑分享給大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60110409,
					"content": "牠們怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60110410,
					"content": "牠們…在談論妳的住址，說想和妳回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				}
