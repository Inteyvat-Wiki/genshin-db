					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "菲林斯？難得你會到我的蛋捲工坊來。感興趣的話你就自由參觀吧，我忙著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110802,
					"content": "我是來探望您的，可敬的愛諾小姐。我為您帶了些鎮上的點心，傳統奶油口味，您看放在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110803,
					"content": "噓！…別讓伊涅芙聽見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110804,
					"content": "…你找我有什麼事？該不會想說…我的大炮做了壞事，從今往後的狂獵問題都要由執燈人接管了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110805,
					"content": "用我們誰都沒有提前預料到的結果，來苛責您這樣的天才技術人員？實在太失禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110806,
					"content": "如果真有人這麼做，我敢說這世上再也不會有技術突破了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110807,
					"content": "哼，你這話倒滿中聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110808,
					"content": "能讓您感到寬心是我的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110809,
					"content": "所以，到底有什麼事嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110810,
					"content": "您願意抽空幫我修理這盞燈嗎？上次我拿去那夏鎮修過一回，但不幸在剛才的戰鬥中又壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110811,
					"content": "修一盞燈？就這點事要我天才愛諾來做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110812,
					"content": "哦，失禮了，這麼看來我應該去委託伊涅芙小姐，那個點心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110813,
					"content": "呃呃呃，我…我是說這點小事費不了什麼功夫，坐著等吧，馬上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60110814,
					"content": "有勞您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110815,
					"content": "下次再有這種事，你記得一開始就來找我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				}
			]
