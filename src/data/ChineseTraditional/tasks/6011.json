					}
				]
			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "哥倫比婭！妳怎麼到這裡來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110602,
					"content": "#嗯？不是{F#妳}{M#你}們推薦我出來走走的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110603,
					"content": "是沒錯啦，但妳不怕被「愚人眾」發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110604,
					"content": "桑多涅沒興趣抓我，其他「愚人眾」現在也不會冒險來找我。他們有更棘手的問題需要解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110605,
					"content": "（是指「獵月人」嗎…他現在是威脅著挪德卡萊所有人的問題。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "好吧，出來走走總是好事，感覺怎麼樣？喜歡那夏鎮嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110607,
					"content": "唔…月矩力的流動有點紊亂，人們心中很不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110608,
					"content": "不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110609,
					"content": "不過什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110610,
					"content": "#{F#妳}{M#你}們上次「請客」的菜，是在這邊買的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110611,
					"content": "（在意的居然是這個嗎！她該不是為了吃漿果煎肉才來的吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110612,
					"content": "呃，妳…妳喜歡的話，我們下次帶妳去吃就是了，還有很多在家裡吃不到的好東西喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110613,
					"content": "#…嗯？{F#妳}{M#你}從剛才開始就很沉默呢。是心中有什麼疑問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110614,
					"content": "關於「獵月人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "唔…我當時沒能洞悉他的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110616,
					"content": "如今他取得了形體，力量不容小覷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110617,
					"content": "但那力量中有一股「執念」，近乎瘋狂的「執念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110618,
					"content": "我不清楚那執念是為月亮而來，還是為別的什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110619,
					"content": "或許弄清這股執念的所指，也是今後對抗他的關鍵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110620,
					"content": "關於「愚人眾」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "桑多涅的生活作息很不規律，「博士」經常使喚人，阿蕾奇諾她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110622,
					"content": "#嗯？{F#妳}{M#你}想聽的不是這些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110623,
					"content": "#{F#妳}{M#你}去過那個試驗設計局了？嗯…那個「武器」是女皇未來計畫中重要的一部分。至少聽起來是那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110624,
					"content": "#{F#妳}{M#你}問具體是什麼計畫？我不在乎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110625,
					"content": "關於「飛船」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "#若是{F#妳}{M#你}希望的話，我可以幫{F#妳}{M#你}在恆月的「月髓」中尋找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110627,
					"content": "#但上次看過之後，我覺得{F#妳}{M#你}的飛船更像被刻意隱藏起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110628,
					"content": "#或許是有人不想讓某些真相被{F#妳}{M#你}、被其他人知道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110629,
					"content": "能做到這種事的人，想必不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110630,
					"content": "沒什麼要問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "我…依舊想回到那個屬於我的月亮上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60110632,
					"content": "那裡是埋藏著答案的地方，那裡…才是我的「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
