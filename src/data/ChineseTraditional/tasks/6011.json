			"dialogs": [
				{
					"id": 60110901,
					"content": "#哎喲？{F#妳}{M#你}們怎麼來了？沒想到我們還有機會見面啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110902,
					"content": "之前妳去哪了啊？不會是跑掉了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110903,
					"content": "哎呀，怎麼會呢，我只是去別的地方談生意了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110904,
					"content": "#多虧了{F#妳}{M#你}們，才保住了我桑歌瑪哈巴依老爺的小店，嗚嗚嗚嗚，我好欣慰呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110905,
					"content": "演得也太誇張了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "這哪有半點演的成分在呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110907,
					"content": "#早告訴過{F#妳}{M#你}們我這的價格經濟又實惠，但{F#妳}{M#你}們還是去了那個什麼「秘聞館」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110908,
					"content": "唉，連熟客都一個個離我而去，我不就只能去別處謀生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110909,
					"content": "妳也太在意「秘聞館」了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "那能不在意嗎！在國外做小生意本就不容易，現在又遇到了那麼厲害的競爭對手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110911,
					"content": "唉，算了，富貴有命，我也不抱怨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110912,
					"content": "真要說的話，奈芙爾這位老鄉在我剛來的時候也幫過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110913,
					"content": "要怪，就怪我這麼久都沒找到機會給她賣個天大的人情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 60110914,
					"content": "#{F#妳}{M#你}們要是打聽到了那位老闆娘想要什麼的話，千萬要記得第一個來找我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
