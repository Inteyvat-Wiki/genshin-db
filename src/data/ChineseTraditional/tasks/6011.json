						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "這位先生，就像是一座燈塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110202,
					"content": "他理所當然地存在於這裡，為周圍的人提供光亮、施予恩惠。但人們習慣了光，就會忽視這盞燈的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110203,
					"content": "漸漸地、漸漸地，他自己也這麼認為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110204,
					"content": "「我做的事沒什麼大不了的、我做的還不夠好，我還需要保持耐心，繼續等待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110205,
					"content": "或許這是個悲傷的結局，但我依然為他曾照亮過他人的前路而驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110206,
					"content": "每一道由光而生的影，都會銘記它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110207,
					"content": "真是太可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110208,
					"content": "我曾聽過一個燈之妖精的故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "哦，那個我也有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110210,
					"content": "對他我也想說同樣的話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110213,
					"content": "#{F#妳}{M#你}說得對，即便是這次，我們的努力看起來也是徒勞的，獵月人還是達成了自己的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110214,
					"content": "但我們依然會追逐他到最後一刻，哪怕結果仍非我們所願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110215,
					"content": "這就像是守墓人的工作——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110216,
					"content": "絕非是為了令逝者復生，只是為了死地安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110217,
					"content": "你能這麼想那就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110219,
					"content": "你、你們在說什麼，能解釋一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110220,
					"content": "氣氛不太好，回去再講給妳聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60110222,
					"content": "畢竟這次送葬的主角，並不是那個什麼燈之妖精呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110223,
					"content": "「執光之人，以鮮血踐行榮光與正義。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110224,
					"content": "「行跡匆匆，你我即便滿身瘡痍，也請片刻駐足，回望愛憎。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110225,
					"content": "「直至深夜世界闔眼，那盞無人可見，只為你一人的燈緩緩亮起。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110226,
					"content": "承蒙關照，索西軍士長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60110211,
					"content": "不必對結果如此執著。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
