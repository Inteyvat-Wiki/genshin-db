			"dialogs": [
				{
					"id": 60111001,
					"content": "修燈、修燈，那真是太簡單了，三兩下的工夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60111002,
					"content": "要是每個人都能知道自己在幹什麼就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60111003,
					"content": "就像辛查那傢伙，別人拿什麼零件過來他都修，最後修出來一個整合控制器，又是大炮又是屏障，搞出一堆麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60111004,
					"content": "我罵過他了，他以後會按期交報告給我，我要檢查他最近都在幹什麼。唉，也、也算我有不對的地方啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				}
			]
		},
