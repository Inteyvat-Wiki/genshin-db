			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "#{F#妳}{M#你}這孩子，怎麼還不去多穿點衣服！要是著涼了就要遭大罪啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170302,
					"content": "婆婆，這是您落下的東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "我看看…對，對，就是這個東西，還真落在山上了，我這個記性啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170304,
					"content": "別看啦，孩子們，這盒子裡裝的都是些無聊的老東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170305,
					"content": "喏，這些是給你們的，收好了，謝謝你們幫我跑這麼一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170306,
					"content": "唉，得趕緊把這盒子放進壺裡了，別再忘記了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
