			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蠣羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "哎呀哈哈哈哈哈…哈哈…哈哈哈哈哈！！哦喲喲…岔氣了岔氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010202,
					"content": "哈哈哈哈眼淚都笑出來了！！阿雀呀，要是妳還在這裡就好了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010203,
					"content": "我有點生氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "哈哈哈哈對不起，對不起…別生氣嘛。是這麼回事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010206,
					"content": "我和妻子從前就一直喜歡捉弄別人，各種惡作劇從來沒有重複的，大家也都樂在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010207,
					"content": "後來呀，她生了場大病，去得早…那時候吩咐我，一定要在她的墳前好好地整一個老實人，不然她的靈就沒辦法離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010208,
					"content": "為了完成阿雀的願望…怎麼樣，我做得還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010209,
					"content": "這個玩笑很無聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "嘖，嘖。島外的人呀，一點都不有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010213,
					"content": "就連噴水戲法你也不願意看…真是無聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010214,
					"content": "再見，我走啦，我走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010210,
					"content": "會出人命的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "我不會再相信你的胡說了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "告訴我這是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
