	"talks": [
		{
			"id": 7220101,
			"completionStepIds": [
				7220101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220101",
							"2"
						],
						"stepId": 7220101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蠣羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "唉…過路的人呀…可憐可憐我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010102,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "#謝謝{F#妳}{M#你}還願意聽一個老人吐苦水…唉…過來，過來，聽我多聊幾句吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010105,
					"content": "我這輩子呀…就沒有一天轉運的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010106,
					"content": "我剛出生的時候，主持出生禮的祭司大人不小心碰翻了油燈，燒光了姑媽的一頭長髮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010107,
					"content": "哎呀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "後來，我患上了奇怪的病，從此四肢不調；再後來有一天，我從搖籃中被甩飛出來，摔斷了六根肋骨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010109,
					"content": "等我長大了一點，有一天表叔被蘑菇嗆了個半死，我爸爸在搶救他的時候用鏟子打中了我的頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010110,
					"content": "然後有一次，心愛的小團雀被家裡養的鵜猿獸吃掉了，鵜猿獸被一頭瞎野豬撞下了山崖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010111,
					"content": "然後，喜歡的女孩子不小心把祭司大人獻祭給了雷鳥大人，被驅逐出島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010112,
					"content": "等我長大成人，奶奶因為我長得太醜鬱鬱而終；後來爺爺也隨她而去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010113,
					"content": "再後來呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010114,
					"content": "家庭對你來說多少算是慰藉吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "#啊，說起家庭…我成人禮的時候，巫醫大人說我可能不會有孩子了，因為我長了一個…等一下，我給{F#妳}{M#你}看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010116,
					"content": "不要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "唉…再聽我說最後一句吧…也是我想拜託你幫一個可憐老人最後的忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010119,
					"content": "請你直說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "前些陣子，我埋葬妻子的時候不小心把自己的金戒指掉進了墓坑，也一併埋進去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010122,
					"content": "那是我最後的財產了…可我不敢重新挖出來…因為那樣會觸怒她的靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010123,
					"content": "所以你要我偷墳掘墓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#{F#妳}{M#你}是外人嘛…外人做什麼都不奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010125,
					"content": "啊不是，不是…我的意思是，如果是外人的話，就可以避免觸怒本地的靈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010126,
					"content": "去千來神祠吧…她的墳墓就在神祠的旁邊呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蠣羅"
				},
				{
					"id": 722010120,
					"content": "不要再提奇怪的話題就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "已經太深入了！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
			"completionStepIds": [
				7220103
			],
