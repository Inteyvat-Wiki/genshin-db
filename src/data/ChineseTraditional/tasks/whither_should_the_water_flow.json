			"dialogs": [
				{
					"id": 140110101,
					"content": "要是沒記錯的話，他就住在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110102
					],
					"speakerTitle": "勞維克"
				},
				{
					"id": 140110102,
					"content": "請問是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110103
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110103,
					"content": "是我，你的劇本寫完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110104
					],
					"speakerTitle": "勞維克"
				},
				{
					"id": 140110104,
					"content": "你怎麼會追到這裡來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110105
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110105,
					"content": "哎呀，這個你不要管，先出來，有好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110106
					],
					"speakerTitle": "勞維克"
				},
				{
					"id": 140110106,
					"content": "嘖，誰信你。等我一下，已經在收尾了，寫完就出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110107
					],
					"speakerTitle": "波洛"
				},
				{
					"id": 140110107,
					"content": "好吧，期待你的大作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110108
					],
					"speakerTitle": "勞維克"
				},
				{
					"id": 140110108,
					"content": "看來不出所料，拖稿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110109
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110109,
					"content": "畢竟結局是這個劇目裡非常重要的一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110110
					],
					"speakerTitle": "迪爾菲"
				},
				{
					"id": 140110110,
					"content": "在他寫好之後，我們所有演員都要看一遍，只有大家都贊成，它才能成為最後的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110111
					],
					"speakerTitle": "迪爾菲"
				},
				{
					"id": 140110111,
					"content": "#剛剛有人告訴我，我還以為他看錯了。居然是{F#妳}{M#你}們，還有芙寧娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110112
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110112,
					"content": "果然還是會碰到她啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110113
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110113,
					"content": "看來你們是來找波洛的，如果還需要時間的話，可以在鎮上隨意逛逛，我都安排好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110114
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110114,
					"content": "啊，沒關係，我們在這裡也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110115
					],
					"speakerTitle": "勞維克"
				},
				{
					"id": 140110115,
					"content": "那就恭敬不如從命，我們先去逛逛啦，謝謝妳的招待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110116
					],
					"speakerTitle": "迪爾菲"
				},
				{
					"id": 140110116,
					"content": "給我過來，注意一下氣氛可以嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110117
					],
					"speakerTitle": "迪爾菲"
				},
				{
					"id": 140110117,
					"content": "最近，白淞鎮的情況有好一點了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110118
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110118,
					"content": "只能說在慢慢恢復吧，但很多人內心的創傷或許一輩子都無法痊癒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110119
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110119,
					"content": "對不起，我也很想做些什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110120
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110120,
					"content": "好啦，難道我們每次見面都要聊這些沉重的話題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110121
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110121,
					"content": "我們都有沉重而痛苦的回憶，但我們不一定要被它們壓得喘不過氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110122
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110122,
					"content": "既然妳也有打算重新開始，就不要總是把過去的事掛在嘴邊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110123
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110123,
					"content": "謝謝妳的安慰，說得很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110124
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110124,
					"content": "不過至少現在，還是讓我保持鄭重的心情吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110125
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110125,
					"content": "沒關係，我知道真正要實踐起來，也沒有像我說的那麼輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110126
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110126,
					"content": "#我來也是為了告訴{F#妳}{M#你}們一聲，至今為止，也不是所有人都原諒了水神在災難中的毫無作為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110127
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110127,
					"content": "#為了避免不必要的麻煩，我和鎮上的人說{F#妳}{M#你}們都是劇團成員，而妳是扮演芙寧娜的演員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110128
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110128,
					"content": "雖然不能說這樣就萬無一失，但應該就可以自由活動啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110129
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110129,
					"content": "原來妳還有這麼細心的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110130,
					"content": "妳說這什麼話，刺玫會的會長從來都是膽大又心細！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110131
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110131,
					"content": "#好啦，那我先走了。{F#妳}{M#你}們好好陪陪她哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110132,
						140110133
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140110132,
					"content": "嗯，知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				},
				{
					"id": 140110134,
					"content": "那我們走吧，去上面看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110135
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110135,
					"content": "#我也沒有能說心裡話的朋友，可能就像她說的，{F#妳}{M#你}們就是最適合的對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110133,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				}
			]
		},
