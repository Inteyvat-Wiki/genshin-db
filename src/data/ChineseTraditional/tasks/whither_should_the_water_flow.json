			},
			"dialogs": [
				{
					"id": 140110201,
					"content": "很感謝娜維婭女士的體諒，說實話我也不知道自己是否做好了準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110202
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110202,
					"content": "逃避往往是最方便的選擇，但它沒辦法解決任何問題，也不能幫助你跨越任何障礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110203
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110203,
					"content": "難怪說到白淞鎮的時候，妳有點猶豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110204,
					"content": "是啊，要說不害怕是不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110205
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110205,
					"content": "但我還是覺得，我應該再來這裡一趟。就像之前我說的那樣，我想看看那些不曾親眼所見的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110206
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110206,
					"content": "如果這裡的人願意原諒我，那我會很開心，但他們如果暴言相向，我也會全盤接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110207
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110207,
					"content": "應該也是有人不相信娜維婭的說辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110208
					]
				},
				{
					"id": 140110208,
					"content": "是啊，我能感覺到那些視線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110209
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110209,
					"content": "可能他們覺得，穿著水神戲服到白淞鎮來，本身就是對這裡居民的一種不尊重的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110210
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110210,
					"content": "我曾經很害怕被人注視，尤其是被質疑、被怨恨的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110211
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110211,
					"content": "唉，看來我還是沒有做好準備啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110212
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110212,
					"content": "沒想到妳對自己還滿嚴格的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110213,
						140110215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110213,
					"content": "是不是有點用力過頭了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110214
					]
				},
				{
					"id": 140110214,
					"content": "我不能只看我想看到的東西啊，那不就和以前一樣了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110217
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110217,
					"content": "#{F#妳}{M#你}們看，是不是人逐漸變多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110218,
					"content": "議論的聲音越來越明顯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110219
					]
				},
				{
					"id": 140110219,
					"content": "我們還是別在這裡久留吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110220
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110220,
					"content": "刺玫會的大船，從那裡能看到整個白淞鎮吧？我們到那裡去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110215,
					"content": "相當意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110216
					]
				},
				{
					"id": 140110216,
					"content": "#什麼意思，難道在{F#妳}{M#你}眼裡我只會東躲西藏，逃避責任嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110217
					],
					"speakerTitle": "芙寧娜"
				}
			]
		},
		{
			"id": 1401103,
			"completionStepIds": [
				1401104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1401104",
							"2"
						],
						"stepId": 1401104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芙寧娜"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2831.178,
							397.924,
							4164.861
						],
						"pointId": 5834
					},
					{
						"sceneId": 3,
						"position": [
							2829.195,
							397.926,
							4164.68
						],
						"pointId": 5844
					}
				]
			},
			"dialogs": [
				{
					"id": 140110301,
					"content": "#抱歉，或許{F#妳}{M#你}們是散步的心情，但我盡是在說一些沉重的話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110302
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110302,
					"content": "沒關係，這樣的妳也滿特別的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110303,
					"content": "#嗯，再多陪我一會吧！謝謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110304
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110304,
					"content": "#或許{F#妳}{M#你}們也能感受到，我排斥接納過去的自己，其實不單單是因為忍受了太久的痛苦與孤獨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110305
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110305,
					"content": "站在船邊，我的腦中都有當時水逐漸上漲的畫面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110306
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110306,
					"content": "一個又一個的生命融化成水，白淞鎮鎮民無比珍惜的生活與回憶化為泡影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110307
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110307,
					"content": "在神明的庇護之下，人們篤信在災難降臨之前，會有強大的存在挺身而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110308
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110308,
					"content": "我也曾經為了讓他們相信確有其事，而不斷地表演…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110309
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110309,
					"content": "可是當水真的漲上來的時候，「水神」無動於衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110310
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110310,
					"content": "也不能這麼說啊…那時的妳有妳的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110311,
					"content": "不用這麼苛責自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110312
					]
				},
				{
					"id": 140110312,
					"content": "為了守護真相，我一直在經歷相似的事，越是這樣我就越痛苦、越孤獨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110313
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110313,
					"content": "逐漸地，我除了真相一無所有，我也害怕我會徹底失敗，坐在我的位置上痛哭流涕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110314
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110314,
					"content": "#好在有{F#妳}{M#你}們，還有諸多英雄的幫助，我們避開了最壞的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110315
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110315,
					"content": "所有人都擔負起了身上的責任，而我…重歸自由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110316
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110316,
					"content": "仔細想想的話，自由不就是不被需要的意思嘛，因為我也沒什麼用處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110317
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110317,
					"content": "沒想到妳會這麼想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110318,
					"content": "自由是對妳的嘉獎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110319
					]
				},
				{
					"id": 140110319,
					"content": "嘉獎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110320,
						140110321
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110320,
					"content": "至少妳可以勇敢說出心裡的話了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				},
				{
					"id": 140110322,
					"content": "…是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110323
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110323,
					"content": "有能夠傾訴的人，在過去簡直是想都不敢想的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110324
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110324,
					"content": "因為必須堅守重要的秘密，我非常害怕他人注意到真實的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110325
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110325,
					"content": "「相信舞臺上的芙寧娜便好，那就是你們應該信任的樣子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110326
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110326,
					"content": "而在生活中，無論是好奇心，還是源自內心的情緒，都不能讓人注意到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110327
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110327,
					"content": "這也是為什麼之前我會說，我不是個會好好維持友善關係的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110328
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110328,
					"content": "原來是這樣，我以為只是妳私下的性格容易被人討厭呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110329,
					"content": "妳今天總是和我唱反調！像妳這樣說話才會讓人討厭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110330,
						140110331
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110330,
					"content": "派蒙不想讓妳太消沉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110332,
					"content": "嗯，曾經的我只有真相，如今終於解脫。雖然暫時還不知道要走向何方，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110333
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110333,
					"content": "我有選擇的資格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110334
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110334,
					"content": "好了，也差不多該回去了，我猜劇本的結局已經寫好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110335
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 140110335,
					"content": "嗯，好，那我們回去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140110331,
					"content": "說出來果然好多了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110321,
					"content": "至少妳不再痛苦與孤獨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				}
			]
		},
