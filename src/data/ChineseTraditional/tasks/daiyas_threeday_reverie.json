			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "#由衷感謝命運的指引，四處徘徊的旅人們啊，{F#妳}{M#你}們總算來到了這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440102,
					"content": "#{F#妳}{M#你}們必然也在尋找一場超越驚喜的邂逅，一次超乎想像的旅途？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440103,
					"content": "#如今，我們互相成全的機會，正擺在{F#妳}{M#你}們面前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440104,
					"content": "#投身於全新的劇集「黛依阿的三日遐想」，置身於話劇的舞臺之上，{F#妳}{M#你}們就能獲得前所未有的新奇體驗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440105,
					"content": "暢遊於摩拉的浴池之中…驅散古堡中的幽魂…掙脫重力的束縛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440106,
					"content": "#輕輕念出暗號：「帶我們前往遐想的世界」，昭示{F#妳}{M#你}們的好奇與熱情，就此啟程吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440107,
					"content": "唔，喇叭那一頭的人真是激動啊，雖然不知道她具體在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440108,
					"content": "旅途？劇集？舞臺？還有什麼…摩拉的浴池！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440109,
					"content": "可能是一種新的遊樂設施。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "喔！這麼一說，我好像能理解了，以前聽說過類似的活動呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440112,
					"content": "所以喇叭後面正在說話的那個人，就是「黛依阿」嗎？她是話劇的導演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440113,
					"content": "如果我們報名，就可以成為這些話劇中的角色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440114,
					"content": "派蒙感興趣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "聽起來還滿有意思的！我想見識一下摩拉的浴池…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440117,
					"content": "呃…不對！我想看看，能在「琉形蜃境」裡佔據一席之地的遊樂項目，究竟有什麼神奇的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440118,
					"content": "那，我們就一起念出報名的口號吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440119,
					"content": "帶我們前往遐想的世界吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "帶我們前往遐想的世界吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440121,
					"content": "居然這麼乾脆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440122,
					"content": "咳咳，簡直完美！報名信號已確認，「黛依阿的三日遐想」即將開幕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440123,
					"content": "「古老的傳說重現天日，價值連城的寶藏有了新的線索，一隊俠義的海盜擦亮了武器，升起了船帆…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440124,
					"content": "「漂浮在天空之中的小鎮遭遇了空前的危機，創造奇蹟的建築師要及時挽救這座正在墜落的高城…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440125,
					"content": "「為了拯救不幸罹難的夥伴，落單的水形幻靈即將闖入幽魂盤踞的古堡，尋找破除『魔咒』的希望…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440126,
					"content": "三個不同主題的劇集，任各位自由賞玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440127,
					"content": "尋找這樣的告示喇叭，遵循旁白的指引，就能向著遐想之地邁進！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440128,
					"content": "#我明白了！{NICKNAME}，接下來我們就去找找這樣的喇叭，好好試試看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440115,
					"content": "我們一起來當演員？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "比如遊客參與表演的話劇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "嗚啊！怎麼有這麼多的「小水珠」…它們圍著一臺超大的機器，在忙來忙去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440602,
					"content": "完全不明白，這臺機器是做什麼的？黛依阿又在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440603,
					"content": "#歡迎探訪「三日遐想」最真實的幕後！{F#妳}{M#你}們現在一定很疑惑吧——眼前的場景說明了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440604,
					"content": "#我們這就向{F#妳}{M#你}們詳細展示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440605,
					"content": "「偷懶鬼」，別打瞌睡了，快去一號位置，執行二號操作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440606,
					"content": "#「由衷感謝命運的指引，四處徘徊的旅人們啊，{F#妳}{M#你}們總算來到了這裡！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440607,
					"content": "那個「小水珠」在操縱喇叭，播放…錄音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440608,
					"content": "好耳熟…總覺得在哪裡聽過這句話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440609,
					"content": "最開始發現活動的告示喇叭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "「全勤王」，在三號位置執行七號操作，拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440612,
					"content": "「出現在新人眼前的大副衣衫襤褸，全身上下包滿繃帶，顯然，不久之前，他才經歷過一場激烈的戰鬥…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790440613,
					"content": "我想起來了！這一段是「黑水晶號與吞金海怪」的旁白，我們與大副剛剛見面的情景！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440614,
					"content": "原來當時聽到的錄音是這樣播放出來的…時機也很準確呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440615,
					"content": "「大冒失」，「黑水晶」號快要抵達寶藏前的關隘了，趕快把所有佈景和機關都升起來…千萬別搞錯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440616,
					"content": "那個「小水珠」好像在用什麼看不見的方法…操作面前的儀器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440617,
					"content": "監測、播音和機關控制…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "沒錯，這臺巨大設備的功能，正是用來調度劇目中的所有功能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440620,
					"content": "勤懇的水形幻靈們時刻觀察著劇目演出的進度，在遊客抵達特定位置時，就播放劇本上的旁白，啟動相應的機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440621,
					"content": "只要遊客老老實實跟著流程走，就能順利觀賞到「三日遐想」的全部演出！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440622,
					"content": "當然，假如遊客中途跳車，或者做出了其他超出預期的行為，那就沒辦法完整體驗所有劇目了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440623,
					"content": "我們的員工數量不夠，暫時無法應對這種情況…但我們相信，遊客們肯定不會亂來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440624,
					"content": "好，好厲害！我們當時光顧著玩了，沒想到幕後還有這麼多門道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440625,
					"content": "現在想想，一路上有那麼多機關要啟動，控制演出的難度不是一般的高呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440626,
					"content": "真是巧妙的設計。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "所以說…現在正在和我們說話的這個聲音，就是黛依阿嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440629,
					"content": "妳在藉助這些水形幻靈控制「三日遐想」演出？為什麼不親自和我們解釋呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440630,
					"content": "我還有好多問題想問妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440631,
					"content": "猜對了，但也不全對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440632,
					"content": "#{F#妳}{M#你}們所見的，這間廣播室裡的一切——控制器、「總導演」、「假編劇」、「偷懶鬼」、「全勤王」和「大冒失」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440633,
					"content": "當然，還有沒露面或者沒發聲的，其他維護著劇目演出的水形幻靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440634,
					"content": "所有組合在一起，才是這道聲音——「黛依阿」的本尊，創造並控制演出的關鍵體系，而非一個具體的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790440635,
					"content": "黛依阿不是一個人…是一個體系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440636,
					"content": "等等、等等，有點超出我的理解能力了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440637,
					"content": "雖然我知道「小水珠」們也很聰明，但只憑「小水珠」們，真的能設計出這麼複雜的一套…體系嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440638,
					"content": "幕後應該有著專門的設計師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "#最初的確是這樣啦，{F#妳}{M#你}們的驚訝也在預料之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440641,
					"content": "說來話長了，「黛依阿的三日遐想」起源於熱情洋溢的佐西摩斯導演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440642,
					"content": "他在「琉形蜃境」中暫住時，將大部分精力放在了那部最精彩的舞臺劇上，無暇再籌備其他劇目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440643,
					"content": "與水形幻靈們相處一段時間後，他發現了水形幻靈們的智慧與豐富的情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440644,
					"content": "水形幻靈們很喜歡他的話劇，想要見證更多精彩的演出，並將這份喜悅傳遞給其他訪客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440645,
					"content": "一個想法在佐西摩斯導演心中萌生了：可不可以讓水形幻靈們自行導演劇目，甚至設計劇目？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440646,
					"content": "好大膽！聽起來就像是…教一群孩子來當導演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440647,
					"content": "確實有難度，好在大家一起努力，成功克服了所有困難！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440648,
					"content": "佐西摩斯導演努力教導幾位熱愛話劇的水形幻靈，讓它們理解了操辦演出的關鍵流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440649,
					"content": "經過一番試錯，他用水形幻靈們能理解的語言，寫下了許多部範例劇目，以及詳實的劇作說明書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440650,
					"content": "在伊迪婭的幫助下，他製造了這臺控制器，在各地搭建了與其相連的機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440651,
					"content": "除了劇本裡的臺詞，佐西摩斯導演還錄下了大部分常見字詞的語音，好讓我們組合出正確的語句，和遊客們溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440652,
					"content": "經過一段時間的磨合，我們終於可以順利運作三部範例劇目了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440653,
					"content": "它們正是「黑水晶號與吞金海怪」、「瞳孔裡的固形魔咒」、還有「天空高城救守記」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440654,
					"content": "也就是說…佐西摩斯導演為「黛依阿的三日遐思」留下了基礎的條件，適合的劇本，還有詳細的說明書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440655,
					"content": "我們在遊玩的過程中完全沒有察覺到，這一切都是「小水珠」們在控制的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440656,
					"content": "#多謝誇獎！{F#妳}{M#你}們的遊玩肯定了我們的努力，驗證了我們的許多想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440657,
					"content": "#所以，我們想給{F#妳}{M#你}們一份豐厚的謝禮，並將創作路上的一切與{F#妳}{M#你}們分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440658,
					"content": "別客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "對哦，我們體驗到了特別的遊樂項目，還開拓了眼界，我們也要謝謝你們，黛依阿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440661,
					"content": "啊哈哈！現在我們要向著下一個目標前進了，那就是獨立創作劇本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440662,
					"content": "為此，我們還要進一步加強我們對「劇作」的理解，不斷取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440663,
					"content": "我們當中有一位「假編劇」，它會聽取各種訪客的故事，充實我們的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440664,
					"content": "就算沒有遇見適合的訪客，「假編劇」也會探訪其他水形幻靈，聊聊它們與訪客們的經歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440665,
					"content": "原來如此，所以說，我們和「假編劇」講故事，就是在幫你們創作新的話劇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440666,
					"content": "#沒錯沒錯！如果{F#妳}{M#你}們有空，就請和「假編劇」多聊聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440667,
					"content": "#另外，還請{F#妳}{M#你}們繼續在「琉形蜃境」裡好好遊玩，盡情冒險，多多和其他水形幻靈互動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440668,
					"content": "#不用擔心哦，我和{NICKNAME}可喜歡這裡了，一定會為你們提供很多素材的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440669,
					"content": "嗯…還有一個問題…我已經好奇很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440670,
					"content": "「三日遐思」裡的「三日」到底是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440671,
					"content": "難道說，佐西摩斯導演寫下每個劇本的時間，都是三天？還是說，一共用了三天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440672,
					"content": "哈哈，這一題我會！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "「昨天」、「今天」和「明天」？好像很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440675,
					"content": "這表示佐西摩斯導演…不對，是「黛依阿」的所有成員，每天都在專心創作，超級努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440676,
					"content": "好想法！可惜有點抬舉我們了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440677,
					"content": "「三日」的真實含義其實是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440678,
					"content": "「時間還早的明天」、「狀態更好的明天」和「再不搞定就完蛋了的明天」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440679,
					"content": "欸？怎麼這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440673,
					"content": "是「昨天」、「今天」和「明天」吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "我們也玩得很開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "還要有把控劇本的人才對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "真是準確的配合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "有這些控制功能就夠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
					"content": "它就在播放這一段宣傳詞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				}
			]
		},
