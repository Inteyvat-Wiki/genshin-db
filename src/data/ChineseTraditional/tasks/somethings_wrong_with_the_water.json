					}
				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#好久不見，{NICKNAME}和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130102,
					"content": "菲米尼？你怎麼還戴著潛水頭盔啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130103,
					"content": "是剛從水裡上來沒多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "嗯…最近水域裡的情況，有些糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130105,
					"content": "比以前多出好幾倍的潛水員，在到處打撈沉底的貨物。我也只能盡量幫點忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130106,
					"content": "早點撈完的話，潛水員們也會離開，水下就會恢復到以前的安靜狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130107,
					"content": "這樣啊…這種鬧哄哄的場面，對你來說一定很不適應吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130108,
					"content": "謝謝派蒙關心。好在，也不全是壞事。有一些額外的收穫，比如無主的古董和裝飾品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130109,
					"content": "#「父親」說，打撈到了漂亮和值錢的東西，可以送到這條船上來，{F#妳}{M#你}們肯定能讓這些東西發揮價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130110,
					"content": "阿蕾奇諾想得也滿周到的嘛。如果是本來就沒人要的好看飾品，說不定可以用來裝點水族館？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130111,
					"content": "要不然，我們也和菲米尼一起打撈吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130112,
					"content": "#可以嗎？也許會佔用{F#妳}{M#你}們的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130113,
					"content": "當然沒問題啦！你都說了撈到了無主的好東西要給我們呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130114,
					"content": "那我們怎麼能光讓你一個人做事呢？這樣白拿好處，我們也會過意不去的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130115,
					"content": "自己撈出古董也有意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "#那…我就把潛水員們的情報分享給{F#妳}{M#你}們，能幫{F#妳}{M#你}們節省一些心力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130118,
					"content": "#如果找到了好東西，請{F#妳}{M#你}們隨意安排它的用途。不過有些是船主也在尋找的物品，那種情況還是要歸還給原主的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130119,
					"content": "好，我們明白啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747130120,
					"content": "請注意安全，不要去陌生的水域。遇見危險的話，也請盡快上來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747130116,
					"content": "水下尋寶本來也很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}