			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大和田",
					"上杉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#喔？{F#妳}{M#你}是…那位金髮的旅行者吧，我聽天野提起過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200302,
					"content": "怎麼，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200303,
					"content": "這是龍二送給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "喔呀，居然是「緋櫻餅」，這可不能隨隨便便就吃掉，得找個合適的地方好好品嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200305,
					"content": "上杉，稍微在這裡代我一下。如果有人來找我，就讓他們等一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200306,
					"content": "大和田先生，現在可是上班時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200307,
					"content": "哈哈哈，沒關係，只不過是出去透透氣而已，很快就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200308,
					"content": "唉…好吧，但您可要快點回來，要是哪位大人突然過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200309,
					"content": "放心吧，奉行所剛剛破了一樁案子，就算是來人，應該也是過來嘉獎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200310,
					"content": "那麼就交給你，上杉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200311,
					"content": "旅行者，和我一起出去轉轉吧，我知道一個地方，很適合悠閒地吃掉這些點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
