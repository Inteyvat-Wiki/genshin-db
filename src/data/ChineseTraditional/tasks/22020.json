			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天野",
					"安藤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "#喔？旅行者，{F#妳}{M#你}怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200202,
					"content": "這是龍二送給你們的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "喔？我看看…這不是「緋櫻餅」嗎，龍二這小子還真是客氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200204,
					"content": "#喂，安藤，你也別這麼有戒心嘛。雖然這位旅行者是外國人，但{F#她}{M#他}不是剛幫了我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200205,
					"content": "虧那小子還記得我們喜歡吃的東西，沒白和他同事一場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200206,
					"content": "龍二之前和你們共事過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "#啊？他沒和{F#妳}{M#你}提過嗎？我倆之前確實和他共事過很短一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200208,
					"content": "不過，那傢伙不知道為什麼，突然捲入了一個事件裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200209,
					"content": "雖然最後託珊瑚的福，把那個真正的犯人揪了出來，幫龍二脫了罪。但那傢伙在那之後也離開奉行所，去珊瑚那邊工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200210,
					"content": "除了這些之外，再多的我也不知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200211,
					"content": "好了，說到這裡就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200212,
					"content": "唔，也是。不過那小子在珊瑚那邊過得可比我們好太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200213,
					"content": "要是可能的話，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200214,
					"content": "我說你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200215,
					"content": "#咳！不說了不說了，謝謝{F#妳}{M#你}，旅行者。這些點心我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200216,
					"content": "記得幫我跟龍二和珊瑚問個好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天野"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
