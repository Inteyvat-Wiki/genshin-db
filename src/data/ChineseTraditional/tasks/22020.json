			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "#辛苦{F#妳}{M#你}了，旅行者，禮物都…交給他們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200502,
					"content": "這都是珊瑚要你做的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "#{F#妳}{M#你}…都發現了？抱歉…請{F#妳}{M#你}去送禮物這件事，確實是社長的囑咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200505,
					"content": "#社長說，想要徹底解決當年我的那樁案件，把幕後的真兇揪出來，{F#妳}{M#你}是不可或缺的幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200506,
					"content": "這案子還沒有徹底解決嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "沒有。社長說，當年她找到那個「犯人」時，一切都…太完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200508,
					"content": "在社長展開調查後，線索、動機和證據幾乎都是自己跑到了社長手裡，而且都齊齊指向那個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200509,
					"content": "雖然最後奉行所將那個人作為犯人處理，但社長始終認為，真正的犯人另有其人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200514,
					"content": "我想，她之所以願意把我收進社裡工作，一定也是為了找到偵破那樁案子的機會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200515,
					"content": "但是，我又能幫上什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "社長的心思…我從來都猜不透。但她有一次和我說，或許是因為她一直待在稻妻，眼界已經變得狹窄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200517,
					"content": "如果能有一個見識廣闊，又無拘無束的人願意來幫忙，說不定這樁案子的偵破工作就能有突破性的進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200518,
					"content": "#旅行者，或許社長覺得，{F#妳}{M#你}就是那個能幫她忙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200519,
					"content": "那我也算是「偵探」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "#如果{F#妳}{M#你}願意幫忙的話，那是當然了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200523,
					"content": "#但無論如何，{F#妳}{M#你}幫了我們偵探社這麼多忙，這一次的報酬還請{F#妳}{M#你}先收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200524,
					"content": "這些話，也是珊瑚教的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "不，這一次，這些話都是我自己想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200526,
					"content": "#再次感謝{F#妳}{M#你}的協助。如果{F#妳}{M#你}願意的話，還請多來我們這裡走一走，社長應該…也會十分歡迎你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200521,
					"content": "這樁案子，報酬不少吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "#那我可說不準，但是…一定會是一筆足夠讓{F#妳}{M#你}滿意的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200510,
					"content": "這案子是珊瑚說的「完美犯罪」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "是的。社長說，當年她找到那個「犯人」時，一切都…太完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200512,
					"content": "在社長展開調查後，線索、動機和證據幾乎都是自己跑到了社長手裡，而且都齊齊指向那個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200513,
					"content": "雖然最後奉行所將那個人作為犯人處理，但社長始終認為，真正的犯人另有其人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200503,
					"content": "你直接把事情告訴我就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
