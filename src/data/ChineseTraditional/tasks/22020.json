			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#旅行者，居然能在這裡遇見{F#妳}{M#你}，看來社長說得沒錯，我們很有緣分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200102,
					"content": "你在這裡做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "是社長的囑咐，為上次的工作做最後一點收尾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200104,
					"content": "其實就是送一些點心過去給同心大人們，感謝他們的協助罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200105,
					"content": "應該是他們要感謝我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "話這麼說沒錯。但這其實也就是藉這個藉口送點禮物過去，打點一下人情而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200108,
					"content": "畢竟，我們偵探社在將來可能會有很多事需要他們多多照拂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200109,
					"content": "這絕對是珊瑚教你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "#呵呵，沒錯，{F#妳}{M#你}的直覺還是一如既往的敏銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200112,
					"content": "那你自己怎麼想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "我？天野和安藤…之前也和我共事過，給朋友送點點心，也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200114,
					"content": "但是…今天社長還讓我去調查另外一件事，從時間上來看，我應該抽不出身了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200115,
					"content": "#旅行者，能請{F#妳}{M#你}幫我把這些點心送給那三個人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "#{F#妳}{M#你}謝你願意幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200121,
					"content": "這裡有三份點心，要送給天野和安藤，還有大和田先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200122,
					"content": "大和田先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "他也是我之前的…同事。在我離開奉行所之前，對我很照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200124,
					"content": "在之前處理連環盜竊案時，他也在奉行所那邊幫了我們一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200125,
					"content": "#那這件事就拜託{F#妳}{M#你}了，旅行者。{F#妳}{M#你}把點心送過去之後，我們再回來這裡碰頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200118,
					"content": "你去送比較好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "還是…社長的委託比較要緊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200120,
					"content": "之後我會再找時間去拜訪那三位的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220200110,
					"content": "一聽就是珊瑚找的理由…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "不是我們協助了他們嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
