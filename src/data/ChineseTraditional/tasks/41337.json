			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "#謝謝{F#妳}{M#你}，這樣我就能把霄燈編出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370402,
					"content": "霄燈編好了，師妹，妳待會就把願望寫上去吧，妳的字是寫得很好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370403,
					"content": "寫，我寫就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370404,
					"content": "師妹…妳…是不是有些不高興？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370405,
					"content": "沒有，我哪有不高興，能幫師兄放霄燈，我可高興了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370406,
					"content": "咳…咳！你們要去哪放燈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "對，這位朋友說得對，我們該準備去放燈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370409,
					"content": "那師兄你自己去吧，我就不去了，爬山太累了…我才沒那個勁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370410,
					"content": "這…我們剛剛才在這裡休息了一段時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370411,
					"content": "我頭有些痛，不知道是不是方才吹了山風了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370412,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370413,
					"content": "我…我幫你們去放吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "這…唉，那就麻煩朋友了。我本來準備去個特別的地方放飛霄燈的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370416,
					"content": "之前古華派尚在的時候，每逢海燈節，師長都會帶著我們去那裡放燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370417,
					"content": "可惜現在山門敗落，那個地方，也久未有古華派門人放霄燈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370418,
					"content": "如今朋友既然願意幫忙，那就請朋友代我去那邊放飛這霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370419,
					"content": "#我把位置標給{F#妳}{M#你}，我先去照顧照顧我家師妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370414,
					"content": "我來幫忙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "咳…咳！你們該去放燈了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
