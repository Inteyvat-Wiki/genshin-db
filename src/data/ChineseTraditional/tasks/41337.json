			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "在這附近放燈，或許就能為仙人所見吧？但是這材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370202,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "啊，失禮了，我和師妹正在考慮放霄燈一事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370204,
					"content": "不過，我們手頭這製作霄燈的材料有些不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370205,
					"content": "如果這位朋友願意的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370206,
					"content": "又是古華派，古華派古華派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370207,
					"content": "好不容易的一個海燈節，許的願望還是古華派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370208,
					"content": "師妹，妳我都是古華派門人，振興古華派，自然是我們的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370209,
					"content": "是是是，師兄說什麼，就是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370210,
					"content": "#唉…這位朋友，如果{F#妳}{M#你}願意的話，能麻煩{F#妳}{M#你}找一些霄燈的材料給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370211,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "#非常感謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370216,
					"content": "咳，我清點了一下，現在好像還缺了一朵清心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370217,
					"content": "之前的那些摘了太長時間，變得又乾又脆，沒辦法用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370218,
					"content": "清心也能用來編霄燈嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "呵呵，這是之前在古華派裡，我和師弟師妹們胡鬧的時候想出來的怪法子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370220,
					"content": "讓霄燈帶上些花香，倒也有些樂趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370221,
					"content": "#我就在這裡等{F#妳}{M#你}，找到材料就請{F#妳}{M#你}送回來吧，麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413370213,
					"content": "你的師妹好像有話想說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "沒什麼，沒什麼，師兄說什麼就是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413370215,
					"content": "唉，師妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孫宇"
				}
			]
		},
