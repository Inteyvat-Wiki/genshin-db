					"nextDialogs": [
						413371012
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 413371012,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371013,
					"content": "師兄，你和這位芷若師姐之間的關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "小雀兒"
				},
				{
