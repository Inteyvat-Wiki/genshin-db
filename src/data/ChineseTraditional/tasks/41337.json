				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "有一次放霄燈的時候，有一位興致高昂的師兄非要和我比劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370702,
					"content": "我還沒說話，我的一個好姐妹幫我用水悄悄澆濕了師兄站著的那塊地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370703,
					"content": "那地又濕又滑，師兄還沒出劍，剛走了一步就摔了個屁股墩，我笑得不行，也不小心摔倒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370704,
					"content": "當時那位師兄也沒生氣，只是指著我笑。然後，周圍的大家也笑成了一團…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370705,
					"content": "不知道，這位師兄現在在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
