			"dialogs": [
				{
					"id": 413370901,
					"content": "我離開古華派的時候，同門弟子已經寥寥無幾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370902,
					"content": "師父沒有責備我，只是叫我要好好生活。",
