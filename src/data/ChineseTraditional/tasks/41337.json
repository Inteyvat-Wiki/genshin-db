					"nextDialogs": [
						413371015
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 413371015,
					"content": "喔…那師兄，那你我之間的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "小雀兒"
				},
