						],
						"pointId": 9248
					}
				]
			},
			"dialogs": [
				{
					"id": 750050701,
					"content": "#居然真的能夠戰勝「大靈」意志的顯化…{F#妳}{M#你}們比我想像中還要強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050702
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050702,
					"content": "通常部族人看到後都會帶著敬意遠離…因為沒有人知道「大靈」的意志究竟是因何而顯化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050703
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050703,
					"content": "運氣好的時候它們會回應你，但是大部分時候都是為了「解決」某些東西才會出現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050704
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050704,
					"content": "所以你們也不知道「大靈」要幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050705,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050706
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050706,
					"content": "之前也說了，「大靈」集合了已逝守護者的意志…相比之下是偉大卻混沌不清的，就如它們的居所——「夜神之國」也是一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050707
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050707,
					"content": "傳說在擁有熾光羽翼的巨龍從火山中甦醒之後，可憐的人們只能在巨牙、利爪和如幡旗的巨翼之間艱難求生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050708
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050708,
					"content": "與此同時，深淵的影響也在不斷加重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050709
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050709,
					"content": "聽說就是在情況最危急的那刻，有部族的人在一陣恍惚之中看到了即使在最深沉的夜裡，也仍然殘留的曜石枝葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050710
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050710,
					"content": "自那以後，才有越來越多人一起在冥冥之中感受到了「夜神之國」…呵呵，他們用圖騰、地脈與元素的力量抵抗深淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050711
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050711,
					"content": "這裡就是古時候的祭壇，部族的先人用黑曜石與夜晚的國度溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050712
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050712,
					"content": "而「大靈」也在那個時代，逐漸成型為各個部族生者與逝者集結一同的圖騰與意識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050713
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050713,
					"content": "原來是這樣。所以剛才那個其實不是真的「大靈」，只是「大靈」的一部分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050714,
					"content": "#是的，剛才{F#妳}{M#你}們看到的是「大靈」一縷意識的化身。據說「大靈」並不具備真正的實體和形象…這有點難解釋，總之，呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050715
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050715,
					"content": "要是惹惱了「大靈」，剛才那個傢伙就會再次出現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050716
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050716,
					"content": "嗚哇，那我們還是快點把那個黑曜石像放回祭壇上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
