			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"雷格巴"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2235.689,
							208.739,
							7959.164
						],
						"pointId": 8109
					},
					{
						"sceneId": 3,
						"position": [
							-2237.073,
							208.846,
							7958.869
						],
						"pointId": 8110
					},
					{
						"sceneId": 3,
						"position": [
							-2236.62,
							208.781,
							7958.013
						],
						"pointId": 9244
					}
				]
			},
			"dialogs": [
				{
					"id": 750050201,
					"content": "不必客氣，你們隨意吧。要不要吃吃看我的手藝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050202
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050202,
					"content": "#如果想自己做的話，那邊的箱子裡有食譜，還有一些我用不到的東西，{F#妳}{M#你}可以翻一翻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050203
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050203,
					"content": "欸？你還隨身帶著食譜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050204,
					"content": "我自己畫的，畫了好幾份，說不定會有人用得上。如果遇到需要解救的人也可以拿來救命啊。妳說對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050205
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050205,
					"content": "哇，你想得還真周到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050206,
					"content": "畢竟在部族外面就只能靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050207
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050207,
					"content": "對了，我們還沒問過你的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050208
					]
				},
				{
					"id": 750050208,
					"content": "我的名字？哈！雷格巴，叫我雷格巴就好。那你們呢，朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050209
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050209,
					"content": "向雷格巴自我介紹。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050210
					]
				},
				{
					"id": 750050210,
					"content": "#派蒙、{NICKNAME}，還有小嵴鋒龍{REALNAME[ID(2)|SHOWHOST(true)]}…你們在納塔相遇，真是奇妙的緣分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050211
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050211,
					"content": "#話說回來，{NICKNAME}，{F#妳}{M#你}們在部族的禁地附近做什麼？嗯？尋寶？打探秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050212,
						750050215
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050212,
					"content": "當然是尋寶啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050213
					]
				},
				{
					"id": 750050213,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050214
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050214,
					"content": "嗯嗯！這種被保護得很好的地方，總有可能藏著寶貝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050220,
					"content": "#總之，不要對那裡動歪腦筋了，外來人。我是不會讓{F#妳}{M#你}們進去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050221
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050221,
					"content": "那裡是古老的先人與夜晚重新建立起連結的地方，自那以後才有越來越多的部族人能夠步入「夜神之國」的門扉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050222
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050222,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050223,
					"content": "「夜神之國」到底是個什麼樣的地方啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050224,
					"content": "哈哈，據說那是所有納塔人在離開這個世界才會前往的地方…只有少數的人有從那裡返回的經歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050225
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050225,
					"content": "#據說那是個流水猶如螢光，佇立著巨大黑曜石碑之處。比起部族的禁地，「夜神之國」才是{F#妳}{M#你}們最好不要好奇的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050226
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050226,
					"content": "所以你之前說的，下面那個…和夜晚世界溝通的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050227,
					"content": "媒介。對，就是以前的人和「大靈」…也是來自「夜神之國」的使者接觸的古老道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050228
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050228,
					"content": "哇，古老的道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050229,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050230
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050230,
					"content": "…或許我說得有點多了。總之，在部族人與「夜神之國」已建有穩定連結的現在，早已不用媒介，而且在我看來手段實在簡陋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050231
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050231,
					"content": "但那好歹也是人類部族的聖物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050232
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050232,
					"content": "唔…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050233
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050233,
					"content": "好吧、好吧…我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050234,
					"content": "對，不要去禁地，那樣才是真正正確的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050235
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050235,
					"content": "#哈！哈！{F#妳}{M#你}們的夥伴很聰明，是個非常聰明的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050236
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050236,
					"content": "我曾經也有許多夥伴…許多很聰明的孩子，但現在我孑然一身，離群索居已久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050237
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050237,
					"content": "咳咳…啊，沒想到天色已經如此之深了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050238
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050238,
					"content": "哈啊…聽了好多似懂非懂的東西，我也想睡覺了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050239,
					"content": "#唉…都怪我，偶爾遇見可以說話的人，就變得喋喋不休了…這樣好了，如果{F#妳}{M#你}們不嫌棄的話，就在這裡休息一晚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050240
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050240,
					"content": "#我來為{F#妳}{M#你}們準備床鋪，反正夜裡我也要在附近巡邏，不必擔心安全的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050241
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050241,
					"content": "哇，好貼心！那就謝謝你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050242,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050243
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050243,
					"content": "#在溫暖的草榻上躺下，伴著閃爍的營火，{F#妳}{M#你}很快便進入了夢鄉…\\n不過{F#妳}{M#你}總覺得耳邊有細碎嘈雜的聲響，無法沉沉入睡。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050244
					]
				},
				{
					"id": 750050244,
					"content": "#直到——\\n直到臉頰旁冰涼濕潤的觸感突然襲來，將{F#妳}{M#你}帶離了黏稠黑暗的夜夢…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050245
					]
				},
				{
					"id": 750050245,
					"content": "#{F#妳}{M#你}睜開雙眼，{REALNAME[ID(2)|SHOWHOST(true)]}熟悉而友好的面孔佔據了{F#妳}{M#你}的視野。\\n或許剛才是牠在舔舐{F#妳}{M#你}，試圖將{F#妳}{M#你}喚醒。\\n又過了片刻，{F#妳}{M#你}才注意到牠似乎正試圖要給{F#妳}{M#你}看什麼東西——看一座奇特的黑曜石像…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050246
					]
				},
				{
					"id": 750050246,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050247,
						750050249
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050247,
					"content": "這是你找到的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050248
					]
				},
				{
					"id": 750050248,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050252,
					"content": "唔…這個東西看起來好嚇人，太不吉利了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050253,
						750050255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050253,
					"content": "派蒙還講究吉利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050254
					]
				},
				{
					"id": 750050254,
					"content": "我只是照實說我的感覺啦…看起來就不像什麼好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050257,
					"content": "#不過，話說回來！{REALNAME[ID(2)|SHOWHOST(true)]}一定是趁我們睡覺的時候出去亂跑了！我說的對不對呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050258,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050259
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050259,
					"content": "真難辦，這個東西是從哪裡撿來的…會不會是很危險、很髒的地方呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050260,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050261
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050261,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}？{NICKNAME}！小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050262
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050262,
					"content": "我們還在這裡，怎麼啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050263,
					"content": "#我聽到{REALNAME[ID(2)|SHOWHOST(true)]}的叫聲就趕過來了。發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050264
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050264,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050265
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050265,
					"content": "這個…這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050266
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050266,
					"content": "天啊，這座黑曜石像就是藏在被封印的大門後面，那個部族禁地深處，以前先民用來與「夜神之國」溝通的媒介…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050267
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050267,
					"content": "#這是{F#妳}{M#你}們要小嵴鋒龍挖出來的？{F#妳}{M#你}們、{F#妳}{M#你}…異邦人，覬覦部族的聖物，虧我還為{F#妳}{M#你}們準備營地和休息的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050268,
						750050270,
						750050272
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050268,
					"content": "等等，我們可以解釋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050269
					]
				},
				{
					"id": 750050269,
					"content": "這不是我們故意做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050274,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050275
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050275,
					"content": "和雷格巴交代了前因後果…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050276
					]
				},
				{
					"id": 750050276,
					"content": "居然是這樣，唉…我居然忘了這個小傢伙可以四處挖洞…是我有點疏忽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050277
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050277,
					"content": "唉…這下就麻煩了，讓我想想…雖然已經很長一段時間沒有用過，但是這個媒介也是聖物，要是「大靈」生氣就麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050278
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050278,
					"content": "啊，那怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050279,
					"content": "#總之就要麻煩{F#妳}{M#你}們把這個東西歸還回它應該去的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050280
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050280,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050281
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050281,
					"content": "就是在說你，嘿嘿，小闖禍精！好了，我們出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050282
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050282,
					"content": "#事先警告{F#妳}{M#你}們一句…遺蹟裡道路曲折，機關眾多，一定要小心危險哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050270,
					"content": "被發現了，快跑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050271
					]
				},
				{
					"id": 750050271,
					"content": "跑什麼啦，這又不是故意挖出來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050272,
					"content": "既然都被你看到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050273
					]
				},
				{
					"id": 750050273,
					"content": "還沒到要動手的程度吧？喂，好好解釋一下呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050255,
					"content": "看起來很值錢欸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050256
					]
				},
				{
					"id": 750050256,
					"content": "哼…這麼醜的東西，想必也不會值太多錢吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050249,
					"content": "你…你吐的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050250
					]
				},
				{
					"id": 750050250,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050251
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050251,
					"content": "怎麼看都不是牠吐出來的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050215,
					"content": "只是好奇而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050216
					]
				},
				{
					"id": 750050216,
					"content": "對呀，看到一扇被封印著的大門，有誰不會好奇呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050217,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050218
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050218,
					"content": "是正派的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050219
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050219,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "派蒙"
				}
			]
		},
