			"dialogs": [
				{
					"id": 750050101,
					"content": "#{NICKNAME}，{F#妳}{M#你}看，這裡有一道被封印的大門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050102,
					"content": "哼哼，我有種直覺，剛才我們在附近拿到的幾個奇怪東西，一定和開啟大門有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050103,
					"content": "真奇怪，這道門的背後會是什麼地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050104,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050105,
						750050110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050105,
					"content": "也許是怪物的巢穴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050106
					]
				},
				{
					"id": 750050106,
					"content": "哇…有怪物的地方，一定會有寶藏的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050107,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050108,
					"content": "那可不一定哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050109
					]
				},
				{
					"id": 750050109,
					"content": "哼，少說喪氣話啦，我們進去看看不就知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050115,
					"content": "喂，兩位異邦人！唔…還有一隻繫著絲巾的小嵴鋒龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050116
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050116,
					"content": "唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050117,
					"content": "#唉呀，有精神的小傢伙，你沒告訴{F#她}{M#他}們封印之所以是封印，就是因為這裡是「禁地」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050118
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050118,
					"content": "#哦，除了深遠的詛咒，{F#妳}{M#你}們在裡面找不到任何東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050119
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050119,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050120,
					"content": "也就是說…沒有寶藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050121,
					"content": "寶藏嘛…大概也是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050122
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050122,
					"content": "大概？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050123
					]
				},
				{
					"id": 750050123,
					"content": "不過那就不是異邦人該染指的東西了，那扇被封印的門後既是「禁地」也是「聖地」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050124
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050124,
					"content": "平常只有來接受考驗的訊使在完成試煉，拿到資格之後才得以進入，據說裡面存放著遠古的先民與夜晚世界的溝通媒介…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050125
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050125,
					"content": "#這麼說來，我只是稍微有事離開了一下子，{F#妳}{M#你}們就取得了證明試煉完成的三枚鑰石？這還真是不得了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050126
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050126,
					"content": "嘿嘿，爬上爬下，找東西這種事情我們很擅長的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050127,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050128,
					"content": "即使是部族的訊使，看來也沒有你們這般矯健的身手。這樣好了，雖然部族的禁地是絕對不可能讓你們進去，不過我的營地就在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050129
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050129,
					"content": "就讓我招待你們，墊墊肚子，再休息一下，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050130
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050130,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050131,
						750050135
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050131,
					"content": "我們還不餓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050132
					]
				},
				{
					"id": 750050132,
					"content": "我也…！唔…我是有點餓啦…不然我們就去休息一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050133,
					"content": "真拿妳沒辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050134
					]
				},
				{
					"id": 750050134,
					"content": "嘿嘿…我還在長高嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050139,
					"content": "#噗嗤…{F#妳}{M#你}們關係還真好。走吧，去我的營地那邊休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050140
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050140,
					"content": "我會準備一些熱乎乎的食物，遠方的來客，說不定我們有很多話題可以聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050135,
					"content": "既然來都來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050136
					]
				},
				{
					"id": 750050136,
					"content": "#沒關係，{F#妳}{M#你}休息，我把風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050137,
					"content": "妳只會睡得比我還熟吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050138
					]
				},
				{
					"id": 750050138,
					"content": "喂——！別太小看我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050110,
					"content": "也許是藏寶的洞窟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050111
					]
				},
				{
					"id": 750050111,
					"content": "哇！我的直覺也是這樣，裡面一定是藏寶的洞窟沒錯啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050112,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050113
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050113,
					"content": "不要太興奮啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050114
					]
				},
				{
					"id": 750050114,
					"content": "裡面有什麼，進去看看就知道了！我們先把這道大門打開吧！嘿嘿，寶藏，寶藏，我們來囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7500502,
			"completionStepIds": [
				7500505
