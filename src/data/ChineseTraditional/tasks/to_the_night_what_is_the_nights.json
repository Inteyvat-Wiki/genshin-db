			},
			"dialogs": [
				{
					"id": 750050501,
					"content": "#{F#妳}{M#你}們終於回來了！呼…剛剛{F#妳}{M#你}們靠近祭壇就「呼」地一下消失了！我還以為{F#妳}{M#你}們被「大靈」帶走了…真的嚇到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050502
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050502,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050503,
					"content": "我們去了一個好可怕的地方！有一個大石碑在和我們說話喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050504,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎麼了，是在擔心我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050505,
					"content": "唔…唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050506
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050506,
					"content": "你看，我就說你的朋友們會平安歸來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050507
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050507,
					"content": "不過…大石碑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050508
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050508,
					"content": "（向雷格巴述說所看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050509
					]
				},
				{
					"id": 750050509,
					"content": "#唉…能夠戰勝「大靈」意志的顯化，聽{F#妳}{M#你}的描述又很像是進入了「夜神之國」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050510
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050510,
					"content": "#看來{F#妳}{M#你}們也不是什麼普通的異邦人啊。居然能夠看見從夜神之國歸還的人，我這輩子也算是值了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050511
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050511,
					"content": "好了，終於解決這個「小風波」了，我們快點上去吧。我還要想辦法讓封印恢復原狀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050512
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050512,
					"content": "嗚哇…還說什麼「小風波」！明明部族的「大靈」意志顯化都被我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050513,
					"content": "沒關係，那些都會隨時間從地脈重聚力量的，不用去管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050514
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050514,
					"content": "哇…明明是部族人，對待自己的崇拜對象這麼隨意嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050515,
					"content": "#那是{F#妳}{M#你}們幸運，若是遇到嚴格一點的部族人，{F#妳}{M#你}們就要被處罰囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050516
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050516,
					"content": "哇啊，我才不要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050517,
					"content": "還有你，小傢伙，下次不許再把這裡的東西挖出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050518
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050518,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050519
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050519,
					"content": "嘿嘿，我們還是快點離開這裡吧，趁還沒有什麼其他祖先被我們激怒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷格巴"
				}
			]
