							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "唉！又到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401302,
					"content": "怎麼了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401303,
					"content": "#其實我也覺得這樣說太任性了，畢竟大家都對我很好，{F#妳}{M#你}們也對我很好…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401304,
					"content": "#{F#妳}{M#你}們不覺得現實世界無趣得可怕嗎？不覺得書裡的世界更美麗嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401305,
					"content": "我也覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "#欸？{F#妳}{M#你}居然這麼覺得嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401311,
					"content": "我覺得還是「揭示之書」裡的世界更美麗——到處都是沾著露水的花瓣，而且好不容易才跟小狗成為了朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401312,
					"content": "小狗…說到這個，夏諾蒂拉，妳聽得懂狗狗說的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401313,
					"content": "嗯？當然聽不懂啊！只是「揭示之書」裡的小狗是特別的，也有可能我是特別的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401314,
					"content": "但我一直冥想，一直到書裡的世界去玩。有一天突然間，原本的汪汪叫就變成了語言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401315,
					"content": "至於我們說的話…他在勸我走，叫我不要再來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401316,
					"content": "唉…我還是想看到向日葵盛開的景象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401317,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "是、是喔…夏諾蒂拉要多保重喔！那我們先走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401307,
					"content": "我不這麼覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "是喔…可能這樣才是對的，我這樣是不正常的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401309,
					"content": "對我來說沒有差別。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#看來{NICKNAME}{M#哥哥}{F#姐姐}是最堅強的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "夏諾蒂拉"
				}
			]
		}
	]
}