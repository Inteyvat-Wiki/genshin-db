			"dialogs": [
				{
					"id": 741401101,
					"content": "哎呀！又見面了。咦？這次把派蒙也帶來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401102,
					"content": "咦？上次我們一起「冥想」到這裡來的時候，我也在呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401103,
					"content": "有這回事？那可能是我忘了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401104,
					"content": "#不管怎麼說，多虧有{F#妳}{M#你}幫忙我才能夠找到「謎鏡」的位置和將要盛開花朵的地方，對這裡的瞭解也加深了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401105,
					"content": "唔…夏諾蒂拉說話的風格還是這麼令人摸不著頭緒呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401106,
					"content": "汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "嗯？不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401108,
					"content": "嗚汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "好啦好啦，我知道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401110,
					"content": "（唔…她和小狗在說什麼呀？難道說，美露莘一般都會狗語嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401111,
					"content": "（真不可思議。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "真沒辦法，那下次再見囉！哼，就算你這樣說，我也還是會回來找你玩的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741401113,
					"content": "#那我們走吧，{NICKNAME}{M#哥哥}{F#姐姐}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
			],
