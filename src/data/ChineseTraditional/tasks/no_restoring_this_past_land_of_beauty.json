			"trigger": {
				"objectNames": [
					"治平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "這次是發生在天遒谷嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#是{NICKNAME}啊，幸會，沒想到今天能在這見到{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220104,
					"content": "#唔…說起來，{F#妳}{M#你}最近去過天遒谷、南天門一帶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220107,
					"content": "最近協會裡不斷接到南天門到天遒谷那一帶的地震報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220108,
					"content": "最開始只是輕微的晃動，但最近似乎越來越嚴重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220109,
					"content": "不久之前，協會裡又接到報告，在一次格外強烈的地震後，部分的山體與遺蹟發生了坍塌，露出了一片巨大的洞窟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220110,
					"content": "報告中還描述說，在那邊見到了某種未知的魔物。根據描述，可能是過去曾經作亂的「岩龍蜥」和「古岩龍蜥」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220111,
					"content": "需要我做什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "#唔，我想拜託{F#妳}{M#你}去天遒谷的那個大空洞去搜索一下，看看地震對周圍環境造成的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220113,
					"content": "還有那些魔物的情況，如果真的大規模出現了，肯定也不能放著不管，必須快點制訂對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220114,
					"content": "#當然，這也算是協會的正式工作。完成以後也會有對應的酬勞，怎麼樣，{F#妳}{M#你}意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "#那就拜託{F#妳}{M#你}了，去那裡搜索的時候，請千萬注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "治平"
				}
			]
		},
