	"talks": [
		{
			"id": 7265001,
			"completionStepIds": [
				7265001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265001",
							"2"
						],
						"stepId": 7265001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"涉川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726500101,
					"content": "#{F#妳}{M#你}好。我叫涉川，是武道流派「心流」的宗主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500102
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500102,
					"content": "#看{F#妳}{M#你}的樣子，應該是外國的旅行者吧。如何，對「心流」有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500103,
						726500104
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500103,
					"content": "「心流」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500106
					]
				},
				{
					"id": 726500106,
					"content": "總之，這是老身獨創的技術。與岩藏流、喜多院流，還有外國的「西風劍術」這些用武器戰鬥的流派不同，我的技術的精髓在於磨練「心流」，再利用「心流」磨練戰鬥技巧的流派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500107
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500107,
					"content": "早年流浪海外，四處鑽研武道時，我曾觀察過納塔人的「拳鬥術」。這種武道流派在練習時，會與假想敵戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500108
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500108,
					"content": "「假想敵」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726500109,
					"content": "跟你的「幻想朋友」對打。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500110
					]
				},
				{
					"id": 726500110,
					"content": "沒錯。幻想敵人的行動，再針對幻想做出反應。這種在當地被稱為「影子拳鬥」的練習技巧，在老身看來是相當孤高的修行法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500111
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500111,
					"content": "而「心流」就是將這種修行發揮到極致的無限制格鬥流派。在老身的指導下，什麼樣的假想敵都能得到再現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500112
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500112,
					"content": "從史萊姆到落武者，甚至是那些至冬國來的異人戰士。只要精通心流的心得，就輕易能再現出與其戰鬥的情境，從而磨練自己的戰鬥技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500113
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500113,
					"content": "順帶一提，世界上最強的生物恐怕是「雷晶蝶」了。岩藏流前代的永胤曾經藉由老身的「心流」，嘗試挑戰有人類體型的雷晶蝶，但就連十秒也沒能撐下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500114
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500114,
					"content": "不僅僅是對手，就連風向、天候、機關、乃至「地脈異常」，老身都可以透過心流模擬。可以說得上是最實用的技術了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500115
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500115,
					"content": "既然心流這麼厲害，為什麼涉川先生要親自挖角呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726500116,
					"content": "老身心流實在是太過…真實了，以至於弟子與假想敵戰鬥時，有時真的會受傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500128
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500128,
					"content": "即使是心流幻想的「劍」，也會砍傷手腳。而心流幻想的「火銃」，甚至真的能射穿身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500117
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500117,
					"content": "久而久之，不完全傾心於武道的，就因為害怕離開了心流；而不顧一切的武癡，又不應該掌握心流，被我攆走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500118,
						726500119
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500118,
					"content": "這麼厲害？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500120,
					"content": "#是啊。但我看{F#妳}{M#你}與心流也有緣，不如試試老身的「心流」，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500121,
						726500122
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500121,
					"content": "有意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500124
					]
				},
				{
					"id": 726500124,
					"content": "總之，如果有興趣的話，就將眼前的平臺視為心流的「土俵」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500125
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500125,
					"content": "#而老身，會為{F#妳}{M#你}量身定做最合適的「心流戰場」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500126
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500126,
					"content": "只不過，小心別受傷了。畢竟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500127
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500127,
					"content": "「心流」可是很無情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500122,
					"content": "沒有興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500123
					]
				},
				{
					"id": 726500123,
					"content": "這樣啊。那還真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500124
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500119,
					"content": "這麼可怕？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500104,
					"content": "沒有興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500105
					]
				},
				{
					"id": 726500105,
					"content": "#別這麼說嘛。{F#小姑娘}{M#小夥子}，{F#妳}{M#你}步伐穩健、站姿挺拔，呼吸更是毫無破綻，想必常年走在「武」之道上吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500106
					],
					"speakerTitle": "涉川"
				}
			]
		}
	]
}