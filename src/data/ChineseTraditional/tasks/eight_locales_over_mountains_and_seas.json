	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "五百藏，你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740102,
					"content": "#咿！居然被識破了！{F#妳}{M#你}們究竟是…這個氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740103,
					"content": "#原來是{F#妳}{M#你}們這些小輩啊。有些時日沒見，氣味我都認不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740104,
					"content": "五百藏倒是完全沒變，還是看到人就害怕，而且還困在石頭裡呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740105,
					"content": "呶？！妳這小輩，這話是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740106,
					"content": "希望你的封印早點解除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "區區人類的封印罷了！只要吾輩努力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740109,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740111,
					"content": "#哼。不管怎麼說，孩子們受了{F#妳}{M#你}不少照顧。小狸子們總說，有個聞起來很香的黃毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}經常陪他們玩，可開心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740112,
					"content": "#黃毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "吾輩本來還以為，人類都跟把吾輩妖狸一族封印的傢伙一樣，又壞、又可怕。看來，還是有些好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740116,
					"content": "大部分人都是好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#對呀，我和{NICKNAME}遇到的人，大部分都是好人。五百藏被封印還不是因為把梳子偷走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740119,
					"content": "#哼，現在梳子已經給{F#妳}{M#你}們了。如果{F#妳}{M#你}們遇到那個跟靈善坊學法術的傢伙，跟他說一聲，讓他把吾輩從石頭裡弄出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740120,
					"content": "吾輩在這裡坐了這麼久，都怪那個臭狐狸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740121,
					"content": "（五百藏抱怨起來好像老頭子哦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740122,
					"content": "（年紀確實應該很大吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "#小輩，{F#妳}{M#你}們手也不是石頭，腳也不是石頭，一定去過不少地方吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740124,
					"content": "#哼哼，我和{NICKNAME}，可是從海對面來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740125,
					"content": "向五百藏講了一些璃月與蒙德的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "…原來外面有這麼多地方哪。真是了不得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740127,
					"content": "一直以來，都只有小狸子跟吾輩報告，所以根本不知道外面是什麼樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740128,
					"content": "以前在影向山上，吾等看到北邊的海對面，有一座好高好高的山，可能比影向山還高，還一直想知道，那是什麼地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740129,
					"content": "那邊的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "從方位來看，應該是龍脊雪山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740132,
					"content": "嗚呶呶，雪山…聽著就覺得肚皮冷。真不知道那個傢伙怎麼想去這樣的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740134,
					"content": "#咳咳。之前也說了，{F#妳}{M#你}們是好人，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740135,
					"content": "是請人幫忙的語氣耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740136,
					"content": "呶！吾輩好歹是得了大御所大人的令，守護鎮守之森的隱神保生司正，如果不是被封在石頭裡，吾輩一定要用八疊大的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740137,
					"content": "有什麼需要幫忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "#雖然吾輩沒辦法自由行動，不過孩子們沒問題。吾輩想要拜託小輩{F#妳}{M#你}們，帶小狸子去外面「修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740144,
					"content": "#就帶「吉法師」去吧。上次和{F#妳}{M#你}們一起玩以後，他就一直唸叨著，想要再見到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740145,
					"content": "可以是可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "嗯，畢竟我們和吉法師語言不通，一同旅行的話，多少會遇到困難吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740148,
					"content": "#怎麼可能。吾等妖狸一族，自然是明白人類的語言的。只不過是{F#妳}{M#你}們人不明白一般妖狸說的話罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740149,
					"content": "什麼！居然還有這樣的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740150,
					"content": "不過作為旅伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "還是希望能一邊旅行、一邊聊天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#就像派蒙和{NICKNAME}那樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740153,
					"content": "#呶，真拿{F#妳}{M#你}沒辦法。之前不是有誰用吾等妖狸一族的法術，給{F#妳}{M#你}們做了吃食嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740154,
					"content": "#別看吾輩現在是這個模樣，做出讓{F#妳}{M#你}們能聽懂吉法師說話的「飯」，也不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740155,
					"content": "好耶！是好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740156,
					"content": "也不算是好吃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "哼，可別小看吾輩的手藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740158,
					"content": "雖然很難形容五百藏是從哪變出來的…\\n總之，和派蒙一起吃了放在五百藏肚皮上的「看起來很美味」的大餐。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740160,
					"content": "那當然了。吾輩可是曾經用泥糰子和狸子毛做成的刺身拼盤，把緒方的四鬼騙得團團轉的五百藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740161,
					"content": "五百藏真厲害！不過，這麼說來，剛剛給我們吃的到底是用什麼做的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740162,
					"content": "有的事情還是不問為好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740164,
					"content": "算了，我們去找吉法師聊聊看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740146,
					"content": "還有個問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "這個嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#嗯嗯，{NICKNAME}的意思我懂！有什麼寶藏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740140,
					"content": "寶藏？那當然了，吾輩可是五百五妖狸的統領，稻妻的寶藏，什麼沒見過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740141,
					"content": "那麼，有什麼需要幫忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "對，我們最會幫忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740131,
					"content": "從方位來看，應該是龍脊雪山。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "聞起來很香…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#不是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}，是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "派蒙的意思是，希望封印早點解除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
