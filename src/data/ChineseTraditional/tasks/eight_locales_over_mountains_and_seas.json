			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「吉法師」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "吉法師，好久不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740202,
					"content": "呶！白毛黃毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740203,
					"content": "黃毛是指我…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "喂！你說誰是白毛呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740205,
					"content": "好強。能聽懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740206,
					"content": "#我叫{NICKNAME}，這位是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "要好好記住喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740208,
					"content": "咔嚓咔嚓堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740209,
					"content": "咦，堇瓜？咔嚓咔嚓又是什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740210,
					"content": "無論如何，也算是勉強能說得上話吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740211,
					"content": "確實有夠勉強的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#不管怎麼說，{NICKNAME}，我們去跟五百藏打聲招呼吧！畢竟，要帶吉法師一起遠行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740213,
					"content": "五百藏！耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740214,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "呶！如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740302,
					"content": "呶！見到白毛黃毛，喜歡。堇瓜砰砰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740303,
					"content": "堇瓜砰砰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "#呶？想不到，{F#妳}{M#你}這小輩，還挺上道嘛…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740305,
					"content": "砰砰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740306,
					"content": "所以說，堇瓜砰砰是什麼意思…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "砰砰是砰砰，堇瓜是堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740308,
					"content": "#看來{F#妳}{M#你}們交流沒有任何問題了。吾輩的「烹飪」技術還是一樣好哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740309,
					"content": "…姑且算是沒問題吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "不對！問題大著呢！吉法師說的話，基本都聽不懂啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740312,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740313,
					"content": "向五百藏傳達了交流的效果。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "#唔唔，原來是這樣啊。不用擔心，那是因為{F#妳}{M#你}們還沒有適應吉法師的氣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740315,
					"content": "慢慢適應吧！越適應吉法師的氣息，就越能聽明白吉法師說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740316,
					"content": "「慢慢」是多久啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740317,
					"content": "這個啊，這個嘛…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740318,
					"content": "呶！稍安勿躁就是了，真是急性子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740319,
					"content": "急性子不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740320,
					"content": "看來五百藏也不知道啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "哼！吾輩可是活了好久好久的妖狸大王隱神五百藏，怎麼會像你們人類那樣，對時間這麼計較呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740322,
					"content": "（雖然大部分時間都被封印在石像裡啦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740323,
					"content": "不過，為什麼五百藏可以和人對話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "呶，真沒禮貌。應該是，為什麼你們人類可以和吾輩對話才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740325,
					"content": "像吾輩這樣活了好久好久、力量強大的妖狸，多少都和人類打過交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740326,
					"content": "好久好久以前，吾等經常和天狗、狐、鬼、妖怪與人打交道。人的故事雖然總在說人，其實有一半是妖狸偽裝成的人類的歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740327,
					"content": "剩下一半的一半是人類自己的故事，另一半是天狗、狐、鬼和其他妖怪的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740328,
					"content": "不過，這一半裡面，也有一半是吾等妖狸偽裝成他們的故事。然後，所有妖狸的故事裡，有一半是吾輩五百藏的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740329,
					"content": "#所以，哼，吾輩可是最厲害的呶，能夠和{F#妳}{M#你}們這些小輩說話自然不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740330,
					"content": "我懂了，十六分之五都是你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "呶？「十六分之五」…是什麼好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740332,
					"content": "聽起來，好吃。想吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME}是說，依照五百藏的說法，五百藏在故事裡的佔比啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740334,
					"content": "五百藏。厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740335,
					"content": "哼，那還用說。吾輩的厲害，你要好好學學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740336,
					"content": "欸？仔細一想，好像能慢慢聽明白吉法師說的話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740337,
					"content": "白毛聰明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740338,
					"content": "嗚哇，被吉法師這樣誇了，心裡感覺很不是滋味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740339,
					"content": "#那就好。這個孩子就拜託{F#妳}{M#你}們了，帶他到外面去修行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740340,
					"content": "吾輩還是個幼狸的時候，也曾經巡禮稻妻十八所，尋訪過去大妖狸「九百九」的名跡，絕不偏離狸道，才能達到今天的高度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740341,
					"content": "欸！所以五百藏才被封印在石頭裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740342,
					"content": "呶哈哈，石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740343,
					"content": "呶？！吉法師，連你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740344,
					"content": "回到正題！那我們先去什麼地方好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740345,
					"content": "剛剛五百藏提到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "嗯嗯！就去龍脊雪山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740348,
					"content": "「因為，山就在那裡」——終於有機會帥氣地說這樣的台詞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726740349,
					"content": "山就在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740350,
					"content": "嗚呶呶，聽起來好冷…吉法師，肚皮不要著涼。不然，會感冒的。感冒的話，就不能表演腹鼓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 726740351,
					"content": "#然後，要好好吃飯，在外面要乖乖跟著黃毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
