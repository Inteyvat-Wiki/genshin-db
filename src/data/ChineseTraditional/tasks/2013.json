						20130402,
						20130403
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20130402,
					"content": "果然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "欸？我們怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130405,
					"content": "我們家小姐有封信要交給您，請一定要看一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20130406,
					"content": "信？讓我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130407,
					"content": "見信如晤：如此唐突地遞上信箋，實在抱歉。希望沒有讓您為此感到困擾。寫信邀約來自異鄉的陌生人，這種事情對我來說也是第一次呢。但我相信與您的相遇絕非偶然。所以，恰好今夜月色尚佳，望您不吝相會。請不用擔心家臣與侍衛盤查，我自有辦法引離。企盼著您務必前來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130408,
					"content": "#是說…要{F#妳}{M#你}晚上偷偷去找她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130409,
					"content": "#剛才{F#妳}{M#你}好像早就知道會發生這樣的事…是為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130410,
					"content": "我和她確認過眼神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "#唔？{F#妳}{M#你}們在背著我搞什麼名堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130414,
					"content": "嗯…還是晚上問問她看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130412,
					"content": "慎介根本不打算讓我們離開。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "我就覺得哪裡不對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130403,
					"content": "來了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
