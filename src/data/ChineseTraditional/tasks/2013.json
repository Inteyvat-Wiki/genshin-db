				},
				{
					"id": 20131006,
					"content": "小…姐…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131007,
					"content": "唉，沒想到真會如此，我就猜是會這樣，新之丞你卻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131008,
					"content": "不會的，小姐一定別有用意，對吧？還有小姐您說的那個鐮治是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131009,
					"content": "不避諱地說…是我的心上人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131010,
					"content": "心上人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131011,
					"content": "喂，不是吧，新之丞你難道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131012,
					"content": "沒、沒什麼…咳咳…我只是隨便問問，我怎麼可能、怎麼可能做那種夢呢…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131013,
					"content": "二位不必擔心，這件事還請二位先當做不知道，如果家父怪罪下來，我會一人承擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131014,
					"content": "也只能如此了，唉…都聽您的，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131015,
					"content": "可是千里小姐，如果真的被發現了可怎麼辦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131016,
					"content": "沒關係的，家父自我小時候便非常寵我，最多會罰我半日禁食之類的而已，不必擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131017,
					"content": "原來那個老頭子還有這樣的一面…那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131018,
					"content": "請二位路上小心，我們有緣再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131019,
					"content": "嗯，再見，千里小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131020,
					"content": "走啊，繼續運貨啊，愣著幹什麼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131021,
					"content": "嗚…咳咳…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131005,
					"content": "也請妳務必保重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
