			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柊慎介",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "我是柊慎介，勘定奉行柊家的家主，很榮幸見到二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130202,
					"content": "我也很榮幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "很高興見到你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130205,
					"content": "我們這次來找你，是想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130206,
					"content": "欸，不急不急。好不容易見到聞名遐邇的兩位旅者，何必這麼匆忙談正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130207,
					"content": "嘿嘿，我們果然很有名氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130208,
					"content": "當然。能挫敗風魔龍，鎮壓漩渦之魔神的凡人，普天之下又有幾人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130209,
					"content": "確實！這點說的對，嗯嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130210,
					"content": "還有…在璃月港破壞愚人眾的計畫，在決鬥中戰勝他們的執行官的事，也是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130211,
					"content": "哇，連這你都知道，當然是真的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130212,
					"content": "嗯…果然嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130213,
					"content": "怎麼了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130214,
					"content": "呵呵，沒什麼沒什麼，老朽由衷敬佩二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130215,
					"content": "過獎了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "…能有二位光臨離島，也是本島的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130218,
					"content": "早就聽聞二位的熱心腸，不知可否能屈尊為我們勘定奉行辦些小事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130219,
					"content": "#儘管說吧，客氣了客氣了！對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130220,
					"content": "又到了幫忙的時間，對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "呵呵，那便好。這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130223,
					"content": "#清心，{F#妳}{M#你}知道吧？那種經常長在璃月山頂上的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130224,
					"content": "知道，我們摘過，難道還要我們回一趟璃月嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130225,
					"content": "嗯，就幫我摘三百株新鮮的清心來吧？要剛摘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130226,
					"content": "我是不是聽錯了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130227,
					"content": "這個數量是不是不太對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "嗄？有點麻煩是嗎…唔，這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130230,
					"content": "那不如，島上有些信件需要派送，不知能否幫忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130231,
					"content": "這還差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130232,
					"content": "一共七百零九封。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130233,
					"content": "喂！怎麼回事呀！而且這種事真的需要我們來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130234,
					"content": "呵呵，真是不好意思，島上確實有點人手不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130235,
					"content": "理由也好俗套！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130236,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "怎麼辦，旅行者，我們真的要幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130238,
					"content": "我會考慮考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "不愧是閣下，那我就等您的消息了，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130239,
					"content": "等我先去勘察一下情況。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "等摘完早就不新鮮了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "這是我的專長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "雖然最後還是讓他們得逞了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
