			"trigger": {
				"objectNames": [
					"小林",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "等一下！請出示「通行憑證」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130102,
					"content": "抱歉，我們有急事要去鳴神島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130103,
					"content": "未持有「通行憑證」的話就請回吧，這是規矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130104,
					"content": "唉…果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130105,
					"content": "旅行者，快想想辦法，現在要怎麼辦才能出去呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130106,
					"content": "如果社奉行的人聽說過我們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "#{F#妳}{M#你}是說，直接去見勘定奉行本人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130109,
					"content": "…儘管對他手下的人很有意見，但好像也只能試試看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130110,
					"content": "萬一他很崇拜我們呢？嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130107,
					"content": "勘定奉行應該也聽說過吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
