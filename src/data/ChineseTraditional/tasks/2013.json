					"nextDialogs": [
						20131106
					],
					"speakerTitle": "橫山"
				},
				{
					"id": 20131106,
					"content": "這兩位是遠道而來的貴客，別再用那老一套了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "柊慎介"
				},
				{
