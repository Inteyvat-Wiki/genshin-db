				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "#啊，{F#妳}{M#你}們終於來了嗎…我…我叫柊千里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130702,
					"content": "算是…第二次見面了吧，請多關照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130703,
					"content": "哇，真的是柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130704,
					"content": "我才是，請多關照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "不用…不用這麼客氣，我早就很仰慕您的事蹟，終於找到這樣的機會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130707,
					"content": "嗯？怎麼感覺氣氛有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130708,
					"content": "#這次偷偷見面，主要是在想…如果錯過了機會，是不是就再也沒辦法和{F#妳}{M#你}講…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130709,
					"content": "講…講什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130710,
					"content": "#講…想讓{F#妳}{M#你}幫忙送信的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130711,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "妳和妳父親果然是父女呢！不能換點事情委託嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130714,
					"content": "不不…請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130715,
					"content": "我是希望二位可以替我送信去鳴神島，到天領奉行的二少爺鐮治先生那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130716,
					"content": "我父親一直反對我們聯絡，想必在政治上他對我的婚配對象有更好的期許，可是我的心裡卻只有鐮治先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130717,
					"content": "#在離島沒有人可以違抗父親的意思，而{F#妳}{M#你}們又是非常難得地，想往鳴神島去的異鄉人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130718,
					"content": "原來是有這樣的苦衷啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130719,
					"content": "#當然，與此相對的，我會全力幫助{F#妳}{M#你}們離開這裡，請相信我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130720,
					"content": "嗯…好像是不錯的交易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "#其實，只要{F#妳}{M#你}們還身在稻妻…父親就沒有讓{F#妳}{M#你}們離開離島的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130723,
					"content": "嗯嗯，這點我們也看出來了，安排那樣的任務肯定是想要拖住我們而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130724,
					"content": "前些天我偷偷聽到父親和一位趾高氣昂的女性談話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130725,
					"content": "他們在說的，似乎就是如何將異鄉的旅者禁錮在離島的事，還是頭一次見父親對將軍之外的人如此恭敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130726,
					"content": "趾高氣昂的女性…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "#時間應該差不多了，我把安排{F#妳}{M#你}們出去的計畫告訴{F#妳}{M#你}…剛好有一批貨物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130729,
					"content": "（柊千里告知了旅行者她的計畫…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130730,
					"content": "#好了，我到關口那邊等{F#妳}{M#你}，信的事…就拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130727,
					"content": "看來要盡快離開。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "除此之外也別無他法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "我回去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "很高興能再見到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
