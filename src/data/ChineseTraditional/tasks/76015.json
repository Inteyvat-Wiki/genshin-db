						760150208
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150208,
					"content": "「鄰家的舞曲讓我忍不住踏腳！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150209,
					"content": "「我在拉琴，你們在微笑。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "「大家都在開心跳舞，嘿！嘿！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150211,
					"content": "「我們聚起來，聚起來跳舞！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "#啊哈，沒錯沒錯，就是這麼唱，{F#妳}{M#你}習慣得很快嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150213,
					"content": "#我的名字叫███，現在我們就算認識了。椅子{F#妳}{M#你}想坐就坐吧，我也不是小氣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150214,
					"content": "#{F#妳}{M#你}也是執燈士對吧，這杯啤酒算我請{F#妳}{M#你}的，搞不好我們還能在訓練的時候遇上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150215,
					"content": "謝謝，儘管我喝不到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "我該去夜巡了，下次再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150216,
					"content": "幸會，我叫作菲林斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "如果我想坐在這裡呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
