			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大嗓門的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "#喂，{F#妳}{M#你}是誰？這是我的椅子，酒館裡誰不知道這是我███的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150102,
					"content": "#{F#妳}{M#你}是剛來島上報到還是怎樣？別亂占別人位置啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150103,
					"content": "我的啤酒怎麼還沒來？快點，我再坐一下就得去夜巡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150104,
					"content": "酒館？啤酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "#{F#妳}{M#你}非要坐也可以，先來跟我們一起喝酒唱歌，熟了都是朋友，{F#妳}{M#你}要坐就坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150107,
					"content": "#會唱歌吧？喲吼，大家唱一句{F#妳}{M#你}唱一句——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150108,
					"content": "「鄰家的舞曲讓我忍不住踏腳！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150109,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "#不對不對，{F#妳}{M#你}這傢伙真掃興，挪德卡萊的人怎麼可能不會唱這首歌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150113,
					"content": "#{F#妳}{M#你}又不會唱歌又不會玩，怎麼融入隊伍？到時候狂獵來了，身邊沒有隊友照顧就完蛋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150114,
					"content": "去學唱歌後再來酒館。喲吼，再來一杯啤酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大嗓門的幽影"
				},
				{
					"id": 760150110,
					"content": "「我家的派蒙讓我忍不住大笑！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "「島上幽靈圍著椅子又唱又跳！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "借我坐一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
