			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩博蘭",
					"蘇法什",
					"西梅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "閣下，我代表鈴風王國歡迎您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700102,
					"content": "你們接下來準備怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "唔…首先，我會向整個王國公告聖物已經做出判斷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700104,
					"content": "守護者嘛…則是那位遠道而來的福羅貝爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700105,
					"content": "欸？！為什麼要這樣做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700106,
					"content": "想要向大家解釋我們所經歷的那件事，實在是太過複雜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700107,
					"content": "而且大家一時之間應該也無法理解為什麼我既是公主，又是守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700108,
					"content": "等到時機適合的時候，我會將所有事情詳細地記錄下來，以書面的形式告訴所有國民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700109,
					"content": "在那之前，我還是會以公主的身分主持王國的各項事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700110,
					"content": "等到將那些「試煉場所」正式改造成「鍛煉場所」後，我就會啟程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700111,
					"content": "啟程？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "公主殿下，妳還記得…在洞窟的時候，那個聖物究竟是為誰亮起的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700114,
					"content": "欸？為誰…亮起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700115,
					"content": "對啊，那時我們都在聖物旁邊，公主殿下當然值得被認可，但是我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700116,
					"content": "你可是被冠軍認可的冠軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "對呀。那個冠軍都專門來拜託你了，還有什麼不值得被認可的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700118,
					"content": "也許是因為公主殿下的光芒太耀眼，大家都搞錯了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700119,
					"content": "噗…那麼冠軍先生，你願意再接受一次試煉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700120,
					"content": "由我，鈴風王國的西梅公主，親自用聖物為你見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700121,
					"content": "當然！我願意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700122,
					"content": "你不要激動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "一說起公主殿下就這麼激動。嘿嘿，福羅貝爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700125,
					"content": "#{F#妳}{M#你}們不要誤會喔！我是、我是為了雨歌塘的使命！我經歷了那麼多訓練，就是為了拯救…那個…保護公主殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700126,
					"content": "這麼重要的任務，我當然要確保萬無一失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700127,
					"content": "你願意和公主殿下同行嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "願、願意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700129,
					"content": "呵呵，那樣最好。那麼福羅貝爾，冠軍先生，準備好接受我的試煉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700130,
					"content": "是的，公主殿下！隨時都可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700131,
					"content": "嗚哇！聖物又亮起來了！亮、亮過頭了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700123,
					"content": "耳朵、耳朵好痛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "你要去做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
