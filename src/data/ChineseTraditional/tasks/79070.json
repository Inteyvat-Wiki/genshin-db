				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福羅貝爾",
					"奧雷盧",
					"埃斯唐普"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "埃斯唐普！你跑去哪裡了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700202,
					"content": "呃…我去周圍逛了逛，嘗試了一下那個試煉，還滿有趣的，只是要用點別的方法通過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700203,
					"content": "你們的事我都聽奧雷盧先生說了，不錯啊？「守護者先生」，你這不是滿有本事的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700204,
					"content": "你、你、你…你要是在我旁邊！我一定把你推出去！有十次，我就推十次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700205,
					"content": "所以我才去試煉了。福羅貝爾，好朋友，我相信你可以搞定的。看，你果然搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700206,
					"content": "哈哈哈哈哈，你們這兩位好先生，今天是我們雨歌塘的吉利日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700207,
					"content": "我們終於有了一位真正的冠軍，雖然福羅貝爾先生還沒有機會拯救公主，但我相信他會有大展身手的機會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700208,
					"content": "唉！我什麼也沒做，奧雷盧先生，我就只是待在旁邊看，全都是公主殿下在忙來忙去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700209,
					"content": "那不是更好嗎？難不成您想要公主殿下遇到危險？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700210,
					"content": "我…這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700211,
					"content": "唉喲，好了。福羅貝爾先生，您可是接過了那位西布雷呂的使命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700212,
					"content": "亂講！我都不知道他到底是不是西布雷呂！我只聽說過他，沒有聽過他說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700213,
					"content": "而且，你還接受了那位公主的試煉，真不愧是冠軍啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700214,
					"content": "我們可以先不談這件事嗎？拜託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "福羅貝爾"
				},
				{
					"id": 790700215,
					"content": "總之，我們雨歌塘的未來就都交給你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700216,
					"content": "這下子我們總算可以沒有任何壓力地跳躍了，我回去就建議組委會在跳遠比賽裡加入更多趣味性的內容！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "奧雷盧"
				},
				{
					"id": 790700217,
					"content": "這是個好主意，我願意主持，我們現在就回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700218,
					"content": "你們不要把我丟在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福羅貝爾"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西梅",
					"薩博蘭",
					"蘇法什"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "您和那位紙蛙，全都被認可為守護者了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "薩博蘭"
				},
				{
					"id": 790700302,
					"content": "不可思議，從未聽說！這之前也沒有過這種紀錄啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "蘇法什"
				},
				{
					"id": 790700303,
					"content": "而且您還要改造試煉…不行！不行啊！公主殿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "薩博蘭"
				},
				{
					"id": 790700304,
					"content": "您不能隨便就改造這麼古老的傳承啊！公主殿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "蘇法什"
				},
				{
					"id": 790700305,
					"content": "好了好了，你們小聲一點，我的耳朵都被震痛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700306,
					"content": "事情已經這樣定下來了。我現在已經既是公主又是被聖物認可的守護者，你們更攔不住我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700307,
					"content": "但是，公主殿下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "薩博蘭"
				},
				{
					"id": 790700308,
					"content": "你們就放心吧。我會主持鍛煉儀式，訓練出許多可靠的飛鼠來保護王國的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700309,
					"content": "在那之後，我才會離開王國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700310,
