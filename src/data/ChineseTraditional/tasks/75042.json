			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曼科"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750420101,
					"content": "哦，您好，最近如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420102,
					"content": "#或是說{F#妳}{M#你}來找我，是有什麼想要確認的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420103,
					"content": "關於「焰主之祝」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "「焰主之祝」…有人認為這是一種返祖現象，因為大家一致認為這種力量的源頭在血脈上更為深遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420105,
					"content": "只是…據龍遺物研究協會的記載來看，這些身上有「焰主之祝」印記的幼龍大多數在成長過程中，受體內無法控制的力量擺布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420106,
					"content": "那份力量會撕扯牠們的身軀，讓牠們與正常龍眾不同…變得狂暴、失去理智。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420107,
					"content": "名為「霍拉瓦伽」的絨翼龍暴君就是最好的例子…據說牠從前就是一隻被賜予「焰主之祝」的絨翼龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420108,
					"content": "關於部族的「處置」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "就是讓牠回歸夜神的國度。在牠來到世上時，或許無法被龍眾或夜神之國接納。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420110,
					"content": "但在離開此世之後，必然還是會回歸夜晚的懷抱，這對牠來說雖然冰冷，但卻可以在那裡與眾生的靈魂相會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420111,
					"content": "恕我冒昧，那或許也是一種溫柔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420112,
					"content": "有信物的線索了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "#有一些，但是…我還要找人確認，也許之後{F#妳}{M#你}會在帕加爾那裡找到我，他是回聲之子的領袖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420114,
					"content": "雖然他看起來有點…浮誇，但是恕我直言，他比最堅固的晶石還要可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				},
				{
					"id": 750420115,
					"content": "沒什麼想問的，再見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "隨時歡迎您，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				}
			]
		}
	]
}