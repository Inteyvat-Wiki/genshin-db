				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "所以，現在我們要幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170202,
					"content": "為妳留下畫片，怎麼操作就交給我們，妳只需要在那邊站好，擺好姿勢就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170203,
					"content": "簡單來說，畫片可以把此時此刻的妳記錄下來，很適合作為紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170204,
					"content": "那擺姿勢又是怎麼一回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170205,
					"content": "要記錄的是畫面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "#原來如此，也就是說，要對著{F#妳}{M#你}們擺出一個好看的動作，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170207,
					"content": "仔細想想，有點難為情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170208,
					"content": "要怎麼做才好呢？幫我出出主意吧，好看一點，但不要太誇張，我覺得我會放不開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170209,
					"content": "擺一個端莊的姿勢吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "那…就這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170215,
					"content": "就這樣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "好，那就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170219,
					"content": "我們挑一個好的角度，為她記錄吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120170216,
					"content": "或許可以再試試其他的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "#好吧，這裡就交給{F#妳}{M#你}來決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170211,
					"content": "擺一個嚴肅的姿勢吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "不太習慣，這樣可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170213,
					"content": "擺一個隨意的姿勢吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "隨意的話，這樣吧，挺自在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
