					"content": "我已經嚐過了，很符合我的預期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420602,
					"content": "記得喝的時候不要著急，如果有不適感，記得要深呼吸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420603,
					"content": "我會記錄下所有觀察到的結果與數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
