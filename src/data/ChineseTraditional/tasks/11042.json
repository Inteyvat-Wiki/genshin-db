			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "說起來，我有一個疑問，那個種子發芽以後會長出什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420102,
					"content": "不知道，但我覺得重點不在結果，而是過程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420103,
					"content": "能夠使用煉金術，在提瓦特喚醒不屬於此世的生命的話，我對生命本質的理解，應該就能更進一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420104,
					"content": "喚醒之後，就算是創造，也並非不可能的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420105,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420106,
					"content": "哈哈，對妳來說還是太難懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420107,
					"content": "不不不，我完全聽懂了，我只是更關心這個種子發芽之後會長出什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420108,
					"content": "完全沒懂嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "如果長出了非常美味的果實，我們就一起分享吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420111,
					"content": "好耶！說話要算話哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420112,
					"content": "居然輕鬆地說服了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "這是因為我…有時要幫忙照顧某個孩子。這要解釋起來比較複雜，就當是我在煉金術之外的小技能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420115,
					"content": "#說回第一項研究，是關於元素力的。這個世界的人想要使用元素力，就必須擁有神之眼，但我沒看到{F#妳}{M#你}身上有類似的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420116,
					"content": "#為什麼{F#妳}{M#你}可以自如地使用元素力，我想確認一下，所以想先問{F#妳}{M#你}幾個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420117,
					"content": "#首先，{F#妳}{M#你}有別人沒有的器官嗎？比如，第二個心臟，第四個胃之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420118,
					"content": "沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "#原來如此，那麼，飛在{F#妳}{M#你}身邊的小傢伙，和{F#妳}{M#你}的身體是連接起來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420121,
					"content": "這個問題好奇怪！從外表來看就能排除這種可能性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420122,
					"content": "還有，不是「小傢伙」，是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420123,
					"content": "我只是在考慮妳作為「外置器官」的可能性，或許連接你們的是一種不可見的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420124,
					"content": "我們是在旅行中認識的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "#哦，那就可以排除這種可能性了。那麼，會不會是派蒙將元素力導向了{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420127,
					"content": "但前提是派蒙的元素力可以擊穿十公尺厚的山岩，又或者是讓清泉鎮南邊的瀑布逆流而上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420128,
					"content": "唔，果然不可能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420129,
					"content": "我還什麼都沒說呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420130,
					"content": "#這麼說來，看來{F#妳}{M#你}的身體構造和這個世界的人類，並沒有明顯的區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420131,
					"content": "那只能用實驗的方法，研究可能存在的差異點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420132,
					"content": "首先，先看看這不明來源的元素力，究竟是如何對外流動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420133,
					"content": "#接下來我會吸引一些史萊姆過來，請用{F#妳}{M#你}最熟悉的方式擊敗它們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420134,
					"content": "原來是用這麼簡單的方式來觀察嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420135,
					"content": "好的實驗應該是直觀而清晰的，而且這只是簡單的小研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420136,
					"content": "#當然，如果{F#妳}{M#你}們覺得缺乏挑戰性的話，我們也可以去嘗試同時挑戰六個純水精靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420137,
					"content": "史萊姆！史萊姆就可以了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420138,
					"content": "不太明白，但好像很麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "那麼，準備一下吧，史萊姆要來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420139,
					"content": "我不想被幻形獸撞來撞去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "她是我從水裡釣上來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "據我所知是沒有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "居然看穿了派蒙的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "我也想知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "#辛苦了，{F#妳}{M#你}應該沒有感覺到什麼異常吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420302,
					"content": "如果受傷了的話，我這裡有些應急用的藥劑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420303,
					"content": "不用擔心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "那就好，根據我的觀察，元素力對外流動順暢，元素反應合理，沒有觀察到特別的狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420306,
					"content": "確定「對外流動」沒問題之後，我們再來測試一下「內部流動」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420307,
					"content": "「內部流動」…要怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420308,
					"content": "很簡單，我可以用煉金術製作一種萃取了元素力的藥劑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420309,
					"content": "#如果元素力是以生理的方式儲存或堆積在{F#妳}{M#你}的體內，或許會和這種藥劑產生元素反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420310,
					"content": "會在肚子裡擴散？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "聽、聽起來好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420313,
					"content": "沒事的，如果一切正常的話，只會引發短暫的不適，但對身體沒有害處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420314,
					"content": "要是不正常呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420315,
					"content": "萬一有意外發生，我也有充足的準備，不用太擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420316,
					"content": "還是很擔心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "#嗯，並非完全沒有風險。但如果{F#妳}{M#你}體內的元素流動確實存在障礙的話，也能借此檢查出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420318,
					"content": "這也是一種對健康的預警，如果內部的元素反應由其他意外引起，那才會引發真正的危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420319,
					"content": "像體檢一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "對，我覺得可以這麼理解。不過在實驗之前，檢測用的藥劑還差了一種觸媒，我們需要找一找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420321,
					"content": "是一種名叫「星銀礦」的礦石，不過不是所有這種礦石都適合做觸媒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420322,
					"content": "#我現在帶{F#妳}{M#你}去我的營地，沿路收集一些「星銀礦」吧。如果有適合做觸媒的，我會告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420323,
					"content": "如果順利的話，等我們抵達營地，就可以直接進行藥物的調製了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420324,
					"content": "聽起來雖然不太安全，但似乎是有好處的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420325,
					"content": "我們在路上的時候留意一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420311,
					"content": "會在肚子裡結晶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "只是有點冷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
