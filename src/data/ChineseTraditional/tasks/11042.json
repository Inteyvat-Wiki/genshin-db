					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#怎麼樣？{NICKNAME}，看{F#妳}{M#你}的表情有點不舒服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420702,
					"content": "像是…在燒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "你不是說你已經嚐過，可以喝嗎？為什麼會變成這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420705,
					"content": "嗯？這個是所有可能性中最正常的一種，是值得高興的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420706,
					"content": "這種藥劑，是將元素力灌入體內，正常狀態下會引起一些排斥反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420707,
					"content": "但如果內部元素流動暢通的話，只需要忍受短暫的不適，等待元素力流動完畢就好了，不會有其他影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420708,
					"content": "這麼說，你明知道喝了會很難受，你還是把它喝了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420709,
					"content": "呵呵，畢竟是我配製的藥劑，自然應該由我擔負起試藥的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420710,
					"content": "這算是…體諒研究對象嗎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "#那當然了，{F#妳}{M#你}是我的協助者，於情於理我也不能讓{F#妳}{M#你}幫我承擔風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420714,
					"content": "#總之，我說說看結論吧。在元素力的測試上，{F#妳}{M#你}和這個世界上的其他人一樣，沒有什麼特別之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420715,
					"content": "還以為會更特別一點呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420716,
					"content": "我覺得比起特別，還是平凡一點好。「特別」…其實也不盡如人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420717,
					"content": "感覺意有所指。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "#平凡的好處，在於身邊處處都是{F#妳}{M#你}的參照物，處處都是能夠理解{F#妳}{M#你}的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420719,
					"content": "因為是一樣的人，所以能夠互相理解與體諒，也能互相鼓勵與支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420720,
					"content": "#生了病，因為和其他人一樣，醫生很容易為{F#妳}{M#你}診斷病情。出了問題，因為和其他人一樣，可以和犯了同樣錯誤的人請教經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420721,
					"content": "但「特別」之人，是無法享受到這些理所當然的，因為在生命的本質上就有差距。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420722,
					"content": "#就比如…人類也無法理解爆炎樹或者狂風之核的生活吧。不知道我這樣說，{F#妳}{M#你}能聽明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420723,
					"content": "大致能夠理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "#總之，實驗結果是件好事。至少在未來，{F#妳}{M#你}可以放心地使用{F#妳}{M#你}的元素力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420726,
					"content": "蒂瑪烏斯，新的實驗結果已經出來了，麻煩你繼續整理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420727,
					"content": "來了，來了！交給我吧，老師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420728,
					"content": "在剛剛被老師提點了一番之後，我覺得我的思維受到了局限，現在我想得清楚多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420729,
					"content": "#可能把{F#妳}{M#你}定位成「動物」有點不嚴謹，但假如從論證{F#妳}{M#你}是「元素生物」的角度入手的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420730,
					"content": "也好，我認為是個有趣的方向，具體情況如何，比起我來判斷，還是由你自己來研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420731,
					"content": "嗯，放心，我會拿出讓你們都滿意的結論！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420732,
					"content": "他似乎沒有沮喪，鬥志反而更高了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420733,
					"content": "該說是他態度認真呢，還是阿貝多很會說話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420734,
					"content": "那麼，在進行接下來的研究之前，我需要準備一個小東西，稍等我一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420735,
					"content": "#如果有興趣的話，{F#妳}{M#你}們可以先參觀一下這裡，就當是打發時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420724,
					"content": "還是感覺…意有所指。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "不怕自己有危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "這或許就是學者的自信吧，節省了很多不必要的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420703,
					"content": "你居然喝得下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
