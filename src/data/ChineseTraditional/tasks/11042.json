				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "這裡就是我的營地，剛剛收集到的材料，我已經先一步用在藥劑的調製上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420502,
					"content": "在等待調製完成的這段時間，先來這邊看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420503,
					"content": "這位是我的助手，蒂瑪烏斯，正在協助我的研究。你們應該在蒙德城裡見過面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420504,
					"content": "#{F#妳}{M#你}們好，我剛剛拿到了{F#妳}{M#你}們的實驗數據，已經整理成報告貼在板子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420505,
					"content": "哇，這個，還有這個…只是和史萊姆打了一場，就有這麼多結論嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110420506,
					"content": "哈哈，說不上結論，很多都是推演，以及我的大膽猜測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420507,
					"content": "最合理的一種方向，我覺得是論證這位旅行者和史萊姆的親緣關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420508,
					"content": "這合理嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "#{F#妳}{M#你}看，{F#妳}{M#你}沒有神之眼，卻可以使用元素力，史萊姆也沒有神之眼，也可以使用元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420511,
					"content": "順著這個思路去尋找線索，肯定能得到更多事實支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420512,
					"content": "這個切入點沒有什麼問題，但是嚴格來說史萊姆是屬於元素生物，換句話說，元素即實體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420513,
					"content": "要類比的話，可能急凍樹，或者騙騙花更加合適，但要追溯動植物之間的親緣關係，恐怕要追溯到世界原初了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420514,
					"content": "從這個角度來看，是不是過於困難了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420515,
					"content": "唔，好像是這樣，老師說得沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420516,
					"content": "而且，其實數據的頂部寫了，這位旅行者是來自其他世界的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420517,
					"content": "如果和這個世界有親緣關係，反而是更加值得研究的內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420518,
					"content": "啊啊，真的！抱歉，我拿到數據太激動了！下次我一定注意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420519,
					"content": "對了，想要完成研究還需要更多數據，我暫時都會在這裡做分析，如果想瞭解實驗結果，都可以來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 110420520,
					"content": "嗯，這裡就交給你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420521,
					"content": "看起來藥劑已經完成了，我會先嚐一嚐，如果沒什麼問題的話，就拜託你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110420509,
					"content": "我覺得派蒙的親緣更近一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
