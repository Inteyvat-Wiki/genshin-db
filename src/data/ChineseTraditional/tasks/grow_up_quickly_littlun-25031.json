					"愛拉尼"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1547.319,
							56.618,
							8115.397
						],
						"pointId": 350400097
					},
					{
						"sceneId": 3,
						"position": [
							-1544.858,
							56.741,
							8114.367
						],
						"pointId": 350400098
					},
					{
						"sceneId": 3,
						"position": [
							-1546.831,
							56.704,
							8112.335
						],
						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "#謝謝{F#妳}{M#你}，謝謝{F#妳}{M#你}幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310402,
					"content": "要是早點把那個破包包包丟掉，我一個人就可以解決他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310403,
					"content": "那我們來納塔就白來了！我才不要勒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310404,
					"content": "等等，妳是…愛拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#欸？{F#妳}{M#你}…{F#妳}{M#你}是{NICKNAME}！真的是{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310406,
					"content": "旁邊這位小姐，難道是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "#娜贊，盜寶團。我們應該見過，{F#妳}{M#你}忘記了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310408,
					"content": "#呼啊…{F#妳}{M#你}真是我的大救星，救了我多少次了？一次，兩次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310409,
					"content": "不要算我那次，那次是妳自己不想走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310410,
					"content": "我才沒算那次，而且什麼叫我自己不想走，我都付過妳錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310411,
					"content": "妳那麼一點錢，隨便吃吃喝喝就花光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310412,
					"content": "妳不會又是為了論文來的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "嘿嘿…我都努力那麼久了，總不能白費吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310414,
					"content": "這次我可是從教令院裡申請了專門的經費，課題也確認好了，沒有人和我撞到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310415,
					"content": "而且我還有娜贊當護衛，壞蛋全都被她打跑啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310416,
					"content": "是因為我們沒油水可撈，他們也不願意惹麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310417,
					"content": "那妳們剛才…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "…這傢伙把自己裝文獻的包包抱得死死的，從「回聲之子」那邊一直走到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310420,
					"content": "說實話，就算是以我的眼光來看，她也像是一個懷裡抱著寶貝的笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310421,
					"content": "一個抱著寶貝的人走在這種前後都沒人的荒郊野外，旁邊只有一個護衛…無論是誰都會想要搏一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310422,
					"content": "沒錯！我的包包裡就是寶貝。這些都是我的實地採訪紀錄，還有各類文獻的謄本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310423,
					"content": "有了這些東西，我那篇論文一定寫得出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310424,
					"content": "哼，這篇論文的主題可是「歸火聖夜巡禮」，絕對的重量級，絕對可以讓我畢業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310425,
					"content": "唉呀，也多虧了塔莫蕾出的主意。真不愧是我的好朋友，嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310426,
					"content": "#再次謝謝{F#妳}{M#你}了，{NICKNAME}，要是沒有{F#妳}{M#你}，那些壞蛋不僅會弄壞我的書，還會搶走我的錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310427,
					"content": "前段時間我幫人家整理書籍和資料，好不容易才掙了一些錢，被搶走的話就沒錢買新的資料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310428,
					"content": "嗯，但妳最終還是會把所有錢都用來買書，如果不是我把妳的錢包拿走，我們就要餓肚子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 250310429,
					"content": "也、也沒有買那麼多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310430,
					"content": "唉呀，先不聊了。我們還要去「流泉之眾」那邊取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310431,
					"content": "#那就再見啦！等下次見面的時候我一定已經寫完論文了！到時候我一定請{F#妳}{M#你}吃一頓好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 250310418,
					"content": "結果還是惹上麻煩了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
