					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "糟糕了…這下糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310102,
					"content": "阿蕾梅的訓練出問題了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}！{F#妳}{M#你}來得正好，謝天謝地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310104,
					"content": "#沒時間解釋了，請{F#妳}{M#你}快幫我去救救人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310105,
					"content": "是妳的朋友？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "算…算是吧…我們兩個都因為論文崩潰過好幾輪，還在圖書館裡抱頭痛哭過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310108,
					"content": "啊啊啊——現在不是說這些的時候！那傢伙根本不聽我的勸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310109,
					"content": "說什麼為了論文在所不惜，然後帶著她的那個護衛整天在野外亂逛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310110,
					"content": "結果她到現在都沒有回來！部族這邊也抽不出人手去救人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}，請{F#妳}{M#你}快去救救她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310112,
					"content": "交給我吧，這個我很熟練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#這件事只能拜託{F#妳}{M#你}了！全都靠{F#妳}{M#你}了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310113,
					"content": "你們教令院的人真的是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "那傢伙…唉…只能說她的運氣真是差到底了。這次來納塔，她還說什麼要為論文做最後一搏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "塔莫蕾"
				},
				{
					"id": 250310106,
					"content": "是妳的熟人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
		{
