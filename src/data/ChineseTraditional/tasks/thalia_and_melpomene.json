			"dialogs": [
				{
					"id": 740760501,
					"content": "前方就是「人格」之塊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760502,
					"content": "無法從密度分析眼前的物質。似乎重量為…零。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740760503,
					"content": "看來我們拿下了最後一分。這樣至少就可以和對面斡旋一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760504,
					"content": "往好處想的話，至少我們就可以阻止水仙十字結社最後鍛造出聖劍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760505,
					"content": "並不是，派蒙。我們的最終目的是鑄造出聖劍，並且用聖劍去阻止他們的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760506,
					"content": "當然，安，我並沒有忘記這柄劍對於妳的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760507,
					"content": "能夠切割意志的聖劍，對於妳來說是解開謎題的鑰匙。其實它對我來說也一樣重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "卡特皮拉"
				},
