			"dialogs": [
				{
					"id": 740760101,
					"content": "最後只剩下這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760102,
					"content": "好在入口還是封住的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760103,
					"content": "看來那個雅各布並沒有解出這裡的謎題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760104,
					"content": "或者他解出來了，卻無法奉上謎底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760105,
					"content": "我想想，之前的答案分別是「影子」、「生命」和「愛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760106,
					"content": "然後根據之前的規律，我的邏輯模組推測碑文如下：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740760107,
					"content": "「從不分離」…「生於一瞬，常與相違，伴你長眠」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740760108,
					"content": "然後最後一句寫的是——「原初一滴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760109,
					"content": "卡特皮拉、西摩爾，你們知不知道這個答案的謎底啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
