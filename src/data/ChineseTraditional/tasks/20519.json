						"stepId": 2051904,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051903",
							"2"
						],
						"stepId": 2051903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "#{F#妳}{M#你}回來了，哎呀，效率可真高，我也算是知道為什麼那位先生這麼喜歡{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190202,
					"content": "報酬拿來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "#冷冰冰的…好啦，我這就把報酬給{F#妳}{M#你}。{F#妳}{M#你}就理解我一下嘛，我也只是個跑腿的人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190204,
					"content": "那真是謝謝厚愛了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "不客氣，不客氣，這些報酬請拿好，還有…合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051902",
							"2"
						],
						"stepId": 2051902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "…盜寶團…哦！不好意思，您有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190302,
					"content": "有盜寶團在蒙德城周圍活動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "盜寶團？我們正準備去追蹤一支盜寶團。那群傢伙居然敢靠近蒙德城，也不知道想要做什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190304,
					"content": "不過，無論原因是什麼，他們肯定沒打什麼好主意。這次我們投入了很多人手來對付他們…恐怕暫時沒辦法顧及您的報告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190305,
					"content": "但您的報告我已經記下了，等我們處理完那批盜寶團之後，我就會如實向上彙報的。再次感謝您的報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051902",
							"2"
						],
						"stepId": 2051902,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051903",
							"2"
						],
						"stepId": 2051903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "#{F#妳}{M#你}還在做準備嗎？嗯，做好準備再出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190402,
					"content": "那位先生到底是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "#無論{F#妳}{M#你}怎麼追問，我都不會告訴{F#妳}{M#你}的啦，這可是幹我們這行的基本素質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190404,
					"content": "即便是透露…那些所透露的消息，也是因為「需要被透露」而被透露的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190405,
					"content": "#啊，對了，{F#妳}{M#你}可以再想一想，我以上所說的話，又有哪些是屬於「需要被透露」的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190406,
					"content": "你們到底是什麼目的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "目的…那位先生的目的，我可猜不到。不過，想必他也是為了保護這座蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190408,
					"content": "唔…應該是，在這種大事上，他應該也不會再遵從著他的「趣味」而行動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205190409,
					"content": "哦呀，不好不好，這種事情可不是我應該揣測的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				}
			]
		},
