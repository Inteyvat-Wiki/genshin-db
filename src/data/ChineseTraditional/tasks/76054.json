				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "咦？哥倫比婭呢？怎麼沒見到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540102,
					"content": "我在這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540103,
					"content": "哇！妳在這麼高的地方做什麼啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540104,
					"content": "上來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540105,
					"content": "嗯？這次又是要幹什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540106,
					"content": "還記得我們上次出去收集的石頭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540107,
					"content": "上次？哦，是說吸收了月矩力後會發光的那種礦石對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540108,
					"content": "對。那之後月靈們又收集了一些，我將這些石頭處理了一下，大致分為了深色和淺色的兩類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540109,
					"content": "深色和淺色？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540110,
					"content": "當然是用來玩「月亮棋」呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540111,
					"content": "欸？什…什麼是「月亮棋」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540112,
					"content": "#{F#妳}{M#你}們沒玩過嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540113,
					"content": "沒有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "這樣嗎…以前看「霜月之子」的孩子們在地上畫格子的時候，我就想試試了。但沒人能陪我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540115,
					"content": "具體規則是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540116,
					"content": "唔…這樣說明容易一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540117,
					"content": "哦！好…好厲害…妳怎麼做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540118,
					"content": "#嗯？就很簡單地運用月矩力而已，{F#妳}{M#你}們做不到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540119,
					"content": "不要以神明的標準來要求我們啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540120,
					"content": "好吧。這就是棋盤，或者說是遊戲中的「夜空」。然後兩個人手中的棋子代表了你所擁有的「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540121,
					"content": "兩人交替將「月亮」放到「夜空」上，誰的三個月亮最先連成一條線，誰就獲勝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540122,
					"content": "哦！總之就是三顆棋子連成一條線的遊戲對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540123,
					"content": "這遊戲在挪德卡萊居然叫「月亮棋」…還真是有在地特色呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540124,
					"content": "不過，「月亮」是會輪替的，天空中無法存在三個以上的「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540125,
					"content": "所以當「夜空」中的「月亮」達到一定數量之後，最開始升上的「月亮」就會消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540126,
					"content": "還…還滿有道理…也為這遊戲加了不少難度呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540127,
					"content": "嗯，要試一試嗎？我也是第一次玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540128,
					"content": "（她看起來很期待的樣子呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#嘿嘿，那我來當{F#妳}{M#你}們的裁判吧。這傢伙腦子不錯，妳可要小心喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540130,
					"content": "好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
