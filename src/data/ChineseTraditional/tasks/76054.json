			"dialogs": [
				{
					"id": 760540301,
					"content": "這樣對嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540302,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540303,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540304,
					"content": "月亮…月亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "這裡怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "這次是我贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "我的三個月亮連起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "嗯，這樣就贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "嗯…月升月落，真是漫長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "我們的月亮誰都不讓誰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "是不是…快平手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "#原來{F#妳}{M#你}喜歡深思熟慮後再做決定，嗯，沒事，我們有很多時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "#忘了怎麼將「月亮」放上「夜空」嗎？要不要我幫{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "不喜歡這個遊戲嗎？我覺得還滿有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "#嗯？{F#妳}{M#你}是在盯著我看嗎？我感覺得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "我的臉上…有關於「月亮」的答案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "棋盤在那邊哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "#嗯，是{F#妳}{M#你}的「月亮」獲勝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "#這片夜空屬於{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "啊…一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "與哥倫比婭在遊戲中度過了一段愉快的時光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "#謝謝{F#妳}{M#你}，我玩得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540323,
					"content": "如果可以的話，下次也來陪我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540324,
					"content": "把這個，當做「約定」的證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		}
	]
}