			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "哎喲…還是得想個辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "是您啊，唉…別提了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310104,
					"content": "最近客棧的生意越來越好，來店裡住的人也越來越多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310105,
					"content": "有的一個人過來找清淨，有的拖家帶口過來旅遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310106,
					"content": "唉，雖然客棧生意好我很高興，但這周圍有很多魔物徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310107,
					"content": "如果有哪個小朋友跑出去玩，或者是哪位老人出去散步的時候遇見那群魔物的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310108,
					"content": "為了防止這種事發生，我得出去驅趕一下客棧周圍的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310109,
					"content": "但我一個人，也驅趕不了多少魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310110,
					"content": "#旅行者，{F#妳}{M#你}能幫我一把嗎？報酬肯定不會少{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310111,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "那就拜託您了。我之前就注意到了幾處魔物的營地，裡面有不少危險的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310116,
					"content": "而且，還有另外一群魔物偷偷摸到了客棧附近，還紮起了營…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310117,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310118,
					"content": "這樣吧，那些危險的魔物就交給我了，您幫我處理一下那些客棧周圍的魔物就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310119,
					"content": "把那些魔物趕走之後，我們再來客棧裡碰頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310120,
					"content": "這些魔物，真是夠煩人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310112,
					"content": "你的身手應該不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "我？這個…您謬讚，算是過得去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310114,
					"content": "但是就憑我一個人，也不可能把那些魔物全部都打倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "淮安"
				}
			]
		},
		{
