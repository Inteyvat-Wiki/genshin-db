			"dialogs": [
				{
					"id": 210310401,
					"content": "#{F#妳}{M#你}們回來了，哎喲…那些魔物真是難對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310402,
					"content": "你把那些魔物都打倒了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "哈哈哈，是的，頗費了一番功夫，年紀大了終歸是有些力不從心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310404,
					"content": "您應該也已經把那些魔物都解決掉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310405,
					"content": "關於魔物營地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "魔物全都被打倒了…但是營地裡卻沒有人影？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310407,
					"content": "這倒是怪了，難道是哪位路過的冒險家，順手打倒了那些魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310408,
					"content": "總之，還是謝謝您幫我去周圍巡查，這些報酬請您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
