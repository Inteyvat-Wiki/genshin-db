						210310203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210310203,
					"content": "不過，既然這些魔物已經被打倒了，現在回去告訴淮安這個消息也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
