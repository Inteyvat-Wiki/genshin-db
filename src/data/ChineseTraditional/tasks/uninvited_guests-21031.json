						210310302,
						210310303
					],
					"speakerTitle": "魈"
				},
				{
					"id": 210310302,
					"content": "你怎麼在這？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "路遇魔物，便隨手處理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "魈"
				},
				{
					"id": 210310305,
					"content": "#這一帶不太安寧，{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "魈"
				},
				{
					"id": 210310306,
					"content": "我會多加小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "好。我另有要事，先行一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 210310303,
					"content": "那些魔物是你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				}
			]
		},
