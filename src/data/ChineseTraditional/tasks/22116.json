			"dialogs": [
				{
					"id": 221161101,
					"content": "汐哥哥，你…你回來了，我剛學會了一道菜，回去做給你吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161102,
					"content": "思妹妹，我剛回來，已經身心俱疲了，只想好好休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161103,
					"content": "對，是啊，你這麼辛苦，是應該休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161104,
					"content": "那…等你休息好了，我們再好好聊聊？也該定個日子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "思思"
				},
				{
					"id": 221161105,
					"content": "嗯，嗯，我記得的，但我暫時還沒有想好。並不是我不想負責，而是我不想辜負妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161106,
					"content": "唉，與大海為伍是水手的宿命，思妹妹，妳值得更好的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 221161107,
					"content": "汐哥哥，你別這麼說，我知道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思思"
				}
			]
		},
