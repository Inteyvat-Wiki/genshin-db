			"dialogs": [
				{
					"id": 221160201,
					"content": "心眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}別和我開玩笑啊，我認真的，{F#妳}{M#你}好好想想，認真想！",
					"roleType": "TALK_ROLE_NPC",
