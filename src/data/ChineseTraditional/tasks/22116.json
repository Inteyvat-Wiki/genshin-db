			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "到底怎麼開頭好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160102,
					"content": "你又在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "#哦，是{F#妳}{M#你}啊。我準備新寫一本小說，但無論怎麼開頭，都覺得缺了點什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160104,
					"content": "我想了很久，還是一點頭緒都沒有，這麼下去什麼時候才能開始寫啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160105,
					"content": "#對了，我知道{F#妳}{M#你}是見多識廣了。{F#妳}{M#你}覺得，一本成功的小說最需要的是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "常九爺"
				}
			]
		},
