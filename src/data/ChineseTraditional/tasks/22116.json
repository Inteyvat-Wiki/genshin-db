			"dialogs": [
				{
					"id": 221161201,
					"content": "璐璐，這次真的應該歸阿飛做船長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161202,
					"content": "對呀，都說了多少次了，老是我來做服務生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 221161203,
					"content": "可是我覺得小蒙扮船長的時候，我們玩得最開心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161204,
					"content": "璐璐，妳不能這麼說，阿飛也演得不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161205,
					"content": "對呀，沒錯，你扮船長的時候，我扮富商，阿飛扮服務生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161206,
					"content": "這個時候，我們玩得是最開心的呀，對吧阿飛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161207,
					"content": "璐璐，妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161208,
					"content": "璐璐都這麼說了，那…那也行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 221161209,
					"content": "阿飛，你這又是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161210,
					"content": "沒事啦！沒事了，璐璐開心就好了，我們繼續來玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 221161211,
					"content": "不就是個船長嗎，我才不稀罕呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 221161212,
					"content": "…你們，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				}
			]
		},
