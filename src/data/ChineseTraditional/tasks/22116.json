				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "我上次去城裡的時候，碰巧看見了一個人和一個似乎是在占卜的姑娘囉嗦個不停，但我那時候沒有詳細聽下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160702,
					"content": "#後來我打聽到，這兩個人一個叫志華，一個叫綺命，{F#妳}{M#你}去幫我再打聽打聽，如果有什麼好故事，就快點拿回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "#這麼一說，{F#妳}{M#你}見過一個叫思思的姑娘嗎？她似乎一直在等著一個叫做潮汐的水手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160802,
					"content": "在我印象中，她好像隔段時間就要去等一次…這思思和潮汐之間，到底有什麼故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
