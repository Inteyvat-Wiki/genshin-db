				{
					"id": 221161301,
					"content": "#怎麼樣，{F#妳}{M#你}有什麼收穫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161302
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221161302,
					"content": "記下來了這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "還真有收穫，給我看看…志華和綺命，果然沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221161304,
					"content": "嗯…不錯，不錯啊，這個不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221161305,
					"content": "哪裡不錯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}沒看出來？沒感覺到嗎？{F#妳}{M#你}仔細看，這股隱隱約約，不足為外人道的微妙默契感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221161307,
					"content": "這個不錯，我覺得我抓到點思路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221161308,
					"content": "#對了，這是給{F#妳}{M#你}的謝禮，收下吧，我得好好想一想怎麼動筆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
