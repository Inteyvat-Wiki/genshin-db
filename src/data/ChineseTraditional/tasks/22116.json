			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "富有張力的熱血戰鬥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "熱血戰鬥…熱血戰鬥，嗯…有點道理，這東西最能吸引眼球了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160303,
					"content": "不過，別說「富有張力的熱血戰鬥」了，這輕策莊裡連「戰鬥」都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160304,
					"content": "看來我得出去取點材。對了！我聽說…在野外有很多冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160305,
					"content": "為了尋寶，他們會到處跑，還經常和野外的那些怪物打起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160306,
					"content": "我剛好知道一個地方有很多怪物，而且那地方看起來嘛…也像模像樣的，咱們就去那裡等著！等著那些冒險家過來，和那些怪物好好打上一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160307,
					"content": "#然後嘛，嘿嘿，這材料不就到手了。好了，那地方還有點遠…我先過去了啊，{F#妳}{M#你}趕緊過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "嘿…這回，哎喲，這回我算是親身體驗了一場「富有張力的熱血戰鬥」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160502,
					"content": "你不只是想旁觀戰鬥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "那是啊，我開始是這麼想，但是誰叫冒險家遲遲就不出現呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160504,
					"content": "那些怪物慢慢悠悠，眼看著就要離開了，要是它們真走了，我不就白等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160505,
					"content": "然後我就…丟了塊小石頭過去，小說裡不都這麼寫，丟塊石頭吸引住注意力什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160506,
					"content": "誰，誰知道，我把石頭給直接丟到那怪物頭頂上去了，然後…就這樣了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160507,
					"content": "哎呀，得了得了，雖然是吃了點皮肉苦，但是這材還是取到了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160508,
					"content": "#我現在是才思泉湧！對了，這是給{F#妳}{M#你}的，多虧了{F#妳}{M#你}幫我，這些就算是謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221160509,
					"content": "我感覺，一回去我就能馬上動筆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
