			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"商人信眾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "有「星辰天君」在，千岩軍都可以下崗了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "商人信眾"
				},
				{
					"id": 111000602,
					"content": "關於「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "我是個商人，上一批貨物實在太值錢了，便冒昧拜託「星辰天君」同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "商人信眾"
				},
				{
					"id": 111000604,
					"content": "只見天君祭出符咒，魔物全都退避三舍，一路上連個影都沒見到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "商人信眾"
				},
				{
					"id": 111000605,
					"content": "雖說費用方面確實貴了點…但畢竟「請仙」是件大事嘛，也不知道你們外國人能不能負擔得起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "商人信眾"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"掇星攫辰天君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "如何？信眾們可能有些言過其實，但都是肺腑之言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000802,
					"content": "感覺都是心理作用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "哈哈哈…閣下說笑了。有位仙家高人，薛無量，人稱「量子」，他曾經說過——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000804,
					"content": "「萬物本是糾纏在一起，『心理作用』亦是一種『魂魄』與『事物結局』相連接的因緣…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000805,
					"content": "也就是說他們的願望都已經走上了通往實現的正軌，這樣講明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000806,
					"content": "完全聽不明白…但總之他們的願望都能實現是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000807,
					"content": "沒錯，這位小友悟性很高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000808,
					"content": "說起來…還有一個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000809,
					"content": "嗯？但說無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000810,
					"content": "你為什麼戴著面具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "本仙…遊歷民間，濟世行善。不露真容，只為少生事端而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000815,
					"content": "原來如此，原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000816,
					"content": "那麼二位的願望是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000817,
					"content": "想獲知親人的行蹤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "嗯…這背後一定有段悲傷的往事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000824,
					"content": "…好吧，想要實現這個願望也不是不可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000825,
					"content": "只是…還差了那麼點意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000826,
					"content": "差了點…意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000827,
					"content": "仙道但憑「悟性」，若二位參不透我話中之意，那就恕本仙難以相助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000828,
					"content": "怎麼辦，我還是不明白他說的意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000829,
					"content": "看來是需要給一些好處…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "哦！剛才那些信眾們好像也提起過，請仙人幫忙要付出不小的代價…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000832,
					"content": "可我們兩個身上，也沒什麼值錢的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000833,
					"content": "#甚至，{F#妳}{M#你}連「神之眼」都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000834,
					"content": "應該不會有人把神之眼賣掉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "欸！不如我們做些好吃的給他？沒人能抵擋美食的誘惑吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000837,
					"content": "在派蒙的價值觀裡確實是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "嗯，好吃的！這個辦法肯定能成功的，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000840,
					"content": "不如我們趕快出發，去「萬文集舍」看看有沒有什麼最新最好的流行食譜吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000838,
					"content": "好吃的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "是啊，真可惜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "看來是要給他摩拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "想得到匹敵神明的力量。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "#擁有力量，很多問題便能迎刃而解。不過我倒是很好奇，{F#妳}{M#你}難道與神明有什麼過節？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000821,
					"content": "想要一夜暴富！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#欸欸！{F#妳}{M#你}不管{F#妳}{M#你}的{F#哥哥}{M#妹妹}了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000823,
					"content": "#嗯，人之常情。{F#妳}{M#你}看上去並非璃月人，卻好像沾染了不少璃月的銅臭氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000811,
					"content": "可以把面具摘下來看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "喂！是不是太不禮貌啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000813,
					"content": "呵呵，確實有所不便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "掇星攫辰天君"
				}
			]
		},
