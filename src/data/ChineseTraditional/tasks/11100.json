			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"女性信眾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "總覺得現在每天過得充滿了希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "女性信眾"
				},
				{
					"id": 111000502,
					"content": "關於「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "你們也是「星辰天君」的「信眾」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "女性信眾"
				},
				{
					"id": 111000504,
					"content": "自從我的未婚夫不告而別，我每天以淚洗面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "女性信眾"
				},
				{
					"id": 111000505,
					"content": "後來嘗試了「星辰天君」的仙法——把他的畫像燒掉，再把灰燼在日出時刻吹向大海…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "女性信眾"
				},
				{
					"id": 111000506,
					"content": "冥冥之中，我真的感覺到他要回來了，是真的！絕對不是什麼心理作用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "女性信眾"
				},
				{
					"id": 111000507,
					"content": "於是我開開心心地把嫁妝獻給了「星辰天君」。畢竟若不是他幫我找回夫君，這嫁妝可能一輩子也用不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "女性信眾"
				}
			]
		},
		{
			"id": 1110006,
