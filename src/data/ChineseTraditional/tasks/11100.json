			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#是我的幻覺嗎，{NICKNAME}…那些丘丘人是不是看起來有些古怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000102,
					"content": "身體上散發著…邪氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "是呀，以前見過的丘丘人，雖然是魔物，但從來沒有這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000106,
					"content": "啊！「望舒客棧」就在附近，會威脅到來往的客人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000107,
					"content": "#見到了又不管的話，總覺得會良心不安…試試看對付它們吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000104,
					"content": "有些躁動的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "是呀，難道和它們身上那種奇怪的黑氣有關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "這些滿身邪氣的傢伙，確實比一般的丘丘人要難對付一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000302,
					"content": "#咦，{F#妳}{M#你}看那邊，聚集了一些人的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000303,
					"content": "#嗚哇…{F#妳}{M#你}看到那個戴著面具的人了嗎？他那邊的丘丘人都害怕得跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000304,
					"content": "莫非他是「仙人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "#{F#妳}{M#你}是說像魈那樣的仙人嗎？這麼說確實…魈也戴過差不多的面具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000307,
					"content": "看他剛才「作法」，好像比魈更有仙人的樣子呢。不如去跟他聊聊吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000305,
					"content": "看起來像是「仙家法術」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
