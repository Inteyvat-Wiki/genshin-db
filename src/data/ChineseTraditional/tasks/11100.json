			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"男性信眾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "看到「星辰天君」作法了嗎？真是神通廣大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000402,
					"content": "家父的病想必也有指望了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000403,
					"content": "關於「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "見到那樣的法術還有什麼好懷疑的，當然是真真正正的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000405,
					"content": "我之前替臥床的老父求了個藥方，跟「不卜廬」的方子天差地別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000406,
					"content": "藥熬出來還飄著一股淡淡的霧氣，仙得很！雖然也可能是加了冰霧花的緣故…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000407,
					"content": "仙家藥方實在了得，家父的病一定會好起來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "男性信眾"
				},
				{
					"id": 111000408,
					"content": "至於那些獻給「星辰天君」作為貢品的古董，跟家父的性命比起來根本不值一提…對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "男性信眾"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
