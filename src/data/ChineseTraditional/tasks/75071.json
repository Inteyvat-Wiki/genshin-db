				]
			},
			"dialogs": [
				{
					"id": 750711101,
					"content": "#{F#妳}{M#你}發現了嗎？小傢伙好像注意到了什麼東西…是牠的家人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711102,
					"content": "牠自己往那邊去了！我們也跟上吧，千萬不要讓牠走丟了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				}
			]
		},
