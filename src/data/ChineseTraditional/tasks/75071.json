			"dialogs": [
				{
					"id": 750711001,
					"content": "#哈哈，親愛的{NICKNAME}和派蒙，我的繆斯和…呃，小繆斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711002,
					"content": "#啊，還有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711003,
					"content": "哪個才是小的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711004,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "哈哈，請不要在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711006,
					"content": "哼，我很在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711007,
					"content": "又有什麼新靈感了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "當然，不過…呃，嘿嘿，新的靈感就意味著…我又要找你們求助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711009,
					"content": "沒問題啦！反正你每次都會給錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711010,
					"content": "哈哈，好啊，我的小小傭兵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711017,
					"content": "#{F#妳}{M#你}看，我這次打算拍攝的是嵴鋒龍…噓，我們小心一點，不要吵到牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711018,
					"content": "我還是第一次接觸這種龍類，但我已經觀察牠們一段時間了…真是迷人的動物…在堅硬的甲殼下面，牠們也有自己的個性呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711019,
					"content": "嘿嘿，餵過牠幾次之後，牠現在已經聽得懂基本指令了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711020,
					"content": "不過我需要馴龍大師做的事呢，就是和那頭離群的嵴鋒龍互動，讓我拍一張牠與其他同類在一起的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711021,
					"content": "嘿嘿，很簡單，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711022,
					"content": "嗯，太簡單啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711023,
					"content": "（反正不是你在忙…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "哈哈，就是這個氣勢！來吧，幫我把那頭離群的嵴鋒龍帶來，然後我們就可以開始啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711024,
					"content": "（也沒那麼簡單啦…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "又需要你的慕斯們幫忙了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "慕斯…我也想吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711013,
					"content": "咕嚕…咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "呃…是「繆斯」…不是吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750711015,
					"content": "嘿嘿，只要你給錢，我們就可以換成吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711016,
					"content": "隨便妳怎麼說啦…不過我的確有錢，兩位不用擔心做白工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "馬尼菲科"
				}
			]
		},
