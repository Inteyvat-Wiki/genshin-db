			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉齊",
					"丹吉爾",
					"柯萊",
					"馬姆杜",
					"法伊茲",
					"卡西特",
					"阿利婭",
					"魯希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "犯了錯的蘭那羅父親，主動承認錯誤，獲得了蘭那羅兒子的原諒嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "拉齊"
				},
				{
					"id": 735010202,
					"content": "嗯，我覺得小朋友們會喜歡這個故事的，但是這個蘭那羅父親主動認錯的原因，好像還是太簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "拉齊"
				},
				{
					"id": 735010203,
					"content": "要不要在故事裡讓蘭那羅父子一起面對什麼困境？這樣他們會互相體諒，蘭那羅父親看著兒子努力的樣子，也會心生愧疚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "丹吉爾"
				},
				{
					"id": 735010204,
					"content": "那麼，蘭那羅父親在心生愧疚的時候，說話是快一點好還是慢一點好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "拉齊"
				},
				{
					"id": 735010205,
					"content": "這個其實就要取決於蘭那羅兒子了，讓他們說話速度不一樣會更有趣一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "丹吉爾"
				},
				{
					"id": 735010206,
					"content": "丹吉爾先生，拉齊，你們好！你們在幹什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010207,
					"content": "嗯，我在和爸爸討論新童話的內容，這一次，就會由我自己來向大家講述童話啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "拉齊"
				},
				{
					"id": 735010208,
					"content": "不過一想到要在很多人面前講自己的故事，我還是有點緊張，所以想要知道有哪些需要注意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "拉齊"
				},
				{
					"id": 735010209,
					"content": "噢！須彌要多一位年紀不大的童話作者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010210,
					"content": "#謝謝你們，如果不是{F#妳}{M#你}們及時出現，拉齊恐怕真的會離我而去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "丹吉爾"
				},
				{
					"id": 735010211,
					"content": "真不錯，看起來一切都解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010212,
					"content": "不過，我突然想起來，有一件事還是很可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010213,
					"content": "嗯？什麼事？需要我幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010214,
					"content": "為什麼道成林的那個樹洞裡，會有蒙德人留下的紙條呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010215,
					"content": "為…為什麼到現在還想著這件事，我覺得單純就是巧合啦，巧合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010216,
					"content": "把秘密寫到紙條上再貼到樹洞裡也是很常見的習慣啦。我覺得這件事沒什麼好在意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010217,
					"content": "柯萊突然好激動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "嗚…嗚嗚嗚…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010220,
					"content": "其實，我也有秘密，一些煩惱。我也有向著樹洞說出秘密的習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010221,
					"content": "不過，看到現在的拉齊和丹吉爾先生，我有了一個想法：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}，{F#妳}{M#你}可以成為我的樹洞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010223,
					"content": "樂意之至。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "真的很常見嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
