			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡西特",
					"阿利婭",
					"馬姆杜",
					"法伊茲",
					"魯希",
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "唔…怎麼今天買到的還是這一種，我明明想要那個最圓嘟嘟，看起來最彈彈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010102,
					"content": "算了，再存一點零用錢吧，我一定要收集齊全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010103,
					"content": "欸…我記得你最近每天都有來買吧？還沒有收集齊全？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "阿利婭"
				},
				{
					"id": 735010104,
					"content": "不如買那個蘭那羅木刻套裝，一套裡面有七個不重複的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "阿利婭"
				},
				{
					"id": 735010105,
					"content": "那就沒有驚喜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010106,
					"content": "我不想要驚喜，就只想每一種都要有，這才是用心的表現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "阿利婭"
				},
				{
					"id": 735010107,
					"content": "今天我就是存夠了錢，特意來買木刻套裝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "阿利婭"
				},
				{
					"id": 735010108,
					"content": "啊，非常抱歉，剛剛賣給凱西特小朋友的是最後一件，今天本店的貨物已經賣完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "馬姆杜"
				},
				{
					"id": 735010128,
					"content": "我們正在招募新的雕刻師，還請明天再次光臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "馬姆杜"
				},
				{
					"id": 735010109,
					"content": "好吧…那我明天再來。等等，你怎麼能稱呼蘭那羅木刻叫做貨物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "阿利婭"
				},
				{
					"id": 735010110,
					"content": "就是就是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010111,
					"content": "好好好，我錯了，我錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "馬姆杜"
				},
				{
					"id": 735010112,
					"content": "抱歉，今天本店的蘭那羅木刻已經全都賣完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010113,
					"content": "賣完了？這該怎麼辦…我還打算多買幾個，送給明天來玩的表弟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "魯希"
				},
				{
					"id": 735010114,
					"content": "那這樣吧，小朋友，我記得你家是住在拉齊家附近吧？明天一早我們就把新雕好的木刻送到你家裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010115,
					"content": "謝謝你，法伊茲叔叔！千萬不要忘了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "魯希"
				},
				{
					"id": 735010116,
					"content": "不會的，我們阿折羅造像，從不辜負小朋友們的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010117,
					"content": "啊，又有新的客人來了。抱歉，今天本店的蘭那羅木刻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010118,
					"content": "#原來是{F#妳}{M#你}們，謝謝{F#妳}{M#你}們的幫助。本來我們還想專程道謝，但是如{F#妳}{M#你}們所見，最近實在是太忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010119,
					"content": "#沒有{F#妳}{M#你}們，阿折羅造像的二十週年慶可能就是另外一副樣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010120,
					"content": "看起來生意非常好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "蘭那羅真的很受歡迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "這些都是託拉齊的福，沒想到小小年紀就能有那麼多奇思妙想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010123,
					"content": "#哦對了，為了表示感謝，本店還打算把「試作蘭那羅」贈送給{F#妳}{M#你}們，當做紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "法伊茲"
				},
				{
					"id": 735010124,
					"content": "哇這是什麼…讓人覺得很…很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010125,
					"content": "震撼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "對對對，震撼，看起來很神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 735010127,
					"content": "唔，到底要不要接收這份禮物，請等我們再仔細考慮考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010129,
					"content": "阿折羅造像的危機已經解決。接下來的拜訪對象是拉齊與丹吉爾。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
