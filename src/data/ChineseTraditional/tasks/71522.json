			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"比勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "這種遊戲還真是太具有靈感了，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220102,
					"content": "有什麼新遊戲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "旅行者！您來得正好，我正好在找人來試玩我製作的這種遊戲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220104,
					"content": "請看，我把這種遊戲命名為「靈感噴激」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220105,
					"content": "它完美地復原了我們詩人創作詩歌時的過程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220106,
					"content": "你是說喝酒、喝酒和喝酒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "願聞其詳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "哈哈哈！您真幽默，用酒來刺激靈感的確是個好主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220108,
					"content": "但要是想創作出真正出色的詩歌，光喝酒可不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220110,
					"content": "在一次詩歌創作中，一開始我們得四處尋找靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220111,
					"content": "有些人喜歡到處旅行、有些人喜歡獨自沉思，還有些人嘛…格外喜歡用酒來刺激自己的思維。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220112,
					"content": "這是最艱難的階段，因為在尋找靈感的過程中，我們幾乎感受不到靈感究竟在何處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220113,
					"content": "在大部分時間裡，我們會覺得一無所獲，變得煩躁又憂鬱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220114,
					"content": "但實際上，在我們不自覺的情況下，靈感其實已經悄悄在我們的頭腦中累積。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220115,
					"content": "當某個契機到來，這些靈感就會一口氣噴發而出，形成一首優秀的詩歌…或者是一幅畫，或者其他什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220116,
					"content": "這也能做成遊戲嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "哈哈哈！當然！這詩歌的創作過程清晰明確，十分容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220118,
					"content": "恰好蒙德城裡有好幾位擅長製作桌遊的先生，他們對我的想法十分感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220119,
					"content": "我們進行了幾次充分的討論，在集思廣益下，這個名為「靈感噴激」的遊戲就完美出爐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220120,
					"content": "您要是感興趣的話，現在就可以試玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "比勒"
				},
				{
					"id": 715220121,
					"content": "要是多玩幾局，說不定您也能學會創作詩歌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "比勒"
				}
			]
		}
	]
}