			"dialogs": [
				{
					"id": 761820101,
					"content": "這就是妳曾經生活的地方嗎？真漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820102,
					"content": "以前更漂亮。我打理花園可是很有一手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820103,
					"content": "哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820104,
					"content": "妳又傻笑什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820105,
					"content": "想像了一下那時的桑多涅蹲在花叢邊的樣子，覺得很可愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820106,
					"content": "我等下可以進屋看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820107,
					"content": "當然，我已經把灰塵都清理過一遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820108,
					"content": "妳今後打算怎麼處理這個家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820109,
					"content": "嗯…果然還是想留下它。有時間就回來打理一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820110,
					"content": "沒時間的話，我也可以來幫妳打理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820111,
					"content": "這裡和曾經妳房間給我的感覺一樣，令人安心。我很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820112,
					"content": "哼…隨妳便吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
