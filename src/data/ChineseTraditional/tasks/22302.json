			"dialogs": [
				{
					"id": 223020301,
					"content": "少爺到底去哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020302,
					"content": "關於常九爺的書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "啊？他…他還在寫嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020304,
					"content": "哦對，他上次說，又寫了本小說去稻妻城參賽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020305,
					"content": "這次又是講什麼的？上次他寫了本關於七星的書，一個勁要我們幫他出版。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020306,
					"content": "這書沒出版，還差點把千岩軍給招來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020307,
					"content": "不過，這次既然是去稻妻城參賽，想來也追不到我們頭上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020308,
					"content": "#{F#妳}{M#你}把書給我吧，我讓商會裡走船的人順路帶過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020309,
					"content": "不過，常九爺這次大概也沒戲。我聽人說，稻妻城那邊正流行一本叫《沉秋拾劍錄》的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020310,
					"content": "也是我們璃月人寫的，就是不知道具體是誰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020311,
					"content": "#對了，辛苦{F#妳}{M#你}把書帶過來，本來常九爺是要我們去拿的，還付了錢。既然{F#妳}{M#你}把書拿來了，這些就給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				}
			]
		},
