					"content": "這次，這次一定能成功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020402
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020402,
					"content": "只要成功了，這本書就能賣遍全世界，她也一定能看見這本書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020403,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}怎麼還在這？快點把書送去<color=#00E1FFFF>飛雲商會</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
