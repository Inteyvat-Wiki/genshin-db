			},
			"dialogs": [
				{
					"id": 223020201,
					"content": "前面應該就是<color=#00E1FFFF>飛雲商會</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020202,
					"content": "把書交給<color=#00E1FFFF>門口的那個人</color>，應該就可以了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020203,
					"content": "不過…還是好在意呀，這本小說到底寫了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020204,
					"content": "怎麼樣？要悄悄看一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
