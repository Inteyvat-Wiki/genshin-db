			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "這次一定能成功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020102,
					"content": "成功什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "#{F#妳}{M#你}知道稻妻城裡，經常會舉辦一個小說大賽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020104,
					"content": "好像是叫…「這本小說真厲害！」，還是由稻妻城著名的「八重堂」主辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020105,
					"content": "為了這個比賽，我已經準備了很久，還看了許多稻妻人喜歡的小說做參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020106,
					"content": "再加上我那一屋子通讀已久的藏書…把璃月和稻妻的文化融合在一起，我寫就的這本小說，一定能拔得頭籌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020107,
					"content": "我已經和飛雲商會約好了，他們幫我把我的小說送過去參賽，但是拿書的人一直沒來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020108,
					"content": "#{F#妳}{M#你}有空的話，能幫我把這份手稿送給<color=#00E1FFFF>飛雲商會</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "#那就拜託{F#妳}{M#你}了，這次一定能行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020111,
					"content": "小說的題材是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "這不能透露，這可是我重要的參賽作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 223020113,
					"content": "只要這次能成功，那一切都能好起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
