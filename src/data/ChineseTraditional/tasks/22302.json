			"dialogs": [
				{
					"id": 223020501,
					"content": "就看一眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "嗯，嗯！就看一眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020503,
					"content": "說起來，這個少年…不會就是常九爺自己吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020504,
					"content": "他的心態，還挺年輕的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020505,
					"content": "唔，我們還是快點把這本書送給<color=#00E1FFFF>飛雲商會</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
