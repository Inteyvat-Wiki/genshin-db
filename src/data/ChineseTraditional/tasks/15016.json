						],
						"pointId": 350400100
					}
				]
			},
			"dialogs": [
				{
					"id": 150160101,
					"content": "#噢，{F#妳}{M#你}們來了啊，事情都處理完了，我正打算去休息呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160102
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160102,
					"content": "特拉佐莉會受到什麼處罰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160103
					]
				},
				{
					"id": 150160103,
					"content": "部族裡還在商量呢。用古名技術來犯罪的人，古往今來也沒多少…帕加爾要頭痛一陣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160104
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160104,
					"content": "能夠確定的是，特拉佐莉的工坊會被完全封閉，剩餘那些未成型的「燃晶名刻」也會徹底銷毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160105
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160105,
					"content": "至於那些已經成型的「燃晶名刻」我會接手處理，唉…又是個麻煩的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160106
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160106,
					"content": "無論如何，至少她的「古名」沒出問題，不然亂子可就大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160107
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160107,
					"content": "噢，說到古名，倒是有個好消息。「燃晶名刻」所汲取的記憶是可恢復的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160108
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160108,
					"content": "等到所有「燃晶名刻」都停止工作後，那些回憶應該就會順著原路物歸原主了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160109,
						150160110
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160109,
					"content": "那大家關於妮赫佳的記憶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				},
				{
					"id": 150160111,
					"content": "是啊。這麼一想…嬸嬸想要妮赫佳回來，所以讓整個部族的人都忘記了妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160112,
					"content": "現在妮赫佳真的離開了，大家卻又即將想起她…真是亂七八糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160113
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160113,
					"content": "妮佩卡現在的情況還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160114
					]
				},
				{
					"id": 150160114,
					"content": "她正在我的工坊裡休息。我已經聯絡了同族的人，準備正式查一查這孩子的身世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160115
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160115,
					"content": "現在族裡還沒回信給我，所以我就打算先照顧著她，順便教她點手藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160116
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160116,
					"content": "這都是之後的事了。現在就讓妮佩卡好好睡一覺吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160117
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160117,
					"content": "只有睡飽了，才有精力面對這麼多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150160110,
					"content": "也會一起回來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				}
			]
		}
	]
}