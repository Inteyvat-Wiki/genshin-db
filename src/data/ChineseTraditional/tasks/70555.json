			"dialogs": [
				{
					"id": 705550101,
					"content": "#{NICKNAME}，收工啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550102,
					"content": "#聽說，在我跟著格蘭菲狄小姐處理外送訂單的時候，{F#妳}{M#你}把事情辦得超漂亮嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550103,
						705550104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550103,
					"content": "這次我的靈感很多哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				},
				{
					"id": 705550105,
					"content": "…總之，榮譽騎士是目前蒙德最有才華的調飲師之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550106
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705550106,
					"content": "#考慮到從業時間，我覺得，{M#他}{F#她}甚至有潛力追上貓尾酒館的那位小小傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550107
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705550107,
					"content": "我無條件支持這個決策，大團長，這段時間實在有勞榮譽騎士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550108
					],
					"speakerTitle": "格蘭菲狄"
				},
				{
					"id": 705550108,
					"content": "飲品小站還會營業一段時間，確保做好迎接遠征隊員的萬全準備。找到適合的店面後，還會試行小範圍常態開放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550109
					],
					"speakerTitle": "格蘭菲狄"
				},
				{
					"id": 705550109,
					"content": "好欸！騎士團的大家都要有美味飲料喝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550110,
					"content": "不愧是赫塔的親傳弟子，格蘭菲狄考慮得很周到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550111
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705550111,
					"content": "還有，榮譽騎士開發的新品特調…如果您不介意，要留下配方，將它們作為正式飲品加入小站的菜單嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550112,
						705550113
					],
					"speakerTitle": "格蘭菲狄"
				},
				{
					"id": 705550112,
					"content": "完全沒關係，大家一起喝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550114,
					"content": "#唔…嗯…感覺{NICKNAME}好像還有什麼願望沒有說…我來猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550115,
					"content": "#以{F#妳}{M#你}的性格，應該會要求…標註每一杯特調的來歷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550116,
					"content": "#讓客人們知道{F#妳}{M#你}是為了誰、受了誰的啟發，才完成了這些厲害的作品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550117,
						705550118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705550117,
					"content": "完全正確！派蒙最懂我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550119,
					"content": "#沒有任何問題！如果{F#妳}{M#你}們還有需求，我可以請專人擬定文書，申請這些特調的專利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550120
					],
					"speakerTitle": "格蘭菲狄"
				},
				{
					"id": 705550120,
					"content": "哈哈哈哈，希望以後新招募的酒保，也能領會我們榮譽騎士的奇妙手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705550121
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705550121,
					"content": "不說調出旗鼓相當的傑作，還原榮譽騎士的七成功力，就算頂尖高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 705550118,
					"content": "這一點對大家都很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550119
					]
				},
				{
					"id": 705550113,
					"content": "介意的話…好像有點小氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550114
					]
				},
				{
					"id": 705550104,
					"content": "和大家聊天找到了點子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705550105
					]
				}
			]
		}
	]
}