			"dialogs": [
				{
					"id": 240110701,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}下手還真是不留情啊。周圍的紫金漁鷗一下子全都被嚇跑了，這效果真是立竿見影。",
					"roleType": "TALK_ROLE_NPC",
