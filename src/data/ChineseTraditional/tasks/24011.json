			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "紫金漁鷗啊、紫金漁鷗。我知道你們肚子很餓，但我也沒有吃飽啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110102,
					"content": "算了。如果這樣能讓你們開心，也滿好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110103,
					"content": "你在幹什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#旅行者？真高興見到{F#妳}{M#你}。如果是來找我辦事的話，那{F#妳}{M#你}得再等等了，我的薯條還沒吃完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110105,
					"content": "我不是來辦事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "這樣啊。那就好，我得把握時間趕快把薯條吃完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110108,
					"content": "這就是我的正餐。今天還要跟洛耶茨先生外出辦事，只能快速吃點這個將就了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110109,
					"content": "我不太習慣在沫芒宮裡吃東西，所以通常都會去外面，找個安靜一點的地方快速吃完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110110,
					"content": "但今天…不知道這群紫金漁鷗發什麼瘋，一直衝過來搶我的薯條，無論吃多少都不滿足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110111,
					"content": "因為還有很多紫金漁鷗想要吃嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "好吧，這麼說也有道理。但我總不能真的讓每一隻紫金漁鷗都吃到薯條吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110114,
					"content": "這不是你的薯條嗎？就不要這麼理所當然地讓給紫金漁鷗吃掉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110115,
					"content": "不然，你不就要餓肚子了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110116,
					"content": "怎麼感覺你有點喪氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "#什麼？我才不…好吧，的確有一點。什麼都沒辦法逃過{F#妳}{M#你}的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110119,
					"content": "我只是不知道，我工作的意義到底是什麼。雖然整天在複律庭忙個不停，但也沒有做出什麼實質性的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110120,
					"content": "既沒有幫助到某個人，也沒有讓誰的生活變得更方便。雖然洛耶茨先生反覆說，我們的工作很重要，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110121,
					"content": "我只是每天坐在打字機前，敲啊、敲啊，敲個不停。但這又有什麼用呢？我還不如再弄丟一次鍵帽，這樣伊絲黛萊還能賺一筆小錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110122,
					"content": "抱歉，我不該說這麼多的。我只是有點找不到方向，任何事情的方向都找不到，也許…也許我還需要更多時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110123,
					"content": "總之，先吃飽再說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "#{F#妳}{M#你}說得對。但以現在的時間…我一定來不及再去買一份新的薯條了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110126,
					"content": "算了，薯條就分給紫金漁鷗們吧。等我和洛耶茨先生辦完事情，再去買點東西吃好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110127,
					"content": "也就…呃…半天左右就能把事情辦完，不會花太多時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110128,
					"content": "這麼長時間不吃東西，身體真的撐得住嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110129,
					"content": "這些紫金漁鷗交給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "#這…這是不是太麻煩{F#妳}{M#你}了？就這麼一份薯條，不用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110132,
					"content": "好好吃東西啦。無論怎麼說，都不能餓著肚子工作呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110130,
					"content": "我去解決這些紫金漁鷗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "總之，先解決那些紫金漁鷗的問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "你的狀態…有點不太好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "畢竟…並不是所有紫金漁鷗都吃到薯條了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "你怎麼在這裡吃薯條？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
