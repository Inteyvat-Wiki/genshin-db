			},
			"dialogs": [
				{
					"id": 240111101,
					"content": "你養一隻狗試試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "#{F#妳}{M#你}的意思是…要我用狗來驅散那群紫金漁鷗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111103,
					"content": "這想法倒是不錯，我也許能找人借一隻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
		{
			"id": 2401112,
			"completionStepIds": [
