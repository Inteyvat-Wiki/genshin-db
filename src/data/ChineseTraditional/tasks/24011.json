					"nextDialogs": [
						240111502
					]
				},
				{
					"id": 240111502,
					"content": "#咦？這倒是個好主意。但那麼多紫金漁鷗，{F#妳}{M#你}餵得過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111503
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111503,
