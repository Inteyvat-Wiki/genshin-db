					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "呃…換個地方吃？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "我暫時也找不到什麼好地方吃東西了。要是離沫芒宮太近，說不定就會被同事看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111203,
					"content": "然後，他們就會拉著我，一邊吃飯一邊談工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111204,
					"content": "要是離沫芒宮太遠，我又不能準時回到辦公室裡，說不定會錯過什麼重要事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111205,
					"content": "同時考慮到這兩點，也只有這裡可以讓我一個人安安靜靜地吃一頓飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
