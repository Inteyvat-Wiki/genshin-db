			"dialogs": [
				{
					"id": 726550201,
					"content": "哈哈，就是這裡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550202,
					"content": "原來在這裡也有地下遺蹟…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550203,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "沒、沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550206,
					"content": "咦，是身體不舒服了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726550207,
					"content": "哈哈，我平時不怎麼下船，看到遺蹟入口這種大場面，還有點心虛罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550208,
					"content": "這算什麼大場面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726550209,
					"content": "#好啦，大姐頭的訂單還等著完成，想必旅行者{F#妳}{M#你}也很好奇遺蹟裡潛藏的秘密吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550210,
					"content": "所以，就請冒險經驗豐富的旅行者來打頭陣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550211,
					"content": "#真拿{F#妳}{M#你}沒辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "真是拿妳沒辦法，我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726550204,
					"content": "有什麼發現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
