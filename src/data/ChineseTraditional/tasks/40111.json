			"dialogs": [
				{
					"id": 401113101,
					"content": "這麼說來，北斗姐也會打「七聖召喚」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113102,
					"content": "嗯，大姐頭的牌技在南十字船隊稱得上數一數二了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 401113103,
					"content": "要不萬葉小哥幫我引薦引薦？我對北斗姐崇拜已久，早就想跟她交朋友啦，可一直沒遇到機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401113104,
					"content": "好。到時候還請堂主手下留情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
