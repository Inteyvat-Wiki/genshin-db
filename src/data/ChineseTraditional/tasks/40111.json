			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "您好您好，我是來自楓丹「蒸汽鳥報社」的記者夏洛蒂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113302,
					"content": "請問方便抽點時間嗎？我想對您做個簡單採訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113303,
					"content": "唉，妳問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113304,
					"content": "您一路過關斬將，最後關頭不敵往生堂的胡桃胡堂主，與冠軍失之交臂，看起來相當遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113305,
					"content": "請問您會如何評價這場比賽呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113306,
					"content": "…這。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113307,
					"content": "記者小姐，妳要的是能寫上報紙的回答，還是我的真實想法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113308,
					"content": "當然是真實想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401113309,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "小千"
				},
				{
					"id": 401113310,
					"content": "雖然打牌七分靠技術，三分靠運氣…但這一次骰出六個同色骰，別說我只是個冒險家，就算我是仙人也打不過啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
