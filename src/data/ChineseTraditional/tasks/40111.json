			"trigger": {
				"objectNames": [
					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "贏囉贏囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111102,
					"content": "恭喜提米！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "#謝謝{F#妳}{M#你}們。這樣一來，媽媽一定也會開心的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111104,
					"content": "葛瑞絲媽媽一直鼓勵我來參加比賽，我要把得到的獎品都送給媽媽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "提米"
				},
				{
					"id": 401111105,
					"content": "真希望爸爸也能看到我現在的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 401111106,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "再見，「七聖召喚」真好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米卡",
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "已經散場了嗎？我、我來晚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111202,
					"content": "米卡，真遺憾你沒看到。凱亞隊長…居然輸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111203,
					"content": "啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111204,
					"content": "哥哥，實際狀況是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111205,
					"content": "我對「七聖召喚」沒什麼研究，全靠大家的談論來理解局勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111206,
					"content": "一開始，凱亞隊長很快拿下了對面的第一張牌，形勢大優。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111207,
					"content": "但這似乎正是對方的策略？那個叫提米的孩子，靠著前幾個回合囤積起手上的卡牌…最後爆發出了驚人的威力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111208,
					"content": "不…或許這場比賽的勝負，早在凱亞隊長抽到「後手」的那一刻，就被決定了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111209,
					"content": "唉，我想去喝一杯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 401111210,
					"content": "哥哥，你冷靜一點，現在不是借酒澆愁的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111211,
					"content": "據我瞭解的凱亞隊長，他應該也不想看到你為他難過才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111212,
					"content": "倒不如我們也學學打牌吧？說不好下次還能跟凱亞隊長親自過招！哈哈…恐怕會輸得很慘吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401111213,
					"content": "哈，你說得對，米卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
