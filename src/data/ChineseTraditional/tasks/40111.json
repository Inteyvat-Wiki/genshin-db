					"夏洛蒂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "「西風騎兵隊長對陣天才不敗少年，湖中之城人才輩出」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111502,
					"content": "唔，用這個標題的話，面子是給足了，但少了些「爆點」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111503,
					"content": "「西風騎士團的頂尖頭腦派，竟在五回合內輸給橋頭少年」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111504,
					"content": "「如麥穗般輝煌的逆轉勝」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 401111505,
					"content": "嗯，不然，還是用回第一版…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏洛蒂"
				}
			]
		},
