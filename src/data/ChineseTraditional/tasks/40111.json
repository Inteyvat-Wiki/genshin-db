			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "聽聞「七聖召喚」的非官方比賽辦得很是熱鬧，不少熱愛牌戲的選手甚至在兩邊同時都報了名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401113202,
					"content": "我的話…偶爾迎迎潮流無妨，但還是對棋戲更感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
