						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#咦？{NICKNAME}{M#哥哥}{F#姐姐}…我們不是剛剛才見過面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420402,
					"content": "什麼時候的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "唔…我也不確定耶…畢竟，在這種地方根本不知道時間嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420404,
					"content": "夏諾蒂拉，跟我走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "這裡很不正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "但是正常與不正常，難道不是我們決定的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420407,
					"content": "嗯…我也沒有別的意思，但這裡對我來說真的很好。這裡充滿生機與色彩，在那邊的世界我從來沒見過這樣的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420408,
					"content": "我只見到一朵向日葵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "真的？哇！在什麼地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420410,
					"content": "之前我們遇到小狗的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "哦！那我先出發啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420412,
					"content": "等等…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7414207,
			"completionStepIds": [
				7414207
