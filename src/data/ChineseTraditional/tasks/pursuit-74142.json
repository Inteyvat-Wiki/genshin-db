							4853.025
						],
						"pointId": 6837
					}
				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#啊！是{NICKNAME}{M#哥哥}{F#姐姐}。咦？派蒙沒有和{F#妳}{M#你}一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420702,
					"content": "那個裂隙…妳在看什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "咦？什麼裂隙？這不是鏡子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420704,
					"content": "唔…這樣一說，我的確有在找的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420705,
					"content": "我一直在找「謎鏡」的線索…應該是像畫一樣的東西，而且和「揭示之書」一樣也能夠讓人「冥想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741420706,
					"content": "關於四象限與格式塔的「畫」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#是喔…原來在那樣的地方。嗯！謝謝{NICKNAME}{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				}
			]
		},
