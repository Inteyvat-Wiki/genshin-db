				]
			},
			"dialogs": [
				{
					"id": 741421301,
					"content": "#嗚嗚…謝謝{F#妳}{M#你}，{NICKNAME}{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421302,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "我不知道…我只是想來看看綻開的向日葵，還有可愛的小狗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421304,
					"content": "但在路上突然出現了一個很可怕的怪物追我，同時天空也變得越來越黑…而且有很多不同的聲音，說著我聽不懂的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421305,
					"content": "我害怕得不得了，就跟著金色的光一直往前跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421306,
					"content": "每當怪物接近我，整個世界就會變得更黑一點…花園、宮殿、大樹和花朵都不見了，變得好陰暗，只剩下廢墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421307,
					"content": "然後怪物就追上我了…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421308,
					"content": "已經不用擔心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "「小狗」，把她送回去吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "小姐，不要再來了。這裡什麼也沒有，而外面還有一整個屬於妳的世界呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "咦？你就是小狗嗎…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421312,
					"content": "…我們還可以再見面嗎？這個世界還可以變成美麗的花園嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421313,
					"content": "不會的。再見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "#還有{F#妳}{M#你}，我再問一次，我在{F#妳}{M#你}眼裡到底是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "#嗯，那就好。{F#妳}{M#你}已經趕走了不應該來到這裡的人物，多虧了{F#妳}{M#你}，這個世界的崩解也停下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "但繼續待在這裡也是不明智的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "我想也是，把我送回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "#{F#妳}{M#你}很明智。那麼永別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "到底是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "原本這裡已經要徹底瓦解了。不該來到這裡的人物到了這裡，撼動了這個世界的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "我所看到的現象，就是這樣來的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "#我不可能知道{F#妳}{M#你}體驗過什麼，畢竟我不是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "那你又是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "…我是誰並不重要。重要的是這個妄想世界的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "他們相信他們能夠拯救世界，卻不知道這個世界是否需要被拯救。或許他們記憶中的世界，只不過是永遠失去盛開的向日葵的午後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "但那些是他們的故事，不是我的故事。我只是他們對一位朋友的記憶，他們曾相信自己能夠拯救我，但最終…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "蝶而化繭，繭破而幼蟲出，最後幼蟲走向未曾誕生的虛無。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "不過這些都無所謂，因為現在的我已經什麼都不剩了。我只是他們記憶中，對於「拯救我」這件事的執著所留下的影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "但我也不會因此記恨他們，因為即使他們隨著割捨而變化，這個記憶與妄想所構成的世界裡的我，仍然證明了他們的執著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "作為曾經的朋友，我很滿足。無論我變成什麼模樣，我都會永遠感念過去一起的友誼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "#好了，就說到這裡吧。{F#妳}{M#你}也感受到了這裡對{F#妳}{M#你}的影響吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "#永別了。{F#妳}{M#你}和我不會再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
