					"nextDialogs": [
						741421404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421404,
					"content": "…那就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#好啦！罪魁禍首也回來了，夏諾蒂拉，妳害{NICKNAME}好擔心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421406,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421407,
					"content": "嗚嗚，對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421408,
					"content": "咦？呃…我沒有在責備妳啦！夏諾蒂拉不哭！我給妳吃好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421409,
					"content": "（發生了什麼事呀？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421410,
					"content": "（在裡面遇到了一些危險。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "（是喔…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421412,
					"content": "不哭不哭，夏諾蒂拉好勇敢！來，夏諾蒂拉，這是我最喜歡的野菇雞肉串，給妳當獎勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421413,
					"content": "嗚嗚…謝謝派蒙…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421414,
					"content": "（咀嚼）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421415,
					"content": "嗚哇，好怪的味道，這就是人吃的飯嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421416,
					"content": "什麼嘛！妳不吃的話那還給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421417,
					"content": "#但是…謝謝派蒙，還有謝謝{NICKNAME}{M#哥哥}{F#姐姐}，謝謝{F#妳}{M#你}救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421418,
					"content": "之後有什麼打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "不知道，但我再也不想看書了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421420,
					"content": "…夏諾蒂拉，這樣是不是有點太極端了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421421,
					"content": "唔…但是「揭示之書」真的很可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421422,
					"content": "（所以到底發生了什麼呀？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421423,
					"content": "（很難解釋…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "（妳要去了才知道。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "（什麼嘛！真氣人…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421427,
					"content": "…總之我不要待在這裡了，我要和大家一起住在海沫村裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421428,
					"content": "那就對啦！別的美露莘會好好照顧妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741421429,
					"content": "#嗯。謝謝{F#妳}{M#你}們，{NICKNAME}{M#哥哥}{F#姐姐}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741421425,
					"content": "（還好妳沒去。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
