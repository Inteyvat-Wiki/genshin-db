				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#是{F#妳}{M#你}啊，{NICKNAME}。取回莉利絲小姐的寶物以後，我們就掌握了勝利的關鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002602,
					"content": "終於，有機會打倒入侵的外來者，拯救出莉利絲小姐。如此一來，「雅克管弦樂團」也將奏響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002603,
					"content": "序曲的最後一個章節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002604,
					"content": "居然才是序曲嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "#嗯？{F#妳}{M#你}該不會以為救出莉利絲小姐，重新拯救了王國，一切就到此結束了吧？哈！現實世界才不是童話故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002607,
					"content": "#就是因為有{F#妳}{M#你}這樣想法的天真傢伙很多，歷史才會不斷地重蹈覆轍。下一步，要顛覆根深蒂固的階級體制和分配方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002608,
					"content": "在一個合理平等世界裡——不必多說，平等當然是合理狀態，也一定是莉利絲小姐嚮往的狀態。之所以將其並列是考慮到現狀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002609,
					"content": "我先走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "我們首先應當根據…設立…推翻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002605,
					"content": "可以精簡一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
