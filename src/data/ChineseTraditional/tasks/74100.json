				"objectNames": [
					"莫里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "（嗅嗅）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003102,
					"content": "汪汪，是好人。摸摸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003103,
					"content": "好哦，摸摸莫里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "摸了摸莫里。\\n因為是水構成的（狗），所以濕漉漉的。\\n但是莫里看起來很高興。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "汪汪，謝謝好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003106,
					"content": "下次再摸吧，莫里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "嗚，莫里壞壞，所以不摸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003108,
					"content": "這跟好壞有什麼關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "汪汪，好狗狗摸摸，壞狗狗…修。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003110,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003111,
					"content": "#看到莫里很傷心，{F#妳}{M#你}伸出手摸了摸莫里。\\n因為是水構成的（狗），所以濕漉漉的。\\n莫里藍色的眼睛裡重新出現了光彩。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "汪汪，謝謝摸摸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫里"
				}
			]
		}
	]
