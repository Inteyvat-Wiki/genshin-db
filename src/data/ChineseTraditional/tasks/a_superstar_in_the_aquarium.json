			"dialogs": [
				{
					"id": 747060101,
					"content": "…這條呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060102,
					"content": "好像還是差一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060103,
					"content": "哥倫比婭，還有芙寧娜？妳們在幹嘛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060104,
					"content": "在和芙寧娜導演一起…「選角」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060105,
					"content": "這麼說倒也沒錯，只不過我們準備選的演員，是水族箱裡的魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060106,
					"content": "魚都能演戲了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060107,
					"content": "現在動物演員也不少見嘛。我們想選一條氣質比較符合的魚，拍攝一些映影中用來烘托氛圍的空鏡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060108,
					"content": "只不過看了一圈下來，還沒有找到太適合的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060109,
					"content": "#要試著拜託{NICKNAME}和派蒙嗎？很多問題{M#他}{F#她}們都能解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060110,
					"content": "妳這麼信任我們倒是很高興啦…但這個問題上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060111,
					"content": "我們可以多找一些魚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "#對哦！這個水族館就是{F#妳}{M#你}們負責經營的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060114,
					"content": "也就是說，我們以後在下水的時候多留個心就行了？好像的確不難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060115,
					"content": "#那就這麼說定了！我稍後將想像中符合氣質的魚告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747060116,
					"content": "#那{F#妳}{M#你}們現在就是「星探」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060117,
					"content": "妳跟著芙寧娜還真是學到好多新詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060112,
					"content": "我們可以多下水看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
