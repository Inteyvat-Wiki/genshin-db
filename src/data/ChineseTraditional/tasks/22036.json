			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "這生意真是難做，我賣的明明都是童叟無欺的好貨啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360102,
					"content": "真是奇怪了，為什麼沒多少人來買呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "#喔，是{F#妳}{M#你}啊，旅行者。唉…別提了，我這店裡的肥料還是賣不出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360105,
					"content": "不是有愛拉尼幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "她…確實幫了點忙，但問題就是，我倆都不知道怎麼推銷，只會待在店裡等顧客上門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360107,
					"content": "#但離島的情況{F#妳}{M#你}也知道，這裡哪有什麼顧客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360108,
					"content": "所以，我就去找商會的先生們請教了一下，他們建議我搞一下什麼…「行銷」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360109,
					"content": "具體就是，多和客人談一談肥料的具體效果和原理，有理有據地向大家多多宣傳，還有什麼「試用」服務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360110,
					"content": "但是…我實在是不懂那些高深的東西，而且這肥料也不是我研究出來的，我怎麼講得出啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360111,
					"content": "不過，就算是拿著說明書唸，我也必須要去周圍跑一跑，宣傳一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360112,
					"content": "#愛拉尼已經出去宣傳了，我等會也要出去。旅行者，能請{F#妳}{M#你}幫我分擔一些宣傳工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360113,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "#那太好了！那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360115,
					"content": "#{F#妳}{M#你}要去的那個地方就在「紺田村」，離這裡不遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360119,
					"content": "那裡有一位紺田傳助先生，對我們店裡的肥料有些興趣，之前他還來過店裡和我聊了一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360120,
					"content": "如果能帶著一些貨去他那裡宣傳，並且請他「試用」的話，說不定他會願意來多買點肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360116,
					"content": "愛拉尼去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "她說要順便取取材什麼的，說是要走遠一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360118,
					"content": "#{F#妳}{M#你}要去的那個地方就在「紺田村」，離這裡不遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "瓦希德"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
