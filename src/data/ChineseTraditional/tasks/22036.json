					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "關於肥料的使用說明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "#對對，我還沒有和{F#妳}{M#你}說明，這次帶過去的肥料得以特別的方法施用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360203,
					"content": "我看看…按照手冊上的說明，施用順序應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360204,
					"content": "首先向肥料中加入<color=#37FFFF>清水</color>，然後再加入<color=#37FFFF>碎葉</color>，最後<color=#37FFFF>攪拌均勻</color>並施入田地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360205,
					"content": "千萬不要記錯了，否則不僅可能發生意外情況，更會影響顧客對我們的印象，以後的訂單就沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360206,
					"content": "我記住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "#那這件事交給{F#妳}{M#你}了。{F#妳}{M#你}把「豐沃之惠」交到顧客手上之後，他的首付款就是{F#妳}{M#你}的酬勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360208,
					"content": "你再說一遍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "首先向肥料中加入<color=#37FFFF>清水</color>，然後再加入<color=#37FFFF>碎葉</color>，最後<color=#37FFFF>攪拌均勻</color>並施入田地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360210,
					"content": "#拜託{F#妳}{M#你}了，旅行者…我們都加把勁，這個月的業績說不定還有希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				}
			]
		},
