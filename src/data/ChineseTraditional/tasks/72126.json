			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "糟糕了…這下怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260102,
					"content": "發生什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "您…太好了，您來了…是這樣，您給了我花種之後，我就開始種花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260104,
					"content": "但我還沒種多少，就突然出現了一群魔物，一直在我準備種花的地方待著，我已經不敢過去種花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260105,
					"content": "再放任它們這樣下去，說不定原本種了花的地方也會被它們糟蹋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260106,
					"content": "如果您願意的話，能幫我趕走那群魔物嗎？我、我只是想要種花而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260107,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "您答應了？太謝謝您了！那就拜託您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260109,
					"content": "為什麼這麼執著種花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "我是想，大家之所以不願意回踏鞴砂，應該也是擔心經歷了「御影爐心」這種事之後，這裡已經不太適合居住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260111,
					"content": "我沒辦法一個一個地說服所有人，但是，如果我能在這裡重新種出很多好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260112,
					"content": "也許就能說服大家，讓大家相信踏鞴砂已經安全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260113,
					"content": "而且…嘿嘿，除了種花之外，我也沒有什麼能說服大家的手段了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721260114,
					"content": "所以，拜託了，請您幫我去趕走那群魔物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薰"
				}
			]
		},
