			"dialogs": [
				{
					"id": 50130801,
					"content": "回聲之子這裡的魔物已經被清理乾淨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 50130802,
					"content": "我去幹掉了深淵瘤石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 50130803,
					"content": "流泉之眾也搞定了，一次了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 50130804,
					"content": "煙謎主的危險也解除了，需要去花羽會幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 50130805,
					"content": "那邊的情況好像滿嚴重的，我已經在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50130806,
					"content": "用不著，已經處理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50130807,
					"content": "這麼快？！妳剛剛還在競技場啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130808,
					"content": "想找人揍一頓，妳知道我忍了多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50130809,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130810,
					"content": "伊安珊，沃陸之邦怎麼辦？妳家離競技場那麼遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 50130811,
					"content": "哦，這個不用擔心，剛剛瓦雷莎和我通信了，那邊也解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50130812,
					"content": "看來全都沒事了呢，深淵似乎也示弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130813,
					"content": "對啊，這傢伙就知道用數量優勢，和還魂詩比比，看看誰人更多吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50130814,
					"content": "等等，深淵好像集結了一批魔物，往競技場的方向衝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130815,
					"content": "看來它也意識到還魂詩是最大的麻煩，想要去破壞聖火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50130816,
					"content": "怎麼可能讓它得逞，朋友們，競技場集合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 50130817,
					"content": "我看到有新的深淵瘤石砸下來，都在競技場附近，我們還是分頭去擊破吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 50130818,
					"content": "對了，還需要有人去守住大門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 50130819,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "好的，這就是最後的戰鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				}
			]
		}
	]
}