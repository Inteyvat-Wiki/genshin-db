			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#是帶來異國花朵的{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490102,
					"content": "妳好啊柯莎。我們帶來的花，成長得怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490103,
					"content": "這個…柯莎已經一天沒去看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490104,
					"content": "欸，不是很喜歡我們帶來的花嗎，為什麼不去看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490105,
					"content": "異國的花，那麼難得，柯莎想要趕快去照料它。可是一想到它可能會在眼前枯萎，就不敢去看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490106,
					"content": "#不會吧，都在意成這個樣子了？…不如我們一起去看看吧！如果遇到什麼問題，派蒙和{NICKNAME}會幫助妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490107,
					"content": "光提心吊膽也不是辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#…說得對，我們一起去吧！有派蒙和{NICKNAME}幫助，柯莎就有信心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
