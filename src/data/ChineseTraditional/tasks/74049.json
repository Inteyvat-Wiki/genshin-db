							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "嗚嗚嗚…寶貴的花朵，被弄壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490202,
					"content": "真是好可惜…原來花朵活不了，是因為隙境原體在搞破壞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490203,
					"content": "…柯莎、柯莎從此要守在花朵旁邊，一步也不離開了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490204,
					"content": "冷靜一點啊，柯莎，我們一起來想想辦法吧！話說回來，隙境原體為什麼會破壞花圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490205,
					"content": "柯莎之前帶其他花朵回來時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "從沒有過！哼，這些壞傢伙，只敢躲著我做壞事！柯莎好生氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490208,
					"content": "哇啊…沒想到柯莎也會有這麼氣憤的時候。看來是真的非常在意這些花朵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490209,
					"content": "但是，回憶一下的話，剛才柯莎靠近的時候，隙境原體也沒有主動躲開啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490210,
					"content": "或許吸引隙境原體的不是花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "對呀，也有這種可能，我們調查一下花圃周圍的情況吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490206,
					"content": "…被隙境原體找過麻煩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7404908",
							"2"
						],
						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME}真厲害，把醜醜的機關，「咚」地一下變成了美麗的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490302,
					"content": "這樣一來花圃應該不會被打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "雖然已經被糟蹋了一些，但剩下的花好像狀態還不錯。隙境原體也不會再來搗亂了，柯莎的花可以茁壯生長啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490304,
					"content": "太好了…不過，柯莎已經吸取了教訓，對寶貴的花朵要小心看護、小心照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}和派蒙…送來了異國的花，還幫柯莎保護花圃。柯莎要怎麼報答…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490306,
					"content": "不必那麼客氣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490307,
					"content": "#對了，還有柯莎親手採到的花朵，最珍貴的花朵！就把這個送給{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490308,
					"content": "#哦！既然是這麼珍貴的花朵，不如{NICKNAME}也開闢一片花圃把它種下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490309,
					"content": "話說這不是汐藻嗎？汐藻也算是花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490310,
					"content": "汐藻是植物，汐藻又很美麗，當然屬於花朵啦。這是人類的「生物學」，為了成為厲害的花匠，柯莎學了一點，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490311,
					"content": "總覺得哪裡不對，可是我也不太懂那些分類理論啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490312,
					"content": "柯莎以後要繼續努力，成為更厲害的花匠。聽人類說，厲害的花匠會培育出新品種的花，拿去參加「園藝會」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490313,
					"content": "柯莎也要培育出新品種，在「園藝會」上贏得「獎項」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490314,
					"content": "柯莎的氣勢倒是很不錯，不過好像還有很多難以解釋的誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490315,
					"content": "參加園藝會，就是說要把自己培育的新品種拿去給人類鑒賞吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490316,
					"content": "柯莎的感官和審美，跟人類差別太大了…她培育的新品種花朵，在人類看來會不會很奇怪啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490317,
					"content": "派蒙真關心柯莎的園藝事業啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "那當然了！我可是柯莎的園藝教師。要是柯莎能參賽獲獎，我臉上也有光彩嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490319,
					"content": "不必太在意獎項，最重要的是開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "…也對哦！柯莎認為自己培育的花美麗就夠啦！旁人的評價也沒有那麼重要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490321,
					"content": "柯莎要照顧好花圃，看著美麗的花，每天都開開心心的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490322,
					"content": "嗯！柯莎會讓異國的花茁壯成長的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490323,
					"content": "至少已經成功地邁出了第一步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "對哦，柯莎培育出的品種可能會有些不尋常，但有些人就是喜歡獨樹一幟的東西嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490325,
					"content": "#柯莎！培育出了新品種之後，要第一個告訴派蒙和{NICKNAME}哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490326,
					"content": "#沒問題，派蒙和{NICKNAME}幫了柯莎那麼多!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7404904,
