					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "嗯…好像也不是這一塊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090202,
					"content": "#啊，{F#妳}{M#你}們好呀，沒見過的{M#大哥哥}{F#大姐姐}，還有…嗯，白白的精靈小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090203,
					"content": "#歡迎{M#哥哥姐姐}{F#姐姐們}來到霜月之坊！有什麼需要幫助的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090204,
					"content": "#沒有沒有，只是看你一個人在這裡，稍微有點好奇而已啦。順帶一提，我是派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090205,
					"content": "#嗯嗯，那就是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐！看樣子，{F#妳}{M#你}們好像不是那夏鎮那邊的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090206,
					"content": "我們是冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#是的，{NICKNAME}和我可是超厲害的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090211,
					"content": "真好呀。能和好朋友一起去各式各樣的地方探險，看到不同的風景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090212,
					"content": "沒錯沒錯，我們已經去過好多好多地方啦。所以妳剛才一個人在這邊做什麼呢？是在找什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090213,
					"content": "嗯，我在找漂亮的石頭呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090214,
					"content": "啊，我明白了，是用來收藏的吧！不只是小孩子，有些大人也有這樣的愛好呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090215,
					"content": "欸，不是喔？我是要用漂亮的石頭收買小梅，讓她拐走我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090216,
					"content": "哦哦，原來如此，是為了讓她拐…等等，妳在說什麼東西？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090217,
					"content": "聽起來有點離譜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#欸？{NICKNAME}{M#哥哥}{F#姐姐}沒聽過大盜雷德·米勒與妖精公主的故事嗎？小梅和我說，外面人人都聽過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090221,
					"content": "「來吧，月色明瞳的小姐，就讓我用這與妳眼眸相稱的寶鑽收買下你的心，將妳拐離這鍍金的囚籠…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090222,
					"content": "雖然我也不太懂這個故事到底是什麼意思，但只要送出別人喜歡的東西，就可以和對方一起去冒險了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090223,
					"content": "那句話應該不是這個意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "是、是呀，那句話的意思其實是…呃啊，總之不是給小孩子看的東西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090227,
					"content": "說起來，妳說的這個小梅是什麼人啊？會跟小孩子講這種奇怪的東西，總覺得是什麼居心不良的壞傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090228,
					"content": "小梅不是什麼壞傢伙啦，年齡也和我差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090229,
					"content": "#和{M#哥哥姐姐}{F#姐姐們}一樣，是從外面來的冒險家哦！她之前一個人在營地附近鬼鬼祟祟的，被我抓到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090230,
					"content": "不知道為什麼，她好像覺得我們是什麼可怕的怪人集團，會把抓到的小孩子獻祭給月神大人，一邊假裝冷靜，一邊勸我別殺她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090231,
					"content": "好、好奇怪的誤解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090232,
					"content": "對吧？我也不知道小梅是從哪裡聽來了這種傳言，好奇怪哦。不過因為看起來很有趣，所以我也沒有反駁她就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090233,
					"content": "這種時候妳倒是反駁一下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090234,
					"content": "總之呢，作為交換，小梅答應做我最好的朋友啦，還給我講了好多好多外面的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090235,
					"content": "爸爸媽媽平時都不讓我看外面的故事，說是只有無信者才會喜歡那樣的糟粕…可是，小梅講的故事就是很有趣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090236,
					"content": "比方說，愛上了精靈的漁夫呀、三度死去卻又三度從冥府的女主人手中逃脫的大盜呀、渴望成為人類的換生靈呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090237,
					"content": "善良的人、沒有那麼善良的人、很壞很壞的壞人，無論富有還是貧窮、正義還是邪惡，最後大家都一樣，在苦難中死掉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090238,
					"content": "我覺得妳父母說得對，的確是糟粕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "是啊，這種故事的確不適合講給小孩子聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090243,
					"content": "可是，我已經不是小孩子了呀。小梅之前也說，外面的世界太亂，不適合像我這樣的小孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090244,
					"content": "明明她連月神大人{RUBY#[S]月矩力}的祝福都沒法用，年齡也和我差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090245,
					"content": "不過沒關係，我可是超聰明的。小梅被我抓到之前，一直在唸叨「石頭」什麼的，那代表她的目的就是收集漂亮的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090246,
					"content": "只要找到<color=#00E1FFFF>漂亮的石頭</color>，她就一定會被我收買，然後像雷德·米勒拐走妖精小姐那樣，把我從這裡帶走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090247,
					"content": "不要再用「收買」這種詞啦！其實就是要找到漂亮的石頭送給好朋友，沒必要用這種奇怪的說法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090248,
					"content": "嗯…反正我們接下來應該也會在附近轉轉，要是看到了什麼漂亮的碎片，就拿回來給妳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090249,
					"content": "#哇，真的嗎？那就謝謝{F#妳}{M#你}們啦，好心的{M#哥哥姐姐}{F#姐姐們}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090240,
					"content": "好想聽，能不能細講一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "嗯？好哦。就比如說，雷德·米勒的同伴，發誓永遠不會再踏入月光的「影鼬」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090242,
					"content": "喂，現在不是聊這種事情的時候吧！而且這種故事也不適合講給小孩子聽吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090225,
					"content": "沒錯，派蒙就是這樣被我拐上了路…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#喂，不要亂教小孩子啦！雖然我最喜歡的也的確是{NICKNAME}做的料理…但、但是不能叫拐走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090218,
					"content": "在挪德卡萊倒也正常…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "就算在挪德卡萊也不正常吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090208,
					"content": "我其實是那夏鎮幕後真正的操縱者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#哇啊，聽起來好帥氣！那我也可以成為{NICKNAME}{M#哥哥}{F#姐姐}的隨從嗎？就像故事裡一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090210,
					"content": "#{F#妳}{M#你}在胡說什麼啦，我們只是經過這裡的冒險家吧！才沒有什麼在幕後操縱那夏鎮各方勢力的打算…應該沒有吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "派蒙"
				}
			]
		},
