				"points": []
			},
			"dialogs": [
				{
					"id": 760090101,
					"content": "#謝謝{F#妳}{M#你}們，好心的{M#哥哥姐姐}{F#姐姐們}！要是附近可以找到<color=#00E1FFFF>漂亮的石頭</color>就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡夏"
				}
			]
		},
		{
