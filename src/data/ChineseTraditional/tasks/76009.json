					},
					{
						"sceneId": 3,
						"position": [
							1759.742,
							223.758,
							10440.77
						],
						"pointId": 12560
					},
					{
						"sceneId": 3,
						"position": [
							1760.837,
							223.823,
							10442.14
						],
