			"trigger": {
				"objectNames": [
					"自稱「唐無仇」者"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "#嗯？怎麼了，難道{F#妳}{M#你}又被老臭的挖寶玩法坑了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820102,
					"content": "我都說了，他那個挖寶，<color=#00E1FFFF>愈是好東西，周圍炸藥桶就愈多。東西愈差，周圍就愈安全。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820103,
					"content": "這次記住了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "自稱「唐無仇」者"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"自稱「唐無仇」者",
					"老何",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "你這盜寶團餘孽，呼呼…要不是我最近沒能吃蘑菇，全身不得勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820202,
					"content": "我早就把你打得生活不能自理了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820203,
					"content": "你這老賊，上來指著我種的琉璃…我種的清心，說是蘑菇，摘了就往嘴裡送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820204,
					"content": "咳咳…哪有，哪有這樣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820205,
					"content": "啊，老何，大俠，你們怎麼打起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820206,
					"content": "我、我在尋找蘑菇肉，蘑菇肉。但是他們不讓我再下礦，所以我就找到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820207,
					"content": "我好不容易發現這裡種著蘑菇啊，剛伸手，這人就打過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820208,
					"content": "#他竟敢冒犯我古華派傳人的修煉之地，這花除了我，還有英雄{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820209,
					"content": "還有英雄派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820210,
					"content": "還有英雄派蒙，除了我們三位之外，豈能容他人染指。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820211,
					"content": "盜寶團餘孽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820212,
					"content": "老賊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820213,
					"content": "好了好了，老何，唐無仇已經金盆洗手，不幹盜寶團的事啦，而且他種的是花，也不是蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820214,
					"content": "嗯？是嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820215,
					"content": "你仔細看，這不是清心嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820216,
					"content": "欸，好像還真的是清心啊，看來頭還是有點暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820217,
					"content": "還有唐無仇，你還想著要開什麼琉璃百合大花園嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820218,
					"content": "哎呀，在這裡，要有一大片琉璃百合大花園，不也是一番美景嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "自稱「唐無仇」者"
				},
				{
					"id": 710820219,
					"content": "不要再打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710820220,
					"content": "唉，沒有蘑菇，走了走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710820221,
					"content": "這鬧事的老頭終於走了，這下我終於可以認真研究研究種花的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "自稱「唐無仇」者"
				}
			]
		}
	]
}