						],
						"pointId": 8299
					}
				]
			},
			"dialogs": [
				{
					"id": 750210701,
					"content": "#哇！好厲害，{F#妳}{M#你}們把全部的星星碎片都找到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210702,
					"content": "#我平常幫卡卡媽媽的忙，存下不少零用錢，這些摩拉全部都給{F#妳}{M#你}們，把星星碎片賣給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210703,
					"content": "星星碎片？你知道這些是做什麼用的嗎？呃…在這之前，你一個小孩子為什麼自己在這種地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210704,
					"content": "#…別人都叫我奧爾科，{F#妳}{M#你}們也可以這樣叫我，雖然現在的名字不過是個代號罷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210705,
					"content": "#我就是為了收集星星碎片才到這裡來的，{F#妳}{M#你}們也看到下面的大石頭了吧？那就是從天上掉下來的星星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210706,
					"content": "#只要把失散的碎片交還給它，就可以獲得失去的力量…拜託了，{M#哥哥姐姐}{F#姐姐}，我真的很需要這些星星碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210707,
					"content": "聽起來好可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "嗯…不過也算是線索吧？那我們就一起試試看好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210711,
					"content": "話說回來，什麼星星碎片、失去的力量…聽起來就像是小說裡的情節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210712,
					"content": "#{F#妳}{M#你}們都沒聽說過奎伊露和烏庫庫的故事嗎？這個就送給{F#妳}{M#你}們好了，爸爸唸過很多遍給我聽，我已經倒背如流了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210713,
					"content": "但現在要緊的是，我們先一起下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210714,
					"content": "和奧爾科一起來到「墜落的星星」前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "#{M#哥哥}{F#姐姐}，快把失散的碎片放回星星上吧。哇…我會覺醒什麼力量呢？說不定可以去天上…嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210709,
					"content": "還有這種好事？那更不能給你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "對方只是個小孩子而已，不用這麼認真吧？而且他說的話也不知道是真是假，不如我們就一起試試看怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "派蒙"
				}
			]
		},
