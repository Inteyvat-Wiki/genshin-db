					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "應該就是這些了吧？這次的委託比想像中簡單很多呢！不過…真的有這麼神奇嗎？之前還有點半信半疑的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210502,
					"content": "派蒙也想覺醒隱藏力量嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#那當然啦，要是有什麼超強寶箱搜尋能力，或是超級大力可以一拳一個魔物，不是很便利嘛！{NICKNAME}難道不想要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210504,
					"content": "我需要更多力量！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "哦哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210508,
					"content": "#{M#哥哥}{F#姐姐}，快把失散的碎片放回星星上吧。哇…我會覺醒什麼力量呢？說不定可以去天上…嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210506,
					"content": "我已經夠強了所以不需要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "欸？人家不是都說在追求力量的路上，不應該要有盡頭的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7502107,
			"completionStepIds": [
				7502107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
