						],
						"pointId": 8296
					}
				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "#呼——我一個人鐵定下不來，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210302,
					"content": "這個就是天上掉下來的星星嗎？這樣靠近看的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210303,
					"content": "啊啊體內湧出了神秘的力量！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "欸？！真的嗎？不對，不是還沒找到失散的碎片嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210305,
					"content": "話說回來，這裡真的有碎片的線索嗎？一點頭緒也沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210308,
					"content": "那我們接下來該怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750210309,
					"content": "只有靠力氣了吧。<color=#00E1FFFF>用嵴鋒龍那麼大的力氣拍一拍</color>說不定就可以知道失散的碎片在哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210310,
					"content": "#大部分的問題都可以靠蠻力解決——爸爸是這樣說的。但我的力量還沒有覺醒，也沒有自己的龍…就拜託{M#哥哥姐姐}{F#姐姐們}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧爾科"
				},
				{
					"id": 750210306,
					"content": "好怪的石頭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "的確很獨特…不過是我太遲鈍了嗎？並沒有感受到神秘的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "派蒙"
				}
			]
		},
