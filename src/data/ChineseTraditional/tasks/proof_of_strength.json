				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "伊涅芙伊涅芙！妳看那個風車！快把它的結構記錄下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960302,
					"content": "收到——正在準備為風車拍照。這次想要合影嗎，愛諾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960303,
					"content": "#欸？{NICKNAME}？派蒙——還有洛恩！嗨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960304,
					"content": "來自挪德卡萊的「強大古龍」…我早該想到是誰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960305,
					"content": "情況總結中…所以，洛恩先生是想要找我進行戰鬥訓練？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960306,
					"content": "跳過所有前因後果，的確是這麼回事。在挪德卡萊遠征的時候還真是沒想到妳居然有這麼曲折的來歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960307,
					"content": "不過這都無關緊要，從前我就想領教一下妳的身手了，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960308,
					"content": "哼哼！伊涅芙！給他一點顏色看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960309,
					"content": "抱歉——根據今日行程安排，我們還要去收集蒙德的特殊零件。根據評估，與您交戰，可能會影響後續的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960310,
					"content": "對哦…差點忘了還有這回事。明明是聽說了蒙德有特別的大機器人才過來的…一不小心就全在玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960311,
					"content": "好吧…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960312,
					"content": "洛恩…居然這就放棄了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960313,
					"content": "只要幫妳們幹掉那些遺蹟守衛，妳就能騰出時間了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				}
			]
		},
