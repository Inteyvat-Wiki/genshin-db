			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "…追尋力量之人，依循命運的指引，終於來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960502,
					"content": "果然是杜林…我怎麼一點都不意外呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960503,
					"content": "但語氣有點不一樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "至高領主、魔女造物、天使孑遺…行使著各不相同的力量，卻都被冠以「龍」的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960505,
					"content": "…只因「龍」，即是強大的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960506,
					"content": "所以「與巨龍戰鬥」也就成了力量的證明？我有點理解當初的大團長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960507,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960508,
					"content": "雖然你看起來還想說什麼，不過接下來就用兵刃交流吧？這樣更好懂一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960509,
					"content": "等等！年…年輕的人類啊，你想找的試煉不在這裡，前往風龍廢墟吧！去直面最後一次預言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960510,
					"content": "語速好快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "你沒事吧，杜林？總感覺你今天說話怪怪的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960513,
					"content": "（哈…該唸的應該都唸了吧…雖然跳過了很多！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960514,
					"content": "那個，阿貝多叫我去幫他做實驗，我就先回去了。抱歉了，各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960515,
					"content": "這就飛走了？真遺憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960516,
					"content": "嗯？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960517,
					"content": "呃…所以杜林究竟是來做什麼的？除了最後那句「前往風龍廢墟」好像沒什麼有效資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960518,
					"content": "我有種預感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "有趣，我現在倒是想去見證一下這個「預言」會怎麼實現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960519,
					"content": "是為了湊「三」這個數字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "像趕著下場的演員！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
