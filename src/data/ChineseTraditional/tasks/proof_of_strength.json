			"trigger": {
				"objectNames": [
					"斯萊日涅夫",
					"萊夫赫姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "「隊長」不僅武力超群，還開發過對抗深淵的特效藥！這你不知道了吧？還敢說我是什麼都沒見識過的假學者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "斯萊日涅夫"
				},
				{
					"id": 700960202,
					"content": "那你知道我們團長的神速嗎？！他曾經只用一眨眼的工夫，就從挪德卡萊順著地脈跑回了蒙德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊夫赫姆"
				}
			]
		},
