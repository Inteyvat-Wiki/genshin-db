			"dialogs": [
				{
					"id": 700960601,
					"content": "很好…按照芭比洛斯的預言，那個需要指引的人類再過一會就會來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960602,
					"content": "登場臺詞…記住了。出場效果…確認過了。嗯，這次絕對萬無一失！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960603,
					"content": "你們覺得…最後一則預言為什麼要洛恩來這裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960604,
					"content": "現在就來了？難道杜林沒念完他的臺詞？不好…要小聲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960605,
					"content": "難道最後一次「直面龍威」…說的是特瓦林？不過牠今天是不是不在啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960606,
					"content": "#嚴格來說，我之前已經見過「東風守護」了。在我剛從挪德卡萊返回的時候，就在{F#妳}{M#你}們旁邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960607,
					"content": "對哦，是在奔狼領替法爾伽送信的那次吧！這樣算起來，你的「預言」其實已經結束了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960608,
					"content": "至少「三次直面龍威」，滿打滿算的話大概可以結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960609,
					"content": "還剩下「理解強大的意義」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "嗯，大概這才是「預言」指引我來這的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960611,
					"content": "這個地方在被稱作「風龍廢墟」之前，曾是龍捲之魔神的領域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960612,
					"content": "能捲起颶風庇護一切的強大魔神，卻攔不住風牆之內對於自由的嚮往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960613,
					"content": "曾與牠角逐神座的北風之魔神，卻在放棄力量之後，找到了一直追尋的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960614,
					"content": "咦？這孩子…好像也沒有法爾伽說的那麼偏執？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960615,
					"content": "「明晨之鏡」、「魔龍杜林」…也都曾陷入過不解與迷茫，而令他們走向強大的，卻從不只是力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960616,
					"content": "嗯嗯…悟性不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960617,
					"content": "還有曾經的天使——「烏薩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960618,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960619,
					"content": "雖然話說得很有道理…但這真的是洛恩你會說出來的臺詞嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960620,
					"content": "先是杜林…又是洛恩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "「選擇了力量的天使，依舊渴望靠近人類，竟至墮落為了可悲的魔物…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960623,
					"content": "「見證過這一切的人類啊，依舊執著於力量嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960624,
					"content": "——這全是我的詞啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960625,
					"content": "嗚哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960626,
					"content": "啊…一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960627,
					"content": "幸會，尼可女士。您寫的劇本，我已經拜讀過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960628,
					"content": "唉…是從杜林那裡撿到的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960629,
					"content": "哦？難不成這也是預言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960630,
					"content": "只是我的猜測而已。要是這也能預言到，我剛才也不會…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960631,
					"content": "總之，這劇本寫得不錯，當成童話來讀讀還滿解悶的。不過我不太喜歡被人說教…就算是「天使」也不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960632,
					"content": "…我就當你是在說我那位選擇力量的前同事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960633,
					"content": "既然你撿到了劇本，那我想要說的話你應該也全看到了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960634,
					"content": "嗯，我會把這些臺詞都當成寶貴的建議記下來。如果沒什麼事，我就回去繼續編我的強敵圖鑑了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960635,
					"content": "（沒說會聽從這個建議…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "不過我今天的確也收獲了不少，嗯…大概是有變強了那麼一點吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960638,
					"content": "謝謝了各位…也代我向「幕後人員」們都問聲好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960639,
					"content": "唉…果然又是一個難對付的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960640,
					"content": "所以這到底是什麼情況啊？誰來幫我理一理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960641,
					"content": "你們之前不是解決了多托雷，還有烏薩留在蒙德的「遺毒」嗎？聽說洛恩在那時候也遭了不少罪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960642,
					"content": "既然是從前的「天使」留下的禍患，那當然得靠現在的「天使」來導正——雖然跟我一開始預想的是有一點偏離…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960643,
					"content": "以後人類的命運，恐怕會變得更加不可預測吧？天使對人類的引導，也不再是通往未來的唯一解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960644,
					"content": "但這些無限的可能性…也許正是人類的「強大」之處呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 700960636,
					"content": "（還是要繼續編圖鑑啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "怎麼都開始念劇本了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
