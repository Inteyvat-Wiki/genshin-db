			"dialogs": [
				{
					"id": 700960401,
					"content": "很流暢的身法，完全看不出是機械。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960402,
					"content": "洛恩先生的攻擊也很精準，就像機械一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960403,
					"content": "好耶！是新零件！可以拿回去做新的模組了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960404,
					"content": "哦？那現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960405,
					"content": "伊涅芙！再去多找幾個！樣本越多越好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960406,
					"content": "是…抱歉，我們回頭再談吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960407,
					"content": "一番探索之後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 700960409,
					"content": "居然睡著了…是因為之前在荊夫港玩得太累了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960410,
					"content": "愛諾經常這樣，精力來得快去得也快。抱歉，洛恩先生，我現在無法移動，需要等愛諾再睡熟一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960411,
					"content": "…算了，妳的力量，我已經看過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960412,
					"content": "…希望我的戰鬥資料，對您有所幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960413,
					"content": "對了，告訴我們特殊機關資訊的人還提到過「雪山」，也許各位可以再去那邊看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				}
			]
		},
