			"dialogs": [
				{
					"id": 710960101,
					"content": "請問兩位找到「老石」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960102,
					"content": "在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "又是三枚「老石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960202,
					"content": "這兩位「熱心群眾」上交的「老石」，我就好好收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960203,
					"content": "沒想到這麼快就找到了三枚，而且品相比我之前見過的都好上不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960204,
					"content": "唉…這讓我想起以前我有的那枚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960205,
					"content": "你的那枚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960206,
					"content": "你自己有還要我們找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "是「以前」我有的那枚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960209,
					"content": "我爸在盛露廳，那枚「老石」是一小塊過他手的邊角料，品相也不是很好，他就把那枚石頭當玩具丟給了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960210,
					"content": "我那時天天和他吵架，遊手好閒，還流連那個時候的岩上茶室，欠了一大筆錢，走投無路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960211,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960212,
					"content": "有點差勁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "這個，誰都有年輕的時候嘛，反正就是我走投無路之時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960214,
					"content": "正好有認出「老石」的人願意花錢買，一塊石頭罷了，賣就賣了，得了摩拉解了一時之憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960215,
					"content": "結果前幾日我爸聊起這件事時，說，「沐寧啊，你以前玩的那塊石頭怎麼不見了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960216,
					"content": "我只好說，「一塊石頭而已，還能留到現在？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960217,
					"content": "嘴上那麼說，心裡卻想著，要是當初沒賣那石頭，他聊起的時候掏出來給他看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960218,
					"content": "…算了算了，想這些也沒用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960219,
					"content": "現在改正了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960220,
					"content": "#{F#妳}{M#你}說的是…只不過以前欠的錢還是要慢慢償還。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960221,
					"content": "不說了，如果還發現老石，記得帶給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960222,
					"content": "還不夠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "三枚吧，再給我三枚應該夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960225,
					"content": "老石本來就是稀有礦材，輝山廳如果還要，層岩巨淵這邊估計也找不到更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960223,
					"content": "到底需要多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "來，把你自己的先繳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}