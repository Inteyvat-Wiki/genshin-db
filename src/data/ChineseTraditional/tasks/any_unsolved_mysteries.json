			"dialogs": [
				{
					"id": 705170101,
					"content": "這一帶看起來很普通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170102,
					"content": "好像找不到什麼吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170103,
					"content": "說漏嘴了，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "咳咳，調查秘密的過程中也是要吃東西的，這是人之常情嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170106,
					"content": "#再說了，最近我們為了省事，吃了好多好多燒烤，{F#妳}{M#你}也有點膩了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170107,
					"content": "如果我們能在沙灘上撿到貝殼或海螺，就把它們和水果一起燉著吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170108,
					"content": "鮮鮮的，甜甜的，彈彈的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170109,
					"content": "聽起來好黑暗，我才不要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "試試看嘛，說不定會打開新世界的大門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170113,
					"content": "#等等，{NICKNAME}，{F#妳}{M#你}看那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170114,
					"content": "突然出現的機關…好像有蹊蹺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170115,
					"content": "附近還有一些行李貨物，是愚人眾的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170116,
					"content": "還真被派蒙說中了，好耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "我的預感果然很可靠，好耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170118,
					"content": "什麼好耶，呸呸呸！明明是我們有麻煩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170119,
					"content": "既然是和愚人眾有關的東西，出現在這裡，就很可能有陰謀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170120,
					"content": "如果放著他們不管，說不定又會不停發展，變得很難辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170121,
					"content": "#總之，先試著處理那個機關吧？如果{F#妳}{M#你}覺得有必要，再調查一下愚人眾的貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}，拿出以前的幹勁，解決他們以後，我們就能安心找食材了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170111,
					"content": "聽起來是派蒙會有的口感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "喂！人家可不是水產！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705170104,
					"content": "難怪妳這麼積極。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}