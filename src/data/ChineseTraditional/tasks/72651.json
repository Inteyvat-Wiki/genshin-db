			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏爾曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726510101,
					"content": "唉，難道我真是什麼「吸引仙靈體質」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510102
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510102,
					"content": "#{F#妳}{M#你}…旅行者？{F#妳}{M#你}怎麼也在這？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510103,
						726510106
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510103,
					"content": "你是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510104
					]
				},
				{
					"id": 726510104,
					"content": "是我啊！我是烏爾曼啊！我倆不是還合作尋過寶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510105
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510105,
					"content": "哎呀，「尋寶仙靈」！記起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510108,
					"content": "你怎麼來稻妻了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510109
					]
				},
				{
					"id": 726510109,
					"content": "#咳…上次我倆合作的時候，{F#妳}{M#你}不是幫我找到了那麼多鐵錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510110
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510110,
					"content": "#我把那些鐵錢轉手，賺了不少摩拉，嘿嘿，還是得多謝{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510111
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510111,
					"content": "#不過{F#妳}{M#你}也知道，這年頭花錢的地方多，那麼些摩拉也不夠花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510112
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510112,
					"content": "#但我沒了「尋寶仙靈」，也沒{F#妳}{M#你}幫忙，肯定是找不到別的鐵錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510113
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510113,
					"content": "所以，我就想要找另外的方法賺錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510114
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510114,
					"content": "我聽某位…呃…前同事說，稻妻這邊遍地寶藏，就想要來碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510115
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510115,
					"content": "你知道稻妻還在鎖國中吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510116
					]
				},
				{
					"id": 726510116,
					"content": "那我當然知道，但是嘛…嘿嘿，我有自己的門路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510117
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510117,
					"content": "我和我的某些「好朋友」友好地溝通了一下，並且付出了一點點小代價，弄到了一艘船，準備開船來稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510118
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510118,
					"content": "但是，唉…但是我越接近稻妻，天氣就越怪，又是打雷，又是風暴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510119
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510119,
					"content": "然後，突然一道雷正巧劈在我的船上，船毀了，我也掉進了海裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510120
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510120,
					"content": "幾個浪頭拍過來，我喝了好幾口水，人也暈了過去，再醒來的時候，就在海灘上趴著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510121
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510121,
					"content": "你運氣可真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510122
					]
				},
				{
					"id": 726510122,
					"content": "哈哈哈，可不是嗎，我運氣一向不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510123
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510123,
					"content": "而且…呃…怎麼說呢，我上岸之後四處打探了一下，結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510124
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510124,
					"content": "結果又遇見了這個小傢伙，它還帶著我找到了幾處寶藏，我想，也許它也是那種「尋寶仙靈」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510125
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510125,
					"content": "而且，它也和之前的那傢伙一樣，尋了幾處寶藏之後就歇了，只是一直跟在我身邊轉來轉去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510126
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510126,
					"content": "又是這種仙靈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510127
					]
				},
				{
					"id": 726510127,
					"content": "我也不知道為什麼，難道我是什麼「吸引仙靈體質」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510128
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510128,
					"content": "或者說，是我身上有什麼特別的東西吸引它？我是弄不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510129
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510129,
					"content": "但總之，既然來了稻妻，那我可不能白來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510130
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510130,
					"content": "根據我的打探，周圍還頗有些寶藏，我都記在我這本手冊上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510131
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510131,
					"content": "但這小傢伙似乎又提不起幹勁了…就憑我一個人，找這些寶藏可真是不太容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510132
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510132,
					"content": "#旅行者，如果{F#妳}{M#你}有興趣的話，那就再和我合作一次吧。{F#妳}{M#你}的那個「尋寶仙靈」應該還願意幹活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510133
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510133,
					"content": "#作法跟上次一樣，我幫{F#妳}{M#你}標出藏寶地點，{F#妳}{M#你}幫我去找到這些寶藏。裡面的寶貝都歸{F#妳}{M#你}，我分文不取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510134
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510134,
					"content": "#但如果{F#妳}{M#你}找到了「鐵錢」的話，就帶來給我吧。嘿嘿，我會出個好價錢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510135
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510135,
					"content": "希望真是個好價錢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510136
					]
				},
				{
					"id": 726510136,
					"content": "#那當然了，{F#妳}{M#你}和我都合作過了，就放心相信我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510137
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510137,
					"content": "#這本手冊給{F#妳}{M#你}，祝{F#妳}{M#你}尋寶愉快，也願咱們合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 726510106,
					"content": "你是那個「尋寶仙靈」的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510107
					]
				},
				{
					"id": 726510107,
					"content": "對，就是我，烏爾曼。我倆不是還合作尋過寶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "烏爾曼"
				}
			]
		},
