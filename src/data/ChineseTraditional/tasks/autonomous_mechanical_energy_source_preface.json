			},
			"dialogs": [
				{
					"id": 700270101,
					"content": "#{F#妳}{M#你}來的正好，「普爾希娜光釘」的維修工作一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270102,
					"content": "只要有了這些元件，我有把握以最快的速度修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270103,
					"content": "我收集了一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "太好了，這真是幫了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270105,
					"content": "只要有了這些元件，我有把握以最快的速度修好",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270106,
					"content": "#不過還有件小事，我想還是先跟{F#妳}{M#你}商量一下比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270107,
					"content": "#在{F#妳}{M#你}收集元件的這幾天裡，我仔細研究了一下「普爾希娜光釘」的內部結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270108,
					"content": "它的結構非常巧妙，不愧是那位普爾希娜前輩製作出來的精妙儀器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270109,
					"content": "任何一處調整都有可能影響到整體功能，所以我有些擔心調整是否能達到預期效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270110,
					"content": "#保險起見，我希望能拜託{F#妳}{M#你}先試用數次，我會根據{F#妳}{M#你}試用期間的數據對它進行再校準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270111,
					"content": "#這樣才能保證「普爾希娜光釘」的最終效果，要不然，等到{F#妳}{M#你}在與特異體交手的時候，萬一它出現了故障，那可就糟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270112,
					"content": "真是謹慎啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "這也是我第一次實際操作「普爾希娜光釘」，我們還是謹慎些為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270115,
					"content": "#那麼，就拜託{F#妳}{M#你}多多試用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700270113,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
}