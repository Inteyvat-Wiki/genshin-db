			"dialogs": [
				{
					"id": 210081001,
					"content": "#呼…這下就沒問題了，太感謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210081002
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210081002,
					"content": "#這些謝禮，請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
