			"dialogs": [
				{
					"id": 210080401,
					"content": "歸離原的道路？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "歸璃原是岩層平原，所以有些地方山路崎嶇，比如西邊的瞭望坡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080403,
					"content": "但是東邊靠海口的位置卻很平坦，有空去瑤光灘看看也不錯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080501,
					"content": "你的同伴呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "事情是這樣的。同伴負責給火盆加燃料，我負責點火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080503,
					"content": "雖然聽起來很瑣碎，但明確的分工是最重要的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
