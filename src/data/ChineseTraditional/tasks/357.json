				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "風魔龍…竟然開始直接襲擊城市內部了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572302,
					"content": "#凱亞、{NICKNAME}，你們來得正好，我們趕快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572303,
					"content": "等等，安柏。這裡還有人沒來得及互相認識吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572304,
					"content": "啊…好的。這是凱亞，是我們的騎兵隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572305,
					"content": "#這兩位是遠方來的旅者，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572306,
					"content": "（只知道是「遠方」嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572307,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572308,
					"content": "原來如此，歡迎來到蒙德。但很遺憾，是在這種糟糕的時機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572309,
					"content": "我很理解血親分離的痛苦心情，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572310,
					"content": "#另外，雖然不知道{F#妳}{M#你}們為什麼要找風神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572311,
					"content": "但每個人都有自己的秘密，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572312,
					"content": "哈哈，我是不會追問的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572313,
					"content": "#總之，首先我要代騎士團向{F#妳}{M#你}們道謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572314,
					"content": "不能放著災難不管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "剛才那場抵禦魔龍的戰鬥，被守護的市民們都是親眼目睹了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572319,
					"content": "代理團長大人對兩位也很有興趣，希望能在<color=#00E1FFFF>騎士團總部</color>一敘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572315,
					"content": "不客氣，那麼謝禮呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "嗯…蒙德特色的蜜醬胡蘿蔔煎肉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3572317,
					"content": "這句話我剛才已經聽過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}