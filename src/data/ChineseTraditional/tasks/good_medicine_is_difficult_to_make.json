			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "#旅行者！旅行者，請快點過來，我有事情想請{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "#{F#妳}{M#你}還記得馬魯夫嗎？就那位阿如村的醫生，之前拜託{F#妳}{M#你}找我要過藥方的那位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380104,
					"content": "這傢伙自己試吃了一碗自己熬的藥，結果整個人上吐下瀉了好幾天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380105,
					"content": "我一問才知道，因為病人喝了藥湯之後沒有效果，他就突發奇想，想要自己改造一下藥方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380106,
					"content": "真不知道這傢伙往藥湯裡加入了什麼藥材，能把自己搞成現在這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380107,
					"content": "唉，如果他只是在原來藥湯的基礎上調整藥材的比例和藥湯做法，絕不會出現這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380108,
					"content": "他也不是第一次吃這種虧了，怎麼還是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380109,
					"content": "算了，說不定他也有自己的苦衷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380110,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能幫我去拿點藥材回來嗎？這次我親自做一副藥，請{F#妳}{M#你}直接帶給馬魯夫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380111,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "馬魯夫這次改的藥方，是我上次開給他用來治療頭痛的藥方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380115,
					"content": "#我的藥方裡還差三顆赤念果，拜託{F#妳}{M#你}幫我去採三顆回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230380112,
					"content": "他之前也這麼做過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "是啊，我都忘了這是多少次了。還好他不經手那種藥性猛烈的藥方，不然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "扎卡里亞"
				}
			]
		},
