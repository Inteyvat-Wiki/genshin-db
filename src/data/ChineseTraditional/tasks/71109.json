			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"文四爺",
					"黃三爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "唉，不想我古華派千年傳承，到頭來竟落到了門長帶頭騙吃騙喝的境地…奈何，奈何啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "文四爺"
				},
				{
					"id": 711092502,
					"content": "嗨…行了行了，我這不是捨不得師弟守著這師門餓死嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "黃三爺"
				},
				{
					"id": 711092503,
					"content": "#你也別露出那種表情了。你一天到晚鬱鬱寡歡的…看到剛才那個{M#小夥子}{F#小姑娘}活躍的表現，你也挺欣慰的不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "黃三爺"
				},
				{
					"id": 711092504,
					"content": "#就那{M#傻小子}{F#傻姑娘}？進去轉一圈給你做個臘肉飯？我還欣慰？我要年輕幾歲先一掌拍死你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "文四爺"
				},
				{
					"id": 711092505,
					"content": "嘿，年輕幾歲你掌法還不如我呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "黃三爺"
				},
				{
					"id": 711092506,
					"content": "行了，你聽我說…就剩下咱們幾個老傢伙了，若不像這樣試探有緣人的底細，總不能真讓那些藏書陪著咱們進棺材吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "黃三爺"
				},
				{
					"id": 711092507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "文四爺"
				},
				{
					"id": 711092508,
					"content": "哈哈，罷了，罷了，這等讓人難受的喪氣話，不說也罷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "黃三爺"
				},
				{
					"id": 711092509,
					"content": "對了，那兩個孩子剛才做給我的美食，你也嚐嚐看吧？嘿嘿，我覺得比萬民堂做得還美味呢！來，嚐一口，嚐一口嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黃三爺"
				}
			]
		}
	]
}