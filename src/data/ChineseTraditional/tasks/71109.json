						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "「…天其難諶，臻而見眷者罕。命其靡常，盛而未衰者鮮…獲目於天，猶有徑路所窮之時，況復天目未及者…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "碑銘"
				},
				{
					"id": 711090502,
					"content": "「…遺此碑宇，且問來許。行至絕處，自當何如？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "碑銘"
				},
				{
					"id": 711090503,
					"content": "（觸碰石碑。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "（離開。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
