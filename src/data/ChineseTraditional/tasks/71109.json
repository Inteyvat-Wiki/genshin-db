					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "哇啊，沒想到這破破爛爛的王山廳裡，居然還真的藏了這麼深的秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090202,
					"content": "我也沒想到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "而且，黃三爺好像也不知道有這種地方…等等，難道這裡就是傳說中的「古華藏寶室」嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090205,
					"content": "#而且…{NICKNAME}{F#妳}{M#你}看，那邊的臺子上好像有什麼東西在發光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090206,
					"content": "是寶藏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "總之，我們快點過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090207,
					"content": "是機關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "可能這就叫「人不可貌相」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
