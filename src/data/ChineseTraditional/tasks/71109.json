						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "欸？這把劍上好像寫了什麼？讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090602,
					"content": "「…撫劍長歌去，斫龍歃血還。神光似遊電，寒浪欲摧山…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "古劍銘文"
				},
				{
					"id": 711090603,
					"content": "「…斬虎天衡下，刺蛟雲海間。功成拂衣後，永同煙水閒…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "古劍銘文"
				},
				{
					"id": 711090604,
					"content": "旁邊好像還有一塊石碑…咦，這下面的字跡好像不太一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090605,
					"content": "「…本欲遺魚羊豐餚於此，奈何日久必腐。且留食譜於此，足下可自烹之。甚美。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090606,
					"content": "「…此外別無他物，唯此劍與此景。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090607,
					"content": "「…行至絕處，當何如？足下已知。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090608,
					"content": "「…不取…遺寶，僅留一…自此…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "歪歪扭扭的摹刻"
				},
				{
					"id": 711090609,
					"content": "「請從絕處…讀我…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "歪歪扭扭的摹刻"
				},
				{
					"id": 711090610,
					"content": "嗚哇…下面這幾行字歪歪扭扭的，根本看不懂寫了什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090611,
					"content": "大概就是他什麼都沒拿的意思吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "嗚嗚…到頭來都沒找到什麼價值連城的寶藏，白期待一場了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090614,
					"content": "就是啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "不過沒想到在這種絕境還能看到這樣的風景…至少算是物有所值了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090615,
					"content": "沒關係沒關係，我做料理給妳吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#欸？！真的嗎！{NICKNAME}，一言為定喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090612,
					"content": "我也看不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
