	"talks": [
		{
			"id": 1502201,
			"completionStepIds": [
				1502201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502201",
							"2"
						],
						"stepId": 1502201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希諾寧"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "照阿爾帕之前說的…特帕爾就是從回聲之子來的吧？要怎麼找到他呢？一個個找人問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220102,
					"content": "直接找回聲之子裡的熟人幫忙會快一點，在這個時間這個地點，最容易找到的人選是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220103,
					"content": "——希諾寧，該起床了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220104,
					"content": "#哈…是{F#妳}{M#你}們啊…唔…{F#妳}{M#你}們等等…我先從樹上下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220105,
					"content": "啊…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220106,
					"content": "妳們好像都很喜歡待在樹上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "我爬樹是為了飛得更久看得更遠，一般不會在樹上休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220108,
					"content": "不是每個人都跟妳一樣，到處折騰一整天都不嫌累的…所以，這次是為了什麼事，來打擾我寶貴的休息時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220109,
					"content": "抱歉了希諾寧，但這件事很緊急——妳認識一位名叫特帕爾的工匠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220110,
					"content": "特帕爾？好像有點印象…應該是普瑪家的孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220111,
					"content": "那他現在人在回聲之子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "#不，起碼好幾年前就不在了…話說回來，{F#妳}{M#你}們又為什麼要找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220113,
					"content": "說來話長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "#{F#妳}{M#你}們盡量簡明扼要地說明了事情的經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "「燃素翼」？特帕爾這小子，居然真的能弄出這種不得了的東西…看來今天的休息時間是要沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220116,
					"content": "「真的能」？難道他以前就研究過類似的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220117,
					"content": "是，差不多就是從花羽會回來之後，他開始研究用人造物飛向天空的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220118,
					"content": "是在成為「失翼者」之後…人造物…就跟妳幫我造的那把槍一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220119,
					"content": "妳的那把「槍」可是比最高傲的絨翼龍還要難馴服——而他想要的，是讓沒有天賦的普通人也能自由飛行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220120,
					"content": "不過他那時候總是失敗，炸過好幾回工坊，連自己的小命都差點丟了。至於後面的事，我沒怎麼注意過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220121,
					"content": "特帕爾的父母早年曾在外遊歷，後來有了特帕爾才回到部族，但也選在了偏僻處定居，不怎麼與人交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220122,
					"content": "部族裡的人跟他們都不算很熟…要瞭解特帕爾的詳細情況，還是去找他家裡的人比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220123,
					"content": "#我現在去把普瑪約出來，{F#妳}{M#你}們就先在我的工坊前面等一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				}
			]
		},
		{
			"id": 1502202,
