			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"普瑪",
					"希諾寧"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "在希諾寧的工坊前稍微等了一陣子…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "久等了，這位就是特帕爾的母親，普瑪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220203,
					"content": "您好，我們是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220204,
					"content": "寒暄的話就免了吧，我不想多談那個人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220205,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220206,
					"content": "他早就已經跟我們沒關係了…我可沒有那樣的孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220207,
					"content": "他心裡就只有飛上天去的白日夢…不管我們怎麼勸都執迷不悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220208,
					"content": "哼…最後一走了之的時候，還說什麼要在天上造工坊，省得被地上的人指指點點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220209,
					"content": "#這是他留下沒帶走的手記，{F#妳}{M#你}們有什麼問題就自己翻吧。我不想再多說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220210,
					"content": "我從來就沒有過這個兒子…反正他也從沒認過我這個媽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "普瑪"
				},
				{
					"id": 150220211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220212,
					"content": "沒…沒想到他們的關係會這麼差啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220213,
					"content": "她的丈夫…特帕爾的父親不久前剛剛去世，但就算是在父親的葬禮上，特帕爾也沒有回來露面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220214,
					"content": "或許就是因為這樣，普瑪才會對特帕爾徹底死心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220215,
					"content": "我先去安撫她了，有事之後再聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 150220216,
					"content": "麻煩妳們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220217,
					"content": "那現在的線索…就只剩下這本手記了？上面寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220218,
					"content": "嗯…「燃素翼」的早期構思…還有…「空中工坊」的設想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220219,
					"content": "「燼城」奧奇卡納塔…看來「燃素翼」的技術原型就是從那裡來的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220220,
					"content": "他居然真的想造出一個飛在天上的工坊？光憑他一個人…真的做得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220221,
					"content": "話說圖紙上的氣球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "——啊！是試煉場地上面的那個！飛得特別高的氣球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220224,
					"content": "那個氣球出現有一段時間了，誰都不知道是怎麼飛上去的…但如果它不是被誰放「上去」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220225,
					"content": "而是因為什麼故障，從更高的雲層之上…「降落」到現在的高度呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220226,
					"content": "難道說它是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "——空中工坊的一部分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220228,
					"content": "很有可能。難怪連伊西多爾都不知道特帕爾的據點在哪裡…原來是藏在了雲層之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220229,
					"content": "居然還真的是藏在天上…那我們要怎麼上去呢？恰斯卡妳…能飛那麼高嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220230,
					"content": "#很有難度，要是再帶{NICKNAME}上去，就更不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220231,
					"content": "就算用了「燃素翼」應該也飛不了那麼高…除非是用手記裡說的「遺物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220232,
					"content": "「遺物」應該還在特帕爾手裡…應該是沒望了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220233,
					"content": "派蒙可以飛那麼高嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "#飛不了！怎麼想都飛不了吧！再說了{F#妳}{M#你}就忍心讓我一個人上去打特帕爾嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220235,
					"content": "放心吧，我們沒想出辦法，不代表別人也想不出。花羽會裡的「飛行高手」可不只有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220236,
					"content": "欸…對哦！還能去找阿爾帕長老呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220237,
					"content": "穆托塔當年也是飛行隊的一把好手，回花羽會去諮詢一下他們的建議吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220222,
					"content": "好像在哪裡看過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
