			"dialogs": [
				{
					"id": 150220301,
					"content": "#恰斯卡，{F#妳}{M#你}們總算回來了，部族裡的氣氛越來越嚴峻了，調查有什麼進展嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220302,
					"content": "還有人懷疑我們控制住商隊的人，是不是偏袒飛行隊，想要打壓「燃素翼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150220303,
					"content": "控制住了商隊矛盾卻還在擴大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "我們已經找到了一些線索，但要找到確鑿的證據還有一道難關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220306,
					"content": "恰斯卡說明了特帕爾的情況與空中工坊的猜想…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "來自燼城的「遺物」？過去這麼多年，奧奇坎的遺毒居然還在激起矛盾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220308,
					"content": "#空中工坊…試煉場地上空的熱氣球…這就是{F#妳}{M#你}們接下來的目的地嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150220309,
					"content": "有辦法上去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "不管是靠絨翼龍還是用「燃素翼」都飛不了那麼高…特帕爾真的會在那裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150220311,
					"content": "唔…方法…倒也不是沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220312,
					"content": "——還真的有啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220313,
					"content": "#{F#妳}{M#你}們還記得試煉場地內的那些噴口嗎？之前的地脈異常跟阻塞導致了氣態燃素匱乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220314,
					"content": "但如果在氣態燃素充盈的現在，反過來重新堵住它們的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220315,
					"content": "你的意思…是只留下最高處的噴口，把所有壓力都集中到那裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150220316,
					"content": "這麼一來，聚集的氣態燃素就會在最高處形成極強的風壓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220317,
					"content": "——然後我們就能乘著風飛上去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150220318,
					"content": "嗯，雖然會有些冒險，但以恰斯卡的技術應該不成問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220319,
					"content": "真是有夠冒險的…但的確有可行性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150220320,
					"content": "封堵噴口的技術細節，可以去試煉場地找因卡納克問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220321,
					"content": "#恰斯卡…能不能抓住飛在天上的證據，就看{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆托塔"
				},
				{
					"id": 150220304,
					"content": "難道不只有商隊的人在作亂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
