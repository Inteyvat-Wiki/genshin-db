			},
			"dialogs": [
				{
					"id": 30111113,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30111101,
					"content": "時間沒有在循環…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "對哦！每天晚上虛空的那個音效，說不定就是在刪除我們當天的記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111104,
					"content": "所以一覺醒來，所有人都以為花神誕祭還沒有度過，明明已經是「明天」了，但都還以為是「昨天」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111105,
					"content": "可身體記憶是刪除不了的，所以迪希雅的新大劍才越用越熟練！這下就都說得通了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111106,
					"content": "…很巧妙的推論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30111107,
					"content": "那到底說對了沒有呀，納西妲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111108,
					"content": "簡單來說的話，像是捉了火元素的晶蝶來當作螢火蟲去照明，太過注重「感受」，而忽略了其「本質」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30111109,
					"content": "這一點都不簡單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111110,
					"content": "依舊是錯誤的結論嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "#不然{F#妳}{M#你}們再去找那位迪希雅小姐聊聊吧，會有新的收穫也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30111112,
					"content": "嗯，畢竟新的線索是從她身上發現的…我們走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111102,
					"content": "而是我們的記憶每天都在被刪除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
