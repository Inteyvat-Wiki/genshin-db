			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "…結果還是這一天嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110102,
					"content": "看來果然沒有我們想的那麼簡單。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "納西妲，其實昨晚妳就知道「花神誕日的輪迴」還是會繼續的吧？怎麼不直接和我們說呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110104,
					"content": "#說了又如何呢，{F#妳}{M#你}們只會在新的焦慮中度過昨晚，明天依舊不會到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110105,
					"content": "#反倒不如…在短暫的希望中徹底放鬆一下自己，這是難得的機會呀，說不定可以讓{F#妳}{M#你}們的思維變得更加清醒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110106,
					"content": "倒也是…納西妲還是為我們在考慮的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110107,
					"content": "#當然，至少最近這段時間裡，{F#妳}{M#你}們就是我的全部嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110108,
					"content": "唔…怎麼突然說出這麼肉麻的話呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110109,
					"content": "#呵呵呵…我的意思是，雖然是我在拜託{F#妳}{M#你}們兩個破解謎團，但反過來，也只有{F#妳}{M#你}們兩個才能看到我、感受到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110110,
					"content": "#換言之，如果不是有{F#妳}{M#你}們兩個在的話，我就和「不存在」是沒有區別的。所以{F#妳}{M#你}們就是我的全部，懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110111,
					"content": "納西妲又在講些讓人摸不著頭腦的話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110112,
					"content": "閒聊就到這裡吧，根據昨天的新線索，旅行者對「現狀」有新的認識了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110113,
					"content": "「時間循環」的確是錯誤的結論。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "欸，為什麼忽然否定了之前的想法呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110115,
					"content": "迪希雅的武藝在進步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "唔，是呀，之前好像沒有留意這種地方，單純的時間循環應該會完全重置身體狀態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110118,
					"content": "那新的結論是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110116,
					"content": "迪娜澤黛病情惡化想必也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "#…{F#妳}{M#你}們原來在這裡，可算找到{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110202,
					"content": "今天的迪希雅果然也沒有受傷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110203,
					"content": "受傷？受什麼傷？別太小瞧我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110204,
					"content": "妳的新大劍畢竟不是那麼順手嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110205,
					"content": "#其實我也覺得很奇怪，今天突然就變得順手了起來…不對，{F#妳}{M#你}們怎麼知道我換過大劍的事？我應該不可能透露過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110206,
					"content": "#唔，這次還是{F#妳}{M#你}來解釋吧，我實在已經解釋膩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110207,
					"content": "其實也沒必要完全讓迪希雅理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "這樣啊，也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110210,
					"content": "妳的大劍忽然變得順手的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "是我們連續度過了許多個花神誕日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "#…我不在的這段時間{F#妳}{M#你}們怎麼了，是被什麼奇奇怪怪的人傳教了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110214,
					"content": "哎呀，別管那麼多，妳就當做是真的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110215,
					"content": "#…好吧，我理解{F#妳}{M#你}們的意思。就是說我的身體記憶已經讓我完全適應這把劍了，只是我的大腦不記得這件事了，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110216,
					"content": "沒錯，每天都會忘記一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110217,
					"content": "那我可反駁了哦？這種情況是絕對不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110218,
					"content": "哦？說來聽聽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110219,
					"content": "如果一連很多天都是花神誕祭，只是我們不記得的話，那所有的物資消耗，花掉的錢、吃掉的東西該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110220,
					"content": "按理說我的錢包早該空空如也了，不可能沒發現的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110221,
					"content": "這一點我也想到過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "在幕後黑手是賢者的情況下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "的確…用虛空記錄全城人每天的行為，再動用全城的資源去恢復到這一天的開始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110225,
					"content": "雖說不太可能，但或許還是可以做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110226,
					"content": "不可能不可能，我有證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110227,
					"content": "妳有證據？在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110228,
					"content": "#唉…{F#妳}{M#你}們對這種莫名其妙的討論還真是認真啊，好吧好吧，就讓我再陪{F#妳}{M#你}們一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110229,
					"content": "跟我來吧，還有迪娜澤黛小姐也請一起，目前還沒辦法保證這附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110223,
					"content": "如果利用虛空的資料和全城的資源…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "只是每天晚上會被消除當天的記憶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "直接切入重點好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "就是這個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110302,
					"content": "這什麼呀，妳練劍的木人樁嗎？這個怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110303,
					"content": "看到上面的痕跡了嗎？是我這幾天的累積。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110304,
					"content": "假設賢者不會每天來把它換掉，它應該早就已經被砍的破破爛爛了對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110305,
					"content": "對呀，那每天都換一個的情況呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110306,
					"content": "那賢者每次都要在新的木人樁上複製出我之前練劍的劍痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110307,
					"content": "好歹我也是武者，在我的武學流派裡，對「控制」的講求非常精細。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110308,
					"content": "每一次揮劍，力度、角度、切入點都是用心控制過的，所以上面每一道傷痕我都記得，也記得揮出那一劍的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110309,
					"content": "正如有句話，武者之劍乃獨一無二，沒有人可以揮出完全相同的兩劍。想要完全複製我的劍痕，絕對不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110310,
					"content": "不可能嗎？如果是用什麼精細的儀器一點點「雕刻」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110311,
					"content": "常有人說，留影機的畫片永遠不能替代畫家畫出來的風景畫，因為前者是沒有靈魂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110312,
					"content": "對我也一樣，雕刻出的劍痕和作為武藝修煉結晶的劍痕…我一眼就能分辨得出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110313,
					"content": "…也有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "呼…這回應該沒什麼疑問了吧？欸，這是不是最近學者之間流行的叫做「腦筋急轉彎」的遊戲？想不到還挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110316,
					"content": "那就這樣吧，我看時候也不早了，我護送迪娜澤黛小姐去妮露那邊了，晚點見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110317,
					"content": "唉…又是一條走不通的路，「記憶刪除」理論也是錯誤的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110318,
					"content": "但至少我們也有了一些階段性的結論吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110319,
					"content": "時間並未循環。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "嗯，的確如此，那現在我們還能找到一些新的頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110322,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "蹊蹺？我覺得最近全是很蹊蹺的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110325,
					"content": "我們…為何從沒考慮過出城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "欸…？出城…對哦！這麼容易想到的嘗試，我們居然沒試過。看看城外的時間是不是還卡在同一天，就能確定很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110327,
					"content": "真是不可思議，是我們之前太鑽牛角尖了呢，還是累得暈頭轉向了才想不到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110328,
					"content": "這真的很奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "要不我們還是回去問問納西妲吧，關於出城的事，莫非是我們忘記了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110329,
					"content": "總覺得應該很早就想到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "我忽然感覺有件事很蹊蹺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "我們不在現實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "看來只能放棄這種可能性了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
