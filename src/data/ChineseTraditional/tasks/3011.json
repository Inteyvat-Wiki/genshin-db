			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "納西妲，我們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110402,
					"content": "今天回來得很早呢，莫非是有了什麼新的收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110403,
					"content": "算是有吧，我們基本確定了時間並未循環，這裡也應該不是現實…可同時我們又有了新的疑惑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110404,
					"content": "出城的話會怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "#出城…在我印象裡，有兩次{F#妳}{M#你}們都提及過出城相關的計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110407,
					"content": "！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "我們說過嗎！我們怎麼完全沒有印象了，後來呢？我們回來之後怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110409,
					"content": "#讓我想想…好像{F#妳}{M#你}們從未提起過出城計畫的結果如何，哦，不如說，那兩次出城計畫的當晚{F#妳}{M#你}們都沒有回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110410,
					"content": "#不過平時{F#妳}{M#你}們也有不少個晚上「夜不歸宿」的，所以我當時也不覺得這能證明什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110411,
					"content": "#確實有的時候會調查事情忘了時間，直接就到了第二天。可是{F#妳}{M#你}所說的出城當天的記憶，我們兩個卻都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110412,
					"content": "#這樣嗎？這倒有些奇怪。理論上應該已經喚起了{F#妳}{M#你}們全部的記憶才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30110413,
					"content": "明天再試一次吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "嗯！絕對有蹊蹺，明天一定要想辦法查清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110416,
					"content": "「滴——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110414,
					"content": "或許突破口就在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "我們是不是真的沒試過出城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
		{
			"id": 301111,
