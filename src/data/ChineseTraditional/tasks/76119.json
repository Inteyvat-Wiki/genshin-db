			"dialogs": [
				{
					"id": 761190101,
					"content": "…這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190102,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761190103,
					"content": "…哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190104,
					"content": "她們好像玩得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190105,
					"content": "#{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190106,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761190107,
					"content": "你也好，努昂諾塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190108,
					"content": "是在玩新遊戲嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "嗯，我在「旗艦」見到有人用杯子和朋友這樣玩，就學來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190110,
					"content": "他們把寶石扣進杯子裡，在桌面上快速轉動杯子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190111,
					"content": "等停下後，讓對方猜測寶石究竟停留在哪個杯子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190112,
					"content": "月靈們喜歡鑽在布裡轉來轉去的感覺，所以我以魔女小姐的帽子為原型，做了些改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190113,
					"content": "很可愛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "月靈"
				},
				{
					"id": 761190115,
					"content": "但話說回來妳都去過「旗艦」了啊，有被人認出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190116,
					"content": "有人問起，我就說：「我在扮演月神大人，很像吧？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190117,
					"content": "祈月之夜時的那招還真是被妳學會了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190118,
					"content": "那些人會信嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "唔…好像半信半疑，但也沒再多和我搭話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190120,
					"content": "是我表演得不自然嗎？下次再去其他地方多試幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190121,
					"content": "怎麼聽起來是學壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190122,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 761190123,
					"content": "#努昂諾塔想邀請{F#妳}{M#你}來猜它躲在哪裡，要和它玩一局嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190124,
					"content": "好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "請按照「旗艦」的規矩，付十萬摩拉作為押金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190126,
					"content": "這部分就不用學了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
