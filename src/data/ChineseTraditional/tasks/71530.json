			},
			"dialogs": [
				{
					"id": 715300101,
					"content": "#海燈節快樂喲，{M#大哥}{F#大姐}和小妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300102
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300102,
					"content": "#哎，{F#妳}{M#你}們不是之前來找嘉明的那兩位大名人嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300103
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300103,
					"content": "我們之前見過你，你和嘉明在一起玩來著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300104,
					"content": "#對，{F#妳}{M#你}們還記得我，我走大運了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300105
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300105,
					"content": "#聽說{F#妳}{M#你}們是高手，做什麼都很在行！我每天走幾步路去吃虎岩買菜，路上都能聽到好幾個人誇{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300106,
						715300107
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300106,
					"content": "沒錯，我就是全能高手！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				},
				{
					"id": 715300108,
					"content": "我我我，我也有吃飯之外的本領啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300109,
					"content": "等等，我想想，我還會什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300110,
					"content": "我懂！普通人哪裡能飄起來，妳又白又輕又蓬鬆，就像鴿子小仙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300111
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300111,
					"content": "會飛就很厲害了，拿東西好方便，做事輕輕鬆鬆，妳要多幫幫妳的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300112,
						715300113
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300112,
					"content": "派蒙居然是鴿子仙人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300114,
					"content": "#先不說鴿子成仙這種事存不存在啦，我一直有幫{NICKNAME}的忙嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300115,
					"content": "#例如從很高的地方掉下去的時候，我也會拉著{NICKNAME}，讓{M#他}{F#她}不會摔得太痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300116,
					"content": "#雖然我力氣不太夠，拉不太動啦…如果我真的是鴿子仙人，我就在{NICKNAME}用風之翼的時候拉著{M#他}{F#她}，飛得更遠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300117,
					"content": "#{F#妳}{M#你}們要多練練嘛，就像我和嘉明練舞獸。一起練的時間長了，有了默契，配合還不簡單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300118
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300118,
					"content": "正好，我做了個新鮮好玩的遊戲，叫「碰碰舞獸戲」，要來試試不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300119
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300119,
					"content": "既能鍛煉配合，又能好好瞭解舞獸戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300120
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300120,
					"content": "「碰碰舞獸戲」？難道就是你旁邊的這個大玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300121,
					"content": "對的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300122
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300122,
					"content": "正宗的舞獸戲很難學，就算有專門的人帶著練，不喜歡、沒毅力也堅持不下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300123
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300123,
					"content": "所以我拿舞獸戲的一種舞法改了改規則、換了道具，就有了這個遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300124
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300124,
					"content": "現在也是海燈節嘛，讓大家開心開心，飯前活動，飯後消食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300125
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300125,
					"content": "只需要穿上戲服，比比誰拿到的茶餅更多。遊戲裡還可以碰來碰去，很樂的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300126
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300126,
					"content": "聽起來很好玩，不過要穿著這麼大的戲服和別人玩遊戲，我的力氣好像真的不太夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300127,
					"content": "#{NICKNAME}對這種遊戲很在行！我就在一邊看著大家玩，先學一學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300128,
						715300129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300128,
					"content": "好！那我就舞一舞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300130,
					"content": "咦？鴿子小仙不親自上嗎？有點可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300131
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300131,
					"content": "#沒問題的！我和{NICKNAME}一起旅行了好久好久，以後也會一直旅行下去，還有很多機會鍛煉默契！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300132,
					"content": "#而且，說不定我只是看看，就能學到不少和{NICKNAME}配合的要領呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715300133,
					"content": "#哈哈！{F#妳}{M#你}們的關係太好了，我都有點羨慕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300134
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300134,
					"content": "#那就請大名人{M#大哥}{F#大姐}來體驗體驗「碰碰舞獸戲」，鴿子小仙開開心心看戲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300129,
					"content": "好！那我就碰一碰！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300113,
					"content": "奇怪的外號增加了耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300107,
					"content": "哈哈，派蒙是吃飯高手！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				}
			]
		}
	]
}