					"派蒙",
					"愚人眾先遣隊",
					"浪人暗部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "看來這個地方果然不簡單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722740111,
					"content": "#噓——{F#妳}{M#你}聽，那邊好像有人說話的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722740101,
					"content": "嘖，沒想到那個女人口風真夠緊的，竟然一個字都不說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740102,
					"content": "大人別擔心，拷問什麼的我可是最擅長了！您先歇歇，等會咱們再到地下的牢房去收拾她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740103,
					"content": "時間不多了，老師要我們趕快問出她到底對計畫知道多少。要是問不出來，我們也要跟著遭殃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740104,
					"content": "哎呀，那位大人的脾氣可真是可怕。這個女人到底幹了什麼，害他這麼惱火？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740105,
					"content": "老師最近的計畫裡，有個重要的棋子叫柳達希卡，可這個終末番的女人，竟然把柳達希卡給幹掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740106,
					"content": "幸好我們衝進去的時候，火還沒熄滅。不愧是老師，一下子就從服裝上認出了柳達希卡，意識到計畫可能存在風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740107,
					"content": "那真是不幸中的萬幸哩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740108,
					"content": "但誰知道這個女人對計畫瞭解到什麼程度，又會不會已經把事情告訴了終末番的其他人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740109,
					"content": "看來百代小姐就被關在地下的牢房裡，我們快去救她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
