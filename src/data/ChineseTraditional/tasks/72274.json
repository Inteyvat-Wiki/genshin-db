			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "沒想到我們竟然會遇上作戰計畫洩露這種事，真是晦氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740202,
					"content": "是啊，老師突然接到命令回至冬國了，可是海祇島的計畫卻還要繼續進行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740203,
					"content": "老師會不會太獨斷專行了？這個任務他沒向「僕人」大人彙報過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740204,
					"content": "這確實是老師一個人的主意。嘖，我有種不好的預感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "愚人眾先遣隊"
				},
				{
					"id": 722740205,
					"content": "你是說，如果我們失敗，老師就會把責任都甩在我們頭上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人眾先遣隊"
				}
			]
		}
	]
