					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690301,
					"content": "殼殼燒…為什麼要叫殼殼燒呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690302,
					"content": "算了，還是先做出來再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690303,
					"content": "完成了！這就是「蟹黃殼殼燒」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690304,
					"content": "我要一個！嗯…就這個好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721690305,
					"content": "給我個小一點的，太大的我可吃不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721690306,
					"content": "#喏，這一份是{F#妳}{M#你}的，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690307,
					"content": "#還有這份「蟹黃殼殼燒」的製作方法，我也抄了一份給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690308,
					"content": "#這道菜做起來倒還算簡單，{F#妳}{M#你}有空的話也自己試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690311,
					"content": "#接下來我們準備去<color=#00E1FFFF>八醞島</color>附近轉轉，如果{F#妳}{M#你}有空的話，可以來找我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690309,
					"content": "好了，我也得去吃一點了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690310,
					"content": "喂！朱莉！留一個給我，別吃完了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
