			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "#怎麼樣旅行者，{F#妳}{M#你}的收獲如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690202,
					"content": "#喔！這隻螃蟹看起來不錯，{F#妳}{M#你}滿厲害的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690203,
					"content": "好了，既然材料都齊全了，那就開始準備烹飪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690204,
					"content": "#我先準備一下，旅行者，{F#妳}{M#你}再稍等一會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 7216903,
			"completionStepIds": [
				7216904
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
