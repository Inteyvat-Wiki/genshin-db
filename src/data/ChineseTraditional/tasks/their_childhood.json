			"dialogs": [
				{
					"id": 240030901,
					"content": "#哥！你是不是把我藏的地方告訴{M#大哥哥}{F#大姐姐}了，{M#他}{F#她}怎麼找到得這麼快呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030902,
					"content": "我都說過了，是你躲的地方太明顯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030903,
					"content": "我經驗很豐富的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "#是嗎？那{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}以後會不會經常來呀？我們一起玩好不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030906,
