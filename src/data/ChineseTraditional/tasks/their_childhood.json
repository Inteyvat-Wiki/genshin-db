			"trigger": {
				"objectNames": [
					"韋呂",
					"奧雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "我這次躲的地方，你一定找不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030102,
					"content": "如果你躲在那些地方，去找你的人就不是我，而是老爸老媽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030103,
					"content": "你們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "我正在和哥哥捉迷藏呢！但是…我躲的每一個地方他都知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030105,
					"content": "韋呂…我們都在這裡玩多久了，每一個能躲的角落都被你躲過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030106,
					"content": "至於那些不能躲的地方…我已經和你說過很多次不能躲那裡的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030107,
					"content": "那些地方又沒什麼危險，老爸老媽總是說得那麼誇張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030108,
					"content": "但你躲到那種地方會把衣服和褲子弄髒或者弄破，爸媽工作已經很辛苦了，別讓他們再操這種心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030109,
					"content": "唔…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030110,
					"content": "不然…我陪你們玩玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "#真的嗎？！{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}願意陪我玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030113,
					"content": "韋呂，別給人家添麻煩！抱歉，我弟弟滿腦子都想著玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030114,
					"content": "沒關係，我剛好有空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "好耶！哥哥你看，人家都答應了！我一定躲得比你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030117,
					"content": "#好吧…那就麻煩您了，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030118,
					"content": "韋呂，不要躲在我和你說過的那些地方，今天晚上爸媽會晚點回來，把衣服弄破了就沒人能幫你補了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030119,
					"content": "知道啦，哥哥真囉嗦…我先去躲了，哥哥也一起玩嘛，快點快點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030120,
					"content": "你先去吧，我已經想好躲在哪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030121,
					"content": "#真的？哥哥又在吹牛…一定第一個就被{M#大哥哥}{F#大姐姐}找到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240030122,
					"content": "奧雷勒和韋呂分別先去躲了起來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "沒關係，不算添麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "我應該找不到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
