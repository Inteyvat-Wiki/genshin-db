			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "韋呂什麼時候能懂事點呢，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030702,
					"content": "你不躲起來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "我本來就不怎麼想玩。如果不是韋呂吵著要出來玩捉迷藏，我還想多看一點書呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030704,
					"content": "爸媽工作都很辛苦了，我要快點長大…這樣才能為他們分擔一點壓力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030705,
					"content": "但韋呂一直說很想媽媽…我只能陪他玩一下遊戲，這樣他就不會哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030706,
					"content": "#抱歉，我說太多了，{M#大哥哥}{F#大姐姐}。我先去集合點等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240030707,
					"content": "希望韋呂不要把衣服弄髒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧雷勒"
				}
			]
		},
