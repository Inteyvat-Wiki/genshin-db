			"dialogs": [
				{
					"id": 760381109,
					"content": "（或許<color=#FFCC33FF>莉奈婭</color>會對糖雕有興趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "莉奈婭小姐，又來為露米買糖雕了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760381102,
					"content": "是啊，露米很喜歡妳做的糖雕，每次都不捨得吃，只是舔一舔就要我收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 760381103,
					"content": "不過，畢竟是糖雕嘛…舔多了也就化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 760381104,
					"content": "所以，拜託烏娜亞塔小姐，再幫露米做一份糖雕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 760381105,
					"content": "沒問題！稍等一下喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760381106,
					"content": "（哎呀，露米太可愛了！好想摸一摸！但隨便摸的話…算了算了，這樣太失禮了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760381107,
					"content": "做好了，請拿好，莉奈婭小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760381108,
					"content": "謝謝妳！露米，糖雕好了，現在要吃嗎…咦，已經睡著了，那我等一會再把糖雕給它吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈婭"
				}
			]
		}
	]
