			"dialogs": [
				{
					"id": 760380508,
					"content": "（或許<color=#FFCC33FF>愛諾</color>會對糖雕有興趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "老闆！我要一份糖雕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760380502,
					"content": "愛諾小姐~好久不見~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380503,
					"content": "嘿嘿，今天來鎮上幫人修東西，剛好來妳這買糖吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760380504,
					"content": "快、快，趁伊涅芙不在，幫我多做幾塊…或者做得甜一點也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760380505,
					"content": "這倒是沒問題…但您吃完之後，要記得刷牙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380506,
					"content": "我知道我知道，我每次吃糖之後都有刷牙，牙齒非常健康呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 760380507,
					"content": "哈哈…那您稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏娜亞塔"
				}
