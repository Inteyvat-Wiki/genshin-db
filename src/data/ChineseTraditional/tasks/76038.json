			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏娜亞塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "（或許<color=#FFCC33FF>菈烏瑪</color>會對糖雕有興趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "烏娜亞塔小姐，請為我做幾份糖雕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760380302,
					"content": "沒問題，菈烏瑪小姐。上次妳帶回去的糖雕，孩子都喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380303,
					"content": "呵呵，他們很喜歡，有的孩子拿著糖雕捨不得吃，一直到糖雕快融化了，才慢慢品嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760380304,
					"content": "這樣啊…嗯，下次我把工具帶著，直接到妳那邊去，現場做給孩子們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380305,
					"content": "這樣就太好了~孩子們一定會很高興的~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760380306,
					"content": "噢，扯遠了…我稍後就去做糖雕。等到做完了，就託人直接送到你們那邊去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380307,
					"content": "但在那之前…嘿嘿，我剛好有一個靈感~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380308,
					"content": "稍等一下喔，菈烏瑪小姐，我這就幫妳做一份特別的糖雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏娜亞塔"
				}
			]
		},
