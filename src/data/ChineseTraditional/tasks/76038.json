						760380703
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760380703,
					"content": "雅珂達，妳也不是第一次來買了，應該知道我的糖雕尺寸都是固定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380704,
					"content": "哎呀，今天我遇見好事了嘛。快點快點，做得稍微大一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760380705,
					"content": "好事？委託執行得很順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380706,
					"content": "嘿嘿嘿，那是當然，一個簡單的護送委託，輕輕鬆鬆，全部搞定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760380707,
					"content": "貨物、委託人，全都毫髮無損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760380708,
					"content": "不說了不說了，快點幫我做個大點的，等會我帶回去吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760380709,
					"content": "沒問題，稍等一下喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏娜亞塔"
				}
