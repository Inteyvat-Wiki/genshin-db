			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏娜亞塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "（或許<color=#FFCC33FF>奈芙爾</color>會對糖雕有興趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "給我來一份糖雕吧，烏娜亞塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760380103,
					"content": "奈芙爾老闆，妳怎麼有空過來買糖雕了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380104,
					"content": "偶爾出來散散步，對我的身體和精神都有好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760380105,
					"content": "吃點甜的，也有助於我進行思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760380106,
					"content": "好~稍等一下，我這就為您做一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380107,
					"content": "好。對了，這些錢給妳，下次雅珂達來的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760380108,
					"content": "幫她做得大一些？還是甜一些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380109,
					"content": "把這些錢給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760380110,
					"content": "就說：「奈芙爾出雙倍的錢，請妳在偷懶完畢後，幫她也帶一份糖雕回去。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				}
			]
		},
