			"dialogs": [
				{
					"id": 760380601,
					"content": "（或許<color=#FFCC33FF>伊涅芙</color>會對糖雕有興趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "請問，可以幫我做一份糖雕嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380603,
					"content": "好啊，這次還是帶回去給愛諾小姐的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380604,
					"content": "不是。愛諾要我過來，買一份屬於自己的漂亮糖雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380605,
					"content": "根據她說的，這是在訓練我進行「社會性活動」，以後也能更方便地進行採購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380606,
					"content": "這樣啊~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "烏娜亞塔"
				},
				{
					"id": 760380607,
					"content": "但我並不懂，因為我其實並不用攝取這麼多的糖分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380608,
					"content": "最後，搞不好還是會被愛諾偷偷吃掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380610,
					"content": "烏娜亞塔小姐，可以請您把糖雕的尺寸做得小一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380611,
					"content": "愛諾很想吃糖，但我覺得，她還是應該少吃一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760380612,
					"content": "交給我吧，嗯…讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏娜亞塔"
				}
