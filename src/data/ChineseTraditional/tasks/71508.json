			"dialogs": [
				{
					"id": 715080101,
					"content": "#真不愧是{F#妳}{M#你}啊…在「普爾希娜光釘」沒有受到什麼損傷的情況下，也清理了周圍的黑泥和怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715080102,
					"content": "#我有點慶幸海迪夫找來的幫手是{F#妳}{M#你}，如果是其他冒險家，可能真的沒法解決這些問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715080103,
					"content": "我可是很厲害的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715080104
					]
				},
				{
					"id": 715080104,
					"content": "嗯，是有目共睹的厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715080105,
					"content": "兩位礦工，也就是老圖和阿昊，已經回去休息了，不過…看這樣子，也很難直接將「光釘」搬進去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715080106,
					"content": "一路清理並不是一個好的辦法，因為愈接近噴口，黑泥重新湧出和覆蓋的速率愈高，必須直接處理掉黑泥源頭才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715080107,
					"content": "…看來得想一些別的方法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				}
