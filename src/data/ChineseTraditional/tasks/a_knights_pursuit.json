			"dialogs": [
				{
					"id": 100120501,
					"content": "…隨後趕到的騎士們解決了闖入近郊的魔物…它的力量遠超尋常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120502
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120502,
					"content": "而阿多諾為了拖延時間，拼命跟它纏鬥到了最後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120503
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120503,
					"content": "阿多諾…阿多諾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120504
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120504,
					"content": "哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120505
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120505,
					"content": "…沒事的，我的身體你也知道…要不是有你，早就撐不到今天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120506
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120506,
					"content": "能為了救人再拼一把，可比躺在床上…更像個騎士！…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120507
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120507,
					"content": "就是可惜…你幫我調理了那麼久…辛苦了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120508
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120508,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120509
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120509,
					"content": "洛恩…「仁藹騎士」的名號，還有第五小隊的隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120510
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120510,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120511
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120511,
					"content": "要是不喜歡，就都別管啦。你沒必要…活成任何人的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120512
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120513
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120513,
					"content": "…洛恩，跟我來一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120514
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120514,
					"content": "調查小隊的分析結果已經出來了。襲擊阿多諾的魔物，身上帶著烏薩的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120515
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120515,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120516
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120516,
					"content": "事到如今，你還打算保持沉默嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120517
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120517,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120518
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120518,
					"content": "這不是審訊，你可以繼續沉默，但我希望你能好好坦白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120519
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120519,
					"content": "…我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120520
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120520,
					"content": "我會交代一切，也會接受任何處置…但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120521
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120521,
					"content": "請再給我一個晚上的時間吧。等到明天，我會去騎士團說明一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120522
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120522,
					"content": "…這是一個騎士的誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120523
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120523,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120524
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120524,
					"content": "…跟你共事了這麼久，還是頭一次聽你用騎士之名發誓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120525
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120525,
					"content": "哈，我知道自己的騎士之名沒多少信用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120526
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120526,
					"content": "但如果算上「仁藹騎士」的願望，就夠分量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120527
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120527,
					"content": "這一次，就請你信守這個承諾吧，洛恩騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120528
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120528,
					"content": "抱歉啊…希奧多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120529
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120529,
					"content": "我本來想把隊長的位置交給洛恩，把「仁藹」的名號留給你…我知道你從小就憧憬這個稱號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120530
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120530,
					"content": "這不是您的錯，阿多諾先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120531
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120531,
					"content": "我沒有洛恩那樣的天分，輕而易舉就能通過騎士團的考核…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120532
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120532,
					"content": "努力了那麼多年，都還只是個見習醫師…又怎麼繼承騎士的名號呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120533
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120533,
					"content": "咳…醫師也好，騎士也罷，不都一樣是在保護大家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120534
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120534,
					"content": "在我心裡，你一直配得上「仁藹」的稱號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120535
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120535,
					"content": "…不，我其實做過很多錯事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120536
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120536,
					"content": "接下來…還要去做一件更大的錯事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120537
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120537,
					"content": "…這麼輕易就答應他了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120538
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120538,
					"content": "不然呢？難道還要他打份報告讓我批准？這可饒了我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120539
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120539,
					"content": "我知道阿多諾在他心裡的分量，所以也相信這句誓言的重量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120540
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120540,
					"content": "從前也有個傢伙用騎士的名義向我父親承諾過許多事，卻在最後背叛了他們的友情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120541
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120541,
					"content": "「歪曲的執念和時間的變遷，會讓朋友變成敵人，就像風改變它的方向那樣簡單。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120542
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120542,
					"content": "…是克利普斯說過的話？真讓人懷念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120543
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120543,
					"content": "你們從前…都互相認識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120544,
					"content": "三個意氣風發的年輕人，曾一起暢想過各自的未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120545
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120545,
					"content": "一名想成為騎士的富家{RUBY#[D]克利普斯}少爺，最後繼承了酒莊的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120546
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120546,
					"content": "一個總是壞規矩的愣頭{RUBY#[S]法爾伽}青，最後統領了整個騎士團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120547
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120547,
					"content": "最後那一{RUBY#[S]伊洛克}位…既沒有獲得嚮往的財富，也沒有獲得憧憬的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120548
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120548,
					"content": "只有執念，日復一日，堆積成塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120549,
						100120550
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120549,
					"content": "嚮往變成了執念…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120551
					]
				},
				{
					"id": 100120551,
					"content": "這就是伊洛克…被「博士」趁虛而入的原因嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120552,
					"content": "不管那個傢伙對他說了什麼，做出選擇的都是伊洛克自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120553
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120553,
					"content": "理解他的想法不代表憐憫他，更不代表我會重蹈什麼覆轍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120554
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120554,
					"content": "這一次，我一定會看住我的部下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120555
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120555,
					"content": "不——不好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120556
					],
					"speakerTitle": "列茲伯格"
				},
				{
					"id": 100120556,
					"content": "——我話都沒說完啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120557
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120557,
					"content": "這聲音…是從阿多諾那傳來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120558,
						100120559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120558,
					"content": "先不管信不信任…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120560
					]
				},
				{
					"id": 100120560,
					"content": "列茲伯格…這是什麼情況？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120561
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120561,
					"content": "阿多諾…不見了？還有洛恩和希奧多也是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120562,
					"content": "不知道，我剛剛巡邏的時候看這裡的門大開，往裡面一看…就已經是這樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120563
					],
					"speakerTitle": "列茲伯格"
				},
				{
					"id": 100120563,
					"content": "阿多諾隊長的狀況不可能下床，那…那會是誰帶走了他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120564
					],
					"speakerTitle": "列茲伯格"
				},
				{
					"id": 100120564,
					"content": "大團長——緊急情況！洛恩副隊長撞開巡邏的騎士，往郊外去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120565
					],
					"speakerTitle": "沃納"
				},
				{
					"id": 100120565,
					"content": "這小子…真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120566
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120566,
					"content": "他有留下什麼話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120567
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120567,
					"content": "留話？…他看起來急匆匆的，只說了句「閃開！」就衝遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120568
					],
					"speakerTitle": "沃納"
				},
				{
					"id": 100120568,
					"content": "你們有追上去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120569
					]
				},
				{
					"id": 100120569,
					"content": "當然！但是以洛恩副隊長的速度，我們恐怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120570
					],
					"speakerTitle": "沃納"
				},
				{
					"id": 100120570,
					"content": "能追到哪算哪，之後就交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120571
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120571,
					"content": "迪盧克、「榮譽騎士」，拜託你們陪我跑一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120559,
					"content": "快過去看看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120560
					]
				},
				{
					"id": 100120550,
					"content": "憧憬變成了嫉妒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120551
					]
				}
			]
		}
	]
}