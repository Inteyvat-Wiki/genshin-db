					"nextDialogs": [
						100120414
					],
					"speakerTitle": "莫里茲提爾"
				},
				{
					"id": 100120414,
					"content": "魔物？怎麼會跑到這裡…樣子也不太對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120415
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120415,
					"content": "啊…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120416
					],
					"speakerTitle": "莫里茲提爾"
				},
				{
					"id": 100120416,
					"content": "不要怕！有我在呢！站起來！跑回去！",
