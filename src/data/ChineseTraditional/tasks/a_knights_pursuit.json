						],
						"pointId": 16758
					}
				]
			},
			"dialogs": [
				{
					"id": 100120301,
					"content": "稍早之前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100120302
					]
				},
				{
					"id": 100120302,
					"content": "最後一隻…可要讓我好好盡興啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120303
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120303,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120304
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120304,
					"content": "…嗯？誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120305
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120305,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120306
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120306,
					"content": "嘖…逃跑了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120307
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120307,
					"content": "沒想到一位酒莊老闆居然對獵殺魔物這麼有心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120308
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120308,
					"content": "還是說你追獵的目標，不只是魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120309
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120309,
					"content": "那你想清除的，難道也只有「魔物」而已嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120310
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120310,
					"content": "以之前現場被清理的程度來看，「什麼」都沒被留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120311
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120311,
					"content": "哦？這我還是頭一次聽說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120312
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120312,
					"content": "那我們不妨一起檢查一下這裡的魔物，看看它們究竟有什麼異常，值得這麼多人關心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120313
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120313,
					"content": "…算了，我還是去追剩下那條漏網之魚吧。調查什麼的，還是不太適合我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120314
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120314,
					"content": "再會了，迪盧克…「前輩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120315
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120315,
					"content": "#…在{F#妳}{M#你}們來之前發生的事，差不多就是這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120316
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120316,
					"content": "洛恩那傢伙…葫蘆裡到底賣的什麼藥？我都有點想把「扛揍騎士」給升級成「欠揍騎士」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120317,
						100120318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120317,
					"content": "所以這些魔物怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				},
				{
					"id": 100120319,
					"content": "對啊！昨天聽阿多諾說…它們雖然有點古怪，但到現在也沒出現過什麼傷人紀錄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120320,
					"content": "一方面可能是有人一直在暗中清理它們，另一方面…似乎是因為它們在飢餓時，會優先攻擊自己的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120321
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120321,
					"content": "攻擊…自己的同伴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120322
					]
				},
				{
					"id": 100120322,
					"content": "嗯，之前只能收到少量的目擊情報，還不能確信。但留在這裡的魔物殘骸，身上的確有大量彼此攻擊的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120323
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120323,
					"content": "明明結伴成群，卻又自相殘殺…這不像是自然產生的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120324
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120324,
					"content": "的確很詭異…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120325
					]
				},
				{
					"id": 100120325,
					"content": "欸？可是如果這些魔物會彼此攻擊，那等它們自生自滅不就行了嗎？為什麼還要這麼提防？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120326,
					"content": "因為這種身具「烏薩血肉」的魔物，不只出現過一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120327
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120327,
					"content": "——法爾伽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120328,
					"content": "喲，真巧啊，榮譽騎士、派蒙，還有迪盧克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120329
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120329,
					"content": "…看來騎士團對這次的異常，並非一無所知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120330
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120330,
					"content": "嗯…伊洛克的悲劇，絕不能——也不會再上演一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120331
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120331,
					"content": "你剛才說的…是「烏薩血肉」？這也跟那個伊洛克有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120332,
					"content": "為了謀取超凡的力量，伊洛克曾經跟多托雷的切片合謀，從魔龍烏薩的血肉中提取蘊含其力量的血清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120333
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120333,
					"content": "在我們決定清算伊洛克的時候，他跟他的黨羽都注射了那種血清…給騎士團造成過不小的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120334
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120334,
					"content": "力量大增、嗜血成性，陷入瘋狂之時，甚至會彼此攻擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120335
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120335,
					"content": "諷刺的是，伊洛克最後沒能控制住那份力量，不僅向著自己的黨羽揮劍，也在瘋狂中走向了自毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120336
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120336,
					"content": "魔龍烏薩…究竟是什麼來頭能有這麼可怕的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120337,
						100120338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120337,
					"content": "聽說牠從千年前就已存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120339,
					"content": "不錯，是有這麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120340
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120340,
					"content": "那…那當初為什麼只是把牠封印了？難道連當初的大團長也殺不死牠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120341,
					"content": "不，這是因為…傳說中的魔龍烏薩，曾是一位「天使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120342
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120342,
					"content": "——啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120343,
					"content": "——啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120344
					]
				},
				{
					"id": 100120344,
					"content": "聽說在很久很久以前…眾天使都曾面臨一道兩難的選擇…而烏薩在那時做出的選擇，是留下自己的「力量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120345
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120345,
					"content": "失去心智，空餘力量的天使仍嚮往著人類的城邦，卻已不知道自己只是靠近，就會毀滅無數生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120346
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120346,
					"content": "所以，當初的溫妮莎才做出了將牠封印的決定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120347
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120347,
					"content": "嗯，但烏薩又在「博士」的誘導下再度甦醒…這的確是騎士團的失察，我不會迴避這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120348
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120348,
					"content": "比起追究往日的責任…還是盡早根除眼前的禍患更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120349
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120349,
					"content": "魔龍烏薩的血肉，為什麼會再次出現在這些魔物身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120350
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120350,
					"content": "…必須承認，伊洛克曾是被我們寄予厚望的騎士，很清楚騎士團的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120351
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120351,
					"content": "他在伏誅之前，就已經銷毀了所有關於實驗地點的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120352
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120352,
					"content": "我們至今都沒能找到實驗材料的所在。這其中，恐怕也少不了那個切片的協助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120353
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120353,
					"content": "#但現在，多托雷所有的後手都已在須彌被{NICKNAME}解決，我相信這你也有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120354
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120354,
					"content": "據我們推測，他的切片當初留在蒙德的某些「隱蔽手段」，也隨之失效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120355
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120355,
					"content": "啊，所以那些魔物，都是從那個什麼實驗地點裡跑出來的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120356,
					"content": "恐怕不只如此——還有人重啟了過去的實驗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120357
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120357,
					"content": "（過去的實驗…烏薩的血肉…天使的力量…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120358
					]
				},
				{
					"id": 100120358,
					"content": "（難道說…昨天在洛恩身上感覺到的力量…就是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120359
					]
				},
				{
					"id": 100120359,
					"content": "#{F#妳}{M#你}也有所察覺了吧？就在昨天那場風波裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120360
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120360,
					"content": "嗯，那時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120361
					]
				},
				{
					"id": 100120361,
					"content": "所以，洛恩有可能為了非凡的力量，染指了禁忌的實驗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120362
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120362,
					"content": "他…應該不是這麼壞的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120363,
					"content": "力量、財富、權力…有太多理由，能讓一個「好人」，變成「壞人」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120364
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120364,
					"content": "不管是烏薩還是伊洛克…在他們做出那個選擇之前，都不是妳想像中的「壞人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120365
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 100120365,
					"content": "但無論洛恩的出發點是什麼，我都有義務在他徹底走遠之前，把他給拉回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120366
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120366,
					"content": "那…現在怎麼辦，要繼續暗中調查嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120367,
					"content": "不必這麼麻煩，這就是我今天來荊夫港的目的——直接去找他問個清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120368
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 100120368,
					"content": "…狡猾的傢伙，還滿能逃的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120369
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120369,
					"content": "現在…還能再往哪跑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120370
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120370,
					"content": "喂——洛恩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120371
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120371,
					"content": "現在不是清理實驗體的時候了！騎士團已經有動作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120372
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120372,
					"content": "…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120373
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120373,
					"content": "今天荊夫港裡出現了好多我不認識的騎士…是昨天的測試暴露了？還是有被抓到的實驗體？難道說他們已經發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120374
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120374,
					"content": "遲早的事而已。不如說能拖這麼久，已經算我們走運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120375
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120375,
					"content": "呵…平時作為隊友有多可靠，作為對手就有多棘手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120376
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120376,
					"content": "那現在怎麼辦？！得快點躲起來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120377
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120377,
					"content": "…現在躲起來的話，回頭就很難再接近我們的目標了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120378
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120378,
					"content": "既然你還能跑過來報信，就證明騎士團沒徹底確定我們的嫌疑，趁這機會放手一搏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120379
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120379,
					"content": "就趁現在，再拿我做一次實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120380
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120380,
					"content": "現在？但之前的問題都還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120381
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120381,
					"content": "有什麼好猶豫的？我從一開始就說了，我跟你可不一樣，我做這些都是為了自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120382
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120382,
					"content": "想要掌握超凡的力量，就必須承擔超凡的風險…我早就做好這個覺悟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120383
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120383,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120384
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120384,
					"content": "還可是什麼？動作快點，別告訴我你忘了自己的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120385
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120385,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120386
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120386,
					"content": "——咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120387
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120387,
					"content": "不行！還是不行！…是劑量不夠？還是濃度不足？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120388
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120388,
					"content": "難道說…根本就不存在完美的結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120389
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120389,
					"content": "洛恩！還是先躲起來吧！我們再收集一些魔物來做實驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120390
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120390,
					"content": "…不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120391
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120391,
					"content": "躲？你以為騎士團還會給我們多少時間？我們從一開始…就只能賭這點時間差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120392
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120392,
					"content": "現在逃跑就證明了我們的嫌疑，往後只要一露面就會被騎士團盯上，那還怎麼接近目標？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120393
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120393,
					"content": "那…現在還能怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120394
					],
					"speakerTitle": "希奧多"
				},
				{
					"id": 100120394,
					"content": "…趁今晚，把目標給劫出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120395
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120395,
					"content": "就讓那個目標…陪著我們一起下「地獄」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120338,
					"content": "還跟初代大團長交過手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120318,
					"content": "值得你們這麼在意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				}
			]
		},
