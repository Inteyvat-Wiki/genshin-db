					}
				]
			},
			"dialogs": [
				{
					"id": 100120201,
					"content": "嘿！阿多諾爺爺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120202,
					"content": "哦哦，是小派蒙和榮譽騎士啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120203
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120203,
					"content": "您已經沒事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120204
					]
				},
				{
					"id": 100120204,
					"content": "哈哈，沒事了，昨天本來就沒真的受傷，請希奧多幫我看了看，就更沒事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120205
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120205,
					"content": "我這把老骨頭現在還能到處亂跑，也多虧了他平時幫忙調理啊。要不然，怕是早就埋進土裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120206
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120206,
					"content": "希奧多…就是那位第八小隊的見習醫師？看不出來他居然這麼厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120207,
					"content": "雖然他曾經立志成為在前線奮戰的騎士，但或許醫師，才是更適合他的道路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120208
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120208,
					"content": "#唉，先不說這個了，{F#妳}{M#你}們過來是想找洛恩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120209
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120209,
					"content": "嗯，他昨天試過「模擬訓練泡」之後就沒影了，在哪都找不到他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120210,
					"content": "他有回來過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120211
					]
				},
				{
					"id": 100120211,
					"content": "嗯，他早上的確丟了張字條過來…說是想為昨天的事道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120212
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120212,
					"content": "他承認昨天都是在演戲，也無法忍受枯燥的日常，但作為代替…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120213
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120213,
					"content": "「…我會去把那些礙事的魔物都殺乾淨。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120214
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 100120214,
					"content": "這麼個道歉法嗎？還真有他的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120215,
						100120216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100120215,
					"content": "洛恩自己去找魔物了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				},
				{
					"id": 100120217,
					"content": "嗯…尋常魔物對他構不成什麼威脅，但我有些擔心他像昨天那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120218
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120218,
					"content": "#能有{F#妳}{M#你}們照看一下，就再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120219
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120219,
					"content": "嗯，我會留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100120216,
					"content": "需不需要我們去看看他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				}
			]
		},
		{
			"id": 1001203,
