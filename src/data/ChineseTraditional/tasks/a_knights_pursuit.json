			"trigger": {
				"objectNames": [
					"阿多諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100120101,
					"content": "唉…可惜，我已經提不動劍了，就算跟著你們去，恐怕也只會跟昨天一樣礙事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120102
					],
					"speakerTitle": "阿多諾"
				},
				{
					"id": 100120102,
					"content": "看來今天的日常工作，只有我一個人來做了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿多諾"
				}
			]
		},
		{
			"id": 1001202,
			"completionStepIds": [
				1001202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
