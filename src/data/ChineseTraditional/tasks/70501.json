			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "不知道這機關能不能製作甜品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010102,
					"content": "這次要做什麼菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "#旅行者，{F#妳}{M#你}來得正好。本仙剛剛想好這次要做的菜色，其名為「布丁」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010104,
					"content": "這種叫做「布丁」的菜色，是我從最近流行的食譜裡看來的。據說香軟可口，是款不錯的甜品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010105,
					"content": "本仙在其原有做法上稍加改造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010106,
					"content": "此外，加入了「稻米」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010107,
					"content": "改造後的這道菜理應由本仙親自賜名，唔…就叫它「米飯布丁」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010108,
					"content": "怎麼聽起來很有飽足感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "這道甜品重在「稻米」的品質，本仙當即啟動「機關烹飪神機」，令它尋找上等稻米。一路奔波，來到了此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010110,
					"content": "旅行者，來得早不如來得巧，再為本仙跑一趟，取來上等稻米吧。據機關顯示，那種稻米應該離這裡不遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010111,
					"content": "為什麼又是我去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "調整機關費時，本仙暫時分身乏術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010114,
					"content": "#{F#妳}{M#你}手腳俐落，是不可多得的幫手。{F#妳}{M#你}就再替本仙跑一趟吧，等「米飯布丁」做出來，自然少不了{F#妳}{M#你}的份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010115,
					"content": "#總之，就有勞{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010116,
					"content": "機關烹飪神機…啟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010117,
					"content": "#旅行者，本仙已啟動機關，{F#妳}{M#你}快循著氣息的蹤跡，去把本仙要的那種稻米拿回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010112,
					"content": "您自己不是會飛嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布倫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "#謝謝{F#妳}{M#你}們，謝謝{F#妳}{M#你}們救了我…我叫布倫，是個商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010202,
					"content": "唉…真是倒楣。我本來正在運一批貨物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010203,
					"content": "但沒想到…才走到半路，突然被一群魔物襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010204,
					"content": "我一個勁地向前跑，顧不上車裡的貨物，也來不及辨認方向…一直跑到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010205,
					"content": "到了這裡之後，我還以為徹底甩掉它們了，就想要下車清點一下貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010206,
					"content": "#但是它們突然又不知道從哪鑽了出來…幸好有{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010207,
					"content": "你運的是什麼貨物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "我運的是一批食材，稻米之類的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010209,
					"content": "看來這就是那位仙人要我們找的稻米了，但是，看起來好像也沒剩下多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705010210,
					"content": "能賣一些稻米給我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "你要買稻米？不是我不賣，只是…我在逃跑的時候，車上的貨物基本上都丟在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010212,
					"content": "現在那些魔物只怕是把這些貨物當做戰利品，搬回它們的營地裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010213,
					"content": "我也正在頭疼，怎麼才能把那些貨物拿回來，要是拿不回來的話，這趟生意我可就虧慘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010214,
					"content": "#旅行者…我看{F#妳}{M#你}剛才的身手很好，{F#妳}{M#你}能幫我去拿回這些貨物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010215,
					"content": "#要、要是{F#妳}{M#你}願意幫我的話！{F#妳}{M#你}要的稻米，{F#妳}{M#你}要多少我就送給{F#妳}{M#你}多少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010216,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "#謝謝{F#妳}{M#你}！那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010220,
					"content": "#{F#妳}{M#你}帶著我的貨運熱氣球去吧，把那些貨物放在這上面就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010221,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者，我就在這等著{F#妳}{M#你}，拿到貨物之後，就拿回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布倫"
				},
				{
					"id": 705010218,
					"content": "我應該拿不動那麼多貨物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "沒關係，這個我有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "布倫"
				}
			]
		},
		{
