			"dialogs": [
				{
					"id": 250250101,
					"content": "拜託啦，稍微上岸來一下好不好？我要打掃這邊的池子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250102,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "懶懶的鰭游龍"
				},
				{
					"id": 250250103,
					"content": "乖孩子，上來啦。不然我就要把你抱上來了喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250104,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "懶懶的鰭游龍"
				},
				{
					"id": 250250105,
					"content": "嗚哇…一下子就游走了，要怎麼抱住牠啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250106,
					"content": "妳在做什麼啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "#欸？{F#妳}{M#你}是來泡溫泉的嗎？不好意思，我正在清理這邊的池子，可能要稍等一下喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250108,
					"content": "而且這孩子說什麼也不肯上岸，唉…我還有很多池子要清理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "佩蕾·努伊"
				},
				{
					"id": 250250109,
					"content": "難道是我前幾天強行把牠抱出來，讓這孩子生氣了嗎？真是難搞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "佩蕾·努伊"
				}
			]
		},
