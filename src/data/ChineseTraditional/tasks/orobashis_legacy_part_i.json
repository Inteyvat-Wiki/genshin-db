			"dialogs": [
				{
					"id": 721290601,
					"content": "怎麼？這麼快就把鎮物修復了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721290602,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "哦哦，沒關係的，請慢慢來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				},
				{
					"id": 721290603,
					"content": "還正在努力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "實在不行的話也請不要勉強，請別在這個危險的地方逗留太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
