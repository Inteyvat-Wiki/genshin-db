			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "形狀奇特的石燈，似乎放射著令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721290102,
					"content": "這個石燈籠好奇怪…讓人感覺怪不舒服的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290103,
					"content": "欸，好像燈柱上寫著什麼字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290104,
					"content": "「路過的旅人，關於此鎮物如有疑問，請至無想刃狹間，與梶先生商談。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721290105,
					"content": "字看起來很新，似乎是不久前寫下的。下面還有幾列被雨水沖刷模糊的小字：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721290106,
					"content": "「…請轉告梶先生，我們試過…但可惜…或許在附近能找到…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721290107,
					"content": "「…請梶先生盡快一同來避難地點，他的家人很想他。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721290108,
					"content": "這個梶先生似乎對石燈籠很在意的樣子，我們不如去無想刃狹間問問他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
