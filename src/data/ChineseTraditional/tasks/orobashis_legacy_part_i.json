			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "#{F#妳}{M#你}注視著鎮物，忽然，一股奇特的能量似乎湧向了{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "接觸鎮物"
				},
				{
					"id": 721290202,
					"content": "#{F#妳}{M#你}意識到它並非抗拒著{F#妳}{M#你}，而是向{F#妳}{M#你}要求著什麼……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "接觸鎮物"
				},
				{
					"id": 721290203,
					"content": "唔…這座鎮物好像少了些什麼東西，我們去附近找找看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290204,
					"content": "使用元素視野調查一下附近彌散的元素痕跡，說不定能發現什麼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
