			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310101,
					"content": "原來如此…沒想到是這麼一回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310102
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310102,
					"content": "哦哦，看起來有新發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310103,
					"content": "裡面的訊息，是一個名叫伯陽的術士所留。他…就是我想調查的那個失蹤的祖先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310104
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310104,
					"content": "這麼多…全是妳的祖先留下的訊息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310105,
					"content": "數百年前，高人將太威儀盤交給我的祖先。他們兄弟二人帶著這件法寶來到層岩巨淵，參與擊退坎瑞亞魔獸的戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310106
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310106,
					"content": "出發時是兩人，回來的僅剩一人，而且已變得瘋瘋癲癲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310107
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310107,
					"content": "…業障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310108
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310108,
					"content": "嗯。有一種可能，他們是與夜叉浮舍並肩作戰時沾染了業障之力。他們都沒有神之眼，無法抵禦太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310109
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310109,
					"content": "看記錄，記下這一切的人…也永遠留在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310110
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310111
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310111,
					"content": "可惡！真沒辦法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310112,
					"content": "怎麼辦，我們要死在這裡了嗎？我不要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310113,
					"content": "我想起一件事，請稍等，馬上確認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310114
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310114,
					"content": "唔…嗯。嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310115
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310115,
					"content": "#{NICKNAME}，我有新發現哦。是這樣的，來的路上我一直在研究那封遺囑，卻沒細想過遺囑是夾在怎樣的書裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310116
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310116,
					"content": "雖然不是逐字牢記，但我也讀過那本書，其中記載了這樣一個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310117
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310117,
					"content": "千年前，仙家製作法寶以封印惡獸，後結交凡人知己，便將法寶交由知己，作法器用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310118
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310118,
					"content": "數年過去，山中有大魔作祟，凡人與仙家便聯手以此器斬妖除魔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310119
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310119,
					"content": "不止如此，書中還提到：「仙力與人力合一，可轉斗移星，舉天地之威。器為證，人仙共存，天人合一。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310120
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310120,
					"content": "我是仙人與人的混血，假如我的力量能起作用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310121
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310121,
					"content": "生效了！雖然我的力量還不夠強，效果轉瞬即逝…但思路是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310122
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310122,
					"content": "太威儀盤裡似乎有什麼東西被啟動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310123
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310123,
					"content": "黃天之威，五方之神。夜叉種民，共執璣衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310124
					],
					"speakerTitle": "浮舍"
				},
				{
					"id": 10310124,
					"content": "黃天之威，五方之神。夜叉種民，共執璣衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310125
					],
					"speakerTitle": "夜蘭的太爺"
				},
				{
					"id": 10310125,
					"content": "是封印時的聲音。浮舍和祖太爺…一同完成了這個空間最上層的封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310126
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310127
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310127,
					"content": "…原來是這樣，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310128
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310128,
					"content": "（等等，這麼說來，之前在層岩巨淵底部見到的那塊巨大晶石…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310129
					]
				},
				{
					"id": 10310129,
					"content": "（…當時，那塊晶石砸中了遺蹟巨蛇…似乎有什麼力量對衝了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310130
					]
				},
				{
					"id": 10310130,
					"content": "（難道就是那種力量的對衝導致了這片空間延遲甦醒並吞沒我們？或者是，那次撞擊導致了地面上的入口鬆動？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310131
					]
				},
				{
					"id": 10310131,
					"content": "（…另外，我們似乎沒有在這個空間裡見到過來自深淵的怪物…這之間，會有什麼關係嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310132
					]
				},
				{
					"id": 10310132,
					"content": "各位！我們先回去找一斗和阿忍，然後我有個建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310133
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310133,
					"content": "#走不動了…我不想留在這裡，嗚嗚，我也不想死，{NICKNAME}，我捨不得{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310134,
					"content": "派蒙，再堅持一下好嗎？相信我，我們還有機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310135
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310135,
					"content": "走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 103102,
			"completionStepIds": [
				103102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"103102",
							"2"
						],
						"stepId": 103102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久岐忍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310201,
					"content": "阿忍，一斗，我們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310202
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310202,
					"content": "一斗怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310203
					]
				},
				{
					"id": 10310203,
					"content": "消耗太大，還沒醒來。不過沒有性命之憂，請放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310204
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310204,
					"content": "倒是你們，看你的表情，恐怕有發現…而且是讓人不怎麼高興的發現，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310205
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310205,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310206,
					"content": "我們找到太威儀盤了，其中有前人留下的訊息。看起來…這片空間無法被突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310207
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310207,
					"content": "上一個持有這件法器的人，似乎也永遠留在了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310208
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310208,
					"content": "…這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310209
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310209,
					"content": "還沒完呢，聽我說，剛才我試過了，向太威儀盤注入力量，它就有反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310210
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310210,
					"content": "但也只是觸發了封印時的記錄而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310211
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310211,
					"content": "不不，問題不在內容，而是方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310212
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310212,
					"content": "還記得書裡說的嗎？「仙力與人力合一，可轉斗移星，舉天地之威。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310213
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310213,
					"content": "只有仙人與人的力量彙聚起來，才能最大程度啟動太威儀盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310214
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310214,
					"content": "我是混血，太威儀盤對我有反應，證明這個系統還在作用。而我們的隊伍裡恰好有完全的仙人和繼承了術法的凡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310215
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310215,
					"content": "…有意思，原來妳是這麼想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310216
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310216,
					"content": "需要魈和夜蘭合作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310217
					]
				},
				{
					"id": 10310217,
					"content": "仙人和人類同時提供力量嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310218
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310218,
					"content": "對。假如我猜得沒錯，你們對太威儀盤最大程度注入力量，能再次完全啟動它，甚至逆轉它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310219
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310219,
					"content": "它上一次被用來封印這處空間與層岩巨淵的接口，如果我們能逆轉它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310220
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310220,
					"content": "就能出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310221
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310221,
					"content": "太好了！我們還有救是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310222,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310223
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310223,
					"content": "…這個想法，不無道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310224
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310224,
					"content": "好，大家稍事休息，等準備完畢，就來嘗試這個方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310225
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310225,
					"content": "眾人休息過後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310226
					]
				},
				{
					"id": 10310226,
					"content": "#喂{NICKNAME}，我好緊張啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310227,
					"content": "別怕，一定能行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310228
					]
				},
				{
					"id": 10310228,
					"content": "夜蘭、魈，可以了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310229
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310229,
					"content": "萬事妥當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310230
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310230,
					"content": "定當全力以赴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310231
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310231,
					"content": "不過煙緋，有件事你得做好心理準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310232
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310232,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310233
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310233,
					"content": "法寶太威儀盤，妳怕是帶不出去了。根據我的判斷，這片秘境裡的一切都是時空與回憶錯亂的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310234
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310234,
					"content": "我們每個人都帶著不同目的，而這片空間裡出現的一切，都像在回應我們的想像和猜測。恐怖，但也奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310235
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310235,
					"content": "這個空間，已經不單單是空間了。不知是受何種高等力量影響…它一直在讀取我們，再用幻象回應我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310236
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310236,
					"content": "此外，根據層岩歷史，這個空間恐怕已經存在很久。…它究竟是如何誕生的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310237
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310237,
					"content": "我記得，空間外側有一條巨蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310238
					]
				},
				{
					"id": 10310238,
					"content": "噢，你說那個啊。當時我也在場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310239
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310239,
					"content": "欸？等等…難道那一箭是妳幹的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310240,
					"content": "除了我還能是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310241,
						10310242
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310241,
					"content": "晶石攻擊巨蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310243
					]
				},
				{
					"id": 10310243,
					"content": "那條巨蛇應該是坎瑞亞文明的遺留物…晶石對牠格外有效…難道是這兩者的力量之間存在衝突關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310244
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310244,
					"content": "如果是這樣的話…很抱歉，或許我該為大家的遭遇負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310245
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310245,
					"content": "不不，你不是為了救我們和處理問題嘛！不能怪你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310246,
					"content": "…或許吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310247
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310247,
					"content": "這片奇異空間堪比活物，利用各種幻覺蒙蔽我們。實際上，我們所見的人，所走的路…早在五百年前就該不存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310248
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310248,
					"content": "另外，這裡大部分事物都靜止著。既然如此，若真能逃出去，等時間真正流動起來……太威儀盤應該就會消失吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310249
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310249,
					"content": "其實，我也這麼想。可正因為是這樣，我們能找到太威儀盤就是一種奇蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310250
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310250,
					"content": "整件事，像是用一柄本不該存在的槍來擊破桎梏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310251
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310251,
					"content": "聽起來不切實際，但也是最後的可能性。…是誰的願望喚來了這件法寶呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310252
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310252,
					"content": "或許，是我們所有人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310253
					]
				},
				{
					"id": 10310253,
					"content": "#是啊。不過，也許還有一個原因，是{F#妳}{M#你}對「追尋」的執著特別強烈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310254
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310254,
					"content": "#很可惜，找到的不是你的家人…但如果那個人在這裡，一定也非常希望{F#妳}{M#你}能得救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310255
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310255,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310256
					]
				},
				{
					"id": 10310256,
					"content": "我們這些人能像這樣巧聚在此，不可不說是一件趣事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310257
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310257,
					"content": "如果這也是命運，就讓命運在我們手中扭轉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310258
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310258,
					"content": "老大交給我和阿丑，我們準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310259
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310259,
					"content": "旅行者，照看好派蒙。煙緋，必要時靠近我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310260
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310260,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310261
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310261,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310262
					]
				},
				{
					"id": 10310262,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310263
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310263,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310242,
					"content": "與地面開裂有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310243
					]
				}
			]
		},
		{
			"id": 103104,
			"completionStepIds": [
				103104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"103104",
							"2"
						],
						"stepId": 103104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10310401,
					"content": "總算逃離危險之地，眾人紛紛休息閒聊起來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310402
					]
				},
				{
					"id": 10310402,
					"content": "剛才真是千鈞一髮呀！差點以為魈要留在裡面了…幸好你沒事，嚇死我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310403
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310403,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310404
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310404,
					"content": "我知道你怎麼想，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310405
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310405,
					"content": "罷了。你有些想法非一日所成，不是我們三言兩語可以說動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310406
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310406,
					"content": "到最後，我們的戰略方針都無法達成統一。但能從那種地方逃出來，確實多虧你。謝謝你救下所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310407,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310408
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310408,
					"content": "不。那不是我一個人的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310409
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310409,
					"content": "也謝謝夜蘭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310410
					]
				},
				{
					"id": 10310410,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310411,
					"content": "幾位看起來都沒有外傷，只是消耗過度。多休息吧，不用急著離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310412,
					"content": "那我先去檢查一下附近有沒有其他異狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310413
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310413,
					"content": "走開了呢…明明還想跟她說幾句謝謝的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310414,
					"content": "夜蘭可能是真不覺得自己做了什麼吧。她也是真心認為魈幫助了大家…受人恩惠，反而不好說什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310415
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310415,
					"content": "不過魈確實也不容易被說動，我想，夜蘭可能放棄說服他了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310416
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310416,
					"content": "魈，她在批評你欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310417,
					"content": "不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310418
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310418,
					"content": "#{F#妳}{M#你}們所言非虛，沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310419
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310419,
					"content": "#{F#妳}{M#你}們的意見，我會考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310420
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310420,
					"content": "也算是想開了一點吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310421
					]
				},
				{
					"id": 10310421,
					"content": "真的？那太好了，感覺自己做了一件大事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310422
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310422,
					"content": "這次情況兇險，缺少任何一個人我們都沒法從地下離開。我很慶幸，沒在過程中失去任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310423
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310423,
					"content": "對了，放牛的還沒醒，不會就這樣一直睡下去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310424,
					"content": "不會吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310425
					]
				},
				{
					"id": 10310425,
					"content": "快去看看他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310426,
					"content": "呼啊——！睡得好爽，唔…嗯？你們幹嘛，怎麼這樣看著我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310427
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310427,
					"content": "你身上有哪裡不舒服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310428
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310428,
					"content": "哞，哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310429
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310429,
					"content": "腦子？腦子怎麼樣了，有沒有撞壞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310430,
					"content": "不舒服的話要說出來哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310431
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310431,
					"content": "本來就不聰明，要是再把腦袋弄壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310432,
					"content": "什麼跟什麼啊，本大爺好得很！狠狠睡了一覺，現在渾身是勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310433
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310433,
					"content": "總覺得忘了什麼事…哦對！哎？我們不是在地下嗎？怎麼上來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310434
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310434,
					"content": "說來話長，就先不說了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310435
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310435,
					"content": "一斗，這次我們能脫險，實在是多虧了你和阿忍還有阿丑全力相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310436
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310436,
					"content": "你們是因為我才被捲入此事，可以的話，請讓我賠禮道歉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310437
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310437,
					"content": "別這麼說。妳幫了我們，我們為妳做些事也是應該的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310438
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310438,
					"content": "要不是妳，我們這會可能是在璃月的牢房裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310439
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310439,
					"content": "這話不夠全面。應該是你在牢裡，我在牢外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310440
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310440,
					"content": "哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310441
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310441,
					"content": "哈哈哈，也是呢。那就當是認識新朋友好了，作為慶祝，我帶你們到璃月港觀光吃飯，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310442
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310442,
					"content": "這個好這個好！被妳一說，呃…肚子好餓…走都走不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310443
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310443,
					"content": "我也餓了，師姐，不如我們現在就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310444
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310444,
					"content": "我也要去！我也要去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310445,
					"content": "派蒙，我們還有事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310446
					]
				},
				{
					"id": 10310446,
					"content": "欸？好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310447,
					"content": "#那麼{NICKNAME}，這兩位稻妻朋友就交給我啦。{F#妳}{M#你}也早點回去休息吧，這次真是辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310448,
						10310449
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310448,
					"content": "嗯。大家都很不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310450
					]
				},
				{
					"id": 10310450,
					"content": "啊對，夜蘭現在不在…那我欠她的一頓茶就先當不存在好了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310451
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310451,
					"content": "哞！哞哞，哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310452
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310452,
					"content": "嗯？啊？這樣啊，唔唔…好，我幫你轉達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310453
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310453,
					"content": "#{NICKNAME}、飛行堇瓜，阿丑有兩句話想託{F#妳}{M#你}們轉達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310454
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310454,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310455
					]
				},
				{
					"id": 10310455,
					"content": "什麼什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310456,
					"content": "我也要聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310457
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310457,
					"content": "那我也要聽，帶我一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310458
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310458,
					"content": "一斗將阿丑剛才說的話翻譯給大家聽…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10310459
					]
				},
				{
					"id": 10310459,
					"content": "有道理，就這麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310460,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310461
					]
				},
				{
					"id": 10310461,
					"content": "阿丑這傢伙，外表明明是這樣，居然也非常細心溫柔，真是沒想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310462,
					"content": "哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310463
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310463,
					"content": "深刻的道理往往都很簡單，所以，我認為阿丑的話或許會有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310464
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310464,
					"content": "沒錯，這件事就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310465
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310465,
					"content": "那一斗、阿忍、阿丑，我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310466
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10310466,
					"content": "噢！吃飯吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310467
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10310467,
					"content": "哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310468
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10310468,
					"content": "下次見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310469
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10310469,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310470
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310470,
					"content": "魈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310471
					]
				},
				{
					"id": 10310471,
					"content": "忙完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310472
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310472,
					"content": "我們倒也沒在忙啦…送送朋友而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310473
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310473,
					"content": "還在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310474
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310474,
					"content": "剛才看到那兩位稻妻人跟著煙緋離開，是往璃月港去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310475
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310475,
					"content": "#{F#妳}{M#你}們不一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310476
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310476,
					"content": "我們還有些話要跟魈說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310477
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310477,
					"content": "嗯，我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310478
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310478,
					"content": "我檢查過四周環境了。目前其他地方暫無異狀，這件事算是告一段落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310479
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310479,
					"content": "接下來的，應該就是保密問題了吧。呵呵…希望那兩位遠方來客能對本次事件三緘其口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310480
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310480,
					"content": "啊啊知道了啦！我們也會幫著提醒他們閉嘴的，妳可不要對他們出手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310481
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310481,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310482
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310482,
					"content": "夜蘭有時心眼真壞呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310483
					]
				},
				{
					"id": 10310483,
					"content": "#被{F#妳}{M#你}發現了？哈哈，那玩笑就到此為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310484
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310484,
					"content": "這次多虧各位鼎力相助。我會將此事牢記在心中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310485
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310485,
					"content": "地下那片詭異的空間何以誕生，又為何能悄然存在如此多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310486
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310486,
					"content": "關於這些，我會繼續調查。我總覺得，這些事背後有著更為深刻…不可告人的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310487
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310487,
					"content": "此外，似乎有人在最後關頭出手相助…雖是好事，但我竟感覺不出對方的來歷，看來也是位高人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310488
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310488,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310489
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310489,
					"content": "放心，現在不是研究這些的時候。還有些後續工作需要彙報處理，我也回璃月港一趟，就此別過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310490
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10310490,
					"content": "夜蘭再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310491
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310491,
					"content": "…好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310492
					]
				},
				{
					"id": 10310492,
					"content": "#{F#妳}{M#你}知道我在等{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310493
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310493,
					"content": "是啊，很明顯哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310494
					]
				},
				{
					"id": 10310494,
					"content": "……是嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310495
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310495,
					"content": "#我想去一個地方。{F#妳}{M#你}若有閒暇，也一起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310496
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10310496,
					"content": "要去哪裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10310497
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10310497,
					"content": "一個，與夜叉有關的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 10310449,
					"content": "你們要玩得開心哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10310450
					]
				}
			]
		},
