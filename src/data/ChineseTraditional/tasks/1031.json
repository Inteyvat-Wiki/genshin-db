	"talks": [
		{
			"id": 103101,
			"completionStepIds": [
				103101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"103101",
							"2"
						],
						"stepId": 103101,
						"stateName": "QUEST_STATE_UNFINISHED"
