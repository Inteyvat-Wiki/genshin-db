			"dialogs": [
				{
					"id": 750350801,
					"content": "唉呀呀，我的工具回來了，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350802,
					"content": "剛才沒看清楚，真是一顆漂亮的寶石啊，像鳥爪一樣透著肉色的黃…呸！不應該用那群壞東西來比喻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350803,
					"content": "像天剛矇矇亮、太陽初升那種早晨一樣的天色…嗯，這個形容還不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350804,
					"content": "大師的比喻好普通…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "我又不是敘事人，唉呀，只要可以記住自然中美麗的顏色就好了…如何美麗地說出口就不是我的專業了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350808,
					"content": "#寶石就交給我吧。按照剛才說的，我會免費替{F#妳}{M#你}們加工，當作找回工具的謝禮。時間嘛…等到兩天後來寶石鋪裡拿吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350806,
					"content": "這就是「考察」的意義嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "#哦？{F#妳}{M#你}也聽說過考察啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
