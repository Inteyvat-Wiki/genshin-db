			"dialogs": [
				{
					"id": 750350101,
					"content": "請問…唔…你是庫拉霍大師嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350102,
					"content": "這是我的名字沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350103,
					"content": "嘿嘿，原來你就是在考察的珠寶大師，我們是伊蜜推薦過來的！剛才看到你在盯著樹看，難道這也是考察嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350104,
					"content": "#呃…其實…算了，現在已經不重要了，唉…{F#妳}{M#你}們是有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350105,
					"content": "#我們帶了一顆漂亮的寶石來，想請你為我們的{REALNAME[ID(2)|SHOWHOST(true)]}加工一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350106,
					"content": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}，快把寶石拿出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350107,
					"content": "呀！呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350109,
					"content": "#耳邊傳來鳥類振翅撲騰的聲音…\\n等反應過來時一看，寶石的蹤影已經消失在{REALNAME[ID(2)|SHOWHOST(true)]}的爪子裡了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "唔、唔嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "哇，等等，寶石呢？那麼大的一顆寶石跑去哪裡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350112,
					"content": "好像被鳥叼走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "怎麼會這樣，這裡的鳥還會搶東西？太沒有禮貌了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350114,
					"content": "唔呀！唔呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "#其實…我剛才要說的就是這件事，就算寶石沒被搶走，我也沒辦法幫{F#妳}{M#你}們雕刻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350116,
					"content": "因為我的工具也被這群該死的鳥搶走了啊！我剛才正是在仔仔細細一個個看，看工具到底在哪隻鳥的爪子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "庫拉霍"
				},
				{
					"id": 750350117,
					"content": "#還…還有這種事？好壞的壞鳥，{NICKNAME}，我們趕快去把寶石追回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350118,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "別忘了還有我的工具——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫拉霍"
				}
			]
		},
