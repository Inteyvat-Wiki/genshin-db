					"nextDialogs": [
						750351207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351207,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#唔…回到這裡以後，{REALNAME[ID(2)|SHOWHOST(true)]}看起來就有點激動，是不是有什麼話要跟我和{NICKNAME}說呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351209,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "欸？是要我們轉過身去的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351212,
					"content": "不會是準備了什麼驚喜吧？嘿嘿，這傢伙的心思簡直和泡泡一樣透明，太好猜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351213,
					"content": "那我們只好配合一點囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351214,
					"content": "#{F#妳}{M#你}和派蒙轉過了身去，只聽到「叮鈴咣噹」的聲音響個不停。\\n不知道{REALNAME[ID(2)|SHOWHOST(true)]}在擺弄些什麼…\\n過了一下子，{REALNAME[ID(2)|SHOWHOST(true)]}「呀呀！」叫了一聲，大概是到了可以轉身的時機…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "出現了好多東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351216,
					"content": "讓我看看…很直的樹枝、圓圓的石頭…還有顏色和氣味都奇奇怪怪，不知道放了幾天的料理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351217,
					"content": "#這些都是你自己小心翼翼收集起來的東西嗎？要送給我和{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351218,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "不過放了太久的料理不能吃哦。不管是我們還是你，吃了都會弄壞肚子的，所以這個要先處理掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351220,
					"content": "嗚呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "但是這根樹枝很了不起！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "對，感覺拿在手裡揮舞起來，會和寶劍一樣威風喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351225,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "哼哼，我們就不客氣地全都收下了！嘿嘿，就放在我小金庫的背包夾層裡面吧，說不定哪天就會用到了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351227,
					"content": "#唔…既然{REALNAME[ID(2)|SHOWHOST(true)]}送了我們東西，我們也送{REALNAME[ID(2)|SHOWHOST(true)]}點什麼當作回禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351228,
					"content": "就讓我看看我的小金庫裡有什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351229,
					"content": "難得看到妳這麼大方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#畢竟是{REALNAME[ID(2)|SHOWHOST(true)]}的心意嘛，當然要重視了！還有啊，東西太重我都要飛不起來了，剛好送牠一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351233,
					"content": "#鐺鐺！是亮晶晶的寶石，{REALNAME[ID(2)|SHOWHOST(true)]}喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351234,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "哦哦，這麼開心，真是送對了…哇小心，不要掉到地上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351236,
					"content": "#…總感覺{REALNAME[ID(2)|SHOWHOST(true)]}這樣抓著，很快就會弄丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351237,
					"content": "不然我們去「回聲之子」那邊，找那種專業的寶石加工匠加工一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
