							7600.912
						],
						"pointId": 8840
					}
				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "#{F#妳}{M#你}們來了啊，庫拉霍師傅已經把加工好的寶石留在鋪子裡了，囑咐我說要親手交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 750350302,
					"content": "欸？庫拉霍大師今天也不在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350303,
					"content": "對啊，他又出去考察了。他還順便打了可以背在身上的鎖，說是為了防止工具被偷，好奇怪…會有人想偷我們的雕刻工具拿去賣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 750350304,
					"content": "當然不是啦！是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350305,
					"content": "（…原來伊蜜還不知道是被鳥搶走的…還是給大師留點面子吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350306,
					"content": "是…是有人覺得這個方法可以偷師吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350307,
					"content": "不管了…那寶石我們就收下啦！這個形狀好漂亮，真不愧是大師呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350308,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#看起來{REALNAME[ID(2)|SHOWHOST(true)]}也很喜歡喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350310,
					"content": "#替{REALNAME[ID(2)|SHOWHOST(true)]}謝謝你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "#嘿嘿，只要{F#妳}{M#你}們的小龍喜歡就好，謝意我會轉達給庫拉霍師傅的，記得常來喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蜜"
				}
			]
		},
