			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710202,
					"content": "對不起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "嗯？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710204,
					"content": "我不小心把盒子和花弄壞了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "弄、弄壞了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710206,
					"content": "嗚…那可是我專門挑出來的花，那麼好的花，可不是能輕易找到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710207,
					"content": "#雪山真有這麼危險嗎？連{F#妳}{M#你}這樣的冒險家都會失手，連一盒花都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710208,
					"content": "#不過，還是謝謝{F#妳}{M#你}幫我跑這一趟，這些東西給{F#妳}{M#你}，請收下吧，我要去打理店裡的花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710209,
					"content": "唉，不然…我還是再用莎拉小姐的辦法試試吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
