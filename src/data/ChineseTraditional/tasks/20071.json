			"dialogs": [
				{
					"id": 200710301,
					"content": "之前存在雪山上的花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710302
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710302,
					"content": "加上這次的都在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710303
					]
				},
				{
					"id": 200710303,
					"content": "都拿到了嗎？太好了，快給我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710304
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710304,
					"content": "呼呼，看起來不錯呀，嗯…看來這個方法確實可行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710305
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710305,
					"content": "#不過，雪山距離蒙德城有些太遠了，總不能每次都麻煩{F#妳}{M#你}，以後得想個方便的辦法才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710306
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200710306,
					"content": "#總之，謝謝{F#妳}{M#你}來幫忙呀，這些是給{F#妳}{M#你}的謝禮，請拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
