	],
	"talks": [
		{
			"id": 7151601,
			"completionStepIds": [
				7151601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151601",
							"2"
						],
						"stepId": 7151601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"應公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715160101,
					"content": "#這齣戲算是完美落幕了，年輕人，{F#妳}{M#你}做得不錯。感覺怎麼樣，演紙映劇難不難？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160102,
						715160104
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160102,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160103
					]
				},
				{
					"id": 715160103,
					"content": "紙映劇和璃月戲不同，一個人也能演，的確是輕鬆不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160106,
					"content": "#我覺得{NICKNAME}做得夠好啦，紙映劇本身也很有意思，我還想看新的故事，應公大叔，{F#妳}{M#你}什麼時候再演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160107,
					"content": "哈哈，有人喜歡就好。至於什麼時候再演，我還真說不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160108
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160108,
					"content": "本來嘛，演紙映劇給孩子們看算是我的業餘愛好。這一出演完了，我就回雲翰社去管行頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160109
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160109,
					"content": "欸？大叔你是雲翰社的人嗎？那你一定也會唱璃月戲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160110,
					"content": "唱是會唱，常年泡在雲翰社裡，誰不會哼幾句？但要跟我們雲老闆比還是差遠囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160111
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160111,
					"content": "我啊，屬於幕後忙活的那撥人。戲臺上用的槍桿子、大旗、各式各樣的戲服、配飾、道具…都歸我管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160112
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160112,
					"content": "雲翰社現在用的行頭，一部分是以前留下來的，一部分是我去購置的，還有的是我親手做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160113
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160113,
					"content": "要唱一齣全本璃月戲，臺上臺下忙活的人有一大堆，只有幾個演員那肯定不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160114
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160114,
					"content": "今年海燈節，雲老闆給我們幾個幕後幹活的人放了假，我那幾個老朋友又都回老家過節去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160115
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160115,
					"content": "我一個人沒什麼事幹，就乾脆帶著傢伙物事給大家演紙映劇來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160116
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160116,
					"content": "不回家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160117
					]
				},
				{
					"id": 715160117,
					"content": "哦，我沒成家，前年我家老爺子和老娘走了，就剩我一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160118,
						715160119
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160120,
					"content": "哎呀，這有什麼好對不起的，我不介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160121
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160121,
					"content": "#我一個人過海燈節也挺快活，{F#妳}{M#你}看到了吧，那幾個孩子很喜歡我演的紙映劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160122
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160122,
					"content": "我們也很喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160123,
					"content": "#別說{F#妳}{M#你}們喜歡，我自己也喜歡，否則就不會費那麼多功夫做這些紙人紙佈景了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160124
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160124,
					"content": "故事是大叔自己編寫的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160125
					]
				},
				{
					"id": 715160125,
					"content": "倒不能這樣說，璃月戲也好，紙映劇也好，甚至是茶博士的說書，都提到過「虯髯公」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160126
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160126,
					"content": "只要人們需要，只要大家發出呼喚，就會有這樣的英雄誕生，去拯救處在危難中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160127
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160127,
					"content": "璃月一直都不缺少這種英雄，只要把他們的故事稍加演繹一番，就有了大家喜聞樂見的戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160128
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160128,
					"content": "以前也聽過很多這樣的事情，這算是璃月傳統文化的一部分嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160129,
					"content": "哈哈，這樣說也算沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160130
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160130,
					"content": "不過呢，雖說總會有英雄在危難的時候出手相助，但平時還是不能總依賴別人，得自己照顧好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160131
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160131,
					"content": "#{M#小夥子}{F#小姑娘}，要照顧好自己，海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160132
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715160132,
					"content": "我會的，海燈節快樂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160133
					]
				},
				{
					"id": 715160133,
					"content": "海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715160134,
					"content": "有空多來雲翰社聽戲啊，說不定以後咱們還能見得著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "應公"
				},
				{
					"id": 715160119,
					"content": "對、對不起！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160104,
					"content": "不太容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160105
					]
				},
				{
					"id": 715160105,
					"content": "#{F#妳}{M#你}不是行內人，第一次嘗試當然會犯些錯誤，這是在所難免的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "應公"
				}
			]
		}
	]
}