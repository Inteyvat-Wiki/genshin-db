					}
				]
			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "塞勒，現在能蓋章嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360202,
					"content": "能！當然能，你帶鑰匙來了吧？先在這裡簽個字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360203,
					"content": "我還以為你們有了這件機器之後，就不用簽字了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360204,
					"content": "這個嘛…這個機器最終還是需要人來操作，那不就需要簽字擔保嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360205,
					"content": "但是這機器的保密性是一流的，沒有鑰匙的話，就算是我也沒辦法讓它動起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360206,
					"content": "把文件放下面吧，一定要對準。再把鑰匙插進這個孔裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360207,
					"content": "這就是那個「自動蓋章機」嗎？看起來還真…普通呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360208,
					"content": "這樣是吧，然後我就轉一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360209,
					"content": "等等，保持這個姿勢先別動，我還要替你留個影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360210,
					"content": "你不怕洩密嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "這是引進這台機器的時候，卡爾西先生向我們定下的規定，必須要用留影機讓來蓋章的人留下存檔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360253,
					"content": "我得挪個位置…別拍到這份文件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360213,
					"content": "最近複律庭裡有人說馬上就要發下一份文件，專門約束留影機洩密這件事。我才不想當那個被打的出頭者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360214,
					"content": "#{NICKNAME}，我們也去外面站著吧，要是被拍進去的話，說不定我們也會捲入什麼「秘密事件」裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360255,
					"content": "塞勒小心翼翼地留好了影…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "…拍好了，你開機器吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360216,
					"content": "我轉了啊，這機器怎麼沒有動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360217,
					"content": "不可能，我剛修過這臺機器，總不會又壞了吧？讓我檢查一下，別擔心，很快就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360218,
					"content": "塞勒低頭檢查起了機器…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "奇怪，什麼問題都沒有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360220,
					"content": "重新插入鑰匙看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "好吧，我來試試看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360222,
					"content": "艾尤恩拔出鑰匙，又重新插了回去。機器依舊沒有發動…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "不會動啊，塞勒，想想辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360224,
					"content": "也許是你沒有把文件的位置對準？你要把文件卡在這些卡扣上才行，裡面都有隱藏的觸發機關的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360225,
					"content": "文件和機器有關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "當然，不然這臺機器怎麼知道有文件在下面等著蓋章呢，這是一臺自動蓋章機，又不是由我手動操作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360227,
					"content": "天哪…好吧、好吧！我這就把文件重新放一遍，對準所有卡扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360228,
					"content": "艾尤恩拿出文件，重新擺放進去。機器依舊沒有運轉…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "沒作用，它還是一動不動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360230,
					"content": "不對啊，上次我只是拍了一下，這臺機器就繼續工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360231,
					"content": "那我去拍拍它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "我們已經不得不訴諸如此…接近於祈禱的行為來維修機器了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360233,
					"content": "至少我們還有祈禱的機會不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360234,
					"content": "（輕輕拍打這臺機器。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "#（這臺機器用沉默回答了{F#妳}{M#你}…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360236,
					"content": "（略微用力地拍打這臺機器。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "（這臺機器就連抗議都懶得做出…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360238,
					"content": "（狠狠地拍打這臺機器！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "（這臺機器沉默了一下，煩躁地發出了一陣稀哩嘩啦的聲音，就像是剛睡醒的人跌跌撞撞地摔下了床…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360240,
					"content": "嗚哇！什麼聲音，這臺機器裡面是不是全部壞掉了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360241,
					"content": "（…然後，這臺機器踉蹌著找到了它的拖鞋，摸索一陣，終於打開燈，嗡嗡地運轉了起來。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360242,
					"content": "居、居然運轉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360243,
					"content": "自動蓋章機疲憊、堅定卻又極富耐心地工作了起來。在幾人近乎絕望的注視下，機器以彷彿玳瑁烏龜爬行一般的速度降下了印章。印章邁開腳步，在文件上疑惑地蹣跚，轉悠了一下後，只能無奈地坐下休憩。最後，機器顫抖著將印章收了回去…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "我就說它能正常工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360245,
					"content": "我真不知道這機器到底哪裡好了，說是自動，但它蓋章的速度比手動還慢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360246,
					"content": "但它的保密性十分優秀，你看，我們三個人就算是這樣，也無法把印章拿出來私自蓋戳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360247,
					"content": "別在這種地方自鳴得意，要是有一天這臺機器徹底壞了，卡爾西先生也不在，那又該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360248,
					"content": "嗯…那也沒關係，我還有一把備用鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360249,
					"content": "那是用來打開這臺機器的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360250,
					"content": "不，那是用來打開卡爾西先生辦公室裡的一個箱子，裡面放著一個備用公章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360251,
					"content": "…旅行者，我們趕快回去把這份文件裝訂好，交給迪福爾先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360252,
					"content": "我真是等不及從這場噩夢中解脫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360211,
					"content": "為什麼還要留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
