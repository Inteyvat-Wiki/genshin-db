			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "還以為腰上那個只是普通的玉石…沒想到居然是「神之眼」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001002,
					"content": "今、今天就先放過你！我們走著瞧！這事沒完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001022,
					"content": "唉，指望他們吸取教訓，是不可能的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001003,
					"content": "你居然有「神之眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "嗯，只不過以「神之眼」退敵有恃強凌弱之嫌，所以我不太喜歡用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001008,
					"content": "他們現在走了，但肯定會再來找麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120001009,
					"content": "我知道，我不會害了我的恩人，商有商道，這件事我會負責到底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001010,
					"content": "「愚人眾」平常不會站在某個商人一邊，但看那家丁的囂張態度，應該所言非虛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001011,
					"content": "這其中多半是有更深的勾結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001012,
					"content": "剛才他們提到的「茂才公」，這名號我也聽過，他的宅子在璃月港很顯眼，拜託你們去打探些線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001013,
					"content": "道理是有道理的…那你要幹什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120001014,
					"content": "我？我還有其他想要瞭解的事，我想想…等一下我們就在璃月港的玉京臺見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001015,
					"content": "真的嗎？不會只是想使喚我們去跑腿吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120001016,
					"content": "哦哦，竟然發生了這樣的事，這一段真是妙，妙不可言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001017,
					"content": "唔唔唔！氣死我了！我可以打他嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120001018,
					"content": "還是要先幫常九爺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "好吧，但每個惹我生氣的人我都要給他取個難聽的綽號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120001021,
					"content": "就叫他「書呆子」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
