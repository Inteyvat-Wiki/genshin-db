			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "「萬文集舍」…這裡是璃月港的書店吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000202,
					"content": "要不要問問這裡有沒有《提瓦特遊覽指南》的璃月篇？那書超有意思的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紀芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "啊，隨便看看吧，不買也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000302,
					"content": "我們是來找書的，這裡有沒有《提瓦特遊覽指南》的璃月篇呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000303,
					"content": "哦，這本書很久以前就不賣了，沒什麼人氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000304,
					"content": "欸？！明明蒙德篇那麼有趣…太可惜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000305,
					"content": "這書的作者太有個性了，說是指南，但其實起不到什麼指南的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000306,
					"content": "不僅賣不出去，我曾經還因為這書被遊客投訴過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000307,
					"content": "個人風格太強烈了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "但我還是覺得很可惜，蒙德篇當成冒險日記來讀也很有趣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000310,
					"content": "反正我這裡現在已經沒有了，如果實在想看，可以去常九爺那兒碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000311,
					"content": "常九爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000312,
					"content": "他住在輕策莊，收藏各種書籍。雖然脾氣不太好，但聊到藏書還是很健談的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000313,
					"content": "他還在璃月港的時候就是我的老主顧了，現在我有時也會給他寄兩本絕版藏書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000324,
					"content": "不過他住的地方很難找，要先沿著輕策莊後山的棧道一路爬上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000314,
					"content": "妳說，絕版藏書？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000315,
					"content": "那已經絕版的《神霄折戟錄》第六卷，也可能在他的收藏之中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000316,
					"content": "你是誰啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "失禮了，在下行秋，只是一個偶然路過的愛書人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000319,
					"content": "#既然{F#妳}{M#你}我都在尋書，那何不一同前往輕策山，拜訪這位常九爺呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000320,
					"content": "有道理，那就麻煩你帶路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "都是愛書之人，不必客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000322,
					"content": "其實我沒想跑這麼遠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "別這麼說嘛，這璃月港分外嘈雜，偶爾也要去清靜之地透透氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000317,
					"content": "神出鬼沒的，嚇死了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "是某些條目在教唆犯罪嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "唉，天要亡我啊…天要…亡我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000502,
					"content": "請問你就是常九爺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "嗯，有事嗎？有事快說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000504,
					"content": "聽說你這裡有很多絕版的藏書，我們想借《提瓦特遊覽指南》的璃月篇看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000505,
					"content": "唉，別跟我提書的事了，我都快煩死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000506,
					"content": "層岩巨淵封鎖以後，我家礦石生意很不好做，「愚人眾」還在下黑手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000507,
					"content": "#為了籌貨款，我只能把我的愛書都拿去當了…！{F#妳}{M#你}知道這意味什麼嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000508,
					"content": "…沒書看了很難過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "不對！是我的人生！我傾盡一生收藏的！保護的！我的藏書，沒了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000511,
					"content": "唉…算了，衝著你們大吼大叫也沒什麼意義。早點籌錢把書贖回來才是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000512,
					"content": "沒其他事的話，我也沒心情聊天。走吧走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000513,
					"content": "莫非，連《神霄折戟錄》的第六卷，也當掉了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000514,
					"content": "哦？想不到會聽到這個名字…你還挺有品味的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000515,
					"content": "意思是我們沒有品味嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000516,
					"content": "這可是具有時代意義的一本奇書，當年剛推出的時候不被任何人看好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000517,
					"content": "但它改變了很多人對武俠小說的印象，之後也出現了大批的模仿者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000518,
					"content": "最初的一版數量非常少，幾乎一下子就絕版了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000519,
					"content": "在後來的加印版本中，作為補充故事的第六卷，不知為何並沒有再版的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000520,
					"content": "對對對，就是這樣！因為存世數量非常之少，無論我再怎麼缺錢，也捨不得當掉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000521,
					"content": "這麼說，這本書還在你的手上？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000522,
					"content": "嗯，這是我剩下的唯一一本愛書了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000523,
					"content": "喂，老常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000524,
					"content": "磨磨蹭蹭的，是我家老爺給你臉了？那批石珀，究竟是賣還是不賣？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000525,
					"content": "惹惱了茂才公，就等於惹惱了「愚人眾」，這道理總該明白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000526,
					"content": "啊，又是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000527,
					"content": "可我也不能三折來賣這一批石珀啊，那樣的話…我可能再也贖不回我的書了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000528,
					"content": "那我不管，你是要看書還是要吃飯？還是想帶著書進棺材提前躺好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000529,
					"content": "呃，你…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000530,
					"content": "話不能這麼講，這位兄台。買賣講究一個你情我願，哪裡有強買強賣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000531,
					"content": "你又是從哪冒出來的？關你什麼事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000532,
					"content": "在下路見不平行俠仗義之人，古華派，行秋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000533,
					"content": "噗…噗哈哈哈——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000534,
					"content": "古華派，他說古華派！哈哈哈——！聽見了嗎？這年頭還有人提古華派！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000535,
					"content": "不過是個斷了香火、搖搖欲墜的小門派吧？就這還敢行俠仗義？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000536,
					"content": "正義和身分可沒什麼關係，你不只過只是個狐假虎威的小家丁，不是一樣在作惡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000537,
					"content": "你…你！行啊，你給我等著！看我有沒有本事收拾你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000538,
					"content": "還有你，老常！這批礦你不賣也得賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000539,
					"content": "唉，虎落平陽被犬欺。這日子是過不下去了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000540,
					"content": "那話說回來吧，究竟能否將書借給我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000541,
					"content": "你這也太漠不關心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "算了算了，我也不指望別人能操心我。看你剛剛幫我說了話的份上，拿著書快滾吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000544,
					"content": "非常感謝！我盼這書三載有餘，予書之恩，行秋必報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000545,
					"content": "行了行了，記得把書還給我就行。我對古華派弟子可沒什麼期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 120000546,
					"content": "喂喂！你這就走了？什麼都還沒搞清楚呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000542,
					"content": "稍微看一下現場氣氛啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "…沒書看了很無聊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200006",
							"2"
						],
						"stepId": 1200006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "站在這裡看書就是你行俠仗義的方式嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000602,
					"content": "有意思，有意思，原來還發生了這樣的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000603,
					"content": "喂，聽我說話啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000604,
					"content": "原來如此，備受追捧果然是有原因的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000608,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000605,
					"content": "剛才來勢洶洶的那幫人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "是啊，不能以超低價買到礦石，就要讓常九爺吃苦頭，他們簡直和強盜沒區別！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000609,
					"content": "我們得想辦法幫幫常九爺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "可別把我排除在外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000613,
					"content": "你這不是聽得到我們說話嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120000614,
					"content": "借來這書，只是我覺得常九爺走投無路，最後還是會當掉它，那就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000615,
					"content": "對常九爺說的話，我可不只是說說而已，既然他有恩於我，那我必定報答，此乃俠義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000616,
					"content": "這書由我代為保管，而他的其他藏書，我也會幫他贖回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000617,
					"content": "你想到辦法了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "當然有辦法，我已經有頭緒了，現在只需要考慮考慮細節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000620,
					"content": "嗯，容我思考一番，不需要太長的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000621,
					"content": "居然還敢待在這，你以為我真的只是嚇唬嚇唬你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000622,
					"content": "豆花派要人沒人，要本事沒本事，就膽子還不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000623,
					"content": "哦，搞錯了，古華派！古華派，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000624,
					"content": "有道是「蚍蜉撼大樹，可笑不自量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000625,
					"content": "啊？扯什麼文辭呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000626,
					"content": "請回吧，強買強賣的事我是不容的，何況還是於我有恩的常九爺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000627,
					"content": "你小子，看來又想幫老常出頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000628,
					"content": "那你可找錯時候了，看，今天有「愚人眾」的大人為我撐腰，幾十個古華派加起來也得罪不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000629,
					"content": "在下雖年少，也行走江湖數年，面對惡者又何曾懼過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000630,
					"content": "那就給你點教訓吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000618,
					"content": "我不覺得你有辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "看來璃月篇是看不成了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "同是求書，你們這麼輕易就要放棄了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000606,
					"content": "那幫人自稱是幫茂才公做事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
