			"dialogs": [
				{
					"id": 191735301,
					"content": "「全自動灌溉機關」…琺露珊前輩，還真是留了個麻煩的課題下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 191735302,
					"content": "師父，有什麼我能幫上忙的嗎？不管是去採購東西，還是準備紙筆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735303
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 191735303,
					"content": "唉…我記得，妳今天還有不少功課要做吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735304
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 191735304,
					"content": "欸？是、是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 191735305,
					"content": "盡快把功課做完，早點上床睡覺，不要讓琺露珊前輩擔心，就是最大的幫助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735306
					],
					"speakerTitle": "提納里"
				},
				{
