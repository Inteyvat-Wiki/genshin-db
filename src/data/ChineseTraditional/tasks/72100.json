			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000401,
					"content": "您好。我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000402
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000402,
					"content": "雖然我們暫且不能在陽光下再會之事令人歎惋，但身邊的象徵著神明的雷櫻與您的光采也足以照亮這一方空間了。如果我有能幫上您的事情的話，請您儘管開口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000403,
						721000407,
						721000410,
						721000413
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000403,
					"content": "關於其他的結界…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000405
					]
				},
				{
					"id": 721000405,
					"content": "除了鎮守之森，有一處結界在名為「荒海」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000406
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000406,
					"content": "最後，在神里家的院子外面，向東北望過去的灘塗上，有一處地穴。最後一處結界就在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000407,
					"content": "找不到鎮物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000408
					]
				},
				{
					"id": 721000408,
					"content": "過去，鎮物是交由「天狐」看守的。但在…一切都變得不同以後，天狐與地狐漸漸不願顯靈，而是沉睡著等待她有朝一日再度現身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000409
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000409,
					"content": "如果要尋找鎮物的話，就在封印的周邊，找找「天狐」…也就是那種特殊的狐狸雕像吧。如果遇到了挫折，就試著找找周圍的「地狐」，用那個鏡子看看有沒有什麼線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000410,
					"content": "關於「留念鏡」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000411
					]
				},
				{
					"id": 721000411,
					"content": "關於這個，恐怕我所知的並不比您多多少。除了柊家的人暴殄天物之事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000412
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000412,
					"content": "在鳴神島各處，應該沉睡著不少「地狐」。呈現在您眼前的，恐怕是小小的、特別的小狐狸像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000439
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000439,
					"content": "在過去，它們的力量雖然薄弱，卻相當珍重情誼。透過那個…「留念鏡」觀察它們的話，您多少也能見到過去的事物、景象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000413,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000414
					]
				},
				{
					"id": 721000414,
					"content": "「心隨白雲流…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000415
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000415,
					"content": "如果有我能幫上忙的地方的話，請不必多慮，儘管說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				}
			]
		},
