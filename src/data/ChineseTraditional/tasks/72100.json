			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000201,
					"content": "辛苦二位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000202
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000202,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000203,
					"content": "怎麼又來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000204
					]
				},
				{
					"id": 721000204,
					"content": "實在抱歉。有的事情，應該說是「習慣」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000205
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000205,
					"content": "不對！妳怎麼又在跟蹤我們，還不來打個招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000206,
						721000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000206,
					"content": "別這樣說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000208
					]
				},
				{
					"id": 721000208,
					"content": "啊，對不起。我一定是跑來跑去太累了…態度不好，真不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000209,
					"content": "不用在意。此處結界能成功解開，「大祓」的進度又推進了一些，實在多謝兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000210
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000210,
					"content": "話說回來，「神櫻大祓」究竟是怎麼一回事呀？和妳之前讓我們做的「淨化」，是一回事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000211,
						721000219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000211,
					"content": "稻城小姐也提到過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000212
					]
				},
				{
					"id": 721000212,
					"content": "稻城？您所說的稻城，是名字叫彌里的巫女嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000213
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000213,
					"content": "名字好像叫螢美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000214,
					"content": "也對。畢竟過了這麼久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000215
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000215,
					"content": "不過她說方法已經失傳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000216,
					"content": "啊…嗯…畢竟過了這麼久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000217
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000217,
					"content": "可以理解。這是可以理解的。畢竟過了這麼久。我沒有生氣。沒錯，是我的記憶在擅自生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000218
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000218,
					"content": "面具巫女小姐看起來很生氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000224,
					"content": "…總而言之，神櫻大祓是「淨化」的儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000225
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000225,
					"content": "鳴神島的雷櫻，能夠吸收大地中的汙穢。但久而久之，汙穢就會累積。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000226
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000226,
					"content": "如果積累得太多，雷櫻可能就會枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000227
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000227,
					"content": "所以，每隔一段時間，就需要對散佈在鳴神島五個地方的雷櫻樹根進行一次「小祓」，立下結界。藉由這種方式，來賦予它們「離穢」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000228
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000228,
					"content": "那「大祓」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000229
					]
				},
				{
					"id": 721000229,
					"content": "當結界當中的汙穢累積夠多，就需要進行「大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000230
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000230,
					"content": "嗯嗯，我知道了。進行「大祓」的時候，要取得鎮物，打破樹根的結界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000231,
					"content": "您的理解能力相當優秀呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000232
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000232,
					"content": "那當然！哼哼，畢竟已經做了兩次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000233,
					"content": "那些像武士的怪物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000234
					]
				},
				{
					"id": 721000234,
					"content": "現在會以這樣的姿態現人了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000235
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000235,
					"content": "那是汙穢的化身。被鎮物從樹根中逼出來後，凝結成的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000236
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000236,
					"content": "以前…啊，我的意思是，根據記載，在過去，有的汙穢會化作火車、犬神、黑玉、海坊主、蓑火之類的東西呢。而且也不一定全都是為害於人的。比如說，豆腐小僧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000237
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000237,
					"content": "火…火什麼？豆腐？那、那些是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000238,
					"content": "哎呀，現在的人已經不知道這些妖怪了嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000239
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000239,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000240
					]
				},
				{
					"id": 721000240,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000241,
					"content": "現在，基本都變成了兇惡的落武者嗎…稻妻到底發生了什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000242
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000242,
					"content": "……那個，如果沒有進行「大小祓」，枯萎了的話…會怎麼樣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000243,
					"content": "我記得…不是，據記載，幾百年前，雷櫻差一點都枯萎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000244
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000244,
					"content": "當時魔物肆虐。連大海也變成了黑色。雷櫻很努力、很努力地吸收邪穢的氣息，最後幾乎全都枯死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000245
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000245,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000246
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000246,
					"content": "後來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000247,
					"content": "後來的事情…我不太清楚。真的很對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000248
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000248,
					"content": "從結果來看，問題似乎是解決了。仍然有人執行了「大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000249,
						721000250
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000249,
					"content": "之前提到說有五個地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000251
					]
				},
				{
					"id": 721000251,
					"content": "多虧您的努力，已經有兩處樹根的結界解開了。那麼，接下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000252
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000252,
					"content": "二位經歷了這麼多，想必已經又累又餓。我準備了一些菜餚，希望不嫌棄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000253
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000253,
					"content": "哇，看起來很美味！雖然戴著面具，但妳果然是全稻妻最好的巫女姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000254,
						721000255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000254,
					"content": "全稻妻最好的巫女姐姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000256
					]
				},
				{
					"id": 721000256,
					"content": "那麼，還請慢用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000257
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000257,
					"content": "真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000258,
						721000259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000258,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000260
					]
				},
				{
					"id": 721000260,
					"content": "欸…仔細一想，雖然剛剛吃得很開心，現在感覺又好像什麼也沒吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000261,
					"content": "該不會是…面具巫女小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000262,
						721000264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000262,
					"content": "…下毒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000263
					]
				},
				{
					"id": 721000263,
					"content": "我怎麼可能對二位做出這種事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000266
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000266,
					"content": "總之，請毋須擔心。這是用從妖狸一族那偷學來的法術，做出來的菜餚。對二位絕對沒有壞處。一般來說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000267,
						721000268
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000267,
					"content": "「一般來說」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000269
					]
				},
				{
					"id": 721000269,
					"content": "之所以請您屈尊吃如此可疑…可口的食物，當然是為了治癒剩下的「樹根」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000270
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000270,
					"content": "鎮守之森中，藏著鎮物與需要淨化的樹根。而在鎮守之森深處，似乎有個老朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000271
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000271,
					"content": "「似乎」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000272
					]
				},
				{
					"id": 721000272,
					"content": "因為是很久以前的事情了。我不太清楚，他是否還記得我。或者說，會不會恨我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000273
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000273,
					"content": "他沒辦法自由行動，也沒辦法與人交流。吃了這個以後，就可以和他交流了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000274
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000274,
					"content": "那位故友，多少應該能為您提供幫助吧。所以，為了「神櫻大祓」，這是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000275
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000275,
					"content": "二位已經兩次展示了自己的氣量、情義，以及不俗的身手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000276
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000276,
					"content": "想來為了這片土地的安康利好，也一定會繼續前進的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000277
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000277,
					"content": "嗯！既然面具巫女小姐都這麼說了，那就當做是完成任務必須採取的行動吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000278,
						721000279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000278,
					"content": "我覺得妳們在一起唬弄我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000280
					]
				},
				{
					"id": 721000280,
					"content": "#喂！{F#妳}{M#你}怎麼會有這種想法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000281
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000281,
					"content": "其他的樹根呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000282
					]
				},
				{
					"id": 721000282,
					"content": "除了鎮守之森，有一處樹根在名為「荒海」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000283
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000283,
					"content": "不知道荒海現在還有沒有人居住呢。很久沒去過那了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000284
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000284,
					"content": "最後一個…是在神里家的院子外面，向東北望過去的灘塗上，有一處地穴。樹根就在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000285
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000285,
					"content": "那麼，「神櫻大祓」就拜託了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000286,
						721000287
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000286,
					"content": "等一等。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000288
					]
				},
				{
					"id": 721000288,
					"content": "請說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000289
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000289,
					"content": "剛剛在荒廢神社裡，我們透過「留念鏡」看到了和面具巫女小姐一樣的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000290
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000290,
					"content": "名字好像是叫「花散里」…欸？妳就是「花散里」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000291
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000291,
					"content": "確實如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000292
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000292,
					"content": "我、我被騙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000293,
						721000294
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000293,
					"content": "她一開始就說過了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000295
					]
				},
				{
					"id": 721000295,
					"content": "總、總之，那是怎麼一回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000296
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000296,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000297
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000297,
					"content": "萬分抱歉，我絕沒有隱瞞之意。只是一直沒有解釋的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000298
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000298,
					"content": "現在也不是合適的時機。真的很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000299
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000299,
					"content": "嗯…好吧！我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000300
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000300,
					"content": "等面具巫女小姐妳有機會，再告訴我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000416,
					"content": "#對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000417,
						721000418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000417,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000419
					]
				},
				{
					"id": 721000419,
					"content": "非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000420
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000420,
					"content": "還有一件事。先前二位所說的「留念鏡」，指的究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000421
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000421,
					"content": "那、那面鏡子，竟然被弘嗣那個傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000422
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000422,
					"content": "怎、怎麼了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000423
					]
				},
				{
					"id": 721000423,
					"content": "……呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000424
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000424,
					"content": "真是失態，請二位原諒。那麼，請好好保管好這個…「留念鏡」。那可是十分寶貴的器物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000425,
						721000426
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000425,
					"content": "我、我明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000427
					]
				},
				{
					"id": 721000427,
					"content": "真的！十分寶貴的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000428
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000428,
					"content": "一定妥當保管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000429
					]
				},
				{
					"id": 721000429,
					"content": "有不少地方都有細小的狐狸雕像，它們叫「地狐」，是舊日的夥伴。有它們在的地方，透過「留念鏡」，應該可以喚來過去的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000430
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000430,
					"content": "如果對您的冒險有所裨益，還請您多多發揮「留念鏡」的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000431
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000431,
					"content": "我們會好好用它的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000432,
					"content": "好好用之餘，一定要保護好它！不要碰撞，要按時清潔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000433
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000433,
					"content": "明、明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000434,
					"content": "那就好。那麼，就請允許我與兩位暫且別過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000435
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000435,
					"content": "我們要怎麼會合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000436
					]
				},
				{
					"id": 721000436,
					"content": "「緋櫻若解別離苦，自當常留駐。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000437
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000437,
					"content": "我們的命運一定會如同「緋櫻繡球」那樣，匯聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000438
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000438,
					"content": "在那之前，我會在紺田村井下，您成功淨化的雷櫻樹根處為您祈福。祝您一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000426,
					"content": "請、請相信我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000427
					]
				},
				{
					"id": 721000418,
					"content": "雖然我還是很在意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000419
					]
				},
				{
					"id": 721000294,
					"content": "只有妳一直叫她「面具巫女」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000295
					]
				},
				{
					"id": 721000287,
					"content": "還有一個問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000288
					]
				},
				{
					"id": 721000279,
					"content": "我覺得派蒙被輕易唬弄了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000280
					]
				},
				{
					"id": 721000268,
					"content": "那為什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000269
					]
				},
				{
					"id": 721000264,
					"content": "…妖術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000265
					]
				},
				{
					"id": 721000265,
					"content": "您對妖異之事的味蕾，似乎很靈敏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000266
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000259,
					"content": "感覺好像有點違和…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000260
					]
				},
				{
					"id": 721000255,
					"content": "派蒙確實餓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000256
					]
				},
				{
					"id": 721000250,
					"content": "接下來，我們應該去哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000251
					]
				},
				{
					"id": 721000219,
					"content": "有本《神櫻大祓要略》…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000220
					]
				},
				{
					"id": 721000220,
					"content": "根本看不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000221,
					"content": "現在的人都看不懂了嗎？明明是用通行的書面語言寫的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000222
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000222,
					"content": "現在的人？喂，妳到底多大歲數呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000223,
					"content": "這、這種問題，可真是失禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000224
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000207,
					"content": "她一定有難處吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000208
					]
				}
			]
		},
		{
			"id": 7210003,
			"completionStepIds": [
				7210009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210009",
							"2"
						],
						"stepId": 7210009,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210004",
							"3"
						],
						"stepId": 7210004,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000301,
					"content": "相當漂亮，無論是五百藏的障眼法，還是您擊敗妖物的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000302
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000302,
					"content": "「噫！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000303,
					"content": "…我本想這麼說，但其實已經習慣了。面具巫女小姐可真沒新意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000304,
					"content": "這樣啊。讓您失望了，非常抱歉。下次我會加油的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000305
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000305,
					"content": "別在這種事情上加油…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000306
					]
				},
				{
					"id": 721000306,
					"content": "說得也是。那麼，五百藏…他是否還安好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000307,
						721000309
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000307,
					"content": "很有精神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000308
					]
				},
				{
					"id": 721000308,
					"content": "雖然變成了石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000311,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000312
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000312,
					"content": "一般來說，妖狸作亂這種事情，只要不太過火，是不會派人去專門退治的。畢竟妖狸一族雖然頑皮，但心地善良單純，和小孩子一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000313
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000313,
					"content": "#但是，連「大祓」所需的鎮物也敢偷，那確實會受到懲罰呢。聽{F#妳}{M#你}們的說法，既然是「影向役者三人組」，那多半是惟神…過去一名陰陽師下的手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000314,
						721000315
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000314,
					"content": "他提到「臭狐狸」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000316
					]
				},
				{
					"id": 721000316,
					"content": "面具巫女小姐，妳是五百藏的狐狸朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000317,
					"content": "…您真是太抬舉我了。他說的是白辰血脈的女兒，被人們稱為「狐齋宮」，過去在一些地方貴為祭神的仙狐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000318
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000318,
					"content": "「天狐」與「地狐」都曾是她的使者。在她離開後，天狐地狐都紛紛化作石像，保存力量，等待她回來時，能再度與她在白狐之野的草野中漫步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000319
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000319,
					"content": "如今在鳴神島行走的狐狸，因為沒了她，所以血脈與靈性都只有當時的狐狸不足一分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000320
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000320,
					"content": "五百藏說「勝負還沒分清」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000321
					]
				},
				{
					"id": 721000321,
					"content": "那件事啊，是這樣的。您可知道，五百藏的全名是「隱神保生司正五百藏」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000322
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000322,
					"content": "五百藏雖然愚鈍、頑皮，但卻又忠誠善良。所以從很久之前開始，「狐齋宮」就想要讓他走上正道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000323
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000323,
					"content": "「狐齋宮」以前為了讓他服從雷神大人的管束，設計了二人，設法讓五百藏被封為「保生司正」，管理鎮守之森的安泰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000324
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000324,
					"content": "所以，當天地變得漆黑時，「狐齋宮」擔心五百藏為了守護森林，會挺身與絕對無法抗衡的強敵戰鬥，並因此死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000325
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000325,
					"content": "於是，就故意用妖狸擅長的「捉迷藏」挑戰他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000326
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000326,
					"content": "「五百藏，一定一定…無論發生什麼事，都是我引誘你的法術。千萬不要被騙、不要現身。」她說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000327
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000327,
					"content": "「那當然，臭狐狸。這次吾輩一定會勝過妳，讓妳輸得心服口服。」五百藏說。於是，這場沒有結束的比試就開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000328
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000328,
					"content": "…所以，五百藏還在等著狐狸回去找到他，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000329,
					"content": "根據您從五百藏那聽來的故事，應該是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000330
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000330,
					"content": "等了一段時間後，五百藏感覺不對，就到處大鬧。為了引出「狐齋宮」，甚至把鎮物給偷走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000331
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000331,
					"content": "他不知道這是「神櫻大祓」需要的物品，只是以為這把梳子對於「狐齋宮」而言很重要。後來，就因此被惟神封在了石頭中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000332
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000332,
					"content": "那「狐齋宮」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000333
					]
				},
				{
					"id": 721000333,
					"content": "…被黑暗吞噬了。最後，在黑暗被斬落後，隨著汙泥一同回歸鳴神的大地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000334
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000334,
					"content": "那妳又是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000335
					]
				},
				{
					"id": 721000335,
					"content": "我？如您所見，我是「花散里」，不過是一名希望能藉助您的力量，祓除妖邪的巫女罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000336
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000336,
					"content": "不是這個問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000337
					]
				},
				{
					"id": 721000337,
					"content": "面具…花散里小姐，之前我就覺得很奇怪，妳知道很多一般人不知道的，過去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000338,
					"content": "甚至會妖狸的法術，能做出狸貓的飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000339,
					"content": "對現在的事情卻不太瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000340
					]
				},
				{
					"id": 721000340,
					"content": "簡直就像從幾百年前過來的人一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000341,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000342
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000342,
					"content": "之前我們在回憶中也見到了與妳相似，名字也一樣的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000343,
					"content": "所以說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000344
					]
				},
				{
					"id": 721000344,
					"content": "妳其實和五百藏一樣，是幾百年前被封印的妖狸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000345,
					"content": "不、不是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000346
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000346,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000347
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000347,
					"content": "我繼承了她的記憶。但別的事情，請二位原諒，現在還沒到說的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000348
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000348,
					"content": "此前在那處洞窟中，我承諾過。當時機來臨時，會將一切全盤托出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000349
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000349,
					"content": "#怎麼辦，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000350,
						721000351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000350,
					"content": "我相信她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000352
					]
				},
				{
					"id": 721000352,
					"content": "#嗯嗯，既然{F#妳}{M#你}這麼說了，那我也相信面具巫女小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000353,
					"content": "感謝您的諒解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000354
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000354,
					"content": "那麼，我們暫且在此別過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000355
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000355,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000356
					]
				},
				{
					"id": 721000356,
					"content": "「別離只此身，心隨白雲流。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000357
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000357,
					"content": "我會在紺田村井下，您成功淨化的雷櫻樹根處，為您祈福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000358
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000358,
					"content": "當所有的五處樹根都得到淨化後，請到那來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000351,
					"content": "那就這樣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000352
					]
				},
				{
					"id": 721000315,
					"content": "妳的狐狸面具…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000316
					]
				},
				{
					"id": 721000309,
					"content": "被變成了石頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000310
					]
				},
				{
					"id": 721000310,
					"content": "但很有精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000311
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
