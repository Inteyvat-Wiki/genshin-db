			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721000101,
					"content": "真是相當了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000102
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000102,
					"content": "噫！妳怎麼…什麼時候…為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000103,
					"content": "噫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000104
					]
				},
				{
					"id": 721000104,
					"content": "我果然沒看錯人，您確實有「淨化」的資質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000105,
						721000107
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000105,
					"content": "妳為什麼會在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000106
					]
				},
				{
					"id": 721000106,
					"content": "我很關心您的行動，以及您能否治癒「樹根」，所以多少觀察了一下二位的行動。如有冒昧，還請您多多海涵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000110
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000110,
					"content": "您能夠解開結界，真是幫了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000111
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000111,
					"content": "既然她一直在觀察我們，也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000112,
						721000116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000112,
					"content": "妳會去報官嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000113
					]
				},
				{
					"id": 721000113,
					"content": "報官？您是指？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000114
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000114,
					"content": "紺田村的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721000115,
					"content": "是說，紺田村的人為了村子，所隱瞞的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000117
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000117,
					"content": "我所效忠的是鳴神島的土地，而非奉行所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000118
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000118,
					"content": "況且她…我與紺田村也有長久的交情。倘若那些家系因此斷絕了，我也無顏面對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000119
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000119,
					"content": "…失禮了。那麼，言歸正傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000120
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000120,
					"content": "您或許知道，雷櫻樹象徵著雷神的永恆守望，有著祓邪、淨化地脈的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000121
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000121,
					"content": "但疏導汙染的樹根久而久之也會被侵蝕，受汙染的部分陸續結成腫瘤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000122
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000122,
					"content": "因此，我們需要進行淨化儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000123
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000123,
					"content": "但是，以我的…身體狀況，無法完成這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000124
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000124,
					"content": "類似這樣的結界還有幾處。如何，能請您助我——不，是助這片大地，一臂之力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000125,
						721000128
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000125,
					"content": "妳的身體狀況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000126
					]
				},
				{
					"id": 721000126,
					"content": "毋須擔心…當務之急，仍是淨化之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000127
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000127,
					"content": "明白了，我會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000129
					]
				},
				{
					"id": 721000129,
					"content": "…非常感謝您能這樣出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000130
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000130,
					"content": "至於下一處「結界」的位置，您可以去附近的荒廢神社看看。在紺田村東北邊不遠的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000131
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000131,
					"content": "礙於一些狀況，我恐怕無法與您同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000132
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000132,
					"content": "我們要怎麼會合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000133
					]
				},
				{
					"id": 721000133,
					"content": "「東岸西岸之櫻，遲速不同。南枝北枝之花，開落已異。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000134
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000134,
					"content": "但這座島上的一切都在她…都在「神櫻」的庇蔭之下。這座島上仍有花瓣如雪般飄落，我一定有幸能與您再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000135
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000135,
					"content": "祝您一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000128,
					"content": "我來幫忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000129
					]
				},
				{
					"id": 721000116,
					"content": "傳助爺爺隱瞞的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000117
					]
				},
				{
					"id": 721000107,
					"content": "妳究竟是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721000108
					]
				},
				{
					"id": 721000108,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000109
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721000109,
					"content": "如您所見，我不過是一名希望能借助您的力量，祓除妖邪的巫女罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721000110
					],
					"speakerTitle": "花散里"
				}
			]
		},
		{
			"id": 7210002,
			"completionStepIds": [
				7210008
			],
