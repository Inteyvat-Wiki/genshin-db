			"dialogs": [
				{
					"id": 726940401,
					"content": "怎麼樣，材料收集得如何了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940402,
					"content": "全在收集器裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "好，現在我們把收集到的素材加入我的獨一無二絕對穩定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940404,
					"content": "「大工機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940405,
					"content": "好吧好吧，讓我們把收集到的素材加入「大工機」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940406,
					"content": "伯特蘭將收集器插入「大工機」的槽口",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "哇，然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940408,
					"content": "等一下這個機器就會咕嘟咕嘟運轉起來，然後劈哩啪啦地製造玩具來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940409,
					"content": "哈哈哈，這當然是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940410,
					"content": "不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940411,
					"content": "想什麼呢，三個工序才完成了一個，離造出玩具還差得遠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940412,
					"content": "原來是這樣啊，要工序全都完成才有玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940413,
					"content": "對，要三個工序都依次完成一遍，才會生產玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940414,
					"content": "好麻煩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "你們啊，每天都想著速成。要對玩具製造的過程有耐心嘛，這中間的每一道製造工序，都要傾注製作者滿滿的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940417,
					"content": "滿滿的什麼？我明白了，畢竟做的是「玩具」，所以要傾注製作者滿滿的熱愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940418,
					"content": "對，要傾注我對摩拉滿滿的熱愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940419,
					"content": "啊，雖然跟想像的不一樣，但這樣的熱愛我也有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940420,
					"content": "喂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "嘿嘿，就順勢一說嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940422,
					"content": "那伯特蘭，我們接下來要去做什麼，接著完成後面的工序嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940423,
					"content": "不急不急，因為是調整過後的機器，還沒有按照這個工序跑過，我先看看機器處理這些素材時有沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940424,
					"content": "#這得觀察一下，{F#妳}{M#你}們過段時間再來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940415,
					"content": "好繁瑣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
