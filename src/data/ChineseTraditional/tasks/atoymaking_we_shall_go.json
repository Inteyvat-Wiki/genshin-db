			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "原來是旅行者和派蒙啊，真是剛好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940102,
					"content": "剛好什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940103,
					"content": "#剛好有一個很適合{F#妳}{M#你}們的任務，我正想聯繫{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940104,
					"content": "很適合我們的任務…不會又是幫忙找東西，清理丘丘人之類的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940105,
					"content": "還有上屋頂撿垃圾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "#不是不是，這次的任務確實十分適合{F#妳}{M#你}們，所謂「十分適合」的意思就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940108,
					"content": "這份工作不僅看上去十分有趣，而且還有豐厚的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940109,
					"content": "有豐厚的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940110,
					"content": "派蒙自動忽略了有趣的部分呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "當、當然，最主要是有趣啦，那到底是什麼樣的委託呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940112,
					"content": "嗯，這次的委託者是來稻妻做生意的楓丹製造商伯特蘭，在尋找幫助他製造商品的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940113,
					"content": "畢竟是生意人，在冒險者協會登記委託時填下的完成報酬一欄，數字可是相當可觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940114,
					"content": "#不過因為一些原因，他只能在「離島」上活動。具體的詳情就讓他自己跟{F#妳}{M#你}們說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 726940115,
					"content": "好，我們這就去「離島」上找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940106,
					"content": "或者奇怪的貨物搬運…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "哼哼，一切都已經準備就緒，只要我一個玩具賣上個幾千摩拉…賣上幾萬個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940202,
					"content": "那不輕輕鬆鬆有幾千萬摩拉到手…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940203,
					"content": "喂！你就是伯特蘭嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940204,
					"content": "啊？是啊，我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940205,
					"content": "#怎麼了，兩位，難道{F#妳}{M#你}們也是聽聞我的消息，來購買我製造的玩具的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940206,
					"content": "#不過稍微有點可惜啊，不能立刻賣給{F#妳}{M#你}們，因為我們還沒有開始大規模的生產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940207,
					"content": "但是也不用急，現在生產線啊已經在籌備當中，如果有意願的話可以先進行登記並交付訂金，等製造出來以後會通知您補足全款…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940208,
					"content": "等等等等，我們不是來買玩具的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940209,
					"content": "哦，這樣…有什麼事就快點說，別耽誤我做生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940210,
					"content": "請長話短說，我的時間可是很寶貴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940211,
					"content": "哇，感覺這個人的態度一下就冷了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940212,
					"content": "我們是來幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "#什麼呀！哎呀，是來當助手的冒險家是吧，歡迎歡迎，哎呀，原來是來幫忙的，{F#妳}{M#你}們早說嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940215,
					"content": "#對，在冒險家協會掛委託的就是我，請問{F#妳}{M#你}們怎麼稱呼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940216,
					"content": "（感覺態度一下又變了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940217,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940218,
					"content": "那這位呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}，總覺得是在哪裡聽過的名字，難道…{F#妳}{M#你}們也被通緝過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940221,
					"content": "確實不止一次…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "那我可能是在被天領奉行通緝…不，是被他們叫去問話的時候聽到過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940225,
					"content": "你到底做了什麼，居然會被天領奉行找上門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940226,
					"content": "唉也沒什麼大不了的，就是上一次做出來的那一批玩具吧，出了一些微不足道的小問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940227,
					"content": "微不足道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940228,
					"content": "小問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "嘿嘿，就是不小心撞到裡面的觸發裝置就會爆炸嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940230,
					"content": "爆炸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940231,
					"content": "哎呀都是一些小問題啦，也沒有人因此受傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940232,
					"content": "可是那些天領奉行的同心還是二話不說，就把我所有的玩具都扣留了…明明還可以作為「外形可愛的炸彈」出售的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940233,
					"content": "唉，當初從楓丹過來的時候還向萬國商會借了一筆錢作為啟動資金，誰能想到現在被限制入境，只能在離島上艱難求生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940234,
					"content": "怎麼想都是你自作自受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940235,
					"content": "等等，你既然還欠著萬國商會的摩拉，哪還有那麼多報酬來進行委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940236,
					"content": "沒關係，我還有最後一筆錢，只要我重新製造出玩具大賣一筆，就一定能還清欠款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940237,
					"content": "#當然也能給{F#妳}{M#你}們豐厚的報酬啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940238,
					"content": "…真的能成嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940239,
					"content": "可別小看了稻妻的玩具市場啊，我造出的玩具在發現會爆炸之前可是很受歡迎的…甚至發現會爆炸以後還更受歡迎了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940240,
					"content": "總之，實在不行的話，就把玩具造出來給久利須會長以貨抵債。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940241,
					"content": "還請兩位務必幫忙，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940242,
					"content": "可是你說要幫忙，具體是要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940243,
					"content": "是這樣的，我是靠我開發出的這個「獨一無二絕對穩定工程用第二代爐心製造機」進行玩具製造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940244,
					"content": "說起我的「獨一無二絕對穩定工程用第二代爐心製造機」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940245,
					"content": "名字太長了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "是啊，不如就叫…讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940247,
					"content": "就叫「大工機」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940248,
					"content": "等等，這名字也太短了吧！一點都沒有那種，特別厲害的感覺啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940249,
					"content": "有的時候簡短一點，反而能被大家記住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940250,
					"content": "「大工機」，我覺得「大工機」就很好，朗朗上口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940251,
					"content": "唉…好吧好吧，確實以前有人說過我取名品味不好，就相信妳這一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940252,
					"content": "派蒙的取名品味也好得有限…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940254,
					"content": "哈哈哈，反正呢，我的「大工機」會自動分析加入的材料，用最適合的方式處理材料並進行組裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940255,
					"content": "但上次就因為加入了一些奇怪的機關，所以才會爆炸，我此次痛定思痛，進行了改裝…理論上來說是沒有這樣的問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940256,
					"content": "理論上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726940257,
					"content": "所以才需要有人幫忙進行試作實驗嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940258,
					"content": "總而言之，製作時，收集材料的環節總共分為三步，分別是「原材收集」、「元素充能」與最後的「核心啟動」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940259,
					"content": "我們需要收集一些素材，礦石啊、果實啊、花啊之類的，作為基礎的原材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940260,
					"content": "之後就是補充元素力以保證製作物運作的環節，再最後就是用元素生物核心中的能量來保持製作物的動力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940261,
					"content": "今天我們先試試第一步的「原材收集」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940262,
					"content": "#來，這個「素材收集器」就交給{F#妳}{M#你}吧，對了，不管收集到什麼，一定要直接放進素材收集器裡啊，免得沾染別的元素力之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940263,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "#嗯，我再調試下機器，收集材料的活就交給{F#妳}{M#你}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940223,
					"content": "什麼叫「也」被通緝過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "哈哈，這個就說來話長了，我也因為一些小意外被天領奉行請去喝茶過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726940213,
					"content": "你在冒險家協會掛了委託吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
