			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾德溫·伊斯丁豪斯",
					"勒馬克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "#{F#妳}{M#你}怎麼…{F#妳}{M#你}果然回來了。{F#妳}{M#你}看，我就知道你們找五圈也找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "艾德溫·伊斯丁豪斯"
				},
				{
					"id": 741363402,
					"content": "實在不行就坐下來喝杯茶吧。我剛好買了五個茶杯…和幾個碗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "艾德溫·伊斯丁豪斯"
				},
				{
					"id": 741363403,
					"content": "您真的很喜歡五這個數字，艾德溫先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "勒馬克"
				},
				{
					"id": 741363404,
					"content": "嗯，這是一個具有神奇魔力的數字，只要使用恰當，就能夠打開靈感的大門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "艾德溫·伊斯丁豪斯"
				},
				{
					"id": 741363405,
					"content": "順帶一提，靈感的大門一共有五扇，至少要轉五次把手…五！知道嗎？五次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "艾德溫·伊斯丁豪斯"
				},
				{
					"id": 741363406,
					"content": "抱歉，我現在真的很想給您五拳，請您捂緊自己的嘴，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒馬克"
				}
			]
		}
	]
}