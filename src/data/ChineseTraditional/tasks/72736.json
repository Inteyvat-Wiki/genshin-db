				"objectNames": [
					"「花角玉將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "難能可貴、難能可貴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727360102,
					"content": "真沒想到，荒瀧派居然能打敗這麼多鬥蟲強者。看來你們對鬥蟲也有著獨特的理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727360103,
					"content": "我收回之前的成見。接下來，我會將你們當成值得尊敬的對手，全力和你們比試一場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727360104,
					"content": "放牛的，到你這個老大登場的時候啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727360105,
					"content": "可別把之前的話當真！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727360106,
					"content": "出陣吧，「真劍鬥蟲大鬼王」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "哈哈哈哈哈哈哈，那是當然了！最後對決，也一定會是我贏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360109,
					"content": "雖然不知道你到底是怎麼指導部下的，但結果已經沒有懸念了，是本大爺的荒瀧派更勝一籌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360110,
					"content": "準備接招吧！「花角玉將」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360107,
					"content": "大激鬥，鬼王對玉將！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
