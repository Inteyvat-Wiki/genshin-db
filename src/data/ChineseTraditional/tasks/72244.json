	"talks": [
		{
			"id": 7224401,
			"completionStepIds": [
				7224401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224401",
							"2"
						],
						"stepId": 7224401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"久利由賣",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "#嗯？真是古怪，妾身已很久未見{F#妳}{M#你}們這樣穿著之人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440102,
					"content": "言行舉止，看上去也並非白夜國民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440103,
					"content": "難不成，是自異邦落入此處的旅客嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440104,
					"content": "是的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "沒想到，白夜國竟然也有來自世外的通途嗎…真是令人驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440106,
					"content": "說來，妾身從出生起就在白夜國，從未見過世外之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440107,
					"content": "從前，有人向妾身提及此事，說想要一窺天外風景，妾身都以為是他的玩笑話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440108,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440109,
					"content": "旅者啊，其實妾身有一事相求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440110,
					"content": "在白夜之國各處，有七座壓著「太陽{RUBY#[D]法厄同}之子」遺服的御陵墓石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440111,
					"content": "太陽之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440112,
					"content": "嗯，白夜國崇尚大日御輿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440113,
					"content": "每隔數年，便有出世孩童被擢選為太陽之子，執掌國家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440114,
					"content": "太陽之子…一共有七位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440115,
					"content": "在白夜國很難遇到異鄉的旅客，拜託了，請去他們墓塚之前憑弔一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440116,
					"content": "咦，可是，為什麼要讓我們這些外來者去憑弔呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440117,
					"content": "一般來說，不是熟人去憑弔比較好嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440118,
					"content": "按常理而言，確是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440119,
					"content": "唉，只是，白夜之國的居民應該無人會想要憑弔他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440120,
					"content": "甚至，那些墓上的御陵墓石也久未祭拜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440121,
					"content": "可是…這是為什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440122,
					"content": "難道這個國家的國民，都不喜歡那些太陽之子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440123,
					"content": "與其說是不喜歡…不如說是痛恨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440124,
					"content": "剛才說過，太陽之子是剛出生就成為太陽之子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440125,
					"content": "這樣的孩子又怎麼會治理國家，真正把持國度的是太陽之子背後的大人們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440126,
					"content": "太陽之子只是聽憑他們擺佈的傀儡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440127,
					"content": "只不過…那些大人們貪得無厭，搜刮民脂，操縱太陽之子做過許多殘忍之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440128,
					"content": "由是，民怨憤起，將許多過錯歸咎於太陽之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440129,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440130,
					"content": "明明太陽之子是無辜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440131,
					"content": "…不，他們並不無辜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440132,
					"content": "對於白夜國民而言，他們、太陽之子的無知就是最大的過錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440133,
					"content": "人因無知而犯下的罪，確實傷害到了他人，這人真的能被稱為是無辜的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440134,
					"content": "恐怕很難吧，皆因造成的傷害已無法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440135,
					"content": "既然這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "這算是…妾身的私情之託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440138,
					"content": "妾身名為久利由賣，是大日御輿內，負責照顧太陽之子起居的女官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440139,
					"content": "雖然知道他們所行是錯誤的，知道他們處處被人操控…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440140,
					"content": "可畢竟是妾身看著長大的孩子，妾身對他們，可憐有之，悲哀有之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440141,
					"content": "卻唯獨…無法恨他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440142,
					"content": "況且，雖然由於妾身的職務，能日日與太陽之子接觸，卻囿於周圍嚴苛的監視…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440143,
					"content": "在他們身邊時，不被允許開口說出任何一句言辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440144,
					"content": "那些孩子，在四下無人，彷徨無助之時。他們向妾身說了那麼多、那麼多話語……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440145,
					"content": "妾身卻無法作出任何回應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440146,
					"content": "如果，如果妾身那時能夠提起捨生的勇氣，對他們說些什麼的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440147,
					"content": "或許…一切都會有所不同吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440148,
					"content": "拜託了，時至今日，妾身已無顏面對他們，只得在此作些祭拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440149,
					"content": "憑弔之事，還請旅者大人幫妾身一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440150,
					"content": "只需要，在他們的墓前…放下一枚「珊瑚真珠」即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440153,
					"content": "這樣，就能點燃此處石龕上的魂燈，打開前往引魂之處的道路，為他們祈求安魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440151,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "#多謝，那就…麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440136,
					"content": "為什麼還要憑弔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
