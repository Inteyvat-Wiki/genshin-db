				"objectNames": [
					"久利由賣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#旅者啊，{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440402,
					"content": "此處是引魂之處，也是妾身最後的執念所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440403,
					"content": "太陽之子每到了一定歲數，就會按典儀，於生辰之日進入大日御輿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440404,
					"content": "進入大日御輿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "是啊，所謂的進入大日御輿，即是「歸日之祭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440407,
					"content": "太陽之子從大日御輿而出，在被凡塵濁世侵染之前，回歸太陽御座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440408,
					"content": "…大日御輿溫度之高可熾照白夜之國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440409,
					"content": "太陽之子中，最後回到引魂之處的，都已經是殘缺魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440410,
					"content": "但是妾身還是覺得，或許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440411,
					"content": "或許？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "或許妾身打開引魂之地，就能夠靠自己的記憶補足他們的殘魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440426,
					"content": "就讓妾身一試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440427,
					"content": "比螺夢門…御琉部栖…妾身在這裡，你們還不歸來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440428,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440429,
					"content": "怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "唉，七任太陽之子中，比螺夢門與御琉部栖由妾身養大，若連他們都不願回應…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440413,
					"content": "看來只有妾身一人的記憶，還是不足夠啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440414,
					"content": "如果有什麼作為媒介，若有象徵太陽之子正身的御轡就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440415,
					"content": "只可惜那枚御轡早就佚失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440416,
					"content": "唉…這個國家，白夜之國，仍然在恨著這些孩子們啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440417,
					"content": "看來，想要解放他們的殘魂，終究只是妾身的癡心妄想罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440418,
					"content": "#…旅者，算是妾身最後拜託{F#妳}{M#你}，能幫忙找尋「神輿之轡」所在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440419,
					"content": "#雖然，找到的可能也並不大。{F#妳}{M#你}已經幫妾身許多，再提出要求也顯得有些厚顏無恥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440420,
					"content": "不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440421,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "那真是…那真是感謝了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440424,
					"content": "不過，御轡丟失已久，也不急於一時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440425,
					"content": "若是有消息，便來妾身這兒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440422,
					"content": "我會盡力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "那不就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
