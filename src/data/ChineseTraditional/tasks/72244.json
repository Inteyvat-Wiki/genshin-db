					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "#一二三……唔，{NICKNAME}，好像已經完成七座墓石的憑弔了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722441102,
					"content": "我們回到石頭神龕那邊，告訴等待在石龕邊上的那個殘魂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利由賣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "啊啊…比螺夢門，你喜歡讀書，常言有天外之地，那時妾身並不相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441202,
					"content": "對你的綺言狂想，每每都只是笑著搖頭。妾身該相信你的呀，該相信你的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441203,
					"content": "你說，如有機會，一定要逃出大日御輿，去天外之地冒險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441204,
					"content": "比螺夢門，現在已不再有人會束縛你了，去吧，去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441205,
					"content": "還有，御琉部栖，御琉部栖，妾身好想再聽你歌上一曲啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441206,
					"content": "聽到你唱歌，聽到你那樣純淨清澈的歌喉，有誰不悄悄在內心裡跟你一起唱呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441207,
					"content": "歸日之祭前夜，你突然想聽妾身的聲音，無論如何都想讓妾身開口唱給你聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441208,
					"content": "說沒有關係，不管唱多難聽，你都不會笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441209,
					"content": "你那個時候是不是已經知道…已經知道歸日之祭其實正是自己的終期？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441210,
					"content": "嗚…可是妾身到最後也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441211,
					"content": "久利由賣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "啊啊，不好意思，旅者，妾身失態了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441213,
					"content": "侍奉太陽之子的女官，為保自身的潔淨無瑕…終生不可嫁予他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441214,
					"content": "所以妾身一生都沒有自己的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441215,
					"content": "這些孩子，這些由妾身侍奉，看著長大的孩子，不知何時已變得比血脈還要親近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441216,
					"content": "#多謝{F#妳}{M#你}，旅者，多謝{F#妳}{M#你}找回了御轡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441217,
					"content": "這御轡經由每位太陽之子之手，其上承載的記憶足以補全殘缺魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441218,
					"content": "即使，這些記憶也是雙面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441219,
					"content": "雙面的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "自然，記憶分為兩類，一類是自身之記憶，一類是他人對自身的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441222,
					"content": "補全他們存在的，既有御轡之上，太陽之子自身的記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441223,
					"content": "也有御轡作為被白夜國怪罪的孩童們的象徵，承載的身為罪孽之子的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441224,
					"content": "妾身的記憶，並不足以補全他們的魂魄，便只能靠白夜之國諸民的記憶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441225,
					"content": "這些孩童們，應這些歸咎於他們身上的罪孽，才重新被白夜國記起，留下殘影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441226,
					"content": "#多謝{F#妳}{M#你}了，旅者…妾身大願已了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441227,
					"content": "也終於能…稍微…安心一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441228,
					"content": "終於能…再和那些孩子們一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722441220,
					"content": "記憶也有面向嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
