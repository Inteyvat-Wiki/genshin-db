			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "啊啊，這果然就是，果然就是「神輿之轡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440602,
					"content": "#沒想到，時至今日居然還能夠看到它，旅者啊，旅者{F#妳}{M#你}是從何處尋到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440603,
					"content": "阿倍良久…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "從阿倍良久命處得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440605,
					"content": "真是奇怪，妾身記得，那是…白夜國剛建立時的偉大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440606,
					"content": "不過據說他之後想要篡奪白夜國王，也就是太陽之子之位，視為謀逆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440607,
					"content": "#啊…既然{F#妳}{M#你}們從他手中取回了這枚御轡，看來背後亦有隱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440608,
					"content": "御轡啊，在此重現天日，時也命也…妾身朝思暮想…那些孩子們的臉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440609,
					"content": "這樣一來，妾身也終於有贖罪的機會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440610,
					"content": "旅者，將這枚御轡投入引魂之處的池中，有此御轡在，必可復原殘魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440611,
					"content": "嗚…好讓他們魂魄健全，魂魄健全地走上往生之路啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由賣"
				}
			]
		},
		{
