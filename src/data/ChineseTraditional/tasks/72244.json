					"久利由賣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "如是，七盞魂燈既已亮起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440302,
					"content": "#看來{F#妳}{M#你}們已經完成憑弔了。{F#妳}{M#你}們的幫助，妾身銘感於心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440303,
					"content": "#那麼，現在就由妾身為{F#妳}{M#你}們來打開…通往引魂之地的道路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440304,
					"content": "#異鄉的旅者啊，因妾身私念為{F#妳}{M#你}造成了許多麻煩…不過妾身仍希望{F#妳}{M#你}能見證安魂之儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "久利由賣"
				},
				{
					"id": 722440305,
					"content": "#請隨著這條道路前進吧，妾身會在那裡等{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由賣"
				}
			]
		},
