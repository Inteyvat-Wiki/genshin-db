			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#郎君}{F#女俠}果然好身法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100102,
					"content": "#嘿嘿，那是當然！{NICKNAME}可是很強的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100103,
					"content": "#接下來，不知{M#郎君}{F#女俠}可否向在下展現<color=#00E1FFFF>縱躍法</color>的精髓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100104,
					"content": "據書中記載，我古華先師跳牆越城如登平地，真有飛簷走壁之能，是為縱躍之法——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100105,
					"content": "好厲害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#嗯…要不然試試看？畢竟{NICKNAME}平常到處翻寶箱，也爬過很多地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100106,
					"content": "聽起來像飛賊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#呵呵，{M#郎君}{F#女俠}請想，若是飛賊能逾牆而走，我等鋤惡扶正之人卻不能，豈不是要被那奸邪之徒輕易走脫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "長孫繼璟"
				}
			]
		},
