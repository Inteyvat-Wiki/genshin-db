			"dialogs": [
				{
					"id": 762100301,
					"content": "二位請看，這便是我古華堂的「望梅之陣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100302,
					"content": "#可否請{M#郎君}{F#女俠}在規定時間內依序踏過由在下指出的石樁，向在下一展身法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100303,
					"content": "小事一樁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "雖然其實有好多好多樁就是了…呃，沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100307,
					"content": "#那麼，便請{M#郎君}{F#女俠}一展身手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長孫繼璟"
				},
				{
					"id": 762100305,
					"content": "其實派蒙派掌門派蒙也做得到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "做不到！不管怎麼想都——咦？仔細想想好像還真的做得到…不過，用飛的應該算犯規吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "派蒙"
				}
			]
