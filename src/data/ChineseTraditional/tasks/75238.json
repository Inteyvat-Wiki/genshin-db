				]
			},
			"dialogs": [
				{
					"id": 752380101,
					"content": "茶的口味還滿意嗎？還是說我該準備一些酒類飲料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380102,
					"content": "不了，茶很好。白天喝酒有些太罪惡了，那種事還是少幹兩次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380103,
					"content": "倒是吉約丹小姐，怎麼跑這麼遠到納塔來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380104,
					"content": "四處走走，看看過去的同伴而已。我也想感謝妳在千靈節期間願意接下那份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380105,
					"content": "妳也太客氣了，就為了這個跑一趟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380106,
					"content": "另外，雖然妳上次沒提，但我知道曾經給你們增添過一些不愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380107,
					"content": "啊…妳部下的那件事是吧？和那個名叫伊涅芙的機器人有關的那次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380108,
					"content": "呵…這不正是生活奇妙的地方嗎？曾經敵人的老闆或許也會變為你的同伴，或是你的老闆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380109,
					"content": "希望妳能收下這些。聊表心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380110,
					"content": "這…這是…限定版——不對，珍藏版輕小說？！而且還是我喜歡的題材？妳…妳怎麼會知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380111,
					"content": "#我向{NICKNAME}詢問妳可能會喜歡的東西，並聽取了{M#他}{F#她}的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380113,
					"content": "（可惡…！這種又高興又有些彆扭的感覺是怎麼回事？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380114,
					"content": "#（雖然{M#他}{F#她}瞭解我喜歡什麼自然是高興啦，但能不能不要隨便告訴別人，倒是來親自送給我啊！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380115,
					"content": "還算中意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380116,
					"content": "啊…謝謝謝謝。吉約丹小姐真的太客氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380117,
					"content": "#喜歡的話，我下次也再幫妳帶一些。當然，到時候恐怕又得麻煩{NICKNAME}一起去選一選了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380118,
					"content": "#一起？！{F#妳}{M#你}們是一起逛…逛書店選的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380119,
					"content": "#嗯，{M#他}{F#她}很認真地為妳挑選了這本。下次或許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 752380120,
					"content": "不要再有下次了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 752380121,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
