			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維納亞克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "從這個角度潛入，利用地形遮蔽…只要太陽高度角不高於…我的速度不低於…嗯，果然還是無解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110302,
					"content": "你在算什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "「在不正面接觸魔物的情況下回收零件的可行路線」…拜沙蟲所賜，我的寶貝零件全被捲進附近的魔物堆裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110304,
					"content": "#——嗚哇！{F#妳}{M#你}們是誰？是什麼時候來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110305,
					"content": "都在旁邊聽你嘀咕好久了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "放心吧，我們不是壞人。是你的同伴請我們來的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110307,
					"content": "同伴？難道是施芮婭？不對啊，她明明說，就算我被魔物抓走也不管我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110308,
					"content": "#啊——我明白了，她是要{F#妳}{M#你}們來回收零件的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110309,
					"content": "我有沒有被抓走無所謂，零件沒人回收了可是大事…嗯，像是她會說的話，合情合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110310,
					"content": "…你就當是這樣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "#不過還是得多謝{F#妳}{M#你}們啦，剛才我怎麼算都求不出解，都想直接衝出去，走一步再算一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110312,
					"content": "…搞不好一步算錯，就真要被魔物逮著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110313,
					"content": "唉，要是沒我在，施芮婭又那麼笨手笨腳的…還有誰能照料好這些機械啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735110314,
					"content": "我算是理解施芮婭為什麼那麼擔心了…這個人腦子裡真的全是機械零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}，我們快把零件給收集起來吧！免得他又想冒險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
