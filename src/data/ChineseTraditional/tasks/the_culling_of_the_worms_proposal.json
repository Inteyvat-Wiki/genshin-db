	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"施芮婭",
					"福迪爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "那個笨蛋…居然就這樣衝進沙漠了！福迪爾大哥，求求你們，快去救救他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110102,
					"content": "很抱歉，村子裡的守備力量有限，還要防著「牠們」亂來，暫時沒有那麼多餘力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110103,
					"content": "可是那個笨蛋那麼拼命，也是為了對付「牠們」啊！至少看在共同敵人的份上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110104,
					"content": "唉，也不是我們不想去找。但是守衛們現在分散在沙漠各處，提防「牠們」的動向，召集人手也需要時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110105,
					"content": "怎麼會這樣…現在回喀萬驛找人幫忙，一定也來不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110106,
					"content": "有誰有危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "#嗯？{F#妳}{M#你}們是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110109,
					"content": "一名路過的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "#——以及{M#他}{F#她}最要好的夥伴派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110111,
					"content": "冒險家？真的嗎！謝天謝地，維納亞克那傢伙，終於有救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110112,
					"content": "#冒險家{M#先生}{F#小姐}！請您救救維納亞克吧，報酬絕對不成問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110113,
					"content": "先說說是什麼情況？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "嗯，沙漠裡現在有「牠們」作亂，比平時要危險不少，最好先聽完情況說明再作打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110115,
					"content": "呃…你們說得對，抱歉，我有點心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110116,
					"content": "從剛才起就一直聽你們在說了，「牠們」到底是什麼東西啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110117,
					"content": "——是一群沙蟲。也不知道為什麼，牠們的性情最近變得異常凶暴，還會潛藏在沙暴裡襲擊過往的獵物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110118,
					"content": "不過是些蟲子而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "…話是這麼說，但這次的數量實在太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110121,
					"content": "有沙暴作掩護，也很難對牠們造成多大的傷害。一覺得有危險，那些傢伙就會立刻逃走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 735110122,
					"content": "唔，那的確還滿棘手的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110123,
					"content": "不只是阿如村，還有一些過往行商也受到了影響。所以，教令院派我和維納亞克來處理這些作亂的沙蟲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110124,
					"content": "可是我們託商隊送來的一部分「零件」在半路上被沙蟲襲擊，還被沙暴卷得到處都是，現在…恐怕已經變成魔物們的玩具了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110125,
					"content": "我原本想先回喀萬驛求援，誰知道維納亞克那傢伙，過了那麼多年還是跟機械一樣呆板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110126,
					"content": "他說著什麼要救回他的寶貝零件，一個人衝進沙漠裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110127,
					"content": "啊啊——乾脆讓魔物抓走他算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110128,
					"content": "#嗚哇…怎麼辦，{NICKNAME}？要是放著不管的話，不僅那位學者有危險，沙蟲的問題也不好解決…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110129,
					"content": "不能對沙漠的危機置之不理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "唉…謝謝，謝謝！抱歉，剛剛被氣得有點失言了…我這就在地圖上標出遇襲的地點，咳，請您盡快找到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110132,
					"content": "希望他的腦袋還沒生鏽到直接衝進魔物堆裡撿零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735110130,
					"content": "救援的工作就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "我對付過更大隻的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "你們需要幫助嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
