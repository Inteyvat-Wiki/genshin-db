				"objectNames": [
					"弘毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "這井水到底是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190302,
					"content": "關於海燈節禮品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "噢，這是總務司送過來的吧。謝啦，我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190304,
					"content": "不過，我還得繼續在這裡執勤一段時間，免得有居民在節日期間過來取水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190305,
					"content": "唉，這井水也不知道是怎麼一回事…但總之，一定是不能喝了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弘毅"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
				7181905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
