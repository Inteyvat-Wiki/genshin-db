			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"向明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "#嗯？{F#妳}{M#你}有什麼事，我在執行任務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190202,
					"content": "關於海燈節禮品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "小聲點！我在執行任務呢，什麼禮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190204,
					"content": "#是總務司要{F#妳}{M#你}送來的？哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190205,
					"content": "唉，又是一年海燈節了，本來今年我還想早點回家的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190206,
					"content": "可是看現在這狀況，我可不敢放鬆…我看又得晚幾天回家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190207,
					"content": "#謝謝{F#妳}{M#你}跑這一趟，這個我就收下了，辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190208,
					"content": "唉，那傢伙到底什麼時候走啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "向明"
				}
			]
		},
		{
