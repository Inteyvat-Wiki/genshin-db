			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一弦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "嗚嗚…我，我還沒寫好願望呢…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190402,
					"content": "弦兒乖，千岩軍叔叔去已經幫妳拿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190403,
					"content": "關於蔡樂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "#{F#妳}{M#你}是在找那位千岩軍叔叔嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190405,
					"content": "剛才弦兒在霄燈上寫願望的時候，不小心把霄燈放飛了，一直往那邊飛了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190406,
					"content": "那位千岩軍叔叔說，他看見霄燈掛在了樹上，他去那邊幫我們拿霄燈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190407,
					"content": "那盞霄燈很特別嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "我是這麼和弦兒說的，但是她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190410,
					"content": "嗚…不…不是嘛，那是哥哥做給我的，哥哥做了好久才做好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190411,
					"content": "弦兒乖，千岩軍叔叔很快就回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190412,
					"content": "#抱歉，如果{F#妳}{M#你}急著找那位千岩軍叔叔的話，可以去那邊找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190408,
					"content": "不能重新做一盞嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
