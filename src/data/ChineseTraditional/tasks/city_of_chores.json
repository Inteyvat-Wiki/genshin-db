					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "唉…事情真是做不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "沒事，我正在整理海燈節期間要處理的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190104,
					"content": "只不過…越整理越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190105,
					"content": "雖然其他同事幫我分擔了一部分，但今年輪到我帶隊去送霄燈，得快點準備好東西才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190106,
					"content": "送霄燈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "#對喔…{F#妳}{M#你}應該不知道，我說的「送霄燈」不是{F#妳}{M#你}想的那種，普通地把霄燈送給別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190109,
					"content": "簡單來說…應該更像是送去節日的祝福啦，氛圍啦之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190110,
					"content": "比如，海燈節期間，雖然大部分人都回家過節了，一般的店鋪也會休假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190111,
					"content": "但為了維持節日裡的秩序，還有處理一些事務，還有一部分千岩軍會繼續在節日期間值班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190112,
					"content": "總務司在海燈節期間一般也會安排人去給他們送些禮品去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190113,
					"content": "我今天就正準備去給負責城裡守衛的千岩軍們「送霄燈」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190114,
					"content": "不過…我帶的人也不太夠了，有些禮品送出去了，但還有些沒送出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190115,
					"content": "#旅行者，{F#妳}{M#你}能幫我把這些禮物送過去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190116,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "#{F#妳}{M#你}願意幫忙嗎？那太好了，就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190118,
					"content": "要送給誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "我看看…還有沒送到的千岩軍是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190120,
					"content": "向明…弘毅…還有蔡樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190121,
					"content": "#我把他們的位置標記給{F#妳}{M#你}，就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190107,
					"content": "是要送很多人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
			"id": 7181902,
			"completionStepIds": [
				7181902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
