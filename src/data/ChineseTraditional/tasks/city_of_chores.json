			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "#{F#妳}{M#你}回來了，禮品發的怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190702,
					"content": "都發給對應的人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "#謝謝，實在是幫大忙了…沒有{F#妳}{M#你}的話，我肯定忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190704,
					"content": "他們整個假期都不會放假嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "這個…唉，雖然總務司也會安排千岩軍們交替值班…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190706,
					"content": "但璃月實在是太大了，需要駐守和巡邏的地方也太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190707,
					"content": "就算是交替值班，人手也總是不夠，總會有人不得不在節日期間值班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190708,
					"content": "而且因為每年的海燈節都很盛大，所以在節日期間，有的地方工作壓力反而會更大，無論怎麼分配人手都不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190709,
					"content": "那真是辛苦了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "沒有啦，沒有，這是我們應該做的…只要海燈節一切順利就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190712,
					"content": "#對了，在海燈節期間，其實還有很多人需要幫助，如果{F#妳}{M#你}願意的話，可以多多去幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190713,
					"content": "如果能讓更多的人能參與「海燈節」，節日的氛圍也肯定會更加熱鬧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190714,
					"content": "我們之所以會「送霄燈」，也是希望每個人都能放出一盞霄燈，許出自己的心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190715,
					"content": "如果再說得寬泛點…就是把「海燈節」帶去四面八方，讓所有人都能感受到海燈節的氛圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190716,
					"content": "畢竟，海燈節可是所有人的節日啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190717,
					"content": "#好啦，我還要有事情要做，就先去忙了，祝{F#妳}{M#你}在海燈節上玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190710,
					"content": "辛苦你們了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
