				"points": []
			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "哎…這要怎麼上去呢，唔…不然還是換個方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190502,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "旅行者？哈哈，沒事沒事，我正在想著怎麼爬上去把那盞霄燈拿下來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190504,
					"content": "不過這樹也太難爬了，我穿著一身甲胄，爬一半就滑下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190505,
					"content": "#呃…旅行者，如果{F#妳}{M#你}願意的話，能不能幫我上去把那盞霄燈給取下來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190506,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "#好，那就拜託{F#妳}{M#你}了，那孩子都急哭了，得快點把霄燈拿回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蔡樂"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181908",
							"2"
						],
						"stepId": 7181908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蔡樂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "#怎麼樣，{F#妳}{M#你}拿到霄燈了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190602,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "#我看看…對，就是這盞，謝謝{F#妳}{M#你}啊，我現在就把霄燈帶回去給他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190604,
					"content": "這麼長時間了，也不知道那兩個孩子是不是還待在原地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190605,
					"content": "關於禮品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "#這是總務司送的吧，好的，我收下了，謝謝{F#妳}{M#你}跑這麼一趟啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190607,
					"content": "這也是千岩軍的職責嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "#{F#妳}{M#你}說幫忙拿霄燈嗎？哈哈哈，當然算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190609,
					"content": "不管是拿霄燈，還是趕走不懷好心的人，或者是去擊退魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190610,
					"content": "幫助需要幫助的人，這就是千岩軍的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190611,
					"content": "#好了，再次感謝{F#妳}{M#你}。我要趕緊把霄燈帶給那兩個孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "蔡樂"
				},
				{
					"id": 718190612,
					"content": "然後我還得接著去處理另外的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蔡樂"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181909",
