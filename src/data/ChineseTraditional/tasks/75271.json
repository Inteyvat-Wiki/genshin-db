			"dialogs": [
				{
					"id": 752710601,
					"content": "尤普依！妳來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710602,
					"content": "斯奇…？是你？你怎麼穿成這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710603,
					"content": "這是你最喜歡的娜娜絲梨人…我去租來的，帥嗎？還有這些氣球，也是我專門準備的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710604,
					"content": "其實我有一句話，很早就想跟妳說了…和我交往吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710605,
					"content": "你…你有病吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710606,
					"content": "不！我心愛的女孩，尤普依，請和我交往吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710607,
					"content": "你真的不是腦子壞了嗎？今天是我們結婚三週年啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710608,
					"content": "我當然記得！但…妳一直說我不懂浪漫，結婚前連一次真正的告白都沒有…所以…這就是我遲到的告白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710609,
					"content": "哈…知道了，我同意了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710610,
					"content": "欸？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710611,
					"content": "我說我同意啦，我浪漫的小男子漢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710612,
					"content": "悠悠的風兒吹過，將兩人擁抱在一起。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
