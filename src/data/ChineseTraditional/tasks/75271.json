					"斯奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "浪漫的紅氣球！真漂亮…我心愛的尤普依一定會喜歡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710302,
					"content": "#{F#妳}{M#你}說是吧，朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710303,
					"content": "呃…我不確定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#不論如何，非常感謝{F#妳}{M#你}，朋友。請別離開，我想讓尤普依也認識{F#妳}{M#你}一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710306,
					"content": "算算時間，她馬上就會過來了，我們約好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710304,
					"content": "當然，她一定會被你打動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
