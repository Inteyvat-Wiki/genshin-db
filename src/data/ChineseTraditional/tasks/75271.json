			},
			"dialogs": [
				{
					"id": 752710101,
					"content": "#請不要弄壞了這些氣球。如果{F#妳}{M#你}想玩氣球，我可以送{F#妳}{M#你}一些別的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710102,
					"content": "這些氣球還滿特別的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "說起來還有點不好意思，這是重要的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710104,
					"content": "#看它的樣子，{F#妳}{M#你}應該也猜到是用來幹什麼的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710105,
					"content": "求婚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "是告白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710109,
					"content": "我會在浪漫的氣球中間向我心愛的尤普依表露心意，你覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710110,
					"content": "應該用紅色的氣球。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "#欸？{F#妳}{M#你}說得有道理…我果然還是缺乏了一點浪漫精神嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710112,
					"content": "可是尤普依馬上就要來了，這時候去哪裡找紅氣球啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710107,
					"content": "告白？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "沒…沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "斯奇"
				}
			]
		},
		{
			"id": 7527102,
