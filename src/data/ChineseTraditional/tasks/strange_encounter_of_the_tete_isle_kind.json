				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "#重要的是，{F#妳}{M#你}有在這附近看到一個光頭嗎？我找他有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520702,
					"content": "我也是來找他的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "哦？他剛才在這裡是嗎？看來已經跑了，是知道我正在追他了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520709,
					"content": "哼，伊凱卡…你跑不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520706,
					"content": "#看在我們還算有緣的份上，勸你離那傢伙和我都遠一點，免得{F#妳}{M#你}這張漂亮臉蛋濺到白白紅紅的髒顏料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520707,
					"content": "這些是我在營地裡搜出來的東西，我猜是他來不及帶走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520708,
					"content": "#送給{F#妳}{M#你}了，別有什麼顧慮，這些東西現在是我說了算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520710,
					"content": "那傢伙的命遲早也都是我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520703,
					"content": "沒看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "#{F#妳}{M#你}沒騙我吧？我暫且信了{F#妳}{M#你}這張誠懇的小臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "泰克胡"
				}
			]
