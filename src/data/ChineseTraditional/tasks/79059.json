			"dialogs": [
				{
					"id": 790590101,
					"content": "此處為短劇《東行·旅途的開始》片場的棄用場景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790590102,
					"content": "原本構想的是一名旅者試圖從楓丹出發，向東前往須彌城尋找智慧宮不智之智的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790590103,
					"content": "這一幕是他在路上解救了被巨岩壓身的「變幻大師」，與之一起踏上旅途的情節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790590104,
					"content": "啊不過，不管是飾演旅者的水形幻靈，還是飾演「變幻大師」的水形幻靈都不知道到哪去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790590105,
					"content": "如果能<color=#00E1FFFF>把他們全都找回來</color>，捕捉到在巨岩邊練習的時刻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "片場備註"
				}
			]
		},
