			"dialogs": [
				{
					"id": 751870101,
					"content": "#角上沒有火焰一樣的花紋…不是{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870102,
					"content": "唔，這個小傢伙又是哪來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870103,
					"content": "奧奇卡納塔的龍蛋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "哦，是那個時候的龍蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870105,
					"content": "嗚呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870106,
					"content": "沒想到蛋裡的也是一隻嵴鋒龍呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870107,
					"content": "我記得之前保護這顆龍蛋的人有幫牠取名字…這個小傢伙的名字是「阿瓜拉」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870108,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870109,
					"content": "哦哦，看來你對自己的名字有反應呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870110,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870111,
					"content": "#就跟{REALNAME[ID(2)|SHOWHOST(true)]}一樣，這傢伙也沒有家了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870112,
					"content": "#那不然就跟我們一起吧！嘿嘿，我和{NICKNAME}，很會和嵴鋒龍做朋友呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870113,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870114,
					"content": "嘿嘿…我就知道你會答應的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870115,
					"content": "#{F#妳}{M#你}像一度為過去的夥伴那樣，為牠繫上了絲巾。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "嗯，上一隻戴著絲巾的小龍，最後成長成了很了不起、很了不起的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870117,
					"content": "阿瓜拉！希望、希望你也能像牠一樣，健康長大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
