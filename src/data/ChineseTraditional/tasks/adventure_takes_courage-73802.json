			"dialogs": [
				{
					"id": 738020101,
					"content": "向著星辰與深淵！歡迎來到冒險家協會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020102,
					"content": "妳好呀，凱瑟琳小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738020103,
					"content": "妳好，凱瑟琳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "#{F#妳}{M#你}們好，看起來兩位今天的狀態很不錯啊。請問您是來接取委託的嗎？還是來處理其他事務的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020105,
					"content": "嗯…兩位為什麼一直盯著我？是…有什麼事要問我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020106,
					"content": "沒有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "這樣啊…看您的樣子，冒險的經驗應該很豐富了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020109,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "#那麼，想必{F#妳}{M#你}也已經很熟悉冒險家協會的運作方式了，我就不多贅述，以免耽誤您的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020111,
					"content": "如果您對協會內的事務有任何疑問，都歡迎來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020112,
					"content": "在須彌城裡，也請您多多完成委託吧。像您這樣實力強大的冒險家，一定能幫上人們不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020113,
					"content": "請繼續勇敢冒險吧，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 738020107,
					"content": "只、只是想要接點委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
}