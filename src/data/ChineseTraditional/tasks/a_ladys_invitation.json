			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「木偶」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "#嗯？{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180102,
					"content": "妳好啊！桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180103,
					"content": "謝謝妳的邀請。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "咦？妳信裡不是說要開茶會嗎？怎麼這裡什麼都沒有，妳該不會沒準備好茶點吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180106,
					"content": "哈，笑話。妳還真是小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180107,
					"content": "哇！這…這桌子是怎麼突然變出來的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180108,
					"content": "哼哼，厲害吧？這是我新研製的攜帶式茶桌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180109,
					"content": "它不僅方便攜帶、易於收納，甚至還加裝了和法潔歐一樣的懸浮裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180110,
					"content": "#更厲害的是…呃，算了，我就不自誇了，搞得像我在推銷一樣。{F#妳}{M#你}們自己感受吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180111,
					"content": "來，這是我準備的茶和點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180112,
					"content": "那我不客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "唔…！真好吃！妳手藝果然很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180114,
					"content": "那是當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180115,
					"content": "不過，妳怎麼會想到要做這麼一個裝置啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180116,
					"content": "當然是為了和朋友們在任何地方都能度過一段愉快的茶會時光啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180117,
					"content": "之前我也說過，留住珍貴之物的方法並不只有堅守你已有的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180118,
					"content": "現在的我，變得想多出去走、多去見見朋友們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180119,
					"content": "但讓收到邀請的人準備茶點、收拾茶桌，未免太不符合淑女的禮儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180120,
					"content": "嘿嘿，我倒是覺得朋友們不會在意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180121,
					"content": "我在意。而且這種簡單的發明對我來說也不費力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180122,
					"content": "#看{F#妳}{M#你}們這麼喜歡，乾脆就送{F#妳}{M#你}們一個好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180123,
					"content": "欸？！這怎麼行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180124,
					"content": "沒什麼不行的。說了我很會做這些東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180125,
					"content": "那就謝謝了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "#別客氣，{F#妳}{M#你}們千靈節的時候也幫了我不少忙，就當是淑女的回禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180104,
					"content": "希望沒讓妳等太久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}