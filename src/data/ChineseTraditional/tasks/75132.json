			"dialogs": [
				{
					"id": 751320601,
					"content": "#啊，異邦的勇士啊…我能感受到…{F#妳}{M#你}所做出的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320602,
					"content": "真是了不起啊，勇士，被侵蝕的力量也回歸了夜神的國度，我能感受到夜魂們的歡悅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320603,
					"content": "那麼…就將這些作為報酬吧，勇士。達成偉業者應當有所獎賞，請收下這些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謎畫塗鴉中的意志"
				}
			]
		}
