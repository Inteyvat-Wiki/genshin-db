			"dialogs": [
				{
					"id": 751320101,
					"content": "…啊…自遙遠處而來的，異邦的勇士啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320102,
					"content": "請您聽聽我的話語吧…啊，我是引路的夜鴉，亦是真夜主人揣摩詩句的憶緒…或也只不過是月光中千萬念頭中的一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320103,
					"content": "請您聽聽我的話語吧…因為地下流淌的靈河破碎不堪，我也只能藉這形象與您述說，以求您提防那些漆黑的敵讎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320104,
					"content": "那破碎的鏡子曾映照在此地，而如今黑煙逐漸瀰漫之處有三，請您記住：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320105,
					"content": "其一是東側，那過往英雄傳說壁畫中潛藏的陰影逐漸浮現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320106,
					"content": "其二是西側，迷海之上，漆黑的化身如惱人的鸚鵡一般模仿夤夜之主的口舌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320107,
					"content": "其三是群崖之下，原本應已絕跡的失色之霧，在燼城又開始蠢動後瀰漫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "謎畫塗鴉中的意志"
				},
				{
					"id": 751320108,
					"content": "異邦的勇士啊，請務必小心…小心那漆黑之敵漫行之處，小心侵蝕一切的敵讎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謎畫塗鴉中的意志"
				}
			]
		},
