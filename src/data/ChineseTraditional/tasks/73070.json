						],
						"stepId": 7307016,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73263",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭羅摩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730702101,
					"content": "第三顆恆素果到手！按照蘭拉迦之前說的，記得是三個就夠了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702102,
					"content": "#嗯！應該夠了。謝謝{F#妳}{M#你}們，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702103,
						730702105
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702103,
					"content": "不用謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702104
					]
				},
				{
					"id": 730702104,
					"content": "…這麼說來，明明是蘭羅摩在幫我們，為什麼要感謝我們呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702106,
					"content": "#嗯。我想想，應該要這樣說。因為{F#妳}{M#你}們也在幫助蘭拉娜，蘭拉娜是我的朋友，所以謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702107
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702107,
					"content": "#然後，那菈{NICKNAME}幫助蘭耶娑、蘭陀娑和蘭修提袈，找到了古老的歌。他們也是我的朋友，所以謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702108
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702108,
					"content": "#最後，和那菈{NICKNAME}、派蒙一起冒險，我很開心，所以謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702109
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702109,
					"content": "我也很開心！謝謝你，蘭羅摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702110,
					"content": "這麼說來，覺樹之堂附近感覺好像都曾經有人活動的痕跡…這邊有什麼故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702111,
					"content": "那是很久很久以前的故事，那時候我連種子都還不是。在很久很久以前，那菈都能看到蘭那羅，蘭那羅也不害怕那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702112
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702112,
					"content": "#在那時候，那菈幫助蘭那羅，蘭那羅幫助那菈，我們一起玩，就像我和那菈{NICKNAME}一樣，還經常一起唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702113
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702113,
					"content": "像蘭耶娑他們那樣的採歌者，原本也是蘭那羅學習那菈得來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702114
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702114,
					"content": "覺樹之堂，原本是蘭那羅和那菈一起玩的地方。但那是很久很久以前的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702115
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702115,
					"content": "在發生了很可怕很可怕的災難以後，桓那蘭那毀滅了，覺樹之堂也荒廢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702116
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702116,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702117,
					"content": "嗯。那是很可怕的故事。但幸好，那只是故事，不是我的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702118
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702118,
					"content": "#別擔心！以後會愈來愈好的，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702119,
						730702120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702119,
					"content": "嗯，沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702122
					]
				},
				{
					"id": 730702122,
					"content": "已經找到了覺樹之堂，也得到了三個恆素果。接下來，我要去幫忙準備無憂節，去把一些森林裡的同伴叫回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702123
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702123,
					"content": "嗯！蘭羅摩，加油！我好期待無憂節！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702124,
					"content": "我也好期待！那就再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702125
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702125,
					"content": "蘭羅摩，再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702120,
					"content": "這可不好說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702121
					]
				},
				{
					"id": 730702121,
					"content": "#…{NICKNAME}，{F#妳}{M#你}是不是累了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702105,
					"content": "明明是你在幫我們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702106
					]
				}
			]
