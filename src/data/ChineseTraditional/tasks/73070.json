			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭修提袈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700401,
					"content": "蘭羅摩！我們又見面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700402,
					"content": "#嗯！那菈{NICKNAME}、派蒙，{F#妳}{M#你}們好。這位是蘭修提袈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700403
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700403,
					"content": "#哇！那菈{NICKNAME}、派蒙，很高興認識{F#妳}{M#你}們！和詩歌裡說的一樣，金色的那菈，又高又強壯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700404
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700404,
					"content": "我也很高興！蘭修提袈是蘭羅摩的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700405,
					"content": "嗯！蘭修提袈是「採歌者」，經常去收集各種各樣的歌曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700406
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700406,
					"content": "在種子變成樹苗之前，我們還一起藏在樹葉裡，到草王的大樹裡去，看那菈一邊喝會讓他們變笨的水，一邊唱歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700407
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700407,
					"content": "#那菈{NICKNAME}、派蒙，有詩歌嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700408
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700408,
					"content": "詩歌嗎…如果是那個綠色的傢伙，應該知道不少吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700409,
					"content": "綠色的傢伙？暝彩鳥？蕈豬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700410
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700410,
					"content": "不是不是！他是蒙德的風神，是吟遊詩人喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700411,
					"content": "哇！那一定知道很多歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700412
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700412,
					"content": "好厲害！風神一定能把詩歌用風吹到很遠很遠的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700413
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700413,
					"content": "嗯！不過話說回來，這裡是覺樹之堂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700414,
					"content": "啊。不是的，但這也是很厲害的發現。在這裡，沉睡著很多年沒有蘭那羅找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700415
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700415,
					"content": "蘭那羅的採歌者，會一直一直追求歌的美麗。所以，在時間的最後，會把只屬於自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700416,
						730700418
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700416,
					"content": "那和覺樹之堂有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700417
					]
				},
				{
					"id": 730700417,
					"content": "這邊似乎是有蘭瑪哈留下的歌。如果是這樣的話，附近應該就有莎蘭樹了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700420,
					"content": "莎蘭樹…之前蘭拉迦好像說過，就是那個什麼來著，我看看森林書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700421,
					"content": "#莎蘭樹！就是能結出恆素果的莎蘭樹！我們也幫忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700422,
					"content": "太好了！能和那菈一起研究過去的歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700423
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700423,
					"content": "蘭瑪哈很喜歡這種玫瑰，但用玫瑰將詩歌藏起來的辦法是蘭雅瑪發現的！因為蘭雅瑪很驕傲，所以他的玫瑰也很驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700424
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700424,
					"content": "所以，玫瑰不會自己告訴我們。只有聰明的蘭那羅，或者聰明的那菈，才能夠找到隱藏的歌。但是蘭修提袈不夠聰明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700425
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700425,
					"content": "#不用擔心！哼哼，{NICKNAME}可是很聰明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700426,
						730700427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700426,
					"content": "既然是為了幫助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700428,
					"content": "嗯！找東西嘛，我們很擅長的，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700427,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700418,
					"content": "祝你們好運。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700419
					]
				},
				{
					"id": 730700419,
					"content": "#嗯！謝謝那菈{NICKNAME}。這邊似乎是蘭瑪哈留下的歌。如果是這樣的話，附近應該就有莎蘭樹了。運氣很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "蘭羅摩"
				}
			]
		},
