					"id": 730702020,
					"content": "嗯！蘭羅摩接下來也要去找覺樹之堂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702021,
					"content": "對！我們一定會再見的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702022
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702022,
					"content": "要注意安全喔，蘭羅摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730702023,
					"content": "#{F#妳}{M#你}們也是，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730702014,
					"content": "覺王的夢之樹讓夢跑不掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702015
					]
				},
				{
					"id": 730702006,
					"content": "還好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702007
					]
				}
			]
		},
		{
			"id": 7307021,
			"completionStepIds": [
				7307016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
