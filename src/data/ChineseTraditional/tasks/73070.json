							"7307006",
							"2"
						],
						"stepId": 7307006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭修提袈",
					"蘭羅摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700601,
					"content": "「來呀，來呀，苗圃的夢想，樹葉的記憶…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700602
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700602,
					"content": "「看，寶石一般的石榴，餘暉色的日落果…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700603
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700603,
					"content": "原來如此，蘭納迦他們的歌，和蘭瑪哈的歌是同源的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700604
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700604,
					"content": "同源是指…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700605,
					"content": "歌就像河川一樣。他們一開始，都在一起，那就是「源之歌」，她是所有歌的故鄉、大河的源頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700606
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700606,
					"content": "後來，又因為不同的記憶、不同的故事，所以唱出來以後，發生變化。就像河流變成小溪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700607
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700607,
					"content": "但所有的小溪都會流入大海，所有的歌最終也會匯聚成同一首，回歸成源之歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700608
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700608,
					"content": "#所以，採歌的蘭那羅，要找到所有的歌。這樣的話，就能找到源之歌。謝謝{F#妳}{M#你}，那菈{NICKNAME}、派蒙，找到了蘭瑪哈的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700609,
						730700612
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700609,
					"content": "真是了不起的願望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700610
					]
				},
				{
					"id": 730700610,
					"content": "#謝謝那菈{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700611
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700611,
					"content": "嗯…歌一直會變多，還會改變，那要怎樣才能找到所有的歌呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700613,
					"content": "蘭那羅也會增加。所以，只要一直努力，一定沒問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700614
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700614,
					"content": "蘭瑪哈的歌，能夠吸引健壯的草種子。他的覺樹之堂，應該也是這樣封印的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700615
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700615,
					"content": "#既然那菈{NICKNAME}找到了他的歌，我們就能到覺樹之堂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700616
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700616,
					"content": "#嗯！祝{F#妳}{M#你}們好運，那菈{NICKNAME}、派蒙，還有蘭羅摩！我先去為無憂節做準備啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700617
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700617,
					"content": "交給我們吧！無憂節再見，蘭修提袈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700618,
					"content": "再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700612,
					"content": "歌是會不斷增加的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700613
					]
				}
			]
		},
		{
			"id": 7307013,
			"completionStepIds": [
				7307013
			],
