					"蘭修提袈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700501,
					"content": "蘭羅摩！我們又見面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700502,
					"content": "#嗯！那菈{NICKNAME}、派蒙，{F#妳}{M#你}們好。這位是蘭修提袈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700503
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700503,
					"content": "#哇！那菈{NICKNAME}、派蒙，很高興認識{F#妳}{M#你}們！和詩歌裡說的一樣，金色的那菈，又高又強壯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700504
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700504,
					"content": "我也很高興！蘭修提袈是蘭羅摩的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700505,
					"content": "嗯！蘭修提袈也是「採歌者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700506
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700506,
					"content": "在種子長成樹苗之前，我們還一起藏在樹葉裡，到過草王的大樹裡！看那菈一邊喝會讓他們變笨的水，一邊唱歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700507
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700507,
					"content": "#那菈{NICKNAME}、派蒙，有詩歌嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700508
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700508,
					"content": "詩歌嗎…如果是那個綠色的傢伙，應該知道不少吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700509,
					"content": "綠色的傢伙？暝彩鳥？蕈豬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700510
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700510,
					"content": "不是不是！他是蒙德的風神，是吟遊詩人喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700511,
					"content": "哇！那一定知道很多歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700512
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700512,
					"content": "好厲害！風神一定能把詩歌用風吹到很遠很遠的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700513
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700513,
					"content": "嗯！不過話說回來，這裡也有隱藏的歌嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700514,
					"content": "這邊似乎是蘭瑪哈留下的歌。所以，附近應該有莎蘭樹了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700515
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700515,
					"content": "#所以，那就能得到恆素果…我們也幫忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700516,
					"content": "太好了！能和那菈一起研究過去的歌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700517
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730700517,
					"content": "蘭瑪哈很喜歡這種玫瑰，但用玫瑰將詩歌藏起來的辦法是蘭雅瑪發現的！因為蘭雅瑪很驕傲，所以他的玫瑰也很驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700518
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700518,
					"content": "所以，玫瑰不會自己告訴我們。只有聰明的蘭那羅，或者聰明的那菈，才能夠找到隱藏的歌。但是蘭修提袈不夠聰明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700519
					],
					"speakerTitle": "蘭修提袈"
				},
				{
					"id": 730700519,
					"content": "#不用擔心！哼哼，{NICKNAME}可是很聰明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700520,
						730700521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700520,
					"content": "既然是為了幫助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				},
				{
					"id": 730700522,
					"content": "嗯！交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730700521,
					"content": "我真是太聰明了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				}
			]
		},
		{
			"id": 7307006,
			"completionStepIds": [
				7307006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
