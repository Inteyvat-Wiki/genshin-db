			"trigger": {
				"objectNames": [
					"菲謝爾"
				],
				"points": [
					{
						"sceneId": 1090,
						"position": [
							18.129,
							0,
							20.305
						],
						"pointId": 14
					},
					{
						"sceneId": 1090,
						"position": [
							16.22,
							0,
							19.822
						],
						"pointId": 15
					},
					{
						"sceneId": 1090,
						"position": [
							16.512,
							0.01,
							21.178
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 705440101,
					"content": "哦呵呵~既是被冠以「貓茸茸城堡」這般奇巧之名的寶地，陳設如此凡俗，未免有些寒酸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440102
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440102,
					"content": "至少要裝設幾座…紫瑪瑙葡萄藤編織而成的鞦韆！純淨白銀的燈盞上，應當是淵水海鹽製成的蠟燭，點亮晚星紋樣的貓餐盤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440103
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440103,
					"content": "嗯…還有雕像！熔煉失落王朝的古幣，以峽灣深底的奇異珍珠和露滴為副材料，打造貓之眷屬的雕像，想必是個不錯的選擇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440104
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440104,
					"content": "#{F#妳}{M#你}也是這麼想的，沒錯吧？這位貓之眷屬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440105
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440105,
					"content": "#呃…{F#妳}{M#你}還未報上名號來。好好斟酌措辭吧，讓本皇女知曉{F#妳}{M#你}的名字，可是無上的榮耀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440106
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440106,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440107
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440107,
					"content": "牠叫「阿呆」哦，尊貴的皇女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440108,
					"content": "「阿呆」不太懂事，聽不懂皇女考究的用詞，還請皇女見諒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440109,
					"content": "不對不對！怎麼一見到菲謝爾，我就自動進入那種狀態了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440110,
						705440111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440110,
					"content": "沒什麼不好的，我也開演！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				},
				{
					"id": 705440112,
					"content": "#果然，不出所料，兩位「貓之魔法師」，{F#妳}{M#你}們再次被命運的紐帶牽引，來到了本皇女的面前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440113
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440113,
					"content": "真是令人感慨的重逢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440114
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440114,
					"content": "這個稱呼…看來菲謝爾已經從瓦樂瑞娜那裡聽說了我們的事了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440115,
					"content": "#有{F#妳}{M#你}們出謀劃策，近來本皇女在幽夜淨土深思之時，偶然從過往閱歷中尋獲的巧念，便能輕鬆落實了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440116
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440116,
					"content": "本皇女打算遴選感官最為敏銳、才思最為聰穎的貓之眷屬，與本皇女同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440117
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440117,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440118
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440118,
					"content": "原來菲謝爾也有養貓的打算啊，想一想也還滿正常的，大部分人見識過貓貓的可愛後，應該都會想養一隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440119,
					"content": "不過，菲謝爾不是有奧茲陪著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440120,
					"content": "你們行動的速度本來就很快，貓貓真的跟得上嗎？還是說…要讓奧茲載著貓貓飛行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440121,
					"content": "哼哼，本皇女時常跨越三千宇宙，雖說旅途不算漫長，但適當多些夥伴，洞悉易被忽略之物…自然沒有壞處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440122
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440122,
					"content": "奧茲也很想與貓之眷屬玩…咳！想與貓之眷屬通力合作，確保本皇女每時每刻的心緒都如霽月光風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440123
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440123,
					"content": "可惜，即便奧茲難得展示平易近人的姿態，也難以完全隱去身上的威壓，無法接近貓之眷屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440124
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440124,
					"content": "距離奧茲不到五步距離時，貓之眷屬們的毛髮就像是飄散的蓬蓬果，疏忽膨脹開來，隨後牠們便會陷入驚恐，四散逃開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440125
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440125,
					"content": "虔信風神的忠實修女建議奧茲在外休息，言之有理…我默許了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440126
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440126,
					"content": "威壓？我好像明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440127,
					"content": "難道說是奧茲身上的雷元素太充沛，一進到「貓茸茸城堡」就會讓所有貓貓炸毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440128,
					"content": "這樣一來，要怎麼讓貓貓跟著菲謝爾旅行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440129,
					"content": "要是提瓦特有某種材料…能夠隔絕雷元素的影響就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440130,
					"content": "用這種材料幫貓貓做衣服，就能讓貓貓跟著菲謝爾和奧茲旅行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440131,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440132,
						705440133
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440132,
					"content": "先給我啊！當然先給我啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440134,
					"content": "不過仔細想想，元素力超級超級厲害，隨隨便便就能找到抵抗元素力的材料…哪有那麼好的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440135,
					"content": "我們兩個也不要做白日夢了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440136,
					"content": "天真！勿要以常理估量貓之眷屬的才能！凡人的隻言片語難以概括牠們的特質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440137
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440137,
					"content": "此世的某地或許存在…能潛入水下、耐受烈火、能乘風而行的貓之眷屬，必然也有無懼轟雷的特殊個體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440138
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440138,
					"content": "只要本皇女耐心尋找，定然不會錯過，至多再等十年百年，不過幽夜淨土時鐘上的片刻光陰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440139
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440139,
					"content": "此外，後天的修行也相當重要，我看「阿呆」頗有潛力，說不定跟著本皇女一段時間後，對雷之力就會愈加熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440140
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440140,
					"content": "正巧本皇女理清了萬千繁雜事務，近來還算空閒，不妨在此多多觀察貓之眷屬們…尤其是「阿呆」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440141
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 705440141,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705440142
					],
					"speakerTitle": "「阿呆」"
				},
				{
					"id": 705440142,
					"content": "嘿嘿，那就祝妳在「貓茸茸城堡」玩得開心啦，菲謝爾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705440133,
					"content": "我穿上它去暴打雷史萊姆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440134
					]
				},
				{
					"id": 705440111,
					"content": "大貓之魔法師，前來參謁！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705440112
					]
				}
			]
		}
	]
}