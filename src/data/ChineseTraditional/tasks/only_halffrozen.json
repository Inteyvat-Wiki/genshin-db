				"points": []
			},
			"dialogs": [
				{
					"id": 205200201,
					"content": "我去幫你找個熱源。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200202
					]
				},
				{
					"id": 205200202,
					"content": "#那最好…那最好，拜託{F#妳}{M#你}，請快點…我感覺我馬上就要被凍住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯米"
				}
			]
		},
		{
