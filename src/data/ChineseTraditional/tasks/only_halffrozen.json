			"trigger": {
				"objectNames": [
					"湯米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200101,
					"content": "#旅…旅行者…{F#妳}{M#你}…能…能不能幫幫我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200102,
					"content": "你這是怎麼了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "#拜…拜託{F#妳}{M#你}，先幫我找個熱源來…我…實在是太冷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200104,
					"content": "#或，或者…{F#妳}{M#你}幫我找點熱菜來也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200105,
					"content": "拜…拜託了，我真的冷得受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯米"
				}
			]
		},
		{
			"id": 2052002,
			"completionStepIds": [
				2052002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
