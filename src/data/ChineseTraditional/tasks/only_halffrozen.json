				"points": []
			},
			"dialogs": [
				{
					"id": 205200301,
					"content": "我去幫你做點熱菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200302
					]
				},
				{
					"id": 205200302,
					"content": "#那…那也不錯，那就拜託{F#妳}{M#你}了，請快一點…我感覺我馬上就要被凍住了…",
					"roleType": "TALK_ROLE_NPC",
