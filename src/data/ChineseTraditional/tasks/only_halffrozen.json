			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#呼…這下暖和多了，謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200402,
					"content": "你怎麼會在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "唉，還不是因為委託的事…我因為一件不那麼容易的委託…一直待在這個營地裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200404,
					"content": "可老是這麼待著也不是事，我就想找點事來做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200405,
					"content": "營地的那位廚師哈里斯，說是想要拜託人去雪山裡找什麼「冷鮮肉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200406,
					"content": "他還說，只要去找那些被冰凍住的小豬就行了，不用太過深入雪山，沒有任何危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200407,
					"content": "我覺得這件事很簡單，就把這個委託接下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200408,
					"content": "而且，我也是準備就這樣慢慢鍛煉自己，逐漸熟悉雪山的環境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200409,
					"content": "然後再把那位…煉金術士小姐的委託給完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200410,
					"content": "#但沒想到，我剛進雪山，沒走幾步就迷了路，差點被凍成冰塊，還好遇見了{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200411,
					"content": "我現在就是非常後悔…委託也沒完成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200412,
					"content": "#旅行者…我感覺{F#妳}{M#你}好像相當熟悉雪山，能拜託{F#妳}{M#你}幫個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200413,
					"content": "#拜託{F#妳}{M#你}，只要幫我找到一份「冷鮮肉」就好，只要一份，我就能完成這個委託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200414,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "#太好了，那讓我把哈里斯說的冰凍住的小豬會出沒的地點幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200416,
					"content": "#那麼，我就先去山腳下的營地裡等{F#妳}{M#你}的好消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯米"
				}
			]
		},
