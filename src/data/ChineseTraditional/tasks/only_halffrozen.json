			"dialogs": [
				{
					"id": 205200501,
					"content": "#{F#妳}{M#你}找到「冷鮮肉」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200502,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "太好了，這就是「冷鮮肉」嗎？但是除了摸起來冷冰冰的，好像也沒什麼不同…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200504,
					"content": "算了，我只管完成委託就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200505,
					"content": "#謝謝{F#妳}{M#你}旅行者，要不是{F#妳}{M#你}我就慘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "湯米"
				},
				{
					"id": 205200506,
					"content": "#這些報酬請{F#妳}{M#你}一定要收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯米"
				}
			]
		},
