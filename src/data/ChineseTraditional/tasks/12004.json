			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "唔，接下來做什麼好呢…快想想我們還有什麼計畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040102,
					"content": "旅行者，派蒙，請留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040103,
					"content": "哎？綾華？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040104,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "#有件事想請{F#妳}{M#你}出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040106,
					"content": "話雖如此，也請不要太過擔心。這次不是來自社奉行或神里家的委託，而是以我個人名義發起的請求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040107,
					"content": "個人名義，也就是說，是私事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040108,
					"content": "是的。是一些與家母有關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040109,
					"content": "#或許有點唐突…但這件事在我看來，只能委託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040110,
					"content": "能詳細說說嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "前幾天，我從舊物堆裡找到一本母親留下的筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040112,
					"content": "裡面有她記錄的許多瑣事，其中出現了一個我從未聽說過的人名，而且頻率之高，實在令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040113,
					"content": "應該是妳母親的朋友吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040114,
					"content": "連妳都沒聽說過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "是的。雖然父母都已過世多年，但與他們有過往來的人物，我和兄長大人大抵還是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040116,
					"content": "因此…我對這位陌生人十分好奇，很想見見對方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040117,
					"content": "筆記上寫，對方名叫「椿」，似乎是一個很受我母親重視，也相當有個性、愛玩樂的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040118,
					"content": "聽起來像是女性的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040119,
					"content": "嗯。我想去見她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040120,
					"content": "那妳需要我們做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040121,
					"content": "是要幫妳找人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040122,
					"content": "不不，筆記上有她住所的地點，我們可以直接過去。我想請旅行者與我一起，是因為還要準備幾件見面禮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040123,
					"content": "剛才說的所有事情還請二位替我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040124,
					"content": "原本這樣的事應該委託兄長與我一同處理，但現階段兄長非常忙碌…我又有點私心，不想讓其他當地人士參與到這件事中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040125,
					"content": "所以需要我這個異鄉人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "#沒錯。{F#妳}{M#你}是一個懂得禮節、體恤他人的良善之人，又很可靠，與{F#妳}{M#你}一起，我才好放心些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040127,
					"content": "嗯嗯！準備見面禮什麼的，我們應該能幫上忙喔。報酬的話，請我們吃好吃的東西就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040128,
					"content": "#那太好了，我本就想趁這次機會請兩位到處走走。若{F#妳}{M#你}們不嫌棄，就請跟我一起行動吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040129,
					"content": "#是妳不嫌棄我們！{NICKNAME}，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040130,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "太感謝了！那麼我們現在就出發好嗎？第一站先去小倉屋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120040132,
					"content": "好呀好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}