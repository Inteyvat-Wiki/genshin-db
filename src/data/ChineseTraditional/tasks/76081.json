						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "承讓了，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760810402,
					"content": "請您放心，在你們犧牲後，我的老爹尼基塔成為了新任執燈長，他帶領著被你們所拯救的人們重建了執燈人的軍團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760810403,
					"content": "而如今，我們的力量已經成長到足以在狂獵的陰霾下守護這一方淨土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760810404,
					"content": "你們的奉獻並非徒勞無功，你們的事蹟，你們的意志沒有、也不會被遺忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760810405,
					"content": "再見，西格德先生。我會時常來拜訪的，願您能夠得到安息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "這種壓制魔物的方式…不對，那個傳奇人物應該已經犧牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760819902,
					"content": "難道他以某種方式醒來了嗎？有空得去一趟苔骨荒原東北側的海灘，他的墓地就在那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760819903,
					"content": "我曾從老爺子那裡聽說過，過去他與之並肩作戰的傳奇執燈長西格德的事蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760819904,
					"content": "紫色的劍光，金色的頭髮…與傳說中的一模一樣，這段時間遇見的那個人該不會那就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760819905,
					"content": "苔骨荒原東北側的海灘是他的埋骨地，有時間的話，去那裡看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		}
	]
}