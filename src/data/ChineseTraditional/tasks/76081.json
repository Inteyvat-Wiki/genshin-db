						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "與你的一戰酣暢淋漓，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810202,
					"content": "英雄的末路如此，未免令人惋惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810203,
					"content": "孤獨地遊蕩在你為之奉獻、殞命的土地上…當初響應執燈人之誓的時候，你是否預計到了今天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810204,
					"content": "即便有過，或許你也不會猶豫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810205,
					"content": "未來我還會前來拜訪的，再會了，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
