			"dialogs": [
				{
					"id": 760810101,
					"content": "我聽說在戰鬥中犧牲的傳奇執燈長西格德慣用長劍，壓制魔物的技巧獨一無二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810102,
					"content": "大戰之後，總部沒能找到他的遺骸，於是為他立了這座空墓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810103,
					"content": "紫色的劍光、金色的頭髮…那個四處遊蕩、與狂獵為敵的戰士就是他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810104,
					"content": "看來他的靈魂未能在棺槨裡安息，就像終夜長塋的眾多幽魂一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810105,
					"content": "為了驅散狂獵而提劍的英雄，即便身死，執念依然不熄，仍在與狂獵作戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810106,
					"content": "你值得我的敬意，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810107,
					"content": "但對一個戰士來說，只是出於仇恨與責任而戰鬥，別無其他，這種孤寂過於殘忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810108,
					"content": "你懷念與別人並肩的日子嗎？如今你揮劍的理由，除了殺敵，可否有其他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810109,
					"content": "是的話，就向我現身吧，為何不與我切磋一場？就像執燈人之間常有的比試一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
		{
			"id": 7608102,
			"completionStepIds": [
				7608104
			],
