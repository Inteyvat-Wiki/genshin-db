			"dialogs": [
				{
					"id": 747100101,
					"content": "嗯…在夠寬敞，裝飾還特別用心的水箱之中，乖巧的魚兒們來回游動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100102,
					"content": "這場景的確非常漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100103,
					"content": "這也是水族館吸引人的地方之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747100104,
					"content": "要是牠們在開放的水域裡也這麼安分就好了，潛入水下的人們就能更沉浸地享受自然生命的美景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100105,
					"content": "#言歸正傳，多虧{F#妳}{M#你}們的協助，我查出了這些魚兒暴躁的原因——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100106,
					"content": "這些年來，陸陸續續發生了一些水運事故，還有壞傢伙違法傾倒廢棄物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100107,
					"content": "大量人造物品沉入海底不斷堆積，破壞了許多魚兒的棲息地，導致魚兒們的攻擊性越發高漲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100108,
					"content": "之前，已經有一批潛水員接到委託，開始專門處理這些垃圾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100109,
					"content": "看來得提醒他們，有勞他們加快進度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100110,
					"content": "聽起來短期內無法解決啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "是的，在此期間，我們還是繼續之前的工作，盡可能把更多暴躁的魚兒請回來休養吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100113,
					"content": "將病患與致病環境隔離開來，是相當重要的步驟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100114,
					"content": "收到！就放心交給我們吧，我們繼續尋找患者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747100111,
					"content": "一時半會應該處理不完…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
}