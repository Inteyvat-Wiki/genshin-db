			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭陀娑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730740101,
					"content": "#{F#妳}{M#你}好，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740102
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740102,
					"content": "又見面啦，蘭羅摩！還有這個蘭那羅是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740103,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740104
					],
					"speakerTitle": "蘭陀娑"
				},
				{
					"id": 730740104,
					"content": "嗯。蘭陀娑是「採歌者」，經常去收集各種各樣的歌曲。他不喜歡說話，因為說話不如唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740105
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740105,
					"content": "唔…雖然也不是不能理解…言歸正傳，這裡就是覺樹之堂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740106,
					"content": "雖然沒有樹，倒是有不少玫瑰…在半空中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740107,
					"content": "啊。不是的，但這也是很厲害的發現。在這裡，沉睡著很多年沒有蘭那羅找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740108
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740108,
					"content": "蘭那羅的採歌者，會一直一直追求歌的美麗。所以，在時間的最後，會把只屬於自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740109,
						730740111
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740109,
					"content": "那和覺樹之堂有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740110
					]
				},
				{
					"id": 730740110,
					"content": "嗯！這邊似乎是蘭雅瑪留下的歌。如果是這樣的話，附近應該就有莎蘭樹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740113,
					"content": "莎蘭樹…之前蘭拉迦好像說過，就是那個什麼來著，我看看森林書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740114,
					"content": "#莎蘭樹！就是能結出恆素果的莎蘭樹！我們也幫忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740115,
					"content": "#謝謝{F#妳}{M#你}們！在那些玫瑰當中，隱藏著歌曲。唔…但是，我和蘭耶娑看了好久好久，都沒找到。那些玫瑰，也不和我們說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740116
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730740116,
					"content": "#原來如此…{NICKNAME}，我們也調查一下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740117,
						730740118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740117,
					"content": "既然是為了幫助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740119,
					"content": "嗯！找東西嘛，我們很擅長的，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740118,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740111,
					"content": "祝你們好運。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740112
					]
				},
				{
					"id": 730740112,
					"content": "#嗯！謝謝那菈{NICKNAME}。這邊似乎是蘭雅瑪留下的歌。如果是這樣的話，附近應該就有莎蘭樹了。運氣很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "蘭羅摩"
				}
			]
		},
