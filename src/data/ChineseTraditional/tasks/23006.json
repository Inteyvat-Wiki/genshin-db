			"dialogs": [
				{
					"id": 230060301,
					"content": "#旅行者，{F#妳}{M#你}有什麼想問我的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060302,
					"content": "關於扎卡里亞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "扎卡里亞醫生是一位很厲害的醫生，也是一位很虔誠的草神信徒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060304,
					"content": "他經常不眠不休地治療病人，就連吃飯都顧不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060305,
					"content": "扎卡里亞醫生還說，讓草神大人的福佑能恩澤到更多人，是他義不容辭的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060306,
					"content": "#{F#妳}{M#你}們的治療真是靠草神的福佑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "準確地來說，「治療病症」這件事，就是草神的恩澤喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060308,
					"content": "草神護佑著我們，讓我們能找到治療病患的方法，培育治療病症的藥草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060309,
					"content": "感謝草神大人的恩澤，願大家都能夠遠離病恙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈爾珊"
				}
			]
		},
