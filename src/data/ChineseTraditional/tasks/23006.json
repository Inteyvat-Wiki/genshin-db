				},
				{
					"id": 230060404,
					"content": "話說回來，古爾根先生最近又在勉強自己工作了，我是不是要多花些時間勸勸他呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
