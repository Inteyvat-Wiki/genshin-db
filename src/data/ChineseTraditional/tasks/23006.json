			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戈爾珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "唉，現在怎麼可能找得到人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "啊！您、您好，旅行者，請問您是需要治療嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060104,
					"content": "只是路過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "哈哈…看起來有那麼明顯嗎？不過，我確實也很煩惱啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060107,
					"content": "不知道為什麼，最近來我們「健康之家」請求治療的人越來越多，我們的全部人手幾乎都投入在照顧病患裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060108,
					"content": "但扎卡里亞醫生還是堅持要我想辦法去打掃周圍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060109,
					"content": "他說，為了讓大家更容易接受草神大人的福佑，必須隨時保持病人身心和醫院內外的潔淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060110,
					"content": "唉，但現在根本找不到人，我總不能拜託那些症狀輕微的病人起來幫忙吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060111,
					"content": "不如就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "#{F#妳}{M#你}願意幫忙嗎？那真是太感謝了！我會準備好報酬的，雖然、雖然不會太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060123,
					"content": "唉，願草神大人保祐大家遠離疾病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060113,
					"content": "不能雇人來幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "我們這裡畢竟都是病患，沒多少人會願意來義務幫忙，我們的資金也有限，沒辦法雇很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060115,
					"content": "平常我們都是輪換值班，但現在這麼忙，已經沒人有空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060116,
					"content": "#旅行者，如果…如果{F#妳}{M#你}願意的話，能不能來幫幫忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060117,
					"content": "我們會付報酬的！雖然、雖然不會太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060118,
					"content": "這裡的病症…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "這裡病人的病情其實都是一些頭痛之類的輕微病症。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060120,
					"content": "扎卡里亞醫生也對外宣傳了很多次，這些病症並不危險，但沒人聽得進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060121,
					"content": "我想，也許大家害怕的不是病症本身，而是得病這件事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060122,
					"content": "#那清掃工作就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "戈爾珊"
				},
				{
					"id": 230060105,
					"content": "只是看妳很煩惱的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
		{
			"id": 2300603,
