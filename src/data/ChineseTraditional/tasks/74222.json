			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喬瓦尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "#{F#妳}{M#你}好，公民，有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220702,
					"content": "我找到了一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "沒事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "注意安全，如果有什麼情況隨時向我匯報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬瓦尼"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喬瓦尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "竟然…沒錯，這就是蠻族用來傳遞資訊的訊號杆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220802,
					"content": "真的假的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "唉…沒想到真的有蠻族奸細混進來了，看來墨提烏斯長官的擔憂果然沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220805,
					"content": "只要把這些情況匯報給他，我也終於能交差了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220806,
					"content": "#不管怎麼說，多謝{F#妳}{M#你}了，公民。要是沒有{F#妳}{M#你}的幫助，說不定在蠻族的大軍到來前，我們的防禦就已經從內部被瓦解了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220807,
					"content": "#在給墨提烏斯長官的報告上，我一定會提到{F#妳}{M#你}的貢獻的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220803,
					"content": "你剛才還說是木頭劍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}