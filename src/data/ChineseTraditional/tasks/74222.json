				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫塞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "保持警惕，公民！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220102,
					"content": "你在幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "#我？如{F#妳}{M#你}所見，我還在忙著處理蠻族的威脅。最近蠻族的攻勢已經越來越近了，說不定會有奸細混進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220104,
					"content": "這絕非小事，在增援軍團到達之前，我們必須加倍警惕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220105,
					"content": "要是有什麼其他事情的話，去找我的副官匯報吧，公民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220106,
					"content": "小孩子一個人在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "嗯？孩子？哪裡有孩子？該不會是哪個新兵又違反軍令，擅自把家屬帶進了營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220108,
					"content": "唉，卡西奧多大人對這些新兵還是太仁慈了。要是這種事情發生在三十年前，軍政官早就已經把鞭子拿出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220109,
					"content": "還有什麼可疑的事情嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "#目前還沒有。不過蠻族就像是狡詐的凶獸，永遠會在{F#妳}{M#你}卸下戒備的時候發起襲擊——他們最擅長的手段便是出其不意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220111,
					"content": "他們會採取一切最為骯髒的手段，滲透我們的城市、打探我們的機密。哪怕是一絲一毫的鬆懈，都有可能釀成慘禍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220112,
					"content": "唉…三十年前，我跟隨波愛修斯大人遠征北境的時候，他們還不過是一群原始的野人，從來不會用這些奸詐的手段。究竟是從哪裡學會了這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220113,
					"content": "三十年前…你父母都還沒出生吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#嗯？{F#妳}{M#你}剛才說什麼，公民？人一旦上了歲數啊…連聽力也不如從前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220115,
					"content": "唉…想當初，我們征服維圖里亞的時候，我隔著幾里路都可以聽到蠻族集結的鐘聲。真是歲月不饒人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫塞"
				},
				{
					"id": 742220116,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "再見，公民。要是遇到可疑的傢伙記得隨時向我匯報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫塞"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喬瓦尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "唉…也不知道這場仗什麼時候才會打完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220202,
					"content": "你在屋頂上面做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#嗯？當然是在監視有沒有可疑的蠻族活動，最近…等一下，公民，{F#妳}{M#你}是怎麼跑到瞭望塔上面來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220204,
					"content": "我才想問你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "唉，算了，這個不重要。墨提烏斯長官說蠻族的攻勢已經越來越接近了，最近說不定會有奸細混進來，務必加強戒備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220206,
					"content": "#但是{F#妳}{M#你}看，像我們這樣的偏僻小城，就算是蠻族也不會有興趣吧？更不用說大費周章地派什麼奸細了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220207,
					"content": "蒼蠅再小也是肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#公民，{F#妳}{M#你}說得很有道理啊！看來我果然要打起精神才行。不過聽{F#妳}{M#你}的口氣，該不會{F#妳}{M#你}這方面的經驗很豐富吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220209,
					"content": "#這樣說來，可以拜託{F#妳}{M#你}幫忙在周圍調查一下嗎？如果真的有蠻族活動的話一定會留下什麼線索，像是木頭劍什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220210,
					"content": "呃…小孩子玩打仗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "畢竟是蠻族，拿木頭樹枝當成兵器也不奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "喬瓦尼"
				},
				{
					"id": 742220212,
					"content": "#總之就拜託{F#妳}{M#你}了，如果在周圍有什麼發現的話就匯報給我，這也是作為雷穆利亞公民的義務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬瓦尼"
				}
			]
		},
		{
			"id": 7422207,
			"completionStepIds": [],
