				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "這風中…帶來了海潮的鹹味，遠方商船的木香，還有…故人的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}，別來無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230403,
					"content": "萬葉，好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "「南十字」船隊在稻妻停靠補給。難得故地重遊，便想四處走走，多看一眼故鄉的景色，多聽一聽這裡的風聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230406,
					"content": "離島的風，總是比別處更喧鬧些，混雜著離別與重逢，希望與迷惘…是個能聽到許多故事的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230407,
					"content": "可以讓我為你留影嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "呵呵，萬物皆有其形，風亦然。只是風的形貌，只在葉落、浪起，或是旅人衣袂飄舉的一瞬才得以窺見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230410,
					"content": "#希望藉由我的身影，能讓{F#妳}{M#你}捕捉到那一瞬即逝的「風之形」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230411,
					"content": "那我要開始了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "#那麼，就請{F#妳}{M#你}來採集屬於此刻的詩篇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 745230412,
					"content": "請像剛才那樣，感受風就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "我也想記錄此刻的風。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "你怎麼會在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
}