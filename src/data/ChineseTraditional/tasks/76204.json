			"dialogs": [
				{
					"id": 762040201,
					"content": "尼可——奇怪，這裡也沒人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040202,
					"content": "#{F#妳}{M#你}們已經到我的工作室了嗎？有沒有看到我從各地收集並栽培下的花草？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040203,
					"content": "唉，好巧不巧我這會沒辦法趕過來，我在楓丹擺攤賣雕塑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040204,
					"content": "呃…需要我們幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "別，這可是我唯一提筆寫字的機會，儘管寫的多數都是數字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040206,
					"content": "#難得{F#妳}{M#你}們來一趟，不如就先玩起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040207,
					"content": "#我記得我在西邊團雀雕塑旁邊留了一份卷軸，{F#妳}{M#你}們看見了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040208,
					"content": "看見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040209,
					"content": "#那就讓這位沉默的嚮導為{F#妳}{M#你}們提供幫助吧，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7620403,
			"completionStepIds": [
				7620403
