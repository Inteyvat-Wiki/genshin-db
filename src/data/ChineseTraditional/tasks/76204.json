					},
					{
						"sceneId": 1156,
						"position": [
							30.993,
							8.153,
							-53.597
						],
						"pointId": 38
					},
					{
						"sceneId": 1156,
						"position": [
							32.188,
							8.153,
							-53.602
						],
						"pointId": 39
					}
				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "#恭喜{F#妳}{M#你}們。讓我看看…像這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040302,
					"content": "不同於現在魔女的花園，這是從前我還是天使時待過的神殿，我在那裡住了很長一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040303,
					"content": "有好多天使哦，而且尼可看起來好受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040304,
					"content": "不是我炫耀，朋友們很愛聽我講故事的。尤其是那類與人類同行、布下徵兆，帶領他們興建文明的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040305,
					"content": "每次講到關鍵時候，在場的天使們都會屏息凝神，連琴弦都不再震顫、畫筆都不再抖動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040306,
					"content": "然後，交織的色彩綻開了。伴著樂聲，金色的光芒遍及萬物，那是我們的歡歌和喜悅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040307,
					"content": "聽起來真美好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040308,
					"content": "誰說不是呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040309,
					"content": "雖然現在舊時的美好全然消逝了，但如今的生活隨時都有新的驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040310,
					"content": "有個傢伙看我在讀報紙竟然想偷我的雕塑品？他完蛋了！我今天就指引他去梅洛彼得堡的路要怎麼走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040311,
					"content": "有個傢伙看我在讀報紙竟然想偷我的雕塑品？",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "他完蛋了！",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "我今天就指引他去梅洛彼得堡的路要怎麼走！",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
	]
