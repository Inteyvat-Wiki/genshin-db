			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "想起來了嗎，七七？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960102,
					"content": "唔…抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960103,
					"content": "不用道歉啦，沒事的。距離沫芒宮還有一段路，我們再走走，說不定就能想起來妳家在哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME}快看，是七七！還有一位美露莘。是沒見過的組合呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960105,
					"content": "#啊！{NICKNAME}，還有…派…派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960106,
					"content": "妳們好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "是七七的熟人嗎？太好了，我在柔燈港附近查案的時候遇到了這個走失的孩子…是孩子吧？按照體型來看，應該是人類的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960108,
					"content": "七七是…是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960109,
					"content": "我們的好朋友！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "對、對！我們很久以前就認識啦，是要好的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960111,
					"content": "#哦哦！{F#妳}{M#你}反應真快，萬一七七說自己是殭屍的話，會嚇壞她的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960112,
					"content": "嗯…好朋友…沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960113,
					"content": "看來總算有點眉目了。說實話，我也是第一次遇上這種束手無策的情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960114,
					"content": "#那{F#妳}{M#你}們應該也知道，她似乎記憶出現了點問題，除了名字以外其他都很難想起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960115,
					"content": "有時候七七是會這樣子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960116,
					"content": "真是個可憐的孩子。我原本打算帶她去逐影庭先安置一下，順便去的路上也看看七七能不能恢復一些記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960117,
					"content": "#既然{F#妳}{M#你}們是好朋友的話，{F#妳}{M#你}們知道她的家在哪裡嗎？我可以直接送她回去，這樣也能省掉很多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960118,
					"content": "知道是知道…呃，但距離這裡也太遠了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960119,
					"content": "太…遠…？七七跟著仙靈走了遠遠的一段路，到了柔燈港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960120,
					"content": "欸？妳想起來了啊？那再之前的事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960121,
					"content": "之前…白先生帶著七七出診，在遺…唔，遺什麼來著？七七去採藥，然後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960122,
					"content": "喔！遺瓏埠是吧！大偵探派蒙已經知道是怎麼一回事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960123,
					"content": "白朮帶著七七一起在遺瓏埠出診，七七在那一帶採藥的時候迷路了，偶遇了仙靈就跟著來到了柔燈港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960124,
					"content": "#哼哼，還好我和{NICKNAME}一起看過《怪盜與名偵探》，這種簡單的推理還難不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960125,
					"content": "其實那個故事完全是虛構的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "噢噢！的確非常合理，那我立刻動身把七七送回遺瓏埠去。白朮先生是七七的監護人是吧？他肯定急壞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960127,
					"content": "等等，芭比洛斯女士在等的人裡面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "對哦！差點就把這件事情給忘記了。芭比洛斯女士——妳在嗎？聽得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746960130,
					"content": "#不用喊那麼大聲。我一直都在，只是不想打斷{F#妳}{M#你}們的對話而已。傾聽是優秀占卜師的本能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960131,
					"content": "所謂的仙靈引路，亦可算是一種命運的指引。呵呵呵…既然來到了這裡，不妨「占卜」看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960132,
					"content": "占…卜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960133,
					"content": "哎呀，打擾一下。芭比，妳這種公事公辦的態度會嚇壞小朋友哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960134,
					"content": "妳先讓一讓。看好了，要像我這樣，把這份驚喜小禮物給送出去才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960135,
					"content": "咳咳，小魔女會成員七七小朋友，我是妳的盟友可莉的媽媽，這個世界上最棒的大魔女艾莉絲阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960136,
					"content": "艾莉絲阿姨好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960137,
					"content": "真是個有禮貌的可愛好孩子。來吧，讓大魔女來為小魔女主持一場驚喜預言儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960138,
					"content": "預言…儀式？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960139,
					"content": "沒錯！看看妳眼前的牌，好不好看？喜不喜歡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960140,
					"content": "喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960141,
					"content": "喜歡就好，那就抽一張牌吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960142,
					"content": "唔…這張，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960143,
					"content": "當然可以。作為好好配合的獎勵，妳手上的牌就歸妳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960144,
					"content": "…謝謝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960145,
					"content": "好了，芭比，妳的休息時間已經結束囉，該來幫七七小朋友解讀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960146,
					"content": "不用晃我的肩膀…我在看著呢，哦，是「倒吊人」，正位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960147,
					"content": "能抽出它來的人可不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960148,
					"content": "也就是說妳非常特別喲，七七小朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960149,
					"content": "它象徵著超越與等待，也意味著超脫於世俗之外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960150,
					"content": "妳處在一定的限制之內，但妳自身並不會想要主動掙脫這種限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960151,
					"content": "限制…是指敕令嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960152,
					"content": "從表面上來說，妳這麼理解也沒有錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960153,
					"content": "關於未來，妳只需要等待即可。當然，對妳來說，最不缺的應該就是時間。但是…哦呀，怪了，怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960154,
					"content": "好了好了，打住！一口氣說太多，會加重小朋友的負擔哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960155,
					"content": "先讓七七小朋友好好感受一下手頭的這份禮物吧，對小朋友要耐心一點，多給一點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960156,
					"content": "怎麼樣，七七小朋友，喜歡這份小小驚喜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960157,
					"content": "卡牌，好看…謝謝艾莉絲阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960158,
					"content": "哎呀，真乖，努力記住了阿姨的名字呢。雖然阿姨還想和妳多聊聊天，但時間差不多了，好孩子該回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960159,
					"content": "芭比要是還有話想說，那等下次小魔女會成員再次相聚的時候，再為每一位小魔女都做一次預言吧！大家一定都會很開心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960160,
					"content": "…可以不要擅自增加我的工作量嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960161,
					"content": "就這麼說定了！我們下次再見啦，七七小朋友和各位見證者們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746960162,
					"content": "再見…艾莉絲阿姨和艾莉絲阿姨的…好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960163,
					"content": "呼…這算是結束了嗎？剛剛那兩位的聲音是從這個玩偶裡傳來的嗎？這是什麼新型玩具，好可愛，在哪裡能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960164,
					"content": "呃！不對不對，現在不應該想這些。七七，我們先去找那位叫白朮的先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 746960165,
					"content": "#…嗯，時間到了，七七該回去了。下次…再見，{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "七七"
				},
				{
					"id": 746960166,
					"content": "路上小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "卡牌…禮物，嗯…好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "七七"
				},
				{
					"id": 746960167,
					"content": "注意安全喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "也有七七吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
