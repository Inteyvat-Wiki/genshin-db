			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "這劍柄…倒是還算完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330404,
					"content": "它和「藏鋒」有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "#我還要仔細分辨後才知道…喔，忘了告訴{F#妳}{M#你}，我前段時間就開始四處收集武器的碎片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330406,
					"content": "我從市場上、野外，還有冒險家的手裡得到了不少碎片，想著也許能從這方面找到「藏鋒」的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330407,
					"content": "但直到現在，我也沒能找到它的任何蹤跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330408,
					"content": "沒關係，我們璃月有句話叫「有志者，事竟成」，我還是會一直找下去…直到找到「藏鋒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330409,
					"content": "#啊，這些報酬給{F#妳}{M#你}，辛苦{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		}
