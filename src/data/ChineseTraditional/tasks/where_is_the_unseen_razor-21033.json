				"points": []
			},
			"dialogs": [
				{
					"id": 210330401,
					"content": "#怎麼樣，旅行者？這次{F#妳}{M#你}找到什麼東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330402
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330402,
					"content": "找到了這個劍柄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103306,
			"completionStepIds": [
				2103306
			],
