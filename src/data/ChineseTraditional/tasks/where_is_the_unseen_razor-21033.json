			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "不知道…這個想法能不能管用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330102,
					"content": "妳還在找那把劍嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#旅行者？是{F#妳}{M#你}啊…是的，我還在找那把「藏鋒」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330104,
					"content": "但到現在，我也沒有找到什麼有價值的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330105,
					"content": "不過這也是沒辦法的事，畢竟在整個璃月尋找一把劍…實在是太難了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330106,
					"content": "有人和我說，那把劍也許早就被魔物毀了…但即使它碎了，我也要把所有碎片都找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330107,
					"content": "#抱歉，自顧自地說了這麼多。這次的委託地點我已經標在{F#妳}{M#你}的地圖上了，拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210330108,
					"content": "希望…那把劍不要真的碎了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
