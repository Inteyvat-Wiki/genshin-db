			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"方謹",
					"刻晴",
					"夜蘭"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1108.29,
							202.929,
							-9.85
						],
						"pointId": 300201064
					},
					{
						"sceneId": 3,
						"position": [
							975.844,
							260.604,
							-187.825
						],
						"pointId": 310500127
					}
				]
			},
			"dialogs": [
				{
					"id": 716700201,
					"content": "唔…不太對勁啊，遠處那個地脈淤積的煙團，越看越邪門，它就是異常魔物的來源嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700202,
					"content": "看起來，千岩軍專門為它建造了一個營地，還有好多巡邏的士兵和工事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700203,
						716700204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700203,
					"content": "以前好像見過類似的淤積點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				},
				{
					"id": 716700205,
					"content": "嗯！就按以前的慣例辦事吧——我們和千岩軍並肩作戰，把所有魔物咚咚打翻，然後想辦法處理掉淤積點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700206,
					"content": "兩位旅人，前方危險，請止步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700207
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700207,
					"content": "#等等…這種氣勢…莫非{F#妳}{M#你}是{NICKNAME}教頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700208
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700208,
					"content": "#咦？{NICKNAME}，{F#妳}{M#你}難道趁我睡著的時候去千岩軍打工了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700209,
						716700210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700209,
					"content": "我嗎？不可思議…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700211,
					"content": "#我叫方謹，是這支千岩軍分隊的領隊。我曾聽蘇定參謀提到{F#妳}{M#你}，蘇定說{F#妳}{M#你}是百年難遇的將才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700212
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700212,
					"content": "#情報也顯示，西風騎士團的榮譽騎士在緊急時刻享有隊長級的指揮權，那於情於理，也要尊稱{F#妳}{M#你}一聲教頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700213
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700213,
					"content": "正事要緊，請兩位跟我去見玉衡大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700214
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700214,
					"content": "刻晴居然也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700215,
					"content": "那事情好像不簡單了呢，看來不能直接用拳頭解決了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700216,
					"content": "#玉衡大人，果然如您所料，{NICKNAME}與{M#他}{F#她}的副官派蒙來訪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700217
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700217,
					"content": "有勞了，方謹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700218
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700218,
					"content": "#好久不見，{NICKNAME}，{F#妳}{M#你}果然還是老樣子，得到消息就火速趕來前線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700219,
						716700220
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700219,
					"content": "沒錯，本將來幫忙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700221,
					"content": "那我就長話短說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700222
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700222,
					"content": "多年以來，這裡的地脈淤積點一直很穩定，但不知為什麼，最近它突然異常活躍，引發了數次魔物襲擊事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700223
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700223,
					"content": "而且，清除外溢的魔物後，這個紊亂點不會消散，還能將接觸它的人送往奇異的秘境，這種情況前所未見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700224
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700224,
					"content": "太古怪了，難不成，這個地脈淤積點…成了某種意義上的錨點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700225,
					"content": "那只憑目前的兵力？是不是有點不夠？應該盡快呼叫增援吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700226,
					"content": "這倒不用擔心，目前的防線非常穩定，將士們都來自歸離原方向的精銳部隊，經驗豐富，說句以一當百都不誇張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700227
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700227,
					"content": "真正的麻煩之處在於，要是找不到地脈紊亂的根本原因，長期在此駐軍作戰，只會白白消耗人力物力，使部隊疲憊磨損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700228
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700228,
					"content": "用兵講究精準節儉，直擊要害，一味被動防禦，永遠無法贏得勝利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700229
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700229,
					"content": "說的有道理…總是捱了打才反擊，讓人感覺不踏實，很不爽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700230,
					"content": "夜蘭已經領著部下進入秘境調查了，再過幾個時辰，應該就能帶著關鍵情報歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700231
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700231,
					"content": "#啊呀，不好意思，我是不是應當適當放慢步調，讓玉衡大人和{NICKNAME}先聊個盡興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700232
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700232,
					"content": "嗚啊！什麼時候出現的，夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700233,
					"content": "這個速度，是進展不順嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700234
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700234,
					"content": "悲喜參半吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700235
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700235,
					"content": "好消息是，大致的狀況已有眉目——這次的異象，屬於地脈紊亂的餘威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700236
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700236,
					"content": "透過調查已有樣本，對照戰史記載，我能確定，地脈正在秘境中重現它所記錄的慘烈戰局，外溢的魔物大抵也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700237
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700237,
					"content": "地脈紊亂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700238
					]
				},
				{
					"id": 716700238,
					"content": "耳熟嗎？那就對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700239
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700239,
					"content": "我手頭的情報顯示，蒙德境內也發生過類似的異動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700240
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700240,
					"content": "好在當時的情況不算嚴重，榮譽騎士與某位暗夜英雄通力合作，不斷清除地脈淤積點外放的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700241
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700241,
					"content": "最終成功耗盡其中儲存的「資訊」，使地脈恢復了正常。可以說，無異於打贏了一場消耗戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700242
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700242,
					"content": "原來這兩個傢伙屬於同樣的麻煩…難怪都紅紅的，看著像是一棵樹上結出來的果子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700243,
						716700244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700243,
					"content": "哪位榮譽騎士啊？幹得好喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700245,
					"content": "#不錯哦，{NICKNAME}。{F#妳}{M#你}還是擅長用輕鬆寫意的態度，來給合作的對象暗示，為自己爭取更好的價碼。這一次，{F#妳}{M#你}絕不會失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700246
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700246,
					"content": "欸？怎麼開始聽不懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700247,
					"content": "接下來就是壞消息了吧，夜蘭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700248
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700248,
					"content": "嗯，顯而易見，這次的地脈紊亂點與以往的孤例不同，僅僅處理外溢的魔物是不夠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700249
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700249,
					"content": "要是不直接抵達秘境的最深處，清除特定情境下的所有魔物，戰局會不斷重演，沒有盡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700250
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700250,
					"content": "而且，紊亂點通向的秘境之中，似乎有著某種特殊規則，在提防我與其他將士，拒絕我們探查它的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700251
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700251,
					"content": "起初，我們還能對其中的物品取樣分析，但進入縱深區域後，將士們都感到身體虛弱，無法發揮正常力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700252
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700252,
					"content": "盤踞其中的魔物則加倍凶惡，甚至展現出全新的特質，相當棘手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700253
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700253,
					"content": "似乎只有很少受到地脈制約的人，才能擺脫干擾，洞察其中的獨特規則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700254
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700254,
					"content": "由這樣的將才領兵，應當足以克服險惡的環境，直擊地脈紊亂的要害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700255,
						716700256
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700255,
					"content": "這下我聽懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700257,
					"content": "也就是說，要麼選擇在外防禦魔物，直到紊亂點週期性停止活躍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700258
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700258,
					"content": "#要麼由{NICKNAME}領兵，攻入其中，隨機應變，壓制異動的根源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700259
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700259,
					"content": "明白了，我會做兩手打算——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700260
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700260,
					"content": "稍後，我會聯絡凝光，為此地投入更多防務資金。同時，與開陽星商議，盡快安排後續的輪崗部隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700261
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700261,
					"content": "#咦？我以為刻晴會直接拜託{NICKNAME}解決這個大麻煩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700262,
					"content": "守護璃月的安定，是千岩軍和七星的使命；不讓將士們無端冒險，是指揮者的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700263
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700263,
					"content": "#但於公於私，我都不希望{F#妳}{M#你}一人擔下全部危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700264
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700264,
					"content": "#所以，如果{F#妳}{M#你}不願意涉險，就由千岩軍長期布防，安排多支部隊輪換作戰，以練兵的形式清剿魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700265
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700265,
					"content": "同時持續派出斥候，收集秘境中的情報，不斷瞭解它的特性，爭取在將來某天組織部隊，一舉將它平定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700266
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700266,
					"content": "#當然，如果{F#妳}{M#你}有參戰的想法，我也支持{F#妳}{M#你}，會讓駐防部隊全力支援{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700267
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700267,
					"content": "#一旦有效遏制地脈的紊亂，我將以戰功為依據，給{F#妳}{M#你}應得的酬勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700268,
						716700269
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700268,
					"content": "於公於私，我都要幫忙才對！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700270,
					"content": "沒錯哦，無論作為璃月人的好夥伴、王牌冒險家搭檔，還是刻晴和夜蘭的朋友，我們都不能坐視不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700271
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700271,
					"content": "而且，我們完全不擔心報酬的事，刻晴和夜蘭無論如何都不會虧待我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700272
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716700272,
					"content": "眼神認真起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700273
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700273,
					"content": "氣勢很棒！那我們就這樣達成合作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700274
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700274,
					"content": "#夜蘭，通知妳的部下，準備協助{NICKNAME}深入秘境作戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700275
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700275,
					"content": "稍等，我要分析片刻，地脈紊亂點的情況會週期性變化，還需謹慎入場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700276
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700276,
					"content": "#{NICKNAME}也能趁此間隙調整狀態，組建{F#妳}{M#你}的精銳小隊，準備迎接此前少見的鏖戰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701201
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701201,
					"content": "時機不錯，抓準目前的機會，應當能深入秘境的關鍵區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701202
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701202,
					"content": "前提是找準沿途的「規則」，以得當的方式擊敗強敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701203
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701203,
					"content": "請保持謹慎和敏銳，時刻關心周圍環境，還有己方的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701204
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701204,
					"content": "狀況不妙時，暫時撤退，重整態勢也無妨，請別勉強自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701205
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701205,
					"content": "#等{F#妳}{M#你}凱旋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701206,
						716701207
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701206,
					"content": "一定盡力而為！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716701208,
					"content": "嗯！刻晴和夜蘭，等著我們的好消息喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716701207,
					"content": "我會努力戰鬥！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716700269,
					"content": "我也有很多並肩戰鬥的夥伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700256,
					"content": "除了我好像的確沒別人了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700244,
					"content": "還有這一回事？想不起來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700220,
					"content": "沒那麼誇張，但也會盡力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700210,
					"content": "教頭竟是我自己！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700204,
					"content": "我們提高警惕，準備戰鬥吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				}
			]
		},
