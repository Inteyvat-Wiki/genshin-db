				]
			},
			"dialogs": [
				{
					"id": 716701101,
					"content": "看來，經過之前的一番波動，這個紊亂點暫時安定下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701102
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701102,
					"content": "不過，異象尚未完全消除，一段時間後，它必定會重歸活躍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701103
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701103,
					"content": "但無論如何，也算是有了難得的空檔期，趁這個功夫好好休憩一番，為下次戰鬥做好準備吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701104
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701104,
					"content": "好，我們會認認真真，做好功課的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716701105,
					"content": "#{NICKNAME}，藉著這個機會，我們吃飽喝足，好好休息，養足精神！再仔細思考一下戰術和對策！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
