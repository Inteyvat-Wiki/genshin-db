			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅科夫",
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230601,
					"content": "（留聲機裡播放著，讓人能回想起溫暖過去的話語……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230602
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790230602,
					"content": "啊…為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230603
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790230603,
					"content": "雅科夫，雅科夫你醒醒啊！你怎麼，怎麼變成了這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230604
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230604,
					"content": "你之前也是這個樣子啦，而且還念著那個徽記呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230605,
					"content": "哦，對哦，那個徽記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230606
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230606,
					"content": "雅科夫，你看，這是你的徽記。雖然你一氣之下把它扔了，但是現在已經找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230607
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230607,
					"content": "這是你和你父親一起獲得的榮譽，現在已經重新回到你的手中了…怎麼樣，雅科夫，你醒過來了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230608
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230608,
					"content": "為什麼…為什麼…為什麼要拋下我一個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230609
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790230609,
					"content": "還是沒有恢復呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230610,
					"content": "難道這不是能喚醒他的東西嗎…那他到底想要的是什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230611
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230611,
					"content": "他想要的是什麼，你居然不知道嗎…你們不是隊友嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230612,
					"content": "我…我一直以為他最重要的就是這份榮譽，不對，我錯了，是「我以為」他覺得最重要的就是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230613
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230613,
					"content": "那是他和他父親一起出一個緊急任務得來的，只不過他的父親犧牲了，再也沒有回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230614
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230614,
					"content": "他的母親在他出生的時候就去世了…失去父親以後，他就變成了孤伶伶的一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230615
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230615,
					"content": "唉，他年紀比我小，得過的榮譽卻比我多，說不定我只是一直在嫉妒他，也不知道如何和他相處，我唯一能夠參照的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230616
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230616,
					"content": "不會是你父親跟你相處的模式吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230617,
					"content": "說來慚愧，但是確實如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230618
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230618,
					"content": "那這樣，不出問題才比較奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230619,
					"content": "我們這支小隊的休整處在海域中央的島嶼，現在雅科夫這個樣子，我必須得先把他送到那邊去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230620
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230620,
					"content": "哦，對了，我們…我們是受佩爾西科夫研究員指派，過來進行訊號測試的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230621
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230621,
					"content": "據說是某位執行官大人在須彌得到了什麼新的知識，可以透過一些技術，連接他人的意識，影響到一整片區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230622
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230622,
					"content": "雖然不被看好，但是佩爾西科夫研究員還是強行開始了這次的實驗，而我們則被指派前往海域各處進行裝置的信號測試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230623
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230623,
					"content": "對了，不知道佩爾西科夫研究員的實驗進行的如何了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230624
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230624,
					"content": "那還用問，我們出現在了這裡，愚人眾的實驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230625,
					"content": "當然是失敗了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230626
					]
				},
				{
					"id": 790230626,
					"content": "是嗎，嘿嘿，這下那個佩爾西科夫研究員恐怕要吃苦頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230627
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230627,
					"content": "我知道的也只有這麼多了，我之前就跟<color=#00E1FFFF>別的隊員</color>約好，完成測試任務，就要回海域中心島嶼的營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230628
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230628,
					"content": "他們應該在<color=#00E1FFFF>北方的兩個島上</color>吧…按照任務的進度，應該在<color=#00E1FFFF>西北方的那個島上</color>吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230629
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230629,
					"content": "唉…要是讓阿加霞看到雅科夫這個樣子，非得生我的氣不可…不過無論如何，我得趕緊把雅科夫帶回去才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉夫卡"
				}
			]
		},
		{
			"id": 7902308,
			"completionStepIds": [
				7902301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
