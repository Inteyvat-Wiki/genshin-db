				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790232001,
					"content": "（留聲機裡播放著，讓人能回想起溫暖過去的話語……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232002
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232002,
					"content": "啊…為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232003
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232003,
					"content": "雅科夫，雅科夫你醒醒啊！你怎麼，怎麼變成了這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232004
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232004,
					"content": "你之前也是這個樣子啦，而且還念著那個徽記呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232005,
					"content": "哦，對哦，那個徽記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232006
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232006,
					"content": "雅科夫，你看，這是你的徽記。雖然你一氣之下把它扔了，但是現在已經找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232007
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232007,
					"content": "這是你和你父親一起獲得的榮譽，現在已經重新回到你的手中了…怎麼樣，雅科夫，你醒過來了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232030
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232030,
					"content": "為什麼…為什麼…為什麼要拋下我一個人...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232008
					],
					"speakerTitle": "雅科夫"
				},
				{
					"id": 790232008,
					"content": "還是沒有恢復呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232009,
					"content": "難道這不是能喚醒他的東西嗎…那他到底想要的是什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232010
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232010,
					"content": "他想要的是什麼，你居然不知道嗎…你們不是隊友嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232011,
					"content": "我…我一直以為他最重要的就是這份榮譽，不對，我錯了，是「我以為」他覺得最重要的就是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232012
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232012,
					"content": "那是他和他父親一起出一個緊急任務得來的，只不過他的父親犧牲了，再也沒有回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232013
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232013,
					"content": "他的母親在他出生的時候就去世了…失去父親以後，他就變成了孤伶伶的一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232014
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232014,
					"content": "唉，他年紀比我小，得過的榮譽卻比我多，說不定我只是一直在嫉妒他，也不知道如何和他相處，我唯一能夠參照的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232015
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232015,
					"content": "不會是你父親跟你相處的方式吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232016,
					"content": "說來慚愧，但是確實如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232017
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232017,
					"content": "這樣不出問題才怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232018,
					"content": "我們這支小隊的休整處在海域中央的島嶼，現在雅科夫這個樣子，我必須得先把他送到那邊去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232019
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232019,
					"content": "哦，對了，我們…我們是受佩爾西科夫研究員指派，過來進行訊號測試的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232020
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232020,
					"content": "據說是某位執行官大人在須彌得到了什麼新的知識，可以透過一些技術，連接他人的意識，影響到一整片區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232021
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232021,
					"content": "雖然不被看好，但是佩爾西科夫研究員還是強行開始了這次的實驗，而我們則被指派前往海域各處進行裝置的信號測試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232022
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232022,
					"content": "對了，不知道佩爾西科夫研究員的實驗進行的如何了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232023
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232023,
					"content": "那還用問，我們出現在了這裡，愚人眾的實驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232024,
					"content": "當然是失敗了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790232025
					]
				},
				{
					"id": 790232025,
					"content": "是嗎，嘿嘿，這下那個佩爾西科夫研究員恐怕要吃苦頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232026
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232026,
					"content": "我知道的也只有這麼多了，我之前就跟別的隊員約好，完成測試任務，就要回海域中心島嶼的營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232027
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790232027,
					"content": "啊，是之前碰到的愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790232028,
