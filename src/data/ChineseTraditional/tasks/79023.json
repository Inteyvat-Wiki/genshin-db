			"dialogs": [
				{
					"id": 790231401,
					"content": "#來吧，{NICKNAME}，不如把那枚徽記給他看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790231402,
					"content": "嗯，把徽記給他看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
