			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230501,
					"content": "原來這裡還有這樣的一座島…還真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230502
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230502,
					"content": "之前，我們在進行調查的時候，不記得有這樣一座島啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230503
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230503,
					"content": "葉夫卡…怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230504,
					"content": "不，沒什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230505
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230505,
					"content": "嗯，看來雅科夫肯定也來到了這個島上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230506,
					"content": "對，雅科夫，得趕緊找到雅科夫才行。雅科夫——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230507
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230507,
					"content": "哇，都說了，別突然叫這麼大聲啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230508,
					"content": "抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230509
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230509,
					"content": "#沒必要那麼緊張，這裡應該是很安全的地方，好，{NICKNAME}，我們就先去找找雅科夫在哪吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7902306,
