			"trigger": {
				"objectNames": [
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230101,
					"content": "都是因為我…都是因為我他才會那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230102
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230102,
					"content": "不行，我得把…我得把徽記找回來給他…得把徽記找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230103
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230103,
					"content": "這個愚人眾的傢伙在念著什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230104,
					"content": "喂，你在這裡幹什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230105,
					"content": "徽記，徽記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230106,
						790230107
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230106,
					"content": "狀態不太對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				},
				{
					"id": 790230108,
					"content": "唔，稍微有點在意呢，為什麼一個雷錘前鋒軍會在這裡，不會在做什麼壞事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230109,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得呢，這個雷錘前鋒軍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230110,
					"content": "只有衝鋒攻擊需要注意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230111
					]
				},
				{
					"id": 790230111,
					"content": "確實，雷錘前鋒軍衝刺的時候實在太讓人害怕了…不對，我沒在說這個啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230112,
					"content": "我是說，我們是不是應該讓他清醒過來，問問他在這裡幹什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230113,
					"content": "確實有點好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230114
					]
				},
				{
					"id": 790230114,
					"content": "對吧，一個愚人眾在這裡，說著什麼「徽記，徽記…」之類的話，像是要找什麼東西似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230115,
					"content": "這可不是平常走在路上能見到的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230116,
					"content": "可是，他到底為什麼變成了現在這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230117,
					"content": "因為那個裝置吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230118
					]
				},
				{
					"id": 790230118,
					"content": "是哦，愚人眾也受到了那個裝置的影響，不過到底有什麼辦法能夠讓他變得清醒過來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230119,
					"content": "一定得找到那個徽記…一定得找到那個徽記才行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230120
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230120,
					"content": "#看來他好像一直在找什麼徽記的樣子…{NICKNAME}，看來得把他在找的徽記給他呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230107,
					"content": "沒辦法溝通呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				}
			]
		},
		{
