					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902301",
							"2"
						],
						"stepId": 7902301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230801,
					"content": "都是因為我…都是因為我他才會那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230802
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230802,
					"content": "不行，我得把…我得把徽記找回來給他…得把徽記找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230803
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230803,
					"content": "喂，你在這裡做什麼呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230804,
					"content": "徽記，徽記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230805
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790230805,
					"content": "完全不理我們呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230806,
					"content": "派蒙再叫大聲一點吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230807
					]
				},
				{
					"id": 790230807,
					"content": "這明顯是聽不到我們的話啦，喊再大聲也沒用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230808,
					"content": "根本就和阿加菲婭一開始的時候一模一樣嘛，那個時候把帶著合照的懷錶給阿加菲婭以後，她就醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230809,
					"content": "這個雷錘前鋒軍，難道也有什麼能讓他從裝置的影響裡醒過來的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230810,
					"content": "#看來他好像一直在找什麼徽記的樣子…{NICKNAME}，看來得把他在找的徽記給他呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
