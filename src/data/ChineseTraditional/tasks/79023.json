			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231501,
					"content": "#還沒有找到打開機關的辦法嗎…啊，不是在催{F#妳}{M#你}們的意思，怎麼了，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231502,
						790231504,
						790231508
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790231502,
					"content": "你們為什麼會來群島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231503
					]
				},
				{
					"id": 790231503,
					"content": "#我們當然是為了完成光榮的使命，不過具體是什麼…找到雅科夫之後，我再跟{F#妳}{M#你}說吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790231504,
					"content": "那枚徽記…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231505
					]
				},
				{
					"id": 790231505,
					"content": "你是說，那枚徽記明明不是我的，但是對它很熟悉，覺得很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231506
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790231506,
					"content": "那枚徽記是雅科夫的，他以前和自己的父親一起去執行一項任務，但是回來的時候就只有他自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231507
					],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790231507,
					"content": "那枚徽記就是那次任務之後得到的…我很羡慕他能夠獲得這樣的榮譽，所以曾經借過來看過很多次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉夫卡"
				},
				{
					"id": 790231508,
					"content": "再見…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
