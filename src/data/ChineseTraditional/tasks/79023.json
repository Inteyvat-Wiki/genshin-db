				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230301,
					"content": "不過，他說的徽記不會就是我們之前在海邊撿到的那個吧…就是那枚看起來有點破舊的那個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230302,
					"content": "不如把那枚徽記給他看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790230303,
					"content": "嗯，把徽記給他看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902305,
			"completionStepIds": [
				7902307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
