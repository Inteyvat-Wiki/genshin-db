			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330802,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "#{F#妳}{M#你}是？這身打扮…{F#妳}{M#你}就是旅行者吧。抱歉，我只是有點想家而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330804,
					"content": "妳剛剛說想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "#欸？莫非…{F#妳}{M#你}會做璃月菜嗎？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330819,
					"content": "#那、那就請{F#妳}{M#你}快點幫幫我，做點正宗的璃月菜給我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330820,
					"content": "讓我想想…我現在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330821,
					"content": "我想吃點心。古樸甜蜜的璃月點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330822,
					"content": "最近我一閉眼，就像做夢一樣，總能看見一位風姿絕世的點心公子，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330823,
					"content": "腳踩鍋巴靴，頭戴豆腐冠，身披米窩氅，手搖花酥扇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330824,
					"content": "這位感覺會招引老鼠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "他從街邊的點心鋪子間走出來，帶著清香，從我身邊過，我就再也忘不了那味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330827,
					"content": "拜託了，請把點心公子帶來吧，拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330825,
					"content": "這位聽起來很耗米麵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "先自我介紹一下，我叫湯雯，是來自璃月的歷史學者，之前正在實地調研稻妻的特色風俗與民話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330807,
					"content": "本來資料已經搜集的差不多了，正準備返回璃月。但是因為最近稻妻發生了很多大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330808,
					"content": "我感覺，此刻的稻妻正處於一個歷史性的時刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330809,
					"content": "這段特殊的時期，必然會在提瓦特的史冊上留下濃墨重彩的一筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330810,
					"content": "親眼見證這樣的歷史，然後真實、完整、清晰地將這一切記錄成冊，留給後人，就是歷史學者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330811,
					"content": "不過…雖然這樣的事業很讓我振奮，但它可沒辦法滿足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330812,
					"content": "妳是餓了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "也不能說…是餓啦…哈哈哈，稻妻的食物都還挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330814,
					"content": "我特別喜歡這邊的「天婦羅」，雖然感覺…就是把東西裹上麵衣炸一炸啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330815,
					"content": "但是吃久了稻妻菜，我還是想要再吃點璃月菜。不過，我一直都找不到能做出正宗璃月菜的餐館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330816,
					"content": "我前幾天都狠下心來，去冒險家協會掛了一道「烹飪委託」，但到現在也沒回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330817,
					"content": "我可以試試嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
}