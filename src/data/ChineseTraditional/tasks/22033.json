			},
			"dialogs": [
				{
					"id": 220330201,
					"content": "#這麼快就回來了？{F#妳}{M#你}不會是個深藏不露的大廚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330202,
					"content": "嗯…我都快要等不及了，請讓我嚐一嚐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330203,
					"content": "請享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "我想想…剛剛討論了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "唔…是米窩窩、蓮花酥、還有三彩糰子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330206,
					"content": "決定好就交給湯雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2203303,
			"completionStepIds": [
				2203303
			],
