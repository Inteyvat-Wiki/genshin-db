					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "唔，這種味道…好、好像不是璃月的菜，也不是稻妻的菜，味道還真是新鮮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330402,
					"content": "雖然不是我想要吃的那一道，但能夠嚐到這種新鮮的料理，我也已經很滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330403,
					"content": "#謝謝啦，旅行者，這些東西給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
