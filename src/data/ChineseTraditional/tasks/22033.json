			"dialogs": [
				{
					"id": 220330701,
					"content": "所以說，要準備哪一道點心呢？不如我們替她挑選一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330702,
					"content": "我想想…我最近喜歡的點心有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330703,
					"content": "便宜又可口的米窩窩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330704,
					"content": "好看又好吃的蓮花酥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330705,
					"content": "還有軟糯彈牙的三彩糰子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330706,
					"content": "這都是妳愛吃的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "嘿嘿，沒問題的，你就相信我的品味吧，快來選一樣~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330708,
					"content": "那就米窩窩吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "聽起來很棒！我們就趕緊做一份米窩窩給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330710,
					"content": "那就蓮花酥吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "好耶！我們就趕緊做一份蓮花酥給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330712,
					"content": "那就三彩糰子吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "真不錯！我們就趕緊做一份三彩糰子給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330714,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "嗯~想好了就趕緊做給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
