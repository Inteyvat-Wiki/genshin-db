					"nextDialogs": [
						220330602
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330602,
					"content": "也不能說是微妙…應該是說…奇異，還是什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330603,
					"content": "#居然能做出這樣的菜，{F#妳}{M#你}的廚藝還真是…另闢蹊徑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330604,
					"content": "#辛苦{F#妳}{M#你}了！旅行者，這些東西請收下吧，這道菜我稍後…稍後再細細品嚐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
