			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"恰斯卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "#難怪總有種預感讓我過來看看…原來是能遇到{F#妳}{M#你}，了不起的「杜{RUBY#[D]希望}麥尼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610102,
					"content": "#那麼——{F#妳}{M#你}是為了「花羽會」的戰士試煉而來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610103,
					"content": "沒錯，我來檢驗關卡的難度！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "#那{F#妳}{M#你}一定不會失望，我對絨翼龍騎士們的要求非常嚴格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610105,
					"content": "因為我不擅長教導別人，在受邀設計這些關卡時，只能回憶「相當棘手」的難題，再一個接一個加進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610109,
					"content": "結果九成九的「花羽會」戰士都過不了第一關…沒辦法，只能接受伊拉德的建議，降低一點難度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610110,
					"content": "#但對{F#妳}{M#你}來說，簡化前的試煉可能都不夠讓{F#妳}{M#你}盡興，應當選用…連我都束手無策的難關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610111,
					"content": "說得好！但我不用特殊對待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "#這是對{F#妳}{M#你}應有的重視。雖然我不擅教導，但評估實力卻從沒看走眼過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610114,
					"content": "#而以{F#妳}{M#你}的實力…唯有難度最高的挑戰，才能與{F#妳}{M#你}相稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610115,
					"content": "但我必須考慮普通戰士的能力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "#…也對，這次{F#妳}{M#你}有委託在身，以後還有機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610118,
					"content": "#我會專門為{F#妳}{M#你}量身訂製…「超越」絨翼龍騎士巔峰的鬥爭盛宴！邊期待邊等著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610116,
					"content": "評估關卡是否適用於大多數人也很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "太看得起我了，沒必要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "也可以是為了妳而來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "哦？原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610108,
					"content": "#——{F#妳}{M#你}是想要「超越」我的紀錄吧？正合我意。這些關卡在設計之初，就塞滿了我曾經遇過的「相當棘手」的難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "恰斯卡"
				}
			]
		}
	]
}