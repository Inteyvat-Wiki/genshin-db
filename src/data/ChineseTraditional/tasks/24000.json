					}
				]
			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "我再重複一遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000102,
					"content": "利弗先生，我十分理解您的訴求，也非常願意盡我所能向您提供幫助，但這件申請…您看這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000103,
					"content": "經辦人是克拉佩爾先生，您所有曾經提供的資料都歸他整理提交，除了經辦人之外我們都沒有權限辦理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000104,
					"content": "現在他正在出外勤，不在辦公室裡，您的這份資料必須要蓋上他的公章，才能進入我們的報銷流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000105,
					"content": "夠了吧！我都來了三次了，你們到底辦不辦事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000106,
					"content": "利弗先生，請冷靜一下，克拉佩爾先生所在的辦公室畢竟只有兩個人，除了他之外，只有一位蒙圖瓦先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000107,
					"content": "但蒙圖瓦先生年事已高，已經在等待退休，很久不在辦公室裡值班了，就連薪水也不拿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000108,
					"content": "好吧，那我去他的辦公室總可以吧？讓那位老先生過來把章拿出來，我來蓋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000109,
					"content": "真的非常抱歉，利弗先生，這真的不行。一方面這樣不合規定，另一方面，公章鑰匙在克拉佩爾先生手上，除了他之外沒人能拿到公章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000110,
					"content": "而且…我也得辦其他的事去了…相信我，今天克拉佩爾先生一定會回來，為您把這件事徹底辦妥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000111,
					"content": "好吧…祝妳今天愉快，柯妮莉婭小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000112,
					"content": "您也是，利弗先生，祝您愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 240000113,
					"content": "柯妮莉婭匆匆離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "今天又只能回去了…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000115,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "沒什麼大事，我只不過是又白跑一趟，浪費了寶貴的半天時光罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000118,
					"content": "我真是受夠了這個叫克拉佩爾的傢伙！沫芒宮在我們這裡訂購了幾件發條機械，但是到現在還沒付款！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000119,
					"content": "我第一次來找他，他說現在是月底，辦公室需要進行月度封帳審計，要到下個月月初才能往外撥款，暫時不接受申請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000120,
					"content": "第二次來，他說蓋章用的印泥用光了，但印泥供應商的倉庫著了火，要去別的地方採購，暫時蓋不了章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000121,
					"content": "第三次，他說這份「外部援請人員資訊登記表」又更新了，我還得重新填一次。但這張表已經用完了，新印的明天才會送來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000122,
					"content": "我今天準備來取那張表，但他根本就不在辦公室，天哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000123,
					"content": "欸？利弗先生，我有什麼能幫您的嗎？瞧您這一副煩惱的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000124,
					"content": "萊彌婭警官，見到您真好，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000125,
					"content": "利弗嘮嘮叨叨地講述了事情的經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "克拉佩爾先生啊…這位先生確實滿難打交道。但他今天真的去了伊黎耶島辦事，不在沫芒宮內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000127,
					"content": "不過，無論他在哪裡，我們還是先去把那張表拿到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000128,
					"content": "欸？但克拉佩爾先生說，那張表已經用完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000129,
					"content": "我有辦法解決您的問題。我記得，某些長期和沫芒宮合作的店鋪也遇見過您現在所面對的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000130,
					"content": "他們的解決方法是，每隔一段時間就來沫芒宮索取可能會用到的表格和文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000131,
					"content": "這樣做一方面是方便以最快的速度填寫和提交文件，另一方面，也可以在第一時間得知表格和文件是否有更改之處…這就是所謂的「有備無患」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000132,
					"content": "難、難道表格就是這麼被拿光的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000133,
					"content": "總而言之，這幾家店裡一定有多餘的最新表格，我們就去找他們拿一張吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000134,
					"content": "而且，我相信當他們聽到您在沫芒宮白跑了這麼多趟之後，一定很願意幫您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000135,
					"content": "對了，我們還得趕在沫芒宮的下班時間之前拿到表格，並且完整填寫完畢，再拿到克拉佩爾先生的辦公室去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000136,
					"content": "這位旅行者，請問您願意幫助一下利弗先生嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000137,
					"content": "旅行者！拜託您幫幫忙吧，再不辦完這件事，我今天晚上一定又睡不著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000138,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "請您幫我們去這兩個店鋪看看，向他們借一份最新的「外部援請人員資訊登記表」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000141,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000142,
					"content": "請您去伊絲黛萊小姐的鐵匠工坊，還有卡隆先生的鐘錶店看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000143,
					"content": "不久之前，伊絲黛萊小姐曾經為沫芒宮維修過路燈，卡隆先生則幫沫芒宮校正過時鐘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000144,
					"content": "這兩位非沫芒宮職員經常被沫芒宮約聘去工作，手上一定有「外部援請人員資訊登記表」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000145,
					"content": "那就拜託您了，我和利弗先生稍後也會分頭行動，去其他的店鋪問問情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊彌婭"
				},
				{
					"id": 240000139,
					"content": "但我要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "你碰到什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
			"id": 2400002,
			"completionStepIds": [
				2400002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400002",
							"2"
						],
						"stepId": 2400002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊絲黛萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "真是麻煩…就這麼一點錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 240000202,
					"content": "關於「外部援請人員資訊登記表」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "敘述了利弗的經歷和想要借表格的請求…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "唉，利弗也真是倒楣。但是…我也沒有多餘的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 240000205,
					"content": "我在幫沫芒宮維修路燈的時候，帶了一個店裡的人當幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 240000206,
					"content": "因為那個人沒幫上忙，我就沒有把他寫進「外部援請人員資訊登記表」裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 240000207,
					"content": "但在提交表格的時候，克拉佩爾堅持要我把所有人員都寫進去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 240000208,
