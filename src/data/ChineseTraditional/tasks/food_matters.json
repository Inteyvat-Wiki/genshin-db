					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "您、您願意幫我？太感謝了，太感謝了——那…就請您幫我拿<color=#00E1FFFF>五顆白靈果</color>來吧，這些就夠用了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670303,
					"content": "等您拿來了之後，我一定會給您做一份最好吃的「饗月餐」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				}
			]
		},
