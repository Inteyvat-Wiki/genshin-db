			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉莉希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "…嗚…早知道就多準備一點白靈果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670102,
					"content": "（上次菈烏瑪在這裡的時候…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#{NICKNAME}，您好，您是來領「饗月餐」的嗎？抱歉，您可能要稍等一下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670105,
					"content": "「饗月餐」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "咦？您上次不是拿過嗎…喔，上次是菈烏瑪大人主持的，好像沒告訴您這種餐點的正式名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670107,
					"content": "簡單來說呢，「饗月餐」就是我們「霜月之子」為有需要之人免費發放的餐點啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670108,
					"content": "我們「霜月之子」原本就有接濟求助者的傳統，最開始，只限於希汐島周圍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670109,
					"content": "但在菈烏瑪大人的主持和大家的努力下，我們也逐漸擴大了「饗月餐」的發放範圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670110,
					"content": "菈烏瑪大人說，這也是為了將月神的賜福遍施眾人，就是那句，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670111,
					"content": "「採獲所得首例珍果，須置於月光祭壇。此非奉神，乃是為迷途的獵人留存…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670112,
					"content": "留存…留存什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670113,
					"content": "咳，總之！這家店呢，就是發放「饗月餐」的主要地點之一，哼哼，幾乎是我一個人在打理這裡喔！厲害吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670114,
					"content": "雖然在那夏鎮裡發放「饗月餐」遇見了很多困難…但我相信菈烏瑪大人所說的，這樣一定能幫助更多需要幫助的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670115,
					"content": "不過…昨天準備食材的時候，我忘記把箱子蓋緊，早上起來的時候，好多果子都被小鳥們啄破，完全用不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670116,
					"content": "剩下的白靈果壓根做不了多少「饗月餐」，嗚…這下怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670103,
					"content": "（好像是在發放餐點…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
