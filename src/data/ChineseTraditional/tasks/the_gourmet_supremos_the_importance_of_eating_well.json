			"dialogs": [
				{
					"id": 220160801,
					"content": "閣下，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160802,
					"content": "你為什麼會答應旭東？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "正如旭東閣下說的，目前…如果我想要吃飽的話，為他工作是最好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160804,
					"content": "而且，朱莉小姐和旭東閣下，我認為都是品德高尚之人，與他們同行是我的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160805,
					"content": "芭爾瓦涅閣下…是一個心思縝密的人，她對我有所警戒也屬正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160806,
					"content": "而且她也僅是警戒，並未排斥我，這就…足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160807,
					"content": "你真的一直在外遊蕩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "在下自然不會說謊。從幕府離開後，我就一直在外徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160809,
					"content": "一般來說，我會用野果來填肚子，運氣好的話，會有一些獵物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160810,
					"content": "我偶爾也會幫助一些需要幫助的人，例如擊退魔物或者海亂鬼，這樣也會得到一些報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160811,
					"content": "呵呵…對我這種除了揮劍外別無長處的人來說，工作的機會實在有點少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160812,
					"content": "更不用說我還有「離開幕府」這種背景在，人們總是會把我和海亂鬼聯想在一起，如此…就更難找到工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160813,
					"content": "我在稻妻也沒什麼居所，也沒有親眷可投奔，除了在外遊蕩，我也沒有地方可去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160814,
					"content": "你為什麼要離開幕府？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "只不過是…不能認同幕府在稻妻施行的某種做法罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160816,
					"content": "我只是一介武夫，也並不知道那種做法究竟是否有益於國家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160817,
					"content": "我只知道那種做法與我心中的想法有悖，所以，我選擇了離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160818,
					"content": "呵呵，也許是我太過古板，不知變通了吧…讓您見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220160819,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "再見，閣下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				}
			]
