					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "嘿嘿，其實還挺好吃的，我還要再吃一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160602,
					"content": "妳為什麼要送吃的給他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "嗯…我就是不想看見大叔餓肚子嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160604,
					"content": "而且，上次見到大叔的時候，他好像很難過的樣子，我覺得，說不定就是因為沒吃飽的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160605,
					"content": "所以我想要給大叔送點吃的，只要吃飽了，大叔也許就不會那麼難過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160606,
					"content": "妳為什麼會相信他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "那是…冒險家的直覺喔。我可是很會分辨好人和壞蛋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160608,
					"content": "而且我真的覺得，在餓肚子的時候還把食物分給別人…只有好人才會做這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160609,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "再見。我以後一定會記得吃早飯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				}
			]
		},
