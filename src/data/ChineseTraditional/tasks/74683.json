	"talks": [
		{
			"id": 7468301,
			"completionStepIds": [
				7468301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468301",
							"2"
						],
						"stepId": 7468301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746830101,
					"content": "嗨，又見面了！親愛的大冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830102,
						746830103
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830102,
					"content": "你好，大映影家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830104
					]
				},
				{
					"id": 746830104,
					"content": "最近過得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830105,
					"content": "最近過得怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830106
					]
				},
				{
					"id": 746830106,
					"content": "#哦！幾乎異口同聲呢，這就是老朋友的默契吧？不過既然我快了半拍，不如就請{F#妳}{M#你}先說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830107,
						746830108
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830107,
					"content": "老樣子，在幫冒險家協會工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830109
					]
				},
				{
					"id": 746830109,
					"content": "#哈哈，還是這麼鎮定。如果是別人講這種話，我賭鐵定是在吹牛，但如果是{F#妳}{M#你}的話一定都是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830110,
					"content": "至於我嘛…也還是老樣子，拍完一部映影就開始為下一部做準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830111
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830111,
					"content": "最近我有一個冒險故事的點子：一群本來不認識的人在陰錯陽差下不得不結伴歷險，克服一些驚心動魄的阻礙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830112,
					"content": "嗯，至於要讓他們經歷什麼困難我還沒想好，但結果不錯，他們會成為英雄。結局的話嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830113
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830113,
					"content": "…目前也還沒想好！可能會設計成分道揚鑣，也可能結束在下一場冒險的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830114
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830114,
					"content": "除了這個計畫之外，我還有幾個別的點子。說實話，我覺得自己的點子無窮多，每天晚上睡覺之前它們就開始在我腦子裡亂飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830115
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830115,
					"content": "壞處是會影響睡眠，好處是有這麼多點子，我這輩子不愁靈感枯竭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830116
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830116,
					"content": "聽起來準備得很順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830117
					]
				},
				{
					"id": 746830117,
					"content": "也不是處處都順利，譬如資金跟贊助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830118
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830118,
					"content": "有時候可以遇到品味好，出手也闊綽的贊助人，有的時候會有千靈映影節這樣的好時機，但這種機遇總不常有，那就必須靠自己想辦法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830119
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830119,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830120
					]
				},
				{
					"id": 746830120,
					"content": "#哦？多謝{F#妳}{M#你}的關心——不過答案是不，不需要{F#妳}{M#你}特意付出什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830121
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830121,
					"content": "#我還不想利用朋友的好心完成自己的願望。作為朋友，我只需要{F#妳}{M#你}的問候，和時不時的聯絡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830122
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830122,
					"content": "我會自己想辦法解決資金問題，比方說我現在就在幫一些贊助商拍攝廣告片，報酬雖然不算多，但好在收入穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830123
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830123,
					"content": "廣告片？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830124
					]
				},
				{
					"id": 746830124,
					"content": "嗯，自從映影開始流行之後，就有不少商家和組織也看上了這種新穎的宣傳手段。他們會根據自己的需要，找人擬定方案再去拍攝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830125
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830125,
					"content": "比起注重敘事性的映影，廣告片更需要在短時間內抓住觀眾的眼球，所以往往節奏更緊、更講求創意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830126
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830126,
					"content": "哦…還有贊助商的意見也會更多。有時他們的修改意見還會自相矛盾，有的根本沒有道理，讓人理解不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830127
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830127,
					"content": "哈，這種話絕對不能讓他們聽到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830128
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830128,
					"content": "聽起來很辛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830129
					]
				},
				{
					"id": 746830129,
					"content": "沒關係，為了做到真正想做的事總要付出點代價。就像吃海鮮一樣，要吃到貝殼裡面的肉也要先撬開殼啊——這不算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830130
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830130,
					"content": "何況我還遇過更不講道理的贊助商…他們非要我在一部懸疑映影的開頭，讓硬漢形象的主角喝著他們家的兒童牛奶登場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830131
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830131,
					"content": "在戲外多拍一些廣告，在戲裡就可以少置入一點…這樣一想，拍廣告片就讓人愉悅多了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830132
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830132,
					"content": "#哦對了，我還真的有點事情想問問{F#妳}{M#你}有沒有興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830133
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830133,
					"content": "是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830134
					]
				},
				{
					"id": 746830134,
					"content": "#我們有一陣子沒一起做點什麼了吧？之前我們一起拍了不少東西，效果不錯，我記得{F#妳}{M#你}也不討厭拍映影這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830135
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830135,
					"content": "這次要不要一起製作廣告片看看？廣告和映影不太一樣，不過也有自己的趣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830136
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830136,
					"content": "#要用到的素材也都已經拍好了，不用再麻煩{F#妳}{M#你}跑片場，只需要加入一點點有創意的剪輯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830137,
						746830138
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830137,
					"content": "所以這次是後製和剪輯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830139
					]
				},
				{
					"id": 746830139,
					"content": "#嗯，那{F#妳}{M#你}有空就來找我吧。不用在意最終效果如何，只是很久不見的老搭檔一起做點有趣的東西，贊助商那邊有我負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830140
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830140,
					"content": "何況廣告嘛！有趣最要緊，順著興致剪一剪說不定成果還會意外不錯啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 746830138,
					"content": "講到創意你就問對人了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830139
					]
				},
				{
					"id": 746830108,
					"content": "順便時不時拯救一下世界。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830109
					]
				},
				{
					"id": 746830103,
					"content": "好久不見！澤維爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830104
					]
				}
			]
		}
	]
}