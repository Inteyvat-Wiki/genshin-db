							-390.54,
							-82.556,
							9582.82
						],
						"pointId": 9898
					}
				]
			},
			"dialogs": [
				{
					"id": 750170701,
					"content": "#七重燃{RUBY#[D]奇琴烏圖}火之地的至高領主向{F#妳}{M#你}致以敬意，獲選者，願{F#妳}{M#你}的道途鋪滿永不凋謝的鮮花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170702
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170702,
					"content": "聲音好像是…從這個大雕像裡傳出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170703,
						750170704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170703,
					"content": "妳是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170706
					]
				},
				{
					"id": 750170706,
					"content": "我名為聖龍伊·奎庫敘·茨{RUBY#[D]L型自律監管機陣統合處理單元}博隆·庫·雷爾，曾是統律奇琴烏圖的主宰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170707
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170707,
					"content": "伊…伊什麼？嗚哇，這名字也太過分啦！簡直就像是莫名其妙的咒語一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170708,
					"content": "算了，就叫妳「伊蕾爾」吧。反正剩下的部分我也已經完全記不住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170709,
					"content": "依循命{RUBY#[D]庫胡勒}定的神聖道途，汝等…不對，等一下！妳這又白又圓的元素飄浮物，剛才叫我什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170710
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170710,
					"content": "#誰是「又白又圓的元素飄浮物」啦！我是派蒙，{M#他}{F#她}是{NICKNAME}，然後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170711,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170712
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750170712,
					"content": "#這是{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170713
					]
				},
				{
					"id": 750170713,
					"content": "還有，明明是妳自己說的嘛！「我名為伊什麼什麼蕾爾」之類的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170714,
					"content": "何、何等不敬！這神聖的名諱乃是出自尊榮的主宰，妳這又白又圓的元素飄浮物，怎敢用妳的舌頭吐出如此僭越之言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170715
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170715,
					"content": "#高貴的{NICKNAME}啊！請恕我直言，您似乎有些過於放縱自己的侍僕了——牠竟敢用這種語氣稱呼一位至高領主！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170716,
						750170719
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170716,
					"content": "派蒙不是我的侍僕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170717
					]
				},
				{
					"id": 750170717,
					"content": "#哼，沒錯沒錯！{NICKNAME}和我可是最好的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170718,
					"content": "您…和元素飄浮物是朋友？呃，真是…很有個性的選擇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170721,
					"content": "#總之，請先容我向您道歉，高貴的{NICKNAME}。您一路來到這裡，我卻只能向您展現出這樣的姿容，實在是…過於屈辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170722
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170722,
					"content": "若是我沒有被困在這卑賤的雕像內，我本應向您呈現出更為優雅的儀態。無論是聖龍的形象，還是凡人的身姿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170723
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170723,
					"content": "欸？被困在雕像裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170724,
					"content": "哼，不然呢？妳難道以為我只是個會說話的雕像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170725
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170725,
					"content": "呃，這個…畢竟是這種地方，真的有「只是會說話的雕像」也不奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170726,
					"content": "咕，何等不敬！我可是奇琴烏圖的至高領主、尊榮的聖龍，妳竟敢…妳竟敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170727
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170727,
					"content": "若不是因為那可恥的背叛，我怎麼可能會被困在這粗製濫造的雕像裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170728
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170728,
					"content": "#總、總之！高貴的{NICKNAME}啊，請允許我長話短說——我希望您幫我做一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170729,
						750170730
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170729,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170732
					]
				},
				{
					"id": 750170732,
					"content": "我的心臟曾被背叛者撕碎，藏匿在不同的機關中。我想要請求您為我找回心臟的碎片，在那之後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170733
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170733,
					"content": "請您像剝開顆粒果的綠葉那般，剖開我的胸腔、挖出我的心臟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170734
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170734,
					"content": "嗯…嗯？等等，妳剛才是不是用很輕鬆的語氣說了什麼超級可怕的事情？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170735,
					"content": "可怕？是說顆粒果的事情嗎？哼哼，還真是膽小的元素飄浮物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170736
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170736,
					"content": "什麼亂七八糟的，誰會怕顆粒果啦！完全不知道妳在得意什麼！我是說後面那個部分——「挖出心臟」什麼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170737,
					"content": "#欸？這難道不是比顆粒果還常見的事情嗎？高貴的{NICKNAME}，您祭祀的時候難道從來都不帶您的侍僕參加嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170738
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170738,
					"content": "為什麼要挖出妳的心臟？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170739
					]
				},
				{
					"id": 750170739,
					"content": "因為您是高貴之人，受龍所選者。除卻那些早已不知所蹤、同為領{RUBY#[D]阿喬}主的同僚們，只有您有資格賜予我與身分相符的解脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170740
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170740,
					"content": "#如果您熟稔古老的道途，高貴的{NICKNAME}，您應該知道，在那受造於悠古之刻的心{RUBY#[D]叢集儲存陣列}臟中，有著曾經屬於我的一切回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170741
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170741,
					"content": "背叛者——願他的名字被投入永不熄滅的火中，焚燒十三個千年——奪去了我的權柄，又用回憶將我束縛在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170742
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170742,
					"content": "呃…回憶也可以束縛人嗎？不對，回憶也可以束縛龍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170743,
					"content": "哼，真是無知到了有些可愛的地步呢，又白又圓的元素飄浮物。要是還沒有失去權柄，說不定我都有些想養妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170744
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170744,
					"content": "對於生命短暫的種族而言，回憶自然是如同青蜜莓一般甜美的佳妙之物——對於生命漫長的種族而言，回憶只會是詛咒與束縛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170745
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170745,
					"content": "唔，好難懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170746,
					"content": "總之，那可鄙的背叛者正是用這種方式強迫我為他的帝國歌唱、為他的妄想歌唱——因為他並不懂得如何讓這座城市運作起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170747
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170747,
					"content": "他可憐的帝國與他那可笑的妄想一樣化作了灰燼，而我卻依然被困在這卑賤的雕像中，千年又千年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170748
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170748,
					"content": "呃…就算妳這樣說，要我們先找回妳的心臟再把它挖出來，還是感覺有點莫名其妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170749
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170749,
					"content": "呵…還是沒聽懂嗎，又白又圓的元素飄浮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170750
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170750,
					"content": "我的生命已經所剩無幾了。即便不這樣做，我的意識也會在接下來的三十個冬天內徹底耗盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170751
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170751,
					"content": "#我的尊嚴不容許我在奴役與拘束中死去。因此，高貴的{NICKNAME}啊，我才會請求您賜予我解脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170752
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170752,
					"content": "我無法自毀，但若是您能尋回那些碎片，我便能將殘存的生{RUBY#[D]能量}命全部注入其中，將原本破碎的心臟修復如初。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170753
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170753,
					"content": "這是<color=#00E1FFFF>自我保護</color>的一環，只有這樣，才不會觸犯命{RUBY#[D]庫胡勒}定的神聖律則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170754
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170754,
					"content": "在那之後，請您將我的心挖出來吧。就是這顆心束縛了我，就是這顆心奴役了我，就是這顆心，數千年間無時無刻不在折磨著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170755
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170755,
					"content": "這是真正聖龍的心臟，人類的所有寶石都無法與它相提並論，這便是我能贈予您的報酬——您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170756,
						750170759
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170756,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170757
					]
				},
				{
					"id": 750170757,
					"content": "謝謝您。那麼就讓我在這裡歌唱，等待您的好消息吧。除此之外，我現在也沒有什麼能做到的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170758
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170758,
					"content": "還請您…找回我的心，賜予我高貴的解脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170759,
					"content": "沒有別的辦法了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170760
					]
				},
				{
					"id": 750170760,
					"content": "呵呵…看來您從未遇過我舊日的同僚們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170761
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170761,
					"content": "否則他們應該告訴過您，毀滅便是我們命{RUBY#[D]庫胡勒}定的道途。沒有另尋道路的必要，也沒有另尋道路的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170762
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170762,
					"content": "無論如何，我會在這裡歌唱，等待您的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170730,
					"content": "報酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170731
					]
				},
				{
					"id": 750170731,
					"content": "呵呵，請您不必擔心。等您聽我說完，自然就知曉報酬的價值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170732
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170719,
					"content": "說得沒錯，小派，今天我要唸一唸妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170720
					]
				},
				{
					"id": 750170720,
					"content": "「小派」是誰啊！不要被吹捧兩句就得意忘形了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170704,
					"content": "獲選者？是在說我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170705
					]
				},
				{
					"id": 750170705,
					"content": "#是的，{F#妳}{M#你}是受龍所選之人，也是我所選擇的高貴之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170706
					],
					"speakerTitle": "伊蕾爾"
				}
			]
		},
