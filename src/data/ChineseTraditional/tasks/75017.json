				]
			},
			"dialogs": [
				{
					"id": 750170901,
					"content": "喂，伊蕾爾！我們已經把妳要的零件找齊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170902,
					"content": "誰、誰是伊蕾爾啊？！何等不敬！都說了，我的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170903
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170903,
					"content": "#算了，無所謂了！我已經等不及要去死了！高貴的{NICKNAME}，請您快些將我的心放入我的胸口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170904
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170904,
					"content": "然後請您挖出我的心臟，讓我死在您高貴的手中吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170905
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170905,
					"content": "妳也該高聲歡呼，又白又圓的元素飄浮物！我也同樣賦予妳見證奇琴烏圖之主死去的尊榮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170906
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170906,
					"content": "嗚哇，不要突然這麼激動啦！總之，呃…先把這些零件放進去就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170907,
					"content": "沒錯，沒錯！接下來，我會為您敞開心胸，您只需要將它取出來就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170908
					],
					"speakerTitle": "伊蕾爾"
				},
				{
					"id": 750170908,
					"content": "不不不，這個詞不是這樣用的吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750170909,
					"content": "（放入零件。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170910
					]
				},
				{
					"id": 750170910,
					"content": "唔，然後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
