			"dialogs": [
				{
					"id": 750171601,
					"content": "呃…那個，伊蕾爾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750171602,
					"content": "#（禁錮在雕像中的意志似乎已經散去了，回答{F#妳}{M#你}們的只有沉默。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蕾爾"
				}
			]
		},
		{
			"id": 7501717,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7501727",
							"2"
						],
						"stepId": 7501727,
						"stateName": "QUEST_STATE_UNFINISHED"
