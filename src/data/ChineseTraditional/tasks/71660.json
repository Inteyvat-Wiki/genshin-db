			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯兒",
					"蒂瑪烏斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "#{F#妳}{M#你}們回來了！「煙霰魔藥」的效果如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600102,
					"content": "如果能在秘境外使用就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "對對對！那樣就錦上添花了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600104,
					"content": "#哦？感覺{F#妳}{M#你}們的評價還不錯嘛，請展開說說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600108,
					"content": "向蒂瑪烏斯詳細說明了試驗中的細節。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "和妳的預測完全相符啊，鶯兒小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600110,
					"content": "完善「煙霰魔藥」的方向確定了——我們需要將昇華後的藥劑約束在一定範圍內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600111,
					"content": "或許…反向利用蒲公英的特性，製作特殊的輔料，就能讓藥劑免受空氣流動的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600112,
					"content": "但這個方案沒有先例，並不簡單，還需要大量試驗來證明它的可行性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600113,
					"content": "完全聽不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600114,
					"content": "不過總感覺，鶯兒小姐每次都提出了很重要的建議呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600115,
					"content": "啊呀，我可沒有給出過這麼詳實的預測哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600116,
					"content": "刻苦的煉金術士，你是在揣摩我的心思，還是想誇獎我…變著花樣哄我開心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600117,
					"content": "我、我只是由衷敬佩鶯兒小姐的學識而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600118,
					"content": "好啦好啦，那你要加把勁哦，也許以後還要用到其他偏門的知識呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600119,
					"content": "等到你的研究成功了，別忘了告訴我哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600120,
					"content": "那是當然…到時我會把品質最好的魔藥寄過來，給鶯兒小姐當紀念品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600121,
					"content": "如果鶯兒小姐還有空，不如和我們一起去「萬民堂」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600122,
					"content": "這次的「學術交流」就到此為止啦，「春香窯」還有許多事務等著我去處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600123,
					"content": "有空的話，一定要經常來陪我哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716600124,
					"content": "下次一定！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "謝謝妳啦，鶯兒小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600126,
					"content": "鶯兒離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "唉，結果還是沒能說出口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600128,
					"content": "不過，最近給鶯兒小姐添了這麼多麻煩，不應該再佔用她的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600129,
					"content": "還是沉下心來，等待合適的時機為妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600130,
					"content": "你在自言自語什麼呢，蒂瑪烏斯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600131,
					"content": "沒什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600132,
					"content": "#這段時間麻煩{F#妳}{M#你}們了！按照約定，我會請兩位到「萬民堂」吃頓大餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600133,
					"content": "我差點都忘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "對哦，吃大餐吃大餐！我們趕快過去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600135,
					"content": "與蒂瑪烏斯來到了「萬民堂」，享用了豐盛的佳餚。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "嗚呼！吃得好飽，好滿足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600137,
					"content": "其實這次研究還蠻有意思的，蒂瑪烏斯！以後如果還要來璃月，記得叫上我們哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600138,
					"content": "妳不關心研究吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "這是什麼話！明明我也有出力…出力去問路啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600141,
					"content": "總之，多謝兩位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600142,
					"content": "不過回到蒙德後，我就要全心全意改進「煙霰魔藥」，恐怕很長時間不會再來璃月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600143,
					"content": "#也許不久後，還要拜託{F#妳}{M#你}們幫我送信。剛才我還沒來得及向鶯兒小姐表達感激之情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600144,
					"content": "咦？你們明明在一起討論了那麼久，為什麼不當面說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600145,
					"content": "咳咳！鶯兒小姐的談吐實在太…特別了！我要仔細斟酌措辭，寫信當然比當面說更合適…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600146,
					"content": "時間緊迫，我們現在就動身回蒙德吧，我等不及要製作出完美的「煙霰魔藥」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716600147,
					"content": "我怎麼感覺，告別鶯兒小姐以後，蒂瑪烏斯的反應就怪怪的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600148,
					"content": "真讓人摸不著頭腦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600139,
					"content": "妳只是想蹭飯吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "還有提升空間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "確實哦，比如說…讓它能在秘境之外生效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716600107,
					"content": "#嗯，我正在和鶯兒小姐討論這個問題，請仔細描述{F#妳}{M#你}們試驗時的細節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "蒂瑪烏斯"
				}
			]
		}
	]
}