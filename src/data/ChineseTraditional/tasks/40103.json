							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401030201,
					"content": "#{F#妳}{M#你}們來了。很抱歉我剛審完犯人，還沒來得及派人去通知{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030202
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030202,
					"content": "問出什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030203,
					"content": "怎麼說呢，很多讓人意想不到的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030204
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030204,
					"content": "幹綁票的那些傭兵比想像中好抓，我派人假扮成薩齊因，沒多久就把他們釣出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030205
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030205,
					"content": "問題是審完之後才知道，雇他們來的人，好像就是薩齊因自己的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030206
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030206,
					"content": "孩子找人綁架自己的父親？為什麼要這麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030207,
					"content": "誰知道呢…進城的傭兵只是一小部分，還有很多人留在城外接應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030208
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030208,
					"content": "#我們正準備抽調人手，去將他們一網打盡。{F#妳}{M#你}們要不要也一起來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030209
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030209,
					"content": "好吧，剛好我們也去看看到底是怎麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
