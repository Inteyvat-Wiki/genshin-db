			},
			"dialogs": [
				{
					"id": 401035101,
					"content": "艾爾海森、妮露，你們看到其他參賽者了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401035102,
					"content": "沒有，暫時還沒有人完成比賽…發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401035103,
					"content": "那個冠冕可能有問題…對了，艾爾海森，你也在這裡，你應該知道些什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401035104,
					"content": "妳指什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401035105,
					"content": "你——算了！我們先去把冠冕找回來，然後再來問你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
