			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401031001,
					"content": "終於等到了…能夠繼承我財產的人…能夠繼承我研究的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031002
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031002,
					"content": "來，卡維。好孩子，到我這來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031003
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031003,
					"content": "…你怎麼知道我的名字？你到底是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031004
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401031004,
					"content": "我名薩齊因。當然，準確來說，我只是薩齊因的一小塊意識碎片而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031005
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031005,
					"content": "真是一種奇妙的緣分…看到你，我會想起曾經看過的一個人。但你比他更堅強、更明白世事的不易。你有資格繼承我的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031006
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031006,
					"content": "孩子們，這是我們第一次見面。但接下來我要說的話很重要，希望你們幫我做一個見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031007
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031007,
					"content": "在本次學院爭霸賽中，每個人的表現都很出色。教令院總是有很多奇才，你們每個人都是特別的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031008
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031008,
					"content": "但是，如果要我選出一位繼任者，我會選擇你，卡維。不僅是因為你奪得了冠軍，而且因為你有著和我相似的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031009
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031009,
					"content": "…我？和你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031010
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401031010,
					"content": "是啊，我們都是可憐的理想主義者，這是我們痛苦的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031011
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031011,
					"content": "二十八年前，我來到沙漠，在那裡定居了整整八年。你覺得我在那裡看到了什麼？爭亂、廝殺，無窮無盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031012
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031012,
					"content": "圍繞水源的爭搶、對商隊的劫掠、對民眾的剝削，一天都沒有停過。防沙壁外的世界，與我認知中的完全是兩個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031013
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031013,
					"content": "我為我看到的一切深感痛苦，所以我迫切地想要找出一條路來拯救他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031014
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031014,
					"content": "所以…你找到答案了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031015
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401031015,
					"content": "我是因論派出身的學者，自然會用因論派的知識去尋找答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031016
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031016,
					"content": "我研究歷史、分析社會，做了無數人性的實驗，甚至與沙漠深處那些自稱為「失落學派」的學者接觸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031017
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031017,
					"content": "然後，我發現答案其實根本就不存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031018
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031018,
					"content": "我無法將過錯簡單地推給任何一方勢力，因為罪孽鐫刻在人性之上。人性帶來紛爭，紛爭導向毀滅，這是人力無法逆轉的必然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031019
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031019,
					"content": "我研究的是如何從歷史中取得教訓，但結論竟然是歷史中沒有任何教訓，一切都只能朝著更糟的方向發展！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031020
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031020,
					"content": "我不知道我所學的一切到底有什麼意義，沉重的虛無感讓我無法再面對生活的一切，於是我決定結束自己的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031021
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031021,
					"content": "但先前一個偶然的機會，讓我得到了這枚可以存放部分意識的冠冕。我將自己的經歷錄入其中，又讓教令院代為打理我的家產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031022
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031022,
					"content": "果然，與教令院簽訂的「合約」，其實更像是你的「遺囑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031023
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401031023,
					"content": "但既然你已經對這個世界絕望，又為什麼還要做這些事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031024
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401031024,
					"content": "先前已經說過，我做過許多關於人性的實驗。你可以理解為，這是我眾多實驗的最後一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031025
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031025,
					"content": "教令院不缺天才，每代都有閃耀的明星。重賞之下必有勇夫，我盼望著有一天，有人能解開人性的死結，讓世界走向正確的方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031026
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031026,
					"content": "也就是說，你想要的繼承者，既要是天才，又要能體會普通人的痛苦。這樣才能對人性、對社會、對這個世界有更清晰的認知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031027
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401031027,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031028
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401031028,
					"content": "你是否想過，財富會麻痺人心，令他們失去對外界痛苦的感知？繼承你財富的理想主義者未必能走到最後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031029
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401031029,
					"content": "你很聰明。但我知道，你並非能夠理解我想法的那類人——對我來說，這也是實驗的一部分，是我對人性的考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031030
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031030,
					"content": "無論繼承者因我的研究而痛苦，還是沉溺於虛假的快樂之中，我的研究都會更進一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031031
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031031,
					"content": "我為世界的本質感到痛苦；我為沉重的歷史感到惋惜；我為未竟的研究感到遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031032
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031032,
					"content": "所以，卡維，親愛的孩子…你將為我所用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031033
					],
					"speakerTitle": "薩齊因"
				},
				{
					"id": 401031033,
					"content": "你…確定要將所有的東西送給我，交由我來處置？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031034
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401031034,
					"content": "我相信我的眼光。戴上冠冕，替我走完這條路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩齊因"
				}
			]
		},
