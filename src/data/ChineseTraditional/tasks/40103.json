			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡莉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401030501,
					"content": "卡莉娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030502,
					"content": "#呼…{F#妳}{M#你}們終於回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030503
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030503,
					"content": "#我找了{F#妳}{M#你}們老半天，{F#妳}{M#你}們剛剛去哪了？第三輪比賽已經開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030504
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030504,
					"content": "我們剛剛去抓了一些盯上薩齊因的壞人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030505,
					"content": "不對，這不是重點！才識之冠可能有問題，我們想好好調查一下它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030506,
					"content": "才識之冠有問題？不太可能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030507
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030507,
					"content": "#二十年來，每屆比賽都會用到才識之冠，從來沒出過什麼問題啊？{F#妳}{M#你}們的消息哪裡來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030508
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030508,
					"content": "是我們的一些推測。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030509
					]
				},
				{
					"id": 401030509,
					"content": "這件事很重要，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030510
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030510,
					"content": "實不相瞞，在第三輪比賽開始之前，我們已經將冠冕放在無郁稠林裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030511
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030511,
					"content": "第三輪比賽的內容，正是到無郁稠林中找出冠冕，然後將冠冕帶出來，放到指定的臺子上。最先將冠冕放好的人會得到4點積分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030512
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030512,
					"content": "考慮到之前參賽者的分數沒有拉開差距，第一個放好冠冕的人很可能就是最後的冠軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030513
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030513,
					"content": "#所以我猜這輪比賽應該很激烈。{F#妳}{M#你}們未必趕得上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030514
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030514,
					"content": "總要試一試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030515
					]
				},
				{
					"id": 401030515,
					"content": "#我會將冠冕的位置標注出來，也請{F#妳}{M#你}們立刻前往現場查看情況，希望不要出什麼事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030516
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030516,
					"content": "好！我們馬上出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4010306,
			"completionStepIds": [
				4010306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010306",
							"2"
						],
						"stepId": 4010306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401030601,
					"content": "這樣就結束了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030602
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030602,
					"content": "卡維…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030603,
					"content": "你沒事吧？身體感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030604
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 401030604,
					"content": "我…沒事…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030605
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030605,
					"content": "謝謝你提納里，別擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030606
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030606,
					"content": "別太勉強自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030607
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 401030607,
					"content": "卡維先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030608
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401030608,
					"content": "雖然冠冕被卡維選手摔碎，但他在摔碎前就已完成比賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030609
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030609,
					"content": "按規則，他是第三輪比賽的勝者，從總積分來看，也是本屆學院爭霸賽的冠軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030610
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030610,
					"content": "身為學院爭霸賽的冠軍，以及薩齊因親自指定的繼承者，卡維選手享有對薩齊因所有財產的繼承權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030611
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030611,
					"content": "我再問一次，你確定要捐出薩齊因所有的財產嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030612
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030612,
					"content": "我剛剛說過了。他覺得這個世界不好，那就用他留下來的產業去做一些改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030613
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030613,
					"content": "單純的否定不能促成任何結果。我和他…不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030614
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030614,
					"content": "好。身為書記官，我會將這件事記入檔案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030615
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030615,
					"content": "至於這些財產具體的使用細節，賽後將由賢者親自與你溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030616
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030616,
					"content": "…就這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030617
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030617,
					"content": "我不知道那個人的研究是否正確，也不知道該怎麼幫他去完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030618
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030618,
					"content": "我只知道，讓一切停在這裡，所有參賽者就不會感到痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030619
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030619,
					"content": "我們不會是最後一屆，將來還會有人來參加這個比賽…還會有未來的學者繼續為這個賽事前赴後繼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030620
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030620,
					"content": "薩齊因的話會讓人痛苦。所以…到此為止，不要再繼續傳播下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030621
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030621,
					"content": "我們都是學者，貿然推翻他的觀點也是獨斷傲慢。沒關係，這份責任我來背負就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030622
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030622,
					"content": "對我來說這樣就好。我也…只能做到這麼多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030623
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030624
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030624,
					"content": "說得不錯，陳述了大部分人渴望卻未必敢去執行的正義和理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030625
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030625,
					"content": "雖然在我看來還是那麼可笑。你早已察覺到自身的問題，僅僅是礙於自尊心不願承認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030626
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030626,
					"content": "不過你的這些觀點很適合在領獎臺上發表。我謹代表本次比賽組委會祝賀你獲得冠軍，卡維選手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030627
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 401030627,
					"content": "啊？別搞錯了，我不需要沒有誠意的讚揚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030628
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030628,
					"content": "另外現在不是辯論的場合，請你專注評論比賽而不是我的觀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030629
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 401030629,
					"content": "恭喜你，卡維先生！也請您準備一下出席頒獎儀式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露"
				}
			]
		},
		{
			"id": 4010310,
			"completionStepIds": [
				4010310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
