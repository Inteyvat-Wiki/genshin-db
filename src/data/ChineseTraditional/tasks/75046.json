			"trigger": {
				"objectNames": [
					"烏魯班巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "嗚嚕嚕——嚕——快回來吧，嗚嚕嚕——嚕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "嗚嚕嚕——嚕——唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460104,
					"content": "我不好，這裡，傷心，好不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460105,
					"content": "就只是出去買點乾草的時間，我養的另外八隻小突角龍就不知道跑去哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460106,
					"content": "牠們還那麼小，要是在外面被丘丘人欺負了怎麼辦？迷路了怎麼辦？被困住了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460107,
					"content": "#好心人，{F#妳}{M#你}有沒有看見我養的小突角龍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460108,
					"content": "牠們長什麼樣子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "這八隻小突角龍的媽媽由我一手帶大，跟我的女兒沒什麼區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460110,
					"content": "牠可是沃陸之邦數一數二的美龍，還拿過我們地區選美大賽的特等獎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460111,
					"content": "我這八隻小調皮鬼遺傳了牠們媽媽的美貌，白皙透粉的皮膚，完美對稱的扇形角上有一抹紫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460112,
					"content": "如果你見到牠們，想點辦法讓牠們回到我這裡來吧，拜託你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460113,
					"content": "我的小龍…爺爺再也不凶你們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460118,
					"content": "我會留心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "謝謝你，好心人。你今天臥推一定破紀錄，引體向上絕對不抽筋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏魯班巴"
				}
			]
		},
