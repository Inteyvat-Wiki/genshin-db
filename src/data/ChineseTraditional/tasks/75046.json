			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"烏魯班巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460801,
					"content": "嗚嚕嚕——嚕——快回來吧，嗚嚕嚕——嚕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460802
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460802,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460803
					]
				},
				{
					"id": 750460803,
					"content": "嗚嚕嚕——嚕——唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460804
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460804,
					"content": "我不好，這裡，傷心，好不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460805
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460805,
					"content": "就只是出去買點乾草的時間，我養的另外八隻小突角龍就不知道跑去哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460806
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460806,
					"content": "牠們還那麼小，要是在外面被丘丘人欺負了怎麼辦？迷路了怎麼辦？被困住了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460807
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460807,
					"content": "#好心人，{F#妳}{M#你}有沒有看見我養的小突角龍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460808,
					"content": "牠們長什麼樣子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "這八隻小突角龍的媽媽由我一手帶大，跟我的女兒沒什麼區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460810,
					"content": "牠可是沃陸之邦數一數二的美龍，還拿過我們地區選美大賽的特等獎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460811,
					"content": "我這八隻小調皮鬼遺傳了牠們媽媽的美貌，白皙透粉的皮膚，完美對稱的扇形角上有一抹紫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460812,
					"content": "如果你見到牠們，想點辦法讓牠們回到我這裡來吧，拜託你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460813,
					"content": "我的小龍…爺爺再也不凶你們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460814,
					"content": "我找到了幾隻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "謝謝你，好心人。還好牠們沒事，擔心死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "烏魯班巴"
				},
				{
					"id": 750460816,
					"content": "不過還剩下幾隻不知道在哪，唉，得麻煩你再看看，遇到的話把牠們一起帶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏魯班巴"
				}
			]
		}
	]
}