			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590101,
					"content": "「海中月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590102
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590102,
					"content": "什麼「海中月」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590103
					]
				},
				{
					"id": 726590103,
					"content": "#啊，{F#妳}{M#你}好！{F#妳}{M#你}就是那個…來自冒險家協會的釣魚家吧？我是鯨井椛，稻妻本地的漁師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590104
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590104,
					"content": "#我從魚協聽說了{F#妳}{M#你}的事蹟，今天一見，果然是年輕有為的樣子，希望我沒找錯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590105
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590105,
					"content": "我最近正在尋找一條傳說中的大魚，叫作「海中月」，傳說中，牠能夠實現人們的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590106
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590106,
					"content": "嗚哇——實現願望的大魚欸！是我喜歡的傳說故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590107,
					"content": "嗯，雖然大家都覺得是故事，但…我相信這是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590108
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590108,
					"content": "因為幾年前，我可能真的遇到過「海中月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590109
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590109,
					"content": "那牠實現了妳的願望嗎?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590110
					]
				},
				{
					"id": 726590110,
					"content": "嗯…算是吧，事情是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590111
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590111,
					"content": "幾年前，因為各自的願望，我和兩個朋友，一個叫嘉瑋，一個叫楠塔克，我們一起出海，去追捕這條傳說中的「海中月」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590112
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590112,
					"content": "但路途很不順利，我們遭遇了雷暴，雖然漁船撐了下來，可是羅盤徹底損壞了，我們迷失在一片未知的海域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590113
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590113,
					"content": "幾天後，還是沒有找到回家的方向，淡水已經告罄，大家雖然嘴上沒說，但心裡已經絕望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590114
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590114,
					"content": "甚至有天半夜，嘉瑋那傢伙偷偷起來，寫了遺書，放進漂流瓶丟了出去，接著想要投海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590115
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590115,
					"content": "他不知道，我們也沒睡著，聽見動靜出去，這才拉住了他。也就在那時候，我們看見，海面下忽然浮現出了一個巨大的影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590116
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590116,
					"content": "那影子發著淡淡的熒光，星星點點地閃耀著，像打碎的月亮落入海洋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590117
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590117,
					"content": "那是「海中月」嗎？走投無路的我們這樣想著，慌忙許願，請牠保佑我們平安返航。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590118
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590118,
					"content": "#是的，跟{F#妳}{M#你}想的一樣，我們活下來了。那影子就像有魔力一樣往遠方游去，我們跟著牠，那就是我們回家的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590119
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590119,
					"content": "嗚哇——真是個令人感動的傳說故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590120,
					"content": "不，這是真的！相信我。我們一定還能再找到牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590121
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590121,
					"content": "要怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590122
					]
				},
				{
					"id": 726590122,
					"content": "先去找我那兩位老朋友吧，他們都是經驗豐富的漁師，有他們加入會輕鬆不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590123
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590123,
					"content": "<color=#00E1FFFF>嘉瑋就在璃月港，</color>我知道他回了璃月港就沒有出去過了，應該也很懷念「海中月」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590124
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590124,
					"content": "#至於楠塔克，我只聽說他後來當了海洋作家，等{F#妳}{M#你}們見到嘉瑋，可以和他打聽一下他在哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
		{
			"id": 7265902,
			"completionStepIds": [
				7265902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
