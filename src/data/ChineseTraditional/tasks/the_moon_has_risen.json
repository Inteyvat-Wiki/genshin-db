			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉瑋",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590201,
					"content": "大海就像美女，偶爾見見就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590202
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590202,
					"content": "你是嘉瑋嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590203
					]
				},
				{
					"id": 726590203,
					"content": "嗯，找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590204
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590204,
					"content": "喔——「海中月」！居然是「海中月」啊！那段經歷，真是令人印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590205
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590205,
					"content": "鯨井那傢伙，果然也是念念不忘，畢竟她的願望…嗯…嗯…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590206
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590206,
					"content": "#那我就把最美好的祝福送給{F#妳}{M#你}們，祝{F#妳}{M#你}們成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590207
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590207,
					"content": "欸？我們是來邀請你的呀，你不打算一起去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590208,
					"content": "哎呀，當年那趟出海，我可是差點沒命呢。大海呢，就像美女，偶爾見見就好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590209
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590209,
					"content": "而且，作為一個已經成家的男人，怎麼能棄家庭不顧？我當然要承擔起丈夫的責任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590210
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590210,
					"content": "畢竟我付出了多少努力、多少汗水，才娶到一個這麼慷慨、富有的妻子！所以，抱歉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590211
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590211,
					"content": "你的老朋友會失望的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590212
					]
				},
				{
					"id": 726590212,
					"content": "不要說這種話…讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590213
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590213,
					"content": "#雖然我沒法加入，但我會用另一種方式支持你們，我要把我的釣魚技巧與寶貴經驗全部傳授給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590214
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590214,
					"content": "「海中月」這種傳說中的生物，可不是隨隨便便就能釣上來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590215
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590215,
					"content": "所以，請接受我的訓練，繼承我的意志，再去追尋神秘大魚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590216
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590216,
					"content": "#哦對了，{F#妳}{M#你}們是不是急著去找楠塔克？別急，那傢伙就像個冬眠的老海龜一樣，一直在待在蒙德呢，據說是在寫書還是幹嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590217
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590217,
					"content": "現在集中精力，嘉瑋的魔鬼釣魚訓練要開始了！訓練完成之後再去找他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉瑋"
				}
			]
		},
