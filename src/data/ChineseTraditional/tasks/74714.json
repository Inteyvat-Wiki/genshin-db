					}
				]
			},
			"dialogs": [
				{
					"id": 747140101,
					"content": "#{NICKNAME}和派蒙，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140102,
					"content": "最近潛水員變多的原因，是要好好處理水下廢棄品，加快修復環境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140103,
					"content": "如果是這樣，我應該盡全力幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140104
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140104,
					"content": "要是水下汙染變得嚴重，海露花的色彩都會黯淡下去，還有許多我不敢想的可怕後果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140105,
					"content": "我們也來出力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140106
					]
				},
				{
					"id": 747140106,
					"content": "好哦！一起加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140107,
					"content": "對了，菲米尼，之前我們在水下找到了一個看起來滿厲害的…結構？似乎是某種樂器的零件？你也看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140108,
					"content": "好的…啊，非常精密的構造。我研究過一些機關，但在市面上，我還從沒見過那麼細緻又獨特的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140109,
						747140110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140109,
					"content": "感覺擺在這裡還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				},
				{
					"id": 747140111,
					"content": "嗯，不過它還差一些零件才能復原的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140112,
					"content": "嗯！慢慢來吧。我也很好奇它修好後是什麼樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140113,
					"content": "那我繼續去水裡幫忙了。兩位可以再多休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140114
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140114,
					"content": "好，你也記得休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140115,
					"content": "#咦？這東西…是{F#妳}{M#你}們撈上來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140116,
					"content": "嗯，桑多涅妳知道這是什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140117,
					"content": "哈，何止是知道？我以前每天都坐在花園裡彈它呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140118,
					"content": "欸？！這是…妳的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140119,
					"content": "曾經是。這是阿蘭發明的機械鋼琴，既可以由人來彈奏，也可以自動演奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140120,
					"content": "這麼厲害…那它怎麼會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140121,
					"content": "阿蘭病重後聽不得琴聲，我就拿去處理了。但沒想到還能再次見到它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140122,
					"content": "我猜是拿到這架鋼琴的人用壞了也不會修，最終就變成這樣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140123,
					"content": "妳能修好它嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140124
					]
				},
				{
					"id": 747140124,
					"content": "當然可以。這能難倒我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140125,
					"content": "#呃，不過這看起來散得也太徹底了…如果{F#妳}{M#你}們能找到鋼琴的其他部分，我很快就能動手修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140126
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140126,
					"content": "好！那我們平時下水的時候就多留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140110,
					"content": "和這裡的環境很搭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				}
			]
		}
	]
}