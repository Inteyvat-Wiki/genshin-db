			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "關於無名的寶藏",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "如果我的猜測沒錯，您上次拿來的那份東西，應該總共有三份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160303,
					"content": "將三份合起來，才是一個完整的物件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160304,
					"content": "如果您真能找齊，那我非常願意出個好價錢收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160305,
					"content": "不過這東西年代實在太過久遠，想要找齊…還是有些難度的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
