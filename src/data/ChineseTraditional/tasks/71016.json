			"dialogs": [
				{
					"id": 710160401,
					"content": "我去試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "好吧，如果您真的搜集齊全了，記得一定要拿來我看看。",
					"roleType": "TALK_ROLE_NPC",
