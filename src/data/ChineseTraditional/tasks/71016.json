			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "我找齊三份了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "您居然真的把這個搜集齊了？請讓我看一看…確實，這三份的紋飾連在一起，確實是在描述「若陀龍王」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160503,
					"content": "看起來，這隻鶴應該就是「理水疊山真君」了，這隻鹿…也許是「削月築陽真君」，但是剩下的這一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160504,
					"content": "咦？最後的這個上面的紋飾好像…被人特意磨掉了形象，一點細節都看不出來。這第三位仙人到底是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160505,
					"content": "算了，這些事已經超出了我的知識範圍了。但不管怎麼說，這份「寶藏」已經完整了，應該能賣個好價錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160506,
					"content": "怎麼樣，您是想要留個紀念，還是把這份「寶藏」出給我，賣個好價錢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160507,
					"content": "賣給你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "好的，那麼這些錢您拿好，東西我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160509,
					"content": "但是…為什麼紋飾之中的這三位仙人，會有一位被磨去了形象呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160510,
					"content": "是誰製作了這個東西，又是誰打碎了它，還擅自磨去了仙人的形象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160511,
					"content": "對了，索拉雅那傢伙好像已經來了璃月，我可以寫封信問問她…她也一定會對這個東西感興趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
