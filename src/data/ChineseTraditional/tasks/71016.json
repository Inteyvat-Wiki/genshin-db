	"talks": [
		{
			"id": 7101602,
			"completionStepIds": [
				7101602
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101602",
							"2"
						],
						"stepId": 7101602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "關於無名的寶藏",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160202,
					"content": "您拿的這東西…看起來倒不錯，這些紋飾應該也有些年頭了。請您稍等，我打開來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160203,
					"content": "這裡的東西雖然有缺損，但如果您急著脫手，我倒是可以出個價收了。只不過價錢高不了太多就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160204,
					"content": "我剛才看了看這東西。這紋路的樣式確實是璃月的，而且，這上面所記載的也正是和「若陀龍王」有關的軼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160205,
					"content": "傳說，若陀龍王是凝聚了璃月的岩元素神髓所生的魔龍，即使是岩王帝君摩拉克斯也無法輕易鎮壓它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160206,
					"content": "為了將其鎮壓，岩王帝君先召集三位仙人，讓他們齊力營造洞天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160207,
					"content": "然後，岩王帝君親自與其交戰，將其打入洞天之中，又命仙人齊力封鎖通路，這才將若陀龍王鎮住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160208,
					"content": "而您拿來的這個東西上的紋飾，應該就是在描述在這場大戰時，三位仙人齊力營造洞天的場景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160209,
					"content": "所以我猜測，這東西應該至少有三份，將這三個部分合起來，才是一個完整的物件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160210,
					"content": "這妳也知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "畢竟我是做這個買賣的，什麼方面的知識都要知道一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160215,
					"content": "啊，說得有些遠了。如我所說，這個物件一共有三份，單拿出來，恐怕價值不高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160216,
					"content": "但如果能將三份找齊，那就另當別論了。不過，看這東西的樣子也頗有年份，想要把三份都搜集齊全，只怕是難上加難",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160212,
					"content": "璃月還真神奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "這個我就不清楚了，但一位前輩曾經和我說，璃月實在是太大，歷史也實在是太悠久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160214,
					"content": "在璃月，無論發現了什麼奇怪的古物都不要驚訝。和璃月漫長的歷史相比，我們所知的東西只是滄海一粟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				}
			]
		},
		{
			"id": 7101603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
