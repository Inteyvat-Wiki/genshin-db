	"talks": [
		{
			"id": 7369901,
			"completionStepIds": [
				7369901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369901",
							"2"
						],
						"stepId": 7369901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736990101,
					"content": "#哦，看來{F#妳}{M#你}們已經順利完成了之前的訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990102
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990102,
					"content": "完成是完成了，不過斯露莎這傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990103,
					"content": "看到幾百年前的沙蟲結晶，明明前一刻還一本正經地說什麼雖然它已經存在了幾百年，但總有一天還是會不留任何痕跡地消失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990104,
					"content": "後一刻說到讚美她的頌詩可能會更快被傳得面目全非，馬上就換了個臉色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990105,
					"content": "哼，那當然了，我的偉業…我是說，吾輩花靈的偉業，應該是不朽的。怎麼能跟那些隨時都有可能煙消雲散的存在相比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990106,
					"content": "不能正確地保存，那就一定是方法有問題。前輩也是為了提醒我這一點才讓我去重新審視沙蟲結晶的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990107
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990107,
					"content": "原來斯露莎是這樣想的，倒也有些意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990108
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990108,
					"content": "難道前輩就不在乎花靈一族的聲名嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990109,
					"content": "如果說是人類之中流傳的聲名，或許並不那麼在乎吧。不管怎麼說，現在的矯論團可是無趣得很哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990110
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990110,
					"content": "#當然，要是多幾個像{NICKNAME}和派蒙這樣有趣的人物，那就另當別論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990111
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990111,
					"content": "嘿嘿，祖爾宛誇我們了欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990112,
						736990115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990112,
					"content": "好欸！謝謝前輩誇獎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990113
					]
				},
				{
					"id": 736990113,
					"content": "#等等…{F#妳}{M#你}、{F#妳}{M#你}怎麼亂認前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990114,
					"content": "斯露莎不要這麼小氣嘛，反正祖爾宛是這裡的長者，我們叫一聲前輩也很合理，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990117,
					"content": "不說閒話了，既然斯露莎還將在人類之中的聲名看得這般重要，那麼接下來的訓練或許剛剛好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990118
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990118,
					"content": "#嗯，我就等{F#妳}{M#你}們的好消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736990115,
					"content": "「有趣」能算是誇獎嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990116
					]
				},
				{
					"id": 736990116,
					"content": "以我的標準來說，的確是誇獎的詞彙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990117
					],
					"speakerTitle": "祖爾宛"
				}
			]
		},
		{
			"id": 7369906,
			"completionStepIds": [
				7369906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369906",
							"2"
						],
						"stepId": 7369906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736990601,
					"content": "哈，這不是之前來找米希爾時經過的地方麼。不過米希爾現在應該不在這裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990602,
					"content": "周圍這些荊棘…應該都是米希爾的夥伴吧，看起來都還不錯。說起來，我們之前還受過它們不少幫助呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990603,
					"content": "白飄飄還真是…該不會把我的功勞全都忘了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990604
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990604,
					"content": "怎麼會，斯露莎雖然嘴上抱怨個不停，但是到底還是會將同族之誼放在心上的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990605,
						736990607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990605,
					"content": "斯露莎做了什麼…想不起來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990606
					]
				},
				{
					"id": 736990606,
					"content": "#身為「謁頌主」怎能這樣健忘？罰{F#妳}{M#你}多寫幾篇頌詩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990609,
					"content": "嘿嘿，我知道，斯露莎這就叫「刀子嘴豆腐心」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990610,
					"content": "才不是這樣，我只是為了得到花冠…要不是前輩非要我來，哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990611
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990611,
					"content": "不管怎麼說，斯露莎能獲得「雙角的花冠」，也是因為有米希爾，那豈不是應該好好感謝她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990612,
					"content": "那種曾經沾染污穢還難看掙扎的傢伙…要我說，再走十遍「淨罪的巡禮路」還差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990613,
					"content": "十遍也太多了吧！等等…仔細想想好像也不是不能接受？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990614,
						736990616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990614,
					"content": "其實路途不算很長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990615
					]
				},
				{
					"id": 736990615,
					"content": "嗯，偶爾鍛煉一下也不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990618,
					"content": "光聽名字還以為要走上十天十夜呢，結果實際上也沒走多久嘛。怎麼說呢，路程短到讓人懷疑效果的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990619,
					"content": "如果有純水精靈的朝聖之路那樣的長度，那我或許也會欽佩她吧。現在這樣嘛，只能說和米希爾十分相稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990620,
					"content": "純水精靈的朝聖之路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990621,
					"content": "大災厄發生之後，陸陸續續有許多純水精靈從楓丹來到須彌，她們途經的道路就是所謂的朝聖之路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990622,
					"content": "奇怪，純水精靈為什麼要來須彌呢？朝聖…又是指誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990623,
					"content": "唔…我也只是聽前輩提起過這件事，雖然過去的確看過從楓丹遠道而來的純水精靈，但是並沒有去打聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990624,
					"content": "難道是「萬種母樹」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990625
					]
				},
				{
					"id": 736990625,
					"content": "對耶，斯露莎說過那是讓花靈得以降生的神明大人，要說尊貴的話，這裡最尊貴的一定就是萬種母樹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990626,
					"content": "不過，純水精靈和萬種母樹又有什麼關係…啊，難道說，純水精靈和花靈其實是遠房親戚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990627,
					"content": "唔…仔細看看斯露莎，越看越覺得跟純水精靈有幾分相似呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990628,
					"content": "哈哈，我該不會發現了什麼驚天大秘密吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990629,
						736990630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990629,
					"content": "倒也沒那麼相似吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990631
					]
				},
				{
					"id": 736990631,
					"content": "白飄飄又在信口胡說了…我可不認識什麼純水精靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990632,
					"content": "唉，說得也是。畢竟斯露莎剛才都說了，純水精靈們走的朝聖之路可比米希爾走過的淨罪的巡禮路長得多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990633,
					"content": "這麼說，純水精靈比花靈厲害！斯露莎要輸了，嗚嗚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990634,
					"content": "什、什麼？！我可不是這個意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990635
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990635,
					"content": "…正經地說，「淨罪的巡禮路」並不單指實際走過的距離，而是象徵一種上升的回歸趨勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990636
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736990636,
					"content": "唔…聽起來好像很厲害，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736990637,
					"content": "總之，片面地斷定花靈不如純水精靈是不合道理的！這可不是因為我在偏袒米希爾哦。",
