					},
					{
						"sceneId": 3,
						"position": [
							2590.03,
							341.248,
							2215.468
						],
						"pointId": 311500202
					}
				]
			},
			"dialogs": [
				{
					"id": 401990401,
					"content": "嗯，就從這裡開始調查好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990402
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990402,
					"content": "跟隨夜蘭在沉玉谷東北荒無人煙的區域穿行…\\n在夜蘭的引導下，從隱秘的位置對海灘仔細地偵察，成為了「暗中觀察的眼哨」。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990403
					]
				},
				{
					"id": 401990403,
					"content": "並沒有直接發現「黑錢領主」團伙的成員。周圍的環境似乎也沒有什麼異常之處。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990404
					]
				},
				{
					"id": 401990404,
					"content": "結果…這裡好像是普普通通的野外？根本沒有壞傢伙的痕跡嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990405,
						401990406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990405,
					"content": "別心急嘛，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				},
				{
					"id": 401990407,
					"content": "#嗯，{NICKNAME}已經明白自己要扮演怎樣的角色了，進入狀態的速度的確不比頂級探員遜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990408
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990408,
					"content": "現階段，我們需要「布餌」，這魚餌就是「黑錢領主」的贓物。所以「找到關鍵的物品」，比找人更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990409
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990409,
					"content": "要找到贓物，鎖定對方藏匿的據點，就是重中之重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990410
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990410,
					"content": "#{F#妳}{M#你}難道沒有覺得，這裡的視野很棒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990411,
					"content": "這麼一說…好像可以看到遺瓏埠的港口，遠處水面的船，還有一座塔…那座塔是幹什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990412,
					"content": "是千岩軍的燈塔，平時負責守望水域。必要時，則會打出頻閃燈語，承擔一定的通訊作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990413,
						401990419
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990413,
					"content": "好像明白了這裡的優勢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990414
					]
				},
				{
					"id": 401990414,
					"content": "哦？說說看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990415,
						401990416,
						401990417
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990415,
					"content": "窺伺千岩軍有利於他們行動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990418,
					"content": "八九不離十了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990425,
					"content": "千岩軍百年如一日，不斷派遣巡邏部隊，將沉玉谷主要地區的治安維持得無可挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990426
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990426,
					"content": "利用這裡的視野優勢，觀察千岩軍的燈語，盡力推測千岩軍的行動規律，能最大程度幫助「黑錢領主」轉運贓物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990427
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990427,
					"content": "那麼，附近應當會有「黑錢領主」的眼哨留下的痕跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990428
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990428,
					"content": "#太…太複雜了，完全跟不上{F#妳}{M#你}們的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990429,
					"content": "總之，拿著這部<color=#00E1FFFF>「綜像勘錄儀」</color>，調查並記錄附近的情況吧，細心尋找線索，必定不會空手而歸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990416,
					"content": "這裡十分適合反偵察？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990417,
					"content": "要避開危險的路線運輸贓物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990419,
					"content": "其實不太明白這裡的特別之處…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990420
					]
				},
				{
					"id": 401990420,
					"content": "可以大膽猜猜看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990421,
						401990422,
						401990423
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990421,
					"content": "觀察千岩軍，自己躲起來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990424,
					"content": "#{F#妳}{M#你}看，{F#妳}{M#你}的直覺非常準嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990422,
					"content": "在這裡巡邏，取得主動權？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990423,
					"content": "應該是觀察點，而不是據點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990406,
					"content": "還不是直接抓壞蛋的時候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				}
			]
