				]
			},
			"dialogs": [
				{
					"id": 401990601,
					"content": "收穫還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990602
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990602,
					"content": "一柄鑰匙，應當可以打開某扇關鍵的門。鴿子傳信筒中，則有著許多暗語寫成的短訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990603
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990603,
					"content": "噫…真的在這裡藏著一些作案工具…那幫傢伙未免也太大膽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990604,
					"content": "不怕觀察千岩軍的時候，被千岩軍發現，抓起來好好調查嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990605,
					"content": "這些器物表明，「黑錢領主」的眼哨有很大可能偽裝成了漁民，他們的心理素質足夠死硬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990606
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990606,
					"content": "如果眼哨堅持宣稱，自己只是找了個清靜的地方歇腳，沒有關鍵證據，千岩軍也不可能扣押一個平民，對其深入調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990607
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990607,
					"content": "呃…我都能想像出那人死皮賴臉的模樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990608,
						401990609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990608,
					"content": "好在，我們找到了這些東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				},
				{
					"id": 401990610,
					"content": "藏匿器物的痕跡還很新，說明部署在這裡的眼哨另有一人並未被埃德勒抓捕，還在活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990611
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990611,
					"content": "我們需要警惕，不能讓對方意識到，我們還在追蹤調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990612
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990612,
					"content": "夜蘭顯然有備而來，取出一套精巧的工具組，首先原樣復刻了那柄鑰匙，隨後針對性記錄了傳信筒中的暗語片段…\\n隨後，夜蘭將現場恢復成了原狀，完全看不出有過調查的痕跡。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990613
					]
				},
				{
					"id": 401990613,
					"content": "好了，既然我的猜想得到了驗證，黑錢領主的確在這裡安插了眼哨，那麼，藏匿貨物的據點會在哪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990614
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990614,
					"content": "#{F#妳}{M#你}怎麼看，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990615,
						401990618
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990615,
					"content": "好像有點頭緒了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990616,
						401990617
					]
				},
				{
					"id": 401990616,
					"content": "監視行動的時間很敏感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990621,
					"content": "#完美的直覺，之後似乎不用對{F#妳}{M#你}進行過多的暗示了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990622
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990622,
					"content": "以信鴿的速度，在較短時間內能夠飛行的距離，畫一個敏感圈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990623
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990623,
					"content": "再避開燈塔的視野，與人多眼雜的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990624
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990624,
					"content": "推算出來的位置是…暝垣山北邊的淺灘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990625,
					"content": "這樣看來，是一片相當可疑的區域，充分利用了山體的掩護，還有著俗語中「燈下黑」的便捷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990626
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990626,
					"content": "下一站的目的地很明確了，我們動身吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990617,
					"content": "傳信要快捷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990618,
					"content": "沒什麼想法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990619,
						401990620
					]
				},
				{
					"id": 401990619,
					"content": "但既然要傳遞重要訊息…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990620,
					"content": "總要考慮信鴿的飛行時間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990609,
					"content": "利用這些線索，能推進調查。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				}
			]
		},
