			},
			"dialogs": [
				{
					"id": 401990101,
					"content": "欸，那邊在喝茶的人…不是夜蘭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990102,
					"content": "她好像在和朋友聚會？我們來得正巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990103,
						401990104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990103,
					"content": "（不對，這個氣氛…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				},
				{
					"id": 401990105,
					"content": "欸，不上去打招呼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990106,
					"content": "前前後後忙了這麼久，應該沒有漏網之魚了吧，埃德勒警官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990107
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990107,
					"content": "外勤辦案的時間應當還有幾天，正好用來犒賞自己，適當度個假？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990108,
					"content": "多謝您熱情招待，夜蘭小姐，這陣子簡直忙掉了我半條命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990109
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 401990109,
					"content": "唔哎…十三個據點啊…那些傢伙簡直都是盜寶鼬成精！烏泱泱抓出那麼一大批人的時候，我都懷疑冤枉了誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990110
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 401990110,
					"content": "好在，終於把這幫經濟犯一鍋端掉了！現在，我就要去翹英莊，找我那位工程師同學安心敘敘舊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990111
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 401990111,
					"content": "別忘了帶些茶葉和點心，給執律庭的朋友們當禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990113
					],
					"speakerTitle": "科德"
				},
				{
					"id": 401990113,
					"content": "啊，夜蘭的朋友走掉了，我還以為能認識一下呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990114,
						401990115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990114,
					"content": "（旁聽的兩人問題很大啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990116,
					"content": "又是令人驚喜的偶遇啊，請坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990117
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990117,
					"content": "店家，請沏一壺品相最好的「雲來白毫」，再補兩套茶具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990118
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990118,
					"content": "#看{F#妳}{M#你}的眼神，應該對剛剛窺伺我們的那兩人，很感興趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990119
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990119,
					"content": "咦！什麼叫窺伺？剛剛有其他人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990120,
						401990121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990120,
					"content": "那兩人顯然不懷好意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990122,
					"content": "可不止被竊聽哦，他們可能已經派人跟上了埃德勒警官，針對我們的行動路線，開始採取對應措施了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990123
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990123,
					"content": "我、我有點明白了！夜蘭妳是不是在對付什麼奇怪的罪犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990124,
					"content": "那些傢伙居然敢反過來跟蹤妳？未免也太膽大包天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990125,
					"content": "如果不是習慣了鋌而走險的傢伙，又怎麼輪得到我來對付呢？我還想把功績留給其他同行，好好休假呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990126,
						401990127
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990126,
					"content": "能讓妳親自出手，事情很嚴重？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990128,
					"content": "涉案金額或達十位數的…「摩拉除痕」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990129
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990129,
					"content": "摩拉廚…廚什麼？不對，十位數…十位數是多少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990130,
					"content": "簡單來說，某位楓丹商人持有大量來路不正的摩拉，楓丹的執法機構可能根據種種痕跡鎖定這筆錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990131
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990131,
					"content": "為了避免這筆錢被追查，牽連自己，就需要將其置換成合法的摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990132
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990132,
					"content": "於是，這名商人想到了一個點子——高價值藝術品的拍賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990133
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990133,
					"content": "他四處購買收藏品，運回楓丹後，將其包裝成藝術價值極高的珍品，炒出高價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990134
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990134,
					"content": "等到拍賣時，他用贓款買下自己炒上高價的收藏品。經過中間周轉，除去差價後到手的摩拉就「乾淨」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990135
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990135,
					"content": "利用這一手段，這名商人不僅洗清了自己手中的贓款，甚至開始幫其他罪犯除痕，並因此得到了「黑錢領主」的稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990136,
						401990137
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990136,
					"content": "這些收藏品與璃月有關吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990138,
					"content": "沒辦法，誰讓沉玉谷的商品精美實惠，又歷史悠久呢？茶具、瓷器、玉玦和石雕，都可以被包裝成價值連城的藝術品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990139
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990139,
					"content": "以璃月的商品為媒介，從事如此見不得人的勾當，長此以往，會對璃月的貿易造成難以估量的惡劣影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990140
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990140,
					"content": "為此，正好又在楓丹度假的我，就只能立刻回到工作狀態了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990141
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990141,
					"content": "唔…夜蘭的解釋還比較好懂？簡直像…把錢從左手換到右手…只是經過了一個騙人的幌子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990142,
					"content": "不過，既然妳們已經明白了對方犯罪的方法，順著這個線索，不就能揪出他了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990143,
					"content": "比如在拍賣會上埋伏好，等到那個壞傢伙出現，買下自己炒高價的璃月商品時，就衝上去把他銬起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990144,
					"content": "很敏銳嘛，派蒙，可惜還是不夠謹慎哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990145
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990145,
					"content": "如果妳是這一切的幕後黑手，妳會輕易親自現身，在別人眼皮底下東奔西走，忙活這一切嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990146
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990146,
					"content": "#這麼說來，好像的確不能輕易暴露呢…如果我是壞人，就讓{NICKNAME}跑腿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990147,
					"content": "#不對不對，就算我成了壞人，{NICKNAME}也不會變壞，那我就…收下一大群小弟，幫我買貨，做髒活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990148,
					"content": "哦…哦哦哦哦哦…這下連我都理解了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990149,
					"content": "就算追查到了那些有問題的收藏品，只要那個幕後黑手「黑錢領主」不親自現身參加拍賣會，還是很難辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990150,
					"content": "不止最後參加拍賣的人哦，來境外買收藏品、中轉回國內，作為賣家與拍賣會溝通…這些事，他都有部下掩護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990151
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990151,
					"content": "追查用來交易的收藏品，本身也是件複雜的任務，因為他採取了大量中轉的措施，交易痕跡相當混亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990152
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990152,
					"content": "放長線，釣大魚，才是眼下最理智的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990153
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990153,
					"content": "最終目的是用軌跡清晰的魚餌，避開所有障眼法，揪出隱藏在幕後的「黑錢領主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990154,
						401990155
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990154,
					"content": "所以，妳們有意讓對方旁聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990156,
					"content": "我、我還以為妳們真的是結束工作了，在放鬆呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990157,
					"content": "看來妳完全上當了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990158
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990158,
					"content": "在此之前，我已和千岩軍溝通，協助埃德勒警官突襲了「黑錢領主」的眾多據點，抓獲了這個團體幾乎所有的成員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990159
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990159,
					"content": "而剛才那兩位則是「黑錢領主」最重要的代理人，直接與他溝通的心腹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990160
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990160,
					"content": "一位是楓丹古董協會的高級成員科德，負責拍賣事務，一位則是須彌船東多達馬尼，從事貨運行業多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990161
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990161,
					"content": "我們以相當自然的方式「漏掉」了謹慎的他們，會讓他們以為自己走運倖存，採取緊急措施，處理錢款與貨品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990162
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990162,
					"content": "為此，那兩人立刻追蹤埃德勒警官，應當是想確認她的行蹤，協助他們在璃月最後的部下安全地轉移物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990163
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990163,
					"content": "現在，我要趁著他們的視線集中在埃德勒警官身上，打他們個出其不意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990164
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990164,
					"content": "怎麼樣，有興趣跟我同行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990165
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990165,
					"content": "#我很期待哦，{F#妳}{M#你}會在探案這一領域展現出怎樣的才華呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990166,
						401990167
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990166,
					"content": "我也不能容忍罪犯們亂來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990168,
					"content": "嗯！既然都遇上了這麼重要的案件，我們肯定不能裝作沒看見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990169,
					"content": "既是幫夜蘭妳，也是幫沉玉谷的大家，還有…唔…璃月的商界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990170,
					"content": "#令人欣賞的責任感啊，{NICKNAME}和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990171
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990171,
					"content": "#但也別忘了自己的利益。按楓丹流行的說法，最後給{F#妳}{M#你}們的酬勞，會對標「頂級探員」執行最危險外勤任務的薪資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990172
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990172,
					"content": "萬事開頭難，好在，開頭的線索已經有了眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990173
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990173,
					"content": "「黑錢領主」的團體異常謹慎，所以，我們要從「反偵察」切入正軌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990174
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990174,
					"content": "我有一種猜想…現在，我們先去東北方位轉轉，驗證他們是否如我所料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990167,
					"content": "我也想試試跟妳一起工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990155,
					"content": "妳們剛才在假裝放鬆警惕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990137,
					"content": "否則也不會驚動到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990127,
					"content": "如此特殊的團體，犯了什麼罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990121,
					"content": "妳和妳的楓丹朋友被竊聽了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990115,
					"content": "（夜蘭不應該忽略了他們？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990104,
					"content": "（周圍有不懷好意的視線…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				}
			]
		},
