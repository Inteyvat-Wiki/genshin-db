				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "怎麼樣？你們找到寶藏了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045003,
					"content": "找到了，確實是在「匯成之地」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "原來如此…還真是和「歸終四誡」裡說的一樣，寶藏在四誡的「匯成之地」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045005,
					"content": "設置謎題的那個人，一定很尊敬「歸終」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045006,
					"content": "即使故鄉被毀滅，也要以這種方式把「歸終四誡」給流傳下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045007,
					"content": "而那位定下這四誡的「歸終」，也一定深愛著她庇護著的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045008,
					"content": "她希望自己的子民們擁有智慧，用道德約束自己，祝福他們身體強健，而且團結一心，一同保護自己的家園「歸離集」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045009,
					"content": "但是她還是失敗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "失敗了？這麼說也沒錯，她死去了…「歸離集」被毀滅，她的子民們也流離失所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045011,
					"content": "不過，如今我們不是讓她的「歸終四誡」重見天日了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045012,
					"content": "這是那位「歸終」為她的子民們親手訂下的誡語，和送上的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045013,
					"content": "秉承著這份「歸終四誡」，她曾經在這片大地上，和自己的子民們攜手前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045014,
					"content": "即使她已經死去了，但是她的信念和理想絕不會就此消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045015,
					"content": "而且，那位崇敬著她的人可真是聰明，居然想到用「藏寶」的方式，把「歸終四誡」給傳下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045028,
					"content": "不過，也不知道在那個人心中，真正的寶貝到底是金銀珠寶，還是這份「歸終四誡」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045029,
					"content": "哈哈，要我說，比起那些金銀珠寶，這份「誡語」才是真正的寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045030,
					"content": "…但是，要真讓人選，又有多少人會拋棄財寶，選這份「誡語」呢？唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045016,
					"content": "是一位溫柔的魔神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "用「溫柔」來形容一位「魔神」，真是感覺有點不搭邊際…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045018,
					"content": "在很久很久之前，在那些引導著人們的魔神之中，也許真有「溫柔」的魔神吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045019,
					"content": "保護著自己的子民，和他們一同在這片大地上漫步，一同攜手前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045020,
					"content": "…不過這樣溫柔的魔神，最終還是什麼也沒能保護下來。就連她給自己子民的誡語，都要借助「寶藏」這種東西才能流傳下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045021,
					"content": "真想見她一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "#居然想要去見魔神，{F#妳}{M#你}還真是異想天開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045023,
					"content": "#不過，如果{F#妳}{M#你}真見到了「歸終」，{F#妳}{M#你}會做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045024,
					"content": "難道想要說「辛苦了」、「謝謝妳」之類的話，來安慰她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045025,
					"content": "如果要我說的話，不如流利背誦一遍「歸終四誡」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045026,
					"content": "然後告訴她，她的信念和理想還沒有消失，這片大地上還有人牢記著她的教誨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045027,
					"content": "對於已經失去了一切的「歸終」來說，也許…這才是最好的安慰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
