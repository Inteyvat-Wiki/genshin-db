			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "「歸終四誡」…到底是在暗示什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040102,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "#哈哈哈，{F#妳}{M#你}可真有幹勁，那好吧，我們開始解讀一下這個「歸終四誡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040106,
					"content": "「教之以智、律之以德、堅其筋骨，眾志一心，四者匯之而成『歸離集』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040107,
					"content": "從字面上來看，確實是類似於一種對於日常生活的「勸誡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040108,
					"content": "不過，這句話哪裡是在暗示著寶藏的線索呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040109,
					"content": "…沒辦法了，還是用我們學者最笨，也是最自討苦吃的方法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040110,
					"content": "先前，我們發現那七段話的地方，都是在各種形式的「遺蹟」裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040111,
					"content": "既然現在我們不知道如何入手，那麼，就繼續去搜索「遺蹟」看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040112,
					"content": "到哪裡找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "嗯…搜索區域的話，就暫時劃定在「歸離原」裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040114,
					"content": "#但是{F#妳}{M#你}看我這樣的學者，一定跟不上{F#妳}{M#你}的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040115,
					"content": "#所以，搜索遺蹟的事就拜託{F#妳}{M#你}了，如果找到線索的話，就回來告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040129,
					"content": "這麼說起來，我曾經在這附近發現過一處遺蹟，而且，我還在裡面發現了一個奇怪的圓盤，上面還有字跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040130,
					"content": "不過，當時我也只是做了一些孤立的研究，沒有再深入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040131,
					"content": "現在回想起來，說不定那片遺蹟裡的那個圓盤，會和這「歸終四誡」有所關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040132,
					"content": "#唔…這樣，我幫{F#妳}{M#你}在地圖上標記出來，{F#妳}{M#你}可以去看一下，說不定真能發現什麼線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040116,
					"content": "全，全部要找一遍嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "當然不是，如果把搜索範圍擴大到整片璃月的話，就憑我們兩個人絕對搜索不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040118,
					"content": "既然是「歸離原」上「歸離集」的寶藏，那麼我們就縮小搜索範圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040119,
					"content": "搜索區域就暫定在這片「歸離原」之內吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040120,
					"content": "#啊，對了，{F#妳}{M#你}看我這樣的學者，一定跟不上{F#妳}{M#你}的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040121,
					"content": "#所以，搜索遺蹟的事就拜託{F#妳}{M#你}了，如果找到線索的話，就回來告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040122,
					"content": "我這就去把璃月裡的遺蹟全部找一遍！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "#等一下！{F#妳}{M#你}別這麼激動，璃月這麼大，{F#妳}{M#你}想要找到什麼時候去啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040124,
					"content": "#聽見寶藏就激動成這樣…我到底該說{F#妳}{M#你}什麼好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040125,
					"content": "既然寶藏來自於「歸離原」上的「歸離集」，那我們首先縮小一下搜索範圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040126,
					"content": "我想想…搜索範圍就暫定在這片「歸離原」之內…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040127,
					"content": "喂，聽我說完再走！記住了，一定要仔細搜索遺蹟，如果有什麼發現，就帶回來告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040128,
					"content": "記住了，在「歸離原」之內搜索就好，別跑太遠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040104,
					"content": "去找寶藏吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "#一說到寶藏，感覺{F#妳}{M#你}就精神煥發…算了，我們開始解讀這個「歸終四誡」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "索拉雅"
				}
			]
		},
