		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "即使是魔神，也有著逃不脫的命運…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042002,
					"content": "在四個遺蹟裡找到了四條線索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "四個遺蹟，四條線索…剛好和「歸終四誡」的誡語數量一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042004,
					"content": "不過，這四句話都是關於「歸終四誡」中某一條的解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042005,
					"content": "想要正確解讀，「歸終四誡」的原文應該才是關鍵，這四條都是輔助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042006,
					"content": "要把這五段話都結合起來，但是到底該怎麼理解呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042007,
					"content": "「匯之而成」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "匯之而成…聽起來像是在說，這四段話可以用某種方式結合起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042009,
					"content": "等等，我記得，這四段「誡語」都各自存在於某一處遺蹟之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042010,
					"content": "唔…我有一個不成熟的猜測。如果想要解讀這四段「誡語」，也許還需要借助一下這些「誡語」各自所在的<color=#00E1FFFF>「遺蹟」</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042011,
					"content": "#不過，具體的解讀方式，我還要再思考一下…{F#妳}{M#你}也可以想想，如果有什麼好想法，直接去付諸實施也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042012,
					"content": "#畢竟{F#妳}{M#你}不像我這個「弱不禁風」的學者，跑幾步就沒力了…唉，真羡慕{F#妳}{M#你}，有這麼好的體力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042013,
					"content": "#好了，我再在這裡仔細思考一下，如果{F#妳}{M#你}有什麼想法，或者發現的話，就來告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
