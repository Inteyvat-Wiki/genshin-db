				{
					"id": 210040201,
					"content": "我有興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "#我把已經發現的那片遺蹟標在{F#妳}{M#你}的地圖上了，{F#妳}{M#你}先去那裡看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040203,
					"content": "對了，如果找到了什麼線索，可別太興奮，記得<color=#00E1FFFF>先記下來</color>，再慢慢解讀啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
