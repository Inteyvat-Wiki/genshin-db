			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "要是那位旅行者也沒空，該怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361402,
					"content": "那是你的問題哦，誰讓你擅自接下這種麻煩事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361403,
					"content": "哎呀，你真走運，你的救星來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361404,
					"content": "#欸？太好了！旅行者{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361405,
					"content": "別擔心，我很空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "這就是說閒人閒人到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361407,
					"content": "社長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361408,
					"content": "跟旅行者比，社長才是閒人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361409,
					"content": "不呀，我很忙的呀。忙著站在這裡…要站一整天呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361410,
					"content": "就算是不想接的委託，社長這個藉口也太敷衍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361411,
					"content": "不想接的委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "#對對…這就是麻煩{F#妳}{M#你}過來的原因，讓我來詳細說明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361413,
					"content": "最近，天領奉行的一位重要人士失蹤了，既不見人，也沒有辦法聯繫上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361414,
					"content": "因為各種原因，天領奉行不方便大張旗鼓地搜尋，所以私下委託了我們尋找這個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361415,
					"content": "他的名字叫作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361416,
					"content": "叫作九條裟羅，這位大將失蹤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361417,
					"content": "…要真是那位大將失蹤了，還不把稻妻城翻個底朝天，可能會僅僅委託我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361418,
					"content": "#旅行者，{F#妳}{M#你}別聽社長亂說。其實這個失蹤者名叫鹿野院平藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361419,
					"content": "他是奉行所的特別偵探，雖然職級只是同心，但本領不小，很受奉行所重視。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361420,
					"content": "嗯？本領比我還大嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361421,
					"content": "社長，妳不肯幫忙就算了，至少不要添亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361422,
					"content": "不好意思旅行者，雖然我接下這個委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361423,
					"content": "#但是{F#妳}{M#你}也看見了，社長…她不太樂意插手這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361424,
					"content": "因為報酬太少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "脫靶！零分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361427,
					"content": "要問原因的話，那就是我絕不會管那個臭小子的事哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361428,
					"content": "如果有什麼是比「鹿野院失蹤了」更讓人開心的…那只能是「鹿野院失蹤了一百年」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361429,
					"content": "咳咳…總之，珊瑚社長和平藏先生，有那麼一點點過節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361430,
					"content": "我懂了…同行相輕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "#咳咳…{F#妳}{M#你}誤會了，可能比這還嚴重一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361432,
					"content": "社長說，平藏先生是她通往真相聖殿的絆腳石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361433,
					"content": "是攔路狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361434,
					"content": "唉…雖然平藏先生的個性確實比較…嗯…別致？但他絕對是個好人，他曾經教會了我很多東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361435,
					"content": "所以就算社長不允許，我也不能置之不理。至少可以把委託轉交給信任的人，比如說神通廣大的旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361436,
					"content": "明白，我是外包。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "啊…不、不是的！那個…天領奉行承諾的報酬當然會全數奉上，另外我個人也再額外補貼一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361439,
					"content": "#所以希望旅行者{M#你}{F#妳}能夠接下這個委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361440,
					"content": "#如果平藏先生真的遇險了，我想有{F#妳}{M#你}在，他會更安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361441,
					"content": "你跟他很熟嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "其實我們關係很好的，只是珊瑚社長一直要求我跟他保持距離，也不讓我公開表現得跟他很熟的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361443,
					"content": "所以一般別人問起，我通常只是說我稍微與鹿野院先生見過幾面，今天要不是出了這事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361444,
					"content": "#咳咳…還是先不說這個了，能請{F#妳}{M#你}幫忙去找找他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361449,
					"content": "瞭解了，我現在出發。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "嗯，差不多就這些了。請收好奉行所的委託書，如果找到了平藏先生，直接回奉行所回報就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361445,
					"content": "沒問題，但我需要更多訊息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "太好了！我們得知平藏先生在失蹤前對海祇島很有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361447,
					"content": "戰爭期間，他似乎在海祇島執行過任務。戰爭結束後，他也曾頻繁往返海祇島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361448,
					"content": "#我聽說旅行者{F#妳}{M#你}跟珊瑚宮關係匪淺，我想，或許可以把那裡當作調查的起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361437,
					"content": "明白，你是二道販子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "因為線索太少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#旅行者，請{F#妳}{M#你}快些出發吧，希望平藏先生不要遇到危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361502,
					"content": "再跟我說說這個鹿野院平藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "平藏先生嗎？他是個充滿生命力的人！話很多，人也活潑，精力旺盛，從來沒見過他停滯不前的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361504,
					"content": "社長總說他就像隻嗡嗡飛的蒼蠅，一定是因為他能夠準確找到每一隻裂了縫的蛋吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361505,
					"content": "這樣說的話，我想平藏先生可能還不僅是普通蒼蠅，他應該是隻高級蒼蠅呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361506,
					"content": "就算把他的鼻子堵住、眼睛蒙住、耳朵遮住，他依然能準確找到蛋殼上的裂縫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361507,
					"content": "很神奇吧，好像他依靠的是一種五感之外的東西，第六感？直覺？神明的援手？還是別的什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361508,
					"content": "這個比喻很清新，下次不要再比了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "啊，社長總說我不會說話，看來果然是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 190361510,
					"content": "這個比喻爛透了，我還想再聽一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "咳咳…要不改天再聊吧…社長在盯著我們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
