					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430301,
					"content": "#嗯，這些應該就夠用了。抱歉啊，{F#妳}{M#你}好不容易過來神社，我還拜託{F#妳}{M#你}幫忙…這些東西{F#妳}{M#你}先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430302,
					"content": "#等我木雕的手藝練好了，我一定送{F#妳}{M#你}一座最好的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430303,
					"content": "唔，接下來雕個什麼樣的代宮司大人好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		}
	]
