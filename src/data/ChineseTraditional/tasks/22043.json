			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "木頭怎麼又用完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430102,
					"content": "#喔！旅行者！{F#妳}{M#你}來得正好，{F#妳}{M#你}願意幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430103,
					"content": "什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "我最近，正嘗試按照代宮司大人的模樣雕刻一些尺寸很小的木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430106,
					"content": "我想，等我雕得好一些之後，就帶著這些木雕回鳴神島去，看看能不能賣出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430107,
					"content": "如果真能賣出去的話，應該也能算是一份穩定的收入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430108,
					"content": "應該能賣出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "#嘿，那我就借{F#妳}{M#你}吉言了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430110,
					"content": "不過，我也對代宮司大人的魅力很有信心啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430118,
					"content": "啊…先不說這些了，我們說正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430119,
					"content": "其實，最近我手上用來練習木雕的木材有些不夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430120,
					"content": "旅行者，能請旅行者幫我去外面搜集10份「御伽木」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430121,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者，真是幫了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430126,
					"content": "#{F#妳}{M#你}搜集到御伽木後，就快點帶來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430123,
					"content": "要這麼多嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "畢竟我剛開始練習木雕不久…多備一些材料總是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430125,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430111,
					"content": "怎麼突然開始做木雕？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "#{F#妳}{M#你}問這個啊…那個，{F#妳}{M#你}知道代宮司大人給我的「報酬」是什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430113,
					"content": "是一些…瓶瓶罐罐，杯杯盞盞之類的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430114,
					"content": "雖然看起來有點舊了，但我拿回去給人看了之後，發現這些東西居然還頗有些年頭，而且也能賣一點錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430115,
					"content": "不過把那些東西拿去賣錢的過程很辛苦，每次都讓我筋疲力竭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430116,
					"content": "而且，這樣子的收入也不穩定…要是代宮司大人哪一天找不出這些東西了，我不就又等於失業了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430117,
					"content": "所以，我正想辦法開闢一條新的生意路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430104,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
