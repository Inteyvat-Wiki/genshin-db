					"content": "可以了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "好耶！那我們就在這裡休息一下，然後回去找賽諾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130101006,
					"content": "在附近坐下歇息了一段時間。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "感覺時間差不多了，我們回拍賣會那裡看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130101008,
					"content": "不知道賽諾那邊有沒有收穫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130101004,
					"content": "再走一段路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "還要繼續走嗎？可是我已經沒力氣了…不如就在這裡休息一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "派蒙"
				}
			]
