			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "好熱…要是有乘涼的地方就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100202,
					"content": "稍微休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "還有不少路要走，再堅持一下。而且從周圍環境來看，這裡也不適合休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100204,
					"content": "呼…好吧，可是賽諾不覺得熱嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100205,
					"content": "當然覺得，不過我已經習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100206,
					"content": "有什麼秘訣嗎？我感覺已經快堅持不住啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100207,
					"content": "盡可能保持清醒，然後靠毅力撐著。一旦放鬆下來，只會更加疲憊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100208,
					"content": "一步一步走，不要讓大腦判斷身體的極限，到相對安全的地方再徹底放鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100209,
					"content": "好吧。不過安全的地方指的是哪裡呢？我覺得這裡很安全呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100210,
					"content": "你看，這裡是一望無際的沙漠，附近也沒什麼怪物——嗚哇！這些毒蠍是從哪裡來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100211,
					"content": "小心，這些傢伙不太對勁——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "呼…沒想到這裡居然會有毒蠍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100402,
					"content": "這不是普通的毒蠍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100403,
					"content": "#{F#妳}{M#你}看，牠們的鉗子上有編號，這是人為飼養的毒蠍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100404,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "有人不希望我們去拍賣會，所以派牠們過來攔截。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100406,
					"content": "反正周圍是漫漫黃沙，就算我們被做掉，也不會有人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100407,
					"content": "好危險！幸好我們沒有放鬆戒備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100408,
					"content": "但是不太對…沙漠中沒有固定的路，他們怎麼知道我們會到這裡來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100409,
					"content": "#別動，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100410,
					"content": "#果然…他們把這東西放在{F#妳}{M#你}身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100411,
					"content": "這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100412,
					"content": "妙論派造出來的小型定位器，能夠據此確定佩戴者的大致方位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100413,
					"content": "我記得這個裝置沒有獲得量產許可，他們是從哪裡弄來的…莫非有妙論派的學者牽涉其中？可是不太對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100414,
					"content": "#居然還有這種東西，為什麼會在{NICKNAME}的身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100415,
					"content": "應該是和傭兵纏鬥的時候，被他們放上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100416,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "當時情況很亂，沒發現很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100419,
					"content": "幸虧賽諾發現了，那我們快把它扔掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100420,
					"content": "#…不，還是先讓它留在{F#妳}{M#你}身上，應該會派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100421,
					"content": "繼續去拍賣會吧，在這裡耽誤太久，說不定會有別的危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100417,
					"content": "沒注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "奇怪，這裡就是拍賣會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100602,
					"content": "一個人都沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "是呀！一個人都沒有，難道說是中場休息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100604,
					"content": "打敗那些傭兵團之後，我們立刻馬不停蹄地趕往這裡。之所以這麼急，就是擔心會有人過來通風報信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100605,
					"content": "而我們還是撲了個空，想必是因為這裡的人透過定位器觀察到了我們的動向，提前撤離了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100606,
					"content": "那我們現在該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100607,
					"content": "搜。他們沒來得及轉移所有的罐裝知識，這裡可能會有線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100608,
					"content": "那我們可要好好找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽諾",
					"巴哈利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "哇！真的抓到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100702,
					"content": "你就是在背後搞鬼的大壞蛋嗎？快把你知道的說出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100703,
					"content": "這個人知道什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "剛剛他出現的時候，我沒有第一時間出手，而是在旁邊觀察了一陣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100706,
					"content": "他不是幕後主使，但他應該是一個分量不輕的商人。我說的對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100707,
					"content": "不愧是賽諾，看得真準…早知道你沒走，我就不貪這點便宜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100708,
					"content": "貪便宜？什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100709,
					"content": "得知你們要來，各地的罐裝知識商人立刻作鳥獸散，貨物也來不及全部帶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100710,
					"content": "這些暫時都是無主之物，只要搶在別人之前拿回去，就能大賺一筆。當然，現在說這些也沒有什麼意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100711,
					"content": "你應該知道是誰在製造和售賣罐裝知識吧。需要我動手，還是你自己說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100712,
					"content": "我自己說吧。不過在那之前，我希望換個地方說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100713,
					"content": "留在這裡，如果被別人看到我和你們接觸，我和我的家人也會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100714,
					"content": "你想去哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100715,
					"content": "到我家吧，在阿如村，那裡很安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100716,
					"content": "#可以。{NICKNAME}，把定位器丟掉，我們過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100704,
					"content": "這個人的「分量」夠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西敏",
					"巴哈利",
					"賽諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "爸爸，你回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100802,
					"content": "啊，是客人嗎？你們好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100803,
					"content": "這是我的女兒，名叫西敏，稍微有些怕生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100804,
					"content": "乖，妳先自己玩一下，爸爸有事要和幾位客人聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100805,
					"content": "噢…好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100806,
					"content": "#賽諾的名字，業內沒有不知道的。{F#妳}{M#你}們兩位怎麼稱呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100807,
					"content": "#我是派蒙，這位是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100808,
					"content": "說實話，我也沒想到那位獨來獨往的賽諾，居然會有同伴。所以看著定位器逐漸遠離，我才篤定是賽諾無功而返。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100809,
					"content": "不過，就算你們抓到了我，我還是想勸你們一句…到此為止吧，不要繼續查下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100810,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100811,
					"content": "製造、銷售、分贓…每個環節少則幾十人、多則上百人，高額的利潤讓所有人聚攏在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100812,
					"content": "為了維護這條來之不易的產業鏈，每個人都會竭盡全力，就算是你也只能撞得頭破血流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100813,
					"content": "而且就算你真的做到了，也沒有任何人會感謝你。或許你自己都會感到難過…為什麼要這麼拼命呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100814,
					"content": "每個人都有自己的堅持，沒什麼好說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100815,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100816,
					"content": "爸爸…喝茶…還有客人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100817,
					"content": "喔，瞧我都忘了幫客人倒茶了。多謝妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100818,
					"content": "沒事…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100819,
					"content": "家裡的茶很苦。所以，我把爸爸給我的糖放進去了。應該會好喝一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100820,
					"content": "真懂事，糖還有嗎？沒有的話，爸爸下次再買給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100821,
					"content": "好…我去休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100822,
					"content": "不是說參與其中的人可以獲得高額的利潤嗎？我從你身上看不到這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100823,
					"content": "…其實，這也是我想跟你們說的，一個我自己的請求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100824,
					"content": "我的女兒，出生起就患有一種頑疾。她的心肺比一般人虛弱，稍微劇烈的運動就可能導致暈厥，甚至面臨生命危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100825,
					"content": "因為這個原因，她自幼沒有玩伴，整天把自己關在房間裡。平常還要吃很多藥，開銷很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100826,
					"content": "而我呢，原本只是個小商人，起早貪黑、東奔西走，賺到的那點錢遠遠不夠，只能一天天地看著她越來越虛弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100827,
					"content": "直到有人找上我，指了一條生財之道給我——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100828,
					"content": "售賣罐裝知識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100829,
					"content": "沒錯。賺到了錢，總算可以幫她治病。看著她逐漸好起來，我心裡比誰都開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100830,
					"content": "像我這樣的人還有很多。走私罐裝知識在你看來不可原諒，但對我們來說這卻是活命的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100831,
					"content": "我告訴你這些，就是想勸你一句——收手吧，賽諾大人，給我們一條活路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100832,
					"content": "怎麼會這樣…也就是說如果我們禁止售賣罐裝知識，她就會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100833,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100835,
					"content": "我必須要知道真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100836,
					"content": "我可以找人幫那孩子看病，但我不能對走私罐裝知識視而不見。這是兩碼子事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100837,
					"content": "我就知道你會這麼說，不過有你這句話就夠了。既然你執意要查下去，就去房屋後面找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100838,
					"content": "那裡有我不久前剛剛進的貨，看過之後，你就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100839,
					"content": "與賽諾一同來到了房屋後面。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "居然有這麼多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100841,
					"content": "整整齊齊裝了這麼多箱子，這裡還只是其中一個商人的據點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100842,
					"content": "這個數量不可能是小規格生產的。難道真的是教令院？可是像這樣大宗貨物進出，不可能沒有審查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100843,
					"content": "快看，這些罐裝知識好像不太一樣，難道這就是記錄歸寂之庭的罐裝知識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100844,
					"content": "應該沒錯。等等，這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100845,
					"content": "沒見過的標記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "這是風紀官的放行圖章。印有這個標記，就意味著裡面的貨物已經由風紀官審查過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100848,
					"content": "見到定位器的時候，我懷疑有教令院的人參與其中，但我想不明白怎麼把這麼多罐裝知識送出教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100849,
					"content": "現在我明白了。有了這個圖章，貨物進出教令院就無需二次審查，可以暢行無阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100850,
					"content": "哼，難怪不希望我繼續查下去。破壞風紀的竟是風紀官本身，難以置信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100851,
					"content": "也可能是誤會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}，可以拜託{F#妳}{M#你}一件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100853,
					"content": "既然這些罐裝知識來自教令院，那麼關於歸寂之庭的罐裝知識，很可能用的也是教令院內封存的研究資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100854,
					"content": "只要去資料室查看紀錄，就能弄清楚背後是誰在搞鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100855,
					"content": "但以我現在的身分，貿然出現在教令院，只會打草驚蛇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100856,
					"content": "#這件事，可以拜託{F#妳}{M#你}來調查嗎？我會寫信給納比爾，讓他帶{F#妳}{M#你}去資料室。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100857,
					"content": "包在我們身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100858,
					"content": "這段時間我也不會閒著。雖然幕後之人的線索指向教令院，但對方明顯在教令院外也很有勢力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100859,
					"content": "#從巴哈利那裡可以拿到一些其他商人的資訊，我留下來提前做些準備。{F#妳}{M#你}們有什麼新的發現，可以隨時回來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 130100846,
					"content": "賽諾認識嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
