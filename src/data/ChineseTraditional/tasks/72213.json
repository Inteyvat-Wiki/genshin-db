			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "太好了，有這些鐵塊就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130502,
					"content": "等會我就去外面找個合適的位置搭爐，然後製作工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130503,
					"content": "#請{F#妳}{M#你}們代我去向代宮司大人說一聲吧，我先在這裡收拾收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		},
		{
