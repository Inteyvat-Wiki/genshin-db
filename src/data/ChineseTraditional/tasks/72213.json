			"trigger": {
				"objectNames": [
					"「寢子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "「抱愁」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130102,
					"content": "雕像如何了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "那個石頭人類可真厲害啊，喵喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130104,
					"content": "已經做好了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "不是，只是轉眼間就弄來了一塊好大好大的石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130106,
					"content": "然後唸叨著，「宮前」、「抱愁」之類的東西，然後一邊對著石頭咚咚咚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130107,
					"content": "說起來，請汝回答奴家吧。「宮前」、「抱愁」到底是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130108,
					"content": "是「工錢」、「報酬」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "也就是為了報答他的勞動，給他的好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130110,
					"content": "是這樣嗎？人類原來講究這個啊…那好吧，奴家就恩准他摸奴家的耳朵好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130111,
					"content": "可、可能不太夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130112,
					"content": "不夠嗎？那，汝給他…吃的東西好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130113,
					"content": "可能他想要的是錢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "錢？這種東西不是用來放進「塞錢箱」的嗎？真奇怪，人類竟然中意這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130115,
					"content": "工錢是很重要的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "哼，汝姑且也幫奴家做了不少事，奴家相信汝便是。回頭，奴家再跟他談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130117,
					"content": "不過，石頭人類現在沒有咚咚咚了。看他拿著好短的木頭棍子，不知道在做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722130118,
					"content": "木頭棍子？雕塑不是要用錘子、鑿子之類的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722130119,
					"content": "難不成工具壞了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#那{NICKNAME}，我們去找大島先生吧！說不定我們能幫上什麼忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
