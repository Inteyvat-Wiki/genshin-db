			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "唉，這沒錘子，沒鑿子，怎麼幹活呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130302,
					"content": "遇見什麼難題了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "#喔，是{F#妳}{M#你}們啊。哎呀…真是大意了，來的時候沒檢查工具，結果工作的時候太入神，不小心把錘子和鑿子都弄壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130304,
					"content": "雖然我也想回去鳴神島買點工具，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130305,
					"content": "怎麼說呢…雕刻雕像這種事情，我習慣一口氣做好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130306,
					"content": "雖然錘子和鑿子壞了，但我還能稍微比劃一下，想一想後面怎麼雕刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130307,
					"content": "要是現在離開這座雕像，去鳴神島買工具的話…回來之後，我又要從頭回憶雕刻的手感了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130308,
					"content": "而且，這塊石頭的質地也太硬了，用一般的工具雕刻的話，工具肯定還是會很快壞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130309,
					"content": "唔…沒辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130310,
					"content": "#旅行者，能請{F#妳}{M#你}們去幫我找三份鐵塊回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130311,
					"content": "我得想個辦法，自己親手造幾份可靠的工具才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130312,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "#喔！那就拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130314,
					"content": "你…自己開始鑄造？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "我好歹也是在踏鞴砂做工的，鍛冶當然也會一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130316,
					"content": "不過，我可不能在神社開爐，不然代宮司大人一定會生氣…嘿嘿，畢竟她是貓嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722130317,
					"content": "#總之，請{F#妳}{M#你}先找三份鐵塊給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		},
