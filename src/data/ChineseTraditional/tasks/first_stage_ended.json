			"dialogs": [
				{
					"id": 3090201,
					"content": "呼，可算是全部處理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090202,
					"content": "這樣蒙德的元素流動、地脈循環就會恢復正常了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090203,
					"content": "要回去看看<color=#00E1FFFF>騎士團</color>的情況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090204,
					"content": "#當然，如果有什麼別的有趣的事要做，我也可以陪{F#妳}{M#你}先去喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090205,
					"content": "比如去蒙德購物…或者一起再去看看<color=#00E1FFFF>七天神像</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090206,
					"content": "之前我們在四風守護的廟宇裡，得到了一種好像凝固的風一樣的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090207,
					"content": "在蒙德，人們把它叫做「散失的風神瞳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090208,
					"content": "這個名字代表的是：它有資格被鑲嵌在神像的眼眶裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090209,
					"content": "有童話說，是燕子銜走了作為眼睛的寶石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090210,
					"content": "但其實「散失的風神瞳」本來就沒有實體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090212,
					"content": "擁有「神之眼」的人會注意收集它們，送去<color=#00E1FFFF>七天神像</color>，取得賜福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090213,
					"content": "#雖然{F#妳}{M#你}沒有「神之眼」，但{F#妳}{M#你}超脫這個世界的常理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090214,
					"content": "想試試的話，就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090215,
					"content": "風起地的那座七天神像，應該就是離我們最近的一座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090216,
					"content": "#我很期待…這一次，神明又會怎樣回應{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
