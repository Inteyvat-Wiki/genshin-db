	],
	"talks": [
		{
			"id": 7352601,
			"completionStepIds": [
				7352601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352601",
							"2"
						],
						"stepId": 7352601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪蒂哈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735260101,
					"content": "早知道就找人幫忙跑腿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260102
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260102,
					"content": "只不過是第一次測試，居然就要翻山越嶺，這是什麼人間疾苦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260103
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260103,
					"content": "妳不要緊吧？說話都有氣無力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260104,
					"content": "#{NICKNAME}，她看起來完全虛脫了，我們做點東西給她吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260105,
					"content": "在附近的爐灶做好了熱氣騰騰的炸蘿蔔丸子和烤肉排，讓這位虛脫的陌生人補充了體能…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260106
					]
				},
				{
					"id": 735260106,
					"content": "哈哈哈哈！我又活過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260107
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260107,
					"content": "手藝還不錯，可惜食材和調味料的品質不好，導致食物的口感乾巴巴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260108
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260108,
					"content": "這種時候就不要挑三揀四了啦，吃飽肚子不就行了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260109,
					"content": "錯了錯了！越是困苦的時候，越要想像奢侈的生活，這樣才能給自己奮鬥的動力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260110
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260110,
					"content": "越是資金周轉不開時，越要想辦法高額借款，這樣才能大開大闔，抓住破局的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260111
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260111,
					"content": "#這就是我，「幻之玩具王·瑪蒂哈」給{F#妳}{M#你}們的回報——逆轉局勢的商業秘訣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260112
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260112,
					"content": "幻…之玩具王？聽起來倒是滿威風的，不過看妳狼狽的樣子，總感覺有蹊蹺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260113,
						735260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260113,
					"content": "玩具還沒造好吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				},
				{
					"id": 735260115,
					"content": "#{F#妳}{M#你}們！{F#妳}{M#你}們是怎麼看穿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260116
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260116,
					"content": "剛才妳都餓得快昏倒了啦，神志不清的時候還在自言自語，說什麼測試，找人跑腿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260117,
					"content": "一看就知道，妳還沒做好妳的招牌玩具吧？甚至連吃飯都忘記了，未免也太慘了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260118,
					"content": "可…可惡，被妳這麼一說，我好不甘心！我的「吼吼小狐」已經進入生產前的最終階段了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260119
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260119,
					"content": "只要測出了「吼吼小狐」的飛行包線，就能完成蕈獸都能看懂的說明書。再借一大筆錢批量生產，就能盈利了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260120
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260120,
					"content": "什麼飛行包線？什麼說明書？不要跟我們講這麼多術語啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260121,
					"content": "#空談無益，就讓{F#妳}{M#你}們見識一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260122
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260122,
					"content": "#瑪蒂哈從行囊中拿出了一個藍色的包裹，對它快速充氣。\\n片刻過後，造型奇妙的玩具便在{F#妳}{M#你}們的面前成形了，穩穩地飄浮在半空中。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260123
					]
				},
				{
					"id": 735260123,
					"content": "這就是妳說的王牌玩具嗎？明明一點都不像狐狸啦！還不如取個…「大耳朵日落果炸彈·青之星星限定版」之類的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260124,
					"content": "還有，「吼吼」是怎麼回事？它的表情也不像在笑啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260125,
					"content": "#不不不，是因為它的噴氣裝置運作時聽起來像是人在吼吼大笑！不信{F#妳}{M#你}們聽聽看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260126
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260126,
					"content": "（發出難以名狀的低頻嘯叫，也許勉強可以用「吼吼」來做比喻）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260127
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260127,
					"content": "#她到底從哪裡聽到的這種笑聲…{NICKNAME}，我有點擔心她的精神狀態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260128,
					"content": "總之，「吼吼小狐」由小型熱氣球提供升力，隱藏的小噴氣口提供推力，有著不錯的操作性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260129
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260129,
					"content": "想像一下，它可是能靈活飛行的玩具！別說一般的小孩了，就連大人也無法抵抗它的誘惑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260130,
						735260131
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260130,
					"content": "這麼一說，確實很新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260132,
					"content": "我聞到了熟悉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260133,
					"content": "#讓我猜猜看，瑪蒂哈的下一句話是——「拜託{F#妳}{M#你}們幫我完成最後的測試吧，我會給{F#妳}{M#你}們一筆報酬的」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260134,
					"content": "#但我和{NICKNAME}還得好好商量一下，畢竟我們很忙，只拿一點點報酬可是吃虧的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260135,
					"content": "不不不，只是一點獎金可不夠，讓我算算看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260136
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260136,
					"content": "#「吼吼小狐」一年內總銷售額的六成，哦不，七成分紅，{F#妳}{M#你}們覺得夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260137
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260137,
					"content": "七成！這未免也太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260138,
					"content": "咳咳…這才像話嘛，「幻之玩具王」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260139,
						735260140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260139,
					"content": "一年內能量產嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260141,
					"content": "#這就是關鍵所在了，兩位！{F#妳}{M#你}們盡快完成測試，就能讓「吼吼小狐」提前投入生產和銷售，拿到更多分紅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260142
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260142,
					"content": "我們一起努力，把產品做到最好，才能達成雙贏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260143
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260143,
					"content": "也對哦，越想越有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260144,
					"content": "#嘿嘿，{NICKNAME}，這樣一來，我們也算是進軍玩具產業，稱得上是商業人士了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260145,
					"content": "#事不宜遲，我之前請教過不少冒險家，根據他們的經驗，佈置了幾個測試飛行包線的挑戰，先為{F#妳}{M#你}們大概指示一下方位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260146
					],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260146,
					"content": "#「吼吼小狐」的未來，還有「幻之玩具王」的招牌，全都拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪蒂哈"
				},
				{
					"id": 735260140,
					"content": "量產了也未必能盈利…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260131,
					"content": "說不定能賣得很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260114,
					"content": "也許已經破產了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				}
			]
		}
	]
}