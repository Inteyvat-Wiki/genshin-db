	"talks": [
		{
			"id": 1905101,
			"completionStepIds": [
				1905101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905101",
							"2"
						],
						"stepId": 1905101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"銀杏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "#{F#妳}{M#你}好，旅行者。我是銀杏，南十字的船醫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510102,
					"content": "水手們無論是暈船、風寒之類大病小病的治療，還是截肢什麼的，都由我來負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510103,
					"content": "我想瞭解一些海上傷病知識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "#嗯，是北斗姐安排的吧？那就由我為{F#妳}{M#你}介紹一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510105,
					"content": "#首先，{F#妳}{M#你}知道對新人來說，航海最危險的是什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510106,
					"content": "暈船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "這在海上確實比較麻煩，但還不是最危險的。對新人來說，航海最危險的其實是「對危險的掉以輕心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510110,
					"content": "我見過很多新船員，自詡年輕力壯，對所謂的傷病預防不屑一顧，以為在陸上沒有問題在海上也就能安然無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510111,
					"content": "這樣想的傢伙，最後都狠狠吃了苦頭。所有人都該知道，海上航行——尤其是遠航，是一件惡劣環境裡的苦差事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510112,
					"content": "我們要面對由物資短缺帶來的營養失衡；要面對驟變的溫差與嚴酷的天氣導致的傷寒雜病；",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510113,
					"content": "甚至還可能有因訊息閉塞和缺乏娛樂造成的心理問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510114,
					"content": "更關鍵的，海上沒有多麼豐富的藥物與治療手段，哪怕是一些小問題也可能走向不可挽回的結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510115,
					"content": "所以妳說的截肢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "#哈哈，{F#妳}{M#你}恐怕還以為我之前在開玩笑吧？也不奇怪，大多新人都會這麼想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510117,
					"content": "#但希望現在{F#妳}{M#你}可以正視這一點，很多事本不該發生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510118,
					"content": "好了，我想對新人而言，知道這些應該就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510119,
					"content": "#{F#妳}{M#你}還有要問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510120,
					"content": "北斗怎麼看這種事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "北斗姐啊…她可能是我見過最重視大家生命安全的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510122,
					"content": "雖然我只是個船醫，但由於北斗姐的授意，我有資格讓任何一位我覺得不過關的新人下船休整，直到他調整好心態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510123,
					"content": "每次遠航前的物資採購，藥物的優先順序也都排在前列，甚至我還被允許自由選擇供應商，預算充足，不論價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510124,
					"content": "#{F#妳}{M#你}知道在我們的會計錢眼兒那裡，這叫什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510125,
					"content": "叫重大財務風險，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510126,
					"content": "但為了避免無意義的人員損傷，北斗姐還是給了我這種權力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510127,
					"content": "我是她信任的人，她相信我可以解決這種問題…當然，事實也證明她的決心是對的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510128,
					"content": "這就是她的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510129,
					"content": "那些截肢的船員後來怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "#嗯…{F#妳}{M#你}也關注他們嗎？怪不得北斗姐對{F#妳}{M#你}另眼相待，看來也不全是因為實力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510131,
					"content": "#要是{F#妳}{M#你}能說服錢眼兒把帳簿給{F#妳}{M#你}看看，{F#妳}{M#你}會發現船隊有一項固定成本，條目名叫「傷殘船員定期療養支出及撫恤金」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510132,
					"content": "不論船隊的收入如何，這筆支出都是雷打不動的，每年都會送到那些並肩作戰過的夥伴手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510133,
					"content": "如今他們已經回到陸上，有些做起了小生意，有些出去雲遊四方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510134,
					"content": "如果能忘記身體的缺陷，他們或許過的比我們逍遙得多吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510135,
					"content": "只可惜，誰能真正忽略那些伴隨一生的傷痛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510136,
					"content": "唯一讓人安慰的，就是有北斗姐在的南十字，不會忘記任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510137,
					"content": "多謝，我瞭解了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "嗯，那就這樣，一定要注意身體健康哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銀杏"
				},
				{
					"id": 190510107,
					"content": "風寒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "截肢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				}
			]
		},
		{
			"id": 1905102,
			"completionStepIds": [
				1905102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905102",
							"2"
						],
						"stepId": 1905102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"繪星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510201,
					"content": "旅行者，真不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510202
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510202,
					"content": "#剛剛光顧著請{F#妳}{M#你}加入船隊，卻沒注意到這讓{F#妳}{M#你}為難了，還好有大姐頭提醒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510203
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510203,
					"content": "沒關係，我想瞭解海圖相關知識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510204
					]
				},
				{
					"id": 190510204,
					"content": "#啊！那{F#妳}{M#你}倒是找對人了，說句自誇的話，整個璃月港最有天分的航海士就在{F#妳}{M#你}面前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510205
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510205,
					"content": "#我就先介紹一下，對新人來說海圖辨識的關鍵吧。如果有問題，{F#妳}{M#你}可以隨時打斷我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510206
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510206,
					"content": "#當我們拿到一份參數繁雜的海圖，{F#妳}{M#你}知道重點要看什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510207
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510207,
					"content": "要看上面標註的岸形、島礁點、水深、水文要素和危險物這幾類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510208
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510208,
					"content": "#有了這些內容，{F#妳}{M#你}至少能夠確定，有沒有可能找出一條安全的航線來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510209
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510209,
					"content": "在表示方法上，海圖採用的繪製法也比較特殊，因為不像陸地有顯眼的參照，大多海圖沒有固定的比例尺，並不好判斷準確的距離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510210
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510210,
					"content": "只有最先進的海圖才會配置一份附圖，上面標註了不同顏色的輔助線來表示距離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510211
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510211,
					"content": "特別一提，在我的主持下，南十字用的就是這種哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510212
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510212,
					"content": "另外，還有些繪製者會在圖上標記出一些特別的點，通常是些特殊符號，如果沒有注釋，幾乎很難看懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510213
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510213,
					"content": "比如上一任航海士留下的海圖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510214
					]
				},
				{
					"id": 190510214,
					"content": "哈哈，不止這個，還有從各個管道得來的殘破海圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510215
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510215,
					"content": "說實話，對我來說也挺有挑戰的，因為它們可能有著很長很長的歷史了，那上面的符號…我從沒見過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510216
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510216,
					"content": "但越這樣，就愈會覺得，要是不把它們破解了，一定會錯過很多大海的秘密吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510217
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510217,
					"content": "還好有大姐頭在，不知道她從哪弄來了些符號學的古籍給我，這樣我也能邊學邊用地研究下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510218
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510218,
					"content": "想起來，也就只有大姐頭這麼神通廣大，能搞來這些市面上沒有的東西了，不管是古海圖，還是符號學的古籍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510219
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510219,
					"content": "哎呀，有些扯遠了！嘿嘿，其實關於海圖辨識的基礎知識，大致就是這些內容啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510220,
					"content": "#{F#妳}{M#你}還想知道什麼嗎？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510221,
						190510236
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510221,
					"content": "關於海圖繪製，妳有什麼經驗嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510222
					]
				},
				{
					"id": 190510222,
					"content": "海圖繪製嗎？這個難度就更高了呢，說實話，我在這方面造詣其實挺一般的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510223
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510223,
					"content": "因為我們現在使用的海圖，完全是在上一任航海士留下的基礎上所做的修訂版。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510224
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510224,
					"content": "只是由於海圖具備的「現勢性」，就是說得把大海時刻變幻的情況更新到圖中，這就是我為數不多的繪圖經驗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510225
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510225,
					"content": "#但是，我覺得這個{F#妳}{M#你}倒是可以去問問大姐頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510226
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510226,
					"content": "因為之前就有一次，船隊誤入了一片未知的海域。由於擔心危險，我們沒有太過深入，很快就返航了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510227
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510227,
					"content": "但航行過的區域，全被大姐頭自己繪製成了簡易海圖，以便未來探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510228
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510228,
					"content": "沒想到吧？我當時也很吃驚，原來大姐頭自己就可以搞定這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510229
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510229,
					"content": "那為什麼還要讓妳當航海士呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510230
					]
				},
				{
					"id": 190510230,
					"content": "因為我有天分嘛，她當然要培養我囉，嘿嘿。其實不僅是我，還有大家也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510231
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510231,
					"content": "#之前啊，我也有跟{F#妳}{M#你}一樣的疑惑，畢竟很多船隊的航海士就是船長兼任的，我沒想明白，乾脆就直接去問她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510232
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510232,
					"content": "結果大姐頭笑著訓了我一頓，說就算是岩王帝君，也從來不是孤軍奮戰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510233
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510233,
					"content": "她希望船上的每個人都能獨當一面，這樣南十字就不是她一個人撐起來的南十字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510234
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510234,
					"content": "即使將來有一天她不在船上了，這個隊伍也能一直前行下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510235
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510235,
					"content": "別看大姐頭平時風風火火、大大咧咧的，但真的為大家考慮了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "繪星"
				},
				{
					"id": 190510236,
					"content": "我沒有問題了，謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510237
					]
				},
				{
					"id": 190510237,
					"content": "#應該的啦，{F#妳}{M#你}不是大姐頭的朋友嘛，那也就是我的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "繪星"
				}
			]
		},
		{
			"id": 1905103,
			"completionStepIds": [
				1905103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905103",
							"2"
						],
						"stepId": 1905103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"徐六石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510301,
					"content": "#旅行者！{F#妳}{M#你}好啊，{F#妳}{M#你}是不是來找我瞭解海上天象觀測的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510302,
					"content": "你怎麼知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "哈哈，幹我這活計的，眼神不好使可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510304,
					"content": "#我剛看見大姐頭帶{F#妳}{M#你}在新人培訓那邊轉了轉，接著{F#妳}{M#你}又去了銀杏和繪星那裡，和她們聊了會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510305,
					"content": "#我就猜到了，大姐頭大概是想讓{F#妳}{M#你}瞭解瞭解我們的船員生活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510306,
					"content": "你果然有一套。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "#嘿嘿嘿，那我就不廢話了，跟{F#妳}{M#你}介紹一下海上天象觀測的要點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510309,
					"content": "所謂海上天象，主要指海上的天氣與海洋現象，像什麼海霧、風暴潮、海龍捲之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510310,
					"content": "這些大多都會影響到船隊的安全航行，但好在無論是什麼天象，到來之前都有預兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510311,
					"content": "就拿海龍捲來說，那是一種發生在海面上的高速旋轉風，它的吸力能輕易捲起大型船隻，危害很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510312,
					"content": "#但如果{F#妳}{M#你}知道，海龍捲只可能產生在高溫高濕且有大片烏雲的環境中，{F#妳}{M#你}就能有所準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510313,
					"content": "#如果{F#妳}{M#你}還知道，海龍捲發生前，海面會颳起相反方向且速度差很大的風，{F#妳}{M#你}就會更加警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510314,
					"content": "#最最關鍵的，如果{F#妳}{M#你}還注意到烏雲裡冒出了一個小小的白白的渦漩，{F#妳}{M#你}就該趕緊通知大家，準備避開前方航線了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510315,
					"content": "那就是海龍捲的預兆。很高興這些年，我沒有漏過任何一個預兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510316,
					"content": "你眼力真不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "哎，要說觀察大海的眼力，我還行吧。但要說看人的眼力，我比大姐頭差遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510318,
					"content": "#{F#妳}{M#你}知道望舒客棧旁邊的小漁村嗎？聽說大姐頭還小的時候就在那裡和大人一起捕魚做工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510319,
					"content": "#後來又到了港口裡討生活，那麼小一孩子，能在那種環境裡混出頭，{F#妳}{M#你}大概知道大姐頭的本事了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510320,
					"content": "#{F#妳}{M#你}看現在，要不是大姐頭拍著我肩膀說我能幹瞭望手這活，我自己都不敢往這方面想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510321,
					"content": "#{F#妳}{M#你}不知道，在外面的人那，關於我的傳言最多的就是「三碗不過港」這種醜事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510322,
					"content": "喝醉掉進海裡、被人嘲笑、被前船隊開除的菜鳥居然能當南十字的瞭望手？說出去誰敢信，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510323,
					"content": "所以說啊，光有點本事還不行，你還得找到個像大姐頭這樣慧眼識人的老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510332,
					"content": "多謝你的指導，我差不多瞭解了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "以後要是想知道更多，還可以再來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510324,
					"content": "你經驗很豐富。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "這樣說就慚愧了，我的很多經驗，其實都是大姐頭教的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510326,
					"content": "#就包括剛剛和{F#妳}{M#你}說的那些天象觀測的內容，她才是真的行家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510327,
					"content": "#{F#妳}{M#你}知道望舒客棧旁邊的小漁村嗎？聽說大姐頭很小的時候就在那裡捕魚做工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510328,
					"content": "後來又到了港口討生活，一直在這種環境裡摸爬滾打，難怪水上的一切她都門兒清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510329,
					"content": "最初我上船的那段日子，每天都在懷疑，難道自己以前的水手生涯都是虛度了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510330,
					"content": "直到後來漸漸習慣了這些新知識、新見聞，我才明白南十字能夠如此強大的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510331,
					"content": "畢竟不是每支船隊都有一位「龍王」坐鎮的。真幸運能夠加入這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "徐六石"
				},
				{
					"id": 190510307,
					"content": "北斗真是知人善任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
		},
