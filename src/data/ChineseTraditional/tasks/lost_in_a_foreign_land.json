			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "#咳咳…呼…等等，請先停手…！{F#妳}{M#你}是誰？為什麼會在這裡…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580102,
					"content": "以及…為什麼要攻擊我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580103,
					"content": "我們還想問妳咧！誰讓你在這裡鬼鬼祟祟的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580104,
					"content": "妳是壞人，妳先說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "…卡塔琳娜，卡塔琳娜·雪奈茨芙娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580106,
					"content": "名字是我們最不值得保密的情報，我只能透露這些，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580107,
					"content": "唔…我們只是想問問情況而已，又沒想拷問妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580108,
					"content": "抱歉、抱歉，這是我能透露的全部情報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580109,
					"content": "為什麼愚人眾會在這裡活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "機密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580111,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "什麼啦！你們這些神秘兮兮的壞傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580113,
					"content": "呵呵，對呀，我們就是這種壞傢伙喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580114,
					"content": "好了，好奇寶寶時間結束…我們有麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "#謝謝…不論如何，我很開心{F#妳}{M#你}沒有趁機在我背後捅刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580202,
					"content": "這是我要說的話才對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "#噗…雖然不知道{F#妳}{M#你}對愚人眾有何成見，但在這種地方搭話可一點也不浪漫…有什麼話就請來我的藏身點一敘吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580207,
					"content": "卡塔琳娜離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "欸？她可是愚人眾呀，我們就這樣把她放走了嗎？不把她交給千岩軍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580206,
					"content": "哼…我知道啦，算啦，反正她也沒有傷到我們，就當是饒她一命好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580203,
					"content": "愚人眾對別人都是如此疑心病嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "#{F#妳}{M#你}們兩個果然來了，請找個地方休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580502,
					"content": "我這裡還有些嗯…紅茶，沒有了…砂糖，也沒了…嗯，牛奶，嘔——酸掉了，我稍後丟掉好了…真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580503,
					"content": "不過火水還多得是…也有硬餅乾做茶點，還有點酸果醬…嗯，足夠開個茶會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580504,
					"content": "哇啊…！你們都用火水開茶會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580505,
					"content": "對啊，很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580506,
					"content": "唔…還是不了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "#怎麼？嘿嘿，在這裡是沒有人管{F#妳}{M#你}喝酒的。不要拘謹啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580510,
					"content": "妳這是在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "「恰到好處地分享食物和情報，可以堵住詢問者的嘴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580513,
					"content": "…我們的手冊是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580514,
					"content": "可是情報呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "嗯？剛剛那就是呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580516,
					"content": "什麼呀…妳剛剛說了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580517,
					"content": "「《愚人眾先遣部隊訓練手冊》附錄4-4，第32條：恰到好處地分享食物和情報，可以堵住詢問者的嘴。」喏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580518,
					"content": "為了報答救命之恩，我甚至透露了機密的訓練手冊內容！哼哼，誠意如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580519,
					"content": "告訴我們那個有什麼用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580520,
					"content": "#呵呵，不和{F#妳}{M#你}們開玩笑了…說真的，非常感謝{F#妳}{M#你}們的幫助，請不要過度解讀了我的好意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580521,
					"content": "唔…鑒於你們之前做的那些壞事，還真不好相信愚人眾會有好意呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580522,
					"content": "妳有什麼圖謀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "外人無法理解愚人眾的理念，並不出我意料。不過在不聊什麼理念呀、立場呀之類問題的時候，我們也是些普通人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580524,
					"content": "…況且，我們的一切行為，不論目的如何，都不過是在為最終的決戰做準備而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580525,
					"content": "最終的決戰…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "嗯，我們最終要面對的是共同的大敵，和無可逃脫的長夜…至冬國的國民都接受了這樣的警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580527,
					"content": "所以，為了這個冷酷的世界，人類流下的每一滴淚水與鮮血…都不是沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580528,
					"content": "乾杯？哼，好吧，好吧，我自便…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580529,
					"content": "妳是在為惡行找藉口嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "#或許吧…不知道，不在乎。{F#妳}{M#你}想要解釋，我給{F#妳}{M#你}理由…只不過是我的版本，可能不對{F#妳}{M#你}胃口。就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580534,
					"content": "#唔…{F#妳}{M#你}們怎麼突然正經聊起天來啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710580535,
					"content": "#順便，我已經自我介紹過了，但還不知道{F#妳}{M#你}們的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "我是派蒙！妳一定聽說過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
