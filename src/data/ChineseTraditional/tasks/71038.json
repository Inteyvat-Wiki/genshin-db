	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "#{F#妳}{M#你}好，前輩！請找個地方坐坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360402,
					"content": "關於冒險的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "#{F#妳}{M#你}是想問，為什麼我之前那麼倔強，讓大家如此費心嗎？哈哈…我知道錯啦，請不要再教訓我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360404,
					"content": "不過話說回來，對「危險」的癡迷，或許是我們這些冒險家的本性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360405,
					"content": "畢竟我們生來擁有堅韌的脊樑，輕捷的四肢…一想到身懷利器卻安於無風無浪的一生，就總覺得不甘心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360406,
					"content": "#至於致命的風險，我也不是沒有考慮過，但…嗯，我可以問{F#妳}{M#你}一個問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360407,
					"content": "請說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "蒙德的大冒險家史丹利因他橫穿燼寂海的壯舉而聞名…他在這場冒險中失去了自己的摯友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360409,
					"content": "因為他的這場冒險，那位死去的摯友…儘管很少有人知道他的名字是什麼，但關於他的記憶卻在冒險家中間流傳至今。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360410,
					"content": "我在想…哈哈，請前輩不要笑我幼稚。史丹利那位再不歸來的友人…會不會並未逝去，而是正在真正地「活著」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360411,
					"content": "唯有生命本身才最重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "但為人所銘記這件事本身…即使事業令他早夭，不也是一種生命的延續嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360413,
					"content": "就這樣藉助他人的憧憬與紀念，評價與凝視…以另一種方式活在眾人之間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360422,
					"content": "請不要太過在意別人的看法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "已經有很多人這樣勸過我了，「做妳自己就好」、「管好自己的事情就行了」…表面上是開導人的話，終究只是勸人放棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360424,
					"content": "其實我之前就說過了，我的冒險，不是為了別人…甚至不是為了自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360425,
					"content": "#嗯…{F#妳}{M#你}有這樣想過嗎，前輩…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360426,
					"content": "這個世界是由眾神擺佈的…但我們作為凡人，即使沒有神靈恩賜的「眼」，也同樣擁有不甘於安寧與遺忘的執著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360427,
					"content": "我相信這份不甘的心情並非毫無意義，所以才會不要命地跑去探索那些險地。畢竟呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360428,
					"content": "以弱小之身與縱使神靈也為之恐懼的永恆角力，這才是人之所以為「人」的理由…我是這樣相信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360429,
					"content": "但賦予冒險意義的不僅妳自己一人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "唔…我明白的。我不會忘記大家的幫助，不會忘記給前輩帶來的麻煩的…畢竟這場冒險並不僅是我一個人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360437,
					"content": "哈哈，這不就是冒險家嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360432,
					"content": "就這麼想要逞英雄嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "比起前輩來，我差得可太遠啦…比起想做英雄，唔…不如說是，「想活著的人才不怕會死於非命」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360434,
					"content": "這話是一個須彌的前輩告訴我的，她也是在「鍍金旅團」聽來的就是啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360435,
					"content": "我覺得很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360436,
					"content": "不如說是在一個勁地追求不吉利的倒楣事呢…這個人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360414,
					"content": "能被人記住，也是一種成功吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "唔…我從沒想過過一場「成功」的人生啦。相反，即使「失敗」，只要能讓眾人都留下印象就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360416,
					"content": "至少有人會說：「志瓊這個人，也是挑戰過層岩巨淵的啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360417,
					"content": "至少不會像那些犧牲在無人之地的前輩一樣…至少不會像現在的我一樣，被人遺忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360418,
					"content": "從來沒想過這種問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "這樣嗎…？或許那是因為像前輩這樣的外來人，無論在哪裡出現都會自然而然地成為視線的焦點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360420,
					"content": "就像含著金湯匙出生的孩子，也只會把貧窮當成一場並非必需的刺激冒險一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360421,
					"content": "啊，抱歉…我不是那個意思，我只是說…沒什麼。當我沒有問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志瓊"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "又是志瓊那傢伙，她去回收信標了…但現在還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380202,
					"content": "本來我也知道她那喜歡到處亂跑的臭毛病，給她多預留了三個小時回程…可現在都已經至少五六個小時了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380203,
					"content": "#那個孩子很尊敬{F#妳}{M#你}，還請{F#妳}{M#你}幫忙找找她吧。我可不希望再有人在我眼皮底下出事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
