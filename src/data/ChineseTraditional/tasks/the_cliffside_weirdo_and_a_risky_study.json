	"talks": [
		{
			"id": 7365101,
			"completionStepIds": [
				7365101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365101",
							"2"
						],
						"stepId": 7365101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈賈娜德",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736510101,
					"content": "嘿嘿嘿，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510102
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510102,
					"content": "大功告成了！接下來就是論證階段了！我要向大家證明，這就是煉金藥劑的最強形態！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510103
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510103,
					"content": "…這個人怎麼站在懸崖邊傻笑？還不停自言自語？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510104,
					"content": "#我感覺心裡毛毛的，{NICKNAME}，我們離這個怪人遠一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510105,
						736510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510105,
					"content": "萬一她有點想不開呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510107
					]
				},
				{
					"id": 736510107,
					"content": "#喂喂，{F#妳}{M#你}也太替別人著想了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510108,
					"content": "#嗯？{F#妳}{M#你}們什麼時候過來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510109
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510109,
					"content": "居然在背後議論別人，真沒禮貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510110
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510110,
					"content": "#我可是悉般多摩學院的明日之星哈賈娜德！等我成為知名的學者，一定要寫篇文章來埋汰{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510111
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510111,
					"content": "好兇！名字也好拗口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510112,
					"content": "等等？這個小傢伙難道是…那篇奇聞上的「白色高智慧浮游助手單元」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510113
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510113,
					"content": "什麼胡說八道的奇聞，從沒聽過這種外號啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510114,
					"content": "總之，帶著「白色高智慧浮游助手單元」的金髮異鄉人…不會錯，我走運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510115
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510115,
					"content": "呃咳！聽我說，我可以讓需要戰鬥的人變得更強。和我做個交易，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510116,
						736510117
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510116,
					"content": "好耳熟的展開…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510118
					]
				},
				{
					"id": 736510118,
					"content": "不奇怪，提瓦特各地有不少像我一樣的煉金術士，致力於發掘煉金術的最高價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510119
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510119,
					"content": "輔助戰鬥是煉金術的重要功能。如果能將藥劑的效力發揮到極致，就有機會改寫戰鬥的規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510120
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510120,
					"content": "#以{F#妳}{M#你}們的見聞，應該遇到過其他鑽研藥劑的煉金術士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510121
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510121,
					"content": "不過和我相比，其他煉金術士大多還在摸索，只有少數人取得了一點進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510122
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510122,
					"content": "比如一位蒙德的煉金術士，他發表了「廣域散佈霧化液體藥劑，改變戰鬥環境」的研究論文…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510123
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510123,
					"content": "太幼稚了！就算增加了輔助揮發的成分，散佈藥劑的速度和濃度也不可能合格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510124
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510124,
					"content": "突然就變得滔滔不絕了，她好像要證明自己在這方面做得最好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510125,
					"content": "所以說，交易的內容…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510126
					]
				},
				{
					"id": 736510126,
					"content": "對啊，哈賈娜德小姐，妳做出了更強的藥劑，打算特價賣給我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510127,
					"content": "#問得好！我正要向{F#妳}{M#你}展示我的最新研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510128
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510128,
					"content": "我將兩種高濃度的藥劑製成片狀的結晶，劃分成許多小塊，並將它們裝入高壓密封的煉金裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510129
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510129,
					"content": "需要使用藥劑時，就點燃裝置內的小型炸藥，將兩片藥劑的一部分瞬間氣化，充分混合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510130
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510130,
					"content": "並且利用爆炸的壓力，將藥劑煙霧推出裝置，散佈在廣闊的空間內，提供戰鬥的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510131
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510131,
					"content": "我稱這個過程為「重熔效應」，裝置為「重熔裝置」，藥劑則叫「重熔片劑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510132
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510132,
					"content": "重…重熔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510133,
					"content": "爆…爆炸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510134
					]
				},
				{
					"id": 736510134,
					"content": "強而有力的爆炸後，空氣中就充滿了沁人心脾的芳香，使用者的力量也隨之急速增長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510135
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510135,
					"content": "怎麼樣？很誘人吧？不想試試嗎？只需要在戰鬥中留意藥劑的功效，幫我記錄一些細節表現就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510136
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510136,
					"content": "當然，絕不是打白工，會有相當不錯的傭金哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510137
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510137,
					"content": "原來只想讓我們來當實驗品嗎？聽起來好危險！我們才不幹咧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510138,
					"content": "要是出了意外，給我們一千倍傭金的賠償，還勉強可以考慮考慮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510139,
					"content": "沒問題。反正我已經試驗過很多次了，我的裝置是絕對安全的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510140
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510140,
					"content": "這麼乾脆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510141,
						736510142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510141,
					"content": "我們倒也不缺這點摩拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510143
					]
				},
				{
					"id": 736510143,
					"content": "唔…想來也是，畢竟是登上過奇聞刊物的人，肯定也家財萬貫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510144
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510144,
					"content": "#那就…那就…求求{F#妳}{M#你}嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510145
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510145,
					"content": "#之前對{F#妳}{M#你}們態度惡劣，還想用這點小錢收買{F#妳}{M#你}們，真的很對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510146
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510146,
					"content": "#如果{F#妳}{M#你}們幫我完成試驗，就是我的大恩人！等我成為了知名的學者，我一定不會虧待{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510147
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510147,
					"content": "啊！突然就變臉了，還敢做出這種承諾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510148,
					"content": "好勢利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510149
					]
				},
				{
					"id": 736510149,
					"content": "說到底是我有求於人吧。需要依附別人的時候，最好端正姿態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510150
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510150,
					"content": "#我知道這副嘴臉很難看，但{F#妳}{M#你}們以後十有八九還會碰到我這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510151
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510151,
					"content": "#起碼我還會給{F#妳}{M#你}們報酬和承諾，有的人可能想著空手套白狼哦。這樣一想，我還算挺實在的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510152
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510152,
					"content": "呃，雖然這樣揣測別人不禮貌，但好像也不是危言聳聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510153,
					"content": "派蒙動搖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510154
					]
				},
				{
					"id": 736510154,
					"content": "話都說到這份上了，我也想看看她的煉金藥劑究竟有多厲害啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510155,
					"content": "而且，我感覺她也沒什麼壞心眼，可能只因為搞研究太心急了，才給人一種怪怪的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510156,
					"content": "完成研究以後，也許她會變成一個不錯的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736510157,
					"content": "#哦？{F#妳}{M#你}們在商量測試裝置的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510158
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510158,
					"content": "附近正好有一個秘境，根據其他冒險家的報告，很適合這次的戰鬥測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510159
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510159,
					"content": "妳倒是一點也不客氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510160
					]
				},
				{
					"id": 736510160,
					"content": "#我都把未來託付給{F#妳}{M#你}們兩位了，{F#妳}{M#你}們也爽快點嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510161
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 736510161,
					"content": "唔…反正和普通的冒險委託也沒太多區別，那就上吧，我們去秘境裡試試這個裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510162
					],
