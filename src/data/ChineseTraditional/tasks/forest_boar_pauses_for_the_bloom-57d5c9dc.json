			"dialogs": [
				{
					"id": 700610701,
					"content": "#哦…{F#妳}{M#你}們回來了？怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610702,
					"content": "已經趕跑啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "#啊，真是太感謝{F#妳}{M#你}了，來，這是給{F#妳}{M#你}的酬勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610704,
					"content": "付出了勞動，就應該拿到報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610705,
					"content": "這下也可以重新修整花田了，希望這次不會再有什麼不是人的傢伙來搗亂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奧波汀"
				}
			]
		}
