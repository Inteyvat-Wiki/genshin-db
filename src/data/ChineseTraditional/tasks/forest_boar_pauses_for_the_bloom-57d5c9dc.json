				]
			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "唉，又是這樣，怎麼花田又被變成這個樣子…真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610102,
					"content": "這樣子花又不能如期交付，該怎麼和收花的人說呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "#花田被毀了…唉{F#妳}{M#你}看看，本來多好的花啊，被禍害成這樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610105,
					"content": "都是那個傢伙做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610106,
					"content": "過分，真不是人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "對啊！真不是人…雖然這樣說，但做出這種事的的確不是人，而是一隻林豬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610108,
					"content": "不知道為什麼，最近總是跑下來啃花，還在花田裡滾來滾去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610109,
					"content": "又非常狡猾，每次弄出動靜，一旦有人圍過來，就會立刻逃跑，剛剛還差點把路過老人的腰撞壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610110,
					"content": "過分，真不是…真不是好林豬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610111,
					"content": "#唔，仔細一看…哦，{F#妳}{M#你}不是榮譽騎士嗎？拯救蒙德的大英雄，就、就請幫幫我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610112,
					"content": "好，我來趕跑牠！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "#{F#妳}{M#你}願意出手幫忙就太好了…我記得，牠好像跑到山谷裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610114,
					"content": "但這傢伙非常狡猾，說不定要用花才能把牠引誘出來…可惜花田現在變成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "莉奧波汀"
				},
				{
					"id": 700610115,
					"content": "#也許{F#妳}{M#你}可以在路上採幾朵風息花把牠騙出來，讓牠也知道被人捉弄的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奧波汀"
				}
			]
		},
