			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "看，又來了兩位勇士！您是想要來挑戰「北風吹流」的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740102,
					"content": "來，往這邊走，我期待您能夠飛得比誰都好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740103,
					"content": "冷靜一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "飛行不需要冷靜，這位客人。絕對不需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740106,
					"content": "#冷靜只會讓{F#妳}{M#你}對風的感受變遲鈍，只有在毫無準備的情況下面對狂風，才可以發掘出自己的潛能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740107,
					"content": "如今的飛鼠都太膽小了！完全遺忘那篇《勇敢的北風》裡的教誨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740108,
					"content": "只是站在安全的地方讚嘆樹葉隨風起舞的勇氣，自己卻怕東怕西，不敢親自踏進風裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740109,
					"content": "這樣下去，我們要怎樣和公主殿下一起守護整個王國！真是沒道理！沒道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740110,
					"content": "還真是一位有活力的飛鼠呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790740111,
					"content": "看來他是真的很喜歡飛行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "所以我就找了幾個吹流格外激烈的風道，還在裡面設下了各類機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740113,
					"content": "只有最勇敢、最擅長飛行的勇士，才有辦法通過這條風道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740114,
					"content": "#兩位客人，{F#妳}{M#你}們有這個勇氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740115,
					"content": "想要試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "很好，請跟我來吧，風道就在不遠處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740117,
					"content": "那個…還有別的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "怎麼？還要做準備嗎？好吧，我就在此等待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740119,
					"content": "兩位客人想要挑戰風道的話，儘管來這裡找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克朗謝"
				},
				{
					"id": 790740104,
					"content": "我一句話都還沒有說耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}