			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡桃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "怎麼樣，是不是覺得詛咒全都被驅散了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110502,
					"content": "對，前所未有的舒暢！是健康的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110503,
					"content": "非常謝謝妳，還有這位旅行者！不然我可能就真的因為詛咒暴斃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110504,
					"content": "那，我現在就可以告訴你了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110505,
					"content": "鏘鏘！你被騙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110506,
					"content": "欸？怎、怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110507,
					"content": "這個東西，一般人接觸不到，但其實就是普通的地脈鎮石啦，它很容易吸引怪物過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110508,
					"content": "那些怪物也根本就不是什麼詛咒的具象化，就是真正的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110509,
					"content": "那就奇怪了，明明我什麼都沒做，你卻感覺完全沒事了，那說明什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110510,
					"content": "這、這個…難道，其實我沒有被詛咒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110511,
					"content": "可是，那我為什麼會生病呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110512,
					"content": "著涼了，吃了壞掉的東西，或者自己嚇唬自己，都有可能…我傾向最後一種，是我這裡的常見病哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110513,
					"content": "沒想到是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110514,
					"content": "我也沒想到，但…總之還是要謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110515,
					"content": "道謝就不必了，以後不要這麼疑神疑鬼的，我也不是每次都能找到合適的方法安慰你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110516,
					"content": "人這一輩子這麼短，趁著還活著把握時間好好享受生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110517,
					"content": "這話怎麼聽著…有點怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110518,
					"content": "那、那我先走了，抱歉給你們添麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110519,
					"content": "看來不是狼哥幹的，我稍微安心了一點。可是，只要狼哥沒有下落，就不能阻止他亂來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110520,
					"content": "既然這件事已經解決了，我們是不是可以繼續去找狼哥了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110521,
					"content": "我覺得，應該沒這個必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110522,
					"content": "因為要找的人已經主動上門來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110523,
					"content": "狼、狼哥——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110524,
					"content": "那、那個…抱歉，打擾你，還有你們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111110525,
					"content": "他就是狼哥？為什麼是個小孩子？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110526,
					"content": "因為是幽靈嘛，理所當然地保持著他當年的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110527,
					"content": "呃，和「狼哥」這個名字給我留下的印象不太一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110528,
					"content": "先帶他回往生堂再說。接下來還有不少事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				}
			]
		},
