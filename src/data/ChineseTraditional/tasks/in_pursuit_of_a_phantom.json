	"talks": [
		{
			"id": 1111101,
			"completionStepIds": [
				1111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111101",
							"2"
						],
						"stepId": 1111101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老孟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "老孟，我回來啦！很遺憾，還是沒找到狼哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110102,
					"content": "這樣啊，那就麻煩了。我們能猜到的地方，算是都找過了一遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110103,
					"content": "狼哥到底是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110104,
					"content": "我還是從頭開始解釋吧。我的老家就在無妄坡附近，小時候，我有幾個玩得很好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110105,
					"content": "狼哥，就是其中之一，和我關係特別好，形影不離。可是，某一天因為意外，他不幸去世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110106,
					"content": "我總是忘不了這件事，可能因為我是個特別戀舊的人吧，所以我現在也經常回無妄坡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110107,
					"content": "但就在前段時間我從無妄坡回來之後，我就覺得很不舒服，而且每天晚上的夢裡，狼哥都會出現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110108,
					"content": "我就覺得，是不是我驚動了他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110109,
					"content": "聽起來很像幻想故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "可能吧，雖然我沒有證據，但我怎麼都放心不下來，越想越擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110112,
					"content": "想到孩提時代的友人，有可能變成了惡鬼，這種事怎麼能接受啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110113,
					"content": "他就是因為這個原因，才加入的往生堂。拜這件事所賜，我也不用給他付工錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110114,
					"content": "不過，老孟說的這種事是有可能的，因為確實時不時就會有鬼靈在現世遊蕩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110115,
					"content": "但惡鬼什麼的，純粹就是自己嚇唬自己了，我自己都沒有碰到過幾次惡鬼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110116,
					"content": "可是，這也不能證明狼哥的事沒有危險，我真的很不想看到他去到處害人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110117,
					"content": "你們看，就是這樣，如果不能把狼哥找出來的話，我說什麼老孟都聽不進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110118,
					"content": "剛剛我們找的那幾個人，同樣也是老孟的童年好友，本來以為狼哥會藏在他們那裡，結果又撲了個空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110119,
					"content": "無妄坡附近也找了，以前的朋友也找了，這下線索是徹底斷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110120,
					"content": "抱歉，抱歉，請問你們是往生堂的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110121,
					"content": "我叫洛成，我最近感覺很不對勁，感覺有什麼東西在盯著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110122,
					"content": "前幾天我和朋友去無妄坡試膽，回來之後我就病倒了，每天都做惡夢，找醫生也診斷不出毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110123,
					"content": "我這樣，肯定是被詛咒了對吧！被魔神詛咒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110124,
					"content": "對對對，嗯，是的，魔神詛咒，可嚴重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110125,
					"content": "妳也知道對吧！就是那個，傳說中在魔神戰爭中死去的魔神，對世間降下的痛苦詛咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110126,
					"content": "只要無法驅逐這種詛咒，最後就會燒穿五臟，骨肉分離，下場非常淒慘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110127,
					"content": "傳說裡中了這種詛咒的症狀，跟我現在簡直是一模一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110128,
					"content": "無妄坡，詛咒…不對，應該不是詛咒，多半是因為狼哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110129,
					"content": "唉，停一下停一下，你們兩個，都就此打住，別再自說自話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110130,
					"content": "妳才是最喜歡自說自話的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110131,
					"content": "往生堂擅長解決這種鬼怪和魔神的事吧！能不能幫幫我！我還不想死！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110132,
					"content": "好啊，沒問題，交給我吧，找我是找對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110133,
					"content": "不過要解除詛咒需要一個合適的場地，還要提前做一點準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110134,
					"content": "#新來的，我需要{F#妳}{M#你}幫我，跟我一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110135,
					"content": "那、那我也一起去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110136,
					"content": "你先幫他做一下準備。焚香驅邪那一套，我教過你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110137,
					"content": "做完準備工作來找我。等這頭忙完，我們再討論狼哥的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110138,
					"content": "好吧，只能這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110139,
					"content": "那，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110110,
					"content": "這種事不存在吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "所以，神神秘秘的，到底要做什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110202,
					"content": "什麼都不做，在這等著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110203,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110204,
					"content": "妳不會把什麼魔神詛咒的說法當真了吧？那種東西，早就被撲滅嘍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110205,
					"content": "那我們為什麼要到這裡來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "你也看到那兩個人了，一個覺得自己被詛咒，一個覺得摯友變成了惡鬼，都不好好聽別人說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110207,
					"content": "唉，所以我說，普通人什麼都不知道才是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110208,
					"content": "為這種事情緒失控的人，我見得太多了。想讓人平靜下來，必須讓他們看到令人信服的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110209,
					"content": "面對相信鬼怪的人，就該當著他們的面消滅鬼怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110210,
					"content": "唔…這話聽起來像哄三歲小孩的把戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110211,
					"content": "讓普通人知曉一切或許更好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "對哦，如果說恐懼來源於未知的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110216,
					"content": "因為沒有人能保證，把真相告訴無知之人，就能讓現狀變好而不是變糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110217,
					"content": "我要將靠近「邊界」的人拉回去。既然是心理作用，就對症下藥，當成心理作用來處理好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110218,
					"content": "倒是有點道理…那，詛咒的事又怎麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110219,
					"content": "這個嘛，你們聽說過「夜叉」的歷史嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110220,
					"content": "沒聽過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "他們曾經和魔神作戰，打得眼花繚亂、昏天黑地。雖然魔神最後被擊敗，但它們的怨念久久不散。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110223,
					"content": "有怨念化為瘟疫，在普通人之間傳播開來，惶恐的人們都以為那是「魔神降下的詛咒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110224,
					"content": "很多人被瘟疫奪去了性命，而這種瘟疫又以死去的人為溫床，繼續擴散。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110225,
					"content": "後來有人發現了阻止瘟疫擴散的方法：淨化空氣，焚燒屍骸。而第一批開始做這種事的人，就是「往生堂」最初的創立者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110226,
					"content": "原、原來是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110227,
					"content": "嗯，在那之後又過了許多年，那一場瘟疫終於被完全撲滅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110228,
					"content": "類似的事件，歷史上「往生堂」處理過很多次，最後的結果，都是讓璃月的生死重新回到某種平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110229,
					"content": "簡而言之，我們就像是「看門人」，不僅幫普通人看門，也幫不是人的東西看門，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110230,
					"content": "這就是「維護生死的邊界」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "所以，「詛咒」只是心理作用，這我比誰都要清楚。但曾經存在這種事，也是不能告訴普通人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110233,
					"content": "我們稍微等一等吧，等會就用這個地脈鎮石，演一齣好戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110234,
					"content": "終於來了，我們也剛剛準備好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110235,
					"content": "看，這就是用來驅邪的特殊裝置，可以把詛咒從你的體內吸引出來，再具象化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110236,
					"content": "不用擔心會有危險，因為這邊的旅行者是身經百戰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110237,
					"content": "果然是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "哦哦，對哦，忘記說了，哈哈，但是無所謂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110240,
					"content": "這樣真的就沒問題了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110241,
					"content": "相信堂主吧，雖然人看上去有點奇怪，但她做事是很認真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110242,
					"content": "喂，怎麼能用「奇怪」來形容我呀？至少也該是天真爛漫、不拘一格吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110243,
					"content": "總之，速速開工！新來的，去啟動裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110238,
					"content": "我可沒聽說過要戰鬥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "沒想到真是源遠流長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "略有耳聞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "派蒙今年幾歲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "為什麼突然問這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110215,
					"content": "我更關心為什麼不能直接告訴大家真相！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1111103,
