					}
				]
			},
			"dialogs": [
				{
					"id": 755040101,
					"content": "#嗨呀！{F#妳}{M#你}們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040102
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040102,
					"content": "#看{F#妳}{M#你}們的眼神，想必飽覽了各地的風光和物產，找到靈感了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040103
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040103,
					"content": "馬馬虎虎吧…這一路上玩得是滿開心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040104,
					"content": "有了特定的目標以後，還真的能夠注意到不少以前忽略的細節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040105,
					"content": "我們也算是大開眼界，收集了許多素材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040106,
						755040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040106,
					"content": "可惜不一定可以運用在塗鴉上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				},
				{
					"id": 755040108,
					"content": "#不要緊，慢慢來！我也不至於急到要{F#妳}{M#你}們在納塔遊覽一番，就頓悟前衛為何物嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040109
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040109,
					"content": "#那麼，向我細說{F#妳}{M#你}們的見聞吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040110
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040110,
					"content": "#給「炫彩呆子」看了{F#妳}{M#你}們在塗鴉指南上的紀錄以及拍攝到的各種畫片…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						755040111
					]
				},
				{
					"id": 755040111,
					"content": "#等等…{F#妳}{M#你}們拍攝畫片時的意識…不是很妙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040112
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040112,
					"content": "#沒想到{F#妳}{M#你}們使用留影機的經驗相當豐富，下意識為這些畫片選擇了絕佳的構圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040113
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040113,
					"content": "#既然如此，我說太多反而是揠苗助長，只需稍微給{F#妳}{M#你}們一點引導，應該就能打通{F#妳}{M#你}們的思維。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040114
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040114,
					"content": "#那就請{F#妳}{M#你}們收下我的手記，之後的旅途中沒事就對著眼前的風景讀一讀，也許眼前就能浮現出富有張力的構圖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040115
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040115,
					"content": "欸？我還以為妳會幫我們分析每張畫片，然後上一堂…前衛理念入門課說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040116,
					"content": "而且我也有點想塗鴉看看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040117,
					"content": "#這不是顯得{F#妳}{M#你}們天賦異稟，有望無師自通嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040118
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040118,
					"content": "讓無師自通的天才按部就班、循規蹈矩地學習塗鴉技巧，或許會扼殺他們發展的潛力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040119
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040119,
					"content": "#所以我就要從全責任的導師和引路人，轉變成提供{F#妳}{M#你}們幫助的前輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040120
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040120,
					"content": "#等到靈感噴湧，時機成熟了，{F#妳}{M#你}們拿起塗鴉的顏料罐就可以大展身手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040121
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040121,
					"content": "我們居然還有這種天賦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040122,
					"content": "嘿嘿…看來之前接了那麼多畫家、映影導演的委託，全都沒有白費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040123,
						755040124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040123,
					"content": "那就借妳吉言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040125,
					"content": "#放輕鬆，憑{F#妳}{M#你}們的才氣，一定有辦法以自己的理解抓準前衛藝術的脈絡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040126
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040126,
					"content": "我通常會待在「煙謎主」那邊籌備建設塗鴉聯盟總部的事，要是有什麼想要諮詢的事還可以來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040127
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040127,
					"content": "#下次過來的時候，我幫{F#妳}{M#你}們搭配一套上好的塗鴉裝備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040128
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040128,
					"content": "好，塗鴉聯盟的總部預定要建設在「煙謎主」那邊，我們記住了…祝你們一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040129,
						755040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040129,
					"content": "這次的交流很愉快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040131,
					"content": "等空閒下來，我們就多看看「炫彩呆子」的手記，讓自己的藝術思維變得更厲害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040132,
					"content": "說不定等以後我們真的成為了塗鴉和畫畫的高手，還可以用這門本領狠狠賺個外快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040130,
					"content": "下次再見了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040124,
					"content": "我們會努力去悟的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040107,
					"content": "前衛的理念還必須再琢磨琢磨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				}
			]
		}
	]
}