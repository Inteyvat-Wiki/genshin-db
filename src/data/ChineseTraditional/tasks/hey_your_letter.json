			"trigger": {
				"objectNames": [
					"米齊卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "這群冒失鬼，怎麼又弄丟好幾份快捷郵件。都說了在送東西的時候不要玩那些花俏的動作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350102,
					"content": "發生什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "有幾個「訊使」又不聽勸，把人家寄出去的快捷郵件弄丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350104,
					"content": "唉…他們都沒意識到這是在損壞我們「懸木人」的聲譽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350105,
					"content": "送東西就好好送東西，遇到山坡就正常越過去，幹嘛一定要半路突然開始玩滑行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350106,
					"content": "我講好幾遍了，但那群年輕人就是聽不進去，整天就想著要追求刺激…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350107,
					"content": "唉…我還要去拜託人把那些快捷郵件找回來。誰有空呢？我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350108,
					"content": "我可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "#{F#妳}{M#你}…願意幫我？那就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350110,
					"content": "我一時半會也找不到可以幫忙的人，如果我自己去找，那「訊使長屋」就沒有人看店了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350117,
					"content": "#我也不會讓{F#妳}{M#你}大海撈針的，我知道那群小子通常會從哪裡走，也大概可以猜到那些快捷郵件是在那裡不見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350118,
					"content": "#我這就幫{F#妳}{M#你}把丟失的地點畫出來，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350111,
					"content": "那些快捷郵件很大嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "不大，但就因為不大，每次找起來都很麻煩，唉…那群粗心的小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350113,
					"content": "#…如果{F#妳}{M#你}有空的話，願意幫我去找找那些快捷郵件嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350114,
					"content": "現在「訊使長屋」裡的人手也不夠，如果我自己去找，那就沒有人看店了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 250350115,
					"content": "沒問題，我來幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "那就太好了！真是多謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "米齊卡"
				}
			]
		},
