			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"優菈",
					"安柏",
					"伯恩哈德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705210101,
					"content": "優菈和安柏！妳們也來玩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210102,
					"content": "#找到{F#妳}{M#你}們了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210103
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210103,
					"content": "咦？妳們是專程來看望我們的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210104,
					"content": "#當然了，{F#妳}{M#你}們的店鋪名氣可大了，人們都在議論呢——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210105,
					"content": "「榮譽騎士和白色小幫手的『西風嘩嘩義賣聯盟』在出售各種寶物，還有神奇的贈品，不容錯過！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210106,
					"content": "結果我又變成「白色小幫手」了…不過聽見大家這麼評價我們的店鋪，還是很開心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210107,
						705210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210107,
					"content": "還是多虧了顧客們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210109
					]
				},
				{
					"id": 705210109,
					"content": "說起來，之前一直沒有看見安柏和優菈呢，妳們兩個出遠門了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210110,
					"content": "哈哈，我們還在工作嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210111,
					"content": "欸？還在工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210112,
						705210113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210112,
					"content": "節日無休？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210114
					]
				},
				{
					"id": 705210114,
					"content": "確切地說，我和安柏屬於騎士團中的「半休假人員」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210115
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210115,
					"content": "佳釀節期間，荊夫港和蒙德城之間的商隊來往頻繁，正是需要加強戒備的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210116
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210116,
					"content": "因為魔物和歹徒會出來搗亂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210117,
					"content": "沒錯。游擊小隊的任務就是在兩地之間巡邏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210118
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210118,
					"content": "跟隨商隊，保護大宗貨物的同時，還要主動出擊、調查可疑地點、提前排除威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210119
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210119,
					"content": "哇，聽起來好辛苦。妳們要這樣日以繼夜…一直忙到佳釀節結束嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210120,
					"content": "那倒不至於，我們會輪班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210121
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210121,
					"content": "一組人手在崗巡邏，一組人手放假休息，還有一組人手機動待命，作為預備隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210122
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210122,
					"content": "每隔一段時間，各個小組就進行輪流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210123
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210123,
					"content": "畢竟優菈是經驗豐富的隊長嘛。多虧了優菈的安排，游擊小隊才能一直高強度執勤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210124,
					"content": "這不是什麼要誇一句的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210125,
						705210127
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210125,
					"content": "好熱情啊，偵察騎士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210126
					]
				},
				{
					"id": 705210126,
					"content": "嘿嘿，下次有機會，再和妳說說優菈剛當上隊長時候的事吧，非常精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210129,
					"content": "咳咳…我們今天來還是有正事的，讓優菈講——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210130
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210130,
					"content": "#嗯，麻煩{F#妳}{M#你}們準備40份「騎士團特色北地煙燻雞」、40份「西風加護堆高高」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210131
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210131,
					"content": "好驚人的數量！一次買這麼多吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210132,
					"content": "難道…騎士團準備辦宴會了？怎麼沒人通知我們呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210133,
					"content": "哈哈，沒有那麼誇張喔，優菈隊長是準備犒賞她的隊員們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210134,
					"content": "嗯…游擊小隊成員們的日常消耗量很大，一頓…確實能吃掉四五人份的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210135
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210135,
					"content": "加上最近有位老隊員歸隊了，就想著好好慶祝一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210136
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210136,
					"content": "#與其買別的，倒不如用這筆錢來支持{F#妳}{M#你}們，還能充實慈善資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210137
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210137,
					"content": "喔噢噢！優菈的決定真是太明智了！一舉兩得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210138,
					"content": "謝謝惠顧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210139
					]
				},
				{
					"id": 705210139,
					"content": "對了…優菈剛剛提到的「老隊員」，該不會就是我們之前見過的那位吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210140,
					"content": "前進測繪員米卡。在跟隨大團長出征前，他一直是我們小隊的核心隊員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210141
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210141,
					"content": "對，就是他！沒想到那個看起來很靦腆的小騎士這麼厲害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210142,
						705210143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210142,
					"content": "但他好像害怕我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210144
					]
				},
				{
					"id": 705210144,
					"content": "#米卡並不是害怕{F#妳}{M#你}們啦，雖然有那麼一點點拐彎抹角，但這是他對{F#妳}{M#你}們的「尊重」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210145
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210145,
					"content": "他認為強大的人都有獨特的個性，要瞭解這些人，理解對方的想法後，再和他們深入交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210146
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210146,
					"content": "這樣，就能做到輕鬆愉快的溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210147
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210147,
					"content": "最初他對我和安柏也這樣。和我們逐漸熟悉以後，他才表現得自然起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210148
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210148,
					"content": "原來是這樣…米卡的性格還真是獨特呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210149,
						705210150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210149,
					"content": "我記住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210151
					]
				},
				{
					"id": 705210151,
					"content": "嗯，等之後有時間，多接觸幾次就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210152
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210152,
					"content": "#{F#妳}{M#你}是騎士團的重要人物，我作為他的長官，有義務防止你們誤解彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210153
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210153,
					"content": "嘿嘿，優菈不用這樣解釋啦。妳其實是在關照他，我們都懂的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210154,
					"content": "啊，優菈，剛剛妳把我的份也算上了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210155
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210155,
					"content": "摩拉我得單獨給才行，畢竟我不是游擊小隊的成員呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210156
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210156,
					"content": "一樣是我請客，就別客氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210157
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 705210157,
					"content": "向優菈和安柏交付了指定的菜餚，兩人道謝後離去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705210158
					]
				},
				{
					"id": 705210158,
					"content": "嘿嘿，多虧了優菈和安柏，一下子就賺到了之前一整天的摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210159,
					"content": "榮譽騎士、派蒙！特大喜訊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210160
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210160,
					"content": "#多虧{F#妳}{M#你}們兩位，這次活動籌集的資金遠超預期！可以說是大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210161
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210161,
					"content": "哼哼，我就說吧，我們肯定能搞定所有麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210162,
						705210163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210162,
					"content": "大家都辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210164
					]
				},
				{
					"id": 705210164,
					"content": "#還得是{F#妳}{M#你}們兩位的功勞，{F#妳}{M#你}們指導有方，義賣才能如此順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210165
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210165,
					"content": "我已經將所有收益交給了慈善資金的負責人，這次義賣活動到這裡就圓滿結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210166
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210166,
					"content": "為表謝意，我們想給兩位一筆酬勞，請兩位務必收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210167
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210167,
					"content": "#我感覺自己再也不怕開店了，希望以後還能與{F#妳}{M#你}們合作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210168
					],
