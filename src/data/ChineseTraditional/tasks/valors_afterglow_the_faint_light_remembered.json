			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390102,
					"content": "妳好，瑾武姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390105,
					"content": "哇啊，嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390106,
					"content": "#抱…抱歉。那個，如果{F#妳}{M#你}們要找志瓊的話…她離隊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390107,
					"content": "她去哪裡了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "我不知道…只是疏忽了一會，她就這樣不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390112,
					"content": "我和她談過了…她還是執意要走。好話壞話，或者拳頭都留不住她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390113,
					"content": "唉…希望她知道她自己在做什麼吧。希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390114,
					"content": "希望如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390115,
					"content": "對了，這件事一定要和沐寧說。讓他盡快組織一支搜救隊，盡早找到那孩子才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390116,
					"content": "我們會去的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "真是的…志瓊怎麼又不見了！我們快去地面找沐寧吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390117,
					"content": "請妳稍微安心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "她離開時情況如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390111,
					"content": "海迪夫為她做過了檢查，她的情況很不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390103,
					"content": "妳還好嗎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "#嗯？志瓊沒和{F#妳}{M#你}一起上來嗎？總務司的薦書下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390202,
					"content": "因為她繪製的地圖給輝山廳幫了大忙，總務司破格聘任她為…嗯，我看看…顧問嚮導，享受正式職位待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390203,
					"content": "恭喜志瓊啦，先前那樣四處亂跑果然不是白做工的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390204,
					"content": "她退出了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "退出了？什麼意思…？她先離開了嗎？可是千岩軍沒有和我說有人離開過層岩巨淵啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390206,
					"content": "志瓊退出了勘探隊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "啊？喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390208,
					"content": "等等！等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390209,
					"content": "#不對不對…{F#妳}{M#你}說，她，退出了勘探隊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390210,
					"content": "志瓊，退出了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390211,
					"content": "對呀！你是哪個部分聽不懂呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390212,
					"content": "…我明白了，我會即刻組織起一支搜救隊。如果她還留在層岩巨淵，我們應該還能找到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390213,
					"content": "不管她是又一次自己犯傻，還是別的什麼原因…要找到她才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390214,
					"content": "以她現在的狀態，脫離隊伍擅自行動完全是在胡鬧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390215,
					"content": "需要我幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "#抱歉，這次就不需要勞煩{F#妳}{M#你}幫忙了…我也總得派上點用場嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390233,
					"content": "如果需要我幫忙，我一定盡快趕到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "嗯嗯，我也是！不能放著後輩不管呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390235,
					"content": "我們也在路上多多注意吧，說不定什麼時候就能遇見她了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390217,
					"content": "關於志瓊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "她是個不安分的傢伙，但我們再怎麼說也算是朋友。我知道我不討人喜歡…但我可不能隨隨便便就把朋友忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390219,
					"content": "這傢伙總是在做什麼冒險家的大夢，之前受過幾次重傷…還差點把命也搭進去。後來好不容易才安分了一段時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390220,
					"content": "本來以為她已經把不切實際的美夢拋之腦後了…羅爾德、史丹利，哪有那麼好當！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390221,
					"content": "#唉…可是沒想到…或許這次我不應該推薦請{F#妳}{M#你}來探索層岩巨淵才是，不然也不至於引起志瓊的這把火…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390222,
					"content": "但她的努力並非毫無收穫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "#收穫…？{F#妳}{M#你}這樣說，未免有點太功利了。她畫下了地下大部分區域的地圖，我們很感激沒錯…但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390224,
					"content": "把「願望」這種虛無縹緲的東西，和追求它的行為，置於生命本身之上…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390225,
					"content": "我是無論如何也不能理解的，我也不能想像有人真的為此置身危險之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390232,
					"content": "所以，尋找她的事情，就請包在我身上吧…呃，我是說，包在千岩軍的搜救隊身上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390226,
					"content": "但這是她的選擇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "#選擇，選擇，選擇…什麼藉口！她是在送死，{F#妳}{M#你}沒意識到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390228,
					"content": "咳咳…抱歉，我的話說得有點太重了。但…在我們凡人無法扭轉的情勢面前…她應該更耐心點的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390229,
					"content": "再等…二三十年，也許只用十年，說不定她就能等到更加安全的礦下設備研發完成了呢？到那時候她也用不著急著勘探地下地圖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390230,
					"content": "但她一點也不願意等等…只想在自己最年輕的時候，就完成別人一輩子的成就！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390231,
					"content": "這傢伙太傻了…作為朋友，這件事我不能不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐寧"
				}
			]
		}
	]
}