			},
			"dialogs": [
				{
					"id": 722662001,
					"content": "怎麼了，還有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662002,
						722662004,
						722662007,
						722662014
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662002,
					"content": "妳的眼睛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662003
					]
				},
				{
					"id": 722662003,
					"content": "不要緊，不至於影響行動。而且說不定今後還能憑這副樣子混進海盜裡去呢。呵呵，想想就很帶勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662004,
					"content": "關於今後的打算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662005
					]
				},
				{
					"id": 722662005,
					"content": "我們會首先去剿滅試圖去海祇島投毒的愚人眾。不過似乎他們的「老師」現在已經離開稻妻了。哼，他如果敢再踏上稻妻，我一定會讓他有去無回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662006
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662006,
					"content": "#已經有人幫我把情報傳回終末番了，{F#妳}{M#你}可以放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662007,
					"content": "和妳接頭的人是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662008
					]
				},
				{
					"id": 722662008,
					"content": "#是個叫早柚的小傢伙，她跟我說{F#妳}{M#你}們之前認識。現在她已經替我把消息帶回終末番了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662009
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662009,
					"content": "真的沒問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662010
					]
				},
				{
					"id": 722662010,
					"content": "雖然她看起來不可靠，但好歹也是終末番的忍者，關鍵的事情是不會馬虎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662011
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662011,
					"content": "#哦另外她還說，如果知道是{F#妳}{M#你}們用那張暗語表，她可能會更努力一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662012
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662012,
					"content": "努力把暗語記清楚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662013
					]
				},
				{
					"id": 722662013,
					"content": "「努力不要把口水流在上面。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662014,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662015
					]
				},
				{
					"id": 722662015,
					"content": "#再見，{F#妳}{M#你}們快去離島吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662016
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662016,
					"content": "呼…百華姐，當年是妳把身為孤兒的我撿回來，讓我加入了終末番。現在的我，算不算做了一件讓妳驕傲的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
		{
			"id": 7226621,
			"completionStepIds": [
				7226618
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226618",
							"2"
						],
						"stepId": 7226618,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「玄冬林檎」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722662101,
					"content": "這是…鳴神大社的御神籤？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662102
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662102,
					"content": "嗯，這是我們用假竹籤跟蹤妳那天，得到的籤文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662103,
					"content": "雖然竹籤是假的，不過它卻是讓我們能真正瞭解柳達希卡小姐的鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662104,
					"content": "當時妳對我們說，因為我們是善良的人，所以籤文會靈驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662105,
					"content": "柳達希卡小姐，妳也是善良的人，所以這張籤文對於妳來說，也一定會靈驗的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662106,
					"content": "希望它能讓妳回憶起稻妻的時光。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662107
					]
				},
				{
					"id": 722662107,
					"content": "祝福妳能像籤文中所說那樣：「飛翔吧，漂泊吧，跨越大海，行至遠方…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662108,
					"content": "「但總有一天，妳將不再漂泊。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662109
					]
				},
				{
					"id": 722662109,
					"content": "「總有一天，妳一定能成為妳希望的模樣。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662110
					]
				},
				{
					"id": 722662110,
					"content": "「總有一天，妳一定能成為妳希望的模樣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662111
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662111,
					"content": "我所…希望的模樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662112
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662112,
					"content": "柳達希卡小姐，妳告訴所有人，妳現在並沒有人生的方向，可那並不是真的，那只是因為妳被自己的過去牽絆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662113,
					"content": "其實，妳心裡早就知道，自己到底希望成為怎樣的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662114,
					"content": "我…早就知道答案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662115
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662115,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662116,
					"content": "妳身上的巫女服——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662117
					]
				},
				{
					"id": 722662117,
					"content": "就是妳給出的答案！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662118
					]
				},
				{
					"id": 722662118,
					"content": "嗚——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662119
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662119,
					"content": "嗚…嗚嗚嗚……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662120
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662120,
					"content": "#嗚嗚嗚…是的，是的…{F#妳}{M#你}們說得沒錯！一直以來，我其實都希望成為一個真正的巫女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662121
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662121,
					"content": "每天看著那些從御神籤箱中搖出竹籤的人們，那些認真向我傾訴煩惱的人們，我都會為自己虛假的身分而感到自責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662122
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662122,
					"content": "我真的好希望，自己能夠為其他人帶來祝福！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662123
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662123,
					"content": "#嗚嗚…{NICKNAME}，派蒙，我的願望能夠實現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662124
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662124,
					"content": "我真的可以留下來嗎…我真的可以成為這樣的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662125,
						722662126
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662125,
					"content": "妳可以留下來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				},
				{
					"id": 722662127,
					"content": "百代小姐說，如果妳願意的話，可以繼續用「玄冬林檎」的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662128,
					"content": "從今以後，妳再也不用被柳達希卡的身分束縛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662129,
					"content": "#嗚嗚…謝謝{F#妳}{M#你}們…謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662130
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662130,
					"content": "我願意接受這個名字，成為真正的「玄冬林檎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662131
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662131,
					"content": "片刻後，柳達希卡終於平靜了下來。\\n然後，將她留下的錢還給了她。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722662132
					]
				},
				{
					"id": 722662132,
					"content": "#呼…二位，剛才真是不好意思，害{F#妳}{M#你}們花費了這麼大力氣來挽留我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662133
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662133,
					"content": "嘿嘿，只要結果是好的就足夠啦。妳現在感覺好些了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722662134,
					"content": "嗯，我現在已經完全清楚了自己的內心：我想要繼續留在稻妻，留在鳴神大社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662135
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662135,
					"content": "#既然我已經收下了摩拉，也請二位重新收下這枚御神籤吧。希望我的祝福，能夠一直陪伴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662136
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662136,
					"content": "二位，我馬上就會回神社，希望還能趕得上當面向百代小姐道謝。而且，也必須感謝八重大人的收留之恩才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662137
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662137,
					"content": "#{NICKNAME}，派蒙，再見了。希望今後也能經常在鳴神大社看見{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662138
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662138,
					"content": "再見，柳達希卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662139
					]
				},
				{
					"id": 722662139,
					"content": "呵呵，下次見面，就請叫我「玄冬林檎」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662126,
					"content": "妳可以成為這樣的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				}
			]
		}
	]
}