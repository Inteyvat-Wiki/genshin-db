			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660301,
					"content": "百代小姐！百代小姐！妳在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660302,
					"content": "這裡已經被愚人眾翻得亂七八糟的了，百代小姐的東西…還有材料什麼的都不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660303,
					"content": "看來這裡曝光了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660304
					]
				},
				{
					"id": 722660304,
					"content": "那百代小姐怎麼樣了，她不會被愚人眾抓走了吧？！…哈啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660305,
					"content": "說起來，從剛才進入安全屋開始，鼻子就感覺怪怪的…哈啾！空氣裡好像有什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660306,
					"content": "地面上能看到粉末的痕跡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660307
					]
				},
				{
					"id": 722660307,
					"content": "#粉末？難道說是之前那種元素粉末？{NICKNAME}，{F#妳}{M#你}快用元素視野看看，這一定是百代小姐在危機之中給我們留下的訊息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226606,
			"completionStepIds": [
				7226606
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226616",
							"3"
						],
						"stepId": 7226616,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226606",
							"2"
						],
						"stepId": 7226606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660601,
					"content": "呼…牢房裡的黴味真要命，現在可算能好好呼吸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660602
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660602,
					"content": "百代小姐，妳的眼睛怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660603,
					"content": "放心吧，這隻眼睛的視力已經恢復了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660604
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660604,
					"content": "可是，另一隻眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660605
					]
				},
				{
					"id": 722660605,
					"content": "#{F#妳}{M#你}看看{F#妳}{M#你}們兩個，愁眉苦臉像什麼樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660606
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660606,
					"content": "開心點！一隻眼睛的代價，就騙了他們所有人，還順便把愚人眾的據點給掀了，這不是超划算的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660607
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660607,
					"content": "#呵呵呵，那個「老師」可是對我的手藝深信不疑啊。{F#妳}{M#你}們要救的那個愚人眾小姑娘，今後就再也不用提心吊膽過日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660608
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660608,
					"content": "百代小姐，難道說妳是為了讓他們相信柳達希卡死了，才沒有從安全屋逃走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660609,
					"content": "#畢竟是答應了{F#妳}{M#你}們的事情。而且如果最後關頭出岔子被敵人識破，之前的努力就白費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660610
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660610,
					"content": "#再說了，我相信{F#妳}{M#你}們肯定會來救我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660611
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660611,
					"content": "我被抓這件事發生得很突然，很快還有海祇島的任務，來不及寫書面報告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660612
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660612,
					"content": "我現在要去趟鳴神大社，找個人幫忙向終末番傳話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660613
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660613,
					"content": "#{F#妳}{M#你}們也去告訴柳達希卡，說她現在已經安全了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660614
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660614,
					"content": "好，我們現在就去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
