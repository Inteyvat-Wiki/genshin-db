				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722661001,
					"content": "柳達希卡小姐！總算找到妳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661002,
					"content": "#{NICKNAME}和派蒙…{F#妳}{M#你}們怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661003
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661003,
					"content": "我們是來勸妳回去的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661004
					]
				},
				{
					"id": 722661004,
					"content": "沒錯，不僅百代小姐不要妳的錢，我們也不要！柳達希卡小姐，妳就用這些錢在稻妻重新開始生活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661005,
					"content": "#{F#妳}{M#你}們…{F#妳}{M#你}們在說什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661006
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661006,
					"content": "我之前不僅是危害稻妻的愚人眾，而且還給大家添了那麼多麻煩…不管怎麼說，我都沒有資格繼續留在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661007
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661007,
					"content": "#再說了，即使{F#妳}{M#你}們希望我留下，其他人…他們又是怎麼想的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661008
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661008,
					"content": "或許這片土地上，並沒有人真正需要我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661009
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661009,
					"content": "不是這樣的！除了我們，這裡也有人希望妳留下來！比如…比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661010,
					"content": "百代小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661011
					]
				},
				{
					"id": 722661011,
					"content": "沒錯！我們之所以能找到妳，也多虧了百代小姐的提示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661012,
					"content": "百代小姐說，她失去眼睛並不是妳的錯。這是工傷，應該終末番給錢才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661013,
					"content": "工傷什麼的就不用說了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661014
					]
				},
				{
					"id": 722661014,
					"content": "欸，為什麼？可這不是百代小姐的原話嗎，而且也很有說服力呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661015,
					"content": "但…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661016
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661016,
					"content": "啊，妳是覺得只有一個人挽留妳，還不夠有說服力是嗎？還有其他人的，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661017,
					"content": "荒谷小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661018
					]
				},
				{
					"id": 722661018,
					"content": "對對！荒谷小姐誇妳又俐落又認真。而且她還說，都想游說妳成為八重堂的正式員工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661019,
					"content": "不過我覺得，妳還是不要接受這份工作比較好。因為八重堂的員工，他們的黑眼圈都好重耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661020,
					"content": "喂，說這種話真的可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661021
					]
				},
				{
					"id": 722661021,
					"content": "怎麼不可以！柳達希卡小姐要留下來的話，擇業可是很重要的，我要為她提出寶貴的建議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661022
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661022,
					"content": "我覺得，柳達希卡小姐還是做巫女比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661023,
					"content": "#可是，雖然{F#妳}{M#你}們這麼說，鳴神大社那種地方，也不是像我這種人能夠隨便去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661024
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661024,
					"content": "這件事妳不用擔心，因為有厲害的人已經認可妳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661025,
					"content": "八重宮司。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661026
					]
				},
				{
					"id": 722661026,
					"content": "她其實早就知道妳是假的玄冬林檎，但是她也覺得妳很適合神社的工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661027,
					"content": "#而且，因為百代小姐不會再回神社工作，如果八重宮司知道妳也不回去的話…我和{NICKNAME}就慘了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661028,
					"content": "怎麼聽起來像是威脅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661029
					]
				},
				{
					"id": 722661029,
					"content": "才不是！我這是動之以情曉之以理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661030
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661030,
					"content": "而且我們很有可能真的會被神子用可怕的辦法折磨呀，妳就一點都不擔心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661031,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661032
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661032,
					"content": "妳終於笑了！所以妳同意不走了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661033,
					"content": "#派蒙，{NICKNAME}，謝謝{F#妳}{M#你}們，也謝謝那些願意接納我的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661034
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661034,
					"content": "只是…我從小就在進行間諜的各種訓練，來到稻妻之前，從沒有體驗過一般人的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661035
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661035,
					"content": "身為「雪奈茨芙娜」的我，直到現在，也不知道哪裡才是自己的歸宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661036
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661036,
					"content": "也不知道來自黑暗的自己，是否真的擁有回到陽光下的權利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661037
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661037,
					"content": "柳達希卡小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661038,
					"content": "所以，這個時候離開稻妻，去提瓦特大陸其他地方遊歷一下，對我來說或許也是不錯的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661039
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661039,
					"content": "至少，我也可以好好想一想，自己到底希望成為怎樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661040
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661040,
					"content": "可是，柳達希卡小姐妳明明這麼喜歡稻妻的！就這樣離開的話，妳不會感到不捨嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661041
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661041,
					"content": "我確實有些不捨，不過…這也是沒辦法的事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661042
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661042,
					"content": "唔唔唔，怎麼會這樣！柳達希卡小姐明明已經非常動搖了，可她就是不肯承認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661043
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661043,
					"content": "唉，感覺即使再勸說她留下，也很難有效果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661044,
					"content": "或許可以反其道而行之。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661045
					]
				},
				{
					"id": 722661045,
					"content": "咦，這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661046
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661046,
					"content": "先打消她的防備。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661047
					]
				},
				{
					"id": 722661047,
					"content": "再讓她正視自己的內心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661048
					]
				},
				{
					"id": 722661048,
					"content": "有道理。柳達希卡小姐並不是沒有夢想，而是因為她擔心自己沒有獲得幸福的資格，所以不敢正視自己的內心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661049
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661049,
					"content": "我想起來了！我們身上有一件東西，正適合撬開柳達希卡小姐的心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661050
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661050,
					"content": "這次一定能成功的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
