				"points": []
			},
			"dialogs": [
				{
					"id": 722661201,
					"content": "#咳咳…我已經說過了，跟{F#妳}{M#你}們這群垃圾沒什麼好說的…還不如趁早給我個痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661202
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661202,
					"content": "百代小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661203,
					"content": "我們來救妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661204
					]
				},
				{
					"id": 722661204,
					"content": "#這個聲音…是派蒙和{NICKNAME}？呵，真沒想到{F#妳}{M#你}們能找到這來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661205
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661205,
					"content": "百代小姐，這種時候妳就不要嘴硬了。妳既然留下了元素粉末，就是相信我們一定會來救妳的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661206,
					"content": "#哼…那{F#妳}{M#你}們想聽我說什麼，誇{F#妳}{M#你}們幹得漂亮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661207
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661207,
					"content": "嘻嘻嘻，不過要誇我們，也還是等到我們一起離開這裡之後吧。我們先幫妳把門打開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661208,
					"content": "門被鎖住了，鑰匙現在在他們老大身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661209
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661209,
					"content": "之前在拷問我的時候，他們好像突然得知了什麼事，就匆匆離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661210
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661210,
					"content": "現在他們應該正在最上層的房間裡密謀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661211
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661211,
					"content": "他們談話的時候應該會把房門反鎖上，那就要用很特殊的勾玉才能從外面打開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661212
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661212,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661213
					]
				},
				{
					"id": 722661213,
					"content": "#嗯，拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
