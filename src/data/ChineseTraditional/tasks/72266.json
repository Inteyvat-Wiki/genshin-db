			},
			"dialogs": [
				{
					"id": 722660801,
					"content": "#{F#妳}{M#你}們找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660802
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660802,
					"content": "妳好，我們想打聽一個人。這幾天在這裡做校對的那位小姐她去了哪裡？我們是她的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660803,
					"content": "#哦，{F#妳}{M#你}們就是{NICKNAME}和派蒙吧，遠山小姐和我說過{F#妳}{M#你}們會來找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660804
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660804,
					"content": "（遠山小姐？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660805,
					"content": "（應該是柳達希卡小姐的假名。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660806
					]
				},
				{
					"id": 722660806,
					"content": "昨天她告訴我，因為家裡突然有急事，她不能繼續進行校對工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660807
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660807,
					"content": "太可惜了！像她那樣又俐落又認真的校對員可不多見，我還想游說她不要做兼職了，來當我們八重堂的正式員工呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660808
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660808,
					"content": "#對了，這些東西是她走之前讓我轉交給{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660809
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660809,
					"content": "她給我們留了封信！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660810,
					"content": "柳達希卡小姐…她走了。她還說，要把這些錢給百代小姐和我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660811,
					"content": "這樣真的好嗎…我們去問問百代小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226609,
			"completionStepIds": [
				7226609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226608",
							"3"
						],
						"stepId": 7226608,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226609",
							"2"
						],
						"stepId": 7226609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660901,
					"content": "#{F#妳}{M#你}們來啦。怎麼樣？那個愚人眾小姑娘應該已經放心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660902
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660902,
					"content": "把柳達希卡留下的信和錢交給百代。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722660903
					]
				},
				{
					"id": 722660903,
					"content": "啊？她留下這些東西之後就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660904
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660904,
					"content": "現在看來是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660905,
					"content": "嘖，真是的，什麼「都是我的過錯，害得百代小姐失去了眼睛」。一派胡言，我的眼睛又不是她弄瞎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660906
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660906,
					"content": "真要說的話，這算是工傷？要給錢也應該是終末番給才對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660907
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660907,
					"content": "#總之，我不要她的錢。這些錢，{F#妳}{M#你}們愛怎麼辦就怎麼辦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660908
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660908,
					"content": "就算妳這樣說，這些錢我也不知道該不該要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660909,
					"content": "派蒙竟然會糾結錢的問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660910
					]
				},
				{
					"id": 722660910,
					"content": "喂，不要說得我好像是個見錢眼開的傢伙一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660911,
					"content": "再說了，離開稻妻之後，柳達希卡小姐會去哪裡？她能找到屬於自己的生活和快樂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660912,
					"content": "哦對了，我想起來一件事。我現在這個樣子，是不可能繼續回神社了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660913
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660913,
					"content": "剛才宮司大人跟我說，她覺得之前那個冒牌貨就挺不錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660914
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660914,
					"content": "#呵呵，要是宮司大人知道是{F#妳}{M#你}們把她給弄沒了，應該會讓{F#妳}{M#你}們好看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660915
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660915,
					"content": "欸，怎麼就變成我們的責任了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660916,
					"content": "#怎麼不是{F#妳}{M#你}們的責任？當然是因為{F#妳}{M#你}們沒攔住她，才讓她從稻妻跑了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660917
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660917,
					"content": "啊，我明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660918,
					"content": "謝謝妳，百代小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660919
					]
				},
				{
					"id": 722660919,
					"content": "#她應該會從離島想辦法離開稻妻，{F#妳}{M#你}們去那裡找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660920
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660920,
					"content": "#等{F#妳}{M#你}把她帶回來，如果她願意的話，就繼續用「玄冬林檎」這個名字好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660921
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660921,
					"content": "雖然是我當時隨便給自己取的假名，但沒想到和她的身分還挺契合的，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660922
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660922,
					"content": "#快去吧，她的事就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660923
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660923,
					"content": "#{NICKNAME}，我們快去離島的港口，把柳達希卡小姐追回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
