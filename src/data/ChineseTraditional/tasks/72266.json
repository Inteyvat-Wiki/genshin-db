				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722661801,
					"content": "#謝謝{F#妳}{M#你}們的好意，不過…我去意已決，就不用再多費口舌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661802
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661802,
					"content": "妳誤會了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661803
					]
				},
				{
					"id": 722661803,
					"content": "對，我們並不是來勸妳的。既然妳要離開稻妻，至少在臨別之際，我們想送給妳一些能代表祝福的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722661804,
					"content": "#咦，{F#妳}{M#你}們要給我什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				}
			]
		},
		{
			"id": 7226620,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
