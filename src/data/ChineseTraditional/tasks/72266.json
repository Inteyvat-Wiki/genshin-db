			},
			"dialogs": [
				{
					"id": 722660701,
					"content": "柳達希卡小姐，我們回來啦！事情全擺平啦，妳現在已經安全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660702,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660703,
					"content": "柳達希卡小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722660704,
					"content": "她不在裡面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660705
					]
				},
				{
					"id": 722660705,
					"content": "奇怪，她到哪裡去了？我們去問問八重堂的員工吧，說不定他們知道柳達希卡小姐的去向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
