			"dialogs": [
				{
					"id": 200160101,
					"content": "餐品外送訂單",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160102,
					"content": "#旅行者！{F#妳}{M#你}來的正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160103,
					"content": "#抱歉，雖然{F#妳}{M#你}餓著肚子，但是能不能請{F#妳}{M#你}幫我個忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160104,
					"content": "最近的送餐訂單越來越多，我通常是先把訂單按照地區分好，然後再標好是誰訂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160105,
					"content": "但是這份<color=#00E1FFFF>嘟嘟蓮海鮮羹</color>的訂餐人標籤被我弄丟了，只知道訂餐的人在清泉鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160106,
					"content": "#{F#妳}{M#你}能幫我把這份<color=#00E1FFFF>嘟嘟蓮海鮮羹</color>送去清泉鎮，再找找是誰訂的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160107,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "#等{F#妳}{M#你}回來的時候，會有一頓大餐做回報的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160109,
					"content": "拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160110,
					"content": "太餓了，我只是來吃飯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "#等{F#妳}{M#你}幫完我的忙之後，我，我就請{F#妳}{M#你}吃獵鹿人特製料理，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
