					"nextDialogs": [
						200160204
					]
				},
				{
					"id": 200160204,
					"content": "我看看…沒錯，太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160205,
					"content": "#還有，這份<color=#00E1FFFF>蟹黃火腿焗時蔬</color>給{F#妳}{M#你}，剛剛做好的，趕快趁熱吃了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
