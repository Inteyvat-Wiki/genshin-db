							-136.96,
							453.037,
							10016.94
						],
						"pointId": 8608
					},
					{
						"sceneId": 3,
						"position": [
							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "沒想到綠寶把我們帶到這裡。看起來和我們遇到玻娜的那個地方一樣，都是座奇怪的要塞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330102,
					"content": "看，這裡也有幅一模一樣的壁畫，唔…不過這個上面倒是沒有被塗抹的痕跡，是因為這裡太高了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得這上面畫的不會就是剛才玻娜說的那個蛇王吧？一看就不是很好惹的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330104,
					"content": "嗯嗯，這傢伙就是蛇王奧奇坎哦。傳說他為了建造天蛇船殘酷地壓迫民眾，直到最後引來了深淵，落得個身死國滅的下場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330105,
					"content": "當然這也只是傳說啦。畢竟就連那個蛇王最後到底怎麼樣了，部族裡的敘事人也有一大堆不同的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330106,
					"content": "說不定他現在還徘徊在那艘天蛇船裡以財寶為食呢！又或者一直阻礙我們的邪龍，其實就是他的怨靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330107,
					"content": "咕嘰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "「綠松石」"
				},
				{
					"id": 751330108,
					"content": "哇，好可怕。妳不要說這種嚇人的話了啦，綠寶都被妳嚇到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330109,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#自從打敗了那條壞龍，{REALNAME[ID(2)|SHOWHOST(true)]}就一直躍躍欲試的樣子，難不成是在偷偷和綠寶比賽冒險什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330111,
					"content": "話說回來，我們要找的那個祭壇究竟在哪裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330112,
					"content": "如果綠寶所指的方向沒錯的話，就是在這下面…欸？我以為會是在更高的地方說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330113,
					"content": "難道是搞錯什麼了嗎？源火祭壇應該不會藏在山體的中心吧…不然豈不是要把整座山都吹塌了才能把我們送到天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330114,
					"content": "難道是有什麼特殊的傳送手段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "呃…剛才在下面還說得信誓旦旦的，這下麻煩了。而且我們又聽不懂綠寶說話，也不知道牠到底是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330116,
					"content": "咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "「綠松石」"
				},
				{
					"id": 751330117,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你有什麼頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330119,
					"content": "我知道了，小派蒙，牠的意思是說，只是一板一眼地只依靠邏輯的話，冒險是沒辦法繼續的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330120,
					"content": "又是妳亂編的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330121,
					"content": "總之不管下面是什麼，我覺得都應該先去一探究竟，這也是冒險的一部分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#唔…沒想到{REALNAME[ID(2)|SHOWHOST(true)]}這麼有精神，那我們先調查看看要怎麼樣下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
