			"dialogs": [
				{
					"id": 411350501,
					"content": "#旅行者，{F#妳}{M#你}見到葛蘿麗了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350502,
					"content": "葛蘿麗的情況怎麼樣？她還好嗎？沒受傷吧？哦對…她應該一直待在城裡，不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350503,
					"content": "這是她給你的蒲公英籽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "呃？蒲公英籽…確實是她的作風，唉，葛蘿麗…希望她別生我的氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350505,
					"content": "#謝謝{F#妳}{M#你}幫我去跑這麼一趟，我得給{F#妳}{M#你}點報酬才行，這些東西請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350506,
					"content": "唉，要是大團長能回來的話，那就什麼問題都沒有了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				}
			]
