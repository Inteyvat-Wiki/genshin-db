			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛蘿麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "希望古德溫平安無事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350402,
					"content": "古德溫拜託我來看看妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "古德溫？您，您知道他在哪嗎？我很久都沒他的消息了，一直在擔心他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350404,
					"content": "他還在很遠的地方執行任務。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "是…這樣嗎？那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350406,
					"content": "如果沒有這些隕石，我都想要去騎士團問問他的下落了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350407,
					"content": "我一直待在城裡，所以很安全。但他應該會去野外執行任務吧，如果全世界的各種地方都有隕石墜落的話，那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350408,
					"content": "唉，希望他平安無事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350409,
					"content": "他一定會平安無事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "謝謝您，這樣的話就最好了。對了，如果您願意的話，能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350411,
					"content": "我找芙蘿拉小姐買了一份蒲公英籽，本來想找人幫我去高處播撒…讓風把它們帶給古德溫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350412,
					"content": "但現在城裡的情況您也看到了，一時間我也找不到人幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350413,
					"content": "現在正好您來了，您願意幫我把這些蒲公英籽帶給古德溫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350414,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "謝謝您，他現在一定在很遠的地方吧，畢竟他是跟著那位大團長去執行任務了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 411350416,
					"content": "請您把這份蒲公英籽帶給他，告訴他我很好，然後…讓他也注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛蘿麗"
				}
			]
		},
		{
			"id": 4113505,
			"completionStepIds": [
				4113507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
