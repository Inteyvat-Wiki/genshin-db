			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古德溫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "你們把那些魔物都清理掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350302,
					"content": "已經清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "#感謝{F#妳}{M#你}，旅行者。這下那些魔物應該暫時形不成威脅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350304,
					"content": "#{F#妳}{M#你}也快點回城裡去吧，這種情況還讓{F#妳}{M#你}在野外跑，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350305,
					"content": "#呃，然後…{F#妳}{M#你}回去城裡的時候，能不能幫我留意一件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350306,
					"content": "很簡單的！就，就幫我留意一下就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350307,
					"content": "到底是什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "#那個，{F#妳}{M#你}回去城裡之後，能不能幫我去看看葛蘿麗的情況？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350309,
					"content": "她應該一直待在城裡，不會有什麼危險，但我就是放心不下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350310,
					"content": "#拜託{F#妳}{M#你}，幫我去看看她的情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350311,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "#謝謝{F#妳}{M#你}，旅行者。對了，請{F#妳}{M#你}…別告訴葛蘿麗我在這，就…就說我還在很遠的地方執行任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350313,
					"content": "#抱歉，拜託{F#妳}{M#你}了，請一定要對她這麼說，我有我的苦衷，拜託{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				}
			]
		},
		{
			"id": 4113504,
			"completionStepIds": [
				4113506
			],
