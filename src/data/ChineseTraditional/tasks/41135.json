					"古德溫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "大團長到底在哪啊…出了這麼大的事，也不知道他收沒收到消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350202,
					"content": "不過，就算他收到了消息，應該一時半會也趕不回來，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
