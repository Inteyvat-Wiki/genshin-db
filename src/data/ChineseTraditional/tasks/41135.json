			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古德溫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "不知道葛蘿麗怎樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "#{F#妳}{M#你}…是旅行者啊，現在野外很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350104,
					"content": "#如果{F#妳}{M#你}想找個安全的地方避難，就快點回蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350105,
					"content": "你不進城嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "我…我暫時，就不回去了，畢竟我也是一名西風騎士…這個時候可不能退縮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350107,
					"content": "雖然因為一些原因，我不能回蒙德城裡幫忙，但是我也能在野外做些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350108,
					"content": "隕石落下了之後，很多魔物被隕石影響，變得格外兇暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350109,
					"content": "如果放著不管的話，一定會釀成大禍，我正準備去把它們給清理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350110,
					"content": "你一個人可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "呃，雖然那些怪物的數量有些多…但只要小心應對，我應該沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350112,
					"content": "但我一個人去清理，不知道要清理到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350113,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能幫我去清理一些怪物的營地嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350114,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "#那就拜託{F#妳}{M#你}了，實在是幫大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350116,
					"content": "為什麼不去找騎士團求助？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "#找騎士團求助…呃，這個嘛，真的不行…我有我自己的苦衷，{F#妳}{M#你}就別追問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 411350118,
					"content": "#請{F#妳}{M#你}幫幫我吧，清理掉那些怪物營地，也算是給騎士團幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				}
			]
		},
		{
