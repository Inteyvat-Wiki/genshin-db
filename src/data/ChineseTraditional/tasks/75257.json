			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊斯特莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "聽起來滿有趣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "太好了！那麼幾位客人，誰先來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570203,
					"content": "本人建議，女士優先。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570204,
					"content": "沒意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "韋涅季克特"
				},
				{
					"id": 752570205,
					"content": "哎呀，多麼紳士的小夥子啊，我就想和你們這種年輕人合照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "蘇瑪"
				},
				{
					"id": 752570206,
					"content": "欸？也…也不是不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570207,
					"content": "咳咳，沒意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "韋涅季克特"
				},
				{
					"id": 752570208,
					"content": "嗯…不，還不夠，再來三個小夥子吧，應該可以辦到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "蘇瑪"
				},
				{
					"id": 752570209,
					"content": "唔…最好還能來點煙花。我年輕的時候，最喜歡那樣的氛圍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "蘇瑪"
				},
				{
					"id": 752570210,
					"content": "沒問題，那我們開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
