			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "上一場拍得很好，下面是這位愚人眾的大哥，您想拍點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570302,
					"content": "請把我拍成神槍手的樣子，一看就是百發百中的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "韋涅季克特"
				},
				{
					"id": 752570303,
					"content": "這樣我就不用為連隊的射擊比賽排名倒數而煩惱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "韋涅季克特"
				},
				{
					"id": 752570304,
					"content": "沒問題，那我們開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
