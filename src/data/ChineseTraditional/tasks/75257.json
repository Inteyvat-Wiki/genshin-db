			"dialogs": [
				{
					"id": 752570101,
					"content": "年輕人啊，這場地不是好好的嗎？為什麼不能營業？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "蘇瑪"
				},
				{
					"id": 752570102,
					"content": "真抱歉，客人，本設施的造景助手昨晚喝多了，今天沒辦法來上班，請明天再來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570103,
					"content": "老婆子我年紀大了，明天再走這麼遠的路過來可能吃不消囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "蘇瑪"
				},
				{
					"id": 752570104,
					"content": "沒錯，大家明天也有別的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570105,
					"content": "對不起，我們「夏日留影角」的特色就是可以為客人搭建心儀的留影背景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570106,
					"content": "但現在造景助手不在，實在無法繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570107,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "#欸？{F#妳}{M#你}們兩位願意來幫忙嗎？我真的很需要。內容也不複雜，只要按照各位客人的要求佈置留影的背景就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
