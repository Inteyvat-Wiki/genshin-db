					}
				]
			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "#哎呀，總算是忙完了。兩位客人，多虧有{F#妳}{M#你}們幫忙，不然我可能要被投訴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570702,
					"content": "不用客氣，嘿嘿，我們可是最熱心的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#冒險家嗎？那不如我來幫{F#妳}{M#你}們留一張影吧？把{F#妳}{M#你}們熱心的身姿記錄下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570704,
					"content": "來，笑一笑！悠悠納塔，悠悠夏天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570705,
					"content": "#謝謝{F#妳}{M#你}們，這些也請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
			]
		},
