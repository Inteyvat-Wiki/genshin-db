			"dialogs": [
				{
					"id": 752570801,
					"content": "上一場拍得很好，最後是這位翩翩公子，您想拍點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "伊斯特莉"
				},
				{
					"id": 752570802,
					"content": "說得不錯，本人出生至今，向來將儀態與氣質放在人生的首要位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570803,
					"content": "人無儀態，則不優雅；無氣質，則不富貴。懂我的要求嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "因提"
				},
				{
					"id": 752570804,
					"content": "唔…讓我思考一下…嗯，我們開始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯特莉"
				}
