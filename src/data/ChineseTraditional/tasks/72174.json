			"trigger": {
				"objectNames": [
					"「船工」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "小河這邊唉…銀的柏樹唉，銀的艾草地喲，銀的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740102,
					"content": "請問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "喲…是客人來了？要登船嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740105,
					"content": "唉呀呀，仔細一看卻是外人…可不行呢，可不行喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740106,
					"content": "不行…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "#往月亮去的銀璨璨的船呀，不是為{F#妳}{M#你}預備的喲…不要把腳踏上來，不要弄髒我的帆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740109,
					"content": "唉呀呀…霧散久矣，霧散久矣…誰還沒有上船呀…金色屋子的女主人會生氣的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740110,
					"content": "船…？在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "呵呵…銀璨璨的船呀，太陽與山之子孫的船呀，大家要回家了，月亮上金燦燦大屋喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740112,
					"content": "可是呀可是…有的孩子迷了路，到現在還沒有上船…女主人會生氣的，可了不得喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740113,
					"content": "你需要幫助嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "快來登船呀，快來登船…不要再迷途了呀，不要再留戀喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740114,
					"content": "你在聽我說話嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "你在說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "你是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
