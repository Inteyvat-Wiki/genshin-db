			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫濟米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "太好了，終於把貨都賣完了，果然薄利多銷的策略是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450602,
					"content": "照理來說我也該啟程回至冬了，只是現在頂多也只賺回了路費…我光腳出來，可不想再光腳回去啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450603,
					"content": "#哎，總之多謝{F#妳}{M#你}照顧生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
