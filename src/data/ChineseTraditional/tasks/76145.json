				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫濟米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "哎喲，緣分真是奇妙，居然在這又碰到了。怎麼樣，要看看嗎？這次有不少好東西哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450709,
					"content": "看看有什麼好東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "嘿，都是愚人眾淘汰下來的老舊裝備，在別處可買不到，有想要的就一起拿走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450702,
					"content": "你不是回至冬了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "不瞞您說，我的家在新基捷城，全家都是採礦工人。他們啊，一個個比矮靈還頑固，我說要出門經商，他們堅決不同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450704,
					"content": "於是出門前我誇下海口，要賺一大筆錢回去…結果沒想到，到頭來會差點連旅費都湊不齊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450705,
					"content": "現在賺大錢是不可能了，至少最後讓我能賺點小錢吧，起碼回去也有個交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450706,
					"content": "你怎麼在愚人眾的地盤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "您說什麼？我可是遵紀守法的至冬公民，看到愚人眾就跟回家了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450708,
					"content": "#現在我這裡的貨都是愚人眾淘汰下來的老舊裝備，是他們特別託我處理的。{F#妳}{M#你}在別處可買不到，獨此一家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450711,
					"content": "不用了，我先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "那可真是遺憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫濟米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "#真是太感謝了，多虧了{F#妳}{M#你}，我可以不用那麼灰頭土臉地回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450902,
					"content": "#這次真的要告別了。{F#妳}{M#你}買了我這麼多東西，我們怎麼說也算是朋友了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "庫濟米奇"
				},
				{
