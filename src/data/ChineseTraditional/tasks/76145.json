			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫濟米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "哎呀呀，沒想到真的賣完了，看來我還是有一些商業眼光的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450302,
					"content": "接下來我會拜託執燈人送我穿過噩影澤地，之後再往北應該就是通途了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450303,
					"content": "說不定回去的路上還能碰到什麼商機呢…那麼就此別過吧，我們有緣再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
