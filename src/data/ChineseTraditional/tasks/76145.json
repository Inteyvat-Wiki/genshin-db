			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫濟米奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "這麼巧，我們又見面了。您要買點什麼嗎？新貨滯銷，幫幫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450407,
					"content": "讓我看看有什麼好貨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "都是一些當地的特產，放心，一定算您最優惠的價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450402,
					"content": "你怎麼又進貨了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "哎，怎麼說呢。商業嘛，正所謂該出手時就出手…我在皮拉米達城碰到了個好機會，一批急著出手的貨物，給了我優惠價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450404,
					"content": "我當時一激動，就忘了我這次是要回家了，全把它們買下來。結果就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450405,
					"content": "你猜他為什麼急著出手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "哎，您就別挖苦我了，不然您看看有什麼用得上的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				},
				{
					"id": 761450409,
					"content": "抱歉，我先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "不再看看嗎？一定有您需要的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫濟米奇"
				}
			]
		},
