			"dialogs": [
				{
					"id": 737060101,
					"content": "各位，好消息來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060102
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060102,
					"content": "我們為「穩健知行」機構打下的基礎，已經得到了各學院權威學者們的高度認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060103
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060103,
					"content": "接下來，教令院派出的專門職工會正式入場，按照我們制定的標準和規則，繼續將這個機構運轉下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060104
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060104,
					"content": "這段時間實在有勞各位了，萬分感謝各位的支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060105
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060105,
					"content": "好耶！努力工作的成果得到了認可，柯萊大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060106,
					"content": "這次的交接工作也都讓柯萊全包了，真不錯啊真不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060107
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060107,
					"content": "希望新入學的年輕人們都能學學妳的作風，踏踏實實，把每件小事都幹得無可挑剔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060108
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060108,
					"content": "而不能只想著論文裡的宏大目標，離開了書面推論就兩眼一黑、兩手一攤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060109
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060109,
					"content": "我、我還是非常緊張的！在各個學院的代表之間跑來跑去、溝通協調，也有點暈頭轉向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060110
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060110,
					"content": "#當然，特別需要感謝{NICKNAME}和派蒙，{M#他們}{F#她們}幫我們完善了最關鍵的規則，提供了最寶貴的指導意見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060111,
						737060112
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060111,
					"content": "還可以還可以！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				},
				{
					"id": 737060113,
					"content": "我們對這些工作都已經習以為常了，就像是…和大家一起來了場特別的野營！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060114,
					"content": "期間偶爾穿插一些解謎鍛煉和健身活動，還滿有趣的！又有趣味又幫助消化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060115,
					"content": "消化…欸…餓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060116,
					"content": "既然工作萬事大吉了，要不要一起吃頓飯，就當是慶祝了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060117,
					"content": "派蒙還真的說到了點上了——犒勞大家的大餐，我和坎蒂絲已經準備好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060118
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060118,
					"content": "幾位，這邊請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060119
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 737060119,
					"content": "是大餐！慶功宴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060120,
					"content": "來得正好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060121,
					"content": "嗚，好久沒吃這麼豐盛的須彌菜了，怎麼感覺我…口味一換，肚量翻倍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060122,
						737060123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060122,
					"content": "那我們多來回走走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060124,
					"content": "哼哼，可別小看我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060125,
					"content": "#當然，我也不會那麼任性，還是要考慮{F#妳}{M#你}的錢包的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060126,
					"content": "嗯…嗯！好久沒仔細品嚐過沙漠地帶的料理了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060127
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060127,
					"content": "記憶裡的印象，居然被打破了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060128
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060128,
					"content": "原來我以前在沙漠裡嚐到的那些菜式…都是應付了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060129
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060129,
					"content": "多謝您的認可，琺露珊女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060130
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 737060130,
					"content": "如果來訪阿如村的學者們都像您這樣彬彬有禮，我們每次都會拿出最豐盛的餐食，盡力招待他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060131
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 737060131,
					"content": "說到這個，安柏小姐更是從遙遠的蒙德來的…妳有什麼想參觀的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060132
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060132,
					"content": "嘿，我都想好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060133
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060133,
					"content": "聽說在奧摩斯港西北，有一片長滿參天大樹的森林，每棵大樹的樹幹都比「獵鹿人」那棟房子的地基還寬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060134,
					"content": "我很好奇！那裡的景色看起來究竟怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060135
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060135,
					"content": "如果爬到樹頂從上面往下跳，再用風之翼滑翔，在巨樹間穿梭，一定很有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060136
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060136,
					"content": "那，我準備一些濕潤的糕點、糰子之類的零食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060137
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060137,
					"content": "高處風大，不適合碎屑太多的食物。水袋也要選加厚款，防止一摔就壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060138
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060138,
					"content": "哦！軟軟彈牙的糰子的確不錯，柯萊很細心嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737060139,
					"content": "沙漠這邊的話，我對巨大的遺蹟非常感興趣，譬如那座超厲害的沙漏型巨大建築！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060140
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060140,
					"content": "當然，說不定須彌這邊有保護遺蹟的規則，我不會貿然闖進去，遠遠觀察一番就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060141
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060141,
					"content": "如果打擾到沉睡在裡面的主人，也有點不講禮貌，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060142
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060142,
					"content": "真是寶貴的守規矩意識，安柏小姐，實在令我欣慰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060143
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 737060143,
					"content": "嗯，以安柏平時習慣的環境，在列柱沙原長期旅行的話，肯定會覺得乾燥難耐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060144
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060144,
					"content": "所以必須準備一些保濕的藥膏，還有滋潤皮膚的植物精油…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060145,
						737060146
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737060145,
					"content": "連面部護理都考慮到了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060147,
					"content": "相比早有預期的旅行計畫，這次參與「穩健知行」機構的建設，更讓我驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060148
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060148,
					"content": "託柯萊的福，認識了各位新朋友，我特別開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060149
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060149,
					"content": "#等到{F#妳}{M#你}們有空，也請來蒙德玩玩哦。我保證帶{F#妳}{M#你}們吃個痛快，玩個盡興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060150
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737060150,
					"content": "那我可就太期待了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060151
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060151,
					"content": "去楓丹的時候，我就嚐到了進口的蒲公英酒，那種芳香和清甜實在讓人沉醉，完全感受不到一點苦澀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060152
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060152,
					"content": "不過，畢竟被封在容器裡飄洋過海，口感還是受了點影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060153
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060153,
					"content": "到了蒙德就能喝到最正宗、最純正的蒲公英酒了，我要暢飲好幾桶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060154
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060154,
					"content": "偶爾也喝點酒以外的東西吧？譬如，孩子們送妳的赤念果荊棘粉沖泡的茶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060155
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 737060155,
					"content": "啊哈…啊哈哈，坎蒂絲…酌情，酌情嚐一點而已，桶也可以是…三五個杯子那麼大的小木桶嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060156
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060156,
					"content": "如果真的去蒙德玩了，我一定會幫妳帶紀念品回來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060157
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737060157,
					"content": "我倒是聽說，西風騎士團圖書館的藏書有上萬卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060158
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060158,
					"content": "搞不好有些機關相關的典籍，會從不同的角度分析工程問題，值得一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060159
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737060159,
