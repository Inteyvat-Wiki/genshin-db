			"dialogs": [
				{
					"id": 110020701,
					"content": "總覺得還缺點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020702,
					"content": "什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "嗯，少一種「噼咔」的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020705,
					"content": "這麼一說確實不夠「噼咔」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020706,
					"content": "「噼咔」？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "哼哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020709,
					"content": "布洛克雖然守規矩了點，但還是有很強的實力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020710,
					"content": "她一定會使用最得意的食材，想要取勝，就需要一道令人耳目一新的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020711,
					"content": "比如涼拌海獸肉啊，乾煸清心花啊，史萊姆滑野蘑菇之類的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020712,
					"content": "史、史萊姆滑野蘑菇？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110020713,
					"content": "哈哈，我知道聽起來有點奇怪，但味道絕對是一級棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020714,
					"content": "#有機會做給{F#妳}{M#你}們嚐嚐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020715,
					"content": "好想吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "#嘿嘿，味道不會讓{F#妳}{M#你}失望的，就是賣相稍微有一點點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020719,
					"content": "先不說這個了，我想起來上次有個地方我還沒去過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020720,
					"content": "我的直覺告訴我會有什麼好東西，我們去找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020717,
					"content": "不、不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "欸？明明就很好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020707,
					"content": "為什麼派蒙能明白？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "不夠印象深刻嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
		}
	]
