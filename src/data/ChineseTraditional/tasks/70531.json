				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "前輩，請稍等一下！您也是來參加「召喚王大獎賽」的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310102,
					"content": "如果您有空的話，我想向您介紹一下我們冒險家協會正在舉辦的「諸景巡禮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310103,
					"content": "我，我是有空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "謝謝前輩！我就簡單為您介紹一下本次協會所舉辦的「諸景巡禮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310106,
					"content": "簡單來說，我們冒險家協會在蒙德的各處放置了許多「巡景臺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310107,
					"content": "您要做的，就是找到這些「巡景臺」，並且用「巡景臺」上的印章，在我們發給您的「巡景手冊」上蓋紀念章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310108,
					"content": "只要找到所有「巡景臺」，並且集齊所有的紀念章…您就算是完成挑戰啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310109,
					"content": "這活動…還真是有冒險家協會的風格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "嘿嘿…放置那些「巡景臺」的位置，我們可是特地設計過的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310111,
					"content": "雖然…有些「巡景臺」的位置有點偏僻，說不定周圍還有魔物出現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310112,
					"content": "但我覺得，以前輩的身手，對付那些魔物肯定也是輕輕鬆鬆啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310113,
					"content": "那麼，我馬上把「巡景手冊」給您，祝前輩玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧妮"
				},
				{
					"id": 705310104,
					"content": "妳，妳先說說看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}