				{
					"id": 205030501,
					"content": "幹嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030502,
					"content": "採到鐵塊了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "哦對，好像有這麼回事，我都忙忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030505,
					"content": "還行吧，看這成色，不是不能用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030506,
					"content": "想委託鍛造",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030503,
					"content": "你之前讓我去採鐵塊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
