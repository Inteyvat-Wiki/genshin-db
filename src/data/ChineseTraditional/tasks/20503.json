			"dialogs": [
				{
					"id": 205030201,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030202,
					"content": "想看看武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "都在那邊，自己挑吧。想要拿得更順手的，我也能定做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030207,
					"content": "原來還能定做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205030208,
					"content": "當然。販賣，定做，精煉，都是鐵匠鋪的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030209,
					"content": "#只要{F#妳}{M#你}有礦石就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030210,
					"content": "在哪裡能找到礦石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "哪裡都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030214,
					"content": "#這樣吧，看{F#妳}{M#你}迷迷糊糊的，我把附近鐵塊比較多的地方告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030215,
					"content": "#如果{F#妳}{M#你}能把鐵塊帶回來，我就幫{F#妳}{M#你}鍛造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030216,
					"content": "好的，謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "用不著。那我繼續忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030212,
					"content": "你這裡賣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "找別人去，我自己都不夠用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030204,
					"content": "想幫派蒙看看武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "沒聽說這回事啊！要讓我打頭陣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205030206,
					"content": "這麼小一隻，嗯，那要定做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "瓦格納"
				}
			]
		},
