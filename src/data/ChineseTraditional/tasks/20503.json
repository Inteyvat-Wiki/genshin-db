				{
					"id": 205030601,
					"content": "以後找到了礦石，都可以來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030602,
					"content": "當然，最好是在我不忙的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030603,
					"content": "感覺你心情不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "打鐵要全神貫注，我不喜歡和客人閒聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030605,
					"content": "手藝好，生意就好，做其他的都是投機取巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "瓦格納"
				},
				{
					"id": 205030606,
					"content": "沒事的話，我就繼續忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格納"
				}
			]
