			"trigger": {
				"objectNames": [
					"湯雯",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "啊…好餓…好難受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "我、我也不太清楚…總之就是整個人都沒什麼精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250104,
					"content": "#大概就是昨天晚上，我把{F#妳}{M#你}做的那份美食帶回家好好品嚐了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250105,
					"content": "雖然那道菜的口味確實是…「另闢蹊徑」了些，但多少還是能填飽肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250106,
					"content": "之後我就打算睡個好覺，今天好好工作，結果…結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250107,
					"content": "每次我要睡著的時候，那道菜的微妙氣味就突然從胃裡冒上來！搞得我瞬間就清醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250108,
					"content": "然後就是這樣的循環，一直半睡半醒地折磨到天亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250109,
					"content": "如果光是睡少一些，倒還不是什麼大事，之前偶爾也會遇到加班的情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250110,
					"content": "重點在今天！本以為起來後，吃點東西就沒事了，可沒想到一吃東西，居然滿嘴都還是那道菜的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250111,
					"content": "那道菜有這麼大威力嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "唉，不管怎麼樣，我現在感覺…應該只有口味獨特的美食，才能沖刷掉那股奇怪的氣息了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250113,
					"content": "口味獨特的美食？不如我們去問問其他人，什麼才是口味獨特的美食吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250114,
					"content": "然後再幫湯雯小姐做一份…說不定就能解決她的困擾了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250115,
					"content": "#真的嗎？真是太好了，實在感謝{F#妳}{M#你}們！如果、如果方便的話，請去離島問問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250116,
					"content": "我記得…離島的商人李曉對美食就很有研究，還有楚瑜商行的秋月，她也算是半個美食家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
