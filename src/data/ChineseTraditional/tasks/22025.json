			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秋月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "什麼事？欸…湯雯小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250307,
					"content": "滿嘴怪味、沒有食欲、吃不下飯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250302,
					"content": "真的是吃了不好的奇怪食物嗎？沒搞錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250303,
					"content": "怎麼聽起來感覺更像是吃撐了消化不良呢。唔，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250304,
					"content": "算了，既然沒法判斷的話，就只有一道菜可以推薦了，那就是——醃篤鮮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250305,
					"content": "口味鹹鮮，肉質酥嫩，爽口開胃，最後還有一鍋老湯幫助消食。嗯！真想現在就來一點啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250306,
					"content": "相信我，湯雯現在需要的就是醃篤鮮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋月"
				}
			]
		},
		{
			"id": 2202504,
			"completionStepIds": [
				2202504
			],
