				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250401,
					"content": "嗚哇，得到了不同的答案呢，絕雲鍋巴和醃篤鮮，都是很特別的美味呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250402,
					"content": "到底該做什麼才好呢？好糾結！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250403,
					"content": "派蒙覺得應該做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "欸？我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250405,
					"content": "這樣的話…讓我選的話…讓我選的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250406,
					"content": "我選烤吃虎魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250407,
					"content": "烤吃虎魚聽起來好像很有勇氣的樣子，如果湯雯小姐吃掉這種勇氣，一定能順利解決現在的麻煩吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250408,
					"content": "派蒙對吃還是很精通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "#哎呀，所以說還是{F#妳}{M#你}來決定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250411,
					"content": "那就…美味的絕雲鍋巴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "好，那我們就快點做好這份美食，送去給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250412,
					"content": "那就…美味的醃篤鮮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "那就…美味的烤吃虎魚！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "吃虎魚不是這麼個說法吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
		},
