			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李曉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "#什麼事？啊…{F#妳}{M#你}說湯雯小姐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250207,
					"content": "食欲不振…滿嘴都是怪味…需要特別的美食才能拯救？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250202,
					"content": "居然遇到了這樣的困難…確實有點棘手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250203,
					"content": "不過依我看，倒不一定要特別名貴的菜，只要口感和風味獨樹一幟，再加上一點點的衝擊力就足夠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250204,
					"content": "所以我的建議是——絕雲鍋巴！既有獨特的勁脆口感，又有猛烈的香辣力道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250205,
					"content": "從當年在輕策莊第一次嚐到絕雲鍋巴，已經過去十幾年了，到現在我還時常想起它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "李曉"
				},
				{
					"id": 220250206,
					"content": "我想如果是絕雲鍋巴的話，無論什麼問題都會迎刃而解的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李曉"
				}
			]
		},
		{
			"id": 2202503,
			"completionStepIds": [
				2202503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
