	"talks": [
		{
			"id": 7550701,
			"completionStepIds": [
				7550701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7550701",
							"2"
						],
						"stepId": 7550701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755070101,
					"content": "#{NICKNAME}、派蒙，謝謝{F#妳}{M#你}們。沒有{F#妳}{M#你}們的幫助，我一定無法完成這項任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070102
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070102,
					"content": "現在可以邀請我加入「組織」了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070103
					]
				},
				{
					"id": 755070103,
					"content": "#{F#妳}{M#你}還真的想加入啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755070104,
					"content": "嗯…年齡方面可能有點微妙，不過不管怎麼說，也得看看其他人的意見，大家投票通過的話，也不是沒有先例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070105
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070105,
					"content": "#如果之後{F#妳}{M#你}去到挪德卡萊，就去那夏鎮的「斯佩蘭扎」吧。卡嘉雖然不是我們的一員，但她是信得過的人，她會幫{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070106
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070106,
					"content": "#好哦。說起來，在{NICKNAME}戰鬥的時候，看你又是留影又是在筆記本上塗塗畫畫，好專業的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070107,
						755070108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755070107,
					"content": "該不會是想偷學我的戰鬥技巧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				},
				{
					"id": 755070109,
					"content": "#唔…告訴{F#妳}{M#你}們也沒關係吧。我的任務是收集一百種怪物的情報，託{F#妳}{M#你}們的福，納塔和楓丹的部分已經完成啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070110
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070110,
					"content": "之後該去須彌了，到時委託鍍金旅團好了。不過在那之前還得把已經做好的圖鑑寄回那夏鎮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070111
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070111,
					"content": "哇，原來你是在做怪物圖鑑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755070112,
					"content": "嗯。挪德卡萊已經沒什麼我不知道的怪物了，所以才決定去其他地方看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070113
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070113,
					"content": "玫熙雖然膽子小，但卻很喜歡聽這些怪物的故事呢。從前每次我把新做好的圖鑑交給她的時候，她都高興得兩眼發光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070114
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070114,
					"content": "可惜她身體不好不能遠行，不然就帶她一起來了。而且卡嘉說過，如果我的圖鑑做得夠好，說不定還有出版的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070115
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070115,
					"content": "要是能帶著出版的圖鑑回去，偷偷藏在她的枕頭下邊，等她醒了給她一個驚喜…咳，一不小心說太遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070116
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070116,
					"content": "嘿嘿，赫卡真的很關心朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755070117,
					"content": "朋友…更像是家人吧，雖然沒有血緣關係。哎呀，還是不要說這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070118
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070118,
					"content": "#對了，這次的圖鑑也送給{F#妳}{M#你}們一份副本好了。畫片要留備份，還得寄給玫熙，所以{F#妳}{M#你}們的那份就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070119,
						755070120
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070119,
					"content": "我也對留影略知一二。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070121,
					"content": "那就好。我也差不多該去下一個目的地了，可能過幾天就動身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070122
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070122,
					"content": "路上要小心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755070123,
					"content": "#{F#妳}{M#你}們也是，祝{F#妳}{M#你}們旅途一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫卡"
				},
				{
					"id": 755070120,
					"content": "想看隨時能看到，沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070108,
					"content": "難道是畫家寫生或者映影導演拍攝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				}
			]
		}
	]
}