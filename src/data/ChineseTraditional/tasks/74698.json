			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746980101,
					"content": "唔…那邊是神子啊，總感覺事情會變得麻煩起來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980102,
					"content": "比如上一次「三川花祭」，雖然結果上很開心啦，只不過過程上就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980103,
					"content": "而且見面就叫我們簽賣身契。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980104
					]
				},
				{
					"id": 746980104,
					"content": "不過這次…嘿嘿，不是我們出力，肯定不會被…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980105,
					"content": "小聲小聲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980106
					]
				},
				{
					"id": 746980106,
					"content": "#哎呀…{NICKNAME}、小派蒙。虧我們好不容易在楓丹偶遇，{F#妳}{M#你}們原來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980107,
					"content": "嗚哇！神神神神子，妳剛才都聽到了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980108,
					"content": "沒有。我什麼都沒聽見，但看小派蒙的樣子，應該不是什麼…好話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980109,
					"content": "沒有沒有，我們也很高興能在這裡見到神子呢，嘿嘿嘿…神子來這裡是幹什麼的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980110,
						746980111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980110,
					"content": "（話題轉移得好生硬…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980112
					]
				},
				{
					"id": 746980112,
					"content": "我這個苦命的主編，還能做什麼？當然是為了八重堂的生意出來奔波啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980113,
					"content": "本來剛買了一箱新書，準備帶回去讓八重堂裡的編輯們好好研讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980114,
					"content": "沒想到，卻偶然看見了我的某位「老朋友」，在這個占卜攤前停了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980115,
					"content": "她平時都不怎麼來神社裡抽「御神籤」，現在卻突然對占卜起了興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980116
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980116,
					"content": "但在城裡閒逛的時候，聽說城外有一個很靈驗的占卜攤位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980117,
					"content": "所以，我也過來占卜了一輪，就算是…滿足一下好奇心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980118,
					"content": "欸？已經抽過了嗎？虧我還想了這麼半天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980119,
					"content": "抽到什麼牌了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980120
					]
				},
				{
					"id": 746980120,
					"content": "#哎呀，對我的未來這麼感興趣啊？呵，想知道的話，我也不是不可以讓{F#妳}{M#你}們看看。不過，{F#妳}{M#你}們也得付出點代價才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980121,
					"content": "#我想想…要不然小傢伙妳乾脆就加入八重堂，負責把{F#妳}{M#你}們的冒險經歷整理成書吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980122,
					"content": "就按時下流行的取名方式，叫《開局撿到應急食品，而後天下無敵》好了，想想就一定能大賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980123,
					"content": "那這本書還滿厚的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980124
					]
				},
				{
					"id": 746980124,
					"content": "沒關係，只要有趣，多厚都行。本社之前還出版過一部叫《悖論後的地平線》的輕小說呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980125,
					"content": "那本書可是厚得和字典一樣，而且還足足出了八部，算上三本設定集和六本衍生外傳，疊起來都能頂到天花板了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980126
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980126,
					"content": "小傢伙，你要是能寫這麼多，那我這個主編，就親自來做你的責任編輯，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980127,
						746980128
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980127,
					"content": "妳就是想催我稿！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980129
					]
				},
				{
					"id": 746980129,
					"content": "哎呀，那妳對我抽到的牌也不感興趣囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980130
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980130,
					"content": "我突然也沒這麼想看了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980131
					]
				},
				{
					"id": 746980131,
					"content": "是啊！其實我們也沒有那麼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980132,
					"content": "啊，這就是我抽到的牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980133
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980133,
					"content": "用這位芭比洛斯女士的描述就是…逆位的「正義」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980134,
						746980135
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980134,
					"content": "我蒙住眼睛了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980136
					]
				},
				{
					"id": 746980136,
					"content": "#不想看？好吧，唉，這麼不喜歡占卜，那下次{F#妳}{M#你}們來抽「御神籤」的時候，我這個不討人喜歡的宮司，就不幫{F#妳}{M#你}抽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980137
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980137,
					"content": "#這麼說來，{F#妳}{M#你}們最近是不是經常來神社掛繪馬？不如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980138,
						746980139
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980138,
					"content": "這張牌抽得真好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980140
					]
				},
				{
					"id": 746980140,
					"content": "#我說{F#妳}{M#你}啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980141,
					"content": "好是好，但可惜，我抽到的這張「正義」是逆位的…是在說，我是一個壞人嗎？占卜師女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980142
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980142,
					"content": "雖然牌名為「正義」，但它並不代指普遍意義上的「好人」或「壞人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980160
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980160,
					"content": "不如說…如今處於逆位的它，所指代的是「不誠實的人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980143
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980143,
					"content": "不誠實？怎麼會呢？我平時幫這小傢伙解籤的時候，可都是誠實得要命呢…是不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980144
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980144,
					"content": "#我只記得每次神子幫{NICKNAME}主持抽籤的時候，{NICKNAME}抽到的都是大吉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746980145,
					"content": "#那是這小傢伙運氣好——或者說，{M#他}{F#她}待在本宮司身邊的時候，運氣很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980146
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980146,
					"content": "運氣…那倒是巧了。逆位的「正義」，的確象徵著偏差的因果、失衡、不誠實…還有不滿足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980147,
					"content": "這位妖怪小姐，應該聽得懂。畢竟，「妖怪」的誕生，本就和「欲望」關係緊密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980148,
					"content": "對於某物的渴求、未曾完成的夢想、未竟的某種大業、被某種情感吸引…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980149,
					"content": "只要些許契機，這些未曾被滿足的「欲望」就會生根成長，蔓延出意料之外的根芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980150
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980150,
					"content": "而妳這位稻妻的「大妖怪」，心中大概也埋著更為龐大的「欲望」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980152
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980152,
					"content": "但更多的我也看不見了，畢竟只抽了一張牌嘛。而且逆位的「正義」也很擅長掩蓋和謊言，無論是對他人，還是對自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980153
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980153,
					"content": "聽得雲山霧罩的，很像是我神社裡各位巫女解籤時候的說法。沒想到來這一趟，還能收獲這種全新的占卜話術，還滿有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980154
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980154,
					"content": "不過，有趣歸有趣，但這種話術和本社的經營理念不符，不能教給各位巫女了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980155
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980155,
					"content": "但總歸，感謝這位魔女的占卜。有機會的話，請妳也去鳴神大社坐坐，讓我也為妳做一做占卜，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980156
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980156,
					"content": "可惜，水占術就夠我忙的了，可分不出空來體驗其他的占卜形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980157
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980157,
					"content": "但這「御神籤」聽起來像是尼可和艾莉絲會喜歡的娛樂，我會告訴她們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980158
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746980158,
					"content": "好啊，到時候，我來主持各位魔女的抽籤儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746980159
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980159,
					"content": "我保證，各位都能抽到上好的吉籤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 746980139,
					"content": "正義這牌，光聽就好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980140
					]
				},
				{
					"id": 746980135,
					"content": "我捂住耳朵了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980136
					]
				},
				{
					"id": 746980128,
					"content": "不了不了我還要冒險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746980129
					]
				},
				{
					"id": 746980111,
					"content": "（完全被神子詐到了…）",
					"roleType": "TALK_ROLE_PLAYER",
