			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3061101,
					"content": "就是這裡了，被廢棄的<color=#00E1FFFF>四風守護廟宇</color>之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061102,
					"content": "這些廟宇已經荒廢好多年了，蒙德的民眾也根本不會來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061103,
					"content": "搞不好裡面會有野獸築巢，或者丘丘人建立營地呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061104,
					"content": "唉…畢竟連風魔龍自己，都放棄了自己的廟宇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061105,
					"content": "妳說風魔龍…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "…是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061108,
					"content": "雖然我也很不願意接受，但…風魔龍，曾經也是「四風守護」之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061109,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3061110,
					"content": "#先不提這些了。{F#妳}{M#你}感受到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061111,
					"content": "這裡面的「風」，有些不對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061112,
					"content": "#進去看看吧，{NICKNAME}。要小心，龍的力量正在影響這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061106,
					"content": "妳說「自己的廟宇」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
