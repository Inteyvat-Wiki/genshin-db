				"points": []
			},
			"dialogs": [
				{
					"id": 3061001,
					"content": "呼…真累人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061002,
					"content": "不過，這樣就能為琴團長分擔一些辛勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061003,
					"content": "以前我們的防禦力量，起碼還能守住城裡的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061004,
					"content": "簡單來說主要是因為有琴在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061005,
					"content": "但現在風魔龍已經直接襲擊了蒙德內部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061006,
					"content": "「風向變了，我們的策略也會作出相應的變化。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061007,
					"content": "聽起來很有哲理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "這是麗莎喜歡說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061010,
					"content": "對了，之前我們聊到的「四風守護」話題——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061011,
					"content": "如果想知道過往的歷史，也可以去問麗莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061012,
					"content": "…先說明，不是因為我歷史學得不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061013,
					"content": "圖書管理員的知識儲備，總之…就是會比偵察騎士更完備一點吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061008,
					"content": "妳原創的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
		{
			"id": 30611,
			"completionStepIds": [
				30601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"30601",
