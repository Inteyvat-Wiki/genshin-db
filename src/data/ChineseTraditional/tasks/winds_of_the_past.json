			"dialogs": [
				{
					"id": 3061201,
					"content": "蒙德城的大家還在被風災困擾著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061202
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061202,
					"content": "每耽擱一秒都是騎士的失職！我們趕快到廟宇裡去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
