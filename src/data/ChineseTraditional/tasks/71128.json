			"dialogs": [
				{
					"id": 711280201,
					"content": "「等這棵樹長大一些，我便把葉子摘了，研茶給你們喝。」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "「到時候就在這裡，把留雲借風、理水疊山他們都叫來…」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "「你把樹隨隨便便種在我的地界上，還好意思說這種話…」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "…昔時的諾言最終未能迎來兌現的一日，無言的古樹卻依然記得諾言的樣貌…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "…如今的茶香，早已飄遍沉玉谷的山野，飄向更遙遠的彼方…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
