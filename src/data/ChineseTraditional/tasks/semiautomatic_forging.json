						"pointId": 340100229
					},
					{
						"sceneId": 3,
						"position": [
							3606.78,
							428.202,
							4584.271
						],
						"pointId": 340100230
					},
					{
						"sceneId": 3,
						"position": [
							3606.759,
							428.202,
							4583.423
						],
						"pointId": 340100231
					}
				]
			},
			"dialogs": [
				{
					"id": 746700101,
					"content": "還有改進的空間啊，捶鍛力度有問題，材料都一樣，是因為鍛造的方式有差別嗎？夾材鍛造和包材鍛造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700102
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700102,
					"content": "這樣的話，是預先設定好相應的力度大小，還是做一個根據鍛造方式判定的自我調整機制呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700103
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700103,
					"content": "果然，走近了看還是覺得很神奇，像這種能夠自己「鐺鐺」打鐵的機器，看起來都不需要鐵匠了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700104,
					"content": "哈哈，這臺機器還沒聰明到「不需要鐵匠」的程度，每次進行鍛造的時候，都要調整很多細節，後續的淬火和打磨也全靠人工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700105
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700105,
					"content": "不過，總有一天，我一定會讓它變成全自動的鍛造機器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700106
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700106,
					"content": "怎麼樣，是有什麼委託鍛造的需求嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700107
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700107,
					"content": "取決於錘鍛機的表現…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700108
					]
				},
				{
					"id": 746700108,
					"content": "這我就不得不露一手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700109
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700109,
					"content": "咦，原來妳不只是老闆，還是鐵匠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700110,
					"content": "對，我就是這裡的老闆…兼鐵匠，怎麼樣，看不出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700111
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700111,
					"content": "第一次知道的人都會露出妳這種驚訝的表情。「這個人手臂沒有那種渾圓厚實的肌肉，身形比普通人還瘦弱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700112
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700112,
					"content": "是啊是啊，這樣的人真的能做好鐵匠的工作嗎…喔，我並沒有真的這樣想，我剛剛只是順著妳的話說了下去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700113,
					"content": "哈哈，沒關係。實不相瞞，能讓身形瘦弱的我勝任鐵匠的工作，就是這臺機器的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700114
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700114,
					"content": "人類會使用工具，而精巧設計的工具讓不可能成為可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700115
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700115,
					"content": "也有人說什麼機器鍛造沒有匠人的靈魂，在我看來機器和錘子一樣都是工具，我倒是很想看看他們不用錘子徒手敲原胚的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700116
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700116,
					"content": "#說遠了說遠了，好，現在就讓我當場打把超鋒利的劍給{F#妳}{M#你}們看看吧…啊，但是好像沒有足夠的鍛材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700117
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700117,
					"content": "哎呀，之前的試驗好像用掉了太多份額，該怎麼辦好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700118
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700118,
					"content": "我知道我知道，接下來就是拉動神秘大拉桿的階段，拉動拉桿，鍛造機器就會「庫庫庫」地變成發條機械，自己出去找材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700119,
					"content": "哦…自動搜尋材料的機器，感覺也是一個需要的設計，要怎麼識別鍛材呢？靠外表面的反光判斷材質嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700120
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700120,
					"content": "伊絲黛萊小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700121,
					"content": "啊，不好意思，一下子分心了。抱歉抱歉，錘鍛機就只是單純的錘鍛機，不會變形也不能到處走，鍛材還是要等人運送過來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700122
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700122,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700123,
					"content": "#說到這個，如果{F#妳}{M#你}們收集到各式各樣的材料，也可以送到我這來，要一邊試驗一邊調整鍛造機器，各類鍛材總是很緊缺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700124
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700124,
					"content": "#作為回報…我就把這裡的一些工坊產品的設計圖給{F#妳}{M#你}們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700125,
						746700126
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700125,
					"content": "我聞到了商業機密的味道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				},
				{
					"id": 746700127,
					"content": "該怎麼說呢，對我來說，重要的不是鍛造出的「產品」，而是鍛造用的「工具」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700128
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700128,
					"content": "讓錘鍛機接觸各種材料，收集不同的資料，這樣對以後鍛造出更好的產品也有幫助，設計圖的重要性反而在其次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700129
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700129,
					"content": "#所以不僅僅是鍛造用的材料，{F#妳}{M#你}要是碰到覺得可以用的鍛材，就盡情帶過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700130
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700130,
					"content": "唔，妳應該不會拿奇怪的設計圖敷衍我們，在我們找妳的時候，就發現這家店空空如也，連人帶錘鍛機一起不見了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700131,
					"content": "怎麼可能，這也可以算是一種長期合作了，在這種合作之中，信譽比什麼都重要，我能保證那些設計圖的品質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700132
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700132,
					"content": "更何況，就算我能跑，讓這個錘鍛機長出腿來也不是容易的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700133
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700133,
					"content": "說的也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700134,
						746700135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700134,
					"content": "那就這麼說定了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700136,
					"content": "#希望這是一次雙方都會愉快的合作，嗯，我很期待{F#妳}{M#你}們會送來什麼樣的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 746700135,
					"content": "合作愉快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700126,
					"content": "真的可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				}
			]
		}
	]
}