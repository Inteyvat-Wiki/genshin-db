			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190201,
					"content": "#{NICKNAME}和派蒙？真沒想到會在這種地方遇到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190202
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190202,
					"content": "竟然是煙緋？妳一般不是在璃月港裡工作嗎？怎麼跑到這種鳥不拉屎的地方來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190203,
					"content": "嗯，說實話，這趟工作確實有點特別…層岩巨淵最下面原來長這樣，我也是第一次見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190204
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190204,
					"content": "#啊不對！兩位幫我個忙吧，有人在找我，如果他們問起，{F#妳}{M#你}就說沒見過我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190205
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190205,
					"content": "欸？什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190206,
						10190207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190206,
					"content": "煙緋，難道妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				},
				{
					"id": 10190208,
					"content": "那可不是，這件事說來話長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190209
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190209,
					"content": "#總之，搪塞的事就交給{F#妳}{M#你}們啦，一會見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190210
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190210,
					"content": "喂，煙緋她真的走了…怎麼辦呀，我突然好害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190211,
					"content": "#{F#妳}{M#你}說，她該不會是犯了什麼法，才逃到這裡來的吧？會不會是…什麼很恐怖的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190212,
					"content": "不會吧，煙緋可是律法諮詢師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190213
					]
				},
				{
					"id": 10190213,
					"content": "不要太天真哦！這個社會可是很複雜的，先做好最壞打算，萬一真有什麼事，我們就成她的共犯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190214,
					"content": "唔唔，要不要袒護她呢…好糾結…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190215,
					"content": "派蒙，真是又複雜又天真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190216
					]
				},
				{
					"id": 10190216,
					"content": "喂！喂那邊的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190217
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190217,
					"content": "啊！來了，有人來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190218,
					"content": "不過這個聲音，好像在哪裡聽過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190219,
					"content": "#哈哈，居然是{F#妳}{M#你}們倆，跑到這種地方來度假嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190220
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190220,
					"content": "居然是一斗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190221
					]
				},
				{
					"id": 10190221,
					"content": "#噢！看{F#妳}{M#你}們的樣子，最近應該過得不錯吧？我也是哦，哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190222,
					"content": "你後面那個人是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190223,
					"content": "#{F#妳}{M#你}們好啊，我是荒瀧派成員久岐忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190224
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190224,
					"content": "#啊哈哈，差點忘了，來來給{F#妳}{M#你}們介紹一下，這位是我們荒瀧派最厲害的人，阿忍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190225
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190225,
					"content": "哦哦！原來也是荒瀧派的人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190226,
					"content": "#在花見坂混的厲害人物，肯定要加入我們荒瀧派啊。平時幫裡的事都是阿忍擺平，也讓她罩著{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190227
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190227,
					"content": "#老大的朋友就是我的朋友，很高興認識二位，{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190228
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190228,
					"content": "很上道嘛！那我就叫妳阿忍啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190229,
					"content": "很高興認識妳，阿忍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190230
					]
				},
				{
					"id": 10190230,
					"content": "#嗯，以後請多關照。其實我有預感…說不定最近就要{F#妳}{M#你}們關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190231
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190231,
					"content": "不過一斗，你剛才說，你們幫派的事都是她在擺平？那其實她才是老大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190232,
					"content": "派蒙，妳在說什麼傻話，老大是我啊。天上地下花見坂荒瀧派，從來只有我一個老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190233
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190233,
					"content": "我懂了，是沒用的老大和厲害的部下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190234,
					"content": "喂！唉，算了，憑妳這個小腦瓜想不明白也正常，本大爺不跟妳一般見識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190235
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190235,
					"content": "#言歸正傳，{F#妳}{M#你}們有沒有見過一個粉色的律…律什麼什麼法師？反正就是個懂很多的人，個子不高，戴著頂怪帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190236,
					"content": "咿…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190237,
					"content": "是一位來自璃月的律法諮詢師，名叫煙緋。我猜，二位或許認識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190238
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190238,
					"content": "沒、沒見過哦！也從來不認識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190239,
						10190240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190239,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190241,
					"content": "#嗯，看來{F#妳}{M#你}們見過她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190242
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190242,
					"content": "我沒說，我什麼都沒說啊！你不要瞎猜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190243,
					"content": "緊張了，看來是被我說中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190244
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190244,
					"content": "人在撒謊的時候會下意識眼神游移呢，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190245
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190245,
					"content": "不過別擔心，我們沒有任何惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190246
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190246,
					"content": "你們認識煙緋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190247,
					"content": "認識認識。她啊，已經是我的救命恩人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190248
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190248,
					"content": "什麼救命恩人？欸…欸等一下，你們兩個怎麼會出現在層岩巨淵啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190249,
					"content": "抱歉，派蒙反應有點慢有點笨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190250
					]
				},
				{
					"id": 10190250,
					"content": "#稻妻鎖國令最近解除了，這事{F#妳}{M#你}們知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190251
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190251,
					"content": "阿忍來璃月拿她的畢業證，我怕她一個人出遠門不安全，就跟過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190252
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190252,
					"content": "畢業證？妳在璃月上過學？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190253,
					"content": "我在璃月同文學塾進修過法學，可惜畢業前夕回家探親剛巧碰上鎖國令…這張畢業證拿晚了好幾年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190254
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190254,
					"content": "我們到璃月港辦事，老大排隊時跟千岩軍士兵起了衝突，險些被拘捕，幸虧煙緋小姐路過出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190255
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190255,
					"content": "要不是恩人幫了大忙，我恐怕要進璃月大牢了，所以，就想幫她做點什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190256
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190256,
					"content": "但她說沒什麼需要我們幫忙的事，那可不行，出門在外哪會不遇到麻煩？乾脆跟著她，等有需要時，我立刻一躍而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190257,
						10190260
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190257,
					"content": "也是一種強迫推銷呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190258
					]
				},
				{
					"id": 10190258,
					"content": "不不，真的只是想保護她！因為她行色匆忙，感覺是去做一件重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190259
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190259,
					"content": "#在這世上想做點偉大重要的事，難免要遇到什麼麻煩，{F#妳}{M#你}懂的吧？我是好心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190264,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190265
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190265,
					"content": "（阿忍在給我使眼色？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190266
					]
				},
				{
					"id": 10190266,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190267
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190267,
					"content": "（難道是暗示我把一斗支開…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190268
					]
				},
				{
					"id": 10190268,
					"content": "煙緋剛才往那裡走了哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190269
					]
				},
				{
					"id": 10190269,
					"content": "哦，謝謝啦，我這就去找她！喂阿忍，走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190270
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190270,
					"content": "恩人，等著本大爺來助妳一臂之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190271
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190271,
					"content": "謝謝，下次見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190272
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190272,
					"content": "#{F#妳}{M#你}剛剛是故意騙一斗的對吧？其實我覺得阿忍沒有相信{F#妳}{M#你}說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190273,
					"content": "或者說，她也覺得一斗太纏人了，不希望他給煙緋添麻煩呢…這個阿忍，很有眼力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190274,
					"content": "這樣一來就沒人找她啦。之後要是遇到煙緋，記得把這個好消息告訴她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190275
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190275,
					"content": "那我們先去上次那個被砸過的地方看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190260,
					"content": "鬼也會報恩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190261
					]
				},
				{
					"id": 10190261,
					"content": "婆婆說了，男人一定要知恩圖報。不管是上刀山下火海，這位律法諮詢師的事我荒瀧一斗都幫定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190262
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190262,
					"content": "那萬一她用不著你幫忙，你怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190263,
					"content": "這…這…哈哈，不可能，這種事絕對不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190264
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190240,
					"content": "妳剛剛那個「咿」已經不打自招了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190241
					]
				},
				{
					"id": 10190207,
					"content": "妳可不要知法犯法呀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190208
					]
				}
			]
		},
		{
			"id": 101903,
			"completionStepIds": [
				101903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101903",
							"2"
						],
						"stepId": 101903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190301,
					"content": "#{F#妳}{M#你}看，煙緋正好也在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190302,
					"content": "煙緋，那些追妳的人被我們支開了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190303,
					"content": "#太好了，多虧{F#妳}{M#你}們。那位打扮花哨的大哥可真熱情，要是平時應該能交個朋友，可惜我今天有正事要辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190304
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190304,
					"content": "唔…什麼正事需要在這種怪地方辦啊，該不會妳也想轉行當冒險家了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190305,
					"content": "我是律法諮詢師，偶爾也會遇到這種不得不親自出遠門的情況。這次來層岩巨淵，是因為一份「遺囑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190306
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190306,
					"content": "遺囑…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190307,
					"content": "嗯。我在一本古書中找到一份遺囑，應該是從前的某位高人所留。他有一件法寶失蹤了，想找回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190308
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190308,
					"content": "這種事竟然也要律法諮詢師做啊，真辛苦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190309,
					"content": "代為執行遺囑也是律法諮詢師工作的一環，當然啦，像這樣的情況確實不多見。層岩巨淵也不是想來就來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190310
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190310,
					"content": "哦？原來妳知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190311
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190311,
					"content": "噫！誰呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190312,
					"content": "哎呀，妳在啊？果然被我猜對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190313
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190313,
					"content": "大律法諮詢師到層岩巨淵來辦事，哪裡需要請示我的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190314
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190314,
					"content": "有夜蘭在的地方，我說話可不算數，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190315
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190315,
					"content": "她、她是誰啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190316,
					"content": "這位是夜蘭，璃月的…唔，我能說妳就職於總務司嗎？總之，是我的一位朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190317
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190317,
					"content": "可以啊。剛巧，最近我也在這一帶有事要辦，與各位算是小有緣分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190318
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190318,
					"content": "#旅行者和派蒙或許不認識我，我對{F#妳}{M#你}們倒是有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190319
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190319,
					"content": "見笑了，我在璃月朋友太多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190320
					]
				},
				{
					"id": 10190320,
					"content": "幾位來這裡辦事，我的工作則是監察層岩巨淵。依照規章，我理應陪同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190321
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190321,
					"content": "但這次我另有要務在身，怕是無法全程跟隨了，幾位自便，不要搞出什麼大動作就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190322
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190322,
					"content": "糟糕，我還想請妳幫忙的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190323
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190323,
					"content": "看在往日交情的份上，妳能不能稍微抽點時間幫我搞定這份遺囑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190324
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190324,
					"content": "求我可是要拿出誠意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190325
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190325,
					"content": "好說，請導遊也要付錢的嘛，剛巧萍姥姥給了我一些好茶葉，不嫌棄的話，讓我請妳喝杯茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190326
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190326,
					"content": "呵呵，不如先說說妳來此地的詳情，我才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190327
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190327,
					"content": "#喂！{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190328
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190328,
					"content": "一斗怎麼回來了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190329,
					"content": "#好啊{F#妳}{M#你}們，故意支開我是吧！我說{NICKNAME}，{F#妳}{M#你}怎麼不向著{F#妳}{M#你}的兄弟我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190330
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190330,
					"content": "因為這邊也是我的朋友嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190331
					]
				},
				{
					"id": 10190331,
					"content": "留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190332
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190332,
					"content": "嗯？妳誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190333
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190333,
					"content": "抱歉，這一帶都屬於層岩重地，外人還請止步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190334
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190334,
					"content": "開什麼玩笑，妳這裡又沒個告示圍欄，還不讓人走路了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190335
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190335,
					"content": "真正危險的地方，不會有任何引起注意的告示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190336
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190336,
					"content": "原來這裡是這麼重要的地方啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190337,
					"content": "的確是個特殊的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190338
					]
				},
				{
					"id": 10190338,
					"content": "這裡確實不是能隨便出入的地方，我也是因為這一點，才不想讓兩位跟著。只可惜，我的拒絕沒什麼用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190339
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190339,
					"content": "#旅行者幫過璃月許多、煙緋是璃月知名的律法諮詢師，我信得過二位的立場和行為，沒有阻攔{F#妳}{M#你}們在這一帶活動。至於這兩位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190340
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190340,
					"content": "妳什麼意思？覺得我沒名氣，還是覺得我不懷好意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190341
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190341,
					"content": "正因為不清楚你的底細，才不能讓你隨便行動。再說煙緋的態度怎麼看都不像是需要你幫忙，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190342
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190342,
					"content": "哈！妳怎麼知道？妳是她肚子裡的蛔蟲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190343
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190343,
					"content": "哦？這不是一目了然的事嗎？倒是你，身為稻妻來客，還是入鄉隨俗，按當地規矩辦事比較好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190344
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190344,
					"content": "妳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190345
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190345,
					"content": "別衝動，她說的是實話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190346
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190346,
					"content": "呃啊，怎麼吵起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190347,
					"content": "麻煩了…他不該跟夜蘭硬碰硬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190348
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190348,
					"content": "我們不知道這裡性質特殊，既然您這麼說，我們會盡快離開。不過要真是危險地區，最好還是立個告示牌吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190349
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190349,
					"content": "感謝妳的意見，我會考慮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190350
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190350,
					"content": "如果我們不打算馬上就走呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190351
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190351,
					"content": "老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190352
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190352,
					"content": "那恐怕就會發生不愉快的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190353
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190353,
					"content": "啊？意思是妳能打贏我們兩個？妳很自信嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190354
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190354,
					"content": "二位雖是旅行者和煙緋的朋友，最好也能聽懂我的警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190355
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190355,
					"content": "哈哈…有意思，只可惜本大爺不服管束。既然妳這麼厲害，就讓本大爺見識見識妳的本事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190356
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190356,
					"content": "等等，沒必要在這裡起衝突！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190357
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190357,
					"content": "不，我就是要往裡走，她能把我怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190358
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190358,
					"content": "呵呵…覺得我喜歡開玩笑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190359
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190359,
					"content": "糟了，他們兩個要打起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190360,
					"content": "二位稍等一下。此事因我而起，不如給我一個面子…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190361
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190361,
					"content": "（地面…在搖晃？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190362
					]
				},
				{
					"id": 10190362,
					"content": "不好，這裡似乎…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190363
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190363,
					"content": "別扯開話題！我可是…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
		{
			"id": 101904,
			"completionStepIds": [
				101904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101904",
							"2"
						],
						"stepId": 101904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10190401,
					"content": "痛痛痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190402,
					"content": "#怎麼搞的啊！喂，{NICKNAME}，{F#妳}{M#你}沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190403,
						10190404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190403,
					"content": "我沒事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				},
				{
					"id": 10190405,
					"content": "呃…把書墊在屁股底下也不抗摔呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190406
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190406,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190407,
					"content": "這、這是什麼地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190408,
					"content": "疼疼疼…喂阿忍！還有我的兄弟！恩人！沒事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190409
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190409,
					"content": "呼…真是飛來橫禍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190410
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190410,
					"content": "喂，我們到底是掉到多深的地方來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190412,
					"content": "看來在剛才的對峙中，地面坍塌了。難道是因為催動了元素力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190413
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190413,
					"content": "可不是本大爺的錯啊。妳說話這麼不客氣，誰聽了都會發火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190414
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190414,
					"content": "我的工作就是阻止外人亂闖重地。假如實話實說也算不客氣…你的心智未免有些脆弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190415
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190415,
					"content": "妳…人活一口氣，我就是不喜歡讓步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190416
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190416,
					"content": "老大，你根本說不過她，幹嘛非要跟她吵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190417
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190417,
					"content": "阿忍，妳幫哪頭的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190418
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190418,
					"content": "點明現狀而已。雖然理解你的心情，但你沒事就跟人起衝突也是在給我添麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190419
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190419,
					"content": "我發現了，一斗既吵不過夜蘭，也說不過阿忍，他在這裡很弱勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190420,
					"content": "一斗和阿忍就像妳和我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190421
					]
				},
				{
					"id": 10190421,
					"content": "嗚哇好生氣啊！不要把我跟一斗相提並論！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190422,
					"content": "喂喂喂這話是什麼意思啊，找碴是吧妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190423
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190423,
					"content": "我、我說的可是實話，你是笨蛋大家都知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190424,
					"content": "我是笨蛋？那妳是飛行矮堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190425
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190425,
					"content": "飛行矮堇瓜？！嗚，氣死我了…我要幫你取個難聽的外號…就叫你放牛的！哼，放牛的，你很狂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190426,
					"content": "我們離掉下來的破洞似乎很遠，根本看不到頂上的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190427
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190427,
					"content": "這種距離，看來是沒法直接上去了，得另外找出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190428
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190428,
					"content": "各位，抱歉打擾你們聊天的雅興，有些事你們或許得知道一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190429
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190429,
					"content": "層岩巨淵在璃月算得上神秘地區，前些年因礦區事故而被封鎖。在這裡行動，最好學會不看、不聽，不問，以免涉及太多各位不該瞭解的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190430
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190430,
					"content": "原則上我不會與大家為敵，也希望大家別在保密問題上為難我。至於出路，我會盡力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190431
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10190431,
					"content": "欸？她怎麼走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190432
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190432,
					"content": "是去找出口了吧。夜蘭她可能是我們之中最懂得應對危機的人，就讓她去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190433
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190433,
					"content": "非常抱歉，一般來說我不會向無關人士透露委託人遺囑的內容，所以沒能跟二位說實話…對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190434
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190434,
					"content": "我來層岩巨淵，是想找回遺囑中提到的太威儀盤。許多年前，我的委託人將這一法寶交給有志之士，希望這件寶貝能在需要它的地方發揮作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190435
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190435,
					"content": "而據目擊者說，那個接收法寶的人帶著它往層岩巨淵去了，此後便下落不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190436
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190436,
					"content": "歷史上，層岩巨淵一帶曾發生過多次戰爭，可就算那個人在戰爭中死去，我也希望能竭我所能尋回法寶，圓委託人一個心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190437
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190437,
					"content": "至於先前夜蘭說的，也都是實話，層岩巨淵暗藏危機…你們應該也體會到了。現在遇到這種麻煩，我想，我們就一起想辦法出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190438
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190438,
					"content": "既然恩人這麼說…好，這個面子我賣了。現在開始大家都是同伴，至於那個臭屁的傢伙…哼，也算上好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190439
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190439,
					"content": "夜蘭不是在總務司工作嗎？總覺得她是個很厲害的人…沒想到做這行需要這麼大本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190440,
					"content": "唔，對外好像是這麼說沒錯…關於她的身分，我不便透露太多，只能說，這份工作非她莫屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190441
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10190441,
					"content": "什麼工作啊，竟然要在這種鳥不拉屎的地方上班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190442
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190442,
					"content": "這個我熟！冒險家呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190443,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190444
					]
				},
				{
					"id": 10190444,
					"content": "#怎麼了那副表情？我又沒說錯，{F#妳}{M#你}我不就是這樣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190445,
					"content": "冒險家是我，不是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190446
					]
				},
				{
					"id": 10190446,
					"content": "#{F#妳}{M#你}最近變得小氣了呢，讓我蹭蹭名頭怎麼了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190447,
					"content": "#對啊{NICKNAME}，{F#妳}{M#你}是派蒙的老大，老大要有氣量，應該多讓小弟沾光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10190448,
					"content": "我們不是這種關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190449,
					"content": "派蒙，老大說的話聽聽就好，不用往心裡去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190450
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10190450,
					"content": "哼，看在阿忍的份上…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10190451,
