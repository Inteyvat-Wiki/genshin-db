	"talks": [
		{
			"id": 101902,
			"completionStepIds": [
				101902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101902",
							"2"
						],
						"stepId": 101902,
						"stateName": "QUEST_STATE_UNFINISHED"
