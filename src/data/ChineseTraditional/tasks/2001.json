			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"北斗",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010901,
					"content": "精彩絕倫，實在值得盛讚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010902,
					"content": "#我能感覺到{F#妳}{M#你}有點不習慣，這也一度讓戰鬥陷入困局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010903,
					"content": "#但{F#妳}{M#你}迅速調整了態勢，取得了對決的勝利，這才是最難能可貴的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010904,
					"content": "很敏銳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "其實是聽出來的，有沙石和呼吸的聲音。不過，不是什麼值得一提的事，這種程度，大姐頭也能看得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010907,
					"content": "哈哈哈，的確是這樣，不過我就是單純靠經驗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010908,
					"content": "#對{F#妳}{M#你}來說，這也是非常新鮮的體驗，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010909,
					"content": "的確如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "我們想打聽一下，決賽的對手是怎麼樣的人，會比準決賽這個人更強嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010912,
					"content": "這倒不會。闖進決賽的人與其說「強」，不如說很有特點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010913,
					"content": "他很「快」，以身法見長，而且一看就有豐富的實戰經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010914,
					"content": "怎麼了？擔心在決賽上，會有點措手不及嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010915,
					"content": "謹慎一點總沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "既然如此，我有一個好的提議，跟我去安靜一點的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010918,
					"content": "之前並沒有介紹，其實在稻妻的時候，我是一名浪人武士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010919,
					"content": "唔，這倒是能從你的衣服上看出來。但你一說起話來，又不像是舞刀弄槍的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010920,
					"content": "文能掌書，武能橫刀，漫漫流浪之路上，多一門技藝又有何不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010921,
					"content": "#雖不敢自詡武藝超群，但也見過大陸各處形形色色的高手。{F#妳}{M#你}決賽的對手所擅長的技巧，我也略知一二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010922,
					"content": "#以{F#妳}{M#你}的天資，我只需稍加提示，{F#妳}{M#你}一定能想到破解之法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010923,
					"content": "喂喂，這是不是有點犯規了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010924,
					"content": "情報蒐集也是對決的一部分，並無不妥之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010925,
					"content": "#{F#她}{M#他}們從蒙德一路走來經歷了諸多惡戰，能夠連戰連捷，靠的也並不只是勇武。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010926,
					"content": "沒錯沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010927,
					"content": "欸，等等，我們好像沒說過我們去過蒙德吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010928,
					"content": "#呵呵，{F#妳}{M#你}們所到之處，都會在自然中留下足跡，而自然會回饋給{F#妳}{M#你}們特殊的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010929,
					"content": "但這種氣息能給我的提示，終究無法觸及本質，我還有很多好奇的問題沒有找到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010930,
					"content": "跟我走吧，就當是賽後的餘興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010916,
					"content": "去稻妻這件事很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "總算要結束了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "你的觀察力很強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
		},
		{
			"id": 200111,
			"completionStepIds": [
				200111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200111",
							"2"
