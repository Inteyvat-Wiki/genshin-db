	"talks": [
		{
			"id": 200103,
			"completionStepIds": [
				200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200103",
							"2"
						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"楓原萬葉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "哈哈哈，不愧是我看好的種子選手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010302,
					"content": "#你也看到了吧，萬葉！{F#她}{M#他}戰鬥的時候一點都不拖泥帶水，贏得乾淨俐落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010303,
					"content": "是啊，不過，感覺就像是收斂了些力量，不想讓對方受傷一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010304,
					"content": "#大大小小的戰鬥，我也經歷過無數次了，只看這一場，我也能清楚感覺到{F#她}{M#他}強勁的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010305,
					"content": "所以，不需要吝嗇你的讚美之詞哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010306,
					"content": "嗯，如果要誇獎的話，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010307,
					"content": "「打得不錯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010308,
					"content": "好吧，本來想讓你說點詩詞助助興，但還是算了，果然不應該為難你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010309,
					"content": "其實剛剛有很多參賽者都來找我說，完全沒想到璃月的大英雄會來參加這場比武。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010310,
					"content": "#報名的人也一下子多了好多，其中不乏武藝高強之人，我覺得，很多人都是想要和{F#妳}{M#你}一較高下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010311,
					"content": "沒想到我有這麼強的號召力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "#哈哈，所以我在想，應該給{F#妳}{M#你}一個更符合奪冠熱門選手的待遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010314,
					"content": "#一方面，不希望{F#妳}{M#你}在對抗普通選手的過程中消耗太多體力，另一方面，{F#妳}{M#你}應該也期待更激烈的對決吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010315,
					"content": "#所以，我就直接讓{F#妳}{M#你}晉級準決賽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010316,
					"content": "欸？剛剛那一場還是預選吧，直接就進準決賽，也太隨便了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010317,
					"content": "#大姐頭性格如此，{F#妳}{M#你}是勸不動她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010318,
					"content": "而且就算憑實力，我覺得這位大英雄也能走到準決賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010319,
					"content": "這我倒是同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010320,
					"content": "#那麼，我們先看看其他人的比賽吧，看看有資格挑戰{F#妳}{M#你}的人，究竟有怎麼樣的來頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010321,
					"content": "終於來了，終於來了，今天的重頭戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010322,
					"content": "呵呵，大姐頭對這場比賽的期待頗高，我很久沒見她如此興奮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010323,
					"content": "#{F#妳}{M#你}的對手突破了重重考驗闖入準決賽，已是身經百戰之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010324,
					"content": "#他的實力可能不及{F#妳}{M#你}，但也切勿掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010325,
					"content": "當然不會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "#那麼就讓我看看，{F#妳}{M#你}是否做好了突破那片雷暴的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20010328,
					"content": "#話先說到這裡吧，觀眾都等不及了。一樣去找場邊負責報名的那位船員，她會帶{F#妳}{M#你}上場的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010326,
					"content": "我沒有忘記我參賽的目的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "我倒是無所謂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200106",
							"2"
						],
						"stepId": 200106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戎世",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "出了很多汗，很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010602,
					"content": "#我承認，是{F#妳}{M#你}更勝一籌，我還需要鍛煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010603,
					"content": "你也很厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "是啊，剛剛真的好險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010606,
					"content": "如果你擁有神之眼的話，一定會非常厲害吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010607,
					"content": "小時候，我也想要神之眼，他們說只要夠強，就有機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010608,
					"content": "但是，拿不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010609,
					"content": "後來我就沒興趣了。神之眼沒有肌肉來得實在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010610,
					"content": "我也打贏過持有神之眼的人。那種力量是神直接給的，我並不羨慕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010611,
					"content": "咦？那你不是衝著那個沒有主人的神之眼來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010612,
					"content": "不，我只是想比武，看有沒有比我更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010613,
					"content": "只有敗北才能感悟差距，才有機會成長，所以我很高興。敗北是很難得的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010614,
					"content": "這才像真正有實力的人說出來的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010615,
					"content": "以後有機會，再來比武吧，我會繼續成長的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010616,
					"content": "我也一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "對了，你知道誰會參加決賽嗎？那個人是不是比你還厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20010618,
					"content": "有沒有我厲害，我不知道，但我聽說他很「快」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010619,
					"content": "不要掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010604,
					"content": "你有成為冠軍的潛力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
			"id": 200109,
