			},
			"dialogs": [
				{
					"id": 20012301,
					"content": "不依靠神之眼也能使用元素力，那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20012302
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20012302,
					"content": "#不用在意我，自言自語而已，{F#妳}{M#你}的挑戰，我會認真旁觀的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		}
