			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "此處四下無人，我就開門見山問了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011102,
					"content": "#其實{F#妳}{M#你}能夠很熟練地運用元素力，而且不止一種，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011103,
					"content": "果然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "唔，從見面開始，你好像就話裡有話，原來早就察覺到了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011106,
					"content": "#嗯，不在會場提及，是考慮到如果被其他參賽者知道了{F#妳}{M#你}會使用元素力，會招來不必要的誤解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011107,
					"content": "#就算在比賽中遭遇險境，{F#妳}{M#你}也沒有使用元素力，也是出於相同的考慮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011108,
					"content": "但你是怎麼知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "呵呵，我所言之「見」與「聞」，並不只是出於詩性，而是確有其事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011110,
					"content": "我很小的時候就能夠理解大自然的訊息，我能聽到風的呼吸，樹葉的低語…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011111,
					"content": "#從{F#妳}{M#你}的身上聽到了相似的東西，僅此而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011112,
					"content": "雖然難以置信，但感覺不像是在說謊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011113,
					"content": "#和{F#妳}{M#你}們的難以置信相比，我的這點能力簡直微不足道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011114,
					"content": "不依靠神之眼，就可以驅動多種元素力的人類…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011115,
					"content": "還有味道無比複雜，不知來自何方的神秘生物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011116,
					"content": "不要用「味道」來評價我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011117,
					"content": "關於這種複合的元素力是如何獲得的，可以講給我聽聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011118,
					"content": "我也不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "嗯…難以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011121,
					"content": "#那{F#妳}{M#你}，又是怎麼學會運用元素力，將其用到戰鬥中的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011122,
					"content": "全靠派蒙的知識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "#嘿嘿，沒有啦，我只是把我想到的事告訴{F#她}{M#他}了而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011125,
					"content": "#漫長的旅途、各種各樣的事、回顧與展望，{F#她}{M#他}有感而發，自然而然地就學會了元素的使用方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011126,
					"content": "老實說，我也完全不知道其中的原理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20011127,
					"content": "或許，這種不可理解才是神明與神之眼的本質吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011128,
					"content": "#不過，我還是想親眼看看，{F#妳}{M#你}是如何使用元素力的，或許我能獲得一些啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011129,
					"content": "#我也會將我掌握的資訊分享給{F#妳}{M#你}，這樣也算合理的交換吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011130,
					"content": "好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "那麼，就用一旁的這個挑戰，小試身手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 20011131,
					"content": "終於可以正常戰鬥了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "全靠派蒙的陪伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "我只是碰了碰七天神像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "難怪不在會場說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
