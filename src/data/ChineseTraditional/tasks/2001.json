					"content": "#從{F#妳}{M#你}到來開始，萬葉就特別注意{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20012202
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20012202,
					"content": "#有什麼好奇的問題，{F#妳}{M#你}也可以趁機問清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		},
		{
