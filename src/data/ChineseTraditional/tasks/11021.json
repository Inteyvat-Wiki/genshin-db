	"talks": [
		{
			"id": 1102102,
			"completionStepIds": [
				1102102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102102",
							"2"
						],
						"stepId": 1102102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210201,
					"content": "唔，這地方，怎麼看起來這麼普通…真的能找到有價值的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210202
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210202,
					"content": "嗯？我覺得挺壯觀的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210203,
					"content": "我不是說風景，而是…既然發生了一場大戰，總該有些不同尋常的地方吧，但現在，唉，甚至不知道該從哪找起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210204
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210204,
					"content": "此處名為孤雲閣，如果想要研究魔神，或是魔神戰爭時期的歷史，這裡都是絕佳的場所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210205
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210205,
					"content": "相傳，岩王帝君以岩為槍，投入此片海域，將魔神刺穿並鎮壓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210206
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210206,
					"content": "那些岩槍經歷了長年的風化，最終形成了此番別緻的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210207
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210207,
					"content": "這、這麼大的山，居然是岩王爺的武器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210208,
					"content": "如今殘存於我們眼前的，不過冰山一角。當年帝君投下的岩槍，無論數量還是體積，都遠超於此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210209,
					"content": "只不過因為角度各異，柱體又過於巨大，受到海水侵蝕，或是重力影響，很多都整體沉入了海底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210210
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210210,
					"content": "所以，除了後來的風化，起初的崩落也是孤雲閣的重要成因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210211
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210211,
					"content": "那…能和這麼誇張的力量對抗的魔神，應該也很強吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210212
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210212,
					"content": "是的，這就是孤雲閣的研究價值所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210213
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210213,
					"content": "與那段歷史有關的物件大多沉於深海，但「漩渦之魔神」掀起了滔天巨浪，也給了這些東西重見天日的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210214,
					"content": "也就是說，只要仔細找找，肯定就能賺得盆滿缽滿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210215
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210215,
					"content": "啊，我是說，肯定會收穫頗豐，是吧？這我就安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210216
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210216,
					"content": "反正帶了這麼多人，我覺得分頭尋找效率會更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210217
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210217,
					"content": "嗯，那麼，我和我的這位朋友同行吧，雖然我略懂一些雜學，但在專業的考古學家面前，還是不班門弄斧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210218,
					"content": "欸？我、我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210219
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210219,
					"content": "怎麼啦？這不是妳的本職工作，有必要這麼驚訝嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210220
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210220,
					"content": "我知道了…那、那我就為他帶路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210221
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210221,
					"content": "嗯，如果收集到了什麼珍貴或者稀奇的東西，我想想…就到對岸會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102106,
			"completionStepIds": [
				1102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102106",
							"2"
						],
						"stepId": 1102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克列門特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210601,
					"content": "…妳這也叫考古學家？！這也看不出來，那也不認識，妳到底行不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210602
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210602,
					"content": "術、術業有專攻不是很正常的事嗎！我已經很努力地講解了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210603
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210603,
					"content": "別吵架別吵架，到底發生什麼了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210604,
					"content": "這傢伙，口口聲聲說自己是考古學家，卻對這周圍的遺蹟一竅不通！還沒有我懂得多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210605
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210605,
					"content": "我只能靠直覺…我是說，經驗，帶了點好像有價值的東西回來。唉，真是耽誤時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210606
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210606,
					"content": "我…我一直都在研究「鹽之魔神」，對海裡的東西不懂，也很正常吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210607,
						110210608
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210607,
					"content": "（作為學者，確實有點奇怪…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				},
				{
					"id": 110210609,
					"content": "倒是你，一直在問我這個值多少摩拉、那個值多少摩拉！文物的價值難道就是摩拉嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210610
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210610,
					"content": "這、這…文物的價值，用摩拉來衡量，不是最直白嗎！也很符合璃月的傳統吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210611
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210611,
					"content": "沒關係，兩位稍安勿躁，我們倒是帶回來了一些不錯的東西，可以一起看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210612
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210612,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210613
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210613,
					"content": "很遺憾，你們帶回來的這些東西，雖然確實是被「漩渦之魔神」帶上岸的，可惜都與魔神無關，只是出自附近海域而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210614
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210614,
					"content": "相比之下，還是我們找到的這塊石板，表面有神秘的紋飾，且微存魔神之力，或許會對研究有所幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210615
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210615,
					"content": "快、快把它給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210616
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210616,
					"content": "嘿嘿，有了這個，就不算毫無收穫了。魔神的力量，哼哼，這個才是好東西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210617
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210617,
					"content": "咳咳，但是，這其他的東西應該也還值幾個錢，能收回雇傭顧問的成本——都歸我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210618
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210618,
					"content": "一定要有魔神的力量殘留在上面，才有研究的價值嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210619,
					"content": "不是的，我追尋「鹽之魔神」的歷史，是因為歷史能講述文化，還有信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210620
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210620,
					"content": "至於你，就只是想借考古的名義發財吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210621
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210621,
					"content": "胡說！我是至冬國的專業考古研究員，如假包換！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210622,
						110210623
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210622,
					"content": "（不，就是想借考古的名義發財吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210624,
					"content": "哦，對了，那個茶杯，最好別賣掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210625
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210625,
					"content": "啊？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210626
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210626,
					"content": "那不是古代的東西，是凝光的收藏，跟著群玉閣一起掉下來的。如果你不想惹惱七星的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210627
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110210627,
					"content": "呃，我知道了…明明我看成色還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210628
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110210628,
					"content": "你看，你就是想拿去賣錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210629
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210629,
