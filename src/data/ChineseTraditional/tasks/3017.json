				"points": []
			},
			"dialogs": [
				{
					"id": 30170601,
					"content": "#{NICKNAME}？是{NICKNAME}嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170602
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170602,
					"content": "啊！妳是…海芭夏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170603,
						30170604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170603,
					"content": "好久不見！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				},
				{
					"id": 30170605,
					"content": "#天啊，真是令人開心，能見到{F#妳}{M#你}們真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170606
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170606,
					"content": "這位是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170607
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170607,
					"content": "是我們在道成林時候遇見的修行學者，當時正在那什麼…「林居狂語期」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170608,
					"content": "唔…這樣嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170609
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170609,
					"content": "#是啊，我們是老朋友了。剛好我來這邊之後，沒什麼人願意跟我講話，{F#妳}{M#你}們來得正是時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170610
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170610,
					"content": "海芭夏，妳開心過頭啦。話說妳居然已經離開道成林了嗎，不繼續在森林裡修行啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170611,
					"content": "等等，不對…難道說，妳已經修行結束，進入「寂靜圓滿期」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170612,
					"content": "哼哼…妳說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170613
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170613,
					"content": "我之前…已經在意識中見過神明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170614
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170614,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170615
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170615,
					"content": "啊？真的嗎！恭喜恭喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170616,
						30170617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170616,
					"content": "真為妳高興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170618,
					"content": "#哈哈…能跟{F#妳}{M#你}們分享這份崇高的喜悅，還真是讓人快意又安慰啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170619
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170619,
					"content": "與神明意識相通的一刻，那簡直是無與倫比的至高體驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170620
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170620,
					"content": "那麼厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170651,
						30170652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170651,
					"content": "其實我們是來找提納里的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170621,
					"content": "#這樣啊…喔對了，請等一下，我沒有忘記跟{F#妳}{M#你}們的約定喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170622
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170622,
					"content": "#當時我說，等我獲得了真正的智慧，也許就能幫{F#妳}{M#你}們解釋曾經在世界樹那裡看到的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170623
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170623,
					"content": "#而現在的我呢，不僅擁有了智慧，甚至還能幫助{F#妳}{M#你}們自行與神明的意識進行連接喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170624
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170624,
					"content": "這、這也能做得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170625,
					"content": "妳覺得可信嗎，納西妲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170626
					]
				},
				{
					"id": 30170626,
					"content": "#我聞所未聞，不過…如果{F#妳}{M#你}想嘗試，我會全力保護{F#妳}{M#你}的意識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170627
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170627,
					"content": "等一下喔，我帶了些靈酚香來，這依舊是必不可少的「儀式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170628
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170628,
					"content": "又是那種薰香嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170629,
					"content": "#好了，現在…握住我的手，我會幫{F#妳}{M#你}們建立意識連接的「通道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170630
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170630,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170631
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170631,
					"content": "準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170632
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170632,
					"content": "這是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170633,
						30170634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170633,
					"content": "並非是大慈樹王的意識…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170635,
					"content": "我們看到的，是「散兵」的過去嗎！？很多資訊都重合上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170636,
					"content": "可是海芭夏口中的神明又怎麼跟「散兵」聯繫在一起的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170637,
					"content": "看到了吧、感受到了吧，崇高的神明、崇高的意志、崇高的情感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170638
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170638,
					"content": "唉…可惜啊，可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170639
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170639,
					"content": "可惜我的胸腔裡跳動的，卻是一顆骯髒的、人類的心…神明大人啊，可否寬恕我，可否救贖我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170640
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170640,
					"content": "看出來了嗎，這可不是什麼「寂靜圓滿期」，恐怕她是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170641
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170641,
					"content": "妳清醒一點，海芭夏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170642
					]
				},
				{
					"id": 30170642,
					"content": "啊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170643
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170643,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}為什麼對我這麼凶呢？為什麼那些人都在躲著我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170644
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170644,
					"content": "我找到了神明的智慧啊，我應該被誇獎才對啊，我成為了那個在黑暗裡探索又找到了光明的人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170645
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170645,
					"content": "海芭夏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170646,
					"content": "明明應該是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170647
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170647,
					"content": "…等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170648
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170648,
					"content": "難道說…是我已經瘋了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170649
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30170649,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170650
					]
				},
				{
					"id": 30170650,
					"content": "等一下，周圍不對勁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170634,
					"content": "也並非是赤王的意識…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170652,
					"content": "我們還有急事，下次再聊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170617,
					"content": "海芭夏真厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170604,
					"content": "想不到會在這裡見到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				}
			]
		},
		{
			"id": 301707,
			"completionStepIds": [
				301707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301707",
							"2"
						],
						"stepId": 301707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170701,
					"content": "…好像到這裡就沒有人追過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170702,
						30170703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170702,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				},
				{
					"id": 30170704,
					"content": "#妳還好嗎，納西妲…欸，不對！這種感覺是，{NICKNAME}{F#妳}{M#你}回來了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170705,
					"content": "#嗯？現在又是{NICKNAME}本人了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170706,
						30170707
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170706,
					"content": "是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170708,
					"content": "#之前一直是納西妲在操控{F#妳}{M#你}的身體，似乎是凱瑟琳人偶被破壞之前，她將意識緊急轉移到了{F#妳}{M#你}的身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170709,
					"content": "然後…提納里聽到聲音趕了過來，幫忙一起擊敗了那些傭兵，隨後我們便一路逃到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170710,
						30170711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170710,
					"content": "這次不僅僅是「意識轉移」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170712,
					"content": "#啊？「互換」？難道說，{F#妳}{M#你}的意識也去了納西妲的體內？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170713,
					"content": "那麼，納西妲的意識呢？她現在又到哪裡去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170714,
					"content": "意識居然可以這樣隨意轉移，若非親眼所見，根本難以置信…這應該還不是人類能夠做到的範疇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170715
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170715,
					"content": "#對了，{NICKNAME}，剛才逃走的路上，{F#妳}{M#你}體內的那個意識拜託我傳話給{F#妳}{M#你}，她說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170716
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170716,
					"content": "#「『博士』已經找到了禁錮意識的方法，我無法與{F#妳}{M#你}同行了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170717
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170717,
					"content": "「但即便是沒有『月亮』的夜晚，一眾『星光』亦足以刺破『虛幻』與『謊言』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170718
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170718,
					"content": "啊啊——可惡，這下子納西妲真的徹底被禁錮在「淨善宮」了啊，糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170719,
					"content": "她留下的話就只有這些了嗎？好像有點不明不白的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170720,
						30170721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170720,
					"content": "這是我們之間才懂的「暗語」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170722,
					"content": "啊，我懂了，「博士」已經捕捉到了納西妲的意識，所以納西妲說了什麼都會被他知道吧，很謹慎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170723,
					"content": "「即便是沒有『月亮』的夜晚，一眾『星光』亦足以刺破『虛幻』與『謊言』。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170724,
					"content": "我知道「月亮」、「虛幻」與「謊言」都源自花神誕祭時候的煉金占卜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170725,
					"content": "「星光」好像也是納西妲用過的比喻？好像是跟塞塔蕾有關的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170726,
						30170727,
						30170728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170726,
					"content": "「月亮」比喻她自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170729,
					"content": "喔喔！這麼說確實是這樣，看來納西妲的意思是，要讓我們去沙漠尋求幫助吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170730,
					"content": "可是沒有納西妲在了，我們真的沒問題嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170731,
					"content": "#派蒙剛剛提到了「淨善宮」？{F#妳}{M#你}們口中的納西妲，也就是之前{NICKNAME}體內的意識…莫非是草神大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170732
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170732,
					"content": "呃…你的猜測是正確的，情況有些複雜，我們現在很難和你解釋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170733,
					"content": "沒關係，學者的好奇也不是完全不講求時宜的，至於情況的複雜程度，我剛才也看在眼裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170734
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170734,
					"content": "#我和{F#妳}{M#你}們相處過一段時間，而且看起來小草神大人也站在{F#妳}{M#你}們一邊，所以…我相信{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170735
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170735,
					"content": "嗯！謝謝你，提納里。對了，我們之前就想找你問，你對賢者們正在進行的「工程」有什麼瞭解嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170736,
					"content": "這個嘛…我的確曾受邀去參加那項工程，但賢者們對工程的內容一直三緘其口，後來我便推脫掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170737
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170737,
					"content": "我只知道，那項工程應該事關「世界樹的修復」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170738,
						30170739
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170738,
					"content": "我大概知道工程的內容了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170740,
					"content": "欸？是和納西妲互換意識的時候見到了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170741,
					"content": "教令院…在幫助散兵「成神」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170742
					]
				},
				{
					"id": 30170742,
					"content": "什麼！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170743,
					"content": "…依據呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170744,
						30170745
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170744,
					"content": "我見到建造中的「神的半成品」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170746,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170747
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170747,
					"content": "#{F#妳}{M#你}描述了與納西妲互換意識的時候，{F#妳}{M#你}的所見…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30170748
					]
				},
				{
					"id": 30170748,
					"content": "是嗎，原來如此…難怪海芭夏的症狀與之前那些瘋掉的學者有所不同，原來是接觸了一個正在誕生中的新神的意識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170749
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170749,
					"content": "提納里是因為海芭夏才離開道成林的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170750
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170750,
					"content": "是的，我留意到了海芭夏的精神失常，但症狀又比較特殊，所以我偷偷帶她來到禪那園，尋找能讓她恢復的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170751
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170751,
					"content": "如果不這樣做，海芭夏現在恐怕已經被風紀官們流放到沙漠中的阿如村了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170752
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170752,
					"content": "話說回來，我原本也知道教令院一直輕視小吉祥草王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170753
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170753,
					"content": "可是的確沒想到，他們會做出「創造新神」這般傲慢自大的事，沒有接受他們的邀請果然是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170754,
						30170755
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170754,
					"content": "這其中也有愚人眾在作祟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170756,
					"content": "「博士」和「散兵」…兩個愚人眾的執行官都在須彌嗎…聽起來前途堪憂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170757
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170757,
					"content": "#不過至少從{F#妳}{M#你}的描述上看，「工程」還沒有徹底完工，應該還有阻止他們的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170758
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170758,
					"content": "可是說起來，「創造新神」與「修復世界樹」之間又有什麼關係呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170759
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170759,
					"content": "是呀，感覺賢者方的目的我們至今還摸不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170760,
						30170761
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170760,
					"content": "先到沙漠去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170762,
					"content": "嗯，現有的情報也整理得差不多了，還是先動身吧…提納里呢，你準備怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170763,
					"content": "我還是打算先留在這裡，海芭夏那邊的情況我還想要再努力一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170764
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170764,
					"content": "#去沙漠的話，{F#妳}{M#你}們可以先到喀萬驛，這是通往沙漠地帶最便捷的路線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170765
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170765,
					"content": "#如果還有什麼我能幫上忙的，請再來這裡找我，願智慧追隨{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170766
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 30170766,
					"content": "好的，也希望海芭夏能夠好起來，那就再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170761,
					"content": "不論如何也要阻止他們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170755,
					"content": "他們可能受到了愚人眾的鼓動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
