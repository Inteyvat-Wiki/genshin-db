			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲",
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "等等，那邊的是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170502,
					"content": "納西妲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "妳果然沒事，真是太好了！我們好擔心妳的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170505,
					"content": "是納西妲的意識吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "#喂，{NICKNAME}，明明是這麼感動的再會，氣氛都要被{F#妳}{M#你}給毀了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170508,
					"content": "派蒙，旅行者提防現在的我是非常明智的，畢竟「博士」展現出過類似操控人們意識的技術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170509,
					"content": "#分別之後，我獨自面對「博士」時發生了什麼，{F#妳}{M#你}們也無從獲知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170510,
					"content": "就像一場災難般的暴雨過後，地上的積水有時也能偽裝成天空一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170511,
					"content": "嗯…我覺得能講出這麼微妙的比喻的人，只能是真的納西妲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170512,
					"content": "我也這麼覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "欸？我剛才不是想博取信任，只是想要講得更好理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170515,
					"content": "好啦好啦，我們知道啦。納西妲快說說，我們離開之後發生了什麼吧？那些民眾怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170516,
					"content": "#{F#妳}{M#你}們離開的時候我正在全力修復所有民眾的意識，好在「博士」所說的「將資訊投放到潛意識」並非是刻寫進大腦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170517,
					"content": "…而是類似在民眾的腦海製造幻覺，以我當下的能力尚能將其解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170518,
					"content": "所幸在他即將把我控制住的一刹那，我完成了民眾意識的修復工作，並使用了意識跳轉成功逃離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170519,
					"content": "還好還好，「博士」這一招的確很出其不意，還好有納西妲在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170520,
					"content": "倒也沒有那麼好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170521,
					"content": "在修復民眾意識的過程中，「博士」已經看出我的真實身分了，我們的底牌又少了一張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170522,
					"content": "而且…他既然有能力對虛空終端進行改造，或許「捕獲」我的意識也只是時間問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170523,
					"content": "是指讓妳沒辦法再這樣自由跳轉意識了嗎，那該怎麼辦…他現在在教令院，的確有可能繼續對虛空動手腳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170524,
					"content": "我們要把握時間了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "可惡…有種被玩弄一樣的感覺，真是難纏的對手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170527,
					"content": "而且據說「博士」好像單憑武力也完全能夠坐穩「第二席」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170528,
					"content": "還不是灰心喪氣的時候，想辦法找找突破口吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170529,
					"content": "嗯，對了，納西妲是怎麼知道我們要來禪那園的？妳是提前在這裡等了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170530,
					"content": "#是的，我能夠感知到{NICKNAME}身上的元素力，循著這股力量移動的方向推斷出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170531
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170531,
					"content": "#{F#妳}{M#你}們來這裡應該不是為了觀光吧？找到什麼線索了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170532
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170532,
					"content": "我們是來找以前認識的一位學者，叫提納里，記得賢者曾經主動聯繫過他。納西妲也跟我們進去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170533,
					"content": "好吧，但願如今的我們不會連累到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30170525,
					"content": "這樣下去我們會越來越被動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "我相信妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "沒有被「博士」動過手腳吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170503,
					"content": "凱瑟琳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				}
			]
		},
		{
