			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔什芬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170301,
					"content": "的確有些棘手呢，這就是傭兵中的精英嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170302,
					"content": "應該不會只有這一波埋伏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "是啊，看來我們以後也要多多提防了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170304,
					"content": "不過「博士」真的有些可怕，是算準了我們會去找提納里嗎，所以才雇人在這裡設下埋伏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170305,
					"content": "和聰明人作對可真是讓人頭痛啊，我們繼續前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
				301704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301704",
							"2"
						],
						"stepId": 301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170401,
					"content": "#欸，旅行者，還有派蒙？{F#妳}{M#你}們怎麼會回來這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170402
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170402,
					"content": "柯萊！又見面了，妳還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170403,
					"content": "我…坦誠地講，不是很好。最近我身上的魔鱗病有加速惡化的趨勢，很多細碎的工作也都變得難以完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170404
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170404,
					"content": "所以提納里師父取消了我的各類巡林任務，只允許我留在這裡協助行政工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170405
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170405,
					"content": "這樣啊…柯萊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170406,
					"content": "看來只有根治世界樹才能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170407
					]
				},
				{
					"id": 30170407,
					"content": "話說提納里呢，是外出巡林了嗎？我們是來找他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170408,
					"content": "提納里師父嗎，他最近剛剛離開了道成林，到禪那園去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170409
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170409,
					"content": "啊？提納里走了？可是…可是過去提納里不是一直不願離開道成林，連賢者的邀請都拒絕了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170410,
					"content": "我也覺得奇怪…提納里師父他一直很看重巡林官的工作，不會輕易離開，可是這次卻匆匆忙忙地走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170411
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170411,
					"content": "他沒說去做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170412,
					"content": "沒有，就連他要走的消息都是留下字條通知我的，各種事務也藉由排班表安排好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170413
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170413,
					"content": "走得這麼匆忙，應該是有什麼分秒必爭的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170414
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170414,
					"content": "妳剛才說提納里去的是禪那園，那是什麼地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170415,
					"content": "提納里師父之前在教令院的生論派進修，而禪那園則類似於生論派的研究基地，種植了各種稀有植被以供研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170416
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170416,
					"content": "我知道提納里師父在成為巡林官以前，曾經有很長一段時間在禪那園專心鑽研學術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170417
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170417,
					"content": "研究基地嗎…提納里到底突發奇想要做什麼研究呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170418,
					"content": "#{NICKNAME}，時間緊迫，那我們就去一趟那個禪那園找他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170419,
						30170420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170419,
					"content": "保重身體，柯萊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				},
				{
					"id": 30170421,
					"content": "啊…嗯，我沒關係，與魔鱗病共生我已經再習慣不過了。見到提納里師父的話，請代我向他問候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170422
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 30170422,
					"content": "好的~我們記住了，再見柯萊~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170420,
					"content": "別太勉強自己，柯萊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				}
			]
		},
		{
			"id": 301705,
			"completionStepIds": [
				301705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301705",
							"2"
						],
						"stepId": 301705,
