			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔什芬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170101,
					"content": "站住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170102,
					"content": "#金髮旅行者，還有飄浮著的小精靈，看來沒錯了。看看周圍，{F#妳}{M#你}們已經中了我們的埋伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170103,
					"content": "你們！你們是「三十人團」的傢伙嗎？是來抓我們的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170104,
					"content": "「三十人團」…我們不是那些幫執政者打雜，又吃力不討好的走狗們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170105,
					"content": "我們可是在須彌收取最高一檔傭金的精英傭兵團，這次是為了完成一位名叫「放逐者」的先生的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170106,
					"content": "「放逐者」…教令院的放逐者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170107,
					"content": "看來是「博士」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "可是「博士」為什麼不直接派愚人眾來抓我們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170109,
					"content": "當地的傭兵團更有優勢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "#還有功夫閒聊這些，看起來{F#妳}{M#你}們是真的不怕死啊。給我上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "塔什芬"
				},
				{
					"id": 30170112,
					"content": "#{NICKNAME}，我們…我們上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30170110,
					"content": "他利用了教令院的資源吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
			"id": 301703,
			"completionStepIds": [
				301703
			],
