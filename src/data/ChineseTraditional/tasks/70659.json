			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"吉蓋克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "#{F#妳}{M#你}好，想試試「風行迷蹤」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590102,
					"content": "「風行迷蹤」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "啊哈，問得好，「風行迷蹤」是一款承載著蒙德城歷史的遊戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590104,
					"content": "#{F#妳}{M#你}應該知道，在之前的蒙德城裡有一群「貴族」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590105,
					"content": "他們在蒙德城裡暴行不斷，讓不少人都苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590106,
					"content": "為了反抗貴族們的種種暴行，有一群勇敢的蒙德人聚集了起來，形成了一個秘密的反抗組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590107,
					"content": "這群遊俠們不斷在蒙德各處展開行動，讓貴族們吃足苦頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590108,
					"content": "但是，那些貴族們也很快訓練出了一群用來鎮壓遊俠們的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590109,
					"content": "於是，遊俠們和貴族的爪牙們，就這樣在蒙德各處展開了一場又一場的對決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590110,
					"content": "「風行迷踪」正是取材於自這史詩級的真實歷史事件！曾經也是很受歡迎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590111,
					"content": "曾經？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "是啊，現在城裡的年輕人們對於「風行迷踪」可沒多少興趣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590113,
					"content": "但我可不想讓「風行迷踪」就此失傳，所以，我對它原來的規則做了些調整，讓遊戲規則更容易理解，也更有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706590114,
					"content": "除此之外，我還特地添加了好幾張全新的遊戲地圖。我覺得，這樣應該會有更多的人來玩吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉蓋克斯"
				}
			]
		},
		{
			"id": 7065903,
