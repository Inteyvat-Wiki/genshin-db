					}
				]
			},
			"dialogs": [
				{
					"id": 745160101,
					"content": "榮譽騎士和白色小幫手，好消息來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160102
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160102,
					"content": "這位是執律庭的昂吉安妮警官，她已將放生徒背後的供貨商逮捕歸案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160103
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160103,
					"content": "哼！店門被我踹開的時候，那小子還在數錢…真是個重量級混蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160104
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160104,
					"content": "#{F#妳}{M#你}們的高強度捕捉也有顯著成效，這片水域的外來魚種明顯減少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160105
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160105,
					"content": "按照這個速度，理論上再過不久本次生物入侵的問題就可以徹底解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160106
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160106,
					"content": "好耶！不用再擔心楓達…不對，是楓丹的水質被影響了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160107,
					"content": "#追獵者小姐也真是本事了得！居然請得動「超天頂級領隊戰力」{NICKNAME}來幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160108,
					"content": "那句老話是什麼…對，艦炮轟漁鷗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160109,
						745160110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160109,
					"content": "偶爾轟一轟搶薯條的漁鷗也可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				},
				{
					"id": 745160111,
					"content": "對了，這位昂吉安妮警官好像有點眼熟耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160112,
					"content": "是因為我們經常幫忙維護秩序，看過不少治安工作者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160113,
						745160116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160113,
					"content": "初次見面，有點熟悉的警官！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160114
					]
				},
				{
					"id": 745160114,
					"content": "哈，太正式了！以後我們還有的是機會合作，輕鬆點，自然點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160115,
					"content": "#不然下次要是遇到什麼事需要{F#妳}{M#你}們的支援，我就必須擺出嚴肅和敬重的樣子…那樣太累了，我做不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160121
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160121,
					"content": "唔欸…忙這麼久了嗎？總算可以下班了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160122
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160122,
					"content": "#我要去鏽舵喝兩杯，等著看那小子和放生徒們上新聞被罵…{F#妳}{M#你}們一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160123
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160123,
					"content": "謝謝妳的好意，昂吉安妮警官。不過我不敢放鬆警惕，不知道生命力強大的入侵魚類會不會引發什麼新的意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160124
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160124,
					"content": "等徹底清除掉這片水域的外來物種…我一定來找妳好好喝一杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160125
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 745160125,
					"content": "喔！看來妳還動力滿滿，短時間內停不下來，那就這樣約好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160126
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160126,
					"content": "妳就全心全意，加油努力好好做吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160127
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160127,
					"content": "哲倆阿回到水邊繼續去監視水域的情況了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745160128
					]
				},
				{
					"id": 745160128,
					"content": "哲倆阿小姐…是不是有點太拼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160129,
					"content": "哎呀哎呀，我猜…以前她應該是遇到了某個責任感超強的人，深受感染…完全可以理解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160130,
					"content": "看她這個氣勢，我都不好意思偷懶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160131,
						745160133
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160131,
					"content": "有動力是好事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160132
					]
				},
				{
					"id": 745160132,
					"content": "#一直努力值得尊敬，不過也要學學{NICKNAME}，適當平衡工作與生活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160135,
					"content": "#那…如果以後我要和{F#妳}{M#你}們學學工作時間管理的小技巧，{F#妳}{M#你}們不能不教我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160136
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160136,
					"content": "#總之…我會向上頭申請將這次行動的經費——尤其是給{F#妳}{M#你}們兩位的酬勞…提升到「主力艦炮運作成本」的等級才可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160137
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160137,
					"content": "#希望下次遇到麻煩的時候，趕到現場又可以碰到{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160138
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160138,
					"content": "#然後聽{F#妳}{M#你}們叉著腰笑著跟我說：「問題已經解決啦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160133,
					"content": "如果可以平衡工作跟生活就更好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160134
					]
				},
				{
					"id": 745160134,
					"content": "#對對對，{NICKNAME}就是這方面的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745160116,
					"content": "以前我們合作過吧，這位警官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160117
					]
				},
				{
					"id": 745160117,
					"content": "還記得我？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160118,
					"content": "下次再見面的時候就可以像同事一樣輕鬆交流…不用說個話都要考慮語氣，小心翼翼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160119,
						745160120
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745160119,
					"content": "好啊，自然一點自然一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160120,
					"content": "以後有事我們互相多照應！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160110,
					"content": "我也可以學習多用途艦炮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				}
			]
		}
	]
}