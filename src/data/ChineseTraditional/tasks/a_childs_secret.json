				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}，看那邊看那邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100102,
					"content": "她、她是一個人站著的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100103,
					"content": "#可她明明在跟別人說話啊！{F#妳}{M#你}看、{F#妳}{M#你}看她還笑了！嗚嗚嗚，好嚇人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100104,
					"content": "我小時候也會和「幻想朋友」玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#嗚哇？{NICKNAME}，{F#妳}{M#你}以前也會做這種事嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100106,
					"content": "#難道是出現了幻覺？還是說，真的有那種看不見的朋友在陪{F#妳}{M#你}玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100107,
					"content": "幻覺就是幻想朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "幻想朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100111,
					"content": "哦，那就是…「想像出來的朋友」啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100112,
					"content": "#{F#妳}{M#你}的「幻想朋友」長什麼樣子，給我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100113,
					"content": "現在不太出現了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "哎？難道「幻想朋友」，在人長大以後就會消失嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100116,
					"content": "是啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#唔…本來還想見識一下的…對了，{F#妳}{M#你}的{F#哥哥}{M#妹妹}也有幻想朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100119,
					"content": "是有的喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "居然也有！這也太方便了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100121,
					"content": "#{F#妳}{M#你}有沒有聽過一種來自璃月的牌戲？一般是四個人玩，你們兩個人就能玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100122,
					"content": "旅行者！真巧啊，你們也在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100123,
					"content": "賣唱的，怎麼又是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100124,
					"content": "哈哈，是因為麗莎最近做了些有趣的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100125,
					"content": "麗莎說的「有趣」，讓我感覺怕怕的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100126,
					"content": "嘿，別這樣評價一位淑女嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100127,
					"content": "為了做這件有趣的東西，她可是特地從須彌弄來了一批危險材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100128,
					"content": "你剛剛說「危險」了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100129,
					"content": "這是眼鏡型探測儀嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "沒錯，雖然長得像單片眼鏡，但它是一台探測儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100133,
					"content": "可惜麗莎自己用不了，所以我就把它借來玩啦，順便也幫她做做實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100134,
					"content": "咦？為什麼麗莎用不了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100135,
					"content": "這個嘛…該說是缺了一些自由自在的童心呢？還是因為別的什麼原因呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100136,
					"content": "下次你們自己問問她就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100137,
					"content": "那麼，溫迪你能看見的吧？快告訴我，這傢伙的幻想朋友長什麼樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100138,
					"content": "嗯，這個嘛…保密^_^",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100139,
					"content": "#總之東西已經給{F#妳}{M#你}了，{F#妳}{M#你}來試試，看諾拉的「幻想朋友」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100140,
					"content": "怎麼樣怎麼樣？能看見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100141,
					"content": "真的有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "#果然，{F#妳}{M#你}戴上這個以後，也能看見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100144,
					"content": "可惡，我也想看！——但這個探測儀的尺寸我沒法戴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}，就靠{F#妳}{M#你}了！我們去看看<color=#00E1FFFF>其他人</color>的幻想朋友都長什麼樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100142,
					"content": "是個跟她很合得來的孩子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "長得好像一副單片眼鏡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "對吧？我也這麼覺得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100117,
					"content": "很遺憾，但確實是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "已經看不見了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "幻想朋友就是幻覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "幻覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芙蘿拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "#{F#妳}{M#你}看，那就是她的幻想朋友。嗯，一株輕飄飄的植物…是蓬蓬果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100204,
					"content": "幻想朋友也可以是植物嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100205,
					"content": "呼呼，旅行者，詩人，你們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 101100206,
					"content": "妳好，可以問妳一些事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "好啊，找芙蘿拉有什麼事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 101100209,
					"content": "妳身邊那個是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "#咦？{F#妳}{M#你}能看到蓬蓬？別人都看不到蓬蓬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 101100211,
					"content": "蓬蓬是我最好的朋友了，我們從小一起長大的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 101100216,
					"content": "（呃…這種只有我被排除在外的感覺…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101100217,
					"content": "芙蘿拉，為什麼妳的朋友會是一株蓬蓬果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101100218,
					"content": "為什麼不可以呢？我一直很想跟會飛的植物做朋友。",
