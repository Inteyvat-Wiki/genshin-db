			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "這座棲木也好了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270302,
					"content": "太厲害了！這就是真正的冒險家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270303,
					"content": "唔…之前也有別人來過這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270304,
					"content": "#但是，都不如{NICKNAME}{F#姐姐}{M#哥哥}和派蒙這麼厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270305,
					"content": "別人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270306,
					"content": "嗯，他們是來找木簧笛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270307,
					"content": "難道是墨田…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "不過，木簧笛到底是什麼呀？雖然之前聽說是鶴觀人的樂器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270310,
					"content": "嗯~的確是一種能發出聲音的裝置哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270311,
					"content": "因為霧海，我們這不是很難看清楚東西嗎？所以大家就會用木簧笛來傳達自己的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270312,
					"content": "畢竟靠喊的太吵啦！而且對嗓子不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270313,
					"content": "確實什麼都看不見呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270314,
					"content": "對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270315,
					"content": "爸…又爺爺還說，木簧笛的聲音可以讓迷失在霧裡的靈魂找到回家的路。所以是很重要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270316,
					"content": "嗯？原來這麼重要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270317,
					"content": "難怪祭典會需要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#嗯，祭典一定能讓{NICKNAME}{F#姐姐}{M#哥哥}和派蒙開心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270319,
					"content": "#{F#妳}{M#你}們先走吧！我還想在樹下待一陣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270320,
					"content": "沒問題嗎？外面可能有魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270321,
					"content": "沒問題的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270308,
					"content": "難怪凱瑟琳小姐說是高難度委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
