			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿瑠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#{NICKNAME}{F#姐姐}{M#哥哥}戰鬥的樣子，好帥氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270102,
					"content": "原來阿瑠在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270103,
					"content": "沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "我沒事喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270106,
					"content": "那些魔物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "不知道這些怪物是什麼地方來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270109,
					"content": "的確，看起來不像是這裡的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270110,
					"content": "嗯。以前，我們這裡是沒有這些東西的，也沒有那些身上很多毛的人和大機器人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270111,
					"content": "以前，我們這裡有一種叫「鵜猿獸」的動物。但是牠很溫順，而且也很好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270112,
					"content": "沒聽說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "我想也是呢。在我們這裡，從什麼時候開始，鵜猿獸都消失了，這些傢伙卻出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270114,
					"content": "不知道是不是從「霧海」外面來的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270115,
					"content": "外面也有丘丘人之類的魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "聽起來好危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270117,
					"content": "確實很危險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "不過，冒險的經歷也很有趣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270120,
					"content": "我也好想冒險哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270121,
					"content": "那阿瑠要好好長大，然後變成了不起的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270122,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "阿瑠"
				},
				{
					"id": 722270123,
					"content": "那這座棲木也交給我們吧。畢竟有魔物，阿瑠到處亂跑的話會很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722270124,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "不過，冒險很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "沒受傷吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
