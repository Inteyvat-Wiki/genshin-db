			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010301,
					"content": "降諸魔山的南方…這範圍也太遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010302,
					"content": "這裡視野不錯，我們就在這裡先等等，看會不會有人過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010303,
					"content": "和派蒙在此等待…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738010304
					]
				},
				{
					"id": 738010304,
					"content": "看，那邊有人來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010305,
					"content": "怎麼來得這麼晚，是遇見什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010306
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010306,
					"content": "…抱歉，箱子好像被人翻過了，我們的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010307
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010307,
					"content": "嘖，難道是被發現了？不對…最近上面也沒來過人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010308
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010308,
					"content": "也許…也許是尼卡翻的呢？那群孩子最近總是過來央求我帶他們出去玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010309
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010309,
					"content": "唉…所以我說，除了必要的交際之外，不要和那些居民走太近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010310
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010310,
					"content": "可是，他們的父母總是不在家，我實在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010311
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010311,
					"content": "算了，先不管這些，無論如何，今天我們都要離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010312
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010312,
					"content": "離開？他們的意思是…要離開須彌嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010313,
					"content": "我們沒有幫手，那個計畫…真的會成功嗎？要是被上面的人知道了的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010314
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010314,
					"content": "管不了那麼多了…妳是還沒有受夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010315
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010315,
					"content": "天天提心吊膽，時時刻刻都被人提防…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010316
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010316,
					"content": "想要從愚人眾裡脫身，今天就是最後的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010317
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010317,
					"content": "我、我知道，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010318
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010318,
					"content": "這兩個人…想要脫離愚人眾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010319,
					"content": "出去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010320
					]
				},
				{
					"id": 738010320,
					"content": "嗯，不過還是要小心，他們可是愚人眾啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7380104,
			"completionStepIds": [
				7380104
			],
			"beginWay": "TALK_BEGIN_AUTO",
