			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010201,
					"content": "喔！箱子打開了！意外地不算困難呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010202,
						738010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010202,
					"content": "我來看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				},
				{
					"id": 738010204,
					"content": "唔唔唔，總之…先看看裡面裝著什麼東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010205,
					"content": "這裡面…看起來都是一些舊衣服，還有一疊信紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010206,
					"content": "上面寫著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010207,
					"content": "「降諸魔山南，舊船離港。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010208,
					"content": "這都是什麼呀？明明是在山裡，怎麼會有船呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010209,
						738010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010209,
					"content": "也許是什麼密語…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010211,
					"content": "唔…那我們也只能去看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010210,
					"content": "愚人眾在謀劃著什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010203,
					"content": "這箱子難道和那兩個愚人眾有關…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				}
			]
		},
		{
			"id": 7380103,
			"completionStepIds": [
				7380103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
