			},
			"dialogs": [
				{
					"id": 738010801,
					"content": "抱歉…咳咳…普熱瓦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010802
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010802,
					"content": "少說廢話。我先給妳包紮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010803
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010803,
					"content": "嗚嗚…嗚…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010804
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010804,
					"content": "你來這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010805
					]
				},
				{
					"id": 738010805,
					"content": "我…我是來這裡摘蘑菇的…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010806
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010806,
					"content": "因為亞歷山德拉姐姐最近…最近好像很難過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010807
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010807,
					"content": "所以我們就商量，要給亞歷山德拉姐姐做好吃的，給她一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010808
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010808,
					"content": "之前亞歷山德拉姐姐帶我們來這裡，摘了很多好吃的蘑菇，我就想要自己過來摘一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010809
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010809,
					"content": "但是，但是進了樹林我就迷路了，然後就被好多蘑菇圍住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010810
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010810,
					"content": "亞歷山德拉姐姐…亞歷山德拉姐姐為了救我…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010811
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010811,
					"content": "咳…別…別擔心，尼卡…姐姐沒事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010812
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010812,
					"content": "…旅行者，看來計畫要變更了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010813
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010813,
					"content": "亞歷山德拉傷勢太重，我們擅自離城應該已經被其他的愚人眾發現了，現在我帶著負傷的她回去，只怕會被抓著盤查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010814,
						738010815
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010814,
					"content": "那你們的計畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				},
				{
					"id": 738010816,
					"content": "呵呵…只能將計就計了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010817
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010817,
					"content": "我剛才在過來的時候，看見有一支鍍金旅團的隊伍正在往這邊走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010818
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010818,
					"content": "#旅行者，{F#妳}{M#你}把這個小鬼先送出樹林，交給鍍金旅團的人，我會帶著亞歷山德拉離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010819
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010820
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010820,
					"content": "還記得我們商量好的話術嗎？看來這次我們得假戲真做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010821
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010821,
					"content": "鍍金旅團的那個人一定會認為，我們這兩個不懷好意的愚人眾，是在這裡進行某種不懷好意的計畫，搭救尼卡只是一種掩飾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010822
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010822,
					"content": "至於我們被魔物群起攻之…那就是我們罪有應得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010823
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010823,
					"content": "嗚…亞歷山德拉姐姐…我再也不搗亂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010824
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010824,
					"content": "…好在這小鬼頭現在應該也沒有心思聽我們說的話，不用擔心他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010825,
						738010826
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010825,
					"content": "但你們是為了救人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010827,
					"content": "相信我，比起「愚人眾英勇犧牲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010828
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010828,
					"content": "他們更容易接受「不懷好意的愚人眾們自食其果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010829
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010829,
					"content": "#還記得{F#妳}{M#你}第一次偷聽我和亞歷山德拉講話的地方嗎？如果…我們成功逃脫了，我會留一封信在那裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010830
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010830,
					"content": "從一開始，你們就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010831
					]
				},
				{
					"id": 738010831,
					"content": "我們只有這麼一次機會，不得不謹慎一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010832
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010832,
					"content": "現在應該先救亞歷山德拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010833
					]
				},
				{
					"id": 738010833,
					"content": "沒關係，旅行者…咳…我還撐得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010834
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010834,
					"content": "…要是錯過了這次機會，讓我再回去做愚人眾，我寧願…咳…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010835
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010835,
					"content": "亞歷山德拉姐姐，妳要去哪？我們一起回去吧！大家都在找妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010836
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010836,
					"content": "尼卡…聽話，這位旅行者會帶你出去…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010837
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010837,
					"content": "姐姐…要在這裡休息一會，休息好了就會回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010838
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010838,
					"content": "可…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010839
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010839,
					"content": "姐姐什麼時候騙過你？咳咳…聽話，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010840
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010840,
					"content": "嗚…嗚嗚…好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010841
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010841,
					"content": "#旅行者，就拜託{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010842,
						738010843
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010842,
					"content": "我馬上回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010844,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010843,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010826,
					"content": "但你們沒有不懷好意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010815,
					"content": "那你們怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				}
			]
		},
		{
			"id": 7380109,
