			},
			"dialogs": [
				{
					"id": 738010101,
					"content": "…新生意談好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010102
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010102,
					"content": "舊貨船剛剛卸好了貨，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010103
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010103,
					"content": "船沒漏吧？<color=#00E1FFFF>上面的貨…</color>都藏好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010104
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010104,
					"content": "都藏好了，藏得嚴嚴實實的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010105
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010105,
					"content": "但是…換下來的老物件怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010106
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010106,
					"content": "今天就作廢掉。新貨到了手…老物件就可以丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010107
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010107,
					"content": "真、真的沒問題嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亞歷山德拉"
				}
			]
		},
