			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"普熱瓦",
					"亞歷山德拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010401,
					"content": "呵呵，終於還是有人來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010402
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010402,
					"content": "你發現我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010403
					]
				},
				{
					"id": 738010403,
					"content": "#{F#妳}{M#你}聽的時間太久，一直沒有動過位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010404
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010404,
					"content": "#剛才有一陣風吹過，{F#妳}{M#你}藏身的那叢灌木擺動的樣子，明顯和旁邊的灌木不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010405
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010405,
					"content": "不、不愧是愚人眾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010406,
					"content": "#金髮…還有旁邊的奇異仙靈。看來{F#妳}{M#你}就是報告上提到的那位「旅行者」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010407,
						738010408
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010407,
					"content": "沒錯，就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010410
					]
				},
				{
					"id": 738010410,
					"content": "#{F#妳}{M#你}既然來了這裡，那就證明{F#妳}{M#你}已經看過了箱子裡的東西了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010411
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010411,
					"content": "真沒想到，亞歷山德拉的小機靈居然真能派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010412,
						738010413
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010412,
					"content": "你們到底想做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010414,
					"content": "#就和{F#妳}{M#你}聽到的一樣，我和亞歷山德拉兩個人，想要脫離愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010415
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010415,
					"content": "別這麼看著我，我們可不是大權在握的高層，也不是駐紮在前線的戰鬥人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010416
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010416,
					"content": "充其量…只能算是被隨便丟在一個地方等候調遣的「釘子」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010417
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010417,
					"content": "和我們一樣身分的人有很多，但是…他們大部分都不會等到任何命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010418
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010418,
					"content": "就這樣抱著「愚人眾」的身分，在人們的提防裡度過餘生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010419
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010419,
					"content": "我們可不想這樣。與其待在這裡浪費生命，不如拼上一把，從此離開愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010420
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010420,
					"content": "但愚人眾可不是那麼好脫離的，如果被人知道了這件事，我們一定…不會有什麼好下場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010421
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010421,
					"content": "所以，我們就制定了一份「假死」的計畫，希望能以此脫身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010422
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010422,
					"content": "但我們的「死亡」，需要一個說話足夠有說服力的人來作證才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010423
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010423,
					"content": "#旅行者，{F#妳}{M#你}在愚人眾裡可以說是大名鼎鼎，而且…呵呵，{F#妳}{M#你}也和愚人眾有很大的過節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010424
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010424,
					"content": "#讓{F#妳}{M#你}見證兩個「愚人眾」的死亡，實在是再適合不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010425,
						738010428
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010425,
					"content": "#{F#妳}{M#你}就這麼確定我會來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010426
					]
				},
				{
					"id": 738010426,
					"content": "#我並不確定{F#妳}{M#你}會來，但我會等到{F#妳}{M#你}來為止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010427
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010427,
					"content": "耐心，是我為數不多的優點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010431,
					"content": "#旅行者，現在我們已經把事情都告訴{F#妳}{M#你}了，幫不幫忙，就由{F#妳}{M#你}來選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010432
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010432,
					"content": "#如果{F#妳}{M#你}願意幫忙，我們也會給{F#妳}{M#你}一大筆報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010433
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010433,
					"content": "#這些報酬是我和普熱瓦去正經工作賺來的錢，{F#妳}{M#你}也不用有什麼顧慮的，真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010434
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010434,
					"content": "我…我去給那些孩子們做晚飯，幫他們縫衣服、講故事、帶他們出去玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010435
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010435,
					"content": "普熱瓦去幫人家打獵，還有處理獵物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010436
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010436,
					"content": "我們離開愚人眾之後，也準備用這些手藝來謀生呢！還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010437
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010437,
					"content": "亞歷山德拉！少說幾句！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010438
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010438,
					"content": "喔…哦！好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010439
					],
					"speakerTitle": "亞歷山德拉"
				},
				{
					"id": 738010439,
					"content": "#總之，選擇權在{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010440,
						738010442
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010440,
					"content": "我會幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010441
					]
				},
				{
					"id": 738010441,
					"content": "#謝謝{F#妳}{M#你}，旅行者，{F#妳}{M#你}會拿到豐厚的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010447,
					"content": "那我們就說定了，事不宜遲，我們現在就去分頭準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010448
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010448,
					"content": "#亞歷山德拉，那邊就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010449
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010449,
					"content": "#旅行者，請{F#妳}{M#你}隨我過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010442,
					"content": "你們不怕我翻臉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010443
					]
				},
				{
					"id": 738010443,
					"content": "那我們也會盡力抵抗，最後…不敵身亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010444
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010444,
					"content": "聽上去差不多，對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010445
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010445,
					"content": "你們的報酬最好夠多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010446
					]
				},
				{
					"id": 738010446,
					"content": "放心吧，絕對是一個足夠豐厚的數額。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010428,
					"content": "如果今天不是我來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010429
					]
				},
				{
					"id": 738010429,
					"content": "#那我們就會回去。直到{F#妳}{M#你}來為止，計畫才會繼續推進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010430
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010430,
					"content": "我們已經籌備了很久，不差這麼一點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010413,
					"content": "剛才那些話，也是說給我聽的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010408,
					"content": "你們是設下陷阱等我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010409
					]
				},
				{
					"id": 738010409,
					"content": "放心吧，我們可沒有那個時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010410
					],
					"speakerTitle": "普熱瓦"
				}
			]
		},
		{
			"id": 7380105,
			"completionStepIds": [
				7380105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380105",
							"2"
						],
						"stepId": 7380105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"普熱瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010501,
					"content": "就是這裡了。旅行者，計畫很簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010502
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010502,
					"content": "我們是兩個…呵呵，不懷好意的愚人眾，前來這片樹林裡做一些不懷好意的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010503
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010503,
					"content": "#而{F#妳}{M#你}，無論是出於義憤，還是出於維護正義的態度，出手試圖制止我們行惡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010504
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010504,
					"content": "在交手的過程中，我和亞歷山德拉準備逃跑，但突然有一群魔物闖入，而我們也被那群魔物給打倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010505
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010505,
					"content": "#而{F#妳}{M#你}因為魔物的數量太多，也只好撤退，等帶人過來的時候，我和亞歷山德拉也已經不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010506
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010506,
					"content": "#故事就是這樣，{F#妳}{M#你}覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010507,
						738010509
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010507,
					"content": "你可真是熟練啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010508
					]
				},
				{
					"id": 738010508,
					"content": "為了把這個故事講得合理，同時讓我們被打倒得更自然一點，我可是花了很大的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010512,
					"content": "不過，亞歷山德拉怎麼還沒回來，只是布置一些魔物誘餌，至於用這麼長時間嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010513
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010513,
					"content": "亞歷山德拉姐姐！亞歷山德拉姐姐！嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010514
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738010514,
					"content": "那、那邊有人的聲音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010515,
					"content": "糟了，亞歷山德拉出事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010516
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010516,
					"content": "喂！等等！你去做什麼啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010517,
					"content": "快追上去！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010518
					]
				},
				{
					"id": 738010518,
					"content": "到底發生了什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010509,
					"content": "很像是愚人眾會有的下場。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010510
					]
				},
				{
					"id": 738010510,
					"content": "沒錯，愚人眾裡在外做情報的「釘子」，一般都會落到這種下場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010511
					],
					"speakerTitle": "普熱瓦"
				},
				{
					"id": 738010511,
					"content": "我們正是不想就這麼消失，才做的這次計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "普熱瓦"
				}
			]
		},
		{
			"id": 7380108,
			"completionStepIds": [
				7380108
			],
