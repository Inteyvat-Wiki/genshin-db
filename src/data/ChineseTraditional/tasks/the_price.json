			},
			"dialogs": [
				{
					"id": 738010901,
					"content": "沒想到這趟差事要繞這麼遠，真是累死人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010902
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738010902,
					"content": "那邊的，什麼人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010903
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738010903,
					"content": "尼卡…還有旅行者，你們怎麼跑到這裡來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010904,
						738010905
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738010904,
					"content": "請照顧一下尼卡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010906
					]
				},
				{
					"id": 738010906,
					"content": "我，我們在趕時間！尼卡就拜託你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738010907,
					"content": "#哈？什麼亂七八糟的，{F#妳}{M#你}給我等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738010905,
					"content": "前面有人遇襲了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010906
					]
				}
			]
		},
		{
			"id": 7380110,
			"completionStepIds": [
				7380110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
