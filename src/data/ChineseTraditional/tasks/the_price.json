			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738011001,
					"content": "亞歷山德拉應該就在這附近啊，他們…他們去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011002,
						738011003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011002,
					"content": "亞歷山德拉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011004
					]
				},
				{
					"id": 738011004,
					"content": "你們在哪呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738011005,
					"content": "別叫了，再叫就把魔物引來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011006
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011006,
					"content": "我都聽尼卡說了，真沒想到，亞歷山德拉和普熱瓦居然是愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011007
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011007,
					"content": "平常我和他們打交道的時候，還覺得他們是好人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011008
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011008,
					"content": "亞歷山德拉姐姐就是好人！普熱瓦哥哥很兇…但也是好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011009
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738011009,
					"content": "哎呀，但他們可是愚人眾啊，誰知道是不是裝成一副好人樣，背地裡打什麼鬼主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011010
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011010,
					"content": "愚人眾的那些著名「事蹟」，我可是聽了不少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011011
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011011,
					"content": "說不定，他們就是在這裡盤算著什麼陰謀，搭救尼卡只不過是一種掩護呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011012,
						738011013
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011012,
					"content": "他們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011014
					]
				},
				{
					"id": 738011014,
					"content": "那可不好說。不過，現在也找不到這兩個人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011015
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011015,
					"content": "他們還帶著一個傷患…以我的經驗，大概已經被魔物給…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011016
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011016,
					"content": "貝拉特哥哥！求求你了，再找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011017
					],
					"speakerTitle": "尼卡"
				},
				{
					"id": 738011017,
					"content": "尼卡，如果我不是一個人過來，我保證會帶著人搜遍森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011018
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011018,
					"content": "但現在我只有一個人啊，先不說魔物，如果有其他的愚人眾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011019
					],
					"speakerTitle": "貝拉特"
				},
				{
					"id": 738011019,
					"content": "咳，總之…旅行者，我們先回去城裡吧，我會向團長報告這件事，等他做出判斷後，我會根據命令行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
