			"dialogs": [
				{
					"id": 732250101,
					"content": "（凌亂奔逃的腳印，有深有淺，甚至有跌倒在沙中的痕跡…顯然不久前有人慌不擇路地逃命，才會留下這些腳印。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250102
					],
					"speakerTitle": "調查"
				},
				{
					"id": 732250102,
					"content": "哇…好亂的腳印…看起來…好可怕…我們還是快點走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250103,
					"content": "放心，這裡沒什麼可怕的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250104
					]
				},
				{
					"id": 732250104,
					"content": "就是因為這樣才嚇人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
