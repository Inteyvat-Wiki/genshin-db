			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251402,
					"content": "也就是說…她從一開始就布下了這個陷阱，只等我們稀裡糊塗地踏進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251403
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251403,
					"content": "等等…為什麼…不早給我看這些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251404
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251404,
					"content": "可是那時妳看見我們就開打，也聽不進去道理呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251405,
					"content": "#呃…唉，對不起啦，{F#妳}{M#你}們都沒事就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251406,
					"content": "不管怎樣，我們要回去找她問清楚這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251407
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251407,
					"content": "唔…好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251408
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251408,
					"content": "先休息一會也來得及。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251409
					]
				},
				{
					"id": 732251409,
					"content": "嗯，是呀…沒必要太著急的，反正現在我們隨時可以回去，但芭別爾她要等著我們才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251410,
					"content": "派蒙說得對，現在我們才是主動方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251411
					]
				},
				{
					"id": 732251411,
					"content": "#{M#嗯，你說得對…抱歉，之前沒能信任你…}{F#主動方…嗎？嗯…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251412
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251412,
					"content": "好啦，婕德，妳傷在哪裡啦？我們來幫忙包紮一下傷口吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251413,
					"content": "傷在哪裡？噗…哪裡都是。不過沒關係啦…我還能撐住就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251414
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251414,
					"content": "不要任性了，讓我們看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251415
					]
				},
				{
					"id": 732251415,
					"content": "#{M#唉…好吧，抱歉…}{F#嗯…好吧…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251416
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251416,
					"content": "#於是，{F#妳}{M#你}們決定在這裡稍作休息，簡單地搭起了營火…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251417
					]
				},
				{
					"id": 732251417,
					"content": "#{M#你為婕德仔細包紮了傷口，伴著火光一同休息了半晌。\\n在無言的默契中，你們已經決定好了下一步行動。}{F#妳為婕德仔細包紮了傷口，伴著火光一同休息了半晌…\\n婕德在妳身邊安睡了許久，血與汗的氣息混合著胡楊枝燃燒的焦味，也沒能掩蓋她身上淡淡的香料味道。\\n她的鼾聲輕細，囈語荒唐…看來她真的累壞了。\\n待她醒來後，妳們已經達成了默契，決定好了下一步行動。}",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251418
					]
				},
				{
					"id": 732251418,
					"content": "…我們走吧，去找芭別爾。讓她解釋清楚這一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		}
	]
