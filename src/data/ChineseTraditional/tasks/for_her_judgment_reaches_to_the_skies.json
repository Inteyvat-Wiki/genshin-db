			},
			"dialogs": [
				{
					"id": 732250201,
					"content": "（被外力砸爛的板條箱，點點痕跡暗示裡面曾經裝著什麼活物…但無論那是什麼，現在它們都自由了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250202
					],
					"speakerTitle": "調查"
				},
				{
					"id": 732250202,
					"content": "唔…這氣味…真是不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250203,
					"content": "咳、咳…！我們別留在這裡啦，前面還有別的遺骸，說不定能引導我們找到婕德所在的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7322503,
