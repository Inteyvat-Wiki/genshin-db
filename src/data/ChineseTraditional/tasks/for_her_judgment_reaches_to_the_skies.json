			"dialogs": [
				{
					"id": 732250301,
					"content": "（質地堅韌的帆布，可能曾經是愚人眾的旗幟或帳篷。已經被撕裂、無從分辨形狀了。）",
					"roleType": "TALK_ROLE_NPC",
