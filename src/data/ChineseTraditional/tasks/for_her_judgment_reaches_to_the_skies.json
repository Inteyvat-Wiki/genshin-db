				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251301,
					"content": "呼…呼…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251302
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251302,
					"content": "沒錯，是婕德！她好像受傷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251303,
					"content": "布列達…戈瓦法…伊吉德爾…梅杜爾…忒雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251304
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251304,
					"content": "烏薩德…塔夫列…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251305
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251305,
					"content": "那是…人名嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251306,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251307
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251307,
					"content": "#{NICKNAME}…{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251308,
					"content": "抱歉，我有點喪失理智了…被他們抓了，真是抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251309
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251309,
					"content": "那種事先放一邊啦，妳受傷了嗎？嚴重嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251310,
					"content": "#過來吧，{F#妳}{M#你}們。我有話要和{F#妳}{M#你}們說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251311
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251311,
					"content": "#告訴我，{F#妳}{M#你}還記得母親的名字。然後，用{F#妳}{M#你}的劍來證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251312
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251312,
					"content": "妳…妳在說什麼啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251313,
					"content": "#告訴我，{F#妳}{M#你}們不是可恥的叛徒，然後證明它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251314,
						732251316
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251314,
					"content": "妳冷靜一下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251315
					]
				},
				{
					"id": 732251315,
					"content": "#我很冷靜，{F#妳}{M#你}的劍在哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251316,
					"content": "我不是叛徒，妳這是怎麼了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251317
					]
				},
				{
					"id": 732251317,
					"content": "#{F#妳}{M#你}不是叛徒，就用劍證明自己的清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
