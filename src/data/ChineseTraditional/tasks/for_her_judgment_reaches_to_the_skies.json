				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奈蘭",
					"雷茲吉",
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250401,
					"content": "呼…呼…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250402,
					"content": "現在我們可以好好談談了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250403
					]
				},
				{
					"id": 732250403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250404
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250404,
					"content": "我不會動手的，我需要妳相信我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250405
					]
				},
				{
					"id": 732250405,
					"content": "#隨便吧，先是阿薩里格，然後又是{F#妳}{M#你}…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250406,
					"content": "妳冷靜一點，我們都被騙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250407
					]
				},
				{
					"id": 732250407,
					"content": "對呀！妳說主母交待妳追蹤我們，因為我們叛變了…可她同樣給了我們相同的任務，要我們來追蹤妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250408,
					"content": "我們相信妳肯定不會叛變的，所以想著找到妳好好談談這件事到底是怎麼回事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250410
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250410,
					"content": "我沒有叛變，我也沒有理由背棄部族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250411
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250411,
					"content": "#芭別爾主母那邊有人證，尤夫騰目睹了{F#妳}{M#你}們和北方人的交易，馬塞拉也看到{F#妳}{M#你}們和北方人在營帳附近活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250412
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250412,
					"content": "怎麼可能！芭別爾她也跟我們說…她有人證能證明妳叛變了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250413,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250414
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250414,
					"content": "#所以，{F#妳}{M#你}們叛變的事情，到底是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250415
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250415,
					"content": "唔…我們也不知道呀…妳還是聽我們說啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250416,
					"content": "假如芭別爾決心要離間妳我的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250438
					]
				},
				{
					"id": 732250438,
					"content": "他們會替我說話，還是替主母說話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250417
					]
				},
				{
					"id": 732250417,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250418
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250418,
					"content": "對呀，婕德！妳是更相信我們，還是他們兩個呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250419,
					"content": "派蒙，別吵。這件事是很不對勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250420
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250420,
					"content": "呼…妳終於把刀收起來了，可別再拿出來啦！看著怪嚇人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250421,
					"content": "話別說得太早，小傢伙…她的刀，還用得上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250422
					],
					"speakerTitle": "奈蘭"
				},
				{
					"id": 732250422,
					"content": "奈蘭、雷茲吉！你們怎麼來了？這裡只需要我一個人就能搞定，你們不必來幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250423
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250423,
					"content": "#嗯，我看得出來。妳做得挺不錯，婕德…但{F#妳}{M#你}們兩個，我們出馬才能搞定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250424
					],
					"speakerTitle": "奈蘭"
				},
				{
					"id": 732250424,
					"content": "…還有一個小精靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250425
					],
					"speakerTitle": "雷茲吉"
				},
				{
					"id": 732250425,
					"content": "哦，還有個小精靈。我還挺喜歡她的，留著她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250426
					],
					"speakerTitle": "奈蘭"
				},
				{
					"id": 732250426,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250427,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250428
					],
					"speakerTitle": "雷茲吉"
				},
				{
					"id": 732250428,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250429
					],
					"speakerTitle": "雷茲吉"
				},
				{
					"id": 732250429,
					"content": "等等，你們…你們也背叛了塔尼特嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250430
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250430,
					"content": "不，恰恰相反，我們是來處理叛徒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250431
					],
					"speakerTitle": "奈蘭"
				},
				{
					"id": 732250431,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250432
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250432,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250433
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250433,
					"content": "這些人是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250434
					]
				},
				{
					"id": 732250434,
					"content": "不重要了，他們曾是很不錯的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250435
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250435,
					"content": "奈蘭、雷茲吉…我很高興能跟你們成為家人，請原諒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250436
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250436,
					"content": "嗯，我們開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250437
					],
					"speakerTitle": "雷茲吉"
				},
				{
					"id": 732250437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322506",
							"2"
						],
						"stepId": 7322506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7322504"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250601,
					"content": "#他們是芭別爾主母派來的…{F#妳}{M#你}們有什麼想法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250602,
					"content": "妳應該看看這些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7322508,
			"completionStepIds": [
				7322508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322508",
							"2"
						],
						"stepId": 7322508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭別爾",
					"婕德",
					"門達斯",
					"烏格威"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250801,
					"content": "…是妳，婕德。妳…妳回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250802
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250802,
					"content": "嗯，我們活著回來了。很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250803
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250803,
					"content": "#妳能活著回來就好…妳現在需要休息，來吧，讓我好好招待一下{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250804
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250804,
					"content": "我不需要休息，我需要解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250805
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250805,
					"content": "為什麼把我騙入北方人的圈套？為什麼要派出族人追殺我？妳為什麼要置我於死地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250806
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250806,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250807
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250807,
					"content": "請冷靜，請聽我說，婕德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250808
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250808,
					"content": "妳還記得我和妳說過什麼嗎？「永恆綠洲」是塔尼特的希望，它將興旺我們的家園…妳也是因為這個而忠誠於我的，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250809
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250809,
					"content": "如今，「永恆綠洲」的門戶已經向塔尼特洞開，我們必須保證它不為外人所知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250810
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250810,
					"content": "我們必須保證，塔尼特部族是綠洲女王最為青睞的子民…只有這樣，才能進一步號召起流散沙漠的其他部民，聚集在綠洲周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250811
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250811,
					"content": "到那時候…妳好好想想吧，我們將會藉助信仰，重新聚集起流散沙漠的人力與資源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250812
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250812,
					"content": "靠著我們的雙手，靠著「綠洲女王」的指引，我們就能在這片沙漠中重建綠洲的國度，擺脫向那些城裡人低頭的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250813
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250813,
					"content": "我們能建立起自己的宮殿，發展起自己的學問，甚至能與那個溫室牢籠中的神分庭抗禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250814
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250814,
					"content": "我們曾經談過這些，難道妳都當做耳邊風了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250815
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250815,
					"content": "我說過，那是不可能的！綠洲女王早就逝去了！她根本不在綠洲！我們是不可能復活她的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250816
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250817
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250817,
					"content": "妳太放肆了，我最寵愛的女兒。妳怎麼能說出這種話來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250818
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250818,
					"content": "她「活著」，或是「死了」，她還能否、或如何「復活」…只要「永恆綠洲」歸我控制，就都取決於我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250819
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250819,
					"content": "我將成為沉睡的女神唯一的女神諭者，塔尼特的律令將成為神的律令，塔尼特的繁榮將成為神諭之下的必然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250820
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250820,
					"content": "但在那之前…婕德，改悔還來得及。妳是我最寵愛的女兒…我不想妳這樣糊塗下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250821
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250821,
					"content": "我…我聽不懂，妳想說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250822
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250822,
					"content": "我的意思很明白：唯一確定的神諭，容不得異議者。目睹了綠洲真相而沒被刺盲雙眼的，只有妳和妳的外人朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250823
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250823,
					"content": "#況且，{M#他}{F#她}仍舊是「鎮靈主人」，即使鎮靈已經不再言語…只要除掉{M#他}{F#她}，便有可能奪取鎮靈的控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250824
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250824,
					"content": "我才更加尊重她的遠古智慧與重建綠洲的能力，我們將會是更加稱職的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250825
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250825,
					"content": "欸，妳這是什麼意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250826,
					"content": "我們上次面談時，妳逃避了這個問題…我可以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250827
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250827,
					"content": "但今天，妳必須做出選擇。塔尼特，妳的家；或是這個外人，妳的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250828
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250828,
					"content": "等等…妳們之前討論過如何處置我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250829
					]
				},
				{
					"id": 732250829,
					"content": "#是的…但我沒有答應她。{M#畢竟你是我的朋友。}{F#因為…妳對我很重要。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250830
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250830,
					"content": "#我很抱歉，孩子。但犧牲是必要的…請相信我，我們不會讓{M#他}{F#她}高貴的血白白流淌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250831
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250831,
					"content": "而妳，婕德，將會成為我的接班人，以後妳會成為塔尼特部族新的主母，娜布·瑪莉卡塔的女神諭者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250832
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250832,
					"content": "好好想想吧，家園的未來盡在妳的手中，我的女兒。如果妳開口請求，我會給妳機會，給妳時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250833
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250833,
					"content": "不需要了，我意已決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250834
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250834,
					"content": "唔，還是多想想比較好啦…不然好嚇人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250835,
					"content": "芭別爾，一直以來我很感謝妳的照顧…即使我明白，自己出自叛徒和外人的血脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250836
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250836,
					"content": "對於妳的安排，我深感…恩寵，受寵若驚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250837
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250837,
					"content": "…先前為妳效勞的那些事情，為妳封掉的嘴巴，那些消失的長老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250838
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250838,
					"content": "布列達長老，他喜歡鱷魚，妳一定記得。他把妳當做親生女兒看待，對我更是寵愛…所以我能把浸毒的匕首刺進他的懷裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250839
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250839,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250840
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250840,
					"content": "戈瓦法長老，妳的眼中釘，他一定也是這樣看妳的。真遺憾，我只能用馱獸的頜骨一下一下、一下一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250841
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250841,
					"content": "那是我第一次被嚇哭，被自己嚇哭。是妳幫我擦掉了眼淚…我還記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250842
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250842,
					"content": "等等…妳是說…？！唔…怎麼會這樣呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250843
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250843,
					"content": "等等…妳提這個做什麼…妳在他們面前提這個做什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250844
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250844,
					"content": "啊，忒雅長老。她年輕、漂亮，又是獵團首領，比妳更有競爭力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250845
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250845,
					"content": "她以為我喜歡她，但我只是為妳做事，因為我相信妳才是我真正的家人，我相信妳能又一次擦去我的眼淚，給我家的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250846
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250846,
					"content": "我讓她消失在沙漠裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250847
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250847,
					"content": "不要說那些沒用的了！妳到底想要說什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250848
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250848,
					"content": "「唯一的女神諭者」，我的「母親」，不應該有什麼可隱藏的秘密，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250849
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250849,
					"content": "如果妳還想聽，我會一件一件都講給妳聽，講給塔尼特的每一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250850
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250850,
					"content": "我為妳做過的一切，我為了「母親」，為了這個「家」做過的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250851
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250851,
					"content": "#而我已經做夠了，已經受夠了。現在，我不想背叛{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250852
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250852,
					"content": "妳發瘋了…竟敢汙蔑部族的主母！妳忘記了母親的名字！閉嘴吧，現在閉嘴還來得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250853
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250853,
					"content": "我的母親叫優菲，優菲·欣迪。她是一個正直的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250854
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250854,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250855
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250855,
					"content": "啊，我明白了。叛徒的女兒，終究是個養不熟的雜種狗…和她的父親一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250856
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250856,
					"content": "哲伯萊勒和那個外來女人為自己的頑劣付出了代價，他們的女兒同樣軟硬不吃、好歹不分…我早該料到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250857
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250857,
					"content": "優菲·欣迪，那是她的名字…也將是我的氏名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250858
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250858,
					"content": "叛徒…我的話全都白費了！沙漠會銘記妳的，叛徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250859
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250859,
					"content": "夠了，我的族人。你們知道該怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250860
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250860,
					"content": "她讓我很氣憤…和悲傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250861
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732250861,
					"content": "#欸…！等一下啦，不是…妳們不要生氣呀！妳才說妳把婕德當女兒看的不是嗎…而且，{NICKNAME}明明幫了妳好多忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250862
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250862,
					"content": "總之…總之，我們一定還有別的辦法和好的，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250863
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250863,
					"content": "派蒙，躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250864
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250864,
					"content": "不要看接下來要發生的事…別髒了妳的白衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322511,
			"completionStepIds": [
				7322511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322511",
							"2"
						],
						"stepId": 7322511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251101,
					"content": "嗯！婕德妳永遠可以信任我們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251102,
					"content": "嗯…只是，我又無家可歸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251103,
					"content": "或者說，妳可以四海為家了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251104
					]
				},
				{
					"id": 732251104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251105,
					"content": "#噗…如果是以前的我，肯定會覺得{F#妳}{M#你}這句話欠揍到不行！唉…不過{F#妳}{M#你}說的沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251106
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251106,
					"content": "妳說的沒錯…現在我是我氏名的主人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251107
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251107,
					"content": "我不再是「塔尼特」這個名字的奴僕，而是「婕德」這個名字的主人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251108
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251109,
					"content": "我取回了母親的氏名…我自由了，或許「婕德」這個名字，以後也會成為新的氏名…我不知道，也許吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251110,
					"content": "我母親的名字帶給我驕傲，父親的名字保留著我的回憶。只要銘記著他們，在荒蕪的沙漠裡…這不就是我一直尋求的「家」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251111
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251111,
					"content": "終於不用再為「家」擔憂了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251112
					]
				},
				{
					"id": 732251112,
					"content": "#嗯，謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251113,
					"content": "#呃…{F#妳}{M#你}知道嗎？我還挺想和{F#妳}{M#你}繼續並肩一起冒險的…哈哈，讓{F#妳}{M#你}這麼多次置身險地…我一定煩到{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251114
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251114,
					"content": "#但是…我看得出，{F#妳}{M#你}還有自己的路要走，我看得出{F#妳}{M#你}還要忍受更大的孤獨，完成更遠的目標…大過我能承受，遠過我能想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251115,
					"content": "#而我呢，我也有我自己的路要走！我的路…{F#妳}{M#你}也看到了，一定不會很和平安穩…所以，我就不拖累{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251116
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251116,
					"content": "妳也不要這麼說呀…有什麼拖累的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251117,
					"content": "#就這樣吧…不過，如果什麼時候{F#妳}{M#你}累了，想要休息一下的話…我相信，我們一定會在某條路上相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251118
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251118,
					"content": "#到那時候，我說不定會邀請{F#妳}{M#你}們，再來一次天翻地覆的冒險呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251119,
					"content": "呼…好了，我的話說得夠多了…是時候離開這個傷心地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251120
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251120,
					"content": "#{M#婕德與你在黃沙中擁別。\\n她緊緊地摟了你一下，你感受到她似乎正強忍著抽泣…\\n然後，她快速抽身離開你的懷中，若無其事地擦了擦眼角，對你咧嘴笑了。}{F#婕德與妳在黃沙中擁別。\\n她緊緊地摟著妳，彷彿生怕妳被遮蔽天幕的沙暴帶走，妳感受到她似乎正強忍著抽泣…\\n然後，她輕輕把妳推開，擦了擦濕潤的眼角，對妳露出微笑。}",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251121
					]
				},
				{
					"id": 732251121,
					"content": "#「我希望我們下次相見，會是在一個陽光更好的日子。」婕德對{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251122
					]
				},
				{
					"id": 732251122,
					"content": "#婕德轉身離去。\\n{F#妳}{M#你}們看到，奔奔也從營地的廢墟中出來，急忙跟上了婕德的腳步。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7322512,
