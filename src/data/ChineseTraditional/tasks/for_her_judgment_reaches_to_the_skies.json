			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭別爾",
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251201,
					"content": "咳咳…看看吧…塔尼特…塔尼特被一個叛徒…被一個叛徒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251202
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251202,
					"content": "我的…部族…我的族人…我的…「永恆綠洲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251203
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251203,
					"content": "對那些說再見吧，妳還有時間說遺言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251204
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251204,
					"content": "為什麼…我曾經…那麼愛妳…為什麼…妳要背叛我…背叛…塔尼特…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251205
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251205,
					"content": "為什麼？妳是惡人，我是好人，我沒必要跟妳講道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251206
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251207
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251207,
					"content": "唉…好吧，好吧。芭別爾，我就告訴妳好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251208
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251208,
					"content": "#{NICKNAME}，{M#他是我最好的朋友。}{F#她是我最好的朋友！}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251209
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251209,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251210
					]
				},
				{
					"id": 732251210,
					"content": "#妳想要害{M#他}{F#她}，我拒絕了，然後妳想要連我一起除掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251211
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251211,
					"content": "#不，比那還要卑劣…妳想讓我別無選擇地與{M#他}{F#她}自相殘殺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251212
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251212,
					"content": "直到這時候，我才意識到，妳不是什麼「女神諭者」，妳配不上綠洲女王的青睞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251213
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251213,
					"content": "妳只是一條狗而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251214
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251214,
					"content": "是妳…太蠢了…咳…一個外人…一個外人…為了一個外人…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251215
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251215,
					"content": "我…我，我們才是妳的家人！妳毀了一切，妳毀了…塔尼特的希望…和鍍金熱砂上所有流散民族的…咳咳…希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251216
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251216,
					"content": "少自大了，我不過推倒了一座小小的沙丘而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251217
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251217,
					"content": "#倒是妳，我問妳！什麼樣的母親會逼迫自己的女兒謀害{M#朋友}{F#她所中意的人}呢！回答我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251218
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251219
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251219,
					"content": "妳想害我，妳就不配做我的家人。去妳的什麼先知大夢吧，將來自然有人替妳實現的…好歹要用更乾淨的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251220
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251220,
					"content": "呵呵…呵…但是…我已經派出斥候，向沙漠各部通報了…妳叛變的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251221
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251221,
					"content": "很快，他們都會知道…妳…是一個玷汙氏族之名的叛徒…咳咳…廣闊的沙漠…很快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251222
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251222,
					"content": "很快，就不會再有任何人會接納妳…妳將再也找不到安全的落腳點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251223
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251223,
					"content": "…什麼時候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251224
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251224,
					"content": "#咳咳…！哈哈…就在…{F#妳}{M#你}們…回來之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251225
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251225,
					"content": "所以…從一開始她就沒想讓我們活。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251226
					]
				},
				{
					"id": 732251226,
					"content": "等等，之前…妳讓我改悔的那一大番話…也是假的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251227
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251227,
					"content": "我以為…妳會心軟…那樣更好對付些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251228
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732251228,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251229
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251229,
					"content": "妳讓我噁心。你們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322513,
			"completionStepIds": [
				7322513
