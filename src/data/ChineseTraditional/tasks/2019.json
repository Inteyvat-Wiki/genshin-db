			"dialogs": [
				{
					"id": 20185301,
					"content": "「無想的一刀」在，稻妻子民便高枕無憂，裟羅連這都看不穿…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
