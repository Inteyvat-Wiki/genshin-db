			]
		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「女士」",
					"派蒙",
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "風風火火地闖進來，一個又一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190102,
					"content": "若不是我知道此地是天守閣，大概會把這裡當成什麼街巷市集之類的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190103,
					"content": "這下總該懂事一點了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190104,
					"content": "啊，九條裟羅被「女士」給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190105,
					"content": "稻妻子民的過錯，當由我來懲戒。妳沒有資格，「女士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20190106,
					"content": "…那真是抱歉了，將軍大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190107,
					"content": "「女士」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "#好了好了，知道{F#妳}{M#你}忘不掉我，不用總把我的名字掛在嘴上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190109,
					"content": "#我也知道{F#妳}{M#你}記恨我…陰魂不散的旅行者，在這裡見到{F#妳}{M#你}，我一點都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190110,
					"content": "妳在暗中推廣邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "急著在將軍面前揭露我的「罪行」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190113,
					"content": "#呵呵呵…我不過是來自至冬的外交使節而已，{F#妳}{M#你}在講什麼，我可都不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190114,
					"content": "她不把我們放在眼裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190115,
					"content": "為了失去神之眼的民眾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "別講那些我根本不關心的人和事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190118,
					"content": "本就連名字都不會被人記住的小角色們，能參與到這場為了抵達「永恆」的革命之中，成為墊腳石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190119,
					"content": "對他們短暫的人生來說，豈不已經是莫大的榮幸了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190120,
					"content": "將軍大人，我所說的應該沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20190122,
					"content": "還有溫迪的神之心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "#翻起舊帳了嗎，{F#妳}{M#你}還真是記仇啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190125,
					"content": "至冬女皇的理想，是這世間最為高潔而純粹之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190126,
					"content": "#相比而言，{F#妳}{M#你}所說的那些…不過是些不足掛齒的「必要的犧牲」罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190127,
					"content": "是時候做個了斷了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "呵，了斷？哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190129,
					"content": "#我也對{F#妳}{M#你}這張臉，稍微有些厭倦了。不過我倒是沒想到，{F#妳}{M#你}是這般有勇無謀的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190130,
					"content": "#在{F#妳}{M#你}說大話之前，可曾意識到…{F#妳}{M#你}還是稻妻的頭號通緝犯啊，先好好想想自己的處境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190131,
					"content": "闖進天守閣，在御前大放厥詞，不是自投羅網是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190132,
					"content": "#希望{F#妳}{M#你}能認識到{F#妳}{M#你}我之間的差距，不論是地位…還是實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190133,
					"content": "我要——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "——向妳發起「御前決鬥」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190136,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 20190137,
					"content": "#居然，還有這一手…{F#妳}{M#你}也學會利用這個國度的「規則」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190138,
					"content": "#勉強把{F#妳}{M#你}我拉到對等的位置上，我承認，有些出乎我的意料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190139,
					"content": "#但敗者…可是會死喔？{F#妳}{M#你}想清楚了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190141,
					"content": "#呵呵呵…那就讓我屈尊和{F#妳}{M#你}共舞一曲，直到{F#妳}{M#你}與我其中一方…生命的盡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190123,
					"content": "置璃月民眾於險境…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "為了遭邪眼反噬的戰友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "企圖一手掌控稻妻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}