			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "這樣做生意長久不了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "#抱歉抱歉，想事情一時分心了。{F#妳}{M#你}是來買成衣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400104,
					"content": "雖然璃月的高檔綢緞仍然斷貨，但新款的著物還是應有盡有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400105,
					"content": "之前妳會從璃月進貨？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "是的，之前我們店總能進到璃月的高檔綢緞，比如「飛雲商會」那些用霓裳花製成的絲綢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400107,
					"content": "可是，現在稻妻這個情況…店裡已經有一段時間沒有進過那種綢緞了。現在也只能靠之前的存貨維持經營。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400108,
					"content": "店裡的這些絲綢，可以說是用一段少一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400109,
					"content": "我本來是想自己設計些新紋樣，或者是用新染料做一些新樣式的布料和成衣來吸引客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400110,
					"content": "但是，我卻想不出什麼能稱得上是有「新意」的紋樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400111,
					"content": "#旅行者，{F#妳}{M#你}見多識廣，{F#妳}{M#你}見過什麼能稱得上是有「新意」的紋樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400112,
					"content": "這就不清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "#這樣啊，我明白了。這麼說或許有些冒昧，但是…能不能請{F#妳}{M#你}幫我向外國人士打聽打聽關於紋樣的事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400114,
					"content": "「小倉屋」如今只有我操持，所以我平時沒辦法離鋪子太久，想四處打聽就只有拜託別人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220400115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "#那太好了，我想想…請{F#妳}{M#你}直接去問問湯雯小姐和拉姆齊先生吧，也許他們會有什麼新想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小倉澪"
				}
			]
		},
