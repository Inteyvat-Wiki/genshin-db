			"dialogs": [
				{
					"id": 741531201,
					"content": "關於你們發現的收據…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531202
					]
				},
				{
					"id": 741531202,
					"content": "最近賣出去的鉗子、鋸子，還有蠟燭？哎喲，真是奇怪的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531203
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531203,
					"content": "#{F#妳}{M#你}要買點心、調味料我有的是，需要這種東西我就不好辦了，貨不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531204
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531204,
					"content": "奶奶，不是我們想要買這些，我們是想問這幾天有沒有人來找妳買過這些東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741531205,
					"content": "我想想，嗯…還真的有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531206
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531206,
					"content": "前些天正好有兩個年輕人，一男一女，到我這裡買了這些東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531207
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531207,
					"content": "說是家裡要做木工，缺了點工具，怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531208
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531208,
					"content": "沒事沒事，我、我們在做社會經濟情況調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741531209,
					"content": "#社會經濟情況調查？呵呵…{F#妳}{M#你}們是來打聽人的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531210
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531210,
					"content": "#這種事我見多了。小傢伙，{F#妳}{M#你}也不用花力氣想藉口了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531211
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531211,
					"content": "#他們兩個去了伯努瓦的舊房子——如果{F#妳}{M#你}們想知道的是這件事的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531212
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531212,
					"content": "關於伯努瓦·勒魯瓦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531213
					]
				},
				{
					"id": 741531213,
					"content": "#原來{F#妳}{M#你}們是衝著伯努瓦來的，不意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531214
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531214,
					"content": "人到了一定年紀，過去就會找上門來，不管搬到哪裡都一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531215
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531215,
					"content": "奶奶妳知道些什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741531216,
					"content": "#我？我和伯努瓦不熟，如果{F#妳}{M#你}們想打聽伯努瓦家的事，應該找史諾德格拉斯問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531217
					],
					"speakerTitle": "布萊卡利"
				},
				{
					"id": 741531217,
					"content": "去吧，史諾德格拉斯這傢伙遊手好閒的，這個時候應該就在這附近閒逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布萊卡利"
				}
			]
		}
