			"dialogs": [
				{
					"id": 741530401,
					"content": "#（撫摸起來有種光滑油潤的觸感，{F#妳}{M#你}確定這是蠟燭留下的痕跡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530402
					],
					"speakerTitle": "奇怪的痕跡"
				},
				{
					"id": 741530402,
					"content": "（有誰拿著蠟燭在箱子附近逗留過，又是為了什麼？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
