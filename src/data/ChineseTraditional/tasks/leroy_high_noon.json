					{
						"sceneId": 3,
						"position": [
							3504.077,
							283.082,
							4528.295
						],
						"pointId": 7525
					}
				]
			},
			"dialogs": [
				{
					"id": 741530701,
					"content": "啊，好無聊啊…不想工作…我什麼時候可以暴富…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530702,
					"content": "關於伯努瓦·勒魯瓦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "…勒魯瓦？這名字似乎在哪裡聽過，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530704,
					"content": "哦，我想起來了。伯努瓦·勒魯瓦，雜貨攤的攤主大叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530705,
					"content": "#怎麼了？{F#妳}{M#你}們是誰？打聽這個做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530706,
					"content": "其實我們只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530707,
					"content": "他的情況比較複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "啊，這…難道…他是不是犯什麼法了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "#懂了懂了…但我還是忍不住想多問一句，{F#妳}{M#你}們是刺玫會來的還是執律庭來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530712,
					"content": "你有權保持沉默…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "你的每句話將作為呈堂證供…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#（{NICKNAME}也太會演了，不愧是{F#妳}{M#你}！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530715,
					"content": "好好好，明白了，我不問了。他發財的手段又不光彩，楓丹法條那麼多，他一定是違反其中某一條了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530716,
					"content": "#長官，{F#妳}{M#你}們找對人了。我告訴{F#妳}{M#你}們，這家人我再熟悉不過了，伯努瓦這個壞東西壞事沒有少做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530717,
					"content": "哦，我都到了結婚成家的年紀，他應該也已經老了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530718,
					"content": "我記得他的女兒小秋很漂亮，嘿嘿…可惜他從來不讓我們跟小秋說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530719,
					"content": "小秋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "沒錯，秋·勒魯瓦，伯努瓦·勒魯瓦的養女。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530721,
					"content": "#{F#妳}{M#你}仔細想一想，他本來只是一個賣雜貨的，賺點小錢而已，怎麼可能突然暴富還搬到上面去住？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530722,
					"content": "還不是靠他的女兒小秋！那麼漂亮的年輕女孩，他硬是讓她嫁給了一個有錢的老頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530723,
					"content": "才幾年老頭就死了，老頭的房子當然就歸小秋了，小秋的就是他的，這下子他不就一口氣成為「上面人」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530724,
					"content": "嘖嘖…這種一夕暴富的好事怎麼剛好發生在他身上？啊不是，我是說這個老東西吸自己女兒的血，太壞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530725,
					"content": "（怎麼會有這種事情？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530726,
					"content": "（我們繼續問他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "#長官，{F#妳}{M#你}們就是來打探這些事的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530728,
					"content": "#我是說…要是這些無聊小事對{F#妳}{M#你}們有用的話，我是不是也對楓丹的社會安全有所貢獻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530729,
					"content": "作為一個對社會有貢獻的市民，執律庭會不會有嘉獎我的打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530730,
					"content": "這些事我們已經知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "別急別急，我還有其他的事情可以說。畢竟住在灰河，要是不知道別人一兩個秘密，睡覺都睡不安穩，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530734,
					"content": "小秋的第二個丈夫——沒錯，她很快就再嫁了，這次嫁得比較遠，我們都沒有再見過她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530735,
					"content": "等到我們再聽說小秋的消息時…她已經犯下那種事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530736,
					"content": "那種事是哪種事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530737,
					"content": "#長官不知道嗎？小秋殺了她的第二任丈夫，被判到梅洛彼得堡去了啊？{F#妳}{M#你}們來查伯努瓦竟然不知道這件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530738,
					"content": "這裡有涉案人員紀錄，派蒙隊員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#啊…啊抱歉，{NICKNAME}隊長，下次我不會再這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530741,
					"content": "繼續說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "對對，我正要說。我也是聽別人說的…據說審判小秋的時候，小秋申請讓伯努瓦出庭，但他拒絕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530744,
					"content": "伯努瓦沒結婚，只有小秋一個女兒…哦對了，我記得她是過繼來的女兒，跟伯努瓦還算是有那麼一點血緣關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530745,
					"content": "反正唯一的父親都沒有出庭作證，小秋會直接被判去梅洛彼得堡也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530746,
					"content": "這個老壞蛋是為了獨吞房產，還是因為跟女兒有什麼衝突才沒有出庭…我就不亂猜了，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530747,
					"content": "他平常看起來很和善吧？我記得他還給過我點心吃，誰知道他私底下這麼冷血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530748,
					"content": "#長官您真鎮定，聽了這麼久眉頭一下都沒皺，這樣{F#妳}{M#你}們都不覺得冷血嗎？我以為我還滿冷血的，{F#妳}{M#你}們比我厲害多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530749,
					"content": "公事公辦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "太專業了，令人肅然起敬。所以長官們，伯努瓦犯的罪嚴重嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530751,
					"content": "無可奉告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "哈，嚴重到無可奉告…那他的房子會被收走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530753,
						741530754
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530753,
					"content": "或許吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "啊哈，我就知道！老鼠就是老鼠，爬到上面還是老鼠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530756,
					"content": "謝謝兩位長官為我帶來美好的一天，期待下次在灰河再度看見兩位，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530757,
					"content": "怎麼說呢…我現在心情有點複雜，本來我對伯努瓦的印象還滿好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530758,
					"content": "人不可貌相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "唉！我是不是太笨了？完全沒看出來他是這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530763,
					"content": "這些複雜的事情夠我們消化一陣子了，我總覺得心裡怪怪的，不想再待在灰河了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530764,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "嗯，去曬曬太陽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530760,
					"content": "不用聽信路人一面之詞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "#{F#妳}{M#你}說的對，但我現在也沒辦法完全相信伯努瓦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530762,
					"content": "#好討厭這種感覺，不過幸好我還可以相信{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530754,
					"content": "有可能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "秘密呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530739,
					"content": "妳沒有仔細研究卷宗，我很失望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530732,
					"content": "要看你可以提供些什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530733
					]
				},
				{
					"id": 741530733,
					"content": "那我可以說的太多了！畢竟住在灰河，要是不知道別人一兩個秘密，睡覺都睡不安穩，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "史諾德格拉斯"
				},
				{
					"id": 741530708,
					"content": "請配合我們工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				}
			]
		},
