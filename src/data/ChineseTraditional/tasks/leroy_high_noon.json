			"dialogs": [
				{
					"id": 741530501,
					"content": "那個箱子怎麼看都不像是該在這裡出現的東西，而且好臭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530502,
					"content": "恐怕是灰河來的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530503
					]
				},
				{
					"id": 741530503,
					"content": "也就是說最近伯努瓦家有人去過灰河，而且伯努瓦又曾經住在灰河…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530504,
					"content": "#所有的線索都和灰河有關，{NICKNAME}，我們要不要去灰河看看，應該可以獲得更多有用的資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530505,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530506
					]
				},
				{
					"id": 741530506,
					"content": "我們去灰河！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
