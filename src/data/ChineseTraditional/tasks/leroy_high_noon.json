					{
						"sceneId": 3,
						"position": [
							3594.91,
							435.073,
							4531.89
						],
						"pointId": 7522
					},
					{
						"sceneId": 3,
						"position": [
							3594.826,
							435.073,
							4532.51
						],
						"pointId": 7523
					}
				]
			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "有沒有人啊！報紙不要了嗎？喂，出個聲啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "伯努瓦不在家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "我怎麼知道？真奇怪，自己訂的報紙自己不來拿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530105,
					"content": "以前我送報到門口勒魯瓦先生至少會回應一聲，最近完全看不到他的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530106,
					"content": "#我這裡已經堆了好幾份他訂的《蒸汽鳥報》了，{F#妳}{M#你}們認識他對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530107,
					"content": "對，對，我們是伯努瓦的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530108,
					"content": "#好朋友？…也可以，不然我把報紙交給{F#妳}{M#你}們，{F#妳}{M#你}們見到他的時候幫我轉交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530109,
					"content": "好的，給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "我也算盡力了，不要之後怪我沒送報紙上門，我還有其他事要忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530112,
					"content": "但最近我們也幾乎見不到他本人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530113,
					"content": "#{F#妳}{M#你}們也找不到他？勒魯瓦先生到底在忙些什麼啊…難道回老房子那裡住了？沒有聽說啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530114,
					"content": "老房子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "對啊，他在灰河的老房子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530116,
					"content": "伯努瓦以前是住在灰河的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530117,
					"content": "#他是從灰河搬上來的{F#妳}{M#你}們都不知道，{F#妳}{M#你}們真的是他的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530118,
					"content": "呃…我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530119,
					"content": "#好了好了，不用解釋。{F#妳}{M#你}們跟他之間是怎麼回事我一點都不關心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530120,
					"content": "#只要把報紙送到我就謝謝{F#妳}{M#你}們了。好了，{F#妳}{M#你}們拿著，我走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "皮普"
				},
				{
					"id": 741530121,
					"content": "#感覺伯努瓦身上還有很多我們完全不瞭解的事，{F#妳}{M#你}覺得這會和我們要調查的事情有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530122,
					"content": "很可能有關。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "好，那接下來我們在伯努瓦家附近稍微調查一下吧！說不定能夠瞭解更多關於伯努瓦的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530125,
					"content": "不過我們的動作要小一點，不然會引起那對夫妻的警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741530123,
					"content": "情報越多越好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "派蒙拿著吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
