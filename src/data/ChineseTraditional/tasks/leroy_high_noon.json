			"dialogs": [
				{
					"id": 741510401,
					"content": "屋內靜悄悄的沒有聲響，沒有人說話，也沒有腳步聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510402
					],
					"speakerTitle": "敲一敲"
				},
				{
					"id": 741510402,
					"content": "伯努瓦一家安靜得有些異常，這幾乎像是間空房子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "敲一敲"
