	"talks": [
		{
			"id": 7351301,
			"completionStepIds": [
				7351301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351301",
							"2"
						],
						"stepId": 7351301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"施芮婭",
					"維納亞克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735130101,
					"content": "…所以說為什麼連鉚釘也要訂做！根本不能提高多少性能吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130102
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130102,
					"content": "——鉚接裝甲可是妙論派的浪漫啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130103,
					"content": "你們…這是從昨天算帳到現在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130104
					]
				},
				{
					"id": 735130104,
					"content": "#啊，{F#妳}{M#你}們已經來了嗎？倒也不算，其實經費的問題昨天已經辯論完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130105
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130105,
					"content": "呼…剛剛是在爭論其他問題，只是不知不覺，就又繞回經費了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130106
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130106,
					"content": "其他問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130107
					]
				},
				{
					"id": 735130107,
					"content": "我連零件的接縫都打磨到發亮了，施芮婭這傢伙，居然想中止計畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130108,
					"content": "不是中止！只是暫緩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130109
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130109,
					"content": "你沒發現環境參數好像有點不對勁嗎？就這樣繼續鋪設的話，裝置的充能效率會遠低於預期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130110
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130110,
					"content": "我們得先搞清楚這片區域到底發生了什麼事、排除掉所有影響因素，然後再按計畫組裝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130111
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130111,
					"content": "理想環境和實際環境對不上的情況多得是吧，沒必要這麼斤斤計較。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130112,
					"content": "我在畫設計圖的時候就考慮過容錯範圍，這點影響根本不算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130113
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130113,
					"content": "何況有些時候就得先上手實驗過了，才能發現問題出在哪裡啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130114
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130114,
					"content": "——這就是你當年強行實驗二號機然後炸膛的理由嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130115
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130115,
					"content": "這、這跟那時候不一樣吧！那時候我就還沒意識到要留容錯空間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130116
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130116,
					"content": "…有沒有安全點的實驗方法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130117
					]
				},
				{
					"id": 735130117,
					"content": "我想想…或許可以先關閉炮塔的發射功能，模擬實驗一下它的充能進程就好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130118
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130118,
					"content": "…不行，我信不過你，還是把炮塔的點火模組卸了吧，我先幫你保管。別的東西隨你裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130119
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130119,
					"content": "卸掉點火模組？——那這「對沙蟲用殺蟲炮」不就變成空架子了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130120
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130120,
					"content": "你不是說實驗一下充能就好嗎？果然還是在打開炮的主意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130121
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130121,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130122,
						735130123
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130122,
					"content": "就先關閉發射功能吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				},
				{
					"id": 735130124,
					"content": "唉，好吧…就當是試裝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130125
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735130125,
					"content": "#早這樣不就好了…安裝過程中應該會有不少魔物被引來，到時候就麻煩{F#妳}{M#你}了，冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735130123,
					"content": "總之先把架子搭出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				}
			]
		}
	]
}