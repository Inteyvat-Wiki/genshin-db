			},
			"dialogs": [
				{
					"id": 4880301,
					"content": "#謝謝{F#妳}{M#你}了朋友，我還以為這次麻煩大了，好在有{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880302
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880302,
					"content": "#我會記得跟酒莊的老爺們美言{F#妳}{M#你}幾句的，拜拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
