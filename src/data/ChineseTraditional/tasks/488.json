				"points": []
			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "麗莎小姐，難道是來送稅收報表的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880002,
					"content": "#哦呀，小可愛。{F#妳}{M#你}說的沒錯。我聽說了琴病倒的事，文書類的工作我就先代勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 4880003,
					"content": "這樣呀，那看來這邊已經沒我們什麼事了，那我們就先走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880004,
					"content": "啊，稍等一下，其實查爾斯先生這邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 4880005,
					"content": "讓我來說吧，麗莎小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4880006,
					"content": "就在剛才，我接到了一批訂單。可是店裡的庫存不夠了，酒莊的進貨又遲遲未到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4880007,
					"content": "#方便的話，想麻煩{F#妳}{M#你}們<color=#00E1FFFF>去查看一下貨物情況</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4880008,
					"content": "欸，是這麼緊急的訂單嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880009,
					"content": "沒辦法，畢竟是臨時接到的，強人所難的訂單——就，在，剛，才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4880010,
					"content": "嗯~嗯~就是這樣，如查爾斯先生所說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 4880011,
					"content": "好吧，我去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "可以，但下次要記得請客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "#呵呵，下次等迪盧克老闆在的時候，他肯定會請{F#妳}{M#你}喝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4880014,
					"content": "嗯，這還差不多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
