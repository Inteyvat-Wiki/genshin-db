			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "原來貨物在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880102,
					"content": "#是來幫忙的嗎？可算等到{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880103,
					"content": "我在這酒莊幹了這麼久，頭一次被丘丘人打劫…哎喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880104,
					"content": "#{F#妳}{M#你}們再來晚一點，我還真的不知道怎麼辦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880105,
					"content": "#放心吧，丘丘人而已，{NICKNAME}很能打的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4880106,
					"content": "#能打就好，那這個<color=#00E1FFFF>貨運熱氣球</color>就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880107,
					"content": "#別光顧著收拾那些丘丘人，一定記得<color=#00E1FFFF>優先確保貨物安全</color>，不然{F#妳}{M#你}我可都賠不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "厄尼斯特"
				},
				{
					"id": 4880108,
					"content": "#那就先這樣了，我到前面等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "厄尼斯特"
				}
			]
		},
