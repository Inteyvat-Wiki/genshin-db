			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦雷莎"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2632.644,
							273.546,
							10216.23
						],
						"pointId": 10952
					},
					{
						"sceneId": 3,
						"position": [
							-2630.629,
							273.544,
							10215.22
						],
						"pointId": 10953
					},
					{
						"sceneId": 3,
						"position": [
							-2634.262,
							273.488,
							10214.6
						],
						"pointId": 10954
					}
				]
			},
			"dialogs": [
				{
					"id": 150331001,
					"content": "這裡就是伊安珊老師的家，聽說競技場那邊出了意外，所以她現在不在家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331002
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331002,
					"content": "#她要我幫她保養一下這裡的器械，麻煩{F#妳}{M#你}們稍等一會哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331003
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331003,
					"content": "這麼多器械，都是妳們平常會用的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331004,
					"content": "嗯，沒錯，伊安珊老師會帶我們訓練，教我們很多技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331005
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331005,
					"content": "她說的很多理論知識我都聽不懂，但只要她說什麼我做什麼，長進就會很明顯…嘿嘿，她真厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331006
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331006,
					"content": "這表示妳的天賦也很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331007
					]
				},
				{
					"id": 150331007,
					"content": "我也想試試！可以讓我試試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331008,
					"content": "好啊，那就用這個最輕的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331009
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331009,
					"content": "唔，唔唔唔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331010,
					"content": "不行，我連拿都拿不起來…這真的是能用來訓練的重量嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331011,
					"content": "欸，我覺得還好，伊安珊老師說這裡的配重片已經不夠我用了，需要再訂幾對特製的才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331012
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331012,
					"content": "哇，好、好厲害！完全看不出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331013,
					"content": "都是老師教得好，嘿嘿，我自己沒有花什麼力氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331014
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331014,
					"content": "這就是天才嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331015
					]
				},
				{
					"id": 150331015,
					"content": "沒有沒有，不是的，面對這些訓練器械或者魔物時，我可以使出全力，不會有什麼心理負擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331016
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331016,
					"content": "但是一旦要和別人對抗，我就不行了…因為害怕把別人弄傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331017
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331017,
					"content": "呃，妳這麼說也對…那「歸火聖夜巡禮」怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331018,
					"content": "唉，連團體賽都沒有贏過，更別說取得名次了。我不擅長搶來搶去的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331019
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331019,
					"content": "伊安珊老師安慰我說，力量的精髓之一，就是「控制」，就拿這邊的槓鈴作比方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331020
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331020,
					"content": "不光是推起的時候需要用力氣，放下的時候同樣需要。一個力量強大的人，一定能收放自如。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331021
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331021,
					"content": "我明白，訓練的時候我都是這麼做的，也沒出過問題，但真的到了和別人對抗的時候，我又會有點懷疑自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331022,
						150331023
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331022,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331024
					]
				},
				{
					"id": 150331024,
					"content": "#嗯，謝謝{F#妳}{M#你}安慰我，只要努力訓練，總會克服的吧。現在還是要把保養做完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331025
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331025,
					"content": "好了，抱歉久等了，走吧，我們現在去果園看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331023,
					"content": "不用急於這一時。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331024
					]
				}
			]
		},
