			},
			"dialogs": [
				{
					"id": 150330401,
					"content": "欸，原來妳先到了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330402,
					"content": "是啊，回家飽餐了一頓。我爸爸的手藝超好，無論是肉還是蔬菜，做什麼都好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330403
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330403,
					"content": "怪不得感覺妳的氣色恢復了很多，原來是吃飽了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330404,
					"content": "嘿嘿，沒錯。來之前我還想叫阿卡特叔叔一起，但他好像不在家，我就一個人過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330405,
					"content": "阿卡特叔叔是我們的首領，本來我覺得讓他來介紹「沃陸之邦」會更適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330406
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330406,
					"content": "#我不知道應該按什麼路線來，也只能想到哪裡說哪裡，這個{F#妳}{M#你}們會介意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330407
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330407,
					"content": "當然不會，這有什麼關係啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330408,
					"content": "那就好，那就好，那麼…走那邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
		{
			"id": 1503305,
