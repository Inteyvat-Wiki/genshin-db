						],
						"pointId": 10951
					}
				]
			},
			"dialogs": [
				{
					"id": 150330601,
					"content": "#那邊就是我的家，{F#妳}{M#你}們看，前面是水果店，後面是我和爸爸媽媽住的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330602
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330602,
					"content": "開在家門口的水果店？難道你們家會自己種水果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330603,
					"content": "嘿嘿，是的，我們家有好大一片果園呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330604
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330604,
					"content": "這裡靠部族營地的出入口很近，每天早上就會聽到門外的行走和車輪聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330605
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330605,
					"content": "我的爸爸媽媽也會在那個時候忙碌起來，我就知道我該起床了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330606
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330606,
					"content": "然後一起去果園工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330607,
					"content": "這、這個嘛…我剛想說，腦袋知道該起床，和身體準備好起床，是兩件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330608
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330608,
					"content": "更多的時候，我都是腦袋往被窩裡一縮，馬上又睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330609
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330609,
					"content": "我懂我懂，這種時候睡懶覺，總能睡得特別沉特別香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330610,
					"content": "#反正出發之前，{NICKNAME}{M#他}{F#她}一定會叫我起床的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330611,
					"content": "以後妳先起床，我睡懶覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330612
					]
				},
				{
					"id": 150330612,
					"content": "開玩笑，我開玩笑的啦，別說這麼可怕的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330613,
					"content": "哈哈哈，偶爾都睡睡懶覺也滿好的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330614
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330614,
					"content": "我通常睡醒之後就會幫爸爸媽媽收拾房間，然後出門訓練，接著回家吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330615
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330615,
					"content": "吃完飯之後爸爸媽媽會去運貨，就輪到我去果園工作的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330616
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330616,
					"content": "也就是現在的時間嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330617
					]
				},
				{
					"id": 150330617,
					"content": "那我們也去果園看看吧，我很感興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330618,
					"content": "#好啊，等一下我就帶{F#妳}{M#你}們過去，現在…跟我走吧，走這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
