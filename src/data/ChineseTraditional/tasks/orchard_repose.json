						],
						"pointId": 10959
					}
				]
			},
			"dialogs": [
				{
					"id": 150331501,
					"content": "原來摘了這麼多，真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331502
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331502,
					"content": "因為妳說「豪宴熱鬥」需要很多原料嘛，我們可不能白吃不幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331503,
					"content": "我剛剛嚐過了，的確很好吃，汁水豐富、甜味充足，一定是市場裡最先賣斷貨的果子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331504,
					"content": "蘑菇我也吃了，蘑菇原本的香味背後居然有股淡淡的果香，真不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331505,
					"content": "我就叫它「果果菇」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331506,
						150331508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331506,
					"content": "可以相信派蒙的判斷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331507
					]
				},
				{
					"id": 150331507,
					"content": "是吧，畢竟已經走過那麼多地方，嚐了各式各樣的美食，我舌頭的記性和腦袋一樣好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331510,
					"content": "#謝謝{F#妳}{M#你}們，既然這樣我也提前收工吧，說好了要做蘑菇給{F#妳}{M#你}吃，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331511
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331511,
					"content": "#瓦雷莎快速烹飪了幾下，熱氣騰騰的蘑菇料理便端到了{F#妳}{M#你}們面前。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150331512
					]
				},
				{
					"id": 150331512,
					"content": "我手藝不太精湛，請不要在意，但只要原料夠好，簡單做一做就會很好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331513
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331513,
					"content": "沒有沒有，聞起來超級香，蘑菇的香味濃郁了很多，感覺一定很美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331514,
					"content": "唔，這個味道，和生吃又完全不同了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331515,
						150331516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331515,
					"content": "各有各的風味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331517,
					"content": "#哈哈哈，{F#妳}{M#你}們喜歡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331518
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331518,
					"content": "這種蘑菇在「沃陸之邦」很受歡迎，不過還沒怎麼在外面出名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331519
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331519,
					"content": "這次的「豪宴熱鬥」，也有推廣這個蘑菇的目的在裡面，阿托力叔叔為了更新菜單下足了功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331520
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331520,
					"content": "#如果{F#妳}{M#你}們感興趣的話，到時候也可以來參加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331521
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331521,
					"content": "妳有興趣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331522
					]
				},
				{
					"id": 150331522,
					"content": "我？「豪宴熱鬥」…嗯，當然要參加！雖然我不知道能吃多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331523,
					"content": "沒關係，不用擔心會浪費，如果妳吃不完，告訴我，我會來幫妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331524
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331524,
					"content": "那我就放心了…欸，不對，我們應該是對手吧，跟妳比要怎麼贏啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331525,
					"content": "不試試怎麼知道呢，我覺得妳的胃口也滿不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331526
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331526,
					"content": "而且輸贏不重要，就當成是一次品嚐我們「沃陸之邦」美食的好機會嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331527
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331527,
					"content": "妳說的有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331528,
					"content": "我也陪她吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331529
					]
				},
				{
					"id": 150331529,
					"content": "好，那我們都要報名！等著吧，看我派蒙大顯神通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331516,
					"content": "都很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331517
					]
				},
				{
					"id": 150331508,
					"content": "有時可以相信派蒙的判斷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331509
					]
				},
				{
					"id": 150331509,
					"content": "這個「有時」總感覺怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331510
					],
					"speakerTitle": "派蒙"
				}
			]
