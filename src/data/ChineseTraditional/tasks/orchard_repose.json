			},
			"dialogs": [
				{
					"id": 150331401,
					"content": "嗚嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331402
					],
					"speakerTitle": "瓦娜娜"
				},
				{
					"id": 150331402,
					"content": "辛苦你看家啦，瓦娜娜。我看看，我看看，你是不是又變壯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331403
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331403,
					"content": "嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331404
					],
					"speakerTitle": "瓦娜娜"
				},
				{
					"id": 150331404,
					"content": "哈哈，我只是要看看，沒有要角力的意思。下次吧，下次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331405,
					"content": "牠是瓦娜娜，平時果園沒人的時候，牠就會守在這裡，是個很可靠，也很黏人的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331406
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331406,
					"content": "小、小傢伙嗎？已經夠強壯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331407,
					"content": "來吧，進來，這裡就是我家的果園。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331408
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331408,
					"content": "哇，裡面比想像中還要大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331409,
					"content": "到處都是果子，看起來每個都很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331410,
					"content": "嘿嘿，我們這裡叫「沃陸之邦」，有個原因就是臨近火山，所以土地很肥沃，種什麼都好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331411
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331411,
					"content": "果子很受歡迎，我們不僅一直在往外賣，也留好多自己吃，還送親朋好友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331412
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331412,
					"content": "原來如此，我之前還在想怎麼會有部族住在火山下面，居然還有這種好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331413,
					"content": "是啊。對了，既然都到這裡了，我們摘點果子吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331414
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331414,
					"content": "欸，妳不是剛吃過飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331415,
					"content": "水果是餐後甜點，不會和正餐搶位置。只是吃三五十個的話，不會有事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331416,
						150331417
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331416,
					"content": "三、三五十個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				},
				{
					"id": 150331418,
					"content": "哈哈，小的時候，我爸爸在門口的水果鋪賣水果，我拉拉他的衣服，他就會塞給我一個果子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331419
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331419,
					"content": "我吃得飛快，吃完又找他要一個，結果越來越多人圍上來，都是來看我吃水果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331420
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331420,
					"content": "爸爸說，因為我吃得很香，買水果的人都變多了。我能幫上爸爸的忙，特別開心，於是吃得更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331421
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331421,
					"content": "客人買完果子都會摸摸我的頭，還誇我，說「這麼能吃的小孩子以後一定能長得很好」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331422
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331422,
					"content": "我就傻傻地看著他們笑，過一會我爸爸也開始笑，來幫忙的媽媽也笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331423
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331423,
					"content": "好溫馨的畫面啊，真是羨慕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331424,
					"content": "#但總歸還是因為家裡種的水果很好吃，大家才願意來照顧生意。我可不是自吹自擂哦，{F#妳}{M#你}們馬上就會理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331425
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331425,
					"content": "正好過幾天會有「豪宴熱鬥」，我們家也會贊助很多水果當甜點的原料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331426
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331426,
					"content": "「豪宴熱鬥」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331427,
					"content": "嗯，簡單來說，就是像大胃王比賽一樣的活動，需要準備很多很多的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331428
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331428,
					"content": "所以，放心地摘，我也會一起摘的，不用擔心浪費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331429
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331429,
					"content": "好！讓我看看，從哪裡開始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331430,
					"content": "欸，怎麼那邊有…蘑菇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331431,
					"content": "哦，這個蘑菇啊，是建果園的時候不知從哪裡長出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331432
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331432,
					"content": "它不用澆水也不用施肥，長得很快，肉質肥美，味道非常好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331433
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331433,
					"content": "不僅適合拿來炒和油煎，就連生吃都很好吃，有股水果味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331434
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331434,
					"content": "水果味的蘑菇？沒聽說過啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150331435,
					"content": "或許是吸收了周圍果樹的養分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331436
					]
				},
				{
					"id": 150331436,
					"content": "應該是，如果吃起來像水果，那它就可以算水果，不用太在意來歷啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331437
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331437,
					"content": "#來吧，想摘多少摘多少，再摘一些蘑菇吧，等會一起做給{F#妳}{M#你}們吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150331417,
					"content": "妳的胃口的確很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150331418
					]
				}
			]
		},
