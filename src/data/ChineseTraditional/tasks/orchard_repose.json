			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦雷莎",
					"伊安珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150330501,
					"content": "欸，是伊安珊老師！聽說妳要參加歸火聖夜巡禮，怎麼回來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330502
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150330502,
					"content": "哦，我臨時想起有一些戰鬥用的消耗品快用完了，保險起見，還是回來取一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330503
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330503,
					"content": "#{F#妳}{M#你}們好，我在競技場見過{F#妳}{M#你}們，就是{F#妳}{M#你}們在幫卡齊娜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330504
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330504,
					"content": "#嗯，我是派蒙，{M#他}{F#她}是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150330505,
					"content": "#{F#妳}{M#你}們真厲害，卡齊娜一下子長進了很多，自信心也充足了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330506
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330506,
					"content": "這次能奪得歸火聖夜巡禮的優勝，也是她長年努力的結果，非常值得驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330507
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330507,
					"content": "#麻煩{F#妳}{M#你}和她見面再誇誇她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330508
					]
				},
				{
					"id": 150330508,
					"content": "嗯，放心吧，我知道，這對她來說很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330509
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 150330509,
					"content": "#{F#妳}{M#你}們來「沃陸之邦」有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				}
			]
		},
