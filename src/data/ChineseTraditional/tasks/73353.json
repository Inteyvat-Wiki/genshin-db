				]
			},
			"dialogs": [
				{
					"id": 733530101,
					"content": "#打擾一下，請問是{NICKNAME}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530102,
						733530103
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530102,
					"content": "是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				},
				{
					"id": 733530104,
					"content": "您好您好，幸好沒有認錯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530105
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530105,
					"content": "自我介紹一下，我是生論派的陀裟多，名字是陀羅詰利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530106
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530106,
					"content": "之前雖然聽說過您的事情，但我們其實並不瞭解您本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530107
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530107,
					"content": "正好我們最近在做與夢境相關的研究，草神大人便告訴我們您在辨別夢與現實方面，比她見過的所有人都要冷靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530108
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530108,
					"content": "過獎過獎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530109
					]
				},
				{
					"id": 733530109,
					"content": "您太謙虛了，我們就是專門在處理夢與現實的問題，資料告訴我入眠後能主動醒來是件很難的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530110
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530110,
					"content": "我們的研究是利用夢境對人的心理影響，調節人們的各種心理障礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530111
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530111,
					"content": "具體來說，我們會根據每個病人的情況，透過環境暗示與引導來塑造一個適合的夢境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530112
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530112,
					"content": "進入共同夢境的這部分技術還不成熟，中間依靠草神大人做了許多改進。簡單來說我們的目標是在夢境中調整病人的認知，進而改善心理問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530113
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530113,
					"content": "聽起來好複雜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530114
					]
				},
				{
					"id": 733530114,
					"content": "啊，不好意思，說到自己的研究話就變多了，是有點複雜沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530115
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530115,
					"content": "講簡單一點，我們在做的是夢境影響心理的醫學研究，比較糟的是現在卡在實踐這一步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530116,
						733530117
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530116,
					"content": "你們要我幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530118,
					"content": "一下子就被您猜到了，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530119
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530119,
					"content": "我們組的成員都沒辦法在夢境中保持清醒的認知，本來沮喪得不行，知道有您這樣的人存在才燃起了希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530120
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530120,
					"content": "還得感謝草神大人，要不是她聽完我們的匯報之後建議我們找您商量，這個研究大概就得暫停了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530121
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530121,
					"content": "我有信心，如果能夠成功推廣這套心理療法的話…教令院的年度心理疾病統計數字會降低不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530122
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530122,
					"content": "所以您剛才的意思是願意幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530123
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530123,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530124
					]
				},
				{
					"id": 733530124,
					"content": "太好了！我馬上就整理安排病人的資料，您方便的時候可以來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530125
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530125,
					"content": "我說明一下實驗流程——您只需要放鬆，和病人一起進入夢境就完成一半了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530126
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530126,
					"content": "接下來只需要根據資料中的指示，找到夢中與病人有關的扭曲異常之處，糾正完那些地方之後再離開夢境就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530127
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530127,
					"content": "放心，我們準備了脫離夢境的緊急措施，比起實驗成功，志工和病人的安全更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530128
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530128,
					"content": "每一位病人的情況各有不同，需要酌情應對。只要您有空，請隨時來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530129
					],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530129,
					"content": "知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530130
					]
				},
				{
					"id": 733530130,
					"content": "感謝您的慷慨，我們稍後見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "陀羅詰利"
				},
				{
					"id": 733530117,
					"content": "幫忙的報酬怎麼算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530103,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				}
			]
		}
	]
}