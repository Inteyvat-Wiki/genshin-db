			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪盧克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3770201,
					"content": "#{F#妳}{M#你}們來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3770202,
					"content": "#咦？{F#妳}{M#你}不是…{NICKNAME}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770203,
					"content": "妳不是…琴嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "首先，我聯絡的不止一人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770206,
					"content": "其次，這一位只是「琴」，不是作為「團長」的琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770207,
					"content": "#這可是身為榮譽騎士的{F#妳}{M#你}，也沒可能接觸到的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770208,
					"content": "真是意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770209,
					"content": "#雖然聽說了天空之琴的事，但沒想到居然是{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770210,
					"content": "那麼，琴聲的淨化能讓風魔龍恢復正常…這也是真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770211,
					"content": "#沒錯！現在{NICKNAME}正為了解決風魔龍事件，積極投身在最前線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3770212,
					"content": "#實在不愧於騎士團超新星{F#少女}{M#少年}之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3770213,
					"content": "雖然感覺上已經越過了違法的邊緣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770214,
					"content": "哼。這種牽扯上神話的荒誕解釋，無法相信也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770215,
					"content": "但沒關係。我們可以讓詩人再上演一次那種歌謠，來說服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770216,
					"content": "我相信你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770217,
					"content": "來說服固執的團長大…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770218,
					"content": "四風守護中的東風之龍，特瓦林，我一直想像不到牠背叛的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770219,
					"content": "但如果是在多年前守護蒙德的戰爭中，受到了毒血的侵害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770220,
					"content": "甦醒後又被深淵法師腐蝕，那確實是會變得身不由己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770221,
					"content": "——但這些話，「代理團長」是絕對不能說出口的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770222,
					"content": "迫於「愚人眾」的外交壓力，騎士團很難公開表示對風魔龍的善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770223,
					"content": "那會被理解為縱容和不作為，所以我才只能私下行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770224,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770225,
					"content": "這也是我不喜歡騎士團的原因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770226,
					"content": "不過我倒是沒料到，妳就這樣相信了來歷不明的異鄉人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770227,
					"content": "#<color=#00E1FFFF>前輩</color>這樣嚴厲又謹慎的人，不也願意去相信{F#她}{M#他}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770228,
					"content": "都說別叫我前輩…也罷，這回就難得地合作一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770229,
					"content": "前輩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770232,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770233,
					"content": "看來是有一些不該追問的過往吶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770234,
					"content": "總之天空之琴的真正下落，我已經大致心裡有數了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770235,
					"content": "（漂亮！看不出來她還有轉移話題的天賦…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3770236,
					"content": "蒙德城與至冬國的衝突，本質上是七國與七神的衝突。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770237,
					"content": "冰之神統率的「愚人眾」，正覬覦著風神留下的神力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3770239,
					"content": "所以他們會提出接管城防？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770242,
					"content": "如果公然殺死風龍的企圖被騎士團阻止，那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770243,
					"content": "天空之琴，就是他們唯一能得到的風神之力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770244,
					"content": "蒙德城裡落單的「愚人眾」成員，要多少就有多少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770245,
					"content": "我已經從他們嘴裡撬了些情報出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770246,
					"content": "迪盧克得到的消息是，愚人眾沒有把天空之琴放在歌德大飯店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770247,
					"content": "即使是他們也不想太過囂張，把偷來的聖物收藏在半公開的駐地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770248,
					"content": "我懂我懂，事情鬧太大的話，就會變成嚴重的外交危機呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770249,
					"content": "呵…七國的關係就是這麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770250,
					"content": "異鄉人，做好出發的準備了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3770240,
					"content": "所以他們想要殺死特瓦林？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "（假裝沒聽到那個詞。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "為什麼團長會在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
