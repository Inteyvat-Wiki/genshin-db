				"objectNames": [
					"埃澤",
					"康納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "康納，你做得不錯，繼續保持這樣，我們一定能把小迪奧娜請來晨曦酒莊做常駐調酒師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 191079802,
					"content": "希望能夠真的成功，我連著好幾週蹲守，才換來了這麼一次巧遇…一定要把握住這次機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "康納"
				},
				{
					"id": 191079803,
					"content": "真是辛苦你了，康納。但只要能把小迪奧娜請來，我們付出的一切努力都是值得的，現在我們才邁出第一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 191079804,
					"content": "記住，一定要讓小迪奧娜感受到我們的誠意，我們的熱情！但記住，千萬不要過於猛烈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 191079805,
					"content": "沒問題，埃澤先生，這些我們倆都練過好多次了，這次一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "康納"
				},
				{
					"id": 191079806,
					"content": "你們在說什麼呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "啊？！沒、沒什麼，我們正…討論一些和酒莊生意相關的事，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 191079808,
					"content": "是…對啊，我們正討論酒莊生意的事呢，那個埃澤先生，我們再討論一下最近酒莊的各項支出吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "康納"
				}
			]
