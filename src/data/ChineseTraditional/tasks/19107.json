			"dialogs": [
				{
					"id": 191079701,
					"content": "埃澤先生，可是這樣真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "康納"
				},
				{
					"id": 191079702,
					"content": "康納，現在最重要的，是讓小迪奧娜感受到我們的誠意，你明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 191079703,
					"content": "明、明白了，埃澤先生！",
