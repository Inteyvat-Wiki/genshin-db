			"dialogs": [
				{
					"id": 3760401,
					"content": "迪盧克老爺，這週的帳面就是這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 3760402,
					"content": "這次風災，對生意的影響果然很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760403,
					"content": "希望這段時間早點過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 3760404,
					"content": "老闆，我們…想要一個，稍微隱蔽點的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3760405,
					"content": "要說隱蔽的話，二樓人少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760406,
					"content": "但你不是吟遊詩人嗎？不如選個熱鬧的位置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760407,
					"content": "啊哈哈，收費演出就等下次吧。我們先上去了，一會見~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3760408,
					"content": "看好他們。那個詩人很可疑，我要去問問情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760409,
					"content": "呃…問誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 3760410,
					"content": "蒙德城的「保全」們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
