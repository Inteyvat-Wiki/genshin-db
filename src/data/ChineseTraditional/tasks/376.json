			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪盧克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "啊，迪盧克老爺，你看到那兩個小偷了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 3760602,
					"content": "發生了什麼，怎麼出動了這麼多人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760603,
					"content": "迪盧克老爺沒聽說嗎？有兩個小偷，居然打起了天空之琴的主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "邁爾斯"
				},
				{
					"id": 3760604,
					"content": "哦？真是奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760605,
					"content": "是吧。天空之琴可是風神他老人家親手彈過的寶物，這樣珍貴的文化財產——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "邁爾斯"
				},
				{
					"id": 3760606,
					"content": "居然有人會傻到偷一件賣不出去的東西，還不如偷我家酒窖划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760607,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 3760608,
					"content": "啊，抱歉離題了。那一黃一綠的兩個人，好像往那邊去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3760609,
					"content": "好的好的。謝謝迪盧克老爺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邁爾斯"
				}
			]
		},
