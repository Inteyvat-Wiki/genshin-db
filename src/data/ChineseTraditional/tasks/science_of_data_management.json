					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "這樣就差不多了…希望這些資料真的能派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160102,
					"content": "妳還在這裡整理資料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "哎呀！很高興見到您，榮譽高級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160104,
					"content": "沒錯，按照雷蒙多先生的指示，我還在繼續整理資料和卷宗…欸，我之前是不是已經說過一遍了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160105,
					"content": "這個地方這麼大，只有妳一個人工作的話也太辛苦了，雷蒙多怎麼都沒派人來幫妳啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160106,
					"content": "科學院現在諸事繁忙，分不出人來幫我也是合情合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160107,
					"content": "虧妳還是「主任」呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "您是說「楓丹科學院資產回收組主任」這個頭銜嗎？唉，還請您别挖苦我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160109,
					"content": "我哪是什麼「主任」啊！從一開始，我就只是一個負責整理卷宗的普通職員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160110,
					"content": "自從被雷蒙多先生指派來這裡整理之後，就突然被告知多了這麼一個頭銜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160111,
					"content": "有人告訴我，這是舒瓦瑟爾先生的意見，說他覺得我們工作很辛苦，這麼做主要是方便多發一點補貼給我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160112,
					"content": "哎呀！您可不要告訴別人，我…我怎麼說出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160113,
					"content": "我不會告訴別人的，放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "聽起來像是好事耶！辛苦地做了很多事的人，多拿一點報酬也沒問題呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160115,
					"content": "不過，為什麼要用這麼繞的方法呀？直接把報酬發給大家不就好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240160116,
					"content": "在科學院，也算是正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "唉，我是不能理解舒瓦瑟爾先生和雷蒙多先生在想什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160119,
					"content": "但無論如何，我都要繼續工作才可以，還有很多事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160120,
					"content": "榮譽高級研究員，如果您願意的話，可以幫幫我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160121,
					"content": "責無旁貸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "那麼就請您幫我去清理一下周圍的汙漬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160125,
					"content": "清理的時候，還請您盡量<color=#00E1FFFF>不要碰到旁邊那些卷宗</color>。要是它們被汙損的話，就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160126,
					"content": "那就拜託您了，我還要繼續在這裡整理卷宗。唉，平常我怎麼都不覺得院裡有這麼多卷宗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160122,
					"content": "就再為我的榮譽多加一筆吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "哈哈哈，沒問題，我會為您的好心腸做證的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160117,
					"content": "總之，只要能拿到手就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
