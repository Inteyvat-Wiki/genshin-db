			"dialogs": [
				{
					"id": 240160401,
					"content": "呼…多謝您幫忙。要是沒有您的幫忙，我都不知道要整理到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160402,
					"content": "不過，要是您幫忙時用的力道可以小一點的話，就更好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160403,
					"content": "不好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "您不要誤會！我沒有責怪您的意思，這樣已經是幫了我一個大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160406,
					"content": "這些東西給您，多謝您幫忙了，榮譽高級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160404,
					"content": "我下次一定會輕一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
