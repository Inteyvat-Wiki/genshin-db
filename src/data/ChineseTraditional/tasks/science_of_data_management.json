			"dialogs": [
				{
					"id": 240160301,
					"content": "呼…多謝您幫忙。要是沒有您的幫忙，我都不知道要整理到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160302,
					"content": "真不愧是榮譽高級研究員，無論做什麼事都這麼利落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160303,
					"content": "我一向身手不凡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "再次感謝您幫忙，榮譽高級研究員！這些東西請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240160304,
					"content": "我對打掃略有心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "欸？那您還真是多才多藝，不愧是榮譽高級研究員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "沙爾梅"
				}
			]
