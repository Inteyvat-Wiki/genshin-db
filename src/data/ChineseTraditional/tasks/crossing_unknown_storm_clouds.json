			"trigger": {
				"objectNames": [
					"慕珍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726540101,
					"content": "#感謝{F#妳}{M#你}帶回來的線索，現在我已經大致上可以定位那些遺蹟機械的所在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540102,
					"content": "不過，在此之前，我們還有一些小麻煩需要處理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540103
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540103,
					"content": "#附近分佈的一些雷元素特異點仍然在干擾著精確定位，這些異常點的位置稍後我會告訴{F#妳}{M#你}…希望{F#妳}{M#你}能幫忙解決它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540104,
					"content": "#這次還是一樣，要麻煩{F#妳}{M#你}帶回一些樣本…我們收集這些東西，首先當然是要研究如何為我所用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540105
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540105,
					"content": "其次…畢竟我們是商船隊嘛，當然也要好好探討一下商業價值啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540106,
					"content": "那你們現在成果如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726540107
					]
				},
				{
					"id": 726540107,
					"content": "#唔…{F#妳}{M#你}所交付的樣品，善加利用的話，或許可以讓「南十字」不再只依賴機動力，就能輕鬆躲避海上的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540108
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540108,
					"content": "這樣的話，來往稻妻的商路也會更加鞏固，更能保障效率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540109
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540109,
					"content": "不過…既然「鎖國令」是將軍的意志，或許我們這樣做多少會讓她老人家不悅吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540110,
					"content": "當然啦，最直接的研究成果，自然是藉由雷元素異常增生物的「壽命」與「年齡」，估算出雷元素異常的範圍與起始點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540111
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540111,
					"content": "而起始點呢，就是我們的訂單目標啦，神奇的古代機械生物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540112
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540112,
					"content": "嘿嘿，不好意思…有點太興奮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540113
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540113,
					"content": "好啦，為了最後一番勘測，現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				}
			]
		}
	]
}