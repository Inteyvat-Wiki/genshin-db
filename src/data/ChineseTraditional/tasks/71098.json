			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "這味道真不錯。但是嚐起來，和言笑先生做的蘿蔔時蔬湯完全不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981502,
					"content": "我很好奇，您…您做這道菜的具體作法是什麼？食材投入了多少？調味料是怎麼放的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981503,
					"content": "別、別靠這麼近！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "啊…抱歉，但還是請您詳細和我說一說吧，您做菜的手法，說不定能給我一些靈感呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981506,
					"content": "旅行者詳細講述了自己烹飪蘿蔔時蔬湯的手法。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981508,
					"content": "唉，一道菜的味道，實在是有太多的變數，想要精細計算的話，就必須要投入更多的計算量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981509,
					"content": "但是，更多的計算量，就意味著我必須改良我的「推數機」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981510,
					"content": "希望教令院圖書館裡的資料會給我靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981511,
					"content": "你為什麼要製造「推數機」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "唔，這是一個好問題，但在我回答這個問題之前，我得先問您一個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981513,
					"content": "您覺得，我製造的這台「推數機」是否擁有「思想」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981514,
					"content": "這問題是什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "沒錯，請您先想想這個問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981517,
					"content": "等我們下次相遇的時候，我們可以就這個問題好好討論一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981518,
					"content": "至於現在嘛，我得先去整理一下資料了…路通，來吧，開始工作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710981519,
					"content": "是，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981520,
					"content": "請您收下這些，旅行者。加爾恰先生就是這樣，還請您多多包涵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981521,
					"content": "你們要去須彌嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "是的，加爾恰先生要去教令院查閱資料，而我被他雇傭隨行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710981523,
					"content": "再見，旅行者。如果我們能在須彌再會，我會很高興的…我想加爾恰先生也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 710981515,
					"content": "「推數機」…是否有「思想」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "你、你先離遠點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
