					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "那我們就去問問吧，他們是在準備研究什麼新菜，我們還能試吃一下呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980712,
					"content": "我們去問問吧。",
