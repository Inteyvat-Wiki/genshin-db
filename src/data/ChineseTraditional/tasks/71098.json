						710980705
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980705,
					"content": "啊，路通，親愛的路通，你幫我點那道菜了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710980706,
					"content": "蘿蔔時蔬湯已經點好了，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980707,
					"content": "太好了，你可真是太貼心了，親愛的路通，這次我準能把那道菜的製作公式轉寫出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980708
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 710980708,
					"content": "我對此滿懷期望，先生。",
