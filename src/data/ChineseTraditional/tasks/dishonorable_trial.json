					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "原來如此，深淵教團已經展開新的行動了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020502,
					"content": "很可能與「污穢逆位神像」有關，我們也去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020503,
					"content": "說起來，深淵教團去奔狼領幹嘛？難道又要重演特瓦林事件？啊——重複的災難就別再來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020504,
					"content": "不，應該不會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020505,
					"content": "與被鎮壓的奧賽爾不同，魔神「安德留斯」早就死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020506,
					"content": "如今守護奔狼領的，只是它的殘魂而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020507,
					"content": "深淵使徒將那縷殘魂當作目標，或許只是想要從風神眷屬的口中，挖出些有用的資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
