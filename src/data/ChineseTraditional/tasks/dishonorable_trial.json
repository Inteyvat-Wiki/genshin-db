	"talks": [
		{
			"id": 800201,
			"completionStepIds": [
				800202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "#榮譽騎士！{F#妳}{M#你}好，最近過得如何？今天有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020102,
					"content": "啊…不過，先說好，想再借天空之琴，是不可以的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020103,
					"content": "（看來她還沒有發現幻術的事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020104,
					"content": "我們是來打聽事情的。芭芭拉聽說過「世上第一座耕地機」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020105,
					"content": "嗯？那是什麼？「耕地機」…是用來做什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020106,
					"content": "唔，果然不知道啊。那換個問題吧，教會有沒有弄丟過七天神像呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020107,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020108,
					"content": "你們是來問那個「老故事」的嗎？好意外，因為是很久以前的事，現在已經沒有什麼人再提起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020109,
					"content": "很久以前，的確有座七天神像一夜之間突然消失，沒有留下任何痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020110,
					"content": "當時，幾乎所有教會成員都參與了搜索，但最後也沒有找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020111,
					"content": "在教會的記載裡，這件怪事被稱為「失落的七天神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020112,
					"content": "唔…果然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020113,
					"content": "果然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020114,
					"content": "啊，沒什麼。還有別的什麼線索嗎？呃，我是說…還有別的什麼怪事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020115,
					"content": "（對不起了，芭芭拉，暫時不能告訴妳我們見過神像的事…這也是商量過的結果，為了妳的安全…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020116,
					"content": "別的怪事？不太清楚，我想想教會記錄過的怪事…「暴君的遺怨」？不對，時間上應該關聯不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020117,
					"content": "「暴君的遺怨」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020118,
					"content": "哦，這件怪事指的是，現在被稱作「風龍廢墟」的「舊蒙德」，有一段時間變得非常危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020119,
					"content": "在很多年前的某段時間裡，只要有人接近那裡，就會引來從天而降的火球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020120,
					"content": "從天而降的火球？！好可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020121,
					"content": "當時，人們認為那是「龍捲之魔神」的詛咒，所以把它叫做「暴君的遺怨」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020122,
					"content": "這個詭異的現象持續了一年，最後也沒能解決，後來是自己慢慢停息的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020123,
					"content": "這也太奇怪了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "嗯，後來教會認為，「暴君遺怨」的說法站不住腳。龍捲之魔神，按理說不會發射火球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020126,
					"content": "恐怕，是有別的什麼原因引發了災禍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020127,
					"content": "總之，這件事和「失落的神像」可能沒有關係。但其它的怪事，我也聯想不到什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020128,
					"content": "沒關係，還是很謝謝妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020129,
					"content": "「謝謝」？我好像又聽到了麻煩的詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020130,
					"content": "啊，是妳啊，蘿莎莉亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020131,
					"content": "如果要找騎士團，他們現在沒時間，「那群魔物」又回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020132,
					"content": "「那群魔物」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020133,
					"content": "就是那些曾經趁著風魔龍之亂，試圖進攻蒙德城的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020134,
					"content": "那不就是深淵教團嗎？！它們又有動作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020135,
					"content": "嗯，它們正在<color=#00E1FFFF>奔狼領</color>集結，狼群躁動不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020136,
					"content": "深淵教團，可能是…盯上了「北風王狼的殘魂」？至於是為了什麼，我還不能確定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020137,
					"content": "琴團長已經去了<color=#00E1FFFF>奔狼領</color>，我也要開始暗中行動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020138,
					"content": "那、那我也要去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020139,
					"content": "琴團長說，要妳留在教會，做好神職人員的本職工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 80020140,
					"content": "可、可是妳也是神職人員啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020141,
					"content": "不用擔心，我也會去幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "對，我們也會去幫助琴團長的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020143,
					"content": "唔…好吧，有「榮譽騎士」在的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020144,
					"content": "但還是請務必小心行事。願風神保佑大家都安然無恙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 80020124,
					"content": "未必和暴君有關吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "呼——這一帶敵人可真不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020202,
					"content": "越靠近目標，敵人就越多。哼，符合教團的作風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020203,
					"content": "我們得快點找到「王狼」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "嗯！走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020205,
					"content": "我…就不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020206,
					"content": "哎？為什麼呀？難道你害怕毛茸茸的生物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020207,
					"content": "應該不是這種原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "與「狼」無關。是因為它作為昔日的魔神，卻效力於如今的七神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020210,
					"content": "我無法認可它的行為，更不想和它打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020211,
					"content": "#再說，討人喜歡是{F#妳}{M#你}的本事，我可做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020212,
					"content": "你真的很討厭七神呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "神明本就不值得期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020216,
					"content": "就當是我私人的建議好了，記住，隨時都要對神明保持警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020217,
					"content": "不要太過信任他們，但，也不要走上…「推翻」或「獵殺」的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020218,
					"content": "#即使，對於{F#妳}{M#你}當年那個「仇敵」，也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020219,
					"content": "不要信任，也不要獵殺…好彆扭的想法。戴因究竟是在仇恨七神，還是維護七神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020220,
					"content": "為什麼會有如此矛盾的觀點？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020222,
					"content": "前車之鑒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020223,
					"content": "#我…最後就告訴{F#妳}{M#你}們一個事實吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020224,
					"content": "欸？什麼事實？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020225,
					"content": "「坎瑞亞是被神覆滅的國度，而這就是…深淵教團想要覆滅七神國度的原因。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020226,
					"content": "#閒聊到此為止，先辦正事。我去解決剩餘的深淵教團，{F#妳}{M#你}們也快去快回。事情都解決後，我們在奔狼領的入口見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020227,
					"content": "啊…他走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020228,
					"content": "真是個怪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020229,
					"content": "我稍微能理解他一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "#嗯，這麼說來，{F#妳}{M#你}也很提防「陌生的神靈」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020231,
					"content": "#那時在璃月，請仙典儀上，{F#妳}{M#你}的選擇和戴因很類似…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020232,
					"content": "因為缺乏信任。無從交涉，只能回避。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "唉…真是不容易啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020234,
					"content": "#榮譽騎士，派蒙！{F#妳}{M#你}們怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020235,
					"content": "呀，琴團長！太好了，找到妳啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020236,
					"content": "我們聽蘿莎莉亞說，妳來這裡作戰，所以就過來支援妳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020237,
					"content": "那真是非常感謝。這次暴動非常詭異，深淵教團將奔狼領層層包圍，我正準備調動兵力對抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020238,
					"content": "#我剛在奔狼領偵察了一番…沒想到遇見了{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020239,
					"content": "聽蘿莎莉亞說，他們的目標可能是「玻瑞亞斯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020240,
					"content": "但深淵教團…與「玻瑞亞斯」…會有什麼關聯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020241,
					"content": "單純的找麻煩，應該不需要理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020242,
					"content": "妳看，深淵教團已經找過特瓦林的麻煩，再去找另一個風神眷屬的麻煩，也不奇怪呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020243,
					"content": "也、也有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020244,
					"content": "總之，這附近的威脅，無論是明面的，還是潛伏的，都交給我來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020245,
					"content": "#榮譽騎士，請{F#妳}{M#你}趕去確認一下「王狼」是否遭遇危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020246,
					"content": "#魔神的殘魂…不常見人。但我聽說{F#妳}{M#你}與它有過一面之緣，由{F#妳}{M#你}出面，或許是最合適的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "琴"
				},
				{
					"id": 80020247,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "#嗯，多加小心。前方的任務就拜託{F#妳}{M#你}了，「西風的榮譽騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 80020214,
					"content": "你真的很不喜歡交際呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "與人打交道當然沒問題，與神…就不好說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020208,
					"content": "毛茸茸不可愛嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
			"completionStepIds": [
				800211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800211",
							"2"
						],
						"stepId": 800211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "這裡，不歡迎，你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020302,
					"content": "呵呵呵…僅剩殘魂的狼，竟然還有養護子嗣的習性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020303,
					"content": "是想要作為護衛嗎？但他的力量，顯然不能與魔神曾經的利爪相比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020304,
					"content": "而只要服從於我們，你就能重獲比肩神明的權柄，就像過去一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020305,
					"content": "讒…言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020306,
					"content": "這是什麼儀式？它看上去很痛苦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020307,
					"content": "唔…是類似控制特瓦林心智時的「腐蝕」嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020308,
					"content": "狼，不屈服。但，不能，再繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020309,
					"content": "我來阻止它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "不論幾次，你們的努力都只是徒勞無功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020310,
					"content": "再戰一次使徒而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "巨大的神像，恢弘的教堂。蒙德人為了修建它們，必然花費了巨量的資源與精力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020402,
					"content": "但收到這份禮物的風神，究竟感受到了多少，又回報了多少呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020403,
					"content": "「信仰」是不求回報的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020404,
					"content": "哼，只要神靈心安理得，我也不多說什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020405,
					"content": "噓——！馬上就要進教堂了，風神的壞話可不能亂說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020406,
					"content": "而且風神其實…呃，啊，沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020407,
					"content": "#呵，我本來就沒有進教堂的打算。與修女打交道的事，就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020408,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020409,
					"content": "之前都是一起行動的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "#{F#妳}{M#你}是蒙德城的榮譽騎士，深受信任，他們應該會放心讓{F#妳}{M#你}參與到這件事裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020412,
					"content": "而我的出現，只會徒增警惕罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020413,
					"content": "因為是陌生人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "嗯，而且就像小傢伙說的一樣，我隨時…都可能說出教會不想聽到的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020416,
					"content": "「拒信者」踏入「虔誠之地」，從來不會有什麼好結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020417,
					"content": "我過去從未蒙受過神明的恩惠，現在和未來也沒有必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020418,
					"content": "好了，這種事說得也夠多了。我們在閒聊的時候，深淵教團可沒有停下腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020419,
					"content": "#唔，那，{NICKNAME}，就我們兩個人去問問看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020420,
					"content": "#我還要提醒{F#妳}{M#你}們一句，{F#妳}{M#你}們最好也別向教會裡的人提起「污穢逆位神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020421,
					"content": "西風教會對神像的事不會置之不理，但如果他們貿然插手，恐怕只會打草驚蛇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020422,
					"content": "而且…不論是誰，觸碰了與「深淵」有關的因果，一般也不會有太好的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80020414,
					"content": "你覺得你會不受歡迎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "你不好奇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
			"completionStepIds": [
				800210
