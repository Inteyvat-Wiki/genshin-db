			},
			"dialogs": [
				{
					"id": 80020601,
					"content": "#{F#妳}{M#你}們去教會裡找人打聽吧，我就在這裡等著{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
