			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玻瑞亞斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "哼…短暫的儀式被打斷了，你們真是好運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020702,
					"content": "沒想到，僅僅是一縷殘魂，也有這麼堅強的意志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020703,
					"content": "但這種微小的變數，不足以影響大局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80020704,
					"content": "又消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020705,
					"content": "至少阻止了它的行動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "謝謝你們，來得，及時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020708,
					"content": "人類中的「盧皮卡」…讓你們見到我如此姿態，見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020709,
					"content": "但深淵的使徒，終究是太小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020710,
					"content": "王狼，不拒絕，試煉。但，陰森的外來者，不遵守，試煉的規矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020711,
					"content": "我也，注意不到，佈下的陷阱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020712,
					"content": "也就是說，是深淵教團先做好了腐蝕的準備，再以試煉的名義，把「王狼」喚醒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020713,
					"content": "這不是你的錯，雷澤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#謝謝{F#妳}{M#你}，{NICKNAME}。以後，我的爪子，需要，更鋒利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020716,
					"content": "你們，聞到了危險，來這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020717,
					"content": "不，我們是聽說的，我們的鼻子沒有這麼好用啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020718,
					"content": "除了來幫忙之外，我們還有一件事要請教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020719,
					"content": "請問…這位魔神大人，你知道「世上第一座耕地機」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020720,
					"content": "我不關心人類的造物，不知道「耕地機」是什麼。但要說印象深刻的機械，曾經倒是有一座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020721,
					"content": "它誤闖了我的試煉場地，我將它視為參與試煉的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020722,
					"content": "可是它沒有智能，只想要戰鬥。它從頭到腳，都是為了殺戮而鑄造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020723,
					"content": "最終，我的攻擊損壞了它。在倒下之前，它離開了這塊試煉場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020724,
					"content": "唔…聽這些描述，好像不能排除是「世上第一座耕地機」的可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020725,
					"content": "它會旋轉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "是的，它會旋轉，跳得很高，還會發射火球。力量雖不比魔神，但比很多持有「神之眼」的人都強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020730,
					"content": "火球…？咦，最近是不是在哪聽到過這個詞來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020731,
					"content": "總之，這個消息是不是能說明，「世上第一座耕地機」，確實來過蒙德？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020732,
					"content": "聽起來，「世上第一座」的力量，比後來那些量產的遺蹟守衛強了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020733,
					"content": "但在這個故事裡，它好像在「狼的試煉」裡被打壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020734,
					"content": "不知道。那麼，幫上忙了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020735,
					"content": "幫大忙了，謝謝你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020736,
					"content": "我們要繼續去追查一件很重要的事了。雖然深淵使徒離開了，但教團的進攻還沒結束，你們也要小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80020737,
					"content": "嗯，我能聞到，更加危險的，東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020738,
					"content": "你們，也，保護自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷澤"
				},
				{
					"id": 80020727,
					"content": "它會發射導彈嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "「導彈」？不…我已經說了，我不關心人類的造物，不懂這些奇怪的詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020729,
					"content": "它會旋轉，跳得很高，還會發射火球。力量雖不比魔神，但比很多持有「神之眼」的人都強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "玻瑞亞斯"
				},
				{
					"id": 80020714,
					"content": "別沮喪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "落跑倒是挺快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}