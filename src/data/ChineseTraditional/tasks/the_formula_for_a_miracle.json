					}
				]
			},
			"dialogs": [
				{
					"id": 110290501,
					"content": "…良…嘉良…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290502
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290502,
					"content": "——嘉良！嘉良！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290503
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290503,
					"content": "——爹！你醒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290504
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290504,
					"content": "唔…江蘺…阿雩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290505
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290505,
					"content": "…我不是…嗯？這些東西是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290506
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290506,
					"content": "——死而復生的感覺如何呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290507
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290507,
					"content": "若有什麼不適或者異樣…可否詳細說予我聽聽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290508
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290508,
					"content": "白先生！我…我不是應該…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290509
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290509,
					"content": "呵呵，你確實已經死過一回了。如今的你，比起人類，更接近一具殭屍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290510
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290510,
					"content": "…殭屍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290511
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290511,
					"content": "不錯，在我們出發之前，我託七七準備了一帖…「不死之藥」，將你的身體維繫於生死的狹縫間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290512
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290512,
					"content": "雖然距離真正的仙家之術還差得遠，估計只能為你延續一點壽命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290513
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290513,
					"content": "至於具體是幾日、幾月還是幾年…我也想藉此機會，再觀察一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290514
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290514,
					"content": "但無論時間多久，應該都夠你好好道完別，再安心上路了——不知胡堂主，可還接受這樣的安排？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290515
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290515,
					"content": "「不死之藥」…你究竟在背地裡鼓搗了多久？居然連這種東西都給煉出來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290516
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290516,
					"content": "名不副實的半成品罷了，如果不是嘉良的意志堅定，恐怕也發揮不了幾分效用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290517
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290517,
					"content": "說到底，我只是一名醫師而已，不懂那麼多生死循環、陰陽守常的大道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290518
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290518,
					"content": "只知道眼前既然有一條值得拯救的生命，就沒有理由不去拯救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290519
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290519,
					"content": "——何況在我們出發之前，不就是胡堂主，讓嘉良來幫忙引路的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290520
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290520,
					"content": "——唔，果然暴露了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290521
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290521,
					"content": "若非胡堂主特意提點，我們後來恐怕也不能及時找到師姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290522,
						110290523
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290522,
					"content": "總覺得那時候還有人在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290524
					]
				},
				{
					"id": 110290524,
					"content": "難怪當時沒提不死藥的事，居然連那種時候都還在提防我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290525
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290525,
					"content": "呃…哈哈，胡堂主還囑咐我不要隨便亂說，結果，還是瞞不過白先生啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290526
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290526,
					"content": "哼哼，可不要小瞧了我的鼻子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290527
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290527,
					"content": "…我不過是看嘉良一直記掛著失蹤的家人，想讓他了卻心願，盡早上路而已，免得回頭徘徊不去，還得費心超度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290528
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290528,
					"content": "——就是沒想到這單生意，最後還是被不卜廬截了胡！算了算了，就當作訂單延期吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290529
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290529,
					"content": "唉，原本有個七七就已經夠頭疼了，現在居然又多了一個…早知道一開始就把他拉去往生堂該多好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290530
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290530,
					"content": "我…我一定會成為比白先生和媽更好的藥師，再治好老爹的！妳…別再打我爹的主意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290531
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290531,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290532
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290532,
					"content": "哦？想跟往生堂搶生意的人，兩個雲來海都裝不下，那你可得多多努力囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290533
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290533,
					"content": "#{NICKNAME}、派蒙——我們改日再會啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290534
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 110290534,
					"content": "呼…終於，走了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290535
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110290535,
					"content": "總算告一段落了呢！為了難得的重逢，是不是該做點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290536,
						110290537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290536,
					"content": "既然是派蒙提的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290538
					]
				},
				{
					"id": 110290538,
					"content": "——嘿嘿，這種時候，就要做頓好吃的來慶祝一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290539,
					"content": "哈哈，上次在飯桌上跟江蘺、阿雩聊天，都好像是上輩子的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290540,
						110290541
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290540,
					"content": "來之不易的一餐呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290542
					]
				},
				{
					"id": 110290542,
					"content": "喔喔——聽起來很值得期待呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290543,
					"content": "首先，得去市集上選最新鮮的食材——出發出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290544,
					"content": "#{M#大哥哥}{F#大姐姐}！我、我也來幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290545
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290545,
					"content": "白朮，這次…真是多謝你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290546
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290546,
					"content": "師姐哪裡的話，我不過是做了該做的事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290547
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290547,
					"content": "該做的事嗎…白朮、長生，要是方便的話，我們到外面敘敘舊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290541,
					"content": "我也久違地露一手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290542
					]
				},
				{
					"id": 110290537,
					"content": "我大概能猜到是什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290538
					]
				},
				{
					"id": 110290523,
					"content": "原來是胡桃也在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290524
					]
				}
			]
		},
		{
			"id": 1102907,
			"completionStepIds": [
				1102907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102907",
							"2"
						],
						"stepId": 1102907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江蘺",
					"白朮",
					"阿雩",
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290701,
					"content": "…我已看過你的不死藥，其中藥理，與我所煉之毒，有幾分相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290702
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290702,
					"content": "…以毒素維繫生前的狀態，的確是個絕妙的構思。師姐不會是要怪我擅自效仿了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290703
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290703,
					"content": "怎麼會，以你的資質，即便沒有先例，假以時日，也能自行推演出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290704
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290704,
					"content": "但從你與嘉良相遇至今，不過區區數日，就能將這毒研究得如此透徹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290705
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290705,
					"content": "甚至還藉它改進了原有的藥方——這就不是資質可以解釋的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290706
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290706,
					"content": "白朮，你如實告訴我，你…可是親自試過毒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290707
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290707,
					"content": "哈，我就說你藏不了多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290708
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290708,
					"content": "長生的契約，能轉移的…恐怕不只是生機吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290709
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290709,
					"content": "…果然還是瞞不過師姐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290710
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290710,
					"content": "不錯，除了生機，長生的秘法，還能轉移毒素與疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290711
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290711,
					"content": "第二次為嘉良治療時，我就向自己轉移了部分毒素，聊以減輕他的負擔，也利於深研其毒性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290712
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290712,
					"content": "不過眼下所有餘毒，皆已隨魔神殘渣而去，師姐也不必再擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290713
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290713,
					"content": "…這也太冒險了。如果那時候沒有除掉魔神殘渣，就連你自己的身體也——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290714
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290714,
					"content": "…哈，我又有什麼資格說你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290715
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290715,
					"content": "當年我之所以遠離師門、避而不見，就是不想讓時日無多的師父繼續折損壽命，來醫治嘉良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290716
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290716,
					"content": "卻沒想到最後，我冒險煉毒，一樣是以命換命。而你以身試毒…一個兩個，全走上了師父他們的老路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290717
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290717,
					"content": "難道這就是我們這一脈的宿命嗎？為了救人的執念短壽而終，執著於忤逆生死的奇蹟…不可自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290718
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290718,
					"content": "…宿命一說，可不該從一名醫者口中講出來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290719
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290719,
					"content": "白朮，我看得出來，這些年裡，你已經用契約向自己轉移了許多病與毒，其中有不少已經連我都看不透了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290720
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290720,
					"content": "你…還可以收手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290721
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290721,
					"content": "師姐，妳是知道的，我們這一脈，個個都是這性格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290722
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290722,
					"content": "喂——開飯啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290723,
					"content": "媽！來吃飯啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290724
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290724,
					"content": "#{M#大哥哥}{F#大姐姐}教我做了好多菜，說是連爹也能嚐出味道！妳也來試試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290725
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290725,
					"content": "好好好，媽這就來…欸，慢點跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290726
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290726,
					"content": "…白朮，我知道自己勸不動你，但…還請不要忘了，如果你不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290727
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290727,
					"content": "七七、阿桂…所有親近你的朋友，都會為你傷心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290728
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290728,
					"content": "師姐不必掛心，我自有分寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290729
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290729,
					"content": "唉…但願如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290730
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290730,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290731
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290731,
					"content": "白朮…江蘺她剛剛說，你不在了，是什麼意思？你、你該不會有事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290732,
						110290733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290732,
					"content": "還有長生之前說的「宿命」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290734
					]
				},
				{
					"id": 110290734,
					"content": "…包括他們的師父在內，我的歷代契約者，無不短壽而終——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290735
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290735,
					"content": "怎——怎麼會這樣！長生妳不是能讓人延年益壽的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290736,
					"content": "這就是，一個很長、很長的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290737
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290737,
					"content": "…繼承契約，對心性也有要求。歷代契約者，心性皆至純。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290738
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290738,
					"content": "然而至善之人得此秘法，卻比常人，更容易被這忤逆生死的奇蹟吸引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290739
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290739,
					"content": "即便他們比誰都清楚結果會如何，但面對芸芸眾生的悲呼哀鳴、至親摯友的生老病死，終究還是會動用非人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290740
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290740,
					"content": "…就如撲火的飛蛾，在眾生皆苦的長夜中，追尋超脫生死的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290741
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290741,
					"content": "那…白朮你豈不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290742
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290742,
					"content": "呵呵…至於我，大概就是那隻既想追尋光明，又不想被燒著的飛蛾了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290743
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290743,
					"content": "長生的秘法，只是轉移了病痛，卻無法減少世間疾苦——就像嘉良會為師姐的危情慌亂，師姐也會為嘉良的犧牲悲慟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290744
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290744,
					"content": "…我尊敬那些為了理想獻上生命的師長們，但我並不打算成為他們，也不希望這份契約，繼續流傳於後人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290745
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290745,
					"content": "欸…可是，你都往身上轉移了那麼多病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290746,
					"content": "——毒是什麼？病又是什麼？本質上，不都是一種影響人體的方式嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290747
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290747,
					"content": "如果說不同於「平常」的表現，就能被稱之為「病」。那麼「不死藥」…會不會也是一種「毒」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290748
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290748,
					"content": "窮究百毒百病，以達不死之境…即便在常人看來有悖天理，但於我而言，這跟先人們遍嚐百草、克服百病並無區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290749
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290749,
					"content": "我既不想讓後來者繼續因契約而短壽，也不想讓長生失去契約而逝…那麼答案，不就只有一個了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290750
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290750,
					"content": "不死之藥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290751
					]
				},
				{
					"id": 110290751,
					"content": "長生不老…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290752
					]
				},
				{
					"id": 110290752,
					"content": "不錯——我會成為最後一任契約者，讓契約的傳承，在我身上終結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290753
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290753,
					"content": "…真正的不死，就連當年的魔神們都難以企及。既想救人、又想救己，最後連我也想救，可真是太貪心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290754
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290754,
					"content": "呵，若不貪心，還是凡人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290755
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290755,
					"content": "…畏懼燭火，卻又嚮往光明，如此自私的飛蛾——就只能往月亮上飛了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290756
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290756,
					"content": "欸…我都不知道該怎麼說你才好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290757,
					"content": "#白先生！{M#大哥哥}{F#大姐姐}！你們還在聊什麼呢？快來吃飯啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290758
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290758,
					"content": "還有，長生、派蒙，可以來喝，椰奶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290759
					],
					"speakerTitle": "七七"
				},
				{
					"id": 110290759,
					"content": "唔唔…算了，還是吃飯要緊！其他事情，就等吃飽了再想吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290760,
						110290761
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290760,
					"content": "妳啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290762
					]
				},
				{
					"id": 110290762,
					"content": "唉，有時候真羡慕派蒙，吃飽喝足，就能常樂知足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290763
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290763,
					"content": "呵呵，教我們這些凡人貪戀一生的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290764
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290764,
					"content": "…不正是這些，渺小的幸福嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290761,
					"content": "幫我留點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290762
					]
				},
				{
					"id": 110290733,
					"content": "到底是怎麼一回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290734
					]
				}
			]
