						110290802
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290802,
					"content": "唔…這種感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290803
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290803,
					"content": "跟那天迷路的時候一樣…好像身體裡有什麼東西，要帶我去什麼地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290804
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290804,
					"content": "「本體」的影響越來越強烈了，究竟是因為距離變近，還是洩露更嚴重了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290805
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290805,
					"content": "嘉良，你能感覺到具體的方向嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290806
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290806,
					"content": "應該是…這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
