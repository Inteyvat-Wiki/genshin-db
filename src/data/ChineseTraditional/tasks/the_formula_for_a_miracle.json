	"talks": [
		{
			"id": 1102902,
			"completionStepIds": [
				1102902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102902",
							"2"
						],
						"stepId": 1102902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉良"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290201,
					"content": "此地…似乎有不祥的氣息，連我也能感覺到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290202
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290202,
					"content": "我對這裡，有點印象…呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290203
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290203,
					"content": "嘉良！你還好吧？要不然，你先在這裡休息，我們去下面找找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290204,
					"content": "不行…江蘺她，一定還在等我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290205
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290205,
					"content": "呼…快點出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
				}
			]
		},
		{
			"id": 1102903,
			"completionStepIds": [
				1102903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102903",
							"2"
						],
						"stepId": 1102903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"白朮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290301,
					"content": "哇…好陰森的感覺，不知道前面會有什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290302,
					"content": "這裡的開鑿痕跡很粗糙，年代也有些久遠，看著像是個盜洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290303
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290303,
					"content": "盜洞？是說，這附近確實有關於寶藏的傳說，會不會是盜寶團的人挖的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290304,
					"content": "看四處遺落的工具，確實有這可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290305
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290305,
					"content": "…不過他們為什麼連工具也不收拾，就將這裡荒廢了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290306
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290306,
					"content": "…我想起來了，她帶我來過這裡，說是在洞裡發現了救我的方子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290307
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290307,
					"content": "但是…但是她說，這種方法會讓我…可惡，怎麼想不起來了！可惡…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290308
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290308,
					"content": "不必勉強自己，先往前探索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白朮"
				}
			]
		},
		{
			"id": 1102904,
			"completionStepIds": [
				1102904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102904",
							"2"
						],
						"stepId": 1102904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉良",
					"白朮",
					"阿雩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110290401,
					"content": "白先生，怎麼樣？江蘺她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290402
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290402,
					"content": "還有脈象，但絕對談不上樂觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290403
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290403,
					"content": "與你身上的毒素一樣，盤踞此地的魔神殘渣，已經侵蝕了她的神志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290404
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290404,
					"content": "若不盡快祛除，即使暫留一命，恐怕…也再難醒覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290405
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290405,
					"content": "那我們還等什麼？趕快把魔神殘渣除掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290406,
					"content": "…事情沒有那麼簡單，還記得白朮在上面說過的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290407
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290407,
					"content": "嘉良身上的毒，跟這裡的魔神殘渣遙相聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290408
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290408,
					"content": "…一旦祛除了魔神殘渣，他身上的毒，也會一併失效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290409
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290409,
					"content": "唔…嘉良身上的毒，不是用來壓制心病的嗎？那要是失效的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290410,
					"content": "欸！難不成——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290411,
					"content": "不錯，如果祛除此地的魔神殘渣，你的命數…也就到了盡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290412
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290412,
					"content": "…果然，會這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290413
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290413,
					"content": "等等！我們忙了這麼久，不就是為了幫嘉良治病嗎！怎麼能…怎麼能這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290414,
					"content": "白朮你見多識廣，一定還有別的辦法…對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290415,
					"content": "…或者，你可以繼續服用此毒，多爭取一點時間。師姐的情況…我們另外再想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290416
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290416,
					"content": "看江蘺的樣子，恐怕一直到昏迷前，都一心在為你煉藥吧——或許她也希望你這麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290417
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290417,
					"content": "…白先生，請你如實告訴我，江蘺她…還能撐多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290418
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290418,
					"content": "魔神殘渣已經侵入肺腑，正常來說，不足三日，但如果我以秘法施救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290419,
						110290420
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290419,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290421
					]
				},
				{
					"id": 110290421,
					"content": "…可那又有什麼意義呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290422
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290422,
					"content": "白先生，來之前，已經有人向我說過魔神殘渣的危害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290423
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290423,
					"content": "如果繼續靠這種東西活著，不僅江蘺要繼續冒著危險給我煉藥，將來要是失控，還會殃及周圍，傷到江蘺跟阿雩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290424
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290424,
					"content": "…反正我這條命，十幾年前就該交代了。能活到現在，看見阿雩長大，都算是岩王爺保佑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290425
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290425,
					"content": "如果最後能換江蘺回來…我就算是…就算是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290426
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290426,
					"content": "嘉良…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290427,
					"content": "…哈，果然人該走的時候沒走，就越來越貪心了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290428
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290428,
					"content": "#白先生、{NICKNAME}，請再給我一點時間，讓我…多看江蘺一眼吧，一眼就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290429
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290429,
					"content": "…好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290430
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290430,
					"content": "謝謝…抱歉，各位的恩情…得來世再報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290431
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290431,
					"content": "嘉良他…白朮、長生，真的連你們也沒有辦法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290432,
					"content": "尋常手段，只怕師姐這些年裡都已試遍了。別的方法，我也沒有幾成把握…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290433
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290433,
					"content": "生老病死，本就是凡人逃不開的宿命。若是輕易能救，江蘺也不必向非人之物伸手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290434
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290434,
					"content": "怎麼會…江蘺好不容易才救了嘉良，嘉良又要犧牲自己去救江蘺…這、這到底有什麼意義啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290435,
						110290436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110290435,
					"content": "現在我們唯一能做的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290437
					]
				},
				{
					"id": 110290437,
					"content": "我還是習慣不了生離死別…不管見過多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290438
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290438,
					"content": "凡人之間終有一別，死得其所，或許也是個不錯的落幕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290439
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290439,
					"content": "…至少你的師父他們，都是這麼想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290440
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290440,
					"content": "他們的選擇確實令人動容，可那些「死得其所」的生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290441
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290441,
					"content": "…往往，才是最不該逝去的生命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290442
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290442,
					"content": "…當初我們說好，只要阿雩長大到能幫妳採藥，就讓我上路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290443
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290443,
					"content": "妳看現在，他都能帶我上璃月港看病了，還去幫妳掛了委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290444
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290444,
					"content": "…就算我不在，你們倆，也能好好活啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290445
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290445,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290446
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290446,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290447
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290447,
					"content": "已經不需要更多時間了，請你們…送我上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290448
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290448,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290449
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 110290449,
					"content": "…唔…呃啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290450
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290450,
					"content": "…你的心智、記憶都會被它侵蝕…到最後，就跟死了沒有兩樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290451
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290451,
					"content": "…用吧，至少…我還能守著你們，看著阿雩長大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290452
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290452,
					"content": "…哈…哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290453
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290453,
					"content": "…媽！爹的樣子不太對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290454
					],
					"speakerTitle": "阿雩"
				},
				{
					"id": 110290454,
					"content": "…沒事的，沒事的，媽媽這就去採藥。我們一家人，誰都不會有事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290455
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290455,
					"content": "哈…都到這時候了，還想這些做什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290456
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290456,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290457
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290457,
					"content": "人啊，真是越活越貪心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290458
					],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290458,
					"content": "——！——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110290459
					],
					"speakerTitle": "江蘺"
				},
				{
					"id": 110290459,
					"content": "真想…再聽聽妳的聲音啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉良"
				},
				{
					"id": 110290436,
					"content": "就是見證嘉良的覺悟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290437
					]
				},
				{
					"id": 110290420,
					"content": "難道你又想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110290421
					]
				}
			]
		},
		{
			"id": 1102905,
