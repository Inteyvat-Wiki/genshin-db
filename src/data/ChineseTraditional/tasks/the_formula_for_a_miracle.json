			"dialogs": [
				{
					"id": 110291001,
					"content": "哇，這裡居然還有香爐？那些盜寶團，還滿懂享受的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110291002,
						110291003
