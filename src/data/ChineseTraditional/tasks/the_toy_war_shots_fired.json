					"卡隆"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745000201,
					"content": "#兩位客人{F#妳}{M#你}們好啊，我是小店店主卡隆，請問有什麼需要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000202
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000202,
					"content": "卡隆老闆你好，我們聽說這裡有一個超級厲害的玩具，想要來瞭解一下啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000203,
					"content": "呵呵，當然可以，不過…兩位是大哥請來打探情報的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000204
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000204,
					"content": "欸？大哥？不對不對…你怎麼一下子就知道我們是來打探情報的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000205,
					"content": "#我剛才看到，{F#妳}{M#你}們從發條工坊那邊過來，那家店的店主是我大哥，所以我立刻就知道怎麼回事了，這完全是他會做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000206
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000206,
					"content": "怎麼…一下子就露餡了，這樣算那個…出師未捷什麼來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000207,
					"content": "哎呀，我們應該做更多準備再來的，誰知道你們是兄弟啊，原本以為是同行相爭，沒想到是…是…是手足相殘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000208,
					"content": "派蒙，不要亂用措辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000209
					]
				},
				{
					"id": 745000209,
					"content": "不好意思老闆…我腦袋一時打結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000210,
					"content": "別在意，再好的玩具、零件偶爾也會卡住，人也是一樣，所以要好好保養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000211
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000211,
					"content": "而且…在大哥眼裡，我們大概就是那種情況吧。算了，不說這個耽誤兩位時間了，我來介紹一下玩具吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000212
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000212,
					"content": "欸，老闆不介意嗎？我們…我們可以算是商業間諜哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000213,
					"content": "哈哈，商業間諜，客人真有趣，小店真正的商品是那些鐘錶，是祖傳下來的技藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000214
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000214,
					"content": "但玩具只是我個人的愛好，這是帶來快樂的東西，讓更多人知道，不就是等於把快樂傳遞到更遠的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000215
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000215,
					"content": "哇，老闆的說法很溫柔呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000216,
					"content": "#哈哈，如果是我大哥，他一定會說這是缺乏冒險精神…言歸正傳，兩位不如試試玩具吧，希望{F#妳}{M#你}們喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000217
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000217,
					"content": "我聽說老闆是在蒙德得到的靈感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000218
					]
				},
				{
					"id": 745000218,
					"content": "沒錯，我從小就嚮往蒙德，直到前陣子有機會過去旅遊，果然收獲不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000219
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000219,
					"content": "我把在蒙德遇見的一位冒險家的故事融入在裡面。不過兩位也不用太期待，說到底它也只是個簡單的發條玩具而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000220
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000220,
					"content": "冒險家？原來不是什麼煉金術玩具啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000221,
					"content": "煉金術玩具？聽起來很有趣。不過這位冒險家，也是一位讓人印象深刻的朋友，有機會我再好好說說他的故事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000222
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000222,
					"content": "現在兩位不如先試試這個玩具？說一千句不如親手試一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000223
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000223,
					"content": "#雖然很想，但是那邊還等著我們回覆呢，{NICKNAME}，還是說我們快去快回吧！好想立刻體驗到這個冒險家玩具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000224
