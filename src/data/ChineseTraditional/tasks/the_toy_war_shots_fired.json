			"dialogs": [
				{
					"id": 745000101,
					"content": "真討厭啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000102
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000102,
					"content": "對啊，太討厭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000103
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000103,
					"content": "這豈不是芙寧娜大人坐審判桌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000104
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000104,
					"content": "一點都沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000105
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000105,
					"content": "芙寧娜大人坐審判桌？那是什麼意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000106,
					"content": "哦！有客人來了，看打扮，兩位貴客是外地人吧？聽不懂楓丹俗語很正常，且聽敝人問一句，審判桌是讓誰坐的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000107
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000107,
					"content": "當然是審判官大人囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000108
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000108,
					"content": "那我們的最高審判官是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000109
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000109,
					"content": "當然是那維萊特大人囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000110
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000110,
					"content": "哎呀，那維萊特大人的位置，怎麼被水神芙寧娜大人坐了去啊？兩位貴客，這讓堂下被審判的可憐的人該作何感想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000111
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000111,
					"content": "要是我絕對會覺得被欺騙了啊，水神大人怎麼會懂審判嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000112
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000112,
					"content": "呃…這樣說，好像有種掛羊頭賣狗肉的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000113,
					"content": "一點都沒錯！掛羊頭賣狗肉，就是這個意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000114
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000114,
					"content": "原來那句話是這個意思啊。欸？！等等，你們拿自己的神明這樣開玩笑沒關係嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000115,
					"content": "當然有關係啊，水神大人最喜歡這樣的玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000116
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000116,
					"content": "如果被她聽見，一定會把敝人綁上石頭沉入深湖，然後興致勃勃地在旁邊觀賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000117
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000117,
					"content": "#但兩位貴客，{F#妳}{M#你}們猜如何，原來阿爾邦這樣的下人的嘴巴太油滑，最後根本沉不下去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000118
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000118,
					"content": "「得救了！」水神大人一定會激動地鼓起掌，說不定還會流下幾滴眼淚，「真是太浪漫了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000119
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000119,
					"content": "搞不好還會頒發「楓丹浪漫市民」的勳章給敝人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000120,
						745000121
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000120,
					"content": "真是太浪漫了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				},
				{
					"id": 745000122,
					"content": "我、我有點不知道該說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000123,
					"content": "那麼言歸正傳，兩位貴客今天來小店有什麼需要呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000124
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000124,
					"content": "話說回來，阿爾邦，你有沒有覺得兩位客人的打扮…有點像是老闆之前交代的著名冒險家啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000125
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000125,
					"content": "#哦！的確有點，如同金子和銀子般耀眼的頭髮…哦哦哦哦——所以兩位貴客是…{NICKNAME}{M#先生}{F#女士}，和派蒙女士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000126
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000126,
					"content": "嗚哇，你們認識我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000127,
					"content": "老闆之前在冒險家協會打聽了最近在楓丹活動的冒險家，協會告知了兩位貴客的資訊，告訴我們是一對十分厲害的搭檔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000128
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000128,
					"content": "#嘿嘿，{NICKNAME}{M#先生}{F#女士}，看來我們名氣越來越大了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000129,
						745000131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000129,
					"content": "派蒙，妳是託我的福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000130
					]
				},
				{
					"id": 745000130,
					"content": "#哼，就算是這樣，{F#妳}{M#你}也可以謙虛一點嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000133,
					"content": "所以說，兩位，你們老闆找我們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000134,
					"content": "真不湊巧，老闆他現在不在店裡，就先由我們來說說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000135
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000135,
					"content": "那就簡單講兩句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000136
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000136,
					"content": "一句話來說，老闆的「決鬥代理人企劃」想請兩位貴客來幫忙收集資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000137
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000137,
					"content": "「決鬥代理人企劃」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000138,
					"content": "就是以決鬥代理人為故事主角、為研發重心、為宣傳方向的一項全新發條玩具企劃。哦，小店是買賣玩具的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000139
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000139,
					"content": "說起來，兩位貴客聽過「決鬥代理人」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000140,
						745000141
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000140,
					"content": "我知道，請繼續說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000145
					]
				},
				{
					"id": 745000145,
					"content": "老闆認為這是一個絕佳的楓丹文化符號，如果製作一款這個題材的玩具，說不定能夠大受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000146
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000146,
					"content": "萬一在其他國家也大受歡迎，還能提升國民榮譽感，一舉兩得！芙寧娜大人直接發勳章給我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000147
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000147,
					"content": "原來是這樣…可是你們要做「決鬥代理人」玩具，找我們冒險家幹嘛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000148,
					"content": "研發嘛，總需要一些數據來支撐。「決鬥代理人」的強大，是透過深入各種危險的地方錘煉武藝得來的，拿到他們的資料可不簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000149
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000149,
					"content": "但是聽說冒險家中的厲害角色，也會做類似的事，不如就請冒險家來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000150
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000150,
					"content": "啊！我好像有點聽懂了…打著「決鬥代理人」旗號的玩具，卻讓冒險家來提供資料，是這樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000151,
						745000152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000151,
					"content": "掛羊頭賣狗肉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000153,
					"content": "哪有到那個地步嘛，頂多就是移朵海露花，接棵懸鈴木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000154
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000154,
					"content": "偷根木房梁，換條大石柱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000155
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000155,
					"content": "那不都是差不多的意思嘛，明明你們自己一開始都在討論，我們都聽見啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000156,
					"content": "噢——那個啊，那是在說隔壁的隔壁的那家勒波特鐘錶店，他們可是比我們過分多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000157
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000157,
					"content": "#明明招牌寫著鐘錶店，卻偷偷賣起了玩具，{F#妳}{M#你}們說說看，這像話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000158
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000158,
					"content": "太不像話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000159
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000159,
					"content": "鐘錶店賣玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000160,
					"content": "對啊，您不覺得這很可惡嗎？不如拿您來說好了，請問您最重視的是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000161
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000161,
					"content": "#我最重視的…？那當然、那當然是我最好的夥伴{NICKNAME}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000162,
					"content": "#那假如有一家店名叫「{NICKNAME}玩偶商店」，結果您跋山涉水跑去一看，發現店裡賣的根本不是{NICKNAME}玩偶，只有一大堆阿爾邦玩偶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000163
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000163,
					"content": "一想到買到好夥伴的期待落空，是不是就很生氣，想大哭大鬧，想要一拳把老闆打飛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000164
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000164,
					"content": "太生氣啦！誰要買阿爾邦玩偶啦！是我就一拳把老闆打進梅洛彼得堡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000165
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000165,
					"content": "#啊呀呀，被你們這樣一說，好像的確有點生氣…怎麼辦，{NICKNAME}，我不想要{F#妳}{M#你}的玩偶突然就買不到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000166,
						745000167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000166,
					"content": "等等，他們是在偷換概念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000168,
					"content": "對哦！我差點掉進你們的圈套了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000169,
					"content": "哎呀，只是個比喻而已，比喻難免有點失真…而且我說的那種情況也不是沒有，晶螺糕裡不就沒有晶螺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000170
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000170,
					"content": "對啊，這種事肯定會越來越多，鐘錶店不賣鐘錶遲早也會發生。除非改名成勒波特玩具工坊，否則絕不原諒他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000171
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000171,
					"content": "這次又在用假設性問題預設別人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000172
					]
				},
				{
					"id": 745000172,
					"content": "你們還真是歪理大王！再聊這些一定被越繞越遠，還是說正事啦，我們要怎麼幫你們收集資料呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000173
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000173,
					"content": "這個嘛，其實在這之前，還有一件小事想要拜託兩位：能否移步隔壁的隔壁，去勒波特鐘錶店幫我們打探一下消息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000174
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000174,
					"content": "雖然說本業是發條鐘錶，但新品玩具卻很熱門，人氣都被吸跑了。據說，那玩具是他們老闆在蒙德得到的靈感，真想知道是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000175
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000175,
					"content": "說不定是什麼煉金術玩具呢，散發著比日落果還要甜蜜四倍的氣味，讓附近的人一下子就著迷，聽說蒙德有這樣的煉金術大師對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000176
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000176,
					"content": "四倍甜日落果？那該不會是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000177
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000177,
					"content": "所以，請兩位貴客幫我們去打聽一下那個玩具，老闆很在乎這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000178
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000178,
					"content": "你們為什麼不自己去看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000179
					]
				},
				{
					"id": 745000179,
					"content": "貴客呀，做生意的哪有不要面子的嘛，哪能這麼光明正大地過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000180
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000180,
					"content": "是面子啊！面子大過天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000181
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000181,
					"content": "剛好兩位貴客登門的事，我得去跟老闆彙報下，所以這件事求您幫幫忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000182
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000182,
					"content": "#{NICKNAME}，這麼說我也有點好奇，從蒙德得到靈感的楓丹玩具長什麼樣子呢，難道真的和煉金術有關係？要不然我們先去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000183,
					"content": "真是太感謝了，我們就在這等著兩位凱旋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000167,
					"content": "人家是多賣東西，不是少賣東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000152,
					"content": "芙寧娜大人坐審判桌！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000141,
					"content": "沒聽過，能解釋一下嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000142
					]
				},
				{
					"id": 745000142,
					"content": "那是楓丹的一種特殊制度，假如您觸犯了什麼事情，面臨審判時，您可以申請與「決鬥代理人」進行「決鬥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000143
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000143,
					"content": "若是戰勝了「決鬥代理人」，您就能擺脫罪名，維護自己的名譽，無需再被審判。當然，想戰勝「決鬥代理人」並不是什麼輕鬆的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000144
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000144,
					"content": "絕對比賣玩具難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000145
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000131,
					"content": "派蒙女士，我是託您的福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000132
					]
				},
				{
					"id": 745000132,
					"content": "#嘿嘿嘿，{F#妳}{M#你}說話也越來越好聽了哦，以後我的福氣都分{F#妳}{M#你}一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000121,
					"content": "這就是楓丹人的浪漫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				}
			]
		},
		{
			"id": 7450002,
