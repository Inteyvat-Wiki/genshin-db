			"dialogs": [
				{
					"id": 745000301,
					"content": "老闆，兩位客人回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000302
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000302,
					"content": "不愧是冒險家協會大力推薦的人，兩位辦事果然迅速。我是店主利弗，歡迎歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000303
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000303,
					"content": "利弗老闆，你好你好，原來那邊的卡隆老闆和你是兄弟啊，我們都不知道這件事，一下子就被他認出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000304,
					"content": "阿爾貝，你在搞什麼？這麼重要的事情都忘記和貴客交代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000305
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000305,
					"content": "你這個阿爾邦！不是說讓你來說的嗎？老闆，你要扣就扣這傢伙的薪水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000306
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000306,
					"content": "喂，你們兩個該不會也是兄弟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000307,
					"content": "我沒有這樣的兄弟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000308
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000308,
					"content": "咳咳…兩位的意思是…任務失敗了？什麼也沒打聽到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000309
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000309,
					"content": "沒有沒有，卡隆老闆是個很溫柔的人，即使知道了也不介意，還歡迎我們隨時去試玩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000310,
					"content": "呵呵，那小子…所以那個真的是煉金術玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000311
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000311,
					"content": "不是，是一個冒險家玩具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000312
					]
				},
				{
					"id": 745000312,
					"content": "哼，原來還是老掉牙的冒險家玩具。他是不是還說，把什麼冒險家的故事融入到了裡面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000313
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000313,
					"content": "對對對，老闆你怎麼知道？你該不會已經偷偷調查過吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000314,
					"content": "那小子我太瞭解了，他總是把一些感性的東西放進玩具裡，一點都不考慮市場。冒險家故事已經不適合這個時代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000315
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000315,
					"content": "可是他們的店人氣很旺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000316
					]
				},
				{
					"id": 745000316,
					"content": "正常的經營波動而已，等我們的「決鬥代理人」企劃完成，絕對會把他們打得人仰馬翻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000317
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000317,
					"content": "又不是真的「決鬥代理人」，是我們這種「過時」的冒險家假扮的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000318,
					"content": "這就是兩位不懂了，這叫包裝，市場就吃這套，沒人管你們到底怎麼做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000319
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000319,
					"content": "只要拿到數據，再把它放進一些熱門的玩具原型，再宣稱這是一段關於「決鬥代理人」成長的故事，事情就搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000320
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000320,
					"content": "就這樣嗎？總覺得這種故事會有問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000321,
					"content": "故事有問題不重要，有噱頭就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000332
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000332,
					"content": "如果我說，阿爾邦和阿爾貝其實就是以「雙人喜劇」為題材製作的仿真玩具魔偶，您怎麼想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000322
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000322,
					"content": "什麼？！玩具魔偶？！真的…真的有這麼逼真的玩具魔偶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000323,
					"content": "當然，就是這麼逼真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000324
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745000324,
					"content": "「雙人喜劇」的世界，騙人也能騙得這麼逼真哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000325
					],
					"speakerTitle": "阿爾貝"
				},
				{
					"id": 745000325,
					"content": "看到了吧？這就是包裝的力量，即使是噱頭，但只要這樣說了，就會有人產生興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000326
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000326,
					"content": "嗚哇！原來是騙人的，你也太狡猾了吧…跟你弟弟之間的差別真大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000327,
					"content": "那小子不好好經營自己的發條鐘錶，非要插手玩具這個行業，我這個當大哥的，當然要好好教育他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000328,
						745000329
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000328,
					"content": "你確實有一手啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				},
				{
					"id": 745000330,
					"content": "承蒙誇獎。那麼，接下來就請兩位貴客記在心上了，數據收集的事，主要由阿爾邦和阿爾貝負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000331
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745000331,
					"content": "哼哼，你們的兄弟之爭我們根本管不到啦，只要不要少了我們的摩拉喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000329,
					"content": "果然是無奸不商。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				}
			]
		},
