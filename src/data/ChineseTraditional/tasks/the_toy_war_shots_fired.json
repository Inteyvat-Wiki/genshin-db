			"dialogs": [
				{
					"id": 745000401,
					"content": "#兩位客人{F#妳}{M#你}們好啊，我是小店店主卡隆，請問有什麼需要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000402
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745000402,
					"content": "老闆你們這裡好多人哦，是在辦什麼活動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745000403,
					"content": "呵呵，算不上什麼活動，只是小店最近新推出了一款新品玩具。就是店門口那個。兩位如果有興趣，可以隨時過來體驗。",
