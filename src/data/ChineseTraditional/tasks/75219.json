			"dialogs": [
				{
					"id": 752190101,
					"content": "#啊…那邊的，是{NICKNAME}吧，還請留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190102,
					"content": "這裡有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190103,
					"content": "哦，怎麼了？有什麼需要幫忙的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190104,
					"content": "哈哈，不是，是你們有一封快捷郵件，真是湊巧，我正想著要去哪裡找你們呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190105,
					"content": "你們就出現在我面前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190106,
					"content": "咦，是誰寄過來的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190107,
					"content": "說到這個，這可是長途跋涉來到這裡的快捷郵件啊，輾轉了很多手，才從冒險家協會轉到懸木人的訊使這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190108,
					"content": "畢竟納塔最近的情況比較特殊，正常的商隊往來都擱置了好一段時間，沒寫寄件人，不過看落款…似乎是從楓丹來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190109,
					"content": "看來你們在楓丹也有不少朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190110,
					"content": "那我就收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "嗯，真是火神保佑，剛拿到的快捷郵件就找到了收貨人，今天的工作有了個好的開頭啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190113,
					"content": "#好了，我接下來要去送其他東西了，祝{F#妳}{M#你}們今天也一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "胡奇魯"
				},
				{
					"id": 752190114,
					"content": "好哦，你也工作順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190115,
					"content": "唔，是楓丹來的，看上去輕飄飄的，與其說是快捷郵件，看上去就像是一封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190116,
					"content": "我們快拆開來看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190117,
					"content": "啊，原來是夏洛蒂寄過來的。唔，原來是離開楓丹的時候拍攝的畫片呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190118,
					"content": "明明離拍這張畫片的時候還沒有多久，可是又覺得已經隔了很長很長的時間了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190119,
					"content": "嘿嘿，我們這就把這張畫片好好收起來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190111,
					"content": "嗯，交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				}
			]
		}
	]
}