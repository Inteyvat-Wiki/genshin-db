			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭加惟",
					"蘭羅摩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#是蘭羅摩和金色的那菈呀，{F#妳}{M#你}可真高。但旁邊這個銀色的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810302,
					"content": "嗯？銀色的怎樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810303,
					"content": "該怎麼說呢…應該可以鑽進很狹窄的樹洞吧，很方便很方便！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810304,
					"content": "#嗯！按照那菈的習俗，應該要先介紹。這是那菈{NICKNAME}和派蒙，這是蘭加惟。你們握手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810305,
					"content": "有點不知所措地和蘭加惟握手了…\\n不敢太用力。\\n觸感很特別。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "真有趣。以前我也聽大家說過許多那菈的事，但接觸到那菈的身體還是第一次。感覺很奇妙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810307,
					"content": "上一次有那菈到我們這來，已經過了很久。許多的種子都長成了大樹，許多的故事都變成了傳說。據說，那是很好的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810308,
					"content": "#那菈{NICKNAME}也是很好的那菈，勇敢又強壯，就像在岩壁上長出來的小樹一樣。而且，{M#他}{F#她}們要幫助蘭拉娜，才來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810309,
					"content": "喔喔，蘭拉娜嗎…好久沒見到了，希望一切都好。也希望維摩莊的小那菈們一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810310,
					"content": "你也認識維摩莊的孩子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "當然認識呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810312,
					"content": "我們都認識！蘭拉娜回來，都跟我們說小那菈的故事。所以，那菈優丹、那菈巴蘭、那菈拉娜他們，就是我們的那菈朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810313,
					"content": "這樣倒也不算是認識啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810314,
					"content": "那，要怎樣才算認識呢？要像那菈那樣，「介紹」以後，「握手」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810315,
					"content": "嗯嗯，派蒙說的，我明白。那菈還要一起吃飯、一起找「寶藏」，才算認識。對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810316,
					"content": "也不是那麼簡單的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "只要知道故事，就算認識。因為蘭那羅的世界是歌的世界、夢的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810322,
					"content": "#嗯，蘭加惟說得對。對蘭那羅來說，只要聽到了描繪那菈{NICKNAME}的歌、夢中見到了那菈{NICKNAME}的樣子，就認識了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810323,
					"content": "我覺得，這個可以先放一邊…因為，我們已經是蘭那羅的朋友了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810324,
					"content": "好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "蘭羅摩和蘭加惟"
				},
				{
					"id": 730810325,
					"content": "好朋友！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "嗯，我們要舉辦無憂節，蘭加惟要做好準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810329,
					"content": "果然如此。是為了惟耶之實吧？我已經讓蘭耶娑、蘭陀娑和蘭修提袈去尋找「覺樹之堂」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810330,
					"content": "直覺真準…不過，為什麼你們不知道覺樹之堂在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810331,
					"content": "覺樹之堂是很神聖很神聖的地方，我們一般不會去。就讓莎蘭樹靜靜地沉睡在夢中吧。直到一切記憶在沙恆中交會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810332,
					"content": "森林會記住一切。一切美好的事物都不會消散。一切痛苦都會成為美好事物的養分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810333,
					"content": "總之，蘭耶娑、蘭陀娑和蘭修提袈他們在外面尋找覺樹之堂。蘭羅摩，你去幫幫他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810334,
					"content": "#嗯。我會去的。如果那菈{NICKNAME}、派蒙在森林裡遇到了我們，就一起冒險吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730810335,
					"content": "#很好很好。很高興認識{F#妳}{M#你}們，那菈{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭加惟"
				},
				{
					"id": 730810327,
					"content": "還是先談正事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "該怎麼說呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "我和派蒙一起吃飯、一起找寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "嗯！我們不但認識，而且是最好的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730810320,
					"content": "#那菈{NICKNAME}和派蒙，真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "蘭羅摩"
				}
			]
		},
