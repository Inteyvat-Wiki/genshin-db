			"dialogs": [
				{
					"id": 715100101,
					"content": "怎麼樣，「普爾希娜光釘」成功運作了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100102,
					"content": "成功了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "成功就好，成功就好，雖然「普爾希娜光釘」不能一次性就將噴口全部封閉，但是只要成功一次，就能夠持續運行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100105,
					"content": "這樣，將所有噴口全部封閉也只是時間問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100106,
					"content": "這問題總算解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100107,
					"content": "我想想，得把這些記錄下來，等關於「普爾希娜光釘」的完全研究報告上交之後，說不定我…我還能成為院內的風雲人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100108,
					"content": "#嗯，這些都可以寫進我將來的自傳裡，「我曾與身手超凡的{NICKNAME}於『層岩巨淵』經過一番實驗…」這樣記錄好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100109,
					"content": "那我就等著那一天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "哈哈，不過我寫研究報告很熟練，寫傳記啊，故事啊這種文體恐怕就有些拙劣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100111,
					"content": "#希望到時候{F#妳}{M#你}不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715100103,
					"content": "大部分黑泥都清理乾淨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				}
			]
		}
