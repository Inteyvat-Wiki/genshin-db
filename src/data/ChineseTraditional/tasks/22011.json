			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻紀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "#{F#妳}{M#你}已經收拾好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110202,
					"content": "已經收拾好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "#多謝{F#妳}{M#你}。這些籤文就交給我吧，我會把它掛在合適的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110204,
					"content": "#這些東西請{F#妳}{M#你}收下，謝謝{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110205,
					"content": "大家迫切想要化解厄運，或者是交上好運的心情，我也不是不能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110206,
					"content": "但是我想…如果真的想要解決某些眼前的問題，比起一味地求籤祈福，還是自己行動起來更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110207,
					"content": "如果自己都不行動的話，就算神明想要給予幫助，也完全沒有途徑吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				}
			]
		},
