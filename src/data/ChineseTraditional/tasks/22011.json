				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻紀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "真是的…到底是誰傳的這個謠言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110102,
					"content": "什麼謠言？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "是關於神社裡求籤的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110104,
					"content": "知道「求籤」是什麼意思吧？簡單來說，就是用抽籤的方式進行的一種占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110105,
					"content": "根據抽到籤上的籤文，人們也能得知一些對於未來的簡單預言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110106,
					"content": "抽到了好籤自然沒問題，如果抽到不太好的籤，人們一般就會把籤留在神社這邊，以此祈求化解可能到來的厄運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110107,
					"content": "但是…不知道到底是誰開始流傳一則謠言，說什麼抽到壞籤就快丟到樹頂上，神靈會優先為消災驅禍之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110108,
					"content": "還說什麼，丟得越高，好運就越快會實現，而厄運就越快被化解。真是無稽之談！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110109,
					"content": "然後，這個謠言越傳越離譜，現在不僅是抽到的籤，還有人往樹上丟摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110110,
					"content": "還有模有樣地說，只要丟上去的摩拉能停在樹梢上，那就是神明接受了祈禱，不僅心中的願望能實現，還能帶來一整年的好運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110111,
					"content": "真的有這種事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "怎麼可能！先不說到底神明能不能聽到祈禱…但丟摩拉這種事也太離譜了，摩拉不都長得一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110113,
					"content": "難道他們是想讓神明把摩拉一枚枚撿起來看不成？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110116,
					"content": "雖然我理解大家都想要祈福，但…但這樣往上丟東西，根本就祈不了福啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110117,
					"content": "而且，那些丟上去的籤文和其他東西被風一吹，掉得到處都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110118,
					"content": "我之前也試著自己去收拾過，但我實在不擅長運動，不僅東西沒收拾乾淨，反而因為不知道怎麼下來而折騰了好一陣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110119,
					"content": "#但放著那些東西不管的話也絕對不行…旅行者，{F#妳}{M#你}能幫我去屋頂收拾一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110120,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "#這件事就拜託{F#妳}{M#你}了，旅行者，請去屋頂收拾一下吧，如果拿到籤的話，請拿來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110122,
					"content": "那些籤會怎麼處理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "那些籤…按照螢美小姐的意思，無論怎麼說，那些都是大家求到的「運道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110124,
					"content": "如果隨便丟掉的話，未免有點不合適，所以收拾下來之後，我也會把那些籤按規矩放在它們應該在的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110125,
					"content": "唉，如果大家從一開始就按規矩做的話，哪還會這麼麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110126,
					"content": "#這件事就拜託{F#妳}{M#你}了，旅行者，請去屋頂收拾一下吧，如果拿到籤的話，請拿來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110114,
					"content": "只要說清楚就可以了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "這麼做的人實在是太多了，我已經快要說不過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻紀"
				}
			]
		},
		{
			"id": 2201102,
			"completionStepIds": [
				2201105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
