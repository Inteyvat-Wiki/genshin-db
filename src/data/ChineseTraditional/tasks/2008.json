				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "奇怪，今天怎麼這麼安靜，和平時完全不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080302,
					"content": "汪汪…汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080303,
					"content": "難道說，又是這種雙簧演出嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080304,
					"content": "托馬——托馬——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080305,
					"content": "汪！汪！…汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080306,
					"content": "喂——不要再躲了，我已經看見你啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080307,
					"content": "嗯？完全沒有人回應，托馬跑到哪裡去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080308,
					"content": "汪汪汪！汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080309,
					"content": "咦？平時一直那麼老實的太郎丸，今天好像很急躁的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080310,
					"content": "兩位，有看到托馬嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080311,
					"content": "我們還以為他跟妳在一起呢，發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080312,
					"content": "糟糕…我在來這裡的路上，聽說托馬被天領奉行的人抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080313,
					"content": "我沒辦法判斷消息是真是假，就立刻跑過來確認。如果托馬沒有按照約定出現在這裡，意味著傳聞很有可能是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080314,
					"content": "雷電將軍會在千手百眼神像前，舉辦第一百顆神之眼的「狩眼儀式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080315,
					"content": "而那第一百顆神之眼的持有者…也就是即將被公開狩眼的對象，恐怕…就是托馬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080316,
					"content": "難道托馬之前聽說的，天領奉行正在籌備的「儀式」，剛好就是為他準備的「狩眼儀式」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080317,
					"content": "應該…是的。將軍和天領奉行的人準備以第一百顆神之眼的「狩眼儀式」，證明眼狩令的階段性成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080318,
					"content": "…不行，我必須去救他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080319,
					"content": "汪汪！汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080320,
					"content": "冷靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "但「白鷺公主」也代表社奉行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "是呀，如果妳親自過去的話，不就代表社奉行要和雷電將軍為敵了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080323,
					"content": "公然反抗雷電將軍的話，社奉行那些普通人也會被牽連進來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080324,
					"content": "這也是沒辦法的事…時間已經不多了，儀式就要開始，我不能就這樣放棄托馬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080325,
					"content": "他是我的朋友，明明不久之前，我們大家還一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080326,
					"content": "他也是我的朋友，我去救他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080328,
					"content": "妳剛才說過吧？——時間不多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080330,
					"content": "#…嗯，我會…等{F#妳}{M#你}們平安回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20080331,
					"content": "放心吧，綾華，事關朋友的性命，我們絕對不會失手的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
