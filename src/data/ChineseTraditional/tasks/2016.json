	"talks": [
		{
			"id": 201601,
			"completionStepIds": [
				201601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201601",
							"2"
						],
						"stepId": 201601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160101,
					"content": "跟著我說，「三二一，一二三，啊啊——」，快一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160102,
						20160104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160102,
					"content": "「三二一，一二三，啊啊——」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160103
					]
				},
				{
					"id": 20160103,
					"content": "嗯嗯，不錯不錯，說明至少腦子目前還是沒什麼大礙的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160106,
					"content": "#好不容易把{F#妳}{M#你}這個像是嵌在了地裡的小傢伙撈回來，要是壞掉了就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160107,
					"content": "唔，從一開始我就想問，神子，妳的談吐舉止和第一次見到妳的時候怎麼完全不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160108,
					"content": "是嗎？可能是摒退了其他那些巫女們的緣故吧。而且，我一直都是這個樣子喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160109,
					"content": "人們所展現出來的，從來都是自己想展現出來的一面，這點我清楚得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160110,
					"content": "所以，不論哪一面其實都是真正的「自我」，只是人們總喜歡無意義地去定義罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160111,
					"content": "在這姑且屬於人類的社會裡，我也不過憑自己興趣照做而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160112,
					"content": "我，好像聽不太懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160113,
					"content": "呵呵，多多研究人類吧，小傢伙，妳也會明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160114,
						20160115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160114,
					"content": "妳究竟是如何…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160116,
					"content": "是呀！我當時光顧著照看旅行者，完全沒注意妳究竟做了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160117,
					"content": "#是「鳴神大社的秘法」，一下子就讓那個叫散兵的傢伙跪地求饒，{F#妳}{M#你}相信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160119
					]
				},
				{
					"id": 20160119,
					"content": "#呵呵，比起思考這樣的問題，{F#妳}{M#你}更應該好好想想該怎麼回報我…不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160120,
					"content": "#還是說，{F#妳}{M#你}的腦袋迴路，果然還是出了些問題呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160121,
					"content": "非常感謝妳，八重神子大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160122
					]
				},
				{
					"id": 20160122,
					"content": "#倒也不必這麼鄭重就是了，我需要的是{F#妳}{M#你}的行動，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160123,
					"content": "#{F#妳}{M#你}現在應該…還在惦記「邪眼」的事，是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160124,
						20160125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160124,
					"content": "沒錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160126,
					"content": "放心好了，那個海祇島的領航人已經帶手下前去清剿了，也向全軍頒佈了嚴肅的軍令，禁止使用邪眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160127,
					"content": "散兵那傢伙也不會在據點都暴露的情況下，替他的同僚做些自討沒趣的頑抗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160176
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160176,
					"content": "唉，要是有時間，真想看看那些愚人眾大吃苦頭的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160128
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160128,
					"content": "做得可真不錯啊，名為珊瑚宮心海的女人，好想當面再跟她好好聊聊，只可惜…信仰分歧真是礙事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160129,
					"content": "礙事？妳可是鳴神大社的宮司呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160130,
					"content": "#好了，告訴{F#妳}{M#你}這些只是為了讓{F#妳}{M#你}放心，然後專心…替我辦一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160131,
						20160132
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160131,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160133,
					"content": "#{F#妳}{M#你}…見過她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160134,
						20160135
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160134,
					"content": "妳是說雷電將軍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160136,
					"content": "#我說的，不是那個「人偶」，我是說…{F#妳}{M#你}應該見過「她」了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160137,
						20160138
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160137,
					"content": "妳是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160139,
					"content": "嗯，為了維持「自我」，而在「一心淨土」中進行著無窮無盡冥想的，真正的雷電將軍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160140
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160140,
					"content": "——其名為「影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160141
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160141,
					"content": "妳是說，儀式上出現的只是人偶，而真正的雷電將軍是旅行者後來見到的那個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160142,
					"content": "也就是說，當時變換過的不只是「戰場」，連「對手」也換過了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160143,
						20160144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160143,
					"content": "我也留意到一些微妙的差別…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160145,
					"content": "這才是那位雷電將軍的「永恆」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160146
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160146,
					"content": "在追求這個國度的永恆之前，勢必自己要先觸及永恆才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160147
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160147,
					"content": "肉身終會歸於塵土，就由「人偶」之身來替代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160148
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160148,
					"content": "精神亦難逃磨損，她便將意識寄宿於佩刀之中，用冥想來規避一切紛擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160149
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160149,
					"content": "那麼，她用刀劃開的那個空間就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160150,
					"content": "「一心淨土」，即是與她的「內心世界」一樣的空間，通常只容許「自我」的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160151
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160151,
					"content": "封閉在自我的世界裡，外部的繁雜都交給那個只會不顧一切奔向永恆的人偶來處理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160152
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160152,
					"content": "…這就是影摸索出的永恆之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160153,
						20160154
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160153,
					"content": "鍾離也談及過「磨損」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160155,
					"content": "#{F#妳}{M#你}說的是摩拉克斯嗎？許久不見，原來璃月的神做出了這樣的選擇，果然是位有趣的神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160156
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160156,
					"content": "不過雷電將軍這樣做，好像確實可以避免鍾離那樣的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160157,
					"content": "呵呵，可是…她的做法不也很像是發脾氣把自己關在屋裡的孩童一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160158
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160158,
					"content": "而且她所謂的「永恆」，也早已變成了她自己以為的「永恆」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160159
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160159,
					"content": "說到底…不過是在害怕失去而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160160
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160160,
					"content": "我還不清楚妳想要我做什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160161
					]
				},
				{
					"id": 20160161,
					"content": "#其實…{F#妳}{M#你}我立場一致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160162
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160162,
					"content": "#{F#妳}{M#你}想要拯救眼狩令之下的稻妻子民，我也一樣，只不過順帶還想拯救一下這個國家，也拯救一下她而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160163
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160163,
					"content": "而關鍵就在於——既然「一心淨土」也代表著影的內心世界，那麼在那裡擊敗她的話，就有著「扭轉」雷電將軍意志的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160164
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160164,
					"content": "這就是妳想到的，廢除眼狩令的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160165,
					"content": "不是靠言語駁倒她，也不是借用反抗軍的力量政變，而是…直接扭轉雷電將軍的內心世界？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160166
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160166,
					"content": "理解得很快嘛，總之，這是稻妻墜入「黑暗的永恆」之前，唯一還趕得上讓它重新走上正軌的方法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160167,
						20160168
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160167,
					"content": "可是為什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160169,
					"content": "#{F#妳}{M#你}還沒意識到自己的特殊之處嗎？我說過，「一心淨土」一般來說是只容許自我存在的空間，而{F#妳}{M#你}可以出現在那裡就證明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160170
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160170,
					"content": "#…她對{F#妳}{M#你}有足夠的興趣。或許…她也從未見過對永恆來說顯得如此「不穩定」的個體吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160171
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160171,
					"content": "沒有其他人進去過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160172,
					"content": "從那個永恆的信徒開始封閉自我時起，從來沒有過，甚至沒人知道那個空間裡究竟是什麼樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160173
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160173,
					"content": "#{F#妳}{M#你}的存在不僅是契機，更是「鑰匙」…{F#妳}{M#你}果然沒讓我的期待落空啊，小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160174
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160174,
					"content": "欸，妳怎麼就走了？要去哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160175,
					"content": "#<color=#00E1FFFF>「反雷電將軍特訓」</color>啊，我可是為{F#妳}{M#你}精心準備的，快跟上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160168,
					"content": "一定要我來呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160154,
					"content": "也是他退位的原因之一。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160144,
					"content": "可是她為何要如此大費周章？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160138,
					"content": "在那個「空間」裡的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160135,
					"content": "見過，就在神像之下的儀式上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160132,
					"content": "這就是救我的原因嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160125,
					"content": "後來怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160115,
					"content": "從散兵手上救下我的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160104,
					"content": "八重神子！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160105
					]
				},
				{
					"id": 20160105,
					"content": "喔？一下子就認出我來了，表示至少腦子目前還是沒什麼大礙的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201604,
			"completionStepIds": [
				201604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201604",
							"2"
						],
						"stepId": 201604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160401,
					"content": "呼…完成啦，這下怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160402,
					"content": "#嗯，完成情況很不錯，我看到{F#妳}{M#你}們的決心和努力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160403,
					"content": "那妳覺得，我們這下能打贏雷電將軍了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160404,
					"content": "我看嘛…完全不是對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160405,
					"content": "喂！那不是全白費了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160406,
					"content": "#呵呵，{F#妳}{M#你}們是計畫當中最重要的一環，我自有盤算，又怎會讓{F#妳}{M#你}們毫無勝機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160407,
					"content": "#說起來…旅行者，{F#妳}{M#你}對反抗軍勢力怎麼看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160408,
						20160409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160408,
					"content": "老實說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				},
				{
					"id": 20160410,
					"content": "呵，的確如此。即便偶爾能跟幕府軍在正面戰場取得些優勢，但真正面對雷電將軍的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160411,
					"content": "就憑那些神之眼都被嵌進神像了的人們所組成的部隊，或許真的是些蝦兵蟹將而已了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160412,
					"content": "不要說得那麼直白啦，旅行者還是「劍魚二番隊」的隊長耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160413,
					"content": "呵呵，我沒有貶低他們的意思，倒不如說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160414,
					"content": "正因為他們的渺小，正因為他們失去了神之眼，他們才有更加珍貴的「意志」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160415
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160415,
					"content": "總之，如果能按計畫進行的話，是一群還算幫得上忙的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160416,
					"content": "計畫…究竟是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160417
					]
				},
				{
					"id": 20160417,
					"content": "唔…時間差不多了，我還有另外一位客人，先隨我回<color=#00E1FFFF>鳴神大社</color>再談吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160418,
					"content": "怎麼突然又要去接待客人了！真搞不懂妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160409,
					"content": "也不是雷電將軍的對手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				}
			]
		},
		{
			"id": 201605,
			"completionStepIds": [
				201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201609",
							"2"
						],
						"stepId": 201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160501,
					"content": "#好了，就先在這裡聊吧。關於{F#妳}{M#你}之前問及的計畫，其實我也揣摩了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160502,
					"content": "#{F#妳}{M#你}知道制定計畫之前，最重要是什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160503,
					"content": "是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160504,
					"content": "——認清局勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160505,
					"content": "頒佈眼狩令，明顯是有人利用「人偶將軍」一心只為永恆的特點所做出的誘導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160506,
						20160507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160506,
					"content": "「散兵」的情報也證實了這一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				},
				{
					"id": 20160508,
					"content": "嗯，這一點的確是最好的佐證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160509,
					"content": "而回想一下眼狩令的頒佈與執行，向來都是由天領奉行左右，並且推助法令進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160510,
					"content": "綾華好像也說過，每次呈上反對眼狩令的文書的時候，天領奉行和勘定奉行都會馬上否決，沒有商量的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160511,
						20160512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160511,
					"content": "天領奉行正在為愚人眾做事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160513,
					"content": "嗯，其實早就已經很明顯了，除社奉行外的兩奉行，都與愚人眾有所勾結。哼，利慾薰心的愚蠢人類們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160514,
					"content": "於是，現狀便是愚人眾那邊的「攪局者」依舊存在，籠絡了兩奉行，又在暗中推廣邪眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160515,
					"content": "只可惜如今，在兩奉行與雷電將軍的庇護下，還揪不出那個攪局人的尾巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160516,
					"content": "那要怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160517,
					"content": "把切入點放在稻妻人身上，總歸要好下手一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160518
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160518,
					"content": "我準備…策反天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160519,
					"content": "策反天領奉行？妳在說什麼呀，天領奉行不是已經在造反了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160520,
					"content": "呵呵，我指的不是天領奉行背叛幕府的事，而是…讓某個人背叛如今的天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160521,
					"content": "#利用「她」的話，想必一定可以把{F#妳}{M#你}…再次帶到雷電將軍的面前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160522,
						20160523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160522,
					"content": "別賣關子了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160524,
					"content": "正統領著幕府軍的人，每個月的這個時間，都會來神社祭拜，也是我們今天的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160525,
					"content": "#她好像…已經在{F#妳}{M#你}身後了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160526,
					"content": "不要動！通緝犯居然敢大搖大擺地出現在神社！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160527
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160527,
					"content": "#別想動什麼歪心思，老實跟我一起去奉行所。抓住{F#她}{M#他}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160528
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160528,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160529
					],
					"speakerTitle": "元助"
				},
				{
					"id": 20160529,
					"content": "九條…裟羅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160530,
					"content": "喲，是不是幾位都忘了，這裡可是鳴神大社…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160531,
					"content": "在這裡動武的話，不敬將軍的罪名…你們準備誰來頂一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160532,
					"content": "…呿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160533
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160533,
					"content": "八重宮司大人，莫非…妳是在庇護這個通緝犯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160534
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160534,
					"content": "朋友之交而已，哪裡談什麼庇護不庇護。妳先叫那些手下退下吧，有些事我們可以好好談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160535,
					"content": "你們先去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160536
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160536,
					"content": "遵命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160537
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 20160537,
					"content": "那麼，敢問八重宮司大人，在神社藏匿通緝犯一事，是否也是對將軍不敬呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160538
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160538,
					"content": "呵呵呵…還是老樣子，九條裟羅大人，論對將軍的忠心，沒人能及得上妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160539,
					"content": "身為臣下，自當忠於將軍；身為武人，將軍的境界亦是我一生所求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160540
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160540,
					"content": "即便雷電將軍…遲早要把妳的神之眼也奪走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160541
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160541,
					"content": "眼狩令是將軍的決斷，我絕無怨言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160542
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160542,
					"content": "唉，只可惜…一片赤誠，終被時局所負。該說妳是糊塗，還是唯一清醒的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160543,
					"content": "請您直說，宮司大人，您此話是何意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160544
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160544,
					"content": "眼狩令不過是受了愚人眾的誤導，讓稻妻國民自廢雙手的愚政罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160545
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160545,
					"content": "而「蒙蔽聖聽」的正是妳自家的主子，天領奉行——九條家的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160546,
					"content": "妳是說，九條家…叛變了幕府？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160547
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160547,
					"content": "正是，妳理解的沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160548
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160548,
					"content": "八重宮司大人，您的指控不僅危險，而且可笑。三奉行自古侍奉將軍，絕無二心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160549
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160549,
					"content": "我被九條家收養以來，耳濡目染，天領奉行上上下下都對將軍忠心耿耿，尤其是家主孝行大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160550
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160550,
					"content": "他對「無想的一刀」的崇拜，勝於所有人，我對將軍的尊崇之情不及他萬分之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160551
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160551,
					"content": "試問家主又怎麼可能做出於將軍不利之事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160552
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160552,
					"content": "三天後…等三天後妳再來這裡，我會把證據給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160553
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160553,
					"content": "身為宮司，我很清楚一件事，人們總是喜歡相信自己願意相信的事。所以有些事，可能只是妳不願看到而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160554
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160554,
					"content": "那就只好…由我來當這個壞人，把它抽絲剝繭，好好呈現給妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160555
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160555,
					"content": "哼…三天對吧，我會來。但如果我沒看到證據，那還請宮司大人對妄測九條家一事道歉，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160556
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160556,
					"content": "#…{F#她}{M#他}我也會一併帶回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160557
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20160557,
					"content": "好了，那就三天後，恭候您的光臨了，客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160558
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160558,
					"content": "嚇死我了，想不到九條裟羅會到這裡來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160559,
					"content": "話說神子，妳剛才所說的，天領奉行叛變的證據…已經有眉目了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160560
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160560,
					"content": "怎麼總是在問這樣的問題，當然沒有了。我是看剛才說服不了裟羅，才臨時想到這麼講的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160561
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160561,
					"content": "唔…不出所料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160562,
					"content": "「扭轉神明的意志」這件事，本身就是一場大的賭局啊，有誰可以面對神明還有十成的把握呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160563
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160563,
					"content": "那我們該怎麼辦，時間只剩下三天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160564
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160564,
					"content": "想拿到證據的話，我們還需要一個幫手，現在…隨我去把那位<color=#00E1FFFF>「專業人士」</color>給叫醒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160523,
					"content": "那個人究竟是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160512,
					"content": "勘定奉行也早已背叛幕府了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160507,
					"content": "是愚人眾為了趁勢推廣邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				}
			]
		},
		{
			"id": 201606,
			"completionStepIds": [
				201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201608",
							"2"
						],
						"stepId": 201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160601,
					"content": "就是這裡了嗎？前面那個<color=#00E1FFFF>機關</color>是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160602,
					"content": "就當作是可以再現雷電將軍招式的法器吧，我憑著記憶製作的…如果她的武藝沒有退步的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160603,
					"content": "能提前摸索好她的出招路數，並找到應對策略的話，會有很大幫助的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160604
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160604,
					"content": "#{F#妳}{M#你}去試著不要被那些招式打到吧，畢竟從她手中死裡逃生過一次，應該難不倒{F#妳}{M#你}們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201607,
			"completionStepIds": [
				201607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201607",
							"2"
						],
						"stepId": 201607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160701,
					"content": "可真是好好鍛煉了一番呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160702,
						20160703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160702,
					"content": "不過如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160704
					]
				},
				{
					"id": 20160704,
					"content": "話說回來，神子妳為什麼知道這麼多有關雷電將軍的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160705,
					"content": "欸，妳問我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160706,
					"content": "可能因為…我就是「雷神眷屬」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160707
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160707,
					"content": "欸！類似特瓦林和巴巴托斯的關係那樣嗎？還真是看不出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160708,
					"content": "#呵呵，那聽起來{F#妳}{M#你}們對我「狐狸小姐」的模樣更感興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160709,
						20160710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160709,
					"content": "想看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160711,
					"content": "想得美喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160712,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160713,
					"content": "其實奇怪的地方並非我的身姿，而是我與她已經不再相見了，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160714
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160714,
					"content": "「永恆不變的國度」是我與她共同的夢想，但我並不認為那意味著完全的「靜止」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160715
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160715,
					"content": "從某個時刻開始，她便走上了我愈發難以觸及的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160716
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160716,
					"content": "在影踏入「一心淨土」之前，並沒有與我道別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160717
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160717,
					"content": "或許是一廂情願吧，我想，這也是她所認為的，讓友誼保持永恆的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160718
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160718,
					"content": "不去道別，也不再見面，我們之間的關係便恆久地維持在當年的模樣，至少在她心裡是這樣想的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160719,
						20160720
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160719,
					"content": "一廂情願的或許是雷電將軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160721,
					"content": "既然已經踏上了兩條截然不同的永恆之路，我可以繼續維持現狀，也可以選擇不計代價地將她帶回正軌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160722
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160722,
					"content": "如今我選擇後者，正因為…如果遁入「一心淨土」是她對永恆的一意孤行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160723
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160723,
					"content": "那把她從自我的世界裡揪出來，便是我作為「永恆的眷屬」的踐行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160724
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160724,
					"content": "神子小姐…是個很好的朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160725,
					"content": "#呵，不過是為了方便{F#妳}{M#你}們理解我的計畫，才把這些告知{F#妳}{M#你}們，可別得意忘形喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160726
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160726,
					"content": "好了，聊天到此為止，是時候進行<color=#00E1FFFF>「反雷電將軍訓練第二期」</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160727
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160727,
					"content": "原來還有呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160720,
					"content": "雷電將軍過於偏頗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160710,
					"content": "感興趣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160703,
					"content": "有些吃力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160704
					]
				}
			]
