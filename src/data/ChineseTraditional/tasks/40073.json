				"objectNames": [
					"菲謝爾",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730401,
					"content": "呵…壯麗又脆弱、龐大又膽怯…令我讚嘆，也讓我作嘔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730402
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730402,
					"content": "小姐的意思是，從沒見過這麼誇張的幻境，即使是她本人也嘆為觀止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧茲"
				}
			]
		},
		{
			"id": 4007306,
			"completionStepIds": [
				4007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007306",
							"2"
						],
						"stepId": 4007306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲謝爾",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730601,
					"content": "這裡有個城堡，但不完整。菲謝爾，這是妳的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730602,
					"content": "唔…待本皇女思量片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730603
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730603,
					"content": "不必想了小姐，這正是您從前因悲傷過度不慎手滑打碎的城堡玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730604
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400730604,
					"content": "奧茲！不要說出來！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730605
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730605,
					"content": "本皇女剛剛想起，有關我之皇城，可是缺失了兩部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730606
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730606,
					"content": "所以是要找兩個碎片對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
