			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神情嚴肅的夜鴉",
					"眼神凜冽的夜鴉",
					"莫娜",
					"菲謝爾",
					"奧茲",
					"辛焱",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730201,
					"content": "站住！又是你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730202
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400730202,
					"content": "幹什麼？我們可是皇女殿下的家臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730203,
					"content": "不不，胡言亂語！皇女殿下可不認得你們這種小人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730204
					],
					"speakerTitle": "眼神凜冽的夜鴉"
				},
				{
					"id": 400730204,
					"content": "哈？你能為自己說的話負責嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730205
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400730205,
					"content": "我再說一次，皇女殿下可不認得你們這種…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730206
					],
					"speakerTitle": "眼神凜冽的夜鴉"
				},
				{
					"id": 400730206,
					"content": "汝剛才說，誰是小人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730207
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730207,
					"content": "皇女殿下和奧茲大人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730208
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400730208,
					"content": "對幽夜淨土的諸位臣子說出這種話，守衛先生們未免太冒犯了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730209
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400730209,
					"content": "哼。本皇女精心挑選的臣子，豈容汝等看輕？還不速速退下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730210
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730210,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730211
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400730211,
					"content": "沒有可是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730212
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730212,
					"content": "是、是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730213
					],
					"speakerTitle": "眼神凜冽的夜鴉"
				},
				{
					"id": 400730213,
					"content": "菲謝爾、奧茲，你們歸隊啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730214,
					"content": "嗯哼，汝暫且這樣認為罷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730215
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730215,
					"content": "小姐的意思是，我們花了不少時間才找到這裡。雖說不願面對這處幻境，但也不能拋下各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730216
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400730216,
					"content": "莫娜說對了呢，「不願面對」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730217
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400730217,
					"content": "有種日記本被人偷看的感覺對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730218,
					"content": "…膚淺。本皇女若真是輕易就能動搖之人，世上可不會有如此壯麗的幽夜淨土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730219
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730219,
					"content": "小姐的意思是，這裡還有別的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730220
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400730220,
					"content": "麻煩？你們遇到什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730221
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400730221,
					"content": "…嗚…這件事稍後再議，先辦正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730222
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400730222,
					"content": "動起來動起來，書就在眼前，可不能傻站著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007304,
			"completionStepIds": [
				4007304
			],
