			"trigger": {
				"objectNames": [
					"辛焱",
					"楓原萬葉",
					"萊昂",
					"菲謝爾",
					"奧茲",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731301,
					"content": "小哥，你這個樣子，以後怎麼出門啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731302
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731302,
					"content": "旅行需要耐力、勇氣和危機意識。你有了耐力和勇氣，之後還請注意增強危機意識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731303
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731303,
					"content": "各位的話，我會牢牢記在心中。但這一次，我們真的該告別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731304
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731304,
					"content": "您或許還沒有察覺，但我知道，天氣變得晴朗，海面平靜又美麗…為了這一天，我們等待許久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731305
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731305,
					"content": "各位一定為我這樣冒失的人都能當上演員感到奇怪，但請相信我，這不是偶然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731306
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731306,
					"content": "每一隻夜鴉都在尋找工作。工作，等同於我們的命運。我們生來便要找到自己命中註定該扮演的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731307
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731307,
					"content": "各位或許還沒聽說，《聖國的詠唱》，是一本預言書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731308
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731308,
					"content": "預言書？可它不是你們的聖典嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731309,
					"content": "是的。數百年前，幽夜淨土被不祥之氣覆蓋，我們的主人卻像失去了治國的興趣一般，未採取任何行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731310
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731310,
					"content": "隨後有一天，大書記官奧茲出現在我們之中。它帶來聖典與一則振奮人心的預言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731311
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731311,
					"content": "那預言正如書中所寫，昭示著幽夜淨土真正的幸福。為此，我們堅信滿天陰霾必會散去，我們衷心期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731312
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731312,
					"content": "救世的主宰者…皇女殿下。她一定會想起這裡本是怎樣的樂土，為了她，我們要仿照預言，獻上戲劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731313
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731313,
					"content": "所以我站出來，扮演勇士。我願走過千難萬險，踏過刀山火海…去向她獻上我的真心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731314
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731315
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731315,
					"content": "您…您是皇女殿下？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731316
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731316,
					"content": "對哦，剛才救援的時候她不知為什麼躲在後面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731317,
					"content": "我之臣民，汝的意志足以斫斷邪龍的手足。現在，我會收下汝的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731318
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731318,
					"content": "我備感榮幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731319
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731319,
					"content": "汝做得很好。騎士的美德，汝也已然具備。去吧，就位，等待演出開幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731320
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731320,
					"content": "讚美您對皇女殿下的虔誠之心。覆蓋幽夜淨土全境的陰霾，將由皇女殿下率領我等扈從擊潰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731321
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731321,
					"content": "…感謝殿下，也感謝各位英雄！那麼，我就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731322
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731322,
					"content": "對了，如果各位需要…請務必記得，前方大門的口令是「永夜的序曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731323
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400731323,
					"content": "我都糊塗了，你們剛才在演哪齣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731324,
					"content": "難道在場諸卿就沒有一人能聽懂我之箴言嗎？愚笨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731325
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731325,
					"content": "小姐的意思是各位很笨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731326
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731326,
					"content": "這種話就不用翻譯了！妳說誰笨，我已經完全明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731327
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731327,
					"content": "嗯，皇女殿下先前說的「正事」，就是這個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731328
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731328,
					"content": "速戰速決，走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731329
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731329,
					"content": "欸？等等，怎麼了，究竟怎麼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007315,
			"completionStepIds": [
				4007315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007315",
							"2"
						],
						"stepId": 4007315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"菲謝爾",
					"幽夜菲謝爾",
					"奧茲",
					"辛焱",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731501,
					"content": "圖書館？我們在圖書館裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731503
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731503,
					"content": "…呵，我苦苦搜尋的宿敵，無為又懦弱的所謂皇女，就是妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731504
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731504,
					"content": "可笑。妳又為什麼覺得自己能夠戰勝我呢？要知道，妳先前表現出的恐懼和猶豫，我可是看得一清二楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731505
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731505,
					"content": "怎麼還有一個妳啊，是影子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731506,
					"content": "影子？對…我們之間確實如此。妳是來向我投降的嗎？小艾咪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731507
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731507,
					"content": "嗚…妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731508
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731508,
					"content": "那邊那位夜鴉，你是奧茲？很好，我也等待了許久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731509
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731509,
					"content": "聽說，有位名叫奧茲的大書記官把《聖國的詠唱》帶入幽夜淨土。想必，就是你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731510
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731510,
					"content": "…誠惶誠恐，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731511
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731511,
					"content": "你怎麼叫她小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731512
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731512,
					"content": "如各位所見，那邊的也是小姐。既是小姐，就是我奧茲的主人，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731513
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731513,
					"content": "…不無道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731514
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731514,
					"content": "不妨告訴各位，幽夜淨土是有來無回的地方。你們來到這裡，就要被我征服，成為我的奴隸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731515
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731515,
					"content": "至於奧茲，雖然你帶來令我不快的預言之書，還令愚蠢的臣民們瘋狂朝拜那言之無物的東西，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731516
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731516,
					"content": "你可是奧茲啊，那不如到我身邊來。畢竟，「菲謝爾就是要與奧茲搭檔的呢」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731517
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731517,
					"content": "感謝小姐的賞識，那我就恭敬不如從命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731518
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731518,
					"content": "奧茲？！你去哪裡？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731519
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731519,
					"content": "他居然去對面了，菲謝爾，這就是妳養的好烏鴉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731520,
					"content": "嗚啊啊啊現在不是數落我的時候吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731521
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731521,
					"content": "奧茲，你被蠱惑了嗎？為什麼相信她說的話，幽夜淨土不該是自由與戲劇的聖土嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731522
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731522,
					"content": "大錯特錯。幽夜淨土才不是那種兒童遊樂園一樣的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731523
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731523,
					"content": "聽好了…它是為無法面對現實之人準備的墳墓。妳會葬身此地，我則帶著我們幻想出來的奧茲，永居王城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731524
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731524,
					"content": "…墳墓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731525
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731525,
					"content": "妳應該最清楚才是。為什麼幽夜淨土下著雨？為什麼這片樂土上沒有真正的歌聲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731526
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731526,
					"content": "…是因為妳，就是妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731527
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731527,
					"content": "哦呵呵，太可笑了，妳才是罪魁禍首吧！小艾咪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731528
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731528,
					"content": "呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731529
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731529,
					"content": "幻想出如此龐大的國度，卻不能承受。對自身創造的事物感到動搖，就算再怎麼逃避，也無法改變妳自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731530
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731530,
					"content": "是因為妳無法真正抵達這裡，我才降臨於此，代行職責。幽夜淨土現今是我的東西，輪不到妳來指手畫腳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731531
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731531,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731532
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731532,
					"content": "小艾咪，妳是一個軟弱的傻瓜，不配擁有這個世界。滾出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731533
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731533,
					"content": "喂，說夠了沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731534
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731534,
					"content": "自己罵自己還能罵得這麼精彩，看來這件事困擾妳很久了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731535
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731535,
					"content": "莫娜…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731536
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731536,
					"content": "妳這是什麼表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731537
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731537,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731538
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731538,
					"content": "哼。妳該不會要認輸吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731539
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731539,
					"content": "…我不想承認，可是…她說的，也許沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731540
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731540,
					"content": "不，請別這麼想。皇女殿下，還記得我們為何來到這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731541
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731541,
					"content": "萬葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731542
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731542,
					"content": "我是來自稻妻的劍客，負責守護妳的安全。至於這幾位，也都應妳呼喚而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731543
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731543,
					"content": "有自己的墳墓，聽起來也挺酷的。但很可惜，幽夜淨土不是墳墓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731544
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731544,
					"content": "辛焱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731545
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731545,
					"content": "…哦，交到朋友了呢。但妳以為這樣就能贏過我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731546
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731546,
					"content": "我可是妳的恐懼與黑暗，是妳這麼多年來始終無法逃避的噩夢，在我面前，妳一無是處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731547
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731547,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731548
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731548,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731549
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731549,
					"content": "…不對。我不能…我…還不能輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731550
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731550,
					"content": "我才是贏家！給我等著，妳會後悔的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲謝爾"
				}
			]
		},
		{
			"id": 4007317,
			"completionStepIds": [
				4007317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007317",
							"2"
						],
						"stepId": 4007317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"幽夜菲謝爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731701,
					"content": "不可能，妳竟然能通過那個噩夢般的圖書館…給我退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731702
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731702,
					"content": "…現在，妳還覺得我會輸嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731703
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731703,
					"content": "妳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731704
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731704,
					"content": "妳看不起我，覺得我懦弱、渺小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731705
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731705,
					"content": "我是有過那樣的日子，因為…我是一個不能面對現實，成天做白日夢還不堪一擊的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731706
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731706,
					"content": "可現在我明白了，在看到這片幻境的一瞬間，我就想明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731707
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731707,
					"content": "看到外面那麼驚人的幻象了嗎？無比龐大、無比美麗…這就是我的想像力，我力量的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731708
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731708,
					"content": "妳似乎很自大，黑暗的東西總是很狂妄。但不應該是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731709
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731709,
					"content": "妳根本不是一個完整的皇女，只是鑽在我影子裡沾沾自喜的灰塵！妳才是失敗者，那個拖我後腿的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731710
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731710,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731711
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731711,
					"content": "懦弱，所以渾身尖刺；膽小，所以靠自暴自棄來偽裝。這樣的妳…比我更弱小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731712
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731712,
					"content": "還給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731713
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731713,
					"content": "什、什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731714
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731714,
					"content": "把屬於我的東西還給我！幽夜淨土、王城、子民…還有還有最重要的，我的夥伴，奧茲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731715
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731715,
					"content": "哎呀，小姐竟然能說出如此流利又極富氣魄的話語，您當真成長為皇女了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731716
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731716,
					"content": "還敢說話，你這個叛徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731717
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731717,
					"content": "不，小姐，我之所以在這裡，是為了向各位證明一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731718
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731718,
					"content": "眾所周知，奧茲會跟隨斷罪之皇女菲謝爾。兩位既然都是菲謝爾，我出現在誰的身邊都不要緊才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731719
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731719,
					"content": "可是您看，當我站在這一邊的時候，您也沒有失去自己的身分不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731720
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731720,
					"content": "原來如此，高明的勸誡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731721
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731721,
					"content": "我的身分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731722
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731722,
					"content": "您認為，「菲謝爾」究竟是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731723
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731723,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731724
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731724,
					"content": "這是我給小姐您的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731725
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731725,
					"content": "菲謝爾…是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731726
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731726,
					"content": "是生活的失敗者，一個心懷恐懼的膽小鬼，無法面對幻想之外缺乏謊言的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731727
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731727,
					"content": "不，您說得不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731728
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731728,
					"content": "菲謝爾…是…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731729
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731729,
					"content": "噢，反應很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731730
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731730,
					"content": "欸？就這麼簡單？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731731
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731731,
					"content": "這才對，小姐。菲謝爾，或許是斷罪之皇女，卻不總是。或許勇敢高傲，卻也膽小懦弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731732
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731732,
					"content": "菲謝爾是您自己。既高貴又平凡，是水準一流可總也交不到太多朋友的冒險家、是不可思議之國的皇女殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731733
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731733,
					"content": "菲謝爾，既膽小又強大，懼怕他人的閒言碎語，也渴望得到他人的崇敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731734
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731734,
					"content": "更重要的是…菲謝爾，是一個常在心中自我批判，被自己打敗無數次，又無數次站起的進取者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731735
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731735,
					"content": "小姐，除了您，沒有人當得起菲謝爾這個名字。它是複雜而單純的符號，指向夢想與自由之美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731736
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731736,
					"content": "無論是否受人追隨，小艾咪就是菲謝爾。菲謝爾是您——在心中無意識寫下那句箴言的賢明之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731737
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731737,
					"content": "…「令我的子民自由，不囿於古老法則。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731738
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731738,
					"content": "感謝您創造幽夜淨土，為我等搭建家園，又於潛意識中寫下《聖國的詠唱》，使我等永遠堅信光明將到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731739
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731739,
					"content": "現在，殿下，請接受您的黑暗，恢復成原本的姿態吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731740
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731740,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731741
					],
					"speakerTitle": "幽夜菲謝爾"
				},
				{
					"id": 400731741,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731742
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731742,
					"content": "嗚哇，穿禮服的那個消失了！欸等等…又冒出來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731743,
					"content": "看來，影子回到了她本來的位置，也就是菲謝爾心裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731744
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731744,
					"content": "…哦呵呵呵，來了嗎，諸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731745
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731745,
					"content": "哦？這種感覺是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731746
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731746,
					"content": "啊哈哈哈，我之臣民們！聽見了嗎，本皇女的召喚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731747
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731747,
					"content": "聽到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731748
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400731748,
					"content": "一恢復精神就吵吵嚷嚷的，受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731749
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731749,
					"content": "奧茲所言甚是，今日正是本皇女取回真心，再度君臨幽夜淨土的偉大時刻。現在，我宣佈——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731750
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731750,
					"content": "——歡迎來到幽夜淨土！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731751
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731751,
					"content": "太好了太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007318,
			"completionStepIds": [
				4007318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007318",
							"2"
						],
						"stepId": 4007318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲謝爾",
					"奧茲",
					"莫娜",
					"嘟嘟通訊儀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731801,
					"content": "（真是令人高興的日子。我找回自己，成為了真正的皇女。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731802
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731802,
					"content": "（幽夜淨土真的降臨了。儘管如此，我也明白，隱藏在我心中的負面情感並不會就此消逝。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731803
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731803,
					"content": "（沒關係，我會帶著這些弱點繼續戰鬥。因為我已經明白，我所擁有的東西獨一無二，如此美妙。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731804
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731804,
					"content": "菲謝爾，聽說外面劇場已經搭起來了，妳不去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731805,
					"content": "派蒙卿，注意言辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731806
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731806,
					"content": "哦哦！好吧，皇女殿下，您不願賞光外出看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731807,
					"content": "噗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731808
					]
				},
				{
					"id": 400731808,
					"content": "咳！身為臣子，竟敢嘲笑光彩榮耀偉大的皇女。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731809,
						400731810
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731809,
					"content": "不是嘲笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				},
				{
					"id": 400731811,
					"content": "…嘿嘿，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731812
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731812,
					"content": "盡情狂歡吧，今天可是幽夜淨土的大日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731813
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400731813,
					"content": "噢，小姐的意思是，誠心邀請諸位奉上最大的熱忱，盡情慶賀這至夜聖土降臨於世的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731814
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731814,
					"content": "好啦好啦，別再翻回菲謝爾語了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731815,
					"content": "…噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731816
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731816,
					"content": "假如是這樣的國度…當地的戲劇表演，一定很好看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731817
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731817,
					"content": "至於我關注的謎題，應該也快有答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731818
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731818,
					"content": "對了，好像還有件事沒做。皇女殿下、奧茲，我們失陪一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731819,
					"content": "好的，二位等等見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731820
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400731820,
					"content": "再試試，看能不能聯繫上溫迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731821,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731822
					]
				},
				{
					"id": 400731822,
					"content": "嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731823
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731823,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731824
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731824,
					"content": "#咦，是{F#妳}{M#你}呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731825
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731825,
					"content": "這個聲音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731826
					]
				},
				{
					"id": 400731826,
					"content": "我從來沒聽過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731827
					]
				},
				{
					"id": 400731827,
					"content": "欸？不是賣唱的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731828,
					"content": "對不起，妳是哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731829
					]
				},
				{
					"id": 400731829,
					"content": "嗯，我們確實素不相識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731830
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731830,
					"content": "#我知道{F#妳}{M#你}想聯絡海島之外的人，但現在還不行哦。所以，我截斷了{F#妳}{M#你}的通訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731831
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731831,
					"content": "咦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731832,
					"content": "#比起詢問，{F#妳}{M#你}不想自己找出答案嗎？不可思議的幻境，它代表「深夢」，正是人心最本質的映射。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731833
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731833,
					"content": "#去看吧。親眼看清這一切，待故事落幕，再告訴我{F#妳}{M#你}的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731834
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400731834,
					"content": "…聯絡斷開了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731835
					]
				},
				{
					"id": 400731835,
					"content": "#喂{NICKNAME}，剛才那是誰啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731836
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731836,
					"content": "#好奇怪，為什麼這個人能截斷我們跟溫迪的聯絡…她又為什麼要問{F#妳}{M#你}的感受呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731837,
					"content": "唔…不行，我想不明白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731838,
					"content": "我也還不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731839
					]
				},
				{
					"id": 400731839,
					"content": "#有點害怕，但…但我會保護{F#妳}{M#你}的，不論發生什麼事，我都陪著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731840,
					"content": "嗯。我們先保密。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731841
					]
				},
				{
					"id": 400731841,
					"content": "（那個人的話語中沒有半點惡意，反倒帶著強烈的試探。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731842
					]
				},
				{
					"id": 400731842,
					"content": "（不知她想從我這裡得到什麼答案，但在那之前…我會看完所有的故事。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400731810,
					"content": "看到妳打起精神來就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				}
			]
		}
	]
}