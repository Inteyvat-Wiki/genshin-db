					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "又回到這裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480702,
					"content": "上次來這裡，按照人的壽命來算都是前前前前前前…世時候的事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480703,
					"content": "看來我們都被重新丟入無想之間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480704,
					"content": "所以我們應該怎麼出去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "普通的辦法就是學習冥想，控制心和思緒，然後拋棄所有渴望的念頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480706,
					"content": "保持什麼都不想的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480707,
					"content": "講起來滿簡單的。但是根據人的素質和渴望程度之不同，辦到這一點從幾年到幾百年的都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480708,
					"content": "#像{F#妳}{M#你}這種背負世界命運的人，渴望恐怕無法被自己割捨吧——何況也不應該被捨棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480709,
					"content": "那怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "先找到彩特琳德再想辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480711,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761480712,
					"content": "你撿了什麼來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "等等，小右也一起被拉進來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480714,
					"content": "那麼這一切或許還有轉機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480715,
					"content": "同為守望者，或許小右可以利用這些碎片裡的力量，強行開闢一條出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480716,
					"content": "這個碎片總歸是需要個名字方便稱呼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480717,
					"content": "這些過於誇張的棺材我略有耳聞，是神殿主人某個姐妹佈置的——好像是叫做「死隨念棺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480718,
					"content": "那這些碎片就叫做「念亡碎片」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亞"
				}
			]
		}
	]
}