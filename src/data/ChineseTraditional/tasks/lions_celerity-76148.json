			"dialogs": [
				{
					"id": 761480101,
					"content": "嗚啊，你們剛才去哪裡了？！嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761480102,
					"content": "#我一直在喊{F#妳}{M#你}的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761480103,
					"content": "為什麼派蒙這個小傢伙沒有被拉入無想之間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480104,
					"content": "可能她除了吃和睡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "…本身就什麼也不想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480107,
					"content": "看來梅蘭塔真的生氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480108,
					"content": "#送{NICKNAME}上去直面梅蘭塔之事已是迫在眉睫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480109,
					"content": "換個地方說話吧。這裡也不是很安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761480110,
					"content": "那個，雖然沒有人在意，但是大家好，我叫阿羅邏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿羅邏"
				}
			]
		},
