				]
			},
			"dialogs": [
				{
					"id": 750680101,
					"content": "這些非人之物還真是難纏，非人的怪物。勇士啊…我是冒險團的誇恩因，我的職責…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680102
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680102,
					"content": "我的職責…就是清理這些怪物，對，我是冒險團裡的戰士，小心，勇士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680103
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680103,
					"content": "這些怪物，非常狡猾，會偽裝成不同的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680104
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680104,
					"content": "每天夜裡入睡之前都會聽見…聽見躲藏在這古老廢墟裡的它們的聲音，所以才…無法在營地入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680105
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680105,
					"content": "#這裡全是這樣的怪物，{F#妳}{M#你}們也…也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
