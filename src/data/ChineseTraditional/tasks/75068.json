							10035.07
						],
						"pointId": 10052
					}
				]
			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "#{F#妳}{M#你}還在這裡啊，勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680402,
					"content": "從前，有學者說這座燼城之中，古老暴虐的城主有…阻止深淵侵蝕的辦法，於是我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680403,
					"content": "可是，這真是邪門的地方啊，勇士，我最近也覺得…覺得有點奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680404,
					"content": "有的時候前一天還完整的路，一覺醒來就變得破破爛爛的…那些石頭屋子原本是那樣嗎？總覺得…應該更完整一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680405,
					"content": "但有的時候，醒來卻能看到本來不應該再出現的朋友…那些是怪物嗎？大概…是變成我朋友模樣的怪物吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680406,
					"content": "我要…我在這裡擔負的職責就是清理掉那些怪物，但是為什麼…為什麼我要那樣做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680407,
					"content": "#總之這是奇怪的地方，{F#妳}{M#你}們還是…快點離開吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
