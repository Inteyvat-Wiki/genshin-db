							10035.07
						],
						"pointId": 10052
					}
				]
			},
			"dialogs": [
				{
					"id": 750680501,
					"content": "#{F#妳}{M#你}們還是快點走吧，再不走就來不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680502
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680502,
					"content": "為什麼來不及…對，因為…因為冒險團已經全軍覆沒了，所有人都被…都被那隻漆黑的巨獸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680503
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680503,
					"content": "他們要我保護那些撤離的人，至少要讓他們離開這座城，「花羽會」的救援就在路上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680504
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680504,
					"content": "我要清除掉這些邪惡的魔物，這樣…那些剩下的人才能回到光明照耀的土地…咦，可是…為什麼我在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680505
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680505,
					"content": "耳邊的聲音，唔…耳邊的聲音變得越來越重，我…必須要回到瀑布那邊，我要…回到瀑布那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680506
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750680506,
					"content": "#勇士，{F#妳}{M#你}們也要…早點離開為妙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		}
	]
