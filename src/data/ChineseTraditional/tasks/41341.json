			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒙蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "編霄燈好難啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}知道怎麼編霄燈嗎？蒙蒙不會編霄燈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410104,
					"content": "穿過去，弄過來，一不小心材料就掉了，要不然就把線弄斷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410105,
					"content": "蒙蒙本來是想編盞霄燈送給小羽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410106,
					"content": "小羽一直在看茶店，沒有時間玩，也沒有時間做霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410107,
					"content": "但是小羽應該有願望想要許吧，所以蒙蒙就想編一盞霄燈送給他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410108,
					"content": "我來幫忙編吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "可是，蒙蒙想自己編好之後送給小羽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410111,
					"content": "而且，蒙蒙想知道做霄燈的訣竅，這樣我還可以講給小羽聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410112,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}能…{F#妳}{M#你}能教蒙蒙編一下霄燈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410113,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410115,
					"content": "霄燈這樣應該就…算是做好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410116,
					"content": "#謝謝{F#妳}{M#你}，{F#大姐姐}{M#大哥哥}！我們趕快把霄燈送給小羽吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410109,
					"content": "我編一個給妳好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
