			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "#客、客官，{F#妳}{M#你}好，那個…想要歇腳的話請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410203,
					"content": "我們是來送霄燈的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "送霄燈…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410205,
					"content": "小羽，這盞霄燈送給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410206,
					"content": "蒙蒙？咦，這盞霄燈是妳做的嗎？謝、謝謝妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410207,
					"content": "#是這個{F#大姐姐}{M#大哥哥}教我編的，其實做得不太好，你…你喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410208,
					"content": "這盞霄燈做得很好啊，我很喜歡！我還正在煩惱，怎麼抽出時間來編霄燈呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410209,
					"content": "謝謝妳，蒙蒙，我等會就去請人幫我把這盞霄燈掛到門上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410210,
					"content": "為什麼要請人幫忙掛霄燈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "這個啊，嗯…我爸爸身體一直不好，不能過來掛霄燈。我個子又太矮，肯定也掛不上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410213,
					"content": "想把霄燈掛到門上去，只能去周圍請人幫忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410214,
					"content": "我來幫忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "#{F#妳}{M#你}願意幫忙嗎？那太好了，謝謝你。我還擔心我要是去找人幫忙，誰來收拾店裡呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410215,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "家裡沒有人來掛霄燈嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#這霄燈掛起來真好看，謝謝{F#妳}{M#你}，{F#大姐姐}{M#大哥哥}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410402,
					"content": "那小羽…我們出去玩吧，我知道一個地方，那裡的花可漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410403,
					"content": "#剛才{F#大姐姐}{M#大哥哥}教我編霄燈了，去那邊之後，我也教你編好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410404,
					"content": "這個…還不行，我還得收拾店裡，雖然沒多少客人，但店裡必須保持乾淨才好，這是爸爸叮囑我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410405,
					"content": "那…那我們不編霄燈，去那邊說一會話好不好？一下就回來了，不耽誤時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410406,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410407,
					"content": "我來幫忙打掃店裡吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "#欸？可以嗎？這也、這也太麻煩{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410410,
					"content": "我們就去一下子，一下子就回來了，不會耽誤很多時間的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410411,
					"content": "#那就拜託{F#妳}{M#你}啦，{F#大姐姐}{M#大哥哥}，謝謝{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410408,
					"content": "打掃的事就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "好像是他們兩個，還在玩的樣子，看來不用太擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413410702,
					"content": "不過現在這個氣氛，好像不應該靠過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413410703,
					"content": "想聽聽他們在說什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "給小羽的爸爸編花環，他會好得快一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410706,
					"content": "我不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410707,
					"content": "書上說，只要過得開心，就算生病也會好得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410708,
					"content": "蒙蒙覺得，小羽已經這麼懂事了，天天都在幫忙看店，小羽的爸爸，一定很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410709,
					"content": "但，爸爸有時候還說我來著…「別老是窩在店裡，多出去玩」什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410710,
					"content": "「你不陪蒙蒙玩，她能把周圍的花都採禿囉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410711,
					"content": "這裡有很多花，才不會採完呢…等一下，我編一個花環給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410712,
					"content": "謝謝妳蒙蒙，我們也該回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410713,
					"content": "好吧…那等你爸爸身體好了之後，你是不是就有時間了？到時候我再來找你玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410714,
					"content": "嗯，爸爸的身體一定會好得很快的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410715,
					"content": "#欸？！{F#大姐姐}{M#大哥哥}…{F#妳}{M#你}，{F#妳}{M#你}什麼時候來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410716,
					"content": "剛來不久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "唔唔唔…我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410719,
					"content": "海燈節快樂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "#{F#大姐姐}{M#大哥哥}也是，海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410721
					],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410721,
					"content": "海…海燈節快樂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410722
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410722,
					"content": "#那個，謝謝{F#妳}{M#你}幫忙，這些東西請收下吧。爸爸說，拜託人做事要準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410723
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410723,
					"content": "我們…我們就先回店裡了，走吧蒙蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410724
					],
					"speakerTitle": "小羽"
				},
				{
					"id": 413410724,
					"content": "#嗯，我們回去吧，謝謝{F#妳}{M#你}，{F#大姐姐}{M#大哥哥}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙蒙"
				},
				{
					"id": 413410717,
					"content": "什麼都沒聽到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410704,
					"content": "聽聽他們在說什麼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				}
			]
		},
