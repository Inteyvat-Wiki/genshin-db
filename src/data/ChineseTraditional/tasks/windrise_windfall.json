			"dialogs": [
				{
					"id": 207431001,
					"content": "這酒莊的生意再這麼停擺下去，我該怎麼和迪盧克老爺交代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 207431002,
					"content": "#旅行者，如果{F#妳}{M#你}看見迪盧克老爺了，能幫我跟他說說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "埃澤"
				},
				{
					"id": 207431003,
					"content": "他老是這樣不管酒莊的生意，也不是辦法啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃澤"
				}
			]
		},
		{
