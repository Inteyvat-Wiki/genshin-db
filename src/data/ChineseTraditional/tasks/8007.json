			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "剛才那是…哈夫丹的靈魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071002,
					"content": "這裡匯聚著不止一種詭異力量。就算見到魂魄也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071003,
					"content": "#不過，如果{F#妳}{M#你}們想繼續前往深處探索，就要小心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071004,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071005,
					"content": "嗯，我們會小心的。欸對了，戴因難道不跟我們一起走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071006,
					"content": "剛才那台裝置同樣對我造成了不小的創傷，我需要一點時間來恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071007,
					"content": "原來如此…不對，我其實早就看出來了，你一直是在硬撐而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071008,
					"content": "也該休息了，戴因…比如說，給自己放個假什麼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071009,
					"content": "放假？這不是該出現在我身上的詞語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071010,
					"content": "我還有重要的事。「命運的織機」計畫還在進行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071011,
					"content": "我甚至懷疑，這裡的增幅裝置也跟那個計畫有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071012,
					"content": "我也會留意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "#感謝{F#妳}{M#你}的體諒，「雇主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071015,
					"content": "#只希望下次見面時，{F#妳}{M#你}不會站在「那邊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80071016,
					"content": "喂，戴因他是不是有點記仇呀，最後才那麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071017,
					"content": "#雖然還是沒能再一次見到{F#妳}{M#你}的{F#哥哥}{M#妹妹}，但也算是瞭解了很多有用的資訊吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071018,
					"content": "只要繼續旅行，你們總會相遇，然後和好如初的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071019,
					"content": "喔對了，還記得我們一開始是為了調查丘丘人們的詭異行蹤才過來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071020,
					"content": "這下應該可以找那位礦工大哥報告了吧，只是…好像有點不知道怎麼說，這裡發生的事對普通人來說有些太過複雜了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071021,
					"content": "總之，別把那份委託給忘了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80071013,
					"content": "等你恢復了，我會再和你好好聊聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
