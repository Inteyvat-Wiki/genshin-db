					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "怎麼辦，把那個深淵司鐸解決了，裝置卻還是沒有停下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070302,
					"content": "哈夫丹他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070303,
					"content": "讓我來代替他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "#不行！只要裝置還保持啟動狀態，我們這些受過詛咒的人就無法發揮出原本實力，只有{F#妳}{M#你}才是深淵的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070306,
					"content": "#如果{F#妳}{M#你}珍惜他的獻身，就別在這裡浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070307,
					"content": "看到周圍那些光線和傳送門了嗎？他們一定把能源裝置分散安置在別處了，過去確認情況，要快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070308,
					"content": "是要穿過那些深淵的傳送門嗎…喂等等我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80070304,
					"content": "我不會受到詛咒淨化效果的影響。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
