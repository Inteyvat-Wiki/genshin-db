			"dialogs": [
				{
					"id": 80070101,
					"content": "本以為會在一瞬間灰飛煙滅…哈夫丹的靈魂竟然如此強韌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070102,
					"content": "礙事的東西！給我閃開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "深淵司鐸"
				},
				{
					"id": 80070103,
					"content": "你在看哪裡？機會難得，你總算能除掉我了，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80070104,
					"content": "…戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "深淵司鐸"
				},
				{
					"id": 80070105,
					"content": "幹掉他，關閉那個裝置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				}
			]
		},
		{
