				"points": []
			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "您好，冒險家！關於委託的完成情況我都已經瞭解了，感謝您為冒險家協會的付出！這裡是您應得的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700250102,
					"content": "雖然沒能捕獲那個奇怪的丘丘人，也沒能找到這次騷亂的原因…但野外的安全至少得到了保障，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700250103,
					"content": "順便一提，艾拉·馬斯克小姐在圖書館等您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
