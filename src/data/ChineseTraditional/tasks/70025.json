			"trigger": {
				"objectNames": [
					"艾拉·馬斯克",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu…mimi tomo…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250202,
					"content": "妳好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "#Ya ika！！啊…是{F#妳}{M#你}們啊…嚇我一跳…請不要打擾我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250204,
					"content": "欸，不是妳叫我們來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700250212,
					"content": "#嗯？哦哦…是{F#妳}{M#你}們啊！多謝{F#妳}{M#你}們的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250205,
					"content": "不過手冊中的內容準確嗎？能夠用來與丘丘人和平交流嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250206,
					"content": "舉手之勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "哼哼，我的詞典工作又前進了一大步！人類能與丘丘人和平共存的論據又增加了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250209,
					"content": "只可惜沒能和那個奇怪的丘丘人搭上話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250210,
					"content": "從我收集的語料來看，或許它也只是很想在這片陌生的大地上結交新朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250213,
					"content": "沒能好好交流，真是遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250214,
					"content": "#啊，順便，這是給{F#妳}{M#你}的謝禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250215,
					"content": "#先前麻煩了{F#妳}{M#你}們那麼多，實在不好意思。有機會還希望能夠一起合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700250211,
					"content": "什麼嘛，原來這傢伙還是會好好說話的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700250207,
					"content": "我還是更喜歡自己的方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
