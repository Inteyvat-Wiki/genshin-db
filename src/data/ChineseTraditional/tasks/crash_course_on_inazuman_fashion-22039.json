					"小倉澪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "這樣做生意長久不了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "#抱歉抱歉，想事情一時分心了。{F#妳}{M#你}是來買成衣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390104,
					"content": "雖然璃月的高檔綢緞仍然斷貨…但新款的著物還是應有盡有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390105,
					"content": "之前妳會從璃月進貨？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "是的，之前我們店總能進到璃月的高檔綢緞，比如「飛雲商會」那些用霓裳花製成的絲綢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390107,
					"content": "可是，現在稻妻這個情況…店裡已經有一段時間沒有進過那種綢緞了。現在也只能靠之前的存貨維持經營。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390108,
					"content": "店裡的這些絲綢，可以說是用一段少一段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390109,
					"content": "我本來是想自己設計些新紋樣，或者是用新染料做一些新樣式的布料和成衣來吸引客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390110,
					"content": "但是，我卻始終沒找到什麼能稱得上是有「新意」的染料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390111,
					"content": "#旅行者，{F#妳}{M#你}四處旅行，一定見多識廣…{F#妳}{M#你}見過什麼能稱得上是有「新意」的染料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390112,
					"content": "我見得多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "真、真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390114,
					"content": "#如果可以的話，能請{F#妳}{M#你}幫我長長見識，拿一些能製成新穎染料的原料給我看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390115,
					"content": "#我會準備好報酬的，拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390116,
					"content": "只要染料嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "現在這個情況，我也暫時只能在染料這方面想想辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390118,
					"content": "#如果{F#妳}{M#你}知道有什麼原料能製成富有「新意」的染料，就請拿來給我吧，我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小倉澪"
				}
			]
		},
