			"trigger": {
				"objectNames": [
					"吉麗安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "唉，不知道那些七天神像怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380102,
					"content": "七天神像怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "是這樣的…我以往每週都會去七天神像前祈禱，順便為神像掃除塵埃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380104,
					"content": "多虧了神明，我才有了現在的幸福生活，這麼做，也是我報答神明的一種方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380105,
					"content": "可是自從我有了莉莉以後，出門的機會越來越少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380106,
					"content": "那些七天神像，肯定因為沒人清洗而蒙塵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380107,
					"content": "雖然這麼說，有點像是推卸責任。但能不能請您替我去清除一下七天神像上的灰塵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380109,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "太感謝您了，願風神保佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380115,
					"content": "對了，七天神像有著神明的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380116,
					"content": "上面的「塵埃」並不能用普通的方法清理掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380117,
					"content": "不過您有著「元素」的力量，應該能輕鬆解決吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380118,
					"content": "不像我，一尊神像就要清理整整一天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380110,
					"content": "就讓風把灰塵給吹乾淨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "巴巴托斯大人和他的風，肯定每天都很繁忙，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380113,
					"content": "而且，也不能事事指望神明，自己卻偷著懶呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200380114,
					"content": "就請您和我一起，為巴巴托斯大人分憂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "吉麗安娜"
				}
			]
		},
