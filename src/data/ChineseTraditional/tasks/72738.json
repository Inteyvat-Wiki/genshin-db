				]
			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "嗯，差不多就這樣吧。簡單清掃一下就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380102,
					"content": "#哎呀？小傢伙，{F#妳}{M#你}來得可真巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380103,
					"content": "來得巧？哪裡巧了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "#看看{F#妳}{M#你}，腦子裡絕對在想：「唉，這女人一定又要把什麼麻煩事推給我了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380106,
					"content": "放心吧，只是本社剛剛做好整修，正準備推出全新的業務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380107,
					"content": "#還沒來得及對外公布呢，{F#妳}{M#你}就過來了。這不是巧了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380108,
					"content": "喏，看到我旁邊的賽錢箱了沒？以後啊，這裡就要多一個許願的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380109,
					"content": "不是已經有御神籤了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "那可不一樣。御神籤那邊是看運勢，而這邊嘛…則是用來「許願」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380111,
					"content": "只需要閉上眼想著自己的願望，再把願望寫上繪馬，再掛在旁邊的架子上，說不定願望就會實現喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380112,
					"content": "什麼願望都可以？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "當然了。不過，究竟能實現哪些，就只能看護佑著我們的神明啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380114,
					"content": "#我這個沒用的宮司，最多也只能幫{F#妳}{M#你}在人緣上想想辦法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380115,
					"content": "能遇見新朋友的話很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "#如果這就是{F#妳}{M#你}的心願，那就去試試看吧。來，拿著這些「籤文簿紙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380118,
					"content": "#這是我在寫「御神籤」的時候剩下的，送給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380119,
					"content": "把願望寫在上面再許願，也許會更靈驗喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380120,
					"content": "真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "#哎呀，我什麼時候騙過{F#妳}{M#你}？快去許願吧，小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380122,
					"content": "記住，先把願望寫在「籤文簿紙」上，再把簿紙貼在繪馬上，最後把繪馬掛在架子上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380123,
					"content": "這樣，許願就完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380124,
					"content": "嗯，很有誠意嘛，不錯不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380125,
					"content": "這真的有用嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "好啦，繼續忙去吧小傢伙。但記得要豎起耳朵，瞪大眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380127,
					"content": "#說不定，{F#妳}{M#你}想要遇見的那個人，就在某個拉麵攤上吃拉麵呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380116,
					"content": "和老朋友們見面也不錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "等一下，這個開場白…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}