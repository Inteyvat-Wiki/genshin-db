						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#咦？咦咦？是榮譽騎士{M#哥哥}{F#姐姐}？好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500102,
					"content": "好耶！是可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "哈哈，優菈姐姐告訴我，赫塔阿姨找來了厲害的幫手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500105,
					"content": "#看到了榮譽騎士{M#哥哥}{F#姐姐}，我就知道，這裡一定是全提瓦特最厲害的飲料店！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500106,
					"content": "謝謝可莉，以後會做到的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "還…還不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500109,
					"content": "#那就…可莉到過的飲料店裡，榮譽騎士{M#哥哥}{F#姐姐}的最厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500110,
					"content": "#反正，不管榮譽騎士{M#哥哥}{F#姐姐}做出什麼飲料，可莉肯定都會覺得好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500111,
					"content": "這次需要可莉嚴格一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "#喔…喔！是這樣嗎？但可莉對{F#妳}{M#你}根本嚴格不起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500114,
					"content": "我想想…那我就學習阿貝多哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500115,
					"content": "阿貝多哥哥替蒂瑪烏斯叔叔當面批改作業的時候，很認真！可莉都能聽進去每一句話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500116,
					"content": "好好好，可莉來當老師！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "嘿…那可莉要厲害地點餐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500119,
					"content": "再過不久，可莉就要和媽媽一起去炸魚了…不要告訴琴團長哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500120,
					"content": "今天，可莉和媽媽一起炸了好多好多魚…不要告訴琴團長哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500121,
					"content": "這幾天，可莉和媽媽開開心心玩了好久好久，最快樂了！被關禁閉也沒關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500122,
					"content": "所以，可莉想點一杯「好天氣」——大晴天，陽光暖暖，心情一定很棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500123,
					"content": "收到，可莉老師，這就開工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "嘿嘿，會是什麼味道呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500124,
					"content": "明白，可莉大師，這就開工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "好好好，大煉金術士可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "這次可莉隨便挑我毛病！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "謝謝可莉，我會加油變強！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "好耶！可莉來做客！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
