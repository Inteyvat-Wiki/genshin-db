			"dialogs": [
				{
					"id": 705500301,
					"content": "鐺鐺！完成了——這杯新品，可莉絕對喜歡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "哇啊！嘟嘟可的糖果也在飲料上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500303,
					"content": "杯子裡有好多好多橙紅色，嘟嘟可好像趴在白色的雲朵上…這是更厲害的好天氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500304,
					"content": "可莉喝喝看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "嗯嗯…好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500306,
					"content": "可莉要慢慢喝，不能咕嚕咕嚕就錯過了好味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500307,
					"content": "#真神奇…榮譽騎士{M#哥哥}{F#姐姐}，好像把陽光裝進了果汁裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500308,
					"content": "玩累了的感覺都消失了，好溫暖，但是又很平靜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500309,
					"content": "#…呼啊~榮譽騎士{M#哥哥}{F#姐姐}最厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500310,
					"content": "這杯飲料就由可莉來取名吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "真的嗎？那我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500313,
					"content": "天氣好、心情好，嘟嘟可應該會唱歌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500314,
					"content": "嘟嘟可唱歌，可莉也會跟著唱…所以就叫它…嘟嘟可晴天合唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500315,
					"content": "好名字，我支持！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "#嘿嘿，謝謝榮譽騎士{M#哥哥}{F#姐姐}，為可莉做了這麼好喝的飲料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500318,
					"content": "我要回去告訴媽媽，現在蒙德最好喝的飲料，就是嘟嘟可晴天合唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500319,
					"content": "可莉開心，我也開心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#那，可莉就把媽媽唸的咒語寫在紙上，送給榮譽騎士{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500322,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}也要學會魔法，做出自己想要的糖果哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500323,
					"content": "下次再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500320,
					"content": "通過了可莉老師的試煉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "可莉的命名最棒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "可莉給它一個厲害的名字吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
