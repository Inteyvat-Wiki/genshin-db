					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "「好天氣」來啦，可莉喝喝看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "哇啊，原來「好天氣」是這種顏色？紫色的天空…是亮亮的夜晚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500203,
					"content": "可能是指日落後晴朗的傍晚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "可莉先喝一點，再認真想一想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500206,
					"content": "啊，喝完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500207,
					"content": "好喝！酸酸甜甜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500208,
					"content": "如果在吃烤魚的時候喝這杯，可莉肯定能呼呼吃掉好幾條，飯量加倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500209,
					"content": "一小杯不夠喝，可莉還想要再來一杯…蛋糕一樣的飲料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500210,
					"content": "懂了，可莉想加點「液態甜點」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#唔…我也不知道要加什麼配方，我和榮譽騎士{M#哥哥}{F#姐姐}一起想想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500214,
					"content": "可莉帶來的糖果好特別！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "這個嗎？嘿嘿…是媽媽教我用煉金臺做出來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500216,
					"content": "好多好多糖，加上媽媽的楓丹朋友帶來的花、芭比洛斯阿姨的星星蜂蜜、歐歐阿姨送給媽媽的魔力果醬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500217,
					"content": "把材料放在煉金臺上，許願一個形狀，跟著媽媽念咒語，「砰~」的一聲，嘟嘟可樣子的糖果就出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500218,
					"content": "成分和工藝都好厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#嘟嘟可糖果也送榮譽騎士{M#哥哥}{F#姐姐}幾份！{F#妳}{M#你}喜歡這種糖果的話，我也教{F#妳}{M#你}媽媽唸的咒語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500221,
					"content": "#這樣，榮譽騎士{M#哥哥}{F#姐姐}也能做出自己想要的糖果了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500222,
					"content": "謝謝可莉分享厲害的配方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "嘿嘿，如果有不懂的地方，可以來找可莉喔！魔法糖果的問題，可莉是專家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500225,
					"content": "可莉今天還有什麼要做的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "嗯！媽媽最近給了可莉一本厲害的書，每晚都要讀一章，學學問，然後早早按時睡覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500227,
					"content": "那本書教可莉怎麼做「推進劑」，可以讓蹦蹦炸彈「嗚呼~」地蹦更高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500228,
					"content": "學…學這個對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "不高深哦…和炸彈有很多相像的地方，只要削的時候小心一點就好，像削蠟筆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500231,
					"content": "睡前的時間也很重要！媽媽會坐在可莉身邊，跟可莉講各式各樣的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500232,
					"content": "媽媽拿出一個…一臺…一盞寶石做的燈，「叮噹~」發出光來，投在天花板上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500233,
					"content": "天花板變成了故事板？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "是啊是啊，故事講到哪裡，天花板上的光點就變出好看的圖案來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500235,
					"content": "有的時候，媽媽講著講著自己就先睡著了，可莉就幫媽媽蓋上被子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500236,
					"content": "#等可莉學會怎麼用這盞燈，可莉就來跟榮譽騎士{M#哥哥}{F#姐姐}講故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500237,
					"content": "好啊好啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "嘿嘿，可莉現在記住了好多好多故事，也能為大家帶來新鮮的快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500240,
					"content": "可莉晚上還會吃東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "嗯！回去以後，可莉要邊讀書邊吃…裹了一點鹽的小堅果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500242,
					"content": "以前晚飯後可莉都要吃蛋糕的！可是琴團長說，蛋糕裡的白糖太多了，睡前吃了很不好，會發胖，還會牙齒痛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500243,
					"content": "所以媽媽聽了芭比洛斯阿姨的建議，給我小堅果吃，說這個能幫助腦袋記住更多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500244,
					"content": "堅果的味道淡淡的，有點像在嚼草，不過，裹上鹽後也不難吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500245,
					"content": "的確是個解決辦法，營養和健康很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "也許我們可以想想看有沒有既健康，又夠甜的材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "對喔…可莉還是想吃甜甜的東西！蛋糕的鮮奶油薄一點也好…或者，多放水果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500248,
					"content": "對了，媽媽那個戴眼鏡的朋友，還送了她一袋楓丹的水果，圓圓滾滾，叫泡泡桔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500249,
					"content": "可莉連續吃了好幾個，很甜很甜，琴團長也覺得沒問題，因為「水果的甜和白糖的甜不一樣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500250,
					"content": "所以，一定要吃堅果的話，好像可以把它們放在果汁裡泡一泡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500251,
					"content": "對了，可莉的三餐通常怎麼安排？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "三餐？吼吼，可莉有的時候一天吃五頓哦，還有吃七頓的時候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500253,
					"content": "這麼多！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "因為，冒險要花掉很多力氣，一次吃太飽的話，跑起來又很不自在…所以每次吃少一點，多吃幾頓就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500255,
					"content": "之前是阿貝多哥哥在做可莉的飯，飯盒裡的料理，總是被阿貝多哥哥擺得漂漂亮亮，像畫一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500256,
					"content": "的確是阿貝多的風格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "如果阿貝多哥哥在雪山忙，可莉也會跟著騎士團的大家，到營地裡吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500259,
					"content": "凱亞哥哥的營地最整潔、安柏姐姐的營地有時在樹上，好玩！赫塔阿姨最會做大餐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500260,
					"content": "媽媽回來以後，就有更多更有趣的好吃的，譬如把好多種魚肉和魚湯，做成布丁那樣的方塊，叫做五彩魚凍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500261,
					"content": "講到我都有點餓了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "巧克力脆脆片也很好！是媽媽用巧克力和餅乾做出來的新發明！有點苦，但酥酥脆脆香香，苦完以後更甜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500264,
					"content": "#吃了以後力氣滿滿…下次我帶幾份來給榮譽騎士{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500265,
					"content": "好，我知道要怎麼改啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "再幫可莉調一杯好喝的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "這麼快嗎？好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500268,
					"content": "下一杯飲料會有多好喝呢…可莉很好奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500262,
					"content": "不愧是大冒險家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "我也想吃吃看阿貝多的手藝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "我等可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "聽…聽起來很難？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "我會努力學，做出糖果的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "實在是不得了的甜品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "好的，再給可莉來一杯厲害的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "可莉想要什麼風味，都可以調！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "飲料的名字不太適合，我來改！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
