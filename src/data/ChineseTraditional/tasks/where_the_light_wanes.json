			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "怎麼被派到這種工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "#旅行者{F#妳}{M#你}可能不瞭解，每年海燈節的霄燈都是要回收的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210104,
					"content": "但霄燈放飛的時候是好看，飛出去之後，總是問題多多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210105,
					"content": "有的燈罩沒做好，飛到一半燈罩壞了，就只剩一塊浮生石到處亂飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210106,
					"content": "有霄燈被風一吹，卡在角落裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210107,
					"content": "這樣子一是有安全隱憂，二是影響了市容，所以總務司都派了專人負責回收這些霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210108,
					"content": "今年不就輪到我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210109,
					"content": "但海燈節放的霄燈數量太大了…如果全堆到節日結束的那一天，我一定忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210110,
					"content": "所以只能大家一邊放，我一邊回收那些掉到角落，已經壞掉的霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210111,
					"content": "但就算只是這樣，我一個人也已經忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210112,
					"content": "#旅行者，如果{F#妳}{M#你}願意幫忙的話，就幫我去看看這幾處有沒有需要回收的霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210113,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "#我把那幾個地點幫{F#妳}{M#你}標在地圖上，那麼就拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
		{
			"id": 7182102,
			"completionStepIds": [
				7182108
