			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "怎麼樣，那些地方有需要回收的霄燈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210302,
					"content": "回收了三盞霄燈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "多謝了，要回收那些地方的霄燈真是太費事了，我每次過去都累得要命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210304,
					"content": "#有{F#妳}{M#你}幫忙，我總算能輕鬆點了。對了，這是給{F#妳}{M#你}的報酬，辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
