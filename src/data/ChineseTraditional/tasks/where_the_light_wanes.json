			"trigger": {
				"objectNames": [
					"快拳阿凌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "怎麼會這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210202,
					"content": "你怎麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "我…唉，是這樣，師父說，他最近領悟出了一套新的腿法，非常厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210204,
					"content": "他說我的心不夠誠，基本功也不到家，不願意將腿法傳授於我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210205,
					"content": "不過我想正好現在趕上海燈節，我誠心獻一盞霄燈給師父，說不定他心情一好就願意傳授我了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210206,
					"content": "但我實在找不到浮生石了，看見了有一盞霄燈卡在那，就想去把那盞霄燈的浮生石拿過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210207,
					"content": "#結果就是這樣了…唉，霄燈我還是不要了，給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210208,
					"content": "居然被魔物逼成這樣，我的基本功果然還是不到家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "快拳阿凌"
				}
			]
		},
		{
