			"dialogs": [
				{
					"id": 761840301,
					"content": "不錯的茶會。早知道我以前就該多參加幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840302,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "好啊，我們下次再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840303,
					"content": "茶會時間該結束了。",
