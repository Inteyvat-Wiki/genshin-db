					"拉菲克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "#喔！多謝{F#妳}{M#你}了，旅行者。這是{F#妳}{M#你}的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200502,
					"content": "不過，這材料真是出乎意料的重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200503,
					"content": "我會盡快開始建造的，這艘小船花不了多長時間，應該過段時間就能下水試航了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200504,
					"content": "…到時候你可要準備好救生用具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200505,
					"content": "哎呀，沒問題的，絕對沒問題，妳就相信我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
