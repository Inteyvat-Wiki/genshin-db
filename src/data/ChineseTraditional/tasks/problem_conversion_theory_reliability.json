			"dialogs": [
				{
					"id": 230200201,
					"content": "拉菲克所計算的那些船體所需材料強度，單從理論資料上看確實沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200202
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200202,
					"content": "但如果真要下水的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200203
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200203,
					"content": "算了，他肯定也不願意聽我說的吧…",
					"roleType": "TALK_ROLE_NPC",
