				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170201,
					"content": "不行了，我已經手痠到提不起鍋子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170202,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170203
					]
				},
				{
					"id": 718170203,
					"content": "#哎，旅行者，我剛才還在想要是有個人來幫忙就好了…{F#妳}{M#你}願意給我幫幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170204
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170204,
					"content": "幫什麼忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170205
					]
				},
				{
					"id": 718170205,
					"content": "海燈節期間，客棧裡的人差不多都回去過節了，沒多少能幹活的人手，我們都忙得不可開交，多一個人來幫忙都是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170206
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170206,
					"content": "#{F#妳}{M#你}也不用太擔心，不用{F#妳}{M#你}幫什麼重活，只要{F#妳}{M#你}幫忙上上菜、採購點材料就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170207
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170207,
					"content": "#{F#妳}{M#你}等會啊，我瞧瞧，現在有什麼可以叫{F#妳}{M#你}幫忙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7181703,
			"completionStepIds": [
				7181702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
