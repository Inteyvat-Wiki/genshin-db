				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170301,
					"content": "哎唷，都忙到忘了，樓下那桌客人還沒點菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170302,
					"content": "#這樣吧，{F#妳}{M#你}來幫樓下兩個外國客人那桌點餐，就是荷爾德林和卡斯帕那桌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170303,
					"content": "#他們應該已經等了好一會了，可能有點等煩了，{F#妳}{M#你}記得先給他們上<color=#00E1FFFF>兩份</color>小菜，<color=#00E1FFFF>美味的野菇雞肉串</color>就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170304,
					"content": "上完小菜之後再問問他們想吃些什麼主菜，免得再跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170305,
					"content": "快去吧，別讓客人等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
