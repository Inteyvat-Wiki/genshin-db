				"points": []
			},
			"dialogs": [
				{
					"id": 718170101,
					"content": "這下糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170103
					]
				},
				{
					"id": 718170103,
					"content": "海燈節啊，客棧裡一堆人回去過節了，幹活的人少了一堆，忙得要命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170104,
					"content": "#現在我沒閒功夫跟{F#妳}{M#你}說話，得趕緊準備著，等晚上客人都來點菜了，我看連水都趕不上喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170105,
					"content": "#{F#妳}{M#你}既然這麼熱心來關心我，那乾脆晚上來幫忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718170106,
					"content": "唉，能抓一個幫手是一個，毓華跑哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7181702,
			"completionStepIds": [
				7181701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
