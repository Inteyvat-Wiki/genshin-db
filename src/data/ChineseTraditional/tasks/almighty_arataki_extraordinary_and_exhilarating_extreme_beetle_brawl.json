			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿守",
					"阿晃",
					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727300201,
					"content": "老大，不能就這麼算了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300202
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300202,
					"content": "你好不容易打響了「真劍鬥蟲大鬼王」的名號，怎麼能讓那個小鬼得逞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300203
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300203,
					"content": "對，那個小鬼一定使詐了，他暗算了老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300204
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300204,
					"content": "你們兩個，慌什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300205
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300205,
					"content": "之前的那一仗，本大爺也有點輕敵。誰叫那個小鬼看起來太普通了嘛！不算數，不算數！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300206
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300206,
					"content": "別管那小鬼耍了什麼把戲，我們就按計畫，擺開「荒瀧極意堂堂鬥蟲大試合」的陣勢，再拿出本大爺錘煉多年的「赤紅一杵」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300207
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300207,
					"content": "到時候，滿場都是觀眾們為本大爺叫好的呼聲，再加上「赤紅一杵」壓倒性的實力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300208
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300208,
					"content": "那個小鬼絕對會嚇得兩腿發抖吧，什麼伎倆都使不出來！本大爺輕輕鬆鬆就能把他拿下，啊哈哈哈哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300209,
					"content": "老大英明！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300210
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300210,
					"content": "可是，忍姐不知道什麼時候才會回來，要舉辦這場「荒瀧極意堂堂鬥蟲大試合」，從什麼地方下手才好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300211
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300211,
					"content": "根據「荒瀧極上盛世豪鼓大祭典」的經驗，我們需要提前向天領奉行報備，拿到活動舉辦許可…好像還有個場地租用憑證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300212
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300212,
					"content": "這些好像都需要經費。考慮到要把「極意大試合」舉辦得比「豪鼓大祭典」更熱鬧，至少得花三倍的摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300213
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300213,
					"content": "停停停停停！一聽到天領奉行這四個字，我就頭痛得厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300214
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300214,
					"content": "至於經費…大不了我們就別做一休三了！努力點，做二休四！這樣我們加起來多做了四天工，整整多賺四倍摩拉，肯定夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300215
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300215,
					"content": "不愧是老大！這樣一來，我們只需要考慮參戰的將士了！參戰的將士也不用太強，能幫老大應付對方的雜兵就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300216
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300216,
					"content": "對喔！那小鬼說過，他還會帶五個鬥蟲好手過來，和我們公正對決。問題是荒瀧派裡精通鬥蟲的，就只有老大你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300217
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300217,
					"content": "要是他們對老大發動車輪戰，就算老大的實力再強，也會吃不消的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300218,
					"content": "你們兩個！明明還沒開始準備，怎麼就畏手畏腳了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300219,
					"content": "拿出荒瀧派的志氣來！這點小問題，本大爺會想辦法解決的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300220
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300220,
					"content": "要不然，先去把以前鬥蟲的小友們找過來，商量一下？或者去長野原煙花店看看，問問她能不能參戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300221
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300221,
					"content": "不成！那樣的話，本大爺敗給一個小鬼的事，很快就會傳遍整個花見坂，誰丟得起那個臉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300222,
					"content": "嗯哼！放牛的，你又在搞什麼事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300223,
					"content": "#喂！嚇死本大爺了，{F#妳}{M#你}們什麼時候來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300224
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300224,
					"content": "居然還好意思問我們，我們站在這裡很久了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300225,
					"content": "#我和{NICKNAME}本來想去冒險家協會，結果遠遠就看見你們在這裡吵吵鬧鬧，說著一大堆不明所以的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300226,
						727300227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300226,
					"content": "「真劍鬥蟲大鬼王」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				},
				{
					"id": 727300228,
					"content": "是「大」試合！少了一個大字，那就完全不夠熱血了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300229
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300229,
					"content": "#我的摯友啊，如果{F#妳}{M#你}也多多鬥蟲，一定能明白鬥蟲激動人心的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300230,
					"content": "所以說，你是不是被什麼人打敗了，正在想著怎麼挽回面子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300231,
					"content": "話可不能這麼說，那都是暗算，暗算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300232
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300232,
					"content": "沒錯，有個叫「花角玉將」的小鬼，看準老大和其他小友切磋後的疲勞時期，突然加入對局，向老大提出挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300233
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300233,
					"content": "用一隻大得誇張的鬼兜蟲，哐哐兩下就把老大的蟲子挑翻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300234
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300234,
					"content": "還說什麼，要讓老大瞭解「鬥蟲強者的真實世界」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300235
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300235,
					"content": "喂，阿守！不用把我戰敗的過程說得這麼清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300236,
					"content": "好像明白了原委…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300237
					]
				},
				{
					"id": 727300237,
					"content": "言歸正傳，我好像聽說過，我的摯友無論做什麼都很有天賦，兩三下就能學會一門新技藝，而且比大部分人還厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300238
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300238,
					"content": "我已經猜到你要說什麼了，放牛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300239,
					"content": "你是不是想拜託我們幫你報仇，打敗那個什麼「花角玉將」，讓我們做免錢的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300240,
					"content": "做免錢的？飛行矮堇瓜，我荒瀧一斗是那麼不講義氣的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300241
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300241,
					"content": "#要是我的摯友答應幫我，我就包下{F#妳}{M#你}們兩個月的午餐，每天都請{F#妳}{M#你}們吃一碗招牌拉麵，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300242
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300242,
					"content": "每、每天一碗？那我們確實可以考慮考慮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300243,
						727300244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300243,
					"content": "一斗居然這麼闊綽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300245,
					"content": "哈哈哈，這可是老大用寶貴的勝利換來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300246
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300246,
					"content": "之前有一位小友自稱「真劍鬥蟲大鬼王」，老大聽說後很不服氣，就向他挑戰。如果那位小友輸了，就要讓出這個稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300247
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300247,
					"content": "經過長達一天一夜的九十二次苦戰，老大終於險勝一場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300248,
						727300249
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300248,
					"content": "怎麼聽起來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300250,
					"content": "不過，那位小友想用他家拉麵攤「每天免費吃一碗招牌拉麵」的優惠券，讓老大網開一面，兩個月後就把這個稱號還給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300251
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300251,
					"content": "雖然不知道他家的拉麵到底多好吃，但光為了這個分量，就是很誘人的提議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300252
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300252,
					"content": "而且，憑老大鬥蟲技藝的進步速度，兩個月後一定會有更威風的綽號，這筆生意確實很划算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300253
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300253,
					"content": "只不過，我們都忘了問那位小友，他家的拉麵攤在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300254
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300254,
					"content": "咳咳咳！都打住，都打住！過程不重要！總之，這些拉麵都送給我的摯友和飛行矮堇瓜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300255
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300255,
					"content": "等等，我們還沒想好呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300256,
					"content": "我已經向「玉將」發出戰書，他也答應了，會帶著幾個援手，迎接我們荒瀧派的攻勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300257
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300257,
					"content": "至於場地，我好像知道要去哪了。首先要拜託我的摯友，把天領奉行那邊的複雜手續通通搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300258
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300258,
					"content": "事不宜遲，我的摯友，還有飛行矮堇瓜，現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300259
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300259,
					"content": "話都說到這份上了，好像也推託不了了…看一斗這麼激動，我們就跟過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300260,
					"content": "反正學學鬥蟲，幫他打敗對手就行了吧？聽起來也不複雜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300261,
						727300262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300261,
					"content": "我也想吃招牌拉麵吃到撐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300263,
					"content": "#唔…難道放牛的有什麼「孩子氣光環」嗎？{F#妳}{M#你}也被影響了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300264,
					"content": "前往天領奉行，幫助荒瀧派辦理了舉辦「荒瀧極意堂堂鬥蟲大試合」的手續，隨後來到了一斗所說的場地…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727300262,
					"content": "我也想試試鬥蟲的樂趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300249,
					"content": "像是對方受不了了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300244,
					"content": "難道打工賺了大錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300227,
					"content": "「極意堂堂鬥蟲試合」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				}
			]
		},
		{
			"id": 7273004,
			"completionStepIds": [
				7273004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273004",
							"2"
						],
						"stepId": 7273004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"荒瀧一斗",
					"阿晃",
					"阿守",
					"「花角玉將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727300401,
					"content": "不錯，阿守和阿晃準備的原材料都就位了，我們開始佈置場地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300402
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300402,
					"content": "根據以前的經驗，試著搭建了「荒瀧極意堂堂鬥蟲大試合」的擂臺…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						727300403
					]
				},
				{
					"id": 727300403,
					"content": "哈哈哈哈哈哈哈！這擂臺很有氣勢嘛，不錯不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300404
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300404,
					"content": "#我的摯友，沒想到{F#妳}{M#你}在這方面也有才能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300405
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300405,
					"content": "配合本大爺這精妙的宣傳畫，氣氛不能再更到位了，啊哈哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300406
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300406,
					"content": "#{NICKNAME}好木工！老大好畫功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300407
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300407,
					"content": "可是，這裡好像離稻妻城太遠了，真的會有人過來看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300408,
					"content": "沒問題沒問題！以本大爺的名氣，還怕沒人來看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300409
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300409,
					"content": "聽說容彩祭的時候，這裡就舉辦了一場劍術比試，當然也是鬼兜蟲對決的不二之選！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300410
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300410,
					"content": "#接下來，是時候讓{F#妳}{M#你}們看看我天下無敵的鬼兜蟲「赤紅一杵」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300411
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300411,
					"content": "居然還真是紅色的鬼兜蟲，好威風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300412,
						727300413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300412,
					"content": "就像被火元素影響了一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300414
					]
				},
				{
					"id": 727300414,
					"content": "放牛的，沒想到你還滿用功的，從哪邊找來了這麼一隻鬼兜蟲啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300415,
					"content": "能讓我靠近看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300416,
					"content": "#哈！隨便看隨便看，仔細觀瞻一番吧！不過，我可不會隨隨便便就把培養「赤紅一杵」的秘密告訴{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300417
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300417,
					"content": "嗯？怎麼有股熟悉的香味，好像是落落莓的果醬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300418,
					"content": "這！一定是妳的錯覺，妳太餓了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300419
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300419,
					"content": "說起來，老大，你還沒把「震懾塗裝」加上保護塗層吧？要是下雨的話，我們花了九千摩拉才買到的那瓶舶來果醬，就都白費了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300420
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300420,
					"content": "沒問題！反正「荒瀧極意堂堂鬥蟲大試合」還沒開始，還有時間把「赤紅一杵」塗上最後的保護層。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300421
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300421,
					"content": "#你們先去準備傳單，拉攏足夠的觀眾。本大爺就在這裡稍微指點一下摯友和飛行矮堇瓜，帶{F#她}{M#他}們上手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300422
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300422,
					"content": "然後，我們就先一起吃個飯，慶祝一下吧。哎呀，做了這麼多事，真是辛苦本大爺了，哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300423
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300423,
					"content": "喔？沒想到你們的陣仗還滿大的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300424
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727300424,
					"content": "出現了！「花角玉將」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300425
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300425,
					"content": "不應該啊！你是怎麼知道這個地方的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300426
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300426,
					"content": "「真劍鬥蟲大鬼王」，你該不會忘了吧？鬥蟲的強者能夠互相感應，上次不也是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300427
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727300427,
					"content": "難道說，你還不知道該怎麼面對我們，正在慌張地做準備？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300428
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727300428,
					"content": "什、什麼話！要知道…沒有和鬼兜蟲心意合一時，本大爺會隱藏強者的氣息，盡量保持低調！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300429
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300429,
					"content": "我只是小看了你的洞察力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300430
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300430,
					"content": "喔？他就是打敗過一斗的人嗎？看起來的確只是個普通的小孩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300431,
					"content": "但他說話的風格很特別，感覺…和放牛的天生就彼此作對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300432,
						727300433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300432,
					"content": "其實他們很合得來吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300434
					]
				},
				{
					"id": 727300434,
					"content": "「花角玉將」！能找到這裡來，算你有點本事，值得我「真劍鬥蟲大鬼王」再認真一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300435
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300435,
					"content": "你們很快就會後悔了，因為你們這一次的行動太莽撞，就像是提前把腦袋伸過來挨揍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300436
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300436,
					"content": "嗯，這次的態度更有自信了，看來你也拿出了最強的底牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300437
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727300437,
					"content": "最開始就讓你一敗塗地的話，一定會錯過很多樂趣。就由我的部下先陪你們玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300438
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727300438,
					"content": "哼！想用小弟來試探我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300439
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300439,
					"content": "那我們這邊就派出飛行矮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300440
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300440,
					"content": "咳咳，不行，飛行矮堇瓜代表我荒瀧派出戰，氣勢絕不能輸給那小鬼，那稱號也得威風一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300441
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300441,
					"content": "我明白了，就讓「破空白鐵小堇瓜」給你們一點教訓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300442
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300442,
					"content": "噫！為什麼是我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300443,
						727300444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300443,
					"content": "速度提升型的派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300445
					]
				},
				{
					"id": 727300445,
					"content": "老大！現在就要和他們對決嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300446
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300446,
					"content": "我們還沒來得及宣傳這場比試呢，你的摯友和摯友的瓜也還沒經歷過鬥蟲的實戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300447
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300447,
					"content": "對喔！但那小鬼都打上門來了，本大爺不可能當縮頭烏龜！宣傳的事之後再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300448,
					"content": "至於鬥蟲的技巧，我會在旁邊指導飛行矮堇瓜的…不對，是「破空白鐵小堇瓜」！實戰也是一種學習，輸掉也沒關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300449
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300449,
					"content": "好過分…還沒開打就假設我會輸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300450,
					"content": "白鐵小堇瓜！妳要拿出荒瀧派的氣勢來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300451
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300451,
					"content": "讓妳第一個出戰，可是我深思熟慮的策略！這個策略的靈感，可是我從阿忍那裡聽說過的璃月故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300452
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300452,
					"content": "「用我方最弱去迎戰對方的最強，我方中等迎戰對方最弱，我方最強迎戰敵方中等，這樣一來，就能保證三戰兩勝！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300453
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300453,
					"content": "雖然妳的確很有天分，但沒多少實戰的經驗，在我們這一群鬥蟲強者之間，只能算是呆瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300454
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300454,
					"content": "派一個鬥蟲呆瓜上陣，就能讓對方的一位好手失去用武之地，我們這邊真是賺大了！哈哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300455
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300455,
					"content": "可是，按這個說法，你要親自去和他們的頭頭「花角玉將」一較高下…你不是才應該是我們這邊最弱的那個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300456,
					"content": "等等，是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300457
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300457,
					"content": "妳…妳好煩啊！我沒說過我的策略和故事裡完全一樣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300458
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300458,
					"content": "好啦好啦，我上就我上，我可不想被小看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300459
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300459,
					"content": "看好了喔，我派蒙可絕不是鬥蟲呆瓜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300444,
					"content": "防禦強化型的派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300445
					]
				},
				{
					"id": 727300433,
					"content": "先讓他們寒暄一番…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300434
					]
				},
				{
					"id": 727300413,
					"content": "確實有一股獨特的威懾力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300414
					]
				}
			]
