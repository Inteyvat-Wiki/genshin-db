	"talks": [
		{
			"id": 7273002,
			"completionStepIds": [
				7273002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
