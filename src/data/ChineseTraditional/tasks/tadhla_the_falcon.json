				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790602,
					"content": "那個…妳就是塔德菈嗎？我們是來救妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790603,
					"content": "嗯…？嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790604,
					"content": "#{F#妳}{M#你}把他們放走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790605,
					"content": "那些人構不成威脅了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "…他們會回去，告訴其他人。這樣他們都會知道我們在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790608,
					"content": "#{F#妳}{M#你}看，智者所見略同。我喜歡這女孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790609,
					"content": "那些不要緊啦！他們再來，我們就再把他們打跑！不過妳受傷了…需要我們幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790610,
					"content": "我還好，還能走，還能找個地方自己死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790611,
					"content": "哦…那還好啦，她還能找個地方——喂，一點也不好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790612,
					"content": "我開玩笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790613,
					"content": "哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790614,
					"content": "我喜歡這女孩的幽默感…若有似無的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790615,
					"content": "#謝謝{F#妳}{M#你}們，我們回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790616,
					"content": "妳的腿走路還方便嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "不方便，但也不需要攙扶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790618,
					"content": "不休息一下嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "休息…？不，我們還沒那麼熟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790620,
					"content": "但我覺得我們可以認識一下，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790621,
					"content": "謝謝，以後吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790606,
					"content": "沒必要趕盡殺絕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
