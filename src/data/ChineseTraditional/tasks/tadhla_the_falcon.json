			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"馬塞拉",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#啊，{NICKNAME}，尊貴的「鎮靈主人」，大駕光臨，令我受寵若驚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790102,
					"content": "好呀，又是一個沙漠奴才。我的大人…唉，算了，您有您自己的判斷，我相信您就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790103,
					"content": "不知您是否有閒暇賞光…我如同期盼明月和雨露一般，期望您的到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790104,
					"content": "無事獻殷勤，必不懷好意，你不如說清楚一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790105,
					"content": "很好，鎮靈大人…我的確有事相求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790106,
					"content": "哈哈，沒什麼大事…是我的獵鷹，塔德菈…她應該是遇險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790107,
					"content": "唉…如果不是因為我的腿不行了，也就不用麻煩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790108,
					"content": "我明白了，所以我們要去救她，然後你會謝謝我們，給我們好多摩拉，我們再去大吃一頓慶祝勝利！對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790109,
					"content": "呃…是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790110,
					"content": "如果是這樣的話，就交給我們好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790111,
					"content": "每到這種時候，邏輯就特別清晰呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "唉…那就這樣吧，為了這貪婪的小傢伙能大吃一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790113,
					"content": "萬分感謝…那麼這件事就拜託給您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790114,
					"content": "啊…她最後出現的地點，在這裡，請讓我為您標出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790115,
					"content": "#{F#妳}{M#你}們要找的人，塔德菈…她的個子很高，膚色黝黑，留著淺色的長髮，手持長弓…嗯，這些資訊應該夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790116,
					"content": "#怎麼樣，{F#妳}{M#你}們記住了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790117,
					"content": "嗯…高個子，深色皮膚的女孩子，淺色長髮，還拿著長弓！嘿嘿，我記性很好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790118,
					"content": "嗯…願流風引導您穿越黃沙，避開重重險阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790119,
					"content": "好，我們走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
