			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕爾",
					"愚人眾先遣隊員甲",
					"愚人眾先遣隊員乙",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "#噓…！{F#妳}{M#你}看…有人在那邊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790402,
					"content": "#哦…我的大人，這些人…就是此前{F#妳}{M#你}們曾反覆提及的「蠢人眾」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790403,
					"content": "是「愚人眾」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "有區別嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790405,
					"content": "妳小聲一點啦！萬一被發現了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790406,
					"content": "#沒關係的，他們聽不到我說話。不信{F#妳}{M#你}們看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790407,
					"content": "喂！大胖子！我在這邊！開飯了，開飯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790408,
					"content": "嗯…？你聽到什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "愚人眾先遣隊員甲"
				},
				{
					"id": 732790409,
					"content": "沒有，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "愚人眾先遣隊員乙"
				},
				{
					"id": 732790410,
					"content": "唔…我還以為開飯了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "愚人眾先遣隊員甲"
				},
				{
					"id": 732790411,
					"content": "哼哼，看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790412,
					"content": "利露帕爾也會玩這種小孩子的惡作劇呀…嘿嘿，總覺得有點可愛呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790413,
					"content": "#{F#妳}{M#你}看…那邊！他們關押的那個是不是塔德菈呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790414,
					"content": "唔我記得她…個子很高，膚色黝黑，留著淺色的長髮…應該就是她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790415,
					"content": "記性不錯嘛，小傢伙。我們動手吧，我的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790416,
					"content": "#好，{NICKNAME}，我們動手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7327906,
			"completionStepIds": [
				7327906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
