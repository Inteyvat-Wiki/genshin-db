			},
			"dialogs": [
				{
					"id": 732790201,
					"content": "#怎麼，{F#妳}{M#你}們找到她了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790202,
					"content": "啊，還需要時間，是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790203,
					"content": "#那麼還要勞煩{F#妳}{M#你}們盡快救出塔德菈…時間不等人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塞拉"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327904",
							"2"
						],
