					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬塞拉",
					"塔德菈",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "#啊，我的小獵鷹回來了！謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790702,
					"content": "#抱歉…我遭到了伏擊，多虧{F#她}{M#他}們相救，我才能回來見您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790703,
					"content": "#「{F#她}{M#他}們」…？是我們尊貴的「鎮靈主人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790704,
					"content": "對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790705,
					"content": "沒關係、沒關係啦！塔德菈受傷了，你也對她好一點嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790706,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790707,
					"content": "…妳受傷了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790708,
					"content": "…對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790709,
					"content": "是什麼動物把妳傷成這樣的？是人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790710,
					"content": "是北方人，我遭到了北方人的伏擊…他們發現自己被跟蹤了，就設下埋伏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790711,
					"content": "設下埋伏的應該是妳才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790712,
					"content": "被獵物反咬成這個樣子，對獵鷹來說，像什麼樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790713,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790714,
					"content": "…去休息吧，妳需要休息。稍後我會為妳療傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790715,
					"content": "塔德菈只是默默點點頭，忍著疼痛緩步離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "馬塞拉對塔德菈有點苛刻呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790717,
					"content": "你們之間關係…不好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "#嗯？不，怎麼會呢！她是我最愛的「獵鷹」…我愛她，但不溺愛她。獵鷹沒有為{F#妳}{M#你}帶回獵物的話，怎麼能餵飽牠呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790719,
					"content": "原來是這樣…哼，那女孩不會有好結果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790723,
					"content": "這些報酬請您一定收下，感謝您，尊貴的「鎮靈主人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790724,
					"content": "咳咳，你是不是忘了什麼？這裡還有兩個人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790725,
					"content": "嘿嘿，其中一個也不算「人」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790726,
					"content": "哦…我忘了，這個小精靈不是人。不過我們也應該得到感謝吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790727,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790728,
					"content": "哈哈，抱歉、抱歉，請您收下額外的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790729,
					"content": "還有額外的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790730,
					"content": "…仍是不多，不過既然我的大人沒什麼意見，那就這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732790731,
					"content": "很好，啊…希望有時間的話，您能再來一趟…我想，我的「獵鷹」仍然需要您的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790720,
					"content": "請不要太苛待塔德菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "苛待？不，我太縱容她了，她的本領退步了…我只是在教育她而已，她是個優秀的「獵鷹」，我怎會忍心傷害她呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "馬塞拉"
				},
				{
					"id": 732790722,
					"content": "那麼獵鷹的結局，往往是什麼樣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "利露帕爾"
				}
			]
		}
	]
}