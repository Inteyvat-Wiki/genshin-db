			"dialogs": [
				{
					"id": 230070301,
					"content": "目前我有幾個想法，今天的話…我想找一些經常與元素生物接觸的土壤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070302
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070302,
					"content": "騙騙花就不錯，它們生長的地方，泥土很可能有與眾不同的特點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070303,
					"content": "但我只是個泥瓦匠，總不可能拿罐子去砸翻那些騙騙花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070304,
					"content": "#旅行者，能請{F#妳}{M#你}幫我這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070305,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "#那就拜託{F#妳}{M#你}了，請{F#妳}{M#你}幫我帶回來一份騙騙花根系上的泥土吧。",
					"roleType": "TALK_ROLE_NPC",
