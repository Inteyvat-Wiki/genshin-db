			"dialogs": [
				{
					"id": 230070201,
					"content": "目前我有幾個想法，今天的話…我想找一些浸有史萊姆凝液的泥土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070202,
					"content": "#我找人打聽到了一處史萊姆的聚集地，旅行者，{F#妳}{M#你}能幫我去取些泥土回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070203,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "#那就拜託{F#妳}{M#你}了。打不打倒那些史萊姆都行，只要取一些它們聚集地附近的泥土回來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070205,
					"content": "#我把那片史萊姆聚集地的方位給{F#妳}{M#你}標在地圖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070206,
					"content": "你自己不去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "我也想自己去，但我還要去解決一些罈罈罐罐的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070208,
					"content": "#放心吧，我會為{F#妳}{M#你}準備好適合的報酬的，這件事就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070209,
					"content": "#請{F#妳}{M#你}去這裡找一找吧，我幫{F#妳}{M#你}標在地圖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070210,
					"content": "#那就拜託{F#妳}{M#你}了。打不打倒那些史萊姆都行，只要取一些它們聚集地附近的泥土回來就好。",
