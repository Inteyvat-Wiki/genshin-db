					"派蒙",
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470301,
					"content": "有、有什麼東西出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470302,
					"content": "看上去好像也是一個殘影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470303,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470304,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470305,
					"content": "這句話我聽懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470306,
					"content": "這句話的意思就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470307,
					"content": "他說自己的名字是赫利俄斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470308,
					"content": "根本就沒懂吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "是這樣嗎……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470311,
					"content": "他的名字叫阿倍良久…真是奇怪的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470312,
					"content": "不過，既然他的名字是阿倍良久，那赫利俄斯又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470313,
					"content": "赫利俄斯！赫利俄斯！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470314,
					"content": "此乃吾親手所造…赫利俄斯造成之日，萬丈光芒自高天籠罩，如是眾人不受龍獸侵擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470315,
					"content": "啊啊，正當時，諸民仰視，熱淚盈眶，揚臂歡呼，難掩喜悅激動之情…可是現在怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470316,
					"content": "不對，吾，吾為何在此…為何…為何吾魂迷夢土，不得安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470317,
					"content": "派蒙聽懂了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "我懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470319,
					"content": "這一定是個…精神不太正常的殘魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470320,
					"content": "吾想起來了…吾魂魄不全，等吾魂歸一處，即可重獲安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470321,
					"content": "轉機就在汝身，吾且與汝言說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470322,
					"content": "呃，我聞到了麻煩事的氣息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470323,
					"content": "此處本應供奉吾一部分骨殖，但是早已朽壞…算是吾託命於汝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470324,
					"content": "將這些寄託吾念的供奉品拿去…不過，周圍有困守吾魂的怪物，一旦吾魂魄寄寓之物離開…便會蜂擁而上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470325,
					"content": "此事兇險，旅者啊，若汝準備好了，再與吾說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470309,
					"content": "他的名字叫阿倍良久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
