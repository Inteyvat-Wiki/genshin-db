					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "看來汝等的實力完全足以…護送供奉之物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470202,
					"content": "這樣，吾也能夠放心了…一定要將之送到，如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470203,
					"content": "如此才能什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470204,
					"content": "如此才能…如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470205,
					"content": "完了，完全是一副壞掉了的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722470206,
					"content": "不過他說的供奉品，就是這個吧…看上去也有點破破爛爛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224703,
