						],
						"pointId": 12598
					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "#喂，{F#妳}{M#你}們看到了嗎？剛才不知道發生了什麼事，我一不留神，那塊大石頭就突然飛走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "佩卡尼"
				},
				{
					"id": 760100602,
					"content": "講述了之前的事…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "#唔哦！雖然完全沒聽懂怎麼回事，但既然能展現這般奇蹟，{F#妳}{M#你}們一定是受到月之{RUBY#[D]庫塔爾}少女寵愛的人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "佩卡尼"
				},
				{
					"id": 760100604,
					"content": "月神大人保佑，月神大人保佑！這樣一來，我就能在這裡大釣特釣了！只要那個討厭的遊吟詩人不再帶著他的寵物過來唱歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "佩卡尼"
				},
				{
					"id": 760100605,
					"content": "來，這是說好的報酬！雖說我最近都沒釣到魚，但其他的東西倒是釣了不少，有的應該還滿值錢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "佩卡尼"
				},
				{
					"id": 760100606,
					"content": "#只是希汐島這邊也用不上什麼摩拉，所以就全都送給{F#妳}{M#你}們吧。謝謝{F#妳}{M#你}們幫忙，接下來就讓我一個人安心釣魚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "佩卡尼"
				}
			]
		}
	]
