			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "等等！士兵先生，您剛才念的台詞情緒不太對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540102,
					"content": "「武士，如同席捲大地的清風。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540103,
					"content": "你還記得我之前和你講的戲吧，要有一種灑脫感，滄桑感，灑脫，灑脫明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540104,
					"content": "這句話是整部戲的關鍵，您一定要完整地，飽滿地，完美地把情緒表達出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540105,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540106,
					"content": "而且揮劍的時候，不要那麼快，一定要保證自己在鏡頭裡面，不然「映影機」都要拍不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540107,
					"content": "先擺出架勢，然後停頓，明白嗎？停頓一下，然後猛地斬下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540108,
					"content": "但與人對決的時候，可不能這麼揮劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540109,
					"content": "這不是劇情和製作需要嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540110,
					"content": "再準備準備，我們再來一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540111,
					"content": "你們在幹什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#哎喲，是您呐！我親愛的好{F#小姐}{M#先生}，肯是一陣好風送您過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540115,
					"content": "如您所見，我正在和這位士兵先生拍攝一部「劍陣映影」，名字叫做《第七個武士》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540116,
					"content": "哦，「劍陣映影」是我為這一類的「映影」取的總稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540117,
					"content": "記錄著刀劍搏擊的畫面，讓觀看者感覺自己如同在劍陣之中穿梭一般的「映影」…差不多就是這個意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540118,
					"content": "虎之助先生居然有空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "這也是上面的大人們准許過的行為，據大人說，這也有助於為幕府武士揚威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540120,
					"content": "雖然，我不知道澤維爾先生是如何說服上面的大人們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540123,
					"content": "但說真的，這位源次郎大人真是一位…非常嚴肅認真，但同時也非常善解人意的先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540124,
					"content": "在我和他懇切地談過之後，他十分愉快地答應了我的請求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540125,
					"content": "不過嘛…作為交換，我必須先製作一部和幕府有關的「映影」，最好是以武士為主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540126,
					"content": "我對這種題材本來就感興趣，當然就答應了下來，那位源次郎大人也很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540127,
					"content": "在親自委派士兵先生和我同行之外，還額外指派了幾位身手不錯的士兵給我，然後他說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540128,
					"content": "「以刀劍搏擊的場面，展示武士和幕府的威嚴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540129,
					"content": "不得不說，這位源次郎大人的眼光真是頗為長遠，居然想到用「映影」來做宣傳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540130,
					"content": "但對我來說，一切對我製作「映影」有幫助的事，我都不會拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540131,
					"content": "你製作得還順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "老實說…不太順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540133,
					"content": "雖然這幾位士兵先生的武藝都很高強，但卻不習慣這種「演藝式」的戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540134,
					"content": "不僅揮劍快到「映影機」沒法記錄，而且有時候演著演著，就跑到了鏡頭外面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540140,
					"content": "旅行者，如果您有空的話，能按照我寫的劇本，上鏡演一遍讓士兵先生們看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540141,
					"content": "我相信，以您的實力和理解力，演藝時一定能在鏡頭前收放自如。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540142,
					"content": "從旁觀者的角度看過演出後，他們一定能更好地理解這個劇情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540143,
					"content": "來來來，您先看看劇本，台詞看看就好，這一段主要是打戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540144,
					"content": "「這場仗，也算是輸了。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "啊，這些是另外場次的台詞了…這一場戲主要是打戲，沒什麼台詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540148,
					"content": "我來看看劇本…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "哦對了，您扮演的這個角色叫做「十三郎」，他和幾名同伴一起，被一個村的村民們雇傭來保護村落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540150,
					"content": "呃，這一場還有一位叫做「久藏」的同伴有台詞…這台詞就由我說好了，先走一遍流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540151,
					"content": "您一定要代入這個角色，理解這個角色！就把自己當做「十三郎」，明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540152,
					"content": "明、明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "很好，非常好，好極了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540155,
					"content": "您準備好了之後就告訴我，我還得去把「映影機」的機位調整一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540153,
					"content": "我就是十三郎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "「就算落難了，武士還是武士。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "「你們都是合格的稻草人…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "「…但敵人可不是團雀。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "我能演個角色嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#當然！當然！您可是我心中永遠的{F#女主角}{M#男主角}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540137,
					"content": "那部《踏鞴物語》我可一直記著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540138,
					"content": "而且…雖然這幾位士兵先生的武藝都很高強，但卻不太習慣這種「演藝式」的戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540139,
					"content": "不僅揮劍快到「映影機」沒法記錄，而且有時候演著演著，就跑到了鏡頭外面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540121,
					"content": "你是怎麼說服他的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "士兵先生早就理解我了，我主要的工作，還是說服那位御輿源次郎大人，請求他允許我在稻妻製作「映影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540112,
					"content": "「武士，如同席捲大地的清風。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "您這句話的情緒太激昂了，應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "澤維爾"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
