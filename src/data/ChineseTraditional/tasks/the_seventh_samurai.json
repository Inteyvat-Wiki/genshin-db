					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#完美！不愧是我心中永遠的{F#女主角}{M#男主角}！完美的示範！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540302,
					"content": "什麼…什麼主角？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "主角，就是「映影」裡最重要的演員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540306,
					"content": "士兵先生，您看清楚剛才旅行者的示範了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540307,
					"content": "大致瞭解了。在揮劍的時候，我需要強調的其實並不是揮劍的「動作」，而是揮劍的「架勢」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540308,
					"content": "如果只是「架勢」的話…我倒是有些主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540309,
					"content": "哦？那太好了，請您去和其餘的士兵先生們說說，稍後我們再來一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540310,
					"content": "#旅行者，太謝謝{F#妳}{M#你}了，這些東西請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540311,
					"content": "下一部「映影」的題材是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "下一部「映影」的題材啊…唔…其實我也非常猶豫，有很多題材我都想要試一試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540313,
					"content": "比如鳴神大社裡的各種傳統啦，稻妻所流傳的狸貓和狐狸的傳說啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540314,
					"content": "稻妻有這麼多島嶼，可以製作的故事實在是太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540315,
					"content": "但無論如何，我都得先把這部《第七個武士》製作好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540316,
					"content": "如果能讓大人們滿意的話，我之後在稻妻製作「映影」的時候，想必也會方便很多吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721540304,
					"content": "下次想換個新角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "沒問題！等拍完了這一部「映影」之後，我就該籌劃下一部全新「映影」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "澤維爾"
				}
			]
		},
