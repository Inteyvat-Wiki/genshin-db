					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540402,
					"content": "你覺得這部「映影」怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "大人們認為，這「映影」有助於傳揚幕府武士的威名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540404,
					"content": "也許是我在這方面有些愚鈍吧…我真的沒有這方面的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540405,
					"content": "而且，這劇本裡的武士們盡說些喪氣話，全然沒有武士的威嚴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540406,
					"content": "不知道上面的大人們為什麼會答應下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540407,
					"content": "「御影爐心」還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "自從範兵衛大人「升遷」後，現在那邊的負責人已經換成了陽介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540409,
					"content": "他是工匠出身，十分踏實可靠，也很會處理實務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540410,
					"content": "「御影爐心」由他負責，應該不會再出什麼問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "虎之助"
				}
