			"dialogs": [
				{
					"id": 200690401,
					"content": "花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690402
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690402,
					"content": "對不起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690403
					]
				},
				{
					"id": 200690403,
					"content": "嗯？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690404
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690404,
					"content": "我不小心把盒子和花弄壞了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690405
					]
				},
				{
					"id": 200690405,
					"content": "弄、弄壞了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690406
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690406,
					"content": "嗚…那可是我專門挑出來的花，那麼好的花，可不是能輕易找到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690407
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690407,
					"content": "#雪山真有這麼危險嗎？連{F#妳}{M#你}這樣的冒險家都會失手，連一盒花都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690408
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690408,
					"content": "#不過，還是謝謝{F#妳}{M#你}幫我跑這一趟，這些東西給{F#妳}{M#你}，請收下吧，我要去打理店裡的花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690409
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690409,
					"content": "唉，不然…我還是再用莎拉小姐的辦法試試吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
