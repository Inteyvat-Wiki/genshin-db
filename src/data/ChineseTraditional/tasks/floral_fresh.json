			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芙蘿拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "這些花也變得沒精神了，好可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "因為經常有人到店裡來買單枝鮮花用來送人，所以我每天都會特別剪一些花備用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690104,
					"content": "但是那些剪下來的花保存不了多久，如果當天沒賣完的話，就會枯萎很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690105,
					"content": "雖然我也嘗試過很多方法，但一天之後，大部分花的品質也都沒法看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690106,
					"content": "到底有什麼方法能讓花卉保存得久一些呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690107,
					"content": "用保存食材的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "我是聽「獵鹿人」的莎拉說，他們會把沒用完的食材放在蔭涼的地方，或者用冰塊保存…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690109,
					"content": "我之前也嘗試過這種方法。但不知道為什麼，直接用冰塊保存的話，花的顏色和外形都會變得很奇怪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690110,
					"content": "不能說是枯萎了…也不能說是鮮花，但總之是沒法看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690114,
					"content": "#我問了很多人，然後那位薩伊德先生…{F#妳}{M#你}知道嗎？就是那位學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690115,
					"content": "他有一天來買花的時候告訴我，他曾經在一本書上看到一種「冷藏花卉」的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690116,
					"content": "具體來說…就是用一個容器裝著花，然後再把這個容器放在冰塊附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690117,
					"content": "他還說，如果想要實驗的話，旁邊雪山上的低溫環境就很合適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690118,
					"content": "但我聽說雪山上很危險，一時半會也找不到願意幫我的冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690119,
					"content": "#旅行者，{F#妳}{M#你}能幫我把這三盒鮮花埋到雪山上的雪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690120,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，我想想…雪山我聽說很大，也有很多不同的區域，保存的效果應該也不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690123,
					"content": "唔，還是對比一下效果比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690124,
					"content": "#請{F#妳}{M#你}幫我把這些花分別放在雪山上的<color=#00E1FFFF>七天神像旁邊</color>、<color=#00E1FFFF>山裡的水邊</color>，還有…<color=#00E1FFFF>洞窟的入口</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690121,
					"content": "要埋在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "當天賣完就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "這樣當然最好啦，但每天總歸會有那麼一兩枝沒人買的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690113,
					"content": "雖然只有這麼一兩枝，但我也不想讓它們就這樣白白枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
		{
