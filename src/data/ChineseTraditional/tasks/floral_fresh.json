			"dialogs": [
				{
					"id": 200690201,
					"content": "花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690202,
					"content": "花已經埋好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "#謝謝{F#妳}{M#你}，那就先讓這些花在雪山上待一會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200690204,
					"content": "呼呼，謝謝你們這次幫我的忙，請收下這些報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "芙蘿拉"
				}
			]
		},
