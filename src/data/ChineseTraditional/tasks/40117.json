			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉",
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "…對了，之前凱亞哥哥答應可莉，要講完瓶中鎮靈的故事給可莉聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401171302,
					"content": "好啊，嗯…上次說到什麼地方了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171303,
					"content": "可莉記得，說是「魔瓶」裡出來的「鎮靈」，想要啊呣一口吃掉打開瓶子的牧童。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401171304,
					"content": "對對，就在壞鎮靈張開血盆大口的時候，牧童突然靈機一動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171305,
					"content": "把蹦蹦炸彈扔進了鎮靈嘴裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401171306,
					"content": "哈哈，如果那個時候牧童身邊有蹦蹦炸彈，他一定也會這麼做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171307,
					"content": "但是牧童從來沒見過炸彈這種東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171314,
					"content": "他只能對鎮靈說：「等等，你那麼大的身子，真的是從瓶子裡出來的嗎？除非我見到，不然我可不信！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171308,
					"content": "鎮靈很生氣，說：「哇呀呀，可惡的小牧童，你怎麼可以小看我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171309,
					"content": "鎮靈說完就鑽回了瓶子，牧童眼明手快，把瓶塞塞了回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171310,
					"content": "真好，這樣壞鎮靈就再也無法跑出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401171311,
					"content": "不過…一直被關在了瓶子那麼小的地方，壞鎮靈會不會睡不好覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401171312,
					"content": "那也是因為它做了壞事，被抓住，才被關在裡面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401171313,
					"content": "所以如果做了壞事不想被關，最關鍵的就是不能被別人抓到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "凱亞"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
