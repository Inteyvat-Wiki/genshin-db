			"dialogs": [
				{
					"id": 401171501,
					"content": "才大言不慚地答應了艾莉絲女士，結果蜃境就出了這樣的亂子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 401171502,
					"content": "不過，就、就和「軍師」小姐說的那樣，要是能夠讓蜃境恢復成原樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				}
			]
