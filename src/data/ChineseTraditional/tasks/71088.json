			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880201,
					"content": "#啊，原來是{F#妳}{M#你}呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880221
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880221,
					"content": "#哈，他們還真把{F#妳}{M#你}給找來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880202,
						710880203
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880202,
					"content": "沒錯，是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				},
				{
					"id": 710880204,
					"content": "哎喲，失禮失禮！我叫海迪夫，海迪夫·普爾希納。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880205
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880205,
					"content": "#哈哈，如果{F#妳}{M#你}瞭解學院歷史的話，我們的祖師們在星相學上曾是普爾比魯尼一系的宿敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880206,
						710880208
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880206,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880207
					]
				},
				{
					"id": 710880207,
					"content": "#不必特意自我介紹啦，{F#妳}{M#你}的大名我早已有所耳聞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880211,
					"content": "你在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880212
					]
				},
				{
					"id": 710880212,
					"content": "我是總務司特約的調查學者，負責在層岩巨淵重新開放之前進入礦井調查生物群落變化情況，以及考察古生物種群…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880213
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880213,
					"content": "當然，作為交換條件，我需要將研究成果與璃月本地的歷史學會共用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880214
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880214,
					"content": "#唉，我知道{F#妳}{M#你}想說什麼…原則上這是違反教令院規則的，但璃月方面表態強硬，沒人能讓他們有所動搖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880215
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880215,
					"content": "另外呢，由於勘探隊名義上是由我牽頭的，我還要負責營地所有礦工的開銷…唉，要是得不償失可就太虧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880216,
						710880217
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880216,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880218,
					"content": "不過沒關係的，不需要安慰我。我很有錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880219
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880219,
					"content": "好吧，告辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880220
					]
				},
				{
					"id": 710880220,
					"content": "再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880217,
					"content": "真是不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880208,
					"content": "自報師門是須彌傳統嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880209
					]
				},
				{
					"id": 710880209,
					"content": "哈哈，不是這樣的。怎麼說…算是身為學者的自矜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880210
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880210,
					"content": "說起來還都怪阿妮薩學姐那傢伙…把普爾比魯尼一門的壞毛病傳染給我囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880203,
					"content": "我認識你嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				}
			]
		},
		{
			"id": 7108803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108802",
							"2"
						],
						"stepId": 7108802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880301,
					"content": "#喲，是新面孔，{F#妳}{M#你}好，年輕人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880302,
					"content": "新面孔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880303
					]
				},
				{
					"id": 710880303,
					"content": "#哈哈…礦上的每一個人不好說認識吧，至少都能叫得出名字。不過{F#妳}{M#你}嘛…是第一次來礦上，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880304
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880304,
					"content": "#{NICKNAME}，幸會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880305
					]
				},
				{
					"id": 710880305,
					"content": "瑾武，管設備的。在礦上幹了二十來年，算是這幫小夥子的大姐。有什麼不懂的可以來找我，設備出毛病了找我也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880306,
					"content": "或者，單純聽大姐閒扯兩句歷史故事什麼的，我也歡迎。閒著也是閒著嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880307,
						710880316,
						710880323,
						710880326
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880307,
					"content": "關於層岩巨淵的歷史…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880308
					]
				},
				{
					"id": 710880308,
					"content": "#那就說來話長了…我就為{F#妳}{M#你}簡短介紹一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880309
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880309,
					"content": "層岩巨淵是璃月最大的礦產基地，也是天衡山礦區之後第二古老的礦區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880310
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880310,
					"content": "傳說在岩王爺到來之前，這裡就居住著以開採琉璃晶砂、交易陶瓷製成品為生的部族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880311
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880311,
					"content": "後來這些部族與岩王爺的夜叉信使歃血為盟，自成一支，於是便成為了今日八門之一——盛露廳的前身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880312
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880312,
					"content": "他們也參加了鎮壓若陀龍王與擊退漆黑災禍的大戰…可謂勞苦功高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880313
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880313,
					"content": "#{F#妳}{M#你}看，西北面的那座谷地…傳說就是當年岩王爺將若陀龍王拖離層岩巨淵，活生生拖出來的痕跡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880314
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880314,
					"content": "後來呀，待到褪盡蠻荒，習慣了城市生活的部民便隨岩王爺遷入城中，專以製造和販賣瓷器為業，不再顧兵戈之事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880315
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880315,
					"content": "哈哈…所以別看盛露廳如今都是些斤斤計較的瓷器商人，祖上也是與岩王爺並肩打過硬仗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880316,
					"content": "關於層岩巨淵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880317
					]
				},
				{
					"id": 710880317,
					"content": "幾年前礦區封鎖時我也在場，聽說下層的小夥子們挖到了不得了的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880318
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880318,
					"content": "我光記得那時候傷員被接連不斷地運上地面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880319
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880319,
					"content": "#更邪門的是，小夥子們受的傷並不是礦下面常見的工傷，而是…呃，有點像精神上的打擊，{F#妳}{M#你}懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880320
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880320,
					"content": "把小夥子們送到地面之後，他們過幾天就慢慢恢復正常了…雖然沒造成什麼嚴重損失，但還是引起了七星的震動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880321
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880321,
					"content": "不管他們挖到了什麼，一定不是什麼好東西就對了。玉京臺的大人們可能也是這樣想的…就全面封鎖了層岩巨淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880322
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880322,
					"content": "結果呢，盛露廳可不高興了…哈哈，那就是另一個話題囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880323,
					"content": "關於妳的工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880324
					]
				},
				{
					"id": 710880324,
					"content": "管設備的。二十來年了，別人家孩子上學的年紀我就在摸晶石礦燈和濾水器了，沒什麼好說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880325
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880325,
					"content": "#{M#認識了一撥又一撥礦工，初次下礦時也比你大不了多少。}{F#女孩子可不要做這種工作，像我一樣把大好時光浪費在礦上，整天一身臭汗忙來忙去，不值得的。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880326,
					"content": "關於「七星陣法」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880327
					]
				},
				{
					"id": 710880327,
					"content": "那是「七星」專門設立的陣法，為的就是防君子不防…哈哈，不開玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880328
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880328,
					"content": "總之，這陣法在行政上是最高級別的封印，任何人看到它就會自然想到，擅自解封的話，要面臨什麼樣的問責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880329
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880329,
					"content": "所以呢，「七星」專門以過於顯眼的「磐鍵」作為固定陣法的節點，也是為了顯示權威…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880330
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880330,
					"content": "讓小賊們即使有賊心，也沒有賊膽大張旗鼓地解除封印，引得大人物震怒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880331
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880331,
					"content": "咳咳…換句話說，如果有人真的解除了封印，而沒有受到有效干涉…就證明那傢伙至少得到了「七星」的默許。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}