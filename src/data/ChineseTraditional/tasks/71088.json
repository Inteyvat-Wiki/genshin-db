	"talks": [
		{
			"id": 7108802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108801",
							"2"
						],
						"stepId": 7108801,
						"stateName": "QUEST_STATE_UNFINISHED"
