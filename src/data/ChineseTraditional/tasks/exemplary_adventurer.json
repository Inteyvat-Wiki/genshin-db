			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736820101,
					"content": "讓我等好久了啊，兩位膽識卓絕的朋友！請把握這個大好機會，和我一起領略冒險的藝術，嘗試超越本我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820102,
						736820103
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820102,
					"content": "冒險藝術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				},
				{
					"id": 736820104,
					"content": "#唔，雖然不知道{F#妳}{M#你}在說什麼，但好像很厲害！能不能再解釋一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820105,
					"content": "#當然沒問題…等等，我認識{F#妳}{M#你}…居然是您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820106
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820106,
					"content": "抗擊風魔龍的空戰豪傑、不倦執勤的委託粉碎機、隱秘寶箱的尋蹤人和未知迷霧的破除者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820107
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820107,
					"content": "如果您帶頭參加這次活動，一定能拉動大家的熱情，推進這項偉大的事業！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820108
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820108,
					"content": "好大一串稱號？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820109
					]
				},
				{
					"id": 736820109,
					"content": "從來沒聽過欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820110,
					"content": "這些稱號通常出現酒桌上、篝火周圍和孩子們的睡前故事裡，只靠人們口口相傳，您沒聽過也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820111
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820111,
					"content": "總之，您活躍的身影鼓勵著成百上千位冒險家，給了大家不斷變強的動力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820112
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820112,
					"content": "#原來{NICKNAME}在蒙德的冒險家協會已經這麼有名了嗎？那我呢，我有什麼稱號嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820113,
					"content": "咳咳！我好像聽朋友說過，有人稱妳為…「如鳥羽般輕靈，如北風般豪爽的派蒙大人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820114
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820114,
					"content": "「鳥羽般輕靈」形容的是妳小巧敏捷的身姿，「北風般豪爽」說的是妳和北風騎士不相上下的，令人羡慕的好胃口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820115,
						736820116
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820115,
					"content": "怎麼好像是在開玩笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820117,
					"content": "有點聽不明白…但都叫我派蒙大人了，應該很威風吧！我會牢牢記下來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820118,
					"content": "#我決定了！不管妳有什麼請求，我派蒙大人和…呃…和豪傑粉碎機、空戰寶箱與委託破除人{NICKNAME}都會幫妳到底的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820119,
					"content": "剛才妳好像提到了冒險、超越之類的詞，我猜，是不是協會要舉辦一場特別的挑戰活動？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820120,
					"content": "#完全正確！{F#妳}{M#你}們應該聽說過，冒險家協會經常為新人開展特訓。正好在佳釀節期間，漸強的西風捎來了特別的「風種子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820121
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820121,
					"content": "這些「風種子」可以強化冒險家們的能力，讓大家體驗變強後的美妙感受，也算是給了冒險家們一個努力的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820122
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820122,
					"content": "所以賽琉斯會長讓我在這些「風種子」散落的區域周圍探查一番，找出凶悍魔物和盜匪的所在地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820123
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820123,
					"content": "參加試煉的冒險家們需要謹慎運用特別的「風種子」，擊敗這些敵人。達成技藝的昇華，精神的突破，以及對未來的展望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820124
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820124,
					"content": "怎麼樣，有沒有覺得很興奮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820125
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820125,
					"content": "哼哼，果然沒錯，我的直覺很準嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820126,
					"content": "反正我們已經吃飽喝足了，不活動一下的話，也許會變胖呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736820127,
					"content": "#對吧對吧！趕快卷起袖子來試試吧！如果{F#妳}{M#你}們參與了這場試煉，相信會有很多冒險家慕名而來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820128
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820128,
					"content": "#接下來，我會幫{F#妳}{M#你}們指出首個挑戰區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820129
					],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820129,
					"content": "#放手去做吧，我會記錄{F#妳}{M#你}們的英姿，並向其他冒險家好好宣傳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊妮"
				},
				{
					"id": 736820116,
					"content": "怎麼好像是剛剛編的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820103,
					"content": "超越本我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				}
			]
		}
	]
}