			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756590101,
					"content": "英雄大人，您終於來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590102
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590102,
					"content": "卑職在此等候多時。待到看見您的身影，疲憊竟一掃而空！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590103,
						756590104
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590103,
					"content": "沒錯，我來得正好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				},
				{
					"id": 756590105,
					"content": "氣氛突然變得好正式！我…我也要用正經的語氣說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590106,
					"content": "啊，請別緊張，英雄大人和尊貴的嚮導，我簡單介紹一下情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590107
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590107,
					"content": "卑職是話事處的員工，戰備聯絡人伊拉德，負責協助火神大人處理各部族巡邏隊的訓練事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590108
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590108,
					"content": "根據傳統，各部族每過一段時間，都會從年輕人中選拔新的戰士加入巡邏隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590109
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590109,
					"content": "同時，還要為老成員們設計難度比較高的考核，以便讓他們挑戰自我，不斷進步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590110
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590110,
					"content": "相關的選拔與考核關卡，就是由戰備聯絡人聯合各部族的優秀戰士一同設計的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590111
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590111,
					"content": "哦呀，我聽懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590112,
					"content": "#聊到戰鬥、競速之類的挑戰，{NICKNAME}的確是專家，應該能幫妳設計出很多有趣的關卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590113,
						756590114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590113,
					"content": "妳要指派任務給我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590115,
					"content": "不至於，不至於！卑職怎敢讓英雄大人來做我分內的工作！那既是我的失職，又是對英雄大人的怠慢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590116
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590116,
					"content": "所有的考核關卡都已經設計完畢了，我只是想請求英雄大人對這些關卡予以「認證」，同時，也是為戰士們樹立一個榜樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590117
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590117,
					"content": "就如書面考試需要滿分，人們修習技藝也需要目標。強大的戰士率先通過這些考核關卡，會給後輩們無盡的動力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590118
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590118,
					"content": "比方說「回聲之子」相關的考核關卡，就由「巴萊卡」的希諾寧大師認證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590119
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590119,
					"content": "「懸木人」和「花羽會」的關卡，則分別請到了「馬力卜」基尼奇大師和「武卡」恰斯卡大師，讓許多戰士滿懷熱情地挑戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590120
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590120,
					"content": "#原來是這個意思…那這次{NICKNAME}豈不是成了…那句話是怎麼說的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590121,
					"content": "「永遠追不上的地平線」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756590122,
					"content": "好，我來當大家的榜樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590123
					]
				},
				{
					"id": 756590123,
					"content": "這氣魄，不愧是英雄大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590124
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590124,
					"content": "謙虛點，提瓦特遍地是高手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590125
					]
				},
				{
					"id": 756590125,
					"content": "這氣度，讚美英雄大人的品德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590126
					],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590126,
					"content": "那麼，請容卑職在地圖上標出幾個考核關卡的位置，英雄大人隨時可以前去大展身手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊拉德"
				},
				{
					"id": 756590114,
					"content": "妳想成為我的甲方嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590104,
					"content": "有…有什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				}
			]
		}
	]
}