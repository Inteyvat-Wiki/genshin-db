				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "#這位旅行者，請{F#妳}{M#你}留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020202,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "#雖然有點突然…但是，請問{F#妳}{M#你}對「留影機」有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020204,
					"content": "有一點興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "哎，我這台「留影機」可不是一般的「留影機」，這可是楓丹最新的技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020207,
					"content": "從這台「留影機」裡印出來的畫，能有一種普通「留影機」沒有的色調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020208,
					"content": "這是怎麼做到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "#哎！{F#妳}{M#你}怎麼一副不相信的樣子，{F#妳}{M#你}不信的話，就去冒險家協會那邊問問去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020211,
					"content": "之前我也不相信，擺弄了這台「留影機」半天沒擺弄好，還是協會裡的一位冒險家幫了我的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020212,
					"content": "這「留影機」啊，和普通的「留影機」不一樣的地方，就是在它裡面的有個小結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020213,
					"content": "這個結構裡填著一種特別的藥劑，能讓印出來的畫帶有特別的效果，可比普通「留影機」拍出來的畫好看多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020214,
					"content": "怎麼樣？有興趣的話，您先拿著這個玩玩？雖然這台裡面的藥劑種類不太多，但體驗體驗還是足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020215,
					"content": "我之後還會去楓丹進一批全新的藥劑，要是您有興趣，歡迎來光顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020216,
					"content": "那…謝謝了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "那這台「留影機」就送給您玩了，如果覺得不錯，以後記得多多光顧我的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020217,
					"content": "那些藥劑多少錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "這個…咳，您別擔心，單支非常便宜。如果您買得多，到時候也能商量一下優惠一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020209,
					"content": "真的假的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "沒什麼興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "好了這台「留影機」就送給您了，請您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020302,
					"content": "這台「留影機」就…送我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "這些藥劑也夠您用一段時間的了，藥劑用完了的話…您就可以找我買嘛，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020305,
					"content": "再說了，我還準備去找那個人，進更多種類的藥劑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020306,
					"content": "您以後要是有興趣，歡迎您來我這光顧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020307,
					"content": "哎呀…沒想到，買台「留影機」，還能買出一樁好生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020303,
					"content": "要是那種藥劑用完的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}