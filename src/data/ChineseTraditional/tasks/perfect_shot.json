			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "#哎，{F#妳}{M#你}來了，我正好有事和{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020102,
					"content": "有什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "不用了不用了，我已經弄清原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020105,
					"content": "前幾天，我總算找到那個賣我「留影機」的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020106,
					"content": "我說他的「留影機」有問題，但是他怎麼都不信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020107,
					"content": "#多虧了{F#妳}{M#你}之前幫我拍了那麼多畫，要不是我有那麼多畫，那傢伙恐怕就不肯認帳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020108,
					"content": "#有了{F#妳}{M#你}幫我拍了那些畫，他才答應回去檢查一下賣給我的那批「留影機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020109,
					"content": "結果，昨天他剛拿了一瓶什麼藥劑過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020110,
					"content": "他說這種「留影機」的結構和普通的不一樣，需要往機器添加點藥劑，印出來的畫才是出正常的畫面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020111,
					"content": "#要是不加那種藥劑，那就和{F#妳}{M#你}之前拍的那種畫一樣，只有顏色，沒有清晰的畫面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020112,
					"content": "機器沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "唔，話是這麼說，但比起「留影機」，我其實對那種藥劑更感興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020115,
					"content": "#{F#妳}{M#你}想，大多數人只會買一台「留影機」對吧？買了也可以一直用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020116,
					"content": "但那種藥劑可是耗材，用完了之後，想用就得接著賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020117,
					"content": "而且據那個人說，根據藥劑的不同，印出來的畫效果也不一樣。他那邊也正在研究更多的藥劑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020118,
					"content": "也許…那種藥劑才是真正的大生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020119,
					"content": "咳，抱歉，我一個人在這自言自語個沒完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020120,
					"content": "謝謝您幫忙，您先把這台「留影機」給我一下，我為您把那種藥劑添進去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020113,
					"content": "那…就都沒問題了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "今天也要拍「顏色」強烈的東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
