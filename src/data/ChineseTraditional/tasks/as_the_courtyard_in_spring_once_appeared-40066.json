			"dialogs": [
				{
					"id": 400660301,
					"content": "哇，是新的空間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400660302,
					"content": "與上次一樣，只有萬葉卿不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400660303,
					"content": "好，這裡就交給我們幾個啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原景春",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "…好，這樣就可以了。萬葉，來得正好，你看我這塊石頭雕得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660602,
					"content": "靈巧有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400660603,
					"content": "呵呵，這是我從書上看來的山景。別國有許多高聳入雲的名山，如有機會，真想外出看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660604,
					"content": "您若想去，隨時都能出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400660605,
					"content": "話不能這麼說。我是如今的家主，雖說楓原家遠不比從前，可該做的事，一件都沒少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660606,
					"content": "但…像這樣堅持父輩的道路，為一度隕落的家族事業傾盡所有，當真值得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660607,
					"content": "父親，我…不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400660608,
					"content": "…萬葉，我希望你記得一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660609,
					"content": "家族固然重要，人卻也不能拘泥於此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660610,
					"content": "家因人而存在。要是我們自己過得苦悶，又談何讓家人快樂幸福呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660611,
					"content": "從前的事，影響家族甚多。可它不應是讓子孫背負的重擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660612,
					"content": "…如果有一天，你厭倦了無趣的生活，就丟下一切出去走走。切記，不要讓生活束縛了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660613,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"楓原景春"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "請恕我無法理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661102,
					"content": "萬葉，你忘了我們之間的約定嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661103,
					"content": "您真的要放棄這一切嗎？就算…就算我們過得艱苦，可您還有我在身邊啊，我難道不能幫助您嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661104,
					"content": "您像我這麼大的時候，已經在為爺爺分憂了吧。是我太無能，讓您失望，還是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661105,
					"content": "萬葉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661106,
					"content": "…唉，你會為這些事自責，正是我作為父親失敗的證明啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661107,
					"content": "楓原家為過去的錯誤付出了太多太多。從你曾祖父那一輩開始，直到現在，我們都沒能真正走出陰霾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661108,
					"content": "鍛刀是我們一族的事業，可你記住，家族的事業，未必就要是你的全部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661109,
					"content": "受傷的野獸想要走出陷阱，就要忍痛捨棄被鉗制的後腿。你覺得這是損失，可不離開陷阱，後果更為致命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661110,
					"content": "已經夠了，萬葉。我身為一家之主，卻沒能振興家族讓你當上貴族少爺。你不埋怨我，我就挺高興了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661111,
					"content": "幾代人的痛苦…就到今天為止吧。從今往後，卸下擔子生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661112,
					"content": "至於捨棄家族產業的惡名，我來背負就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661113,
					"content": "…父親…請別這樣，當不起家的惡名，可不能落在您頭上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661114,
					"content": "要是真有那麼一天，我也要為您分擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661115,
					"content": "再等等吧。楓原家遲早會傳到我手中，等那時，再由我來處理這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4006614,
			"completionStepIds": [
				4006614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
