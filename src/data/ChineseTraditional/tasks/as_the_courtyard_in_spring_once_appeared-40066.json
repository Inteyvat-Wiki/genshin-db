			"dialogs": [
				{
					"id": 400661701,
					"content": "果然又被關在這裡了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400661702,
					"content": "哈哈，也算是規律使然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661703,
					"content": "我們又進了幻境裡的迷宮哦，不過這一次，似乎跟上次不太一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400661704,
					"content": "講述了這一次的見聞…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "人氣變淡，擺設也不那麼華麗了…嗯，本該如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661706,
					"content": "#{F#妳}{M#你}們見到的，應該是正在沒落的楓原家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661707,
					"content": "不過，幻境裡的你像個影子一樣，而且跟現在不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400661708,
					"content": "沒錯，本皇女也贊同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400661709,
					"content": "與現在的萬葉卿相比，那道幻影有更多迷茫，背負著沉重的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400661710,
					"content": "確實能算是背負著沉重的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400661711,
					"content": "說明如今的我成長了。讓各位見到不成熟的我，實在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661712,
					"content": "離開稻妻之後很長一段時間裡，我的生活顛沛流離。但不是壞事，我因而沉澱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661713,
					"content": "如果我也能見到那個從前的我就好了。他見了我，定會明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400661714,
					"content": "——人生路遠，我仍需遠行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
