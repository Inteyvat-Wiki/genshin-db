					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661401,
					"content": "不對，雖然樣子沒什麼區別…可他都聽不到我們說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400661402,
					"content": "看來這只是個幻影，不是跟我們一起來的那個萬葉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
