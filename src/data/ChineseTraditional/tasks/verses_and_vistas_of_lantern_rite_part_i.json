			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "不對，這樣也不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "#啊，{F#妳}{M#你}好，我正在這附近取材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350104,
					"content": "現在不是正在海燈節期間嗎？我正在想，怎麼才能用一幅畫來描繪海燈節和璃月港呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350105,
					"content": "唉…不知道是我用的手法不對，還是什麼原因…怎麼畫都感覺不對勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350106,
					"content": "我在想，也許換個取景地能有些靈感，但我又實在找不到好取景地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350107,
					"content": "#旅行者，{F#妳}{M#你}知道哪裡有適合取景的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350108,
					"content": "那我們去周圍找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "唔…也好，那我們一起去周圍看看吧，說不定真能找到好取景地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "這裡的景色還不錯。咦，這位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350302,
					"content": "在下清晝，自詡詩客。您是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350303,
					"content": "哈哈，你是個詩人嗎？我是個畫家，正在這附近取材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350304,
					"content": "取材？巧了，我也正在取材，敢問您是為何取材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350305,
					"content": "唔，我想要畫一幅畫來描繪海燈節和璃月港，正在和這位旅行者一起找最佳取景點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350306,
					"content": "對了，您又是為什麼在這取材的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350307,
					"content": "嗯…這確實是巧了，我也正好想要寫一首詩來描述海燈節和璃月港，也正在這裡取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350308,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350309,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350310,
					"content": "一首詩…有點簡單了吧，海燈節和璃月港用幾行字怎麼能描述得下來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350311,
					"content": "哈哈，要我說，還是得畫一幅大畫，才能把這些事物全部給描繪下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350312,
					"content": "一幅大畫？呵呵，我倒是覺得這樣太費筆墨，反倒是把海燈節的神韻給遮蓋了下來，也失了璃月之風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350313,
					"content": "再說了，如此大的璃月，又怎麼能是一幅畫能畫下來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350314,
					"content": "哈哈，我看，還是畫好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350315,
					"content": "呵呵，我想，還是詩好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350316,
					"content": "你們冷靜點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "這麼爭下去也沒完沒了，不如這樣，我們各自去創作一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350318,
					"content": "等創作完了，再把作品擺在一起，請個人來評判，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350319,
					"content": "這樣也好，那等你畫好了畫，就來望舒客棧找我吧。然後我們再去找人評判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350320,
					"content": "好，那就一言為定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350321,
					"content": "一言為定，在下就先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 413350322,
					"content": "這個詩人真是大言不慚，憑幾行字就想概括海燈節和璃月港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350323,
					"content": "哼，等我把畫畫出來了，這詩人肯定得認輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350324,
					"content": "這幅畫我得好好畫…畫材也得特別準備一下才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350325,
					"content": "#旅行者，能請{F#妳}{M#你}幫我去搜集一點特別的材料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350326,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "#那就拜託{F#妳}{M#你}了，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350329,
					"content": "#唔…請{F#妳}{M#你}幫我去從熾熱騙騙花那裡搜集一份騙騙花蜜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350330,
					"content": "有了它，我一定能做出一份特別的顏料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 413350328,
					"content": "要什麼材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
		{
			"id": 4133505,
