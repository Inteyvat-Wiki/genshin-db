	"talks": [
		{
			"id": 4133501,
			"completionStepIds": [
				4133501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
