				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "#{F#妳}{M#你}怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350202,
					"content": "你也是來看銅雀的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "只是路過此處，駐足片刻罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350204,
					"content": "#{F#妳}{M#你}們來，是有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350205,
					"content": "我們是來看銅雀先生的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350206,
					"content": "不過，這周圍還是和上次一樣，簡直是一團亂啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350207,
					"content": "明明建了廟，也做了雕像…怎麼沒人過來維護一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350208,
					"content": "也許是忘了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "這也能忘記嗎？夜叉明明是保護了璃月港的大英雄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350211,
					"content": "魈…你、你是不高興了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350212,
					"content": "沒有，夜叉但行守護之責，本就無意尋求什麼後人紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350213,
					"content": "不說這些了，我們快點來吃烤吃虎魚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350214,
					"content": "唔…要是魈也想吃的話，我們可以各自把烤吃虎魚切一半給你喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350215,
					"content": "不必了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350216,
					"content": "救命啊！救命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350217,
					"content": "咦？我好像聽見了什麼聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350218,
					"content": "有人呼救，在那邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350219,
					"content": "快走！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "欸？把烤吃虎魚收好呀！我還沒吃呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
