					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "謝謝仙師，謝謝英雄…真是巧了，又遇見您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350302,
					"content": "你認識我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350303,
					"content": "我怎麼敢忘了仙師的樣子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350304,
					"content": "你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "哎呀，我叫王平安！您想起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350306,
					"content": "「掇星攫辰天君」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "啊？！別別別千萬別，什麼「掇星攫辰」，您可別損我了，仙師還在這呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350310,
					"content": "我正準備去山裡的一座供奉著夜叉「銅雀」的廟看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350311,
					"content": "但剛進山不久，就被那群盜寶團盯上了…多謝仙師相救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350312,
					"content": "等一下，你去銅雀先生的廟做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350313,
					"content": "難不成…你在打銅雀先生雕像的主意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350314,
					"content": "沒有！我絕不會有這種想法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350315,
					"content": "那你想做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "我是…想要重修一下那座廟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350317,
					"content": "我今天過來，本來是準備再仔細看看那座廟的情況，好回去購置材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350318,
					"content": "沒想到，半路上被盜寶團給盯上了，只能逃跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350319,
					"content": "但我跑著跑著就…迷路了。後面的事，您都知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350320,
					"content": "去廟那邊詳細說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "對，這裡不是談話的地方，我們先去廟那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350322,
					"content": "有什麼話，我們到那邊再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350323,
					"content": "你們去吧，我還有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350324,
					"content": "欸！你要走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350325,
					"content": "已經…走掉了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350308,
					"content": "我記得你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "多虧您還記著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "王平安"
				}
			]
		},
		{
