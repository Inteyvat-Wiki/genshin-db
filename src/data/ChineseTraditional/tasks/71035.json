			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "這座廟還是這麼破敗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350402,
					"content": "趕緊交代，你怎麼突然想要來修廟的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350403,
					"content": "咳，那就說來話長了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350404,
					"content": "我之前為了假扮仙人，搜集了很多資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350405,
					"content": "那次受了仙師教誨之後，我不是立下了從善的誓嗎？回去之後，我就準備把那些資料全部毀掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350406,
					"content": "但我轉念一想…與其把這些資料毀掉，不如我把這些資料，還有我行騙時的手段編寫成冊，散發給其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350407,
					"content": "這樣，說不定能幫助大家識破一些騙子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350408,
					"content": "沒想到，我編寫的這本冊子還真幫不少人防了騙，連總務司的人都說我這個冊子很有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350409,
					"content": "除了我自己寫的那部分內容之外，他們還拜託我加入一些其他的防騙內容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350410,
					"content": "為此，總務司還付了我不少錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350411,
					"content": "除了那本小冊子之外，我還在編寫另外一本有關「護法夜叉」的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350412,
					"content": "我想用這本書來向大家宣傳一下「護法夜叉」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350413,
					"content": "這樣做，我的那些民俗學知識也算是用在了正道上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350414,
					"content": "這位「銅雀」的廟，我也是在編寫有關「護法夜叉」的書的時候發現的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350415,
					"content": "上面記載說，那座廟本來是先民們為了紀念夜叉「銅雀」所建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350416,
					"content": "但我找到這座廟的時候，真沒想到它居然如此破敗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350417,
					"content": "回去之後我左思右想，最後還是決定…自己出錢，把這座廟重修一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350418,
					"content": "畢竟，我能重新走回正道，也是多虧了仙師教誨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350419,
					"content": "重修這座廟，也算是為我之前做的那些錯事贖一些罪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350420,
					"content": "唔…聽起來不像是假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350422,
					"content": "感覺還挺真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "什麼叫感覺挺真的，這就是真的，千真萬確！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350426,
					"content": "唉，算了，您愛怎麼想就怎麼想吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350427,
					"content": "您要是真不信，就等正式開工之後自己過來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350424,
					"content": "你之前是騙子欸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "我現在不是了啊！我現在可是個正經人，我不都在仙師面前立誓了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "王平安"
				}
			]
		},
