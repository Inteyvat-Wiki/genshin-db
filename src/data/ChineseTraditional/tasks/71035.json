					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "二位，要點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 710350102,
					"content": "三份烤吃虎魚，打包。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "好嘞！您在這稍等一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 710350104,
					"content": "#三份？{F#妳}{M#你}一份，我一份…還有一份是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350105,
					"content": "想去看看銅雀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "#{F#妳}{M#你}是說之前把七星燈和香爐給我們的那位銅雀先生嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350108,
					"content": "對喔，記得銅雀先生說過他很想念烤吃虎魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350109,
					"content": "不過，銅雀先生應該已經走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350110,
					"content": "去看看也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "嗯，那我們就再去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350112,
					"content": "之前在那邊見到銅雀先生的時候，那間廟又破又舊，旁邊好像還有盜寶團的蹤跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350113,
					"content": "希望，銅雀先生的雕像別被人弄壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350114,
					"content": "二位，您要的三份烤吃虎魚打包好了，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 710350115,
					"content": "#好香啊！{NICKNAME}，那我們就快點出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350106,
					"content": "銅雀喜歡吃烤吃虎魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
		{
			"id": 7103502,
