			"dialogs": [
				{
					"id": 790470701,
					"content": "哼！這下知道錯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470702,
					"content": "記住了！以後不准再來搞破壞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470703,
					"content": "不對勁啊！剛才的那三個傢伙，有誰見過它們嗎？是不是「超入戲」雇來的演員？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470704
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470704,
					"content": "「工程師」呢？「工程師」修完海怪爪牙的機關了嗎？快帶著應急小組去現場處理一下後續事宜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470705
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470705,
					"content": "什麼？我還在播音？啊啊對不起！我馬上關掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470706
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470706,
					"content": "還好遊客們自己搞定了這次的突發情況…下次絕對不能再犯這樣的錯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470707
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470707,
					"content": "克服重重困難後，「風之微粒」的收集工作總算幾近完成。兩位守望者太過專注，沒有注意到時間已經過去了大半個月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470708
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470708,
					"content": "奇蹟建築師也交出了完美的考卷，他用有限的時間迅速修復了小鎮地基中的升力氣球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470709
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470709,
					"content": "喇叭那邊的聲音…為什麼聽起來有點慌張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470710,
						790470711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470710,
					"content": "這是預期中的設計嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470712
					]
				},
				{
					"id": 790470712,
					"content": "呃，也不知道究竟發生了什麼事，先不管了！我們繼續話劇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470713,
					"content": "旁白說，我們來到了設定上的「十幾天後」，那就省下了等待建築師修復氣球的時間，我們現在就去和他們會合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470711,
					"content": "總覺得出了一點意外？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470712
					]
				}
			]
		}
	]
