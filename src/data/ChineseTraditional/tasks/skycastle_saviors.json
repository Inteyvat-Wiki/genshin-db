			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470101,
					"content": "機關設備檢查完成，「風之微粒」已部署到位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470102
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470102,
					"content": "喂喂？應該部署到位了吧？那些異常的風之微粒…都搞定了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470103
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470103,
					"content": "咳！總之…「黛依阿的三日遐想」之「天空高城救守記」，即將開幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470104
					],
					"speakerTitle": "樂園告示喇叭"
				},
				{
					"id": 790470104,
					"content": "故事發生在偏遠的山區，這裡的居民時常蒙受洪水和風暴的侵害，苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470105
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470105,
					"content": "為了及時對災害作出預警，一群富有擔當的勇士站了出來，在高聳入雲的山崖上搭建了觀察哨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470106
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470106,
					"content": "時光流轉，居住在高崖上的人們演化成了一支獨特的部族——「高崖守望者」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470107
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470107,
					"content": "來自喇叭的旁白詳細講述著故事的背景——\\n礙於物資運輸的不便，守望者們的生活條件過於艱苦，甚至在最近失去了最後一座完好的房屋。\\n於是，守望者的長老找到了專攻建築的「奇蹟建築師」，委託奇蹟建築師建造了一座懸浮在空中的小鎮…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470108
					]
				},
				{
					"id": 790470108,
					"content": "奇蹟建築師為牢固的岩石地基構築了絕妙的承重結構，在這之上搭建好所有的房屋。\\n隨後，他在地基內部安裝了上萬個專門設計的貨運熱氣球，並向其中注入「風之微粒」。\\n氣球獲得了無與倫比的升力，將整座小鎮直接托起，懸浮至山頂。\\n奇蹟建築師根據計算好的高度，用錨索將小鎮牢牢固定…\\n如此一來，守望者們便有了安定、溫暖的住處…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470109
					]
				},
				{
					"id": 790470109,
					"content": "但隨著時間流逝，貨運熱氣球似乎遭遇了某些意外…\\n守望者一族發現，小鎮的高度正在下降，似乎再過不久就會墜落至山頂，摔個粉碎…\\n巨大的危險正在降臨，小鎮損失高度的同時，小型地震般的顫動頻頻來襲，每位守望者都惶恐不安…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470110
					]
				},
				{
					"id": 790470110,
					"content": "嗚啊，這個故事的開頭居然這麼鄭重！一座浮在天空中的小鎮…要墜落了？一聽就是超大的危機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470111,
						790470112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470111,
					"content": "那我們也要認真一點了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				},
				{
					"id": 790470113,
					"content": "嗯，好像還有另一個喇叭，那邊才是話劇開始的地方，我們繼續過去聽聽看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470112,
					"content": "仔細了解故事的脈絡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				}
			]
		},
		{
			"id": 7904702,
			"completionStepIds": [
				7904702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904702",
							"2"
						],
						"stepId": 7904702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470201,
					"content": "守望者的長老與奇蹟建築師見面後，詳盡地介紹了空中小鎮面臨的危機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470202
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470202,
					"content": "奇蹟建築師，如您所見，小鎮的高度每天都在下降，我們都不想失去這座溫暖、可靠的家園，但又束手無策…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470203
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470203,
					"content": "而且，最近小鎮時常發生強烈的震動，不妙的傳聞正在散播，大家慢慢變得恐慌了起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470204
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470204,
					"content": "要摔死啦，要摔死啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470205
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470205,
					"content": "可敬的長老，我理解你們很心急，也聽說了一些質疑工程品質的流言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470206
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470206,
					"content": "但不必擔心，我再次回到這裡，就是為了將這次的危機徹底解決，消除你們的恐慌和疑慮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470207
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470207,
					"content": "剛才我繞著小鎮轉了一圈，看了看之前預留在地基里的監測裝置，發現問題出在個別升力氣球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470208
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470208,
					"content": "一些升力氣球中的風之微粒總量有所減少，似乎遭到了惡意破壞…所以，只需要將它們修好，就能防止小鎮墜毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470209
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470209,
					"content": "不過，為了讓小鎮回到原有的高度，還要提升一部分氣球的升力，並且安裝更多固定錨索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470210
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470210,
					"content": "這個嘛…得加錢…人為破壞通常是沒有免費維修的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470211
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470211,
					"content": "沒問題，預算增加到目前報價的五倍，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470212
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470212,
					"content": "五倍預算！五倍預算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470213
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470213,
					"content": "啊呀呀，您能同意加錢真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470214
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470214,
					"content": "慢著，五倍？這未免有點誇張了！最早建造這座小鎮時，你給我的預算就比其他甲方多好幾倍了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470215
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470215,
					"content": "上次忘了告訴你，以前曾有位貪心的工匠，看我們資金充裕，報價很誇張，是平均價格的二十多倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470216
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470216,
					"content": "還好，我們好好調查了一番，才沒上當受騙，現在我們對施工的費用也算是知道個大概了。而你的報價一直低於平均線很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470217
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470217,
					"content": "原來你們這麼闊綽嗎？還真是…財不外露啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470218
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470218,
					"content": "我們吃苦，我們讓大家發財！大家心裡有數，大家總是送錢給我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470219
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470219,
					"content": "正是如此，附近的村民們做了大生意，經常給我們大筆大筆捐贈財物。不過，我族生活勤儉，就把這些錢財積攢了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470220
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470220,
					"content": "天下居然還有這麼民風淳樸的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470221
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470221,
					"content": "咳咳，無論如何…我可是控制成本的高手，目前報價的2.5倍就足夠了，哪裡有必要那麼誇張！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470222
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470222,
					"content": "沒想到啊，沒想到啊，不愧是有著「奇蹟」之名的高尚建築師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470223
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470223,
					"content": "有錢不賺？有錢不賺！呆瓜！呆瓜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470224
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470224,
					"content": "喂！你這個笨鳥，我不能賺昧良心的摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470225
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470225,
					"content": "建造這座小鎮時，我的報價剛好超出材料和人工費一點點，可以給你們造出最好的房屋，還能剩下我兩個月的飯錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470226
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470226,
					"content": "至於今天的維修服務，我本來也只能賺到路費和這幾天的食宿費，難道對於甲方來說，這不是最好的方案嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470227
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470227,
					"content": "不久前還感動到落淚的長老有些生氣，用力敲暈了肩頭的學舌鳥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470228
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470228,
					"content": "咳咳，實在感激不盡！我們守望者一族會牢記你的恩情，並將你的事蹟代代傳頌下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470229
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470229,
					"content": "話說回來，上次您雇了一支馱獸商隊，運來了幾百個特別的儲藏罐，這次則是輕裝來訪，看起來沒做什麼準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470230
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470230,
					"content": "咳！您說到點子上了，現在最主要的問題，就是收集足夠的風之微粒，補充氣球損失的升力，得想個辦法啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470231
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470231,
					"content": "那你大可不必擔心，這次的風之微粒就交給我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470232
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470232,
					"content": "收集風之微粒正是我族擅長的領域——我們經常用這種方法分析暴風成形的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470233
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470233,
					"content": "就讓這一行的好手來助你一臂之力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470234
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470234,
					"content": "#長老推選了兩位勇敢的守望者——在一旁聽候已久的{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470235
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470235,
					"content": "#{F#妳}{M#你}們早就征服了重力與山風，能在高聳的地形來去自如，是守望者一族的新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470236
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470236,
					"content": "我懂啦，終於到我們出場了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470237,
					"content": "這一次，我們兩個是擅長飛來飛去的守望者，需要去各種地方收集「風之微粒」，聽起來一點也不難嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470238,
						790470239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470238,
					"content": "經典科目！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				},
				{
					"id": 790470240,
					"content": "#那麼，就拜託{F#妳}{M#你}們了！這次的工作可能比平常更累，我會額外給{F#妳}{M#你}們一筆獎勵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470241
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470241,
					"content": "#高空作業不是小事，{F#妳}{M#你}們一定要注意安全啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470242
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470242,
					"content": "不用擔心，老實的長老和誠實的建築師，這件事就包在我們身上了！你們在鎮子裡修氣球，我們去收集關鍵的微粒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470243,
					"content": "#我們走吧，{NICKNAME}，快快工作，早早收工！找齊足夠的「風之微粒」，幫這些守望者保住小鎮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470239,
					"content": "駕輕就熟！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				}
			]
		},
		{
			"id": 7904704,
			"completionStepIds": [
				7904704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904704",
