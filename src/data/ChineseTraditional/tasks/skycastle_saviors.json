			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470401,
					"content": "#歡迎回來！真是辛苦{F#妳}{M#你}們了，請先好好休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470402
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470402,
					"content": "厲害！厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470403
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470403,
					"content": "#{F#妳}{M#你}們環顧四周，奇蹟工程師已經修復了所有破損的升力氣球。\\n只等「風之微粒」準備到位，就能徹底解決小鎮墜落的危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470404
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470404,
					"content": "#長老召來了其他守望者，為{F#妳}{M#你}們端來了熱呼呼的飯菜和爽口的飲品。而奇蹟建築師掐指一算，對{F#妳}{M#你}們的效率嘖嘖稱奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470405
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470405,
					"content": "#{F#妳}{M#你}們完成收集任務的時間，比我的預期快上了整整五天？不愧是有名的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470406
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470406,
					"content": "既然「風之微粒」收集好了，那我就一鼓作氣，為氣球補充升力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470407
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470407,
					"content": "#來自喇叭的旁白開始描述此後的情景——\\n\\n 奇蹟建築師取出了獨特的設備，四處奔走，透過預先設置好的接口，將{F#妳}{M#你}們收集到的「風之微粒」分發至地基各處的裝置。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470408
					]
				},
				{
					"id": 790470408,
					"content": "隨著升力恢復正常，異常的震動也完全停息。\\n小鎮不再下墜，反而慢慢向原本所在的高度攀升，強烈的氣流排開了大片雲層…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470409
					]
				},
				{
					"id": 790470409,
					"content": "陰翳的天色也重歸晴朗，小鎮重新沐浴在明媚的陽光之下，守望者們開始歡慶叫好…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470410
					]
				},
				{
					"id": 790470410,
					"content": "太好了，小鎮總算停止下墜了，危機圓滿解除，鼓掌鼓掌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470411,
					"content": "可是，為什麼我們兩個要一直抬頭看呢？明明是我們腦海裡想像的情景，而且我們本來也站在小鎮上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470412,
					"content": "脖子都酸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470413,
					"content": "要不然，等到有機會了，我們找一找這方面的專家，把這個故事畫出來，或者…做成映影！我有預感，一定可以大賣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470414,
						790470415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470414,
					"content": "說不定黛依阿也是這麼想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470416
					]
				},
				{
					"id": 790470416,
					"content": "感受著腳下的地基歸於平靜，長老長舒了一口氣，感動得有些鼻酸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470417
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470417,
					"content": "小鎮安全了！小鎮安全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470418
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470418,
					"content": "太好了，太好了…這樣一來，我們守望者一族就可以繼續恪守職責！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470419
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470419,
					"content": "大功告成…這次的修復工程非常順利，是能寫進論文…哦不，是足以登上教科書的完美案例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470420
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470420,
					"content": "今後兩個月都不用為飯錢煩惱了，下次的大工程，做點什麼厲害的東西好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470421
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470421,
					"content": "可是，容我一問，小鎮好像…還一直在上升，如果超過了本來的高度…什麼時候才會停下來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470422
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470422,
					"content": "糟糕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470423
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470423,
					"content": "我好像光顧著修復氣球，忘記把抵消升力的錨索固定好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470424
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470424,
					"content": "不要慌…小鎮上升的速度很慢，還可以用小型貨運氣球來施工！這點補救措施，花不了多少功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470425
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470425,
					"content": "原來如此，我還以為，您見識到兩位新星的身姿後，覺得我們都能飛簷走壁，適應高空的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470426
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470426,
					"content": "哈！我們守望者一族倒也沒有那麼神通廣大…麻煩您盡快修復這個小小的瑕疵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470427
					],
					"speakerTitle": "守望者的長老"
				},
				{
					"id": 790470427,
					"content": "要加錢嗎？要加錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470428
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470428,
					"content": "再賺一點？再賺一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470429
					],
					"speakerTitle": "不太禮貌的學舌鳥"
				},
				{
					"id": 790470429,
					"content": "假如長老打算建一個豪華鳥籠，把你關在裡面，好好學習說話的禮儀，還有「生財有道」的道德觀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470430
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470430,
					"content": "那不用加錢，倒貼錢我也做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470431
					],
					"speakerTitle": "奇蹟建築師"
				},
				{
					"id": 790470431,
					"content": "雖說最後還有一點小插曲，但並不影響結局的圓滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470432
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470432,
					"content": "如此一來，守望者一族心心念念的問題，便被奇蹟建築師徹底解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470433
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470433,
					"content": "這座天空中的小鎮將繼續支持著高崖守望者一族，為整個地區帶來長久的安寧與繁榮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470434
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470434,
					"content": "「天空高城救守記」全劇終，感謝您的觀看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470435
					],
					"speakerTitle": "來自喇叭的旁白"
				},
				{
					"id": 790470435,
					"content": "鼓掌鼓掌，這部話劇落幕啦！雖然還有一些遺憾，但故事本身還是很不錯的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470436,
					"content": "如果我是一個富商，就要為「黛依阿的三日遐思」投一大筆錢，把每件道具和每個場景都做到最好，來講好這個故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470437,
						790470438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470437,
					"content": "有機會的話，我們研究一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
				{
					"id": 790470439,
					"content": "嗯！希望不久以後，我們就可以遇見神奇的黛依阿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790470438,
					"content": "這個計畫的財務情況怎麼樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
				{
					"id": 790470415,
					"content": "主要的問題是預算的困境吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470416
					]
				}
			]
		},
