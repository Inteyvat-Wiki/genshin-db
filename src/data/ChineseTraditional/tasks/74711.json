			"dialogs": [
				{
					"id": 747110101,
					"content": "嗯！一切順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110102,
					"content": "現在我可以確定了，救治狂暴魚兒們的工作，已經進入了最後階段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110103,
					"content": "除了再找回一些病患魚兒，查漏補缺，還有一個特別的任務——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110104,
					"content": "從受到影響的水域找出關鍵的水下機關，回收它們的探測裝置所記錄的資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110105,
					"content": "然後從中找出相關的規律…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "沒錯哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110108,
					"content": "還要向船主和潛水員提個醒，總結一下這次的教訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747110109,
					"content": "嗯，還有漁民和遊客、在水面上坐船、在水下潛水的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110110,
					"content": "所有和水域打交道的人都要留個心，可別隨意亂丟東西，搞得水域環境一團糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110111,
					"content": "不然，可能會有暴躁的魚兒來掀翻你的小船哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110106,
					"content": "以便之後防治類似的事故？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
