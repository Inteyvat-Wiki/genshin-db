					}
				]
			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "梅妲姐姐壞心眼…我只是想讓妳在冒險途中玩得開心，幹嘛要說這種掃興的話，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010202,
					"content": "你要是不改改你那想到什麼做什麼的毛病，其他人也會受不了你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010203,
					"content": "那才不是想到什麼做什麼，我、我也是有自己的打算的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010204,
					"content": "打算啊…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010205,
					"content": "又這樣敷衍我…我再也不跟妳講話了，到時候就算妳後悔也沒用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010206,
					"content": "…啊，莉奈婭姐姐！妳聽我說，梅妲姐姐她——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010207,
					"content": "聽維薩結結巴巴地講述了此前發生的事，似乎只是孩子間常見的小吵架…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "不管怎麼想錯的都不是我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010209,
					"content": "那我、我也沒錯啊！莉奈婭姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010210,
					"content": "唔——有時候的確會發生這樣的事呢。明明大家都沒錯，但結果卻不盡如人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010211,
					"content": "對了，就像宿影花代表的霜月之子姐妹的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010212,
					"content": "姐妹的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010213,
					"content": "嗯，據說曾經有一對霜月之子的姐妹，她們性格迥異，就像宿影花一紅一藍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010214,
					"content": "姐妹兩人都做了自己認為正確的事，但也正因為這樣而分道揚鑣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010215,
					"content": "據說妹妹一直都沒有原諒棄自己而去的姐姐，儘管姐姐在那之後拯救了許多人的生命…但最終，兩人到死也未能再見到一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010216,
					"content": "霜月之子還有這樣的故事…從來沒聽過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010217,
					"content": "我也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010218,
					"content": "我也是聽吟遊詩人講的，或許有故事性的成分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010219,
					"content": "哦，原來是編造的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010220,
					"content": "哎呀，就算故事可能是假的，但道理總歸是沒錯的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010221,
					"content": "她們誰也不認為自己有錯，都堅信自己的選擇才是正確的，但她們的選擇也讓她們永遠失去了彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010222,
					"content": "如果為了證明自己是對的，必須以失去朋友為代價…你們會怎麼選呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010224,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010225,
					"content": "唉…其實冒險途中偶爾有些臨時起意的小插曲也不賴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010226,
					"content": "…嗯！仔細想想，梅妲姐姐能陪我冒險的時間也很寶貴，要是想法變來變去，可能最後什麼都沒玩到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010227,
					"content": "下次…下次我會計劃得更好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "維薩"
				},
				{
					"id": 762010228,
					"content": "嘿嘿，你們能夠和好就最好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 762010229,
					"content": "之後和維薩去冒險的時候如果撿到什麼不常見的石頭，我們會送去「斯佩蘭扎」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "梅妲"
				},
				{
					"id": 762010230,
					"content": "好啊！那就先謝謝你們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈婭"
				}
			]
		},
