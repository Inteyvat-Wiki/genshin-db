			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "「鳴神大社」…就是這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500202,
					"content": "好多扇紅色的門啊。人類很喜歡紅色的門嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500203,
					"content": "這個叫「鳥居」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "淺瀨神社也有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500205,
					"content": "喔喔~奴家明白了，原來那就是「鳥居」啊。也就是鳥居住的地方對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500206,
					"content": "所以鳥居愈多，鳥就愈多吧。鳥，那可是好東西。人類也挺聰明的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500207,
					"content": "汝等，看見阿響在哪了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500208,
					"content": "沒發現人的蹤跡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "這周圍，好像都沒有人的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500210,
					"content": "不如，我們上去「鳴神大社」，問問裡面的那些巫女小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500211,
					"content": "那位「阿響」應該也是巫女…說不定，她們會知道些什麼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "喵喵，這神社可真大，也有很多人類呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500302,
					"content": "喔！捐獻箱和架子也很氣派，難怪有這麼多人來這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500303,
					"content": "汝等好好學。以後，淺瀨神社也要變成這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500304,
					"content": "應該不是這方面的原因啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "不過，還是沒看到阿響哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500307,
					"content": "總、總之，我們找人問問關於「阿響」的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500305,
					"content": "為什麼是我要好好學啊？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稻城螢美",
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "#{F#妳}{M#你}好，遠道而來的旅者，歡迎來到「鳴神大社」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500402,
					"content": "#如果有煩惱或者心願，可以來這裡求籤，雷神會保佑{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500403,
					"content": "我們不是來求籤的，是有一件事想要請問妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500404,
					"content": "問我？喔…那請說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500405,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "淺瀨神社的…阿響？難道是「淺瀨響」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500407,
					"content": "對！阿響就是「淺瀨響」，人類！汝認識阿響嗎？知道她在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500408,
					"content": "嗯…咦？！這隻貓怎麼會說話，是我聽錯了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500409,
					"content": "人類真是喜歡大驚小怪啊…奴家會說話是件很奇怪的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500410,
					"content": "汝，認識阿響嗎？知道她在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500411,
					"content": "被一隻貓這麼追問，感覺還真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500412,
					"content": "#不過，如果{F#妳}{M#你}們問的真的是那位「淺瀨響」的話，那{F#妳}{M#你}們找錯地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500413,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500414,
					"content": "找錯了…地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "我之前在神社少數保存完整的典籍裡讀到過她的名字。她是淺瀨神社最後一代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500416,
					"content": "大約四五百年前，曾經有「影向役者三人組」的說法。淺瀨響、惟神晴之介、御輿長正曾經在影向山上，事師於影向天狗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500417,
					"content": "當時淺瀨在我們神社見習過，也與狐齋宮大人有所結交。不過，最後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500418,
					"content": "三人最終似乎是在一場記事中語焉不詳的「災難」後分道揚鑣了。據說，惟神渡海去了璃月，想要學習更強大的「仙家道法」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500419,
					"content": "御輿回到了稻妻城，為幕府效力。淺瀨則…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500420,
					"content": "回到了清籟島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "嗯，沒錯。不過因為可考的史料太少，所以具體的情況也不太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500423,
					"content": "等一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "唔…她說四五百年前，也就是說，阿響是很久前的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500425,
					"content": "那寢子也是有四五百歲的貓嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500426,
					"content": "喵喵？奴家不清楚。「四五百歲」是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500427,
					"content": "奴家又不是人。沒有那麼多要計較的事情，只知道太陽升起、月亮升起。如果心情不好，那睡一覺就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500428,
					"content": "好羡慕啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500429,
					"content": "派蒙也差不多吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#喂！真沒禮貌，派蒙可是天天為了{NICKNAME}，擔心得不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500433,
					"content": "汝等說了很多奴家不懂的事情。所以，阿響呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500434,
					"content": "恕我直言，淺瀨響的話，恐怕已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 220500435,
					"content": "阿響不在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "對、對啊，阿響應該是去別的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500438,
					"content": "也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500439,
					"content": "真沒辦法哪。阿響怎麼還跟小傢伙似的。到處亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220500440,
					"content": "不管怎麼說，謝謝巫女小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220500441,
					"content": "那麼，我們先走了。",
