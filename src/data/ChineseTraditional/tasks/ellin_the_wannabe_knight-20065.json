			"dialogs": [
				{
					"id": 200650101,
					"content": "傷腦筋…這裡要怎麼解決啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650102,
					"content": "妳在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "為了下一次的騎士選拔，我正在訓練呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650104,
					"content": "唔…不過，我可沒有琴大人那樣的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650105,
					"content": "比起鍛煉「力量」，我覺得學習「技巧」更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650106,
					"content": "比如，一口氣把這些木樁全部破壞掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200650107,
					"content": "這些木樁可是很結實的，可不能掉以輕心…真是辛苦老爸了，也不知道他是從哪找到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
