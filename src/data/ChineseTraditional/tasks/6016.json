			},
			"dialogs": [
				{
					"id": 60160401,
					"content": "看什麼呢？詠月使小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160402
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160402,
					"content": "妳對我的稱呼還真奇怪。詠月使小姐、詠月使女士…都叫過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160403
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160403,
					"content": "是啊，不行嗎？這不都是妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160404
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160404,
					"content": "但我已經想好直接叫妳奈芙爾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160405
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160405,
					"content": "我本來就叫這個，有什麼奇怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160406
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160406,
					"content": "意思是不加任何稱謂，直呼其名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160407
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160407,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160408
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160408,
					"content": "也許可以證明我們的關係變融洽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160409
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160409,
					"content": "多麼美麗的錯覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160410
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160410,
					"content": "奈芙爾！菈烏瑪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160411,
					"content": "#派蒙、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160412
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160412,
					"content": "我們來看看妳們的情況！準備得還順利嗎？有好好休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160413,
					"content": "放心吧，不會拖大家後腿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160414
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160414,
					"content": "我也會全力幫助大家取得勝利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160415
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160415,
					"content": "#對了，請允許我替{F#妳}{M#你}們稍微檢查一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160416
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160416,
					"content": "…好了，兩位的狀態都不錯，真是再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160417,
						60160418
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160417,
					"content": "託大家的福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160419
					]
				},
				{
					"id": 60160419,
					"content": "#不用客氣。{F#妳}{M#你}不比我們任何人輕鬆，所以{F#妳}{M#你}也要好好休息，直到迎戰多托雷的那一刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160420
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160420,
					"content": "#放心吧，我會監督{M#他}{F#她}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160421,
					"content": "那就好，派蒙自己也要注意休息哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160422
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160422,
					"content": "嗯，我記住啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160418,
					"content": "非常感謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160419
					]
				}
			]
		},
