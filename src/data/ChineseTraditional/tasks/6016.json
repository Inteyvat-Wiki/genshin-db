					"id": 60160504,
					"content": "有她幫忙，情況應該會穩定一些，至少大家可以得到最基本的保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160505
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 60160505,
					"content": "阿貝多、杜林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160506,
					"content": "#是{NICKNAME}和派蒙！{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160507
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 60160507,
					"content": "休息得還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160508
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 60160508,
					"content": "謝謝關心，還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160509
					]
				},
				{
					"id": 60160509,
					"content": "那我們就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160510
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 60160510,
					"content": "按照計畫，那夏鎮交給我和阿貝多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160511
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 60160511,
					"content": "雖說多托雷的能量界域一直在不斷向這裡拓張…我們會竭盡全力守住陣地的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160512
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 60160512,
					"content": "我們並肩作戰過很多次，每一次都取得了好的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160513
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 60160513,
					"content": "這次一定也是如此，所以，儘管去戰鬥吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				}
			]
