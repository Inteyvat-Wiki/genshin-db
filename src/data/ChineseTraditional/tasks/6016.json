					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160420
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60160420,
					"content": "#放心吧，我會監督{M#他}{F#她}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160421,
					"content": "那就好，派蒙自己也要注意休息哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160422
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60160422,
					"content": "嗯，我記住啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160418,
					"content": "非常感謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160419
					]
				}
			]
