					}
				]
			},
			"dialogs": [
				{
					"id": 60161901,
					"content": "我知道你們在搞一些自以為掙扎的小花招，不過看起來，似乎沒能堅持到程序的最後一步啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161902
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161902,
					"content": "讓我猜猜，你們是想讓哥倫比婭回來吧？那怎麼沒見到桑多涅？難道你們在為她爭取時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161903
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161903,
					"content": "有趣…這兩位的性格可不一般，居然也與你們建立了如此深厚的連結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161904
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161904,
					"content": "說到哥倫比婭，我也曾將她視作妹妹。她在愚人眾那些年，我們一度關係良好，相處愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161905
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161905,
					"content": "只是後來突然有一天，她不再願意參與任何實驗。我至今都不明白，是什麼事讓她不高興？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161906
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161906,
					"content": "多令人惋惜啊，我本可以有一個妹妹、一個家人的。她竟然不怎麼喜歡我了，唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161907
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161907,
					"content": "你不配成為她的家人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161908
					]
				},
				{
					"id": 60161908,
					"content": "這我倒不否認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161909
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161909,
					"content": "那麼多人熱衷於扮演這陳舊的戲碼，世界真是太迂腐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161910
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161910,
					"content": "#還有{F#妳}{M#你}，本來也可以走向正確答案的。想到要這樣殺了{F#妳}{M#你}…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161911
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161911,
					"content": "#但我向來具備誠意，再給{F#妳}{M#你}一次機會吧。要不要與我合作？在我數到十之前，做出決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161912
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161912,
					"content": "一、二、三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161913
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161913,
					"content": "（別開玩笑了！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161914
					]
				},
				{
					"id": 60161914,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161915
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161915,
					"content": "桑多涅？真難得，妳居然也跑到這麼高的地方來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161916
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161916,
					"content": "做事風格依然那麼倒胃口呢。可別以為人人都要感謝你給的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161944
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161944,
					"content": "（桑多涅？可是現在術式的進度還沒完成…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161917
					]
				},
				{
					"id": 60161917,
					"content": "#來得真巧。我原本在和{NICKNAME}談合作，看見妳，我必須得說，真是太浪費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161918
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161918,
					"content": "浪費？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161919
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161919,
					"content": "我說過，會平等地給所有人一次機會。但妳主動送上門來…那就是浪費了一次機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161920
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161920,
					"content": "哈！騙誰呢，以為我會信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161921
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161921,
					"content": "原本還想著解決完上面的事再慢慢處理妳那個術式，也好，辛苦妳特地上來，幫我省了不少力氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161922
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161922,
					"content": "CS",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60161923
					]
				},
				{
					"id": 60161923,
					"content": "桑多涅——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161924
					]
				},
				{
					"id": 60161924,
					"content": "#{F#妳}{M#你}看，機械造物是如此脆弱，輕輕一弄…就碎掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161925
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161925,
					"content": "不論桑多涅再怎麼醉心發明，她一死，存在於她體內的術式也會停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161926
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161926,
					"content": "當然，能堅持到現在也值得誇獎了。同事一場，我有能力欣賞她頑固的態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161927
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161927,
					"content": "#{F#妳}{M#你}，到這裡來。在我身旁找個位置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161928
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161928,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161929
					]
				},
				{
					"id": 60161929,
					"content": "#剛才，計數被打斷了。但我破例給出的第二次機會還在，{F#妳}{M#你}依然可以趁現在加入我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161930
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161930,
					"content": "#{F#妳}{M#你}分明已經理解這力量與權能，為什麼不願意邁向更完美的可能性？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161931
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161931,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161932
					]
				},
				{
					"id": 60161932,
					"content": "#不想跟我說話？好吧，今天的{F#妳}{M#你}和平時不太一樣，話變少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161933
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161933,
					"content": "那聊點實在的吧。就以桑多涅作為話題好了，她以前就這樣，從不真正相信別人，也很不喜歡分享研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161934
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161934,
					"content": "嚴格來說，她並非毫無長處，能從無數的資訊中提煉並改善出如今這個世界式，當真不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161935
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161935,
					"content": "#但她總是不願給出信任。要是能將術式交給別人來看護或執行，{F#妳}{M#你}們說不定還有一絲勝算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161936
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161936,
					"content": "擊敗頑固而笨拙的人，真令人痛心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161937
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161937,
					"content": "…多托雷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161938
					]
				},
				{
					"id": 60161938,
					"content": "你大概從沒想過，人是會變的吧？哥倫比婭逃離那次也是，桑多涅這次也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161939
					]
				},
				{
					"id": 60161939,
					"content": "變？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161940
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161940,
					"content": "任你擺出何種姿態，我都能感覺到，你才是信不過別人的那種人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161941
					]
				},
				{
					"id": 60161941,
					"content": "#在{F#妳}{M#你}看來，我是那樣的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161942
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				},
				{
					"id": 60161942,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161943
					]
				},
				{
					"id": 60161943,
					"content": "#現在的{F#妳}{M#你}，還能做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "贗月的異端者"
				}
			]
		}
	]
