			"dialogs": [
				{
					"id": 60160301,
					"content": "#{NICKNAME}、派蒙，很高興見到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160302
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160302,
					"content": "菲林斯！你這邊準備得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160303,
					"content": "還不錯，我已經做好正面迎戰多托雷的準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160304
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160304,
					"content": "哦哦，這一次看起來比平時還認真一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160305,
					"content": "說真的，我平時不怎麼喜歡全力以赴——那不利於隱藏身分，對吧？再說，一個人應當有選擇地展露實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160306
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160306,
					"content": "養精蓄銳，更好地贏下關鍵之戰。目前我正處於這個狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160307
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160307,
					"content": "#能看到你認真，心裡都踏實了幾分，對吧{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160308,
						60160309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160308,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				},
				{
					"id": 60160310,
					"content": "能得到兩位的信任，我很榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160311
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160311,
					"content": "#還請好好休息。我衷心希望，能在決戰中見到精神抖擻的{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160309,
					"content": "感覺很安心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				}
			]
		},
