			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「木偶」"
				],
				"points": [
					{
						"sceneId": 20321,
						"position": [
							1677.129,
							236.029,
							9524.242
						],
						"pointId": 12
					},
					{
						"sceneId": 20321,
						"position": [
							1630.833,
							238.252,
							9528.693
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 60160201,
					"content": "#喔，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160202
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160202,
					"content": "桑多涅！進度怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160203,
					"content": "#{F#妳}{M#你}們將成為第一、第二個見到我得意之作的人…或者飄浮靈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160204,
					"content": "喂！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160205,
					"content": "不管了。來，都不許眨眼，仔細地看清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160206
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160206,
					"content": "哇，是個從來沒見過的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160207,
					"content": "看起來很不得了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160208
					]
				},
				{
					"id": 60160208,
					"content": "這個計程儀直觀表現了「術式」的進展。目前，它還在建構最重要的連結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160209
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160209,
					"content": "#程序完成時，我會將它送到{F#妳}{M#你}身邊。這樣才能迎回哥倫比婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160210
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160210,
					"content": "送到身邊？如果只是計算結果的話，直接用通訊儀告訴我們不就行了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160211,
					"content": "…嘖。妳這小東西還真是沒見過世面。這不是簡簡單單的「算式」，而是能夠建構某種規則的「術式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160212
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160212,
					"content": "#…算了，說多了{F#妳}{M#你}們也不明白，總之只要知道它是哥倫比婭回來所需的必要條件就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160213
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160213,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160214
					]
				},
				{
					"id": 60160214,
					"content": "#我把這些資料分享給{F#妳}{M#你}。尼可同意我使用她建構的訊息通道，所以可以透過嘟嘟通訊儀，像這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160215
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160215,
					"content": "#好了，現在{F#妳}{M#你}也可以查看程序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160216
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160216,
					"content": "真的有欸！妳好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160217,
					"content": "廢話，我一直很厲害，哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160218
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160218,
					"content": "#嗯，我需要交代給{F#妳}{M#你}的就這些。接下來要是有空，也去看看其他人，監督一下他們，別讓任何人出差錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160219
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160219,
					"content": "在愚人眾，這類監督不屬於苛責的範疇。我只是希望一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160220
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160220,
					"content": "#目前術式還在運轉，我不方便移動，{F#妳}{M#你}就作為我的第二雙眼睛，去完成使命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
