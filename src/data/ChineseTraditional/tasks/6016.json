				]
			},
			"dialogs": [
				{
					"id": 60161501,
					"content": "看起來，你們這兩天過得還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161502
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161502,
					"content": "多托雷！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161503
					]
				},
				{
					"id": 60161503,
					"content": "從我的角度，這絕對是件好事。實驗對象若是過早死亡，我的期待自然只能落空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161504
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161504,
					"content": "因此，我要感謝你們的頑強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161505
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161505,
					"content": "雖說我們雙方早已不在同一個層級，但該有的敬意我仍會給。造物主應有仁慈與禮貌，我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161506
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161506,
					"content": "而在終結你們之前，世界應當被告知，我已降臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」"
				}
			]
		},
		{
