						],
						"stepId": 2010301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾拉·馬斯克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "#又見面啦，{F#妳}{M#你}還記得我嗎？忘了的話…{F#妳}{M#你}總記得上次我們和丘丘人進行的那些「友好交流」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030102,
					"content": "唔，別這麼看著我嘛，語言學習這種事情，就是要不斷的練習才行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030103,
					"content": "#{F#妳}{M#你}放心，我可沒有讓{F#妳}{M#你}的努力白費，上次回來之後，我的丘丘人語口語水準已經有了很大的提升…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030104,
					"content": "但是口語水準是提升了，書寫水準也不能落下呀。所以，在經過嚴謹研究之後…我用丘丘人語完全原創了幾首詩歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030105,
					"content": "#不過…這些詩歌裡面，還有幾句我沒辦法確定意義，{F#妳}{M#你}能幫我去「查證」一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030106,
					"content": "…「查證」的意思是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "當，當然就是去念給丘丘人聽，看看它做什麼反應啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030108,
					"content": "不過，別擔心！那些具體意義存疑的單句，我都<color=#00E1FFFF>做了標註</color>，意義應該偏差不了太遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030109,
					"content": "#我已經挑好了目標，那幾位丘丘人看上去脾氣很好，{F#妳}{M#你}就把那幾句單句念給它們聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030110,
					"content": "#那就拜託{F#妳}{M#你}了！把我寫的詩念給丘丘人聽之後，再回來告訴我詳細情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030111,
					"content": "…又要去念給丘丘人聽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "#對啊，{F#妳}{M#你}看{F#妳}{M#你}已經很熟練了嘛。別擔心啦，那些具體意義存疑的單句，我都<color=#00E1FFFF>做了標註</color>，意義應該差不了太遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030113,
					"content": "#我已經挑好了目標，那幾位丘丘人看上去脾氣很好，{F#妳}{M#你}就把那幾句單句念給它們聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030114,
					"content": "#那就拜託{F#妳}{M#你}了！把我寫的詩念給丘丘人聽之後，再回來告訴我詳細情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 201030115,
					"content": "如，如果有什麼意外的話，我相信你們應該處理得好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				}
