					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "#效果怎麼樣？看{F#妳}{M#你}這幅樣子，想必效果很不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
