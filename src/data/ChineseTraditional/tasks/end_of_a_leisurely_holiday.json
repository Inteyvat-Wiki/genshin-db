			"dialogs": [
				{
					"id": 765100101,
					"content": "這下總可以證明這不是什麼秘密軍事武器了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100102,
					"content": "唔，沒錯，設計得再難一點就不算是扮家家酒了，加油。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100103,
					"content": "哇！又是一樣可怕的氣氛，緊張得像是要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100104,
					"content": "馬上打起來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#是啊…趁{NICKNAME}也在，不如現在，我們公平地切磋切磋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100106,
					"content": "唉，真不知道妳哪來的執念——不會是因為上次隨隨便便被我打敗了吧！如果是這個原因，那就切磋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}，您就看好了，看看誰先認輸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100108,
					"content": "哼，光會說大話是沒用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100109,
					"content": "埃德勒看起來更有力氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100113,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "嗚哇哇！她們不是只是切磋一下嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100115,
					"content": "妳現在認輸還來得及，我會給妳三秒鐘的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100116,
					"content": "三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100117,
					"content": "哇嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100118,
					"content": "一聲金屬的「喀噠」脆響後，一切都歸於平靜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "好了，小派蒙，可以睜眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100120,
					"content": "看來，全場最緊張的人在這裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100121,
					"content": "什、什麼？維斯菈娃居然是好好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100122,
					"content": "埃德勒在嚇唬維斯菈娃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "是啊，我才不想出來一趟，還被關到外地的監獄裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100125,
					"content": "只好強裝大膽，虛張聲勢，好讓她看看，我不是那種可以隨意玩弄的懦弱行商。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100126,
					"content": "這樣下次見面，她就不敢隨隨便便找我麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100127,
					"content": "#可是，{NICKNAME}{F#妳}{M#你}又是怎麼看出來的！我看{F#妳}{M#你}完全不緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765100128,
					"content": "埃德勒的表情看起來很放鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "您真敏銳。恐嚇的確是最快讓人認輸的辦法，可惜，走捷徑總歸是沒那麼容易的，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100131,
					"content": "#更何況，{NICKNAME}還在這裡啊…總之，現在我還好好地站著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100132,
					"content": "只是下次遇見的時候，希望有機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "維斯菈娃"
				},
				{
					"id": 765100133,
					"content": "千萬不要，小的才沒有這麼多機會和您這位大人相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100134,
					"content": "如果下次碰面在妳的執勤期內，妳要對我做些什麼，我也只好正當防衛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100135,
					"content": "若又在妳的休假期內碰上了，那還是來盤兵棋推演算了，就當是照顧照顧我的生意好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765100129,
					"content": "埃德勒說了，是看「誰先認輸」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "銃槍裡沒有子彈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "維斯菈娃看起來更高大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}