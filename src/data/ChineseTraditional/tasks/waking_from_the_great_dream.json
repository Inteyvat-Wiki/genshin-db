							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "我…感受到了「理性」。到來之人，汝等是水仙十字的後繼者，還是齒輪的鷹犬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650102,
					"content": "對我拔劍相向了。看來答案不言自明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650103,
					"content": "納齊森科魯茲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650104,
					"content": "欸？這個東西就是納齊森科魯茲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650105,
					"content": "既然已聽聞我名，那汝等自當理解我救世之道義。既已聽聞我名，爾等意識之內便有得救的種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650106,
					"content": "想來爾等對我兵鋒相向，應該是被謊言所欺騙。如此時機，我也不想浪費太多力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650107,
					"content": "欣喜吧！喝彩吧！在一切結束之後我來解答，我來展現。現在把聖劍歸還到我的手中，然後離開避難吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650108,
					"content": "才不能把聖劍給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650109,
					"content": "愚蠢啊愚蠢！但是我原諒爾等，就算如此我也會拯救爾等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650110,
					"content": "我感覺到了，四象限雖然得以逆轉，但是湧流之樹的全圖並沒有完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650111,
					"content": "已經沒有辦法拯救所有人了。我將最大程度延展我的慈悲，透支我的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650112,
					"content": "如果只能救五成的人，我就盡力去救下六成的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650113,
					"content": "現在，我要來取聖劍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納齊森科魯茲"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
