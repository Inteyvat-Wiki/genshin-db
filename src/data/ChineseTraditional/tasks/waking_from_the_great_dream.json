				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納齊森科魯茲",
					"安"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "不可能…我明明已經登達了「不退還」之位階。為什麼，跌落到了如此境界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650202,
					"content": "對原始胎海的掌控也徹底喪失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650203,
					"content": "為什麼…為什麼會這樣？為什麼…為什麼你們要這麼做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650204,
					"content": "新世界無法誕生，所有人都要在蛋殼之夢裡死去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650205,
					"content": "你才是早點從自己的夢裡醒過來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650206,
					"content": "世界末日這種事，當然是全世界的人一起想辦法解決的事情啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650207,
					"content": "我明白了，是聖劍。它沒有站在我這邊。它每一次揮動都切削了圍聚在我周身的眾生意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650208,
					"content": "直到最後，我懦弱的凡人性——我的人格也回到了我的體內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650209,
					"content": "胎海泛濫並沒有那麼快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "我已經有所察覺，最早填入「世界式」的輸入值出現了變動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650211,
					"content": "有誰掌控了生命之力，又有什麼人開辟了獸之國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650212,
					"content": "#還有一個「變量」，那就是{F#妳}{M#你}啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650213,
					"content": "註定見證吞食一切之鯨敗走的人，一切的見證者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650214,
					"content": "原來是這樣…原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650221,
					"content": "#我也做過這樣的夢，想要成為{F#妳}{M#你}這樣的事物。不過這個夢，剛剛破碎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650222,
					"content": "我所做的一切都毫無意義，就像是一個空虛的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650223,
					"content": "#不，甚至不如一個夢。至少夢是無害的，而我…不，{F#妳}{M#你}們，還有他們卻為這件事付出了那麼多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650224,
					"content": "納齊森科魯茲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650225,
					"content": "啊！是妳。我都沒有發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650226,
					"content": "你能知道我究竟是誰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650227,
					"content": "名字只是一個稱呼。混在妳靈魂裡的兩種顏色，我都是再熟悉不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650228,
					"content": "莉利絲院長不知道發生了什麼，她只是抱住了一息尚存的瑪麗安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650229,
					"content": "她理解不了過於複雜的當下與未來，只是想要留住過去。於是她做了她唯一會做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650230,
					"content": "我叫做安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650231,
					"content": "那麼，妳好，安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650232,
					"content": "我願意原諒你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650233,
					"content": "妳在說什麼奇怪的話。從一開始我的規劃就有著崇高與神聖的目的。這中間沒有私心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650234,
					"content": "沒有人能評價我，沒有人能審判我，沒有人能原諒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650235,
					"content": "你的目的或許是崇高的，但是你的瘋狂傷害了很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650236,
					"content": "你連算式的輸入都沒填對。犯錯然後被原諒，有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650237,
					"content": "…妳說得對。我很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650238,
					"content": "然後納齊森科魯茲，你和我們回去吧。你需要見一見其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650239,
					"content": "雖然這傢伙好像變得很好說話了，但是這種要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650240,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650241,
					"content": "欸！一般不是要做點心理鬥爭然後讓我們勸個半天的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650242,
					"content": "正如我之前所說，我並未覺得自己有任何負罪。如今偉業惜潰，但是世界已然得救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650243,
					"content": "任由他人責罵與嘲笑我吧。我的內心已經空落，徒餘一種渴望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650244,
					"content": "是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650245,
					"content": "我也想回到最開始的時候。水仙的勇者還沒有踏上旅程的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650246,
					"content": "不過這已經辦不到了。決定人命運的終究不是人自己，如今我連讓自己做什麼夢的力量也失去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650247,
					"content": "#那，{NICKNAME}騎士，準備好之後，我們就去重新封印胎海然後離開這裡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741650215,
					"content": "那條鯨已經被打敗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "我本該有所察覺，最早填入「世界式」的輸入值出現了變動。有「變量」降臨此間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650217,
					"content": "並非是所有宇宙外到來的事物都能被叫做「降臨」或者「變量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650218,
					"content": "#原來我少算了一個「變量」，那就是{F#妳}{M#你}啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650219,
					"content": "一切的見證者，一切的記錄者，一切的設計者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "納齊森科魯茲"
				},
				{
					"id": 741650220,
					"content": "唯有自身等價一個世界的人才能擔此頭銜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "納齊森科魯茲"
				}
			]
		},
