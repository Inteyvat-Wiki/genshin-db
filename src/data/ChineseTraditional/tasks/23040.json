				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "#旅行者，{F#妳}{M#你}拿到那些貨物了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400702,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "#太好了，就把貨物放在那裡吧，多謝{F#妳}{M#你}幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400704,
					"content": "哈巴奇先生已經去倉庫裡面清點其他貨物了，這些食物就由我先看著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400705,
					"content": "唉，希望這批食物沒有損失太多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				}
			]
		},
