				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#旅行者！{F#妳}{M#你}來得正好，請{F#妳}{M#你}快去幫幫哈巴奇先生吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400802,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "唉，有一批貨物在村外被盜寶團截住，能出動的守衛都已經出去支援了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400805,
					"content": "哈巴奇說人手還是太少，所以他自己也抓著武器出了村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400806,
					"content": "但聽說那群盜寶團人數很多，哈巴奇先生一個人說不定對付不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400807,
					"content": "#旅行者，我把他要去的地方標在{F#妳}{M#你}的地圖上，請{F#妳}{M#你}快去幫幫他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400808,
					"content": "我立刻出發。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "#拜託{F#妳}{M#你}了旅行者，希望哈巴奇先生不要出事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400810,
					"content": "他的武藝怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "對付一兩個盜寶團，對於哈巴奇先生來說應該不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400812,
					"content": "但聽說這次是有一整支盜寶團埋伏了運貨隊，要不是運貨隊裡有個跑步快的人跑回村裡報信，也許都沒人能知道運貨隊被襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400813,
					"content": "唉，要是坎蒂絲小姐沒有外出的話，那些盜寶團一定不敢來亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400814,
					"content": "他們一定是看準了空檔，才敢突然動手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400815,
					"content": "#旅行者，拜託{F#妳}{M#你}了，請快去幫幫哈巴奇先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400803,
					"content": "妳怎麼這麼緊張？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
