			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納傑特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "#怎麼樣，{F#妳}{M#你}把那些赤鷲都解決掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400402,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "#太感謝{F#妳}{M#你}了，這樣哈巴奇先生總算能正常吃一頓飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400405,
					"content": "#對了，這些報酬給{F#妳}{M#你}，請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400406,
					"content": "唔，今天還要入庫什麼貨物來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400403,
					"content": "牠們應該會安分一段時間了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
