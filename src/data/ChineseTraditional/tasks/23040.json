			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納傑特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "唉…這些赤鷲，真是沒完沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400202,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#{F#妳}{M#你}是…旅行者，對吧？我聽奧貝德那孩子提起過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400204,
					"content": "呵呵，居然會有旅行者造訪我們這村子，我倒是真沒想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400205,
					"content": "#喔，{F#妳}{M#你}見過哈巴奇了嗎？他一直都很嚴肅…要是他和{F#妳}{M#你}說話時態度有點凶，還請{F#妳}{M#你}理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400206,
					"content": "畢竟…我們村的許多物資都放在這個倉庫裡，不僅是糧食，還有衣物、武器，甚至一些財貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400207,
					"content": "村子裡就那麼些年輕人，既要守衛村子，又要幫村子裡的人處理各種事…一直都只有哈巴奇一個人守著倉庫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400208,
					"content": "我這裡除了記帳和清點之外，也幫不上什麼忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400209,
					"content": "你剛才說赤鷲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "唉，別提了，前段時間剛有一批乾肉運進了倉庫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400211,
					"content": "不知道是哪裡漏出了氣味，沒多久就有幾隻赤鷲飛過來，停在倉庫旁邊的山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400212,
					"content": "牠們沒法啄走倉庫裡的乾肉，但只要有人在牠們面前吃飯，這群赤鷲就會突然飛下來發動襲擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400213,
					"content": "村子裡的守衛沒空去解決牠們，哈巴奇先生也暫時沒空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400214,
					"content": "#旅行者，如果{F#妳}{M#你}有空的話，能幫我們去解決掉那些赤鷲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400215,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "#那就拜託{F#妳}{M#你}了，那些赤鷲很凶猛，最好不要靠近…如果{F#妳}{M#你}會用弓箭的話，應該能安全地解決掉牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400217,
					"content": "牠們襲擊過什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "路過的貨物、晾曬的乾肉，還有哈巴奇先生的便當…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400219,
					"content": "哈巴奇先生在站哨中吃飯時，習慣把菜放在一旁，那群赤鷲經常看準這個機會，飛下來把肉全都叼走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400220,
					"content": "因為還要站哨，他也不能去教訓赤鷲，只能看著牠們飛走，然後就著剩下的菜趕緊把飯吃完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400221,
					"content": "#拜託{F#妳}{M#你}了，旅行者，快去把那些赤鷲都解決掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				}
			]
		},
