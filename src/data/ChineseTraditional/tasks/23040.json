			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納傑特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "唉，哈巴奇先生什麼時候才能稍微休息一下呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400502,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "#旅行者，{F#妳}{M#你}來得正好，請{F#妳}{M#你}幫我們一個忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400504,
					"content": "剛才有一批風乾的食物從外面送進村裡，哈巴奇先生準備去把它們接入倉庫裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400505,
					"content": "但一群赤鷲聞到了食物的氣味，突然成群結隊地衝了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400506,
					"content": "雖然其他守衛很快趕過來打跑了這些赤鷲，但那批風乾的食物也被赤鷲們啄得到處都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400507,
					"content": "#其他人已經去警告其他運貨的隊伍了，哈巴奇先生也忙著去回收還完好的食物…旅行者，{F#妳}{M#你}能幫幫我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400508,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "#那就拜託{F#妳}{M#你}了，真是不好意思，我等等還要去幫忙接收貨物，實在是忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400510,
					"content": "哈巴奇先生還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "唉，我讓他休息一下他也不肯，說搜集完食物之後，還要再清點一遍倉庫，這樣下去，他的身體怎麼撐得住啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "納傑特"
				},
				{
					"id": 230400512,
					"content": "#那些貨物應該就在白之梯附近。旅行者，請{F#妳}{M#你}幫我們回收一下那些貨物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納傑特"
				}
			]
		},
