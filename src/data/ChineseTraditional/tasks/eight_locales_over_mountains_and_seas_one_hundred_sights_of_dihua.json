			"dialogs": [
				{
					"id": 722620201,
					"content": "拍好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620202,
					"content": "接下來的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620203,
					"content": "嗯，就這麼辦吧！吉法師，釣過魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620204,
					"content": "釣魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620205,
					"content": "看來沒試過呢！走，我們到水邊去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620206,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				}
			]
		},
		{
			"id": 7226203,
