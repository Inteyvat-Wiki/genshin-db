				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "哇。這裡的大海，漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620102,
					"content": "欸？荻花洲不是大海啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620103,
					"content": "但荻花洲的水域確實和海連在一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "嗯，說得也是…不過，如果要說荻花洲是海，感覺還是不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620105,
					"content": "呶…不是很明白。「大海」和「不是大海」，區別是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620106,
					"content": "水的味道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "喔！森林的溪水有點甜味，所以不是海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620108,
					"content": "但是，如果果酒湖裡都是果酒的話，應該算什麼呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620109,
					"content": "那樣的話溫迪會很快樂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "不過，這個問題先放一邊，吉法師是不是越來越會說話了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620121,
					"content": "按照之前五百藏的說法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "五百藏說了什麼來著？「吾輩乃是名震天下的妖狸」…不對，不是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620124,
					"content": "「想撓肚皮，嗚呶呶。」…「咿！」…也不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620125,
					"content": "呶哈哈，派蒙學得好像。好好笑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620126,
					"content": "「適應吉法師的氣息…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "啊，對哦！我們越適應吉法師的氣息，就越能理解吉法師的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620128,
					"content": "#還有修行呶！和{NICKNAME}、派蒙一起，吉法師學會了好多好多事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620129,
					"content": "派蒙可是個好嚮導呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620131,
					"content": "#那麼久以前的事，{NICKNAME}還記得呀。好開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620132,
					"content": "#嗯！謝謝派蒙和{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620136,
					"content": "這裡的「不知道算不算大海」很漂亮，後面還有好高好高的漂亮房子。幫吉法師拍照？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620137,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "一起冒險的伙伴，能一起成長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "嗯！伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620135,
					"content": "最好的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620122,
					"content": "出發前，五百藏好像說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "陸地主體之外的大型水域是海？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "哇，聽起來好嚴謹的答案！但是，這樣的話，問題又回到了「分界」上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME}剛剛說，荻花洲的水和大海連在一起。那「陸地煮煮」和不是「陸地煮煮」，區別又是什麼哩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620113,
					"content": "…雖然聽起來嚴謹，卻沒有解決任何問題呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620114,
					"content": "這些概念都是人強加的。沒有意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "荻花洲覺得自己是大海，就是大海。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "吉法師覺得自己是仙人，就是仙人呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620117,
					"content": "#喂！吉法師別聽{F#她}{M#他}的。{NICKNAME}，{F#妳}{M#你}在說什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620118,
					"content": "…不過，雖然是歪理，也不是完全沒道理啦。吉法師想成為什麼樣的妖狸，就能成為什麼樣的妖狸！說不定未來能變成仙狸呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620119,
					"content": "仙狸！耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "「吉法師」"
				}
			]
		},
