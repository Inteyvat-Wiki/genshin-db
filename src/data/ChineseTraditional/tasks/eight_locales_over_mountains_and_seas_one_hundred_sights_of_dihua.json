					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "嗚呶呶…為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620302,
					"content": "吉法師真是的！怎麼就衝進丘丘人的據點裡了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620303,
					"content": "本來以為…能和丘丘人一起玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620304,
					"content": "欸？為什麼這麼想？丘丘人是很危險的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620305,
					"content": "噗，丘丘人也沒有很危險啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "#喂！吉法師可不是像{F#妳}{M#你}這樣身經百戰的旅行者啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620309,
					"content": "在鎮守之森第一次見面的時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "對呀，當時吉法師不是被丘丘人包圍著，變成了什麼東西躲起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620311,
					"content": "#剛剛見到{F#妳}{M#你}們的時候…我想想…我想想…啊，對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620312,
					"content": "那時候，是在和丘丘人捉迷藏。森林裡的丘丘人，是不會攻擊妖狸的。而且，經常陪我們玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620313,
					"content": "欸？是形成了什麼和諧共生的關係嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620314,
					"content": "不知道為什麼，這裡的丘丘人會這樣。嗚呶呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620315,
					"content": "總之，在外面要多加小心啦！即使是丘丘人…不對，應該說，正因為是丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620316,
					"content": "#嗚哇，好複雜…{NICKNAME}，{F#妳}{M#你}來幫我說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620317,
					"content": "要學會分辨好人和壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "嗯！這樣才能在外面，保護好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620319,
					"content": "但是也不要忘了善良和開放的心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "嗯嗯，沒錯！這樣才能容納美好的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620321,
					"content": "呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME}和派蒙說得好複雜，吉法師聽不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620323,
					"content": "#但是，吉法師知道，{F#妳}{M#你}們是好人。所以，吉法師要學{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620324,
					"content": "#好啦，不說這個了。先跟{NICKNAME}學習釣魚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "派蒙"
				},
