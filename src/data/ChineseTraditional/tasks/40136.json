			"dialogs": [
				{
					"id": 401360201,
					"content": "…押送程序結束。他們三個，接下來就交給你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360202,
					"content": "看樣子後邊還有別的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360203,
					"content": "嗯…得去趕一場派對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360204,
					"content": "真少見，在培養新愛好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360205,
					"content": "只是這場比較特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360206,
					"content": "夏沃蕾、公爵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360207,
					"content": "過節就是好，連我這裡都變熱鬧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360208,
					"content": "這就是千靈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360209,
					"content": "是啊…護士長甚至準備了豪華版營養奶昔…健康程度也是豪華版的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360210,
					"content": "你們剛才在聊工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360211,
					"content": "已經聊完了。我也向萊歐斯利先生打了「招呼」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360212,
					"content": "我沒有明確回應哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360213,
					"content": "但你也沒拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360214,
					"content": "我有個好主意，為他們每人發一份報紙吧…比如，一份頭版印著一段二十年前往事的報紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360215,
					"content": "那我猜有一個人要倒楣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360216,
					"content": "我猜有兩個人要被當成英雄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360217,
					"content": "#說到英雄，{F#妳}{M#你}們兩位是有什麼事要找我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "萊歐斯利"
				},
				{
					"id": 401360218,
					"content": "哦…我們是來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360219,
					"content": "來邀請我去派對的，對吧？我可是沒忘記今天是什麼日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360220,
					"content": "嘿嘿…那我們趕快回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360221,
					"content": "公爵再見！千靈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360222,
					"content": "嗯…節日快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊歐斯利"
				}
			]
		},
