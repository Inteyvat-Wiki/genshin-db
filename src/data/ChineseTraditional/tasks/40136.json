			"dialogs": [
				{
					"id": 401360101,
					"content": "自那之後又過了一陣子…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "澤維爾！有一段時間沒見到你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360104,
					"content": "兩位好，這不是因為剪輯完成之後，我又開始著手於宣傳與放映的工作了，實在忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360105,
					"content": "今天就是頒獎的日子了吧？也不知道我們的映影能不能奪得「芙寧娜獎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360106,
					"content": "我倒是有九成的把握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360107,
					"content": "芙寧娜！原來妳已經到現場了呀…來得比其他人都早呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360108,
					"content": "其他人應該也很快就到。對了，澤維爾，說到領獎，你是不是該為我們的團隊取個名字呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360109,
					"content": "啊？但我還不知道能不能得獎…我、我不敢做這種提前打開美酒的事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360110,
					"content": "睜大眼睛，看看人們離開劇場的反應吧！沒有一個不叫好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360111,
					"content": "你自己也知道吧？劇場的工作人員一定找過你，說要增加這部映影的放映次數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360112,
					"content": "這次的票房回報，都夠你開一家正經的映影公司了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360113,
					"content": "但這不是我一個人的功勞！是諸位好先生與好女士們共同的心血，絕不能由我一個人來取這個名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360114,
					"content": "總之你就好好想想吧，我相信大家會同意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360115,
					"content": "#好吧…但在那之前，{NICKNAME}和派蒙，可以麻煩您兩位去一趟梅洛彼得堡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360116,
					"content": "咦？可是不是還有頒獎典禮嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360117,
					"content": "我想請兩位去找我們的女主角之一，夏沃蕾小姐來這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360118,
					"content": "我最近都見不到她，也沒機會通知她來參加今天的頒獎典禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360119,
					"content": "但報紙上說，銃槍殺人案的犯人今天會由特巡隊隊長親自押送至梅洛彼得堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360120,
					"content": "哦…原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360121,
					"content": "舉手之勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "嗯！澤維爾在這裡等著就好，努力想出個好聽的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360123,
					"content": "好，拜託兩位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				}
			]
		},
