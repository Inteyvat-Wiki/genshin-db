						"sceneId": 3,
						"position": [
							3430.616,
							449.586,
							4454.762
						],
						"pointId": 340100503
					}
				]
			},
			"dialogs": [
				{
					"id": 401360301,
					"content": "我宣布，獲得首屆千靈映影節「芙寧娜」獎的影片是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "會場主持人"
				},
				{
					"id": 401360302,
					"content": "《兩個銃槍手》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "會場主持人"
				},
				{
					"id": 401360303,
					"content": "是我們耶！真的是我們耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360304,
					"content": "恭喜你，澤維爾先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360305,
					"content": "天哪！我…我…真是太謝謝各位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360306,
					"content": "我對楓丹娛樂界的判斷從不出錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360307,
					"content": "現在有請《兩個銃槍手》的製片人，澤維爾先生，上臺領獎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "會場主持人"
				},
				{
					"id": 401360308,
					"content": "謝謝…非常感謝大家對我們影片的認可。我在此，要特別感謝——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360309,
					"content": "時間過得真快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360310,
					"content": "嗯…就好像夏沃蕾妳教我握槍只是幾天前的事一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360311,
					"content": "還會來楓丹嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360312,
					"content": "當然！我喜歡這個城市，新奇的東西看都看不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360313,
					"content": "夏沃蕾會來稻妻嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360314,
					"content": "…以前從沒有過這個打算。不過，現在可以考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360315,
					"content": "我期待妳的到來。到時候，還想邀請妳來家裡做客，讓妳嚐嚐我們家的茶點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360316,
					"content": "嗯…保持聯絡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360317,
					"content": "如你所願？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360318,
					"content": "妳也該回稻妻看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360319,
					"content": "「小倉屋」怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360320,
					"content": "一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360321,
					"content": "代我向她問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360322,
					"content": "我會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360323,
					"content": "聽說島上不下雷暴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360324,
					"content": "也不打仗了。和平安治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360325,
					"content": "聽起來真好，是適合曬布料的天氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360326,
					"content": "——再次感謝我提到的所有人。是你們帶我走上了領獎臺，是你們鑄就了這部映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360327,
					"content": "另外，經過團隊成員的一致認可，我正式將澤維爾劇組，命名為「銃槍影業」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360328,
					"content": "嘿嘿…這麼喊出來還真帥氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360329,
					"content": "那麼，下面就有請「銃槍影業」的所有成員，上臺合影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "會場主持人"
				},
				{
					"id": 401360330,
					"content": "哦！還有合影環節！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401360331,
					"content": "芙寧娜導演，我認為，妳才是應該舉起這個獎盃的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 401360332,
					"content": "欸？不…不要啦…好丟臉的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 401360333,
					"content": "沒人比導演您更適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 401360334,
					"content": "當之無愧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360335,
					"content": "非妳莫屬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "妳就認命吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360337,
					"content": "準備好了嗎？三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "會場主持人"
				},
				{
					"id": 401360338,
					"content": "銃槍影業！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
