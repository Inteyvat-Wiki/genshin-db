			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"莫娜",
					"楓原萬葉",
					"菲謝爾",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "哇，又出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400750802,
					"content": "莫娜，那個冒險家…真的死了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750803,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750804,
					"content": "我只見過他一次。至今有三年多，所以…他應該已經不在人世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750805,
					"content": "可是，就沒有一點他還活著，只是你算錯的可能嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400750806,
					"content": "可是那樣不公平吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "遇到壞事就全然拒絕，遇到好事就深信不疑。這樣的事，不能被稱為占卜，只能算是自我安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750808,
					"content": "作為日常娛樂當然沒關係啦，但我學的是一門沒有謊言的學問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750809,
					"content": "否定我自己的結論，是在褻瀆占星術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750810,
					"content": "殘酷，但也真實。命運確實是這樣的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400750811,
					"content": "平時我可不說這種話，但既然提到了，還是希望大家別把占星術跟街邊小攤小販的那些抽籤活動混為一談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750812,
					"content": "我們研究星象，絕不是為了讓誰聽了奉承高興一整天。占星術士，是為了驗證真實，見證世界之理而存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750814,
					"content": "啊——！所以我說，占星術士就是個招人討厭的職業啊！很偉大跟惹人厭完全不衝突嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750815,
					"content": "為何突然這般吵鬧？汝也不是那麼不值得結交的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400750816,
					"content": "小姐的意思是，很高興和您成為朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400750817,
					"content": "不是啦！我沒那麼說吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400750818,
					"content": "奧茲，你怎麼回事？愈來愈喜歡假傳我的旨意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400750819,
					"content": "哎呀哎呀，為什麼呢，難道是我太擔心小姐得罪好朋友，特意時時刻刻挽回嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400750820,
					"content": "我見識沒那麼廣，只認識妳一個占星術士，不過你給我的感覺很好哦，完全不討人厭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750821,
					"content": "隨便向別人打聽秘密，又把不喜歡的結果隨手丟棄，那些人自己才要反思一下，命運可不是那麼便宜的東西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750822,
					"content": "如果命運是三言兩語便能迴避的東西，人間就不會有別離之苦了。莫娜，別往心裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400750823,
					"content": "追逐本心，永不忘記正確之事，這樣足矣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400750824,
					"content": "咳咳，也…也沒必要這樣關懷我哦，我很強韌的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750825,
					"content": "那妳耳朵為什麼紅紅的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "呃、呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750827,
					"content": "…好吧，那…那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750828,
					"content": "謝謝大家…了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750829,
					"content": "聽不清楚，請大聲向本皇女獻上妳的崇敬與祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400750830,
					"content": "好了好了殿下，比起鬥嘴，您還是先去水池倒映出的新地點回收其他碎片吧。沒有那個，我們可進不去幻境啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750831,
					"content": "唯有小姐您銳利的目光才能鎖定秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400750832,
					"content": "既然如此，好吧好吧，本皇女就移駕海灘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400750833,
					"content": "走了，莫娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750834,
					"content": "哦、哦哦！來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750835,
					"content": "…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		}
	]
}