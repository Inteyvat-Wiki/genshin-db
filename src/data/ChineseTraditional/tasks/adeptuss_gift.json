				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "怎麼回事？我們怎麼來了這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630302,
					"content": "#怎麼樣？喜歡我給{F#妳}{M#你}們準備的小玩意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630303,
					"content": "茲白，妳在這裡啊！這把傘是什麼？「嗖」地一下就把我們搬到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630304,
					"content": "#看來{F#妳}{M#你}們的記性也欠佳呢，這就忘了先前與我一同乘過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630305,
					"content": "現在想起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630306,
					"content": "哦！是…是月宮的高車！難怪剛才就覺得眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630307,
					"content": "呵呵，只是我依照記憶仿製的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630308,
					"content": "#這還要多虧{NICKNAME}拿來的那枚玉節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630309,
					"content": "#噢~原來妳之前說要做一個小玩意送給{NICKNAME}，就是這個啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630310,
					"content": "#不錯，這玉節所製的高車可載著{F#妳}{M#你}們快速抵達目的地，應當能為旅途提供些許便利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630311,
					"content": "兩位嚮導，請收好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630312,
					"content": "好厲害…我還以為妳只是說說而已，沒想到這麼快就做好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630313,
					"content": "我原以為是要花上一些工夫，畢竟這玉節受損嚴重，靈氣早已散盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630314,
					"content": "但幸運的是，這裡是沉玉谷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630315,
					"content": "哦？沉玉谷怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630316,
					"content": "妳可知，我們現在所在沉玉谷何處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630317,
					"content": "呃…遺瓏埠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630318,
					"content": "呵呵，妳還不夠瞭解這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630319,
					"content": "妳我腳踏之地，其實是璃月地脈交會的關鍵節點之一，如此節點，共有八處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630320,
					"content": "生死休杜，開景驚傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "#{F#妳}{M#你}倒是比我想像中要更加熟悉此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630322,
					"content": "哦！我也想起來了，是地脈中的八門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630323,
					"content": "不錯，這裡就是其中的大吉門——生門的中央地帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630324,
					"content": "生門主生長繁榮，萬物復甦，因此，我才能在短時間內補足玉節靈氣，製出這架高車。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630325,
					"content": "哇，原來這麼管用啊？看來沉玉谷真是個風水寶地啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630326,
					"content": "嗯…這才該是你們安居樂業的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630327,
					"content": "你們…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630328,
					"content": "沒什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630329,
					"content": "#好啦，我也沒有別的事了，去忙{F#妳}{M#你}們的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630330,
					"content": "我打算在這山上再走一走，就在這裡別過吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630331,
					"content": "謝謝茲白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "#不必客氣。{F#妳}{M#你}喚醒了我，是我欠{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630333,
					"content": "主要還是鍾離的功勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "同樣的話，我也對他說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630335,
					"content": "#從他那我還得知，{F#妳}{M#你}正在行進一條漫長的旅途中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630336,
					"content": "#{F#妳}{M#你}的下一站，是那遙遠的雪國嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630337,
					"content": "是的，那裡是至冬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "至冬…雖然我不清楚那是個什麼樣的國度，但冰天雪地的路途，想必不能暢通無阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630339,
					"content": "#{NICKNAME}，往後若是需要助力，{F#妳}{M#你}知道在哪裡可以找到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "茲白"
				},
				{
					"id": 711630340,
					"content": "我會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "嗯，保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茲白"
				}
			]
		}
	]
}