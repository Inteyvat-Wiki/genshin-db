			"dialogs": [
				{
					"id": 711630201,
					"content": "茲白好像不在這裡，不是她要我們過來的嗎？跑哪裡去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630202,
					"content": "欸！這把傘有點眼熟…好像在哪裡見過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630203,
					"content": "可能是茲白的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "我也這麼覺得…不過她怎麼把傘丟在旅店門口了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630205,
					"content": "她的記性不太好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "這怎麼辦？這樣下去，總覺得有一天她會一邊吃飯，一邊忘記筷子丟到哪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630207,
					"content": "唉，我們還是快找找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630208,
					"content": "等等…這好像不是傘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "不是傘是什麼？嗯…讓我再仔細看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630210,
					"content": "嗚哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7116303,
