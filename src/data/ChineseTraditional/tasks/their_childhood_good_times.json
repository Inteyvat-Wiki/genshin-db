			"trigger": {
				"objectNames": [
					"韋呂",
					"洛薇",
					"奧雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "這次輪到我來抓人了，我一定能抓住洛薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060102,
					"content": "那可不一定。有些地方你都爬不上去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060103,
					"content": "那是…那是因為我的鞋子不適合爬，要是換雙鞋，一定能抓住妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060104,
					"content": "那我們乾脆把鞋子都脫掉好了，這樣才公平！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060105,
					"content": "好了！你們不可以光腳到處跑，這裡到處都是廢棄的零件，要是劃傷了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060106,
					"content": "是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060107,
					"content": "好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060108,
					"content": "那個…哥哥，你剛才抓我的時候，怎麼一副恍神的樣子啊？我從你面前跑過去都沒反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060109,
					"content": "咦？是這樣嗎？我剛才完全沒注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060110,
					"content": "是啊，我剛才直接繞著跑一圈耶，但你就和沒看見我一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060111,
					"content": "#但…欸？{M#大哥哥}{F#大姐姐}，您怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060112,
					"content": "洛薇怎麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "爸爸說他最近要去出差，媽媽也要出去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060114,
					"content": "剛好奧雷勒哥哥來還書，爸爸就拜託奧雷勒哥哥來照顧我，所以我就來這裡和他們一起玩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060118,
					"content": "不說這些了，繼續玩吧，這次誰來抓人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060119,
					"content": "我還以為你不太喜歡捉迷藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "這個啊，咳…因為我最近正在寫第一篇評論，需要思考一些問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060122,
					"content": "我發現…那個，在運動時我的思維會特別敏捷，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060123,
					"content": "但就是容易分心，有時候還會站在原地自言自語，怎麼叫都沒反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060124,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}陪我們玩玩吧，{F#妳}{M#你}玩捉迷藏一定比哥哥厲害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060125,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "嘿嘿，那還不一定呢，我和洛薇都是捉迷藏大師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060128,
					"content": "那就開始吧，快快快洛薇，我們去躲起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060129,
					"content": "洛薇和韋呂飛快地跑開了，奧雷勒則沉思著緩步離開…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "我不會讓你們唷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "你怎麼突然這麼想玩捉迷藏了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "你們還在玩捉迷藏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "是的。因為德勒呂叔叔正巧要去出差，杜梅阿姨也要去工作，於是他們就拜託我來照顧洛薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060117,
					"content": "所以我就帶著洛薇來這裡和我們一起玩了，希望她的裙子不會被弄得太髒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "奧雷勒"
				}
			]
		},
		{
			"id": 2400602,
