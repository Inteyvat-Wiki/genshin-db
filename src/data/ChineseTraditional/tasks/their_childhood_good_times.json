			"dialogs": [
				{
					"id": 240060301,
					"content": "不行…這一段的邏輯不通順，要從另外一個角度切入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060302,
					"content": "這麼…不對，還是不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060303,
					"content": "啊？我被找到了啊，我現在就去集合點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240060304,
					"content": "嗯…這個觀點對嗎？不對，呃…對不對呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧雷勒"
				}
			]
		},
