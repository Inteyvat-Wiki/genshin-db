			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "不知道奧雷勒哥哥能不能找到靈感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060402,
					"content": "#咦？！這個地方也能被找到嗎？{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}到底玩過多少次捉迷藏啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240060403,
					"content": "那我回集合點啦，下次一定躲得再好一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
