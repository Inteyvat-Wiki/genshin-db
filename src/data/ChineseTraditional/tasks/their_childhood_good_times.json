				"objectNames": [
					"韋呂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#還是被找到啦，{M#大哥哥}{F#大姐姐}果然還是比我厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060202,
					"content": "那我去集合點啦，希望哥哥能晚點被找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060203,
					"content": "你為什麼這麼希望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "哥哥說過呀，每次玩捉迷藏之後，他都會找到很多新想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060205,
					"content": "那些想法太多了，他每次都要蹲在地上記好久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060206,
					"content": "洛薇和我說，那些想法超級寶貴的，絕對不能打擾他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060207,
					"content": "所以我和洛薇在和哥哥玩捉迷藏的時候。如果輪到他被抓，那我們就會故意把時間拉長，等他記好了再去找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240060208,
					"content": "不過…如果輪到哥哥抓人，那我們就得等好久的時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韋呂"
				}
			]
		},
		{
