				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "唔，到底要怎麼樣才能知道茂才公和「愚人眾」有勾結呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010202,
					"content": "要有決定性的證據。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "那…直接去找他？能抓到現場最好，抓不到也能嚇唬嚇唬他，說不定就告訴我們了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010205,
					"content": "先和守衛打聽打聽吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "#那就交給{F#妳}{M#你}了！我會配合{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010203,
					"content": "如果能看到現場就好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "什麼人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010302,
					"content": "我是蒙德來的商人，與茂才公有約。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "咦？應該已經提前告知過了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010306,
					"content": "老爺今天臨時有要事，所有會面都取消了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010307,
					"content": "「要事」…是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010308,
					"content": "最近老爺在忙一筆重大的生意，早早就出門接待貴客了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010309,
					"content": "那他現在在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010310,
					"content": "抱歉，這個老爺特別叮囑了，不能透露…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010311,
					"content": "意思是我們就不是貴客了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "不不不，我沒有冒犯的意思，請不要介意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010313,
					"content": "如果不讓我見茂才公，有你好受的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "對不起，對不起！老爺現在在新月軒談生意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010316,
					"content": "還望您大人有大量，別讓老爺怪責下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010317,
					"content": "我家老爺還有要事在身，就不和你糾纏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010318,
					"content": "#你就期待{F#她}{M#他}和茂才公談完生意之後，能把你的冒犯忘掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010319,
					"content": "#太、太謝謝你們了！願{F#妳}{M#你}們的生意永遠有岩王爺庇佑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010320,
					"content": "#沒想到{NICKNAME}{F#妳}{M#你}還有這種天賦啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010321,
					"content": "只是順勢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "#以後我可要小心一點，不能隨隨便便被{F#妳}{M#你}唬住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010325,
					"content": "看樣子守衛提到的貴客，應該就是「愚人眾」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010326,
					"content": "我猜也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "嗯，那就去新月軒吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010327,
					"content": "來得早不如來得巧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "妳演得也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "嘿嘿，那作為感謝，要請我吃點心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010314,
					"content": "等你老爺為你的冒犯買單吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#我是{NICKNAME}，你家主子的貴客！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "奇怪了，名冊上沒有這個名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂才公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "我知道，我知道，放心，訂單我一定會完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010702,
					"content": "但我之前派給你的手下回覆我說，進度不太樂觀啊…有人不願配合，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120010703,
					"content": "呃…是，在原料上出了點小問題，石珀暫時還沒收購到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010704,
					"content": "不過這不需要您擔心，就算那個常九爺不賣，我從其他人手上買就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010705,
					"content": "那是最好，之前我就說過，「愚人眾」只重視結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120010706,
					"content": "為了完成訂單，「愚人眾」可以給你一定支援，但如果按時完不成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120010707,
					"content": "我們的好意可不是免費的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120010708,
					"content": "明白明白，承蒙您關照，我又怎麼敢辜負您的期望呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010709,
					"content": "那就到時候看你的成果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "債務處理人"
				},
				{
					"id": 120010710,
					"content": "呼…該死的老常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 610045701,
					"content": "這個茂才公果然和「愚人眾」有勾結！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 610045702,
					"content": "不知道書呆子那邊有沒有什麼進展，我們去告訴他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "說是有其他想瞭解的事，搞得神神秘秘的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010802,
					"content": "結果你只是換了個地方看書吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010803,
					"content": "茂才公的生意我們弄清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "原來如此，和我猜得差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010805,
					"content": "你真的有猜過嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010806,
					"content": "#辦法我已成竹在胸。我這裡有封信，拜託{F#妳}{M#你}們帶去給「飛雲商會」的家丁，他知道該怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010807,
					"content": "因為一些難以言述的苦衷，在下不能與二位一同前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010808,
					"content": "#至於信中內容{F#妳}{M#你}們不必查看，到時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010809,
					"content": "哇，字好醜！這種字就算查看了也看不懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010810,
					"content": "古代文字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010813,
					"content": "#所以說{F#妳}{M#你}們不必查看，不看…也不會有什麼關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010814,
					"content": "那個人是讀得懂這封信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010815,
					"content": "可是，是要找「飛雲商會」幫忙嗎？那可是璃月大名鼎鼎的商會之一，沒理由幫我們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010816,
					"content": "「飛雲商會」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "來璃月之後，經常聽到這個名字，好像有很多很多生意都是他們主導的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010818,
					"content": "像這樣的大商會如果願意幫忙是很好，但他們真的會幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010819,
					"content": "這個不用擔心，據我瞭解，他們都跟我一樣，有一顆俠義心腸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010820,
					"content": "讀了我曉之以理、動之以情的這封信，一定會出手相助的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010821,
					"content": "真的會有用嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "要給茂才公一個深刻的教訓，只靠我們是不夠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010824,
					"content": "而且我也不想讓別人知道這件事是我做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010825,
					"content": "為什麼？你不是為了報答常九爺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010826,
					"content": "「事了拂衣去，深藏功與名」，此乃俠義之本，回味無窮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010827,
					"content": "滴水之恩，定當湧泉相報，但這僅僅是報答，我不想要人情，也不想要回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010828,
					"content": "說得這麼帥，其實你只是想繼續看你的書吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010829,
					"content": "那就拜託二位送信給「飛雲商會」的家丁了，他現在應該在琉璃亭附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010830,
					"content": "不准無視我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010822,
					"content": "為什麼要找他們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "加了密的密文？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}