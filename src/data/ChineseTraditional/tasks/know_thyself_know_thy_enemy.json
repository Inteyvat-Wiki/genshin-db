		},
		{
			"id": 1200102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200102",
							"2"
						],
						"stepId": 1200102,
						"stateName": "QUEST_STATE_UNFINISHED"
