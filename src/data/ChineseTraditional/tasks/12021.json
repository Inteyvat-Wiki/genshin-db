			"dialogs": [
				{
					"id": 120210301,
					"content": "心海——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210302,
					"content": "心海，我們找到商人的貨物啦。妳看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210303,
					"content": "唔…喔喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210304,
					"content": "有什麼心事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "沒事，只是稍稍有些分心而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210307,
					"content": "讓我看看…確實，這些應該就是商人先生丟的東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210308,
					"content": "糧食、藥材、農耕用具…都是戰後急需的東西。他囤著這些，大概是想賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210309,
					"content": "不過，天領奉行應該不缺這些東西，他倒確實不至於把這些運回天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210310,
					"content": "應該只是個投機的商人而已，沒有松田和內村說的那麼誇張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210311,
					"content": "唔…但是，故意囤積這些必需品，顯然也是個壞傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210312,
					"content": "我們就這樣把貨物還回去嗎？總覺得有點不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210313,
					"content": "放心吧，這種情況我已經考量過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210314,
					"content": "在最新的「戰後臨時法令」中，我限制了必需品的價格上限。這些東西，最終還是會以合理的價格流通到民眾手裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210315,
					"content": "如果他能早一點讀讀法令，應該也不會遭此無妄之災了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210316,
					"content": "嘿嘿，總覺得心海什麼事都能算到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210317,
					"content": "太誇張啦。就拿目前的情況來說，關於天領奉行勾結愚人眾的傳聞，我就沒什麼頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210318,
					"content": "正好還是在「能量」快不夠的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210319,
					"content": "嗯？心海，妳剛剛說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210320,
					"content": "沒什麼，我們快點將這堆貨物還回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210321,
					"content": "慶功宴就快到了，這些麻煩事，必須早點做個了結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210322,
					"content": "好欸！我們也想在一個和平的海祇島上開慶功宴呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120210305,
					"content": "心海在想什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
