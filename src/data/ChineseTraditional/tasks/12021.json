							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "不過沒想到，愚人眾竟然藉丘丘人的營地為掩護，悄悄在這裡駐紮了這麼久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210202,
					"content": "他們的目的是什麼呢？難道說，真的像士兵們所說的那樣，他們已經勾結了天領奉行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210203,
					"content": "我們好好調查一下這個營地吧，如果那位商人沒有說謊的話，貨物應該就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210204,
					"content": "好！那我們先四處看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
