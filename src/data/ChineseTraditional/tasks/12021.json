				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "那些！那些是我的貨物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210402,
					"content": "是，珊瑚宮大人！多謝這位隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210403,
					"content": "怎麼樣，我就說自己是被冤枉的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210404,
					"content": "哼…誰知道呢。說不定你早就跟愚人眾商量好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210405,
					"content": "從愚人眾營地中的資訊來看，他和愚人眾確實沒什麼來往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210406,
					"content": "否則按照愚人眾的行事風格，應該會留下一些證據才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210407,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210408,
					"content": "沒有什麼可是！既然找回了貨物，按照之前的約定，我們就應該還他清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210409,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210410,
					"content": "是我們魯莽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210411,
					"content": "哼哼…我就說你們這些大頭兵，平時不幹正事，還敢來找我的麻煩，這下知道錯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210412,
					"content": "這位商人也請不要得意。雖然我們證明了你的清白，但根據最新的法令，惡意囤積必需品，將遭受懲罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210413,
					"content": "既然你承認這些是你的貨物，那我們也會採取必要的措施。除了強制以定價銷售外，還有一筆罰款，金額是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210414,
					"content": "停、停！珊瑚宮大人，妳不是站在我這邊的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210415,
					"content": "當然不是。我是海祇島的「現人神巫女」，遵循的是「賞罰分明」的原則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210416,
					"content": "有功當賞，有錯該罰。清白已還，但你還是要為自己的所作所為付出代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210417,
					"content": "啊？這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "成瀨"
				},
				{
					"id": 120210418,
					"content": "看什麼看，帶走帶走！交罰款去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210419,
					"content": "珊瑚宮大人，雖然此人說這些都是他的貨物，但我覺得有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210420,
					"content": "這些印有天領奉行標記的應該無誤，但其他的貨物似乎並不是。特別是這一些，明顯是給神社用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210421,
					"content": "嗯…應該是愚人眾將所有搶到的東西混在一起了吧。其他貨物，麻煩你們去尋找一下失主，神社相關的交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210422,
					"content": "辛苦你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210423,
					"content": "不辛苦，不辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210424,
					"content": "不過珊瑚宮大人，雖然這次沒有抓到他們的把柄，但天領奉行勾結愚人眾，是我們的人親眼所見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210425,
					"content": "關於和談…還請您務必三思啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "內村"
				},
				{
					"id": 120210426,
					"content": "我知道了，我會再想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}，我準備帶著這些神社相關的東西回珊瑚宮，方便的話，不妨一起走走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
