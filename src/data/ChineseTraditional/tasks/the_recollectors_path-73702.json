				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "與上次相見時相比，表情開朗了許多嘛。看來訓練進行得很順利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020102,
					"content": "嗯，經過這幾段反思我已經獲得了成長。如果是現在的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020103,
					"content": "就可以算得上是稱職的花靈勇者了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020104,
					"content": "還…還沒有，畢竟還有最後的訓練沒有完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020105,
					"content": "直到所有的任務完成，並且最終獲得前輩的認可之後，「雙角的花冠」才真正屬於我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020106,
					"content": "哦？看來之前說已經脫離了叛逆期，的確不假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020107,
					"content": "前、前輩怎麼還記得這個？快忘了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020108,
					"content": "呵呵，不管怎麼說，看妳恢復精神了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}和派蒙，斯露莎究竟是否配得上「雙角的花冠」，也請兩位見證到最後吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020110,
					"content": "我會在終點處等候，那就稍後再見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "荼泥黑淵…這裡就是災厄的中心了。雖然一切都靜止了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020602,
					"content": "不難想像當時的景象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "周圍這些巨大的結晶…比沙蟲還要大上很多倍呢！想到之後要由斯露莎來解決這裡的大麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020604,
					"content": "這不正是花靈勇者最該承擔的責任嗎？而且，也是斯露莎自己所期望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020605,
					"content": "話是這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020606,
					"content": "難道是信不過我？哼，沒想到事到如今還會被區區白飄飄看扁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020607,
					"content": "哇，感覺之前那個囂張的斯露莎又回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020608,
					"content": "也不知道是好事還是壞事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "唔…經過這陣子的相處，「謁頌主」和白飄飄還是對我有所懷疑嗎？我這可不是什麼沒來由的盲目囂張啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020610,
					"content": "哼哼，要知道，我已經完全理解了自己過去的失誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020611,
					"content": "過去我一度將聲名看得比行動本身更重要，但現在我知道了，這是捨本逐末的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020612,
					"content": "就像「西摩格」是因為牠的犧牲而成為神鳥，我也將會因為我所行之事而被當作花靈勇者，為人所稱頌傳唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020613,
					"content": "而且，我也完成了前輩指定的全部訓練，這下就算是前輩也該承認我的確是個稱職的勇者，的確配得上「雙角的花冠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020614,
					"content": "我當然對靈光的選擇沒有異議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020615,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020616,
					"content": "怎麼了？這時候我該提出反對意見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020617,
					"content": "不…只是…只是我沒想到前輩居然會這麼爽快地認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020618,
					"content": "還以為至少會刁難兩句。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "哎呀，我可不是什麼壞心眼的長者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020620,
					"content": "對了，關於勇者的職責…我並沒有從花冠得到有關的知識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020621,
					"content": "是因為我作為勇者還是不完全的嗎？難道說還需要經過什麼其他的訓練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020622,
					"content": "這個嘛…雖然勇者的稱號的確是花靈傳承的一部份，具體的職責卻是隨時代改變的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020623,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020624,
					"content": "簡單來說，就是沒有具體要做哪些事的規定，也沒有什麼是否合格的評判標準。一般來說，靈光的選擇就代表了最終的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020625,
					"content": "欸？也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020626,
					"content": "我是不會沒收「雙角的花冠」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020627,
					"content": "這下不用擔心頭頂一陣寒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "重點不是這個吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020633,
					"content": "我知道了！這一定也是考驗的一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020634,
					"content": "斯露莎好像理解了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020635,
					"content": "白飄飄可真是健忘呀，我剛剛還說過呢！經過這些訓練，除了磨練行動力和洞察力，最重要的是我理解了自己過去的錯誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020636,
					"content": "如果因為結果其實不會改變而輕忽訓練的過程，那不就重蹈覆轍了嗎？所以，這一定是前輩留給我的最後的考驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020637,
					"content": "對於名副其實的花靈勇者來說，當然是不在話下了。這可是前輩充分信賴我的表現啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020638,
					"content": "真沒想到居然被斯露莎給看穿了，不愧是靈光選中的花靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020639,
					"content": "#不過斯露莎能有這樣的改變，或許也多虧了{NICKNAME}和派蒙兩位吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020640,
					"content": "#嗯！吾之「謁頌主」和{M#他}{F#她}的同伴白飄飄，的確是可造之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020641,
					"content": "#雖然想說有我自己就綽綽有餘了…不過，相信有{M#他們}{F#她們}的幫助，熄滅「焚真之天象」也不是什麼難事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020642,
					"content": "#那真是太可靠了。別忘了，米希爾和拉沙魯也會協助{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020643,
					"content": "前輩就放心交給我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020644,
					"content": "總覺得這一切都是祖爾宛的安排…不過看斯露莎的開心的樣子，也許這樣也滿好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020629,
					"content": "不是想沒收也沒收不了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "對啊，祖爾宛自己也說了，靈光的選擇就代表最終的結果。即使是祖爾宛也不能輕易改變這個結果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020631,
					"content": "呵呵…真的不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
