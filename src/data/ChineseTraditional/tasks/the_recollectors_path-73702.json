			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎",
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "曾經的荼泥黑淵…過去的災厄的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020702,
					"content": "真沒想到斯露莎真的熄滅了「焚真之天象」，解決了這裡的大麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020703,
					"content": "熄滅「焚真之天象」也在花靈勇者的職責之內，斯露莎只是做了自己該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020704,
					"content": "多虧了米希爾和拉沙魯的協助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "嗯，還有我們也出了不少力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020706,
					"content": "好啊，吾之「謁頌主」還有白飄飄，居然將我這個主角拋下不談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020707,
					"content": "哇，感覺之前那個囂張的斯露莎又回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020708,
					"content": "唔…經過這陣子的相處，「謁頌主」和白飄飄還是對我有所懷疑嗎？我這可不是什麼沒來由的盲目囂張啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020709,
					"content": "哼哼，要知道，我已經完全理解了自己過去的失誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020710,
					"content": "過去我一度將聲名看得比行動本身更重要，但現在我知道了，這是捨本逐末的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020711,
					"content": "就像「西摩格」是因為牠的犧牲而成為神鳥，我也將會因為我所行之事而被當作花靈勇者，為人所稱頌傳唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020712,
					"content": "而且，我也完成了前輩指定的全部訓練，這下就算是前輩也該承認我的確是個稱職的勇者，的確配得上「雙角的花冠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020713,
					"content": "我當然對靈光的選擇沒有異議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020714,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020715,
					"content": "怎麼了？這時候我該提出反對意見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020716,
					"content": "不…只是…只是我沒想到前輩居然會這麼爽快地認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020717,
					"content": "還以為至少會刁難兩句。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "哎呀，我可不是什麼壞心眼的長者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020719,
					"content": "對了，關於勇者的職責…我並沒有從花冠得到有關的知識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020720,
					"content": "是因為我作為勇者還是不完全的嗎？難道說還需要經過什麼其他的訓練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020721,
					"content": "這個嘛…雖然勇者的稱號的確是花靈傳承的一部份，具體的職責卻是隨時代改變的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020722,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020723,
					"content": "簡單來說，就是沒有具體要做哪些事的規定，也沒有什麼是否合格的評判標準。一般來說，靈光的選擇就代表了最終的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020724,
					"content": "欸？也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020725,
					"content": "我是不會沒收「雙角的花冠」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020726,
					"content": "這下不用擔心頭頂一陣寒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "重點不是這個吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020732,
					"content": "我知道了！這一定也是考驗的一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020733,
					"content": "斯露莎好像理解了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020734,
					"content": "白飄飄可真是健忘呀，我剛剛還說過呢！經過這些訓練，除了磨練行動力和洞察力，最重要的是我理解了自己過去的錯誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020735,
					"content": "如果因為結果其實不會改變而輕忽訓練的過程，那不就重蹈覆轍了嗎？所以，這一定是前輩留給我的最後的考驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020736,
					"content": "對於名副其實的花靈勇者來說，當然是不在話下了。這可是前輩充分信賴我的表現啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020737,
					"content": "真沒想到居然被斯露莎給看穿了，不愧是靈光選中的花靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020738,
					"content": "#不過斯露莎能有這樣的改變，或許也多虧了{NICKNAME}和派蒙兩位吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020739,
					"content": "#嗯！吾之「謁頌主」和{M#他}{F#她}的同伴白飄飄，的確是可造之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020740,
					"content": "#雖然想說有我自己就綽綽有餘了…不過，的確是因為{M#他們}{F#她們}的幫助，我才得以熄滅「焚真之天象」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020741,
					"content": "沒想到在短短的時間裡，斯露莎竟然能蛻變得如此可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020742,
					"content": "嗯！只要是勇者的職責所在，前輩就放心交給我好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737020743,
					"content": "總覺得這一切都是祖爾宛的安排…不過看斯露莎的開心的樣子，也許這樣也滿好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020728,
					"content": "不是想沒收也沒收不了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "對啊，祖爾宛自己也說了，靈光的選擇就代表最終的結果。即使是祖爾宛也不能輕易改變這個結果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737020730,
					"content": "呵呵…真的不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737020731,
					"content": "嗚…有點可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
