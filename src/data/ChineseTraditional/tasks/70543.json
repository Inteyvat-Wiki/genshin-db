			"dialogs": [
				{
					"id": 705430101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430102,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "「團團灰」"
				},
				{
					"id": 705430103,
					"content": "#…是{F#妳}{M#你}們。我在，聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430104,
					"content": "聊天…雷澤是在和「團團灰」聊天嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430105,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "「團團灰」"
				},
				{
					"id": 705430106,
					"content": "「團團灰」的意思好像是…「沒錯」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430107,
					"content": "聞到熟悉的味道，找朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430108,
					"content": "牠很好，高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430109,
					"content": "喵，喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "「團團灰」"
				},
				{
					"id": 705430110,
					"content": "#氣味吸引朋友，{F#妳}{M#你}也來了，高興。{F#妳}{M#你}身上，風和雨的味道，很熟悉…貓的氣味，也熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430111,
					"content": "派蒙，甜甜的味道，好聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430112,
					"content": "欸？！甜甜的…難道是瓦樂瑞娜給我們的鬆餅的味道？我、我有吃那麼多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430113,
					"content": "我的都分一半給妳了啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "完全沒注意…哎呀，都怪鬆餅太好吃了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430116,
					"content": "嘿嘿，我還想吃甜甜花釀雞、烤肉排和薯餅…還有蘋果釀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430117,
					"content": "#那菜單就決定是這樣啦，{NICKNAME}，我們快去找瓦樂瑞娜下單吧，雷澤也一起來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430118,
					"content": "謝…謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430119,
					"content": "「團團灰」帶了很多…堅果給我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430120,
					"content": "還有，盒子的肉…我，吃得很飽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 705430121,
					"content": "聽起來好像是瓦樂瑞娜小姐點的外送訂單？難道「團團灰」把外送餐品拿給雷澤吃了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430122,
					"content": "喵喵。喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "「團團灰」"
				},
				{
					"id": 705430123,
					"content": "沒想到「貓茸茸城堡」裡還會有貓貓反過來招待客人的事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430124,
					"content": "看來雷澤的「貓緣」真的很棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430114,
					"content": "不用擔心，妳還能再吃三倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}