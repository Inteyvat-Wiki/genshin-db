			"dialogs": [
				{
					"id": 210340401,
					"content": "#怎麼？{F#妳}{M#你}已經把那邊的魔物清理完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340402,
					"content": "這裡的魔物…妳已經全部打倒了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "嗯，那是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340404,
					"content": "我好歹也是璃月冒險家協會的會長。對付這群尋常的魔物，也沒費多大力氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
		{
