					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210340101,
					"content": "哼，看來這傢伙就在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340102,
					"content": "嵐姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "#旅行者，沒想到能在這裡遇見{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340105,
					"content": "#{F#妳}{M#你}還記得上次{F#妳}{M#你}們幫我找到的那個劍柄嗎？它確實是「藏鋒」的一部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340106,
					"content": "說來好笑，我之所以能把它分辨出來，是因為我小時候偷偷拿刀在上面刻了記號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340107,
					"content": "那時我和兄長說，如果他之後換了其他的劍，那一定要把「藏鋒」送給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340108,
					"content": "呵呵，我們兩個那時候應該都沒想到…我居然是以這種形式拿到的「藏鋒」。看來，這柄劍…真的已經碎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340109,
					"content": "#好了，閒話就不說了。既然在這裡遇見了{F#妳}{M#你}，那我還要請{F#妳}{M#你}再幫我一個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340110,
					"content": "前面是兩塊魔物聚集地，這群魔物四處收集了不少破損的武器，放在營地裡不知作何用途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340111,
					"content": "協會擔心它們擾亂附近，本來打算掛出委託，但我看見之後就自己攬了下來…也許，我能從這裡再找到一些「藏鋒」的碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340112,
					"content": "旅行者，我們就各去掃清一片營地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340113,
					"content": "#左邊的營地聚集著一群丘丘人，雖然對{F#妳}{M#你}來說，單個丘丘人並不難對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340114,
					"content": "#但這裡丘丘人的數量不少，如果它們一擁而上，只怕{F#妳}{M#你}也需要費一番手腳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340115,
					"content": "右邊是一個「丘丘岩盔王」，它的危險程度…我應該也不用解釋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340116,
					"content": "#是我請{F#妳}{M#你}幫的忙，就由{F#妳}{M#你}先選一片營地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 210340103,
					"content": "#{F#妳}{M#你}怎麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
