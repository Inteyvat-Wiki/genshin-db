			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"韋尼爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "一百三十六…好，再來十四次，就可以休息了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230202,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "幫忙？不不，不用，哪有鍛煉還需要別人幫忙的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230204,
					"content": "只有鍛煉出強悍的體魄，才有辦法像這位長官一樣加入不朽軍團，成為一名榮耀的士兵啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230205,
					"content": "…………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230206,
					"content": "忘記介紹了，這位是我的教官。只有通過他的考核，才可以有獲得擢升的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230207,
					"content": "這不是個雕像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#{F#妳}{M#你}在說什麼啊，公民？雷穆利亞人不都長成這個樣子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230209,
					"content": "#怎麼樣，{F#妳}{M#你}要試試看嗎？只要可以同時打碎這些石柱就算是通過初步考核了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230213,
					"content": "不要小看這些石柱，我鍛煉了這麼久也只能勉強一拳打碎一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230210,
					"content": "考核？什麼考核？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "當然是戰鬥的考核。就算擢升後能夠獲得不朽的身軀，戰鬥的技能也是要透過自己的鍛煉才能習得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230212,
					"content": "#怎麼樣，{F#妳}{M#你}要試試看嗎？只要可以同時打碎這些石柱就算是通過初步考核了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "韋尼爾"
				}
			]
		},
