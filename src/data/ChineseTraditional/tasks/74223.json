					"nextDialogs": [
						742230404
					],
					"speakerTitle": "韋尼爾"
				},
				{
					"id": 742230404,
					"content": "#長官對{F#妳}{M#你}的表現也讚譽有加呢，看來我還要勤加練習啊！",
					"roleType": "TALK_ROLE_NPC",
