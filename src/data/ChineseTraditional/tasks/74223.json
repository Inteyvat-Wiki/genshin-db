				},
				{
					"id": 742230402,
					"content": "#實在是太厲害了，{F#妳}{M#你}該不會之前有在神王的軍團裡服役過吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "韋尼爾"
				},
				{
