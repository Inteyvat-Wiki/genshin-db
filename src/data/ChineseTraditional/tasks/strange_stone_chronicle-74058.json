			"dialogs": [
				{
					"id": 740580201,
					"content": "竟然…有這麼多嗎，真是幫大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580202,
					"content": "雖然好像因為工匠對這種寶石的品性不太瞭解的緣故，導致了一些問題…上次送去加工的寶石，到現在也還沒有拿到成品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580203,
					"content": "不過沒關係，我相信我的眼光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580204,
					"content": "我打算把它們加工成最流行的首飾款式，到時候一定會風靡整個楓丹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580205,
					"content": "#等下次{F#妳}{M#你}們來的時候應該就能看到成品了！到時候，我也會贈送一些樣品給{F#妳}{M#你}們作為報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580206,
					"content": "#不過，也說不定{F#妳}{M#你}們會在那些上流社會的有錢人身上先看到呢，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580207,
					"content": "#那麼，也歡迎{F#妳}{M#你}們再次光臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "切瑟爾"
				}
			]
		},
