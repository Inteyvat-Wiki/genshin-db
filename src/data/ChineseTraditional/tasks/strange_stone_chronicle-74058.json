			"dialogs": [
				{
					"id": 740580401,
					"content": "#歡迎光臨…哦哦，是{F#妳}{M#你}們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580402
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580402,
					"content": "#之前約定好的礦石，不知道{F#妳}{M#你}們帶來了沒呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580403,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "雖然不是很著急…畢竟之前那個礦石樣本，工匠們還在處理當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580405,
					"content": "不過要是能早點拿到更多礦石的話，說不定工匠們也能有新的靈感唷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740580406,
					"content": "那麼我就還是在此靜候佳音了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "切瑟爾"
