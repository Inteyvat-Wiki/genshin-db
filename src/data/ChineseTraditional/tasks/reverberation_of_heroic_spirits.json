			"dialogs": [
				{
					"id": 761420401,
					"content": "菲拉耶夫，別怕，我和帕托利會帶你一起出去的。打起精神，像個合格的執燈人一樣，把劍拿穩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420402,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420403,
					"content": "有什麼計畫？能有什麼計畫，帕托利。如果這就是結局，那我會在這裡戰鬥到底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420404,
					"content": "你們是最棒的小隊，不論結果會如何，曾與你們一同並肩是我的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420405,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420406,
					"content": "這也是我們的榮幸，隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420407,
					"content": "來吧，準備防守！讓這群狗東西見識一下「凜風之馬」的厲害！",
					"roleType": "TALK_ROLE_NPC",
