			"dialogs": [
				{
					"id": 761420301,
					"content": "嘿，契諾夫，你還好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420302,
					"content": "還拿得動刀…隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "契諾夫"
				},
				{
					"id": 761420303,
					"content": "肖諾科維奇…菲拉耶夫…你們沒事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420304,
					"content": "呃啊…我的腿好像斷了，幸好我還活著，你數過了嗎？我殺了幾個了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "肖諾科維奇"
				},
				{
					"id": 761420305,
					"content": "到…到底有多少魔物啊，我們…我們不會要死在這裡了吧，隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420306,
					"content": "你這個混小子在說什麼？我們肯定能安全出去的！別擔心，斥候肯定已經回城告訴老爺子了，我們的增援已經在路上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420307,
					"content": "又來了，這群狂獵真是沒完沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420308,
					"content": "嘿！拿好你們的武器和燈，我們還有一場硬仗要打呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
