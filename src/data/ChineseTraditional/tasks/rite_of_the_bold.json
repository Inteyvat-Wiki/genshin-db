			"dialogs": [
				{
					"id": 750190601,
					"content": "#恕我直言…雖然我明白{NICKNAME}的實力，但是還請注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190602,
					"content": "雖然沒能夠獲得「古名」，不過帕加爾的實力也是不容小覷的…如果他這幾年沒有荒廢鍛煉的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190603,
					"content": "如果準備好與他的戰鬥的話，那就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				}
			]
		},
