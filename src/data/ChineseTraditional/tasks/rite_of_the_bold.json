			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "贏了，好耶！了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190702,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "#哈…即使是現在部族裡最強的戰士，恐怕也打不贏{F#妳}{M#你}吧…這次還真是輸得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190704,
					"content": "被一隻小傢伙打敗的感覺怎麼樣，老兄？看來我們還要多多鍛煉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190705,
					"content": "呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "烏丘"
				},
				{
					"id": 750190706,
					"content": "真是見證了一場精彩的決鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190707,
					"content": "曼科老兄啊，你這傢伙不要老是在旁邊說這種漂亮話，怎麼樣，要不要你也下來打一場？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190708,
					"content": "不，我就對此敬謝不敏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190709,
					"content": "#唉…無聊的傢伙。啊，真是一場爽快的戰鬥，{F#妳}{M#你}…{NICKNAME}，{F#妳}{M#你}的實力不是蓋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190710,
					"content": "我還沒熱身呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "哈哈哈，真是囂張的傢伙，不過我很欣賞這種態度。強者就應該飛揚跋扈一點，不然變強又有什麼意義？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190714,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#哈哈，{REALNAME[ID(2)|SHOWHOST(true)]}，看得出來你有被{F#她}{M#他}們好好照顧著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190716,
					"content": "#那是當然了，{REALNAME[ID(2)|SHOWHOST(true)]}可是我們了不起的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190717,
					"content": "既然如此，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190718,
					"content": "#好了，說好的，部族首領的證明{F#妳}{M#你}們就拿去吧，就是這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190719,
					"content": "學名叫什麼東西…曼科老兄，現在是你該發言的時候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190720,
					"content": "瓦薩克拉胡巴肯的護符…「盜火賢者」的護符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190721,
					"content": "嗯，這個名字我永遠記不起來。不過我記得是在火龍王死去，而最初的火之神從烈焰中甦生之後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190722,
					"content": "「盜火賢者」與最初的火神各自從火山中帶走了一枚信物，取得兩枚信物之人就能進入火山內的淨火，除卻一切詛咒與災厄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190723,
					"content": "不過這個「盜火賢者」到底活了多久啊？曼科老兄，感覺從「部落」時代到奧奇卡納塔那時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190724,
					"content": "就連「縫影針」那裡都有他的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190725,
					"content": "畢竟是第一個會使用燃素的人類…出現在傳說中的人物，不管變成什麼樣都有可能吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190726,
					"content": "有人說他已經把身體與靈魂都燃素化了，和納塔的風、大地與花融為一體，能夠傾聽部族人向他祈求幫助的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190727,
					"content": "也有人說，其實每個時代都有不同的人繼承「盜火賢者」之名，一代一代，甚至傳言今日也依然有「盜火賢者」的傳承者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190728,
					"content": "不過，恕我直言…其中大部分都是敘事人的臆測罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190729,
					"content": "哈哈，聽到你這麼說，蒂圖兄弟又要生氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190730,
					"content": "好了，我該做的已經做完了…哦不對，按照傳統和慣例還有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190731,
					"content": "#那就是為踏上旅程的勇者和{F#她}{M#他}的夥伴獻上祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190732,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "哦哦，居然還有這樣的儀式嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190734,
					"content": "其實就是一些討個好彩頭的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190735,
					"content": "#那麼，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190736,
					"content": "嗯，我在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "祝你們能夠像翎翅最硬的鳥兒那樣飛過一切山巔；\\n祝你們能夠像最堅強的頑石那樣抵擋惡浪的奔流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190739,
					"content": "祝你們不畏艱險，因為世上註定有諸多艱險。\\n祝你們不忘彼此，因為命運之中終有離別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190740,
					"content": "祝你們能抵達想要到達之處，能夠得償所願…然後，最重要的一點，也是我最希望的一點，祝你們能夠平安歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190741,
					"content": "我會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "啊，那我呢？我就沒有祝福嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190744,
					"content": "對耶，小派蒙…那就祝小派蒙吃好喝好，睡得飽飽的，健康長大吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190745,
					"content": "也不錯哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "哼，那我就勉強接受這份祝福吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190749,
					"content": "好，那見證人的儀式就結束了，在你們出發之前，我還是要說：「一定要小心啊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190750,
					"content": "嗯，我們知道啦，再見，帕加爾…還有烏丘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190751,
					"content": "嗚嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "烏丘"
				},
				{
					"id": 750190753,
					"content": "再見，祝你們一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190746,
					"content": "派蒙還會長大嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "#當然會，等以後我一定要長成「三座山大小」的派蒙給{F#妳}{M#你}看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190712,
					"content": "你也不賴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "#這種可憐人的誇獎就免了吧。不過要是我再年輕一點…誰勝誰負還不知道呢，真可惜，如果年輕時可以和{F#妳}{M#你}打一場就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "帕加爾"
				}
			]
		},
