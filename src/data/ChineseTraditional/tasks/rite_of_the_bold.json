			"dialogs": [
				{
					"id": 750190301,
					"content": "…這件事沒有商討的餘地嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190302,
					"content": "我說曼科老兄啊，你沒有聽蒂圖兄弟說過嗎？這件事已經快五百多年沒有人做過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190303,
					"content": "就算你說找到可能的入口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190304,
					"content": "那又如何？歷史上踏上這條路的人和他們的夥伴，全都沒有回來，聽好了——是「一個」都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190305,
					"content": "呃…恕我直言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190306,
					"content": "那個龍遺物研究協會的傢伙在那裡，旁邊那位好像是「回聲之子」的首領？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190307,
					"content": "喂…龍遺物研究協會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190308,
					"content": "#是{NICKNAME}…派蒙，還有{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190309,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "喔哦，尾巴上綁紅絲巾的小嵴鋒龍！好有精神的小傢伙，看起來感覺就不太一樣哦，來，再來一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190311,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#真不錯，你就是{REALNAME[ID(2)|SHOWHOST(true)]}，那{F#妳}{M#你}們兩個就是{REALNAME[ID(2)|SHOWHOST(true)]}選擇的勇者了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們的名字最近出現得很頻繁哦…不僅曼科老兄一直在講，連蒂圖那傢伙回部族的時候也有提到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190314,
					"content": "#{F#妳}{M#你}們最近的事蹟都已經可以算是「傳說故事」了，而且回聲之子的小傢伙們也受到{F#妳}{M#你}很多照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190315,
					"content": "不用太感激我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "哈哈，了不起的年輕人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190318,
					"content": "#曼科老兄，為了驗證你的想法就要把{F#她}{M#他}們推進火坑，這不是回聲之子的待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190319,
					"content": "至少這不是「我的」待客之道，我幹不出這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190320,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190321,
					"content": "你們在說什麼啊？什麼危險啊，火坑的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190322,
					"content": "抱歉，這就請讓我來說明吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190323,
					"content": "還記得之前說的嗎？為了解除「焰主之祝」的標記，必須帶著兩種信物前往火山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190324,
					"content": "其中一個信物就在回聲之子外的遺蹟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190325,
					"content": "只不過想要進入那裡也有條件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190326,
					"content": "根據過往的慣例…當然了，這個慣例還是我剛剛翻織物找到的，畢竟已經很久沒有人想做這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190328,
					"content": "如果想帶自己的龍夥伴前往火山洗禮，洗去「焰主之祝」，就要從各自部族首領那裡獲得認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190332,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}是隻小嵴鋒龍，所以就要取得「回聲之子」首領的承認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190334,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "那不就是帕加爾先生的認可嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190336,
					"content": "#沒錯，不過說實話，這個規矩對異邦人到底有沒有效我也不知道…但是，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190337,
					"content": "這幾百年來，有很多勇士想讓自己的龍夥伴從這個血脈中的…比起祝福更像是詛咒一樣的東西逃脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190338,
					"content": "但是沒有一個人成功…這也是後來部族裡逐漸荒廢這項傳統的緣由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190339,
					"content": "欸，居然沒有一個人成功嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190340,
					"content": "對，就是這麼危險的事。而且據說在取得信物前的試煉中，不僅是決定前往的勇士，就連龍夥伴自己也都要接受考驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190341,
					"content": "#雖然{F#妳}{M#你}們並不是部族人，但我還是不希望{F#妳}{M#你}們白白送死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190342,
					"content": "#所以{NICKNAME}，我還是提議把{REALNAME[ID(2)|SHOWHOST(true)]}留在回聲之子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190343,
					"content": "至少我可以保證，在牠進入夜神的國度之前，我會好好照顧好牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190344,
					"content": "可是…可是這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190345,
					"content": "#…就像我之前說的，{REALNAME[ID(2)|SHOWHOST(true)]}就沒辦法長大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190346,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "看來牠不是很希望這樣呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "我想試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "即使很危險，也想要試試看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190350,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "小傢伙，你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190352,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "哈哈哈，真好，無比堅定的眼神，堅決，卻能夠感受到內心的火熱，真是猶如燃素岩一般的好傢伙們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190354,
					"content": "好啊，那我就承認你們有前往火山朝聖的資格吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190355,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "好耶，現在我們是不是就可以去找第一個信物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190357,
					"content": "不，還不行。既然已經取得資格，就要接受見證人的試煉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190358,
					"content": "按照古老的傳統，勇者與龍必須一起取得樹林深處綠咬鵑的羽毛，並獻上一打獸皮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190359,
					"content": "必須一同為部族贏下五十場對外戰鬥、獻上九十六顆品質上等的寶石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190360,
					"content": "我沒有資格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "算了，曼科老兄，你說的都是哪一年的老石歷了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190363,
					"content": "那些本來就是為了培養龍和人的默契、增強他們的實力，才必須遵守的繁文縟節——我已經受夠那些啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190364,
					"content": "#更何況，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}，看起來並不需要那些東西來證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190365,
					"content": "#換種簡單點的方法吧…{NICKNAME}，在納塔，人們遇到這種情況的時候有一種最方便快速的辦法——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190366,
					"content": "#和我打一場，向我證明{F#妳}{M#你}和{F#妳}{M#你}夥伴的實力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190367,
					"content": "正合我意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "咦？要在這裡開打嗎…啊，難道要去舞臺上打？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190370,
					"content": "當然不是，哈哈。舞臺是沒辦法鑽來鑽去的…回聲之子的決鬥場地在後山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190371,
					"content": "來吧，我們去後山上痛痛快快地打一場吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕加爾"
				},
				{
					"id": 750190361,
					"content": "可以換算成摩拉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
