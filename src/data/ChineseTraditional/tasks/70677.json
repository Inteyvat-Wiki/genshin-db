			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小狼"
				],
				"points": [
					{
						"sceneId": 48000,
						"position": [
							38.876,
							0.239,
							22.069
						],
						"pointId": 7
					},
					{
						"sceneId": 48000,
						"position": [
							39.722,
							0.239,
							21.347
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 706770101,
					"content": "哎呀哎呀，是客人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770102
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770102,
					"content": "我在這裡等好久好久了，一直都沒有客人來，原本只是想小瞇一下，可是沙發太軟了，一不小心就睡著了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770103
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770103,
					"content": "哇！布偶在說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770104,
					"content": "對啊對啊，布偶是會說話的。讓我想想，唔…這種時候應該先自我介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770105
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770105,
					"content": "#兩位客人{F#妳}{M#你}們好，我是…我是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770106
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770106,
					"content": "…我是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770107
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770107,
					"content": "欸？就算你問我們…該不會是睡迷糊了還沒清醒過來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770108,
						706770109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770108,
					"content": "你是「狼狼伯爵」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770110
					]
				},
				{
					"id": 706770110,
					"content": "欸欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770111
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770111,
					"content": "只是在開玩笑而已啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770112,
					"content": "#順帶一提，我是派蒙，旁邊這位是{NICKNAME}哦。呼，太好了，看來這裡不是會讓人失憶的神秘房間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770113,
					"content": "真是抱歉…可能是因為睡太久做了好多夢，現在都分不清楚哪一段才是真實的經歷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770114
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706770114,
					"content": "我想想…「現在」的我應該是「禮賓員」，負責招待來到這裡的「客人」。嗯，兩位客人就叫我「小狼」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770115
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770115,
					"content": "好呀。不過既然是夢，怎麼會是真實的經歷呢？那應該都是小狼的想像才對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770116,
					"content": "想像不能是真實的經歷嗎？客人懂得真多，我都分不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770117
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770117,
					"content": "不管是因為中了可怕的詛咒，心臟被不會融化的冰晶牢牢封住，在無邊雪原獨自忍受寂寞的日子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770118
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770118,
					"content": "還是在薄霧的森林中和「白獠牙」玩耍，追逐金色的蝴蝶，涉渡潺湲的溪流，連月亮也踏碎了的時光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770119
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770119,
					"content": "又或者在凱旋的隊列中沐浴繽紛的五彩紙屑，想像女王陛下會在不久的將來為我授勳——那該有多光榮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770120
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770120,
					"content": "對我來說都和真實的經歷沒有不同啊。就像最近做的一個夢，我夢到魔女小姐在小徑分岔的花園對我說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770121
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770121,
					"content": "「之後你就是禮賓員了，要好好招待客人哦。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770122
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770122,
					"content": "然後我就來到這裡了。就像剛才說的，等了好久好久…總算等來了兩位客人！終於可以作為「禮賓員」盡責了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770123,
					"content": "兩位還有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770124,
						706770131,
						706770139,
						706770147
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770124,
					"content": "關於魔女小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770125
					]
				},
				{
					"id": 706770125,
					"content": "小狼說的魔女小姐到底是誰呀？明明應該是夢裡的角色，但又好像不只是這樣，好神秘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770126,
					"content": "魔女小姐就是魔女小姐啊，就像客人就是客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770127
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770127,
					"content": "魔女小姐和她的朋友…哦！她的朋友也是魔女小姐。她們都會很厲害的魔法——創造的魔法、幻想的魔法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770128
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770128,
					"content": "用羽毛筆施展魔法的魔女小姐有一個神奇的墨水瓶，裡面裝著「幻想的真實」，我偷偷舔過一小口，味道苦苦的…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770129
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770129,
					"content": "但是其他的魔女小姐都很喜歡她的魔法，所以會用創造的魔法把「幻想的真實」變成「真實的幻想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770130
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770130,
					"content": "到底是怎麼做到的呢？我也搞不清楚，畢竟我只是一隻布偶嘛…用來思考的地方一定是裝滿了棉花和線團…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770131,
					"content": "關於這個房間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770132
					]
				},
				{
					"id": 706770132,
					"content": "我們是從圖書館那扇以前打不開的門進來的，但這裡到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770133,
					"content": "這裡是只有受到邀請的客人才可以進入的特別房間，恭喜兩位客人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770134
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770134,
					"content": "因為兩位有這樣的資格，所以兩位也可以邀請朋友進來坐坐哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770135
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770135,
					"content": "唔…我會盡快把這裡打掃乾淨，然後準備好熱茶和茶點，茶點甜一點可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770136
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770136,
					"content": "當然好啊…不對！我想問的是這裡到底是哪裡呀？我們還在蒙德嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770137,
					"content": "唔…這個問題好難。畢竟是魔女小姐用魔法創造的房間，我又不懂魔法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770138
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770138,
					"content": "不過我以「禮賓員」的身分保證，這裡是安全又舒適的地方！如果兩位能夠在這裡玩得開心，那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770139,
					"content": "關於那本書和剛才的戰鬥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770140
					]
				},
				{
					"id": 706770140,
					"content": "客人的表演真是精彩極了，我都差點看入迷了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770141
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770141,
					"content": "…表演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770142,
					"content": "嗯，魔女小姐說過，故事書的每一頁都是一段「現在」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770143
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770143,
					"content": "一定是因為客人是特別的客人，所以可以作為故事的主角登上舞臺獻上華麗的演出！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770144
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770144,
					"content": "驚心動魄的戰鬥場景…對於某些故事來說是必不可少的香辛料哦！當然，我也很愛看這種故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770145
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770145,
					"content": "如果是講述了客人華麗演出的故事書，要叫什麼標題好呢？戰記、鏖戰錄、征戰記，還是鬥戰篇？真難取捨啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770146
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770146,
					"content": "不管怎麼說，如果客人今後也可以為大家奉上這樣精彩的演出…不，請務必繼續演出，留下更多關於「現在」的故事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770147,
					"content": "沒什麼想問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770148
					]
				},
				{
					"id": 706770148,
					"content": "雖然感覺謎團反而越來越多了…不過小狼看起來也不像是什麼惡棍，應該沒問題吧？再說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770149,
					"content": "漫遊提瓦特，就得靠膽識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770150,
					"content": "哇，是真正的冒險家臺詞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770151
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770151,
					"content": "嘿嘿，那當然了，我們本來就是真正的冒險家嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706770152,
					"content": "作為「禮賓員」，我也得更加努力才行，要讓疲憊的客人在這裡得到療癒，精神百倍地踏上新的冒險旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770153
					],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770153,
					"content": "兩位客人如果覺得累了，也請回到這裡休息一下，我會好好招待兩位的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小狼",
					"speakerSubtitle": "「禮賓員」"
				},
				{
					"id": 706770109,
					"content": "你是聲名遠播人見人愛的榮譽騎士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770110
					]
				}
			]
		}
	]
}