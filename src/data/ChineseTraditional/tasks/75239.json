			"dialogs": [
				{
					"id": 752390101,
					"content": "扎卡那小子…工作沒做完就曠工了，那些玩偶也不知道放哪去了。我非得投訴他不可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "卡內"
				},
				{
					"id": 752390102,
					"content": "什麼玩偶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "是一些以鰭游龍為原型的小玩偶，我在幫它們上色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "卡內"
				},
				{
					"id": 752390104,
					"content": "但是我的徒弟扎卡最近沒來上班，他手上還有三個沒上色的半成品玩偶，也不知道被他放去哪裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "卡內"
				},
				{
					"id": 752390105,
					"content": "#這位客人，{F#妳}{M#你}能幫我找一找它們嗎？我想應該就在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡內"
				}
			]
		},
