				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿金"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080201,
					"content": "#{F#妳}{M#你}拿到史萊姆凝液了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				}
			]
		},
		{
			"id": 2300803,
			"completionStepIds": [
				2300803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300803",
							"2"
						],
						"stepId": 2300803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿金"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "太好了！就是這些，請稍等我一下，馬上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080302,
					"content": "等待了一段時間之後。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "果然，我的猜想沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080304,
					"content": "潮濕的泥土黏合性好，凝固後卻容易斷裂，但和騙騙花的泥土樣本混合之後，凝固後的泥土居然有了一些柔韌性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080305,
					"content": "但這種泥土在凝固前的可塑性很差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080306,
					"content": "但加上史萊姆棲息地的泥土之後，這種泥土在凝固前的可塑性突然好了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080307,
					"content": "我也不知道為什麼，硬要形容的話，就是這種泥土變成了史萊姆一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080308,
					"content": "「史萊姆土」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "我猜是史萊姆的某種特質影響了泥土，所以就在想如果直接加入史萊姆凝液會不會更有效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080312,
					"content": "結果剛剛測試了一下，根據史萊姆凝液加入量的不同，泥土的可塑性與強度都會隨之變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080313,
					"content": "換句話說，不只是建築材料，它還能用來做陶器，還有許多其他東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080314,
					"content": "恭喜你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "謝謝，這就是上面的聰明人常說的「聚沙成塔」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080317,
					"content": "別看這泥土很不起眼，現在也許它真的能造出一座通天高塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080318,
					"content": "我決定把這些混合型的泥土取名為「凝成泥土」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080319,
					"content": "接下來我要做的，就是試驗這種「凝成泥土」能用來做什麼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080320,
					"content": "長時間困擾大家的房屋問題，現在也有解決的希望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080321,
					"content": "#非常感謝{F#妳}{M#你}，旅行者。這些是報酬，請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080315,
					"content": "總算有成果了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "派蒙會喜歡嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "派蒙才不會去吃土咧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}