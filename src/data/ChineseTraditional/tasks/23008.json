			},
			"dialogs": [
				{
					"id": 230080101,
					"content": "也許馬上就要成功了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080102,
					"content": "#旅行者！請{F#妳}{M#你}留步，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "我要找史萊姆凝液！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080106,
					"content": "#事情是這樣的，我這幾天一直在試驗，把{F#妳}{M#你}之前幫我拿回來的泥土用各種比例混合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080107,
					"content": "雖然失敗了很多次…但我最終還是找到了一個可用的混合比例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080108,
					"content": "用這種比例混合出來的「凝成泥土」雖然在凝固前沒什麼可塑性，但凝固後卻堅固耐用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080109,
					"content": "我猜，也許是那種混合了史萊姆凝液的泥土加太少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080110,
					"content": "#旅行者，請{F#妳}{M#你}快去幫我再拿三份史萊姆凝液回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080111,
					"content": "有了這些史萊姆凝液，我一定能做出我想要的泥土！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230080104,
					"content": "你又要找什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
		{
			"id": 2300802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
