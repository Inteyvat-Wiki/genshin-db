						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "沒想到這裡的環境這麼特殊…這樣的話，「普爾希娜光釘」的能源系統…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010202,
					"content": "#嗯？{NICKNAME}和派蒙，真是好久不見了，{F#妳}{M#你}們怎麼也來層岩巨淵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010203,
					"content": "#這麼說來，我之前好像聽海迪夫說過，{F#妳}{M#你}在層岩巨淵幫了勘探隊許多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010204,
					"content": "不過現在的層岩巨淵環境相較之前變得更為惡劣和危險，可不是來散步的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010205,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "我們不是不久之前才剛見過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010207,
					"content": "#雖然每次見面好像都麻煩{F#妳}{M#你}做了很多事，但也沒必要裝作不認識吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010208,
					"content": "算了，那我就再自我介紹一下，我是須彌「教令院」的學者胡塞尼，之前進行「導能圓盤」的研究，還去稻妻進行了考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010209,
					"content": "不過現在研究的經費用完了，所以不得不返回須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010210,
					"content": "哦，我好像有點印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010211,
					"content": "妳想起我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010212,
					"content": "你就是——「圓盤人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010213,
					"content": "…我很確定自己不是什麼「圓盤人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010214,
					"content": "總之，我在回須彌的路上，接到了同為「教令院」學者海迪夫的委託，從前海迪夫幫過我一些忙，主要是研究經費上的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010215,
					"content": "所以這次我就來層岩巨淵幫他解決這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010216,
					"content": "#我解釋得夠清楚了吧，{F#妳}{M#你}們呢，{F#妳}{M#你}們怎麼會在這個時候來層岩巨淵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010217,
					"content": "我們接了海迪夫的委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "#哦哦，原來是{F#妳}{M#你}們。海迪夫之前說想要找人幫忙一起協助的時候，我還感到擔憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010220,
					"content": "#不過既然是{F#妳}{M#你}們的話，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010221,
					"content": "#這次層岩巨淵的黑泥湧出事件，如果只有我一個人來處理，就要耗費更多的精力。有{F#妳}{M#你}們協助，解決的機率就…更高了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010222,
					"content": "需要我們做什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "#{F#妳}{M#你}聽說過「普爾希娜光釘」嗎？能夠釋放擾亂地脈的力量的儀器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010224,
					"content": "按照我的推測，只要在黑泥湧出之處安置「普爾希娜光釘」，擾亂地脈活動，就能夠清理掉黑泥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010225,
					"content": "可是黑泥和地脈有什麼關係啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715010226,
					"content": "因為這些黑泥是隨著地脈的變動出現在這裡的，有很大機率與地脈有關…這是我和海迪夫一起討論出來的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010227,
					"content": "所以利用光釘來擾亂，甚至關閉此處地脈向外接洽的出口，即可停止黑泥的湧出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010228,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "只不過，之前也只不過是用光釘「擾亂地脈」，這次要「完全封閉」，還是第一次嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010230,
					"content": "我經過一些驗算，調整了光釘裡的一些參數，理論上不會出錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010231
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010231,
					"content": "不過理論終究是理論，還是需要進行實驗驗證的，我剛才就在打算進行試啟動，不過，實驗代表著風險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010232
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010232,
					"content": "我來試試吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010233
					]
				},
				{
					"id": 715010233,
					"content": "#嗯…這樣也好，就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010234
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010234,
					"content": "我也會在一邊進行觀測的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715010218,
					"content": "我們是來幫忙的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				}
			]
		}
