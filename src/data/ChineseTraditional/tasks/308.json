			"dialogs": [
				{
					"id": 3081101,
					"content": "呀，小可愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081102,
					"content": "#這麼危險的事{F#妳}{M#你}也來幫忙，真令人感動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081103,
					"content": "這段時間裡有什麼不明白的，都可以來問姐姐喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081104,
					"content": "圖書管理員主要負責做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "嗯，這個問題問得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081106,
					"content": "基本上，就是體力活和腦力活之外的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081107,
					"content": "那究竟是還剩哪一種事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081111,
					"content": "#所以，{F#妳}{M#你}們也可以多信任我一些喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081108,
					"content": "為什麼圖書管理員會來遺蹟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "嗯，這個問題問得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081110,
					"content": "答案嘛，當然是因為琴信任我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "麗莎"
				}
			]
		},
