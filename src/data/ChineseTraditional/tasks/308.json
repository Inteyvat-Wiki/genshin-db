				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "只是在門外，就能感受到元素力亂流所帶來的煩躁感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081302,
					"content": "趕緊奪回這座廟宇，好讓身體舒暢一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"30814",
							"2"
						],
						"stepId": 30814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "東風之龍，南風之獅，北風之狼，西風之鷹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081402,
					"content": "牠們是蒙德四方之風的守護者，也是風神「巴巴托斯」的眷屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081403,
					"content": "特瓦林——這就是風魔龍的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081404,
					"content": "在被人們稱作魔龍以前，牠曾是「四風守護」中的「東風之龍」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081405,
					"content": "這就是，四方之風的力量中，特瓦林只能借用三方的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081406,
					"content": "從一開始，牠就已經在燃盡「自己」了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081407,
					"content": "牠為什麼要這樣做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "我想…是因為「恨」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081410,
					"content": "恨…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081411,
					"content": "是對蒙德的憎恨啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081412,
					"content": "以恨意為驅動、將恨意作為比風更強的力量，化作魔龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081413,
					"content": "可是，「四風守護」之一，為什麼反而會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081414,
					"content": "憎恨牠本該守護的那座城市呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081416,
					"content": "身為蒙德人，真難自己說出口呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081417,
					"content": "拿去看吧…這是百年前發生的故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3081408,
					"content": "牠為什麼要做到這種地步？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
