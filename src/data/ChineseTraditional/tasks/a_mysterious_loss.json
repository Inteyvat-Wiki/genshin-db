					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "你跑回來的時候發生了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "跑回來的時候？我想想啊…具體的情況我是記不清了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270503,
					"content": "對了，我從<color=#00E1FFFF>千風神殿附近</color>跑回來的時候，遇見了很大一群雷史萊姆，一不小心被它們狠撞了幾下，盒子也被撞出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270504,
					"content": "還好我手快把盒子拿了回來。但是我又慌慌張張跑了一段之後…盒子還是丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
