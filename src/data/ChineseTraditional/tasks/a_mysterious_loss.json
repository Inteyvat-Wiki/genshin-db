				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "你去外面做了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "#喂，{F#妳}{M#你}別這麼一副懷疑的表情行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270303,
					"content": "我就是出去外面逛逛散散心而已啊！隕石落下來了之後，我就趕緊回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270304,
					"content": "#好了，{F#妳}{M#你}再去找找吧，<color=#00E1FFFF>真找不到的話，也可以回來找我</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270305,
					"content": "我再努力回憶回憶，看能不能想起什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
