			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "完蛋了完蛋了，這下慘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270102,
					"content": "你怎麼了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "唉，這不是天天待在這太無聊了，還成天被修女白眼，我就想出去逛逛散散心嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270104,
					"content": "我剛出城去，想到千風神殿附近逛逛，但還沒等我到那裡…天上突然就開始劈裡啪啦往下落隕石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270105,
					"content": "我這哪還敢多待，急匆匆地就跑回來，但回來一看…我弄丟了一個盒子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270106,
					"content": "現在外面那麼亂，我也不敢出去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270107,
					"content": "而且…我這個「愚人眾」，要是在這個時間裡敢亂動，指不定又要被懷疑成什麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270108,
					"content": "#行了，廢話也不多說了，{F#妳}{M#你}能不能幫我去找找那個東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270109,
					"content": "#前幾次「交易」我們都挺愉快的，這次我也肯定不會虧待{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270110,
					"content": "不要說這種可疑的話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "#什麼…怎麼就可疑了？我不就是跟{F#妳}{M#你}講了點故事嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270112,
					"content": "#好了好了，{F#妳}{M#你}就說，願不願意幫我這個忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
		{
