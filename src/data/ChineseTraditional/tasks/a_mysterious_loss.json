			},
			"dialogs": [
				{
					"id": 411270201,
					"content": "#怎麼？{F#妳}{M#你}還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270202,
					"content": "沒有線索真的不好找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "#呃，好吧，那{F#妳}{M#你}等會，我回憶一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270204,
					"content": "我是真想不起來了，好像也沒什麼特別的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270205,
					"content": "那我問你點問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "#問題？也行，{F#妳}{M#你}要問什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
