					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "盒子裡裝了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "#呃，{F#妳}{M#你}這就別管了，就是一點小玩意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270403,
					"content": "喂！別用這種懷疑的眼神看著我啊！我又不是什麼壞人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270404,
					"content": "但你是愚人眾啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "#愚人眾…愚人眾就都是可疑的人嗎？{F#妳}{M#你}這是哪裡得來的結論！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270406,
					"content": "#好了，{F#妳}{M#你}再去找找吧，<color=#00E1FFFF>真找不到的話，也可以回來找我</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 411270407,
					"content": "我再努力回憶回憶，看能不能想起什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				}
			]
		},
