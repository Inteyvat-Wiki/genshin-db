			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "雖然她話是這麼說，但是前面的怪物很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400502,
					"content": "我們去幫芬德小姐掃除一下周圍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400503,
					"content": "看她認真的樣子，搞不好會想著直接衝過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400504,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "嗯，認真的人就應該得到幫助呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400505,
					"content": "真有人會認真到這種地步嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "那種是最糟糕的情況啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400508,
					"content": "為了不讓這種情況發生，我們快點去掃除魔物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
