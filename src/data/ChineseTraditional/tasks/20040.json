				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "唉，到底怎麼過去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400102,
					"content": "哦…您找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400103,
					"content": "您在這做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "我正準備去望風角的瞭望塔，去看看海上是不是有風暴在聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400105,
					"content": "可是前面有一群怪物擋住了路…我在思考怎麼過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400106,
					"content": "哦，不用擔心，我沒有讓您代我去瞭望的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400107,
					"content": "這是我的職責，也是我個人的堅持而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400108,
					"content": "您忙您的去吧，我自己再好好想想辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
			"id": 2004002,
