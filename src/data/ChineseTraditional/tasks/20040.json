				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "嗯…今天也是風平浪靜的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400402,
					"content": "我的家族受到溫妮莎大人命令，世代在此為蒙德守望風暴，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400403,
					"content": "雖然自從有了巴巴托斯大人的庇護，蒙德再也沒有受到風暴的侵擾，瞭望台也逐漸廢置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400404,
					"content": "但即使是這樣，我還是會不由自主地想去瞭望塔上看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400405,
					"content": "辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "#謝謝{F#妳}{M#你}，但是說到我的「職責」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400407,
					"content": "我倒寧願永遠不去真正履行它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400410,
					"content": "好了，謝謝您幫我，這些風車菊是給您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400411,
					"content": "在之前，我的家族常以風車菊的生長程度，來判斷一個地區的風力大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400412,
					"content": "絲毫無風的地方，或者暴風侵襲的地方，都不會有風車菊存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400413,
					"content": "只有在蒙德這樣溫柔的風中，它才會順利地生長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400414,
					"content": "真希望，它們能一直這麼順利地生長下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400408,
					"content": "是很辛苦的歷史啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "是的，希望那段歷史永遠不再重演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "芬德"
				}
			]
		},
