			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "您還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400202,
					"content": "前面已經安全了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "咦？感謝風神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400204,
					"content": "不，不對，抱歉，我應該感謝的是您才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400205,
					"content": "我該怎麼回報您呢…哦，對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400206,
					"content": "請您來瞭望塔頂吧，我在那等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
			"id": 2004003,
