				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "關於放在水邊的奇怪物件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "#嗯？{F#妳}{M#你}把那個東西放在水邊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500803,
					"content": "怎麼樣，有發生什麼特殊反應之類的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500804,
					"content": "出現了岩龍蜥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "岩龍蜥？那個東西放到水裡變成了岩龍蜥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500806,
					"content": "喔，不是那個東西變成的，而是岩龍蜥看到那個東西之後就游出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500807,
					"content": "嚇了我一跳，要是這個東西入水直接變成岩龍蜥，那我的世界觀的立柱都要崩塌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500808,
					"content": "那個東西到底是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "說來也簡單，該怎麼說明好呢，這樣吧，讓我先猜一猜，那隻岩龍蜥，有沒有什麼特別之處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500810,
					"content": "比如說，元素附著屬性是水之類的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500811,
					"content": "好像是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "那就對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500816,
					"content": "那隻岩龍蜥應該可以調用水元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500817,
					"content": "#層岩巨淵的地下水，水元素含量很高，特殊的聚集點就會養出類似{F#妳}{M#你}釣上來的水草一樣的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500818,
					"content": "岩龍蜥，當然了，其他生長在層岩巨淵的親水生物也一樣，靠食用這種富含水元素的水草來提升自己的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500819,
					"content": "所以那個東西其實就是…富含水元素的水草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500820,
					"content": "只是水草嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "嗯，就是水草，不過富有如此元素量的水草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500822,
					"content": "正常環境可長不出來，除非有什麼非常純淨又巨大的能量影響了水源…不說這個了，這些水草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500823,
					"content": "說不定有一天也會生出意識變成元素生物，真是值得好好研究一番啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500813,
					"content": "沒看見…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#難道是因為解決得太快了所以根本沒在意到嗎…真是厲害啊，不愧是傳說中的{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500815,
					"content": "不過根據我的推測…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "海迪夫"
				}
			]
		}
	]
}