			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"察列維奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "真是倒楣透了！西風騎士團真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "哼，西風騎士團辦事真是沒效率，說前頭有魔物，不讓我通過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000104,
					"content": "但是到現在他們也沒傳信過來給個答覆，真是靠不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000105,
					"content": "我還有一堆事要處理，這折合下來，我得損失多少錢啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000106,
					"content": "#不過…看{F#妳}{M#你}的樣子倒像是個冒險家，這樣吧…我付{F#妳}{M#你}錢，{F#妳}{M#你}幫我去辦點事，{F#妳}{M#你}願意不願意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000107,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "#很好，我就喜歡爽快的人，事情辦好之後，我絕不會虧待{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000111,
					"content": "也不知道是不是我的錯覺，這蒙德的丘丘人感覺是越來越多了，哼，西風騎士團，也不知道一天到晚在做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000112,
					"content": "#{F#妳}{M#你}既然答應了幫我辦事，那{F#妳}{M#你}正好幫我去清理丘丘人。但{F#妳}{M#你}也只有一個人，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000113,
					"content": "#算了，{F#妳}{M#你}自己選一個地方去清理吧，山頂、山腰和山底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000114,
					"content": "反正都是去清理丘丘人，沒什麼差別，趕緊選，別浪費我時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000109,
					"content": "能給多少錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "#哼，那就要看{F#妳}{M#你}辦事的樣子了，只要事情辦好，我絕不會虧待{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "察列維奇"
				}
			]
		},
