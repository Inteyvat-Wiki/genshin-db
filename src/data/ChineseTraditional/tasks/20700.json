			"dialogs": [
				{
					"id": 207000304,
					"content": "已經辦好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "#拖拖拉拉，和西風騎士團一個德性，我說了給{F#妳}{M#你}一分鐘，{F#妳}{M#你}是忘了還是壓根沒聽進去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000306,
					"content": "哼，這麼點簡單的細節都不在意…1000摩拉拿好，該幹嘛幹嘛去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
