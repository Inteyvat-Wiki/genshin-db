			"dialogs": [
				{
					"id": 207000201,
					"content": "已經辦好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "這麼快就回來了，還沒到一分鐘就全部解決了，身手不凡，身手不凡呐，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000203,
					"content": "不錯不錯，5000摩拉，一分不少，拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000204,
					"content": "身手不凡也才5000摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207000205,
					"content": "可別嫌少，這酬勞可是我仔細算過的，和你們的工作剛好相稱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "察列維奇"
				},
				{
					"id": 207000206,
					"content": "想要賺大錢，就得辦點大事，下次有機會的話，你們再努努力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "察列維奇"
				}
			]
		},
