			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭非拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "#嗯？是{F#妳}{M#你}啊。好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220302,
					"content": "哎呀，這裡是哪裡，是什麼山洞裡嗎…唔，感覺有點暈暈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220303,
					"content": "你是誰，你怎麼睡在這裡啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220304,
					"content": "我是誰…唔，頭暈暈的，讓我想想…我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220305,
					"content": "我的名字是蘭非拉，嘿嘿，我想起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220306,
					"content": "原來你就是蘭非拉呀！我們還說你跑到哪裡去了，原來躲在這個山洞裡睡覺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220307,
					"content": "#蘭非拉…{F#妳}{M#你}們居然知道我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220308,
					"content": "咦，是那菈！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220309,
					"content": "完全醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220310,
					"content": "完全醒過來了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "嗚嗚，我還沒有準備好，不要把我煮成粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220312,
					"content": "啊？怎麼會有人想要把你煮成粥？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220313,
					"content": "妹、妹妹說過，如果我老是迷迷糊糊，就會被壞那菈抓走，煮成雜燴粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220314,
					"content": "你看起來很好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "嗚哇啊啊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220316,
					"content": "#喂！{NICKNAME}，不要開這種玩笑！蘭非拉，沒有人會把你煮成粥的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220318,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220319,
					"content": "真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220320,
					"content": "真的是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220321,
					"content": "#不騙你啦。我叫派蒙，這位高高的那菈是{NICKNAME}。是蘭帕卡提叫我們來找你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220322,
					"content": "蘭帕卡提？她還好嗎？我在這裡待了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220323,
					"content": "多久？我記得好像是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220324,
					"content": "我想想…很多很多個月亮以前，幼苗鑽出土，長成了大樹，有多少個蘭帕卡提高…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220325,
					"content": "七個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#喔！不愧是{NICKNAME}，記憶力真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220329,
					"content": "哎呀，已經過了這麼久了嗎？糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220330,
					"content": "總之，事情是這樣的。無憂節要開始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220331,
					"content": "向蘭非拉述說事情的經過。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "啊，原來要過無憂節了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220333,
					"content": "是啊，所以蘭帕卡提要你回桓那蘭那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220334,
					"content": "哎呀…可是我現在還沒完成我的「烹飪修行」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220335,
					"content": "咦？你不是在睡覺嗎？我還以為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220336,
					"content": "「睡覺」？啊，只是在想以前的事情。沒到那麼嚴重的地步啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220337,
					"content": "對蘭那羅來說，睡覺是很嚴重的事情喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220338,
					"content": "嗯…該怎麼說呢。在性命垂危的時候，我們會「休眠」。然後，把所有的記憶和夢都壓縮成一顆「種子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220339,
					"content": "如果危機過去了。如果有緣分，那種子就能回到森林中。然後，在機緣合適的時候，再度長成蘭那羅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220340,
					"content": "聽起來很嚴苛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "#不過，我知道。那菈是要睡覺的。以前，我也有一個那菈朋友。和{F#妳}{M#你}一樣，金燦燦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220345,
					"content": "#以前，我和{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也到過這裡，為了摘到「鮮嫩無朋之果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220346,
					"content": "#所以，我一直來這裡採果實。如果{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}回來了，或者是，遇到了新的那菈朋友，就可以一起吃果實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220347,
					"content": "這次，我也摘到了好多「鮮嫩無朋之果」…咦，怎麼就剩這麼點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220348,
					"content": "原來我們看到，散在路上的日落果，全是你掉的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220349,
					"content": "掉了好多嗎…唔，不過沒有關係，嘿嘿，最鮮嫩，最好吃的果子還留在我身上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220350,
					"content": "唔…到底是為什麼掉了那麼多果子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220351,
					"content": "我記得我和幾個哥哥們一起出來進行「烹飪修行」，但是他們都不知道，其實鮮嫩的果子就是最好的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220352,
					"content": "不過就在我摘果子的時候…對，就在我摘果子的時候，突然出現了一個好大好大的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220353,
					"content": "大怪物，有著五個蘭非拉那麼高，尾巴長長，走起路來連大地都在震顫。而且，裡面還有有點像「無留陀」的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220354,
					"content": "而且，好硬好硬。可能，就連蘭羅摩、蘭百梨迦，都要用一點力氣才能拆掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220355,
					"content": "什麼？他們有這麼強嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220356,
					"content": "#嗯。但是，我沒有那麼強。所以，我只好躲在這裡。一邊想著過去的事情，一邊等它走。回過神來，就看到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220357,
					"content": "有這樣可怕的大怪物在外，我可不想出去。對不起，「妹妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220358,
					"content": "不行，無憂節快開了，你得回去才行呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220359,
					"content": "無憂節無憂，而走出山洞就有性命之憂…呼呼…不能因為無憂節而有憂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220360,
					"content": "呼呼——呼呼——那菈法留納…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220361,
					"content": "啊，這個傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220362,
					"content": "#{NICKNAME}，這下該怎麼辦呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220363,
					"content": "解決大怪物吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "…再可怕應該不會有風魔龍可怕吧。不知道蘭那羅見到風魔龍的話，會怎麼形容呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220366,
					"content": "「有一百萬個蘭非拉高！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "「從尾巴走到頭，要從月亮升起，到月亮落下！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220368,
					"content": "總之，去解決外面的怪物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220364,
					"content": "哎呀，大怪物，好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "聽起來真方便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "派蒙，妳能變成種子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "#{F#妳}{M#你}對我有什麼不滿嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220327,
					"content": "派蒙記憶力真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220317,
					"content": "沒有人會把你煮成粥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
