				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "唔…這就開始用「鮮嫩無朋之果」來做料理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220602,
					"content": "這個「鮮嫩無朋之果」，到底和普通的果子有什麼區別呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220603,
					"content": "我知道的。在那菈看來，果實都一樣。但其實，是不同的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220604,
					"content": "「鮮嫩無朋之果」，是強壯的樹才能結出來的。強壯的樹，當風吹來的時候，會率先唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220605,
					"content": "強壯的樹生出的孩子，就是給我們的恩惠。也就是「鮮嫩無朋之果」。那菈朋友說，這種果子在肚子裡就像會唱歌一樣好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220606,
					"content": "好期待啊，用這個果子，能做出什麼樣的美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220607,
					"content": "#蘭非拉立刻開始烹飪…\\n他將手中的果子分成數份…\\n隨後，蘭非拉將其中的幾份交給{F#妳}{M#你}們品嚐。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "一起品嚐了新鮮的果實。\\n應該說是符合預期吧，確實是新鮮水果的滋味。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "真好。謝謝你，強壯的樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220610,
					"content": "等等，這也算是烹飪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220611,
					"content": "「鮮嫩無朋之果」自身就是最高級的「至上珍饈」，不需要任何加工，就有最完美的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220612,
					"content": "多說無益，只要進行品嚐就能夠清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220613,
					"content": "雖然確實好吃，就像、就像在吃水果一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220614,
					"content": "這本來就是水果啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "倒也沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220616,
					"content": "#{F#妳}{M#你}們那菈不也有那種，只把果子切開，擺在盤子裡，就放在木頭平臺上的菜餚嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220617,
					"content": "咦，有嗎…等等，你說的是果盤吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220618,
					"content": "果盤算是菜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220619,
					"content": "應該算是吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "總覺得把果盤當做菜有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220623,
					"content": "唔…不要拘泥於這樣的形式嘛，尋找更好的食材，本身也是一種烹飪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220624,
					"content": "尋找食材的過程中，就可以到森林的各個地方去，親近森林，這才是「烹飪修行」的真義嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220625,
					"content": "是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220626,
					"content": "就是這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220627,
					"content": "這下摘到了「鮮嫩無朋之果」，我也做出了「至上珍饈」，這次「烹飪修行」也結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220628,
					"content": "就能正大光明回桓那蘭那了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220629,
					"content": "#唔…被大怪物堵在山洞裡，要是沒有那菈{NICKNAME}和派蒙，肯定會錯過這次無憂節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220630,
					"content": "好啦，你也快點回桓那蘭那吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220631,
					"content": "確實確實…錯過無憂節，一定會被妹妹訓斥…想想就害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220621,
					"content": "應該不算吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "就是說呀，感覺都沒有經過什麼…處理工法，被叫做菜很奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "派蒙"
				}
			]
		},
