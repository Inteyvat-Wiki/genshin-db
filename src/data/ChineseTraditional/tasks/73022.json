			},
			"dialogs": [
				{
					"id": 730220101,
					"content": "你好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220102,
					"content": "呼呼——呼呼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220103,
					"content": "喂！你好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220104,
					"content": "唔嗯。好果子。呼呼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220105,
					"content": "可惡，睡得好沉。唔…對了，蘭帕卡提說過，用<color=#00E1FFFF>草元素的力量</color>，應該可以讓他恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220106,
					"content": "#{NICKNAME}，就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"73022"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭非拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "#嗯？是{F#妳}{M#你}啊。好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220202,
					"content": "哎呀，這裡是哪裡，是什麼山洞裡嗎…唔，感覺有點暈暈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220203,
					"content": "你是誰，你怎麼睡在這裡啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220204,
					"content": "我是誰…唔，頭暈暈的，讓我想想…我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220205,
					"content": "我的名字是蘭非拉，嘿嘿，我想起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220206,
					"content": "原來你就是蘭非拉呀！我們還說你跑到哪裡去了，原來躲在這個山洞裡睡覺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220207,
					"content": "#蘭非拉…{F#妳}{M#你}們居然知道我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220208,
					"content": "咦，是那菈！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220209,
					"content": "完全醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220210,
					"content": "完全醒過來了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "嗚嗚，我還沒有準備好，不要把我煮成粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220212,
					"content": "啊？怎麼會有人想要把你煮成粥？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220213,
					"content": "妹、妹妹說過，如果我老是迷迷糊糊，就會被壞那菈抓走，煮成雜燴粥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220214,
					"content": "你看起來很好吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "嗚哇啊啊啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220216,
					"content": "#喂！{NICKNAME}，不要開這種玩笑！蘭非拉，沒有人會把你煮成粥的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220218,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220219,
					"content": "真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220220,
					"content": "真的是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220221,
					"content": "#不騙你啦。我叫派蒙，這位高高的那菈是{NICKNAME}。是蘭帕卡提叫我們來找你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220222,
					"content": "蘭帕卡提？她還好嗎？我在這裡待了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220223,
					"content": "多久？我記得好像是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220224,
					"content": "我想想…很多很多個月亮以前，幼苗鑽出土，長成了大樹，有多少個蘭帕卡提高…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220225,
					"content": "七個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#喔！不愧是{NICKNAME}，記憶力真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220229,
					"content": "哎呀，已經過了這麼久了嗎？糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220230,
					"content": "總之，事情是這樣的。無憂節要開始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220231,
					"content": "向蘭非拉述說事情的經過。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "啊，原來要過無憂節了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220233,
					"content": "是啊，所以蘭帕卡提要你回桓那蘭那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220234,
					"content": "哎呀…可是我現在還沒完成我的「烹飪修行」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220235,
					"content": "咦？你不是在睡覺嗎，我還以為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220236,
					"content": "「睡覺」？啊，只是在想以前的事情。沒到那麼嚴重的地步啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220237,
					"content": "對蘭那羅來說，睡覺是很嚴重的事情喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220238,
					"content": "嗯…該怎麼說呢。在性命垂危的時候，我們會「休眠」。然後，把所有的記憶和夢都壓縮成一顆「種子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220239,
					"content": "如果危機過去了。如果有緣分，那種子就能回到森林中。然後，在機緣合適的時候，再度長成蘭那羅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220240,
					"content": "聽起來很嚴苛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "#不過，我知道。那菈是要睡覺的。以前，我也有一個那菈朋友。和{F#妳}{M#你}一樣，金燦燦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220245,
					"content": "#以前，我和{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也到過這裡，為了摘到「鮮嫩無朋之果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220246,
					"content": "#所以，我一直來這裡採果實。如果{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}回來了，或者是，遇到了新的那菈朋友，就可以一起吃果實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220247,
					"content": "這次，我也摘到了好多「鮮嫩無朋之果」…咦，怎麼就剩這麼點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220248,
					"content": "原來我們看到，散在路上的日落果，全是你掉的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220249,
					"content": "掉了好多嗎…唔，不過沒有關係，嘿嘿，最鮮嫩，最好吃的果子還留在我身上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220250,
					"content": "唔…到底是為什麼掉了那麼多果子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220251,
					"content": "我記得我和幾個哥哥們一起出來進行「烹飪修行」，但是他們都不知道，其實鮮嫩的果子就是最好的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220252,
					"content": "不過就在我摘果子的時候…對，就在我摘果子的時候，突然出現了一個好大好大的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220253,
					"content": "大怪物，有著五個蘭非拉那麼高，尾巴長長，走起路來連大地都在震顫。而且，裡面還有有點像「無留陀」的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220254,
					"content": "而且，好硬好硬。可能，就連蘭羅摩、蘭百梨迦，都要用一點力氣才能拆掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220255,
					"content": "什麼？他們有這麼強嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220256,
					"content": "#嗯。但是，我沒有那麼強。所以，我只好躲在這裡。一邊想著過去的事情，一邊等它走。回過神來，就看到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220257,
					"content": "這麼說來，在我們來的路上，確實遇到了「遺蹟龍獸」，你說的大怪物是它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220258,
					"content": "那菈是這樣稱呼它的嗎…？或許是吧。應該是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220259,
					"content": "已經處理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#喔喔。沒想到，看起來沒有大怪物大的那菈{NICKNAME}，居然有這樣的力量。好強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220265,
					"content": "嗯。那我們出發吧。好那菈，我們一起吃果實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220260,
					"content": "哎呀，大怪物，好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "…有這麼可怕嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220262,
					"content": "嗯嗯。看來那菈也明白，是可怕的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730220263,
					"content": "#不用擔心啦。見到你之前，{NICKNAME}已經把那個大怪物打敗啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220241,
					"content": "聽起來真方便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "派蒙，妳能變成種子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "#{F#妳}{M#你}對我有什麼不滿嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220227,
					"content": "派蒙記憶力真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730220217,
					"content": "沒有人會把你煮成粥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
