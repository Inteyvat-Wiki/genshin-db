						],
						"pointId": 8161
					},
					{
						"sceneId": 3,
						"position": [
							-3014.803,
							380.927,
							8549.981
						],
						"pointId": 8670
					},
					{
						"sceneId": 3,
						"position": [
							-3014.679,
							380.789,
							8548.529
						],
						"pointId": 8671
					}
				]
			},
			"dialogs": [
				{
					"id": 750110101,
					"content": "原來這裡就是「浮土靜界」。從下面往上看的時候，還以為上面會是灰灰一片，什麼都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "沒想到是這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110104,
					"content": "嗯，據說這裡的浮土本身都是用燃素的力量聚合在一起的，燃素本身也是一種生命力非常旺盛的能源…能源有點怪，但先這樣理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110105,
					"content": "所以上面也能夠長出花草、能夠讓冷卻的土地重新溫熱、能夠在黑暗之中點亮熾燃靈魂的火光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110106,
					"content": "這就是「燃素」…是由「盜火賢者」從巨龍的手中搶奪至我們手中的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110107,
					"content": "說到這個，我想到有點生氣的事情，哼，部族裡有些人啊，看到「浮土靜界」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110108,
					"content": "就說人類使用燃素絕對達不到能夠造出浮島的程度，所謂的「盜火賢者」其實也是巨龍之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110109,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "還有這種觀點？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "自己做不到就說能夠做到的人「其實不是人哦」，真是沒有志氣的傢伙，我才不要和他們做朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110114,
					"content": "啊，對了，寶藏跟秘藥呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110115,
					"content": "從這個意義上來說，這裡看起來什麼都沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110116,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "嘿嘿，這可是那個被稱為瘋子的「盜火賢者」的試煉，怎麼可能這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110118,
					"content": "按照古織卷裡的說法，現在我們要啟動一些機關、完成最後的試煉，就可以達到「浮土靜界」的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110119,
					"content": "不過我也不知道所謂「浮土靜界」的中心長怎樣，總覺得記憶中看到的浮島圖片，和現在看到的有點差距…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110120,
					"content": "不過有可能是年紀到了，連原本引以為傲的記憶都變得不可靠了。不過沒關係…都已經到這裡了，就靠著直覺來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110121,
					"content": "那麼，機關如何開啟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "嗯，應該也和「燃素刻錄」一樣，使用燃素的話就可以打開了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110123,
					"content": "至少古卷上是這樣畫的，據說遍布納塔的「燃素刻印碑」其實就是以這裡的機關為原型製作的…機關也是了不得的古物哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110124,
					"content": "#前途無量的{M#少年}{F#少女}，哼哼，快去試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇科婭"
				},
				{
					"id": 750110111,
					"content": "觀點是自由的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "我知道，別人對於世界的想法其實都是很難撼動的，不過還是很火大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "奇科婭"
				}
			]
		},
