			"dialogs": [
				{
					"id": 790730101,
					"content": "歡迎！尊敬的客人，歡迎您來到「賜福森林」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730102
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730102,
					"content": "您是來森林裡旅行，還是準備去參觀雨歌塘的跳躍比賽？無論如何，都祝您開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "許迪"
				}
			]
		},
		{
			"id": 7907303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"許迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730301,
					"content": "您也要記得避開那隻不知道何時會前來造訪的巨龍！千萬不要讓他耽誤了您的行程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730302
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730302,
					"content": "唉…我之前還想說要送那位龍一些「紙模」…這樣也許會讓他心情好一點，不要再來吹翻我的架子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730303
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730303,
					"content": "但是…那位龍明顯不願意聽我叫喊，每次都自顧自地飛走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "許迪"
				}
			]
		},
		{
			"id": 7907304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"許迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730401,
					"content": "如今，我們也不用擔心有一隻巨龍突然前來造訪了。不得不說，您來得正是時候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730402
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730402,
					"content": "我聽說那位龍的脾氣如今可是很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730403
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730403,
					"content": "我正打算帶著一些「紙模」去看望他，希望那位龍會喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "許迪"
				}
			]
		},
		{
			"id": 7907305,
			"completionStepIds": [
				7907301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"許迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730501,
					"content": "喔！天啊，我竟然忘記為您介紹我的傑出作品，還有這座傑出的架子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730502
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730502,
					"content": "請您看向這裡！看看這臺「贈禮箱」，我迄今為止製作過的所有紙模都在裡面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730503
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730503,
					"content": "為了製作紙模，我走…喔，應該說是「跳」遍了整個世界，也結交了無數朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730504
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730504,
					"content": "例如總是想抓我去風場裡嘗試飛行的飛鼠克朗謝、和我一樣喜歡做模型的德維特…當然啦，還有那位總是板著一張臉的埃洛夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730505
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730505,
					"content": "他們都很慷慨，願意讓我以他們為原型製作紙模，把這有趣的小玩意與大家分享！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730506
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730506,
					"content": "來，拿著這些「星遊幣」，就當作是我對您的歡迎禮吧。把星遊幣塞進這臺「贈禮箱」裡，轉動把手，看看露珠會賜予您什麼禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730507
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730507,
					"content": "但是如果您用完了這些硬幣之後，還想繼續轉動「贈禮箱」的話，就要自己想辦法拿到硬幣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730508
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730508,
					"content": "至於怎麼拿到硬幣…哈哈哈，您可以去問問我那些好朋友們，他們會有主意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730509
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730509,
					"content": "拿到禮物之後，您可以把禮物擺在我身後這座好架子上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730510
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730510,
					"content": "認真地說，這座架子才是我製作「贈禮箱」和「紙模」的動力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730511
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730511,
					"content": "但這就要講到一個不那麼簡潔的故事了…如果您希望的話，我之後也願意講給您聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730512
					],
					"speakerTitle": "許迪"
				},
				{
					"id": 790730512,
					"content": "現在，就請您轉動「贈禮箱」吧，露珠在上，祝您拿到心儀的禮物，也拿到一整天的好心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "許迪"
				}
			]
		}
	]
}