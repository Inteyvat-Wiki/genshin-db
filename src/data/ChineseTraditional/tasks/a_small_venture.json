			"dialogs": [
				{
					"id": 761390101,
					"content": "出版業也不賺錢啊，不然乾脆只做投資算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390102,
					"content": "想看看投資券…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "好，投資券2000摩拉一張，每星期結算一次，嘿嘿，這個小袋子裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390104,
					"content": "…呃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390105,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "沒、沒什麼，只是不知道奈芙爾老闆也大駕光臨，您…您也想買張投資券嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390107,
					"content": "我就不了，只是陪我這位朋友過來看看而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390108,
					"content": "聽說薩維特老闆的投資生意做得有聲有色，今天一看，果然如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390109,
					"content": "普通！普通，哈哈哈…小本生意，餬口罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390110,
					"content": "這真的賺得了錢嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "那是當然的，薩維特老闆可是位優秀的生意人，跟著他投資不會虧的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390112,
					"content": "是…是…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390113,
					"content": "看看我今天運氣怎麼樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "今天！就在今天，您剛才買的是我們剛剛推出的…短線投資券！盈虧立即結算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390115,
					"content": "怎麼感覺這些話都是你剛剛才編出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761390116,
					"content": "呃…總、總之，感謝您購買短線投資券！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390117,
					"content": "這是您的投資回報，祝您擁有美好的一天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390118,
					"content": "總之賺錢是好事啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "#真的？嘿嘿嘿，那{F#妳}{M#你}買一個小鳥形狀的給我，我喜歡那種的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761390121,
					"content": "那我也告辭了。薩維特老闆果然是個有信譽的好商人，祝您生意興隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390122,
					"content": "借奈芙爾老闆吉言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390123,
					"content": "然後…奈芙爾老闆，上次我拜託您幫忙找的那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390124,
					"content": "東西是已經找到了，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390125,
					"content": "薩維特先生，不要心急。事情，要一步一步地做才穩當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761390126,
					"content": "是、是，奈芙爾老闆說得是…那就麻煩了，我就指望您了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩維特"
				},
				{
					"id": 761390119,
					"content": "走，派蒙，我們去買糖雕吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				}
			]
