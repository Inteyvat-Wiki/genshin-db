				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "#唉，果然{F#妳}{M#你}也不行嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750102,
					"content": "果、果然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750103,
					"content": "#只是想看看{NICKNAME}作為騎士團超級新人，究竟夠不夠分量啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750104,
					"content": "#{F#妳}{M#你}看，勇者順手就取走了村子裡名貴的寶劍——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750105,
					"content": "這不是非常適合傳唱的故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750106,
					"content": "哼，感覺你的比喻很失禮啊，吟遊詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750107,
					"content": "哎呀，妳誤會我了。這是對蒙德的失望，面對勇者卻還要吝嗇寶劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750108,
					"content": "那麼，看來明借是行不通的，只能巧取了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750110,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "#今天我們充分尊重自由意志，{F#妳}{M#你}們說說喜歡怎樣巧取？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750112,
					"content": "其實我不想偷東西！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "說吧，不要拘束，自由意志就是要暢所欲言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750113,
					"content": "#啊哈哈，{F#妳}{M#你}看{F#妳}{M#你}，一開口就跑題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750114,
					"content": "#認真地說，這件事{F#妳}{M#你}比我更適合去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750115,
					"content": "因為我除了唱歌，就沒什麼值得自信的長處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750116,
					"content": "而且我在蒙德無依無靠，被抓住了無人申冤，一定會從重處罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750117,
					"content": "偷東西被抓住了也沒什麼冤枉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750118,
					"content": "#但{NICKNAME}不同。{F#妳}{M#你}是為蒙德城作過貢獻的，騎士團的明日之星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750119,
					"content": "失手了以後好好解釋一下，或許就能蒙混過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750140,
					"content": "而且這裡的守衛，似乎在夜裡就會下班了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750141,
					"content": "哎呀，如果能抓住這個時機，想要失手都很難吶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750120,
					"content": "是以失手為前提來考慮的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750122,
					"content": "你剛才說自己是巴巴托斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}…{F#妳}{M#你}覺得怎樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750123,
					"content": "啊呀，好像是這麼說過——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750125,
					"content": "如果你真的是神，就不能放著不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "所以呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750126,
					"content": "哦？這是為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3750128,
					"content": "如果你不是神，我也會救特瓦林。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#有關{NICKNAME}的過去，以後再慢慢跟你說吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3750130,
					"content": "我會為你帶回「天空」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "因為我不想再見到「分離」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "溫迪"
				}
			]
		},
