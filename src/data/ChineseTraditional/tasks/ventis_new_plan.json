			"dialogs": [
				{
					"id": 3750202,
					"content": "#麻煩啊，這地下室入口真的需要在整個<color=#00E1FFFF>白天</color>一直守衛嗎…\\n喂！{F#妳}{M#你}站住，這裡禁止通行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
