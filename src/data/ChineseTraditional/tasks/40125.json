			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯萊",
					"優菈",
					"萊斯格",
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "如果從阿如村走的話…就能夠途經喀萬驛，禪那園…繞道去須彌城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401251202,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401251203,
					"content": "要順路買什麼東西嗎？妳們只管選禮物，我來負責提！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "萊斯格"
				},
				{
					"id": 401251204,
					"content": "只要手裡拿得下，多重都沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "萊斯格"
				},
				{
					"id": 401251205,
					"content": "哪有那麼多人要送…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401251206,
					"content": "媽媽、阿貝多哥哥、琴團長、雷澤…還有迪奧娜姐姐、莫娜姐姐、菲謝爾姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251207,
					"content": "看我幹嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401251208,
					"content": "沒什麼、沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401251209,
					"content": "可莉想幫大家選什麼樣的禮物呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401251210,
					"content": "要…要日落果味道的糖！還有蕈獸那樣的大帽子，還有還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251211,
					"content": "可莉要買很多很多故事書送給大家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251212,
					"content": "但送給媽媽的禮物，可莉還沒想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251213,
					"content": "沒關係，邊走邊看，姐姐們也會幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401251214,
					"content": "嗯！謝謝姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		}
	]
