			"dialogs": [
				{
					"id": 401251101,
					"content": "珊瑚宮小姐不打算把那個貝殼帶回去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401251102,
					"content": "我反倒覺得，保存在伊迪婭小姐這裡會更適合些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401251103,
					"content": "如今的海祇島已經有了新的「寶物」，人們的願望也正慢慢被實現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401251104,
					"content": "不如就讓它守護著這瓶中的蜃境，陪伴著路過旅人們的夢想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
