			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"諾拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "嗚…怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "#{F#妳}{M#你}看見風神像了嗎？往上看，很高很高的地方…就是風神大人手的那個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580104,
					"content": "我想要上去玩…但是，葛瑞絲阿姨一定不會讓我爬上去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580105,
					"content": "#拜託拜託，拜託{F#妳}{M#你}去和葛瑞絲阿姨說話吧，別讓她看過來，我爬得很快，一下子就能爬上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580106,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "#那就拜託{F#妳}{M#你}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580110,
					"content": "#總之，就拜託{F#妳}{M#你}葛瑞絲阿姨了，我這就去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580111,
					"content": "諾拉，不准去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200580112,
					"content": "呼…稍微走神了一會，她居然來麻煩您了，抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200580113,
					"content": "怎麼這樣！只是上去玩一玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580114,
					"content": "不行就是不行，妳父親也不會允許的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200580115,
					"content": "還有您，請您也別遷就她。要是您做這種危險的事情，肯定也有人會擔心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 200580108,
					"content": "太危險了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "沒關係啦，我可是很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "諾拉"
				}
			]
		},
		{
			"id": 2005802,
			"completionStepIds": [
				2005802
			],
