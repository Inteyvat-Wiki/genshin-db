					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200581107,
					"content": "#謝謝{F#妳}{M#你}啦，這些給{F#妳}{M#你}，是我悄悄搜集的寶物，就給{F#妳}{M#你}做禮物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581108
