					"content": "可以的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "那我要快點長大，等爸爸工作完了，我就要和他一起去玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "諾拉"
				},
				{
