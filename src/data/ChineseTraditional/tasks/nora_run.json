			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"諾拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580202,
					"content": "要上去做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "葛瑞絲阿姨說，如果想要向誰說悄悄話，只要告訴蒲公英，然後撒出去，風神大人就會把蒲公英和悄悄話一起帶給那個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580204,
					"content": "而且撒的地方越高，心願就能傳達得越快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580205,
					"content": "葛蘿麗姐姐就拜託過冒險家，幫自己去風神像上撒過蒲公英…結果隔了幾天，古德溫哥哥就回信了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580206,
					"content": "諾拉也有悄悄話告訴爸爸，而且也找好蒲公英了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580207,
					"content": "但是…葛瑞絲阿姨一直不許，一直說等我長大之後，才能回去和爸爸一起住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580208,
					"content": "到底怎麼樣才能長大得更快呢，我也在很努力地鍛煉了，但還是這麼矮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580209,
					"content": "#嗯…我經常看見{F#妳}{M#你}在城裡飛來飛去，{F#妳}{M#你}能教教我，平時{F#妳}{M#你}都是怎麼飛的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580210,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "嘻嘻，那我就在旁邊看啦。這次，總是在葛瑞絲阿姨的允許範圍內了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "諾拉"
				},
				{
					"id": 200580212,
					"content": "要一起飛嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "不行不行，葛瑞絲阿姨看見了，又要訓我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "諾拉"
				}
			]
		},
