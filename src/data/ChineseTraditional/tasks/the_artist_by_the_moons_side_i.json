			"dialogs": [
				{
					"id": 760360301,
					"content": "這些就夠了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360302,
					"content": "嗯，它看起來很滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360303,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360304,
					"content": "我以前都不知道月靈還會畫畫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360305,
					"content": "它們其實和我們一樣，有著各自的性格和愛好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360306,
					"content": "欸？難道說挪德卡萊的每一隻月靈妳都認識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360307,
					"content": "嗯，只要見過的話就認識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360308,
					"content": "這麼厲害？！在我看來除了努昂諾塔有點特殊之外，其他月靈幾乎都長一個樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360309,
					"content": "那這隻會畫畫的小傢伙叫什麼名字呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360310,
					"content": "名字…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360311,
					"content": "妳該不會沒幫它們取名字吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360312,
					"content": "我認識它們，它們也認識我，不需要名字…我也沒有名字呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360313,
					"content": "不要把不好的傳統延續下去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360314,
					"content": "呃…那，那我想想…「努昂諾塔」意思是月神賜福下誕生的生靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360315,
					"content": "那「畫」在「霜月之子」的語言裡是怎麼說的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360316,
					"content": "好像是…梅…娜？梅拉？是梅拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360317,
					"content": "聽起來還不錯，那就叫它「梅拉」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360318,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360319,
					"content": "怎麼樣，梅拉，你畫好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360320,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360321,
					"content": "哦！我看看我看看…這！這…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360322,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "這畫得也太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360324,
					"content": "我還以為畫得會比較孩子氣…或者…像美露莘那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "派蒙"
