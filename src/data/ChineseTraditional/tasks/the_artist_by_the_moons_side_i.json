			"dialogs": [
				{
					"id": 760360101,
					"content": "不是這個藍色嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360103,
					"content": "哥倫比婭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "#嗯？是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360106,
					"content": "#幫幫我好嗎？之後會給{F#妳}{M#你}們好處的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360107,
					"content": "呃…妳什麼時候才能改掉這個習慣啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360108,
					"content": "妳之前也幫過我們很多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "對啊，就算沒什麼好處我們也會幫忙的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360111,
					"content": "所以到底怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360112,
					"content": "唔…準確來說，是它需要幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360114,
					"content": "這隻月靈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360115,
					"content": "這孩子不知從哪裡撿到了一支畫筆，回來後在我周圍開心地晃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360116,
					"content": "我幫它找了些畫布和顏料，但畫了一陣子後，它好像怎麼也調不出心儀的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360117,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 760360118,
					"content": "咦，你怎麼出來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360119,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 760360120,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360121,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 760360122,
					"content": "呃…就算你這樣比劃，我們也不知道你要什麼啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360123,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 760360124,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "努昂諾塔"
				},
				{
					"id": 760360125,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360126,
					"content": "#呀！它好像看上了{F#妳}{M#你}的背包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360127,
					"content": "#{F#妳}{M#你}們身上有帶適合的顏料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360128,
					"content": "我們不會隨身帶那種東西啦…話說回來，哥倫比婭是從哪裡找到顏料的？妳平時也不像會畫畫的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360129,
					"content": "這孩子有點等不及，我就隨手用身邊帶顏色的花朵幫它做了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360130,
					"content": "哦！難道說，努昂諾塔也是想找一些色彩豐富的東西來做顏料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360131,
					"content": "快快快，看看我們包裡都有些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360109,
					"content": "妳之前也給過我們賜福…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "發生什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
		},
