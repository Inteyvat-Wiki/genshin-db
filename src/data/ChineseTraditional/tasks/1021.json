					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210201,
					"content": "嗯？空氣裡有強烈的甜香味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210202,
					"content": "#而且…{F#妳}{M#你}有沒有聽到什麼聲音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210203,
					"content": "好像有人呼救。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "聽起來，是從那個遺蹟裡發出的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210207,
					"content": "…啊，是那些盜寶團把什麼人關起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210205,
					"content": "好像有人在唱歌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "不對，是呼救聲！是從那個遺蹟裡發出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
