				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "恭候多時了，絕雲間歸來之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210402,
					"content": "呀，是凝光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210403,
					"content": "初次見面，我們準備了一份禮物，希望妳能喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210404,
					"content": "給我的？真是多謝。我請二位來，反倒讓二位費心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210405,
					"content": "不費心，不費心，嘿嘿~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210406,
					"content": "「群玉閣」很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "#哈哈，很高興{F#妳}{M#你}也喜歡它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210409,
					"content": "這座宮殿浮空的位置，高於一切山脈，從這裡能清楚地看見璃月港的全貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210410,
					"content": "從學做生意的年紀起，我就開始為它準備建造資金了。成為「天權」以後，我更是邀請頂級工匠，不斷擴建…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210411,
					"content": "起初，它只有房間大小，如今已能遮蔽璃月上空真正的銀月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210412,
					"content": "我相信終有一日…它的影子會籠罩七國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210413,
					"content": "（這位「天權」大人，很有野心…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "#有資格登上「群玉閣」的外客不多，但西風騎士團的代理團長與我有書信往來，對{F#妳}{M#你}讚賞有加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210415,
					"content": "#所以，從{F#妳}{M#你}到璃月的第一天起，我就開始散出眼線…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210416,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210417,
					"content": "#終於在{F#妳}{M#你}們前往望舒客棧時，大致掌握了{F#妳}{M#你}們的動向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210418,
					"content": "難道菲爾戈黛特老闆，是你們的人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210419,
					"content": "不是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210420,
					"content": "整座望舒客棧裡，全都是我們的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210421,
					"content": "##%^%*&……！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210422,
					"content": "不久前，還遇到了「玉衡星」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "在歸終機旁見了一面，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210424,
					"content": "妳該不會一直在天上偷看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210425,
					"content": "哈哈…這麼遠的距離，偷看有些難吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210426,
					"content": "#…憑藉「耳目」即可。我對{F#妳}{M#你}們很感興趣，關注也是理所應當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210427,
					"content": "刻晴說，七星不會暗害帝君。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "#嗯，{F#妳}{M#你}與仙人往來頗多，對我們不信任，也是理所當然。這次請{F#妳}{M#你}來，就是想要解開一些誤會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210408,
					"content": "第一次到這麼高的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "嗚哇——！好、好大的客廳啊！從來沒見過這麼豪華的房間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210602,
					"content": "二位隨意，把這裡當成自己家也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210603,
					"content": "真的可以嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210604,
					"content": "#我請{F#妳}{M#你}們來，自然是把{F#妳}{M#你}們當成朋友。朋友來玩，當然是開心第一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210605,
					"content": "那裡是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "哎？這就是「傳說中的那面牆」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210607,
					"content": "哦？妳的消息很靈通嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210608,
					"content": "因為連說書先生都在說…好多人都在求購牆上的紙張，可有名了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210609,
					"content": "因為那面牆上記錄著璃月的秘密。商人對秘密，總是充滿熱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210610,
					"content": "#但旅行者，璃月的商業秘密對{F#妳}{M#你}來說並無意義，{F#妳}{M#你}很特別，{F#妳}{M#你}自己也很清楚這一點吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210611,
					"content": "#如果可能，我想獲取{F#妳}{M#你}的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210612,
					"content": "#但假如要{F#妳}{M#你}在我和刻晴當中，選擇一個更值得信任的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210613,
					"content": "凝光的敬神和刻晴的不敬神…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "#…哈哈，{F#妳}{M#你}會選刻晴吧？這種程度的直覺，我還是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210616,
					"content": "我原本覺得，過剛易折。以她那樣的性格當上七星，有些事還需要我在背後打點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210617,
					"content": "但在她說出「仙人的時代已經過去了，如果連璃月七星都不敢正視這一點，那璃月的未來要怎麼辦」這句話以後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210618,
					"content": "我心中的一些疑慮，倒是被打消了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210619,
					"content": "不錯，我不否認帝君的逝去看似對七星有利。但為了璃月，我也不能被「七星篡位」的流言束縛住應有的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210620,
					"content": "這些流言的背後，也有愚人眾的身影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "#嗯…看來{F#妳}{M#你}從剛才開始，就已經完全明白我要說什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210622,
					"content": "我下令封鎖消息、藏匿仙體，一來是為暫時穩定局面，二來也是為了避免…在蒙德發生過的那種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210623,
					"content": "愚人眾借帝君之死，已經有了太多超出外交底線的暗中行動。我身為對璃月負責的「天權」，對抗時也顧不得姿態優雅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210624,
					"content": "批准「送仙典儀」的籌辦，也只是為七星全面接管璃月，爭取一些緩衝時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210625,
					"content": "唔…果然和鍾離說的一樣，七星提供了儀式場地，只是因為可以利用我們達成自己的目的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210626,
					"content": "對了！說到「達成目的」…還有一件事，我可以說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210627,
					"content": "但說無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210628,
					"content": "聽說，送了見面禮的客人，都能得到一些好處…那我們有份嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210629,
					"content": "派蒙，妳就不能說些別的嗎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "哈哈哈…沒關係，我很喜歡直白的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210631,
					"content": "#最近這段時間，麻煩{F#妳}{M#你}們的事情也算是不少。這樣吧，作為賠禮，妳可以從我這裡任選一件喜歡的東西帶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210632,
					"content": "好！就等著這句了——我早就想好了！我想要的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210633,
					"content": "那面牆上的<color=#00E1FFFF>紙片</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210634,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "#別用那種眼神看著我！{F#妳}{M#你}不明白嗎？這面牆上的紙，哪怕只有指甲蓋大小，也能賣出天價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210636,
					"content": "要是…要是沒有撕碎的一整張…唔！我都不敢想像它值多少摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210614,
					"content": "還是刻晴的「不敬」更可信一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
