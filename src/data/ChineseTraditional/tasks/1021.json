			"dialogs": [
				{
					"id": 10213001,
					"content": "#多謝{F#妳}{M#你}們救了老孟，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213002
					],
					"speakerTitle": "星稀"
				},
				{
					"id": 10213002,
					"content": "嗯，接下來…我得洗洗陶罐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星稀"
				}
			]
		},
		{
			"id": 102131,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
