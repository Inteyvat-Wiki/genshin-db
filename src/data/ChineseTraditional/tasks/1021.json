				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "咦？認真一看，根本不用挑嘛。最大的一張筆記就釘在最顯眼的位置。好，就選定這張吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211202,
					"content": "啦啦啦…先來看看上面寫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211203,
					"content": "嗯？這裡有個圈出來的地點，難道是寶藏！或者是別的什麼發財機會？我看看，邊上這些字寫的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211204,
					"content": "「百無」…「禁忌籙」…什麼什麼…「愚人眾」…「研究」…「複製」…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211205,
					"content": "好像…不是寶藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211206,
					"content": "這張紙上寫的，是愚人眾對<color=#00E1FFFF>「百無禁忌籙」</color>的秘密研究，被七星佈下的眼線發現了蹤跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211207,
					"content": "唔…凝光剛才說，愚人眾在璃月暗中做了很多壞事，比如散佈流言、覬覦仙體什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211208,
					"content": "但「研究百無禁忌籙」，算是什麼類型的壞事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211209,
					"content": "#{NICKNAME}，說起來「百無禁忌籙」和{F#妳}{M#你}也有點關係，要不要去探查一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211210,
					"content": "事情的發展…有點刻意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "欸？是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211213,
					"content": "那…那我們就不去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211214,
					"content": "不，我是這樣想的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "#喔，原來{F#妳}{M#你}的意思是，「越是不能全盤盡信凝光，越是需要親自去印證一下凝光的說法」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211216,
					"content": "唔…有點超過我的理解範圍。我覺得她對我們很親切，是個好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211217,
					"content": "#不管了，就照{F#妳}{M#你}說的，先行動吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211218,
					"content": "在去荻花洲找鍾離之前，我們先去這份資料裡說的地方看看，愚人眾是不是真的在做一些見不得人的勾當？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211211,
					"content": "明顯是凝光想引我們去那裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "#{F#妳}{M#你}應該聽說過「魔神戰爭」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211302,
					"content": "不太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "世上曾有諸多魔神，也曾有曠日持久的戰爭，直到兩千年前方才終結。期間生靈塗炭，流血無數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211305,
					"content": "最終，提瓦特大陸上只剩下七位勝利者。他們在敗者的殘骸上建立國度與城邦，開始了七神的時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211306,
					"content": "看見「孤雲閣」了嗎？那並不是天然的地貌，而是戰爭期間，帝君投下的巨大岩槍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211307,
					"content": "在岩槍之下，鎮壓著帝君當年的手下敗將：未能取得七神之位的昔日魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211308,
					"content": "不僅魔神會死，即使是「塵世七執政」，兩千年來亦有更迭。帝君的逝去是璃月無法想像的災難，但提瓦特的七神體系…不會崩潰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211309,
					"content": "下一位岩神遲早會出現，但我們又怎會遺忘帝君？到那時，璃月人與仙神的關係，必定會與過往不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211310,
					"content": "#即使在新的時代，「璃月七星」也是帝君的舊日子民。向帝君舉刀的罪名…{F#妳}{M#你}認為，我們擔得起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211311,
					"content": "可是，你們為什麼要藏起「仙祖法蛻」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211313,
					"content": "#那天在玉京臺，事出突然，我也毫無防備。{F#妳}{M#你}當時在現場，應該都看見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211314,
					"content": "七星的敵人，早已潛伏在璃月港內。若不採取行動，就會落於下風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211315,
					"content": "藏起仙祖法蛻是必要之舉，借此，我才能轉明為暗，以靜制動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211316,
					"content": "妳說的「敵人」是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211317,
					"content": "#旅者，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211318,
					"content": "難道是他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "#嗯？{F#妳}{M#你}和凝光在打什麼啞謎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211321,
					"content": "正確的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211322,
					"content": "唔——？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10211323,
					"content": "哈…外面景致雖好，但高空的風還是略大了些。二位，殿內已經做好了待客的準備，請隨我進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211319,
					"content": "就是他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "只對這個詞語有點印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
		{
