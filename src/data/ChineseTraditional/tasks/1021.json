				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "怎麼，挑完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213102,
					"content": "啊，決定了的話也不用問我，直接拿走就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213103,
					"content": "然後，就在「群玉閣」坐一會、逛一逛吧。旅途當中的休息，也是很重要的一環。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213104,
					"content": "多謝款待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "別這麼客氣，請隨意些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10213106,
					"content": "是時候動身了，再見…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "#要走了嗎？也好。希望我們下次相遇時，{F#妳}{M#你}已經做了正確的事…或者將要作出正確的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		}
	]
}