				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "這裡就是《蒸汽鳥報》報社嗎，看起來是不是…完全沒什麼特別的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050302,
					"content": "很普通的房子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "哇！居然真的有機械鳥！好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050305,
					"content": "厲害吧？爸爸經常帶我來這裡買報紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050306,
					"content": "他超喜歡《蒸汽鳥報》的，每天早上都會拿著報紙看個不停。偶爾還會把報紙上的一部分剪下來，貼在一個本子上保存起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050307,
					"content": "爸爸說這是他所發表的「評論」，有時候他甚至會自己讀那些評論給我和媽媽聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050308,
					"content": "我們兩個並不喜歡聽，一直用「好啊」、「是嗎」或者「原來如此」來回答他，但爸爸根本沒察覺到，自己讀得超開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050309,
					"content": "「評論」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "如果簡單來說，「評論」就是從評論家自己的觀點出發，對某件事發表一些意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050311,
					"content": "洛薇的父親，德勒呂叔叔是一位楓丹科學院的科學家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050320,
					"content": "同時，也是一位經常在《蒸汽鳥報》上發表「評論」的「評論家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050312,
					"content": "對呀，爸爸對任何事情都喜歡長篇大論地發表「評論」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050313,
					"content": "有時候說著說著，他就會像想起什麼一樣，衝回屋子裡埋頭寫稿，就只顧著喝茶，連飯都不吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050314,
					"content": "欸…還有這種只要發表意見就能賺錢的職業嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050315,
					"content": "光是發表意見可稱不上是「評論家」。如果想要發表一篇值得被認可的評論，首先要遵循幾個要素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050316,
					"content": "#那個…那個…韋呂！還有{M#大哥哥}{F#大姐姐}，你們肚子餓了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050317,
					"content": "路易哥哥前幾天和我說，他最近會賣泡泡桔口味的薯條，我們趕快去買來吃吃看吧，我們請你們！",
					"roleType": "TALK_ROLE_NPC",
