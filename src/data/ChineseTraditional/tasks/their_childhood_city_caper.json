				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "哇…好想進去踩水，或者用噴泉洗個澡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050202,
					"content": "這樣肯定會被罵的啦，在外面看看就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050203,
					"content": "但是，既然不讓人進去玩，那把噴泉做這麼大幹嘛啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050204,
					"content": "就算它再好看，如果只能看的話，那也就是一個普通的水池而已，一點也不有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050205,
					"content": "這裡才不是普通的噴泉啦。不過…爸爸是有說過其他的普通噴泉，他是怎麼說的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050206,
					"content": "「楓丹廷市政美化工程最大的作用，是靈活地解決報稅問題。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050207,
					"content": "今天德勒呂叔叔剛和我講解過這方面的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050208,
					"content": "就連說話的語氣，和我爸爸一模一樣…難怪爸爸這麼喜歡奧雷勒哥哥，每次都要拿一大堆書去和你聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050209,
					"content": "雖然聽不懂，但哥哥一定又在說掃興的話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050210,
					"content": "洛薇，我們快去下個地方玩吧，今天妳好不容易不用讀書了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050211,
					"content": "嗯，我們接下來去看看其他地方吧，我想想…報社應該開著，我們去那裡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				}
			]
		},
