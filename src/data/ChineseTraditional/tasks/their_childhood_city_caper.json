					"洛薇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "哥哥，快點快點，走這邊啦。那邊的大房子我們還沒看過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050102,
					"content": "走慢點，別又摔倒了。洛薇妳也是，妳爸爸說妳身體不好，千萬不要著涼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050103,
					"content": "嗚哇，你哥哥好囉嗦，和我媽媽一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050104,
					"content": "我也這麼覺得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050105,
					"content": "你們兩個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050106,
					"content": "又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#{M#大哥哥}{F#大姐姐}好！又見面啦，這次我們沒在玩捉迷藏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050109,
					"content": "準確地來說，是剛剛已經玩過了…還被諾爾小姐訓斥了一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050110,
					"content": "諾爾姐姐在工作的時候一直那麼嚴肅，總是愛教訓人，虧我還請她吃過餅乾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050111,
					"content": "不過，反正也玩累了，我正想帶奧雷勒和韋呂到處逛逛，吃點好吃的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050112,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}想和我們一起…嗯…那個叫什麼來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050113,
					"content": "散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240050114,
					"content": "對，和我們一起散步吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050115,
					"content": "我們快去那邊的廣場看看吧，我還想去看看噴泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240050116,
					"content": "那就麻煩小姐帶路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "好呀，那我們就…先去那邊的廣場吧，裡面的噴泉真的都很好看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050117,
					"content": "那就麻煩各位帶路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "你們在做什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
