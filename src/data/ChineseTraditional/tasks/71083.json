					"沐寧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "#沒想到{F#妳}{M#你}們真的破壞了「七星陣法」，看來我必須要寫進週報了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830102,
					"content": "寫帥氣一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "#咳…{F#妳}{M#你}們嚴肅一點，這件事情很嚴重。具體嚴重程度，最後可是會由「七星」來親自定奪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830104,
					"content": "#也就是說，等我的報告交上去了，說不定會驚動「七星」的老人家們親自來這裡阻止{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830105,
					"content": "#哼，到那時候，就算我也沒辦法保{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830106,
					"content": "（提示也太明顯了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "#哼…被嚇住了吧？好了好了，還有人在等{F#妳}{M#你}呢，快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		},
		{
