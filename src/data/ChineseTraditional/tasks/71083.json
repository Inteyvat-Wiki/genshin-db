			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "下面情況如何了？有遇到什麼危險嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830202,
					"content": "（向沐寧描述一番）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "#原來是這樣，聽起來還挺危險的。瑾武姐還有志瓊，可就拜託{F#妳}{M#你}多費心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830204,
					"content": "你不是應該阻止我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "#我當然有義務阻止{F#妳}{M#你}，只不過{F#妳}{M#你}每次都跑得太快，我追不上，所以沒法阻止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830206,
					"content": "我沒有跑很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "#不，{F#妳}{M#你}就是跑得很快，週報裡就是這麼寫的，這就是事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830208,
					"content": "好的，我跑得很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "嗯，所以，還請一切小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710830210,
					"content": "一切順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "那就好，那就好，只要沒出事，「七星」也不會怪罪得太厲害吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		}
	]
