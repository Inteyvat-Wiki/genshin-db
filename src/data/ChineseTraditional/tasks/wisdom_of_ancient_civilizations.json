			"trigger": {
				"objectNames": [
					"蒂瑪烏斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "好神奇啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060202,
					"content": "我們現在所使用的煉金術，都還只是在模仿古人留下來的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060203,
					"content": "會使用風之翼的人是不需要知道它是怎麼製作出來的，煉金術也是同個道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060204,
					"content": "但每當我覺得好像摸到了一點原理，它又馬上會讓人出乎意料，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060205,
					"content": "煉金術來能用來幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "說實話我也不知道，但就是不知道才引人好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060210,
					"content": "有很多神奇的配方我也還在研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060211,
					"content": "#在{F#妳}{M#你}冒險的途中，應該能見到一些古代文明留下的關於煉金術的紀錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060212,
					"content": "#隨著{F#妳}{M#你}「冒險等階」的提高，{F#妳}{M#你}掌握的配方也會更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060213,
					"content": "謝謝你的解釋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "#不用謝，也別忘了跟我分享{F#妳}{M#你}的見識與成果哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060218,
					"content": "那們，我們下次見。祝你們的前路永遠有風吹拂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060215,
					"content": "到那時候就能造派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "#還在考慮這件事，我是哪裡讓{F#妳}{M#你}不滿意了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060217,
					"content": "#哈哈，{F#妳}{M#你}們兩位是很有趣的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 205060207,
					"content": "能造出派蒙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "有一個我還不夠嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205060209,
					"content": "哈哈哈，很可惜現在還不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "蒂瑪烏斯"
				}
			]
		}
	]
