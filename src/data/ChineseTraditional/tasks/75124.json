			"dialogs": [
				{
					"id": 751240301,
					"content": "唉呀，正是好時機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240302,
					"content": "我忙了那麼久都沒有完成的畫面，在兩位的幫助下居然這麼快就能夠拍攝完畢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240303,
					"content": "啊，浮流鳥，晃晃的、滾滾的身子在游泳圈內…真是讓人感動到落淚啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240304,
					"content": "真的有那麼感動嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "對於旁人來說無法理解，甚至覺得荒謬的東西，對於我們來說卻是此生的追求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240306,
					"content": "不過我相信如果我可以拍出更多浮流鳥可愛的畫片，最終喜歡浮流鳥的人一定會越來越多的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240307,
					"content": "我也完全相信這樣的未來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240308,
					"content": "#啊，多謝{F#妳}{M#你}們的幫忙，這些就給{F#妳}{M#你}們作為答謝吧，還請務必收下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "容韋勒"
				}
			]
		},
