				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1640.235,
							200.011,
							10049.76
						],
						"pointId": 10055
					},
					{
						"sceneId": 3,
						"position": [
							-1639.219,
							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "唉…又跑出去了。我看看，在游泳圈裡的不就只剩下一隻了嗎…這下該怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240102,
					"content": "是要套到什麼時候啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240103,
					"content": "哦，居然有人在這裡拍畫片…是在拍浮流鳥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240104,
					"content": "浮流鳥真的很可愛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240105,
					"content": "嗯，晃晃悠悠的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "對，走起路來晃來晃去的感覺十分可愛，而且脹起身體變成球浮在水上時的樣子，光看就讓人覺得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240109,
					"content": "這位有著漂亮銀色光澤秀髮的小小女士說得對哦！創造出浮流鳥這種生物的人應該受到世間所有讚美…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240110,
					"content": "真是了不起——啊，抱歉，我還沒有自我介紹，我是浮流鳥攝影愛好者，叫我容韋勒就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240111,
					"content": "#嗯，我叫派蒙，這位是{NICKNAME}…不過，這裡有這麼多浮流鳥，容韋勒你為什麼還唉聲嘆氣的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240112,
					"content": "此事說來話長…不過就容我容韋勒長話短說吧——浮流鳥的攝影愛好者有很多，大家都希望拍出更有趣的照片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240113,
					"content": "而我在前幾天誕生了一個天才的想法——那就是把鏡頭中的所有浮流鳥都套在游泳圈裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240114,
					"content": "有什麼意義嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "當然了，意義就在於沒有意義，明明自己能夠漂浮在水面上的浮流鳥，卻仍然套著游泳圈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240116,
					"content": "就如同用摩拉賺取摩拉那般虛無！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240120,
					"content": "浮流鳥身上背負的東西也太多了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240121,
					"content": "這就是所謂的超現實拍攝，要從留影之內找到更深的意義…啊，但遇到了麻煩的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240122,
					"content": "現實中的浮流鳥畢竟還是不會套著泳圈…所以根本就拍不到這樣的畫面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240123,
					"content": "畢竟是「超現實」拍攝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#不過聽起來好像只要用游泳圈把所有的浮流鳥圈住就好？{NICKNAME}，同為浮流鳥愛好者，我們來幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240125,
					"content": "嗚呼，浮流鳥愛好者應當互相幫助！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "說得對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240129,
					"content": "#真的嗎？{F#妳}{M#你}們願意幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240130,
					"content": "嘿嘿，只要事後你把好看的畫片給我們幾張就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240131,
					"content": "#那、那就拜託{F#妳}{M#你}們兩位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240127,
					"content": "雖然我比較喜歡飛鼯啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "這裡就不要再說這種掃興的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751240117,
					"content": "正常人的確想不到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "浮流鳥明明自己能夠漂浮在水面上，卻仍然套著游泳圈——這樣就能在畫面中形成一種意義的過度堆疊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240119,
					"content": "這其實展現了「過度使用」和「浪費」的主題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "容韋勒"
				},
				{
					"id": 751240107,
					"content": "其實我比較喜歡飛鼯啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "#飛鼯當然也很可愛，但是{F#妳}{M#你}有辦法在這些游來游去的浮流鳥們面前，說出：「飛鼯比浮流鳥可愛」這麼殘忍的話嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "派蒙"
				}
			]
		},
