			"dialogs": [
				{
					"id": 740820701,
					"content": "一滴晶瑩的水珠出現在了祭壇上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "咦！這滴水珠…這滴水珠不會就是寶藏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830103,
					"content": "長得不太像寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "我也覺得…畢竟這麼順利就得到了…那它會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830105,
					"content": "說不定是鎮壓魔王的關鍵物品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "說不定是別人存放在這裡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "什麼？那我們豈不是闖大禍了，快！快把它放回去！希望還來得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830107,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830108,
					"content": "完蛋了！魔王出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830109,
					"content": "魔王？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830111,
					"content": "什麼？完蛋了，那我們不就成了小偷了？對不起對不起…我們快把東西放回去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830112,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830113,
					"content": "完蛋了！主人回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830114,
					"content": "主人？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830115,
					"content": "嚇死我了…原來是一位美露莘…妳怎麼在這裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830116,
					"content": "鑰匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830117,
					"content": "什麼…什麼鑰匙？這滴水珠是鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830118,
					"content": "珀西芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830119,
					"content": "呃…這滴水珠是珀西芙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830120,
					"content": "美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830121,
					"content": "哎呀！什麼意思？這滴水珠是美露莘？我有點暈了，到底是什麼啦，妳不才是美露莘嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830122,
					"content": "珀西芙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830123,
					"content": "呃…妳是珀西芙？還是妳叫珀西芙？等等…我一定會被妳的答案弄得更暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830124,
					"content": "我決定就叫妳珀西芙了，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830125,
					"content": "美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}…怎麼辦？我完全搞不懂她的意思，她到底在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830127,
					"content": "妳能聽懂我們的話，對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "珀西芙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830129,
					"content": "這滴水珠是鑰匙，對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "珀西芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830131,
					"content": "妳不是人，對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830133,
					"content": "呃…突然罵人不太好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830134,
					"content": "我不是人，對嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "美…美露莘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830136,
					"content": "啊！等等，我好像有點聽出來了…「珀西芙」的意思是肯定，「美露莘」的意思是否定，難道是這個意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830137,
					"content": "珀西芙！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830138,
					"content": "原來妳不是叫珀西芙…對不起，我搞錯了妳的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830139,
					"content": "珀西芙…喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830140,
					"content": "妳喜歡這個名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830142,
					"content": "#太好了！那就這樣叫妳了，嘿嘿！我是派蒙，這是{NICKNAME}，很高興認識妳，珀西芙，我還沒見過像妳這樣的美露莘呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830143,
					"content": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830144,
					"content": "伊黎耶…美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830145,
					"content": "…伊黎耶否定？呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830146,
					"content": "伊黎耶島不好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "伊黎耶，美露莘，現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830148,
					"content": "珀西芙，伊黎耶，保護…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830149,
					"content": "伊黎耶島正在變得不好，然後，妳要保護它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830150,
					"content": "#派蒙，{NICKNAME}，伊黎耶，邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830151,
					"content": "#呃…這次有五個詞，呃…妳希望派蒙和{NICKNAME}對伊黎耶島邦邦邦邦這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830152,
					"content": "美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830153,
					"content": "妳希望我們幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830155,
					"content": "原來是幫忙呀！幸好幸好，如果要讓我們對這座島邦邦邦邦，那就真的滿難的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830156,
					"content": "邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830157,
					"content": "有報酬嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "那要怎麼幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "報…酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830159,
					"content": "#哎呀！{NICKNAME}，{F#妳}{M#你}看珀西芙都不太會說話，鐵定找不到其他人幫忙了，我們就幫幫她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830160,
					"content": "那要怎麼幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "鑰匙，鑰匙，鑰匙，數量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830163,
					"content": "然後呢？鑰匙的數量是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830164,
					"content": "鑰匙！鑰匙！鑰匙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830165,
					"content": "三把鑰匙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "珀西芙！鑰匙，霧道，南…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830167,
					"content": "鑰匙，泉眼，北…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830168,
					"content": "鑰匙，垂柳，東…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830169,
					"content": "哦！原來是這個意思…那我先記一下…一共有三把鑰匙，分別是南邊的霧道、北邊的泉眼、東邊的垂柳…是這樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830170,
					"content": "鑰匙，鑰匙，鑰匙，廣場，西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830171,
					"content": "西邊的廣場還有三把鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830172,
					"content": "集齊三把鑰匙去廣場？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#派蒙，美露莘！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830174,
					"content": "#哎呀！珀西芙，妳不要老是說這種顯得{NICKNAME}比我聰明的話嘛！明明我和{M#他}{F#她}差不多聰明才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830175,
					"content": "總而言之，現在我們已經得到一把鑰匙了，看來只要再弄到另外兩把就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830176,
					"content": "伊黎耶，美露莘…珀西芙，保護！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830177,
					"content": "妳放心啦！雖然不知道發生了什麼，但我們會幫妳保護伊黎耶島的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830178,
					"content": "不過我再補充一小點哦！珀西芙，假如妳碰巧看見一種沒有人要的，亮晶晶的，圓滾滾的東西，或者一看就很貴的箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830179,
					"content": "能跟我們說一聲就再好不過啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820780,
					"content": "珀西芙似懂非懂地摸了摸頭，又高興地蹦跳了兩下，然後略顯匆忙地離開了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#啊！她就直接跑掉了，看來是很緊急的事。{NICKNAME}，我們現在就去尋找另外兩把鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
