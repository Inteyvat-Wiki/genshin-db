			"dialogs": [
				{
					"id": 20101301,
					"content": "#{F#妳}{M#你}就是新任的劍魚二番隊隊長吧，珊瑚宮大人已經跟我們說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101302
					],
					"speakerTitle": "劍魚二番隊代理隊長"
				},
				{
					"id": 20101302,
					"content": "#軍隊中早有關於{F#妳}{M#你}的傳聞，委任書也確認完畢。不過我尚有一個疑慮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101303
					],
					"speakerTitle": "劍魚二番隊代理隊長"
				},
				{
					"id": 20101303,
					"content": "嗯？欸？有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101304,
					"content": "#簡單來說，就是{F#妳}{M#你}是否值得我們追隨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101305
					],
					"speakerTitle": "劍魚二番隊代理隊長"
				},
				{
					"id": 20101305,
					"content": "你們的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101306,
					"content": "如果是平時，最直接的做法就是痛痛快快地打一場。不過現在嘛，這裡有更好的靶子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101307
					],
					"speakerTitle": "劍魚二番隊老兵"
				},
				{
					"id": 20101307,
					"content": "#我們駐紮在這裡，是因為最近很多<color=#00E1FFFF>流浪武士</color>鬧事。如果{F#妳}{M#你}能把這些<color=#00E1FFFF>流浪武士</color>幹掉，我們就認可{F#妳}{M#你}的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101308
					],
					"speakerTitle": "劍魚二番隊老兵"
				},
				{
					"id": 20101308,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101309
					]
				},
				{
					"id": 20101309,
					"content": "嗯嗯，就讓他們心服口服吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
