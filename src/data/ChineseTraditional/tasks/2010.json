			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100201,
					"content": "#喲，{NICKNAME}，{F#妳}{M#你}來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100202
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100202,
					"content": "馬上就到與珊瑚宮大人約定的日子了，我們也該出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100203
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100203,
					"content": "#準備好了嗎？我先帶{F#妳}{M#你}去我們<color=#00E1FFFF>海祇島</color>的軍營看看，之後我們一起去找珊瑚宮大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100204
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100204,
					"content": "#如果中途暈船的話，要馬上跟我說。不過聽說{F#妳}{M#你}在南十字船隊待過，應該沒問題吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100205
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100205,
					"content": "準備，啟航！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲平"
				}
			]
		},
		{
			"id": 201004,
			"completionStepIds": [
				201004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201004",
							"2"
						],
						"stepId": 201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100401,
					"content": "這裡就是我們海祇島軍隊的訓練營了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100402
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100402,
					"content": "目前的反抗軍，絕大部分都是由海祇島的本土士兵組成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100403
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100403,
					"content": "一部分人在踏鞴砂跟幕府軍正面交戰，一部分人留在海祇島，保護百姓的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100404
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100404,
					"content": "哲平以前也在這裡訓練嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100405,
					"content": "是啊，可惜我還沒有完全得到教官的認可，就不得不去踏鞴砂參戰了，只能先在後勤部隊幫點小忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100406
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100406,
					"content": "#我暫時會住在這裡，如果{F#妳}{M#你}想找我的話，來這裡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100407
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100407,
					"content": "#要是我不在，{F#妳}{M#你}可以寫個字條，貼在附近的牆上。我看到了就會去找{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100408
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100408,
					"content": "…糟了，快到與<color=#00E1FFFF>珊瑚宮大人</color>約定的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100409
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100409,
					"content": "#下次再帶{F#妳}{M#你}逛一逛海祇島吧，我先帶{F#妳}{M#你}去<color=#00E1FFFF>珊瑚宮</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100410
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100410,
					"content": "珊瑚宮，應該就是那位<color=#00E1FFFF>珊瑚宮心海</color>住的地方…我們過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 201006,
			"completionStepIds": [
				201006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201006",
							"2"
						],
						"stepId": 201006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100601,
					"content": "無論如何，糧草都是重中之重，不能有任何閃失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100602
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100602,
					"content": "如今我們和幕府軍之間的衝突日漸激烈，必須要優先確保後勤穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100603
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100603,
					"content": "是。我再想想辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100604
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100604,
					"content": "放心，有了之前那批物資，我也在著手擴充軍隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100605
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100605,
					"content": "人手不足的時候辛苦你們了，之後的局面應該會有所好轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100606
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100606,
					"content": "擴充軍隊？太好了。雖然不知道這次是誰在背後資助我們，但真是幫大忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100607
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100607,
					"content": "欸？這不是哲平嗎，你這小子回海祇島了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100608
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100608,
					"content": "這位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100609
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100609,
					"content": "#嘿嘿，是珊瑚宮大人的客人喔，我是負責把{F#她}{M#他}帶回海祇島的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100610
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100610,
					"content": "喔？莫非就是最近軍隊中已有傳言的那位…力大無窮、百步穿楊、金剛不壞的新人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100611
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100611,
					"content": "為什麼會有這樣的傳聞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100612,
					"content": "兩位遠道而來，應該也是有要緊事。我就不多打擾了。之後有空，也可以來我這坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100613
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100613,
					"content": "那珊瑚宮大人，我就先行告退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100614
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100614,
					"content": "珊瑚宮大人，我剛剛好像聽到大久保大哥說什麼「資助」，那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100615
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100615,
					"content": "不久之前，有人寫信給我，說願意支持海祇島的抗爭，並送來大量物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100616
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100616,
					"content": "拜此所賜，我們終於可以放開手腳招兵買馬，與幕府軍在正面戰場展開對抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100617,
						20100619
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100617,
					"content": "那真是太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100618
					]
				},
				{
					"id": 20100618,
					"content": "其實我對此還有疑慮…不過海祇島並不富庶，這筆物資確實是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100621,
					"content": "對方的要求也不過分，只說要我們竭盡全力對抗幕府軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100622
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100622,
					"content": "不管他們的目的是什麼，至少在這一點上我們是一致的，那就當作是多了一個不願露面的盟友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100623
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100623,
					"content": "當然，也不能完全放鬆警覺。如果你們發現任何異樣，請即時彙報給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100624
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100624,
					"content": "珊瑚宮大人，那前線的伙食是不是也會變好？前幾天去傷兵營，那些傢伙吵著要吃烤肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100625
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100625,
					"content": "呵呵…放心，我已經安排好了。供應烤肉讓他們吃飽，不過還是不許喝酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100626
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100626,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100627
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100627,
					"content": "也難為你們了。從眼狩令頒佈、我們起兵反抗以來，軍中的飯菜確實很少更換。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100628
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100628,
					"content": "之後我會和後勤部隊進行協商，在這方面做出一些改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100629
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100629,
					"content": "不過我們的物資還是有限，勝利之前，還希望你們再忍耐一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100630
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100630,
					"content": "那眼狩令，什麼時候才能結束呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100631,
					"content": "這個問題…我也沒有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100632
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100632,
					"content": "頒佈眼狩令一事本就很奇怪。不管是天領奉行，還是將軍大人，他們的態度都很微妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100633
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100633,
					"content": "天領奉行突然一味讚揚眼狩令，而將軍大人似乎也對眼狩令帶來的戰爭視而不見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100634
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100634,
					"content": "#在解開這些謎題之前，眼狩令恐怕都不會結束。我只能向{F#妳}{M#你}保證，只要眼狩令還在，我們就不會放棄反抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100635
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100635,
					"content": "#{NICKNAME}，現在我想再確認一下。在瞭解到海祇島和反抗軍的現狀之後，{F#妳}{M#你}還願意與我們一同抗爭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100636
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100636,
					"content": "我不會放棄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100637
					]
				},
				{
					"id": 20100637,
					"content": "#好，那現在，我正式頒佈對{F#妳}{M#你}的任命——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100638
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100638,
					"content": "#從現在起，{F#妳}{M#你}將升任海祇島特別行動隊「劍魚二番隊」的隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100639
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100639,
					"content": "劍劍劍劍魚二番隊？是我想的那個，被冠以「劍魚」之名的特別行動隊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100640
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100640,
					"content": "我記得光是進入特別行動隊就很難了，居然可以一口氣當上隊長…這也太厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100641
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100641,
					"content": "#雖然是破格任命，但我相信以{F#妳}{M#你}的智慧、勇氣與力量，可以帶領這支隊伍走向勝利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100642
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100642,
					"content": "好耶！那我們什麼時候上任呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100643
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100643,
					"content": "劍魚二番隊如今正在本島<color=#00E1FFFF>西南</color>處的山谷待命，最近有一些<color=#00E1FFFF>流浪武士</color>鬧事，需要特別行動隊來穩定後方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100644
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100644,
					"content": "#委任書我已經寫好，{F#妳}{M#你}給他們看一下就可以了。那些流浪武士，也麻煩{F#妳}{M#你}一起清剿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100645
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100645,
					"content": "#特別行動隊的人都是海祇島的精銳，身上或許會有些傲氣，不過相信{F#妳}{M#你}能夠贏得他們的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100646
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100646,
					"content": "那，那我呢？珊瑚宮大人，有什麼作戰需要我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100647
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100647,
					"content": "我也想為反抗軍多做一些貢獻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100648
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100648,
					"content": "當然有了，等一下我也會為你安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100649
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100649,
					"content": "#保證完成任務！嘿嘿，{NICKNAME}，雖然{F#妳}{M#你}已經當上了劍魚二番隊的小隊長，但我也不會輸給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100650
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100650,
					"content": "好吧，你小心一點，不要太勉強了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100651,
					"content": "#{NICKNAME}，我們也出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100619,
					"content": "真的可靠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100620
					]
				},
				{
					"id": 20100620,
					"content": "我對此也有疑慮…不過海祇島並不富庶，這筆物資確實是雪中送炭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 201009,
			"completionStepIds": [
				201009
			],
