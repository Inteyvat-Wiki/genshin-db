				"points": []
			},
			"dialogs": [
				{
					"id": 20100901,
					"content": "#好久不見啦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100902
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100902,
					"content": "怎麼樣，和劍魚二番隊那些人還合得來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100903,
						20100904
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100903,
					"content": "合得來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				},
				{
					"id": 20100905,
					"content": "#嘿嘿，就讓我這個前輩教{F#妳}{M#你}一些統御之道吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100906
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100906,
					"content": "#{F#妳}{M#你}要增加他們的軍餉，還要設置一些懸賞，要讓他們遵守紀律…還有什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100907
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100907,
					"content": "哇喔…哲平，你是從哪聽來的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100908,
					"content": "從一本八重堂出版的小說…那是好久以前的事了。當時我用好幾個糰子當賄賂，那個朋友才答應借我看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100909
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100909,
					"content": "居然試圖用小說裡的東西指導軍隊，這就是別人說的「紙上談兵」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100910,
					"content": "#哼哼，不要小看我喔。現在我可是和{F#妳}{M#你}們一樣，正在學習和摸索「治軍之道」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100911,
						20100912
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100911,
					"content": "難道說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100913,
					"content": "沒錯！因為在海戰中立下了汗馬功勞，現在我也是特別行動隊的隊長了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100914
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100914,
					"content": "而且還是一個全新的小隊，「鯡魚一番隊」！怎麼樣，聽起來是不是很厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100915
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100915,
					"content": "我問過珊瑚宮大人啦，珊瑚宮大人說，我們的隊服都已經在製作中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100916
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100916,
					"content": "等製作好了，我們一起去把隊服取回來。之後換上全新的隊服見面，想想就覺得很酷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100917
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100917,
					"content": "真好啊，多虧了從資助方那裡拿到的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100918
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100918,
					"content": "那個隊服，我也會有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100919,
					"content": "當然了！妳也是我們海祇島軍隊的一員呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100920
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100920,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100921,
					"content": "隊長，有新的作戰任務到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100922
					],
					"speakerTitle": "內村"
				},
				{
					"id": 20100922,
					"content": "#嗯，我現在過去。那我先走啦，{NICKNAME}，下次再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100923
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100923,
					"content": "#{F#妳}{M#你}可要小心一點，不要被我輕易超越了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100924
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100924,
					"content": "我們才不會輸給你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100925,
					"content": "咳咳…這可難說。現在我的狀態超級好，正是建功立業的好時候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100926
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100926,
					"content": "沒想到哲平居然也升到小隊長啦，看來他真的很努力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100927,
					"content": "我們休息一下，然後去<color=#00E1FFFF>魔神戰爭遺蹟</color>那邊看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20100912,
					"content": "哲平也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100904,
					"content": "有點苦惱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				}
			]
		},
