			"dialogs": [
				{
					"id": 20101401,
					"content": "有兩下子嘛…雖然不如傳聞中那麼誇張，但確實很厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101402
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101402,
					"content": "介紹一下，我叫幸德，劍魚二番隊的代理隊長。這位是嘉久，也是隊伍中的老兵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101403
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101403,
					"content": "#現在，我正式把「隊長」一職交給{F#妳}{M#你}。劍魚二番隊，隨時待命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101404
					],
					"speakerTitle": "幸德"
				},
				{
					"id": 20101404,
					"content": "還有別的流浪武士鬧事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101405
					]
				},
				{
					"id": 20101405,
					"content": "遭到襲擊的重災區有兩處，這裡的流浪武士已經被隊長幹掉，他們的據點就只剩下<color=#00E1FFFF>本島東部</color>的淺灘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101406
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101406,
					"content": "不過那裡的流浪武士數量更多，戰鬥力也更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101407,
						20101408
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101407,
					"content": "我們過去看看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				},
				{
					"id": 20101409,
					"content": "是呀，海祇島還在和幕府軍打仗呢，不能讓這些壞傢伙在後面搗亂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20101408,
					"content": "心海也說要保證後方安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				}
			]
