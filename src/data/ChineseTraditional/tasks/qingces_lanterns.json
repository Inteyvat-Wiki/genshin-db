					"nextDialogs": [
						413310502
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310502,
					"content": "我準備做的菜還挺多的，到時候再把桌椅搬出來的話，說不定有些菜都要涼了。",
					"roleType": "TALK_ROLE_NPC",
