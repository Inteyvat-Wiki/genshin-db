			},
			"dialogs": [
				{
					"id": 413310301,
					"content": "還差這麼多東西嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310302,
					"content": "我來幫忙置辦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "#咦？哦…{F#妳}{M#你}願意幫忙那就最好了，我正煩惱怎麼置辦食材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310304,
					"content": "#我看看…請{F#妳}{M#你}幫我準備三份獸肉和三份禽肉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310305,
					"content": "其餘的材料，我會想辦法準備的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
		},
