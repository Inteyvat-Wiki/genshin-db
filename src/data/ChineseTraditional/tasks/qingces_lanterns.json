					"nextDialogs": [
						413310611
					]
				},
				{
					"id": 413310611,
					"content": "#沒事沒事，我不多問了，{F#妳}{M#你}肯定也有自己的原因吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310612
					],
					"speakerTitle": "凱叔"
				},
				{
					"id": 413310612,
					"content": "#不過{F#妳}{M#你}要是願意，留在這過節也行，反正這裡人也挺多的，也算熱鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱叔"
				},
				{
					"id": 413310610,
					"content": "因為一些事…",
					"roleType": "TALK_ROLE_PLAYER",
