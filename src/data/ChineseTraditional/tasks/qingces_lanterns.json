			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413313701,
					"content": "這麼多人在一起，倒是也有幾分節日的氣氛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313702
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313702,
					"content": "呵呵，我們就一起放了這盞霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313703
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313703,
					"content": "希望新的一年裡，大家都能身體健康，萬事如意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313704,
					"content": "還有在外奔波的那些孩子們，也能萬事如意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313705,
					"content": "好了若心奶奶，再不去吃，我準備的那些飯菜可都要涼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413313706,
					"content": "哇，有好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "小六"
				},
				{
					"id": 413313707,
					"content": "奶奶，那我們去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "東東"
				},
				{
					"id": 413313708,
					"content": "你們這群孩子啊…好，好，快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313709,
					"content": "您不去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "我？我不急，我想再看會霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313711,
					"content": "#對了孩子，這些給{F#妳}{M#你}，收下吧，謝謝{F#妳}{M#你}在這裡忙前忙後的幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313712,
					"content": "謝謝奶奶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "#不用謝，我看{F#妳}{M#你}的年紀也不大，這樣子在外面跑，一定很辛苦吧，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313714,
					"content": "#不然，{F#妳}{M#你}就在這再待一會，和大家一起過個節吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313715,
					"content": "奔波了一整年，能休息一會總是好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
