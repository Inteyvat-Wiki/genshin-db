			"dialogs": [
				{
					"id": 413311001,
					"content": "#{F#妳}{M#你}回來了，辛苦{F#妳}{M#你}了，大過節的還在這忙前忙後的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413311002,
					"content": "應該做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "#那我也得好好謝謝{F#妳}{M#你}才是。剛才我也編了不少的霄燈，想要和這輕策莊裡的人一起放出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413311004,
					"content": "#{F#妳}{M#你}願意的話，就晚上來門口找我吧，我們一起放放霄燈，過個好節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413311005,
					"content": "但那群孩子們也不知道跑到哪去了…我也走不動遠路，沒辦法去找他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413311006,
					"content": "#如果可以的話，請{F#妳}{M#你}替我去找找那些孩子們，讓他們過來吧，他們一向很喜歡放霄燈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413311007,
					"content": "#要是{F#妳}{M#你}能再順便再叫些其他的人來，那就更好了，畢竟人越多越熱鬧嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
