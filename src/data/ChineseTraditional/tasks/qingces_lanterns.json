			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "又到了海燈節了，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310202,
					"content": "您在擔心什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "到海燈節啦，按理說，是該熱熱鬧鬧地過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310204,
					"content": "但是這輕策莊裡…老的老，小的小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310205,
					"content": "去城裡工作的那些孩子們，要嘛是說工作忙請不到假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310206,
					"content": "要嘛就是離得遠，怎麼樣都趕不及回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310207,
					"content": "明明是個大傢伙聚在一起，團團圓圓熱熱鬧鬧的節日，結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310208,
					"content": "我也理解他們在外的難處，但是大過節的，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310209,
					"content": "哎呀，不說了，不說了。大過節的可不能這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310210,
					"content": "#對了，如果{F#妳}{M#你}願意的話，能去幫一下小白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310211,
					"content": "那孩子說想要給大家置辦桌好菜，正在那忙呢，我擔心她一個人會有點忙不過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310212,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "#那就拜託{F#妳}{M#你}了，實在是太謝謝了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 413310213,
					"content": "您別擔心，我這就去幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
