					"nextDialogs": [
						413310606
					],
					"speakerTitle": "凱叔"
				},
				{
					"id": 413310606,
					"content": "#不過，沒想到{F#妳}{M#你}還特意過來幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310607
					],
					"speakerTitle": "凱叔"
				},
				{
					"id": 413310607,
					"content": "應該做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310608
					]
				},
				{
					"id": 413310608,
					"content": "#呵，{F#妳}{M#你}這年輕人倒是不錯…不過這大過節的，{F#妳}{M#你}怎麼不回家裡去？",
