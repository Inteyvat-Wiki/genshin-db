				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "下次再設計一下團隊戰好了？或許對戰也是不錯的主意？哦，是你們呀，歡迎來到訓練場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570102,
					"content": "關於訓練場…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "#客人漸漸變多了，這還是多虧了{F#妳}{M#你}們。當然，還有孩子們和「地隱會」的功勞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570104,
					"content": "我發現，訓練場會是一個很適合聚會的地方。和多年不見的朋友突然相聚，突然會不知道該說些什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570105,
					"content": "關於「地隱會」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "啊…暫時還沒有找到比標靶更適合的鼴鼠窩墊材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570107,
					"content": "我和孩子們試了好幾種材料了，牠們就是特別喜歡標靶。目前為止還是只能去和牠們交易換回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570108,
					"content": "不過，我們也漸漸掌握了牠們的寶物匯率，賺了不少淨利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊諾"
				},
				{
					"id": 760570109,
					"content": "下次再來找你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "#嗯，請隨時來！記得哦，只要是{F#妳}{M#你}們，永遠免費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊諾"
				}
			]
		},
