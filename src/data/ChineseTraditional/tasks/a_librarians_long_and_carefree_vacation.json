	"talks": [
		{
			"id": 7350601,
			"completionStepIds": [
				7350601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350601",
							"2"
						],
						"stepId": 7350601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060101,
					"content": "#{F#妳}{M#你}好，歡迎來到聚砂廳，有興趣接一些委託工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060102
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060102,
					"content": "有沒有那種毫不費力，站著就能拿摩拉拿到手軟的工作？我們很有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060103,
					"content": "這…這樣的委託確實還沒有，不過我這裡有一些比較簡單的居民請求，報酬分別在幾萬摩拉不等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060104
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060104,
					"content": "唔…幾萬摩拉嗎？感覺有點不夠花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060105,
						735060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060105,
					"content": "摩拉越多越好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				},
				{
					"id": 735060107,
					"content": "對啊。阿芬迪先生，有沒有報酬更高一點的委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060108,
					"content": "啊這樣嗎？我想想…最近悉般多摩學院開設了一個地脈調查計畫，正在有償招募志工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060109
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060109,
					"content": "悉般多摩學院裡有不少學者專攻地脈研究，對地脈資料的需求很大，時常需要進入秘境調查地脈異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060110
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060110,
					"content": "這段時間裡他們有些人手不足，找了不少本院學生幫忙還不夠，不得不大量招募志工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060111
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060111,
					"content": "#他們的報酬開得很高，相應的，對志工本身的素質要求也很嚴格。{F#妳}{M#你}們有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060112
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060112,
					"content": "有什麼要求？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060113
					]
				},
				{
					"id": 735060113,
					"content": "#好，我來按照招募流程確認一下吧，首先：「{F#妳}{M#你}是否能夠熟練使用一種以上的武器？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060114,
						735060115
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060114,
					"content": "我在單手劍領域頗有心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060116,
					"content": "#很好，那麼「{F#妳}{M#你}對元素的瞭解如何？是否能夠使用元素力？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060117,
						735060118
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060117,
					"content": "我非常瞭解元素反應。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060119,
					"content": "#嗯，{NICKNAME}對吧，我這裡登記好了。志工需要的物資和報酬我之後會協調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060120
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060120,
					"content": "不過實際的工作接洽得找加福爾先生，但他今天有位重要訪客需要接待，應該不在教令院內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060121
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060121,
					"content": "#按照院內訪客接待標準流程，他今天應該會帶訪客去普斯帕咖啡館。等訪客接待時間結束，{F#妳}{M#你}們可以去和他談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060122
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060122,
					"content": "真是的，跟我聯絡的時候還說是急著招募志工，怎麼還中途去接待訪客了，到底什麼人這麼重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060118,
					"content": "我使用元素力戰鬥的經驗很豐富。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060115,
					"content": "其實我諸武精通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060106,
					"content": "想要亮晶晶的石頭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				}
			]
		},
		{
			"id": 7350602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350602",
							"2"
						],
						"stepId": 7350602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加福爾",
					"麗莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060201,
					"content": "這裡的咖啡，妳還熟悉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060202
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060202,
					"content": "當然，這是我以前最常喝的飲品，怎麼會不熟悉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060203
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060203,
					"content": "加福爾師兄，嗯…現在應該是加福爾老師了吧，我們明明是老熟人，何必一直繞圈子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060204
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060204,
					"content": "又是敘舊，又是咖啡的，你有什麼想說的就直說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060205
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060205,
					"content": "那個人就是我們要找的加福爾吧，不過他好像正忙著和別人說話，不然我們先等一等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060206,
					"content": "其實也沒有什麼特別的事情。自從妳離開教令院之後，我們當初的專案和計畫就沒了主要領導者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060207
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060207,
					"content": "居勒什老師也很失望，他一直很看重妳這個得意弟子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060208
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060208,
					"content": "麗莎，妳離開教令院，實在是一件非常可惜的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060209
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060209,
					"content": "以妳的聰明才智，如果當初留在教令院的話，現在都能得到訶般荼的位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060210,
						735060211
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060210,
					"content": "（是麗莎！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				},
				{
					"id": 735060212,
					"content": "我沒聽錯吧，那不是西風騎士團的圖書管理員麗莎小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060213,
					"content": "我聽說，麗莎好像曾經在須彌教令院唸過書，不過那都是過去的事了。現在麗莎到這裡是要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060214,
					"content": "我猜得沒錯的話，你是想舊話重提，拉我回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060215
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060215,
					"content": "呵呵，我聽說妳現在是在蒙德的西風騎士團裡擔任圖書管理員？要我說，真的是屈就了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060216
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060216,
					"content": "何必浪費自己的時間，去為保管圖書這種小事勞心費神呢？妳的時間明明是最寶貴的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060217
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060217,
					"content": "只要妳願意回到學院來，立刻就能有一堆計畫供妳主持。現在正是學院需要用人的時候，有些重要計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060218
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060218,
					"content": "哈…所以說來說去，還是想拉我回去囉？居勒什老師應該不知道你這麼做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060219
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060219,
					"content": "實際上，恩師他早就有心叫妳回來參與院內的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060220
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060220,
					"content": "…喔是嗎？加福爾老師，欺騙他人可不是好做法喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060221
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060221,
					"content": "我為什麼只在學院裡待了兩年就離開了，老師他是最清楚的，所以他絕對不會提出這種要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060222
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060222,
					"content": "放棄蒙德的生活，以素論派學者的身分重回教令院嗎…求取智慧所需要的代價我自己已經再也支付不起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060223
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060223,
					"content": "所以啊，就別再挖空心思拉我回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060224
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060224,
					"content": "嗚哇，原來麗莎曾經是素論派的學者嗎？從來都沒聽她本人提過啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060225,
						735060226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060225,
					"content": "小聲點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060227,
					"content": "而且保管圖書可是很重要的工作，我從不覺得那是浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060228
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060228,
					"content": "「智慧蘊藏在世界的每個角落，絕不可輕視點滴中的智慧」，這可是老師常掛在嘴邊的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060229
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060229,
					"content": "優秀的學者是不會忽視細節的，加福爾師兄——果然還是叫你師兄比較習慣——你剛才的說辭在細節上犯了錯誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060230
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060230,
					"content": "而且還有一個細節你也沒有注意到，此刻，有兩個人正在偷聽我們說話，已經半天了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060231
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060232
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060232,
					"content": "兩位，找我們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060233
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060233,
					"content": "嘿嘿，妳好麗莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060234,
					"content": "好久不見，麗莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060235
					]
				},
				{
					"id": 735060235,
					"content": "#我就說嘛，果然是{F#妳}{M#你}們兩個呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060236
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060236,
					"content": "好久不見喲，小可愛、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060237
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060237,
					"content": "…兩位有什麼事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060238
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060238,
					"content": "啊那個，其實我們是來應徵參與悉多…呃…悉般多摩學院的地脈調查計畫的，剛剛在阿芬迪先生那裡登記過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060239,
						735060240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060239,
					"content": "正巧遇到了麗莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060241,
					"content": "#地脈調查計畫？難道小可愛{F#妳}{M#你}們進入了教令院？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060242
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060242,
					"content": "只是擔任計畫志工。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060243
					]
				},
				{
					"id": 735060243,
					"content": "對，聽聯絡員阿芬迪先生說，有個學術計畫正在有償招募志工，我們這才過來找加福爾先生瞭解情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060244,
					"content": "有償招募志工？加福爾師兄，學院內部這麼缺人嗎？還是你們有什麼非要外人來做不可的計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060245
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060245,
					"content": "沒有沒有，這只是出於常規地脈監測需求才有的計畫，一切操作都符合安全標準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060246
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060246,
					"content": "投入大量人力去收集地脈資料，我們也是不得已…要是妳肯回來幫忙主持一些事務，就不用弄這麼麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060247
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060247,
					"content": "我沒記錯的話，收集地脈資料是需要調查人員深入秘境的，危險性不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060248
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060248,
					"content": "#在離開蒙德之後，{NICKNAME}和我經歷了不少戰鬥，探索秘境這種小事不算什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060249,
					"content": "#這麼久不見，{F#妳}{M#你}們好像又經歷了不少有趣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060250
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060250,
					"content": "是呀，所以麗莎不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060251,
					"content": "既然兩位是來應徵參與計畫的，那就請稍等一下，等到我和麗莎談完事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060252
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060252,
					"content": "加福爾師兄，抱歉，我是不會答應你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060253
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060253,
					"content": "真的一點轉圜餘地都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060254
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060254,
					"content": "當初執意告別教令院，這個決定我至今沒有後悔，將來的話…想必也不會後悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060255
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060255,
					"content": "本來以為過了這麼久再和妳聊，會得到不一樣的答覆，唉，麗莎妳還是跟以前一樣固執。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060256
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060256,
					"content": "妳都說到這個份上了，再強行遊說就是我自討沒趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060257
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060257,
					"content": "既然這樣，我也有不少沒處理完的事務，就不再打擾了，幾天之後的學院聚會再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060258
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060258,
					"content": "嗯，放心吧師兄，學院聚會我會準時到場的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060259
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060259,
					"content": "#至於兩位志工，稍後{F#妳}{M#你}們有空的時候，請來無郁稠林找我，還有志工的工作需要{F#妳}{M#你}們協助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060260
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060260,
					"content": "對了還有最後一件事，麗莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060261
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060261,
					"content": "怎麼了，師兄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060262
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060262,
					"content": "祝妳在蒙德順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060263
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060263,
					"content": "…我會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060264
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060264,
					"content": "好了，小可愛、派蒙，說客已經離開了，我們可以好好坐下來聊聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060265,
						735060266
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060265,
					"content": "說客？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060267,
					"content": "呵呵，教令院內部似乎發生了什麼不得了的事，我的這位師兄啊，正在為他自己的前程奔走呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060268
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060268,
					"content": "對了，麗莎怎麼會來到須彌呢？騎士團那邊沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060269
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060269,
					"content": "當然是因為琴讓我放了一個帶薪長假。既然是難得的假期，為什麼不去旅行一番，放鬆心情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060270
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060270,
					"content": "#不知道{F#妳}{M#你}們有沒有聽說過，我曾經在須彌教令院的悉般多摩學院進修過兩年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060271
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060271,
					"content": "不過畢業之後我沒有留在教令院，而是直接回到了蒙德，成為了騎士團的圖書管理員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060272
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060272,
					"content": "所以麗莎才會到須彌來吧，這樣既可以四處遊玩，又能探望以前的朋友和老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060273,
					"content": "麗莎為什麼會離開教令院呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060274
					]
				},
				{
					"id": 735060274,
					"content": "#{F#妳}{M#你}們很好奇嗎？嗯…告訴{F#妳}{M#你}們應該也沒關係吧，畢竟那都是很久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060275
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060275,
					"content": "非要說的話，只能歸結為理念不合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060276
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060276,
					"content": "當初在教令院的時候，居勒什老師非常賞識我，邀我參與了許多教令院的核心計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060277
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060277,
					"content": "不過後來，其中的大部分計畫都失敗了。說實話，為了獲得超人的智慧，他們走得太遠了，失敗也是當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060278
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060278,
					"content": "#我不想再參與這種瘋狂的事情，就選擇了離開。好了，現在{F#妳}{M#你}們都知道了，要記得為我保密喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060279
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060279,
					"content": "唔…聽起來發生過不少事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060280
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060280,
					"content": "所以就算是居勒什老師親自來遊說，我也是不會再回到教令院的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060281
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060281,
					"content": "比起沒日沒夜地做實驗，還是早晨十點之後再工作、每天有固定下午茶的生活更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060282
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060282,
					"content": "我就知道，其實麗莎是討厭麻煩才選擇做圖書管理員的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060283
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060283,
					"content": "是麗莎的風格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060284
					]
				},
				{
					"id": 735060284,
					"content": "工作那麼麻煩的事，還是要悠哉一點才好，而且定期休假可是很重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060285
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060285,
					"content": "唉，可惜剛到須彌沒多久，還沒來得及到化城郭去看望那個孩子，就被加福爾師兄找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060286
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060286,
					"content": "#說了這麼半天，{F#妳}{M#你}們呢？小可愛和派蒙又是為什麼來到須彌的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060287
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 735060287,
					"content": "和麗莎講述了來到須彌後的見聞。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 735060266,
					"content": "是指加福爾吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060240,
					"content": "不想打擾你們說話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060226,
					"content": "噓，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060211,
					"content": "（麗莎怎麼會出現在這裡？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				}
			]
		},
		{
			"id": 7350603,
			"completionStepIds": [
				7350603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350603",
							"2"
						],
						"stepId": 7350603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加福爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060301,
					"content": "#{F#妳}{M#你}們來了啊，看樣子是已經做好準備了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060302
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060302,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060303
					]
				},
				{
					"id": 735060303,
					"content": "很好，那麼我先來說明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060304
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060304,
					"content": "我們悉般多摩學院長期與地脈打交道，需要隨時監測地脈湧流情況。這次的調查計畫也是出於這個需求設立的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060305
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060305,
					"content": "由於須彌境內的秘境中時常出現地脈的異常湧流，所以我們不得不定期派人深入各處秘境記錄地脈情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060306
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060306,
					"content": "因為秘境內部的情況往往比較危險，所以我們設立的原則是「只派遣具有戰鬥能力的人員」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060307
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060307,
					"content": "#{F#妳}{M#你}們需要做的就是進入秘境深處，記錄地脈的異常情況。注意，如果遇到危險情況，請優先保護好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060308
					],
					"speakerTitle": "加福爾"
				},
				{
					"id": 735060308,
					"content": "#好，我的說明就是這些了。準備好的話，{F#妳}{M#你}們就可以進入秘境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加福爾"
				}
			]
		},
		{
			"id": 7350604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
