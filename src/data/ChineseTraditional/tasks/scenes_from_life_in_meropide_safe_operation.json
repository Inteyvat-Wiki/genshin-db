			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡特皮拉",
					"米圖爾"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "米圖爾，你還好嗎？應該沒被困太久吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330402,
					"content": "我的救星！你們總算來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330403,
					"content": "科布倫茨呢？他沒跟你們一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330404,
					"content": "是他向我求助，說你被困在這裡了。不過中途被看守打斷，他就先行離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330405,
					"content": "我就知道他不是個靠得住的生意夥伴！他一定是怕了，自己心虛理虧，所以逃跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330406,
					"content": "你說，做生意，不膽大一點能有收益嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330407,
					"content": "他笨手笨腳也就算了，還瞻前顧後的…你猜後來呢？現在不要說是「純潔之水」了，楓達都進來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330408,
					"content": "楓達進來了，我們還能有活路嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330409,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330410,
					"content": "#怎麼，{F#妳}{M#你}們也喜歡楓達嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330411,
					"content": "怎麼，你不喜歡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "我當然喜歡！我必須承認，它是相當強力的競爭對手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330415,
					"content": "不多說了，我得去找科布倫茨這傢伙算帳去了。對了，他是不是沒有支付報酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330416,
					"content": "的確沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330417,
					"content": "#…有時我真想把他塞進桶裡讓他好好反省反省。總之，請{F#妳}{M#你}們收下這些特許券。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330418,
					"content": "#請{NICKNAME}和派蒙收下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330419,
					"content": "欸？全都給我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330420,
					"content": "當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330421,
					"content": "嘿嘿，那我們就收下啦。之後有機會也可以去破爛骨頭商店看看有沒有什麼好東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330422,
					"content": "#對了，既然給{F#妳}{M#你}們添了不少麻煩，作為賠禮，我這裡有幾瓶新鮮的健康飲料，{F#妳}{M#你}們要不要喝喝看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330423,
					"content": "新鮮的…健康飲料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330424,
					"content": "比「純潔之水」健康多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330425,
					"content": "給我一杯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "（喂！卡特皮拉剛才是不是說過，還是不要喝比較好…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330427,
					"content": "#{NICKNAME}剛才說的不算！我們來之前已經…呃，已經喝了很多飲料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330431,
					"content": "真可惜啊，這麼好的健康飲料，還是之後有機會再好好品嚐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330432,
					"content": "這麼不湊巧嗎？那好吧，之後如果有機會記得來找我，我一定好好款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330433,
					"content": "那我就先告辭了，還要去找科布倫茨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330434,
					"content": "#我有些別的事要辦，就暫時道別吧。特許券的事{F#妳}{M#你}們不用太憂心了，<color=#00E1FFFF>有線索的話我會貼在黑板上的</color>。我們稍晚再會合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330435,
					"content": "嗯，那我們晚點再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330428,
					"content": "給我一杯楓達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "#有是有…嗯？{F#妳}{M#你}是不是看不起我的健康飲料？我跟{F#妳}{M#你}說哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "米圖爾"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME}不是這個意思啦！只是…只是我們來之前已經喝過很多飲料了，現在飽得不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330413,
					"content": "還好吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "哦？看來是有品味的顧客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "米圖爾"
				}
			]
		}
	]
}