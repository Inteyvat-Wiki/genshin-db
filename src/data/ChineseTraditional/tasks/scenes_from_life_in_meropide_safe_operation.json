			"dialogs": [
				{
					"id": 740330101,
					"content": "晶簇礦坑道封鎖之後，這裡就不太有人來了，這裡的機械裝置也不適合外行擺弄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330102,
					"content": "不過這次就是有人隨意擺弄傳動機閥，把自己的同伴關了起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330103,
					"content": "#總之，我們先操作傳動機閥打開通向<color=#00E1FFFF>一號備品倉庫</color>的連通路吧。如果待會他要請{F#妳}{M#你}喝什麼飲料，最好還是婉拒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330104,
					"content": "誰要請我們喝飲料？為什麼不喝呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330105,
					"content": "待會妳就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
		{
			"id": 7403304,
