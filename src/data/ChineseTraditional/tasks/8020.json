			"dialogs": [
				{
					"id": 80200601,
					"content": "和我預想的一樣，「虛假的記憶」果然是個陷阱，深淵教團真的跟著我們來到了這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200602,
					"content": "這樣一來，也就有機會見到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200603,
					"content": "唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200604,
					"content": "戴因？你突然怎麼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200605,
					"content": "感受到了嗎？是地脈的擾動，深淵教團又在搗什麼鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200606,
					"content": "你的體質還真是敏感，我好像沒什麼感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200607,
					"content": "#{NICKNAME}，{F#妳}{M#你}們先用那邊的機關離開吧，按我說的做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200608,
					"content": "留你一個人在這裡，真的沒關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "深淵教團正在行動，現在回維摩莊的話，或許有機會抓到那個「失蹤者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200610,
					"content": "…也可以當做是兵分兩路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200611,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "（照理說應該是這樣沒錯…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "（但總覺得好像哪裡有點「違和」…是我漏掉了什麼事情嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "哼…我就知道，除非主動踏入你們的陷阱，不然你是不可能來面見我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200615,
					"content": "你將自己與「耕地機的眼睛」都作為賭注…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "賭注如此之大，禁不住誘惑而踏入陷阱的，應該是我才對吧，「末光之劍」戴因斯雷布？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "你一個人來的？你的那些信徒們呢，怎麼沒帶在身邊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200618,
					"content": "在有所防備的「末光之劍」面前，投入多少兵力都是一種無謂的浪費，還不如由我一人來直面你。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "我知道你有很多話想說…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "…但在那之前，先擊敗我，如何？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
