					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200306,
					"content": "…事不宜遲，我們趕快進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200307,
					"content": "（剛剛戴因想要和我說什麼…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "喂，等等我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
