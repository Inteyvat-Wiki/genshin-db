			},
			"dialogs": [
				{
					"id": 80200201,
					"content": "欸，戴因？喂…戴因！你在這裡發什麼呆呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200203,
					"content": "是遇到什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200204,
					"content": "怎麼了，戴因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "#{NICKNAME}，{F#妳}{M#你}們說的那個失蹤者…是個什麼樣的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200206,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200207,
					"content": "大概二十歲出頭的男性青年吧，到底怎麼了呀，戴因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200208,
					"content": "現在我的腦海裡似乎憑空多了一些東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200209,
					"content": "…是一段有關他的「記憶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200210,
					"content": "什麼…？會不會…會不會是我們昨天聊了太多有關他的事，所以你昨晚做了一個這樣的夢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200211,
					"content": "不，那不是夢，是今早我醒來以後忽然出現在腦海中的一段記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200212,
					"content": "而且我很確定，我從未見過這個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200213,
					"content": "那「記憶」的內容是什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "我記得，在那段回憶裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200215,
					"content": "…我把「世界上第一顆耕地機的眼睛」送給了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200216,
					"content": "！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "啊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200218,
					"content": "…所以現在可以確定，那個失蹤者與深淵教團有關聯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200219,
					"content": "嗯，而且那個傢伙，應該擁有向人們的腦海中「投放」記憶的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200220,
					"content": "究竟是如何做到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "那要是這麼說的話，維摩莊的大家會不會也只是被投放了虛假的記憶？原本大家應該不認識他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200222,
					"content": "可是這麼做的目的又是什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200223,
					"content": "今早的這件事，對深淵教團來說，其實也暴露了一個事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200224,
					"content": "暴露了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200225,
					"content": "他們的目標…依舊是「世界上第一顆耕地機的眼睛」，並沒有把尋找它的事情拋在腦後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200226,
					"content": "對我投放這樣的一段記憶，想必是為了擾亂唯一知道「眼睛」下落的我的思維…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200227,
					"content": "那「眼睛」現在還安全嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "#{F#妳}{M#你}的擔憂並不是沒有道理，儘管我認為深淵教團應該還沒有能力讓那段記憶變成現實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200230,
					"content": "但考慮到他們對「眼睛」的執著程度，我們也應該拿出對等程度的謹慎才穩妥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200231,
					"content": "和我一起去確認一下吧，「眼睛」是否還在我們手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200232,
					"content": "是要到你藏「眼睛」的地方去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200233,
					"content": "（…可是，如果我們就這樣過去的話，萬一被跟蹤，豈不是反而暴露了隱藏位置？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "（也或許，這原本就是深淵教團投放那段記憶給戴因的目的？引起他的疑心，讓他產生再次確認的想法…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200236,
					"content": "（根據我對戴因的瞭解，他不可能沒意識到這一點…看他的樣子，應該是有別的想法…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "那我們走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200238,
					"content": "你帶路，戴因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "有沒有可能，「記憶」是真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
