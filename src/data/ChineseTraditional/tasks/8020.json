			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "#{F#妳}{M#你}們針對現狀，再次向維摩莊的村民們收集了線索，直到天色暗了下來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "#原來{F#妳}{M#你}們是接到了那樣的委託，才來到這裡的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200124,
					"content": "「似乎只存在於記憶中的人」…的確令人在意，我也並不認為這會是一起普通的失蹤案，但還不能確定與深淵教團的關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200125,
					"content": "除此之外，就只有丘丘人的躁動這種浮於表面的線索了，還是沒什麼收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200126,
					"content": "好了，那麼現在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#就是{NICKNAME}血親的記憶裡，那個神秘的聲音，好像是什麼…「罪人」，他到底是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200129,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}，{F#妳}{M#你}會認為…{F#妳}{M#你}的血親「背叛」了{F#妳}{M#你}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200131,
					"content": "#我想要相信{M#她}{F#他}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "#是嗎…在徹底弄清真相之前，我看出了{F#妳}{M#你}的猶豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200134,
					"content": "在任何不可挽回的事情出現之前，你們的關係完全還有轉圜的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200135,
					"content": "#不像{F#妳}{M#你}們想要瞭解的那個「罪人」，他和其他「罪人」一起，早已背叛了國家，也背叛了我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200136,
					"content": "他的名字…是「預言家」維瑟弗尼爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200137,
					"content": "雖不願提起，但他的確也是我的血親，我的「哥哥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200138,
					"content": "那個人是…戴因的哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200139,
					"content": "你們之間究竟發生了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "「罪人」共有五人…也即是坎瑞亞的「五大罪人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200142,
					"content": "「賢者」海洛塔帝、「預言家」維瑟弗尼爾、「黃金」萊茵多特、「極惡騎」蘇爾特洛奇，以及「獵月人」雷利爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200143,
					"content": "無論我的記憶如何磨損，這些名字都不會忘卻，終有一天…我會向他們所有人復仇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200144,
					"content": "這些名字！很多都很熟悉…創造阿貝多的萊茵多特、絲柯克的師父蘇爾特洛奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200145,
					"content": "還有我們剛剛知道的，引導克洛達爾創立深淵教團的，戴因的哥哥…「預言家」維瑟弗尼爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200146,
					"content": "一切在冥冥之中串聯在一起了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "（這麼說的話，在楓丹遺蹟內發現的預言石板，高機率也是出自維瑟弗尼爾之手吧？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "他們都曾是在坎瑞亞被寄予厚望的人，是各個領域同輩中的翹楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200149,
					"content": "計畫本應是由包含我在內的六人一同前往阻止災厄的發生，阻攔黑王繼續動搖世界的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200150,
					"content": "然而心底埋藏著各自欲望的那五人，沒能禁得住「深淵」的誘惑，瓜分了那些足以毀滅世界的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200151,
					"content": "他們成為了「罪人」，也成為了超然的存在，每個人所掌持的力量都能與世界相匹敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200152,
					"content": "而後坎瑞亞災變發生，他們卻沒有任何一個人站出來阻止這場悲劇…我無法原諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200153,
					"content": "然後就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "…沒錯。如果繼續放任，我相信他們終有一天，也會將整個世界「背叛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200156,
					"content": "提起這些想必很不好受吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "#沒什麼，我說過的，我不打算迴避{F#妳}{M#你}的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200159,
					"content": "那麼戴因，之前那段時間，你有調查到什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200160,
					"content": "我繼續在追查關於「命運的織機」的問題，自那份「命運的織機原動計畫」啟動，已經過去很多時日了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200161,
					"content": "儘管我們曾經透過奪取「世界上第一顆耕地機的眼睛」，阻止了他們計畫的某個階段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200162,
					"content": "我記得，是說要改造魔神奧賽爾什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200163,
					"content": "嗯，不過…很明顯，那應該也只是某種技術性試驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200164,
					"content": "即便他們還尚未得到那顆不可或缺的「耕地機的眼睛」，但他們選擇跳過了試驗階段，依然在以某種方式推進著計畫的執行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200165,
					"content": "有很多跡象都能表明這一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200166,
					"content": "那怎麼辦？還來得及嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200167,
					"content": "當務之急…是要弄清楚命運的織機究竟是用來做什麼的，以便由此反推深淵教團的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200168,
					"content": "根據我目前所掌握的線索，我猜測命運的織機…應該和「地脈」有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200169,
					"content": "地脈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200170,
					"content": "#上次{NICKNAME}能夠看到血親的記憶，其原因便是那一帶的地脈不穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200171,
					"content": "而最近，我在追查深淵教團的期間發現，只要是他們活躍的地帶，都會伴隨著一系列的地脈問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200172,
					"content": "提瓦特的地脈中流淌著「記憶」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "欸，那按照戴因的說法，這次我們來維摩莊要找的那個「似乎只存在於記憶中的人」，或許也可以串聯起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200174,
					"content": "（記憶…地脈…命運的織機…只存在於記憶中的人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "（串聯這一切的究竟會是什麼…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "#{F#妳}{M#你}們說的這些不無可能。明天我也會加入{F#妳}{M#你}們的調查，這次的事件的確可能會成為某種契機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80200177,
					"content": "又要和戴因一起行動了嗎，那我們趕快養精蓄銳，明天去稍遠一點的地方再看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200401,
					"content": "哈欠——昨天有點用腦過度，現在還是睏睏的…都怪戴因說了那麼多難懂的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200402,
					"content": "我也有點失眠了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "我們去找戴因吧，今天還有很多事情要做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80200403,
					"content": "腦子裡感覺亂亂的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "謝謝你把這些都告訴我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "我的血親，接觸了你的哥哥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "當時的坎瑞亞究竟發生了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "大概已經算是一種背叛了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "當初答應我的情報呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
