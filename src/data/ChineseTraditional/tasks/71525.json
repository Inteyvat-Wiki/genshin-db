			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "精彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "「且聽下次覆盤」"
				},
				{
					"id": 716662102,
					"content": "原來荒瀧派所擅長的鬥蟲，發展成了如此激昂的角逐。嗯…的確能寫成引人入勝的故事，好好說道說道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "「且聽下次覆盤」"
				},
				{
					"id": 716662103,
					"content": "田兄台，讓承了。我鬥得很盡興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662104,
					"content": "是「承讓了」，鬼王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716662105,
					"content": "咳咳！細節不重要！總之…多謝田兄台捧場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662106,
					"content": "也有勞荒瀧幫主了。這段時間，我還會在此觀摩鬥蟲，好好取材！你們盡情玩，不理會我也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "「且聽下次覆盤」"
				},
				{
					"id": 716662107,
					"content": "真是個文雅的對手，說得我腦袋嗡嗡的，感覺好像學到了一些鬥蟲之外的知識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662108,
					"content": "看來這次「荒瀧甲光烈烈鬥蟲大修行」還真是開了個好頭啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
