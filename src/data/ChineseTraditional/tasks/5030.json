						50300505
					],
					"speakerTitle": "瑪亞薇"
				},
				{
					"id": 50301601,
					"content": "#原來是{F#妳}{M#你}們，很高興看到{F#妳}{M#你}們沒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪亞薇"
				},
				{
					"id": 50300506,
					"content": "妳兒子的情況如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "我不知道，通訊幾乎斷了，送來的傷員一個接一個，我必須集中精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "瑪亞薇"
				},
				{
					"id": 50300508,
					"content": "但我相信他，他一定能在關鍵的時候做出正確的判斷，因為他是我的兒子，我始終都為他驕傲。",
					"roleType": "TALK_ROLE_NPC",
