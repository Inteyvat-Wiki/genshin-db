			"dialogs": [
				{
					"id": 50300801,
					"content": "#是{F#妳}{M#你}們，太好了！謝謝{F#妳}{M#你}們一直鼓勵我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "烏圖倫庫"
				},
				{
					"id": 50300802,
					"content": "納塔有很多人都把對抗深淵視為榮耀，但他們也會被熱血沖昏頭腦，不知不覺就陷入險境之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "烏圖倫庫"
				},
				{
					"id": 50300803,
					"content": "#{F#妳}{M#你}們說得很對，戰鬥很重要，生命也很重要，我們為所愛之人戰鬥，所以我們還要去和所愛之人重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "烏圖倫庫"
				},
				{
					"id": 50300804,
					"content": "#我轉告了{F#妳}{M#你}們的想法之後，戰友們都很認可，在戰鬥中也變得穩重了很多，我們取得了非常好的成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "烏圖倫庫"
				},
				{
					"id": 50300805,
					"content": "#真的要謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏圖倫庫"
				}
			]
		},
