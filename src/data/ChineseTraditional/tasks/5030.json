			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧希娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "#我看到{F#妳}{M#你}們把葵可女士送回來了…對此我很遺憾，葵可女士真的是一位前途無限光明的醫生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "奧希娜"
				},
				{
					"id": 50300202,
					"content": "我們在業務上有很多合作，她對於藥物的品質有很高的要求，有時候為了替別人治病，還會自掏腰包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "奧希娜"
				},
				{
					"id": 50300203,
					"content": "她和我說比起賺錢，她更看重經驗的累積。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "奧希娜"
				},
				{
					"id": 50300204,
					"content": "只有掌握最精湛的醫術才能讓她救最多的人，同時，也讓她不會錯過她最想救的那個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "奧希娜"
				},
				{
					"id": 50300205,
					"content": "可惜，可惜，醫者難自醫，納塔失去了如此傑出的一位英才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧希娜"
				}
			]
		},
