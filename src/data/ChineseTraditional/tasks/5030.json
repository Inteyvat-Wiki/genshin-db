					"琪絲佩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "天啊，人也不夠，東西也不夠，就我這三腳貓的技術，很多傷口根本處理不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "琪絲佩"
				},
				{
					"id": 50300102,
					"content": "要是有更專業的人在就好了…不行不行，還不是嘆氣的時候，我得打起精神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琪絲佩"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
