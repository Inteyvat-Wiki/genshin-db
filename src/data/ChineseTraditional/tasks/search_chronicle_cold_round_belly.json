			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "#兩位，等{F#妳}{M#你}們好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670102,
					"content": "和爆炎樹變成朋友了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "#唉，不要說了。經過{F#妳}{M#你}那一番「交涉」，它安分是安分了，但也就那麼一下子而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670104,
					"content": "#一恢復過來，馬上又是要置我於死地的架勢，真是嚇人。看來{F#妳}{M#你}們是對的，要和爆炎樹交朋友還是太勉強了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670105,
					"content": "啊，不過爆炎樹的果實味道還不錯，有火元素的味道。納塔朋友應該會喜歡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670106,
					"content": "好難想像是什麼味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670107,
					"content": "#{F#妳}{M#你}要吃吃看嗎？如果要的話我現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670108,
					"content": "還、還是不用了！話說回來，你是準備繼續去挑戰古岩龍蜥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670109,
					"content": "對啊。我覺得這次贏面很大，畢竟古岩龍蜥和嵴鋒龍滿像的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670110,
					"content": "#如果{F#妳}{M#你}們像我一樣從須彌去納塔的話，第一個碰見的應該就是牠們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670111,
					"content": "好吧，不過我還是有種這次也不會成功的感覺…為什麼不考慮一下幼岩龍蜥呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670112,
					"content": "…沒有圓滾滾的肚皮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670113,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670114,
					"content": "幼岩龍蜥沒有圓滾滾的肚皮。一定是因為牠們經常以匪夷所思的速度轉圈，所以幾乎沒有囤積脂肪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670115,
					"content": "唉…不過最主要的原因還是缺乏衝擊力吧…對那些和龍一起生活的納塔朋友來說，幼岩龍蜥有什麼稀奇的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670116,
					"content": "古岩龍蜥就不一樣了，哪怕在故事裡也算得上是夠格的對手了。對手強才可以顯得主角強嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670117,
					"content": "好了，我們也不要耽擱了，古岩龍蜥就在前面等著我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 716670118,
					"content": "那就走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "還有別的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "#沒問題，我就在這裡等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭吉特"
				}
			]
		}
	]
}