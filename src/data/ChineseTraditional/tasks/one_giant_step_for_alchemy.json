				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂瑪烏斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "只要再多啟動幾次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110402,
					"content": "#旅行者！{F#妳}{M#你}來得正好，還記得那座「原素烘爐」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110403,
					"content": "#在{F#妳}{M#你}啟動「原素烘爐」之後，我在旁邊也蒐集了不少數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110404,
					"content": "而且最重要的是，我已經確定了它的可靠性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110405,
					"content": "有了這麼一座可靠的器材，接下來就可以進行更多的實驗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110406,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能幫我再去啟動一下「原素烘爐」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110409,
					"content": "要實驗多少次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "當然是越多越好，像我這種沒有「神之眼」的煉金術師，只能用這種笨辦法來研究了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110411,
					"content": "#所以就拜託{F#妳}{M#你}了，旅行者，幫我再去啟動一下「原素烘爐」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				}
			]
		}
	]
}