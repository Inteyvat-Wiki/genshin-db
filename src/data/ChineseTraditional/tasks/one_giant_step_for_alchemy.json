				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110301,
					"content": "#{F#妳}{M#你}來了，這就是我的<color=#00E1FFFF>「原素烘爐」</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 409110302,
					"content": "多餘的話也不說了，我們趕快開始試驗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				}
			]
		},
		{
			"id": 4091104,
			"completionStepIds": [
				4091104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091104",
							"2"
