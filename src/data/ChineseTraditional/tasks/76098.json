					}
				]
			},
			"dialogs": [
				{
					"id": 760982801,
					"content": "格蕾茲娜…？妳這可恥的叛徒，竟敢出現在我的面前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982802
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982802,
					"content": "#嗚哇，{NICKNAME}，小心啊！那個怪物好像被引出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760982803,
					"content": "不，不，妳不是格蕾茲娜…我嗅不到妳的氣味——你是什麼？是活人，還是另一個徘徊在魔天中的死魂靈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982804
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982804,
					"content": "沒人能活著闖進這座墳墓…他們的墳墓，我們的墳墓。回答我，回答我！是霍德望教授派你來的嗎？我的主人是否饒恕我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982805,
						760982817,
						760982820
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982805,
					"content": "你就是「末日」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982806
					]
				},
				{
					"id": 760982806,
					"content": "<color=#FF5E41FF>末日</color>？<color=#FF5E41FF>末日</color>！呵…哈哈…看看外面的世界吧，<color=#FF5E41FF>末日</color>已經降臨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982807
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982807,
					"content": "索洛維家的小少爺想阻止它，那個冒充雷德·米勒的布萊赫想阻止它，叛徒格蕾茲娜想阻止它——但它還是來了，它還是來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982808
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982808,
					"content": "我的主人…霍德望教授…他已經用「三寶磨」將那可笑的世界焚作薪柴，只有這座避難所依然漂泊在滅卻後的魔天中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982809,
						760982810
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982809,
					"content": "所以你覺得世界已經毀滅了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982811
					]
				},
				{
					"id": 760982811,
					"content": "#「世界」已是舊日的死棺…我不知曉{F#妳}{M#你}們從何而來，但我已從天殼中破繭而出，再也不受引力與命理的羈絆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982812
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982812,
					"content": "#{F#妳}{M#你}呢？{F#妳}{M#你}不是主人的僕從，但{F#妳}{M#你}也不是那些蠢物…{F#妳}{M#你}是要加入我們，我們的血肉，還是現在就去死？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982813
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982813,
					"content": "<color=#00E1FFFF>加入</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982814
					],
					"speakerTitle": "「末綴之劫」",
					"speakerSubtitle": "溫和的女聲"
				},
				{
					"id": 760982814,
					"content": "還是<color=#FF5E41FF>去死</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982815
					],
					"speakerTitle": "「末綴之劫」",
					"speakerSubtitle": "熱情的男聲"
				},
				{
					"id": 760982815,
					"content": "世界沒毀滅，你就在海底。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982816
					]
				},
				{
					"id": 760982816,
					"content": "#夠了！不要再噴吐{F#妳}{M#你}那惡毒的謊言了，褻瀆者！我的主人不會欺騙我，我等早已身處魔天之間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982825,
					"content": "隨葬於那滅卻的世界吧，唯有我等能夠存續於魔天——我的主人啊，請你見證！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982826
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982826,
					"content": "#嗚啊，沒辦法了，{NICKNAME}，我們先試著用這些植物來對付它吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760982810,
					"content": "外面的世界還好好的呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982811
					]
				},
				{
					"id": 760982817,
					"content": "聽不懂，看劍！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982818
					]
				},
				{
					"id": 760982818,
					"content": "對嘛對嘛，完全聽不懂你在說什——不對，哪來的劍啊！我們的劍不是在避難所門口就被沒收了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760982819,
					"content": "#不要緊…不要緊！無知的蠢物啊，就算格蕾茲娜那個叛徒將我囚禁在這裡，{F#妳}{M#你}的血肉也會成為「明日」的食糧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982820,
					"content": "霍德望死了，你是下一個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982821
					]
				},
				{
					"id": 760982821,
					"content": "#呵…哈哈…我原本還以為，只有我會用這般粗劣的謊言去欺騙那些蠢貨，沒想到{F#妳}{M#你}會用我的手段來對付我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982822
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982822,
					"content": "別想騙我！別想騙我們！霍德望教授不會死去，不，不會，否則提瓦特又怎會毀滅？我們又怎會漂泊在魔天之間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982823
					],
					"speakerTitle": "「末綴之劫」"
				},
				{
					"id": 760982823,
					"content": "提瓦特沒毀滅，你就在海底。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760982824
					]
				},
				{
					"id": 760982824,
					"content": "#夠了！不要再噴吐{F#妳}{M#你}那惡毒的謊言了，褻瀆者！我的主人不會欺騙我…我已從天殼中破繭而出，再也不受引力與命理的羈絆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760982825
					],
					"speakerTitle": "「末綴之劫」"
				}
			]
		}
	]
}