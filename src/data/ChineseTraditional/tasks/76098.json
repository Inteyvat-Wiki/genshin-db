			"dialogs": [
				{
					"id": 760980301,
					"content": "「…歡迎來到（…）號避難所，遠道而來的朋友…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980302
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980302,
					"content": "「…如果您正在聽這段錄音，那便意味著<color=#FF5E41FF>末日</color>即將來臨…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980303
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980303,
					"content": "哇啊！嚇我一跳，這個居然還會響喔…不對，比起那個，它剛才是不是說了什麼雖然我沒聽懂但是好像很可怕的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980304,
						760980305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980304,
					"content": "好像在說什麼末日的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980308
					]
				},
				{
					"id": 760980308,
					"content": "「…幸運的是，您找到了這裡，而我們也有幸能與您…共同…<color=#FF5E41FF>末日</color>後的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980309
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980309,
					"content": "「…請…密鑰卡…<color=#00E1FFF>升降梯</color>已接通至…安全後…搭乘…前往避難所…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980310
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980310,
					"content": "嗚啊，是機器壞掉了嗎？雜音把她的聲音蓋過去了，聽不清楚她後面在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980311,
					"content": "#完全搞不懂這裡是用來做什麼的…{NICKNAME}，不然我們還是進去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980305,
					"content": "沒什麼，只是末日要來了而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980306
					]
				},
				{
					"id": 760980306,
					"content": "哦哦，原來只是末日啊，那我就放心了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980307,
					"content": "怎麼可能放心啦！這種時候就別用那種像是在說「明天的早餐是野菇雞肉串」一樣理所當然的語氣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980308
					],
					"speakerTitle": "派蒙"
				}
			]
		},
