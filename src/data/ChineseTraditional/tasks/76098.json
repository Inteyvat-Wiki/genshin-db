					"nextDialogs": [
						760980105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980105,
					"content": "唔，搞不懂。總之我們先回那個終端機那裡，看看這次的密鑰卡可以解鎖什麼東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
