				},
				{
					"id": 760980704,
					"content": "（查詢一號研究區狀態。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980705
					]
				},
				{
					"id": 760980705,
					"content": "正在產生狀態報告，請稍候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980706
					],
					"speakerTitle": "避難所主控制終端機"
				},
				{
					"id": 760980706,
					"content": "<color=#00E1FFF>一號研究區</color>：<color=#FF5E41FF>警告</color>。偵測到高濃度深淵汙染。目前外溢風險：<color=#FF5E41FF>極高</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980707
					],
					"speakerTitle": "避難所主控制終端機"
				},
				{
					"id": 760980707,
					"content": "<color=#FF5E41FF>末日</color>淨化系統：<color=#FF5E41FF>阻塞中</color>。已派遣維修人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980708
					],
					"speakerTitle": "避難所主控制終端機"
				},
				{
					"id": 760980708,
					"content": "距離上次呼叫維修已有：<color=#FF5E41FF>錯誤</color>標準小時。請勿恐慌，公民，保持冷靜並等待監督指示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980709
					],
					"speakerTitle": "避難所主控制終端機"
				},
				{
					"id": 760980709,
					"content": "嗚哇，這個什麼淨化系統根本完全沒有用嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980710,
					"content": "我懂了，「末日」其實就是指深淵汙染吧？唉，明明建造避難所就是為了抵禦深淵，結果沒想到裡面被侵蝕得還比外面嚴重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980711,
						760980713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980711,
					"content": "看來沒能抵禦成功呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980712
					]
				},
				{
					"id": 760980712,
					"content": "#{NICKNAME}，我們想想辦法吧？放著不管的話，深淵災害說不定會外溢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980715,
					"content": "先去一號研究區看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980716
					]
				},
				{
					"id": 760980716,
					"content": "嗯嗯，我們走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980713,
					"content": "真的只是這麼簡單嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980714
					]
				},
				{
					"id": 760980714,
					"content": "我也搞不清楚啦。不過，要是放著不管的話，深淵災厄說不定會外溢…還是得先把問題解決掉才可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980715
					],
					"speakerTitle": "派蒙"
				}
			]
