						],
						"pointId": 361100003
					}
				]
			},
			"dialogs": [
				{
					"id": 760980201,
					"content": "偵測到未登記居民。正在啟動標準安全檢查程式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980202
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980202,
					"content": "掃描完成。偵測到您帶有<color=#FF5E41FF>多件危險物品</color>。為了其他避難所居民的安全，請將所有武器及危險物品放入指定的收納櫃中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980203
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980203,
					"content": "欸，要我們把武器交出去？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980204,
					"content": "請諒解。沒收危險物品是為確保避難所居民的絕對安全。您的所有物品將被妥善保管，待您離開時即可取回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980205
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980205,
					"content": "若您有安全方面的顧慮，還請務必放心。避難所內部搭載了最先進的<color=#FF5E41FF>末日</color>淨化系統，您不會遇到任何危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980206
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980206,
					"content": "以（…）教授的名譽擔保，無論天幕之外有何種魔物侵擾，都絕不會滲入我們的樂園分毫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980207
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980207,
					"content": "呃，天幕之外？我們不是在海底嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980209
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980209,
					"content": "哦哦，我懂了！就和那夏鎮的小說裡寫的一樣，這個所謂的「末日」，其實是打算侵略我們提瓦特的外星人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980210,
						760980211,
						760980212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980210,
					"content": "少看一點便宜的娛樂小說吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				},
				{
					"id": 760980213,
					"content": "我只是在開玩笑啦！就算真的有天外來的侵略者，也不會跑到這種地方來…呃，應該不會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980214,
					"content": "不過話說回來，既然是避難所，為了安全考量要求卸下武器也…還算合理吧？除非這裡其實在做什麼奇怪的壞事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980215,
					"content": "例如故意只提供超級難吃的食物之類的，或者故意讓淨水裝置隔段時間就壞一次之類的，又或者是大門永遠都打不開之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980216,
					"content": "請不必擔憂。本避難所旨在提供絕對安全的庇護環境，所有居民均可隨時自由離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980217
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980217,
					"content": "#呃，既然它都這樣講了…那不然我們就先按照它講的做吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760980218,
					"content": "感謝您的配合。危險物品已收納。掃描完成，未偵測到其他威脅。標準安全檢查程式結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760980219
					],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980219,
					"content": "歡迎來到<color=#FF5E41FF>末日</color>後的避難所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古老的終端機"
				},
				{
					"id": 760980211,
					"content": "這個…也不是沒有這種可能啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				},
				{
					"id": 760980212,
					"content": "原來如此，那絲柯克說不定會知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760980213
					]
				}
			]
		},
