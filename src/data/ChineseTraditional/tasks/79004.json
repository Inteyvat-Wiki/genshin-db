				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "已經記錄了這麼多壁畫了。連起來看的話，也能大致理解上面記錄的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩伊德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "嗯，這些壁畫裡所描繪的內容倒是不難解讀。雖然我不太拿得準這些壁畫之間的順序，但我們一幅幅地來理解，應該也不會有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040402,
					"content": "首先是這幅畫，上面記錄了一群遭遇了海難的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040403,
					"content": "#在遭遇海難後，他們應該是流落到了{F#妳}{M#你}找到壁畫的那片島嶼上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040404,
					"content": "然後，他們就在那片島嶼上住了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040405,
					"content": "我們再看看這幅壁畫，這幅畫中描繪了五個物體，而且這五個物體內部，還有著不同的標識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040406,
					"content": "就像是五個盛了水的杯子一樣，而且每個杯子裡所盛水的量還不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040407,
					"content": "一般來說，這種描繪方式其實是在暗示著某種事物狀態的變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040414,
					"content": "事物狀態的變化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "但具體什麼事物我可沒辦法推測出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040409,
					"content": "不過，如果這是一座在海中的島嶼，那這種事物，也許就是「海水」也說不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040410,
					"content": "我們往後看，接下來是這一張",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040411,
					"content": "在又一次的海難後，這片島嶼來了新的「客人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040412,
					"content": "#{F#妳}{M#你}看，這應該是第一批人正在試圖營救第二批人，而且，{F#妳}{M#你}看這裡描繪的斷船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040413,
					"content": "在第一幅壁畫裡，船隻是一個用來暗示他們處境的意象，但在這一幅畫中，對於斷船的描繪卻格外具體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040416,
					"content": "或許這艘斷船對這群流落荒島的人來說，有著非比尋常的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040417,
					"content": "之後就是這一幅壁畫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040418,
					"content": "#在這幅壁畫中，{F#妳}{M#你}們應該也能發現，在畫中的山上，有一處特別的標記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040419,
					"content": "我想，對於那群人來說，那個位置應該有著什麼重要的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040422,
					"content": "最後就是這一幅。他們顯然找到了離開這座島的方法，並且就此離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040423,
					"content": "這些壁畫所描繪的故事應該就是這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790040424,
					"content": "謝謝您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "不用客氣，我本來就對這方面的研究有些興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
