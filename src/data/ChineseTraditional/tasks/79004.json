				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "#{F#妳}{M#你}好朋友，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041202,
					"content": "那個，你是「學者」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790041203,
					"content": "呵呵，算是吧。雖然嚴格來說，我其實是一位「遊學者」，但…「遊學者」當然也算是「學者」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041204,
					"content": "#怎麼，{F#妳}{M#你}們遇見了什麼必須要「學者」才能解決的問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041205,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "海上的島嶼…還有島嶼裡的壁畫，有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041207,
					"content": "#然後，{F#妳}{M#你}們之所以想要尋找學者，其實也是想要解讀那些壁畫，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041208,
					"content": "您願意幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "當然，對於這些未知的故事，我從來都無法拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041213,
					"content": "那我們事不宜遲，請把那些壁畫給我看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041214,
					"content": "這些是我們記錄的壁畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "嗯…不錯，不錯。抱歉，請容我思索一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041210,
					"content": "我們可以付報酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "#哈哈哈，看{F#妳}{M#你}這作風，你應該是一位經驗豐富的冒險家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "薩伊德"
				},
				{
					"id": 790041212,
					"content": "#不過對我來說，這些未知的故事就是最好的報酬，{F#妳}{M#你}不用再額外付我什麼東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "薩伊德"
				}
			]
		},
