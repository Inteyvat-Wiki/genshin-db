			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040101,
					"content": "#咦？{F#妳}{M#你}看這裡，石頭上好像…畫著什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 790040102,
					"content": "看起來，像是一艘船遇上了海難…然後還有好多人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 790040103,
					"content": "真難懂…總之先把這幅壁畫記錄下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "觀察"
				}
			]
		},
