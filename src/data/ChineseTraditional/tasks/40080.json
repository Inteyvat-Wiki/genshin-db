			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"諾艾爾",
					"砂糖",
					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800201,
					"content": "也不知道雷澤那邊，「補習」的進展是不是順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800202,
					"content": "砂糖小姐，請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800203
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800203,
					"content": "#{NICKNAME}前輩、派蒙，請幫我攔住她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800204
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800204,
					"content": "哇，嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800205,
					"content": "妳們兩個，怎麼慌慌張張的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800206,
					"content": "#是這樣的，我和砂糖小姐說好要一起把釀酒材料交給{F#妳}{M#你}們，但她一聽說雷澤也要來，說什麼都不肯留在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800207
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800207,
					"content": "我…我不擅長和陌生人打交道，只要材料能平安送到就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800208
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800208,
					"content": "這怎麼行呢！既然是我們兩人合作完成的，就應該一起出面。我不能搶了砂糖小姐的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800209
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800209,
					"content": "不是…功勞什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800210
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800210,
					"content": "這麼看來，騎士團準備的材料是「生物煉金」的產物囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800211,
					"content": "對，是「四倍甜日落果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800212
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800212,
					"content": "四倍甜？普通的甜度還不夠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800213,
					"content": "而且…為什麼是日落果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800214,
					"content": "嗯，這就要從頭說起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800215
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800215,
					"content": "我很喜歡聞酒的味道，對釀酒這件事情，也學習和總結過一些經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800216
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800216,
					"content": "從結論來說，原材料的甜味是必不可少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800217
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800217,
					"content": "為了選出最適合的那一種，我找來了蒙德周邊所有含有甜味的植物和果實，逐一試吃並記錄了一份完整的清單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800218
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800218,
					"content": "不同地點的同種素材也納入了考量，比如清泉鎮附近的甜甜花會比誓言岬的更甜一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800219
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800219,
					"content": "哇，聽起來工作量好大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800220,
					"content": "沒關係，這就是我身為「騎士團女僕」應該做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800221
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800221,
					"content": "能夠代表騎士團，找到「守護的執著」，對我來說也是無上的榮幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800222
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800222,
					"content": "諾艾爾的眼睛，在發光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800223,
					"content": "但我覺得，她是被麗莎小姐給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800224,
					"content": "派蒙，噓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800225
					]
				},
				{
					"id": 400800225,
					"content": "啊，說回正題。只有我獨自進行評測的話，我會擔心陷入主觀。那天剛好遇到了從實驗室裡出來的砂糖小姐，就問了問她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800226
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800226,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800227
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800227,
					"content": "怎麼了，砂糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800228
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800228,
					"content": "我突然想起來…我出門是為了去領最近進口的一批實驗器材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800229
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800230
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800230,
					"content": "看妳們的臉色…該不會是把這事情忘記了，一直在實驗室裡待到今天吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800231,
					"content": "嗯，是的…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800232
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800232,
					"content": "唉，別在意，我也有責任。器材我晚點再去找瑪喬麗小姐吧。諾艾爾，妳先繼續說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800233
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800233,
					"content": "是，是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800234
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800234,
					"content": "砂糖小姐不愧是專業的研究員！對我的清單提出了寶貴的建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800235
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800235,
					"content": "就不用特地誇我了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800236,
					"content": "在那之後，諾艾爾也告訴了我事情的經過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800237
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800237,
					"content": "她明明不認識那位名叫雷澤的少年，卻做得那麼認真…讓我很感動。但在我看來，現有材料都不足以達到「完美」這一要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800238
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800238,
					"content": "我們需要的是一種含糖量高又便於發酵的水果，最後，我從清單裡選擇了果酒湖周圍採集的日落果樣本作為基礎，將它改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800239,
					"content": "透過「生物煉金」放大甜味的特徵，再加以實驗對照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800240
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800240,
					"content": "一旦開始做實驗，砂糖小姐的毅力就令我自愧不如！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800241
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800241,
					"content": "啊，都說了請不要誇獎我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800242,
					"content": "總之…「伍式日落果改陸參號四倍甜度版」，終於研發成功了，甜度經過嚴格測量，色澤和飽滿度也是一流的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800243,
					"content": "諾艾爾把它簡稱為「四倍甜日落果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800244,
					"content": "可惜現在的條件還沒辦法大規模量產…這次能幫上雷澤就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800245,
						400800246
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800245,
					"content": "一定可以的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800248
					]
				},
				{
					"id": 400800248,
					"content": "#{NICKNAME}，我還有一些話想說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800249
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800249,
					"content": "從小到大…我都生活得很幸福。雖然一直不太擅長跟人打交道，但父母從沒對我提過要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800250
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800250,
					"content": "他們從沒對我說過「妳應該表現得更開朗一點」，只是告訴我「做自己喜歡的事就好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800251
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800251,
					"content": "我知道…我是幸運的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800252
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800252,
					"content": "雷澤的生活，我從未經歷過，也無從想像。貿然說這些話只會是冒犯。但我真心希望他能過得快樂，能去做自己想做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800253
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800253,
					"content": "砂糖小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800254
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800254,
					"content": "「咔嗒——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800255
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800255,
					"content": "對不起，我又來晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800256
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800256,
					"content": "師父，忘記看時間，一直，在說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800257
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800257,
					"content": "沒事喔，我們剛好也在聊天呢。欸，總感覺這兩天說過一模一樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800258,
					"content": "（咦，等等，砂糖怎麼不見了？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800259,
					"content": "（竟然趁他推門出來的時機跑掉了？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800260
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800260,
					"content": "你好！我是西風騎士團的女僕諾艾爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800261
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800261,
					"content": "妳好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800262
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800262,
					"content": "這份材料請你收下。這並不是我一個人準備的！另一位煉金術士，她現在…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800263
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800263,
					"content": "她工作有點忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800264
					]
				},
				{
					"id": 400800264,
					"content": "啊，對…很遺憾，不能親手交給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800265
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800265,
					"content": "藥劑，花蜜，還有風晶蝶一樣的味道…對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800266
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800266,
					"content": "哇，果然瞞不過雷澤的嗅覺呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800267,
					"content": "日落果，比之前聞到過的，都甜。可莉說過，煉金術，超級厲害，能讓東西變好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800268
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800268,
					"content": "嗯！希望這種甜蜜的果子，能為你們釀出最甜最好的酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800269,
						400800270
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800269,
					"content": "那位女孩子還想說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800271,
					"content": "…謝謝妳們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800272
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800272,
					"content": "下次，等她，有空，想當面說謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800273
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800273,
					"content": "交給我吧！我來想辦法說服她…說服她不要每天都這麼忙，然後就把她介紹給你認識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800274
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800274,
					"content": "好，我會等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800275
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800275,
					"content": "嗯，這下材料也收齊了，終於可以釀酒啦。酒桶的話，我記得放在「天使的饋贈」攤位那邊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800276
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800276,
					"content": "諾艾爾，那我們就先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800277,
					"content": "再見，祝你們一切順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 400800270,
					"content": "「做自己喜歡的事就好。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800246,
					"content": "我能先嚐一口嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800247
					]
				},
				{
					"id": 400800247,
					"content": "#喂！{F#妳}{M#你}怎麼回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800248
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008003,
			"completionStepIds": [
				4008003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008003",
							"2"
						],
						"stepId": 4008003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉",
					"迪奧娜",
					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800301,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}、雷澤，這裡這裡！你們看看誰來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800302,
					"content": "哇，這不是迪奧娜嗎？我還以為妳會來貓尾酒館的攤位，結果好幾天都沒看見妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800303,
					"content": "嗚…不可原諒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800304
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800304,
					"content": "欸？欸——妳怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800305,
					"content": "唔呃呃呃呃呃——氣死我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800306
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800306,
					"content": "#可莉都告訴我了，都是{F#妳}{M#你}們兩個幹的好事，竟然讓雷澤…讓爸爸的朋友，可靠的好人！也對酒產生了興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800307
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800307,
					"content": "雷澤，你絕對不可以變成趴在酒桌上哇哇大哭的臭大叔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800308
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800308,
					"content": "我，呃…不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800309
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800309,
					"content": "聽起來像是有什麼誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800310,
					"content": "小可莉，妳到底是怎麼說的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800311,
					"content": "#唔…我和迪奧娜姐姐說，雷澤要找媽媽，榮譽騎士{M#哥哥}{F#姐姐}在幫他，他們很難過，他們需要酒，所以想要妳幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800312
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800312,
					"content": "還沒說完，迪奧娜姐姐就回答：「可莉，妳不用再說了，這件事我一定要管。」然後，我們就一起過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800313
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800313,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800314
					]
				},
				{
					"id": 400800314,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800315
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800315,
					"content": "好…好吧，我都不知道該怎麼接話了。迪奧娜，關於這件事，傳達上出現了一點問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800316,
					"content": "向迪奧娜講述了來龍去脈…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800317
					]
				},
				{
					"id": 400800317,
					"content": "#{F#妳}{M#你}們的意思是說，雷澤是想藉由製作父母從前釀造的酒，來瞭解他們的過去…不是剛編了一個說辭在騙我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800318,
						400800319
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800318,
					"content": "沒有沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				},
				{
					"id": 400800320,
					"content": "迪奧娜姐姐對不起，是可莉不好，沒有說清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800321
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800321,
					"content": "妳可不可以不要生氣，幫幫雷澤做酒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800322
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800322,
					"content": "我抓好多魚跟妳一起吃，喏，嘟嘟可也給妳摸摸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800323
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800323,
					"content": "我…我才沒有多生氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800324
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800324,
					"content": "可莉是想幫忙做好事，我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800325
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800325,
					"content": "我剛才是因為不想雷澤被帶壞，才不小心把聲音抬高了一點點…既然不是要自己喝，那就勉為其難地幫你們一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800326
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800326,
					"content": "但有些事先說好，我平時調製的都是釀好的酒。現在突然要從混合原料開始製作，我也不知道會變成怎麼樣喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800327
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800327,
					"content": "太好啦！迪奧娜姐姐是大好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800328
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800328,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800329,
						400800330
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800329,
					"content": "有迪奧娜出手，事半功倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800331,
					"content": "#哼，{F#妳}{M#你}們就會說好聽的。看我的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800332
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800332,
					"content": "迪奧娜亮出她享譽蒙德的招牌調酒師手勢，往酒桶裡搗捶了幾下…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800333
					]
				},
				{
					"id": 400800333,
					"content": "完成，真不費力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800334,
					"content": "接下來，就得把它找個地方儲存起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800335,
					"content": "「等啊，等啊，等著風起湧。」…唔，是要放在有風的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800336,
					"content": "風起地，可以嗎？風很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800337
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800337,
					"content": "嗯！在蒙德只要說起風，第一時間想到的就是那裡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800338,
					"content": "好呀好呀，可莉也要一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800339
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800339,
					"content": "我還要監督我那個笨蛋老爹，就不跟過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800340
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800340,
					"content": "可莉，下次再一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800341
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 400800341,
					"content": "好喔，約好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800330,
					"content": "加油啊，迪奧娜！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800319,
					"content": "絕對沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				}
			]
		},
