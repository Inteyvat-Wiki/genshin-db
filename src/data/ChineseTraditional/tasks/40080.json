			"dialogs": [
				{
					"id": 400800401,
					"content": "好巧好巧，你們也來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800402,
					"content": "賣唱的，你怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800403,
					"content": "我一覺醒來，空中飄來一陣特別好聞的味道。順著果子的甜味一路走，就到這裡了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800404,
					"content": "對呀，果子好甜，可莉也聞得到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800405
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800405,
					"content": "還有別的原因吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800406
					]
				},
				{
					"id": 400800406,
					"content": "嗯，因為我想起了一件重要的事。在你們封上木桶、把酒埋進泥土之前，還需要再做一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800407,
					"content": "欸！還缺什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800408
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800408,
					"content": "雷澤，還記得那半瓶「千風佳釀」的味道吧？裡面是不是有一點苦味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800409
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800409,
					"content": "嗯，有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800410
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800410,
					"content": "啊哈哈，那種苦味大有來頭，就是…這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800411
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800411,
					"content": "蒲公英籽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800412,
					"content": "你們知道蒲公英酒吧。在蒙德人心中，風能夠帶回靈魂，也可以保存記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800413
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800413,
					"content": "蒲公英籽就像自然的寶石，匯聚著每年第一縷風。人們把它放進酒桶，就是把當下的風放了進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800414
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800414,
					"content": "美酒因而保留下此刻的記憶，直到永遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800415
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800415,
					"content": "所以，「千風佳釀」就是最初的「蒲公英酒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800416
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800416,
					"content": "喔——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800417,
					"content": "好厲害——我們的事情被酒記下來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800418
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800418,
					"content": "至於為什麼沒有固定的味道嘛，因為放進去的材料完全自由，欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800419
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800419,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800420
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800420,
					"content": "怎麼了，雷澤，你在想什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800421
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800421,
					"content": "爸爸媽媽的酒裡，蒲公英籽以外，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800422
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800422,
					"content": "我的酒裡，有很多，朋友的情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800423
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800423,
					"content": "爸爸媽媽，還是不明白。但…有大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800424
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800424,
					"content": "大家，很努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800425
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800425,
					"content": "法爾伽，師父，可莉，班尼特，棕色貓叔叔，冷冷的姐姐，裝笑的大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800426
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800426,
					"content": "灰灰硬硬的女孩子，風晶蝶味道的人，貓叔叔的女兒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800427
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800427,
					"content": "#綠詩人，派蒙，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800428
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800428,
					"content": "每個人，都記著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800429
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800429,
					"content": "酒，做起來，很難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800430
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800430,
					"content": "沒有大家…不會有，今天的酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800431
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800431,
					"content": "和朋友一起，困難，不是困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800432
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800432,
					"content": "我…很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800433,
						400800434
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800433,
					"content": "能夠幫上雷澤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				},
				{
					"id": 400800435,
					"content": "嗯，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800436
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800436,
					"content": "朋友…也是「盧皮卡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800437
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800437,
					"content": "未來，大家一起。我是人，我是狼…都沒有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800438
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800438,
					"content": "長大…再一起來開，這桶酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800439
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800439,
					"content": "精彩的發言。我這個吟遊詩人，已經沒有什麼想補充的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800440
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800440,
					"content": "接下來就把酒埋好，慢慢等待它變得甘醇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800441
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800441,
					"content": "大家一起把酒桶埋進了土裡…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800442
					]
				},
				{
					"id": 400800442,
					"content": "終於完工啦，我也想好好慶祝一下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800443,
					"content": "沒記錯的話，明天就是「歸風日」對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800444,
					"content": "哇！風神大人要回來啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800445
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800445,
					"content": "啊哈哈，提醒我了。歌謠還沒有背完，我得回去準備舉杯儀式。各位朋友，明天再見囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800446
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800446,
					"content": "今晚好好睡一覺，明天早晨記得迎著清風叫醒你們的耳朵，然後，來聽最好的吟遊詩人演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800434,
					"content": "所有人都很開心喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				}
			]
		},
		{
			"id": 4008006,
			"completionStepIds": [
				4008006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008006",
							"2"
						],
						"stepId": 4008006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎",
					"溫迪",
					"琴",
					"雷澤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800601,
					"content": "好多人啊，大家都來迎接風神了呢。咦，怎麼都圍在「天使的饋贈」攤位前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800602,
					"content": "按照慣例，佳釀節上品質最好的酒，要等到舉杯儀式獻給風神大人品嚐過之後才能開售，大家都在排隊等著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800603
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 400800603,
					"content": "哼，對這些傢伙來說，迎接風神只是個過場吧。麗莎小姐，妳是來看雷澤的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800604,
					"content": "嗯，之前還有些不放心，剛才和雷澤聊過幾句，聽說你們的釀酒之旅還算順利。今天我也能安心喝一杯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800605
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 400800605,
					"content": "哇…妳也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800606,
					"content": "呵呵，雷澤他們已經在那邊了，趕快過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800607
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 400800607,
					"content": "#呦，{F#妳}{M#你}們來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800608
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800608,
					"content": "哇，這麼多酒瓶是怎麼回事？如果不知道，還以為你們也擺了個賣酒的攤位呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800609,
					"content": "哈哈哈，這些都是我們幫雷澤準備的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800610
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800610,
					"content": "媽媽說過，今天大家要迎接風神大人，要請他喝酒。如果風神大人高興，就會變成風來祝福大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800611
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800611,
					"content": "#我們想讓風神大人高興，讓他幫幫雷澤。榮譽騎士{M#哥哥}{F#姐姐}{F#妳}{M#你}看，這是阿貝多哥哥借給我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800612
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800612,
					"content": "這瓶是我的老爹們給的，還好沒在路上摔了…也就裝裝樣子，用完得帶回去給他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800613
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800613,
					"content": "媽媽說，風神大人的酒量特別大，只要他想，一口氣能把果酒湖喝乾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800614
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800614,
					"content": "這些，再加上雷澤爸爸媽媽留下的酒…夠不夠呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800615
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800615,
					"content": "啊，綠詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800616
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800616,
					"content": "咳咳，各位，非常榮幸來到這裡。今天我受西風騎士團代理團長琴小姐邀請，為大家彈奏一曲——〈千風佳釀〉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800617
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800617,
					"content": "我會把最好的歌謠獻給風，也獻給在場的你們——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800618
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800618,
					"content": "「我們把這些東西封進桶，\\n等啊，等啊，等著風起湧。\\n把佳釀的瓶口先蠟上，\\n南風和煦，北風猛。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800619
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800619,
					"content": "「佳釀味道像什麼？\\n蒙德的名字，自由的夢。\\n究竟是什麼發酵成佳釀？\\n探索的勇氣、慈愛的溫柔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800620
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800620,
					"content": "「守護的執著一如初，\\n伴著千風起祝頌，\\n酸汁變甜、糙桶潤透，\\n等啊，等啊，等著風起湧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800621
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800621,
					"content": "「酒桶裡面放了什麼？\\n小麥的金黃，潛薈蔥蘢。\\n佳釀出桶，飄來了什麼？\\n風鈴的聲音，萬古的長空。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800622
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800622,
					"content": "「我們伴著這些美酒唱起歌，\\n等啊，等啊，等著風起詠。\\n千風帶走了什麼下酒？\\n琴弦上的故事，今夜的美夢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800623
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400800623,
					"content": "朋友們，讓我們共同開啟美酒——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800624
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400800624,
					"content": "敬獻風神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800628
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800628,
					"content": "敬獻風神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800629
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800629,
					"content": "敬獻風神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800630
					]
				},
				{
					"id": 400800630,
					"content": "欸…沒有風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800631
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800631,
					"content": "可莉，別難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800632
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800632,
					"content": "怎麼會這樣，雷澤，風神大人沒有回來，是不是他不喜歡我們準備的酒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800633
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800633,
					"content": "應該不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800634
					]
				},
				{
					"id": 400800634,
					"content": "才不會呢！小可莉知道嗎？風神大人不僅會變成風，也會變成其他樣子，所以今年他一定是變成其他樣子回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800635,
					"content": "唔？是嗎？變成…變成蹦蹦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800636
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800636,
					"content": "好，就變成蹦蹦！聽見了嗎風神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800637,
					"content": "嘿嘿…雷澤，風神大人帶來祝福給你了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800638
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800638,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800639
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800639,
					"content": "跟你們一起，說很多，學會了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800640
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800640,
					"content": "現在，不會害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800641
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800641,
					"content": "這個…就是祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800642
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800642,
					"content": "別忘了，將來等你的酒釀成之後，我也要來喝一口喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800643,
						400800644
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800643,
					"content": "也有我的份吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				},
				{
					"id": 400800645,
					"content": "嗯，一起分享，一起，回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800646
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800646,
					"content": "嗯嗯！不過…可莉口渴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800647
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800647,
					"content": "光顧著說話了，我們去喝飲料吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800648,
					"content": "我聽說「天使的饋贈」攤位上新開賣的「假日果釀」，超好喝的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800649
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800649,
					"content": "我要喝我要喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800650
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800650,
					"content": "嗯，大家，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷澤"
				},
				{
					"id": 400800644,
					"content": "會回憶起現在吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				}
			]
		},
