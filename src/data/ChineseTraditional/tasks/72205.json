					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木戶",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "唔，奇怪呀…明明就在口袋裡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "沒有的話可不行呀…是要帶給宇奈婆婆的喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050105,
					"content": "宇奈婆婆歲數大了，好多事情都記不清了…最近又開始唸起了年輕時的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050106,
					"content": "她呀，總是在說著「花」呀「花」的…還說，那是霧海外的花，顏色不同的好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050107,
					"content": "然後有一天，我做了一個夢…我夢見島上的霧「哇」地一下全都消散了，海的另一邊立起了高高大大好漂亮的屋子…不是木頭的，也不是金子的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050108,
					"content": "我也是呢，我也是呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050109,
					"content": "在那個夢裡面呀，我登上高高的山，爬上大大的樹，摘了好多好多好看的花…雖然沒有見過，但我知道那就是宇奈婆婆想要的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050110,
					"content": "可是花太多太重，我就從樹上掉了下來，一直掉呀，一直掉呀…然後，夢就醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050111,
					"content": "哼，還不是因為你太貪心！我都說了好多遍足夠啦、足夠啦！結果連累我也一同掉了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050112,
					"content": "口袋裡空空的…什麼都沒有了…就這樣怎麼回去見宇奈婆婆呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050103,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
