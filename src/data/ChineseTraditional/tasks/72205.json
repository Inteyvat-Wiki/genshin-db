					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050702,
					"content": "木戶哥哥今天不想說話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
