			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木戶",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#{F#妳}{M#你}好，大{F#姐姐}{M#哥哥}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050302,
					"content": "你好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "#謝謝{F#妳}{M#你}上次幫我採來那些花朵！只不過呀…我感覺身邊一直怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050305,
					"content": "我也是呢，一直都怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050306,
					"content": "每次去到不同的地方，都只會遇到不開心的人…大家都聽不到別人說話的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050307,
					"content": "而且呀，每次看到漂亮的花朵，摘下放進口袋裡之後，就很快不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050308,
					"content": "那是因為…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "這樣嗎…我不太明白呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050311,
					"content": "要離開了嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050312,
					"content": "那個金色的叔叔也說了類似的話…但是我們還不能跟他走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050313,
					"content": "我們還要帶好看的花去給宇奈婆婆呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050309,
					"content": "是時候離開了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "精神不錯嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
