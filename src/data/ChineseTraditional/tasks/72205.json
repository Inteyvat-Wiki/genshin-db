	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
