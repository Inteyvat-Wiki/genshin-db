					"木戶",
					"木奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "在這裡又見面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050502,
					"content": "又見面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050503,
					"content": "你好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#嘿嘿，我還在這裡呢！說起來，大{F#姐姐}{M#哥哥}知道這些大石頭是做什麼的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050506,
					"content": "哼哼，木戶哥哥什麼都知道哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050507,
					"content": "不知道呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "聽又爺爺講，這是用來招引亡靈的墓碑呢…那些死後迷失的、佇留的靈總會被這些大石頭吸引，在這裡從夢中醒來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050510,
					"content": "然後在島上各處徘徊…尋找能夠滿足他們心願的人。一旦找到，他就會纏上那人…直到自己的願望被滿足，被那撐船的人接走為止…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050511,
					"content": "他們有的是好的靈，有的是壞的…所以呀，在霧中走夜路的人，一定要在這種大石頭前，大聲報出自己的氏名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050512,
					"content": "牢記祖先的人，總是比孤魂野鬼更有底氣。而那些死去的靈得知了生人的血脈，便會自慚形穢地離去，不再要求什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050513,
					"content": "#只可惜大{F#姐姐}{M#哥哥}是外人呢…沒有響噹噹的氏名可報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050514,
					"content": "#唔…要是壞的靈來了，大{F#姐姐}{M#哥哥}要怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050515,
					"content": "#嘿嘿，沒關係的。不用怕啦，我可以保護{F#妳}{M#你}呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "木戶"
				},
				{
					"id": 722050516,
					"content": "木奈也要一起，嚇走壞蛋靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木奈"
				},
				{
					"id": 722050508,
					"content": "是做什麼的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "你還在島上呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
