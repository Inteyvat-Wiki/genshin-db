			"trigger": {
				"objectNames": [
					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "還是沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "又是你們，看來協會的任務確實越來越輕鬆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090104,
					"content": "有興趣的話，願不願意再接受一個我個人的委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090105,
					"content": "有很多拿著弓箭的丘丘人聚集在「歸離原」中的一處地方，正威脅著過路的行人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090106,
					"content": "雖然只是丘丘人，但它們數量眾多，又佔據著制高點，一般的冒險家也拿它們沒什麼好辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090107,
					"content": "#{F#妳}{M#你}要做的，就是把它們俐落地消滅掉。消滅之後，我會給{F#妳}{M#你}足夠的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090108,
					"content": "還有，如果發現了什麼與「劍」有關的東西，記得拿回來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090109,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "#該說{F#妳}{M#你}年輕，還是該說{F#妳}{M#你}勇敢呢，這麼果斷就接下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090112,
					"content": "不過，別的不說，倒是很像一個冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090115,
					"content": "好了，閒話就不說了。好好準備之後，就去消滅那些魔物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090110,
					"content": "丘丘人和劍有關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "#沒有關係。{F#妳}{M#你}只需要稍微留意一下。如果有，就帶回來，如果沒有，也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090114,
					"content": "#這個委託的目標是消滅丘丘人，消滅它們，我就會正常付給{F#妳}{M#你}報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
