			},
			"dialogs": [
				{
					"id": 221090301,
					"content": "怎麼樣，消滅它們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090302,
					"content": "已經全部消滅了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "#幹得不錯，那群丘丘人沒給{F#妳}{M#你}造成多大麻煩吧？沒關係，我只是隨口問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090304,
					"content": "依然沒有發現和「劍」有關的東西？哼，又是意料之中的一無所獲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090305,
					"content": "#好了，這是{F#妳}{M#你}的報酬，拿好，辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090306,
					"content": "為什麼這麼在意「劍」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "#…告訴{F#妳}{M#你}也沒關係。那把叫做「藏鋒」的劍，是我大哥的佩劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090308,
					"content": "但是我大哥去世時，這把劍卻沒有被他帶在身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090309,
					"content": "到底發生了什麼，會讓他連隨身的武器都丟掉了呢，我一直想不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090310,
					"content": "但是，到現在我也沒有頭緒，既沒有找到劍，也不知道大哥到底遭遇了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090311,
					"content": "#好了，就說到這裡，拿好{F#妳}{M#你}的報酬，去忙{F#妳}{M#你}自己的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		}
	]
