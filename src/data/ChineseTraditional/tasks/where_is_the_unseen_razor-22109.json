				"points": []
			},
			"dialogs": [
				{
					"id": 221090201,
					"content": "怎麼樣，消滅它們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "#{F#妳}{M#你}到底是在謹慎地準備，還是在磨磨蹭蹭地偷懶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 221090204,
					"content": "或者…兩者皆有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
