			"dialogs": [
				{
					"id": 700920101,
					"content": "給布倫妮的…與其說是課題，不如說是一封戰書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920102,
					"content": "「哼哼，小小魔女獵人，想好打敗我的方法了嗎？大聲喊出妳酷酷的挑戰宣言，準備好敗給大魔王吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920103,
					"content": "這個口吻…是艾莉絲吧…要不是寫了「魔女獵人」，我還以為這是給可莉的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920104,
					"content": "布倫妮一直對艾莉絲敵意很大，收到這種挑釁會不會被激怒啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920105,
					"content": "很明顯，艾莉絲是故意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920106
					]
				},
				{
					"id": 700920106,
					"content": "我們要不要換個委婉一點的方式告訴布倫妮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920107,
					"content": "要告訴我什麼？我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920108
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920108,
					"content": "嚇我一跳！妳先不要激動，聽我說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920109,
					"content": "…無聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920110
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920110,
					"content": "欸？意外地淡定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920111,
					"content": "哈。她這種幼稚的把戲我見多了，故作神秘，本質上就是場耍小孩的惡作劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920112
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920112,
					"content": "誰會在路上「大聲喊宣言」啊？不明真相的路人只會覺得莫名其妙吧，我才不上當。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920113
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920113,
					"content": "簡直等於在街上喊：我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920114
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920114,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920115
					],
					"speakerTitle": "留聲機"
				},
				{
					"id": 700920115,
					"content": "什、什麼啊？！為什麼我的聲音會從那裡冒出來啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920116
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920116,
					"content": "誰？誰在說話？哈哈，誰是大笨蛋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920117
					],
					"speakerTitle": "不明真相的路人"
				},
				{
					"id": 700920117,
					"content": "竟然會有人說自己是大笨蛋，哈哈哈，是不是玩遊戲輸了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920118
					],
					"speakerTitle": "愛湊熱鬧的路人"
				},
				{
					"id": 700920118,
					"content": "絕對是小孩的惡作劇，看來有個笨小孩上當受騙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920119
					],
					"speakerTitle": "理智的路人"
				},
				{
					"id": 700920119,
					"content": "可惡…快停下，不准叫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920120
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920120,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920121
					],
					"speakerTitle": "留聲機"
				},
				{
					"id": 700920121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920122
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920122,
					"content": "冷靜一下布倫妮！先不要砸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920123,
						700920124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920123,
					"content": "收手吧，布倫妮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				},
				{
					"id": 700920125,
					"content": "啊…艾——莉——絲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920126
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920126,
					"content": "嗨嗨各位。哎呀~沒想到是這樣的宣言呢，非常有趣。恭喜妳成功開啟魔女的課題挑戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920127
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920127,
					"content": "我為這次的挑戰準備了一個很有儀式感的魔法空間，但魔法載入需要一點時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920128
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920128,
					"content": "所以我早早就想好了，把挑戰宣言做成載入音效，循環播放給妳鼓舞士氣！怎麼樣，喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920129
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920129,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920130
					],
					"speakerTitle": "留聲機"
				},
				{
					"id": 700920130,
					"content": "不，這不是什麼宣言，快撤回這個破音效啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920131
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920131,
					"content": "看來鬧烏龍了。可是音效跟挑戰魔法是一個整體，撤回就等於放棄挑戰哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920132
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920132,
					"content": "真的嗎？確定嗎？那只好有緣再見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920133
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920133,
					"content": "不…不准走！好不容易才逮住妳。啊啊啊…妳那破魔法到底還要載多久啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920134
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920134,
					"content": "早就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920124,
					"content": "周圍全是留聲機！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				}
			]
		},
