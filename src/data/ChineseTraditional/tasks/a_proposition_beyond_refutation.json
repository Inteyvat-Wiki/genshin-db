				]
			},
			"dialogs": [
				{
					"id": 700920201,
					"content": "歡迎來到提瓦特最具戲劇張力的地方——歐庇克萊歌劇院…的魔法擬造空間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920202
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920202,
					"content": "這次的課題是「辯論」，為此我專門打造了這樣的魔法空間。還不錯吧？誠意多多儀式感滿滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920203
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920203,
					"content": "辯論？上次妳已經徹底輸給我了吧？還想來自取其辱嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920204
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920204,
					"content": "呵呵…妳在12歲的辯題裡展現了高達16歲的智慧，不可思議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920205
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920205,
					"content": "考慮到妳是反駁型人格…所以這次我準備了一個妳無法反駁的絕妙論題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920206,
						700920207
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920206,
					"content": "不好意思打擾一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				},
				{
					"id": 700920208,
					"content": "#一場精彩絕倫的辯論少不了一位公平公正的評審，我們幾個中{F#妳}{M#你}是最佳的人選，我想沒有人會反對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920209
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920209,
					"content": "那…派蒙適合在那個位置嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920210
					]
				},
				{
					"id": 700920210,
					"content": "其實我早就想說了，派蒙那傢伙已經在高處的貴賓席位上擺了很久的姿勢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920211,
						700920212
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920211,
					"content": "這句話似曾相識…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920213,
					"content": "嘻嘻…居然被傳送到這個位置上，我就突發奇想模仿一下我們的朋友，她可是楓丹的大明星哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920214,
					"content": "我記得派蒙喜歡看熱鬧，這個觀看席位視野最好，還滿意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920215
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920215,
					"content": "原來這裡看出去的視角是這樣的啊…呃，可是我真的可以坐在這裡看嗎？會不會太僭越了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920216,
					"content": "#放心，這裡是用魔法擬造的空間，魔女說了算。不會有警衛闖進來把{F#妳}{M#你}們抓走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920217
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920217,
					"content": "還有坐在山頂的朋友派蒙，對這個貴賓觀看席還滿意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920218
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920218,
					"content": "非、非常震撼！好氣派哦…第一次坐在這種地方，我都有點說不出話來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920219,
					"content": "那請妳快快適應哦，接下來的精彩瞬間很需要妳的歡呼喝彩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920220
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920220,
					"content": "好了別鬧了，速戰速決吧——說出妳的題目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920221
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920221,
					"content": "可莉是個壞孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920222
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920222,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920224,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920225
					]
				},
				{
					"id": 700920225,
					"content": "這就是妳要反駁的辯題。如果妳能證明「可莉不是壞孩子」，我就送妳一份小禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920226
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920226,
					"content": "誰稀罕妳的小禮物啊！可莉是妳的親生女兒，妳怎麼能出這樣的題目？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920227
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920227,
					"content": "妳…壞到極致的壞女人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920228
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920228,
					"content": "哼哼，正所謂「有其母必有其女」，既然妳咬定我是壞人，那壞人的孩子就是壞孩子，沒有錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920229
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920229,
					"content": "反對！簡直愚昧，妳壞的是人品和作風，沒有科學依據證明這種東西會遺傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920230
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920230,
					"content": "再說了，比起遺傳，成長環境更重要。蒙德那群人比妳可靠多了，可莉有他們陪著根本壞不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920231
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920231,
					"content": "但事實是，可莉很喜歡炸魚，這就是壞孩子的有力證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920232
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920232,
					"content": "這…這只是兒童善惡不明的天性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920233
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920233,
					"content": "港口的船也經常會捕魚回來，對可莉來說她哪裡分得清為什麼捕魚可以但炸魚就不行嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920234
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920234,
					"content": "那我就要說了，可莉每次關完禁閉還是屢教不改哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920235
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920235,
					"content": "就憑可莉每次都能乖乖配合關禁閉，證明她從來都是認罰的，沒有逃避過責任哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920236
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920236,
					"content": "不應該在可莉承擔完後果後，再給她扣上壞孩子的帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920237
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920237,
					"content": "而且，上一次關完禁閉後，可莉雖然嘴上說著想要炸魚，卻沒有「擅自」去做這件事，一次都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920238
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920238,
					"content": "最近的一次行動，全因受了信任之人的「唆使」和「縱容」。而這個人，是一位「混沌」的母親！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920239
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920239,
					"content": "嗯哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920240
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920240,
					"content": "歸根究底，妳才是那個最該被扣上壞孩子帽子的人！不對，壞大人！也不對，哪有這麼幼稚的大人——壞大孩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920241
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920241,
					"content": "形勢反轉了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920242
					]
				},
				{
					"id": 700920242,
					"content": "聽起來好有氣勢…是很漂亮的一擊！對方辯手又該如何應對呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920243,
					"content": "就算如此，也只能證明可莉主觀上沒有壞心思。恐怕這不能成為大家眼裡可莉不是壞孩子的理由哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920244
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920244,
					"content": "還想硬撐嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920245
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920245,
					"content": "那妳聽好了，這點妳永遠無法反駁——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920246
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920246,
					"content": "因為可莉很可愛，所以大家都會原諒她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920247
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920247,
					"content": "對！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920248
					]
				},
				{
					"id": 700920248,
					"content": "沒錯！可莉這麼可愛，犯點小錯怎麼了？反正她在我眼裡不是壞孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920249,
					"content": "比起妳說的那些，明明她身上的優點更多：會把玩具分享給別人、想去玩的時候發現大家在忙就在一邊乖乖等待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920250
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920250,
					"content": "最重要的是對每個人都充滿善意，所有人在她眼裡都是好人，包括將她媽媽視為敵人的我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920251
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920251,
					"content": "總之，這麼可愛的孩子，我不許妳說她是壞孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920252
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920253
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920253,
					"content": "我投降啦！身為媽媽不可能不認同這句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920254
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920254,
					"content": "而且終於從妳嘴裡聽到這句話了，看來妳是真心把可莉當成好朋友的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920255
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920255,
					"content": "我的女兒非常可愛對不對？我早就說過了，去找到她，妳也會變得快樂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920256
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920256,
					"content": "妳還得意？我之所以千里迢迢跑到蒙德來不就是因為妳的惡作劇嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920257
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920257,
					"content": "嘻嘻，可莉有妳這位好朋友的陪伴，我就更加放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920258
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920258,
					"content": "真期待妳們的成長啊，妳也想像不到可莉到我這個年紀還炸魚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920259
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920259,
					"content": "等等，妳該不會要說「這個課題真正要考驗的是妳對可莉的真心」這種超土的話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920260
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920260,
					"content": "真聰明，那就快進到宣布挑戰結果的環節吧。有請評審老師——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920261
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920261,
					"content": "咳咳，「布倫妮小朋友的魔女挑戰課題，合格！現送出魔女的祝福」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920262
					]
				},
				{
					"id": 700920262,
					"content": "「祝妳和可莉一樣，身體好好吃飯飽飽煩惱少少，當個快樂的小孩」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920263
					]
				},
				{
					"id": 700920263,
					"content": "妳和可莉都是好孩子，即便偶爾犯錯或鬧脾氣，也是可以被允許的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920264
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920264,
					"content": "謝…謝謝？但一碼歸一碼，說了多少次別把我當小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920265
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920265,
					"content": "別忘了我是魔女獵人，不會跟妳和解的，想都不要想！妳輸了，老實出來，別用這個大玩偶糊弄我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920266
					],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920266,
					"content": "今天玩得很開心，下次有空再來逗妳玩。拜拜~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920267
					],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700920267,
					"content": "跟妳說話沒聽見嗎？別跑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布倫妮"
				},
				{
					"id": 700920212,
					"content": "這個場面也是！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920207,
					"content": "我適合在這個位置嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				}
			]
		},
