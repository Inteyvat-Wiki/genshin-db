				{
					"id": 200230302,
					"content": "關於寧錄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "#他今天已經喝了快半天了，{F#妳}{M#你}看，這是他喝的帳單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 200230304,
					"content": "再這麼下去，只能把優律小姐叫來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 200230305,
					"content": "借用一下？也不是不行，可是你們要這個做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查爾斯"
				}
			]
		},
