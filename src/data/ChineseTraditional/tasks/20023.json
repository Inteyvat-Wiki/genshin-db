					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "哼，果然是這樣…不出所料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230404,
					"content": "無論過去經歷了什麼，只要沒有真正吃到苦頭，人們最終什麼都不會記得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230405,
					"content": "好了，這是給你們的答謝，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230406,
					"content": "寧錄的那一份「答謝」，我也會好好思考的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維多利亞"
				}
