			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維多利亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "他到底有沒有悔改呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230102,
					"content": "悔改什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "每天都會有很多人到我這裡，傾訴他們所犯下的罪孽，祈求神的原諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230104,
					"content": "但如果只是口頭說說，不付諸行動，那不就只是在浪費時間嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230105,
					"content": "比如寧錄先生，他為自己酗酒的習慣懺悔了好多次，但一點改變都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230106,
					"content": "#如果{F#妳}{M#你}有空的話，去幫我去看看他現在的情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "對了，如果他又在喝酒，請帶一些證據回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230109,
					"content": "屢教不改的人…還是需要一點能深刻銘記的「教誨」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230110,
					"content": "喝酒也算「罪孽」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "喝酒不算「罪孽」，但是因為喝酒，而讓其他人陷入苦惱算是「罪孽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230112,
					"content": "如果每個人都恣意妄為，那麼這座蒙德城，總有一天也會陷入巨大的苦惱中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200230113,
					"content": "#所以，要將每一份剛萌芽的「罪孽」掐斷，好了，{F#妳}{M#你}快點去看看寧錄的情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維多利亞"
				}
			]
		},
		{
			"id": 2002302,
