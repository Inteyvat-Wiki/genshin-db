					"寧錄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "哈哈哈，我每天都指著這一杯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200230202,
					"content": "你不是說要戒酒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "啊？！嚇死我了…我還以為是我老婆呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200230204,
					"content": "偶爾喝一點也無所謂吧，我可是辛苦工作了一天啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200230205,
					"content": "好了好了，我再喝一點就回去了…優律也差不多該買完東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寧錄"
				}
			]
		},
		{
