			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "您回來了，都通知到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200702,
					"content": "都通知到了，但他們都暫時不肯回來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "不肯回來？到底是有什麼重要的事，讓他們這個時候還要待在野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200704,
					"content": "不愧是自由的蒙德人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "哈哈…哈…是啊，他們確實是自由的蒙德人，再自由不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200706,
					"content": "但是在這個時候，我更希望他們能把這份自由給收斂起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200707,
					"content": "唉…西風騎士團想必也沒空處理這件事吧。算了，我再想想其他辦法，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200708,
					"content": "希望所有人都能平安無事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				}
			]
