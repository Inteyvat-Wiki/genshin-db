			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "呼…謝謝您，剛才真是太危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200602,
					"content": "所以，請您進蒙德城去避難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "抱歉，我暫時還不能回去。現在天降隕石，已經可以說是十分奇怪的天象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200604,
					"content": "在這種天象裡，海上再產生風暴的話也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200605,
					"content": "我必須要在這裡守著，如果真有風暴出現，我必須第一時間通知城裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200606,
					"content": "謝謝您來通知我，辛苦您了，我會多加小心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
