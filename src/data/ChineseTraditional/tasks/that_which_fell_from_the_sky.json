			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞絲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "希望所有人都平安無事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200102,
					"content": "您在擔心什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "是旅行者啊。那些從天而降的隕石，您應該注意到了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200104,
					"content": "雖然很幸運沒有隕石砸到蒙德城裡面來，但是野外已經亂成了一片。我很擔心那些還逗留在野外的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200105,
					"content": "#旅行者，能請{F#妳}{M#你}幫忙去警告一下那些還逗留在野外的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200106,
					"content": "如果他們願意的話，就請他們到蒙德城裡來避難吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200112,
					"content": "您可以先去找琳小姐，問問她知不知道還有哪些人逗留在野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200113,
					"content": "然後，也請試著說服她進蒙德城避難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200114,
					"content": "現在可不是她接著挑戰「野外生存」的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200109,
					"content": "為什麼隕石沒砸進蒙德城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "也許只是運氣好吧。但不管怎麼說，蒙德城是目前來看比較安全的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 411200111,
					"content": "至少…比待在野外安全多了，您說對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "葛瑞絲"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
							"2"
						],
						"stepId": 4112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "在這種情況下進行「野外生存」…好像還挺有挑戰性的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200202,
					"content": "請進蒙德城避難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "避難？哎呀，不用擔心我，我一直在留意著周圍呢，不會有危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200204,
					"content": "#不過，{F#妳}{M#你}怎麼還在外面逛來逛去，還是快回蒙德城吧，要是被隕石砸到可就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200205,
					"content": "關於在野外逗留的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "#在野外逗留的人？那可有很多啊，{F#妳}{M#你}問這個做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200207,
					"content": "去讓他們避難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "是這樣啊…這麼一說，協會裡好像也發佈過相關的委託，我也去周圍通知了不少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200209,
					"content": "離蒙德城比較近的人，應該都已經進城裡避難了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200210,
					"content": "#但因為人手不足，臨時也召集不到多少冒險家，野外應該還有很多人沒被通知到吧，{F#妳}{M#你}肯幫忙再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200215,
					"content": "我想想啊，還逗留在野外的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200216,
					"content": "啊！對了，帕琪小姐和杜蘭先生一直待在千風神殿那邊，我和他們說過了，但他們還是堅持在那裡研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200217,
					"content": "還有芬德修女，之前她一直待在望風角附近，協會裡也讓我去找過她幾次，但我去了好幾次都沒找到她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200218,
					"content": "#我只記得這些了，{F#妳}{M#你}就先去告訴他們進蒙德城避難的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200219,
					"content": "至於我嘛，再準備一點食物和必需品之後，我也會去周圍轉一圈，盡量通知更多人進城避難的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200220,
					"content": "希望他們別跑到太偏遠的地方去，不然就算找到了，回來也得大費一番周折吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳"
				},
				{
					"id": 411200211,
					"content": "葛瑞絲修女很擔心他們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "葛瑞絲修女？是她啊…其實協會裡也發佈過相關的委託，我也去周圍通知了不少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200213,
					"content": "離蒙德城比較近的人，應該都已經進城裡避難了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200214,
					"content": "#但因為人手不足，臨時也召集不到多少冒險家，野外應該還有很多人沒被通知到吧，{F#妳}{M#你}肯幫忙再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "琳"
				}
			]
		},
		{
			"id": 4112003,
			"completionStepIds": [
				4112003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112003",
							"2"
						],
						"stepId": 4112003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "現在可不是研究的時候，我們得快點去避難才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200302,
					"content": "我說過好幾次了，我絕不會放過這次機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200303,
					"content": "請進蒙德城去避難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "怎麼又來了？現在可不是避難的時候，這些天降的隕石，說不定正是我們深入千風神殿的好機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200305,
					"content": "深入千風神殿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "帕琪說，也許隕石會砸到千風神殿，如果底下有內殿…或者其他什麼的話，我們就可以順著隕石砸開的路深入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200307,
					"content": "但是這也太異想天開了，如果隕石砸過來的話，我們倆逃都逃不開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200308,
					"content": "我們還是去避難吧，如果隕石真的砸進了千風神殿，還砸出了條路，那我們之後再來探索不也一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200309,
					"content": "要是被人捷足先登了怎麼辦？要回去你自己回去，我要在這裡等著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200310,
					"content": "這…好吧，旅行者，不好意思，我們倆還得在這待一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200311,
					"content": "別擔心，如果真的有危險…我，我會處理好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200312,
					"content": "對了，之前有個叫舒特的人路過了這裡，一副很害怕的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200313,
					"content": "他找我要了點水喝之後，就說自己要回蒙德城，飛快地跑掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200314,
					"content": "但他跑的路卻又不是往蒙德城，而是往望風角的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200315,
					"content": "我想…那傢伙不會是因為太害怕，連路都記錯了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200316,
					"content": "#旅行者，{F#妳}{M#你}先去望風角附近找找他吧，如果他遇到魔物就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 411200317,
					"content": "我會在這裡陪著帕琪，如果真有什麼事發生…呃，我會處理好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜蘭"
				}
			]
		},
