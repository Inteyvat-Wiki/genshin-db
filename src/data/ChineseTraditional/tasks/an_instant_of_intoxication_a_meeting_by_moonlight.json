							4478.179
						],
						"pointId": 340100819
					}
				]
			},
			"dialogs": [
				{
					"id": 402000101,
					"content": "夜景不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000102
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000102,
					"content": "清新的海露花香、街角香水店的芬芳、還有醇厚的咖啡豆味，在夜風中相融，氛圍相當閒適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000103
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000103,
					"content": "如果能找到一間樓頂露臺的小酒館，小酌兩杯起泡葡萄酒，就能獲得一場絕妙的微醺體驗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000104,
						402000105
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000104,
					"content": "現在是清淨的假期，那就喝吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				},
				{
					"id": 402000106,
					"content": "好呀…那就陪我找找看吧，隱伏在城中的寶藏酒館，會不會藏著驚喜的酒單？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000107
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000107,
					"content": "不過，在那之前，趁著卡布里埃商會還沒打烊，和我一起去挑選幾種香水，搭配這身裝束？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000108,
					"content": "還有精密的鐘錶，暗藏趣意的發條擺設，和工藝獨特的首飾，值得一看的紀念品還不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000109,
						402000110
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000109,
					"content": "工作越久越想消費嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000111,
					"content": "有提瓦特見識最廣博，審美最獨到的旅者陪著我，我當然要抓住這個機會，請你好好當一回參謀啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000112,
					"content": "嗯…心滿意足了，的確是一次不錯的異國旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000113,
					"content": "如果能將時長放寬，慢慢遊玩個三五天，還能消除倉促帶來的遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000114,
						402000115
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000114,
					"content": "不是說要好好享受假期嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000116,
					"content": "沒辦法，下一樁差事已經來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000117
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000117,
					"content": "除了為這次的案件寫一份正式報告，協助建設更完善的貨物通關體系，我還要準備動身，前往下一個任務地點——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000118
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000118,
					"content": "挪德卡萊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000119,
						402000120
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000119,
					"content": "我和派蒙的下一站也是那裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000121,
					"content": "別緊張，只是和一位情報夥伴見個面，確定以後互利共贏的方案，還有互不干擾的邊界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000122
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000122,
					"content": "詳情以後再談吧。為了紀念這次盡興的楓丹之旅，一起合張影，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000123,
						402000124
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000123,
					"content": "也是為了紀念你領我上道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000125,
					"content": "#沒錯，我可以將我的後背毫無保留地交給{F#妳}{M#你}了，新晉王牌探員{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000126
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000126,
					"content": "就用最關鍵的「綜像勘錄儀」，來完成這張意義重大的留影吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000127
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000127,
					"content": "希望在挪德卡萊再見時，我們還能像這次一樣，完美合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402000124,
					"content": "也是為了紀念我們成功合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000120,
					"content": "有什麼緊急情況驚動了妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000115,
					"content": "怎麼好像又要回去工作一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000110,
					"content": "購物意願爆發的時機正好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000105,
					"content": "剛剛完成一樁大案，盡情喝吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				}
			]
		},
		{
