				"points": []
			},
			"dialogs": [
				{
					"id": 402000201,
					"content": "也就是說，再等一會，豐克警官就會帶我們去審訊壞傢伙的地方，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000202,
					"content": "沒錯，妳有機會看到我們的秘密基地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000203
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 402000203,
					"content": "哈哈，開玩笑的。為了避免鬧出的動靜干擾正常的工作，我們特意選了一座偏僻的民房。出發後，要跟緊我喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000204
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 402000204,
					"content": "#沒關係！我可是最最稱職的嚮導，以前和{NICKNAME}去過好多好多頭都會繞暈的地方，不會在楓丹廷裡迷路的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000205,
					"content": "#啊，{NICKNAME}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000206,
					"content": "動作這麼快？難道夜蘭是那種…閉眼一下就休息好了的超級工作達人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000207,
						402000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000207,
					"content": "還沒去休假。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				},
				{
					"id": 402000209,
					"content": "嘿嘿，沒事沒事，別擔心我。派蒙也是會成長的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000210,
					"content": "#這次，所有的麻煩事都搞定了，{F#妳}{M#你}就放心和夜蘭去玩一陣子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000211,
					"content": "要拋掉一切煩惱，好好享受放鬆時光哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000212,
					"content": "我也一定保證，把派蒙小偵探照顧得好好的，派蒙小偵探想學什麼本領，想吃什麼零食，我們都全力滿足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000213,
						402000214
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「執律庭」探員"
				},
				{
					"id": 402000213,
					"content": "那我去玩囉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000215,
					"content": "嗯！我一定好好學習！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000214,
					"content": "派蒙加油哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000208,
					"content": "不放心妳，過來看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				}
			]
		}
	]
}