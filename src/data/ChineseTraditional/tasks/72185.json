			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#旅行者，{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850302,
					"content": "#怎麼樣，{F#妳}{M#你}有問到什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850303,
					"content": "關於客人們的反饋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "原汁原味的「烤蘑菇披薩」啊…嗯，倒是可以試試看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850305,
					"content": "要準備的材料是乳酪，高麗菜和蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850306,
					"content": "其餘的材料店裡倒是有，可是這個乳酪，店裡平時也沒準備多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850307,
					"content": "#旅行者，能請{F#妳}{M#你}幫我去拿一份乳酪來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850308,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "#那就拜託{F#妳}{M#你}了，只要一份乳酪就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850310,
					"content": "店裡平時都不用乳酪的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "也不能說完全不用，只能說用得很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850312,
					"content": "畢竟，店裡的這些菜，也沒幾道要用到乳酪的，所以準備得很少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850313,
					"content": "#總之，就拜託{F#妳}{M#你}了旅行者，請幫我帶一份乳酪回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
