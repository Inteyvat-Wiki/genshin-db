			},
			"dialogs": [
				{
					"id": 721850501,
					"content": "#謝謝{F#妳}{M#你}，有這些食材就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850502,
					"content": "原汁原味的蒙德「烤蘑菇披薩」，不知道能不能順利做出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850503,
					"content": "完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850504,
					"content": "這披薩…看起來還不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850505,
					"content": "#謝謝{F#妳}{M#你}幫忙，旅行者，這些東西請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850506,
					"content": "我等會就去仔細品嚐一下這披薩的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850507,
					"content": "如果還不錯的話…應該很快就能作為新品正式推出啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
