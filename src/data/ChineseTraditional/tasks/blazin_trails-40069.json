					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"楓原萬葉",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690301,
					"content": "哇啊我的帽子要掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690302
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690302,
					"content": "嗯？這種氣味…我們是在璃月附近的山上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690303
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400690303,
					"content": "可是這裡好陰暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690304,
					"content": "等等。你們聽…有聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006904,
			"completionStepIds": [
				4006904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006904",
							"2"
						],
						"stepId": 4006904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竹叔",
					"吉祥",
					"海伯",
					"莫娜",
					"楓原萬葉",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690401,
					"content": "我說辛焱啊，小姑娘家家，怎麼又在玩那種粗魯的樂器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690402
					],
					"speakerTitle": "竹叔"
				},
				{
					"id": 400690402,
					"content": "辛焱呀，妳媽媽說了，讓我有空多教教妳繡工。呵呵，這叫雅趣。什麼時候到阿姨家裡來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690403
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690403,
					"content": "吵死了，別在路邊彈琴啦！要是非彈不可，也彈點上得了檯面的曲子行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690404
					],
					"speakerTitle": "海伯"
				},
				{
					"id": 400690404,
					"content": "這、這說的都是什麼話呀，根本不是人話吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690405,
					"content": "唉，這些人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690406
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690407
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400690407,
					"content": "啊——氣死我了！妳幹嘛不罵回去呀，妳的搖滾精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690408,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690409
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690409,
					"content": "都這樣了，妳還笑！不生氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690410,
					"content": "有些話聽一次冒火氣，聽一百次可就氣不起來了。不過還是謝謝妳，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690411
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690411,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690412,
					"content": "吉祥阿姨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690413
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690413,
					"content": "欸，阿姨等妳回音呢。這個週末我剛好有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690414
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690414,
					"content": "阿姨，別光顧著我啦，妳家爐子火沒關，上頭還燉著湯吧？唔…妳看，都焦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690415,
					"content": "哎呀呀這怎麼得了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690416
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690416,
					"content": "竹叔，小竹又在外頭玩泥巴了，哎呀！你不是說了讓他別這樣嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690417
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690417,
					"content": "啊？！這混小子，又背著我出去幹這事！看我不給他一頓好打！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690418
					],
					"speakerTitle": "竹叔"
				},
				{
					"id": 400690418,
					"content": "嘻嘻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690419
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690419,
					"content": "海伯，對不住，我換個地方就是。不過您這聽曲兒的品位，可得趕趕時髦囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690420
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690420,
					"content": "要知道，就連璃月港最有名的角兒，都喜歡聽我這不上檯面的曲子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690421
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690421,
					"content": "妳說什麼？還有這事？妳…妳可別騙我啊！…當真有這事？不成，我得出去問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690422
					],
					"speakerTitle": "海伯"
				},
				{
					"id": 400690422,
					"content": "消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690423
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690423,
					"content": "妳看，適當的話術，自然的笑容，就能解決大部分問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690424
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690424,
					"content": "既然如此，搖滾精神又該用在什麼地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690425
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400690425,
					"content": "我的搖滾精神可不是那麼表面的東西，用來跟人吵架未免太浪費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690426
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690426,
					"content": "搖滾是革命！改革自我、改革命運，告別懦弱和退讓。而且，不是在言語上，是在藝術裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690427
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690427,
					"content": "風雨中絕不熄滅的燭火，岩洞下永遠沸騰的岩漿…無人可擋、無法停止的氣魄，這才是我的搖滾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690428
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690428,
					"content": "好了，走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690429
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690429,
					"content": "我看旁邊有條小路，走那邊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
