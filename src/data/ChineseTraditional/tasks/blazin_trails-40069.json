			},
			"dialogs": [
				{
					"id": 400690201,
					"content": "辛焱將泉水倒入花中…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400690202
					]
				},
				{
					"id": 400690202,
					"content": "感覺好多了。很有效，謝謝你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690203
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400690203,
					"content": "接下來，我會送各位去你們想去的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690204
					],
					"speakerTitle": "火熾之心"
				},
				{
					"id": 400690204,
					"content": "嗚啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4006903,
			"completionStepIds": [
				4006903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006903",
							"2"
						],
						"stepId": 4006903,
