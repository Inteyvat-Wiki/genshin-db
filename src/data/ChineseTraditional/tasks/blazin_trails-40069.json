				"points": []
			},
			"dialogs": [
				{
					"id": 400690801,
					"content": "笨瓜笨瓜，我們給你準備驚喜呢，誰知道你都不來找我們，還、還哭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690802
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690802,
					"content": "對不起，我是笨瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690803
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690803,
					"content": "不是啦！你不是笨瓜，是我們不好…不該嚇唬你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690804
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690804,
					"content": "阿飛，今天是你生日，我們本來想給你個驚喜，讓你嚇一大跳，才故意躲著你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690805
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690805,
					"content": "咦？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690806
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690806,
					"content": "給你準備了很多蓮蓬，好吃的。還有我和璐璐親手寫的祝福信…不能說我們字醜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690807
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690807,
					"content": "哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690808
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 400690808,
					"content": "你們…嘿嘿，謝謝你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690809
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690809,
					"content": "搞了半天是這麼一回事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690810,
					"content": "虛驚一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690811
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400690811,
					"content": "朋友嘛，幹出這種事也不奇怪。要是我朋友給我準備驚喜，我也會被嚇一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690812
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690812,
					"content": "是在暗示我們給妳驚喜嗎？好高明的話術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690813,
					"content": "欸？啊不是不是啦！我就是隨口一說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690814
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690814,
					"content": "我知道啦。我也是開玩笑，就想嚇妳一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690815
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690815,
					"content": "啊…是我肚子餓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690816,
					"content": "聲音未免太響了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400690817
					]
				},
				{
					"id": 400690817,
					"content": "確實快到飯點了，我想想…要不然，去我家吃飯吧？離這兒不遠，一直走就到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690818
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690818,
					"content": "幻境裡也有家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690819,
					"content": "有啊。我剛看了，這條路和現實中一樣，就通往我家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690820
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690820,
					"content": "雖然是在幻境裡，但不論是跟鄰里意見不合，還是表演失敗失望而歸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690821
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690821,
					"content": "假如有什麼非去不可的地方，我猜也就是那裡了。因為…人嘛，總要回家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006911,
			"completionStepIds": [
				4006911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006911",
							"2"
						],
						"stepId": 4006911,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聆聽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691101,
					"content": "那些鳥雀是喝過山頂的泉水，才能唱出悠揚的歌。妳看咱家，從來就沒人喜歡唱歌，妳又怎麼能唱得好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691102
					],
					"speakerTitle": "辛焱的母親"
				},
				{
					"id": 400691102,
					"content": "那我也去喝這種泉水就行了吧？媽媽，我出門一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006912,
			"completionStepIds": [
				4006912
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006912",
							"2"
						],
						"stepId": 4006912,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"楓原萬葉",
					"莫娜",
					"香菱",
					"雲堇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691201,
					"content": "到了到了，大家隨意，進門不用換鞋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691202
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691202,
					"content": "抱歉打擾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691203
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400691203,
					"content": "有椅子呢，正好可以坐一會兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691204
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691204,
					"content": "嗯？裡面的屋子好像有聲音…你們休息，我去看一眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691205
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691205,
					"content": "燈都沒亮，沒人在…哇啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691206
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691206,
					"content": "登登登！生日快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691207,
					"content": "妳們幹嘛啊！那麼大兩個人坐在屋裡還不開燈，想嚇死我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691208
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691208,
					"content": "雲堇妳說對了，她真的會被嚇到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691209,
					"content": "難得的生日，來點驚喜才好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691210
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691210,
					"content": "妳們兩個不要頂著可愛的臉做這種事行不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691211
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691211,
					"content": "欸？這話呀，我可是不愛聽的。誰規定長得乖巧可愛就不能開惡作劇玩笑啦？是不是呀香菱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691212
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691212,
					"content": "就是就是！鍋巴長那樣，不也很靈活嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691213
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691213,
					"content": "行行行，說不過妳們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691214
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691214,
					"content": "北斗姐今天有事，託我們帶話給妳，她就不親自過來啦，給妳的禮物由我轉交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691215
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691215,
					"content": "來，這是北斗姐送妳的外國樂譜和特製匕首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691216,
					"content": "辛焱，我專程差家裡人給妳打了金髮簪和鐵髮圈哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691217
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691217,
					"content": "鐵髮圈？！妳千年的打鐵世家，就打這個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691218
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691218,
					"content": "怎麼了？髮圈這是麻雀雖小五臟俱全呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691219
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691219,
					"content": "嘻嘻，我就不一樣囉。不久前，我在路邊看到個戴眼鏡的鐵匠，瞧他那樣子，好像能看懂石頭一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691220
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691220,
					"content": "我不信邪，請他幫我選石頭，沒想到真能開出翡翠來！嘿嘿，我當場拿去磨成吊墜大小，拿繩子串起來，給妳當掛飾用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691221,
					"content": "哇，妳做了個翡翠吊墜給我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691222
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691222,
					"content": "對呀，啊啊不是掛在脖子上的哦，掛琴上！天天看妳寶貝妳那把琴，我就想著，早晚也給它打扮起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691223,
					"content": "這麼寶貴的禮物我可不捨得用，得供起來！謝謝妳香菱，妳好細心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691224
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691224,
					"content": "嘻嘻，香菱心細也不是一兩天的事了。不過那人居然能看懂石頭…妳再說說這事。要是好玩，我得寫進戲裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691225
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691225,
					"content": "我也不曉得，聽說他是病了一陣子，那期間渾渾噩噩的，什麼都不記得，身體像是不屬於自己一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691226
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691226,
					"content": "再後來，砰地一下就好了！只是不知為什麼，從那天起，看一眼就能分辨石頭好壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691227
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691227,
					"content": "嗯…可真是怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691228
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691228,
					"content": "噢噢，不說這些了，菜都要涼啦，開吃開吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691229
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691229,
					"content": "且慢，辛焱，妳不是從外國商人那裡學了一招嘛？上回我生日時候，妳教我的那個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691230
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691230,
					"content": "嗯？噢，妳是說許生日願望對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691231
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691231,
					"content": "對對，就是那個。在外國還要點蠟燭切蛋糕，我們可沒顧上這些，光忙著幫香菱把飯菜提過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691232
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691232,
					"content": "沒事，我自己想像一下就有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691233
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691233,
					"content": "那我們數一二三，妳來許願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691234
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691234,
					"content": "一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691235
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691235,
					"content": "二——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691236
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691236,
					"content": "三——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691237
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 400691237,
					"content": "嗯~今年許個什麼願望好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691238
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691238,
					"content": "我的願望是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4006913,
			"completionStepIds": [
				4006913
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006913",
							"2"
						],
						"stepId": 4006913,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"莫娜",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691301,
					"content": "咦，回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691302
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691302,
					"content": "怎麼回事？我才剛湊到門縫裡看了沒多久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400691303,
					"content": "既然是幻境，辛焱，妳剛才在屋裡遇到什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691304,
					"content": "我知道我知道，她見到了幫她過生日的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400691305,
					"content": "那些我也聽到了啦！我是說她自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691306,
					"content": "我自己…啊！我許了個願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691307
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691307,
					"content": "說起來，這事也有點意思。我不是推門進去嗎？屋裡居然是香菱和雲堇，我的兩個好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691308,
						400691309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691308,
					"content": "認識認識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400691310
					]
				},
				{
					"id": 400691310,
					"content": "這可是現實中發生過的事，上回生日，她倆跑我家給了我一個大驚喜，做了一桌好吃的，讓我許生日願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691311
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691311,
					"content": "辛焱，妳的生日願望是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691312
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400691312,
					"content": "我的願望是——「跟大家意想不到的人一起辦演唱會」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691313
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691313,
					"content": "意想不到的人，會是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691314
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400691314,
					"content": "關於這件事，我在剛才一瞬間想通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691315
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691315,
					"content": "有答案了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691316
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400691316,
					"content": "嗯。不過，公佈答案之前，我想先疏通那些貫穿山石的水脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400691309,
					"content": "久仰久仰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400691310
					]
				}
			]
		},
		{
			"id": 4006914,
			"completionStepIds": [
				4006914
			],
