						400690702
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690702,
					"content": "啊！他、他怎麼這麼笨呀，都不知道來找我們…算了，我找他去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690703
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 400690703,
					"content": "跑掉了，我們快跟上。",
