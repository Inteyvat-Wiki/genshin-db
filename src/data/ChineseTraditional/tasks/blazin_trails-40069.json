				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"辛焱",
					"阿飛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690601,
					"content": "咦，那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690602,
					"content": "又是「門」，該不會又有那樣的人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690603
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400690603,
					"content": "小意思，放著我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690604
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690604,
					"content": "大姐姐，妳的髮型好奇怪喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690605
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690605,
					"content": "是嗎？我覺得很酷啊，你再好好看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690606
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690606,
					"content": "豎起來的辮子，尖尖的髮飾，別人都不這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690607
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690607,
					"content": "這話說得不對。我跟別人不一樣，那你見了我就會印象深刻，怎麼也忘不掉。以後見到我，還能認得我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690608
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690608,
					"content": "嗯…對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690609
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690609,
					"content": "頭髮衣服，甚至臉皮身段，可不是只給別人看的。自己喜歡什麼樣，就打扮成什麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690610
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690610,
					"content": "真的嗎？可我要是穿畫著小狗的袍子，別人就會說：「阿飛像小狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690611
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690611,
					"content": "那你就不聽他們的。你喜歡小狗對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690612
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690612,
					"content": "喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690613
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690613,
					"content": "你朋友喜不喜歡小狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690614
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690614,
					"content": "也喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690615
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690615,
					"content": "所以你的朋友肯定喜歡你那件袍子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690616
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690616,
					"content": "…嗯。大姐姐，怎麼不紮個討人喜歡的辮子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690617
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690617,
					"content": "沒辦法，我就喜歡這種有性格的。唉，紮這個之前，我也料不到大家這麼不喜歡我的辮子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690618
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690618,
					"content": "那不改改嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690619
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690619,
					"content": "這種髮型才符合我的音樂和生活。平日常見的那些都太普通了，不夠精神，還妨礙我演出時搖頭晃腦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690620
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690620,
					"content": "不喜歡就不喜歡唄，不改了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690621
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690621,
					"content": "那妳的朋友也不喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690622
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690622,
					"content": "才不會。她們都說，我這辮子好看得很呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690623
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690623,
					"content": "…朋友會幫妳。真好。不像我的朋友…把我丟在這裡。嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690624
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690624,
					"content": "哎呀怎麼哭了！出什麼事了？跟姐姐說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690625
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690625,
					"content": "璐璐和小蒙…不理我了，嗚嗚…說好今天約在碼頭，他們卻一直不來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690626
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690626,
					"content": "小小年紀就學會放鴿子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400690627,
					"content": "你待在這兒別亂跑，我去附近找找。找到了，就帶他們來找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690628
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400690628,
					"content": "…嗯！謝謝妳，大姐姐。我再也不說妳的辮子奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690629
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 400690629,
					"content": "哈，算你識相。那一會兒見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
