					"content": "不，沒什麼事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420402
					]
				},
				{
					"id": 751420402,
					"content": "#是嘛，那就祝{F#妳}{M#你}的旅途順利啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420403
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420403,
					"content": "嘿嘿，要常來玩喔！",
					"roleType": "TALK_ROLE_NPC",
