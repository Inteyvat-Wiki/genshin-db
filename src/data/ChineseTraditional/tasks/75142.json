			},
			"dialogs": [
				{
					"id": 751420101,
					"content": "哎呀，異邦的英雄，還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420102,
					"content": "一定是找不到「挖掘地」和「噴發遺蹟」，既然如此，我們也只能稍稍違背大人們的禁令…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "杜茲厄"
				},
				{
					"id": 751420103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420104,
					"content": "嗚，好吧…我不會出部族的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "杜茲厄"
				},
				{
					"id": 751420105,
					"content": "#那麼，{NICKNAME}…有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "度尼婭"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7514201",
							"2"
						],
						"stepId": 7514201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"度尼婭",
					"杜茲厄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "關於「挖掘地」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "嗯，其實挖掘地應該被稱為「秘源遺蹟的挖掘地」，就在聖山的南側，有一大片遺蹟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420203,
					"content": "據說也是很久很久以前的巨龍留下來的呢，為了防止有不懷好意的盜寶團偷偷發掘遺蹟，恩波索爺爺每天會在那邊巡邏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420204,
					"content": "從前恩波索爺爺就對這些遺蹟啊，遺物什麼的特別上心，還加入過龍遺物研究協會，每次都會和我們說過去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420205,
					"content": "不過，恩波索爺爺故事講得好差，都很枯燥無聊，什麼從遺蹟的什麼紋路上就能看出什麼圖騰「蔥白」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "杜茲厄"
				},
				{
					"id": 751420206,
					"content": "是圖騰「崇拜」啦…因為恩波索爺爺比起敘事人更像是個考古家嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "度尼婭"
				},
				{
					"id": 751420207,
					"content": "#據說，恩波索爺爺以前也曾經探索過火山內，說不定能幫上{F#妳}{M#你}們的忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "度尼婭"
				}
			]
		},
		{
			"id": 7514203,
			"completionStepIds": [],
