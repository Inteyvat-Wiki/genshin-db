	"talks": [
		{
			"id": 7268701,
			"completionStepIds": [
				7268701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268701",
							"2"
						],
						"stepId": 7268701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870101,
					"content": "#{F#妳}{M#你}們好，有緣人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870102,
					"content": "兩位舉手投足間散發著一股馨香，必定經受過風雅之物的薰陶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870103,
					"content": "#咦，我們身上香香的？讓我聞聞{F#妳}{M#你}，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870104,
					"content": "#真的誒，{F#妳}{M#你}身上有股松茸釀肉捲的香味！這個姐姐看人真準！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870105,
						726870106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870105,
					"content": "她說的應該不是這種香味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				},
				{
					"id": 726870107,
					"content": "也對喔，這種熟悉的展開…我明白了！這位姐姐果然也需要我們幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870108,
					"content": "#兩位是盡職盡責的嚮導，的確能為我招徠更多客人，但我希望{F#妳}{M#你}們也能以客人的身分享受這場祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870109,
					"content": "#如果兩位有空，要來試試看嗎？構築專屬{F#妳}{M#你}們的「花影瑤庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870110,
					"content": "「花影瑤庭」是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870111,
					"content": "我也想了解一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870112
					]
				},
				{
					"id": 726870112,
					"content": "#如{F#妳}{M#你}所見，我是一名花匠。我身邊這些花架上陳列著的，是以「插花」之道所構築的「花庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870113
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870113,
					"content": "將精心修剪的花卉置入花器，輔以各色飾物，構建桌上庭院般的景致。這便是「花影瑤庭」，花藝的結晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870114
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870114,
					"content": "在社奉行的支持下，我攜多座「花影瑤庭」參與容彩祭，希望能讓客人們領略到花藝的美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870115
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870115,
					"content": "要是對「花影瑤庭」感興趣，現在就可以來體驗一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870116
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870116,
					"content": "確實…這些花藝作品都好漂亮，聽起來也好高雅啊。不過，總覺得這種事情好難好難…我們能做到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870117,
						726870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870117,
					"content": "派蒙有點手拙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870119,
					"content": "請別擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870120,
					"content": "為了讓客人們充分體驗花藝的魅力，我預先製作了許多部件，適當簡化了「花影瑤庭」的製作步驟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870121,
					"content": "只需要選擇「主花」「花景」和「茵席」，將它們適當組合，就能完成「花影瑤庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870122,
					"content": "#當然，重要的是品味花藝的「表達」，因此，我會為{F#妳}{M#你}們提出四道「花題」，考驗{F#妳}{M#你}們的構圖思維。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870123
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870123,
					"content": "完成每天的「花題」後，就能將相應的「花庭」和花材帶走留念，還可以獲得額外的獎品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870124,
					"content": "真的嗎！還有這種好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870125,
					"content": "#{NICKNAME}，這位姐姐這麼盡心盡力地推崇花藝，我們就幫幫她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870126,
						726870127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870126,
					"content": "為了優美的花藝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870128,
					"content": "我們現在就要試試…什麼來著？對！製作我們的「花影瑤庭」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870129,
					"content": "兩位願意對花藝投入心意和熱情，實在感激不盡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870130
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870130,
					"content": "那我們現在就開始吧。今日的「花題」是「紫櫻扶疏，澄砂薄香」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870131
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870131,
					"content": "#請兩位領會題中的深意，專注於花材與花器，開始構築{F#妳}{M#你}們的「花影瑤庭」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870127,
					"content": "為了額外的獎品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870118,
					"content": "派蒙習慣大開大闔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870106,
					"content": "重點錯了啦，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				}
			]
		},
		{
			"id": 7268705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268702",
							"2"
						],
						"stepId": 7268702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "接下來的幾天，我會一直守候在這裡，引導容彩祭的客人們，讓他們感受「花影瑤庭」的精妙之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "#兩位也別忘了每天揭曉一道的「花題」喔，一共有四道「花題」等著{F#妳}{M#你}們作答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "#當然，要是兩位還有其他問題，我也會盡力為{F#妳}{M#你}們解答的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "關於這裡的花卉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有著難以挑剔的品質和親民的價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "#也許{F#妳}{M#你}們已經見過咲耶了，我們曾在同一位老師門下學習「插花」的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "咲耶對於花藝的理解也可圈可點，但是聽說容彩祭的客人絡繹不絕時，她似乎有些怯場，認為在這種環境裡難以靜下心來插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "所以，我也會向其他客人宣傳她的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "有機會的話，我們也可以幫忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870219,
					"content": "那麼，還有什麼問題嗎，兩位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "謝謝妳，柴染小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "#不用客氣。如果{F#妳}{M#你}們有空，隨時都可以來找我喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "關於社奉行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行一直支持著稻妻的花藝事業。準確來說，為這次活動出資的貴人，是那位白鷺公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鷺公主自小就表現出驚人的花藝天賦。我曾看過她的「插花」表演，有幸與她交流過心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "雖說我比她年長，但論插花的技巧和對花藝的理解，完全沒法與她相提並論呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "在條件允許的情況下，白鷺公主每年都會提供資金，推廣「插花」這門藝術。聽說有時她還會用掉自己的積蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鷺公主曾坦率表達過自己的願望——她想讓更多人瞭解「插花」，對花藝產生興趣，進而沉下心來修習這門學問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "原來綾華為稻妻的花藝付出過這麼多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870217,
					"content": "希望她的願望能實現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "#感謝兩位，{F#妳}{M#你}們真是善解人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "暫時沒有問題了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "#如果{F#妳}{M#你}們有空，隨時都可以來找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}