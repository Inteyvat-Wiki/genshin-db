			"dialogs": [
				{
					"id": 190785001,
					"content": "卡維老師看起來很生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "烏宰爾"
				},
				{
					"id": 190785002,
					"content": "管他呢。說不定他是擔心，我們將來會搶了他的飯碗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "瓦伊茲"
				},
				{
					"id": 190785003,
					"content": "這…應該不至於吧？卡維老師那麼有名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "塔尼莎"
				},
				{
					"id": 190785004,
					"content": "誰知道呢？我爸說了，越有名的人越喜歡擺架子，像阿爾卡米老師那樣的才是少數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊茲"
				}
			]
		},
