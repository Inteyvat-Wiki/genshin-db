			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿比德",
					"阿迪勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "聽說了嗎？阿爾卡米找來了卡維當培訓班的老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "阿比德"
				},
				{
					"id": 190780802,
					"content": "嘿，這下他的生意一定更好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780803,
					"content": "真讓人眼紅。阿爾卡米那小子，幹建築設計師的時候就得過且過，論能力他根本當不了老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "阿比德"
				},
				{
					"id": 190780804,
					"content": "他宣傳得好吧…再加上教令院有入學考試，能進教令院學建築的人畢竟還是少數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780805,
					"content": "上不了教令院的人，以及那些追求「速成」的人，當然就會聚集到他的培訓機構了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "阿迪勒"
				},
				{
					"id": 190780806,
					"content": "真是生財有道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿比德"
				}
			]
		},
