			"trigger": {
				"objectNames": [
					"阿丹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "你好，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780402,
					"content": "你認識阿爾卡米嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "你說阿爾卡米？是最近很出名的那個有錢人吧？他之前找我訂做家具，出手相當闊綽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780405,
					"content": "聽說他以前是知名建築師，存下了富裕的家產。現在開設了培訓機構，向大家分享自己的致富之路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780406,
					"content": "如果不是學費太貴，我也想幫我的孩子報個名。當建築師真賺錢啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿丹"
				},
				{
					"id": 190780403,
					"content": "想打聽一下阿爾卡米。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
