				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"華清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "站住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200402,
					"content": "什麼人，竟敢私闖重地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200403,
					"content": "私闖？我們只是路過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "是啊是啊，真不懂你們在說什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200406,
					"content": "我們是受邀來這裡的，是貴客！憑什麼這樣對我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200407,
					"content": "不…等一下…難道凝光…她是故意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200408,
					"content": "她假裝請我們上群玉閣，其實在這裡埋伏了千岩軍，想要把我們抓起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200409,
					"content": "我覺得不是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "嗚啊——我生氣了！那邊的士兵，你們這是釣魚執法！無恥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200412,
					"content": "什麼…正常的守衛任務，怎麼就無恥了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200413,
					"content": "一派胡言，總之，先把可疑人士控制起來再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "阿陽"
				},
				{
					"id": 10200414,
					"content": "要來了，把他們統統打趴下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200410,
					"content": "還沒跟他們解釋邀請的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "重地？這裡只是天衡山的野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
