			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "住手！何事喧嘩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200602,
					"content": "刻晴大人，這兩個怪人突然出現，似乎對歸終機有所圖謀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200603,
					"content": "你、你說誰是怪人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200604,
					"content": "我只是在找前往群玉閣的路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "#嗯？{F#妳}{M#你}們要上「群玉閣」？{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200606,
					"content": "我們是受邀請的客人，想找「璃月七星」！妳又是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200608,
					"content": "真巧，我就是「璃月七星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200609,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200610,
					"content": "我是刻晴，璃月七星之一的「玉衡星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200611,
					"content": "#我知道{F#妳}{M#你}的事，旅行者，{F#妳}{M#你}是凝光的客人吧？沒想到會在山間偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200612,
					"content": "哇——我也沒想到會在荒郊野嶺遇見有錢的大人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200613,
					"content": "天衡古城垣的歸終機損壞，卻在一夜之間修復完好。我在這裡，原本是想調查一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200614,
					"content": "這些千岩軍只是負責守衛現場，不是來抓人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200615,
					"content": "原來是誤會啊？嗯…真是完全沒想到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200616,
					"content": "還是很容易想到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "話說回來，仙人所造的機關，居然有凡人能修好。這即使對「七星」來說，也算一件奇事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200618,
					"content": "嘿嘿，那個是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200619,
					"content": "（噓…別節外生枝了，派蒙。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "咦？啊，哦…對了，這位「玉衡」大人，妳知道「天權」大人為什麼要邀請我們去群玉閣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200622,
					"content": "叫我刻晴就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200623,
					"content": "#凝光約{F#妳}{M#你}見面，我想，無非是希望「拯救蒙德的英雄」中立一些。至少…不要完全站在仙人一方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200624,
					"content": "我們可沒有站邊！我們和那些仙人聊過，他們也是準備庇佑璃月的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200625,
					"content": "妳說的「庇佑」，就是指那種居高臨下的傲慢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200626,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200627,
					"content": "#因為{F#妳}{M#你}們是凡民，是他們庇佑的對象，所以他們不會把{F#妳}{M#你}當做「有能力刺殺神明的刺客」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200628,
					"content": "所以他們一定也覺得，凝光封鎖現場、盤問凡民、追捕刺客…這些命令全都是無用功，甚至是在掩蓋什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200629,
					"content": "我直說了吧：這是在小看人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200630,
					"content": "妳這麼說，確實也有點道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200631,
					"content": "不過，像妳這樣「不敬仙神」的璃月人，我還是第一次遇見呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200632,
					"content": "哈…我是要敬他們時間觀念淡薄，又對凡人心存傲慢，所以暫時還不會對我們「七星」出手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200633,
					"content": "算了，我不該這樣談論仙人。「不敬仙神」只是我個人的態度，凝光就絕對不會說這種話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200634,
					"content": "總之，我也承認，這一次仙人們的行事，已經足夠克制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200635,
					"content": "帝君遇害，實在非比尋常。面對如此超出常理的事態，他們仍然願意召集眾仙商議、沒有直接打來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200636,
					"content": "這還挺文明的，真叫人意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200637,
					"content": "所以，會有和談的可能嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "凝光那個人呐…在她眼裡，最好萬事都能坐下商量——但這是不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200640,
					"content": "「仙人」的時代已經過去了，如果連「璃月七星」都不敢正視這一點，那璃月的未來要怎麼辦啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200641,
					"content": "唔…又是一句非常大膽的發言呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200642,
					"content": "#呼…那就言盡於此吧。其實我本來沒必要說這麼多，但{F#妳}{M#你}是很好的聽眾呢，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200643,
					"content": "#好了，{F#妳}{M#你}們該去群玉閣了。要準時喔？因為求見凝光的預約，都已經排到明年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200644,
					"content": "璃月的頂級富商們，都把「登上群玉閣」當作從商生涯的無上榮耀。人人都帶著豪禮，只為從凝光手中換取些許好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200645,
					"content": "好、好處？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200646,
					"content": "派蒙，那不是重點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "可是…可是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200649,
					"content": "對了！「見面禮」也是璃月的珍貴文化，我們不是為了好處，是為了尊重璃月的傳統文化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200650,
					"content": "看看這個派蒙殷勤的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "#好了好了，要送什麼見面禮{F#妳}{M#你}們慢慢想，我先把去群玉閣的方法告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200652,
					"content": "#其實{F#妳}{M#你}們不必來天衡山的。回璃月港去吧，到月海亭找「引路人」，然後如此這般…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200653,
					"content": "那麼，我們有緣再見吧，旅者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200654,
					"content": "嗯…那位「玉衡星」雖然不敬仙神，但我覺得她是個相當颯爽的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200655,
					"content": "我對她的印象也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "對了，要給凝光送什麼見面禮呢…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200658,
					"content": "派蒙的重點真的變成送禮了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "對了！昨天我睡覺的時候，夢見了一道無比尊貴的點心——<color=#00E1FFFF>「糖霜史萊姆」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200660,
					"content": "我有預感，它很適合凝光這種身分的大富豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200661,
					"content": "我們就用這個當作禮物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200662,
					"content": "所以，有食譜嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "沒有！但只要用「劈咔」的感覺去做就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200666,
					"content": "快去搜集材料！事不宜遲，榮華富貴在等著我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200664,
					"content": "夢到的東西要怎麼做啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "用「劈咔」的感覺去做就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200656,
					"content": "我認同她說的一部分話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "派蒙，我們在談正事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "凝光也想和仙人談判嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "（我們只是做了一些小小的工作…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "哎哎？只能飛到這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200702,
					"content": "都怪風場不夠厲害，不然就能直接上到頂啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200703,
					"content": "回璃月港吧…找千岩軍打聽一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "嗯？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200705,
					"content": "上去的方法應該不是秘密，否則…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "否則？…喔，我明白了，否則甘雨讓我們自己拜訪群玉閣，就說不通了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200707,
					"content": "#好吧，那就按{F#妳}{M#你}說的辦吧，我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200708,
					"content": "#啊！先等一等，{F#妳}{M#你}看下面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200709,
					"content": "原來我們已經走到<color=#00E1FFFF>「歸終機」</color>附近了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200710,
					"content": "這樣的話…唔…我有個新點子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200711,
					"content": "#——不如，用「歸終機」把{F#妳}{M#你}發射上去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200712,
					"content": "先不要，會死的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "唔呃…這麼說來，確實沒有考慮到安全細節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200716,
					"content": "不過我記得，歸終機有望遠的功能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "啊，對哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200718,
					"content": "這麼說來，確實可以利用…那就靠歸終機來找找看，附近還有沒有上去的路吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200714,
					"content": "難道妳很恨我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "唔呃…只是沒有考慮到安全細節而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}