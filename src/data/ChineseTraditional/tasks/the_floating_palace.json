			"dialogs": [
				{
					"id": 10200101,
					"content": "看！天上那個就是「群玉閣」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200102,
					"content": "好高啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200105,
					"content": "失策了！作為嚮導的我，好像並不知道通往「天上」的路在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200106,
					"content": "現在才發現這一點嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200109,
					"content": "不過，既然要去群玉閣，那直接在地圖上找群玉閣的位置，也是很合理的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200110,
					"content": "一定是在附近就有上去的辦法吧？我們找找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10200107,
					"content": "當時應該問問那位叫做甘雨的使者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "要怎麼上去呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102002",
							"2"
