							"7224504",
							"2"
						],
						"stepId": 7224504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里栖太御須",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "不許動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450402,
					"content": "啊，不要動，不要動啊！欸呀，都說了不要動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450403,
					"content": "欸，可是，突然要我不要動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450404,
					"content": "讓派蒙不動…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "才不會呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450407,
					"content": "哎呀，那就轉個身吧，我可從來沒見過這樣的衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450408,
					"content": "雖然有點醜陋，但也不是什麼意思都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450409,
					"content": "居然覺得醜，那還不如不要看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450410,
					"content": "真是的，以往我要那些女官們為我作範本，可沒有那麼煩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450411,
					"content": "不過，白夜國的人啊，穿的衣服，長的樣子我也全都看膩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450412,
					"content": "#{F#妳}{M#你}們身上的倒是少見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450413,
					"content": "#嗯嗯，我知道了，原來這個衣服是這樣的結構…{F#妳}{M#你}們異鄉還真是不知羞恥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450414,
					"content": "原來如此，衣服結構若是這樣的，那身軀就做成這個造型吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450415,
					"content": "你這是在做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450416,
					"content": "塑像啊，用泥水混合，用雙手捏出造型。每每只有做這事的時候，內心才能平靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450417,
					"content": "平時的議會，照本宣科地按著大人們寫好的詞句讀，總讓人不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450418,
					"content": "…好了，妳的造型我也已經看膩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450419,
					"content": "別煩我，去做自己的事去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里栖太御須"
				},
				{
					"id": 722450405,
					"content": "會掉下來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
