			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"栖令比御",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#遠方到來的旅者，咳咳，{F#妳}{M#你}看上去相當疲憊啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450302,
					"content": "疲憊可不行，很多病，都是從疲憊開始的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450303,
					"content": "每日要保證足夠的睡眠，才能，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450304,
					"content": "咳咳咳咳，咳咳咳…才能健康成長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450305,
					"content": "總覺得你自己不是很健康呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450306,
					"content": "哈哈，這是老毛病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450307,
					"content": "旅者啊，只有完備健全的身軀，才可寄寓完備健全的魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450308,
					"content": "唉，如果再有點時間就好了，我一定能夠成為世上最好的醫生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450309,
					"content": "這樣，就算是我這樣的身軀，恐怕也可以健康地走出房間，肆意玩耍了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "栖令比御"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
