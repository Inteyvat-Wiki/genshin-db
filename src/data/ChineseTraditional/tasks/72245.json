			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#唉，{F#妳}{M#你}就是異鄉的旅者嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450702,
					"content": "#{F#妳}{M#你}是在追尋什麼嗎，{F#妳}{M#你}行走的姿勢，實在是，令人感到憂傷啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450703,
					"content": "憂傷？有什麼讓人覺得憂傷的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450704,
					"content": "對於歌者來說，世界上任何事都是值得悲傷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450705,
					"content": "譬如，結合就意味著分離，活著就意味著有一日會被埋入塵土之下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450706,
					"content": "譬如，重逢短暫，消解不了別離之苦，這位旅者呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450707,
					"content": "只有追尋什麼的人才會踏上遠離故土的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450708,
					"content": "這旅程對於長住一地的居民來說想必相當浪漫，但對於旅者自己，或許是難言的苦楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450709,
					"content": "#若是從前，我便要在此為{F#妳}{M#你}歌唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450710,
					"content": "只是，我在日前與人立下誓言，如果我聽不到她的聲音，那我也不再展露自己的歌喉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450711,
					"content": "#我只能祝福{F#妳}{M#你}，雖然{F#妳}{M#你}看上去也已比我年長許多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450712,
					"content": "#祝{F#妳}{M#你}如願以償。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御琉部栖"
				}
			]
		}
