			"dialogs": [
				{
					"id": 722450501,
					"content": "#哎呀，這位旅者，咱看{F#妳}{M#你}眉心發黑，不如咱來為{F#妳}{M#你}算個命吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450502,
					"content": "咱可是百算百靈的伊恩大人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450503,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450504,
					"content": "這在橋下拉客的人的語氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450505,
					"content": "（而且，我記得他的墓碑上寫著……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450506,
					"content": "那是什麼懷疑的眼神，好了好了，咱平時給別人算命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450507,
					"content": "但是白夜國的國民…很少有幸福快樂的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450508,
					"content": "所以咱就欺騙他們，說他們走了好運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450509,
					"content": "咱覺得，這樣他們好歹也能快樂一些嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450510,
					"content": "結果他們就說咱根本就不會算，真是令人悲傷呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450511,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450512,
					"content": "怎麼樣，小傢伙，就讓咱給妳算一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450513,
					"content": "那、那好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450514,
					"content": "嗯…讓我仔細算算，咦，怎麼牽涉的東西這麼多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450515,
					"content": "欸呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450516,
					"content": "怎、怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450517,
					"content": "算不出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450518,
					"content": "怎麼會這樣呢，咱平時算出來的雖然不準，但也不會到算不出來的地步啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450519,
					"content": "看來能力不是很強嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450520,
					"content": "…所言甚是，看來，咱還得再努力學習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊恩"
				}
