			"dialogs": [
				{
					"id": 722450601,
					"content": "#啊，看{F#妳}{M#你}的樣子，你是從異國而來的旅者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450602,
					"content": "是從什麼地方來的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450603,
					"content": "我們是從蒙德來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450604,
					"content": "蒙德？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450605,
					"content": "向比螺夢門簡單講述了蒙德城的風物…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "從來沒有聽說過的城邦，是嘛，了不起，居然還有這樣的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450607,
					"content": "哈哈哈，我就說世上怎麼會只有白夜國那麼大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450608,
					"content": "世上只有白夜國，嘿，那豈不是寂寞得要死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450609,
					"content": "看古籍的時候也有提到白夜成國之前的故事，那時我就覺得天外有天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450610,
					"content": "不過，我原本還是害怕的，害怕白夜國之外其實空無一物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450611,
					"content": "#旅者，{F#妳}{M#你}的到來讓我安心好多。哼，世上原來還有這麼多有趣的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450612,
					"content": "只可惜我現在還有一個叫歸日之祭的祭典要完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450613,
					"content": "#旅者啊，不如這樣，{F#妳}{M#你}告訴我{F#妳}{M#你}進入此處的路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450614,
					"content": "等到歸日之祭的祭典禮成，我就找機會偷偷從大日御輿跑出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "比螺夢門"
				},
				{
					"id": 722450615,
					"content": "到時候一起喝杯果汁吧！哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "比螺夢門"
				}
			]
