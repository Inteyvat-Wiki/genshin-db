			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"離可琉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "嗯？別來打擾我，我在想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450102,
					"content": "我在想很重要的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450103,
					"content": "很重要的事？是什麼事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450104,
					"content": "#{F#妳}{M#你}看到那個叫大日御輿的東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450105,
					"content": "就整個白夜之國最高的建築。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450106,
					"content": "我在想呀，要怎麼做個更高的建築，比大日御輿還高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450107,
					"content": "嗯，可是大日御輿建那麼高，是為了照亮白夜國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450108,
					"content": "你的那個建築做那麼高是為了什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450109,
					"content": "當然是為了彰顯我離可琉大人的聲名啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450110,
					"content": "只有這樣，就能證明我比阿倍良久那個大叔要厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450111,
					"content": "你認識…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "那是當然了，建造大日御輿，讓白夜國擺脫危機…我以前，正是因為崇拜他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450114,
					"content": "可是，他居然想要圖謀王位，要不是那些大人，說不定我就要丟掉性命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450115,
					"content": "哼，我一定要建造比大日御輿還高的建築。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450116,
					"content": "那、那要建多久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450117,
					"content": "我才不管呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450118,
					"content": "白夜之國的人民能受我諭令，建造一個留名青史的奇觀，感恩戴德還來不及呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450119,
					"content": "好了，別打擾我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450120,
					"content": "讓我想想，樑高如果…這樣的話，承重和斗拱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "離可琉"
				},
				{
					"id": 722450112,
					"content": "阿倍良久嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224502",
							"2"
						],
						"stepId": 7224502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"依栖目那須",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "#嗯？從未在白夜之國見過{F#妳}{M#你}們這樣穿著的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450202,
					"content": "#難道{F#妳}{M#你}們是從什麼天外之處來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450203,
					"content": "#原來世上不只有白夜之國，那，呈上{F#妳}{M#你}們通行使用的地圖，給我一觀吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450204,
					"content": "（給予地圖…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "哦哦，真是精巧，不僅陸地輪廓精確，連山川走勢也隱隱所現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450206,
					"content": "那麼這名為提瓦特之國的國土大小，能和白夜之國相比嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450207,
					"content": "提瓦特是整片大陸的名字啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450208,
					"content": "還有，淵下宮，啊，也就是白夜國，在地圖南邊的這個小塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450209,
					"content": "荒謬！我白夜國土如此遼闊，怎麼可能才只有這點大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450210,
					"content": "此圖看上去精巧，實為妄誕亂畫之作，拿去拿去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450211,
					"content": "我本還有些敬佩之心，沒想到竟是偽作，真是汙了我的眼睛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "依栖目那須"
				},
				{
					"id": 722450212,
					"content": "哼，你不信就算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224503,
			"completionStepIds": [
				7224503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
