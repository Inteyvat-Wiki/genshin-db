			},
			"dialogs": [
				{
					"id": 722430102,
					"content": "我有寶物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "出售寶物？真是令人意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430104,
					"content": "像您這樣強大的冒險家，想要出售的東西一定很罕見吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430105,
					"content": "快請讓我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430106,
					"content": "將龍骨花凝珠的故事告訴了瑪喬麗。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "啊，這不是就像是吟遊詩人的故事裡說的忘憂果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430108,
					"content": "居然真的有這種東西存在嗎…原來它叫龍骨花凝珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430109,
					"content": "如果它的效果真的和您所說的一樣，我願意花80000摩拉加一些特色料理買下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430110,
					"content": "嗯…80000摩拉加上5個月亮派，您覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430111,
					"content": "妳會拿它做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "嘻嘻，多麼獨特的寶物呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430113,
					"content": "童話一般的神奇功效，我相信那些煉金術士們不會吝惜自己的錢包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430114,
					"content": "公道的價格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "那我就收下這件寶物了，多謝惠顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430116,
					"content": "對了，通常來說，這種凝珠類的物品會在風中緩慢揮發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430117,
					"content": "所以，最好將它覆上隔膜或者放進容器密封起來，這樣成色會更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430118,
					"content": "這是一點附送您的小技巧，希望對您的冒險有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430119,
					"content": "如果今後您又找到了類似的寶物，別忘了，這有您忠實的買家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430120,
					"content": "我再考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "哈哈，沒問題，但是我相信我的價格是最合適的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 722430122,
					"content": "如果您考慮好了，可以再來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				}
			]
