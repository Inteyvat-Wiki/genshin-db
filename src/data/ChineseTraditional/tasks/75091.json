				"points": []
			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "嗯…要有耐心一點，等到…等到安靜的時候，我會把這些石頭餵給「寶藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910202,
					"content": "只要再過一段時間，嘿…就會長出更好的石頭的，嘿嘿…一顆…一顆，兩顆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				}
			]
		},
		{
			"id": 7509103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
