			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "嗯，真的長出更好的石頭了。雖然已經是第二次看到，但感覺還是很神奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910502,
					"content": "呵，呵呵…多疑的外邦人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910503,
					"content": "#這下{F#妳}{M#你}們終於能夠明白…「寶藏岩」的偉大之處了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910504,
					"content": "#啊啊…得益於{F#妳}{M#你}們拿來的石頭，「寶藏岩」的力量也變得更加深厚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910505,
					"content": "真不知道最後會變成什麼樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910506,
					"content": "嗯，這麼一說，就連我都有些好奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910507,
					"content": "到底是為什麼只要吃進石頭，就會吐出一些更好的？還是…我們打開來看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910508,
					"content": "妳、妳在說什麼，絕不允許這樣做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910509,
					"content": "#要是…要是{F#妳}{M#你}們想要把「寶藏岩」打開的話，就先踏過我的屍體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910510,
					"content": "唔…我只是隨便說說啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910511,
					"content": "#哼，看在{F#妳}{M#你}們之前為「寶藏岩」拿石頭來的分上…這次就饒過{F#妳}{M#你}的冒犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910512,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910513,
					"content": "我已經…哼哼，我已經感受到了，只要再讓「寶藏岩」吃下更高級的石頭，就一定能夠產生了不起的變化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910514,
					"content": "異邦的旅人啊，我曾聽外來的行商說沙漠中有種特殊的輝石，蘊藏著了不起的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910515,
					"content": "名字是…對，名字是「萬相石」。如果、如果能夠將那種石頭帶來餵給「寶藏岩」的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910516,
					"content": "一定，一定就可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910517,
					"content": "#唔…{NICKNAME}，{F#妳}{M#你}覺得呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910518,
					"content": "那就試試看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "真的滿好奇會發生什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910520,
					"content": "如、如果有「萬相石」的話…給我，只要給我一枚就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				}
			]
