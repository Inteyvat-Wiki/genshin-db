			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"基斯庇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "嗚哇，沒想到上面真的長出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910302,
					"content": "「寶藏岩」好厲害…不對，不會是基斯庇你放在「寶藏岩」上的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910303,
					"content": "呵，呵呵…我怎麼會做如此愚蠢之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910304,
					"content": "#多虧了{F#妳}{M#你}們給的石頭，「寶藏岩」也變得更有活力，啊，{F#妳}{M#你}們聽不見嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910305,
					"content": "那彷彿地中流焰鼓動的聲響，就像是…啊，就像是脈搏一般…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910306,
					"content": "果然，給它吃點別的石頭…是對的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910307,
					"content": "唔…什麼都聽不到啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}{F#妳}{M#你}聽得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910309,
					"content": "感覺只是正常岩石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "是哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910313,
					"content": "哼哼，異邦的…啊，兩位了不起的異邦的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910314,
					"content": "#如果可以的話，再給我一些石頭吧。更好的、更漂亮的石頭…相信「寶藏岩」的力量不會讓{F#妳}{M#你}們失望的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910315,
					"content": "我感受到了，我感受到了，這樣一定對它也是有好處的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910316,
					"content": "總有種逐漸陷入陷阱的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}，{F#妳}{M#你}覺得呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910318,
					"content": "可以拿到更好的石頭的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "的確有繼續試試的價值呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910320,
					"content": "嘿嘿，那就挑一些比以前更好的石頭交給我吧…啊，更好的石頭，這樣「寶藏岩」的力量也一定會有所增長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910311,
					"content": "「寶藏岩」在大叫！「嗚哇哇」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "#才不會啦！{F#妳}{M#你}又在嚇我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
