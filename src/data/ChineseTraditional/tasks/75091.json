			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"基斯庇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "一顆，兩顆，嗯，三顆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910102,
					"content": "哼，哼，一顆…兩顆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910103,
					"content": "嗚哇，這裡有個好奇怪的部族人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910104,
					"content": "#奇怪的應該是{F#妳}{M#你}們這些異邦人才對，呵…呵呵…這可不是異邦人應該來的地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910105,
					"content": "這是什麼禁地…還是聖地之類的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910106,
					"content": "#並不是，這只是我偶然發現的寶藏之地。哼，來吧，兩位，靠近點，{F#妳}{M#你}有沒有聽見？這塊特殊的岩石…「寶藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910107,
					"content": "其中傳來的聲音猶如低鳴般起伏，就彷彿，啊…就彷彿有人在呼吸一般的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910108,
					"content": "石頭也很辛苦嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "只是呼吸而已，算什麼辛苦啦，不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910112,
					"content": "石頭…石頭也會呼吸嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910113,
					"content": "不僅有呼吸，如果將耳朵貼上去，還可以聽得到律動，聽到岩石在這粗糙的表皮之下摩擦的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910114,
					"content": "嘿，嘿，真是美妙的聲響啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910115,
					"content": "而且，而且哦，只要餵一些小石頭，甚至還會吐出更好、更漂亮的石頭來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910116,
					"content": "#啊啊，很不可思議吧？{F#妳}{M#你}看這些寶石，一顆，兩顆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910117,
					"content": "原來剛才我們過來的時候，你在數這些寶石啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910118,
					"content": "對，而且我可以感受到吃下不同石頭的這塊「寶藏岩」，變得更加強壯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910119,
					"content": "這一定是了不起的奇蹟，啊啊…「寶藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910120,
					"content": "聽起來很可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "#呵，呵呵…本來就不指望{F#妳}{M#你}們這些異邦人會相信。如果不嘗試一下的話，沒有人會相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910123,
					"content": "我也是偶然把收集到的礦石放在「寶藏岩」上才發現的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910124,
					"content": "#對了，就讓{F#妳}{M#你}們試一下吧！試試看{F#妳}{M#你}們就會相信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910125,
					"content": "剛好附近的石頭已經全部被吃過一遍了，要再餵點新的石頭…可是我沒辦法去找給它吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910126,
					"content": "欸，為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910127,
					"content": "當然！我當然要一直看著「寶藏岩」啊！它要是、要是在我離開的時候鑽入地底，那該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910128,
					"content": "我已經在這裡看守很久了…身上所有的石頭都已經被吃過一遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910129,
					"content": "#{F#妳}{M#你}們、{F#妳}{M#你}們給我一點新的石頭吧。我來餵石頭證明給{F#妳}{M#你}們看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910130,
					"content": "唔…聽起來好像一個騙子哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910131,
					"content": "#怎麼辦，{NICKNAME}，要試試看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910132,
					"content": "反正只是石頭的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "嘿嘿，那就挑一些石頭交給我吧…「寶藏岩」一定會吐出更好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910121,
					"content": "真的嗎？很像在騙人欸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "我也會呼吸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "對啊，會呼吸有什麼了不起…唔…沒人在說這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7509102,
