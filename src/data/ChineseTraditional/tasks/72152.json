			"dialogs": [
				{
					"id": 721520101,
					"content": "「…此處曾是大海賊林藏的藏寶之地，兄弟們搬走了最後幾箱…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "盜寶團的筆記"
				},
				{
					"id": 721520102,
					"content": "「…但林藏生前詭計多端，在島上多處留下了專屬記號…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "盜寶團的筆記"
				},
				{
					"id": 721520103,
					"content": "「…或許只是掩飾，或許確有寶藏，但只有前往一探究竟才能確定…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "盜寶團的筆記"
				},
				{
					"id": 721520104,
					"content": "「…我們已經發現了一些標記，時不我待，該動身去發掘林藏的全部遺寶了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "盜寶團的筆記"
				},
				{
					"id": 721520105,
					"content": "唔…好長…除了「寶藏」兩個字以外完全不想讀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721520106,
					"content": "欸…？寶藏？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721520107,
					"content": "既然有寶藏，我們也快點出發吧！別讓盜寶團搶先啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
