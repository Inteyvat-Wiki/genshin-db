			},
			"dialogs": [
				{
					"id": 402200201,
					"content": "馬上比賽就要開始了，大家準備得怎麼樣？我們一路過來看到好多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200202,
					"content": "我準備好了毛巾、熱湯還有保暖的毛毯，嗯…應該已經不缺什麼了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200203
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200203,
					"content": "按照我們之前商量好的安排，隊長她們現在應該正在熱身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200204
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200204,
					"content": "等大家正式開跑之後，我就去終點守著，隨時準備遞上水和毛毯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200205
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200205,
					"content": "我剛從家裡過來，比賽很快就要開始了，大家的熱身還沒結束嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200206
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200206,
					"content": "的確是有點久了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200207
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200207,
					"content": "按理說，瓦雷莎和希諾寧都不是會拖拖拉拉的人啊…我們過去看看情況好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200208,
					"content": "#那就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明妮"
				}
			]
		},
