			"dialogs": [
				{
					"id": 402200101,
					"content": "別自責了，明妮，這不能怪妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200102
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200102,
					"content": "妳已經做得很好了…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200103
					],
					"speakerTitle": "湯義剛"
				},
				{
					"id": 402200103,
					"content": "義剛，不用安慰我了。你身體要緊，強撐著過來已經很不容易了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200104,
						402200105
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200104,
					"content": "比賽結果怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				},
				{
					"id": 402200106,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200107,
					"content": "我來吧。抱歉，榮譽騎士，我帶著傷員走到終點的時候，其他隊伍的選手都已經跑完很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200108
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200108,
					"content": "救生員已經把人帶走檢查了，我們隊…沒有拿到一個像樣的成績，對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200109
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200109,
					"content": "#明明{F#妳}{M#你}們在前面跑得那麼快，卻因為我被拖累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200110
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200110,
					"content": "明妮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200111
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402200111,
					"content": "看到那個人受傷的時候，其實我很猶豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200112
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200112,
					"content": "大家已經努力了這麼多天，如果我沒有回去拉他的話，我們的成績就不是現在這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200113
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200113,
					"content": "救生員和安柏小姐就在附近，妳們也離得不遠，如果我不去拉他，他也不會有生命危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200114
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200114,
					"content": "但我沒辦法忍住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200115
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200115,
					"content": "沒關係的，明妮，我們明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200116
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200116,
					"content": "面對受傷的人，怎麼可能置之不理呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200117
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200117,
					"content": "「是熾魂鬥士的話，一定會握住那雙渴求幫助的手。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200118
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200118,
					"content": "欸，這句話的出處是哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200119
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200119,
					"content": "是我剛編的，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200120
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200120,
					"content": "…隊長，謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200121
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200121,
					"content": "明妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200122
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200122,
					"content": "還好沒出大事，剛才嚇死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200123
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200123,
					"content": "孩子，什麼東西都沒妳的生命重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200124
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200124,
					"content": "下次別這樣嚇唬我們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200125
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200125,
					"content": "爸爸媽媽，對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200126
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200126,
					"content": "因為一個小小插曲，你們並沒有獲得理想的成績。雖然有些不甘心，但現實就是這樣，汗水未必能澆灌出花朵。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200127
					]
				},
				{
					"id": 402200127,
					"content": "不過你們的歡笑與付出都真實地存在過，在未來某一天它或許可以結出別的成果。\\n明妮的表情有些苦澀，但也有些釋然。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200128
					]
				},
				{
					"id": 402200128,
					"content": "明妮選手，妳的身體怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200129
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200129,
					"content": "啊，裁判先生，我還好，沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200130
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200130,
					"content": "…您是剛才的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200131
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200131,
					"content": "您好，我是「飛雷稻光」隊的謙三，受您關照我沒受什麼大傷，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200132
					],
					"speakerTitle": "暈頭轉向的稻妻選手"
				},
				{
					"id": 402200132,
					"content": "幾位，「飛雷稻光」全隊和我們組委會協商了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200133
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200133,
					"content": "明妮選手回身救助他人的行為值得讚賞，組委會一致認為如果不是這個意外，你們的成績會更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200134
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200134,
					"content": "目前，「熾魂鬥士」隊的排名不足以拿到獎牌，但我們評估之後認為你們應當獲得一項榮譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200135
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200135,
					"content": "在前幾名的獎牌之外，組委會將為你們頒發一塊特別獎牌，鼓勵你們以生命為先的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200136
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200136,
					"content": "謝謝你，杜拉夫叔叔。爸爸、媽媽，我會按照約定的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200137
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200137,
					"content": "好，那就按照我們之間的約定來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200138
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200138,
					"content": "…在保證安全的情況下，妳可以去外面旅行了，明妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200139
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200139,
					"content": "欸？爸爸，但是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200140
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200140,
					"content": "在我看來，妳已經拿到一個夠好的「名次」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200141
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200141,
					"content": "呵呵，是啊。喏，還有獎牌為證呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200142
					],
					"speakerTitle": "雪琳"
				},
				{
					"id": 402200142,
					"content": "依我看，不如我們全家一起出去旅遊一趟吧——就去妳最喜歡的八重堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200143
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200143,
					"content": "我倒要看看能不能找到適合妳老爸老媽看的漫畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200144
					],
					"speakerTitle": "莫里茨"
				},
				{
					"id": 402200144,
					"content": "太好了，明妮，這是一個好開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200145
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200145,
					"content": "我…我太開心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200146
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200146,
					"content": "這麼值得紀念的時刻，怎麼能忘記留影呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200147
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200147,
					"content": "有道理啊，大家一起來合影吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200148
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200148,
					"content": "我建議我們模仿「熾魂鬥士戰記」第二冊裡菲耶蒂娜第一次和瑪薇卡並肩作戰的場面，一起拍一張！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 402200105,
					"content": "明妮身體怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				}
			]
		},
