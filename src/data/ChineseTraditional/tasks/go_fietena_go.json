			"dialogs": [
				{
					"id": 402200501,
					"content": "各位選手、各位觀眾，大家好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200502
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200502,
					"content": "我，杜拉夫，受組委會任命，擔任本次龍脊雪山國際越野賽的裁判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200503
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200503,
					"content": "希望各支隊伍在遵守比賽規則的同時，超越自我，跑出好成績。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200504
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200504,
					"content": "同時也提醒大家，雪山地形崎嶇，為了防止意外，大家應當盡量保持在賽道上行走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200505
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200505,
					"content": "組委會已經提前清理過賽道，但雪山環境複雜，賽道之外依然會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200506
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200506,
					"content": "選手們注意，一旦身體不適，無法堅持跑完全程，或者意外受傷，請到賽道一側休息。組委會工作人員會盡快趕到並救助傷者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200507
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200507,
					"content": "隊長，義剛呢？怎麼沒看到他？馬上就要開跑了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200508
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200508,
					"content": "明妮，義剛發燒了，現在人還昏著，沒辦法來參賽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200509
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402200509,
					"content": "什麼？怎麼會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200510,
						402200511
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200510,
					"content": "別擔心，有我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				},
				{
					"id": 402200512,
					"content": "#放輕鬆，明妮，{M#他}{F#她}很強的，有我們在妳們說不定能拿到第一名呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200513,
					"content": "#我…我放心，謝謝{F#妳}{M#你}們幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200514
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200514,
					"content": "…接下來，由我來介紹各支參賽隊伍——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200515
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200515,
					"content": "來自須彌的「沙之行者」、來自稻妻的「飛雷稻光」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200516
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200516,
					"content": "來自璃月的「夕陽」，以及楓丹的「灰手」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200517
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200517,
					"content": "由冒險家組成的隊伍「向山」，還有清泉鎮鎮民們組成的隊伍「神行獵手」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200518
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200518,
					"content": "最後，由各國參賽者組成的混合隊伍——「熾魂鬥士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200519
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200519,
					"content": "其他隊伍的選手看起來都很厲害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402200520,
					"content": "不要慌，不要緊張！現在該想想菲耶蒂娜了，各位，拿出勇氣來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200521
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200521,
					"content": "有我們在一起，什麼阻礙都能翻越！翻不過去的就用衝撞頂開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200522
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 402200522,
					"content": "不是誰都像妳…算了，我同意，這種時候可不能說喪氣話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200523
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 402200523,
					"content": "看我的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200524
					]
				},
				{
					"id": 402200524,
					"content": "我也會努力，相信大家，相信自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200525
					],
					"speakerTitle": "明妮"
				},
				{
					"id": 402200525,
					"content": "接下來，請選手們各就各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200526
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200526,
					"content": "準備——開跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 402200511,
					"content": "我來跑義剛這段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				}
			]
		},
