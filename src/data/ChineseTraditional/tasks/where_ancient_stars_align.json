			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"菲謝爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "咦，菲謝爾在等我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140102,
					"content": "來得可真是時候。雖然不捨，也必須和各位說出這番話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140103,
					"content": "#暫且與本皇女辭別吧，同行者。一路上{F#妳}{M#你}展現了非凡的勇氣，這股嘉獎的風正是為{F#妳}{M#你}而起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140104,
					"content": "哎哎哎？怎麼突然道別呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140105,
					"content": "菲謝爾，妳要走了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "大隕石加劇了昏睡現象，連身強體壯的士兵也支撐不住。現在到處都缺乏人手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140107,
					"content": "皇女與我要代替士兵看護那些患者，剩下的事就交給你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}…再見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140109,
					"content": "#{F#妳}{M#你}是很好的聆聽者，願意陪我聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140110,
					"content": "平時，即使在協會裡，許多冒險家願意跟我搭檔，也只是為了從我的話裡聽出奧茲偵察的結果而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140111,
					"content": "這次的一小段旅途，是一場很好的冒險。突然說要走，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140112,
					"content": "咦？菲謝爾的說話方式，是不是有點不像平常的那種…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140113,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140114,
					"content": "（啊——啊啊啊剛才不小心出神了…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140115,
					"content": "小，小姐的意思是…你們是如此勇敢，又有常人難及的智慧，任何謎題在你們面前都會化為烏有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140116,
					"content": "怎麼這次奧茲「翻譯」的方向完全反過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140117,
					"content": "咳，咳咳…小姐想說，如果是你們幾位，一定可以抵達幻象背後的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140118,
					"content": "#咳咳…唔，沒錯。你們是皇女的扈從。斷罪的騎士，{F#妳}{M#你}要帶領他們走出黑暗，回歸光明之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411140119,
					"content": "誰是妳的扈從啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140120,
					"content": "奧茲，菲謝爾，謝謝你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "還會再見的，等一切結束，再約著喝杯酒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411140122,
					"content": "哎，可惜了兩個好幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140123,
					"content": "別愁眉苦臉的，說個好消息吧，我有新發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140124,
					"content": "我從大隕石上刮來一些粉末幫助占卜，卓有成效哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140125,
					"content": "這些墜落的石頭已經存在成百上千年，萊納德應該是很久之前的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140126,
					"content": "隕石傳遞著他的意志，也就是說，千百年來他的願望一直沒有減弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140127,
					"content": "#一個熱切渴望登上山頂的古人…我敢斷定，他和{F#妳}{M#你}一樣，也是冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140128,
					"content": "冒險家？難怪這麼想爬上雪山！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140129,
					"content": "目前的辦法幾乎是跟時間賽跑，我們很被動。必須轉換思路，從根本上解決問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140130,
					"content": "我支持！我認為現在應該把重心放在萊納德身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140131,
					"content": "嗯…如果隕石承載了某種願望，那這些石頭就正如菲謝爾所說，算是某種形式的「詛咒」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140132,
					"content": "真難得，她蒙對了…咳咳，算了，優雅的占星術士不該這樣評價別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140133,
					"content": "總之，我們只要去解開詛咒就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140134,
					"content": "現在就出發吧，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140136,
					"content": "既然要調查從前的冒險家，就該從<color=#00E1FFFF>冒險家協會</color>入手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111407,
			"completionStepIds": [
				4111407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
