							"2"
						],
						"stepId": 4111407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "叫這個名字的冒險家有好幾位，我也不敢斷論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411140702,
					"content": "但我有印象看過叫這個名字的人寫的書，不如去圖書館看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411140703,
					"content": "但我記得，有一本作者名叫萊納德的書，你們不如去<color=#00E1FFFF>圖書館</color>看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111414",
							"2"
						],
						"stepId": 4111414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "作者，萊納德…萊納德…有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140802,
					"content": "索引上說，萊納德的冒險家手冊在圖書館<color=#00E1FFFF>一樓</color>的<color=#00E1FFFF>西北角</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140803,
					"content": "西北角…應該就是那邊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111409,
			"completionStepIds": [
				4111409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111409",
							"2"
						],
						"stepId": 4111409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "找到他的書了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140902,
					"content": "快給我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140903,
					"content": "內容有缺損，完全不連貫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "哼哼，我就知道會這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140905,
					"content": "如果是一般的占星術士，多半已經投降了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140906,
					"content": "但我莫娜可是未來的占星術第一人，沒有什麼東西能難倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140907,
					"content": "用星盤推算缺漏的部分填入其中，再進行解讀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140908,
					"content": "呼——！終於看完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140909,
					"content": "說了什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140910,
					"content": "和我想的一樣，萊納德是一名兩千年前的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140911,
					"content": "他畢生的夢想就是登上一座名叫「尖帽子峰」的雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140912,
					"content": "兩千年？這些隕石是…古代人的「命之座」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140913,
					"content": "他的命之座由於某種原因被召喚到大地上。關於這點，我認為和愚人眾有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140914,
					"content": "同意，稀奇古怪的事情就屬他們幹得最多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140915,
					"content": "這些隕石內含元素力，以一種精神暗示的方式輻射了周圍居民，使他們陷入夢境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140916,
					"content": "另外如果我猜得沒錯，這批隕石中應該有一顆類似核心的存在，是萊納德精神的結晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140917,
					"content": "它會在哪裡呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "如果我是萊納德，這顆核心一定會按我所想，從空中抵達生前沒能登上的山頂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140919,
					"content": "核心會在尖帽子峰嗎？可是…尖帽子峰在哪裡呀？我都沒聽說過這個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140920,
					"content": "我也是第一次知道。對比書中地圖與現在的蒙德地形，我發現，尖帽子峰已經不存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140921,
					"content": "那麼大一座雪山也會消失嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140922,
					"content": "我在書上讀到過，風神巴巴托斯為了他的人民，曾經動用神力吹散冰雪，也改變了蒙德的地貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140923,
					"content": "過去的山峰被一望無垠的大海取代了。但若將那座山放入海中，以它曾經的高度，還是會留下一些痕跡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140924,
					"content": "——峰頂露出水面的部分，如今叫做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>「馬斯克礁」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
