			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "找到了！冒險家手冊《山與海之書》，作者萊納德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141402,
					"content": "可是，這本書居然缺字少頁，根本看不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141403,
					"content": "怎麼這樣，嗚…該不會白來了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141404,
					"content": "別放棄，拿給莫娜看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "啊，對哦，說不定她有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
