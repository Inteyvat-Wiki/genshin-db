			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "哦？這就是從前的尖帽子峰嗎？變得好小呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141102,
					"content": "哎，有人先到了？這裡是什麼觀光景點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141103,
					"content": "啊！是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141104,
					"content": "唔…嗯？是你們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141105,
					"content": "你是怎麼找到這裡的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "他這個樣子，難道是剛從夢境裡出來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141108,
					"content": "竟然有人能憑自己的力量甦醒過來…怎麼可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141109,
					"content": "哼，你們做不到，不代表我也做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141110,
					"content": "你們來晚了一步，我的「研究」已經完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141111,
					"content": "果然這一切都是你們愚人眾搞的花樣嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141112,
					"content": "#別那麼緊張，我今天沒時間陪你們玩。下回再找{F#妳}{M#你}的麻煩也不遲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141113,
					"content": "等等！你到底有什麼目的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "你剛才進入了那個眾人共通的雪山夢境吧？你對萊納德的事知道多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141115,
					"content": "萊納德？什麼萊納德…哼，不管了，現在可不是關心雜魚的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141116,
					"content": "我發現了…更可怕、更重要的事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141117,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141118,
					"content": "是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "星空本身，就是個巨大的謊言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141120,
					"content": "星空…謊言？這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141121,
					"content": "是想反駁莫娜的什麼占星術理論嗎？那也不用說「星空本身是謊言」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141122,
					"content": "在夜裡，抬頭往天上看，不就能直接看到星星嗎？這種常識…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141123,
					"content": "哈…哈哈哈哈哈哈！還在說這種天真的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141124,
					"content": "不過，這也不是妳的錯，因為直到不久之前，我也是這樣相信的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141125,
					"content": "直到剛才？你是指…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141126,
					"content": "哼，我可沒空再陪你們探討這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141127,
					"content": "「丑角」那傢伙…把這種任務交給我，居然不事先預警可能的「發現」…是想故意嚇我一跳嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141128,
					"content": "我現在必須去確認「真相」。那麼，再見了，菜鳥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141106,
					"content": "你是剛睡醒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
