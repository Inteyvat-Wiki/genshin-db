					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "要好好地吸食雨露，快快長大才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190102,
					"content": "你好！你是蘭…蘭什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190103,
					"content": "你是蘭帕卡提的哥哥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "喔喔，這招不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190107,
					"content": "…長大、長大，變成美味的菜餚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190108,
					"content": "完全聽不進去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190105,
					"content": "蘭薩卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "蘭薩卡！你是蘭薩卡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "噫！是那菈…好高、好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190202,
					"content": "#求求{F#妳}{M#你}了…不要摘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190203,
					"content": "好啦，我們不會摘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190204,
					"content": "那就好，呼呼…這些墩墩桃都是我，一點一點種出來的，從它們還是種子開始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190205,
					"content": "不、不對，你們這些那菈，壞！怎麼能隨便向別人種的墩墩桃下手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190206,
					"content": "那菈為什麼會、會有這麼可怕的習慣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190207,
					"content": "我們什麼都沒做，還沒來得及摘啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190208,
					"content": "#什麼都沒做，都已經那麼可怕了，{F#妳}{M#你}們要是真的做了什麼，那豈不是要嚇死我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190209,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190210,
					"content": "不行，蘭薩卡…想想呀，為了你辛苦種出的墩墩桃，為了「烹飪修行」…不能在這裡退縮，一定不能害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190211,
					"content": "果然，你就是蘭薩卡呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190212,
					"content": "#嗚哇，{F#妳}{M#你}、{F#妳}{M#你}們怎麼知道我名字的…{F#妳}{M#你}們是從哪裡來的那菈…居、居然一見面就知道了我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190213,
					"content": "你自己說的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "#真是禍從口出，完蛋了，我的名字將被用於可怕的詛咒…求求{F#妳}{M#你}們，饒了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190215,
					"content": "#除了把墩墩桃給{F#妳}{M#你}們，我什麼都願意做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190219,
					"content": "沒必要那麼緊張啦，我們其實是受蘭帕卡提委託來找你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190220,
					"content": "蘭、蘭帕卡提？啊，我親愛的「妹妹」，密林中的陽光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190221,
					"content": "向蘭薩卡述說事情的經過。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "#嗚哇，無憂節、無憂節怎麼會那麼快…欸，{F#妳}{M#你}們就是來參加這次無憂節的那菈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190223,
					"content": "#對不起，剛剛說{F#妳}{M#你}們是壞那菈。{F#妳}{M#你}們一定是好那菈，因為只有好那菈才能進入桓那蘭那，參加無憂節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190224,
					"content": "無憂節要到了，要是沒有完成「烹飪修行」就回桓那蘭那…不行…但是無憂節可不能不參加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190225,
					"content": "怎麼反而變得更緊張了…你不是還有你種的墩墩桃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190226,
					"content": "…只、只有我種的墩墩桃是不夠的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190227,
					"content": "一定要拿到「開心的味道」。沒有「開心的味道」，墩墩桃也只不過是墩墩桃而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190228,
					"content": "蘭茶荼、蘭阿帕斯和蘭非拉，都不相信世界上存在「開心的味道」。我要做出來給他們看。也要給那菈品嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190229,
					"content": "「開心的味道」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "嘿嘿，「開心的味道」，我以前曾經嚐到過一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190232,
					"content": "「開心的味道」。白白的，揉揉就碎…變成白色的巴螺迦，但是不像巴螺迦那樣，又硬又痛。裝在硬硬氣泡裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190233,
					"content": "…白色的巴螺迦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "白色的巴螺迦，就是白色的沙子…吧？不過，硬硬氣泡是什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190236,
					"content": "唔，搞不懂。那種「開心的味道」在什麼地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190237,
					"content": "妳、妳問這個幹什麼，難道妳想要在我之前，奪走「開心的味道」嗎？好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190238,
					"content": "我們是想幫你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "幫我？幫我什麼？我、我自己也能拿到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190242,
					"content": "只不過，那裡有很多那菈走來走去。而且，其中有一個，還有那菈巴螺迦的味道。唔…我害怕…要是那菈少一點，我也可以的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190243,
					"content": "…唉。好吧，我就是拿不到，我…不敢進化城郭，那裡那菈太多了。而且，都是死去的樹，我好怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190244,
					"content": "我有一個那菈朋友住在裡面。但是，過去了很久很久。現在，他變了，聽不到我的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190245,
					"content": "這樣啊，所以你說的「開心的味道」，其實在化城郭裡就有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190246,
					"content": "「開心的味道」，不是從土地裡長出來的，而是那菈做出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190247,
					"content": "我真的好想再嚐一次呀，我還記得第一次品嚐那個味道的時候，心裡多麼高興。那是好厲害、好厲害的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190248,
					"content": "和那菈朋友一起在森林裡，數從樹葉間落下來的，像金箔一樣的陽光有多少片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190249,
					"content": "一起唱歌，一起品嚐「開心的味道」。每次看見樹葉間的陽光，我就會想到他。每次想到他，我就想起「開心的味道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190250,
					"content": "所以，我想讓蘭帕卡提嚐嚐這樣的味道。而且，等無憂節開始了，讓那菈也嚐嚐這樣的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190251,
					"content": "#我明白了，就交給我和{NICKNAME}吧！對吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190252,
					"content": "我也想要開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "#真的？{F#妳}{M#你}們沒有在騙我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190255,
					"content": "沒有啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190256,
					"content": "不過化城郭那麼多人，到底要去誰那裡找啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190257,
					"content": "我知道。不久之前，看到一個那菈，從這裡路過，<color=#00E1FFFF>去了化城郭</color>。他就帶著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190258,
					"content": "他背上有一個鼓鼓的東西。是那菈用來裝東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190259,
					"content": "背上有鼓鼓的東西…嗯，<color=#00E1FFFF>應該是行囊或者背簍</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190260,
					"content": "知道了，我們這就去幫你找「開心的味道」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190253,
					"content": "既然已經答應了蘭帕卡提…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "哇！派蒙，妳好可怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "喂！我只是想幫蘭薩卡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190234,
					"content": "…硬硬氣泡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "你說的「開心的味道」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "我們早就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "#什麼！早就知道？原來{F#妳}{M#你}們在很早之前就盯上了我…難、難道{F#妳}{M#你}們想從我這裡得到什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190218,
					"content": "難道是墩墩桃？不、不行，要是其他的東西我一定給…但，但是墩墩桃不行，無論如何都不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "蘭薩卡"
				}
			]
		},
		{
			"id": 7301903,
			"completionStepIds": [],
