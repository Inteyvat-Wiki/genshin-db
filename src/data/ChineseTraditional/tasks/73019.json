			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"楊尼斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190402,
					"content": "#唔，{F#妳}{M#你}們好…怎麼，有什麼想要的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190403,
					"content": "是的，其實我們是想要一樣東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190404,
					"content": "#呵呵，當然啦，所有人過來都是想要「一樣東西」的。不過只說「一樣東西」，我可不知道{F#妳}{M#你}們要的是「什麼東西」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190405,
					"content": "嗯…我知道啦。怎麼說呢，我們想要的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190406,
					"content": "白白方方的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "白白方方的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190408,
					"content": "對，而且還要一揉就碎成沙，還要裝在硬硬的氣泡裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190409,
					"content": "還真是奇怪的描述…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190410,
					"content": "#光聽{F#妳}{M#你}們這麼說，還真不清楚到底是什麼，不過，{F#妳}{M#你}們說的這種白白的方方的東西啊，它是做什麼用的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190411,
					"content": "用途，用途總是知道的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190412,
					"content": "是可以吃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "可以吃的，白白方方的東西…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190416,
					"content": "#啊！我知道了，我知道{F#妳}{M#你}們要什麼了…哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190417,
					"content": "有這麼好笑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190418,
					"content": "哎呦，哈哈哈哈哈，我說啊，白白方方的，一揉就碎，變成沙…還能吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190419,
					"content": "那不就是「糖」嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190420,
					"content": "硬硬氣泡，該不會說的是裝糖的玻璃瓶吧，我的天哪，硬硬氣泡，哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190421,
					"content": "什麼呀，原來是糖啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190422,
					"content": "有點難堪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "哎呀，笑得眼淚都快出來了。這些年為了生意奔波，都不知道上一次笑成這樣是什麼時候的事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190425,
					"content": "這麼說來，真是懷念，我記得很久以前…啊，我還是小孩的時候，曾經有個朋友第一次吃糖，也說過類似的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190426,
					"content": "「這個白白方方的東西真好吃！好厲害！開心的味道。」可驚訝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190427,
					"content": "哈哈…都是多少年前的事了，現在回想，卻連他長什麼樣子都記不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190428,
					"content": "#哎呀，作為笑得這麼開心的回禮，這瓶糖就送給{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190429,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "要注意，小心拿好喔，硬硬氣泡雖然硬，一下摔在地上可還是會碎的。「硬硬氣泡」，哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楊尼斯"
				},
				{
					"id": 730190423,
					"content": "有點尷尬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "是烹飪用的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "烹飪用的，白白方方的，難道是調味料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "楊尼斯"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
