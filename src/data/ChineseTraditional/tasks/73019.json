			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "#怎、怎麼樣，{F#妳}{M#你}們找到，「開心的味道」了嗎…就在化城郭裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730190302,
					"content": "有個那菈，背上有一個鼓鼓的東西。「開心的味道」一定裝在裡面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭薩卡"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
