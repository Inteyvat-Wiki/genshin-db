				7150301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150301",
							"2"
						],
						"stepId": 7150301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼",
					"阿昊",
					"老圖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715030101,
					"content": "#{F#妳}{M#你}來得好，{NICKNAME}，我們正討論怎麼將「普爾希娜光釘」搬運進去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030102,
					"content": "不過這裡的情況比我們想像的嚴重太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030103,
					"content": "咳咳…不行，這裡的黑泥太多，又全是黑泥引來的怪物，搬不進去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030104
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030104,
					"content": "根本找不到能夠再往前的路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030105
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030105,
					"content": "這還遠沒到礦道裡面呢，來，再搭把手，再試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030106
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030106,
					"content": "要是還是不行，我就去外面再找幾個弟兄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030107
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030107,
					"content": "不就是搬個東西嘛，我挖礦巨星老圖，隨便揮揮鎬子就能挖空一座山，這層岩巨淵裡的怪物能奈我何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030108
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030108,
					"content": "你就別裝了，你憋咳嗽憋得臉都紅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030109
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030109,
					"content": "你胡說，我哪有，呃咳，咳咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030110
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030110,
					"content": "不能再繼續前進了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030111,
					"content": "過度接觸這些黑泥，會造成嚴重後果，而且裡面怪物那麼多，太危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030112,
					"content": "可是，可是我們都看到了，之前把機器放到礦區，礦區不就乾淨了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030113
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030113,
					"content": "要是，咳咳，要是能早點解決礦道裡的這些黑泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030114
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030114,
					"content": "這不是追求速成的時候，無論是處理問題還是實驗，不進行準備，完成勘查，就貿然進行，一個誤操作就會造成生命危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030115,
					"content": "「個人生命至關重要」，這是「教令院」實驗室操作手冊上的基本守則之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030116,
					"content": "身為「教令院」的學者，我不能對這樣的行為視而不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030117,
					"content": "唉，可是我們停手了…這麼多黑泥該怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030118
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030118,
					"content": "如果這些黑泥引來更多怪物…就算我們再來二十個人…咳咳，都沒法送進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030119
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030119,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030120
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030120,
					"content": "實在不行就，在這裡先啟動一次光釘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030121,
					"content": "在這裡啟動光釘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030122
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030122,
					"content": "對，我剛才目測了一下黑泥湧出的速率，雖然比昨天礦區裡要快，但是畢竟不是黑泥的核心區域，清理的速度會比湧出的速度快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030123,
					"content": "層岩巨淵的怪物被黑泥吸引，肯定也是受到了黑泥裡能量的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030124,
					"content": "#在這裡啟動光釘，減輕周圍黑泥的影響，對{NICKNAME}{F#妳}{M#你}的行動也有助益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030125,
					"content": "如果清理完黑泥，怪物也不會在此聚集。到時候再試試看往裡搬運吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030126,
					"content": "那就這麼辦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030127
					]
				},
				{
					"id": 715030127,
					"content": "兩位，就先回營地休息一下，之後還有麻煩兩位的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030128
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030128,
					"content": "我還不用休息，就這點事…咳咳，還沒到我挖礦巨星想要休息的時候，不就是清理怪物嘛，我能幫得上忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030129
					],
					"speakerTitle": "老圖"
				},
				{
					"id": 715030129,
					"content": "別強撐著了，我還不知道你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030130
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030130,
					"content": "#這位可是{NICKNAME}，事情交給{NICKNAME}，還有什麼需要我和{F#妳}{M#你}操心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030131
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030131,
					"content": "#{NICKNAME}，清理周圍的黑泥和怪物，就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030132,
						715030133
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715030132,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				},
				{
					"id": 715030134,
					"content": "#對了，{NICKNAME}這周圍全是黑泥，比我想像的要嚴重太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030135
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030135,
					"content": "黑泥周圍還有很多的怪物，一定要小心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030136
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030136,
					"content": "我會小心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030137
					]
				},
				{
					"id": 715030137,
					"content": "不，我是說，一定要注意「普爾希娜光釘」的安全啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030138
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030138,
					"content": "#我相信{F#妳}{M#你}的實力，但是「普爾希娜光釘」畢竟是精密而脆弱的偉大儀器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030139
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030139,
					"content": "可得注意不讓光釘受到損傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715030133,
					"content": "交給我，你們就放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				}
			]
		}
	]
}