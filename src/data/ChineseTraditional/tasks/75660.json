			"trigger": {
				"objectNames": [
					"希諾寧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "呼…天氣還不錯，這次散心來得滿值得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600102,
					"content": "嗯？這不是我們的驕傲「杜{RUBY#[D]希望}麥尼」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600103,
					"content": "好巧哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "向希諾寧說明了伊拉德和考核關卡的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "原來是這樣…差點忘了，之前我的確幫了她一把，「回聲之子」的考核關卡剛好也在這附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600107,
					"content": "一開始，伊拉德只有請「赭石之災」恩孔加和「塞提阿德的砂刃」阿姆魯提供參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600108,
					"content": "不過那兩位對「靈活機動」沒什麼興趣，只顧著強調正面對決，提出的設計建議都有點太偏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600109,
					"content": "帕加爾聽說了這件事，就來請我出主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600110,
					"content": "那麼，現在的關卡是妳的作品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "差不多吧，我和帕加爾和伊拉德討論了之後，還是決定略微修改一下我們部族的關卡構造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600112,
					"content": "現在，這些關卡更考驗戰士佔據有利位置以及不斷在戰線支點轉移的意識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600116,
					"content": "那就讓我來接受妳的考驗吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "#{F#妳}{M#你}的實力整個納塔都有目共睹，無論是什麼樣的關卡，應該都難不倒{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600119,
					"content": "喏，關卡就在那邊，有興趣的話就去試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600117,
					"content": "希望希諾寧的關卡不要太難…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "妳這位名匠還真是什麼都造…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "只是一些簡單的裝置，造起來也沒什麼困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600115,
					"content": "要是忙這麼一次，「回聲之子」就能不斷湧現出新的強者，我也能清閒點，把手頭堆積的單子慢慢搞定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 756600104,
					"content": "我接了伊拉德小姐的委託。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}