			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"佩科"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "哎呀呀，感謝兩位的救命之恩，我是遊商佩科，之後兩位若有機會關照我的生意，一定給兩位最實惠的折扣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220302,
					"content": "說起來今天真是倒楣，竟讓我碰見這傳說中的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220303,
					"content": "傳說中的人物？那傢伙很有名嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220304,
					"content": "惡名的話是有的。我也是聽別的同行說的…當時他們也被嚇得不行，說是再也不走這條路線了，我也是不信邪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220305,
					"content": "那你還真是膽大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220306,
					"content": "我們做遊商的，什麼沒碰見過？而且，我們有時候坐在一起，講講自己的故事的時候，也總容易「誇大事實」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220307,
					"content": "說偏了…他叫「權八」，聽說是在稻妻犯了什麼事，逃亡來了偏鄉，對了，還帶著他的對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220308,
					"content": "所以剛剛他提到的「阿紫」就是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#對哦！剛剛那個怪人和{NICKNAME}打架的時候就唸叨著這個名字呢，奇奇怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220310,
					"content": "從前就不走正路的人，哪怕到了新的地方，想要金盆洗手也沒那麼容易吧。沒個正經營生，最後只有重蹈覆轍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220311,
					"content": "如果他就自己一個人的話，這種生活方式倒也無所謂，但刀口舔血，誰知道會得罪什麼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220312,
					"content": "聽說他那相好也是因此才喪命…反正，自從那之後，他就瘋瘋癲癲的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220313,
					"content": "唉…大塊頭搶劫摩拉是可惡，但一想到他變成現在的樣子，又覺得有那麼一點點可憐啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220314,
					"content": "所以派蒙千萬不要為了摩拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "喂！主要根本不是這個啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220318,
					"content": "好啦，我就不繼續耽誤兩位的時間了，這份謝禮先請兩位收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "佩科"
				},
				{
					"id": 760220316,
					"content": "如果有一天派蒙被搶劫了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#哼哼，那我身邊不是還有{F#妳}{M#你}嘛！我的摩拉，{NICKNAME}守護！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}