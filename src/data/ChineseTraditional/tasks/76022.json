			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "喂！大塊頭！你在做什麼！快停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760220202,
					"content": "摩拉…不對，不對！害死阿紫的傢伙…受死吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "憤怒的武士"
				},
				{
					"id": 760220203,
					"content": "#哇啊啊！{NICKNAME}，小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
