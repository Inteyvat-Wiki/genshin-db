					"瑪格麗特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "好了，這下兩份佐料都齊了，我們開始調製飲品吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083802,
					"content": "到底會是什麼味道呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "#如何，{F#妳}{M#你}也想嚐嚐這種飲品嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083804,
					"content": "嗯…這種飲品的調製手法也不複雜，只要按照我設計的流程調製，就一定會成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083805,
					"content": "#旅行者，不如…{F#妳}{M#你}來親手調製一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083806,
					"content": "我來試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "#沒問題，我先說一下調製這種飲品的流程，{F#妳}{M#你}記好了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083808,
					"content": "首先放入<color=#00E1FFFF>甜甜花</color>，再澆入調酒專用的基酒…當然，我們這次用的是<color=#00E1FFFF>牛奶</color>，這就有了口感清甜的基底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083809,
					"content": "為了增添風味，這時候再加入<color=#00E1FFFF>風車菊</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083810,
					"content": "然後別急著混合，得<color=#00E1FFFF>靜置</color>一下，讓花的香味慢慢散發出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083811,
					"content": "再撒入<color=#00E1FFFF>蒲公英籽</color>，酒液裡就會像散滿星星一樣好看，最後放入<color=#00E1FFFF>冰塊</color>就大功告成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083812,
					"content": "順序就是這樣，要調出可口的酒可不能弄亂這個順序，得好好記住唷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700083813,
					"content": "記住的話就來試試吧，如果忘記了再來問我也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪格麗特"
				}
			]
		},
