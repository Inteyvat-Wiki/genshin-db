					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060906
					]
				},
				{
					"id": 30060906,
					"content": "也就是說是有用的對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060907,
					"content": "好，接下來再去戰鬥一次吧，像剛才那樣用平常心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060905,
					"content": "罐裝知識裡的東西成為了記憶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060906
					]
