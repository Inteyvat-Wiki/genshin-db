						],
						"stepId": 300601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060101,
					"content": "#{F#妳}{M#你}們來了，看{F#妳}{M#你}們的表情，事情應該是辦成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060102
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060102,
					"content": "哇，這裡可有不少教令院的人在啊，你怎麼把見面地點選在這種地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060103,
					"content": "維卡拉商棧本來就是教令院管理監督下的機構，當然有教令院的人在這裡工作。我來奧摩斯港，表面上也是處理這裡的公務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060104
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060104,
					"content": "你這個人還真是膽大包天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060105,
					"content": "#別那麼緊張，這裡的人對我們的話題沒興趣，而且風紀官也不會來這裡的。好了，說說{F#妳}{M#你}們和多莉見面的情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060106
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060106,
					"content": "向艾爾海森說明了之前的經歷，並把買到的罐裝知識交給了他…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060107
					]
				},
				{
					"id": 30060107,
					"content": "艾爾海森，既然我們已經把你交待的事辦到了，現在你總可以告訴我們關於教令院丟失的罐裝知識的情報了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060108,
					"content": "#在那之前我想問一句，{F#妳}{M#你}們為什麼要追查那個東西？當然{F#妳}{M#你}們不回答也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060109,
						30060110
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060109,
					"content": "並不是什麼需要隱瞞的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				},
				{
					"id": 30060111,
					"content": "#嗯，{M#他}{F#她}只不過是想求見智慧之神，向她詢問一些重要的事情而已。但我們在須彌待了這麼久，還沒有找到辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060112,
					"content": "這時候我們打聽到教令院丟了某個東西，這個東西可能和「神明」有關。既然這樣，我們就來碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060113,
					"content": "#這麼說的話，{F#妳}{M#你}們的方向倒也不算錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060114
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060114,
					"content": "前一陣子教令院在沙漠丟失了一枚罐裝知識，據說那是一枚「神明罐裝知識」，如果使用它，就能夠獲得神明的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060115
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060115,
					"content": "#哇，竟然還有這種東西！{F#妳}{M#你}說，如果我們找到了它，是不是無論求見草神的辦法，甚至{F#妳}{M#你}{M#妹妹}{F#哥哥}的事情，也都能知道了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060116,
					"content": "這東西有沒有這麼神奇，我非常懷疑。但這件東西確實存在，而且現在就在奧摩斯港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060117
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060117,
					"content": "它現在在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060118,
					"content": "這個問題，就是我們接下來的課題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060119
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060119,
					"content": "難道說，你的目的也是它？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060120
					]
				},
				{
					"id": 30060120,
					"content": "我不否認。我對「神明罐裝知識」究竟是什麼很好奇，想一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060121
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060121,
					"content": "當然奧摩斯港的鍍金旅團也盯上了它。這東西本身就非常珍貴，說不定其中的知識，還能帶來更多力量與財富。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060122
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060122,
					"content": "最近幾個旅團就正在爭奪這東西的歸屬權，目前還沒有最後贏家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060123
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060123,
					"content": "以我個人的財力和門路，很難跟他們競爭，所以我之前嘗試了各種辦法，好不容易才和幾個旅團達成初步協議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060124
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060124,
					"content": "我不會佔有這枚神明罐裝知識，但他們答應給我研究它的機會。畢竟對他們來說，弄懂這東西也沒壞處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060125
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060125,
					"content": "可是鍍金旅團裡，也有不那麼好談條件的，比如阿赫瑪爾之眼的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060126
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060126,
					"content": "這些人堅信，神明罐裝知識中有赤王的力量，他們得到它是為了讓赤王重現世間，絕不允許教令院的人玷汙赤王的精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060127
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060127,
					"content": "他們不肯跟你合作，所以你之前才會一直糾纏他們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060128,
					"content": "嗯。阿赫瑪爾之眼並不算財大氣粗，但得到它的信心非常堅決。他們為了弄到充足的資金，一直在用各種卑鄙的辦法斂財。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060129
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060129,
					"content": "所以我一直在攪他們的生意，逼他們不得不與我對話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060130
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060130,
					"content": "神明罐裝知識的秘密交易，大概這幾天就會進行。旅團們會各自出價，東西也會被偷偷交給贏家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060131
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060131,
					"content": "各旅團為了東西的安全，哪怕是為了提防風紀官，也不會公然聲張自己贏得了神明罐裝知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060132
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060132,
					"content": "如果我不能知道神明罐裝知識的確切去向，和他們之間的協定就無法兌現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060133
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060133,
					"content": "#得知情報最可靠的管道就是多莉，但之前這條路對我來說走不通。現在{F#妳}{M#你}們加入了，情況就不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060134
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060134,
					"content": "也就是說，你讓我們和多莉打好關係，都是為了獲得神明罐裝知識的下落？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060135,
					"content": "#對，{F#妳}{M#你}們可以這麼認為，但這件事對{F#妳}{M#你}們沒有一點壞處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060136
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060136,
					"content": "#後天，{F#妳}{M#你}們再到多莉那邊去一趟，試著向她買神明罐裝知識的下落。如果她表示還沒有消息，就等兩天再去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060137
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060137,
					"content": "#如果我將來能順利得到神明罐裝知識的研究機會，會把研究結果告訴{F#妳}{M#你}們。這個就算是報酬，可以吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060138,
						30060139
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060138,
					"content": "這正是我需要的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060140,
					"content": "好，那我們就後天再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060141
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060141,
					"content": "艾爾海森，你等一下！其實我們自己也買了一枚罐裝知識，不過還不知道應該怎麼用它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060142,
					"content": "#{F#妳}{M#你}們想試試罐裝知識？好吧，我可以教{F#妳}{M#你}們如何用它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060143
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060143,
					"content": "不過要站在教令院的眼皮子底下做這件事，還是困難了點，我們到野外去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060139,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060110,
					"content": "我們在尋找見草神的辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				}
			]
		},
		{
			"id": 300602,
			"completionStepIds": [
				300602
			],
