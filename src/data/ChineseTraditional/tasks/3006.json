				"points": []
			},
			"dialogs": [
				{
					"id": 30060201,
					"content": "#好，就在這吧。把{F#妳}{M#你}們買到的罐裝知識給我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060202
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060202,
					"content": "給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060203,
					"content": "「單手劍戰鬥技巧·八」…嗯，是實戰類的罐裝知識。這類知識不太常見，很多都被鍍金旅團的人拿去提升戰力用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060204
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060204,
					"content": "真的嗎？太好了，說不定我們買到好東西了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060205,
					"content": "#想知道這東西是不是有用，我可以幫{F#妳}{M#你}測試一下{F#妳}{M#你}戰鬥時的狀態。不過如果{F#妳}{M#你}本身實力已經很強，恐怕就很難有較大提升。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060206
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060206,
					"content": "#不如就來一場對照組實驗吧，使用這枚罐裝知識的前後，{F#妳}{M#你}分別進行兩次戰鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060207
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060207,
					"content": "#…我會透過虛空終端來測定{F#妳}{M#你}戰鬥中的各種身體狀態指標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060208
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060208,
					"content": "關於前後兩次測試的體力差距因素，以及對手個體的強弱差距因素等等，我會透過後製計算來消除誤差影響，請放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060209
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060209,
					"content": "哇…艾爾海森，你應該是教令院裡成績特別好的那種人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060210,
					"content": "我有點好奇，你肯定不是那些需要罐裝知識幫助才能畢業的學生，為什麼會冒著被風紀官盯上的危險接觸它呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060211,
					"content": "我也有點好奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060212
					]
				},
				{
					"id": 30060212,
					"content": "#當{F#妳}{M#你}無法理解一名學者的行動的時候，絕大多數情況都可以用「好奇心」來解釋，這是一條定理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060213
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060213,
					"content": "唔…總感覺你好像在敷衍我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060214,
					"content": "#好了，開始測試吧，{F#妳}{M#你}只要正常戰鬥就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				}
			]
		},
