				"objectNames": [
					"塔里克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060701,
					"content": "艾爾海森…沒想到你這瘋子還真敢來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060702
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060702,
					"content": "對話是我要求的，我還擔心你們不會守約，但看來你們還是很講信用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060703
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060703,
					"content": "場面滿隆重的，我也帶了幫手，沒關係吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060704
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060704,
					"content": "#幫手？這不是餐廳裡那{M#小子}{F#丫頭}嗎，因為這瘋子幫了{F#妳}{M#你}的忙，所以來報答他？哼，膽子倒是不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060705
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060705,
					"content": "我也不說什麼客氣的話了，你們就等著到水裡去餵魚吧。兄弟們，上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060706
					],
					"speakerTitle": "塔里克"
				},
				{
					"id": 30060706,
					"content": "他們衝過來了，你們兩個小心一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300608,
			"completionStepIds": [
				300612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300612",
							"2"
						],
						"stepId": 300612,
						"stateName": "QUEST_STATE_UNFINISHED"
