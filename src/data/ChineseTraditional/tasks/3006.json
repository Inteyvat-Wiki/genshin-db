			"trigger": {
				"objectNames": [
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060601,
					"content": "艾爾海森，我們把消息弄到手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060602,
					"content": "是嗎，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060603,
						30060604
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060603,
					"content": "是阿赫瑪爾之眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				},
				{
					"id": 30060605,
					"content": "多莉還給了我們交易的證據，你看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060606,
					"content": "呵，拍得真清楚。不僅敢潛伏進鍍金旅團的交易現場，還敢藏得這麼近，膽子也是真夠大的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060607
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060607,
					"content": "沒錯，上面的人就是阿赫瑪爾之眼的團長密茲里，他手裡這枚與眾不同的紅色罐裝知識，看來就是「神明罐裝知識」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060608
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060608,
					"content": "這樣一來下週和他們的「武力對話」，也就有機會逼迫它「亮相」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060609
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060609,
					"content": "當初還無法理解艾爾海森為什麼要挑釁阿赫瑪爾之眼的傢伙們，現在看起來，完全是讓你得逞了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060610,
					"content": "等我們打敗他們，就能跟他們老大好好聊一聊，讓他把神明罐裝知識借給我們看看了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060611,
					"content": "#辛苦{F#妳}{M#你}們了。這幾天{F#妳}{M#你}們就休息一下吧，我也去做些準備。跟他們見面那天下午三點，我們先在這裡會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060612
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060612,
					"content": "好，一言為定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060613
					]
				},
				{
					"id": 30060613,
					"content": "我先走一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060614
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060614,
					"content": "幾天後，與阿赫瑪爾之眼約定見面當天…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060615
					]
				},
				{
					"id": 30060615,
					"content": "艾爾海森好慢啊，還沒有來嗎…啊，他來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060616,
					"content": "久等了，我們到法邏斯燈塔前面的棧橋去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060617
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060617,
					"content": "嗯，我們走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060604,
					"content": "是我們即將見面的對手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				}
			]
		},
		{
			"id": 300607,
