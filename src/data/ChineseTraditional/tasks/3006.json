			},
			"dialogs": [
				{
					"id": 30060301,
					"content": "#好，我來連接{F#妳}{M#你}的虛空終端，記錄數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060302
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060302,
					"content": "接下來就是使用這枚罐裝知識了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060303
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060303,
					"content": "#把它拿在手上，我來幫{F#妳}{M#你}與它建立連接，之後{F#妳}{M#你}就能啟動它的力量。",
					"roleType": "TALK_ROLE_NPC",
