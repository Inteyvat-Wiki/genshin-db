			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060801,
					"content": "剛剛到底發生什麼事了？那個大塊頭突然就變成了那個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060802,
					"content": "看來，他是使用過神明罐裝知識了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060803
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060803,
					"content": "他會變成那樣，是因為神明罐裝知識的影響嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060804,
					"content": "說起來，之前海芭夏說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060805
					]
				},
				{
					"id": 30060805,
					"content": "#{F#妳}{M#你}是指學者們在獲得世界樹知識的時候，會因為接觸到神明的知識而發瘋這件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060806,
					"content": "據我所知，「林居狂語期」學者們瘋掉的情況的確不少。從那傢伙的樣子看，也像是類似的狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060807
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060807,
					"content": "看來這個神明罐裝知識的確與神明有關，但又應該不像傳聞中的那樣，擁有它就擁有了神明的智慧或者力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060808
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060808,
					"content": "#{F#妳}{M#你}聽到那個傢伙嘴裡說的話了嗎？「世界…遺忘我」，這究竟是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060809
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060809,
					"content": "（他嘴裡說的那句話，和之前在世界樹那裡聽到的一模一樣…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060810
					]
				},
				{
					"id": 30060810,
					"content": "那個人被風紀官帶走了的話，手上的神明罐裝知識也會被教令院拿回去了吧？好可惜，就這麼和目標失之交臂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060811,
					"content": "不過，沒想到神明罐裝知識這麼危險，如果我們貿然嘗試了它，說不定我們也會變成那種樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060812,
					"content": "事已至此，我也沒有在奧摩斯港繼續停留的意義了，我們的合作也告一段落吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060813
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060813,
					"content": "說起來，之前光顧著找神明罐裝知識，還沒問過你，既然你是教令院的人，那你知不知道見小吉祥草王的辦法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060814,
					"content": "說實話，我也不知道。小吉祥草王似乎游離於須彌的治理體系之外，平時甚至完全感受不到她的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060815
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060815,
					"content": "而且教令院有象徵神明智慧的虛空在，學者們也沒有想要與神明本身接觸的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060816
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060816,
					"content": "唉，可真是神秘啊，小吉祥草王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060817,
					"content": "#之後我會回教令院去，{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060818
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060818,
					"content": "看看時間，也快到花神誕日了，要不我們也回須彌城去吧。這幾天一直都在奔波，說不定稍微休息一下也能打起精神來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060819,
						30060820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060819,
					"content": "妳說得有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				},
				{
					"id": 30060821,
					"content": "艾爾海森，那我們就在這裡告別吧。再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060822,
					"content": "嗯…接下來，是先處理這個東西，還是先寫大人物們要的報告書呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30060820,
					"content": "我們回須彌城吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				}
			]
		},
