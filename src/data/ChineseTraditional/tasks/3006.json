			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"多莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060501,
					"content": "#喔，這裡這裡！兩位客人，{F#妳}{M#你}們這麼快就又來了呀。這次有什麼需要呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060502
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060502,
					"content": "#無論是罐裝知識還是其他東西，只要{F#妳}{M#你}們開口，嘩啦嘩啦的摩拉送到，我保證都能幫{F#妳}{M#你}們弄到手喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060503
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060503,
					"content": "多莉，無論我們有什麼想要的東西都行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060504,
					"content": "哎呀哎呀，兩位客人既然這麼說，那看來罐裝知識這種貨已經滿足不了兩位了吧？請說說看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060505
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060505,
					"content": "我想買「神明罐裝知識」的下落。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060506
					]
				},
				{
					"id": 30060506,
					"content": "喔…呵呵呵呵。我就說嘛，出手這麼大方的客人，目標肯定不會是幾枚普通的罐裝知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060507
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060507,
					"content": "不過這個情報，價錢可不便宜喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060508
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060508,
					"content": "畢竟我可是好不容易才躲進了交易現場，而且，一旦被人知道消息是我走漏的，我還可能會被人找麻煩喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060509
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060509,
					"content": "可是我們怎麼知道妳的情報是真的呢？或者說，妳怎麼會「剛好」有這樣的情報在手上呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060510,
					"content": "呵呵呵…因為對我來說，市面上在流通的一切值錢的東西，都是我的「貨源」喔，時刻關注那些寶貝的動向，才有更多生意可做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060511
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060511,
					"content": "而關於情報的真假，就更不用擔心了，我用留影機拍下了交易瞬間的畫片，無論誰看了都賴不了帳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060512,
						30060513
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060512,
					"content": "開個價吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				},
				{
					"id": 30060514,
					"content": "不愧是客人，交易愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060515
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060515,
					"content": "既然客人們已經付清錢款，那麼消息就請聽好：神明罐裝知識，昨天已經被阿赫瑪爾之眼的首領密茲里先生拿下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060516
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060516,
					"content": "阿赫瑪爾之眼？就是那個信奉赤王的鍍金旅團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060517,
					"content": "喔，看來客人們也很熟悉他們嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060518
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060518,
					"content": "阿赫瑪爾之眼為了這枚神明罐裝知識可是拼了全力呢，畢竟他們相信，它裡面寄宿的是赤王的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060519
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060519,
					"content": "不愧是神明罐裝知識，和之前見到的都不一樣，它可是散發著耀眼的紅色光芒喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060520,
					"content": "在我拍攝的畫片上，也能清楚地看到這枚神明罐裝知識喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060521,
					"content": "謝謝妳的情報，多莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30060522,
					"content": "#不客氣不客氣，有{F#妳}{M#你}們這樣識貨的客人，我昨天的勞動也沒有白費呀。今後有什麼需要儘管找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 30060513,
					"content": "這份情報我買了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				}
			]
		},
