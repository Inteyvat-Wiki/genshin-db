						760240805,
						760240808
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240802,
					"content": "關於海螺幫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "#{F#妳}{M#你}也想要加入嗎？那就去找尤爾瓦哥哥吧，他在「斯佩蘭扎」。唔，如果要投票的話，赫卡不在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240804,
					"content": "不過沒關係，尤爾瓦哥哥肯定有別的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240805,
					"content": "關於嗅嗅鼴鼠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "我猜是因為牠們一直和人生活在一起，所以有些行為也像人一樣了。盜寶鼬也是這樣，聽說納塔的龍也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240807,
					"content": "不過，這到底是好事還是壞事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240808,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "路上要小心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧妮"
				}
