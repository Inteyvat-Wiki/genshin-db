			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧妮"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1648.494,
							213.477,
							9656.33
						],
						"pointId": 11564
					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}比那些大個子更厲害啊，原來不是體型越大越厲害喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240202,
					"content": "#哼哼，對吧？{NICKNAME}雖然身材不高大，但是就算對付大到超過自己幾倍的魔物也沒什麼問題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240203,
					"content": "沒有沒有，跟派蒙比還是略遜一籌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "#欸？就、就算{F#妳}{M#你}這樣誇我…好吧，下次有什麼好吃的，分給{F#妳}{M#你}的那一半一定多給一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240206,
					"content": "#那{NICKNAME}{M#哥哥}{F#姐姐}肯定可以把盜寶鼬大哥也趕出莫雷谷吧？這裡又不是牠們的家，結果被牠們搞得亂七八糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240207,
					"content": "原本要辦的葬禮也辦不了，莫雷爺爺搞不好也被牠們害死啦，不過就算要舉辦新的葬禮，也必須先找到他們一家才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240208,
					"content": "欸？！盜寶鼬居然…不過妳說的葬禮，之前來不及問，不、不會真的有人要在這裡舉辦葬禮吧？為什麼會選在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240209,
					"content": "#這是當然要的吧，我都準備好了，葬禮時要唱的歌也想好了。欸，給{F#妳}{M#你}們看看，不過要小聲一點，讓牠安靜休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240210,
					"content": "奧妮從口袋裡掏出一個小小的火柴盒，打開之後，一隻顏色漂亮的小小甲蟲躺在一塊小小的花色襯布上，周圍還裝飾了一些白色的花瓣…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "因為牠已經永遠安息了，所以要幫牠舉辦葬禮。不過我選好的地方都被盜寶鼬占據了，就是那些有機器的小山丘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240212,
					"content": "莫雷爺爺一家人如果不是逃走了，就是死掉了吧。他們的家就這樣被盜寶鼬破壞啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240213,
					"content": "#（{NICKNAME}，{F#妳}{M#你}覺得奧妮嘴上說的莫雷爺爺，該不會是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240214,
					"content": "（應該是什麼小動物吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "（嗯，我也覺得可能是她的動物朋友呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240218,
					"content": "嗯，如果是這樣，不然我們來幫奧妮抓到做壞事的盜寶鼬吧！至於莫雷爺爺一家…等到抓到盜寶鼬之後，我們再一起找找看好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240219,
					"content": "#哇，{NICKNAME}{M#哥哥}{F#姐姐}、派蒙妹妹，{F#妳}{M#你}們人也太好了！我會邀請{F#妳}{M#你}們來參加葬禮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240220,
					"content": "倒、倒也不用這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240221,
					"content": "好吧。那麼，就之前買的糖雕…咦，原來已經沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240222,
					"content": "#不過尤爾瓦哥哥給我的零用錢還有。唔，那就給{F#妳}{M#你}們零用錢，{F#妳}{M#你}們自己去買糖雕吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240223,
					"content": "拜託別人幫忙，要支付酬勞，還要說謝謝，這樣做才是對的。嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240224,
					"content": "派蒙居然要從小孩那裡搶走糖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "搞得我好像是什麼大壞蛋似的！不過奧妮年紀這麼小，卻很有禮貌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240227,
					"content": "#謝謝{F#妳}{M#你}稱讚我，但是一個人只能有一個糖雕的摩拉，稱讚我也不會再更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240228,
					"content": "說到這個就這麼現實…對了，依照妳剛才說的，做壞事的盜寶鼬應該不只一隻吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240229,
					"content": "嗯。剛才逃跑的那隻不是我之前看過的盜寶鼬大哥，我也不知道牠有多少小弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240230,
					"content": "但是那邊也有和這邊一樣的會發射子彈的機器爪子，搞不好能在那邊找到盜寶鼬小弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "奧妮"
				},
				{
					"id": 760240231,
					"content": "#好哦，這次肯定不能再讓盜寶鼬逃走了！{NICKNAME}，我們去教訓一下那些壞盜寶鼬吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240226,
					"content": "奧妮好有禮貌哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "（可能是原來住在這裡的人吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "#（欸？這裡看起來不像有人長期居住的樣子…我覺得搞不好是奧妮的動物朋友！{F#妳}{M#你}看，她還會幫甲蟲舉辦葬禮呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240205,
					"content": "對上小型的魔物也不會手下留情！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
