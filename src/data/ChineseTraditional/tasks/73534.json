			"dialogs": [
				{
					"id": 735340501,
					"content": "初次見面，我是稻妻的妖怪小說家樋口鐵矢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "樋口鐵矢"
				},
				{
					"id": 735340502,
					"content": "最近的趕稿壓力比較大，不論是什麼辦法，只要能調整好狀態，我都願意嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "樋口鐵矢"
				},
				{
					"id": 735340503,
					"content": "畢竟是根據我的問題創造的夢境，可能帶有我的個人風格。如果待會您在夢裡見到什麼奇怪的東西，我提前道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樋口鐵矢"
				}
			]
		},
