					"nextDialogs": [
						735340702
					],
					"speakerTitle": "涅提"
				},
				{
					"id": 735340702,
					"content": "叫我涅提就好，我是素論派的遊學者，目前長期在楓丹工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "涅提"
				},
				{
					"id": 735340703,
					"content": "#人上了年紀就是容易碰到各種問題，年輕人，稍後就靠{F#妳}{M#你}在夢裡幫我看看問題的源頭了。",
