			"dialogs": [
				{
					"id": 735340101,
					"content": "#{F#妳}{M#你}好{F#妳}{M#你}好，要幫我做夢境療法的就是{F#妳}{M#你}嗎？說實話，我也不知道會夢到些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "柯林伍德"
				},
				{
					"id": 735340102,
					"content": "我是蒙德人，平常沒什麼愛好，就只有喝點酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "柯林伍德"
				},
				{
					"id": 735340103,
					"content": "#有的時候喝太多了，容易誤事，這次就靠{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯林伍德"
				}
			]
		},
