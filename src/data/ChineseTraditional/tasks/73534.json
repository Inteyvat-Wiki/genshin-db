			"dialogs": [
				{
					"id": 735340301,
					"content": "幸會，我們馬上就得一同入夢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "幼光"
				},
				{
					"id": 735340302,
					"content": "我是來自璃月的鏢師幼光，這次是因為走鏢撞見了一點不乾淨的東西，最近就完全沒有好好睡過覺，所以來託您幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "幼光"
				},
				{
					"id": 735340303,
					"content": "要是可以藉由夢境療法消滅我的噩夢就太好了，感激不盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "幼光"
				}
			]
		},
