			"dialogs": [
				{
					"id": 710120101,
					"content": "「風帶來了新的故事，時間使之成為神話。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "殘破的刻字"
				},
				{
					"id": 710120102,
					"content": "這句話是什麼意思啊…完全沒有頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120103,
					"content": "唔，不過，這個地方看起來似乎有什麼秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710120104,
					"content": "我們去周圍看看吧，說不定會有什麼線索呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
