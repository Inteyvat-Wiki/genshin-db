					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414211003,
					"content": "透過和純水小動物結合，詞彙量增加了。明白了清泉鎮的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414211004,
					"content": "「生命的溪水潺潺向前」，有一點點悲傷。是看不懂的小詩。不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414211005,
					"content": "或許以後就會明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "嫣朵拉我還需要學習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414211007,
					"content": "洛蒂婭最近很狂躁。如果能直接面對它，或許就可以解決問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嫣朵拉"
				}
			]
