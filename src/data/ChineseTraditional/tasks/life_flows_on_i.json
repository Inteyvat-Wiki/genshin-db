			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "#旅行者，{F#妳}{M#你}好啊。別來無恙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 414210102,
					"content": "又發生了什麼奇怪的事情了嗎，凱瑟琳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210103,
					"content": "和之前那些大事件相比，這件事有些不足為奇。不過因為它事關蒙德的經濟，還是滿棘手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 414210104,
					"content": "是什麼事情呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "最近，酒莊附近的水源毫無預兆地變苦了。這樣下去，未來幾年的釀酒業會面臨重大危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 414210107,
					"content": "#詳情就請{F#妳}{M#你}和酒莊的康納談一談吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 414210105,
					"content": "蒙德的經濟？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"康納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "#協會派來協助的人員就是{F#妳}{M#你}們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210202,
					"content": "是我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210203,
					"content": "#那我就放心了。這件事，與其由我描述，不如請{F#妳}{M#你}們自己體驗一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210204,
					"content": "#這瓶水是就近取用的。它已經經過了所有的淨水程序，絕對衛生。{F#妳}{M#你}可以放心嚐嚐看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210205,
					"content": "我也要我也要！我也想試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210206,
					"content": "（嚐一口…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "嗚啊，呸呸呸。這股苦味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210208,
					"content": "這股苦味用傳統的淨水作法根本去不掉，不是成分的問題。應該又是神奇元素力引發的現象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210209,
					"content": "這樣的水根本無法釀酒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210210,
					"content": "那附近的魚最近生活也很艱難吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210211,
					"content": "我們試過了，那些被苦得翻肚的魚，就算做成菜都是苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "康納"
				},
				{
					"id": 414210212,
					"content": "…我都沒想這麼遠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210213,
					"content": "#總之，事情就是這樣。如果{F#妳}{M#你}問我有沒有什麼頭緒的話，我直覺認為應該向北去調查。不知璃月碧水河和輕策莊的水現在味道如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "康納"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142105",
							"2"
						],
						"stepId": 4142105,
