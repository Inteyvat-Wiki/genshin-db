			},
			"dialogs": [
				{
					"id": 414210801,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210802,
					"content": "她說了一些奇怪的話，不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210803,
					"content": "饞…纏…什麼的，不懂。問了也不回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210804,
					"content": "認識的字數和詞彙量不足啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "也許是有不能和大家見面的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210806,
					"content": "不明白。純水精靈，我們，喜歡融合在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210807,
					"content": "她，一個意識，孤獨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210808,
					"content": "我想大概是因為其他生物無法和你們融合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210809,
					"content": "欸，沒辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210810,
					"content": "會在你們的身體裡淹死的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210811,
					"content": "你們真孤獨。我們，所有人，愛所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210812,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210813,
					"content": "突然怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210814,
					"content": "石門附近，洛蒂婭的眼線！水的小動物。是，偵察兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210815,
					"content": "這麼一說，似乎有在附近看到純水小動物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210816,
					"content": "好像是見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "強大的水，幻化，小動物。很危險。但是，和它們融合，可以學到東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210819,
					"content": "帶我去。那邊那邊。洛蒂婭很不安。洛蒂婭把水變苦了。嫣朵拉學習說話，和洛蒂婭說清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210820,
					"content": "妳是說妳能幫助我們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}，我覺得還是值得一試的，畢竟我們目前也沒有別的線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210817,
					"content": "是嗎，沒注意到欸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
