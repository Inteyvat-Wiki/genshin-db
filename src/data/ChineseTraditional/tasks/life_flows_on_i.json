					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "唔啊，居然掉下來了一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210502,
					"content": "嫣朵拉，沒有水，快死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210503,
					"content": "嫣朵拉，是妳的名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210504,
					"content": "苦味，是敵意。會殺掉嫣朵拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210505,
					"content": "雖然不知道怎麼辦。要怎麼樣才能拯救妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210506,
					"content": "要去，有甜甜水的地方。要去，清泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210507,
					"content": "嫣朵拉，寄宿水團子，代步。沒水。嫣朵拉，無處棲身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210508,
					"content": "我們要怎麼把它帶去有清泉的地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210509,
					"content": "這裡倒是有一瓶水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "可是這瓶水也是苦的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210511,
					"content": "嫣朵拉，可以忍耐。但是，不能很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210512,
					"content": "哦哦，那事不宜遲。趕緊出發前往有清泉的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210513,
					"content": "不過這個傢伙靠著水史萊姆旅行了這麼遠，和我們的關係很像呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142106",
							"2"
						],
						"stepId": 4142106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "這裡，水是甜的。嫣朵拉發現了，是同類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210602,
					"content": "嫣朵拉，同類，把水變好喝。也變苦，是洛蒂婭幹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210603,
					"content": "這麼說來，清泉鎮似乎有泉水精靈的傳說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210604,
					"content": "不過我們還是快點先去泉水邊，把瓶子裡的苦味水換掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老芬奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "…妳是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210702,
					"content": "哇啊啊，嫣朵拉妳怎麼自己跑出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210703,
					"content": "我是嫣朵拉。純水的精靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210704,
					"content": "這位老爺爺似乎就是深信清泉精靈存在的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210705,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210706,
					"content": "妳和她簡直一模一樣。不過妳要小多了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210707,
					"content": "嫣朵拉，還小！嫣朵拉，在學習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210708,
					"content": "不過，妳出現在我的面前，至少證明了那場相識不是我的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210709,
					"content": "她還在。名字，不知道。不知道，也不回答嫣朵拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210710,
					"content": "嫣朵拉，要聯繫她。嫣朵拉，能帶話。你要說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210711,
					"content": "妳是說，她一直都在嗎？你可以幫我帶話給她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210712,
					"content": "是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210713,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210714,
					"content": "我已經很老了。我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210715,
					"content": "幫我向她問好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老芬奇"
				}
			]
		},
		{
