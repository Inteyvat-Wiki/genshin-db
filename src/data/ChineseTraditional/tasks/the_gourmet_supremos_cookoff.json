	"talks": [
		{
			"id": 2202101,
			"completionStepIds": [
				2202101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202101",
							"2"
						],
						"stepId": 2202101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"龜井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "我這道菜可是很厲害的，你可要做好準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210102,
					"content": "在下的這道菜同樣很不錯，請閣下也做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210103,
					"content": "你們在幹什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#是{F#妳}{M#你}啊，旅行者。是這樣的，芭爾瓦涅和朱莉出去蒐集食材了，我們本來打算幫她們準備飯菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210105,
					"content": "但我和宗久大叔對於準備什麼菜，有一點點分歧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210106,
					"content": "所以，我和宗久大叔就打算各自出一道菜切磋一下廚藝，順便以此決定今天的菜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210107,
					"content": "我打算做一道璃月特色菜「珍珠翡翠白玉湯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210108,
					"content": "在下則準備用拿手的「串串三味」來應戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210109,
					"content": "需要我幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "#唔，如果{F#妳}{M#你}有空的話，我們確實需要一個負責評判味道高低的裁判…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210113,
					"content": "但我倆各自都只有一個人，而且每道菜要準備四個人的份，說不定會有點忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210114,
					"content": "#在評判味道之前，還是請{F#妳}{M#你}先幫我們準備那道菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210115,
					"content": "#當然，{F#妳}{M#你}也只有一個人，所以{F#妳}{M#你}就挑一道自己感興趣的菜幫忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210116,
					"content": "旭東，你忙得過來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "#{F#妳}{M#你}也不用擔心我，我好歹之前在璃月也是個開餐館的，只是準備準備飯菜而已，難不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210118,
					"content": "只不過，如果有人幫忙的話，飯菜能做得更精細一些就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210122,
					"content": "#總之，{F#妳}{M#你}就挑一道感興趣的菜幫忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210123,
					"content": "旭東，我來幫你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "噢！那太好了，宗久大叔，你可要準備好，可別被我的菜一口氣打倒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210125,
					"content": "在下可不會輕易認輸的，閣下儘管放手施為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210126,
					"content": "宗久大叔，我來幫你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "多謝閣下。旭東閣下，你可要小心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210128,
					"content": "沒問題，你就儘管放馬過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210119,
					"content": "宗久大叔，你忙得過來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "閣下憑自己喜好挑選即可，在下還在幕府之時，也經常一人準備好幾個人的下酒菜，現在只是四人份而已，不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210121,
					"content": "但如果閣下願施以援手，那在下的飯菜一定能做出更好的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210111,
					"content": "你們一定缺一個裁判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "哈哈哈，可不是，我們正需要一個負責評判味道高低的裁判呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"龜井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "這樣就做好了，多謝啦旅行者。這香味，聞著就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210202,
					"content": "我先來嚐嚐…呵，不錯，食材燉煮的程度剛好，香氣也很足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210203,
					"content": "可以說是一道「完美的珍珠翡翠白玉湯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210204,
					"content": "好了，宗久大叔，你的菜做得怎麼樣了？你也拿出來讓旅行者品鑑一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210205,
					"content": "唔，在下失誤了。在開始做菜的時候，才發現沒有備足鳥蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210206,
					"content": "雖然在下馬上從旁邊的樹林裡取了些鳥蛋，但其餘的食材卻都過了最佳的處理期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210207,
					"content": "以這種新鮮度欠佳的食材製作的「串串三味」，已經不能稱得上是一道好菜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210208,
					"content": "居然會如此疏忽，在下真是慚愧。在廚藝一道上，我還需要再多加訓練才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210209,
					"content": "這次的比試，是在下輸了。但下次，在下一定會贏過你的，旭東閣下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210210,
					"content": "要加油啊，大叔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "嘿嘿，不過我也不是那麼好戰勝的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210212,
					"content": "#對了旅行者，這些東西給{F#妳}{M#你}，收下吧。謝謝{F#妳}{M#你}陪我和大叔忙到現在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210213,
					"content": "#下次我們對決的時候，{F#妳}{M#你}可一定也要過來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210214,
					"content": "其實我感覺味道還好啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "不，就算是做菜，也要懷著追求極致之心，不斷追求廚藝的「極意」，絕不能滿意於「差不多」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210216,
					"content": "這樣，才能不斷攀上廚藝之道上的一個個高點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "龜井宗久"
				},
				{
					"id": 220210217,
