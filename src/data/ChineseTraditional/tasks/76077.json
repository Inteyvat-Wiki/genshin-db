				]
			},
			"dialogs": [
				{
					"id": 760770101,
					"content": "這就是您要找的那本書，奈芙爾老闆，請您看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770102
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 760770102,
					"content": "讓我看看…哈，真是夠巧的，這本書裡記錄的故事剛好是那篇《變成騾子的人》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770103
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770103,
					"content": "奈芙爾？她也來處理委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770104
					]
				},
				{
					"id": 760770104,
					"content": "怎麼想奈芙爾都不像是處理委託的人，她應該是那種向人發委託的人啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770105,
						760770106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770105,
					"content": "喔…的確是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770107
					]
				},
				{
					"id": 760770107,
					"content": "#我說{F#妳}{M#你}啊，就別搶雅珂達的工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770108,
					"content": "不過，奈芙爾到底是要向冒險家協會發什麼委託呢？有點好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770109,
						760770110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770109,
					"content": "等下再去問問看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770111
					]
				},
				{
					"id": 760770111,
					"content": "不錯，的確是我要找的故事書。不愧是冒險家協會，果然手眼通天，連這篇遺失已久的故事都能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770112,
					"content": "哈哈哈，這也是多虧了諸位冒險家們的努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770113
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 760770113,
					"content": "雖然尋找的途中有許多波折，但最終，我們還是在至冬的某位收藏家手裡找到了這篇故事的抄本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770114
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 760770114,
					"content": "沙漠的故事，居然會流傳到至冬去，真是有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770115
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770115,
					"content": "多謝了，我會按照之前的約定，為這本書支付相應的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770116
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770116,
					"content": "另外，麻煩薩林先生繼續維持這份委託的發布狀態，優先順序也調高一些。相應的費用，我會一併支付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770117
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770117,
					"content": "沒問題。能和奈芙爾老闆做生意，是我們冒險家協會的榮幸。我這就去協會協調相關事宜，先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770118
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 760770118,
					"content": "#{NICKNAME}、派蒙。我的事情已經談好了，{F#妳}{M#你}們可以來滿足自己的好奇心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770119,
						760770120
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770119,
					"content": "妳早就發現我們了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770121
					]
				},
				{
					"id": 760770121,
					"content": "連我說的話也聽見了？該說不愧是奈芙爾嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770122,
					"content": "所以，妳是在刊登委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770123
					]
				},
				{
					"id": 760770123,
					"content": "差不多。但嚴格來說，這應該是我和冒險家協會的一項長期合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770124
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770124,
					"content": "走吧，去「秘聞館」裡一起喝杯茶，這裡可不是一個適合聽故事的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770120,
					"content": "你的眼睛真好啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770121
					]
				},
				{
					"id": 760770110,
					"content": "現在不太好打擾奈芙爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770111
					]
				},
				{
					"id": 760770106,
					"content": "那下次請她發點輕鬆的委託給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770107
					]
				}
			]
		},
		{
			"id": 7607702,
