				]
			},
			"dialogs": [
				{
					"id": 760770201,
					"content": "…哎呀，雅珂達看樣子還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770202
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770202,
					"content": "#{F#妳}{M#你}們在這稍等，我去泡茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770203
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770203,
					"content": "喵——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770204
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 760770204,
					"content": "阿舍魯，摸摸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770205
					]
				},
				{
					"id": 760770205,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770206
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 760770206,
					"content": "嘿嘿，阿舍魯乖乖喔，來，握手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770207,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770208
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 760770208,
					"content": "來吧，茶泡好了。牛奶和糖在那邊，需要的話自己去加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770209
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770209,
					"content": "#看來阿舍魯很親近{F#妳}{M#你}們。想當初，我剛把阿舍魯帶回來的時候，牠就像獅子一樣凶狠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770210
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770210,
					"content": "除了我之外，幾乎沒有人能碰牠。那些擅自靠近牠的人，基本上都被牠用爪子和牙齒趕走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770211
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770211,
					"content": "阿舍魯原來這麼凶嗎？看不出來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770212,
					"content": "喵，喵喵？喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770213
					],
					"speakerTitle": "阿舍魯"
				},
				{
					"id": 760770213,
					"content": "那是很久之前的事了，那時候我和牠剛剛到挪德卡萊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770214
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770214,
					"content": "我們無依無靠，想要在彼時的挪德卡萊拼殺出一片容身之所，就不得不露出爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770215
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770215,
					"content": "…現在，已經沒那個必要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770216
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770216,
					"content": "#好了，現在是滿足{F#妳}{M#你}們好奇心的時間。我猜，{F#妳}{M#你}們應該是對我和冒險家協會的那項「長期合作」有興趣，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770217,
						760770218
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770217,
					"content": "奈芙爾居然會去委託冒險家協會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770219
					]
				},
				{
					"id": 760770219,
					"content": "難道是連奈芙爾也沒辦法一個人找到並且帶走的寶貝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770220,
					"content": "重要的確是很重要。但是不是寶貝，那就要看個人的判斷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770221
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770221,
					"content": "喏，我要冒險家協會幫我找的就是這本書，看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770222
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770222,
					"content": "讀起來是一篇很有須彌風格的童話呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770223,
						760770224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770223,
					"content": "難道是寶藏的線索？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770225
					]
				},
				{
					"id": 760770225,
					"content": "#啊？又要解謎尋寶了？{NICKNAME}{F#妳}{M#你}加油喔！我、我有點看不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770226,
					"content": "放心吧，這只是一篇流傳在須彌沙漠人中的普通故事。既沒有暗指藏寶地，也沒有隱藏密語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770227
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770227,
					"content": "我之所以費力尋找，只因為它和我的父親有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770228
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770228,
					"content": "妳的父親…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770229
					]
				},
				{
					"id": 760770229,
					"content": "#沒錯。我之前應該為{F#妳}{M#你}「引見」過他了。{F#妳}{M#你}們應該還記得他和我的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770230
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770230,
					"content": "在帶回那一桶裹挾著災禍的「戰利品」，讓村子被黃沙吞沒之前…他經常給我講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770231
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770231,
					"content": "#當然了，{F#妳}{M#你}們也知道當時須彌的情況，那些溫情脈脈又富有智慧的故事，只有雨林裡的幸運兒才有特權聆聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770232
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770232,
					"content": "而對於那些被防沙壁隔絕在外的沙漠人來說，智慧和溫情是奢侈品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770233
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770233,
					"content": "由他們口耳相傳的故事，唯一且最重要的作用，就是教會孩子們如何活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770234
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770234,
					"content": "比如，浪費糧食的人會變成蠍子、不珍愛水源的人會失去舌頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770235
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770235,
					"content": "再比如，善良是美德，但輕信別人只會招致災禍；欺騙是可行的，但前提是別被發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770236
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770236,
					"content": "不過，我父親似乎並不想讓我被這些故事「感化」成「典型的沙漠人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770237
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770237,
					"content": "在蒐集到故事之後，他會自己進行改編，把故事變得…更溫情一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770238
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770238,
					"content": "在他說的那些故事裡，騙子變成了騾子、殺人者跌下了懸崖、挑食的孩子最多只是牙痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770239
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770239,
					"content": "能夠稍微理解一點他的想法，畢竟誰都想讓自己的孩子好好長大啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770240,
					"content": "奈芙爾喜歡那些故事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770241
					]
				},
				{
					"id": 760770241,
					"content": "我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770242
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770242,
					"content": "當時的我喜歡得不得了。每天都期待著夜晚到來，父親用故事哄我入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770243
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770243,
					"content": "到了白天，我就會拿著父親的故事書出去，把故事再講給其他孩子聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770244
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770244,
					"content": "他們很羨慕我。無論我到哪，身後都跟著一堆小孩，只要能聽故事，我要他們做什麼就做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770245
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770245,
					"content": "直到一切都迎來終結，我的父親，朋友和部族，還有那些故事，都被掩蓋在了黃沙之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770246
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770246,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770247
					]
				},
				{
					"id": 760770247,
					"content": "之後，我去了教令院。在那裡，我才發現了一部分故事的「原版」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770248
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770248,
					"content": "騙子們從未被懲罰，因為蠢人就活該被騙；殺人者總是得勝後揚長而去，因為只有他的手裡有刀劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770249
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770249,
					"content": "至於挑食的孩子…則和那些浪費水的孩子一樣，被變成了蜥蜴，永世蜷縮在岩石底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770250
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770250,
					"content": "直到那個時候，我才知道父親一直在「欺騙」我，他用自己的筆，為我編織出了一個虛假的溫情世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770251
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770251,
					"content": "但我的父親離開了，那個虛假的世界也宣告毀滅，我不得不面對那些真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770252
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770252,
					"content": "幸運的是，我學得很好，很快就成了一個他努力不讓我成為的「沙漠人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770253
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770253,
					"content": "#之後，就是謊言、欺騙、復仇和毀滅，這些都是在沙漠中重複了一萬遍的主題，{F#妳}{M#你}們應該很熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770254,
						760770255
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770254,
					"content": "那妳蒐集這些故事的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770256
					]
				},
				{
					"id": 760770256,
					"content": "算是吧。我只是想看看，他究竟對自己的女兒撒了多少謊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770257
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770257,
					"content": "作為世界上唯一一個被他如此欺騙的人，我想我有義務把他的騙術記錄下來。否則，他作為一個騙子也太過籍籍無名了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770258
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770258,
					"content": "再說了，哼…「䴉之王」圖特一定也對我的行動樂見其成吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770259
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770259,
					"content": "畢竟，是他要我去尋覓能夠「釐定真偽」之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770260
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770260,
					"content": "在我年幼時，我父親所編撰的那些故事，為我塑造了對於這個世界的認知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770261
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770261,
					"content": "而那些故事的真實結局…呵，也讓我更深地認識了這個真實的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770262
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770262,
					"content": "對我來說，這些故事確確實實地幫助過我「釐定真偽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770263
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770263,
					"content": "將它們蒐集起來，或許能幫助我尋找「䴉之王」所需要的那個答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770264
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770264,
					"content": "所以，在挪德卡萊扎下腳跟之後，我就開始用各種管道打聽起了父親曾經講述的那些故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770265
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770265,
					"content": "但這些故事大部分在沙漠人之中口耳相傳，幾乎沒有書面紀錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770266
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770266,
					"content": "我遠在挪德卡萊，自然不可能自己跑去沙漠裡到處尋訪遺民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770267
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770267,
					"content": "至於雅珂達…我這裡本來就缺人手，想想還是算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770268
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770268,
					"content": "所以，我就和坐擁無數冒險家的冒險家協會達成了長期合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770269
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770269,
					"content": "只要為我帶回沙漠人的故事，我就會付出相應的報酬，甚至…幫他們一點小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770270
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770270,
					"content": "薩林先生很願意接受我的條件，很快和我達成了共識。從結果上來說，我們合作得也很愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770271
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770271,
					"content": "那…關於妳剛剛蒐集到的這篇故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770272
					]
				},
				{
					"id": 760770272,
					"content": "啊，這一篇啊。這是我父親跟我講的最後一個故事，也是他唯一一篇沒有修改結局的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770274
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770274,
					"content": "說了一輩子謊的人，在唯一一次誠實地講述故事後，就被黃沙掩埋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770288
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770288,
					"content": "哈，這故事裡居然還寫著：「他是打從心底善良的，這是無上的智慧。」…真是夠諷刺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770275
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770275,
					"content": "#{F#妳}{M#你}們對這篇故事感興趣的話，我抄一份給{F#妳}{M#你}們就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770276
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770276,
					"content": "#順便一提，{NICKNAME}，{F#妳}{M#你}也是冒險家對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770277,
						760770278
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770277,
					"content": "呃…欸？對、對啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770279
					]
				},
				{
					"id": 760770279,
					"content": "#我知道{F#妳}{M#你}常年在世界各地旅行，見多識廣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770280
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770280,
					"content": "有意向的話，我們也可以簽署一個長期合作的…框架協議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770281
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770281,
					"content": "#如果{F#妳}{M#你}在旅途中取得了有關須彌沙漠人的故事，可以拿來給我，我會付給{F#妳}{M#你}一筆豐富的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770282
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770282,
					"content": "原、原來妳叫我們來，是為了最後這句話啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770283,
						760770284
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770283,
					"content": "奈芙爾果然是刊登委託的人啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770285
					]
				},
				{
					"id": 760770285,
					"content": "很好，那預祝我們合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770286
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770286,
					"content": "…不過，雅珂達為什麼還沒回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770287
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770287,
					"content": "她接的那項委託，有這麼困難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760770284,
					"content": "好吧，我果然是處理委託的命啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770285
					]
				},
				{
					"id": 760770278,
					"content": "怎麼突然提起這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770279
					]
				},
				{
					"id": 760770255,
					"content": "是為了看看原版故事究竟是怎樣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770256
					]
				},
				{
					"id": 760770224,
					"content": "裡面難道有什麼謎語？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770225
					]
				},
				{
					"id": 760770218,
					"content": "一定是要尋找很重要的東西吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770219
					]
				}
			]
		}
	]
}