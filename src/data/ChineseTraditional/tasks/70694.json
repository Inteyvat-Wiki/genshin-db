			"dialogs": [
				{
					"id": 706940101,
					"content": "邦邦小姐，腰還疼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940102,
					"content": "目前沒事了…熱敷當真見效快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940103,
					"content": "嘿嘿，用慢速火藥加熱濕繃帶的方法，可得把握好時間哦，不然就會把繃帶點燃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940104,
					"content": "這種加熱繃帶的方法，可能只有宵宮才能想到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940105,
					"content": "#等等…看看這是誰來了！名副其實的大英雄，和{M#他}{F#她}的白色夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940106,
					"content": "漫畫織卷裡的場景，要在我眼前上演了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940107,
					"content": "妳們這是在療傷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "不要緊！只不過是在野外轉轉，找了一些以前沒怎麼見過的強敵練習！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940110,
					"content": "宵宮小姐才是，我不小心扭到腰咕嚕嚕摔成雪球滾下來的時候，幫了我大忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940111,
					"content": "哇啊…光聽就痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940112,
					"content": "哈哈，按照《熾魂鬥士戰記》的說法，「我只是一個路過的戰士罷了」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940113,
					"content": "而且是自由的僱傭戰士！騎士團已經給我行動許可了，可以自行擊退魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940114,
					"content": "聽起來，還有魔物在徘徊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "好像不妙啊，要不要通知騎士團那邊再派一些人手來支援？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940117,
					"content": "的確不能怠慢，不過情況也不算緊急啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940118,
					"content": "騎士團的專業人士已經把「國際越野賽」場地周圍的魔物清理完了，剩下的都是一些遊蕩不定的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940119,
					"content": "說實話，參加越野賽的選手們中，也不乏武力不錯的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940120,
					"content": "他們有體魄、有膽識，要他們像普通人一樣處處小心魔物，人家反而覺得自己被看輕了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940121,
					"content": "所以，按照冒險家協會的辦事傳統，我們就地組成團隊，將處理這些魔物當成了一種試煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940122,
					"content": "正是——「鬥魂試煉」，在清剿魔物的基礎上，盡量模仿英雄們的戰鬥風格，實現對自我的超越！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "「邦邦滾石」"
				},
				{
					"id": 706940123,
					"content": "這個想法的確很符合「沃陸之邦」的作風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940124,
					"content": "那我要加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#好啊！很久沒看見{NICKNAME}露一手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940127,
					"content": "#非常期待，現在{F#妳}{M#你}的身手…漂亮得像是哪種煙花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940125,
					"content": "我也不能缺席！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "那需要謹慎，附近還有平民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "剛經歷過戰鬥嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}