			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "終於到<color=#00E1FFFF>璃月</color>了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010202,
					"content": "#冒昧問一下。{F#妳}{M#你}身邊飄著的這個小東西，多少錢可以賣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010203,
					"content": "多少錢也不賣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "多少錢也不賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010209,
					"content": "哈哈哈哈，最近手頭周轉不開，的確出不起價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010210,
					"content": "畢竟我只是個普通商人，也不販售奇珍異寶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010211,
					"content": "…聽語氣感覺很可疑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010212,
					"content": "別這麼說嘛。小傢伙，妳要吃糖嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}，我認為這個人可以信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010214,
					"content": "對了，你們來璃月，也應該是衝著「海燈節」來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010215,
					"content": "今年的「明霄燈」壯景可期啊。用來讓巨燈浮空的那塊「浮生石」，是二十年來最大的一塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010216,
					"content": "大到讓人不禁要想，神話中雲間的浮城要是真的存在的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010217,
					"content": "也只是下面裝了一塊差不多大的浮生石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博來"
				},
				{
					"id": 400010218,
					"content": "聽起來好厲害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010219,
					"content": "#哈哈哈哈，有緣再見吧。歡迎{F#妳}{M#你}們來璃月——這話代表不了<color=#00E1FFFF>璃月港</color>，但我的小店永遠歡迎{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				},
				{
					"id": 400010205,
					"content": "你出不起我心中的價位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "這話聽起來怪怪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010207,
					"content": "說實話還有點在意…究竟這個價位是多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010208,
					"content": "#算了，我就當{F#妳}{M#你}是在說「多少錢也不賣」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}，快看！那塊石頭浮在空中欸，而且連鎖鏈都拉直了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010302,
					"content": "如果沒有繩子拴住，不知道它會飛去哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010303,
					"content": "這就是用來製作「明霄燈」的浮生石。整個「霄市」就是圍繞著它佈設的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010304,
					"content": "啊，請問妳是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010305,
					"content": "我是江舟，最近負責明霄燈的建設進度統計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010306,
					"content": "看樣子你們是第一次來璃月見識海燈節吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010307,
					"content": "沒錯…妳怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010308,
					"content": "去年我可不記得有帶著奇怪吉祥物的旅行者來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010309,
					"content": "我來介紹一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010310,
					"content": "所以「明霄燈」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "節日裡，人們手中放飛的小燈叫做「霄燈」。而全璃月人共同建造的巨燈，就是「明霄燈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010312,
					"content": "「霄市」上的攤位，是璃月各路商行一年一度、難得不為賺錢，只為籌集「明霄燈」的建設資材而開設的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010313,
					"content": "你們如果願意，也可以一起來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010314,
					"content": "那，那有什麼好處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010315,
					"content": "#{F#妳}{M#你}的努力「明霄燈」是會記住的。等到新年第一次月圓，辭舊迎新之時，{F#妳}{M#你}的願望也會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010316,
					"content": "就沒有更實際一點的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010317,
					"content": "唉，何必如此務實？腳踏實地之外，也需要仰望星空啊。人生不能缺少夢想家的氣質…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010318,
					"content": "總而言之，幫助建設「明霄燈」的話，在<color=#00E1FFFF>「霄市」</color>也自有回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010319,
					"content": "總而言之，只要努力就能換到好吃的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}，要加油哦！我們去問問<color=#00E1FFFF>「霄市」</color>上的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "今年「明霄燈」的造型是紀念「移霄導天真君」啊，那個喜歡逞威風的傢伙應該會高興的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010602,
					"content": "關於「移霄導天真君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "今年海燈節在建造的「明霄燈」，就是「移霄導天真君」的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010604,
					"content": "希望他們會把鹿角修得大一些，畢竟頭上的角可是那位仙人最引以為傲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010605,
					"content": "據說，他的角吸收了岩王帝君岩之力的神髓，曾是整個璃月最堅硬的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010606,
					"content": "但就在「那場決戰」中，勁力迸出，山嶽傾倒，他為了不波及到山腳的村莊，主動讓朋友將他的鹿角砍下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010607,
					"content": "他將那鮮血淋漓的鹿角作為支點，撐起了整個山嶽。而他自己也堅持戰鬥到自己流盡最後一滴血…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010608,
					"content": "如今，曾被他撐起的「天衡山」依然巍然屹立，他死戰之中流出的鮮血則匯聚而成「碧水河」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010609,
					"content": "#呵呵…不論{F#妳}{M#你}是否相信我講的，能有人願意聽聽這些陳年舊事，就已經是很大的安慰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010610,
					"content": "海燈節之所以存在，也是因為那些「老朋友們」不甘寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010611,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "再見。願薪火相傳，美德不滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
