						],
						"pointId": 12758
					}
				]
			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "你好，你的飲料到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "#噢！噢！原來{F#妳}{M#你}們是送飲料的啊，我想說怎麼老半天沒有收到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130608,
					"content": "都怪你啦，在訂單上留下「送給沙灘上藍褲子客人」的備註，卻偷偷躲在沙子裡，害我們找了藍褲子大半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130609,
					"content": "你應該給我們加倍的外送費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130610,
					"content": "#啊，實在對不起，我忘記了這件事，我應該把褲子擺在一邊，這樣可能方便{F#妳}{M#你}們找到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130611,
					"content": "你為什麼要埋在沙子裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "因為很有趣啊，我聽說很多人度假的時候都會這樣做，所以也想試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130613,
					"content": "但你的姿勢不太對吧，你看起來像是蘿蔔紮在地裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752130614,
					"content": "欸？這樣會有什麼壞處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "阿考"
				},
				{
					"id": 752130615,
					"content": "容易絆倒別人，自己也會受傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "#知道了，我會考慮的。噢，這是{F#妳}{M#你}們的加倍外送費，謝謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿考"
				}
			]
		},
