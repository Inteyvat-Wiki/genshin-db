			"dialogs": [
				{
					"id": 752130501,
					"content": "天氣好熱啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130502
					],
					"speakerTitle": "灰褲子的遊客"
				},
				{
					"id": 752130502,
					"content": "你好，你的飲料到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130503
					]
				},
				{
					"id": 752130503,
					"content": "這杯飲料送給我嗎？天哪！是我的祈禱被神明聽見了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130504
					],
					"speakerTitle": "灰褲子的遊客"
				},
				{
					"id": 752130504,
					"content": "不是這個啦，我們要找的是藍色褲子的人！不是灰色褲子！",
					"roleType": "TALK_ROLE_NPC",
