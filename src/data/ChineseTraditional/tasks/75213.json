			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "欸？可以嗎？小店的員工已經全派出去了，現在還有一份加急的外送訂單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "哈雅庫"
				},
				{
					"id": 752130203,
					"content": "訂單上備註了送給一位<color=#00E1FFFF>沙灘上的藍褲子客人</color>，只要及時送到就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "哈雅庫"
				},
				{
					"id": 752130204,
					"content": "#實在感謝，除了這筆訂單的外送費以外，小店的飲料配方也送給{F#妳}{M#你}當作酬金，就拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈雅庫"
				}
			]
		},
