			"dialogs": [
				{
					"id": 700501201,
					"content": "吉雅羅小姐！妳怎麼在這裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501202,
					"content": "…不對，不對，這種突然找到線索的方式也太唐突了。而且一個人被捆在這裡一整晚，真的還有辦法思考嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501203,
					"content": "嗚哇…完全陷入思考了，她是找到什麼重要的靈感了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501204,
					"content": "不如說是遇見了重大的阻礙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#…{NICKNAME}、派蒙，{F#妳}{M#你}們來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501206,
					"content": "#可以請{F#妳}{M#你}們把我捆在木樁上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501207,
					"content": "我、我聽錯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501208,
					"content": "#請{F#妳}{M#你}們兩位把我的雙手捆起來，然後把我以「吊起雙手」的姿勢吊在一棵樹上。呃…反正都是木頭，也差不多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501209,
					"content": "我不想成為妳小說裡的嫌疑犯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "請放心，我已經把責任書全部寫好了，在此期間出現的一切意外，都由我本人負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501211,
					"content": "不是這個問題啦…妳為什麼突然要我們捆住妳？妳又沒犯什麼罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501212,
					"content": "但我小說裡的主角要在這裡被村民們吊起雙手，待在野外一整晚等待「玄文獸」的審判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501213,
					"content": "後面的情節是早就預料到這種情況的主角，用某些手段活了下來並安全地度過一晚，隨後揭露一切的真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501214,
					"content": "但是…我完全不知道被綁了一個晚上的人究竟是一種怎樣的感覺，無論是語氣、思考方式、行動能力——我都完全不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501215,
					"content": "#所以我想要請{F#妳}{M#你}們把我捆起來，讓我在這個地方待上一整晚，這樣的話我就可以體驗到這種感覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501216,
					"content": "不行，這樣太危險了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "唔…還有另外一種方式，但這種方式的效果不一定好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501219,
					"content": "那就是…我以「高舉雙手」的姿勢，在這裡站著待一整晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501220,
					"content": "不然…還是不要寫那本小說了吧…這樣也太容易讓人誤解了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501221,
					"content": "妳的小說主角也太慘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "#拜託了！這是最關鍵的一步，我的小說就快完成了！{F#妳}{M#你}們如果用這種方式的話就不用犯罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501223,
					"content": "我們本來就不用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501224,
					"content": "我們本來就不用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "啊…那個，不用那麼麻煩，只要守在我旁邊就好，免得我取材到半路被人拖走…或者被野獸拖走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501226,
					"content": "我看看…考慮到小說裡的氣氛，果然還是必須去最上面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501227,
					"content": "欸？妳等等我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501228,
					"content": "#{F#妳}{M#你}們和吉雅羅一起爬到了茶田的最上層…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "呼…有、有點冷…但是很有代入感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501230,
					"content": "#{F#妳}{M#你}真的要舉著雙手，在這裡站一整夜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501231,
					"content": "沒錯，我已經決定好了。寫小說總要付出一些代價…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501232,
					"content": "#那就拜託{F#妳}{M#你}們守在我旁邊了，只要一個晚上就好了…只要一個晚上就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700501217,
					"content": "難道沒有什麼安全的方式嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
