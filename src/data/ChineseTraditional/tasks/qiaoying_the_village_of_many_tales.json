			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "妳看，都說了只是一隻普通的小貓啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500502,
					"content": "居然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500503,
					"content": "喵？喵…喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "陷入迷惑的小貓"
				},
				{
					"id": 700500504,
					"content": "請問，你認識玄文獸嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "喵…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "陷入迷惑的小貓"
				},
				{
					"id": 700500508,
					"content": "小貓無奈地轉身離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "#不過…{F#妳}{M#你}們說，這隻小貓會不會就是玄文獸的幼體？牠就這樣潛伏在翹英莊裡，等成年了就把所有的茶樹席捲一空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500510,
					"content": "吉雅羅小姐，怎麼又是妳…我都和妳說過了，玄文獸不是這種溫和的野獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500511,
					"content": "哎呀，洪分小姐，真是太巧了，您怎麼也來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500512,
					"content": "唉…請不要總是在我們這裡唸叨什麼「罪案事件」，孩子們要是當真了可怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500513,
					"content": "妳們兩個認識？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "是啊，我來這裡的時候，正是請這位小姐幫忙搬運行李的呢。還請教了很多有關民俗傳說的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500515,
					"content": "我都說了很多次，玄文獸是不會在莊裡出現的，但吉雅羅小姐卻總是不信，還說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500516,
					"content": "不出現，也有不出現的取材方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500517,
					"content": "又來了…唉，吉雅羅小姐，我是勸不動妳了。但無論如何，請妳一定不要離開莊裡到處亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500518,
					"content": "玄文獸是真實存在的猛獸，如果遇見牠的話…唉，請您一定、務必不要獨自離開莊裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "洪分"
				},
				{
					"id": 700500519,
					"content": "洪分無奈地離去了，看起來比剛才的小貓更疲憊一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "好了，既然洪分小姐都這樣說了，我們也只能去另外一個地方取材了。走，跟著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500506,
					"content": "抱歉，我們認錯貓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "陷入迷惑的小貓"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉雅羅"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "怎麼樣？這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500602,
					"content": "茶釜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "沒錯！就是茶…茶什麼？總之…是一個很別緻的東西啦！而且還在莊裡的最中央，我覺得它一定有著特別的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500604,
					"content": "#唔…{F#妳}{M#你}們覺得…玄文獸會不會就住在這裡面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500605,
					"content": "這樣寫的話，會寫成傳奇小說喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "如果這樣寫的話，總覺得妳的小說裡還會出現仙人之類的元素呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500608,
					"content": "這種主題的罪案小說，總覺得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "#…喔！{F#妳}{M#你}們的表情不錯，是不是感覺…如果以玄文獸為主題寫罪案小說的話，這份罪案會十分「荒謬」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500610,
					"content": "欸？是、是有一點點這種感覺。無論如何，罪案小說的劇情都不可能以這種主題來發展的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500611,
					"content": "等等，難道妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#嗯，很敏銳嘛{NICKNAME}。沒有愧對{F#妳}{M#你}的大名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500613,
					"content": "#沒錯，我想要寫的正是一篇「荒謬到不可能發生的罪案」。洪分小姐和{F#妳}{M#你}們的反應很有趣，我會寫進小說裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500614,
					"content": "至於玄文獸嘛…牠是我設計中的「犯案者」，一種傳說中會吞噬村莊的惡人，卻從未有人真正見過的「玄文獸」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500615,
					"content": "在某一次節日中，有一位村莊居民被人發現在野外遇害，看起來像是被猛獸襲擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500616,
					"content": "但在第二天的慶典裡，我的主角卻再次遇見了本該死去的那位遇害者，隨後又有一位死者出現了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500617,
					"content": "之後呢？之後呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700500618,
					"content": "還沒想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500619,
					"content": "我要離開了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "#等等啊…等我寫完之後，絕對會寄兩本給{F#妳}{M#你}們。我還要有一個大忙想請{F#妳}{M#你}們幫我呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500621,
					"content": "洪分小姐不是一直說我絕對不能獨自離開莊裡嗎？這句話我可是好好聽進去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500622,
					"content": "#但現在嘛…既然{F#妳}{M#你}們來了，那我就不算是「獨自一人」，可以去村莊外面逛一逛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500623,
					"content": "#當然，我也不會去太遠的地方！{F#妳}{M#你}們願意幫我這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500624,
					"content": "好吧…為了看到小說的結尾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "那麼，我們就往那邊走吧！我有一個很想去的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500625,
					"content": "報酬要照規矩付喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "#那當然，{F#妳}{M#你}們就放心好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500606,
					"content": "這和罪案小說有什麼關係啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
