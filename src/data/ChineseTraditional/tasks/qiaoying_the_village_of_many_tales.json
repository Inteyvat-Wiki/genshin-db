			"dialogs": [
				{
					"id": 700500801,
					"content": "這些東西是「燈籠」嗎？看起來像是魚的燈籠，真有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500802,
					"content": "這些把手…是用來抬起這盞燈籠的嗎？嗯…這種拆卸式結構，只要設計得妥當，偷偷加個一兩節也不會被人發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500803,
					"content": "裡面的空間很大，應該可以輕鬆地裝進去一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500804,
					"content": "停！把念頭放在心裡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "欸？喔…喔！哈哈哈…看見有趣的東西，不由自主地又把念頭說出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500806,
					"content": "有了「燈籠」這種元素，我的小說一定會更有質感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}，可以請{F#妳}{M#你}去幫旁邊這隻大大的「魚燈籠」留個影嗎？我想要留下一些畫片當參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500808,
					"content": "我的留影技術又要進步了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "#那留影的事就拜託{F#妳}{M#你}了…對了！{F#妳}{M#你}在留影的時候，請務必把這個燈籠完整記錄下來，這對我來說很重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500811,
					"content": "運用「尺寸」這種元素來設計詭計…好像很有趣的樣子。唔…但是重量問題要怎麼解決呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 700500809,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
