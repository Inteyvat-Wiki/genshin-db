			"dialogs": [
				{
					"id": 700501001,
					"content": "咦？吉雅羅小姐人呢？她剛才還在這裡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501002,
					"content": "被玄文獸叼走囉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "不要說這種可怕的話啦！她一定又是一邊想著小說情節，一邊到處亂跑了，我們去周圍找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501005,
					"content": "旁邊茶田的地勢很高，先從那邊找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "先從高處找起啊…嗯！就這樣辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700501003,
					"content": "她寫的小說不會成真了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
