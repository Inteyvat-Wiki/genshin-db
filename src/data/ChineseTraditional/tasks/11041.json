			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "那就是阿貝多嗎？為什麼他會待在這種地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410402,
					"content": "聽說阿貝多他很喜歡畫畫，在什麼地方寫生都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410403,
					"content": "這裡視野很好，風景也不錯，無論是遠景還是近景都值得描繪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410404,
					"content": "但…他有注意到這些丘丘人嗎？會不會被突然攻擊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410405,
					"content": "嗚哇？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "#{F#妳}{M#你}們是誰？為什麼要驚擾它們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410602,
					"content": "幸好我的畫已經完成，要是沒能為特別的丘丘人收尾，就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410603,
					"content": "原來你在畫丘丘人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "不過，丘丘人有什麼好畫的，不都長得差不多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410606,
					"content": "#嗯…這個問題解釋起來比較複雜，不如請{F#妳}{M#你}們直接看看我的畫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410607,
					"content": "這…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "哇，有畫得特別認真的，但是，也有一看就非常敷衍的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410610,
					"content": "那些都是隨處可見的丘丘人，很無聊，不值得浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410611,
					"content": "但妳看這一隻，它的體格，它的毛髮，它的姿態，妳能看到它與眾不同的生命張力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410612,
					"content": "在原始族群周而復始的生活中，這種特殊性代表了進化。進化，即是從無到有，從已知到未知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410613,
					"content": "稍等稍等，我有預感會是一篇長篇大論，我可沒什麼興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410614,
					"content": "既然找到了人，我就先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410615,
					"content": "啊，妳沒有什麼問題想問他嗎？喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410616,
					"content": "唉，好奇怪的一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410617,
					"content": "#沒想到蘿莎莉亞修女會為{F#妳}{M#你}們帶路。嗯，沒來得及向她道謝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410618,
					"content": "#話說回來，聽她的意思，{F#妳}{M#你}們是專程來找我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410619,
					"content": "嗯，沒錯，我們在蒙德城裡遇見了一個叫砂糖的女孩子，她說，你的研究陷入了瓶頸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410620,
					"content": "#原來如此，是她把{F#妳}{M#你}們介紹過來的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410621,
					"content": "#那麼，我沒猜錯的話，{F#妳}{M#你}就是最近蒙德城裡都在議論的那位「榮譽騎士」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410622,
					"content": "#{F#妳}{M#你}在龍災中的表現、{F#妳}{M#你}對於元素力的異常掌控，還有諸多神秘之處，我都有所耳聞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410623,
					"content": "#直接說結論吧，可能性只有一種——{F#妳}{M#你}是從「另一個世界」遠道而來，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410624,
					"content": "嗯，沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "#太棒了。如果能得到{F#妳}{M#你}的協助，我的研究一定可以取得很大的進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410627,
					"content": "你的研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "#啊，抱歉，想必{F#妳}{M#你}現在一定很疑惑吧。從哪裡開始解釋比較好呢…唔，先講講生命的本質？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410630,
					"content": "等下等下，這已經很抽象了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410631,
					"content": "#唔…有道理，比起語言解釋，還是讓{F#妳}{M#你}們看到點什麼比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410632,
					"content": "比如，喚醒生命，讓枯枝獲得「新生」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410634,
					"content": "居然能做到這種事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410635,
					"content": "煉金術真是神奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "可是…我有一顆特殊的種子。剛剛用的辦法，在那個種子上就不奏效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410639,
					"content": "#它和{F#妳}{M#你}一樣，是從另一個世界來的——如何讓它生長並盛開，就是我現在遇到的瓶頸，也是需要{F#妳}{M#你}協助的研究內容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410640,
					"content": "你都做不到的事，那我們也幫不上忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410641,
					"content": "當然可以，因為就算是我，也無法想像這個世界以外的生命形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410642,
					"content": "#但只要認真觀察研究同是來自異世界的{F#妳}{M#你}，說不定就能讓我找到讓種子發芽的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410643,
					"content": "原來我的任務是「被人研究」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#怎、怎麼辦，{NICKNAME}？我覺得聽起來有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110410645,
					"content": "有什麼危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "#可能會有，但我會盡最大努力保障{F#妳}{M#你}的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410649,
					"content": "事不宜遲，我們先換個地方，趕緊開始研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410651,
					"content": "阿貝多，還有那個旅行者，好像一拍即合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410652,
					"content": "這兩個人，都是「異類」。蒙德的平穩延續…會被這樣的變量影響嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110410647,
					"content": "有什麼報酬嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "#摩拉，知識，以及{F#妳}{M#你}想知道的，又是我知道的答案，這樣沒問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110410636,
					"content": "煉金術真是方便。",
