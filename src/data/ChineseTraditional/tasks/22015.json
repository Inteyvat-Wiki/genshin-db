			"dialogs": [
				{
					"id": 220150901,
					"content": "#那麼，這件事就拜託{F#妳}{M#你}囉，我會準備好報酬的，順便…{F#妳}{M#你}也能親身體驗一下偵探的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150902,
						220150905
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150902,
					"content": "妳不擔心妳的助手嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150903
					]
				},
				{
					"id": 220150903,
					"content": "那傢伙身手很好，不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150904
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150904,
					"content": "怎麼說，他也是曾經在奉行所裡做過同心的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150905,
					"content": "妳怎麼不和妳助手一起去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150906
					]
				},
				{
					"id": 220150906,
					"content": "唔，怎麼說呢…我們倆各有分工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150907
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150907,
					"content": "他負責收集證據和線索，而我則負責分析歸納，找出真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150908
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150908,
					"content": "合理的工作模式，是一家偵探社良好運轉的基礎嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
