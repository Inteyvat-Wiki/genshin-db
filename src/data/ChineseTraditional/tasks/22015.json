			"dialogs": [
				{
					"id": 220150501,
					"content": "沒有在蒙德看見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "#蒙德…喔，{F#妳}{M#你}是說蒙德城吧，我倒是對那座城市有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150503,
					"content": "蒙德最著名的兩種特產，一種是酒，另一種是「自由」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150504,
					"content": "哈哈哈，這兩種特產還真是相輔相成…是蒙德城裡有偵探的話，肯定天天都會生意興隆的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
