					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "我只遇見過一位「律法諮詢師」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "「律法諮詢師」？啊…我聽說過，這種人…最難纏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150703,
					"content": "我想，這種人最擅長的事應該就是把簡單的問題變複雜，把複雜的問題搞成公式，再把公式的問題訂成契約。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150704,
					"content": "如果可以的話，我希望我永遠不要遇見這種人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
