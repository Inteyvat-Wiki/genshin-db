				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "#看{F#妳}{M#你}的樣子，是不是對偵探社還挺感興趣的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150802,
					"content": "我也能當偵探嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "#{F#妳}{M#你}想當偵探？這可是件苦差事喔，不要被那些小說騙了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150804,
					"content": "偵探探案的時候，沒有驚險刺激的追逐戰，也沒有生死一線的終極決斷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150805,
					"content": "滿屋子的卷宗、泥濘的山路，還有無論如何都不露出馬腳的嫌疑人…這才是偵探工作的真實場景啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150806,
					"content": "#但這麼說{F#妳}{M#你}應該也弄不清楚…我這裡剛好有個小事件，不如{F#妳}{M#你}先親身感受一下偵探的工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150815,
					"content": "我那位叫做龍二的助手，不久前剛去外面收集線索，到現在還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150816,
					"content": "已經都這個時候了，他應該收集到足夠的線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150817,
					"content": "#我想要請{F#妳}{M#你}走一趟，去把龍二給接回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150818,
					"content": "不會是遇見什麼危險了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "我已經把所有事都向他交代好了，就算是遇見了什麼突發情況，以那傢伙的身手應該也可以解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150820,
					"content": "我更在意的是，他能不能順利找到我想要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150826,
					"content": "#那麼，這件事就拜託{F#妳}{M#你}囉，我會準備好報酬的，順便…{F#妳}{M#你}也能親身體驗一下偵探的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150821,
					"content": "不會是遇到什麼意外了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "不會發生什麼意外的，我已經把所有事都向他交代好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150823,
					"content": "就算是遇見了什麼突發情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150824,
					"content": "以他的身手，應該也可以解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150825,
					"content": "我更在意的是，他能不能順利找到我想要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150807,
					"content": "感覺滿麻煩的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "那當然啦。但偵探這個職業，就是專業的「麻煩處理人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150809,
					"content": "什麼驚險刺激的追逐戰、生死一線的終極決斷…都是小說裡寫來騙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150810,
					"content": "滿屋子的卷宗、泥濘的山路，還有無論如何都不露出馬腳的嫌疑人…這才是偵探工作的真實場景啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150811,
					"content": "但那些小說裡還是寫對了一件事，那就是偵探總是有著各種各樣的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150812,
					"content": "所以妳也有助手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "那是當然。我的那位助手現在正在外面忙呢。而現在呢…我還需要另外一位助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150814,
					"content": "#如果{F#妳}{M#你}願意的話，能幫我這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
