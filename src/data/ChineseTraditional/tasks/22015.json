			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "#原來如此，{F#妳}{M#你}就是社長說的「助手」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150206,
					"content": "你知道我要來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "唔…倒也不是。只是社長說，會有人來幫忙，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150208,
					"content": "喂，你們在做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150209,
					"content": "那些是盜寶團嗎？為什麼會離城裡這麼近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150210,
					"content": "龍二，你怎麼也在這，還有這個可疑的外國人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150211,
					"content": "你說我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "#對啊，這裡的外國人也就{F#妳}{M#你}一個啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150215,
					"content": "好了，你也別太敏感了。龍二，你在這裡做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150216,
					"content": "我只是根據社長的指示，跟蹤可疑的人來到這裡，但是卻遇見了盜寶團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150217,
					"content": "這位旅行者確實是社長請來的幫手，剛才和我一起擊退了那些盜寶團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150218,
					"content": "這樣嗎…但是，這附近為什麼會出現盜寶團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150219,
					"content": "龍二，你剛才還說什麼，跟蹤可疑的人…喂！難不成，你是從城裡跟蹤盜寶團過來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150220,
					"content": "正是如此。社長之前正在處理一樁連續盜竊案，根據社長的推理，我在城裡四處搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150221,
					"content": "隨後，我在花見坂附近發現了可疑的人。但只是略微盤問了幾句，他就慌張地離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150222,
					"content": "我追著他出了城，之後的事，你們都已經知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150223,
					"content": "喔…龍二，你小子怎麼突然這麼會說話了，之前你不是都不怎麼說話的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150224,
					"content": "跟著珊瑚做事，把口才也鍛煉得不錯了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150225,
					"content": "你們是來做什麼的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "是安藤這傢伙，說有個可疑的金髮外國人在城裡亂轉，想要跟過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150227,
					"content": "#所以我倆才跟著{F#妳}{M#你}到了這裡，沒想到{F#妳}{M#你}居然是珊瑚的助手，誤會了{F#妳}{M#你}，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150232,
					"content": "啊…不過龍二，你剛才說，你是在城內發現那個可疑人士的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150233,
					"content": "正是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150234,
					"content": "這群傢伙居然還真的敢把手伸進城裡來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150235,
					"content": "正是如此。只憑我們…只憑我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150236,
					"content": "（他怎麼突然說話卡住了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "喔…只憑我們，也只能趕走一兩個盜寶團。想要徹底趕走盜寶團，還是得拜託你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150239,
					"content": "二位…如果還想看看證據的話，可以去城裡找社長，她會再詳細地和兩位解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150240,
					"content": "是嗎…天野，那我們就去找珊瑚吧，要是城裡真的有盜寶團作亂，那可不能放著不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150241,
					"content": "喔…喔！那我們去找珊瑚了，龍二，你們也快點回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150242,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150243,
					"content": "我們回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150244,
					"content": "你剛才說的那些話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "是社長交代的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150246,
					"content": "事情已經辦好了，我們回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150237,
					"content": "（他怎麼像是忘詞了一樣…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "你們也是追著可疑人士來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "#這麼說也沒錯，但我倆追著的可疑人士其實是{F#妳}{M#你}，咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150230,
					"content": "是安藤這傢伙，說有個可疑的金髮外國人在城裡亂轉，想要跟過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150231,
					"content": "#所以我倆才跟著{F#妳}{M#你}到了這裡，沒想到{F#妳}{M#你}居然是珊瑚的助手，誤會了{F#妳}{M#你}，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150213,
					"content": "我是珊瑚的助手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "珊瑚的助手？聽起來反倒更可疑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "安藤"
				}
			]
		},
		{
