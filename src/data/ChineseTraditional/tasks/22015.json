			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "時候差不多要到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150102,
					"content": "喔呀，歡迎光臨，閣下是遇見什麼難題了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150103,
					"content": "#唔，原來如此，{F#妳}{M#你}…沒遇見什麼難題，只是想要「隨便逛逛」而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150104,
					"content": "這裡是「萬端珊瑚偵探社」，是一個很尋常的地方，而我嘛…是一個偵探。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150105,
					"content": "妳是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "我叫珊瑚，是這家偵探社的社長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150107,
					"content": "不過，雖然說是社長，但這家偵探社也只有兩個員工罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150113,
					"content": "#怎麼，{F#妳}{M#你}是第一次看見這種偵探社嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150108,
					"content": "偵探是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "喔，這是個好問題。從一般人的視角來看，偵探這種職業也許特殊又神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150110,
					"content": "但要我來說，偵探也只是一種「拿錢辦事」的普通職業罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150111,
					"content": "雖然辦的事有時候會不太尋常，委託人偶爾會也有點特別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150112,
					"content": "但無論如何，都脫不開「拿錢辦事」這個行事主旨就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
							"2"
