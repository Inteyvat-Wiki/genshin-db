			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "沒有在璃月看見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "璃月也不太需要偵探啦。那邊對「契約」的重視程度我也聽說過一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150603,
					"content": "而且，他們還有無論大事小情都會迅速到場解決的「千岩軍」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150604,
					"content": "就算那邊有偵探社，大概也會因為生意太少而迅速倒閉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
