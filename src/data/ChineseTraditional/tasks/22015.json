			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "珊瑚小姐，妳剛才說的都是真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150302,
					"content": "城裡的連環盜竊案，真的是那些混帳盜寶團幹的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150303,
					"content": "那是當然。剛才我也給你看過那些證據了，憑兩位的「職業直覺」…心裡應該也已經有了判斷吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150304,
					"content": "這群盜寶團…真是膽大包天！這是不把我們放在眼裡嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150305,
					"content": "天野！我們快回去，把這件事往上報告吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150306,
					"content": "一定要再加強巡邏，不能給這群混帳一點可乘之機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150307,
					"content": "珊瑚小姐，這些證據可以先借給我們一下嗎？我們要用來說服大人們採取措施。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150308,
					"content": "沒問題，儘管拿走吧。畢竟盜寶團作亂這種大事，可不是我們偵探社能夠處理的，只能拜託奉行所的大人們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150309,
					"content": "放心吧！這群盜寶團…我們絕對一個都不放過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150310,
					"content": "辛苦你們了。現在…應該已經準備得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150311,
					"content": "準備？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "是，這兩位奉行所的同心大人，可是結掉我手裡這個案子的重要「幫助」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150316,
					"content": "在這兩位同心大人加強巡邏後，城裡的盜寶團一定也會提高警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150317,
					"content": "龍二，在我請你去的那個地方，你應該和那些盜寶團交過手了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150318,
					"content": "是的，社長，那些盜寶團都被我和這位旅行者擊退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150319,
					"content": "嗯…這樣就好，你們製造出的動靜應該已經夠大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150320,
					"content": "接下來我們要做的，就是再等一個機會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150321,
					"content": "#辛苦{F#妳}{M#你}了旅行者，這些是報酬，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150322,
					"content": "我好像也沒幫什麼忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "#可不能這麼說。以外國人的身分吸引住安藤，讓他帶著天野追著{F#妳}{M#你}和龍二會合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150324,
					"content": "然後，讓他們親眼發現盜寶團的威脅，然後順理成章地在城裡加強巡邏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150325,
					"content": "#這些，可都是只有{F#妳}{M#你}才能做到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150326,
					"content": "畢竟，比起我去告訴他們，讓這兩位同心「親自發現」盜寶團的事，效果才更好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150327,
					"content": "#總之，收下這些東西吧，說不定…我之後還會再找{F#妳}{M#你}幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150313,
					"content": "妳要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "我是偵探，要做的事，當然是要斷案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150315,
					"content": "這兩位奉行所的同心大人，可是結掉我手裡這個案子的重要「幫助」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
