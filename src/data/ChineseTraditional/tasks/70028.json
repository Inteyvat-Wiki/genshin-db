			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "#多虧{F#妳}{M#你}的試用數據，「普爾希娜光釘」的最終校準工作已經完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280102,
					"content": "現在，我有十足的把握，它們一定能穩定運行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280103,
					"content": "只要我們把「普爾希娜光釘」佈置在特異體時常出沒的地點，就能控制住它的能源供應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280104,
					"content": "如只要光釘啟動，機體就無法再反覆自我修復了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280105,
					"content": "#謝謝{F#妳}{M#你}的幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "功勞並不在我，我們應該感謝的是先輩們為我們留下的知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280109,
					"content": "如果沒有那些知識給予的引導，我無論如何也想不出制伏那台特異體的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280110,
					"content": "我們所作的一切都有賴於知識的引導，知識才是這世界上最重要的資源啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280111,
					"content": "聽起來很難懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "#{F#妳}{M#你}不理解這個最基本的道理也很正常，{F#妳}{M#你}畢竟還沒有領受過至高智慧的薰陶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280113,
					"content": "費了不少功夫終於修好了「普爾希娜光釘」，我一時有點興奮，哈哈，剛才有些扯遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280114,
					"content": "我們只剩最後一項準備工作了，那就是去鶴觀把「普爾希娜光釘」佈置好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280115,
					"content": "抱歉，這件事我就幫不上忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280116,
					"content": "#按稻妻本地規定，我這種連駐留手續都沒辦好的人不能自由行動，這件事只能由{F#妳}{M#你}完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280117,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "#那就靠{F#妳}{M#你}了。我建議{F#妳}{M#你}在佈置完成後，不要輕率動手，簡單觀察一下情況是否正常，再和我說一聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280119,
					"content": "#為了{F#妳}{M#你}的安全著想，我們最好謹慎些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280107,
					"content": "感謝科技的力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "我倒不這麼認為，我們應該感謝的是先輩們為我們留下的知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "胡塞尼"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
