			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "怎麼樣？光釘有沒有正常運行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280302,
					"content": "一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "嗯，一切正常是最好的情況，希望以後也不要出故障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280304,
					"content": "這樣一來，只要在特異體出現在光釘附近時啟動光釘，特異體的能量供應就會被切斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280305,
					"content": "#這次，{F#妳}{M#你}應該能夠擊敗它了，放開手去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280306,
					"content": "#我相信{F#妳}{M#你}的實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}