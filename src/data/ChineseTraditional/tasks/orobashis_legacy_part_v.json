			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "#感謝{F#妳}{M#你}的努力，雖然島上依然危險重重，但多虧了{F#妳}{M#你}，那些背井離鄉的人們才多少恢復了一點回家的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320102,
					"content": "雖說現在大雨停了，交戰的雙方可能會更積極地進軍爭奪這座島吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320103,
					"content": "不過島上的境況，既然他們無暇改變，我們所做的一切至少比就這樣放著惡化好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320104,
					"content": "#那麼，之前說好的謝禮就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320105,
					"content": "#這是幾百年前八醞守大人使用的名槍…我不清楚這幅畫對{F#妳}{M#你}來說有沒有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320107,
					"content": "不過把它拿給手藝足夠精湛的工匠的話，或許能夠重現喜多院大人的英姿吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320108,
					"content": "唉，當今不再是英雄的時代了，曾撲滅無數邪魔的喜多院大人也不復歸來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320109,
					"content": "#不過幸好有{F#妳}{M#你}相助，喜多院大人的功業…現在我們也追上了一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320110,
					"content": "接下來我會去幕府軍的朋友那邊，看看能幫上什麼忙，希望來日有緣再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		},
