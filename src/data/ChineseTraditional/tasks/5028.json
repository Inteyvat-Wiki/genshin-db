			"dialogs": [
				{
					"id": 50280501,
					"content": "降臨者的生命比妳想像中更有價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "希巴拉克"
				},
				{
					"id": 50280502,
					"content": "妳親手捏碎了世界的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "希巴拉克"
				},
				{
					"id": 50280503,
					"content": "若我註定失敗，你又為何恐懼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "瑪薇卡"
				},
				{
					"id": 50280504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "希巴拉克"
				},
				{
					"id": 50280505,
					"content": "（為了願望，我們步上巡禮。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "瑪薇卡"
				},
				{
					"id": 50280506,
					"content": "（為了最強之名，我們雲聚鬥爭。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "瑪薇卡"
				},
				{
					"id": 50280507,
					"content": "（為了夢，我們在劫火中燃盡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "瑪薇卡"
				},
				{
					"id": 50280508,
					"content": "（如此輪迴，循環往復…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪薇卡"
				}
			]
		},
