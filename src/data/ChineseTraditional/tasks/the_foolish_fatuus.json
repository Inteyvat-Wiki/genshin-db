			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧列格",
					"凱西姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730490317,
					"content": "#噓，{NICKNAME}，{F#妳}{M#你}看那邊！有一個鍍金旅團的和…一個愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490301
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730490301,
					"content": "凱西姆…這些桑格吉拉光機運作情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490302
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490302,
					"content": "情況良好，奧列格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490303
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490303,
					"content": "這就是這次的結果報告，按現在的情況進行下去…不用多長時間就能提取到你們愚人眾想要的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490304
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490304,
					"content": "好啊，哈哈哈，有你的幫助，一定能夠在最短的時間內完成執行官大人的命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490305
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490305,
					"content": "不過，如果你膽敢騙我…你自己知道後果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490306
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490306,
					"content": "騙你對我有什麼好處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490307
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490307,
					"content": "你清楚就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490308
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490308,
					"content": "嘿，那個特洛芬·雪奈茨維奇…辦事不力，在這裡好幾年都毫無建樹，我這麼快就拿出成果，到時候，看他還有什麼狡辯的話說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490309
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490309,
					"content": "特洛芬·雪奈茨維奇…我在須彌可沒聽過這個名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490310
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490310,
					"content": "哈哈那是當然，他怎麼可能用這個名字，豈不是一下就暴露了…執行官大人交給他的任務，幾年了，一點進展也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490311
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490311,
					"content": "#…不對，誰，誰在那裡？{F#妳}{M#你}是怎麼到這裡來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490312
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490312,
					"content": "#嗚哇，{NICKNAME}，被發現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730490313,
					"content": "…我也該走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490314
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490314,
					"content": "呵，愚人眾，不會被區區一個誤入此地的冒險家擊敗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490315
					],
					"speakerTitle": "凱西姆"
				},
				{
					"id": 730490315,
					"content": "這還用不著鍍金旅團的人操心…哼，等我先把這個偷跑進來的老鼠消滅了，再去說好的實驗營地找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490316
					],
					"speakerTitle": "奧列格"
				},
				{
					"id": 730490316,
					"content": "凱西姆離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
