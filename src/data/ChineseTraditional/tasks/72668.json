			"dialogs": [
				{
					"id": 726680101,
					"content": "真好啊，曾經追尋「海中月」的大家，也都算是完成了自己的心願呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680102,
					"content": "都完成了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "#{F#妳}{M#你}看{F#妳}{M#你}看，嘉瑋是不是找到了一個十分富有的妻子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680104,
					"content": "楠塔克也因為那本揭秘「海中月」的書成了小有名氣的作家了呢，雖然內容是錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680105,
					"content": "鯨井椛更是稻妻最厲害的漁王了，而且今天還捕捉到了父親都沒有成功的「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680106,
					"content": "#所以我覺得啊，{NICKNAME}的願望，也一定會實現！嘿嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680107,
					"content": "小派蒙剛剛許下的願望是什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "不能說不能說，說出來就不靈了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680109,
					"content": "「海中月」不會這麼小氣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "嗯——那好吧，聽清楚哦，我就說一遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680111,
					"content": "#我的願望就是實現{F#妳}{M#你}的願望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680112,
					"content": "聲音太小了，你說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "哼哼，就說一遍，沒聽清就算了！我要買糖果去囉~啦啦啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
