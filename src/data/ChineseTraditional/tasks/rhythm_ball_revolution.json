			"dialogs": [
				{
					"id": 755080101,
					"content": "喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080102,
					"content": "我們最最重要的客人來啦，說明氣氛即將達到最熱點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080103,
					"content": "瑪拉妮，你好呀！希諾寧也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080104,
					"content": "還有瑞希？你從稻妻過來啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080105,
					"content": "沒錯哦，納塔的朋友們待我就像家人，「流泉之眾」就像是我異鄉的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080106,
					"content": "我也需要用心打理分店，才能為納塔的大家提供力所能及的幫助嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080107,
					"content": "說得不錯，瑞希小姐的工作態度實在無可挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080108,
					"content": "和她一對比，傳說中的乙方範本都會顯得怠惰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080109,
					"content": "原來希諾寧也是瑞希的客戶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "最近做了幾個奇怪的夢，比如…委託人把原本四週的訂單工期縮短到一週。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080112,
					"content": "或者接到的需求是「外形圓潤又帶著危險感的掛飾」，同樣是四倍加急…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080113,
					"content": "這題我會，史萊姆和蕈獸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "反應這麼快，該不會是你託夢給希諾寧下單的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080116,
					"content": "這兩種生物…危險嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080117,
					"content": "唔，工期倒是次要的，圓形圖案處理起來比較費事，一旦加急，成品效果就未必完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080118,
					"content": "夢裡這類的麻煩訂單還不少，我感覺有些不對勁，就把手頭的單子都結了，來瑞希小姐的店裡試了試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080119,
					"content": "結果還真靈驗，當天午睡時，我就沒再做過奇怪的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080120,
					"content": "能為希諾寧女士排遣煩擾，我深感榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080121,
					"content": "不過我覺得，希諾寧女士的古怪夢境會消散，主要的功勞應該還在於您自己啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080122,
					"content": "總而言之，現在大家的精神狀態都很不錯，正是放鬆的好時機——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080123,
					"content": "「流泉之眾」要重啟水上派對的傳統，讓大家玩個痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080124,
					"content": "水上派對~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "好耶，玩個痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080127,
					"content": "…不過，我以前還沒參加過這種活動，只知道有好吃的東西和好喝的飲料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080128,
					"content": "納塔人大多會在派對上玩些什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080129,
					"content": "鰭游龍拉著客人高速衝浪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "我…我能玩這個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080133,
					"content": "哎呀，你們已經是成熟的極限運動愛好者了！我第一時間也想讓客人們玩這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080134,
					"content": "不過阿米娜很認真地說…咳咳…「對於普通人來說，這樣的活動還是刺激過頭了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080135,
					"content": "「就算是普普通通的沙灘排球，一些客人都可能把握不住力道，導致同伴受傷哦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080136,
					"content": "「要是參加了派對，一個不注意，沒能玩個痛快，反而留下了心理陰影，到時候增加的就是瑞希小姐的工作量了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080137,
					"content": "我倒是不介意幫更多人排憂解難啦，但可不包括自己製造出的病患哦，還是別讓客人受傷為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080138,
					"content": "嘿嘿，所以我才好好找你諮詢了一番嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080139,
					"content": "看來你們已經商量出了不錯的方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080140,
					"content": "沒錯，我們達成了共識，希望更多沒有極限運動基礎的客人參加派對，而不是看著刺激的活動望而卻步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080141,
					"content": "在和我聊天時，瑪拉妮小姐聽說了稻妻的「三川花祭」，對歷年祭典上的輕鬆遊戲很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080142,
					"content": "就萌生了一個念頭——將「秋津羽戲」與納塔的氛圍相結合，打造出既能休閒放鬆，又能玩個爽快的遊戲「節拍撞球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080143,
					"content": "稻妻的遊戲…納塔的氛圍…還真是以前從沒想過的組合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080144,
					"content": "我看到了「回聲之子」的「熱舞樂臺」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "啊呀，「熱舞樂臺」明明還沒調高音量，看來你對低音和鼓點還滿敏感的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080147,
					"content": "這次的主力遊戲「節拍撞球」，就是跟著熱情的音樂，暢玩彈球，打碎所有方塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080148,
					"content": "順從本能，釋放自我，不必考慮複雜的技巧，不用擔心安全問題，任何人都能玩個痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080149,
					"content": "#當然，對於{NICKNAME}這種天賦異稟的選手，應該能打出…具有特別「節拍」和「層次」的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080150,
					"content": "在不同的音控師手中，一首曲子有可能展現出截然不同的風格，帶有打擊感的遊戲也是同理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080151,
					"content": "沒準…「馳放」風格的基底音樂，經過你的處理，都會展現出類似「出神」或「藝核」的有趣律動呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080152,
					"content": "我有點期待哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755080153,
					"content": "#聽…聽不太明白！不過感覺，應該是{NICKNAME}能做到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080154,
					"content": "那我就來扮演音樂和遊戲天才！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "太對了，就是這種幹勁！在我們的期待中，無論如何都要保證玩得最開心的客人，就是你和派蒙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080157,
					"content": "待會我要拿一堆零食和飲料，在一邊開開心心地看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 755080158,
					"content": "當然，也請注意，別興奮過頭呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080159,
					"content": "說不定晚上睡覺前，腦子裡還在反覆播放「熱舞樂臺」的音樂，停不下來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755080160,
					"content": "謝謝大家！我們一定玩個開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080161,
					"content": "話說回來，我記得希諾寧很會挑歌，就算夢裡還在重播…應該也沒問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080155,
					"content": "不至於這麼強，我會盡力的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
