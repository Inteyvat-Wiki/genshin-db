			"completionStepIds": [
				7002901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002901",
							"2"
						],
						"stepId": 7002901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700290101,
					"content": "旅行者，情況如何？「普爾希娜光釘」派上用場了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290102,
						700290103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290102,
					"content": "幫了大忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				},
				{
					"id": 700290104,
					"content": "很好很好，我們沒白忙一場，這項委託總算是結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290105,
					"content": "至於這台特異體，它的功能設計似乎和野外常見的遺蹟守衛、遺蹟獵手有很大不同，整體的設計概念比它們優秀太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290106,
					"content": "不過，擁有類似設計的自律機關並不常見，我猜測，它可能是某種試作產品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290107,
					"content": "它最初的設計者到底是出於何種目的製造了它呢？。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290108,
					"content": "這是不是意味著…古文明的自律機關製作比目前水準學術界評估的還要高？真有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290109,
					"content": "如果能拆解它的內部結構，一定能獲得具有革新意義的發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290110,
					"content": "旅行者，有空的話，能帶我去看看特異體的殘骸嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290111,
					"content": "已經沒剩什麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290112
					]
				},
				{
					"id": 700290112,
					"content": "#什麼？{F#妳}{M#你}難道把它的機體給打爛了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290113,
					"content": "神啊…這是多麼巨大的浪費！不，是巨大的失誤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290114,
					"content": "#唉，我應該事前提醒{F#妳}{M#你}的，都怪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290115,
					"content": "太可惜了，太可惜了，這可是古文明技術史領域的重大發現，居然連樣本都沒留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290116,
						700290119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290116,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290117
					]
				},
				{
					"id": 700290117,
					"content": "#不不，{F#妳}{M#你}並不瞭解這件事的學術意義，所以才會這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290118,
					"content": "#懂得它意義的我卻沒有早點提醒{F#妳}{M#你}，這是我的問題，責任並不在{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290121,
					"content": "我這次外出調查真是太坎坷了，先是無法長期駐留離島，後是白白放過了這麼重大的學術發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290122,
					"content": "…算了算了，還是樂觀些吧。至少這件事促使我修好了「普爾希娜光釘」，還成功驗證了它的功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290123,
					"content": "創造出如此精妙的儀器的普爾希娜和阿葉夏前輩真是了不起，他們的偉大發明不該被閒置在倉庫裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290124,
					"content": "這次的稻妻考察要是實在進行不下去，我就把主題換成「普爾希娜光釘」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290125,
					"content": "如果「普爾希娜光釘」這個主題能夠受到「教令院」重視，又萬一我的研究報告能得到發表…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290126,
					"content": "#哈哈，我一定會在致謝中寫上{F#妳}{M#你}的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290127,
					"content": "希望我能看懂你的報告。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290128
					]
				},
				{
					"id": 700290128,
					"content": "哈哈，到那時候再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290129,
					"content": "#這次我們合作愉快，希望{F#妳}{M#你}今後的旅途也能順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290119,
					"content": "如果你早些告訴我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290120
					]
				},
				{
					"id": 700290120,
					"content": "沒有早點想到這一層是我考慮不周，現在說什麼都晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700290103,
					"content": "問題已經被解決了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				}
			]
		}
	]
}