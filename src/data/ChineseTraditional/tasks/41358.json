					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "#全部都找到了？{F#妳}{M#你}尋寶的功夫還真的…挺出色的，好多人過來，轉了一下燈就走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580204,
					"content": "#既然{F#妳}{M#你}找到了全部的寶藏…那這些獎勵給{F#妳}{M#你}，收下吧，祝{F#妳}{M#你}在海燈節玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
