			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "歡迎試玩「玲瓏霄燈圖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580102,
					"content": "咦？這些燈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "#是{F#妳}{M#你}啊，來得正好，{F#妳}{M#你}上次解開了那盞燈之後，我特意又換了幾盞燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580104,
					"content": "怎麼樣，要不要再試試解讀一下？這次可沒上次那麼簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580105,
					"content": "是映出來的圖案更複雜了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "不不，圖案還是很好理解，也只分成三份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580107,
					"content": "這次的難度，是在「轉燈的方式」上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580112,
					"content": "噢，對了！這次要拼的圖案是<color=#00E1FFFF>「摩拉」</color>。記好啦，拼出正確的圖案之後，才能去找寶藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				},
				{
					"id": 413580108,
					"content": "是轉燈的方式更難了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "嘿嘿，這次的三盞燈可是<color=#00E1FFFF>「連軸」</color>的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580110,
					"content": "#簡單來說，就是當{F#妳}{M#你}轉一盞的時候，說不定另外一盞也會跟著轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580111,
					"content": "#好了，{F#妳}{M#你}就自己去體會一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "小千"
				}
			]
		},
