				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369502",
							"2"
						],
						"stepId": 7369502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丹納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "#喔？{F#妳}{M#你}已經把所有「文物模型」都找到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950202,
					"content": "#了不起！{F#妳}{M#你}很有考古方面的天賦嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950203,
					"content": "#那麼，這份禮物就送給{F#妳}{M#你}了，感謝{F#妳}{M#你}來參加我們學院舉辦的活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950204,
					"content": "#希望{F#妳}{M#你}從這次的活動裡感受到了一些考古的樂趣啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950205,
					"content": "雖然在真實的考古工作裡，大部分時候都枯燥乏味又辛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950206,
					"content": "但在挖掘到關鍵性文物的那一剎那，又會感覺到一切的辛苦都是值得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950207,
					"content": "那要是沒挖出來呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "沒挖出來的話…那就和俗話說的一樣，這一趟「白忙活」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950210,
					"content": "而且這種做白工的情況才是常態，能順利挖到關鍵性文物的次數少之又少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950211,
					"content": "不過做考古工作嘛，就是要習慣這種情況，隨時保持樂觀的心態，不然工作不了多長時間，就要撐不住囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丹納"
				},
				{
					"id": 736950208,
					"content": "也有沒挖出來的情況吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
