			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "祭典都有哪些內容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "哈哈哈哈！內容豐富得很！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840634,
					"content": "#看見那邊的小山坡了嗎？那是豪歌嶺，{F#妳}{M#你}們可以站在上面，面對大海，自由歌唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840635,
					"content": "還有這團篝火，用來烤堇瓜綽綽有餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840636,
					"content": "還有這堆箱子，不管是玩《七聖召喚》還是鬥蟲都不會感到擁擠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840637,
					"content": "聽起來還真是「豐富」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840638,
					"content": "#當然，祭典的重頭戲還是這個豪鼓祭演啦。來，{F#妳}{M#你}們看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840639,
					"content": "#偷偷告訴{F#妳}{M#你}們，這可是我從秘密管道搞來的好東西，說是一位大陰陽師留下的寶具小鼓，本來要價800萬摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840640,
					"content": "賣家說看我面目俊朗，與她有緣，於是給我打了個折，只要80萬摩拉就賣給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840641,
					"content": "800萬摩拉變成80萬摩拉，怎麼聽也像是騙人的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840642,
					"content": "當然！我怎麼可能被這種低劣的手法騙到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840643,
					"content": "我一眼就看出了這個小鼓的邊緣有些破損，這是瑕疵品！還說什麼與我有緣，可笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840644,
					"content": "於是本大爺又砍了她一刀，最後只要8萬摩拉成交。哈哈哈哈哈！撿到大便宜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840645,
					"content": "總覺得是人家撿到大便宜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840646,
					"content": "話說回來，放牛的居然出得起8萬摩拉，讓人有點刮目相看啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840647,
					"content": "不過是8萬摩拉而已，不要隨便看輕本大爺啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840648,
					"content": "我出了其中的2萬...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840649,
					"content": "我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840650,
					"content": "啊？老大，為什麼我出的是3萬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840651,
					"content": "2萬加2萬加3萬等於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840652,
					"content": "好你個放牛的，居然自己不出一分錢，就從小弟那裡搜刮了8萬摩拉出來...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840653,
					"content": "咳咳，妳是怎麼算的，我我我也是出了最後1萬摩拉的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840665,
					"content": "好了，多的就不說了，看看時間，我也得回阿忍那裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840666,
					"content": "祭典才剛剛開始，我們還得再努力拉一些人過來才熱鬧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840667,
					"content": "收好這個小鼓，如果準備好要開始豪鼓祭演，找元太就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840668,
					"content": "回見了！我的摯友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
