			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博彦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "二位有什麼需要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840502,
					"content": "我們來找荒瀧派。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "#噢噢噢，我知道了，{F#妳}{M#你}們也是來參加那個荒瀧極上什麼什麼大祭典的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840504,
					"content": "也是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "嗯嗯，不久前，天領奉行的九條裟羅大人，還有長野原煙花店的宵宮小姐都來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840506,
					"content": "宵宮小姐是過來送煙花時，碰巧看見那夥人在張羅場地，可能是感興趣吧，所以過去看了看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840507,
					"content": "至於九條裟羅大人為什麼過來，就不太清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840508,
					"content": "#{NICKNAME}，居然有人比我們先到了呢！嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840509,
					"content": "所以荒瀧派他們現在在哪裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840510,
					"content": "說來慚愧，因為最近島上已經沒有額外的空餘場地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840511,
					"content": "我們只好把他們安排在了西北邊的小灘塗上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840512,
					"content": "如果他們能再早些申請，我可以為他們準備更好一些的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840513,
					"content": "#{F#妳}{M#你}們往西北邊走一走應該就能看見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博彦"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "#哈哈哈哈哈哈哈！我的摯友啊！{F#妳}{M#你}終於到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840602,
					"content": "#剛剛還在想，什麼時候到才能見到{F#妳}{M#你}，果然{F#妳}{M#你}就到了，真是讓本大爺高興啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840603,
					"content": "看看本大爺這場子，怎麼樣？是不是上佳的選擇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840604,
					"content": "三面環海，空氣清新，遠離城市喧囂，坐擁絕版景觀資源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840605,
					"content": "背靠甘金島，獨享祭典文化中心的頂級配套。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840606,
					"content": "水陸交通發達，無論是步行或是坐船都能便捷抵達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840607,
					"content": "確實，場子很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "當初看到這個場子的瞬間，本大爺就決定，就是它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840610,
					"content": "那一刻，世界大有不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840611,
					"content": "老大英明！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840612,
					"content": "明明是被天領奉行的人趕過來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840613,
					"content": "咳咳…我們還是先說正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840614,
					"content": "#這次請{F#妳}{M#你}們過來，是想請{F#妳}{M#你}們參加我荒瀧極上盛世豪鼓大祭典！這個祭典意義重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840615,
					"content": "老大說，一來是為了宣傳我荒瀧派的名頭，方便未來招募新人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840616,
					"content": "二來是為了忍姐畢業慶功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840617,
					"content": "最後還能補上前幾次因為欠缺經費而延期的團建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840618,
					"content": "還真是一典多用呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840619,
					"content": "阿晃...最後一條不必再提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840620,
					"content": "怎麼沒有看見阿忍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "祭典這種事，多多宣傳才有更多的人來參加，所以阿忍去發傳單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840622,
					"content": "喂！明明阿忍是主角吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840623,
					"content": "居然她在外面幹活，你們在這裡遊手好閒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840624,
					"content": "#本大爺也有在認真…認真在這裡接待{F#妳}{M#你}們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840625,
					"content": "老大其實是剛剛回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840626,
					"content": "#說是估算著{F#妳}{M#你}們可能要到了，才特地回來迎接的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840627,
					"content": "本來他和忍姐一起，也在外面努力拉人參加祭典呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840628,
					"content": "不用誇我，不用誇我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840629,
					"content": "哎呀，放牛的居然也在認真做事了。難得地可靠了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840630,
					"content": "哼，不跟妳這飛行矮堇瓜一般見識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840631,
					"content": "#話說回來，我的摯友啊，關於這次祭典，{F#妳}{M#你}還有什麼疑問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840608,
					"content": "確實，你們很樂觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
