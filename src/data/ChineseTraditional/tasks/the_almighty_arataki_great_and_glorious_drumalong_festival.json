			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "我是荒瀧豪鼓祭接引大使元太，準備好開始豪鼓祭演了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840702,
					"content": "哦對了，關於這個小鼓，之前老大有一點忘記交代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840703,
					"content": "因為大家也不太懂樂器，所以您在開始之前，可以先調整一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840704,
					"content": "這樣可以讓最後的音色更加準確動聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840705,
					"content": "來，請您試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元太"
				}
			]
		},
