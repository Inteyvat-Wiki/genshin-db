				"points": []
			},
			"dialogs": [
				{
					"id": 726847101,
					"content": "我是荒瀧豪鼓祭意見回饋大使阿晃，您有什麼要回饋的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847102,
					"content": "我覺得還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "好的，您的回饋我收到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847106,
					"content": "欸？您問別的？我沒有別的話要說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847107,
					"content": "啊…老大的意思是，我的工作只要說，「您有什麼要回饋的嗎？」，「您的回饋我們收到了」這兩句話就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847108,
					"content": "如果客人還要追問什麼時候回饋才有消息，那就再加一句，「請您耐心等待」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847109,
					"content": "他說他在其他地方參加的活動都是這樣的，想必是借鑒了一下優秀的經驗吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847110,
					"content": "不過後來忍姐說這樣實在太敷衍了啦，所以又給我準備了一個小本子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847111,
					"content": "瞧，您的意見我已經記下來了，等忍姐回來了再給她看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847103,
					"content": "我覺得普通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "我覺得不太行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
