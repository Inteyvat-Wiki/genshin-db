			},
			"dialogs": [
				{
					"id": 726840660,
					"content": "聽說宵宮也來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "那位長野原煙花店的老闆嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840662,
					"content": "真是一位熱情健談的女士啊，她是來甘金島送貨的路上，巧合才知道我們的祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840663,
					"content": "她很喜歡我們的祭典，過來祝福了一番，還說下次會提前給我們準備煙花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840664,
					"content": "看來以後我荒瀧派，應該也要和長野原煙花店多多走動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840631,
					"content": "#話說回來，我的摯友啊，關於這次祭典，{F#妳}{M#你}還有什麼疑問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
