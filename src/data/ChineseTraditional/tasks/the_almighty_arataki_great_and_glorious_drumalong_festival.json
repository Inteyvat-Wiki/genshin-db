				"points": []
			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "我是荒瀧豪鼓祭氛圍大使阿守，您有什麼需要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847202,
					"content": "您問我的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847203,
					"content": "啊，氛圍大使嘛，主要就是營造火熱的氛圍，讓參加祭典的人們產生「我快要嗨到不行了」的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847204,
					"content": "您有那種感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847205,
					"content": "完全沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "請…請不要說這種話啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847208,
					"content": "不要這樣冷漠地打擊我的積極性啊！這樣我的工作不就失去了意義嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847209,
					"content": "您是老大的摯友，請代替老大給我一些支持吧。拜託了，對我說那句話吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847210,
					"content": "哪句話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "「我快要嗨到不行了」那句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847212,
					"content": "我快要嗨到不行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "太棒了！太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847214,
					"content": "這是對我最好的認可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847218,
					"content": "來吧，朋友們！接著奏樂！接著舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847215,
					"content": "我快要…我快要…抱歉我說不出口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "唔…好吧。就算您這樣說，但看著荒瀧派的大家都在努力做好自己的工作，所以就算這樣我也不能鬆懈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847217,
					"content": "無論遭受什麼打擊也不放棄，這是老大的教導！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847206,
					"content": "根本不會有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
