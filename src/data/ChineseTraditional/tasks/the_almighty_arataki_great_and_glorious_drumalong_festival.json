				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "有什麼需要幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840302,
					"content": "關於即將舉辦的祭典。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "什麼？祭典？最近沒聽說要舉辦祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840304,
					"content": "二位能說得更詳細一些嗎？比如名字之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840305,
					"content": "名字是荒瀧極上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "荒瀧極上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840307,
					"content": "荒瀧極上盛世…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "是荒瀧派舉辦的荒瀧極上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840310,
					"content": "啊！是上次在容彩祭上搗亂的那個荒瀧派吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840311,
					"content": "#原來{F#妳}{M#你}們說的是那個三無活動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840312,
					"content": "三無活動？不是不是，你搞錯啦。是荒瀧極上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840313,
					"content": "#好了，不用強調這個名字，我大概知道了，總之我來告訴{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840314,
					"content": "前幾天我確實在這裡看到了荒瀧派的成員，他們在四處堆放一些毫無美感的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840315,
					"content": "#那個為首的傢伙，還聲稱要在這裡辦一場超過容彩祭的大型祭典，應該就是{F#妳}{M#你}們說的那個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840316,
					"content": "結果稍微查問了兩句，發現他們既沒有活動舉辦許可，也沒有場地租用憑證，更不用說事先應該去奉行所準備好的報批記錄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840317,
					"content": "這毫無疑問地明顯是三無活動。按照規定，我們只好強制他們停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840318,
					"content": "欸？強制停止！難道他們已經被抓起來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840319,
					"content": "那倒沒有，看在他們是沒有經驗，而且好歹準備了安全預案的份上。我們也只是對他們進行了簡單的教育。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840320,
					"content": "安全預案，這幫傢伙還是挺有安全意識的嘛...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840321,
					"content": "#如果{F#妳}{M#你}們在找荒瀧派，也許可以去甘金島看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840322,
					"content": "甘金島是社奉行給各種大小祭典常備的場地，初衷是為了培育各種來自民間的文化活動，手續和費用都是從簡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840323,
					"content": "我們把這個告知了荒瀧派的那幾位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840324,
					"content": "如果他們仍然想要舉辦活動的話，那裡是最合適的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840325,
					"content": "#唔...{NICKNAME}，雖然已經感覺不太可靠的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840326,
					"content": "但是，來都來了...所以我們還是去甘金島找找吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840308,
					"content": "荒瀧極上盛世豪鼓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
