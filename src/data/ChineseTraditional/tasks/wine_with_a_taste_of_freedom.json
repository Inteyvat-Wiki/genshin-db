			"dialogs": [
				{
					"id": 223030301,
					"content": "我先試試看吧，看能不能用璃月的釀酒法，來用一用這蒲公英。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030302,
					"content": "哦，這是給您的，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030303,
					"content": "我這拿蒲公英釀酒啊，可能會失敗很多次，蒲公英用完了，下次還得煩請您幫忙，可要請您多擔待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德貴"
				}
			]
		}
