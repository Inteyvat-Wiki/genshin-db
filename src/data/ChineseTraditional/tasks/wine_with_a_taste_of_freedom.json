					"德貴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "生意真是越來越難做了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "嗯？哦，我說我這家酒館的生意越來越難做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030104,
					"content": "我們這種管吃喝的店，開的時間長了有好有不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030105,
					"content": "好的是，時間長了總有名聲，名聲大了，自然有錢賺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030106,
					"content": "壞的就是，吃喝總是會膩的，要是鋪子大，品類多倒也沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030107,
					"content": "可是我這小酒館，又不是什麼大鋪面的大店…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030108,
					"content": "主顧們吃太長時間漸漸覺著膩味，來得也越來越少，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030109,
					"content": "我聽說，蒙德城的酒業也很發達。他們用蒲公英釀造的「蒲公英酒」很有名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030110,
					"content": "雖然不知道蒲公英到底能不能用來釀酒，但我也只能試試看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030111,
					"content": "#{F#妳}{M#你}能幫我去蒙德一趟，帶點蒲公英回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030112,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "#那就拜託{F#妳}{M#你}了，我會付{F#妳}{M#你}報酬的。我們璃月人，說到做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030114,
					"content": "蒲公英酒嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "怎麼？是酒的口味很怪嗎？我聽說，這種酒很受蒙德人歡迎啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030116,
					"content": "不過，我要只是照搬蒲公英酒的配方，肯定也賣不動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "德貴"
				},
				{
					"id": 223030117,
					"content": "您先把<color=#00E1FFFF>蒲公英</color>拿來吧，我再看看怎麼用璃月的法子來釀造釀造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德貴"
				}
			]
		},
