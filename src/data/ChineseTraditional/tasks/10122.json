			},
			"dialogs": [
				{
					"id": 101220301,
					"content": "嗯？為什麼要突然戴上面罩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220302,
						101220303
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220302,
					"content": "不想被陌生人看見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				},
				{
					"id": 101220304,
					"content": "對哦，就算他們實力強大，在蒙德這片土地上，我們的地位還是遠高於他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220305
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220305,
					"content": "#既然如此，的確不該那麼容易讓他們瞻仰到{F#妳}{M#你}的尊容，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220306
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220306,
					"content": "#還好{F#妳}{M#你}反應夠快。我還以為會露餡呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220307,
					"content": "#那我們繼續前進吧，我會向他們介紹，說{F#妳}{M#你}是我的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220303,
					"content": "這才符合貴族的禮儀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				}
			]
		},
		{
			"id": 1012204,
			"completionStepIds": [
				1012207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
