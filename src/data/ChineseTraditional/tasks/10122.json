	"talks": [
		{
			"id": 1012201,
			"completionStepIds": [
				1012201
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012201",
							"2"
						],
						"stepId": 1012201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"舒伯特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220101,
					"content": "（帳篷破破爛爛的，卻有一把看起來很不錯的椅子…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220102,
					"content": "（這也是貴族的禮節之一嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220103,
					"content": "#又是{F#妳}{M#你}們？唉，能不能不要來煩我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220104,
						101220106
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220104,
					"content": "聽說貴族向來寬宏大量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220105
					]
				},
				{
					"id": 101220105,
					"content": "「寬宏大量」…有點意思，沒錯，正是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220108,
					"content": "#好吧，我也絕非心胸狹隘之人，先前的小小不悅就既往不咎了。{F#妳}{M#你}若想進言，我就姑且一聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220109
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220109,
					"content": "（哇，這高高在上的姿態！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220110,
						101220112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220110,
					"content": "在那之前，請容我表達抗爭意志。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220111
					]
				},
				{
					"id": 101220111,
					"content": "#原來如此，同道中人，「抗爭」——即反抗無能的騎士團。{F#妳}{M#你}，深明大義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220114,
					"content": "#表現很不錯，我的本意就是對{F#妳}{M#你}自謙品格的試探。果然，{F#妳}{M#你}已經深諳此道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220115
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220115,
					"content": "（原來是試探？！這樣說話也太麻煩了吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220116,
					"content": "#嗯，禮數上是合格了。很難想像這麼短的時間，{F#妳}{M#你}們就有如此進步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220117
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220117,
					"content": "如此溫文明禮的遣詞造句，是從何處學來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220118,
						101220119
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220118,
					"content": "蒙受友人之慧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220120,
					"content": "不錯，不錯，聰慧有加，和蒙德的賤民相比，實在是可造之材。假若是出自貴胄血脈，則前途不可限量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220121
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220121,
					"content": "對了，我們還有禮物…呃，咳咳，小小禮物，不成敬意，還請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220122,
					"content": "啊，這個是…「醬菜煎肉」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220123
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220123,
					"content": "果然不是裝模作樣，是真的下了功夫。當今的年輕人，只要認真還是能做到嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220124
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220124,
					"content": "正好我很久都沒吃…不，我的意思是，既然到了用餐時間，那我就不客氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220125
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220125,
					"content": "啊，好香，還是原來的味道，一點都沒變。尤其是這股酸香，嗯——這就是貴族才能理解的享受啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220126
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220126,
					"content": "搞得我都有點好奇它的味道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220127,
					"content": "#好吧，我感受到{F#妳}{M#你}們的誠意了。如此誠懇，一定是有求而來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220128
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220128,
					"content": "聽說勞倫斯家有個大計畫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220129
					]
				},
				{
					"id": 101220129,
					"content": "連這都知道了嗎？這本來是我們家族的機密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220130,
						101220131
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220130,
					"content": "我想助你們一臂之力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220132,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220133
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220133,
					"content": "#好吧，看{F#妳}{M#你}禮數周全，想必是未來可期的人才，我願意給{F#妳}{M#你}充分的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220134
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220134,
					"content": "那麼跟我來吧，我們現在正需要更多的幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220135
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220135,
					"content": "要去什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220136
					]
				},
				{
					"id": 101220136,
					"content": "見見我們遠道而來的朋友，他們將會伸出援手，幫助勞倫斯家族重現榮光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220137
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220137,
					"content": "只是因為禮數周全，就完全相信我們了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220138,
						101220139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220138,
					"content": "我也覺得，小心一點吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220140,
					"content": "好了好了，跟上來，就什麼都知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220139,
					"content": "或許這也是舊貴族的「講究」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220131,
					"content": "我想為貴族獻上微薄之力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220119,
					"content": "經友人指點，泛讀經典，參悟而來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220112,
					"content": "此次面見，猶如沐浴在無上的光輝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220113
					]
				},
				{
					"id": 101220113,
					"content": "#原來如此，同道中人，「光輝」——即存續至今的貴族榮光。{F#妳}{M#你}，赤膽忠心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220106,
					"content": "請允許我斗膽一言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220107
					]
				},
				{
					"id": 101220107,
					"content": "「斗膽」…有點意思，聽到了一個很恰當的詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "舒伯特"
				}
			]
		},
		{
			"id": 1012202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012204",
							"2"
						],
						"stepId": 1012204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220201,
					"content": "（擺在有些破舊的帳篷前的豪華椅子，看起來實在很突兀。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220202
					],
					"speakerTitle": "觀察椅子"
				},
				{
					"id": 101220202,
					"content": "（這好像是舒伯特的鍾愛之物，不愧是舊貴族，在如此境況中也要保持優雅。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
