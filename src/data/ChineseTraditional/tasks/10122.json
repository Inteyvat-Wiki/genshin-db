				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220601,
					"content": "別碰我，閃開！我自己會走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220602
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220602,
					"content": "看起來是趕上了，這裡確實有很多愚人眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220603
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220603,
					"content": "#喔，是{F#妳}{M#你}，調查已經有收穫了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220604,
						101220605
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220604,
					"content": "完全不費工夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				},
				{
					"id": 101220606,
					"content": "難道，這傢伙的禮儀，全都是從妳那裡學的？妳不是從來都不把這些東西放在心上嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220607
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220607,
					"content": "而且，家族有規矩，這些東西是不可以教給外人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220608
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220608,
					"content": "哦，好像是有這麼一回事。然後呢？好像也沒有不能這麼做的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220609
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220609,
					"content": "妳…妳這是觸犯了家裡的大忌！害得我準備了好久的計畫，都泡湯了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220610
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220610,
					"content": "我知道叔父花了很大的力氣，但你也知道這是不該做的事。身為西風騎士，我沒有理由視而不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220611
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220611,
					"content": "還西風騎士，搞清楚！我是妳的叔父！妳是勞倫斯家族的人，應該幫助家族重獲榮光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220612
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220612,
					"content": "妳現在還有爭取原諒的機會，把這裡的西風騎士全都幹掉，跟我一起走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220613
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220613,
					"content": "那我就會在家裡為妳求情，給妳一個改過自新的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220614
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220614,
					"content": "我沒聽懂，你要西風騎士去幹掉西風騎士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220615
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220615,
					"content": "再重複一次，妳才不是什麼西風騎士，妳是我們家族的末裔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220616
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220616,
					"content": "妳是流著勞倫斯家族之血的貴族！應該要順應家族的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220617
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220617,
					"content": "…可是，從以前到現在，我什麼時候順應過家族的意志了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220618
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220618,
					"content": "妳、妳！妳這個大逆不道的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220619
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220619,
					"content": "真的要發脾氣的話，生氣的也應該是我才對。你明明是勞倫斯家族的一員，還在搞這種威脅蒙德安全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220620
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220620,
					"content": "你想過你給多少人添了麻煩嗎？你又想過，為了平息這次的事，我要和多少人結仇嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220621
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220621,
					"content": "妳在教訓我嗎？妳居然敢教訓我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220622
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220622,
					"content": "是的，我在教訓你。叔父，以你最看重的勞倫斯家族之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220623
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220623,
					"content": "我沒有經歷過你所說的「榮光」的時代，也不理解家族對此狂熱的追求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220624
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220624,
					"content": "但我有能力判斷是非對錯，也深知「自由」對蒙德人的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220625
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220625,
					"content": "——勞倫斯家族不會，也不應該變成你心中的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220626
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220626,
					"content": "唔，唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220627
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220627,
					"content": "家門不幸！家門不幸啊！家裡怎麼出了妳這麼一個大逆不道的怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220628
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220628,
					"content": "看上去一副歇斯底里的樣子。總是掛在嘴邊的禮貌和優雅，完全不見了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220629,
					"content": "不太明白你在吵什麼。麻煩兩位把他帶走吧，我和榮譽騎士，接下來還有事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220630
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220630,
					"content": "#既然{F#妳}{M#你}們動手了，就說明已經掌握決定性的證據了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220631,
						101220632
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220631,
					"content": "愚人眾手上有一張城防圖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220633,
					"content": "我偷偷看了一眼，妳的叔父靠觀察和繪畫，把西風騎士的巡邏路線，還有其他好多資訊，都標記出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220634,
					"content": "唉，原本覺得他只是個不務正業的長輩，沒想到在這種事上，居然這麼執著。這個仇我也記下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220635
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220635,
					"content": "剩下的話晚點再說吧，我們要先把那張圖搶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220632,
					"content": "愚人眾在計劃危險的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220605,
					"content": "進展太快了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				}
			]
		},
		{
			"id": 1012207,
			"completionStepIds": [
				1012214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012214",
							"2"
						],
						"stepId": 1012214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"優菈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220701,
					"content": "就是這個，不過不知道他們有沒有趁這個機會製作備份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220702
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220702,
					"content": "不過，如果沒有叔父當他們的傀儡，就算攻打蒙德也沒有什麼好處吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220703
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220703,
					"content": "愚人眾應該不至於一定要依靠妳的叔父吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220704,
					"content": "的確，但如果不是想要靠扶持傀儡來接管蒙德，單純只是進攻，就沒必要繞這個圈子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220705
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220705,
					"content": "就算愚人眾很不老實，也不至於現在就要對外開戰，那樣的話他的對手可不止蒙德一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220706,
						101220707
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220706,
					"content": "我也是這麼想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				},
				{
					"id": 101220708,
					"content": "總之，這層隱憂我也會告訴代理團長，她會妥善處理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220709
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220709,
					"content": "對了，妳為什麼會跟來呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220710
					]
				},
				{
					"id": 101220710,
					"content": "對耶，妳出現的時機也太巧了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220711,
					"content": "這個嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220712
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220712,
					"content": "#因為一開始{F#妳}{M#你}擊敗了我追蹤的愚人眾，搶了我的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220713
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220713,
					"content": "#所以現在我就來報仇了，既然{F#妳}{M#你}搶了我的功勞，那我一定要搶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220714,
						101220715
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220714,
					"content": "原來那張圖就是妳的「復仇」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220716,
					"content": "嘿嘿，經過這麼長時間，我終於能聽懂妳說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220717,
					"content": "其實妳只是隱約察覺到，我們這邊可能會有事發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220718,
					"content": "擔心我們，又擔心妳的叔父，所以就帶著小隊過來看看，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220719,
					"content": "是報仇，不要曲解我的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220720
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220720,
					"content": "哼，妳這小傢伙，看起來不太機靈，心機真的不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220721
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220721,
					"content": "這個仇我記下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220722
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220722,
					"content": "看起來不太機靈是什麼意思啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220723,
					"content": "#{F#妳}{M#你}們兩個，這次我們算是結下深仇大恨了，給我等著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220724
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220724,
					"content": "#就算{F#妳}{M#你}們化成了灰，我也絕對不會忘記{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220725
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220725,
					"content": "那我們就是「仇人」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220726
					]
				},
				{
					"id": 101220726,
					"content": "放馬過來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220727,
					"content": "哈哈哈，就是這個氣勢。那我就帶著圖紙回騎士團了，接下來的事，都交給我處理就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220728
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220728,
					"content": "嗯嗯，我們有機會再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220729,
					"content": "當然會再見的，下次我們見面的時候，可不要讓我失望了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 101220715,
					"content": "那我們扯平了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220707,
					"content": "那就本末倒置了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				}
			]
		},
