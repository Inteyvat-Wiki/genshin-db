					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010404,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010405,
					"content": "你們別吵了，吵了這麼久不累嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010406,
					"content": "只是玩個遊戲，別這麼生氣，大家都是朋友呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010407,
					"content": "喏，新摘的蓮蓬，快點吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010408,
					"content": "吃完了之後，我們再好好商量一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010409,
					"content": "排好誰做船長，誰做服務員的順序，不就好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010410,
					"content": "好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010411,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010412,
					"content": "真的安靜下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220010413,
					"content": "怎麼樣，我就說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010414,
					"content": "妳怎麼知道要這麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "我們一起玩了很久，我當然知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010416,
					"content": "璐璐真厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}，北斗姐姐才厲害呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010418,
					"content": "我長大之後，也能成為她那樣的人嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				}
			]
