				"points": []
			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "小蒙，今天總輪到我做船長了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010102,
					"content": "璐璐，我已經連著好幾天做船長了，也該阿飛扮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010103,
					"content": "可是我覺得小蒙的船長扮得很好呀，我想你接著做船長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010104,
					"content": "你們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "#{F#大姐姐}{M#大哥哥}，我們在玩遊戲。本來說好了這次輪到我做船長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010106,
					"content": "可是璐璐總是說，小蒙扮船長的時候更好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010107,
					"content": "唉，璐璐總是這樣…不過，她覺得這樣好的話，那就這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010108,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}有空再扮一次海盜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010109,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "結果，我這次還是個服務生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010113,
					"content": "#就和上次一樣，{F#大姐姐}{M#大哥哥}準備好了之後，就過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010111,
					"content": "我想做個好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "哎呀，我還想做船長呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "阿飛"
				}
			]
		},
		{
