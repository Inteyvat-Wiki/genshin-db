			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "#就是這！船長在這了，{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010302,
					"content": "你怎麼把海盜帶過來了啊！你不是應該帶著海盜到處繞圈，然後我帶著璐璐跑掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010303,
					"content": "憑什麼你陪著璐璐跑，我就要在這拖住海盜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010304,
					"content": "那我直接把你交給海盜，我不是一樣可以帶著璐璐跑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010305,
					"content": "你…北斗姐姐說了，不可以隨便出賣朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010306,
					"content": "那北斗姐姐說船長就應該帶著人跑嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010307,
					"content": "你…我再也不把蓮蓬分給你吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220010308,
					"content": "不吃就不吃！誰稀罕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220010309,
					"content": "他們怎麼就吵起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220010310,
					"content": "#{F#大姐姐}{M#大哥哥}，不用擔心，我有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010311,
					"content": "他們最喜歡吃蓮蓬了，有好吃的東西，他們絕對會安靜下來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010312,
					"content": "#{F#妳}{M#你}能幫我去找點蓮蓬回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010313,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}，請快去快回呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010315,
					"content": "他們最喜歡的應該不是蓮蓬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "#唔…{F#大姐姐}{M#大哥哥}在說什麼呢？那他們最喜歡什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220010317,
					"content": "總之，請先找點蓮蓬來吧，總不能讓他們總是這麼吵呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				}
			]
		},
