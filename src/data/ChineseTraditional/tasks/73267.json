					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670802,
					"content": "居、居然跑得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670803,
