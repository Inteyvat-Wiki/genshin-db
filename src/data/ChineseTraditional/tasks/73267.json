			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿提亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "加入鍍金旅團！擁抱美好生活！這位朋友，有沒有興趣瞭解一下我們鍍金旅團啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670102,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "#咳，{F#妳}{M#你}聽我說啊。鍍金旅團可是個好地方，自由！團結！友好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670104,
					"content": "而且還能讓住在樹上的那些傢伙從腰包裡拿錢出來。教令院的學者們都很有錢的，絕對不會拖欠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670105,
					"content": "我已經加入冒險家協會了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "呃…冒險家協會…那…那也沒衝突嘛！這年頭誰沒有兼職，而且冒險家和傭兵感覺上也、也差不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670108,
					"content": "還是差很多的啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "唉，不過我們的伙食也很好啊，時不時就有魚有肉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670110,
					"content": "#而且如果{F#妳}{M#你}運氣好的話，甚至能和那位「熾鬃之獅」迪希雅說上話呢！我…咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670111,
					"content": "你喝點水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "呼…呃…抱歉抱歉，剛才說太急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670114,
					"content": "好不容易有個人願意聽我宣傳，我太激動了一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670115,
					"content": "#不過，{F#妳}{M#你}真的不考慮加入鍍金旅團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670116,
					"content": "暫時沒這打算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "#好吧，既然{F#妳}{M#你}都這麼說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670119,
					"content": "你一直在這裡招人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "是啊，這是我的工作嘛。這年頭哪裡都缺人，我們傭兵這行更是格外缺人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670121,
					"content": "#唉…跟{F#妳}{M#你}說應該沒什麼關係。{F#妳}{M#你}看著我們鍍金旅團人多，但傭兵這行太危險了啊，護送商隊這類的工作還好，頂多累了點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670122,
					"content": "但要是出一趟和學者們有關的工作，那真是全程都把腦袋提在手上，跑一趟工作回來，只要不是斷手斷腳就謝天謝地了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670123,
					"content": "正常的兄弟跑完這種工作回來，少說也要休息十天半月，那他的這個空缺就要有人補上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670124,
					"content": "須彌這麼大，學者這麼多，每天都不斷地有新工作進來，我們幾乎都在連續運轉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670125,
					"content": "再不招一點人，我們真的是要撐不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670126,
					"content": "那你招到人了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "#{F#妳}{M#你}說這個村子嗎？哈哈…一個人都沒招到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670128,
					"content": "呃…也不能說是沒招到吧，只能說，想招的人不想來，想來的人不能招…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670129,
					"content": "#{F#妳}{M#你}要是不信，就跟著我走一圈吧…說不定走完這一趟，{F#妳}{M#你}就願意加入我們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670130,
					"content": "#…哎呀，開個玩笑嘛，{F#妳}{M#你}都說了不想加入了，我也不會勉強{F#妳}{M#你}。我就是想找個人陪我到處走走而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670132,
					"content": "陪你走走倒是沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "#嘿嘿，謝謝{F#妳}{M#你}啦。我看看啊，這個…我們先去找薩尼婭好了，她白天應該有空，晚上嘛…她還要忙著和傑巴里討論生活大事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670117,
					"content": "冒險家協會的事就夠多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "你這套說得好熟練啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "我已經有很多委託要做了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
