			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩尼婭",
					"阿提亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "真讓人煩惱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670302,
					"content": "薩尼婭！午安啊，妳在選什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670303,
					"content": "阿提亞…我都說過了，傑巴里對鍍金旅團沒什麼興趣，我也不想他去做什麼傭兵，你就別想著讓我幫你說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670304,
					"content": "哎呀，傑巴里的廚藝那麼好，去鍍金旅團裡一定能混個好職位，你們家的收入也會好很多啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670305,
					"content": "而且他不也說過，想要外出找點工作嗎？如果他真想外出工作，有我這個熟人介紹當然是最好的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670306,
					"content": "你就聽他說吧，他隔一段時間就會說一次這種話，過幾天就再反悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670307,
					"content": "說到最後，他就是捨不得我一個人待在村裡…我也捨不得他一個人出去打拼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670308,
					"content": "更何況，是每天都去玩命的傭兵！所以你就別想了，就算傑巴里想去，我也會阻止他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670309,
					"content": "好了，話就說到這裡，我還要買東西呢，你去找別人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "薩尼婭"
				},
				{
					"id": 732670310,
					"content": "#呼…好吧。旅行者，{F#妳}{M#你}看見了吧，這就是我每天工作的狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670311,
					"content": "我們接下來去找福迪爾吧，他…曾經是我們的人，但後來退出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670312,
					"content": "要是我能把他勸回來，那就再好不過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亞"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福迪爾",
					"阿提亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "阿提亞，你怎麼又來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670502,
					"content": "嘿嘿，百折不撓是我們鍍金旅團的優良品質嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670503,
					"content": "那你也應該知道，堅持原則更是我的處事方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670504,
					"content": "福迪爾大哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670505,
					"content": "我已經退出鍍金旅團了，你不用這麼稱呼我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670506,
					"content": "唉，福迪爾先生。你真的不考慮回去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670507,
					"content": "雖然有些兄弟的作風是有點…呃…輕率，但還是有很多兄弟遵紀守法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670508,
					"content": "阿提亞，我說過了，我不會再回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670509,
					"content": "你說的那些事情，我都已經用我自己的眼睛確認過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670510,
					"content": "也許鍍金旅團裡不全是目無法紀之人，也不是每個鍍金旅團成員都喜歡做那些趁火打劫的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670511,
					"content": "但阿提亞…惡行會傳播。只要有一個人違法亂紀，那他周圍的人就會受到影響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670522,
					"content": "一個人影響一群人，那一群人再不斷地開展行動，對更多人造成影響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670523,
					"content": "阿提亞，這種情況你應該比我更清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670512,
					"content": "在這種氛圍裡…惡行易施啊，阿提亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670513,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670514,
					"content": "你想勸我回去，我也想勸你離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670515,
					"content": "也許在你眼裡，鍍金旅團這個團體雖然稱不上有道德，但也不能算是惡劣…但人不能永遠生活在灰色地帶裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670516,
					"content": "…這只是我對你的忠告。到底要怎麼做，還需要你自己做出決斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670517,
					"content": "我知道，福迪爾大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670518,
					"content": "嗯。如果你真的退出了…同時也想謀個生計，我會幫你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "福迪爾"
				},
				{
					"id": 732670519,
					"content": "你沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "哈哈哈，我就是辯不過福迪爾大哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670521,
					"content": "接下來…哈哈，我們先回去休息一下吧，說了這麼多話，我喉嚨都痛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亞"
				}
			]
		},
