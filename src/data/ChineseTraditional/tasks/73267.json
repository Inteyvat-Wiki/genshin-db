				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "阿提亞叔叔！你還在招募人加入鍍金旅團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670602,
					"content": "艾登，妳怎麼又跑出來了，你跟媽媽說過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670603,
					"content": "說過啦！媽媽在工作，我就自己來找卡里瑪玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670604,
					"content": "你好呀，阿提亞叔叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670605,
					"content": "阿提亞叔叔，我上次跟你說的事，你覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670606,
					"content": "我一直都在鍛煉，還和卡里瑪一起訓練了很久…她都已經快要跑不過我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670607,
					"content": "誰跑不過妳了，我只不過是那天午餐沒有吃飽而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670608,
					"content": "總之，我可是按照你制定給我的計畫訓練了好久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670609,
					"content": "阿提亞叔叔，你今天再幫我測試一下吧！看看我夠不夠格加入鍍金旅團！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670610,
					"content": "這就是你說的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "咳…好！艾登，今天我就以鍍金旅團成員的身分，再次對妳進行測驗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670613,
					"content": "好耶！卡里瑪，妳也來測測看吧，我們一起加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670614,
					"content": "我可不想加入鍍金旅團，我只想留在村裡，好好保護大家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670615,
					"content": "不過…讓阿提亞叔叔幫我測驗一下也不錯，我可是向坎蒂絲姐姐請教過鍛煉方法的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670616,
					"content": "欸？！妳什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670617,
					"content": "哈哈哈，妳們兩個這麼有活力，很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670618,
					"content": "艾登，妳也不要嘟著嘴了，有機會的話，我也帶著妳去向迪希雅請教鍛煉方法，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670619,
					"content": "真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670620,
					"content": "鍍金旅團成員說的話，絕對是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670621,
					"content": "不過，今天我們在開始測驗之前，就先讓這位旅行者來示範一下標準動作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670622,
					"content": "還有我的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "#…之前我可沒機會示範啊。我總不可能自己跑去示範，然後把這兩個孩子單獨留在這裡吧，那樣也太危險了…這次就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670626,
					"content": "咳，這位旅行者是一位實力強勁的冒險家，我可是好不容易才請過來為妳們示範的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670627,
					"content": "艾登、卡里瑪，妳們兩個要看好了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670628,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "艾登"
				},
				{
					"id": 732670629,
					"content": "冒險家…是冒險家協會裡的那種人嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "卡里瑪"
				},
				{
					"id": 732670630,
					"content": "無論是傭兵還是守衛，在執行任務的時候，都會遇見某些必須先行撤退的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670631,
					"content": "這個時候，我們往往就需要…跑得越快越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670632,
					"content": "#旅行者，就拜託{F#妳}{M#你}了，我們先來演練一下…嗯…迅速撤退的方法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670633,
					"content": "#起點就在那裡，就拜託{F#妳}{M#你}進行示範了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670624,
					"content": "你之前沒示範過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "…我之前還得分心照顧這兩個孩子，怎麼可能去示範什麼標準動作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670634,
					"content": "#…總之，這次就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "阿提亞"
				},
				{
					"id": 732670611,
					"content": "想來的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
