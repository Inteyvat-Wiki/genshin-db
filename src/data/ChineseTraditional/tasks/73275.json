			"dialogs": [
				{
					"id": 732750501,
					"content": "關於歌謠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "#{F#妳}{M#你}還記得這首歌謠啊…又有一個年輕人記住了它，呵呵，是好事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750503,
					"content": "「薔薇啊薔薇，實現我的願望。花從石頭中綻放，金薔薇對我歌唱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750504,
					"content": "「沒有土地承載我，唯有歌謠承載我。歌謠戰勝敵視我的命運，戰勝我的結局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750505,
					"content": "「戰勝我戰勝時間，戰勝永不消逝的消逝…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
