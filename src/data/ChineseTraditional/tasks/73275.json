			"dialogs": [
				{
					"id": 732750102,
					"content": "種出了金薔薇花苗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "#這些…欸喲，{F#妳}{M#你}這小孩是在哪裡找到這些種子的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750104,
					"content": "在很遠的地方撿到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "沙法卡特叔叔撒下的種子還真是去到了沙漠的各個角落，不過最後兜兜轉轉又回到這裡來囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750107,
					"content": "這些花苗要小心照顧啊，我要全部留給賽芭那孩子。等到我也不在了，這些花就交給她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750108,
					"content": "#孩子，謝謝{F#妳}{M#你}，我沒什麼好東西給{F#妳}{M#你}，就把這些果子和花送給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
