						732750308
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750308,
					"content": "#{F#妳}{M#你}幫了我這個老頭的大忙，雖然{F#妳}{M#你}這孩子沒跟我要報酬，不過我要是不給的話，心裡會過意不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750309,
					"content": "#這株花苗最近剛剛破土，賽芭提議把它送給{F#妳}{M#你}，還費心把它裝了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732750310,
					"content": "#我們把它當作紀念送給{F#妳}{M#你}，希望{F#妳}{M#你}像它一樣堅韌，永遠不喪失信心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
