			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂蕾娜",
					"昂吉安妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745180101,
					"content": "嗯…對敵人的強硬支撐點開展進攻時，機動組的路徑選擇和守衛組的配合調度，的確值得深入研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180102
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180102,
					"content": "#主要還是{NICKNAME}指揮得太離譜，根本不按常理出牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180103,
						745180104
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180103,
					"content": "看來妳們有靈感了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180105
					]
				},
				{
					"id": 745180105,
					"content": "的確！如您所見，主攻部隊一旦展開，短時間內很難脫離接觸，這個時候，掩護側方、截斷敵方增援的兵力就顯得至關重要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180106
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180106,
					"content": "但在兵力有限的情況下，分出多少單位去抵禦，一直是個難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180107
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180107,
					"content": "哎呀…人多了有可能削弱主力，人少了可能沒法形成遮斷，每次行動派多少人去抵禦，誰都說不準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180108,
					"content": "按照慣例，特巡隊會以約四分之一主攻部隊的兵力組成抵禦力量，在敵方潛在增援到來的方向上巡邏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180109
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180109,
					"content": "一般情況下，這樣安排就夠用了，但也出現過邪門的情況…抵禦部隊那邊悠閒散步沒敵人來，主力反倒缺人打得氣喘吁吁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180110,
					"content": "而您，準領隊，您有時會將主力部隊機動組的進攻路徑安排得萬分巧妙，與抵禦部隊相互照應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180111
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180111,
					"content": "如此一來，主力部隊機動組和抵禦部隊可以在適合的時機互相支援，最大程度利用兵力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180112
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180112,
					"content": "進攻受阻時，抵禦部隊就適當輔助機動組，敵方強大增援來襲時，機動組也可以就地與抵禦組一同對其攔截，堪稱攻守一體！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180113,
						745180114
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180113,
					"content": "被發現了？不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180115
					]
				},
				{
					"id": 745180115,
					"content": "總之，正是在您這樣靈活的調度下，曾經難倒過昂吉安妮教官的第三個進攻想定，對您來說完全不在話下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180116
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180117
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180117,
					"content": "好吧好吧，我輸了！晚點就把那幾組競賽彈藥送給妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745180118,
					"content": "嘿！這次我贏得理所當然，就不跟教官客氣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180119
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180119,
					"content": "夏沃蕾隊長同款的限量競賽彈頭，超高的精度和遠距離存速…啊哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180120
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180120,
					"content": "呃咳！言歸正傳，我早就感覺到準領隊對銃槍有興趣了。之前我去問了幾位同僚，搞清楚了必要的申請條件，您完全符合要求！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180121
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180121,
					"content": "下次等您有時間，我們找個機會，走完相關流程、測好關鍵數值，幫您訂製一把專用的銃槍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745180114,
					"content": "是這樣嗎？我隨便打的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180115
					]
				},
				{
					"id": 745180104,
					"content": "我打出了值得研究的案例？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180105
					]
				}
			]
		}
	]
}