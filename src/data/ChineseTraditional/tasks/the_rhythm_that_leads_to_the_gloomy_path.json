			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭耶娑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730690301,
					"content": "我們又見面啦！蘭羅摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690302,
					"content": "#喔！那菈{NICKNAME}和派蒙，{F#妳}{M#你}們好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690303
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690303,
					"content": "嗯。他是蘭耶娑。我們尋找覺樹之堂的時候，在這裡遇到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690304
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690304,
					"content": "蘭耶娑你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690305,
					"content": "你好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690306
					]
				},
				{
					"id": 730690306,
					"content": "#「接下來唱的是…一位{M#小姐}{F#少年}，追尋至珍之物的詩。在旅途開始時，{M#她}{F#他}雙眸的顏色是沒有一絲陰霾的琥珀…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690307
					],
					"speakerTitle": "蘭耶娑"
				},
				{
					"id": 730690307,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690308,
						730690309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690308,
					"content": "感覺怪怪的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				},
				{
					"id": 730690310,
					"content": "嗯。蘭耶娑是「採歌者」，經常去收集各種各樣的歌曲。蘭耶娑他是採歌的蘭那羅裡膽子最大的，所以會經常學到那菈的詩歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690311
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690311,
					"content": "「我們的宿命，是一同誕生的珍珠…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690312,
						730690313
					],
					"speakerTitle": "蘭耶娑"
				},
				{
					"id": 730690312,
					"content": "完全沒辦法交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690316
					]
				},
				{
					"id": 730690316,
					"content": "言歸正傳…這裡就是覺樹之堂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690317,
					"content": "啊。不是的，但這也是很厲害的發現。在這裡，沉睡著很多年沒有蘭那羅找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690318
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690318,
					"content": "蘭那羅的採歌者，會一直一直追求歌的美麗。所以，在時間的最後，會把只屬於自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690319,
						730690321
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690319,
					"content": "那和覺樹之堂有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690320
					]
				},
				{
					"id": 730690320,
					"content": "嗯！這邊似乎是蘭拉吉留下的歌。如果是這樣的話，附近應該就有莎蘭樹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690323,
					"content": "莎蘭樹…之前蘭拉迦好像說過，就是那個什麼來著，我看看森林書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690324,
					"content": "#莎蘭樹！就是能結出恆素果的莎蘭樹！我們也幫忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690325,
					"content": "「啊啊，這份思念，會結出像石榴一樣血紅的果實。即使命運將你的雙眼蒙上…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690326,
						730690327
					],
					"speakerTitle": "蘭耶娑"
				},
				{
					"id": 730690326,
					"content": "既然是幫助拉娜所需要的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690331
					]
				},
				{
					"id": 730690331,
					"content": "嗯，總之，在那些玫瑰當中，隱藏著歌曲。唔…但是，我和蘭耶娑看了好久好久，都沒找到。那些玫瑰，也不和我們說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690332
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690332,
					"content": "#原來如此…{NICKNAME}，我們也調查一下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690333,
						730690335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690333,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690334
					]
				},
				{
					"id": 730690334,
					"content": "嗯！找東西嘛，我們很擅長的，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690335,
					"content": "「我會點亮你的詩。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690336
					]
				},
				{
					"id": 730690336,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690327,
					"content": "「也無法奪走唇邊的歌…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690328
					]
				},
				{
					"id": 730690328,
					"content": "#噫——{NICKNAME}，{F#妳}{M#你}在幹什麼啦！好奇怪喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690329,
					"content": "#那菈{NICKNAME}應該和蘭耶娑很合得來呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690330
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690330,
					"content": "#不要鼓勵{M#他}{F#她}啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690321,
					"content": "祝你們好運。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690322
					]
				},
				{
					"id": 730690322,
					"content": "#嗯！謝謝那菈{NICKNAME}。這邊似乎是蘭拉吉留下的歌。如果是這樣的話，附近應該就有莎蘭樹了。運氣很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690323
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690313,
					"content": "「啊啊，那罪惡般甜蜜的宿命。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690314
					]
				},
				{
					"id": 730690314,
					"content": "#噫——{NICKNAME}，快停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730690315,
					"content": "#那菈{NICKNAME}好厲害！和蘭耶娑的歌一樣，完全聽不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730690316
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730690309,
					"content": "是吟遊詩人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730690310
					]
				}
			]
		},
