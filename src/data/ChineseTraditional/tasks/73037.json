			"dialogs": [
				{
					"id": 730370401,
					"content": "取得了「惟耶之實」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730370402
					]
				},
				{
					"id": 730370402,
					"content": "終於拿到手了，珍貴的惟耶之實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370403,
						730370405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370403,
					"content": "真不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370404
					]
				},
				{
					"id": 730370404,
					"content": "嗯。之後，帶給拉娜就行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370406,
					"content": "#…{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730370405,
					"content": "帶給拉娜就行了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370406
					]
				}
			]
		},
		{
