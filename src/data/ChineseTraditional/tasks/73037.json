	"talks": [
		{
			"id": 7303701,
			"completionStepIds": [
				7303703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303703",
							"2"
						],
						"stepId": 7303703,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PLAYER_CHOOSE_MALE",
						"rawParams": [
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭羅摩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370101,
					"content": "這到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370102,
					"content": "那就是上一次戰爭結束的地方。我們…他們在這裡壓制了無留陀的化身，然後設下四重的封印，將它囚禁在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370103
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370103,
					"content": "真可怕…無留陀的化身，就在這裡面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370104,
					"content": "無留陀已經侵蝕了本應生長在它之上的莎蘭樹，以此受肉再次獲得了形象。如果置之不理，它終究會侵蝕地上一切的生命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370105
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370105,
					"content": "現在的它力量還不完全。要消滅無留陀化身的話，現在就是最好的時機。戰勝它之後，我們就能取得惟耶之實了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370106
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370106,
					"content": "#那菈{NICKNAME}、派蒙，我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370107
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370107,
					"content": "蘭羅摩說話的風格好像又變回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7303702,
			"completionStepIds": [
				7303708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303708",
							"2"
						],
						"stepId": 7303708,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭羅摩",
					"派蒙",
					"蘭拉娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370201,
					"content": "#我們消滅了無留陀的化身。森林也會安寧一些吧。雖說「我們」，但主要依靠的是{F#妳}{M#你}的努力、{F#妳}{M#你}的勇氣。謝謝{F#妳}{M#你}，那菈{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370202,
						730370205
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370202,
					"content": "多虧了花冠和大家的支持…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370203,
						730370204
					]
				},
				{
					"id": 730370203,
					"content": "讓我有不放棄的勇氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370207,
					"content": "每一朵花，都連接著一顆蘭那羅小小的心。而將所有的花朵編製成的花冠，說它是「瑪哈桓那{RUBY#[D]蘭那羅的宇宙}蘭那薜那」的門扉也不過分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370208
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370208,
					"content": "#所以，我們能與{F#妳}{M#你}心意相通，在{F#妳}{M#你}感到痛苦時為{F#妳}{M#你}聲援，將力量借給{F#妳}{M#你}，抵擋噩夢，幫助{F#妳}{M#你}戰勝黑暗的時日，填補心中的虛空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370209
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370209,
					"content": "不再夢想、見不到我們的人；接受命運，不再前進的人；沉醉於恐懼與痛苦的人；他們內心已經變得堅硬，無法獲得花的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370210
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370210,
					"content": "#正因為那菈{NICKNAME}是正直而善良的人，正因為那菈{NICKNAME}是那菈{NICKNAME}，花冠才能發揮作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370211
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370211,
					"content": "#那菈{NICKNAME}是蘭那羅的友人。所以，我們不會讓你獨自承擔面對無留陀、消滅邪惡，讓世界變得明亮而純潔的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370212
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370212,
					"content": "#畢竟，{NICKNAME}是我最好的夥伴，當然是最好的人！這樣一來，死域的問題就徹底解決了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370213,
					"content": "消滅無留陀的化身後，無留陀也會再度陷入沉睡吧。過幾十年，或者幾百年，遲早會再度甦醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370214
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370214,
					"content": "因為沙恆當中已經有了無留陀的記憶。除非能將其完全消除，否則萬物當中對「死」的記憶，終究會讓它再度復甦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370215
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370215,
					"content": "#…但那是很久以後的事情了。將來一定也會有像那菈{NICKNAME}與那菈法留納那樣，像太陽一樣金燦燦的人，我不擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370216
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370216,
					"content": "如今的森林有著明媚的未來。森林的孩子們會獲得充足的陽光與雨露，只要消滅殘存的無留陀就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370217
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370217,
					"content": "唔…不管怎麼說，既然消滅了無留陀的化身，那接下來應該就是種下覺王樹與惟耶之實了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370218,
					"content": "#嗯。{F#妳}{M#你}們等我片刻，我去將蘭拉娜叫來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370219
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370219,
					"content": "蘭拉娜…對喔，要用蘭拉娜的記憶，才能結出惟耶之實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370220,
					"content": "不過，蘭拉娜不是在維摩莊附近嗎？要怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370221,
					"content": "消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370222,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370223,
					"content": "#那菈{NICKNAME}、派蒙。蘭拉娜感覺到，{F#妳}{M#你}們和無留陀的化身戰鬥。{F#妳}{M#你}們和蘭羅摩，充滿了勇氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370224,
						730370227
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730370224,
					"content": "你們是怎麼從這麼遠的地方過來的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370225
					]
				},
				{
					"id": 730370225,
					"content": "我獲得了蘭穆護昆達的記憶，所以也明白怎麼利用沙恆在森林中快速旅行。這個蘭迦拉梨就叫「傳送」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370226
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370226,
					"content": "蘭羅摩好厲害，蘭穆護昆達的記憶交給你，一定也很開心。蘭拉娜好久好久沒有「傳送」過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370228
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730370228,
					"content": "接下來應該是種出新的覺王樹吧？記得蘭羅摩提到過「種子」的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370229,
					"content": "種子會明白要茁壯成長，變成大樹，然後結出飽滿的果實…謝謝你，蘭羅摩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370230
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730370230,
					"content": "嗯。我會長成新的覺王樹，然後將你的回憶與夢結成惟耶之實，用我的樹根，將被無留陀侵蝕的夢之間的橋樑重新連上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370231
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370231,
					"content": "你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370232,
						730370234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370232,
					"content": "蘭羅摩就是種子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370233
					]
				},
				{
					"id": 730370233,
					"content": "我吸收了恆素果、覺王樹與蘭穆護昆達的記憶與力量，現在森林裡沒有比我更強壯的「種子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370236,
					"content": "咦？我不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370237,
					"content": "原本我打算透過自己的眼睛、自己的身體，去累積只屬於自己的記憶，過幾十年、幾百年以後，再回歸土地，長成美麗的莎蘭樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370238
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370238,
					"content": "#如果不是{F#妳}{M#你}們，我就也不會有此殊榮，能一同消滅無留陀的化身、治癒森林，也無法累積如此多的記憶，成為莎蘭樹中的王者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370239
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370239,
					"content": "啊，難道…覺樹之堂的莎蘭樹，也是蘭那羅變成的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370240,
					"content": "他們是蘭拉吉、蘭雅瑪、蘭瑪哈。而恆素果則是他們的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370241
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370241,
					"content": "那，蘭羅摩變成樹的話，就不能跑來跑去，也不能說話、不能唱歌了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370242,
					"content": "#雖然身為種子在地上行走的時間有些短暫，不過與{F#妳}{M#你}們一同度過的時間，比過往要充實數十倍，不，數百倍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370243
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370243,
					"content": "怎麼會這樣…我還想和蘭羅摩一起玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370244,
					"content": "#這樣啊。我明白，派蒙，妳和那菈{NICKNAME}是我的朋友，這點永遠也不會變…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370245
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370245,
					"content": "獲得了如此的記憶與力量後，我能夠從沙恆中見到許多景象、聽到許多故事。讓我跟妳說個故事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370246
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370246,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370247,
					"content": "隱蔽在金色的沙暴當中的永恆綠洲，其中沒有任何生命。沒有蘭那羅有幸面見的，一切草木最古老的主宰，蟄伏在黃沙之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370248
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370248,
					"content": "曾經覆蓋它的綠植也全都枯死，變成了無法把握的細沙。正如無留陀所悄聲說的：一切美好的，終於會死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370249
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370249,
					"content": "但是，你要知道，儘管夜晚如此黑暗，其中也總會有星星閃耀；太陽也一定會升起。就算死渴求著主宰一切，生命也不會消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370250
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370250,
					"content": "正如落入大地的黃葉將會成為萃華樹的養料，而它的果實將養活馱獸、狐狸、林豬，而它們又將養活長鬢虎。森林中充滿了生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370251
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370251,
					"content": "毒血曾經染黑大地。蘭那羅與那菈一樣，以為一切都將要結束，但現在關於它的記憶已經消失了。森林比樹王的時代更加繁茂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370252
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370252,
					"content": "最終留下的都是美好的；就算別離，也終將會在沙恆中相會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370253
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370253,
					"content": "終有一天，我的夢與妳的夢、我的記憶與妳的記憶，我們將會交錯在一起，在沙恆的無數枝杈上開花，這又何嘗不是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370254
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370254,
					"content": "嗯…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370255,
					"content": "派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370256
					]
				},
				{
					"id": 730370256,
					"content": "嗯。嗯…我知道啦！蘭羅摩，你是最好的「種子」，所以一定能長成又大又漂亮的樹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370257,
					"content": "#所以、所以，就算變成了樹，也不要忘記我、不要忘記{NICKNAME}，不要忘記我們一起的冒險哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370258,
						730370259,
						730370260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730370258,
					"content": "謝謝你，蘭羅摩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370261,
					"content": "#嗯。謝謝{F#妳}{M#你}們，派蒙、那菈{NICKNAME}。很高興認識{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370262
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370262,
					"content": "蘭拉娜，我一定會將你的記憶，結成最美麗最飽滿的惟耶之實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370263
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370263,
					"content": "我相信你，蘭羅摩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730370259,
					"content": "再見，蘭羅摩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370260,
					"content": "這樣就結束了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370234,
					"content": "你們在說什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370235
					]
				},
				{
					"id": 730370235,
					"content": "我就是覺王樹的種子。我吸收了恆素果、覺王樹與蘭穆護昆達的記憶與力量，現在森林裡沒有比我更強壯的「種子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730370227,
					"content": "接下來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370228
					]
				},
				{
					"id": 730370204,
					"content": "讓我有站起來的力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370205,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370206
					]
				},
				{
					"id": 730370206,
					"content": "#剛剛真是千鈞一髮…{NICKNAME}戴著花冠，真是太好了！這個花冠好神奇呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370207
					],
					"speakerTitle": "派蒙"
				}
			]
		},
