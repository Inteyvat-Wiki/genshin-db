			"dialogs": [
				{
					"id": 730350401,
					"content": "覺王樹中間好像在發光…那就是惟耶之實嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350402,
					"content": "哎呀，真是不容易，這些終於能讓拉娜恢復了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350404,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350405,
					"content": "蘭羅摩，你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350408,
					"content": "#覺王樹已經被無留陀侵蝕了，無法結出惟耶之實。所以，我要種出新的覺王樹，這樣才能幫助{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350409,
					"content": "但是…種樹不是要花好長好長時間嗎？從種子到長成大樹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350410,
					"content": "毋須擔心。莎蘭樹成長的速度與種子有關。覺王樹將所有的力量交給了我，加上恆素果與我們一同的記憶，沒問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350411,
					"content": "#謝謝你，最初的覺王樹。謝謝{F#妳}{M#你}們，蘭拉吉、蘭雅瑪、蘭瑪哈，我會好好利用{F#妳}{M#你}們留下的記憶，讓新的覺王樹重新連接夢的通路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350412,
					"content": "感覺，蘭羅摩好像變了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350413,
					"content": "是嗎？我知道了很多事情、學到了很多詞語、獲得了許多記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350414,
					"content": "#但是，不用擔心。我還是我，{F#妳}{M#你}們是我的朋友。我一定會幫助{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350415,
					"content": "那惟耶之實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "覺王之殿的深處封印著往昔的桓那蘭那，無留陀的化身就在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350420,
					"content": "它會不停向大地、向沙恆灌注蛇毒，直到一切青翠的都枯黃，所有花朵都凋零，溪水散發出腐臭的氣味。直到萬物死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350421,
					"content": "我們要將它摧毀。只有這樣，才能種出強壯的樹，結出惟耶之實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350416,
					"content": "我相信你。接下來要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#那菈{NICKNAME}明白了就好。那就沒什麼問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730350406,
					"content": "怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
