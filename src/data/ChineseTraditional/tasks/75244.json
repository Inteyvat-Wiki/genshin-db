			"dialogs": [
				{
					"id": 752440402,
					"content": "#還在在乎那些土匪嗎？別太擔心啦，萬一{F#妳}{M#你}真遇上了，報我的名字，你{F#妳}{M#你}會沒事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440403,
					"content": "#別的就不要問了，{F#妳}{M#你}和我有緣，還幫我撿了帽子，就當是對{F#妳}{M#你}的感謝啦。",
					"roleType": "TALK_ROLE_NPC",
