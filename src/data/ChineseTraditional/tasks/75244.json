			"dialogs": [
				{
					"id": 752440302,
					"content": "#沒錯！真是太感謝{F#妳}{M#你}了，有了這頂帽子，我一下就放心了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440303,
					"content": "這可是我找人特製的安全帽，連銃槍的子彈都能擋住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440307,
					"content": "你多慮了，只是釣魚而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "#{F#妳}{M#你}不知道，之前就有個傢伙在岸邊釣魚，被人在遠處用箭還是銃槍之類的玩意射瞎了一隻眼，多危險啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440305,
					"content": "據說那是一夥挪德卡萊過來的土匪在內訌…但誰知道呢？既然有了這種先例，我們也還是小心為妙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "瑞安提"
				}
			]
		},
