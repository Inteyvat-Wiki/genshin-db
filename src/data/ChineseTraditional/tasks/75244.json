			"dialogs": [
				{
					"id": 752440101,
					"content": "哦呀，販售也是來釣魚的嗎？要知道釣魚啊，要戴好夠堅固的帽子才行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440106,
					"content": "為什麼要戴帽子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "因為戴帽子才安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440107,
					"content": "可是你也沒戴帽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "#這就是我跟{F#妳}{M#你}搭話的原因…真不好意思，我的帽子被風吹跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440104,
					"content": "不介意的話，能幫我找一找嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440108,
					"content": "為什麼不自己去找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "如果我去找帽子，就必須要放下魚竿，如果我拿起魚竿，就沒辦法去找帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440109,
					"content": "#所以拜託{F#妳}{M#你}，請幫我一把吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑞安提"
				}
			]
		},
