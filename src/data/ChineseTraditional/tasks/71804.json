				},
				{
					"id": 718040402,
					"content": "關於伊凡諾維奇的新版經營許可證…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "伊凡諾維奇…哦，之前他來過幾趟，我有印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "小安"
				},
				{
					"id": 718040404,
					"content": "他是在跑新版經營許可證的手續嗎？哈哈…那他應該跑得很累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "小安"
				},
				{
					"id": 718040405,
					"content": "#{F#妳}{M#你}是來幫他代辦的吧，<color=#00E1FFFF>出海申請批覆件</color>帶來了嗎？我上次和他說了，他的手續不全，得去其他地方補一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小安"
				}
			]
		},
