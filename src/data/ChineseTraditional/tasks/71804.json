					"nextDialogs": [
						718040604
					],
					"speakerTitle": "小昭"
				},
				{
					"id": 718040604,
					"content": "帶來的話就給我吧，要換成新經營許可證的話，舊的那張必須回收才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小昭"
				}
			]
