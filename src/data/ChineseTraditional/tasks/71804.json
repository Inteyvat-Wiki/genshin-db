			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "此乃緋雲坡公告板，街區新聞、店鋪廣告，無論大小，皆以公示。閒人如無要事，請勿擅自張貼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040202,
					"content": "關於總務司人事調動的說明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "「總務司人事調動公示如下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040204,
					"content": "等一下，總務司的人事調動應該跟經營許可證沒有關係吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718040205,
					"content": "關於緋雲坡水源汙染問題的情況通報…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "「關於緋雲坡近來水源汙染一事…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040207,
					"content": "伊凡諾維奇先生急著辦事呢，我們沒有時間關心水源汙染問題啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718040208,
					"content": "關於新版經營許可證的申請…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "「如需申請新版經營許可證，需有如下手續…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 718040210,
					"content": "這應該就是伊凡諾維奇先生想要申請的新版經營許可證了，我們趕快抄下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
