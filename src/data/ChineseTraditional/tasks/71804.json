			"dialogs": [
				{
					"id": 718040501,
					"content": "請保持秩序，保持秩序！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718040502,
					"content": "關於伊凡諾維奇的新版經營許可證…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "#啊？{F#妳}{M#你}是來幫人代辦的吧，那你把經營場所證明…和那什麼來著？哦…經營安全許諾書，都帶來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718040504,
					"content": "你在負責經營許可證的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "沒有，沒有。我只是臨時過來幫忙的，小昭那邊文件收不過來了，我暫時先來幫忙收一下，歸個檔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 718040506,
					"content": "#唉，這工作幹得真是頭暈…好了，{F#妳}{M#你}把經營場所證明，還有經營安全許諾書帶來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				}
			]
		},
