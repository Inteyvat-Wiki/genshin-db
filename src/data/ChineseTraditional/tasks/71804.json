			"trigger": {
				"objectNames": [
					"伊凡諾維奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "#{F#妳}{M#你}找到關於新版經營許可證的公告了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040302,
					"content": "已經抄下來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "太好了，我來仔細看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040304,
					"content": "出海申請批覆件，經營場所證明及經營安全許諾書和…還有舊的經營許可證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040305,
					"content": "還好，還好，這幾份文件我前幾天剛剛跑去簽好了，可把我跑得夠累的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040306,
					"content": "#旅行者，麻煩{F#妳}{M#你}再幫我跑一趟，把這些文件分別交上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040307,
					"content": "咳咳…可能要交的人有點多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040308,
					"content": "呃，首先，<color=#00E1FFFF>出海申請批覆件</color>交給小安，<color=#00E1FFFF>經營場所證明及經營安全許諾書交給</color>千岩軍嘉毅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040309,
					"content": "還有<color=#00E1FFFF>舊的經營許可</color>，去交給小昭就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040310,
					"content": "#旅行者，就拜託{F#妳}{M#你}再幫我跑跑了，我一定會準備好足夠的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040311,
					"content": "好吧，好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "希望跑完這些手續之後，我就不用再跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040313,
					"content": "希望以後不用跑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "#{F#妳}{M#你}之後應該不用跑這種手續了，但是我嘛…在這裡做生意，之後免不了還得跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 718040315,
					"content": "唉，雖然這種辦事方式確實讓人安心，但如果能再簡化一些就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡諾維奇"
				}
			]
		},
