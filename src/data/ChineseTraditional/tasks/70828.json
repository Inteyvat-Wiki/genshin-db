			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#哈哈，謝謝{F#妳}{M#你}啦，金髮的冒險家！{F#妳}{M#你}真是我的大大大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280502,
					"content": "我現在覺得腦海中的靈感就像風龍廢墟的狂風、沉玉谷的瘴氣、清籟島的雷霆，正在呼嘯著往外湧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280503,
					"content": "聽起來好危險！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "#哼哼，{F#妳}{M#你}就等著吧！我這就把它們寫下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280505,
					"content": "萊納斯那種迂腐的詩歌根本不堪一擊，等我的曠世巨作完成，全提瓦特的酒館都會為本小姐沸騰的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾西"
				}
			]
		},
		{
