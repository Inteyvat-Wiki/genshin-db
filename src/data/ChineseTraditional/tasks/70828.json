					"埃爾西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "（交出《阿伊·哈努姆之歌》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "哇哦，好漂亮的書！讓我看看裡面寫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280203,
					"content": "「…沒有無蛇的寶座，沒有無刺的薔薇。把苦痛一飲而盡吧，菲莉吉絲啊，再用妳甜美的雙眸，與我彼此許下…許下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280204,
					"content": "呃…後面這個字怎麼唸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280205,
					"content": "#不行，太深奧了啊！舌頭都要打結了！總之我先買回去慢慢看…謝謝{F#妳}{M#你}啦，金髮的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾西"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
