			"dialogs": [
				{
					"id": 708280401,
					"content": "（交出《羅納布韋之夢》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "哦哦，是楓丹的詩集！讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280403,
					"content": "…回到過去…純水騎士的王庭…和侍女一見鍾情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280404,
					"content": "笑死我了，怎麼會有這麼傻的人啊！明明有機會回到過去，結果滿腦子居然只有怎麼找和自己祖宗一樣大的人談戀愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280405,
					"content": "這不是愛情詩嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280406,
					"content": "#唉，我懂了，愛情就是讓人發昏。總之我先買回去慢慢看，謝謝{F#妳}{M#你}啦，金髮的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾西"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
