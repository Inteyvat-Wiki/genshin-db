							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "（交出《愛、聖啟與美德的典律》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "啊，我聽說過這個！是西風教會的詩集，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280303,
					"content": "我看看…「她的靈魂如焚燒的原野，向風發出炙熱的歌唱；在星辰、月光與日輪間，灼傷了我的光芒…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280304,
					"content": "在寫什麼東西啊，怪嚇人的。而且西風教會的人一看就不會寫詩嘛，星星、月亮和太陽怎麼可能一起出現呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280305,
					"content": "#好，有自信了！本小姐再怎麼說也可以寫得比這部詩集的作者好！這本書我買下了，謝謝{F#妳}{M#你}啦，金髮的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾西"
				}
			]
		},
		{
