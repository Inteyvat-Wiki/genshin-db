				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃爾西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "啊！那邊那位金髮的冒險家，請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280103,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "#不是不是，只是想問{F#妳}{M#你}有沒有關於愛情的詩集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280107,
					"content": "#{F#妳}{M#你}看，本小姐是超厲害的吟遊詩人，也許是蒙德歷史上除了巴巴托斯大人以外最厲害的吟遊詩人…總之就是超級厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280108,
					"content": "但那個叫萊納斯的吟遊詩人似乎總是不服氣，一天到晚跑來找本小姐唸詩！不管怎麼看都是在故意挑釁，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280109,
					"content": "更生氣的是，他唸的還都是什麼愛情啊、戀人啊…都是本小姐完全沒寫過的主題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280110,
					"content": "所以，我決定親自出馬，寫一首震撼全蒙德的偉大愛情詩，讓他見識一下什麼叫真正的才華！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280111,
					"content": "不過嘛…本小姐把時間都奉獻給了偉大的藝術，暫時還沒空去體驗愛情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280112,
					"content": "所以要是有什麼關於愛情的詩集，可以賣給我！只要讓我隨便翻翻，以本小姐的天賦，絕對立刻就能文思泉湧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280104,
					"content": "幫不了，我還有事，告辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "#不是要{F#妳}{M#你}幫忙啦！話又說回來，要是人人遇到問題都靠在路邊隨便抓一個陌生人解決，那大家恐怕都不敢上路了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "埃爾西"
				},
				{
					"id": 708280106,
					"content": "#咳咳，只是想問{F#妳}{M#你}有沒有關於愛情的詩集而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "埃爾西"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
