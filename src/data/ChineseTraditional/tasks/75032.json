			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曼尤雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "龍也要歸巢了，我要不要從天空的舞臺上下場呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320602,
					"content": "繼續飛吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "#自言自語被{F#妳}{M#你}聽到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320606,
					"content": "我想我會離開這裡回家一趟，退役的事情我還沒和家人說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320607,
					"content": "往後我就有一大把閒散時間了，該做些什麼比較好，這些事情也還沒有想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320608,
					"content": "調整好自己的心態之後，就要面對接下來的人生階段了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320609,
					"content": "先聽聽家人的建議比較好。我的父親以前也是飛行隊成員，退役之後做了訓練師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320610,
					"content": "我走過的路他也走過，他應該會有些特別的看法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320611,
					"content": "#所以這裡的飛屋我會拆下來帶走，但是賽道會留在這裡，畢竟像{F#妳}{M#你}這樣的年輕勇士總會需要練習的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320612,
					"content": "曼尤雅，我們以後還會碰到妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320613,
					"content": "我不知道，不過我猜自己不管怎麼選，最後都無法放棄天空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320614,
					"content": "#只要{F#妳}{M#你}還會飛行，我們應該就還會遇到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320615,
					"content": "下次再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "下次再見，年輕的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320604,
					"content": "…曼尤雅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "#哦，{F#妳}{M#你}過來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "曼尤雅"
				}
			]
		},
