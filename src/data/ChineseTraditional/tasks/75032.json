				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "沒那麼容易，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320802,
					"content": "要是有飛行隊成員隨隨便便就被路過的冒險家超過了，隊長鐵定要生氣了哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320803,
					"content": "#好了，別沮喪嘛。其實我應該感謝{F#妳}{M#你}保全了我這個退役馭龍師的面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320804,
					"content": "#{F#妳}{M#你}飛得也滿瀟灑的，只是要打敗我還早得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320805,
					"content": "不服氣的話，就再來試一試囉？年輕就多試嘛，輸了也沒什麼大不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				}
			]
		},
