			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "怎麼樣，比不比？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320202,
					"content": "#在限定時間內盡全力沿固定賽道馭龍飛行，獲得高分，<color=#00E1FFFF>只要超過第二高那級就算{F#妳}{M#你}贏我了。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320203,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "好，爽快！去起點那裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320205,
					"content": "我還要再準備一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "#沒關係，等{F#妳}{M#你}有心情再說，本來飛行就應該是一件輕鬆愉快的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曼尤雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "哈哈哈哈，很好，果然得承認年輕的總是要打敗年老的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320402,
					"content": "就算是星星也有墜落的時候，更何況是人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320403,
					"content": "現在已經不是我的時代了，開開心心退役才是正確的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320405,
					"content": "但還是不甘心啊，我明明不老啊…皺紋都還沒有呢，怎麼就要隱退了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320406,
					"content": "太短了，我的生涯怎麼會這麼短…還沒嚐出站在頂峰是什麼滋味，就開始下墜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320407,
					"content": "早知道會這麼遺憾的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320408,
					"content": "算了，也不能這樣說，能重來一次的話，我還是會做同樣的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320409,
					"content": "會拼盡全力加入飛行隊，以我的能力這根本不難，然後還是會在這個年紀退役。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320410,
					"content": "沒辦法，我已經盡力了，不甘心也沒用啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320411,
					"content": "…可能人生就是這樣吧，無奈的事太多了，想要成為英雄就必須接受閃耀只有一瞬這種事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320412,
					"content": "曼尤雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320413,
					"content": "#沒關係，{M#他}{F#她}飛得很棒。妳剛才一臉同情，現在怎麼又是一副不安的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320414,
					"content": "哈哈，活著就是會遇到各式各樣的事，接受也好不接受也好，反正都會發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320415,
					"content": "#就當是前馭龍師教給{F#妳}{M#你}的經驗之談吧。我的問題需要我自己解決，不要因為我的失態壞了{F#妳}{M#你}的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320416,
					"content": "#{F#妳}{M#你}做得很好哦。如果我弟弟也和{F#妳}{M#你}一樣沉著冷靜就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320417,
					"content": "曼尤雅還有弟弟喔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320418,
					"content": "#對啊，我那兩個怪脾氣的弟弟才不像{F#妳}{M#你}們這麼好說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320419,
					"content": "他們也在訓練自己的飛行技巧——哦不對，阿科米蒂那傢伙一心只想逃跑，說不定只會躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320420,
					"content": "#不管這些臭小子了，我看得出來{F#妳}{M#你}很有天賦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320421,
					"content": "有空的話不妨多試著飛一飛，說不定會被主動招進飛行隊哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320422,
					"content": "我會多嘗試的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "#那就太好了。希望以後還能看到{F#妳}{M#你}飛行的樣子，加油吧，年輕的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503206",
							"2"
						],
						"stepId": 7503206,
						"stateName": "QUEST_STATE_UNFINISHED"
