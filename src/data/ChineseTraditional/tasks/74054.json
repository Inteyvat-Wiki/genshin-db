			"dialogs": [
				{
					"id": 740540801,
					"content": "拉動拉桿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#嗚哇！{NICKNAME}，{F#妳}{M#你}在幹什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540803,
					"content": "#{F#妳}{M#你}毫不猶豫地拉動了拉桿。\\n下一個瞬間，伴隨著宛若雷霆的震耳轟鳴，整座高塔開始劇烈地晃動起來，彷彿天為之崩、地為之裂…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "#然後…噗地一聲，機器吐出了一疊紙帶，正好掉在{F#妳}{M#你}的手中。\\n一切重歸沉寂。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "就…就這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540806,
					"content": "唔…完全看不懂上面刻了什麼東西，但看起來好像滿重要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}，我們還是先留著這些紙帶吧？說不定之後會在什麼地方用上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
