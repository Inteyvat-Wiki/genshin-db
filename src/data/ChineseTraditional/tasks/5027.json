			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬索",
					"歐洛倫",
					"伊安珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "你覺得，我會變成什麼蔬菜呢？紅色的，還是綠色的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "馬索"
				},
				{
					"id": 50270202,
					"content": "你的話，可能會變成洋蔥吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270203,
					"content": "洋蔥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "馬索"
				},
				{
					"id": 50270204,
					"content": "其貌不揚，卻能讓試圖對你動手的人痛哭流涕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270205,
					"content": "真的？聽起來好強大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "馬索"
				},
				{
					"id": 50270206,
					"content": "這兩個人在說什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270207,
					"content": "洋蔥很厲害。上次去朋友家碰巧他在削洋蔥，削得不停流眼淚，他也流，龍也流，最後屋裡的生物幾乎都哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270208,
					"content": "你呢？你在哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270209,
					"content": "我也在屋子裡，不過及時用披風遮住了眼睛。咔庫庫和伊法他們看不到我，就以為我也哭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270210,
					"content": "我想成為洋蔥一樣讓人哭泣的男人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "馬索"
				},
				{
					"id": 50270211,
					"content": "嗯，沒問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270212,
					"content": "好想打斷你們，又不知道說什麼才能阻止這種對話發展下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270213,
					"content": "伊安珊是…小小的…蘑菇。嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270214,
					"content": "沒有人問啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270215,
					"content": "不過蘑菇嗎？還不錯呢，很有生命力，我喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50270216,
					"content": "那伊安珊姐姐是很有生命力的女人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "馬索"
				},
				{
					"id": 50270217,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 50270218,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				}
			]
		}
	]
