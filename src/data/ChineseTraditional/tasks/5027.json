				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "火神大人真厲害！而且很有勇氣，敢和希巴拉克大人過招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 50270102,
					"content": "別謙虛了，換做是妳妳也敢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50270103,
					"content": "哈，誰不敢？我敢！你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 50270104,
					"content": "我…我不敢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 50270105,
					"content": "戰鬥是戰士的天性，有什麼敢不敢的？真的到了那個時刻，自然會想要一決高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 50270106,
					"content": "唉，真有精神啊你們…那可是希巴拉克大人哦？超級祖先哦？這麼喜歡跟老一輩過招嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 50270107,
					"content": "茜特菈莉奶奶！有機會我們也再比試比試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 50270108,
					"content": "不要不要，絕對不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
