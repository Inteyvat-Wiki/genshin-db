			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里",
					"今谷三郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "欸，這不是宵宮嘛，快來快來，進屋坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120102,
					"content": "這邊的是妳的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120103,
					"content": "對啊，是遠道而來的旅行者，現在有外人到稻妻來很不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120104,
					"content": "是啊，現在情況特殊，不過既然來了，我們身為當地人，就要好好招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120105,
					"content": "嗯。對了，你們兩位之前訂的煙花，我也帶過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120106,
					"content": "喔，謝謝啊，每年都要麻煩妳們家，先是妳爸爸，現在輪到妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120107,
					"content": "不知道有生之年，能不能等到「長野原煙花店」的下一任接班人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120108,
					"content": "沒問題的，兩位現在身子骨這麼硬朗，就別說不吉利的話啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120109,
					"content": "唉，身子這東西，確實不如以前啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120110,
					"content": "以前種田挑水什麼的一點都不費勁，現在稍微幹點活就腰痠背痛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120111,
					"content": "昨天本來想把雜草除一下，結果彎下腰去，就有點直不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120112,
					"content": "這樣啊，沒關係，交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120113,
					"content": "哎，別別別，好不容易來一趟，怎麼能讓妳們幹活呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120114,
					"content": "我去拿點心和茶，邊吃邊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120115,
					"content": "沒關係啦，我不是總來幫你們做家務的嘛。最近是因為煙花會的事在忙，之後我還會經常來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120116,
					"content": "對我們來說是小事情啦，不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120117,
					"content": "#哎呀，{F#妳}{M#你}們就是懂事，不像我家那孩子，也老大不小的了，還是一個人，也總是不回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120118,
					"content": "既然妳都這麼說了，我這裡還醃了點鹹蘿蔔，妳能順便帶給村那邊的小聰嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120119,
					"content": "好啊，我們去去就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120120,
					"content": "跟我來吧，爺爺奶奶腿腳不方便，我們幫幫忙吧，先<color=#00E1FFFF>除草</color>，再去<color=#00E1FFFF>送鹹蘿蔔</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "聰叔叔你好，最近身體怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120402,
					"content": "還是老樣子啊，沒什麼變化。妳看起來也還是那麼活潑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120403,
					"content": "託大家的福嘛，我家的生意愈來愈好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120404,
					"content": "上次賣到璃月去的煙花，聽說廣受好評，之後的訂單大概又要增加了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120405,
					"content": "那妳不是更辛苦了，和龍之介先生還忙得過來嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120406,
					"content": "實在吃力的話，記得叫我幫忙喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120407,
					"content": "沒問題啦，煙花的事情，可以自己解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120408,
					"content": "對了對了，這是香里奶奶託我送過來給你的鹹蘿蔔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120409,
					"content": "哎呀，真是謝謝，本來我以前都吃不慣鹹蘿蔔的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120410,
					"content": "可一嚐了她的手藝就忘不掉囉，現在都成我們家裡人的習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120411,
					"content": "家裡現在都還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120412,
					"content": "好啊，不過，偶爾也會鬧鬧脾氣吧，家人不就是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120413,
					"content": "我覺得，有親人一直陪在身邊，就算有矛盾，也比一直見不到面要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120414,
					"content": "雖然叔叔阿姨的感情很好，但孩子總是不回來，也挺孤單的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120415,
					"content": "看起來好像也不會，他們好像已經習慣這樣的日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120416,
					"content": "不過你說得也很有道理，那我以後多來看看好了，至少有人能聊聊天什麼的，就不會無聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120417,
					"content": "好啊，紺田村的大家都希望妳能多來看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120418,
					"content": "嘿嘿，謝謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷香里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "不愧是年輕人啊，做事就是俐落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120502,
					"content": "年輕人的精力用不完，老人見多識廣經驗豐富，各有各的厲害之處嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120503,
					"content": "說起來，今年就正好五十年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120504,
					"content": "是啊，一年一年這麼過去，其實沒什麼明顯的感覺，但一晃眼，就五十年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120505,
					"content": "五十年？是什麼重要的日子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120506,
					"content": "哈哈，那就要講，五十年之前，這老婆子追我的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120507,
					"content": "在外人面前亂講什麼，明明是你發了瘋地追我好不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120508,
					"content": "那這一段先略過，不講。總之，就是在那年的「長野原煙花會」上，我向老婆子求了婚，然後就一起過日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120509,
					"content": "祝賀你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "其實本來也沒下定決心的，抱著有點猶豫的心態找長野原做了煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120512,
					"content": "煙花升起來，就到那時候也不知道要怎麼開口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120513,
					"content": "結果聲音砰砰砰的，煙花點亮了天空，再看她的側臉，那眼睛啊，倒映出煙花的光，閃閃發亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120514,
					"content": "也不知道怎麼回事，回過神來的時候，我好像已經開了口，她還答應了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120515,
					"content": "五十年說長也長，說短也短，不是什麼了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120516,
					"content": "但攜手走過五十年，也值得紀念一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120517,
					"content": "我之前不知道是五十年這麼特殊的日子，早知道，應該幫你們做一個特殊的豪華版煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120518,
					"content": "不用不用，就是以前的那種就行，每次煙花會都看，看不到才會不習慣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120519,
					"content": "只要看了煙花，就能想起那段日子。哪怕是上了年紀，也不會覺得自己的過去有什麼遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120520,
					"content": "他們的感情真的很好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120521,
					"content": "對了，我們的事先不提，宵宮妳現在應該忙著辦煙花會吧，到我們這裡來，是有什麼要緊事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120522,
					"content": "喔，其實是個比較難以啟齒的事，我先跟你們說一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120523,
					"content": "朔次郎，他…回來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120524,
					"content": "欸？你們認識他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120525,
					"content": "那是我家孩子小時候最好的朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120526,
					"content": "唉，那時候他們一直一起玩，從小到大，無話不講，到處跑、到處看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120527,
					"content": "結果呢，有一天突然吵了一架，吵得很厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120528,
					"content": "我記得那時候的朔次郎，想要去外面的世界看看，他覺得稻妻太安穩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120529,
					"content": "可是我們家那孩子佳祐，從小就和我們一樣，覺得安安穩穩的沒什麼不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120530,
					"content": "小孩子嘛，就是會因為對錯而爭論得很厲害，最後朔次郎就一氣之下，獨自離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120531,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120532,
					"content": "那之後佳祐雖然什麼都沒跟我和老婆子說，但能看出來，他很傷心，但心裡的想法，又不願和我們講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120533,
					"content": "後來，不知道是賭氣還是什麼其他原因，他就去了天領奉行，很少回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120534,
					"content": "其他的忙，我們跟佳祐好好說說，他應該是會幫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120535,
					"content": "但如果是朔次郎的事，我覺得…我們沒有辦法插手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120536,
					"content": "沒想到這麼巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120537,
					"content": "我明白了。我問朔次郎他為什麼回來的時候，他也不願意細講，只說是「以前犯了錯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120538,
					"content": "我終於明白他為什麼下不了決心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120539,
					"content": "明明是童年摯友，現在一個是天領奉行的人，一個在被天領奉行通緝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120120540,
					"content": "這就是命運吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "沒關係，既然這樣的話，就不打擾你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120543,
					"content": "我們會幫朔次郎想想辦法的，兩位也不用勉強，這件事，還是留給朔次郎和佳祐自己去解決吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120544,
					"content": "嗯，要是他們的關係能和好如初就好了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120545,
					"content": "那麼多年之前的爭吵，現在也應該放下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120541,
					"content": "我也沒想到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "令人羡慕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
							"2"
						],
						"stepId": 1201206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
