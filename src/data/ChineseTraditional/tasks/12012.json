			"dialogs": [
				{
					"id": 120120801,
					"content": "馬上就是「長野原煙花會」了吧，我家孩子早就跑出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120802,
					"content": "特別迫不及待，心思全寫在臉上，誰不知道她是惦記城裡的那個臭小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "聰"
				},
				{
					"id": 120120803,
					"content": "…唉，她開心就好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
