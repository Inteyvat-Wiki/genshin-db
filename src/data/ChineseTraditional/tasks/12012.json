			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "丫頭，不好了，剛剛天領奉行的人來過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120602,
					"content": "欸？為什麼，他們這麼快就知道了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120603,
					"content": "老爹你沒事吧？他們沒對你做什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120604,
					"content": "我說，煙花會，房子裡都是煙花，不要隨便進去，免得火災。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120605,
					"content": "但他們不聽，就覺得朔次郎那小子躲在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120606,
					"content": "不過幸好，朔次郎提前聽到了動靜，爬窗跑掉了，天領奉行的人沒有在這裡抓到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120607,
					"content": "哎呀，這就麻煩了，朔次郎現在應該還在猶豫不決…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120608,
					"content": "老爹，你看到他往哪裡跑了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120609,
					"content": "我覺得天領奉行的人一定會追上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120610,
					"content": "你聽到那個人的名字了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "對對對，名字、名字！這麼突然地就來抓人，很有可能就是那個佳祐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120612,
					"content": "不然只是因為偷渡，應該還不至於這麼勞師動眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120613,
					"content": "#不行啊，我耳朵不好，也沒聽到。{F#妳}{M#你}們想問方向是吧，他們出城去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120614,
					"content": "名字我沒聽到，唉，真的沒聽到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120120615,
					"content": "名字的話，我好像聽到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120616,
					"content": "我剛剛又從朋友那裡拿了點礦石，送過來的時候，剛好撞上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120617,
					"content": "領頭的那個，名字好像跟你們說的一樣，叫作佳祐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120120618,
					"content": "果然是這樣！謝謝你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120619,
					"content": "如果朔次郎還是沒有下定決心，兩個人見面不僅不能解決問題，還會讓事情變得不可挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120120620,
					"content": "#這樣肯定不行。{NICKNAME}，跟我來，我們沿路打聽線索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
