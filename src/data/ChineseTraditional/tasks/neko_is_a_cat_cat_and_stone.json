			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "唉，到底什麼時候才能找到工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120302,
					"content": "#{F#妳}{M#你}們…是來找我的嗎？有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120303,
					"content": "你會做石雕嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "咦？那…那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120306,
					"content": "我都忘了自我介紹了…我叫大島純平，之前是在踏鞴砂工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120307,
					"content": "出了意外之後，我和其他人也都被疏散了出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120308,
					"content": "但是…到現在我也沒有接到開工的消息，就這麼一直閒在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120309,
					"content": "#{F#妳}{M#你}們是在找做石雕的人對吧？我會一點石雕的手藝，雖然不是非常專業…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120310,
					"content": "#{F#妳}{M#你}們要做怎麼樣的石雕？能告訴我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120311,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "#呃，會說話的貓，要{F#妳}{M#你}們找一個工匠，幫牠雕一座石雕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120313,
					"content": "不、不是我不相信，是這件事實在有點…有點離譜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120314,
					"content": "#其他的不論，就算我答應了{F#妳}{M#你}們，那…那位「代宮司」大人，怎麼支付報酬呢？我可不能做白工啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120315,
					"content": "放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "（真、真的可以放心嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120317,
					"content": "#這樣啊，這…我總覺得{F#妳}{M#你}們在騙我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120318,
					"content": "#但是…算了，閒著也是閒著，我就和{F#妳}{M#你}們走一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120319,
					"content": "希望對方真的能支付報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120304,
					"content": "我們正在找會做石雕的工匠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
