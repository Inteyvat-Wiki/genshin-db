			"trigger": {
				"objectNames": [
					"「寢子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "汝等來得正好，來幫奴家做件事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120102,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "奴家想要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120104,
					"content": "在神社旁邊，放一塊很高很高，很大很大，和奴家一個樣子的石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120105,
					"content": "上、上哪找這樣的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120106,
					"content": "是說雕像對吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "總之，奴家要的東西，和好遠好遠的那個島上的狐狸石頭一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120108,
					"content": "阿響說過，在那個島上，有好多狐狸石頭，還說，要不要也弄一個給奴家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120109,
					"content": "奴家覺得，阿響想要的，一定是好的。所以，汝等幫忙弄個石頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120110,
					"content": "我沒有雕刻的手藝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "唔，要怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120112,
					"content": "對了，去找大祐吧！他這麼喜歡貓，說不定能為了寢子學會雕刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120113,
					"content": "去找大祐幫忙好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "有道理！他這麼喜歡貓，說不定能幫得上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221202",
							"2"
						],
						"stepId": 7221202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大祐",
					"悅子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "#喔！{F#妳}{M#你}好，今天又在忙什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120202,
					"content": "幫寢子做雕像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "啊…啊？做雕像，在這裡？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120204,
					"content": "我、我這就去學雕刻技術！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120205,
					"content": "來、來不及吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "#又是那位寢子拜託{F#妳}{M#你}的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120207,
					"content": "說起來，因為踏鞴砂那邊的問題，很多工匠都在找工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120208,
					"content": "協會之前接到過不少相關的委託，據我所知，有人似乎還留在踏鞴砂附近，一直在找工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120209,
					"content": "我之前去執行協會委託的時候，也見到了一個類似的營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120210,
					"content": "#如果{F#妳}{M#你}們願意的話，倒是可以去那邊碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120211,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "呵呵…不用在意，只不過是舉手之勞而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120215,
					"content": "我也很想看看，這座神社如果真能熱鬧起來的話…會發生什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120216,
					"content": "特別是那位「阿響」…到底是一位怎麼樣的人，能讓那位寢子這麼在意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120217,
					"content": "#好了，{F#妳}{M#你}也別在這聽我自言自語了，快去找工匠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120218,
					"content": "#至於{F#妳}{M#你}們找到的工匠會不會雕石雕…呵呵，那就全憑{F#妳}{M#你}們的運氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120219,
					"content": "悅子小姐，其實妳也是想幫幫寢子大人對吧？哈哈哈，妳還真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120220,
					"content": "大祐，調查計畫寫好了沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722120221,
					"content": "呃！馬、馬上就好，實在對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120212,
					"content": "悅子小姐感覺和平時不太一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "#怎麼？我這麼主動地給{F#妳}{M#你}們消息，{F#妳}{M#你}有些不習慣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "悅子"
				}
			]
		},
		{
			"id": 7221203,
			"completionStepIds": [
				7221204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
