			"dialogs": [
				{
					"id": 722120401,
					"content": "汝等回來了。這個人類想必便是石頭人類，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120402,
					"content": "是我們請來的工匠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "欸？欸！貓…貓說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120405,
					"content": "喵喵喵，汝可真是大驚小怪啊…奴家會說話很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120406,
					"content": "不要大驚小怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "#喂！難道對{F#妳}{M#你}來說，這事情是一件很平常的事嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120409,
					"content": "是很平常啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "#{F#妳}{M#你}到底都經歷了什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120411,
					"content": "好啦，好啦，你們不要光顧著說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120412,
					"content": "總之，石頭人類，你能把石頭，弄得和奴家一模一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120413,
					"content": "咦？石頭人類？我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120414,
					"content": "敲石頭…呃，你是說做石雕啊，我倒是可以試試看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120415,
					"content": "是嗎？那太好了，喵喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120416,
					"content": "這、這樣啊…無論如何，有份工作都是件好事。雖然我也從來沒為一隻貓工作過…報酬的事…之後再聊吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120417,
					"content": "呃，我得先去做點準備工作，這島上倒是有不少石頭，我得去好好挑一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120418,
					"content": "那個，我該怎麼稱呼你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120419,
					"content": "喔，奴家是這座「淺瀨神社」的代宮司，寢子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120420,
					"content": "至於稱呼，隨汝喜歡就好，高高的，會敲石頭的人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120421,
					"content": "是嗎？那我…就叫你代宮司大人吧，畢竟是發工錢的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120422,
					"content": "「宮前」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120423,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120424,
					"content": "那、那我就先去周圍看看，挑挑石頭去了，你們先聊著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120425,
					"content": "幫一隻貓工作，還真是新奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120426,
					"content": "大島先生，好像已經不想思考報酬的事情了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722120407,
					"content": "只不過是貓會說話而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "對，石頭人類。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
