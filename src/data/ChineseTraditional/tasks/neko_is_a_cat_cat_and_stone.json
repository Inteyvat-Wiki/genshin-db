			"dialogs": [
				{
					"id": 722120601,
					"content": "不過，奴家還是很好奇。石頭那麼硬的東西，怎麼會變成奴家的樣子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120602,
					"content": "那個石頭人類，是不是很厲害？是不是會什麼妖術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120603,
					"content": "很厲害的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "原來如此，奴家很是期待哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120605,
					"content": "和做飯一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "原來如此，奴家明白了。汝做的飯和阿響做的飯，都是好東西。所以，石頭人類做的石頭，也是好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722120607,
					"content": "人類有時候真厲害哪。這次，也謝謝汝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		}
