			"dialogs": [
				{
					"id": 760620101,
					"content": "你們還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620102,
					"content": "瑪歌受了一些傷…不過沒有危及生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620103
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620103,
					"content": "為什麼會這樣…他們不是一對伴侶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620104,
					"content": "是「家庭暴力」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620105
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620105,
					"content": "#妳從哪學來的詞…總之我們得阻止那傢伙…剛才{F#妳}{M#你}們看見了嗎？烏吉身上是黑色的…和黑蛋一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620106,
					"content": "但是他個頭卻有那麼大，不會是因為吃了很多其他黑蛋吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620107,
					"content": "派蒙…妳等等我…等我長到他那麼大的時候就來回答妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620108
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620108,
					"content": "可惡…好吧，那現在怎麼辦？烏吉已經回來了，我們要先撤回去等下一次機會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620109,
					"content": "來不及了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620110
					]
				},
				{
					"id": 760620110,
					"content": "嗯…古月風暴已經逼近了烏吉恩圈，那裡還有很多小生靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620111
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620111,
					"content": "妳照顧瑪歌，我們去拿古月之源。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620112
					]
				},
				{
					"id": 760620112,
					"content": "好，但小心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620113
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620113,
					"content": "#我需要時間治療瑪歌，拜託{F#妳}{M#你}吸引烏吉的注意，撐到我來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620114
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620114,
					"content": "#月海裡生活著一些小型的群遊月靈，我也會讓它們幫助{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620115
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620115,
					"content": "好！交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620116,
					"content": "我也來…幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黑蛋"
				}
			]
		},
