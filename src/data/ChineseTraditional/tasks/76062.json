			"dialogs": [
				{
					"id": 760620401,
					"content": "終於把古月之源拿到手了！這下大功告成了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620402,
					"content": "我感覺…這裡面有我需要的資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620403
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620403,
					"content": "咦？不是終端機也可以嗎？這東西看起來是自然產生的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620404,
					"content": "不…它是人工製造的…我感覺到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620405
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620405,
					"content": "那…那你小心一點啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620406,
					"content": "啊…果然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620407
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620407,
					"content": "這是一個叫做…盧沙里姆的學者製造出的能量體…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620408
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620408,
					"content": "盧沙里姆是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620409
					]
				},
				{
					"id": 760620409,
					"content": "是烏吉恩和瑪歌的學生…應該也是…在終端機中寫下留言的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620410
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620410,
					"content": "這片月海…曾經其實是…盧沙里姆的月幕實驗所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620411
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620411,
					"content": "月幕實驗所？那又是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620412,
					"content": "是一個…藏起月亮的偉大工程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620413
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620413,
					"content": "藏起月亮？天啊，這些傢伙真是人人…真是龍龍有夢想啊！這種事要怎麼辦到啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620414,
					"content": "雖然原理不清楚…但好像和他的老師烏吉恩有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620415
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620415,
					"content": "盧沙里姆成功地實驗過微型月幕…就應用在烏吉恩圈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620416
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620416,
					"content": "哦，我想起來了！烏吉恩圈從外面看很蒼涼，進到裡面卻是另一個樣子！就是月幕的作用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620417,
					"content": "沒錯…微型月幕的成功…推動月幕工程進入了下一個階段…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620418
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620418,
					"content": "一座巨大的月幕產生器…在這裡建立了…它能遮蔽整個月亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620419
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620419,
					"content": "可是現在月亮並沒有被藏起來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620420
					]
				},
				{
					"id": 760620420,
					"content": "因為就在月幕成形的前夕…一位天外而來的存在戳破了它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620421
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620421,
					"content": "裝置失控…實驗所發生爆炸…一切都化為烏有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620422
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620422,
					"content": "只有地下深處…可能還殘留著些許痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620423
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620423,
					"content": "等等…天外而來的存在？！難道是那一位？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620424,
					"content": "高天的主宰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620425
					]
				},
				{
					"id": 760620425,
					"content": "那個存在的降臨，沒有人預料到。但它的到來，卻改變了一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620426
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620426,
					"content": "在盧沙里姆的設計中…月幕工程是望月者計畫的重要環節…卻被迫中止了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620427
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 760620427,
					"content": "那望月者計畫究竟是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760620428,
					"content": "小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620429
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760620429,
					"content": "糟了！烏吉在下面！快躲開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
