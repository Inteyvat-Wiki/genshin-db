			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "您好，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010202,
					"content": "我們想借這裡的廚房用一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010203,
					"content": "我的朋友想吃特殊的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "原來如此，那當然可以。只要自備食材，廚房就請儘管借用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010206,
					"content": "不過我想多一句嘴，這位客人，想必烹飪技術很精湛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010207,
					"content": "當然，做什麼都是「美味的」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "哈哈，果然不凡。其實，我有一個小建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010211,
					"content": "看您的衣服，像是外國人。但既然來了璃月，要不要試試看做璃月的菜式呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010212,
					"content": "我這裡有一份「黃金蟹」的食譜，是非常經典的「月菜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010213,
					"content": "裹上麵粉的螃蟹先用油炸，再跟薑蒜一起炒，盛到盤裡的螃蟹就像躺在黃金上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010214,
					"content": "黃…黃金蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010215,
					"content": "聽起來有點麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#黃金蟹！{NICKNAME}，黃金蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010218,
					"content": "知道了知道了，黃金蟹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "嘿嘿，那我們現在就去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010221,
					"content": "#憑藉{F#妳}{M#你}在烹飪上的造詣，肯定一下——就學會了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010219,
					"content": "…也算是為妳學的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "為了莫娜專門學一道菜是不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "也沒有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "哈哈，真謙虛呢。其實，我有一個小建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010204,
					"content": "我的朋友想吃我親手做的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
			"id": 1050103,
