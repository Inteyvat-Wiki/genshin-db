			"dialogs": [
				{
					"id": 105010301,
					"content": "不用為我費工夫，我一點都不饞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010302,
					"content": "雖然還是有點餓，但…也沒什麼大不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 1050104,
			"completionStepIds": [
				1050107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050107",
							"2"
						],
						"stepId": 1050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "終於到蒙德了，唉，好累啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010402,
					"content": "想得到偉大而深奧的知識，果然不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010403,
					"content": "我倒是沒那麼累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010404,
					"content": "因為妳是飄在天上的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010405,
					"content": "唉，看來占星術士也沒那麼厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010406,
					"content": "那是因為妳對占星術有太多不切實際的幻想了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010407,
					"content": "你們幾位，也是在這裡歇腳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010408,
					"content": "請問你是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010409,
					"content": "哦，我們幾兄弟都是商人，剛在璃月港做完生意，準備回蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010410,
					"content": "看你們好像挺累的樣子，我們訂的馬車一會就來了，要不要一起走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010411,
					"content": "我也有點累了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "要收錢嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "哈哈，那就一起走吧，路上多幾個伴聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010414,
					"content": "不用啦不用啦，反正是順路的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010415,
					"content": "沒這個需要，快閃開快閃開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010416,
					"content": "欸？這位小姐…有什麼不方便嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010417,
					"content": "別裝模作樣了，強盜先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010418,
					"content": "挑路上看起來好欺負的人下手，只要對方上了車，就會把車拉到荒郊野嶺，洗劫一通，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010419,
					"content": "妳、妳在說什麼？！我們好心來搭話，卻被當驢肝肺，還血口噴人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010420,
					"content": "不坐車就不坐，神經病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010421,
					"content": "那，要不要我現在說說你們身上，有哪些東西是搶來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010422,
					"content": "不服氣的話，我說完之後，找人來對質一番，就什麼都明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010423,
					"content": "如果我輸了，我願意賠你兩萬摩拉。如果我贏了，那你們就得去璃月港吃牢飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010424,
					"content": "怎麼樣，要真是正經做生意的人，沒什麼不敢的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010425,
					"content": "妳、妳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010426,
					"content": "妳真是把我惹毛了！小丫頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010427,
					"content": "我不知道妳是怎麼知道的，但只要滅了妳的口，就不會有人知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "泰勒"
				},
				{
					"id": 105010428,
					"content": "莫娜，小心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "不會讓你們傷害她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "別在意，幾個強盜而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010431,
					"content": "之前你們說占星術士「沒那麼厲害」…那正好給你們看看，師父威風的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
