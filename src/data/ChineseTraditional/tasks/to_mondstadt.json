			"dialogs": [
				{
					"id": 105010501,
					"content": "哼，怎麼樣？這下算是回應了你們的期待了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010502,
					"content": "戰鬥力，很厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "對占星術士來說，這可是基本功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010505,
					"content": "在占星術的面前謊言毫無意義，「命運」與「真實」都在星空中一覽無餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010506,
					"content": "雖然結果越具體，就越花時間，但大概的趨勢一眼就能明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010507,
					"content": "可是，一路上好像也有不少失算的時候啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010508,
					"content": "那是因為提瓦特的星空，只展示「此世」的命運與真實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010509,
					"content": "只要是和你們有關的事情，就會變得模糊起來，就算是我也沒法準確判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010510,
					"content": "#所以，我才要和那個繼承者見面，結合她的知識，說不定就能洞悉{F#妳}{M#你}的命運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010511,
					"content": "有點期待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "#呵，無論如何，對{F#妳}{M#你}來說都是有益無害的一次旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010514,
					"content": "好了，我也休息夠了，那我們就一口氣走到<color=#00E1FFFF>蒙德城</color>去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010515,
					"content": "唉，要是有車坐就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010516,
					"content": "妳不是不累嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010512,
					"content": "不太抱期望…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "看穿強盜的真實，很厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
