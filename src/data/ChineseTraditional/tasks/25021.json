			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "#（霍萊的身體並沒有放鬆，反而迷茫地看著{F#妳}{M#你}。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212710,
					"content": "（卡茲加及時接手了工作。在又一陣細緻的打理後，終於還是為霍萊修剪了指甲…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#沒關係，有時候我也會猜錯霍萊的心思，但牠一定知道{F#妳}{M#你}是一位對牠很好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212702,
					"content": "嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250212703,
					"content": "#哈哈哈，{F#妳}{M#你}看我剛剛說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212704,
					"content": "#這次還是多謝{F#妳}{M#你}了，這些東西給{F#妳}{M#你}，就當做是謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212705,
					"content": "小龍的心思就是這麼難猜，我也是和霍萊相處很久之後，才能猜出來牠大部分的心思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212706,
					"content": "有辦法做到這件事我就已經知足了，畢竟我們兩個還要繼續相處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250212707,
					"content": "咦？霍萊去哪裡了？不、不會是又跑了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "卡茲加"
				},
