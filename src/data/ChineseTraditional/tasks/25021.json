				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡茲加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "霍萊，這次你不能亂跑了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210102,
					"content": "嗚，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250210103,
					"content": "今天霍萊很聽話耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "#對啊，多虧了{F#妳}{M#你}幫我做的那個「漂流球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210105,
					"content": "有了這個球，我也有辦法引導霍萊去做各種事，不管是洗澡、吃東西、睡覺，還是訓練，都方便了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210106,
					"content": "特別是修剪指甲這件事！要是之前的話，我光是追霍萊都會追到累癱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210107,
					"content": "現在只要把球放在霍萊面前，這個小夥子就會乖乖坐下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210108,
					"content": "嗚嗚，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250210109,
					"content": "#霍萊，你記得{M#他}{F#她}嗎？這可是幫你做玩具的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210110,
					"content": "嗚嗚，嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250210111,
					"content": "乖乖喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "#喔！霍萊記得{F#妳}{M#你}耶，看起來還滿開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210114,
					"content": "#{F#妳}{M#你}要幫牠剪指甲看看嗎？順便再擦擦牠的角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210115,
					"content": "這對小嵴鋒龍來說是一件很重要的事，畢竟牠們要挖岩掘土，爪子必須要常常磨，也要修剪那些長歪或被撞壞的指甲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210116,
					"content": "只有這樣，才能保證小嵴鋒龍在長大之後擁有一對最完美的爪子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210117,
					"content": "來，拿著這個！我們正好趁這個修剪指甲的機會，把霍萊全身都整理一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210118,
					"content": "你說得真詳細…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "嗚嗚，嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250210121,
					"content": "咳…難得看到霍萊這麼聽話。一想到今天我不用追著霍萊跑遍整個部族，我就不由自主地高興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210122,
					"content": "真是辛苦你了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "#沒什麼！那我們就開始吧，我會在旁邊指導{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210124,
					"content": "#為了讓霍萊放鬆，{F#妳}{M#你}要先用大刷子輕輕清理牠的後背…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210130,
					"content": "再用細毛刷乾淨牠的角，這個時候要用點力道，否則就會漏掉一些縫隙中的汙漬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210125,
					"content": "然後呢，拿毛巾擦洗霍萊的全身…這樣，牠就會慢慢放鬆，四足上的爪子也會伸出來，這個時候就可以為牠修剪指甲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210126,
					"content": "這也太詳細了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "那當然，霍萊可是我一手帶大的。整個部族…不，整個納塔都找不到比我更瞭解牠的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210129,
					"content": "#好了，{F#妳}{M#你}就按照我剛才說的幫霍萊修剪一下指甲吧。我就在旁邊，不懂的話來問我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250210127,
					"content": "你真是瞭解霍萊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "你怎麼突然變興奮了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "（摸摸霍萊。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
