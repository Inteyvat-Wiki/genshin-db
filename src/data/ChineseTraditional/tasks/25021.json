				"points": []
			},
			"dialogs": [
				{
					"id": 250213701,
					"content": "#（霍萊歪了歪腦袋，搔了搔自己的肚子，迷茫地看著{F#妳}{M#你}。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250213702,
					"content": "#{F#妳}{M#你}不能一直光顧著和霍萊玩啊，還有正事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213703,
					"content": "#咳！還是我來吧。讓我給{F#妳}{M#你}示範一下正確的梳洗方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213704,
					"content": "（卡茲加及時接手了工作。在又一陣細緻的打理後，終於還是為霍萊修剪了指甲…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250213705,
					"content": "#{F#妳}{M#你}不能光顧著和霍萊玩哦，還是先做正事比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213706,
					"content": "嗚！嗚嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250213707,
					"content": "#哈哈哈哈，但霍萊看起來還滿喜歡和{F#妳}{M#你}玩的，難怪這次梳洗的時候這麼聽話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213708,
					"content": "#無論如何，這次還是多謝{F#妳}{M#你}了，這些東西給{F#妳}{M#你}，就當做是謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213709,
					"content": "唔…那不然…我之後也試試看先陪霍萊玩個痛快，再幫牠梳洗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213710,
					"content": "霍萊，你覺得這個主意怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213711,
					"content": "咦？霍萊去哪裡了？不、不會是又跑了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250213712,
					"content": "喂！霍萊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡茲加"
				}
			]
		}
