			"trigger": {
				"objectNames": [
					"蘭彌那離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#那菈{NICKNAME}想要打開「寶箱」？但是…桓那還有很多蘭那羅需要幫助，如果金色的那菈可以去幫助這些蘭那羅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000102,
					"content": "蘭彌那離會準備好滿滿的「寶箱」！連同蘭甯巴送回的「寶貝」一起，把「箱」餵得飽飽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭彌那離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#金色的那菈，蘭彌那離知道，是幫助過蘭那羅的好那菈。所以，蘭彌那離的「寶箱」，給那菈{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
