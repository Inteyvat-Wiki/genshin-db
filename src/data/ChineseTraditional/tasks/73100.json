				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭彌那離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#蘭彌那離聽說了，那菈{NICKNAME}在桓那「大展身手」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000302,
					"content": "#「寶」已經放進「箱」裡，那菈{NICKNAME}可以打開「寶箱」，「不要客氣」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭彌那離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#那菈{NICKNAME}，還有派蒙，好慢！蘭彌那離的「寶箱」，早早準備好了，和蘭彌那離一起等了好久好久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000402,
					"content": "蘭那羅的好朋友，「寶箱」已經滿滿了，可以打開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭彌那離",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#很多蘭那羅告訴蘭彌那離，那菈{NICKNAME}和派蒙，做了很多好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000502,
					"content": "蘭彌那離早就知道啦，那些誇獎的話，跑過林間的枝椏，淌過細細的水流，跟著微風一起，都吹進了蘭彌那離的「快樂小窩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000503,
					"content": "#所以蘭彌那離，這次也把「箱」塞得滿滿，就等那菈{NICKNAME}來打開啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000504,
					"content": "#蘭甯巴送回了一些亮晶晶，蘭彌那離也都塞進了「箱」裡，也許那菈{NICKNAME}會喜歡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000505,
					"content": "蘭甯巴沒有回來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "嗯，蘭甯巴不像大樹，根扎得很深，他是停不下來的蘭那羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000507,
					"content": "欸…那蘭彌那離獨自一個在這裡不會寂寞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000508,
					"content": "「寂寞」是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000509,
					"content": "唔…就是，就是獨自一個的時候，很想很想同伴在身邊的感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000510,
					"content": "桓那蘭那有很多蘭那羅，所以蘭彌那離一點也不「寂寞」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000511,
					"content": "不過，蘭雅瑪和蘭甯巴都不在桓那蘭那了。以前，三個蘭那羅在一起，不管做什麼都很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000512,
					"content": "蘭雅瑪的蘭迦拉梨很強，很弱的那菈沒辦法破解。蘭甯巴很會畫畫，畫各種各樣的東西，好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000513,
					"content": "但是現在，只有蘭彌那離和蘭彌那離的「寶箱」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000514,
					"content": "蘭彌那離…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000515,
					"content": "沒關係，蘭彌那離有很多「寶箱」，雖然不知道為什麼那菈這麼喜歡開箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000516,
					"content": "但是蘭彌那離是「寶箱」的主人，喜歡寶箱的那菈，也會喜歡蘭彌那離的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000517,
					"content": "不過，蘭彌那離沒有更多「寶」了，唔…「箱」要過一段肚子空空的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000518,
					"content": "#雖然蘭彌那離的「寶箱」之後要空空了，那菈{NICKNAME}，還是要做蘭那羅的好朋友呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
