				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#蘭彌那離飽飽，「寶箱」餓餓。餓，不好，那菈{NICKNAME}和派蒙走很多路，一定很餓，要多吃蘑菇，這樣才有力氣。",
					"roleType": "TALK_ROLE_NPC",
