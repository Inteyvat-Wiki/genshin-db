			},
			"dialogs": [
				{
					"id": 731000601,
					"content": "#蘭彌那離還沒有準備好！「寶箱」也還沒有吃飽。那菈{NICKNAME}和派蒙可以「遊手好閒」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 731000602,
					"content": "唔，不對，是「四處漫遊」。這樣，說不定會碰到需要幫助的蘭那羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭彌那離"
				}
			]
		},
		{
			"id": 7310007,
			"completionStepIds": [],
