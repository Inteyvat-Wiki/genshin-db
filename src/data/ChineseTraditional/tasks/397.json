	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
