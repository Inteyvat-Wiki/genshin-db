				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪盧克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "深淵教團…這些與人類為敵的怪物，地下情報網也很少出現他們的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970202,
					"content": "但雖然麻煩，終究也還是被我找出一些線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970203,
					"content": "這麼快就有線索了嗎？不愧是消息靈通的迪盧克老爺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970204,
					"content": "不過說起來，風神巴巴托斯大人，為什麼要借助人類的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970205,
					"content": "哈哈，怎麼說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970206,
					"content": "人們所說的七神，更本源的稱謂是「塵世七執政」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970207,
					"content": "劃分塵世、各自統治七分之一，這是我們做為神明的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970208,
					"content": "履行神職，才能累積神力。但我不喜歡統治…我覺得蒙德也不會喜歡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970209,
					"content": "「我們建立無人稱王的自由城邦」——巴巴托斯大人的理念，我們牢記於心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970210,
					"content": "真虔誠啊，琴團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970211,
					"content": "完全沒有想過可能是某人太過自由散漫、不想管事的原因呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970212,
					"content": "咳咳，總之你們看，我都這麼久沒有回過蒙德了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970213,
					"content": "所以現在的我，毫無疑問，正是七神中最弱的一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970214,
					"content": "這話說得真是擲地有聲啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "過獎過獎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970217,
					"content": "呵…我們有這樣一位風神大人，該說是好還是壞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970218,
					"content": "不過現在就先拋開七國與七神的話題，重新關注一下人類共同的敵人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970219,
					"content": "這一次查出的<color=#00E1FFFF>深淵法師蹤跡</color>，就在<color=#00E1FFFF>酒莊</color>附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970220,
					"content": "不能讓它全身而退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970221,
					"content": "開始追獵吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "不愧是「自由之都」的神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "咦？這是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970402,
					"content": "深淵法師被擊敗以後，散逸出了某種能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970403,
					"content": "它原本的用途，似乎是隔絕我和特瓦林之間的連繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}，{F#妳}{M#你}知道<color=#00E1FFFF>「風龍廢墟」</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970406,
					"content": "不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "嗯，但琴團長和迪盧克老爺想必都是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970410,
					"content": "特瓦林甦醒以後，把一片遠古的廢墟當作了牠的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970411,
					"content": "與先前封鎖蒙德四方的暴風一樣，廢墟的入口也有特殊的障壁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970412,
					"content": "但現在，從深淵法師散逸的能量裡，我能讀出編織魔力的韻律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970413,
					"content": "雖然那種韻律比丘丘人的合唱還要難聽，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970414,
					"content": "也足夠讓我們破除暴風障壁、抵達<color=#00E1FFFF>「風龍廢墟」</color>內部了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970415,
					"content": "那，就是要正面挑戰風龍了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970416,
					"content": "我倒是沒有意見…話說回來，琴才是那個想要避免開戰的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970417,
					"content": "不。在沒有更好的選擇時，就由我承擔改變方針的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970418,
					"content": "如果討伐風龍是唯一的方案，那我就會成為衝鋒在前的騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970419,
					"content": "——現在還沒到那一步喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970420,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970421,
					"content": "溫迪閣下的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970422,
					"content": "我的意思是，天空之琴不是我們的底牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970423,
					"content": "#真正的底牌——是{NICKNAME}呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970425,
					"content": "是因為我淨化了淚滴結晶嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970430,
					"content": "淚滴裡的汙穢雜質，和纏繞在特瓦林身上的詛咒，是同一種邪力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970431,
					"content": "所以——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970432,
					"content": "賣唱的，這太危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970433,
					"content": "你看特瓦林發火的樣子，動手前就會被特瓦林一口吞掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970434,
					"content": "都說了我很能打。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "…嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970437,
					"content": "有趣的計畫，值得嘗試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970438,
					"content": "#我也當然會與{F#妳}{M#你}同在，榮譽騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3970439,
					"content": "敵人是…深淵的怪物，和龍！壓迫感很強呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3970440,
					"content": "人類也有人類的底蘊。我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3970441,
					"content": "那麼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970442,
					"content": "英雄的詩篇，終於進入決戰的篇章啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970435,
					"content": "這一戰需要借助大家的力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "是因為我很能打嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#唔嗯…當然，{NICKNAME}的戰力是很強的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3970429,
					"content": "#但在{F#妳}{M#你}的身上，還有更珍貴的閃光點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "溫迪"
				},
