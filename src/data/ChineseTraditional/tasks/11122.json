			"dialogs": [
				{
					"id": 111229901,
					"content": "等等，地上有線索！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111229902,
					"content": "一定是那些礦工留下的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111229903,
					"content": "我們到靈矩關出口去。如果那裡沒有腳印，就表示他們還在靈矩關內，如果有新線索，就繼續追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
