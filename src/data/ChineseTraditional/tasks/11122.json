			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "呀，有腳印！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220202,
					"content": "看來他們穿過了靈矩關，繼續向前步行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220203,
					"content": "跟著腳印就能找到他們的去處了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小玲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "請問妳在這附近見過礦工打扮的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220402,
					"content": "大約是四、五天前吧，有幾個人從這裡走過，背著簍子，提著鐵鎬什麼的…和妳說的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220403,
					"content": "對對，就是他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220404,
					"content": "四、五天前？看來他們走得遠不如我們想像中快，恐怕是被靈矩關的地形耗去了不少時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220405,
					"content": "哎呀，那些人可奇怪了，四個大男人，個個面色呆滯，都像沒睡醒一樣！前面還有個小孩，搖搖晃晃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220406,
					"content": "妳看清那個小孩的模樣了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220407,
					"content": "只掃了一眼，藍色頭髮，個子很矮，好像…好像是個女孩！還有，她表情也很嚴肅，一點笑意都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220408,
					"content": "他們走的是這條路嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220409,
					"content": "是啊，就從這一直往前走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220410,
					"content": "我們追吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琬玉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "這些怪物太暴躁了，只是走過都會被牠們發現，二話不說就往人身上撲…多虧各位救了我，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220702,
					"content": "我叫琬玉，隸屬於璃月盛露廳，負責人文古蹟的研究工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220703,
					"content": "哎呀？不是礦工嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220704,
					"content": "礦工？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220705,
					"content": "嗯，我們在找礦工，一共四個！都是個子高高大大的男性，帶著採礦工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220706,
					"content": "妳說的人，我好像見過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220707,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220708,
					"content": "對，我是前天從南天門出發的，要往靈矩關方向去。半路上遇到一隊人，是一個小孩和幾個大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220709,
					"content": "能說得詳細一點嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "我走得比較急，沒能細看。面貌特徵什麼的都記不清了…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220711,
					"content": "這些就足夠了，謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220712,
					"content": "能幫上忙就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220713,
					"content": "那我就先走一步了，還有學術會議要參加，再次感謝幾位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220714,
					"content": "根據那位學者的說法，這些人應該是往南天門方向去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220715,
					"content": "不過，能確定是同一批人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220716,
					"content": "小孩跟大人的組合，沒那麼常見吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220717,
					"content": "還是滿常見的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "呃…那、那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220719,
					"content": "喂，你們看那邊那塊石頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220720,
					"content": "喔喔，還有這一招呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220721,
					"content": "應該行，我來試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220722,
					"content": "唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220723,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220724,
					"content": "沒錯，是同一批人。他們沿著這條路走過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220725,
					"content": "昆兄讀取石塊回憶的場面，無論看幾次都覺得有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220726,
					"content": "這所謂的本事，平時還真用不上。能讓鍾離先生消遣，也算有些意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220727,
					"content": "小昆簡直是我們的指南針！有你在，才好確定方向呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220728,
					"content": "哈哈哈哈，是嗎？那我也就不枉來此一遭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220729,
					"content": "嗯，這感覺…像在辦案一樣，好有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220730,
					"content": "有趣之餘，別忘了保持警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220731,
					"content": "四名成年人面容呆滯地跟著一個孩童日夜趕路，翻山越嶺…此事絕不簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220732,
					"content": "噢噢！說得也是，鍾離先生真是謹慎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220733,
					"content": "另外，剛才那位學者是被幼岩龍蜥襲擊了，但這種怪物不該有這麼強的攻擊性才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220734,
					"content": "一路走來諸多線索，冥冥之中似乎都有聯繫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220735,
					"content": "工人們是前天往南天門方向去的。從這裡過去，要經過一段艱險的山路。假如他們的目的地就是南天門，我們應該還能趕上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220736,
					"content": "嗯，馬上出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220737,
					"content": "方才我在附近做了記號，如果老戴趕上來，也能循著記號找到我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220738,
					"content": "不愧是鍾離！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"礦工"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "旁邊還落著背簍…他確實是礦工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220803,
					"content": "喂、喂，能聽見我說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220804,
					"content": "看他的樣子，應該是筋疲力盡才昏倒在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220805,
					"content": "要叫醒他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220806,
					"content": "我還能…還能挖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "礦工"
				},
				{
					"id": 111220807,
					"content": "嗯？嘴裡嘀咕著什麼東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220808,
					"content": "一直在掙扎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "如此執著，實在反常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220811,
					"content": "附近有個營地，先帶他到那裡安頓下來，再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220809,
					"content": "很想站起來的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220902,
					"content": "怎麼樣？他不會死吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220903,
					"content": "他是勞累過度所以陷入昏迷。幸好，沒有性命之憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220904,
					"content": "他怎麼會累成這樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "我剛才聽見他在唸叨著說要挖什麼東西，所以他是挖累了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220906,
					"content": "不無可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220907,
					"content": "好奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "嗯？他口袋裡好像有什麼東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220910,
					"content": "這是…礦石的碎片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220911,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220912,
					"content": "各位，我看了他口袋中礦石碎片的記憶。這些碎片是這個人從礦區帶出來的，可見此人確實是我們要找的四名礦工之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220913,
					"content": "那他會倒在這裡，就更有意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220914,
					"content": "被人帶走，然後…被拋下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220915,
					"content": "可既然要丟掉他，又為什麼要把他一路帶到這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220916,
					"content": "除非發生了什麼事，讓他不得不脫隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220917,
					"content": "唔…唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220918,
					"content": "不行，太神秘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220919,
					"content": "啊，對了！看到這些碎片才想起來，我也有些東西要送給你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220920,
					"content": "什麼什麼，有禮物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220921,
					"content": "送給我們？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220922,
					"content": "不瞞你們說，與老戴會合之前我總是犯迷糊，和你們一起查案，思緒才變得清晰起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220923,
					"content": "我一直在偷偷慶幸老戴還找了你們幾位幫忙。要是沒有你們，只憑我一人，恐怕沒辦法查到這麼多線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220924,
					"content": "這些是我從市集挑來的水晶，別看它只是水晶，成色可是極其罕見的！一人一塊，就當留個紀念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220925,
					"content": "好漂亮的水晶啊，顏色還會變！這樣看，那樣看…感覺都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220926,
					"content": "看起來非常貴重…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "別客氣，拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220929,
					"content": "這塊給鍾離先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220930,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220931,
					"content": "咦？怎…怎麼了，不喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220932,
					"content": "不，怎麼會呢。只是沒想到，會在這樣的時刻收到禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220933,
					"content": "多謝，我會好好保管的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220934,
					"content": "謝謝你們願意收下。好的禮物送給識貨的朋友才有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220935,
					"content": "我看這一帶也有不少石塊，你們先休息吧，我去附近逛逛，順便摸摸石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220936,
					"content": "小昆還真是喜歡石頭啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220937,
					"content": "礦石是大地的結晶，時間的沉澱。和它們在一起，我會覺得安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220938,
					"content": "你們慢慢休息，出發前叫我一聲。我就在附近，不會走遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "昆鈞"
				},
				{
					"id": 111220939,
					"content": "他一個人不要緊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "不用擔心，我剛才看過周圍，沒有其他危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220941,
					"content": "#對了，我有話要跟{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220942,
					"content": "唔？神情有些嚴肅哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220943,
					"content": "#旅行者，關於「鎮龍石」，{F#妳}{M#你}有什麼印象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220944,
					"content": "沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "是他找的那種礦石對吧，有什麼特別之處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220946,
					"content": "鎮龍石是一種罕見的鍛造用礦石。常見的水晶多數是在高溫環境下自然形成，鎮龍石卻是元素反應引發的結晶成品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220947,
					"content": "元素反應能產生實物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220948,
					"content": "可以。不過只有很少一部分能長久保存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220949,
					"content": "鎮龍石誕生於千百年前的一場大戰。強烈的元素力碰撞導致元素結晶，戰鬥結束後，這些石頭奇蹟般地留存了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220950,
					"content": "居然是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220951,
					"content": "但它畢竟是結晶造物，數量很少，知名度也不高，而且早在幾百年前就開採殆盡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220952,
					"content": "現代的璃月人，為什麼要找早已不存在的礦石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220953,
					"content": "對哦！如果他能知道這種石頭的存在，不就更應該知道它被人採光了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220954,
					"content": "好奇怪…完全說不通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220955,
					"content": "礦業相關的工作者裡，也有一些對鎮龍石感興趣的人。但像昆兄這樣說不出緣由卻要找石頭的…十分少見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220956,
					"content": "或許他是另有來意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "另有來意…是壞人嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220958,
					"content": "現在很難定論，不如先靜觀其變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220959,
					"content": "別忘了，眼下最主要的目的是救回那些礦工。至於其他事情，早晚也會水落石出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220960,
					"content": "與目標的距離正在縮短。我想，我們應該沿這條路繼續走。能找到其中一個，就能找到剩下的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220961,
					"content": "#等{F#妳}{M#你}休息完畢，請叫上昆兄，我們繼續追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220962,
					"content": "至於這位工人，可以先安置在營地內，等解決了事件，再回來照看他。給老戴留張字條，萬一他找來也能及時處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220927,
					"content": "真的可以給我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "他不是被帶走了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
