			"dialogs": [
				{
					"id": 710800613,
					"content": "講述有關黑霧與深淵怪物的故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800614
					]
				},
				{
					"id": 710800614,
					"content": "#{F#妳}{M#你}為塔列辛講述了此前的經歷…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "哇…這個很好！這個很好！請讓我記錄下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710800616,
					"content": "「…深黑的霧氣如雪崩壓至，倏而離析，來自深淵的兩位使徒消失不見，正如來時一般…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
			]
		},
