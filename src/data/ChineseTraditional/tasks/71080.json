					"nextDialogs": [
						710800643
					]
				},
				{
					"id": 710800643,
					"content": "哈哈，這個故事很有意思呀！「…『日暮途窮的苦澀今日，竟被大敵所搭救！』安東上士如是嘆息…」",
					"roleType": "TALK_ROLE_NPC",
