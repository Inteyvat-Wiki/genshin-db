			"dialogs": [
				{
					"id": 708240101,
					"content": "打掃得細心一點！這可是客人們對酒莊的第一印象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 708240102,
					"content": "對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 708240103,
					"content": "我們會再細心點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 708240104,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "是您啊，歡迎光臨晨曦酒莊，暴風雖然平息了，但被暴風弄得亂七八糟的酒莊還要收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 708240106,
					"content": "我正在安排打掃的事，但是摩可和海莉，實在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 708240107,
					"content": "對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 708240108,
					"content": "我們會再細心點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 708240109,
					"content": "你們已經說過一次了！有道歉的功夫，還不如去再細心打掃一遍，還不快去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "愛德琳"
				},
				{
					"id": 708240110,
					"content": "唉，這兩個孩子，怎麼老是這麼粗心，用這種工作效率，什麼時候才能收拾完，屋子裡面可還要打掃呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛德琳"
				}
			]
		},
