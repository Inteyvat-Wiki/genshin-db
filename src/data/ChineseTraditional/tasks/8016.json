			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丘丘人"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "欸，有個丘丘人在這裡呢，是在休息嗎？看起來好像沒什麼攻擊性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160202,
					"content": "為什麼躲在這裡呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160203,
					"content": "#啊，{F#妳}{M#你}把它吵醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160204,
					"content": "嗯？跑掉了…我們在納塔的名號，已經對丘丘人都這麼有威懾力了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160205,
					"content": "好像有東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "#{F#妳}{M#你}說那個亮晶晶的？剛剛它逃跑的時候從身上掉出來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160207,
					"content": "唔…我猜是它自以為撿到了什麼寶貝，準備在這裡藏起來吧，沒想到這麼快就被我們發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160208,
					"content": "我看看我看看，雖然感覺以丘丘人的智慧，應該不是什麼好東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160209,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#啊？怎麼了，{NICKNAME}，怎麼{F#妳}{M#你}的表情這麼嚴肅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160211,
					"content": "這不就是一把普通的鑰匙嗎？不過樣式的確有點稀奇，不像是納塔的風格…嗯…會是哪個國家造的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160212,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "飛船休眠艙？什麼飛船，什麼休眠艙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160215,
					"content": "#等等！飛船休眠艙？難、難道說！是{F#妳}{M#你}來到提瓦特乘坐的那個飛船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160216,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "#怎麼會突然出現在這裡！{F#妳}{M#你}確定不是{F#妳}{M#你}剛才自己掉的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160218,
					"content": "我的在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "#哦~看上去一模一樣…那麼這把不是{F#妳}{M#你}的，難道說它應該屬於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160221,
					"content": "一共就只有這兩把。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "#果然如此…唔，這個時候我才真切地感受到{F#妳}{M#你}是個「外星人」…哦不，「降臨者」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160224,
					"content": "那麼這個情況，讓我推斷一下，邏輯應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160225,
					"content": "#丘丘人之所以能在附近撿到這把鑰匙並且藏起來，是因為{F#妳}{M#你}{M#妹妹}{F#哥哥}在這附近弄丟了它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160226,
					"content": "#也就說明{F#妳}{M#你}的{M#妹妹}{F#哥哥}最近曾在這一帶活動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160227,
					"content": "也就是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#是啊…沒想到原本只是隨口答應幫伊安珊巡邏，結果有了這麼重大的發現，甚至還得到了{F#妳}{M#你}{M#妹妹}{F#哥哥}的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160230,
					"content": "我們現在是繼續在附近找找線索呢，還是先到「沃陸之邦」找伊安珊呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160231,
					"content": "#{F#妳}{M#你}們在這啊，辛苦了，看來{F#妳}{M#你}們巡邏很用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160232,
					"content": "伊安珊！妳怎麼過來了，不是應該在「沃陸之邦」集合嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160233,
					"content": "我們正考慮要不要去找妳，剛剛有了重大發現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160234,
					"content": "我是來通知你們不用繼續巡邏了，因為健美比賽剛剛取消了，晚點會有巡邏隊過來接手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160235,
					"content": "等等，發生什麼了，這麼突然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160236,
					"content": "「深淵教團」打過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160237,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160238,
					"content": "沒想到這麼快就印證了猜想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#（看來是{M#熒}{F#哥哥}又有行動了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#（這次一定要把握住機會，與{M#她}{F#他}見面。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "我之前對深淵教團的名號有所耳聞，但從未見過它們如此大規模、大範圍的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160242,
					"content": "簡直…像是準備與納塔整個國家開戰一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160243,
					"content": "單單一個「教團」，要與被稱為「戰爭之國」的國家開戰？難以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160244,
					"content": "印象裡深淵教團大多情況下都是在暗中活動，這種情況我們也是第一次見…他們到底想要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160245,
					"content": "現在單單從「沃陸之邦」的視角，戰況還不夠明確。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160246,
					"content": "目前「沃陸之邦」的防禦應該不成問題，我決定到聖火競技場去找瑪薇卡瞭解一下情況，畢竟那裡才是中樞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160247,
					"content": "#要不要跟我一起，{NICKNAME}，有納塔的英雄坐鎮總歸更讓人放心一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160248,
					"content": "我也很需要瞭解情況。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "那正好，我們一起過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160249,
					"content": "我對深淵教團也有所瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "「深淵教團」很可能也來過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#一把在我身上，一把屬於我{M#妹妹}{F#哥哥}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "…我一直有好好帶在身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "…飛船休眠艙的鑰匙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
