				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "#旅行者，又見面了。上次多虧了{F#妳}{M#你}幫忙，社長已經確定了犯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350102,
					"content": "但想讓那個犯人徹底伏法，需要再做一些準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350103,
					"content": "社長會處理其他的事，我們就繼續上次的工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350104,
					"content": "還要繼續找盜寶團麻煩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "沒錯。雖然那個犯人也許和我們要對付的那些盜寶團沒關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350106,
					"content": "但那些盜寶團平日裡也沒有做什麼好事，這次就讓他們繼續「幫」我們一把好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350112,
					"content": "具體的地點社長也已經幫我標好了，就在城外不遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350113,
					"content": "城內的話…社長也已經私下裡和天野和安藤先生交代過了，他們也會配合我們行動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350114,
					"content": "而且…社長也已經承諾了他們，破獲這樁案子的功勞，都歸他們所有。他們一定會很樂意合作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350115,
					"content": "思考和計劃就交給社長吧，我們繼續去和那些盜寶團好好「交流」一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350116,
					"content": "#我把地點也標在{F#妳}{M#你}的地圖上了，我們這就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350107,
					"content": "還要繼續麻痹那傢伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "沒錯。我們還要繼續讓他以為，我們的目標還是盜寶團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350109,
					"content": "這樣，社長才能有更多的時間調整計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350110,
					"content": "呵呵…反正那些盜寶團平日裡也沒有做什麼好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350111,
					"content": "這次，就讓他們繼續「幫」我們一把好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
