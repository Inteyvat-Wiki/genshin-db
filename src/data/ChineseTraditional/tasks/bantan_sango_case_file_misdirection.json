	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
