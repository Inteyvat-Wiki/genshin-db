				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "嗯，這次的動靜也夠大了，天野和安藤先生會配合我們，讓城裡的那個盜賊察覺到這個消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350205,
					"content": "這還要折騰多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "很快了，只要社長做好準備，我們就可以去給這樁案子收尾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350207,
					"content": "#這些報酬給{F#妳}{M#你}，旅行者，多謝{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220350208,
					"content": "#這是社長親自指定的數目，應該是十分合適的，請收下吧，說不定之後還要麻煩{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
