			"dialogs": [
				{
					"id": 4260101,
					"content": "坐下來休息一會吧，接下來有什麼計畫呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260102,
					"content": "想做任務",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "這個簡單，點開左上角的嘆號圖示，就能看到現在已經接取的任務啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260104,
					"content": "任務有難度等級，等級差太多的話，會很棘手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260117,
					"content": "還有什麼想瞭解的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260105,
					"content": "想四處逛逛",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "不同的區域也有對應的難度等級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260107,
					"content": "挑戰適合難度的區域，才能最有效的提升實力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260108,
					"content": "冒險家協會的艾爾菲，對提瓦特大陸可以說瞭若指掌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260109,
					"content": "她就在蒙德城進門的商業街上，去問問她有沒有適合的探索區域吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260110,
					"content": "想要變強",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "唔，那可離不開稱手的武器和珍貴的聖遺物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260112,
					"content": "聽說地下城裡有不少好東西，就是比較兇險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260113,
					"content": "當然也可以去蒙德城的商業街上購買，如果預算允許的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260114,
					"content": "還有，武器和聖遺物也都可以強化和突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260115,
					"content": "#這些就需要{F#妳}{M#你}自己多研究啦",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260116,
					"content": "對了，角色自身的等級也很重要哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4260118,
					"content": "沒啥，妳先回去吧~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "嗯嗯~",
