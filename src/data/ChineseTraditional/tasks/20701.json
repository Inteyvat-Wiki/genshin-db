			"dialogs": [
				{
					"id": 207010101,
					"content": "肚子怎麼又餓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010102,
					"content": "#咦，是{F#妳}{M#你}啊！太好了，{F#妳}{M#你}還記得我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010103,
					"content": "香菱，料理對決，是我啊，齊格芙麗雅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010104,
					"content": "#嘿嘿，記起來了嗎，{F#妳}{M#你}來得正好，我能不能…拜託{F#妳}{M#你}一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010105,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "#{F#妳}{M#你}還記得，{F#妳}{M#你}上次做的那道「翡玉什錦袋」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010107,
					"content": "我一直記得那個味道，實在是太好吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010108,
					"content": "所以，我想要自己也來做一做看，但是…感覺做出來的味道始終都差一點點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010109,
					"content": "我覺得，只要再仔細品嚐幾次，我就能重現那個味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 207010110,
					"content": "#能不能拜託{F#妳}{M#你}，再把「翡玉什錦袋」做給我嚐嚐看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊格芙麗雅"
				}
			]
		},
