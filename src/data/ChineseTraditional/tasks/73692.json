			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "#啊…{F#妳}{M#你}好，旅行者，看樣子，{F#妳}{M#你}也是來參加學院遊樂會的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920102,
					"content": "如果有興趣的話，您願意來試玩一下我們阿彌利多學院推出的小遊戲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920103,
					"content": "是什麼小遊戲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "我們學院在學院遊樂會期間推出了小遊戲「仿生摹行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920105,
					"content": "在這個遊戲中，我會向您介紹一些動物的規律行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920106,
					"content": "當然了，這些「規律性」都經過了我們的簡化和概括，很容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920107,
					"content": "您需要做的，就是用這個我們已經準備好的模型來模仿對應動物的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920108,
					"content": "聽起來還滿簡單的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "是的。「動物具有規律性的習性」是一句很容易理解和接受的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920111,
					"content": "但在這句看似簡單的話背後，卻包含著探究不盡的謎題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920112,
					"content": "不過…這段時間內，我們就暫時放下學術性的觀察眼光，輕鬆地體會一下動物們的習性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920113,
					"content": "想要試玩一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "好的，請您到這邊來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920115,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "沒關係，這段時間，我的攤位會一直開著，您可以隨時來試玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕茲"
				},
				{
					"id": 736920109,
					"content": "感覺倒是不難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}