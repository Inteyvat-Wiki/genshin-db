			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菈烏瑪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#是{F#妳}{M#你}們啊，{NICKNAME}和派蒙。林間的飛鳥剛剛就在談論{F#妳}{M#你}們的到來。今日前來，可是有什麼要事，或是…需要我稍作指引？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010102,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "這裡深受月華浸潤，無論是植被還是棲息於此的生靈，都與外界不盡相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010105,
					"content": "的確是個能留下許多珍貴畫片的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010106,
					"content": "兩位請隨意徜徉，若有任何好奇之處，隨時可以問我，我會盡我所能解答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010107,
					"content": "這裡的氣氛非常寧靜呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "是的，這裡是我的靜思之地，也是我與萬物低語、交流的所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010110,
					"content": "僅僅是站在這裡，心神就會歸於安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010111,
					"content": "哇，聽起來好有詩意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765010112,
					"content": "其實，我有一個小小的請求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "是啊，菈烏瑪小姐站在這裡，和這裡的景色渾然一體，簡直美得像一幅畫！用留影機拍下來一定非常好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765010115,
					"content": "#為我…留下畫片嗎？這倒是新奇的體驗。若{F#妳}{M#你}們認為此刻的寧靜以及我的身影，值得讓{F#妳}{M#你}們的鏡頭記錄，那我很樂意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010116,
					"content": "#能成為{F#妳}{M#你}們旅途中一段美好的回憶，也是我的榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010117,
					"content": "那麼，我該如何配合呢？是需要我望向某個方向，還是保持自然的姿態便可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010118,
					"content": "像平時一樣就可以了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "#好的，那接下來就交給{F#妳}{M#你}了。願{F#妳}{M#你}能捕捉到那瞬息的靈感之光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 765010119,
					"content": "我會努力捕捉最動人的一刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "我們希望能為妳拍攝畫片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "菈烏瑪平時都會待在這附近嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
