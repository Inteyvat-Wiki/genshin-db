					{
						"sceneId": 3,
						"position": [
							-2156.834,
							174.01,
							5993.106
						],
						"pointId": 3965
					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "#哦哦，感謝{F#妳}{M#你}！勇敢的冒險家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120102,
					"content": "還好還好，沒過多長時間，零件還沒怎麼被糟蹋…只要再修整一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120103,
					"content": "維納亞克開始埋頭處理機械…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "…維納亞克？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120105,
					"content": "嗯嗯，快了快了！馬上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120106,
					"content": "——維、納、亞、克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120107,
					"content": "嗚哇！施芮婭？妳是什麼時候來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120108,
					"content": "就在你擺弄零件的時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "妳不是說，這裡有魔物，很危險嗎？怎麼連妳自己也過來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120110,
					"content": "…我只是在擔心我們的零件而已，免得到時候交不了差，連我都回不了教令院！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120111,
					"content": "哈，我就說嘛——妳看，全都收集完了，等回去做完進一步的調整，就能開始組裝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120112,
					"content": "話說，這些都是什麼的零件呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120113,
					"content": "#啊，忘了向{F#妳}{M#你}們介紹了——這是「對沙蟲用殺蟲炮」，我們當年的畢業設計作品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120114,
					"content": "——為什麼會有這麼偏門的選題啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120115,
					"content": "你要是也為了畢業開過題，就知道為什麼了…咳，總之這些不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120116,
					"content": "正式自我介紹一下，我是從阿彌利多學院畢業的學者施芮婭，主修沙漠生物學與環境學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120117,
					"content": "…這邊這個機械笨蛋是剎訶伐羅學院的，主修的是應用機關術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120118,
					"content": "——我叫維納亞克，之前真是多謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120119,
					"content": "學的方向完全不同欸…這樣也能合作起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120120,
					"content": "別提了…當初為了成功開題跟這傢伙合作做畢設，絕對是我在學生時代犯的最大錯誤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120121,
					"content": "也不能這麼說吧，妳看我們兩個不還是照樣畢業了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120122,
					"content": "是啊！你算算看比同屆入學的人晚了多少年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120123,
					"content": "那好歹也算畢業了吧？我聽說有些人的題目去年才通過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120124,
					"content": "啊啊…夠了！這種無意義的爭論留在學生時代就夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120125,
					"content": "但每次不都是妳先開始的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120126,
					"content": "哪有？就說我們第一次做原型機的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120127,
					"content": "停停停！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "唔…關係好差，教令院怎麼會想到派你們倆來處理這件事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120130,
					"content": "唉，倒也不能說是教令院叫我們來的…其實這件事本來是由我們院的庫納爾全權負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120160,
					"content": "他算是我導師的導師吧，當初我們畢業口試的時候也有來旁聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120161,
					"content": "大概就是那個時候，讓他留下了「院裡的年輕人做過什麼沙蟲炮」的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120162,
					"content": "所以這次，他說什麼「要多讓年輕人發光發熱！」然後把我們抓過來，強迫解決這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120163,
					"content": "明明我們畢業之後就沒怎麼來往了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120131,
					"content": "就連我的導師也被他說動了…咳，不過藉這機會，我才能讓這門「對沙蟲用殺蟲炮」重見天日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120132,
					"content": "——等到組裝完成，就能讓那些蟲子見識一下它的厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120133,
					"content": "這個機械笨蛋又開始了…不過從我的角度來說，也想研究一下這些沙蟲作亂的原因，維護沙漠的生態平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120134,
					"content": "#冒險家{M#先生}{F#小姐}，您的身手看起來很不錯。請問在我們留居沙漠的這段時間裡，能聘請您來保護我們的安全嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120135,
					"content": "摩拉到位一切好說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "請放心，這趟出來教令院別的援助不多，經費倒是給得滿充足…雖然某人已經花掉了大半來升級機械配置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120138,
					"content": "都、都是必要的提升！…話說妳這不是能好好說話嗎，怎麼一拐到我身上就帶刺了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120139,
					"content": "——那要看說話的對象有沒有讓人好好說話的價值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120140,
					"content": "欸，這兩個人又要開始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735120141,
					"content": "要吵架你們晚點盡情吵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "唉…抱歉，學生時代留下的老毛病了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120144,
					"content": "這批零件還得帶回阿如村去做進一步的調整，算起來，怎樣也得到明天才能開始組裝了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120145,
					"content": "我們之前計劃在附近有沙蟲出沒過的地方安裝「對沙蟲用殺蟲炮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120146,
					"content": "#到時候，可能還會有其他魔物被我們弄出的動靜吸引過來——那就得拜託{F#妳}{M#你}出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120147,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "那現在，施芮婭，我們可以繼續辯論了，我花掉的經費絕對有理有據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735120150,
					"content": "你…！好啊！算帳是吧？奉陪到底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735120148,
					"content": "明天見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "能不能先說一下工作安排。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "區區小事不足掛齒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
					"content": "要沒完沒了了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				}
			]
		}
	]
}