				"points": []
			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "協會到底忙不忙得過來，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280402,
					"content": "旅行者！不好意思，我剛才在想一些協會裡的事務，有點恍神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280403,
					"content": "#{F#妳}{M#你}來蒙德城，應該是來參加風花節的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280404,
					"content": "我們冒險家協會正好推出了一個小遊戲，保證輕鬆有趣，參與就有獎勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280405,
					"content": "#怎麼樣，{F#妳}{M#你}要不要來試試看啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280406,
					"content": "#我先為{F#妳}{M#你}介紹一下這個小遊戲。協會裡設計這個遊戲的人，把它取名叫做「逐花棋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280407,
					"content": "他說自己的靈感是來自於飄飛的花瓣，還有追逐著花瓣的風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280408,
					"content": "整個遊戲的感覺，也是想要模擬那種追逐花瓣的…浪漫感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280409,
					"content": "滿，滿有故事性…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "這老兄是個吟遊詩人…比較富有那個…想像力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280412,
					"content": "簡單來說，玩這種棋的時候，玩家需要盡量地去收集棋盤內分佈的「風花球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280413,
					"content": "在收集的同時，還要閃避各種阻礙…當然啦，棋盤裡還有各種輔助性的道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280414,
					"content": "#那位老兄可是專門寫了一整本詳細的遊玩手冊，{F#妳}{M#你}等一下可以看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280415,
					"content": "#如果有興趣的話，歡迎{F#妳}{M#你}來試玩啊，參與就有獎勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卜勞恩"
				},
				{
					"id": 705280410,
					"content": "這，這麼複雜嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}