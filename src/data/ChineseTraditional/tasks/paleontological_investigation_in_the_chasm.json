			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "關於奇怪的岩石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "拍到了奇怪的岩石的照片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500603,
					"content": "請務必給我看一眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500604,
					"content": "就是這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "欸呀，這照片！真不愧是楓丹那邊做出來的新機型，拍攝得相當清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500606,
					"content": "之前倒是買過一批試驗機型，拍得很模糊，而且一台機子還要兩個人抬，最後只能放在教令院積灰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500607,
					"content": "積灰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "是啊，好歹也是我一頓飯的錢。嗯…看來是時候再買一批新的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500610,
					"content": "說遠了，我看看，這石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500611,
					"content": "嗯，這是化石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500612,
					"content": "化石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "是啊，而且有很多海洋生物…有趣。璃月有一句話叫做…「林園和田野，被茫茫的大海淹沒」？說的就是這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500614,
					"content": "層岩巨淵這邊能夠出現化石，就說明原本這些生物曾經被迅速埋藏在地下，骨骼才能保持如此完整的形狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500615,
					"content": "這麼說來，聽說這裡也時常發生地震…這樣就說得通了，活躍的地質活動是形成化石的必要條件之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500616,
					"content": "這可對研究這一片區域的古生物類群很有幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500617,
					"content": "可是只有一張的話可不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500619,
					"content": "#這樣{F#妳}{M#你}要是還有這樣的化石，就拍下來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500620,
					"content": "那要拍幾張才行啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "我想想，要放進報告裡的話，類似的照片4、5張應該足夠了…那就5張吧，給我5張類似岩石的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500622,
					"content": "我會給出合適的價錢買下的，這可是大發現啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500608,
					"content": "有點浪費…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
