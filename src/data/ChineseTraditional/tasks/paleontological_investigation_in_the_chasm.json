			]
		},
		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "不錯不錯，真是不可多得的好照片啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500903,
					"content": "勘探隊的那些開銷，只要有這幾張照片那就值回票價了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500904,
					"content": "#{F#妳}{M#你}看，這些都是遠古海生生物的骨骼，造型也非常清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500905,
					"content": "證明了層岩巨淵在形成以前，其實是海洋環境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500906,
					"content": "真可惜，如果是在須彌發現這樣的化石，就能夠直接搬回教令院進行研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500907,
					"content": "下次再和總務司接洽的時候，跟他們談談好了，我們這邊出錢請人保護也行，得小心一些啊，不能讓礦工把這些化石給敲壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500908,
					"content": "不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500909,
					"content": "不過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "這些照片…勉強算是足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500912,
					"content": "之前說了吧，這麼品相完好，結構完整的化石，它形成也是有條件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500913,
					"content": "那就是被迅速埋藏入土中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500914,
					"content": "層岩巨淵的化石，基本上只出現在某個固定的高度區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500918,
					"content": "固定高度？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "哎呀，從地質學的角度上來說，這個等級的差異可以忽略不計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500915,
					"content": "總之，這就說明形成化石的時期很短，而且都相當接近…說明在很短暫的時間段裡發生了特別大的生態變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500916,
					"content": "譬如說，巨大的衝擊導致的…之類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500917,
					"content": "嗯，層岩巨淵，到底發生過什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500919,
					"content": "上下高度差挺大的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "難道是照片不夠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
