				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760101,
					"content": "#怎麼樣，{M#大哥哥}{F#大姐姐}找到未來星了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760102
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760102,
					"content": "六顆未來星都找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760103
					]
				},
				{
					"id": 736760103,
					"content": "哈哈太好啦，這下就可以去召喚大未來星了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760104
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760104,
					"content": "#{M#大哥哥}{F#大姐姐}，在出發之前{F#妳}{M#你}得做好準備，召喚大未來星的時候說不定會出現意外的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760105
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760105,
					"content": "#每次我做些特別的事情的時候，總是會有意外發生。我都有做好準備，{F#妳}{M#你}也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760106
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760106,
					"content": "上次我在家裡發射大黃金飛天箭的時候，院子就突然爆炸了，要不是「蘋果」衝過來把我和沙爾瑪叼走，我們倆就慘囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760107
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760107,
					"content": "哇，這也太危險了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760108,
					"content": "不過我覺得妳可以放心，一般來說，問題都算可控！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760109
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760109,
					"content": "院子都爆炸了欸，問題已經夠大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760110,
					"content": "#沒關係的啦，{F#妳}{M#你}們不用害怕。準備好了之後，就去地圖上我標記好的地方和我會合吧，我先出發啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760111
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760111,
					"content": "#{NICKNAME}，我有點不太好的預感，待會我們一定要小心點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7367603,
			"completionStepIds": [
				7367602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367602",
							"2"
						],
						"stepId": 7367602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760301,
					"content": "喔！只有最後一道機關了，這次的最終試煉看起來很簡單嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760302
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760302,
					"content": "這次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760303
					]
				},
				{
					"id": 736760303,
					"content": "對啊，我之前幾次碰到的機關都比這個複雜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760304
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760304,
					"content": "有的要用很多種方法試才能試出唯一解除方法，有的是解錯了就會自毀，特別麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760305,
						736760306
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760305,
					"content": "要不然妳來吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				},
				{
					"id": 736760307,
					"content": "不過按我的經驗，這個機關跟沙爾瑪平時撿回家裡的低級舊機關差不多，應該是嵌入所有機鑰就能解鎖的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760308
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760308,
					"content": "芭努，妳平常一直都在和這些奇奇怪怪的機關打交道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760309,
					"content": "對呀，我經常和沙爾瑪還有「蘋果」一起去各種好玩的地方做好玩的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760310
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760310,
					"content": "這次出來找未來星也是，平時和沙爾瑪一起編設定也是，遇到許多意外也是，有趣得不得了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760311
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760311,
					"content": "要是每天都只在家門口附近轉悠，每天都做一樣的事，那也太無聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760312
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760312,
					"content": "#這個我同意，{NICKNAME}和我也經常離開熟悉的地方，去新奇的地方探險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760313,
					"content": "雖然我們碰到過很多嚇人的東西，但也有特別驚喜特別受震撼的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760314,
					"content": "太好啦，我們肯定能成為好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760315
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760315,
					"content": "但是呢，有件事我要先說好。我知道出門到處跑很好玩也很危險，所以我都有好好做準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760316
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760316,
					"content": "沙爾瑪跟我說，想要找人幫忙的時候就得好好觀察對方，盜寶團、還有陌生的鍍金旅團的叔叔阿姨們就不能找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760317
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760317,
					"content": "#我覺得{M#大哥哥}{F#大姐姐}{F#妳}{M#你}看起來像是善良的人，才會請{F#妳}{M#你}幫忙的。不過請善良的哥哥姐姐們幫了忙，就不能害{F#她}{M#他}們倒楣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760318
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760318,
					"content": "#這是我的原則。所以如果{M#大哥哥}{F#大姐姐}覺得害怕，也沒關係，我自己也可以解開這個機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760319,
						736760320
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760319,
					"content": "笑話，我會害怕？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760321,
					"content": "#那也行。總之{M#大哥哥}{F#大姐姐}不用太擔心，只要把六顆未來星全部嵌進機關裡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760320,
					"content": "有點危險，還是我來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760306,
					"content": "我突然想起來我還有事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				}
			]
		},
		{
			"id": 7367604,
			"completionStepIds": [
				7367604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367604",
							"2"
						],
						"stepId": 7367604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沙爾瑪",
					"芭努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760401,
					"content": "芭努，妳沒受傷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760402
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760402,
					"content": "才這點程度，沒什麼好怕的啦。你寫的書裡教過：打不過立刻就跑。我早就躲到一邊去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760403
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760403,
					"content": "對了沙爾瑪，你怎麼還把「蘋果」帶來了呀，她現在應該在好好看家才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760404
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760404,
					"content": "「蘋果」有點擔心你，就跟著我出來了。妳知道的嘛，她只聽妳和媽媽的話，我勸她她也不回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760405,
						736760406
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760405,
					"content": "等一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760407
					]
				},
				{
					"id": 736760407,
					"content": "芭努好像認識那隻突然竄出來的長鬢虎，還叫牠「蘋果」…還有這個跟長鬢虎一起突然出現的人，到底怎麼回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760408,
					"content": "#{M#大哥哥}{F#大姐姐}，我來給{F#妳}{M#你}介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760409
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760409,
					"content": "#這個冒冒失失的傢伙就是沙爾瑪，我借給{F#妳}{M#你}的那本《遊學者不可不知的五十件事》就是沙爾瑪寫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760410
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760410,
					"content": "#我本來想等到大未來星召喚儀式之後再把沙爾瑪和「蘋果」一起介紹給{F#妳}{M#你}的，但是果然，這次也碰到了意外情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760411
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760411,
					"content": "也好，這樣就不用費力氣去找人啦，這次的意外發生得正正好，不錯不錯。希望下次也有這麼好的運氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760412
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760412,
					"content": "#{F#妳}{M#你}好，本人是芭努生物學意義上的父親，沙爾瑪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760413
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760413,
					"content": "至於「蘋果」，她是我們家庭中的另一位重要家庭成員，一隻優雅的雌性長鬢虎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760414
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760414,
					"content": "生、生物學意義上的父親？呃…這是什麼意思？難道在別的地方，你就不是芭努的父親了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760415,
					"content": "的確如此。在本人的心目中，本人是和芭努平等的朋友；在日常生活中，本人是和芭努平攤家務的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760416
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760416,
					"content": "父親不過是這些身分中微不足道的一個而已，比起父親，本人更願意做芭努的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760417
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760417,
					"content": "#剛才本人一直躲在機關下方的地洞裡聽{F#妳}{M#你}們的對話，{F#妳}{M#你}們如此願意幫助芭努，本人萬分感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760418
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760418,
					"content": "不客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760419
					]
				},
				{
					"id": 736760419,
					"content": "呃，這個鄭重過頭的說話口氣…我知道剛見面的時候芭努為什麼會那樣和我們說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760420,
					"content": "芭努的措辭和處事方式的確和本人有相似之處，但總體來說，芭努都是個比本人優秀萬分的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760421
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760421,
					"content": "比如她做的拌飯比本人做的足足好吃一萬倍。僅僅是這一點，就已經足夠了不起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760422
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760422,
					"content": "因此，本人十分珍惜和這樣快樂活潑的優秀孩子相處的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760423
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760423,
					"content": "每每想到她即將進入教令院，過上每天泡在教研室裡抓頭髮到半夜、沒到四十歲頭髮就提前變白、長期不按時吃飯導致營養不良的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760424
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760424,
					"content": "本人就感到十分痛心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760425
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760425,
					"content": "在芭努還沒進入教令院之前，本人當然需要抓住一切機會，為芭努留下有趣的回憶。這次的尋星之旅就是為了這個目的設計的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760460
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760460,
					"content": "由於本人對地脈與機關術有些小小的研究，所以利用這片土地上早已有之的機關做了些小小的佈置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760461
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760461,
					"content": "沙爾瑪，我問你，之前找未來星的時候也好，剛才也好，那些魔物都是你招出來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760462
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760462,
					"content": "#不不不，這個…這個都是意外。怪我考慮不周，讓{F#妳}{M#你}們遇到危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760463
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760463,
					"content": "#我…我其實有讓「蘋果」暗中跟著妳，至於這位冒險家{M#先生}{F#小姐}，我看{M#他}{F#她}的身手那麼誇張，就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760464
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760464,
					"content": "唉，沙爾瑪真是個靠不住的爸爸，沒有我和「蘋果」的話，你該怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760426
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760426,
					"content": "#{NICKNAME}和我也旅行了好久了，你這種奇怪的父親我還是第一次見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760427,
					"content": "奇怪嗎？奇怪正是本人的人設之一，這個評價真是對本人最好的讚揚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760428
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760428,
					"content": "這也是設定的一部分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760429
					]
				},
				{
					"id": 736760429,
					"content": "是的。否則，在這個擁擠的世界裡，本人和庸庸碌碌的其他人又有什麼區別呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760430
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760430,
					"content": "雖然不論本人言行有多奇怪，依然不過是偌大世界中的普通人，但本人卻擁有位高權重的賢者所無法擁有的胡說八道的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760431
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760431,
					"content": "啊！這多是一件樂事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760432
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760432,
					"content": "#{M#大哥哥}{F#大姐姐}別被沙爾瑪搞昏頭了，每次他想把什麼事情唬弄過去的時候，就會像這樣胡說八道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760433
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760433,
					"content": "沙爾瑪，我問你，我的大未來星呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760434
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760434,
					"content": "你之前說集齊六顆未來星、解開最終機關，就可以召喚大未來星的，大未來星在哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760435
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760435,
					"content": "放心放心，這次我絕對沒有唬弄芭努。妳看，大未來星就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760436
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760436,
					"content": "沙爾瑪從口袋中掏出了一枚星螺遞給芭努。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736760437
					]
				},
				{
					"id": 736760437,
					"content": "這就是集齊未來星之後，跨越了無窮廣闊的星海來到芭努身邊的大未來星。妳看，它表面是不是有一顆閃亮的白色星星？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760438
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760438,
					"content": "#這顆星星就是{F#妳}{M#你}們收集的未來星凝成的，它是妳的大未來星。妳把耳朵湊到那個黑色的開口聽聽看，星海在對妳說話呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760439
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760439,
					"content": "喔！這就是大未來星啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760440,
						736760441
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760440,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760442,
					"content": "這人在胡說八道吧，這不是璃月海灘上到處都有的星螺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760443,
					"content": "唔…沙爾瑪，星螺是它在另一個設定裡的名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760444
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760444,
					"content": "咳咳…也能這麼說，在許多人的設定裡它叫星螺，是長在海裡的。但…但是在我的設定裡，它的名字叫大未來星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760445
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760445,
					"content": "啊我懂了，就像你從教令院的垃圾堆裡淘來的那個東西那樣。我管它叫「芭努的智慧」，但大家都叫它「阿葉夏混沌勘探器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760446
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760446,
					"content": "謝謝你，沙爾瑪，我很喜歡這顆大未來星！。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760447
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736760447,
					"content": "欸，就這麼唬弄過去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760448,
					"content": "這怎麼能叫唬弄呢？每個人都有他自己看待世界的方式，在本人的眼中，這正是跨越星海而來的大未來星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760449
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760449,
					"content": "多接受一種看待世界的方式，不也很有趣嗎，更何況芭努也認可了這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760450,
						736760454
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760450,
					"content": "完全是狡辯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760451
					]
				},
				{
					"id": 736760451,
					"content": "#多接受一種看待世界的方式…嗯，那我能把{NICKNAME}背包裡的薄荷看成摩拉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760452,
					"content": "派蒙怎麼也…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760453
					]
				},
				{
					"id": 736760453,
					"content": "嘿嘿，我只是覺得這樣的話，旅行途中會開心不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760458,
					"content": "兩位放心，就算是本人也不會在摩拉的事情上胡說八道，理應付給兩位的委託報酬絕對不會抵賴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760459
					],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760459,
					"content": "#請收下這些，感謝{F#妳}{M#你}們這幾天對芭努的關照，本人將永遠把這件事記在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙爾瑪"
				},
				{
					"id": 736760454,
					"content": "好像也挺有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760455
					]
				},
				{
					"id": 736760455,
					"content": "#不要被繞進去啊，{NICKNAME}。要是{F#妳}{M#你}把摩拉看成別的東西隨便丟掉了，我們就慘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760456
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760456,
					"content": "那不行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760457
					]
				},
				{
					"id": 736760457,
					"content": "這個叫沙爾瑪的傢伙太會狡辯了，得趁我的腦子還清醒的時候趕快提委託報酬的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736760441,
					"content": "芭努妳聽我說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760406,
					"content": "這是怎麼回事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760460
					]
				}
			]
		}
	]
}