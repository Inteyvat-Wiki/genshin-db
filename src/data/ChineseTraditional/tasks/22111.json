				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110201,
					"content": "有一封信給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110202,
					"content": "向著星辰與深淵！歡迎來到冒險家協會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110203,
					"content": "這封信應該是給妳的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "信？讓我看看，唔…您是從蒙德來的冒險家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110205,
					"content": "咦？這是…蒲公英？信裡為什麼會夾這種東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110206,
					"content": "冒險家，請問是您把蒲公英夾在裡面，想以此來證明您從蒙德來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110207,
					"content": "您多慮了，這封信裡的資訊已經足夠證明您的身分和來歷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110208,
					"content": "不是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "不過，這並不是什麼重要的事，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110214,
					"content": "從蒙德冒險家協會的信上看，您已經是個經驗豐富的冒險家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110215,
					"content": "那麼想必您也準備好，面對璃月冒險家協會的各類委託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110216,
					"content": "向著星辰與深淵，嶄新的偉大冒險正在等著您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110210,
					"content": "難道是凱瑟琳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "凱瑟琳？喔，您說的是「蒙德城的凱瑟琳」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110212,
					"content": "她為什麼要在裡面夾蒲公英呢？真奇怪…蒲公英對冒險可沒什麼幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110213,
					"content": "不過，這並不是什麼重要的事，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		}
	]
}