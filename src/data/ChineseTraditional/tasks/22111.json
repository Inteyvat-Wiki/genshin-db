					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110101,
					"content": "關於新的委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110102,
					"content": "#{F#妳}{M#你}好，冒險家。{F#妳}{M#你}的冒險事蹟，已經在蒙德廣為人知了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110103,
					"content": "#以這樣的勢頭接著努力，{F#妳}{M#你}一定會成為一個偉大的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110104,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "#如果想要成為一個偉大的冒險家，那{F#妳}{M#你}可不能只在熟悉的地方冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110106,
					"content": "#既然{F#妳}{M#你}已經有了如此充足的冒險經驗，要不要試試去別的地方探索一番？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110110,
					"content": "請拿好這封信，把它帶給璃月港的凱瑟琳小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110111,
					"content": "璃月港的…凱瑟琳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "是的，您會很容易就找到她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110115,
					"content": "有了這封信，她也會像我一樣，為您的各種冒險活動提供最專業的服務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110116,
					"content": "如果您再回到蒙德城，我也會繼續為您提供服務，請儘管放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110117,
					"content": "對了，還請您不要隨意拆開這封信，不然說不定會遺落掉什麼東西，造成不必要的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110118,
					"content": "向著星辰與深淵，請您大步向前吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110113,
					"content": "那以後要叫妳「蒙德城的凱瑟琳」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "您大可選擇一個便於您開展冒險活動的稱呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110107,
					"content": "只是在蒙德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "#因為到目前為止，{F#妳}{M#你}也只是在蒙德周圍展開冒險呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 221110109,
					"content": "#不過，{F#妳}{M#你}很快就能向更外面的世界邁進了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 2211102,
			"completionStepIds": [
				2211102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211102",
							"2"
						],
						"stepId": 2211102,
						"stateName": "QUEST_STATE_UNFINISHED"
