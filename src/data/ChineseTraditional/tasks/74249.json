			"dialogs": [
				{
					"id": 742490201,
					"content": "嗯！這種悠閒的下午茶時光怎麼都過不膩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 742490202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742490204,
					"content": "嗯，歡樂的時光過得可真快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 742490203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
