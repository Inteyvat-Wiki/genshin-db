				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "「在讀過偉大的塔巴里賢者編製的『星表』之後，我才終於意識到，魔神的戰爭也好，古國的覆滅也罷，不過都是群星運行在大地上的投影。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432002,
					"content": "「唯一永恆的只有我們頭上的星空。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432003,
					"content": "「唔…拋去在嚴謹的學術研究中加入不知所謂的抒情元素不談，原來明論派的研究就是把前後上千年的事情都混為一談嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432004,
					"content": "「真希望你們能學會從歷史的角度看問題，而不是整天盯著星星陰陽怪氣的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732432005,
					"content": "「你懂什麼！這叫探究世界的法則，難怪說你們伐護末那都是書呆子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324321,
