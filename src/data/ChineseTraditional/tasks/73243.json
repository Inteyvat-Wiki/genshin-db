			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "「…關於『贊迪克』其人其事的調查結果…陀裟多…死亡原因…謀害可能…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431902,
					"content": "「…『贊迪克』…除名後…對於魔鱗症…但缺乏證據…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431903,
					"content": "「…記錄突然消失…不明年份…魔鱗症開始傳播…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431904,
					"content": "「…失蹤前…『法留納傳說』…執著於…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431905,
					"content": "【以下的內容被汙損得很徹底，完全看不到有意義的文字了。】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
