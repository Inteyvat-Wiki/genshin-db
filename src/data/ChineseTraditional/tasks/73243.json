				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "「最近好久沒看到那個沙漠矮子了，看來總算可以放鬆一會了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431802,
					"content": "「這幫管風紀的傢伙也不知道聞了什麼香這麼積極，害得我上個學年的考核都沒過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431803,
					"content": "「我記得那個考核不是光靠出勤都能過嗎，你自己不好好學習還要賴別人。而且雖然最近風紀官人手短缺，不過你這樣亂說還是小心被找上門吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431804,
					"content": "「什麼風紀官，說白了還不是上面的人裝裝樣子的。等一下，虛空給我發了個消息…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732431805,
					"content": "「看來大家還是謹慎一點比較好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
