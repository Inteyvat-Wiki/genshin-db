				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "教令院相關通知及內外法令公告現已全面轉由虛空內投放，此公告板現僅保留供院內師生課外交流使用，院外人士請勿隨意留言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "「為了更加寬鬆的學術環境，為了更加友好的學術交流，為了大家能夠笑著寫出論文！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430202,
					"content": "「我們支持維克拉姆成為下一任大掌書！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430203,
					"content": "「歡迎加入『維克拉姆之友聯誼會』，我們將會見證一位年輕、親民、有趣的大掌書的誕生。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "「切不可忘記教令院的三善六罪。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430302,
					"content": "「諍言、巧思、篤行。是每一位學者都應當追求的美德。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430303,
					"content": "「而里法特，數十年來，一直親身踐行著這三點。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430304,
					"content": "「歡迎加入『三善書友會』，與智慧同行，與未來的大掌書同行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "「『三善書友會』的成員們，我敬佩你們對於美德的追求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430402,
					"content": "「不過，我可聽說，里法特的論文，可有一半以上是代筆之作。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430403,
					"content": "「這也是他為什麼明明學術成果眾多，卻還這麼低調的原因。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430404,
					"content": "「留言板雖然不像論文那樣需要充分的論據，但是也不能惡意攻擊他人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430405,
					"content": "「我看上面的留言只是嫉妒罷了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430406,
					"content": "「並且，我也有聽說，維克拉姆可是藉著他的口才，贏得了不少女孩子的芳心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430407,
					"content": "「這些女孩子，可都不知道他是有婦之夫哦。怎麼樣，你要不要也嫉妒一下他的豔福？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430408,
					"content": "「禁止無端惡意攻擊教令院學者，如有再犯，風紀官將會追查謠言來源。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "「此留言板尚未納入虛空許可權系統管轄，無需虛空即可直接閱覽。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430502,
					"content": "「請大家務必提高知識安全意識，嚴禁透過此留言板進行公共傳播領域外的知識資源交流。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "「溫馨提醒，各位同學課餘時間在院外也不要忘記謹守院紀。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430602,
					"content": "「對於知識的統一管理是『智慧之國』賴以存在的基石，不要因為無心之失而失去在教令院學習的機會。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "「近期連續發生數起罐裝知識走私案件。詳細情況將在調查完成後在下一次識藏日前透過虛空投放給相關學院的師生。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732430702,
					"content": "「也請各位導師加強與學生的溝通交流，避免學生因論文壓力過大而鋌而走險。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
