			"dialogs": [
				{
					"id": 250201001,
					"content": "#就是這個，多謝{F#妳}{M#你}了，我這就…嘶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201002,
					"content": "抱歉，我…我剛才在捆骨架的時候，不小心把手指弄破了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201003,
					"content": "這種精細的工作對我來說果然還是太難了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201004,
					"content": "稍等喔，我把這些燼芯花的花莖捆在骨架上，然後蓋一層布…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201005,
					"content": "卡茲加和「漂流球」繼續搏鬥了起來…當他的手上又多出三道新傷口後，「漂流球」總算是做好了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "好了！我們現在就去找霍萊吧，牠一定又在那棵樹下面挖土了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201007,
					"content": "先包紮一下手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "喔，不用擔心這個，都是小傷口，之後我隨便拿個布條包一包就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250201009,
					"content": "我們還是先去找霍萊吧，不要讓這小子玩太瘋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡茲加"
				}
