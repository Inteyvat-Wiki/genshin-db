			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "嗚？嗚嗚，嗚…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200502,
					"content": "嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200503,
					"content": "霍萊開心地抱起「漂流球」在水塘裡開始打滾，水波翻湧之間，牠身上的汙泥也都被洗乾淨了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "哈哈哈，這小子看來很喜歡這個球喔。居然在水塘裡直接玩起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200505,
					"content": "我們過去吧。牠這樣也算是好好洗一頓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200506,
					"content": "嗚嗚？嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200507,
					"content": "小夥子，喜歡這個禮物嗎？送你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200508,
					"content": "嗚嗚，嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200509,
					"content": "幫你洗個澡還真不容易…不過…哈哈哈，我也算是知道怎麼對付你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200510,
					"content": "嗚嗚…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200511,
					"content": "你碰我的手做什麼？這些傷口…都是小傷，不用擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200512,
					"content": "嗚，嗚…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200513,
					"content": "你這小夥子，怎麼一下子消沉起來了，剛才不是還玩得很開心嗎？難道是玩累了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200514,
					"content": "#也多謝{F#妳}{M#你}了，朋友。這些東西給{F#妳}{M#你}，就當做是報酬吧。裡面沒什麼值錢的玩意，{F#妳}{M#你}放心收下就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200515,
					"content": "嗚，嗚嗚！嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
