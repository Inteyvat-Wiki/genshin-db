							7728.138
						],
						"pointId": 350400157
					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "霍萊！聽話，別動！只是稍微擦洗一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200102,
					"content": "嗚嗚，嗚嗚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200103,
					"content": "唉…小夥子，我們先去洗個澡怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200104,
					"content": "你看，那個水塘離這裡不遠，洗好之後我們可以馬上回來繼續玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200105,
					"content": "嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "霍萊"
				},
				{
					"id": 250200106,
					"content": "欸！等等！不要亂跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200107,
					"content": "剛、剛才是不是有什麼衝過去了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "#{F#妳}{M#你}是來部族做客的客人嗎？真不好意思，霍萊最近有點活力過剩了，總是跑個沒完，沒有嚇到{F#妳}{M#你}吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200110,
					"content": "你剛才在勸牠去洗澡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "勸？唉…我這是在「求」霍萊去洗澡了。這幾天下了好幾場雨，牠每次出去玩都會弄得滿身是泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200112,
					"content": "我是想要把霍萊弄乾淨，但牠一心只想著玩，每時每刻都在到處亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200113,
					"content": "而我…作為一個普通人，完全跟不上這小夥子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200114,
					"content": "用好吃的引誘一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "我用過了。但這小子就像是知道我在想什麼一樣，只要看見我在旁邊，就根本不去吃東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200116,
					"content": "我只要一挪開目光，牠就從地下鑽過去把東西吃光，再鑽進地裡跑掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200117,
					"content": "不愧是嵴鋒龍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "是啊。等這小子長大，我都不敢想牠會惹出什麼麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200119,
					"content": "只希望牠不要弄翻夏溫的店面…不然我是賠不起那些寶石的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200120,
					"content": "唉…現在也只能試試看巴茨之前出的那個主意了，但這個球…嵴鋒龍真的會喜歡嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200121,
					"content": "巴茨是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "喔，他是部族裡負責照顧嵴鋒龍的人。這傢伙很聰明哦，他也很精通音樂，龍和人都很喜歡他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200123,
					"content": "很久之前…我和巴茨說過這個問題，那傢伙馬上就給了我一張製作「漂流球」的圖紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200124,
					"content": "這是他從馬陶霍那邊弄來的東西，小龍們很喜歡，要我也試著做一個給霍萊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200125,
					"content": "我剛收集好材料準備開始做，霍萊就又鬧個不停，根本安靜不下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200126,
					"content": "沒辦法了，現在只能指望「漂流球」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200127,
					"content": "我能幫什麼忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "#{F#妳}{M#你}願意幫忙？那太好了，我運氣真是夠好，可以碰到{F#妳}{M#你}這麼熱心的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200130,
					"content": "#那就請{F#妳}{M#你}去那邊的箱子裡，幫我拿一些燼芯花莖過來吧。我會在這裡先把那個「漂流球」的骨架做出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡茲加"
				},
				{
					"id": 250200128,
					"content": "需要幫忙儘管說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "嗚哇！差點被撞倒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
