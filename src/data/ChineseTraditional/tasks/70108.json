			"trigger": {
				"objectNames": [
					"賽琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "#{F#妳}{M#你}好，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080402,
					"content": "這封信是給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "信？哦…是她的啊，我知道了，肯定又是來問我有關探險隊的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080404,
					"content": "唉，這事我也沒辦法，現在沒幾支探險隊會去雪山裡探險，那地方實在是太危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080405,
					"content": "#我等一下會自己寫封信給她，把情況和她說明一下，謝謝{F#妳}{M#你}專門送信過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080406,
					"content": "#哦對了，這是她之前寫信過來讓我給{F#妳}{M#你}準備的報酬，{F#妳}{M#你}就收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080407,
					"content": "#還有…我多說一句，雖然{F#妳}{M#你}看起來身手不錯，但在雪山裡活動，還是要格外小心才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 701080410,
					"content": "唉，雪山…要是有機會的話，我一定要親自領隊進山看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
