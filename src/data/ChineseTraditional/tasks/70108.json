			"trigger": {
				"objectNames": [
					"艾斯特爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "#{F#妳}{M#你}把信標放好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701080302,
					"content": "已經放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "#太好了，謝謝{F#妳}{M#你}，這樣我一定能勘測到雪山的高度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701080304,
					"content": "#啊，對了，{F#妳}{M#你}的報酬我已經拜託賽琉斯先生準備好了，{F#妳}{M#你}去城裡找他拿一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701080305,
					"content": "然後，順便幫我把這封信帶給他，他答應我幫忙留意第二支要進山的探險隊，結果到現在也沒有消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701080306,
					"content": "那些信標修好了之後，我還得再進山把它們安置一遍。這座雪山上還有很多東西要勘測呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾斯特爾"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
