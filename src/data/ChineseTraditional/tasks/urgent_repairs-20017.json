				"objectNames": [
					"法拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "#別，別打我！別…咦？旅行者，那些傢伙呢？已經被{F#妳}{M#你}趕跑了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170102,
					"content": "#太好了！太謝謝{F#妳}{M#你}了…他們真的都走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170103,
					"content": "#呼…多虧了{F#妳}{M#你}，不過這麼一耽擱，我肯定趕不上這趟商隊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170104,
					"content": "而且，車也被這群傢伙給打壞了，得趕緊修好運回城裡去，不然水果非爛在車裡不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170105,
					"content": "#{F#妳}{M#你}絕對不想知道，這麼多水果在車裡爛掉之後，車上那股子洗不掉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170106,
					"content": "我要在這把這些水果都檢查一遍，我已經能聞到有不少水果壞掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170107,
					"content": "#拜託{F#妳}{M#你}去周圍幫我找找修車的材料吧，我覺得…一塊<color=#00E1FFFF>結實的木板</color>就夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法拉"
				}
			]
		},
		{
