					"nextDialogs": [
						200170404
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170404,
					"content": "可惡，肯定是被那群怪物丟到不知道哪去了。旅行者，幫我去周圍找找<color=#00E1FFFF>繩索</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法拉"
