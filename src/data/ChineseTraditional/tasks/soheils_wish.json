			"dialogs": [
				{
					"id": 731100601,
					"content": "探索了「透明遺蹟」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100602
					]
				},
				{
					"id": 731100602,
					"content": "啊，原來兩位去了「透明遺蹟」，有什麼收穫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100603
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100603,
					"content": "當然有！並且，一定會讓你大吃一驚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100604,
					"content": "向索赫爾講述了探查透明遺蹟的經歷，並把三塊石板交給了他。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100605
					]
				},
				{
					"id": 731100605,
					"content": "喔…！果然，那股神秘的力量後面有著赤王不可告人的秘密，且待我一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100606
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100607
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100607,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100608
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100608,
					"content": "怎麼會這樣…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100609
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100609,
					"content": "哇，你的臉色變得好難看，是發現了什麼可怕的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100610,
					"content": "啊…抱歉，倒也不是說可怕，而是…石板上的內容，看起來很複雜，不過基本上都是…請假紀錄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100611
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100611,
					"content": "並且，就連請假理由和現在的年輕學者們都沒什麼區別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100612
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100612,
					"content": "呼，還好當年沒有找到進入透明遺蹟的方法，否則可能會被氣瘋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100613
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100613,
					"content": "#不過，還是謝謝{F#妳}{M#你}們帶回了這幾塊石板，我再去打聽一下蒙德人的請假理由，應該也能夠寫上一篇論文——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100614
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100614,
					"content": "《忙裡偷閒——淺論不同社會形態中休假觀念的流變》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索赫爾"
				}
			]
		},
