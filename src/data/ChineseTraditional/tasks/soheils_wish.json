	"talks": [
		{
			"id": 7311001,
			"completionStepIds": [
				7311001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7311001",
							"2"
						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"索赫爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "呼…這裡比剛剛的地方涼快多了，拜託兩位，把石板暫時借我一觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100102,
					"content": "索赫爾拿著石板看了又看，時而眉頭緊鎖，時而嘖嘖稱奇。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "喂…你看得也太久了吧！難道說是想把上面的內容記下來，不給我們報酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100104,
					"content": "抱歉抱歉，只是實在是看入迷了，畢竟我是第一次見到這樣的一次文獻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100105,
					"content": "有什麼發現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "唔…有一些吧，看起來像是什麼工程紀錄…裡面提到了「阿如」，不知道和阿如村是什麼關係。可惜沒有更多記載了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100107,
					"content": "#不過，也是值得寫上幾筆的發現了，謝謝{F#妳}{M#你}們，這是說好的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100108,
					"content": "不客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100112,
					"content": "那麼下一步，就是找到更多的一次文獻，可是不進沙漠的話又很難弄到手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100113,
					"content": "啊…我想到了！兩位接下來要是有空的話，能不能聽我一個不情之請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100114,
					"content": "索赫爾先生，莫非你是想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100115,
					"content": "賢者大人吩咐過，任何學者都不得進入沙漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100116,
					"content": "哎，別誤會，我可不敢不聽從賢者大人的命令。不過賢者大人應該沒有吩咐過，不允許隨便贈送禮物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100117,
					"content": "贈送禮物？你要送我們什麼好東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100118,
					"content": "是非常珍貴的事物——我的考古筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100119,
					"content": "實不相瞞，我在十幾年前，也曾經試圖進入沙漠，不過沒有什麼特別的發現。只記錄下了幾處很可疑的遺蹟的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100120,
					"content": "#我想，在時隔多年我又回到這裡的時候，和{F#妳}{M#你}們因為遺蹟相識，這一定是某種宿命。所以我想把這本筆記送給{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100121,
					"content": "你是打算…？我明白了，確實沒有違反賢者大人的吩咐，可是，這樣的舉動終究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100122,
					"content": "#舉動？什麼舉動？贈送禮物單純只是為了紀念我結識了大英雄{NICKNAME}和小英雄派蒙，難道不是非常合理嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100123,
					"content": "合理…吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100124,
					"content": "非常合理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "呼，學者的世界真複雜！明明就是想讓我們幫忙調查，卻非要說是什麼送禮物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100131,
					"content": "要我說啊，他就是害怕在邊上的那個大個子回去找賢者告狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100132,
					"content": "是派蒙的世界太簡單了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100133,
					"content": "是嗎？我覺得還挺複雜的，畢竟，要記住各種不同食物的味道…還要記住各種寶藏的獲得方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100141,
					"content": "比起這些，我們快來看看索赫爾給的禮物裡，到底記錄著什麼內容吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100142,
					"content": "唔…真是坎坷，在赤王陵附近探索了一個月沒什麼收穫。但還是不死心，發現了一些「透明遺蹟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100143,
					"content": "然後發現了一個比赤王陵小得多的「飽飲之陵」。最後還在一個叫做「吞羊岩」的地方，被傭兵們襲擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100144,
					"content": "哇，看他的紀錄，好像吃了不少苦頭，卻還說「比起被嘲笑，更痛苦的是知識沒有增長。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100145,
					"content": "和現在判若兩人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "嗯，感覺那時候的索赫爾，真的很認真地在追求知識樣子，我都被感動了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100147,
					"content": "這麼看來，他把這本筆記叫做貴重的禮物，好像也不是很誇張了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100148,
					"content": "那麼，我們分別去他提到的那些地方看看吧！要是發現了什麼，就帶回來，當做給他的回禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100134,
					"content": "派蒙居然聽懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100135,
					"content": "那當然！他都快把「幫幫我」這幾個字寫在臉上了！這種時候幫他，一定會獲得很多報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100136,
					"content": "他也有他的難處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100137,
					"content": "話是這麼說沒錯啦，但是總覺得這幫學者，把追求知識這四個字當做面具在用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100138,
					"content": "好像只要說出了這四個字以後，就變成了正義的化身，不管說什麼做什麼都有了什麼不得了的內情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100139,
					"content": "派蒙千萬不要變成這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100140
					]
				},
				{
					"id": 731100140,
					"content": "不會的！我一直對知識沒什麼興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100125,
					"content": "不太合理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100126
					]
				},
				{
					"id": 731100126,
					"content": "啊…是覺得這份薄禮太過樸素了嗎？嗯…這只是見面禮！接下來，我會準備更體面的禮物的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100127
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100127,
					"content": "唔，我覺得還…蠻合理的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100128,
					"content": "既然小英雄已經答應了，大英雄是不是也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100129
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100129,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100109,
					"content": "應該謝謝提爾扎德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100110
					]
				},
				{
					"id": 731100110,
					"content": "沒錯，如果不是為了證明提爾扎德沒有撒謊，我們也不會找到這塊石板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100111,
					"content": "#{F#妳}{M#你}說得對。謝謝提爾扎德，謝謝他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100112
					],
					"speakerTitle": "索赫爾"
				}
			]
		},
		{
			"id": 7311002,
			"completionStepIds": [
				7311001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7311001",
							"2"
						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302515",
							"3"
						],
						"stepId": 7302515,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"索赫爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "呼…這裡比剛剛的地方涼快多了，拜託兩位，把石板暫時借我一觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100102,
					"content": "索赫爾拿著石板看了又看，時而眉頭緊鎖，時而嘖嘖稱奇。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "喂…你看得也太久了吧！難道說是想把上面的內容記下來，不給我們報酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100104,
					"content": "抱歉抱歉，只是實在是看入迷了，畢竟我是第一次見到這樣的一次文獻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100105,
					"content": "有什麼發現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "唔…有一些吧，看起來像是什麼工程紀錄…裡面提到了「阿如」，不知道和阿如村是什麼關係。可惜沒有更多記載了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100107,
					"content": "#不過，也是值得寫上幾筆的發現了，謝謝{F#妳}{M#你}們，這是說好的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100108,
					"content": "不客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100109,
					"content": "應該謝謝提爾扎德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100110
					]
				},
				{
					"id": 731100110,
					"content": "沒錯，如果不是為了證明提爾扎德沒有撒謊，我們也不會找到這塊石板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100111,
					"content": "#{F#妳}{M#你}說得對。謝謝提爾扎德，謝謝他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100112
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100112,
					"content": "那麼下一步，就是找到更多的一次文獻，可是不進沙漠的話又很難弄到手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100113,
					"content": "啊…我想到了！兩位接下來要是有空的話，能不能聽我一個不情之請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100114,
					"content": "索赫爾先生，莫非你是想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100115,
					"content": "賢者大人吩咐過，任何學者都不得進入沙漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100116,
					"content": "哎，別誤會，我可不敢不聽從賢者大人的命令。不過賢者大人應該沒有吩咐過，不允許隨便贈送禮物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100117,
					"content": "贈送禮物？你要送我們什麼好東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100118,
					"content": "是非常珍貴的事物——我的考古筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100119,
					"content": "實不相瞞，我在十幾年前，也曾經試圖進入沙漠，不過沒有什麼特別的發現。只記錄下了幾處很可疑的遺蹟的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100120,
					"content": "#我想，在時隔多年我又回到這裡的時候，和{F#妳}{M#你}們因為遺蹟相識，這一定是某種宿命。所以我想把這本筆記送給{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100121,
					"content": "你是打算…？我明白了，確實沒有違反賢者大人的吩咐，可是，這樣的舉動終究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100122,
					"content": "#舉動？什麼舉動？贈送禮物單純只是為了紀念我結識了大英雄{NICKNAME}和小英雄派蒙，難道不是非常合理嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100123,
					"content": "合理…吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "哈爾瓦尼"
				},
				{
					"id": 731100124,
					"content": "非常合理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100125,
					"content": "不太合理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100126
					]
				},
				{
					"id": 731100126,
					"content": "啊…是覺得這份薄禮太過樸素了嗎？嗯…這只是見面禮！接下來，我會準備更體面的禮物的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100127
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100127,
					"content": "唔，我覺得還…蠻合理的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100128,
					"content": "既然小英雄已經答應了，大英雄是不是也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100129
					],
					"speakerTitle": "索赫爾"
				},
				{
					"id": 731100129,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "呼，學者的世界真複雜！明明就是想讓我們幫忙調查，卻非要說是什麼送禮物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100131,
					"content": "要我說啊，他就是害怕在邊上的那個大個子回去找賢者告狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100132,
					"content": "是派蒙的世界太簡單了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100134,
					"content": "派蒙居然聽懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100136,
					"content": "他也有他的難處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100133,
					"content": "是嗎？我覺得還挺複雜的，畢竟，要記住各種不同食物的味道…還要記住各種寶藏的獲得方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100234,
					"content": "還要記住許多蘭那羅的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100135,
					"content": "那當然！他都快把「幫幫我」這幾個字寫在臉上了！這種時候幫他，一定會獲得很多報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100137,
					"content": "話是這麼說沒錯啦，但是總覺得這幫學者，把追求知識這四個字當做面具在用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100138,
					"content": "好像只要說出了這四個字以後，就變成了正義的化身，不管說什麼做什麼都有了什麼不得了的內情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100139,
					"content": "派蒙千萬不要變成這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100140
					]
				},
				{
					"id": 731100140,
					"content": "不會的！我一直對知識沒什麼興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100141,
					"content": "比起這些，我們快來看看索赫爾給的禮物裡，到底記錄著什麼內容吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100142,
					"content": "唔…真是坎坷，在赤王陵附近探索了一個月沒什麼收穫。但還是不死心，發現了一些「透明遺蹟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100143,
					"content": "然後發現了一個比赤王陵小得多的「飽飲之陵」。最後還在一個叫做「吞羊岩」的地方，被傭兵們襲擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100144,
					"content": "哇，看他的紀錄，好像吃了不少苦頭，卻還說「比起被嘲笑，更痛苦的是知識沒有增長。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100145,
					"content": "和現在判若兩人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "嗯，感覺那時候的索赫爾，真的很認真地在追求知識樣子，我都被感動了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100147,
					"content": "這麼看來，他把這本筆記叫做貴重的禮物，好像也不是很誇張了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731100148,
					"content": "那麼，我們分別去他提到的那些地方看看吧！要是發現了什麼，就帶回來，當做給他的回禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
