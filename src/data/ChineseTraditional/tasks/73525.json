	],
	"talks": [
		{
			"id": 7352501,
			"completionStepIds": [
				7352501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352501",
							"2"
						],
						"stepId": 7352501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沛休"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735250101,
					"content": "哎呀，這下又得給嵐姐添麻煩了…不過這也沒有辦法嘛，事情那麼多，幹事的就我一個人，怎麼做得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250102
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250102,
					"content": "只能再拖延一下交付測繪結果的期限了。這樣下去，在須彌花掉的生活費都已經快趕上預付的訂金了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250103
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250103,
					"content": "不過、不過最可怕的還是嵐姐的怒火…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250104
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250104,
					"content": "咦，這裡怎麼會有一個璃月冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250105,
					"content": "喂，冒險家協會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250106,
					"content": "嗯？怎麼了，這裡的河邊不能進行休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250107
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250107,
					"content": "不是不是，我們只是有點好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250108,
					"content": "璃月的冒險家在須彌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250109
					]
				},
				{
					"id": 735250109,
					"content": "確實很少見嘛，而且還在這裡一臉苦惱的樣子，所以就來問問，有什麼我們能幫上忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250110,
					"content": "原來是這樣，我的名字叫沛休，二位呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250111
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250111,
					"content": "#我叫派蒙，這是{NICKNAME}！所以，沛休，你是為什麼跑到了須彌…啊，難道是因為迷路了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250112,
					"content": "哈哈哈哈哈，小傢伙，是叫派蒙，哈哈哈哈，迷路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250113
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250113,
					"content": "有這麼好笑嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250114,
						735250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250114,
					"content": "勉強好笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				},
				{
					"id": 735250116,
					"content": "…普通情況下倒是沒有那麼好笑，不過問一名地圖測繪師是不是迷路了，這件事就有點滑稽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250117
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250117,
					"content": "地、地圖測繪師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250118,
					"content": "對，就是負責勘定一下以前的地圖，然後看看有沒有什麼變化…這也是冒險家協會的職責之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250119
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250119,
					"content": "很不巧，我就是這樣一名地圖測繪師，只不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250120
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250120,
					"content": "只不過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250121,
					"content": "我只是個學徒，雖然進行了簡單的地圖測繪，但是錯誤很多，要去一些被樹木遮掩的幽谷或地道裡一一進行勘定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250122
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250122,
					"content": "哎，真是快難死我了，須彌這裡地勢複雜，道路和山洞很多，有時甚至讓人懷疑是不是整個山都是空的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250123
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250123,
					"content": "進展緩慢…唉，我又不像本地人那樣熟悉這裡的地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250124
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250124,
					"content": "咦，那為什麼不讓須彌本地的冒險家來測繪地圖呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250125,
					"content": "呃…其實這是須彌和璃月兩個冒險家協會分會的合作專案，測繪出的地圖也會供來往兩地進行貿易和冒險的人使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250126
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250126,
					"content": "交給璃月這邊的人負責…是因為本來應該負責這個專案的前輩有豐富的測繪經驗，大家都覺得她十分可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250127
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250127,
					"content": "哎呀，那位前輩據說以前在翹英莊就做類似的工作，不管多複雜的地形，只要看一眼就知道得差不多，繪圖也十分精準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250128
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250128,
					"content": "但她後來去了礦區。咦，我忘了是去層岩巨淵還是黑岩廠來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250129
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250129,
					"content": "總之，當時看她畫出的地圖，大家都自愧弗如，使用她所繪地圖的冒險家也都讚不絕口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250130
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250130,
					"content": "我就不行啦…雖然做了測繪，但是缺漏還是很多，重新勘定就要耗上太多的時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250131
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250131,
					"content": "唉，人生地不熟的，雖然也有須彌冒險家協會的協助，但是效率還是太低了，這樣下去，預付的訂金也要當做旅費用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250132
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250132,
					"content": "唔，聽起來好可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250133,
					"content": "不過，我們也不懂什麼地圖繪製…要是在地圖上標什麼地方有好吃的，我倒是可以幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250134,
					"content": "哈哈，這倒是個好主意，下次畫一張美食地圖之類的東西，一定會很受歡迎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250135
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250135,
					"content": "不過…其實現在的工作與繪製倒沒有太大的關係，現在差的其實是勘定的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250136
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250136,
					"content": "也就是尚有幾處險境，因為周圍地形危險，所以無法入內勘測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250137
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250137,
					"content": "咦，如果只是這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250138,
					"content": "聽起來倒也不是很難？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250139
					]
				},
				{
					"id": 735250139,
					"content": "對，說不定我們也可以幫忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250140,
					"content": "…但是這些險境，其實大多十分危險，甚至說不定還會有魔物在裡面徘徊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250141
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250141,
					"content": "那就更得交給我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250142,
					"content": "真、真的嗎…感覺如果有兩位的幫忙，勘定工作一定會很快完成，這樣的話，也能在期限內交出測繪圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250143
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250143,
					"content": "更重要的是，讓來往的旅人能用上更新後的地圖，不至於再跟著老地圖跑到人跡罕至的荒地險境裡去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250144
					],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250144,
					"content": "嗯，不過，嘿嘿，我們的幫忙也是有條件的…等你以後做好了美食地圖，得寄一份給我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735250145,
					"content": "#哈哈哈，那是一定的…不過，那也得等勘定這份地圖之後了！這就交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沛休"
				},
				{
					"id": 735250115,
					"content": "滿分五分的話給三分吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				}
			]
		}
	]
}