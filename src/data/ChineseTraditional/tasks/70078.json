					}
				]
			},
			"dialogs": [
				{
					"id": 700780701,
					"content": "嗚…別過來…別過來…別再閃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780702
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780702,
					"content": "啊呀，溫斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780703
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780703,
					"content": "誰——誰啊！我把門都關起來了，你們怎麼進來的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780704
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780704,
					"content": "幽、幽靈——別、我錯了，你們別靠近我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780705
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780705,
					"content": "哇，看起來好嚴重，都有點神志不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780706,
					"content": "白色幽靈，白色幽靈出現了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780707
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780707,
					"content": "如此大叫著，名為溫斯洛的男人險些就這樣背過氣去…\\n在奧多夫的安撫下才稍稍冷靜下來，恢復了一些理智。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780708
					]
				},
				{
					"id": 700780708,
					"content": "好一點了嗎，溫斯洛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780709
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780709,
					"content": "好？好什麼好…奧多夫，你！你來幹什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780710
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780710,
					"content": "你就是來看我的笑話的，對不對…你還帶了這個白色的傢伙來，就是為了嚇我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780711
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780711,
					"content": "你們這些當地人，你們一直在排斥我、嫉妒我住在這裡，你們這些、你們這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780712
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780712,
					"content": "冷靜點，溫斯洛，我們是來幫你的。我們一直都在幫你，溫斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780713
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780713,
					"content": "在你叫著要把底下那些「陰濕、恐怖、麻煩的玩意」遷到港外的野地裡的時候，我們來幫你，勸你不要這樣做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780714
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780714,
					"content": "那時我跟你說：「會有報應的，溫斯洛。」…你看，現在你變成了這樣，我心裡也很難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780715
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780715,
					"content": "你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780716
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780716,
					"content": "#然後，這兩天我剛從至冬回來，就聽說你被這裡的幽靈啊什麼的折磨，立刻找來了能夠解決麻煩的{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780717
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780717,
					"content": "我們一直在幫你，溫斯洛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780718
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780718,
					"content": "誰知道…誰知道你們是不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780719
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780719,
					"content": "#唉…你如果不相信我，也該相信相信{NICKNAME}，{M#他}{F#她}可是騎士團的榮譽騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780720
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780720,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780721
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780721,
					"content": "好了，溫斯洛，繼續待在這裡對你的精神狀況不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780722
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780722,
					"content": "#{NICKNAME}、派蒙，看看這個可憐人吧…我先帶他上去透透氣，遺蹟的事就交給{F#妳}{M#你}們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780723
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780723,
					"content": "要是我們沒能成功…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780724
					]
				},
				{
					"id": 700780724,
					"content": "也將化作它們中的一員…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780725
					]
				},
				{
					"id": 700780725,
					"content": "噫、噫啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780726
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700780726,
					"content": "真是的，又在說一些奇怪的話！別在這裡嚇人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780727,
					"content": "#哈哈，我想下面的東西應該不會那麼危險。好了，祝{F#妳}{M#你}們順利解決問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780728
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700780728,
					"content": "嗯嗯，我們一定會的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780729,
					"content": "奧多夫扶著腳步蹣跚、神色難看的溫斯洛離開了塔下的遺蹟…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
