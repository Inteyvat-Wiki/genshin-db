					"nextDialogs": [
						700781604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700781604,
					"content": "…寂寞才是最可怕的魔鬼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700781605
					]
				},
				{
					"id": 700781605,
					"content": "哦，是嗎？完全聽不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700781606,
					"content": "不過剛才還猛吹的風到底是哪裡…咦，不對，是在上面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700781607,
					"content": "有什麼從上面掉下來了，噫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
