					},
					{
						"sceneId": 3,
						"position": [
							3563.435,
							207.301,
							-232.469
						],
						"pointId": 16314
					}
				]
			},
			"dialogs": [
				{
					"id": 700782001,
					"content": "奧多夫，我們回來了！怎麼樣，警戒機關還有問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782002,
					"content": "沒有了，警戒機關已經停止閃爍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782003
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782003,
					"content": "啊呀，好快，兩位居然這麼迅速地解決了麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782004
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782004,
					"content": "對啊，原來那些風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782005,
					"content": "那些風想必就是不願意離開的騎士英魂發出的怒吼…警戒機關的閃爍只是一種警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782006
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782006,
					"content": "欸，等等，其實幽靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782007,
					"content": "其實幽靈們並不是真正想傷害你，溫斯洛，他們只是對你想要讓他們離開的想法感到不滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782008
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782008,
					"content": "真、真的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782009
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782009,
					"content": "他們是對抗深淵犧牲在這裡的英雄，怎麼會真的做傷害你的事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782010
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782010,
					"content": "#咳咳…多謝這兩位，{NICKNAME}和派蒙，{M#他們}{F#她們}是西風騎士團的榮譽騎士，也是頂級的…頂級的幽靈談判專家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782011
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782011,
					"content": "雖然…呃，不過，這個頭銜還滿帥氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782012,
					"content": "剛剛那聲彷彿腳下石板裂開的巨響…兩位應該沒在那陣巨響裡受傷吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782013
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782013,
					"content": "毫髮無傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782014
					]
				},
				{
					"id": 700782014,
					"content": "#那就好，我剛剛還有些擔心說——咳咳，剛才的那陣巨響其實就是…就是{NICKNAME}和派蒙與騎士團的幽靈們進行的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782015
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782015,
					"content": "…嗯…超級通靈…比腕力談判！這裡的人都知道，啊呀，那是一種平息幽靈憤怒非常危險的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782016
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782016,
					"content": "超級通靈比腕力談判？真、真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782017,
						700782019
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782017,
					"content": "只是普通的塌陷罷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782018
					]
				},
				{
					"id": 700782018,
					"content": "#多麼強大——與幽靈比腕力時因為發出了巨力使遺蹟塌陷，對於談判大師{NICKNAME}來說只是普通的日常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782021,
					"content": "總之，經過談判，這些幽靈的憤怒也應該平息了下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782022
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782022,
					"content": "那、那他們再也不會出來作祟…不不不，我的意思是，出來影響警戒機關了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782023
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782023,
					"content": "那就不一定了啊溫斯洛，要看你表現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782024
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782024,
					"content": "我…我這兩天表現很好哦，我好好清理了英雄們墓邊的野草，還仔細擦拭了墓碑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782025
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782025,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782026
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782026,
					"content": "#啊呀，幹得好，溫斯洛，{NICKNAME}談判順利，你做出的彌補一定也發揮了很大的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782027
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782027,
					"content": "如果你可以一直這樣，那些曾經的英魂們一定會舒舒服服躺在三尺之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782028
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782028,
					"content": "如果可以安穩地躺在那裡，誰願意沒事就出來折騰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782029
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782029,
					"content": "#別緊張了，溫斯洛，你看，事情都會解決的。如果警戒機關再出問題，我們也可以找{NICKNAME}來幫你談判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782030
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782030,
					"content": "你說得對…唉，奧多夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782031
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782031,
					"content": "#也謝謝{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782032
					],
					"speakerTitle": "溫斯洛"
				},
				{
					"id": 700782032,
					"content": "#好了，至於{NICKNAME}和派蒙，感謝{F#妳}{M#你}們為我們作出的貢獻，這是給{F#妳}{M#你}的報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782033
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782033,
					"content": "#之前說要準備的東西就是這個，我就知道{F#妳}{M#你}們能夠解決這個事件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782034
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782034,
					"content": "原來是報酬，我還以為你準備的是什麼冒險用的道具呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782035
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782035,
					"content": "我有自知之明，做點生意還可以，冒險就不是我的強項了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782036
					],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782036,
					"content": "好了，兩位朋友，下次再來酒館吧，我們就可以聊一點其他有趣的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧多夫"
				},
				{
					"id": 700782019,
					"content": "普通一掰罷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782020
					]
				},
				{
					"id": 700782020,
					"content": "#這是只有{NICKNAME}才能辦到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "奧多夫"
				}
			]
		}
	]
}