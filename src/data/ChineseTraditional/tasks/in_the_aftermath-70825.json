			"dialogs": [
				{
					"id": 708250401,
					"content": "唉，要是能再多點人就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250402,
					"content": "城裡西風騎士們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "保持城防、協助城內各種修繕事務，還有一些雜七雜八的事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250404,
					"content": "現在騎士團總部裡每個人都忙得不可開交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250405,
					"content": "這麼一比，在門口站哨反而算是個輕鬆的活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250406,
					"content": "可以去找冒險家協會幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "他們早就在幫忙了，最開始在城裡不斷搜索受災的人們，之後又負責監視野外的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250408,
					"content": "魔物向城邊聚集時，也是冒險家協會的各位冒險家們不斷外出確認魔物動向，再回來報告，我們才能制訂出具體的迎擊計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250409,
					"content": "現在他們也在全力協助城內的各種工作，沒了他們，西風騎士團只怕會獨木難支吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 708250410,
					"content": "這麼一說，我得找個機會好好謝謝賽琉斯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
