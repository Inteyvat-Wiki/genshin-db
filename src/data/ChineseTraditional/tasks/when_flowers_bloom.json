			},
			"dialogs": [
				{
					"id": 230240101,
					"content": "#兩位，{F#妳}{M#你}們終於來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230240102,
					"content": "時間正好，萬事齊全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230240103,
					"content": "為什麼這麼興奮？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "難道說，之前的薔薇要開花了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230240105,
					"content": "#沒錯，哈哈哈！這都是多虧了{F#妳}{M#你}幫忙啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230240106,
					"content": "雖然這株薔薇還沒有盛開，但根據整個植株的形態可以判斷，它的生命力極其旺盛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230240107,
					"content": "#旅行者，如果{F#妳}{M#你}有興趣的話，就來近距離觀察一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230240108,
					"content": "#哈哈哈，說不定，它會在{F#妳}{M#你}們面前盛開呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230240109,
					"content": "那我可要好好看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "真，真的嗎？在這麼短的時間裡開花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230240111,
					"content": "好期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
