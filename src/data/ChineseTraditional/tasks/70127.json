			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "「如果您讀到這條訊息的話，希望您是我所期待的那個人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270102,
					"content": "「這是第幾封信了呢？這封信漂流了多遠，又在哪裡擱淺了呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270103,
					"content": "「等有機會再見面，再為我講講岩港的山、北國的風雪，或者蒲公英與酒，如何？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270104,
					"content": "「我會等著妳的回信，像往常一樣。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
