			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "「如果您讀到這條訊息的話，希望您是我所期待的那個人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270202,
					"content": "「我們曾以為戰爭只是童話和傳說裡才會發生的事，但如今，我們每個人都在大御所大人的雷霆震怒之下戰慄。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270203,
					"content": "「我們常去的那片海灘被封閉了，但我還是想辦法投出了這封信。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270204,
					"content": "「請不要為此擔心責備。對於曾和妳一同冒險的我來說，這種小事輕而易舉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270205,
					"content": "「我等待著妳的回信，哪怕只有一句話也好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
