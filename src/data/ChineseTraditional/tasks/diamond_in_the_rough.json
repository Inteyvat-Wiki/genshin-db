			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"石頭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "客官，哎，客官！您要不要來塊石頭，試試手氣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050102,
					"content": "來一塊試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "好嘞！客官，我看您今天氣色不錯，看起來就要賺錢吶，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050116,
					"content": "客官，您這邊上眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050104,
					"content": "什麼石頭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "當然是我店裡這些上好的璞石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050106,
					"content": "只要開石後能出玉，我就付給您摩拉，當然，如果什麼也沒有，那自然也沒有摩拉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050107,
					"content": "客官，您自己來一塊石頭玩玩，就什麼都明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050108,
					"content": "這些石頭從哪來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "我們店裡這些璞石，個個那都是從「層岩巨淵」裡鑿出來的頂尖貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050110,
					"content": "嘿嘿，您別不信，我們「解翠行」做了好幾輩的玉器生意。看石頭的眼光，那是獨一無二！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050111,
					"content": "哎，不過這些風光都是原來，現在…總務司不是把「層岩巨淵」給封了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050112,
					"content": "這原料地一封，賣一塊石頭少一塊，這麼一來二去，這些石頭反而比做好的玉器更值錢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050113,
					"content": "我一想，那不如直接把店裡的璞石拿來賣算了，不僅省了道工序，開石的時候，還有股刺激感，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050114,
					"content": "客官，您來一塊石頭玩玩，自己體驗體驗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050115,
					"content": "來一塊試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
