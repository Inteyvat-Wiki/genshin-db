			"dialogs": [
				{
					"id": 223050501,
					"content": "600摩拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "好！大氣，瞧您這風姿儀態，那是要賺大錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050503,
					"content": "您這邊請，這幾塊璞石您上眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050504,
					"content": "您慢慢看，這可都是上好的璞石，絕不會虧了您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "石頭"
				},
				{
					"id": 223050505,
					"content": "挑好了您和我說，我來開石，不勞您動手。",
