				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "旅行者，請留步，社長有事拜託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340102,
					"content": "是案情有進展了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "社長沒有說，只是說，還需要做更多準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340104,
					"content": "#她還要我等{F#妳}{M#你}過來，然後拜託{F#妳}{M#你}和我一起去野外進行搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340105,
					"content": "她到底要幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "#{F#妳}{M#你}要是問我…說實話，我也不知道，但只要按照社長說的來做，通常都能把案件解決掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340112,
					"content": "唔，我們還是說正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340113,
					"content": "據社長說，自從天野和安藤把那件事向上報告後，城內的巡邏確實加強了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340114,
					"content": "但奇怪的是，城內商戶還是不斷地遭到盜竊，而且犯罪者的目的似乎十分明確，除了目標物品之外，其他的看也不看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340115,
					"content": "情況如此，社長認為，城外盜寶團偶然流竄進城作案的可能性已經很低了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340116,
					"content": "犯下這樁案子的犯人…或者犯人們，作案時有明確的目的性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340117,
					"content": "現在最大的可能性，就是有一個始終待在城內的「內應」，不斷地向城外的人傳遞消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340118,
					"content": "那同心們不是在做無用功？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "不，正因為那個傢伙意識到，同心們的目標並不是他，所以現在他還沒有停止犯罪活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340120,
					"content": "他犯的案愈多，就愈容易露出馬腳，社長弄清他真面目的機會也愈大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340121,
					"content": "所以，我們還需要繼續做樣子給那個盜賊看，讓他放鬆警覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340122,
					"content": "#旅行者，所以我才來拜託{F#妳}{M#你}，和我一起去野外再去找找那些盜寶團的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340123,
					"content": "當然，報酬會如數支付。而且…在了結這樁案子後，還有另外的禮物奉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340124,
					"content": "這些也是珊瑚要你說的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "#唔…{F#妳}{M#你}感覺到了？{F#妳}{M#你}的直覺還真是敏銳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340126,
					"content": "#這些確實是社長交代我，讓我用來說服{F#妳}{M#你}的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340127,
					"content": "但是請相信我，我說的這些話本身也絕非虛言。至少…那些報酬都實實在在地拿在我手裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340128,
					"content": "#所以，這件事就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340129,
					"content": "但我到底要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "很簡單，我們只需要…去折騰一下那些野外的盜寶團就行了，製造的動靜越大越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340131,
					"content": "#社長已經把一些盜寶團營地的所在地標記給我了，我也幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340132,
					"content": "好了，我們就去這個地方碰頭，現在就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340107,
					"content": "她自己怎麼不來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "這是社長的習慣了。她說自己…「只擅長思考，不擅長行動」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340109,
					"content": "之前，一個寫小說的人來採訪社長，說要把她的事蹟寫成一本小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340110,
					"content": "還說社長是…「安樂椅偵探」。社長對這個稱呼好像還挺喜歡的，一直想要買一把安樂椅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340111,
					"content": "但是因為社裡的經費問題，這把安樂椅一直沒有置辦下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龍二"
				}
			]
		},
