			"dialogs": [
				{
					"id": 220340203,
					"content": "這些傢伙，跑得倒是挺快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340204,
					"content": "他們應該會回去通風報信，這樣我們的目的也達到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340205,
					"content": "#辛苦{F#妳}{M#你}了，旅行者，這些報酬請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340206,
					"content": "我也會馬上回去，向社長報告這裡的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340207,
					"content": "不知道社長有沒有推理出來什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
