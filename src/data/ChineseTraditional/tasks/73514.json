				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "好險…居然連沙蟲也來攪局了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735140102,
					"content": "唉！要是剛才沒有拆除點火裝置，我們就可以直接幹掉牠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140103,
					"content": "現在放跑了牠，少說也得再等上一天，才能讓牠重新放鬆戒備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140104,
					"content": "妳不會想說，等到明天，我們還要為一點細枝末節而糾結，然後再放跑牠一次吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140105,
					"content": "唔…可是，參數問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735140106,
					"content": "我都已經測過了，雖然充能速度比設計值是低了一點，但還不影響使用，也沒有什麼安全隱患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140107,
					"content": "施芮婭…我明白，妳是希望把一切分析完畢才開始動手，可是妳也知道，實際情況又不可能總是跟著計畫走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140108,
					"content": "為求萬無一失，反而錯過了時機的話，就會就跟那次期中口試一樣悲慘延期…回頭也只會惹出更多麻煩來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140109,
					"content": "唉…好吧。拿去吧，點火模組。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735140110,
					"content": "——好欸！明天總算能讓「對沙蟲用殺蟲炮」威風一下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140111,
					"content": "我先把它們帶回阿如村再調整一下。「對沙蟲用殺蟲炮」的第一次正式上場…可得好好準備呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735140112,
					"content": "…可是環境參數，究竟為什麼會出現偏差呢？說到底，沙蟲又為什麼會突然作亂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735140113,
					"content": "#果然不能放著這些問題不管…冒險家{M#先生}{F#小姐}，煩請您明天再來一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735140114,
					"content": "到時候我們應該會直接面對沙蟲，希望能多少研究出一點端倪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				}
			]
		}
	]
}