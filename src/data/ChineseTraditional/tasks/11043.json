	"talks": [
		{
			"id": 1104301,
			"completionStepIds": [
				1104301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104301",
							"2"
						],
						"stepId": 1104301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "不會是要我們從這麼高的地方跳下去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430102,
					"content": "不一定，如果你們有更好的辦法的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430103,
					"content": "沒有的話還得了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "無論用什麼辦法，只要能夠抵達下面的湖的對岸，就算完成了實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430106,
					"content": "#根據{F#妳}{M#你}完成的時間，以及達到的最快速度，我會進行分析與比較的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430107,
					"content": "#在湖的對岸，也就是說，想讓{F#她}{M#他}在雪山游泳？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430108,
					"content": "當不限制條件的時候，人就會本能地去選擇自己認為最合理的方式完成目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430109,
					"content": "可能有人覺得冰雪中的湖水難以忍受，但可能另外的人就喜歡這種冰冷刺骨的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430110,
					"content": "無論你們做出了什麼選擇，都是實驗的一部分，對我來說，都具有十足的研究價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430111,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "#拜託{F#妳}{M#你}了，非常期待{F#妳}{M#你}交出的答卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430112,
					"content": "比起超能力這要輕鬆多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "這種模棱兩可的回答最讓人緊張。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
							"2"
						],
						"stepId": 1104303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "#辛苦{F#妳}{M#你}了，{F#妳}{M#你}的表現令我刮目相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430302,
					"content": "不愧是傳聞中的旅行者，各項數據都已經遠超蒙德的平均水準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430303,
					"content": "可是看你一直跟著我們，好像也沒有氣喘吁吁嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430304,
					"content": "我嗎？其實我用煉金術偷了一些懶，不過這些都不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430305,
					"content": "#如果提瓦特的法則沒有影響{F#妳}{M#你}，那我可以獲得幾種對異世界文明的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430306,
					"content": "#如果提瓦特的法則影響了{F#妳}{M#你}，那我也可以推測在沒有影響的狀況下，會發生怎樣的演化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430307,
					"content": "其中蘊含的無數可能性，實在太有趣了，值得反覆品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430308,
					"content": "但是…這對你的研究又有什麼幫助呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430309,
					"content": "#困擾我多時的問題已經解開，等回到營地之後，我應該能為{F#妳}{M#你}們呈現一些獨特的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430310,
					"content": "你有像這樣研究過其他東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "#那{F#妳}{M#你}可能馬上要被和很多奇奇怪怪的東西一起類比了，{F#妳}{M#你}可能會不樂意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430312,
					"content": "黃金，石化古樹，八倍大的太陽——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430313,
					"content": "探究本質的過程令人著迷。可惜，這種著迷的時光，註定只是須臾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430314,
					"content": "我寧願將我一切的精力都傾注其中，然而樣本終究是有限的，當未知逐漸變為已知，那種趣味也就會逐漸消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430315,
					"content": "最終它們都會變為日落果，甜甜花這樣平淡無奇的存在，不再值得花時間去關注了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430316,
					"content": "哦，所以你畫的那副丘丘人的畫，不同的丘丘人之間才會有那麼明顯的區分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430317,
					"content": "對，當時我也說了，「很無聊，不值得浪費時間」。因為對我來說，它們的趣味早就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430318,
					"content": "那在實驗之後，我們在你的眼裡也會變成這樣嗎？變成…呃，草稿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430319,
					"content": "#這個不必擔心，{F#妳}{M#你}們是我的協助者，這份情誼我是不會忘記的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430320,
					"content": "好了，在返回營地之前，讓我們進行最後一項，也就是智力方面的實驗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 110430321,
					"content": "跟我來，現在我們去另一側的遺蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				}
			]
		},
