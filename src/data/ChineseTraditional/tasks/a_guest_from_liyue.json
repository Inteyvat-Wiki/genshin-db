			"dialogs": [
				{
					"id": 706720101,
					"content": "咦，這不是阿圓嗎，怎麼到貓尾酒館裡來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720102,
					"content": "阿圓——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720103,
					"content": "妳好呀，阿圓！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720104
					]
				},
				{
					"id": 706720104,
					"content": "原來是二位啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720105
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720105,
					"content": "阿圓，妳怎麼會到這…不對！原來妳也可以從塵歌壺裡跑出來嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720106,
					"content": "那是當然…嗯，這麼說來，在壺天之外與兩位相見倒還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720107
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720107,
					"content": "雖說是仙人創造「壺靈」以處理洞天之中的諸多瑣碎雜事，不過壺靈活動倒也並不受限於洞天所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720108
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720108,
					"content": "就如阿嘟…哦不，「尋瑰納琦真君」，平日亦會在四方遊走，蒐集那些蒙塵的奇珍之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720109
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720109,
					"content": "哎呀，相較之下，我確實很少從壺中出來就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720110
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720110,
					"content": "原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720111,
					"content": "啊，那這次阿圓為什麼從壺中出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720112,
						706720115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720112,
					"content": "難道是來買喝的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720113
					]
				},
				{
					"id": 706720113,
					"content": "雖說也想嚐嚐此處的飲品與璃月有何不同，但今日畢竟是受人所託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720114
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720114,
					"content": "受人所託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720117,
					"content": "#嗯…而且說到底，這件事還和{NICKNAME}有些牽連呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720118
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720118,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720119
					]
				},
				{
					"id": 706720119,
					"content": "#哎呀，自從「七聖召喚」流行，想必{NICKNAME}也發現了，發函邀請朋友前來酒館對局頗有樂趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720120
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720120,
					"content": "只不過在收到邀請函後須千里迢迢趕來，實在是苦事一件，於是有人便託我來此處利用術法，做出一個類似壺天的小房間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720121
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720121,
					"content": "收到邀請函欲來此處之人，只是一瞬靈犀，便可出現在那房間之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720122
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720122,
					"content": "#這樣，{NICKNAME}可以自由使用這房間邀人對局，同時也免去了那些受邀者的一些麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720123
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720123,
					"content": "哇，那還真的滿方便的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720124,
					"content": "不過，這裡畢竟是瑪格麗特小姐的酒館，妳用仙術這樣改造，她知道了不會生氣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720125,
					"content": "嗯…這倒是無礙，畢竟房間本身不在貓尾酒館內，而且，在這之前當然也已經過酒館主人的同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720126
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720126,
					"content": "「欸呀，璃月的法術還滿好用的嘛，能把酒館面積擴大一倍嗎？」酒館主人這樣說…可惜我的術法做不到這點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720127
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720127,
					"content": "還、還滿像是瑪格麗特小姐會說的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720128,
					"content": "#兩位在此倒是正好，我本來還正想著什麼時候{F#妳}{M#你}們回到壺中洞天再說明此事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720129
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720129,
					"content": "那現在就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720130
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720130,
					"content": "好，這樣就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720131
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720131,
					"content": "#那麼，現在就請{NICKNAME}盡情使用這個房間，邀請各處的朋友前來對局吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720132
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720132,
					"content": "#啊…差點忘記了，是酒館裡的小傢伙拜託我要向{F#妳}{M#你}說的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720133
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720133,
					"content": "#{NICKNAME}，希望{F#妳}{M#你}能感受到「七聖召喚」的樂趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720115,
					"content": "不會是來打牌的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720116
					]
				},
				{
					"id": 706720116,
					"content": "雖不中卻也不遠了。我並不是為了牌戲而來，但受託之事確實和牌有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720134
					],
					"speakerTitle": "阿圓"
				},
				{
					"id": 706720134,
					"content": "阿圓驅使仙術，對酒館進行了一番改建，並更換了對局邀請板。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
