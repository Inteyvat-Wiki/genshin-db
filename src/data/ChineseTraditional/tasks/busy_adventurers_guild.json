			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050501",
							"2"
						],
						"stepId": 2050501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "#不好意思，又把{F#妳}{M#你}叫過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050102,
					"content": "沒關係，平時受了很多照顧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "#{F#妳}{M#你}能這麼說真是太好了，那我盡量長話短說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050106,
					"content": "#很感謝{F#妳}{M#你}之前能幫忙完成協會的委託，冒險家協會的風評也變得越來越好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050107,
					"content": "不過因為這個，願意來委託協會的人越來越多，現在冒險家們已經有點忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050108,
					"content": "是要我們去當宣傳員嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050109,
					"content": "啊，不是的，有這份心我很感激。我也希望能有更多新人加入協會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050110,
					"content": "但現在再去找新人，有點遠水救不了近火的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050111,
					"content": "#我想問問看，不知道{F#妳}{M#你}的朋友有時間幫這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050112,
					"content": "需要和他們商量一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "#太好了，謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050117,
					"content": "總之我先說明一下吧，現在比較緊急的是這種<color=#00E1FFFF>「探索派遣」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050118,
					"content": "「探索派遣」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "我們會隨時關注城市周邊和野外，比如存在潛在的危險，或者地下遺蹟又有異常之類的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050120,
					"content": "因為不是來自他人的委託，所以沒有時間限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050121,
					"content": "但如果因為繁忙就長期擱置，可能隱患就會變成巨大的災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050122,
					"content": "聽起來確實很重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050123,
					"content": "朋友們應該可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "只要他們答應幫忙，剩下的手續交給我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050127,
					"content": "#那事不宜遲，為{F#妳}{M#你}介紹一下目前的「探索派遣」有哪些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050128,
					"content": "確認「探索派遣」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "報酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "放心，探索中的收穫協會分文不取，全都歸你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050114,
					"content": "原來想勸我的朋友加入協會？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "#不不不，{F#妳}{M#你}誤會了。我明白{F#妳}{M#你}的朋友有各種各樣的身分，讓他們都加入很不現實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050116,
					"content": "這更像是協會的不情之請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050104,
					"content": "又有報酬可以拿了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "#哈哈…確實是這樣，看來{F#妳}{M#你}很感興趣的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "#{F#妳}{M#你}可以隨時承接「探索派遣」，而執行委託的夥伴在此期間仍然可以和{F#妳}{M#你}一起冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050202,
					"content": "進行不同程度的探索會花費不同的時間，探索完成後，只需要來我這裡確認一下成果就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050203,
					"content": "隨著「冒險等階」的提高，還可以去更多更危險的地方探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050204,
					"content": "這就是能力越大，責任越大吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205050205,
					"content": "是的，當然這也是為了各位的安全著想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 205050206,
					"content": "#再次感謝{F#妳}{M#你}的幫助，希望{F#妳}{M#你}和{F#妳}{M#你}的夥伴能多多承接「探索派遣」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		}
	]
}