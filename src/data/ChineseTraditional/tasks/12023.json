			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "嗚哇…這個人身上好重的酒氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230202,
					"content": "#嗯？我記得{F#妳}{M#你}是…「劍魚二番隊」的隊長！沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230203,
					"content": "#{F#妳}{M#你}回海祇島了啊，我還以為{F#妳}{M#你}拋下小隊不管，一個人跑路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230204,
					"content": "我們才不會跑路呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230205,
					"content": "哼，那可難說。和平啊，安定啊…每個人都在討論著相似的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230206,
					"content": "#反抗軍最重要的是什麼，{F#妳}{M#你}還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230207,
					"content": "是「戰鬥的意志」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "#沒錯。就讓我測試一下，{F#妳}{M#你}到底還是不是一個合格的反抗軍戰士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230209,
					"content": "#不管{F#妳}{M#你}想問什麼，打贏了我再告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230210,
					"content": "唔…感覺和這個人的溝通好困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230211,
					"content": "#怎麼辦，{NICKNAME}，要上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230212,
					"content": "嗯，我們不會輸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "#哼…等{F#妳}{M#你}們贏了再說吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "高善"
				},
				{
					"id": 120230213,
					"content": "讓他把知道的消息吐出來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
