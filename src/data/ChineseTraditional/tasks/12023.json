				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "多虧了珊瑚宮大人，海祇島才有現在的和平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230502,
					"content": "最近有發生什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "最近？我想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230504,
					"content": "對我們來說，最近的大事就是終於可以出海捕魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230505,
					"content": "之前打仗的時候，海上有好多戰船，我們只能在附近撈撈小魚小蝦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230506,
					"content": "有的時候收穫不佳，大家都吃不飽。小孩子沒日沒夜地哭鬧，我卻一點辦法都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230507,
					"content": "每天晚上肚子咕嚕嚕地叫個不停，翻來覆去睡不著覺，好不容易才能熬到天亮。現在終於好一些了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230508,
					"content": "#我聽說了，{F#妳}{M#你}是劍魚二番隊的隊長吧，謝謝{F#妳}{M#你}幫我們打贏了這場仗。這條魚給{F#妳}{M#你}，剛撈上來的，別嫌棄啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230509,
					"content": "不不不，這怎麼好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230510,
					"content": "#哈哈，收著吧。沒有{F#妳}{M#你}，說不定我們現在還在餓肚子呢。珊瑚宮大人教導我們，人要知恩圖報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230511,
					"content": "#好吧，謝謝你。{NICKNAME}，我們再去問問別人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
