			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"傳次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "看來慶功宴準備得差不多了，不過在酒宴開始之前，我還得簡單地演講一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230102,
					"content": "唔…心海的能量還夠用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230103,
					"content": "#放心，完全夠用。有{F#妳}{M#你}們的幫助，我的能量回復得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230104,
					"content": "太好了。我們也會幫妳加油助威的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230105,
					"content": "大家辛苦了，今天是屬於我們的慶功會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230106,
					"content": "在過去的一段時間裡，我們與幕府軍的戰爭告一段落，也見證了眼狩令的廢除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230107,
					"content": "稻妻的未來會變成什麼樣，我也無法預料。但明天我將與天領奉行展開和談，為海祇島爭取和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230108,
					"content": "感謝各位一直以來的努力，正因為你們的努力，我們才能打贏這一場艱難的戰役。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230109,
					"content": "這場慶功會是為在場的每個人準備的，希望大家好好享受這來之不易的勝利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230110,
					"content": "喔——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "傳次郎"
				},
				{
					"id": 120230111,
					"content": "看來晚會進行得很順利，沒出什麼問題真的太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230112,
					"content": "#人在開心的時候，往往傾訴的欲望也會提高。{NICKNAME}，可以拜託{F#妳}{M#你}再幫我收集一些情報嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230113,
					"content": "關於「天領奉行勾結愚人眾」這件事，到現在還沒有進一步的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230114,
					"content": "我很擔心明天的和談，會不會出什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230115,
					"content": "好吧，那我們再去問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1202302,
