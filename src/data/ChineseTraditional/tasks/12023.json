			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "好強…不愧是珊瑚宮大人選中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230302,
					"content": "#{F#妳}{M#你}的身上還有戰鬥的意志…也許，{F#妳}{M#你}可以理解我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230303,
					"content": "#劍魚二番隊的隊長…{F#妳}{M#你}會成為我們的同伴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230304,
					"content": "先告訴我發生了什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230306,
					"content": "「天領奉行勾結愚人眾」這件事，其實是我們編造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230307,
					"content": "怎，怎麼這樣！心海一直在擔心的問題，居然是你們編的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230308,
					"content": "為什麼要這麼做？這可能會導致你們和天領奉行繼續打下去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230309,
					"content": "我們要的，就是這樣的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230310,
					"content": "和談？哼，就是因為每個人都這麼想，海祇島才沒有未來可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230311,
					"content": "誰能保證天領奉行不會半路變卦？誰能保證雷電將軍不會頒佈下一次眼狩令？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230312,
					"content": "我們反抗軍，最重要的就是戰鬥的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230313,
					"content": "天領奉行和雷電將軍都不可信，能夠相信的只有我們自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230314,
					"content": "#{F#妳}{M#你}也是這麼認為的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230315,
					"content": "他說的好像很有道理，但我總覺得哪裡怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230316,
					"content": "只是你們想打而已吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "對喔。你說了半天，都是自己的猜測不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230318,
					"content": "為了這個猜測，你們就編造了這樣的傳聞，打算毀掉很多人辛苦盼來的和平嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230319,
					"content": "#別一副事不關己的樣子對我說教！{F#妳}{M#你}們又明白什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230320,
					"content": "#為了贏下戰爭，我們將戰鬥的意志貫徹到了極致，但現在{F#妳}{M#你}們突然告訴我，這些都沒用了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230321,
					"content": "要我們放下武器，像普通人一樣地生活，怎麼可能呢？我閉上眼睛，總會想起那些在戰場上犧牲的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230322,
					"content": "每當他們的身影出現在我的腦海，我就絕對無法原諒天領奉行，無法原諒眼狩令！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230323,
					"content": "#看來{F#妳}{M#你}和我們不是同路人…{F#妳}{M#你}可以把這些話告訴珊瑚宮大人。但是，現在想阻止我們已經來不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230324,
					"content": "來不及了？那是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230326,
					"content": "唔…他似乎不打算回答了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230327,
					"content": "#怎麼辦{NICKNAME}，事情緊急，我們還是先去告訴心海吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "…總之，就是這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230402,
					"content": "天領奉行勾結愚人眾這件事，其實是他們編造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230403,
					"content": "他們的目標是破壞和談，讓戰爭繼續下去。他們還說，不管我們想做什麼，都已經來不及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230404,
					"content": "原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230405,
					"content": "心海…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "#沒事，讓{F#妳}{M#你}擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230408,
					"content": "是我的錯。如果我能更早地察覺到他們的心情，就不會發生這樣的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230409,
					"content": "高善所說的「來不及了」，我大概知道指的是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230410,
					"content": "和談雖然明天才開始，但雙方的侍衛已經提前抵達了談判地點，負責確認附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230411,
					"content": "像高善這樣的主戰派，很可能已經混進了侍衛隊伍，準備在明天的談判中突起發難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230412,
					"content": "這可怎麼辦呀。要不我們現在出發，去把他們換掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230413,
					"content": "不妥。首先我們帶著新的衛隊前往中立地帶，勢必會引起各方警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230414,
					"content": "主戰派的士兵們很可能也會提前發動計畫，進攻天領奉行的侍衛，一樣有可能引發戰爭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230415,
					"content": "更何況，我們不知道有多少海祇島的士兵參與其中，臨陣換人，難免會出現無人可信的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230416,
					"content": "聽起來好複雜…難道真的沒有什麼辦法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230417,
					"content": "不必擔心。此事既然已經發生，就由我來思考對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230418,
					"content": "那些士兵們固然有錯，但過錯不全在他們。無論如何，我會想辦法保住他們的命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230419,
					"content": "明天，我們再在這裡會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230406,
					"content": "沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
