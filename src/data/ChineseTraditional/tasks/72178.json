			"dialogs": [
				{
					"id": 721780201,
					"content": "這裡也有一座神龕，我們去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721780202,
					"content": "（看起來很普通的神龕，並沒有任何奇特的元素痕跡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
