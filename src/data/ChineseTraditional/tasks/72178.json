					],
					"speakerTitle": "神龕"
				},
				{
					"id": 721780102,
					"content": "調查",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "（這座神龕看起來狀態良好，似乎不久前才被精心照料過。打理這裡的，或許是一個細心的人。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "神龕"
				},
				{
					"id": 721780104,
					"content": "（但除此之外，並沒有誰來過的痕跡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "神龕"
				},
				{
					"id": 721780105,
					"content": "奇怪呢…好像有人來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
