				},
				{
					"id": 721780203,
					"content": "調查",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "（這座神龕看起來乾淨整潔，散發著淡淡的神櫻香氣。或許不久前有人在此處祈禱過。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "神龕"
				},
				{
					"id": 721780205,
					"content": "（但除此之外，並沒有更新近的痕跡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "神龕"
				},
				{
					"id": 721780206,
					"content": "是神櫻花瓣的氣味呢…長次的媽媽或許來過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721780207,
					"content": "而且一定是不久前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
