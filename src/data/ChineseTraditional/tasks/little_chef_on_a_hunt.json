				"points": []
			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "這裡的野豬太肥美了，還很有活力，肉質一定是極棒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000402,
					"content": "啊，說著說著肚子就餓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "哇，有這麼多，一部分用來煎，一部分配上蘑菇炒，還有些和史萊姆凝液試試看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000502,
					"content": "她瞬間就入迷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "我們很自然地被忽略了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000506,
					"content": "啊啊，不好意思不好意思，一不小心就去想食譜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000507,
					"content": "#這個是答應送{F#妳}{M#你}們的好吃的。現在就嚐嚐看吧！把感想告訴我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000508,
					"content": "我們是被當成試菜員了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000509,
					"content": "哦哦！這、這個…太好吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000510,
					"content": "可以告訴我們是怎麼做的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000511,
					"content": "嘿嘿，當然可以了！只不過我還沒有寫成食譜，我想想看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000512,
					"content": "#要不然這樣吧！我現在再做一次，{F#妳}{M#你}們就照著學！看一遍肯定就明白了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000513,
					"content": "這麼複雜的菜看一次也記不住啦…而且鍋和調味料都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000514,
					"content": "哎呀，這還不簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000515,
					"content": "鍋用岩板，油用剛剛獵到的野豬的油，搬石頭堆成灶，木頭和茅草生旺火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000516,
					"content": "糖用甜甜花，至於鹽，我之前在一個洞穴裡找到了很多崖鹽，夠用好幾天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000517,
					"content": "這、這也太駕輕就熟了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "嘿嘿，我總按捺不住嘗試新菜的心情。但又不能每次出門都帶好鍋碗瓢盆什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000520,
					"content": "稍等一下，我現在就去準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000521,
					"content": "#喂！{F#妳}{M#你}們在這裡幹什麼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 110000601,
					"content": "這裡是野豬們的棲息地，是不可以打獵的！把牠們都嚇跑了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 110000602,
					"content": "我們獵人不做殺雞取卵的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 110000603,
					"content": "啊！我懂我懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000604,
					"content": "只有最合適的環境才能誕生這麼鮮美的肉質！如果被嚇跑的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000605,
					"content": "不行不行，那絕對是美食界…不對，是全人類的一大損失！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000606,
					"content": "真是有個性的理解方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "對不起，沒想到會造成這麼大的影響！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000609,
					"content": "#唉，{F#妳}{M#你}們去和杜拉夫先生道個歉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 110000610,
					"content": "他是我們這些獵人的領頭人，他很看重狩獵的規矩，現在很生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "艾倫"
				},
				{
