			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "小聲點，我正在打獵呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000302,
					"content": "早就聽說蒙德有很多好食材，現在一看果然名不虛傳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000303,
					"content": "妳是獵人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "不不不，我是個廚師，立志走遍各地，搜尋珍奇食材的廚師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000306,
					"content": "#我叫香菱，從璃月港來，{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000307,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "妳好啊，我是派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000309,
					"content": "派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000310,
					"content": "怎麼了？為什麼突然盯著我看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000311,
					"content": "好奇妙的生物，這個可以吃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000312,
					"content": "她是我的好朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "可惜了，朋友那就是不能吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000316,
					"content": "#{F#妳}{M#你}們的關係真好，其實我也有這樣的好朋友，叫作鍋巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000317,
					"content": "名字怎麼還是吃的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000318,
					"content": "哈哈，因為很可愛啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000319,
					"content": "#對了對了，{F#妳}{M#你}們可以幫我狩獵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000320,
					"content": "這裡有好多獵物，全都是絕佳的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000321,
					"content": "我一個人實在是抓不過來，放走了又太可惜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000322,
					"content": "聽起來好麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000323,
					"content": "#別這麼說嘛，等一下送給{F#妳}{M#你}們好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000324,
					"content": "#好、好吃的？一言為定，{NICKNAME}可擅長這個了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000325,
					"content": "一點立場都沒有啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "#嘿嘿，別在意別在意，{F#妳}{M#你}的朋友都已經答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000328,
					"content": "不管用什麼方法，只要能帶回來獸肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000329,
					"content": "#那就交給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000326,
					"content": "別無視我的意見啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "當然可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "不可以！派蒙不是吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000304,
					"content": "妳是冒險家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
