			"dialogs": [
				{
					"id": 100030301,
					"content": "九老師還有什麼特徵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030302,
					"content": "根據讀者來信問答和卷尾「作者的話」來看，他應該髮際線後退、輕微啤酒肚、不喜歡吃甜的、心臟在右邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030303
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030303,
					"content": "左邊還是右邊？嗯，右邊。然後他左手有五根手指、失眠很嚴重、每隻眼睛各有一個瞳孔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030304
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030304,
					"content": "好沒特色！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
