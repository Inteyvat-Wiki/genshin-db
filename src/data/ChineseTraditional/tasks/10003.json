			"dialogs": [
				{
					"id": 100031201,
					"content": "怎麼是你們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031202
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031202,
					"content": "這個聲音，是尼可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031203,
					"content": "我們還想問呢。為了找九老師，我們從璃月找到這裡，結果最後遇到了妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031204,
					"content": "和尼可以及仙靈說了八重堂的委託和之前的調查…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100031205
					]
				},
				{
					"id": 100031205,
					"content": "原來是這樣。九老師，就是它啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031206
					],
					"speakerTitle": "尼可"
				},
				{
