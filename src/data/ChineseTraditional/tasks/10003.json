			},
			"dialogs": [
				{
					"id": 100030201,
					"content": "那個可以來蒙德公費旅遊的幸運之人是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030202,
					"content": "行——不對，枕玉老師的負責編輯小野寺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030203,
					"content": "#{NICKNAME}，之前承蒙照顧了。希望這次{F#妳}{M#你}聽完八重大人的委託之後還能再照顧我一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030204
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030204,
					"content": "旁邊這位菲謝爾皇女打扮的是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030205
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030205,
					"content": "吾乃斷罪之皇女菲謝爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030206
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030206,
					"content": "小姐的意思是：她是菲謝爾，很高興認識你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030207
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030207,
					"content": "呃，她是菲謝爾小姐，是個來協助的朋友。她可是很可靠的冒險家哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030208,
					"content": "沒錯，她是菲謝爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030209
					]
				},
				{
					"id": 100030209,
					"content": "原、原來是菲謝爾啊。就算如此，也不用說四次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030210
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030210,
					"content": "即已知曉吾之名諱，自然應該瞭解稱吾之名，即為贖罪。因故，稱讚吾名，即是救祓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030211
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030211,
					"content": "小姐的意思是：她——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030212
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030212,
					"content": "原來是這樣啊。記住名字的確是基本禮節，只要能解決問題，要我喊一萬次也沒問題。謝謝妳來幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030213
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030213,
					"content": "居、居然比奧茲的翻譯還要更早明白菲謝爾的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030214,
					"content": "不要小看編輯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030215
					]
				},
				{
					"id": 100030215,
					"content": "那麼事不宜遲，讓我來詳細說說這次的委託吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030216
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030216,
					"content": "你們應該知道《神霄折戟錄》的作者九老師吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030217
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030217,
					"content": "菲謝爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030218
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030218,
					"content": "小姐，您說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030219
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030219,
					"content": "九老師代表作明明是《菲謝爾皇女夜譚》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030220
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030220,
					"content": "咳咳，小姐的意思是：倘若造物主的常態只有冷酷，那幽夜淨土與皇女也應是足以讓它垂淚的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030221
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030221,
					"content": "那好的。《菲謝爾皇女夜譚》的作者九老師，最近從挪德卡萊發來一封求救信，看起來他狀態很不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030222
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030222,
					"content": "那這不是一個很簡單的事情嗎？委託那邊的協會或者傭兵找到他就好了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030223,
					"content": "所以最大的問題來了——我們其實也不知道九老師長什麼樣子、年紀多大、是胖是瘦、是哪國人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030224
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030224,
					"content": "他從來只寫信和八重堂聯絡，發信地址遍布全大陸。作者年會和現場活動也請不來真人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030225
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030225,
					"content": "這種委託怎麼處理啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030226,
					"content": "所以調查九老師究竟是誰，是委託的一個重要部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030227
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030227,
					"content": "我們也自己努力調查過，結果發現，九老師自從《神霄》完結之後，字跡都開始不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030228
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030228,
					"content": "最早為九老師負責的編輯也已經辭職，想要自己寫小說。他對於九老師也沒有額外資訊可以補充。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030229
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030229,
					"content": "凡存在過的事物都會被斷罪皇女記住，在幽夜淨土中永存。原初神聖言語自會湧流出一切因果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030230
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030230,
					"content": "小姐的意思是：最——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030231
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030231,
					"content": "沒錯，我們想到一樣的事了——所以我們找出來了最早的《神霄折戟錄》原稿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030232
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030232,
					"content": "嗚啊！這個行——枕玉老師看到會激動到暈過去的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030233,
					"content": "不對！比起這個，小野寺居然又先於奧茲理解了菲謝爾的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030234,
					"content": "編輯，很神奇吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030235
					]
				},
				{
					"id": 100030235,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030236
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030236,
					"content": "奧茲華爾多·亨利·赫芙那梵茵斯喲，你發現了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030251,
					"content": "沒有那個「亨利」，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030237
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030237,
					"content": "的確能感覺到一絲若有若無的感應。和小姐您身上的…磁場、引力、因果絲線，這樣的東西近似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030238
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030238,
					"content": "我們最後只確定了一件事——投稿的稿紙底紋和工藝來自璃月，大概就在輕策莊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030239
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030239,
					"content": "九老師難道是個璃月人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030240,
					"content": "不對，說到輕策莊寫小說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030241,
					"content": "常…九爺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030242
					]
				},
				{
					"id": 100030242,
					"content": "這不太可能吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030243,
					"content": "常九爺是嗎？《古華派的大師兄》也是新人獎獲獎作品，我聽說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030244
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030244,
					"content": "無妨。「垂淚的聖徒」與「贖罪的聖徒」縱使所行之道義不同，力量卻是同源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030245
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030245,
					"content": "小野寺先生，您請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030246
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030246,
					"content": "奧茲我知道你信任小野寺，但是考慮一下我們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030247,
					"content": "說的也沒錯。既然同為作家，就算不是同一人，說不定總會有些交流吧？把他當切入點或許不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030248
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030248,
					"content": "編輯，很強大吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030249
					]
				},
				{
					"id": 100030249,
					"content": "呃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030250,
					"content": "那就麻煩你們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "小野寺"
				}
			]
		},
