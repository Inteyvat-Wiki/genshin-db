			"dialogs": [
				{
					"id": 100030501,
					"content": "看起來也是平平無奇的東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030502,
					"content": "並非如此，本皇女已然看破塵埃之中的宇宙奧秘。它所展現的，正是湧向真實的智慧泉流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030503
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 100030503,
					"content": "小姐的意思是：她覺得這個是線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧茲"
				}
