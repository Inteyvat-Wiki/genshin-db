			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100030701,
					"content": "幻想我自己是九老師是嗎？倒也不失為一種打開創作方向的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030702
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 100030702,
					"content": "開始幻想了，幻想我是九老師。如果是九老師會怎麼寫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
