			"dialogs": [
				{
					"id": 100030401,
					"content": "常九爺似乎不在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030402,
					"content": "看來一下子是找不到人問話了，是要在這裡等一等他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030403
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030403,
					"content": "好像只能這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030404,
					"content": "不過他不在的話，是不是代表…他的確有可能是被綁架到挪德卡萊的九老師呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030405
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030405,
					"content": "要不要搜查一下他的住處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030406
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 100030406,
					"content": "總覺得私自搜別人的家有點不好。不過哦，萬一常九爺真的是九老師的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
