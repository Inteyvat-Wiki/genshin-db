			},
			"dialogs": [
				{
					"id": 745070101,
					"content": "咦？難道是我眼花了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070102,
					"content": "剛才…前面飄過去的好像是…一隻蕈獸？難道有蕈獸入侵楓丹了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070103,
					"content": "#{NICKNAME}，我們快跟過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7450702,
			"completionStepIds": [
				7450702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7450702",
							"2"
						],
						"stepId": 7450702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂蕾娜",
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745070201,
					"content": "多謝配合，能力審查已完成，妳的夥伴們也都很安全，不會對楓丹市民和生態環境造成任何威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070202
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070202,
					"content": "根據《楓丹外來物種管理法》與《利奧奈區商業行為規範》，妳可以繼續舉辦活動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070203
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070203,
					"content": "有勞妳了，蒂蕾娜小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070204
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070204,
					"content": "沒想到在楓丹舉辦活動的流程居然這麼複雜，比在奧摩斯港多出十來個環節，看來我之前做的準備還不夠啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070205
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070205,
					"content": "不用客氣，更不必自責，妳和妳的蕈獸夥伴屬於特別的來客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070206
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070206,
					"content": "執律庭很少接觸蕈獸這一外來物種，有必要謹慎行事，所以花了不少時間來觀察和評估。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070207
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070207,
					"content": "接下來，我會將妳的委託轉達給其他警備隊員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070208
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070208,
					"content": "#如果見到了傳說中的「黃金流星」和「白銀伴星」，隊員們會通知{M#他們}{F#她們}，請兩位貴客直接來這裡找妳的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070209
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070209,
					"content": "預祝你們的「小小靈蕈大幻戲」活動舉辦順利，在楓丹廷玩得開心…如有需要，我隨叫隨到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070210
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070210,
					"content": "#啊！看來不用麻煩你們了，{M#他們}{F#她們}已經找過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070211
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070211,
					"content": "等一下！妳說的「黃金流星」和「白銀伴星」…居然是這兩位…「超天頂領隊級戰力」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070212
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070212,
					"content": "哇啊！妳們兩個的話題怎麼突然轉向我們了？還有這奇奇怪怪的稱號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070213,
					"content": "#{F#妳}{M#你}們兩位還是一如既往的神采奕奕、容光煥發，一出現就令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070214,
						745070220
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070214,
					"content": "誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070215
					]
				},
				{
					"id": 745070215,
					"content": "妳妳妳…妳是哪位？我們之前見過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070216,
					"content": "#嗯…{F#妳}{M#你}們兩位沒印象了，是我的失誤，我應該盡力和{F#妳}{M#你}們保持聯絡，多寫幾封信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070217
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070217,
					"content": "很久以前，須彌舉辦了一場「月蓮盃馴獸師大賽」。當時，我抱著偏執的想法參加了比賽，想要做些危險的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070218
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070218,
					"content": "#是{F#妳}{M#你}們打醒了我，讓我改過自新，不再仇視善良的蕈獸夥伴，而是找到一條與它們共同生活的正確道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070219
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070219,
					"content": "#那次大賽最後，{F#妳}{M#你}成為了「月蓮盃馴獸師大賽」的最終決定人，而我承諾，會為{F#妳}{M#你}獻出全力，繼續把大賽辦好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070224
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070224,
					"content": "難道說妳是…海妮耶？一直幫我們照顧著「咚咚小圓帽」和其他蕈獸夥伴的海妮耶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070225,
					"content": "沒錯，的確是我，好久不見了！「黃金流星」和「白銀伴星」兩位老闆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070226,
						745070227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070226,
					"content": "新衣服很漂亮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070228
					]
				},
				{
					"id": 745070228,
					"content": "妳現在的樣子，我們根本認不出來嘛！變化太太太…太大了，說話的方式也不一樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070229,
					"content": "為什麼會這樣呢？難道說…是為了帶著蕈獸夥伴們在楓丹旅遊的…儀式感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070230,
					"content": "咳咳！其實楓丹廷對遊客沒有著裝要求，就算穿著樸素的獵戶服裝，也不會被人冷眼相待的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070231
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070231,
					"content": "海妮耶小姐著裝已經不止於滿足儀式感了，而是太優雅了，優雅至極！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070232
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070232,
					"content": "#實在感謝！得到了{F#妳}{M#你}們的肯定，我更有信心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070233
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070233,
					"content": "言歸正傳，這次我來楓丹，是為了幫正式的蕈獸大賽尋找可靠的投資方，並用暖場活動宣傳蕈獸的可愛之處，提前吸引受眾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070234
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070234,
					"content": "左右加說，我們正在進行跨國的商業事務，楓丹人非常講究穿衣打扮的細節，我們要入鄉隨俗才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070235
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070235,
					"content": "所以左右加為我準備了暖場活動的方案，訂製了這身服裝，還對我進行了一番特訓，改善了我的言行舉止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070236
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070236,
					"content": "左右加？這個名字…好像是那位被我們打敗後，一直跟著妳取材，幫妳照顧蕈獸夥伴的輕小說作家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070237,
					"content": "沒想到左右加居然還懂這些…異國的禮節！她居然這麼博學的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070238,
					"content": "#不只如此，如果{F#妳}{M#你}們對以前玩過的桌上遊戲「靈蕈棋陣」還有印象，那也可以來試試全新的「小小靈蕈大幻戲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070239
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070239,
					"content": "之前，「靈蕈棋陣」的玩法是「指揮小小靈蕈們戰勝場地內的棋陣機關」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070240
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070240,
					"content": "遊戲剛剛推出時的反響還不錯，但缺乏長久遊玩的潛力，很快就沒了人氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070241
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070241,
					"content": "所以左右加結合各種文獻和小說的描述，將棋陣機關換成了模擬強大對手的棋子，為遊戲增添了各種多變性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070242
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070242,
					"content": "現在，左右加正在《蒸汽鳥報》報社商量刊登廣告，宣傳遊戲的事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070243
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070243,
					"content": "我好像明白了…妳說的暖場活動，「小小靈蕈大幻戲」，就是桌上的這款遊戲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070244,
					"content": "強大的對手？也就是說，要指揮蕈獸夥伴們的棋子，去和其他的生物較量，雙方都能移動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070245,
					"content": "聽起來遊戲整個變複雜了很多…不過，按照以往的經驗，妳是不是還要處理一些細節上的事，完善這個遊戲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070246,
						745070247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070246,
					"content": "哈哈！是我們擅長的領域！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070248
					]
				},
				{
					"id": 745070248,
					"content": "咳咳…已經不勞兩位擔心了。需要解決的難題，我們都事先處理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070249
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070249,
					"content": "海妮耶小姐與她的「小小靈蕈大幻戲」得到了來自楓丹科學院的…呃…楓達團隊的贊助，一切都準備妥當了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070250
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070250,
					"content": "#就算有還沒處理完的雜務，本人…特巡隊工作最勤快的蒂蕾娜，也不會允許{F#妳}{M#你}們兩位貴客受累的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070251
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070251,
					"content": "#畢竟{F#妳}{M#你}們可是「超天頂領隊級戰力」，而海妮耶小姐是重要的外國商客，雜務什麼的大可以交給普通的警備隊員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070252
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070252,
					"content": "原…原來這位小姐是警備隊員嗎？我還以為是海妮耶僱來的幫手呢…真可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070253,
						745070254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070253,
					"content": "失敬失敬！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070255
					]
				},
				{
					"id": 745070255,
					"content": "噫！「超天頂領隊級戰力」肯定我了…我得到了頂級戰士的認可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070256
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070256,
					"content": "呃咳！現在不是在乎這個的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070257
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070257,
					"content": "作為特巡隊的新人，我有義務監視外來生物，並為特別的客人提供最高級的幫助，搞定普通警備隊員處理不了的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070258
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070258,
					"content": "要是蕈獸相關的活動能為楓丹廷帶來可觀的經濟收益…我也算是累積了一些戰鬥之外的履歷，能更被隊長重視了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070259
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070259,
					"content": "不要這麼嚴肅嘛，只是一個遊戲而已，輕鬆一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070260,
					"content": "在我的印象裡，和善良的蕈獸夥伴有關的事情，能讓人把一切煩惱都忘掉，開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070261,
					"content": "正好！我有一個提議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070262
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070262,
					"content": "之前我和左右加試玩過幾百次「小小靈蕈大幻戲」，不過，我們只代表了兩種遊玩者，而客人們的思維各不相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070263
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070263,
					"content": "剛好「黃金流星」和「白銀伴星」的性格和閱歷都很特別，而蒂蕾娜小姐又很負責…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070264
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070264,
					"content": "#如果{F#妳}{M#你}們兩位進行幾次對局，應該能夠探索出這個玩法的許多極限，有助於改進它的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070265,
						745070266
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070265,
					"content": "好耶！是新遊戲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070267
					]
				},
				{
					"id": 745070267,
					"content": "既然是「超天頂領隊級戰力」都很感興趣的遊戲，又能為我的履歷寫下光彩的紀錄…我當然樂意奉陪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070268
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070268,
					"content": "#不過，我明白我在各方面的實力都遠不如{F#妳}{M#你}，也請{F#妳}{M#你}不要太凶狠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070266,
					"content": "本來也想試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070267
					]
				},
				{
					"id": 745070254,
					"content": "有勞有勞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070255
					]
				},
				{
					"id": 745070247,
					"content": "有我們能幫上忙的工作嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070248
					]
				},
				{
					"id": 745070227,
					"content": "談吐也好有禮貌！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070228
					]
				},
				{
					"id": 745070220,
					"content": "我是不是在哪裡見過妳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070221
					]
				},
				{
					"id": 745070221,
					"content": "這個聲音，總覺得有點耳熟，但我們以前認識這樣的淑女嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070222,
					"content": "看妳的樣子，曬得有點黑的皮膚，似乎不是楓丹當地人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070223,
					"content": "等等…我好像有點印象了，雖然有點不敢相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070224
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7450703,
			"completionStepIds": [
				7450704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7450704",
							"2"
						],
						"stepId": 7450704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂蕾娜",
					"海妮耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745070301,
					"content": "好強…太強了…就算是桌上遊戲，也近乎無懈可擊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070302
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070302,
					"content": "請…請再來兩局，多多教導我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070303,
						745070304
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070303,
					"content": "我真有這麼厲害？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070305
					]
				},
				{
					"id": 745070305,
					"content": "妳的說法未免也太誇張了啦！我們明明只是在玩一個遊戲而已嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070306,
					"content": "請不要謙虛！這個桌上遊戲可以反映遊玩者的「小隊指揮」思維——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070307
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070307,
					"content": "每隻「小小靈蕈」的站位、應對的目標、發動戰技的節奏、互相支援的時機等等…都很講究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070308
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070308,
					"content": "#{F#妳}{M#你}沒有接受過執律庭的小隊指揮訓練，就能如此嫻熟地發動「聯合作戰」的攻勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070309
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070309,
					"content": "#{F#妳}{M#你}已經不是「超天頂領隊級戰力」了，而是名副其實的「超天頂領隊」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070310
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070310,
					"content": "#有意向來執律庭任職嗎？{F#妳}{M#你}一定很快就能坐上小隊長的位置，然後進一步成長為關鍵的骨幹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070311,
						745070317
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070311,
					"content": "好啊！薪水多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070312
					]
				},
				{
					"id": 745070312,
					"content": "這個嘛…我不太確定，我記得幾年前普通警備隊員的月薪好像是30萬摩拉吧…現在應該提高了一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070313
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070313,
					"content": "每個月30萬摩拉是多少來著？我總覺得這個數字有點熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070314,
						745070315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070314,
					"content": "還不夠派蒙吃的呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070316
					]
				},
				{
					"id": 745070316,
					"content": "沒…沒辦法！畢竟執律庭只是執行機構，大部分資金來源都是楓丹市民們的稅款，薪水當然不會特別高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070323
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070323,
					"content": "我理解妳對「黃金流星」和「白銀伴星」的敬重，蒂蕾娜小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070324
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070324,
					"content": "#可惜，根據我的消息，{M#他們}{F#她們}要在提瓦特四處遊歷，順便幫各國的人解決難題、清剿魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070325
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070325,
					"content": "#作為{M#他們}{F#她們}善行的受益者，我也希望有更多人接受{M#他們}{F#她們}的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070326
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070326,
					"content": "是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070327
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070327,
					"content": "把正義與和平的種子播撒到全提瓦特，的確比只照顧楓丹的治安要偉大得多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070328
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070328,
					"content": "#那我就只有…再和{F#妳}{M#你}們多玩幾局遊戲，盡量領會{F#妳}{M#你}們兩位的思想了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070329
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745070329,
					"content": "話說回來，不能忘了還有一件重要的事，海妮耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070330,
					"content": "我猜，妳是想問「咚咚小圓帽」沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070331
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070331,
					"content": "「咚咚小圓帽」和「歡騰之火」就在旁邊，蒂蕾娜小姐還特意幫蕈獸夥伴們安排了一位照顧生活的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070332
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070332,
					"content": "按照慣例，這次我也有準備特別的「妙妙瓊脂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070333
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070333,
					"content": "#{F#妳}{M#你}們可以一邊和蕈獸夥伴們玩，一邊和夥伴們一起吃零食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070334
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745070334,
					"content": "好好好！海妮耶的準備越來越周到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070335,
					"content": "#{NICKNAME}，我們分別和蒂蕾娜再玩一局「小小靈蕈大幻戲」，就去看看「咚咚小圓帽」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070315,
					"content": "我難道不值幾千萬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070316
					]
				},
				{
					"id": 745070317,
					"content": "哎呀！我不想上班！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070318
					]
				},
				{
					"id": 745070318,
					"content": "#要是在一個固定的地方停留下來，每天上班，{NICKNAME}就不能做自己的正事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070319,
					"content": "我也不想每天早早就被叫起床去工作…還是自由自在比較好，想去哪裡就去哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070320,
						745070321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070320,
					"content": "而且日常飯菜有更多選擇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070322
					]
				},
				{
					"id": 745070322,
					"content": "對哦！各式各樣的美食也很重要！總是待在同一個地方，飯菜也遲早會吃膩的，還是要時不時替換一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745070323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745070321,
					"content": "而且吃的東西有更多花樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070322
					]
				},
				{
					"id": 745070304,
					"content": "奉承我也沒用哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745070305
					]
				}
			]
		},
