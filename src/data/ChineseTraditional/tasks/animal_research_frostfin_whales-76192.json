			"dialogs": [
				{
					"id": 761920201,
					"content": "拍得真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920202,
					"content": "現在心滿意足了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 761920203,
					"content": "嗯！不管傳說是不是真的，我希望不論赫卡走到哪裡，好運都會助你化險為夷，最後平安回到「斯佩蘭扎」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920204,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 761920205,
					"content": "嘿嘿，那我們回去吧？莉奈婭姐姐，也謝謝妳，我們「斯佩蘭扎」見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761920206,
					"content": "「斯佩蘭扎」見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈婭"
				}
			]
		},
