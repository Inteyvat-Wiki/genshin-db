			},
			"dialogs": [
				{
					"id": 200030201,
					"content": "#{F#妳}{M#你}拿到木材了嗎？只要一份杉木和一份樺木就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
		{
			"id": 2000303,
			"completionStepIds": [
				2000304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2000304",
							"2"
						],
						"stepId": 2000304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "#謝謝{F#妳}{M#你}，這些木材就夠了，我這就拿去給木匠…對了，還得去收房租才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030302,
					"content": "唉，也不知道那個…阿斯…阿斯…什麼莫娜…這次在不在家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030303,
					"content": "是阿斯托洛吉斯·莫娜·梅姬斯圖斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "對！就是這個名字，哎喲…我是真的記不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030305,
					"content": "咦？莫娜還沒交房租嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030306,
					"content": "可不是嘛，其他的租客都把房租交了，就剩她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030307,
					"content": "我跑了好幾趟了，但她一直都不在家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030308,
					"content": "#旅行者，請{F#妳}{M#你}幫我跑一趟，去催催她交房租吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
