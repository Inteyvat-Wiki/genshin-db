			},
			"dialogs": [
				{
					"id": 200030601,
					"content": "騎士團裡的圖書館。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030602
					]
				},
				{
					"id": 200030602,
					"content": "圖書館啊…嗯！騎士團的圖書館特別大，莫娜說不定會去那邊查資料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030603,
					"content": "那我們就過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
