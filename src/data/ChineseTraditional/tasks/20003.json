					"莫娜的實驗室"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030501,
					"content": "莫娜，妳在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030502,
					"content": "莫娜，該交房租啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "呃…莫娜好像不在呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030504,
					"content": "奇怪，她一般不都是在房間裡嗎？難道今天出門辦事去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030505,
					"content": "難、難道！莫娜已經被餓暈在房間裡了，根本沒力氣來開門嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030506,
					"content": "不至於啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "是、是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030509,
					"content": "但是，我們要去哪裡才能找到莫娜呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030507,
					"content": "她之前都說自己想到賺錢的方法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
