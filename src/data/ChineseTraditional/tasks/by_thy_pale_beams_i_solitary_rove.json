						"stepId": 7266206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "怎麼…怎麼會這樣，連父親的魚餌配方也沒有用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620302,
					"content": "不要難過，都怪那個遺蹟守衛！一定是它把「海中月」嚇跑了！我們再試試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620303,
					"content": "嗯，不然我們再試試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620306,
					"content": "先算了吧，我有點累了。或許楠塔克是對的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620307,
					"content": "唉…我現在想去外面散散心，我得好好想想之後的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620308,
					"content": "#這些是報酬，不管怎麼說，還是非常感謝{F#妳}{M#你}們的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620309,
					"content": "看來鯨井小姐現在想要一個人靜靜呢，我們過一陣子再來看看她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}