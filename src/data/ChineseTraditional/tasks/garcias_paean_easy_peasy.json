			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "我的手…呃！全麻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160102,
					"content": "先生，您過一段時間還要為迦雅小姐計算帳目，可不要過分勞累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160103,
					"content": "我、我知道！別提這個，路通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160104,
					"content": "當然，如果您不能去的話，我也可以為您代勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160105,
					"content": "不！我自己會去，我只要再…再砸出幾個齒輪來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160107,
					"content": "好吧，我砸不動了，我真的砸不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160108,
					"content": "你又在做什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "#是{F#妳}{M#你}啊，旅行者…哎喲…我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160110,
					"content": "是這樣，因為阿漢格爾先生還有其他的工作，不能一直幫我製作我要的零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160111,
					"content": "而且他所製作的零件，總是和我想要的有一些細微的差別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160112,
					"content": "所以，為了保證這些零件可用，我就直接向阿漢格爾先生請教了一下鑄造的手法，決定自己來親手鑄造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160113,
					"content": "還好在楓丹的時候我有過類似的工作經驗…但阿漢格爾先生和我說的那些手法，有些我是真的記不住，哎喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160114,
					"content": "旅行者，請您代我向阿漢格爾先生再請教一下手法，我是真的需要休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160115,
					"content": "你在這好好休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "謝謝您願意幫忙，哎喲…我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160116,
					"content": "迦雅是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "生意夥伴！一個…呃…才華橫溢，財富也橫溢的…生意夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160118,
					"content": "我們之間簽了長期的帳目管理合約！所以我才會一直去找她，對吧路通？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230160119,
					"content": "您說得很有道理，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160120,
					"content": "總，總之就是這樣…旅行者，請您快些去找阿漢格爾先生請教一下吧，我就在這等您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿漢格爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "#都說了等一會…嗯？怎麼是{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160202,
					"content": "我是代他來請教的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "他還真去自己做了啊…真是個怪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160205,
					"content": "我打了這麼多年鐵，從來沒見過要求這麼精細的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160206,
					"content": "他居然還會拿尺量鐵管之間的接縫粗細，還有螺紋的間距。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160207,
					"content": "我實在是不耐煩了，就說他有本事自己去做…結果他第二天還真的過來請教鑄造的手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160208,
					"content": "我真是服了他，所以就隨便他了。只要他自己出材料錢，工具什麼的都讓他用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160209,
					"content": "唉，真不知道這傢伙想做什麼東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160210,
					"content": "他在做一臺偉大的機器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "#行吧…反正都是怪東西。{F#妳}{M#你}們是來問鑄造手法的對吧？做齒輪這件事我也沒什麼好教的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160213,
					"content": "不過，我注意到這傢伙要的齒輪邊緣都很銳利，中間卻要凹下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160214,
					"content": "這種異型齒輪單靠模具很難直接做出來，他必須要再把齒輪二次加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160215,
					"content": "#詳細操作我之前都教過他了，{F#妳}{M#你}就回去告訴他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160216,
					"content": "首先，二次入爐的時候，<color=#00E1FFFF>燃料記得加多一點</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160217,
					"content": "然後，拿出來加工的時候，<color=#00E1FFFF>從內向外敲打</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160218,
					"content": "怎麼樣，記住了嗎？記住了就回去告訴他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160219,
					"content": "真是個怪人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿漢格爾"
				},
				{
					"id": 230160211,
					"content": "他在做一臺奇怪的機器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "他手敲麻了，休息一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
