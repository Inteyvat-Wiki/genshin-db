			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "#啊，{F#妳}{M#你}們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370302,
					"content": "老何留下了些訊息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "喔？他還真的留了些東西！來，告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370306,
					"content": "#{F#妳}{M#你}們向瑾武具言了此前尋到的資訊。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "嗯…黑色「熔岩」…流明石…蘑菇…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370305,
					"content": "哼…真是邪門，似曾相識的邪門。我們也別在這裡久留了，一起動身去營地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "就是這裡了…奇怪，志瓊那傢伙在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370402,
					"content": "志瓊，志瓊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370403,
					"content": "唉…對，那傢伙又自顧自跑到礦洞深處畫地圖了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370404,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "#剛剛{F#妳}{M#你}們離開的時候，她畫了這幅地圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370408,
					"content": "她應該又跑去深處探險了。請替我告訴她一聲，前方很危險，不要冒冒失失地甩下大家自己一個人亂撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370409,
					"content": "…如果再惹出什麼麻煩拖累大家，瑾武姐的拳頭是不會留情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370410,
					"content": "嗚哇…好兇惡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370411,
					"content": "好兇惡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "好啦，兩位也不要閒著。要嘛幫我佈置營地，要嘛去前面探路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370413,
					"content": "抱歉，我不太會說客氣話…總之，至少要對大家有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370414,
					"content": "#啊，順便一提，如果{F#妳}{M#你}們在路上看見了流明石的原晶，就請帶給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370415,
					"content": "我會想辦法把它們加工成更有效用的「觸媒」。根據我的經驗…這些東西在礦下會很有用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370405,
					"content": "志瓊有危險了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "現在還沒…哼，不過她如果再不通知我就亂跑的話，她的屁股就有危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "瑾武"
				}
			]
		},
