	"talks": [
		{
			"id": 7103701,
			"completionStepIds": [
				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊",
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "呼，好久沒有下來過了…是礦下熟悉的空氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370102,
					"content": "可不要太懈怠了，小瓊。我怎麼聞到了不熟悉的氣味呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370103,
					"content": "畢竟我們又不能直接跳下來…搖搖晃晃的起重機太讓人分心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370104,
					"content": "妳呀…還是在地面上時間長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370105,
					"content": "我怎麼什麼都沒聞到呀…你們礦工，鼻子都這麼靈嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370106,
					"content": "哈哈，在礦下鼻子不靈的話可是會要命的。不過現在還好啦，團雀們還很有精神呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370107,
					"content": "看那邊，流明晶石都長到這裡來了…上次下礦時還沒有延伸到這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370108,
					"content": "真的呀，我們一起去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370109,
					"content": "唔…總感覺有人搶了我的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "沒想到流明晶石會出現在距離地面這麼近的地方…我本以為這些東西不會增生在結構比較脆弱的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370202,
					"content": "它們是地下那個「東西」的碎片，沿著岩石的脈絡而遷移，最終來到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370203,
					"content": "別亂說。它們就是本地的岩石，之所以變成這樣，只是因為經歷了某種轉化作用，形成了結晶而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370204,
					"content": "「七星」委託我們做過分析…成分上大部分還是層岩巨淵本地的礦物，但只是…受到外力影響，重構成了奇特的結晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370205,
					"content": "#快看，那塊晶石和{NICKNAME}身上的「觸媒」似乎差不多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}也快把流明石「觸媒」拿出來看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370232,
					"content": "沒錯，流明石「觸媒」和此種晶石實際上是同一種東西。其結構一致，自然會彼此共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370206,
					"content": "好邪門…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "#喂，{F#妳}{M#你}就只會說這個嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370209,
					"content": "#{F#妳}{M#你}們先不要吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370210,
					"content": "我們沒有吵架…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "#{NICKNAME}沒有在和我吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370212,
					"content": "#我是說，我沒在關心{F#妳}{M#你}們有沒有吵架，志瓊和我要在前方佈置一個臨時的前進營地，這段時間請不要到處亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370213,
					"content": "我們剛剛發現的結晶，對於接下來的探險十分有用，如果接下來再有新發現，請務必通知我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370214,
					"content": "#我的手藝還沒有生疏，可以替{F#妳}{M#你}們加工一下這些粗糙的原晶…對後面的冒險很有用處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370215,
					"content": "嗯，還有就是…不要吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370216,
					"content": "知道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370217,
					"content": "知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "#真乖，等一下發糖給{F#妳}{M#你}們。對了，如果{F#妳}{M#你}們在附近遇到了什麼奇怪的東西，請及時回來報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370219,
					"content": "對了，上次瑾武姐說的，關於老何的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370220,
					"content": "#我還沒忘呢。既然{NICKNAME}也來了，就麻煩再幫我一個忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370221,
					"content": "老何是我們礦上的前輩，前些年層岩巨淵疏散礦工時，他是不幸失蹤的其中一個…他聽力不好，也許沒注意到警報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370222,
					"content": "輝山廳與盛露廳的撫恤也到位了，他家裡也把白事辦好了…不過我還是不信邪，我總覺得他還活在礦下某個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370223,
					"content": "老何他算是資深礦工啦…如何規避礦難、如何逃生、如何等待救援，等等等等…他懂得可多了，也教了我不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370224,
					"content": "所以我相信，這麼久了，他一定還在哪裡活著…可不能放棄搜救才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370225,
					"content": "#稍後我為{F#妳}{M#你}們指出幾個方位，是礦工撤離前老何曾經所在的工作地點…說不定在那邊還能找到什麼線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370226,
					"content": "至於我呢，就先去礦洞深處勘察啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370233,
					"content": "#對了，別忘了{F#妳}{M#你}們的糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370227,
					"content": "妳不一起來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "她還要為我們繪製地圖，層岩巨淵的地下結構錯綜複雜，沒有地圖可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370229,
					"content": "注意安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "#沒關係的啦，我也不是新手了。請{F#妳}{M#你}儘管放心吧，前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370207,
					"content": "好神奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
