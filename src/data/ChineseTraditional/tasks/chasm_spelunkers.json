			"trigger": {
				"objectNames": [
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#啊，是{NICKNAME}前輩，{F#妳}{M#你}們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370502,
					"content": "瑾武有事囑咐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370510,
					"content": "妳在這裡做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370503,
					"content": "又是那套安全叮囑吧？唉…我聽都聽煩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370504,
					"content": "我從小也是在礦上長大的，礦坑裡的危險哪有不知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370505,
					"content": "至於那些未知的事物，長輩們總是喜歡藉經驗來判斷是否危險…然後反過來用結果來證明自己的經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370506,
					"content": "#我是受夠他們這種自大了…我相信身為冒險家的前輩{F#妳}{M#你}，也是一樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370508,
					"content": "好啦——不要再勸我了，我不想和前輩為這種小事吵起來…唔，我們換個話題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370509,
					"content": "#前輩{F#妳}{M#你}看，我現在正在勘探這裡的地形，以便繪製地圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370511,
					"content": "嗯…我剛剛說了呀，我在勘探地形，繪製地圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370512,
					"content": "只不過…之前在探索礦洞的時候，前路被幾處奇怪的異變點阻擋了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370513,
					"content": "如果能夠取樣或者拍下照的話，總務司與冒險家協會應該都會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370514,
					"content": "說來丟人…下礦時我的留影機不小心摔壞了，所以只能仰賴前輩高超的攝影技巧啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370515,
					"content": "還有另一些地點…嗯，這裡和這裡，有盜寶團的蹤跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370516,
					"content": "什麼呀…完全看不出哪裡是哪裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370517,
					"content": "只是幾個叉號和幾條線呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "哈哈，抱歉抱歉…只是自己習慣，就忘記不是人人都有製圖師的直覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370519,
					"content": "#不過沒關係，我會隨前輩一起去，為{F#妳}{M#你}們指路的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370520,
					"content": "這幾處地點，我們先去解決哪裡都可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710370521,
					"content": "那我們就出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "路上妳要小心安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "謝謝前輩關心！我明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				}
			]
		},
