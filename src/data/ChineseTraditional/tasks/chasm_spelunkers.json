			"dialogs": [
				{
					"id": 710370901,
					"content": "#等{F#妳}{M#你}們回來，志瓊的地圖應該也差不多畫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370902,
					"content": "#不過在這之前，我還要等上面的運輸隊把我的工具都帶下來，這段時間請{F#妳}{M#你}們自由探索吧。",
					"roleType": "TALK_ROLE_NPC",
