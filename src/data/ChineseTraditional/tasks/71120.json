			"dialogs": [
				{
					"id": 711200101,
					"content": "喂，離遠點！這是老爺的地盤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200102,
					"content": "哇啊，好凶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711200103,
					"content": "你們是什麼人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "#看{F#妳}{M#你}囉。{F#妳}{M#你}若客客氣氣的，我們便是朋友！{F#妳}{M#你}若打探太多，便別怪我們不客氣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711200105,
					"content": "#勸{F#妳}{M#你}有點眼力見，哪裡來的回哪裡去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200109,
					"content": "你們也太可疑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711200110,
					"content": "#可疑？唉喲…我們就是看門的而已，{F#妳}{M#你}們這副探頭探腦的樣子才更可疑吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711200111,
					"content": "行了，有什麼好說！別打擾我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200106,
					"content": "這是哪位「老爺」的地盤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "#哪位「老爺」？哼…說出來嚇死{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711200108,
					"content": "#為{F#妳}{M#你}自己好，朋友！不該知道的東西就別亂打聽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "盤枝蛇"
				}
			]
		},
