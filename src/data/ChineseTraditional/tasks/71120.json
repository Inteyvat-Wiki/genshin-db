			"dialogs": [
				{
					"id": 711209101,
					"content": "#怎麼又是{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711209102,
					"content": "#收收好奇心，朋友。{F#妳}{M#你}們就當沒看見我們，我們也當沒看見{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209103,
					"content": "你們在看守什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "#朋友，{F#妳}{M#你}猜我們領工錢為了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209105,
					"content": "為什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209106,
					"content": "咳咳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209107,
					"content": "#（我只告訴{F#妳}{M#你}們兩個，別讓別人知道哦…來來，我告訴{F#妳}{M#你}…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209108,
					"content": "（嗯嗯！我聽著呢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209109,
					"content": "#為了讓{F#妳}{M#你}們這種閒人滾蛋！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209110,
					"content": "哇啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711209111,
					"content": "山洞裡有奇怪的聲音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "我放屁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "坐地虎"
				},
				{
					"id": 711209113,
					"content": "呃…對，他放屁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "盤枝蛇"
				},
				{
					"id": 711209114,
					"content": "那、那沒事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
