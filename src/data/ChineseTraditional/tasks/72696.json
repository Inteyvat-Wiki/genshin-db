			"trigger": {
				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960101,
					"content": "哈啊，真是好險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960102
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960102,
					"content": "差一點，就差那麼一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960103
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960103,
					"content": "伯特蘭，你怎麼滿臉是汗，好像全身都要虛脫了一樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960104,
					"content": "不是「好像要虛脫」，我就是「虛脫」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960105,
						726960106
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960105,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				},
				{
					"id": 726960107,
					"content": "嘿嘿，險些失敗了，好在我眼疾手快進行了一些緊急的調整，終於穩定下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960108
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960108,
					"content": "現在那些元素正一點點和之前收集的原材料結合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960109
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960109,
					"content": "哎呀，還真是命懸一線啊，要是元素力沒控制住，我就可以和長野原家的煙花比比誰在天上更璀璨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960110
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960110,
					"content": "之前還說不會爆炸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960111
					]
				},
				{
					"id": 726960111,
					"content": "我說的是玩具不會爆炸，我可沒保證過製造玩具的機器一定不會爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960112
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960112,
					"content": "#不過這次也正是多虧了有{F#妳}{M#你}們幫忙實驗，要是直接投入生產，一個玩具都做不出來不說，連立身之本的「大工機」都得沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960113
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960113,
					"content": "好了，現在就是最後的環節，這最後的環節就是「核心啟動」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960114
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960114,
					"content": "核心啟動，聽你之前的話，是和元素生物有關對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960115,
					"content": "對，元素生物身上有令元素力不斷流動的動力。將這種動力加入機器，就是最後的工序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960116
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960116,
					"content": "如果能成功產出玩具，就可以持續不斷地生產，用玩具還上欠債，大賺一筆，在稻妻逍遙快活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960117
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960117,
					"content": "嗯？你不回楓丹嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960118,
					"content": "楓丹…呵，楓丹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960119
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960119,
					"content": "#{NICKNAME}，派蒙，{F#妳}{M#你}們還沒有去過楓丹吧，如果{F#妳}{M#你}去過就知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960120
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960120,
					"content": "對於一些人來說，那裡是能夠便利生活的國度，但對另一些人來說，那裡不過是一塊失意的傷心地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960121
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960121,
					"content": "那裡的能源體系比較特殊，誰都不知道還能維持多久。在真的崩潰之前，找到替代的能源方案是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960122
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960122,
					"content": "但是改變總是比想像中困難，結果就是…我現在不得不一個人在楓丹之外研究其他的能量來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960123
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960123,
					"content": "其實「大工機」也是我研究新能源的產物，所以還不是很穩定，一個不注意可能就會產生爆炸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960124
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960124,
					"content": "不過總有一天我一定會找到一個好的能源方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960125
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960125,
					"content": "那時候我就會啟程返回楓丹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960126
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960126,
					"content": "伯特蘭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960127,
					"content": "不說這些了，開始最後的工序吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960128
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960128,
					"content": "#返回楓丹之前，我能在稻妻能過上什麼樣的生活，可都看{F#妳}{M#你}的了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960106,
					"content": "元素反應失敗了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				}
			]
		},
