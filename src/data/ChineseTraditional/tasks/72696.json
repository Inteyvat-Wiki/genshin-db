					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960301,
					"content": "這下所有工序都將就緒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960302
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960302,
					"content": "#這樣吧，{NICKNAME}，就由{F#妳}{M#你}來親手將「素材收集器」放在機器上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960303
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960303,
					"content": "真不知道能造出什麼樣的玩具，還真有點興奮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960304
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960304,
					"content": "你居然也不知道會造出什麼樣的玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960305,
					"content": "這就是「大工機」的有趣之處啊，哈哈哈，因為它是應對不同的材料相對做出不同的處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960306
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960306,
					"content": "#做出來的東西取決於{F#妳}{M#你}帶來了什麼，來，快點試試看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				}
			]
		},
		{
			"id": 7269604,
			"completionStepIds": [
				7269605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269605",
							"2"
						],
						"stepId": 7269605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960401,
					"content": "這真的是楓丹機器製造出的玩具嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960402,
					"content": "…總覺得和楓丹印象不符。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960403
					]
				},
				{
					"id": 726960403,
					"content": "只是做出楓丹風格的玩具機器人，當然是沒法獲得商業化的成功的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960404
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960404,
					"content": "實不相瞞，這加入了我對在地流行文化的理解，只有貼近本地居民的心，才會受到本地居民的歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960405
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960405,
					"content": "真的會受歡迎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960406,
					"content": "咳咳…一開始肯定會遭到誤解，但是只要持之以恆，改進產品，肯定能打動他們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960407
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960407,
					"content": "總而言之，這樣就完成一次製造了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960408
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960408,
					"content": "怎麼樣，很有趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960409
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960409,
					"content": "普通有趣吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960410
					]
				},
				{
					"id": 726960410,
					"content": "#哼哼，明白了，這樣的材料比例能夠做出來的玩具是這樣的，那我就先把這個收進我的庫存裡，另外，這張券給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960417
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960417,
					"content": "#這張券可以免費兌換與這個機器人相同造型的機器人，如果{F#妳}{M#你}喜歡這個造型的，穩定生產完成後就用這張券來換就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960418
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960418,
					"content": "嗯嗯…畢竟是第一個造出來的玩具機器人，我得進行一些檢查，總是做出會爆炸的小東西可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960411
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960411,
					"content": "試運行產生的問題紀錄…我看看，要提高效率還要做出一些調整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960412
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960412,
					"content": "沒想到一涉及這些工作，還滿認真的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726960413,
					"content": "那是當然了，我孤身在外，能夠依靠的就只有這個機器和製造工藝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960414
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960414,
					"content": "雖然這些都被之前抓捕我的同心怒斥為「奇技淫巧」，哼，可別小看了認真的「奇技淫巧」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960415
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960415,
					"content": "我先做些調整，這樣一來，等過段時間能夠正式開始我的製造大業了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960416
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726960416,
					"content": "#到時候{F#妳}{M#你}也一定要來幫忙啊，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
