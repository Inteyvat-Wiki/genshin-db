			"dialogs": [
				{
					"id": 200100701,
					"content": "怎麼樣？我的丘丘人口語很不錯吧？只要語言能夠相通，那麼互相理解也只是時間問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100702
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200100702,
					"content": "我是這麼希望的…我的夢想，是和丘丘人們做朋友。",
