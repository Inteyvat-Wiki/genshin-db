				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100201,
					"content": "這裡剛好有個丘丘人醒著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100202
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200100202,
					"content": "就這位了，我們快點過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100203
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200100203,
					"content": "小心點，過去的時候別吵醒其他丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100204
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200100204,
					"content": "不然他們肯定會誤會，以為我們是準備來攻擊他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100205
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 200100205,
					"content": "要是這樣，肯定不能順利地對話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				}
			]
		},
		{
			"id": 2001003,
