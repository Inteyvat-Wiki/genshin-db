				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "哼，這下他們應該不敢隨便去傷害小匿葉龍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260502,
					"content": "總感覺，有什麼誤會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "別聽他們的花言巧語，我可是親眼看到他們想要把繩子捆在小匿葉龍的尾巴上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260504,
					"content": "要不是我及時過去，還真的不知道會出什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260505,
					"content": "#再次感謝{F#妳}{M#你}幫忙，這些報酬給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260506,
					"content": "可惜，那群盜寶團跑太快了。要是有辦法抓住他們，我一定要把這群惡徒斬草除根！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
