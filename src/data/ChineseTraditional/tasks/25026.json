			"dialogs": [
				{
					"id": 250260401,
					"content": "我們一起去教訓盜寶團吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#{F#妳}{M#你}願意和我一起去？那太好了，看{F#妳}{M#你}這副模樣…想必也是位經驗豐富的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260403,
					"content": "我會照冒險家的規矩準備好報酬的，那我們立即出發吧，給那群惡棍一點顏色看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
