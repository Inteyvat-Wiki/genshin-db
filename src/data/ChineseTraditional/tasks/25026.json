			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "可憐的小匿葉龍…這幫惡棍，我一定要教訓他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260102,
					"content": "惡棍們，你們可以逃，但絕對無處可藏…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260103,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#{F#妳}{M#你}是…外來的旅行者，對吧？向{F#妳}{M#你}致意，很抱歉，現在我沒辦法招待{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260105,
					"content": "那群不識好歹的盜寶團惡棍，又想抓住那隻小匿葉龍，還好我及時過去，把他們都趕跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260106,
					"content": "那隻小匿葉龍一定是嚇壞了，無論我怎麼叫牠都不肯過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260107,
					"content": "但現在我已經找到那群盜寶團的所在地了，等下就去教訓這幫惡棍，再把他們捆在樹上，拿樹藤狠狠地抽一頓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260108,
					"content": "而且還要找點好吃的，去安慰一下那隻小匿葉龍才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502601",
							"2"
						],
						"stepId": 2502601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "還是先去安慰小匿葉龍吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "#唔…{F#妳}{M#你}說的也有道理，那孩子一定被嚇得很厲害，還是先去安慰一下牠比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260203,
					"content": "#那就跟我來吧，看{F#妳}{M#你}的模樣，想必也是位經驗豐富的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260204,
					"content": "我們兩個一起過去，那群不懷好意的人絕對不敢再來，不用擔心報酬，我會按照冒險家的規矩準備好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260206,
					"content": "#我想想…那孩子很喜歡吃新鮮的燭傘蘑菇…我記得那邊的樹下長了很多，請{F#妳}{M#你}先去採一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260205,
					"content": "#我去另一邊採燭傘蘑菇，等{F#妳}{M#你}採好之後，我們在競技場那邊的懸崖上集合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260207,
					"content": "那孩子平常經常在那邊休息，也許我們可以在那邊找到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502603",
							"2"
						],
						"stepId": 2502603,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_LESS",
						"rawParams": [
							"2502601",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特阿墨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "那孩子平常經常呆在這裡。但今天，怎麼沒看到牠留下的痕跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260302,
					"content": "也許是被嚇壞了，特意藏起來了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260303,
					"content": "我們要去找牠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "…不必了，先讓那孩子安靜一下吧。我們把燭傘蘑菇放在這裡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260305,
					"content": "你還滿熟練的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "我已經照顧這孩子一段時間了，牠的個性很敏感，就算是遇到陌生人都會嚇一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260307,
					"content": "我餵這隻小匿葉龍餵了很久之後，這孩子才願意靠近我…唉…可是被那群惡棍一鬧，牠鐵定又不願意出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260308,
					"content": "沒辦法，只能讓牠先自己安靜一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260309,
					"content": "#多謝{F#妳}{M#你}陪我一起來。這是報酬，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260310,
					"content": "沒看見牠，有點遺憾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "放心，那孩子會記住對牠好的人。等到時機成熟，牠一定會來見我們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特阿墨"
				},
				{
					"id": 250260311,
					"content": "還是想見見那隻小匿葉龍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
