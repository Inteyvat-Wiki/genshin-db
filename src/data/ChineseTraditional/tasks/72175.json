				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#又見面了，{NICKNAME}！還有…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751802,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751803,
					"content": "順便一問，這個飛來飛去的小傢伙怎麼賣？看起來蠻有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751804,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751805,
					"content": "你還好嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "明顯不太好吧！這傢伙怎麼突然失憶了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751809,
					"content": "#{F#妳}{M#你}們在說什…噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751810,
					"content": "噗…哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751811,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751812,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "#哈哈哈哈…咳咳…哈哈哈哈哈！瞧瞧…瞧瞧{F#妳}{M#你}們那副表情！噗哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751814,
					"content": "完了…我笑得喘不過氣了…對不…對不起…這是…呵哈哈哈哈…這是我最喜歡的「健忘笑話」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751815,
					"content": "一點也不好笑吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751816,
					"content": "不是很懂你的幽默感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "噗…好了，好了，不開玩笑了，抱歉抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751819,
					"content": "真是的，我還以為你作為大冒險家，是個很嚴肅的人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751820,
					"content": "呵呵，可不要產生這樣的刻板印象哦，冒險家協會可是有名的怪人圈子。我在裡面算是比較正常的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751821,
					"content": "…也沒有多正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751822,
					"content": "#還是謝謝{F#妳}{M#你}們的蘑菇。這東西到現在為止效果還不太明顯…或許是需要長期服用，也許本身就不是什麼藥物…總之味道不差就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751823,
					"content": "這些可不能全吃完了，我還要留一些給須彌的朋友，幫忙研究一下它的藥用價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751824,
					"content": "我猜你一轉頭就會把這事給忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751825,
					"content": "咳咳，正事正事。請問二位有沒有去尋找壁畫呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751826,
					"content": "這裡是你要的相片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "哦哦，大恩不言謝！這個國家是這樣表達感謝的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751828,
					"content": "#唔嗯…有趣，非常有趣。只是…{F#妳}{M#你}們沒有發現更多壁畫了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751829,
					"content": "這些是全部了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "那就更有意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751832,
					"content": "咦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751833,
					"content": "鶴觀的原住民曾以雷元素之魔鳥為信仰，以祭祀儀禮為核心組建起自己的文明。稍微瞭解歷史的人對此應該並無異見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751834,
					"content": "#但在{F#妳}{M#你}們提供的壁畫上…卻沒有雷鳥的痕跡。人們所膜拜的是另一些東西——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751835,
					"content": "日月星辰…和…奇怪的符號。或許…在雷鳥降臨之前，鶴觀原住民的先祖們就已經擁有了一定高度的文明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751836,
					"content": "除此之外…霧與月亮，群星與黑暗…唔，解釋不通呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751837,
					"content": "還是不要過度用腦了吧…你的記性已經很不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751838,
					"content": "#…啊，抱歉。思考太入迷，忘了{F#妳}{M#你}們還在場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751839,
					"content": "#再次感謝{F#妳}{M#你}們的辛勞，我接下來的日誌有了足夠的素材…假如能有幸被歷史學者重視的話，我是不會忘記署上二位的大名的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751840,
					"content": "#好了，我也該去冒險家協會報到了。實在抱歉打擾了{F#妳}{M#你}很長時間，希望下次有緣再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751841,
					"content": "真是個大忙人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721751842,
					"content": "#啊，對了…還有一件事。雖然不是什麼大事，但希望{F#妳}{M#你}能替我注意一下。先前提到的那個小孩子…叫…什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751843,
					"content": "「阿瑠」…對，是這個名字。我這次順便幫那孩子帶了些吃的…希望還新鮮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751844,
					"content": "自從上次以來，我還一直惦記著這島上有個孩子…在這樣兇險的島上過日子，一定很不容易吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751845,
					"content": "#好了，不多耽誤{F#妳}{M#你}時間了，{NICKNAME}。旅途的下一站再見，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721751830,
					"content": "我們只找到了這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "這是「健忘人」適應這個世界的方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "之前的「幽燈蕈」有效嗎…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "對呀，對呀！怎麼還惡化了！",
					"roleType": "TALK_ROLE_NPC",
