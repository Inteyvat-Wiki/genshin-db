			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"羅爾德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "#沒想到{F#妳}{M#你}們也還在這座島上，真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750102,
					"content": "#{F#妳}{M#你}們近來如何？有沒有什麼驚人的發現？說來讓我聽聽嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750103,
					"content": "沒什麼發現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "#難免的，難免的！這樣一座島嶼上從來不缺少秘密，相信{F#妳}{M#你}一定能有所發現的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750107,
					"content": "話說回來，羅爾德先生在這裡做什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750108,
					"content": "嗯？我剛收拾好營地行李，正準備離開呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750109,
					"content": "這座島上的濃霧太邪門了…每次深入沒多遠就會迷失方向。然後不知不覺間就會回到起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750110,
					"content": "先前阿釜特意指引的道路讓我給忘了個乾淨…結果想要再回去尋訪那邊的原住民，卻再也找不到路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750111,
					"content": "身上的羅盤也好，地上的影子也好，都沒法用來指明方向…甚至我連鞋子都試過了，可到最後也沒能在霧中多前進半步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750112,
					"content": "鞋子…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750113,
					"content": "他說的是丟鞋指路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750115,
					"content": "#哈！這種資深冒險家的小技巧果然難不住{NICKNAME}！小派蒙要多學學囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750116,
					"content": "派蒙還需要學習哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "根本是碰運氣吧！這種東西有什麼必要學啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750118,
					"content": "總之就是這樣，我的探索裹足不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750119,
					"content": "唉…假如把繩索綁在附近的樹上，緊握著另一端摸索前進的話，本來還可以再多試幾次的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750120,
					"content": "所以為什麼不再試試了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750121,
					"content": "用來分辨方向的備用鞋子丟完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750122,
					"content": "原來備用鞋子都是一次性的嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "嘿嘿，原本不是的。只是丟多了，就總是忘了回頭撿回來，結果慢慢就都…消耗掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750126,
					"content": "#啊！對了，我終於想起自己有什麼事情要拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750127,
					"content": "哇，嚇我一跳！還以為你要咬人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750128,
					"content": "抱歉，抱歉，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750129,
					"content": "#如{F#妳}{M#你}所知，我本來就有個丟臉的毛病…就是無論做什麼都丟三落四的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750130,
					"content": "生來記憶力不佳，給我造成了很多不便，尤其身為冒險家，很容易為此而陷入危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750131,
					"content": "而我此次來到鶴觀的目的之一，是採集一種名為「幽燈蕈」的菌類。聽珊瑚小姐說，這種菌類能夠增強記憶力，緩解大腦勞損，對視力也有好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750132,
					"content": "上次與阿釜一同前來，因為對「遇見原住民」這件事太過在意…反倒忘了採集菌類…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750133,
					"content": "又沒能想到，自己一個人登島之後就遇到了這樣的困難…真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750134,
					"content": "#如果{F#妳}{M#你}們在這裡還要繼續冒險的話，不知可否請幫我採摘一些「幽燈蕈」回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750135,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "十分感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750137,
					"content": "到時候別忘了找我要就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "哈哈，這個不會忘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750124,
					"content": "真是遺憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "唉，說的是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750105,
					"content": "我們還在探索途中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "#這樣呀，哈哈，那就別讓我耽誤{F#妳}{M#你}們的路程了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "羅爾德"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅爾德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "#嗯…有這些的話應該足夠了，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750302,
					"content": "#還有，如果{F#妳}{M#你}們在島上的「祭場」附近有什麼發現的話，還望告知我一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750303,
					"content": "#啊…對了，{F#妳}{M#你}們隨身帶著「留影機」，楓丹貨，對吧？那東西還挺貴的…如果經費寬裕一點的話，我自己也要採購一台。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750304,
					"content": "聽當地的歷史作家所言，傳說鶴觀的古代原住民會用顏料將無法追憶的古老歷史塗畫在山洞內的岩壁上，往往存續超過千年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750305,
					"content": "此前的尋訪中，我似乎也藉著祭典的火光看到了些許圖案…自此之後就難以忘懷，幾天都沒有睡好覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750306,
					"content": "這些壁畫，據我所知從未有人目睹…假如能夠藉二位的口述得以證實的話，將會為「冒險家協會」在歷史學術範疇帶來又一大突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750307,
					"content": "#所以我希望二位能尋到傳說中的壁畫，盡可能完整清晰地拍攝下來。我會買下{F#妳}{M#你}們的照片作為日誌素材所需，並且支付足夠的費用酬謝{F#妳}{M#你}們的辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750308,
					"content": "不知兩位意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750309,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "非常感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750311,
					"content": "只要你別再弄丟日誌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "我…我盡力而為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾德"
				}
			]
		},
		{
