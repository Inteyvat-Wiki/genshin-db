			},
			"dialogs": [
				{
					"id": 721750401,
					"content": "兩位好！最近有什麼收穫嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750402,
					"content": "沒發現什麼有趣的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "不用急躁，我一直在這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750404,
					"content": "#對了，謝謝{F#妳}{M#你}送的「幽燈蕈」。很新鮮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750407,
					"content": "說的倒是輕鬆，你吃的蘑菇不還是我們採的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750408,
					"content": "哈哈，別在意那麼多嘛，我一直在吃呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750409,
					"content": "哇——這個健忘人！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750405,
					"content": "還在努力奔走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "累了的話也請休息一下，來點「幽燈蕈」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "羅爾德"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
