			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#{F#妳}{M#你}好啊，{NICKNAME}，還有多話的小精靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750602,
					"content": "#{F#妳}{M#你}好呀，健·忘·人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750603,
					"content": "我·是·派·蒙！下次可不要忘記啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750604,
					"content": "我知道呀，小·派·蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "羅爾德"
				},
				{
					"id": 721750605,
					"content": "哇！原來你在耍我！你這人的禮貌哪裡去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750606,
					"content": "#哼，{NICKNAME}快把那些詭異的蘑菇給他吧，我不要和他說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721750607,
					"content": "這些足夠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
			"completionStepIds": [
				7217509
