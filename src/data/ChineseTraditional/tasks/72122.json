			]
		},
		{
			"id": 7212215,
			"completionStepIds": [
				7212217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212217",
							"2"
						],
						"stepId": 7212217,
						"stateName": "QUEST_STATE_UNFINISHED"
