			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721220101,
					"content": "淨化裝置、備用零件、路線圖，還有信標數據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220102
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220102,
					"content": "這下應該就準備妥當了…等等，我檢查一下我的備忘，再想想有什麼遺漏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220103
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220103,
					"content": "信標數據、路線圖、備用零件，還有淨化裝置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220104,
						721220105
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220104,
					"content": "行了，出發吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220106
					]
				},
				{
					"id": 721220106,
					"content": "抱、抱歉，我還是第一次進入這種地方，平時我都只是做做後勤，處理處理數據…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220107
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220107,
					"content": "最多…最多也就是用器械遠距離操作一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220108
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220108,
					"content": "唉，這回真的就是…「趕鴨子上架」了。您聽說過這句璃月的俗話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220109
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220109,
					"content": "大意就是，形容讓某人去做一件能力達不到的事…雖然我不知道為什麼鴨子上不了架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220110,
					"content": "啊，鴨子，多麼優雅、多麼柔軟的生物。在楓丹的如同明鏡一般的水面上靜靜漂遊的鴨子，便是此時此刻的我最懷念的景象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220111
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220111,
					"content": "唉，我們出發吧，如果這個裝置運轉正常的話，應該能不斷淨化它周圍小範圍內的「祟神」能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220112,
					"content": "這樣我們就能一起深入災害區域了。還是按照之前的計畫，您去搞定愚人眾，我來搞定「御影爐心」…出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220105,
					"content": "別緊張，會順利的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220106
					]
				}
			]
		},
		{
			"id": 7212202,
			"completionStepIds": [
				7212204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212204",
							"2"
						],
						"stepId": 7212204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721220201,
					"content": "老天爺…我還是第一次不用任何防護手段就進這種地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220202
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220202,
					"content": "但我們居然能順利到達這裡，很好，非常好，幾乎要超出預期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220203,
						721220205
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220203,
					"content": "你的預期也太低了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220204
					]
				},
				{
					"id": 721220204,
					"content": "對於這位被我臨時湊起來的夥計來說，這個預期已經夠高了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220206
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220206,
					"content": "按照我的預期，當我們前進到大概二分之一的距離的時候，我拼出來的這位夥計就會罷工啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220207
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220207,
					"content": "然後，我就會因為被「祟神」影響而陷入昏迷…有可能是真被影響了，也有可能是被嚇的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220208
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220208,
					"content": "但無論如何，我褲子右邊的口袋裡有一張紙條，只要按照上面的步驟處理，您就可以把我安全地帶到外面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220209
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220209,
					"content": "呃…我和您說過紙條的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220210,
						721220212
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220210,
					"content": "完全沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220211
					]
				},
				{
					"id": 721220211,
					"content": "好吧，沒關係，現在您知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220214
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220214,
					"content": "好了，我再檢查一下它，然後我們就可以繼續前進了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220212,
					"content": "現在你告訴我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220213
					]
				},
				{
					"id": 721220213,
					"content": "我一定是忙到忘記了…沒關係，現在您知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220214
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220205,
					"content": "你的預期是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220206
					]
				}
			]
		},
		{
			"id": 7212203,
			"completionStepIds": [
				7212223
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212223",
							"2"
						],
						"stepId": 7212223,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721220301,
					"content": "喔，見鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220302,
						721220303
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220302,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220305
					]
				},
				{
					"id": 721220305,
					"content": "但是，這個裝置似乎少了那麼…一二三個零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220306
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220306,
					"content": "幸好都不是關鍵部位，它暫時還能運轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220307
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220307,
					"content": "但如果想要繼續往前走的話，我們還是得先想辦法把那些零件找回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220308
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220308,
					"content": "那些零件應該就在我們來時的路上，請您快去把它們找回來吧，我就在這等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
