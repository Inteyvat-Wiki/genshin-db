					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220309,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220312
					]
				},
				{
					"id": 721220312,
					"content": "那就拜託您了，我就在這等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220310,
					"content": "你留在這裡，不要走動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220311
					]
				},
				{
					"id": 721220311,
					"content": "那是當然，這周圍又是「祟神」又是愚人眾的，我可不敢亂動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220312
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721220303,
					"content": "發現符合你預期的情況了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721220304
					]
				},
				{
					"id": 721220304,
					"content": "也不能說…完全符合我的預期…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721220305
