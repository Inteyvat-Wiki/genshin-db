				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"虎之助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721221501,
					"content": "「御影爐心」已經恢復正常了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221502
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221502,
					"content": "你已經知道了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221503
					]
				},
				{
					"id": 721221503,
					"content": "你們在「御影爐心」所做的事，已經有人向我報告過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221504,
						721221506
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221504,
					"content": "為什麼不直接來幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221505
					]
				},
				{
					"id": 721221505,
					"content": "沒有接到範兵衛大人的命令，我無權採取任何行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221508
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221508,
					"content": "好了好了，有這麼一位對流程如此重視的嚴謹上司，這位士兵先生也有他自己的苦衷，我們就別為難他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221509
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221509,
					"content": "再說，我倆的行動之所以能如此順利，說不定也有一部分是拜這位範兵衛先生所賜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221510
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221510,
					"content": "而且士兵先生也不是完全沒有給我們幫助，比如那幾門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221511
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221511,
					"content": "澤維爾先生，非常感謝你的協助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221512
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221512,
					"content": "咳…主要還是得感謝這位旅行者，沒有這位旅行者幫忙，我一個人可什麼都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221513
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221513,
					"content": "是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221514
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221514,
					"content": "#非常感謝{F#妳}{M#你}，旅行者。我為我之前的態度…向{F#妳}{M#你}道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221515
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221515,
					"content": "#謝謝{F#妳}{M#你}保護了這座島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221516,
						721221517
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221516,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221518
					]
				},
				{
					"id": 721221518,
					"content": "呃，金髮的…旅行者？等一會，我好像記得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221519,
						721221520
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221519,
					"content": "不、不用客氣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221521
					]
				},
				{
					"id": 721221521,
					"content": "#喔…哦…無論如何，還是謝謝{F#妳}{M#你}幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221522
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221522,
					"content": "哈哈哈，旅行者，您看看您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221523
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221523,
					"content": "您也別謙虛了，要是沒您幫忙，我應該就只能在外面乾看著啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221524
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221524,
					"content": "不過，我倒是還有個問題，士兵先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221525
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221525,
					"content": "您之前和我說，您那位嚴謹的上司為了遞交那些繁複的文書，不得不前往城內工作，想必肯定十分勞苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221526
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221526,
					"content": "但現在「御影爐心」已經恢復了正常，不知道這位好先生現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221527
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221527,
					"content": "唔，範兵衛大人所忙碌之事，先前就有位名叫御輿源次郎的大人詳細詢問過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221528
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221528,
					"content": "聽了我的詳細報告之後，御輿源次郎大人似乎對這件事也很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221529
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221529,
					"content": "之後，據御輿源次郎大人說，上面的大人們也對範兵衛大人的工作能力十分讚賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221530
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221530,
					"content": "為了嘉獎他，似乎已經將範兵衛大人選為了駐於須彌的「遠國御用」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221531
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221531,
					"content": "據說，是常駐須彌，保障須彌與稻妻蘑菇貿易通暢的重要職位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221532,
						721221534
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221532,
					"content": "果然是重要職位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221533
					]
				},
				{
					"id": 721221533,
					"content": "正是如此。這樣重要的職位，實在是非範兵衛大人莫屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221536
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221536,
					"content": "現在範兵衛大人正在城內等待任令，到了合適的時候，應該就會出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221537
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221537,
					"content": "哎呀…這可真是太棒了。不過失去了這麼一位好先生，那這裡空缺的職位怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221538
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221538,
					"content": "我已經向上面舉薦了幾位堪當此任的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221539
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221539,
					"content": "上面的大人最後選定了一位名叫陽介的工匠，負責統一安排「御影爐心」之後的維護工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221540
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221540,
					"content": "這樣安排聽著就讓人放心。哦對了，我們先不說這個了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221541
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221541,
					"content": "士兵先生，請把我的那份報酬全都給這位旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221542
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221542,
					"content": "#還有，這個東西請{F#妳}{M#你}收下，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221543
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221543,
					"content": "這是我之前從一位工匠的手裡買下來的一份圖紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221544
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221544,
					"content": "本來我是想，把這份圖紙作為紀念品帶回國…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221545
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221545,
					"content": "但現在看來，我應該還會在稻妻停留一段時間…暫時是沒法回國了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221546
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221546,
					"content": "所以，這份圖紙我就送給您了，請您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221547
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221547,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221548
					]
				},
				{
					"id": 721221548,
					"content": "哈哈哈，您不用和我這麼客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221549
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221549,
					"content": "這次多謝您幫忙了。等我完成了那部「踏鞴物語」，一定第一個請您過來觀影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221550
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221550,
					"content": "然後，士兵先生，我還有一個小小的忙，想要請你幫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721221534,
					"content": "原來是負責給稻妻添蘑菇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221535
					]
				},
				{
					"id": 721221535,
					"content": "正是。給稻妻人的餐桌上添蘑菇這種重要工作，實在是非範兵衛大人莫屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221536
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721221520,
					"content": "「御影爐心」已經安全了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221521
					]
				},
				{
					"id": 721221517,
					"content": "這是我應該做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221518
					]
				},
				{
					"id": 721221506,
					"content": "就這麼放任愚人眾嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721221507
					]
				},
				{
					"id": 721221507,
					"content": "沒有接到範兵衛大人的命令，我無權採取任何行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721221508
					],
					"speakerTitle": "虎之助"
				}
			]
		}
	]
}