			"dialogs": [
				{
					"id": 751950201,
					"content": "我的天哪，這是…突然出現了好心人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "杜塔"
				},
				{
					"id": 751950202,
					"content": "這片荒地裡的石頭，我正打算請一條突角龍過來幫忙打碎了踢到一邊去，要是冒出來什麼魔物，也順帶一起清理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "杜塔"
				},
				{
					"id": 751950203,
					"content": "結果還沒動手，就有人幫我把麻煩都解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "杜塔"
				},
				{
					"id": 751950204,
					"content": "啊，我每天早上起來都要幫家門口的果樹施肥，這種好事做了一輩子，這就是神明給我的獎勵吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "杜塔"
				},
				{
					"id": 751950205,
					"content": "好心人，神明的使者！我杜塔感謝你的慷慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "杜塔"
				},
				{
					"id": 751950206,
					"content": "#老頭子沒什麼好東西，只能送{F#妳}{M#你}點摩拉，還有點沒什麼大用的破爛，請{F#妳}{M#你}也一起拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜塔"
				}
			]
