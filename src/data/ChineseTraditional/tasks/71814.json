			"dialogs": [
				{
					"id": 718140301,
					"content": "你們已經清掃完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140302
					],
					"speakerTitle": "大坤"
				},
				{
					"id": 718140302,
					"content": "發現了這些東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140303
					]
				},
				{
					"id": 718140303,
					"content": "#嗯…這些摩拉{F#妳}{M#你}就自己收著吧，數量也不太多，就當做{F#妳}{M#你}幫忙的報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140304
					],
					"speakerTitle": "大坤"
				},
				{
					"id": 718140304,
					"content": "#這個盒子我就不知道是什麼了，不然{F#妳}{M#你}把它拿給百聞看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140305
					],
					"speakerTitle": "大坤"
				},
				{
					"id": 718140305,
					"content": "她就在月海亭那邊辦公，也許她知道這是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大坤"
				}
			]
		},
