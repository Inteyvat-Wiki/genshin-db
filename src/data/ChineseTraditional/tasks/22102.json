			"dialogs": [
				{
					"id": 221020101,
					"content": "真是麻煩哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "您看我這黑眼圈，我已經多少天沒睡過好覺了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020104,
					"content": "您見過客棧裡的客人嗎？那真是，一個比一個會折騰，我們這客棧這麼高，也真有人敢往下跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020105,
					"content": "算了，我剛從城裡訂了批菜，現在應該快要到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020106,
					"content": "這路上的怪物啊，肯定也不會乖乖休息，能勞煩您幫我去清一清路嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "那就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020108,
					"content": "這家客棧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "「廣收天下客，遍聽四海聲」…我是這麼想來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020111,
					"content": "不過，其實也就是間客棧，就是地方偏了點，客人多了點，沒什麼了不起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020112,
					"content": "那麼，就萬事拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
