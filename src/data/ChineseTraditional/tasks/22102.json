					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "請您快些吧，這廚子快沒菜下鍋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
