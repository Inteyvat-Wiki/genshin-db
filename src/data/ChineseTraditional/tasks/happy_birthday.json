				]
			},
			"dialogs": [
				{
					"id": 741430201,
					"content": "#孩子們！{F#妳}{M#你}…{F#妳}{M#你}們…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430202,
					"content": "嗚哇，恩肖爺爺怎麼了啊？氣喘吁吁的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430203,
					"content": "莉諾爾…莉諾爾她、她被一個丘丘人擄走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430204,
					"content": "欸？怎麼會這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741430205,
					"content": "#它往那個方向去了！我去找人幫忙，拜託{F#妳}{M#你}們去看看情況！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 741430206,
					"content": "知道了！我們趕快去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7414304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
